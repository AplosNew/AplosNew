<!DOCTYPE html>
<html lang="en" ng-app="loginApp" spellcheck="true">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta charset="utf-8" />
    <base href="@ViewBag.BasePath">
    <title>{{title}}</title>
    <link rel="shortcut icon" href="images/title.gif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    @Scripts.Render("~/bundles/jq")
    @Scripts.Render("~/bundles/angular")
    @Scripts.Render("~/bundles/login")
</head>
<body aplos-focus class="login-bg">
    <div ng-controller="portalController" class="login-portal">
        <a class="download-btn" href="/Download/AuthToken"><i aria-hidden="true" class="glyphicon glyphicon-cloud-download"></i> Download</a>
        <input type="hidden" id="authToken" name="authenticationToken" value="@ViewBag.AuthToken" />
        <input type="hidden" id="groupId" name="groupId" value="@ViewBag.GroupId" />
        <div class="login-portal-inner">
            <div class="container">
                <div class="company-name">
                    <img class="logo" src="{{companyGroupLogo}}" alt="Logo">
                    <p>{{companyGroupName}}</p>
                </div>
                <p id="error" style="margin-top: -6%;font-size: 20px;text-align: center;color:red;">@ViewBag.InvalidPanel</p>
                <div class="row">
                    <a class="prev-arrow" href="portal?authToken=@ViewBag.AuthToken&groupId=@ViewBag.GroupId">
                        <i class="glyphicon glyphicon-menu-left"></i>
                    </a>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="widget-btn">
                            <a href="account/Login?servicepanel=hrms&authToken=@ViewBag.AuthToken&groupId=@ViewBag.GroupId&moduleId=53">
                                <i aria-hidden="true" class="glyphicon glyphicon-send"></i> HRMS
                            </a>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="widget-btn">
                            <a href="#5/{{authenticationToken}}/{{companyGroupId}}">
                                <i aria-hidden="true" class="glyphicon glyphicon-flash"></i> Incentive
                            </a>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <noscript>
        JavaScript is disable in your browser. Please enable from browser settings.
    </noscript>
    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
</body>
</html>