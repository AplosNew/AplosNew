                    <li ng-show="ShowHomeButton"> <a href="{{bootPoint}}{{'dashboard'}}" ng-click="ResetMenu();"><div class="glyphicon glyphicon-home"></div> </a> </li>
                    <li ng-hide="!SelectedHref||SelectedHref==''||SelectedHref=='null'">
                        <a ng-click="DownloadDocumentationFile()" @*href="{{'POPResources/Templates/'+SelectedHref}}" target="_blank"*@>
