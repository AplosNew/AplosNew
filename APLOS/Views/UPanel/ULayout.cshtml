<!DOCTYPE html>
<html lang="en" ng-app="upanelApp" spellcheck="true">
<head>
    <link href="~/SyncfusionLib/css/web/default-theme/ej.web.all.min.css" rel="stylesheet" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta charset="utf-8" />
    <base href="@ViewBag.BasePath">
    <title>{{title}}</title>
    <link rel="shortcut icon" href="images/title.gif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    @Scripts.Render("~/bundles/jq")
    @Scripts.Render("~/bundles/angular")
    @Scripts.Render("~/bundles/syncfusion")

    @Scripts.Render("~/bundles/accounts")
    @Scripts.Render("~/bundles/Administration")
    @Scripts.Render("~/bundles/addresses")
    @Scripts.Render("~/bundles/attendances")
    @Scripts.Render("~/bundles/banks")
    @Scripts.Render("~/bundles/biometric")
    @Scripts.Render("~/bundles/chart")
    @Scripts.Render("~/bundles/Commercial")
    @Scripts.Render("~/bundles/Costings")
    @Scripts.Render("~/bundles/currencies")
    @Scripts.Render("~/bundles/employees")
    @Scripts.Render("~/bundles/EmployeeServices")
    @Scripts.Render("~/bundles/Farming")
    @Scripts.Render("~/bundles/fixedassets")
    @Scripts.Render("~/bundles/humanresource")
    @Scripts.Render("~/bundles/ie")
    @Scripts.Render("~/bundles/issuetracker")
    @Scripts.Render("~/bundles/leave")
    @Scripts.Render("~/bundles/logs")
    @Scripts.Render("~/bundles/machines")
    @Scripts.Render("~/bundles/materials")

    @Scripts.Render("~/bundles/ordermanagements")
    @Scripts.Render("~/bundles/organizations")
    @Scripts.Render("~/bundles/parties")
    @Scripts.Render("~/bundles/payrolls")
    @Scripts.Render("~/bundles/processes")
    @Scripts.Render("~/bundles/productions")
    @Scripts.Render("~/bundles/products")
    @Scripts.Render("~/bundles/projects")
    @Scripts.Render("~/bundles/QMS")
    @Scripts.Render("~/bundles/recruitment")
    @Scripts.Render("~/bundles/securities")
    @Scripts.Render("~/bundles/setups")
    @Scripts.Render("~/bundles/skills")
    @Scripts.Render("~/bundles/sm")
    @Scripts.Render("~/bundles/taskmanagement")
    @Scripts.Render("~/bundles/workcenters")
    @Scripts.Render("~/bundles/Outsourcing")
    @Scripts.Render("~/bundles/JobWork")
    @Scripts.Render("~/bundles/PerformanceManagement")
    @Scripts.Render("~/bundles/MeetingManagement")
    @Scripts.Render("~/bundles/mis")


    @Scripts.Render("~/bundles/upanel")
</head>
<body panel-body>

    <div id="iframe_div_for_report" style="display:none"></div>
    @*<nav class="navbar navbar-default navbar-fixed-top navbar-site">*@

