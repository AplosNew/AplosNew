                                </g>
                            </svg>
                        </a>
                    </li>


                    <li>
                        <img ng-src="POPResources/Organizations/{{CompanyLogo}}"
                             class="logo center-block" style="height: 30px;" alt="" />

                    </li>
                    <li ng-hide="CompanyFullName==null || CompanyFullName==undefined || CompanyFullName==''"><strong>Company:</strong> {{CompanyFullName}}</li>
                    <li ng-hide="plantName==null"><strong>Plant:</strong> {{plantName}}</li>
                    <li><strong>Panel:</strong> Application</li>
                    <li>
                    </li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    <li class="dropdown">
                        <a href="" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                            <img class="img-responsive img-circle" ng-src="{{userImage}}" style="height:30px;display:inline;" alt="" /> &nbsp;
                            @ViewBag.FullName <i class="fa fa-angle-down"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li style="white-space: nowrap;font-size: 9px;z-index:881"><strong>Last Login:</strong> @ViewBag.LastLoginTime</li>
                            <li ng-show="ShowHomeButton"><a ng-click="ShowHideFavouriteMenu();"><i class="glyphicon glyphicon-bookmark"></i> {{ShowFavouriteMenu?'Hide Quick Access':'Show Quick Access'}}</a></li>
                            <li><a href="{{bootPoint}}plant-selection"><i class="glyphicon glyphicon-refresh"></i> Switch Plant</a></li>
                            <li><a href="{{bootPoint}}user-password-change/@ViewBag.Name"><i class="fa fa-key"></i> Change Password</a></li>
                            <li><a href="{{bootPoint}}logout"><i class="fa fa-power-off"></i>  Logout</a></li>
                        </ul>
                    </li>
                </ul>

            </div>


        </div>
    </nav>


    <div class="container-fluid" id="main">
        <div class="row">
            <div ng-hide="isLeftMenuHide" class="col-sm-3 col-md-2 sidebar">
                <div style="position:sticky;top:0px;left:0px;background-color:#1c1f32;z-index:891">
                    <h1>
                        <a href="{{bootPoint}}dashboard" class="navbar-brand" style="cursor: default;margin-top: -6px;">
                            <img class="logo" src="images/aplos-logo.png" style="height:34px;" alt="">
                            <span>V-@typeof(WebApiApplication).Assembly.GetName().Version</span>
                        </a>
                    </h1>

                    <input ej-autocomplete id="AutoCompleteMenuSearch" e-showpopupbutton="true" e-popupwidth="100%" e-popupheight="300px" e-template="template" e-value="nullvalue" e-select="tocode" e-watermarktext="Search Menu" e-filterType="contains" e-datasource="ListMenuSearch" e-fields-text="Item" e-fields-value="Href" e-width="100%" />
                    <style type="text/css">
                        .e-atc .e-in-wrap, .e-atc .e-input, .e-atc-popup, .e-atc .e-options {
                            font-size: 9pt;
                            color: darkviolet;
                        }
                    </style>

                    <p ng-click="moduleShowHide();" style="font-size: 14px;font-weight:bold;color: white;padding-left: 16px;margin-bottom: -10px; cursor: pointer;margin-top: 4px;">{{menuModuleName}}</p>
                </div>
                <nav panel-menu class="main-nav">

                    <ul ng-show="showMenu=='Module'">
                        <li class="moule-menu" ng-repeat="module in menuModuleList">
                            <a ng-click="mpanelMenu(module.ModuleId, module.ModuleName)"><span class="fa fa-desktop"></span>{{module.ModuleName}}</a>
                        </li>
                    </ul>
                    <ul ng-show="showMenu=='Menu'">
                        <li ng-repeat="menuFrame in menuFrames">
                            <a><span class="glyphicon glyphicon-book"></span>{{menuFrame.MenuFrameName}}</a>

                            <ul>
                                <li ng-if="menuFrame.MenuGroups.length > 0" ng-repeat="menuGroup in menuFrame.MenuGroups">
                                    <a>{{menuGroup.MenuGroupName}}</a>
                                    <ul>

                                        <li ng-if="menuGroup.MenuSubGroups.length > 0" ng-repeat="menuSubGroup in menuGroup.MenuSubGroups">
                                            <a>{{menuSubGroup.MenuSubGroupName}}</a>
                                            <ul>
                                                <li style="padding-left:30px;" ng-repeat="menuSubG in menuSubGroup.MenuItems" data-placement="top" title="{{menuSubG.TooltipName}}" tooltip>

                                                    <a style="height:32px;position:relative;" href="{{bootPoint}}{{menuSubG.Href}}" ng-click="InsertMenuAccessLog(menuSubG)">
                                                        <span style="position: absolute; left: 4px; top: 9px; padding: 0px; height: 10px; width: 10px;">
                                                            <span ng-bind-html="menuSubG.Image"></span>

                                                        </span>
                                                        {{menuSubG.MenuItemName}}
                                                    </a>
                                                </li>
                                            </ul>
                                        </li>
                                        <li ng-repeat="menugrp in menuGroup.MenuItems" style="padding-left:20px;" data-placement="top" title="{{menugrp.TooltipName}}" tooltip>
                                            <a style="height:32px; position:relative;" href="{{bootPoint}}{{menugrp.Href}}" ng-click="InsertMenuAccessLog(menugrp)">
                                                <span style="position: absolute; left: 4px; top: 9px; padding: 0px; height: 10px; width: 10px;">
                                                    <span ng-bind-html="menugrp.Image"></span>
                                                </span>
                                                {{menugrp.MenuItemName}}
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                <li ng-repeat="menuItem in menuFrame.MenuItems" style="padding-left:9px;" data-placement="top" title="{{menuItem.TooltipName}}" tooltip>
                                    <a style="height:32px; position:relative;" href="{{bootPoint}}{{menuItem.Href}}" ng-click="InsertMenuAccessLog(menuItem)">
                                        <span style="position: absolute; left: 4px; top: 10px; padding: 0px; height: 10px; width: 10px;">
                                            <span ng-bind-html="menuItem.Image"></span>
                                        </span>
                                        {{menuItem.MenuItemName}} 
                                    </a>
                                </li>
                            </ul>


                        </li>
                    </ul>
                </nav>
            </div>
            <div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2 main">
                <div class="row" style="background-color:#1c1f32; position:sticky;top:50px;left:140px;z-index:870;">
                    <div class="col-sm-12 common-btn" ng-show="ShowFavouriteMenu" style="padding:0px; padding-left:24px; padding-right:100px;border-top:2px solid #545454">
                        <ul class="list-inline text-left" style="padding:2px;">
                            <li><span class="glyphicon glyphicon-bookmark aplosFavouriteMenu" ng-click="SaveFavouriteMenu();" style="padding:6px;font-size:12pt;color:white;"></span></li>
                            <li class="aplosFavouriteMenu dropdown" ng-repeat="x in FavouriteModuleData" style="padding:4px;">
                                <a href="" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false" style="color:white; font-size:10pt;">
                                    {{x.ModuleCode}} <i class="fa fa-angle-down"></i>
                                </a>
                                <ul class="dropdown-menu">
                                    <li ng-repeat="m in x.MenuList" class="aplosFavouriteMenuItems" style="padding:10px;width:200px;">
                                        <table>
                                            <tr>

                                                <td>  <a style="width:200px;color:white;" href="{{bootPoint}}{{m.Href}}"><span style="vertical-align:bottom" ng-bind-html="m.Image"></span> {{m.Description}} </a></td>
                                                <td style="width:20px;"> <span class="glyphicon glyphicon-trash" style="color:orangered" ng-click="DeleteFavouriteMenu(m.Href);"></span></td>
                                            </tr>
                                        </table>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="inner-content" @*style="position:relative;z-index:0;"*@>
                    <div style="padding: 0px; position: relative; float:left; top: -4px;"><span ng-bind-html="FormIcon"></span></div>
                    <div ng-view>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
    <noscript>
        JavaScript is disable in your browser. Please enable from browser settings.
    </noscript>
</body>

</html>

<style>
    .tooltipAplos {
        position: relative;
        /* display: inline-block;
        text-align: justify;*/
    }

        .tooltipAplos .tooltipAplostext {
            content: "";
            display: inline-block;
            width: 200px;
            visibility: hidden;
            background-color: lightgoldenrodyellow;
            border: 1px solid #ffd002;
            color: #000;
            text-align: center;
            border-radius: 2px;
            padding: 5px 0;
            position: absolute;
            z-index: 11111111;
            top: -5px;
            right: 110%;
        }

            .tooltipAplos .tooltipAplostext::after {
                display: inline-block;
                width: 100%;
                content: "";
                position: absolute;
                top: 50%;
                left: 100%;
                margin-top: -8px;
                border-width: 8px;
                border-style: solid;
                border-color: transparent transparent transparent #ffd002;
            }

        .tooltipAplos:hover .tooltipAplostext {
            visibility: visible;
        }

    .aplosFavouriteMenu {
        transition: background-color 0.5s ease;
        background-color: transparent;
        padding: 4px;
    }

        .aplosFavouriteMenu:hover {
            background-color: Highlight;
        }

    .aplosFavouriteMenuItems {
        transition: background-color 0.5s ease;
        background-color: #2c314e;
        padding: 4px;
    }

        .aplosFavouriteMenuItems:hover {
            background-color: Highlight;
        }
    /* .modal-content {
        margin-top: 100px;
    }*/

    .loaderr {
        width: 300px;
        height: 200px;
        background-color: #0780BA;
        color: #fff;
        padding: 100px;
        font-size: 25px;
    }

    .e-ddl {
        height: 22px;
    }

    .e-grid .e-headercelldiv {
        font-weight: bold;
        font-size: 8.5pt;
        display: block;
        border: 0 none;
        height: 29px;
        line-height: 29px;
        margin: -7px;
        padding: 0 .7em;
        text-align: left;
        white-space: nowrap;
        text-overflow: ellipsis;
        /*font-family: "Arial Narrow";*/
    }

    .e-grid .e-rowcell {
        border-width: 1px 0 0 1px;
        padding: .7em;
        line-height: 10px;
        white-space: nowrap;
        width: auto;
        vertical-align: middle;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .e-grid .e-gridheader .e-icon {
        color: white;
    }

    .e-grid.e-wrap .e-columnheader .e-headercelldiv {
        margin-bottom: 2px;
        margin-top: 0;
        font-size: 8.5pt;
    }

    .e-filterset:before {
        color: white;
    }

    .e-grid .e-headercell, .e-grid .e-headercell-hover {
        height: 30px !important;
    }

    .e-grid {
        font-size: 8.5pt !important;
    }

        .e-grid .e-content {
            min-width: 100%;
        }

        .e-grid .e-rowcell {
            padding-top: 3px !important;
            padding-bottom: 4px !important;
            padding-left: 4px !important;
            padding-right: 4px !important;
            font-size: 8.5pt;
        }

        .e-pager, .e-grid .e-pagerstatusbar {
            border: none;
            padding: 0px;
            margin: 0px;
            font-size: 8.5pt;
        }

        .e-grid .e-rowcell dl, menu, ol, ul {
            padding: 0px !important;
            margin: 0px !important;
        }

    e-grid .e-columnheader .wrap .e-headercelldiv {
        height: Auto;
    }

    .e-grid .e-excelfilter .e-btncontainer input {
        /*padding: .2em .4em .3em;*/
        padding: 0px;
    }

    .e-grid.e-dlgcontainer .e-dlgBtns .e-clear {
        padding: 3px;
    }

    .e-grid.e-dlgcontainer .e-dlgBtns .e-filter {
        padding: 3px;
    }

    ::-ms-clear {
        display: none;
    }

    .e-grid.filtered .e-filteredicon {
        color: red;
    }

    .e-grid .e-vhandle {
        background-color: #1c1f32;
    }

    .e-grid .e-hhandle {
        background-color: #1c1f32;
    }
</style>


