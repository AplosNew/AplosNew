<style>
	.PassedHoliday {
		background-color: #52b3d9 !important;
	}

	.NextHoliday {
		background-color: yellow !important;
	}

	.TodayHoliday {
		background-color: lightgreen !important;
	}

	.blink {
		animation: blink-animation 1s steps(5, start) infinite;
		-webkit-animation: blink-animation 1s steps(5, start) infinite;
	}

	@@keyframes blink-animation {
		to {
			visibility: hidden;
		}
	}

	@@-webkit-keyframes blink-animation {
		to {
			visibility: hidden;
		}
	}
</style>
<div @*ng-init="ShowHideSideBar();"*@ class="container-fluid">
	<div class="row">
		<div class="col-md-12" style="font-size: 30px;color: #343852;font-weight: 500;padding-bottom: 1%;margin-left: 88%;">aPOP</div>
		<div class="col-md-12" style="font-size: 15px;color: #343852;font-weight: 500;margin-left: 82%;">a Process Optimization Platform</div>
	</div>
	<div class="row">
		<div style="padding: 20px;"></div>
		<div class="col-sm-6">
			<div class="panel panel-default">
				<div class="panel-heading form-elements form-horizontal" style="height: 55px; background-color: #ffffff;">
					<div class="col-md-4" style="padding-top: 10px;padding-left: 1px;"><i class="glyphicon glyphicon-calendar"></i> Holiday List</div>
					<div class="col-md-8">
						<label class="col-md-2 control-label">Plant</label>
						<label class="col-md-10 control-label">{{plantName}}</label>
					</div>
				</div>
				<div class="panel-body">
					<div class="table-responsive modal-table">
						<table class="table table-striped ">
							<thead>
								<tr>
									<th>SL#</th>
									<th>Date</th>
									<th>Day</th>
									<th>Holiday Name</th>
								</tr>
							</thead>
							<tbody>
								<tr ng-repeat="x in holidayList" class="{{x.DayStatus}}">
									<td>{{$index+1}}</td>
									<td>{{x.OffDayDate | dateFiltering}}</td>
									<td>{{x.DayName}}</td>
                                    <td>
                                        {{x.HolidayName}}
                                        <sup ng-show="x.Blink" ng-class="x.Blink?'blink':''" style="font-size: 15px;color:red;">
                                            <i class="glyphicon glyphicon-star"></i>
                                        </sup>
                                    </td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
		<div class="col-sm-6">
			<div class="panel panel-default">
				<div class="panel-heading form-elements form-horizontal" style="height: 55px; background-color: #ffffff;">
					<div angucomplete-alt id="ex2" placeholder="Search employee by name" pause="300" selected-object="selectedPerson" remote-url="Employees/EmployeeInformation/GetEmployeeIndex?employeeName=" remote-url-data-field="results"
						 title-field="EmployeeName" description-field="DesignationName" image-field="EmpPicPath" minlength="1"
						 input-class="form-control form-control-small" match-class="highlight"
						 local-search="localSearch">
					</div>
				</div>
				<div class="panel-body">
					<div ng-show="selectedPerson">
                        <div class="col-md-9">
                            <b style="font-size: 20px;">{{selectedPerson.originalObject.EmployeeName}}<br /></b>
                            <br />
                            Employee Code: {{selectedPerson.originalObject.EmployeeCode}}<br />
                            Plant: {{selectedPerson.originalObject.Plant}}<br />
                            Department: {{selectedPerson.originalObject.DepartmentName}}<br />
                            Designation: {{selectedPerson.originalObject.DesignationName}}<br />
                            Legal Designation: {{selectedPerson.originalObject.LegalDesignation}}<br />
                            Email: {{selectedPerson.originalObject.EmailId}}<br />
                            Mobile: {{selectedPerson.originalObject.CellPhnNo}}<br />
                            Extension: {{selectedPerson.originalObject.ExtensionNo}}<br />
                        </div>
						<div class="col-md-3 text-right"><img src="{{selectedPerson.originalObject.EmpPicPath}}" style="height: 100px;width: 90px;" /><br /></div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>