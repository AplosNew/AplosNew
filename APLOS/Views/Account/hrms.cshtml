<!DOCTYPE html>
<html lang="en" ng-app="loginApp" spellcheck="true">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta charset="utf-8" />
    <base href="@ViewBag.BasePath">
    <title>{{title}}</title>
    <link rel="shortcut icon" href="images/title.gif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    @Scripts.Render("~/bundles/jq")
    @Scripts.Render("~/bundles/angular")
    @Scripts.Render("~/bundles/login")
</head>
<body aplos-focus class="login-bg">
    <div ng-controller="hrmsPanelLogin" class="login-content" ng-form name="upanelLoginForm">
        <div class="company-name company-name-login">
            <img class="logo" src="{{companyGroupLogo}}" alt="Logo">
            <p>{{companyGroupName}}</p>
        </div>
        <form class="login-inner" autocomplete="off">
            <p id="error" class="login-error" ng-hide="errorHide">{{errorText}}</p>
            <h4>Please login your account</h4>
            <input type="hidden" id="timezoneoffset" name="timezoneoffset" value="{{timezoneoffset}}" />
            <input type="hidden" id="servicepanel" name="servicepanel" value="{{servicepanel}}" />
            <input type="hidden" id="authToken" name="authenticationToken" value="@ViewBag.AuthToken" />
            <input type="hidden" id="groupId" name="groupId" value="@ViewBag.GroupId" />
            <input type="hidden" id="groupName" name="groupName" value="{{companyGroupName}}" />
            <input type="hidden" id="moduleId" name="moduleId" value="{{moduleId}}" />
            <input type="hidden" id="companyName" name="companyName" value="{{companyName}}" />
            <div class="form-group" show-errors>
                <div class="input-group input-select show-message">
                    <span class="input-group-addon"><span class="glyphicon glyphicon-home"></span></span>
                    <select class="form-control" ng-model="companyId" name="Company name" tabindex="1"
                            ng-options="item.Value as item.Text for item in companyList" required autofocus ng-change="getPlant(companyId)"></select>
                </div>
            </div>
            <div class="form-group" show-errors>
                <div class="input-group input-select show-message">
                    <span class="input-group-addon"><span class="glyphicon glyphicon-home"></span></span>
                    <select class="form-control" ng-model="plantId" name="plant name" tabindex="2"
                            ng-options="item.Value as item.Text for item in plantList| orderBy:'Text'" required ng-change="getPlantName(companyId)"></select>
                </div>
            </div>
            <div class="form-group" show-errors>
                <div class="input-group show-message">
                    <span class="input-group-addon"><span class="glyphicon glyphicon-user"></span></span>
                    <input type="text" class="form-control" ng-model="userId" placeholder="Username" name="UserId" required tabindex="3" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <div class="input-group show-message">
                    <span class="input-group-addon"><span class="glyphicon glyphicon-lock"></span></span>
                    <input type="password" ng-model="password" class="form-control" placeholder="Password" name="Password" required tabindex="4" />
                </div>
            </div>
            <div class="checkbox-site">
                <label>
                    <input type="checkbox" ng-model="remember">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Remember Me
                </label>
                <button tabindex="5" type="submit" class="btn btn-default pull-right" ng-click="Login()"><span class="glyphicon glyphicon-log-in"></span> Login</button>
            </div>
        </form>
    </div>
    <noscript>
        JavaScript is disable in your browser. Please enable from browser settings.
    </noscript>
    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
</body>
</html>