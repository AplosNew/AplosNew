<div class="row" id="date" style="border:1px solid #d8d7d7; margin:-2px;">
    <div class="col-md-3">
        <div class="form-group form-element-ctrl">
            <div class="show-message">
                <p>
                    <input type="text" name="Date" ng-model="Date" datepicker class="form-control datepicker" required tabindex="1" style="margin-top: 7px;margin-bottom: -4px;">
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-1"><button ng-click="dFunction()" class="btn" style="margin-top:4px;"><i class="glyphicon glyphicon-refresh"></i></button> </div>
    <div class="col-md-4">
        <div class="col-md-12">
            <div class="col-md-6" style="margin-top: 7px;margin-bottom: -4px;">
                <span style="margin-top: 7px;margin-bottom: -4px;"> Employee Category:</span>               
            </div>
            <div class="col-md-6">               
                <div class="select-style" style="margin-top: 7px;margin-bottom: -4px;">
                    <select ng-model="mpDrpDownModel.EmplyeeTypeOrCategoryId" ng-change="EmpCategory(mpDrpDownModel.EmplyeeTypeOrCategoryId);">
                        <option value="">Select All</option>
                        <option ng-repeat="option in docEmployeeCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="radio">
            <label style="margin-left: 37%;"><input type="radio" name="status" ng-model="hrStatus.pstatus" value="Default" ng-change="directIndirect();"><span class="cr"><i class="cr-icon"></i></span>Overall</label>
            <label style="position:relative;"><input type="radio" name="status" ng-model="hrStatus.pstatus" value="Direct" ng-change="directIndirect()"><span class="cr"><i class="cr-icon"></i></span>Direct</label>
            <label style="position:relative;"><input type="radio" name="status" ng-model="hrStatus.pstatus" value="Indirect" ng-change="directIndirect()"><span class="cr"><i class="cr-icon"></i></span>Indirect</label>
        </div>
    </div>
</div>
