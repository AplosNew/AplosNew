                    <thead><tr><td colspan="3" style="border-top: 1px solid darkgrey;"><b>Manpower Budget Status</b></td></tr></thead>
                    <tbody>
                        <tr ng-click="GetModalBudgetSummaryJS(0);">
                            <td>Budgeted</td>
                            <td><span style="background-color:rgba(46, 204, 113,.6); border:.5px solid rgba(46, 204, 113,.6)"> &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;&nbsp;</span></td>
                            <td style="text-align:right;cursor:pointer;" class="hoverItem">{{proposedTotalEmp}}</td>
                        </tr>
                        <tr ng-click="getModalEmployeeSummaryJS(0);">
                            <td>On Role</td>
                            <td><span style="background-color:rgba(240, 52, 52, .6); border:.5px solid rgba(240, 52, 52, .8)"> &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;&nbsp;</span></td>
                            <td style="text-align:right;cursor:pointer;" class="hoverItem">{{currentTotalEmp}}</td>
                        </tr>
                        <tr ng-click="GetShortSummary(0);" class="hoverItem">
                            <td>Short</td>
                            <td></td>
                            <td style="text-align:right;cursor:pointer;" class="hoverItem">{{Short}}</td>
                        </tr>
                        <tr ng-click="ExcessSummary(0);">
                            <td>Excess</td>
                            <td></td>
                            <td style="text-align:right;cursor:pointer;" class="hoverItem">{{excess}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="Detail" class="col-lg-7" style="padding-left:0%">
        <div class="row">
            <div class="" style="margin-left:0%;  max-height:375px; max-width:100%;">
                <table class="table table-hover" style="overflow-y:scroll;border:1px solid black; box-shadow:1px 1px 1px 1px grey;">
                    <thead>
                        <tr>
                            <th>{{ColList[index+2].ColumnName}}</th>
                            <th>On Role</th>
                            <th>Budgeted</th>
                            <th>Short</th>
                            <th>Excess</th>
                            <th>On Role Salary <br /><span style="background-color:rgba(240, 52, 52, .6); border:.5px solid rgba(240, 52, 52, .8)"> &nbsp;&nbsp; &nbsp;&nbsp;</span></th>
                            <th>Budgeted Salary <br /> <span style="background-color:rgba(46, 204, 113,.6); border:.5px solid rgba(46, 204, 113,.6)">&nbsp;&nbsp; &nbsp;&nbsp;</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in list">
                            <td style="padding:2px; cursor:pointer;" class="hoverItem" ng-click="setIndex(x);GetDetailDrillDownTableJS(x)" >{{x.UserName}}</td>
                            <td style="padding:2px; text-align:right;cursor:pointer;" class="hoverItem" ng-click="GetModalEmployeeDetailJS(0,x);">{{x.TotalManpower}}</td>
                            <td style="padding:2px; text-align:right;cursor:pointer;" class="hoverItem" ng-click="GetModalBudgetDetailJS(0,x)">{{x.ProposedManpowerBudget}}</td>
                            <td style="padding:2px; cursor:pointer;text-align:right" class="hoverItem" ng-click="GetShortDetail(0,x)">{{x.Short}}</td>
                            <td style="padding:2px; cursor:pointer; text-align:right" class="hoverItem" ng-click="GetExcessDetail(0,x)">{{x.Excess}}</td>
                            <td style="padding:2px; text-align:right">{{x.OnRoleSalaryC| number:0}}</td>
                            <td style="padding:2px; text-align:right">{{x.ProposedSalaryC| number:0}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <br /><div class="col-lg-1"></div>
            <div class="col-lg-10" style="box-shadow:1px 1px 1px 1px grey;">

                <canvas id="salBarChart" width="300" height="150"></canvas>
            </div>
            <div class="col-lg-1"></div>
        </div>
    </div>
</div>

