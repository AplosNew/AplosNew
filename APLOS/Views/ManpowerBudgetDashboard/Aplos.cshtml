<style>
    #wizard-container ul li {
        display: inline;
    }

        #wizard-container ul li a {
            display: block;
            font-size: 12px;
            font-family: 'open Sans';
            float: left;
            height: 40px;
            background: #242841;
            text-align: center;
            padding: .5px 1px 0 18px;
            position: relative;
            margin: 0 5px 0px 0;
            text-decoration: none;
            color: #fff;
            display: inline-block;
        }

            #wizard-container ul li a:after {
                content: "";
                border-top: 20px solid transparent;
                border-bottom: 20px solid transparent;
                border-left: 20px solid #242841;
                position: absolute;
                right: -20px;
                top: 0;
                z-index: 1;
            }

            #wizard-container ul li a:before {
                content: "";
                position: absolute;
                border-top: 20px solid transparent;
                border-bottom: 20px solid transparent;
                border-left: 20px solid #FFFFFF;
                left: 0;
                top: 0;
            }

        #wizard-container ul li:first-child a:before {
            display: none;
        }

    .exceess {
        background-color: orangered;
    }

    .compare {
        background-color: orangered;
        color: white !important;
    }

    .short {
        background-color: #f1c40f;
    }

    canvas #ManPowerbarChart {
        width: 85% !important;
        height: 50% !important;
    }

    canvas #salBarChart {
        width: 85% !important;
        height: 30% !important;
    }

    .sortorder {
        content: '\25b3';
        content: '\25BD';
    }

        .sortorder:after {
            content: '\25b3';
        }

        .sortorder.reverse:after {
            content: '\25BD';
        }
</style>
<div class="col-md-11">
    <h4 style="margin-top:-10px;margin-bottom:25px;"><span class="glyphicon glyphicon-stats"></span>&nbsp;Manpower Budget Dashboard</h4>
</div>
