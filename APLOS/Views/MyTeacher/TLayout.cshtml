<!DOCTYPE html>
<html lang="en" ng-app="tpanelApp" spellcheck="true">
<head>
	<link href="~/SyncfusionLib/css/web/default-theme/ej.web.all.min.css" rel="stylesheet" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
	<meta charset="utf-8" />
	<base href="@ViewBag.BasePath">
	<title>{{title}}</title>
	<link rel="icon" href="images/title.gif" type="image/gif" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
	@Scripts.Render("~/bundles/taskmanagement")

	@Styles.Render("~/bundles/css")
	@Styles.Render("~/bundles/fonts")
	@Scripts.Render("~/bundles/jq")
	@Scripts.Render("~/bundles/angular")
	@Scripts.Render("~/bundles/syncfusion")
	<script src="~/Scripts/moment.js"></script>
	<script src="~/Scripts/calendar.js"></script>
	<script src="~/Scripts/fullcalendar.js"></script>
	<script src="~/Scripts/gcal.js"></script>
	<script src="~/Scripts/ui-bootstrap-tpls.min.js"></script>
	@Scripts.Render("~/bundles/currencies")
	@Scripts.Render("~/bundles/accounts")
	@Scripts.Render("~/bundles/addresses")
	@Scripts.Render("~/bundles/employees")
	@Scripts.Render("~/bundles/parties")
	@Scripts.Render("~/bundles/products")
	@Scripts.Render("~/bundles/materials")
	@Scripts.Render("~/bundles/IssueTracker")
	@Scripts.Render("~/bundles/TaskScheduler")
	@Scripts.Render("~/bundles/leave")
	@Scripts.Render("~/bundles/humanResource")
	@Scripts.Render("~/bundles/tpanel")


</head>
<body panel-body>
	<nav class="navbar navbar-default navbar-fixed-top navbar-site">
		<div class="container-fluid">
			<div class="navbar-header">
				<button aria-controls="navbar" aria-expanded="false" data-target="#navbar" data-toggle="collapse" class="navbar-toggle collapsed" type="button">
					<span class="sr-only">Toggle navigation</span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
				</button>
			</div>
			<div class="navbar-collapse collapse" id="navbar">
				<ul class="nav navbar-nav">
					<li><a ng-click="ShowHideSideBar()" class="nav-control"><span aria-hidden="true" class="glyphicon glyphicon-align-left"></span></a></li>
					<li><img class="logo center-block" src="{{companyGroupLogo}}" alt="" style="height: 30px;"></li>
					<li ng-hide="plantName==null"><strong>Plant:</strong> {{plantName}}</li>
					<li><strong>Last Login:</strong> @ViewBag.LastLoginTime</li>
				</ul>
				<ul class="nav navbar-nav navbar-right">
					<li class="dropdown">
						<a class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
							<img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" ng-src="{{MyAppuserImage}}@ViewBag.EmpPicPath" style="height:30px;display:inline; border-radius:50%" alt="" /> &nbsp;
							@ViewBag.FullName <i class="fa fa-angle-down"></i>
						</a>
						<ul class="dropdown-menu">
							<li><a href="{{bootPoint}}employee-job-description"><i class="glyphicon glyphicon-list-alt"></i> My Job Description</a></li>
							<li><a href="{{bootPoint}}password-change/@ViewBag.EmployeeId"><i class="fa fa-key"></i> Change Pin</a></li>
							<li><a href="{{bootPoint}}logout"><i class="fa fa-power-off"></i> Logout</a></li>
						</ul>
					</li>
				</ul>
			</div>
		</div>
	</nav>
	<div class="container-fluid" id="main">
		<div class="row">
			
			<div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2 main">
				<div class="inner-content">
					<div ng-view></div>
				</div>
			</div>
		</div>
	</div>
	<div class="loader" data-loader>
		Please wait
		<div class="bounce1"></div>
		<div class="bounce2"></div>
		<div class="bounce3"></div>
	</div>
	<ej-dialog id="dialogMessage" title="Error" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#main" e-minwidth="200" e-open="enableBtn">
		<div class="col-xs-12">
			{{ Message }}
		</div>
	</ej-dialog>
	<noscript>
		JavaScript is disable in your browser. Please enable from browser settings.
	</noscript>
</body>
</html>

<style>
	.loaderr {
		width: 300px;
		height: 200px;
		background-color: #0780BA;
		color: #fff;
		padding: 100px;
		font-size: 25px;
	}

	.e-grid .e-headercelldiv {
		font-weight: bold;
		font-size: 8.5pt;
		display: block;
		border: 0 none;
		height: 29px;
		line-height: 29px;
		margin: -7px;
		padding: 0 .7em;
		text-align: left;
		white-space: nowrap;
		text-overflow: ellipsis;
		/*font-family: "Arial Narrow";*/
	}

	.e-grid .e-rowcell {
		border-width: 1px 0 0 1px;
		padding: .7em;
		line-height: 10px;
		white-space: nowrap;
		width: auto;
		vertical-align: middle;
	}

	.e-gridheader .e-headercell {
		background-color: #1c1f32;
		color: White;
		min-height: 100%;
		border-bottom-color: #8B4513;
	}

	.e-grid .e-gridheader .e-icon {
		color: white;
	}

	.e-grid.e-wrap .e-columnheader .e-headercelldiv {
		margin-bottom: 2px;
		margin-top: 0;
		font-size: 8.5pt;
	}

	.e-filterset:before {
		color: white;
	}

	.e-grid .e-headercell, .e-grid .e-headercell-hover {
		height: 30px !important;
	}

	.e-grid {
		font-size: 8.5pt !important;
	}

		.e-grid .e-rowcell {
			/*padding-top: 2px !important;
			padding-bottom: 4px !important;
			padding-left: 4px !important;
			padding-right: 4px !important;*/
			font-size: 8.5pt;
		}

		.e-pager, .e-grid .e-pagerstatusbar {
			border: none;
			padding: 0px;
			margin: 0px;
			font-size: 8.5pt;
		}

		.e-grid .e-rowcell dl, menu, ol, ul {
			padding: 0px !important;
			margin: 0px !important;
		}

	e-grid .e-columnheader .wrap .e-headercelldiv {
		height: Auto;
	}

	.e-grid .e-excelfilter .e-btncontainer input {
		/*padding: .2em .4em .3em;*/
		padding: 0px;
	}

	.e-grid.e-dlgcontainer .e-dlgBtns .e-clear {
		padding: 3px;
	}

	.e-grid.e-dlgcontainer .e-dlgBtns .e-filter {
		padding: 3px;
	}

	::-ms-clear {
		display: none;
	}

	.e-grid.filtered .e-filteredicon {
		color: red;
	}

	.e-grid .e-vhandle {
		background-color: #1c1f32;
	}

	.e-grid .e-hhandle {
		background-color: #1c1f32;
	}
</style>