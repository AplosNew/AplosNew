<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>PIN Change</h3>
<div class="form-element-ctrl form-horizontal" ng-form name="userPasswordChangeForm">
    <fieldset class="col-xs-12 col-sm-7 col-md-7 scheduler-border">
        <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top:18px;">
            <input type="hidden" ng-model="user.UserId">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Old PIN<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="password" name="Old Password" ng-model="user.OldPassword" class="form-control" required tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">New PIN<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input name="Password" type="password" ng-model="user.Password" class="form-control" id="pwd" maxlength="6" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">New Confirm PIN<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="password" name="Confirm Password" ng-model="user.ConfirmPassword" class="form-control" id="Conpwd" maxlength="6" required tabindex="3">
                    <p class="msg-error" ng-show="user.ConfirmPassword != user.Password">These pin don't match. Try again?</p>
                </div>
            </div>
        </div>
    </fieldset>
</div>
<div class="common-btn">
    <ul class="list-inline text-right">
        <li><button class="btn" ng-click="Save();"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
    </ul>
</div>