<!DOCTYPE html>
<html lang="en" ng-app="apanelLoginApp" spellcheck="true">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta charset="utf-8" />
    <base href="@ViewBag.BasePath">
    <title>{{title}}</title>
    <link rel="shortcut icon" href="images/title.gif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    @Scripts.Render("~/bundles/jq")
    @Scripts.Render("~/bundles/angular")
    @Scripts.Render("~/bundles/apanellogin")
</head>
<body aplos-focus class="login-bg">
    <div ng-controller="apanelLoginController" class="login-content" ng-form name="apanelLoginForm">
        <div class="company-name company-name-login">
            <img class="logo" src="{{companyGroupLogo}}">
            <p>{{companyGroupName}}</p>
        </div>
        <form class="login-inner" autocomplete="off">
            <p id="error" class="login-error" ng-show="errorText!=null">{{errorText}}</p>
            <h4>Please login your Administration Panel</h4>
            <input type="hidden" id="timezoneoffset" name="timezoneoffset" value="{{timezoneoffset}}" />
            <input type="hidden" id="servicepanel" name="servicepanel" value="{{servicepanel}}" />
            <input type="hidden" id="authToken" name="authenticationToken" value="@ViewBag.AuthToken" />
            <input type="hidden" id="groupId" name="groupId" value="@ViewBag.GroupId" />
            <input type="hidden" id="groupName" name="groupName" value="{{companyGroupName}}" />
            <input type="hidden" id="returnUrl" name="returnUrl" value="{{returnUrl}}" />
            <div class="form-group" show-errors>
                <div class="input-group show-message">
                    <span class="input-group-addon"><span class="glyphicon glyphicon-user"></span></span>
                    <input tabindex="1" ng-keypress="clearMsg();" type="text" class="form-control" ng-model="userId" placeholder="Username" name="UserId" id="UserId" required autofocus />
                </div>
            </div>
            <div class="form-group" show-errors>
                <div class="input-group show-message">
                    <span class="input-group-addon"><span class="glyphicon glyphicon-lock"></span></span>
                    <input tabindex="2" ng-keypress="clearMsg();" ng-enter="Login()" type="password" ng-model="password" class="form-control" placeholder="Password" name="Password" id="Password" required />
                </div>
            </div>
            @*<div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="remember">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Remember Me
                    </label>
                    <button tabindex="4" type="submit" class="btn btn-default pull-right" ng-click="Login()"><span class="glyphicon glyphicon-log-in"></span> Login</button>
                </div>*@
            <div style="padding-bottom: 13px;">
                <button tabindex="3" type="submit" class="btn btn-default pull-right" ng-click="Login()"><span class="glyphicon glyphicon-log-in"></span> Login</button>
            </div>
        </form>
    </div>
    <noscript>
        JavaScript is disable in your browser. Please enable from browser settings.
    </noscript>
    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
</body>
</html>