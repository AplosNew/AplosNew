<style>
    .loaderr {
        width: 300px;
        height: 200px;
        background-color: #0780BA;
        color: #fff;
        padding: 100px;
        font-size: 25px;
    }

    .e-grid .e-headercelldiv {
        font-weight: bold;
        font-size: 8.5pt;
        display: block;
        border: 0 none;
        height: 29px;
        line-height: 29px;
        margin: -7px;
        padding: 0 .7em;
        text-align: left;
        white-space: nowrap;
        text-overflow: ellipsis;
        /*font-family: "Arial Narrow";*/
    }

    .e-grid .e-rowcell {
        border-width: 1px 0 0 1px;
        padding: .7em;
        line-height: 10px;
        white-space: nowrap;
        width: auto;
        vertical-align: middle;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .e-grid .e-gridheader .e-icon {
        color: white;
    }

    .e-grid.e-wrap .e-columnheader .e-headercelldiv {
        margin-bottom: 2px;
        margin-top: 0;
        font-size: 8.5pt;
    }

    .e-filterset:before {
        color: white;
    }

    .e-grid .e-headercell, .e-grid .e-headercell-hover {
        height: 30px !important;
    }

    .e-grid {
        font-size: 8.5pt !important;
    }

        .e-grid .e-rowcell {
            padding-top: 2px !important;
            padding-bottom: 4px !important;
            padding-left: 4px !important;
            padding-right: 4px !important;
            font-size: 8.5pt;
        }

        .e-pager, .e-grid .e-pagerstatusbar {
            border: none;
            padding: 0px;
            margin: 0px;
            font-size: 8.5pt;
        }

        .e-grid .e-rowcell dl, menu, ol, ul {
            padding: 0px !important;
            margin: 0px !important;
        }

    e-grid .e-columnheader .wrap .e-headercelldiv {
        height: Auto;
    }

    .e-grid .e-excelfilter .e-btncontainer input {
        /*padding: .2em .4em .3em;*/
        padding: 0px;
    }

    .e-grid.e-dlgcontainer .e-dlgBtns .e-clear {
        padding: 3px;
    }

    .e-grid.e-dlgcontainer .e-dlgBtns .e-filter {
        padding: 3px;
    }

    ::-ms-clear {
        display: none;
    }

    .e-grid.filtered .e-filteredicon {
        color: red;
    }
    .e-grid .e-vhandle {
        background-color: #1c1f32;
    }

    .e-grid .e-hhandle {
        background-color: #1c1f32;
    }
</style>
