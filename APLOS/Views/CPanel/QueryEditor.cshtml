<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Query Editor</h3>
<style>
	table {
		border-collapse: collapse;
		width: 100%;
		font-family: serif;
	}

	td, th {
		border: 1px solid #dddddd;
		text-align: left;
		padding: 3px;
		white-space: nowrap;
	}

	th {
		text-align: left;
		font-weight: 100;
	}
</style>
<div class="form-elements form-horizontal" ng-form="queryEditorNewForm">
	<ul class="list-inline" style="margin-top:-14px;margin-bottom:2px;">
		<li><button ng-click="run();" class="btn btn-sm"><i class="glyphicon glyphicon-play"></i></button></li>
		<li><button style="margin-left: -11px;" ng-click="clear();" class="btn btn-sm"><i class="glyphicon glyphicon-refresh"></i></button></li>
		<li><button style="margin-left: -11px;" ng-click="exportToExcel('tbl');" class="btn btn-sm">Excel</button></li>
	</ul>
	<div class="col-md-12">
		<div class="form-group">
			<textarea inputid="" class="form-control" style="resize:vertical" rows="5" ng-model="query"></textarea>
		</div>
		<p class="msg-error" ng-hide="errorText==null">{{errorText}}</p>
	</div>
	<span style="font-size:16px;">
		<span style="font-family:arial,helvetica,sans-serif;">

		</span>
	</span>
</div>
<div class="clearfix"></div>
<div class="table-responsive">
	{{resultList.length}} rows
	<table id="tbl">
		<thead>
			<tr><th ng-repeat="x in headerList">{{x.Text}}</th></tr>
		</thead>
		<tbody>
			<tr ng-repeat="x in resultList">
				<td ng-repeat="hh in headerList">{{x[hh.Value]}}</td>
			</tr>
		</tbody>
	</table>
</div>