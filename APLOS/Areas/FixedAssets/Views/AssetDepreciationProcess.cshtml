
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Depreciation Process</h3>
<div class="form-elements form-horizontal" ng-form="from0">
    <div class="tab-design " id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Depreciation Process</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);getData()" href="" aria-controls="general" role="tab" data-toggle="tab">Depreciation Process List</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-md-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-3  control-label">Fiscal Year<sup>*</sup></label>
                            <div class="col-sm-9 show-message">
                                <div class="select-style">
                                    <select name="Fiscal Year" ng-model="depreciationProcess.FiscalYearId" class="col-sm-3 form-control"
                                            ng-change="getFiscalYearData()" ng-options="item.Value as item.Text for item in fiscalYearList" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors id="div_ToDate">
                            <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                            <div class="col-sm-9  show-message">
                                <input type="text" name="To Date" ng-model="depreciationProcess.ToDate" datepicker tabindex="3" class="form-control">
                            </div>
                        </div>
                        <div class="form-group" show-errors id="div_ProcessName">
                            <label class="col-sm-3 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-9  show-message">
                                <input type="text" name="User Name" ng-model="depreciationProcess.ProcessName" tabindex="3" class="form-control" required>
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="getFixedAssetMastersData();" ng-enter="getFixedAssetMastersData();" title="Search" class="btn"><i class="glyphicon glyphicon-refresh"></i>Search</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors id="div_StartDate">
                            <label class="col-sm-3 control-label">Start Date<sup>*</sup></label>
                            <div class="col-sm-9 show-message">
                                <input type="text" name="Start Date" ng-model="depreciationProcess.StartDate" tabindex="2" class="form-control" disabled>
                            </div>
                        </div>
                        <div class="form-group" show-errors id="div_EndDate">
                            <label class="col-sm-3 control-label">End Date<sup>*</sup></label>
                            <div class="col-sm-9  show-message">
                                <input type="text" name="End Date" ng-model="depreciationProcess.EndDate" tabindex="3" class="form-control" disabled>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="row">
                    <div class="col-md-12">
                        <div style="color:black;" id="GridFixedAssetMastersList"
                             ej-grid e-datasource="fixedAssetMastersList"
                             e-allowfiltering="true"
                             e-allowpaging="true"
                             e-gridlines="vertical" e-allowscrolling="true"
                             e-filtersettings-filterType="excel"
                             e-enabletouch="false"
                             e-allowresizing="true"
                             e-allowselection="false"
                             e-templaterefresh="refreshTemplateAssetMaster"
                             e-allowsorting="true">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplate" e-template="#checkdepreciationProcess" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="30" e-textalign="center"></div>
                                <div e-column e-field="UserName" e-headertext="Asset Master" e-width="50" e-textalign="center"></div>
                                <div e-column e-field="FixedAssetCategory" e-headertext="Category" e-width="50" e-textalign="center"></div>
                                <div e-column e-field="FixedAssetSubCategory" e-headertext="Sub Category" e-width="40" e-textalign="center"></div>
                                <div e-column e-field="AssetType" e-headertext="Asset Type" e-width="40" e-textalign="center"></div>
                                <div e-column e-field="DepreciationRules" e-headertext="Depreciation Rules" e-width="60" e-textalign="center"></div>
                                <div e-column e-field="ProcessStatus" e-headertext="Process Status" e-width="80" e-textalign="center"></div>

                            </div>
                        </div>

                        <script type="text/template" id="checkdepreciationProcess">
                            <input type="checkbox" ng-model="data.isSelected" ng-checked="data.isSelected" ng-click="$parent.pushInTempListforProcess($event,data);">
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>
                        <br />
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Process </button></li>
                            </ul>
                        </div>
                    </div>


                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row text-right aplos-grid-toggle">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByDepreciationProcessData">
                                            <option ng-repeat="option in searchByListDepreciationProcessData" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchDepreciationProcessData" ng-enter="getData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table aplos-grid-toggle">
                    <div style="color:black;" id="GridMaster" ej-grid e-datasource="masterList" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="AssetDepreciationId" e-headertext="Id" e-width="20"></div>
                            <div e-column e-field="ProcessName" e-headertext="Process Name" e-width="90" e-filter="false"></div>
                            <div e-column e-field="ProcessDate" e-headertext="Process Date" e-width="30" e-filter="false"></div>
                            <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="30"></div>
                            <div e-column e-field="Status" e-headertext="Status" e-width="40"></div>
                            <div e-column e-type="numeric" e-format="{0:0.00}" e-field="DepreciationAmount" e-headertext="Depreciation Amount" e-width="40"></div>
                            <div e-column e-template="#ShowActionButtonsassigned" e-headertext="Actions" e-width="50" e-textalign="center"></div>
                        </div>
                    </div>
                    <script type="text/ng-template" id="ShowActionButtonsassigned">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-left">
                                <li>
                                    <div ej-tooltip e-showshadow="true" e-content="Excel" ng-click="$parent.onClickReportDownloadExcel(data);" e-width="width">
                                        <button class="btn" style="background-color: #1c1f32;"><i class="fa fa-file-excel-o"></i></button>
                                    </div>
                                </li>
                                <li>
                                    <div ej-tooltip e-showshadow="true" e-content="Pdf" ng-click="$parent.onClickReportDownloadPdf(data);" e-width="width">
                                        <button class="btn" style="background-color: #1c1f32;"><i class="fa fa-file-pdf-o"></i></button>
                                    </div>
                                </li>
                                <li ng-show="data.VoucherNo==''">
                                    <a class="btn btn-action" ng-click="$parent.confirmDelete(this);" title="Delete" href=""><i class=""></i>Delete</a>
                                </li>
                            </ul>
                        </div>
                    </script>
                </div>

            </div>
        </div>
    </div>
   
</div>

<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(assetDepreciationId)"></confirm-archive-generic>




















