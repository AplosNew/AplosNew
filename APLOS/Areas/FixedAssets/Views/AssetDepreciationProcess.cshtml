
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Depreciation Process</h3>
<div class="form-elements form-horizontal" ng-form="from0">
    <div class="row">
        <div class="col-md-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-3  control-label">Fiscal Year<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <div class="select-style">
                        <select name="Fiscal Year" ng-model="depreciationProcess.FiscalYearId" class="col-sm-3 form-control"
                                ng-change="getFiscalYearData()" ng-options="item.Value as item.Text for item in fiscalYearList" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors id="div_ToDate">
                <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-9  show-message">
                    <input type="text" name="To Date" ng-model="depreciationProcess.ToDate" datepicker tabindex="3" class="form-control">
                </div>
            </div>
            <div class="form-group" show-errors id="div_ProcessName">
                <label class="col-sm-3 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-9  show-message">
                    <input type="text" name="User Name" ng-model="depreciationProcess.ProcessName"  tabindex="3" class="form-control" required>
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="getFixedAssetMastersData();" ng-enter="getFixedAssetMastersData();" title="Search" class="btn"><i class="glyphicon glyphicon-refresh"></i>Search</button></li>
                </ul>
            </div>
        </div>
        <div class="col-md-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors id="div_StartDate">
                <label class="col-sm-3 control-label">Start Date<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <input type="text" name="Start Date" ng-model="depreciationProcess.StartDate"  tabindex="2" class="form-control" disabled>
                </div>
            </div>
            <div class="form-group" show-errors id="div_EndDate">
                <label class="col-sm-3 control-label">End Date<sup>*</sup></label>
                <div class="col-sm-9  show-message">
                    <input type="text" name="End Date" ng-model="depreciationProcess.EndDate"  tabindex="3" class="form-control" disabled>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12">
            <div style="color:black;" id="GridFixedAssetMastersList"
                 ej-grid e-datasource="fixedAssetMastersList"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-gridlines="vertical" e-allowscrolling="true"
                 e-filtersettings-filterType="excel"
                 e-enabletouch="false"
                 e-allowresizing="true"
                 e-allowselection="false"
                 e-templaterefresh="refreshTemplateAssetMaster"
                 e-allowsorting="true">
                <div e-columns>
                    <div e-column e-headertext="All" e-headertemplateid="#headerTemplate" e-template="#checkdepreciationProcess" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="Code" e-headertext="Code" e-width="30" e-textalign="center"></div>
                    <div e-column e-field="UserName" e-headertext="Asset Master" e-width="50" e-textalign="center"></div>
                    <div e-column e-field="FixedAssetCategory" e-headertext="Category" e-width="50" e-textalign="center"></div>
                    <div e-column e-field="FixedAssetSubCategory" e-headertext="Sub Category" e-width="40" e-textalign="center"></div>
                    <div e-column e-field="AssetType" e-headertext="Asset Type" e-width="40" e-textalign="center"></div>
                    <div e-column e-field="DepreciationRules" e-headertext="Depreciation Rules" e-width="60" e-textalign="center"></div>
                    <div e-column e-field="ProcessStatus" e-headertext="Process Status" e-width="80" e-textalign="center"></div>

                </div>
            </div>

            <script type="text/template" id="checkdepreciationProcess">
                <input type="checkbox" ng-model="data.isSelected" ng-checked="data.isSelected" ng-click="$parent.pushInTempListforProcess($event,data);">
            </script>
            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
            </script>
            <br />
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Process </button></li>
                </ul>
            </div>
        </div>


    </div>
</div>






















