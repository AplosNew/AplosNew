<togglable name="FixedAsset Capitalize"></togglable>
<div class="form-elements form-horizontal" ng-form="modelNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Information</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">GRN Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="DocRef" ng-model="modelNew.GRNDate" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="popUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group" style="margin-bottom: 0px;" ng-hide="modelNew.EmployeeId==null">
                <label class="col-sm-3 control-label"><b>EmployeeCode :</b></label>
                <label class="col-sm-9 control-label"><b>{{modelNew.EmployeeCode}}</b></label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Vendor :</label>
                <label class="col-sm-9 control-label">{{modelNew.PartyCode}} - {{modelNew.PartyName}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Invoicing By :</label>
                <label class="col-sm-9 control-label">{{modelNew.InvoicingBy}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Invoicing Address :</label>
                <label class="col-sm-9 control-label" style="white-space: pre-line;">{{modelNew.InvoicingByAddress}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Gate Entry No :</label>
                <label class="col-sm-9 control-label">{{modelNew.GateEntryNo}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">GRN No :</label>
                <label class="col-sm-9 control-label">{{modelNew.GRNNo}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">PO No :</label>
                <label class="col-sm-9 control-label">{{modelNew.POId}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Payment Term :</label>
                <label class="col-sm-9 control-label">{{modelNew.PaymentTermName}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Base on due date :</label>
                <label class="col-sm-9 control-label">{{modelNew.BaseOnDueDate}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Material Group :</label>
                <label class="col-sm-9 control-label">{{modelNew.MaterialGroupMasterName}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Article :</label>
                <label class="col-sm-9 control-label">{{modelNew.StandardName}}</label>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" name="Voucher Type" ng-disabled="voucherTypeList.length==1" ng-model="modelNew.VoucherTypeId"
                                ng-options="item.Value as item.Text for item in voucherTypeList" tabindex="2">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 0px;" ng-hide="modelNew.EmployeeId==null">
                <label class="col-sm-3 control-label"><b>Employee Name :</b></label>
                <label class="col-sm-9 control-label"><b>{{modelNew.EmployeeName}}</b></label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Party Account Group :</label>
                <label class="col-sm-9 control-label">{{modelNew.PartyAccountGroupName}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Delivery By :</label>
                <label class="col-sm-9 control-label">{{modelNew.DeliveryBy}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Delivery Address :</label>
                <label class="col-sm-9 control-label" style="white-space: pre-line;">{{modelNew.DeliveryByAddress}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Gate Entry Date :</label>
                <label class="col-sm-9 control-label">{{modelNew.EntryDate}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">GRN Date :</label>
                <label class="col-sm-9 control-label">{{modelNew.GRNDate}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Currency :</label>
                <label class="col-sm-9 control-label">{{modelNew.CurrencyCode}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Due Date :</label>
                <label class="col-sm-9 control-label">{{modelNew.MatureDate}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Non Creditable :</label>
                <label class="col-sm-9 control-label">{{modelNew.IsNonCreditable?'Yes':'No'}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Material :</label>
                <label class="col-sm-9 control-label">{{modelNew.UserName}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">SKU1</label>
                <label class="col-sm-9 control-label">{{modelNew.FirstCharacteristicsValue}}</label>
            </div>
        </div>
    </fieldset>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border" >
        <legend class="scheduler-border">Issued Material :</legend>
        <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>Dr</th>
                        <th>Cr</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in inventoryMaterialList| orderBy:'MaterialGroupMasterId'| groupBy: 'MaterialGroupMasterId'">
                        <td>
                            <span>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</span>
                        </td>
                        <td>
                            <span>{{x.BudgetName}}</span>
                        </td>
                        <td>
                            <span>{{x.ActivityName}}</span>
                        </td>
                        <td>
                            <span ng-hide="inventoryMaterialList[$index].TrnType=='Cr'">{{x.Amount}}</span>
                        </td>
                        <td>
                            <span ng-hide="inventoryMaterialList[$index].TrnType=='Dr'">{{x.Amount}}</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </fieldset>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="common-btn list-inline text-right">
            <li> <button ng-click="Post();" class="btn"> Post</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id No</th>
                    <th>Voucher No</th>
                    <th>Voucher Date</th>
                    <th>Posting Date</th>
                    <th>GRN No</th>
                    <th>Amount</th>
                    <th>Print</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in dataList |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'dataList'">
                    <td>{{x.Id}}</td>
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.VoucherDate | dateFiltering}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.GRNNo}}</td>
                    <td>{{x.Amount}}</td>
                    <td>
                        <ul class="list-inline action-list">
                            <li><a class="btn btn-action" href="FixedAssets/FixedAssetRegister/GetFixedAssetCapitalizeJournalReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.Id}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="FixedAssets/FixedAssetRegister/GetFixedAssetCapitalizeJournalReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.Id}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'dataList'"
                                 direction-links="true" boundary-links="true"
                                 on-page-change="getData(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>
<style>
    .modellgModify {
        width: 1400px;
    }
</style>
<!-- #region Inventory Receive Data -->
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> {{popUpTitle}}<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="popUpData" ej-grid e-datasource="popUpDataList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                         e-recorddoubleclick="selectDoubleClick" e-filtersettings-filterType="excel"
                         e-enabletouch="true" e-allowselection="true"
                         e-scrollsettings="scroll">
                        <div e-columns>
                            <div e-column e-field="Type" e-headertext="Type" e-width="60"></div>
                            <div e-column e-field="PartyName" e-headertext="Party" e-width="160"></div>
                            <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="140"></div>
                            <div e-column e-field="GRNNo" e-headertext="GRN" e-width="60"></div>
                            <div e-column e-field="GRNDate" e-headertext="GRNDate" e-width="60"></div>
                            <div e-column e-field="POId" e-headertext="PO No" e-width="60"></div>
                            <div e-column e-field="TransactionQty" e-headertext="Qty" textAlign='Right' e-width="80"></div>
                            <div e-column e-field="TotalMaterialTranAmount" e-headertext="Amount (TRN)" textAlign='Right' e-width="80"></div>
                            <div e-column e-field="TotalMaterialBooksCurrencyAmount" e-headertext="Amount (BC)" textAlign='Right' e-width="80"></div>
                            <div e-column e-field="MaterialGroupMasterName" e-headertext="MaterialGroup" e-width="120"></div>
                            <div e-column e-field="UserName" e-headertext="Material" e-width="140"></div>
                            <div e-column e-field="StandardName" e-headertext="Article" e-width="160"></div>
                            <div e-column e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="100"></div>
                            <div e-column e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="100"></div>
                        </div>
                    </div>
                </div>

                <div class="common-btn">
                </div>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closePopUp()">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
<!-- #region GL -->
<div class="modal fade site-modal in" id="gltListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Down Payment GL<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="glListParameters.searchBy">
                                            <option ng-repeat="option in searchGLByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="glListParameters.search" ng-enter="getGLData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getGLData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive  modal-table ">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Account Group</th>
                                <th>GL </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in glList |itemsPerPage:glListParameters.pageSize" pagination-id="metaData.name + 'glList'" total-items="glListParameters.total_count" ng-dblclick="setGL(x)">
                                <td>{{x.AccountGroupName}}</td>
                                <td>{{x.GLGeneralInfoName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'glList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getGLData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closeGltListPopUp()">Select</button>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->