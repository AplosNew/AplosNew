                    <button ng-click="getMasterData();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
                @*<div class="col-sm-1">
                    <span class="input-group-btn">
                        <button ng-click="getMasterData();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>*@
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Capitalization Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
