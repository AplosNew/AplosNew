                    </div>
                </li>
                <li>
                    <div ej-tooltip e-showshadow="true" e-content="Pdf" ng-click="$parent.onClickReportDownloadWord(data);" e-width="width">
                        <button class="btn" style="background-color: #1c1f32;"><i class="fa fa-file-pdf-o"></i></button>
                    </div>
                </li>

            </ul>
        </div>
    </script>
</div>

