                    <input required datepicker="checkPostingDate();checkDocDate();" id="docDate" type="text" name="Doc Date" ng-model="voucher.DocDate" class="form-control" tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
