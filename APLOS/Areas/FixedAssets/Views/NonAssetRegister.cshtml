<togglable name=" Asset Register"></togglable>
<div class="form-elements form-horizontal">
    <div class="col-xs-12">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-show="register.registerType=='Individual' || register.registerType=='Accumulated'" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Asset</a></li>
                    <li role="presentation" ng-show="register.registerType=='SubAsset'" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="subasset" role="tab" data-toggle="tab">SubAsset</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-show="register.registerType=='Individual' || register.registerType=='Accumulated'" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form="form0">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Asset No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Id" ng-model="register.Id" class="form-control" readonly tabindex="3">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Asset Item<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <input type="text" name="Asset Item" tabindex="8" ng-model="register.MaterialMasterName" class="form-control" readonly>
                                </div>
                                <div class="col-sm-1">
                                    <button ng-click="getFixedAssetData();" ng-disabled="isDisable" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                                </div>
                                <div class="col-sm-1">
                                    <button ng-click="clearAssetCode();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-refresh"></i></button>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-12"></label>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-12"></label>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Article<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <input type="text" name="Article" tabindex="8" ng-model="register.ArticleStandardName" class="form-control" readonly>
                                </div>
                                <div class="col-sm-1">
                                    <button ng-click="getArticleSearchList(register.MaterialMasterId);" ng-disabled="isDisable" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                                </div>
                                <div class="col-sm-1">
                                    <button ng-click="clearMaterialArticle();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-refresh"></i></button>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12" ng-show="register.FixedAssetMasterId !=null">
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><b>Asset Master: </b>{{register.AssetMasterName}}</label>
                                <label class="col-sm-3 control-label"><b>Asset GL: </b>{{register.AssetGLName}}</label>
                                <label class="col-sm-3 control-label"><b>Budget: </b>{{register.AssetBudgetName}}</label>
                                <label class="col-sm-3 control-label"><b>Activity: </b>{{register.AssetActivityName}}</label>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="col-sm-12" ng-show="articleList.length>0">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">Article</legend>
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Article Code</label>
                                        <div class="col-sm-7">
                                            <input type="text" name="Id" ng-model="materialArticleInfo.ArticleCode" class="form-control" readonly tabindex="3">
                                        </div>
                                        <div class="col-sm-1">
                                            <button class="btn single-small-btn" ng-click="loadMaterialMasterArticleModalList()"><i class="cr-icon glyphicon glyphicon-edit"></i></button>
                                        </div>
                                    </div>
                                    <div ng-repeat="x in articleHead">
                                        <div class="form-group" ng-if="$index%2===0">
                                            <label class="col-sm-4 control-label">{{x.MaterialAttributeName}}</label>
                                            <div class="col-sm-8">
                                                <input type="text" name="Id" ng-model="materialArticleInfo[x.MaterialAttributeName]" class="form-control" readonly tabindex="3">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Article Name</label>
                                        <div class="col-sm-8">
                                            <input type="text" name="Id" ng-model="materialArticleInfo.ArticleStandardName" class="form-control" readonly tabindex="3">
                                        </div>
                                    </div>
                                    <div ng-repeat="x in articleHead">
                                        <div class="form-group" ng-if="$index%2 !=0">
                                            <label class="col-sm-4 control-label">{{x.MaterialAttributeName}}</label>
                                            <div class="col-sm-8">
                                                <input type="text" name="Id" ng-model="materialArticleInfo[x.MaterialAttributeName]" class="form-control" readonly tabindex="3">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        <div class="clearfix"></div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
                                <div class="col-sm-6 show-message">
                                    <input type="text" name="Vendor" tabindex="7" ng-model="register.Vendor" class="form-control" readonly required>
                                </div>
                                <div class="col-sm-1">
                                    <button ng-click="showPartyPopUp();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                                </div>
                                <div class="col-sm-1">
                                    <button ng-click="clearVendorCode();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-refresh"></i></button>
                                </div>
                            </div>
                            <div class="form-group" ng-show="register.registerType =='Individual'">
                                <label class="col-sm-4 control-label">Voucher No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Model" ng-model="register.VoucherNo" class="form-control" tabindex="9" ng-disabled="isDisable" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Model</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Model" ng-model="register.Model" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Invoice No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="InvoiceNo" ng-model="register.InvoiceNo" class="form-control" ng-disabled="isDisable" tabindex="11">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">LC Number</label>
                                <div class="col-sm-8">
                                    <input type="text" name="InvoiceNo" ng-model="register.LCNumber" maxlength="100" class="form-control text-right" tabindex="11" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Year of Manufacture<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" required name="Year Of Manufacture" maxlength="4" ng-model="register.YearOfManufacture" class="form-control" tabindex="13">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">For Production</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" name="IsForProduction" ng-model="register.IsForProduction" tabindex="15">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Purchase Price<sup>*</sup></label>
                                <div class="col-sm-4 show-message" style="padding-right:0px;">
                                    <input type="text" name="Price" n-decimals="4" ng-model="register.TotalPrice" required readonly class="form-control text-right" tabindex="17">
                                </div>
                                <div class="col-sm-4" style="padding-left:0px;">
                                    <div class="select-style">
                                        <select name="Currency" class="form-control" tabindex="18" ng-model="register.CurrencyId" ng-disabled="isDisable" ng-options="register.Value as register.Text for register in tranCurrencyList">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Unit Price<sup>*</sup></label>
                                <div class="col-sm-3 show-message" style="padding-right:0px;">
                                    <input type="text" name="Price" n-decimals="4" ng-model="register.Price" required readonly class="form-control text-right" tabindex="17">
                                </div>
                                <label class="col-sm-3 control-label">Number of Quantity</label>
                                <div class="col-sm-2">
                                    <input type="text" only-numbers ng-disabled="register.registerType==='Individual'" ng-keyup="calUnitPrice(NumberOfQuantity)" name="NumberOfQuantity" ng-model="NumberOfQuantity" class="form-control text-right" tabindex="20">
                                </div>
                            </div>


                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Country of Origin<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Country of Origin" class="form-control" required tabindex="22" ng-model="register.CountryOfOriginId" ng-options="register.Value as register.Text for register in countryList">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <textarea class="form-control" rows="1" ng-model="register.Description" tabindex="24" required name="Description"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Material Master Base UOM</label>
                                <div class="col-sm-8">
                                    <input type="text" name="BaseUOMName" ng-model="register.BaseUOMName" class="form-control" readonly tabindex="11">
                                </div>
                            </div>
                            <div class="form-group" show-errors ng-show="register.registerType =='Individual'">
                                <label class="col-sm-4 control-label">Voucher Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Voucher Date" ng-model="register.VoucherDate" ng-disabled="isDisable" datepicker class="form-control datepicker">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Capitalization Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Capitalization Date" ng-model="register.CapitalizationDate" ng-disabled="isDisable" datepicker class="form-control datepicker" tabindex="10" required>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Invoice Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Invoice Date" ng-model="register.InvoiceDate" ng-disabled="isDisable" datepicker required class="form-control datepicker" tabindex="16">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Brand</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Brand" class="form-control" tabindex="12" ng-model="register.BrandId" ng-options="register.Value as register.Text for register in brandList">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Serial No<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Serial No" ng-model="register.SerialNo" class="form-control" tabindex="14" required autocomplete="off">
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Year of Installation<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" only-numbers name="Year Of Installation" maxlength="4" required ng-model="register.YearOfInstallation" class="form-control text-right" tabindex="19" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Useful Life (Years)</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Life Time" n-decimals="2" maxlength="3" ng-model="register.LifeTime" class="form-control" tabindex="20">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Financial Implication</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" name="IsFinancial" ng-model="register.IsFinancial" disabled tabindex="16">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                            </div>
                        </div>

