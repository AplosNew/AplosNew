                        <div class="clearfix"></div>
                        <div class="col-xs-12 col-sm-12 col-md-12" ng-show="assetRegisterCharactreristicsList.length>0">
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Characteristics</th>
                                            <th>Characteristics Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in assetRegisterCharactreristicsList">
                                            <td> {{x.CharacteristicsName}}</td>
                                            <td>
                                                <input type="text" ng-model="x.CharacteristicsValueFreeText" class="col-sm-2 form-control" ng-keyup="idNullByFreeText(x.CharacteristicsId, $index)"
                                                       style="width:400px;margin-top:-5px;margin-bottom:-5px;" ng-disabled="x.FlagDisable" ng-required="x.IsMandatory" name="Material attribute value">
                                                <button class="btn single-small-btn" ng-disabled="!x.IsPreDefinedField" style="margin-top:-5px;margin-bottom:-5px;"
                                                        ng-click="getCharacteristicsValuePopUP($index,x)" tabindex="4">
                                                    <i class="cr-icon glyphicon glyphicon-search"></i>
                                                </button>
                                                <button class="btn single-small-btn" ng-click="materialAttributeValueClear($index)" style="margin-top:-5px;margin-bottom:-5px;"><i class="cr-icon glyphicon glyphicon-remove"></i></button>
                                                <label style="color:red;font-size: 10px;font-weight: normal;" ng-show="IsMandatoryButNull(x.IsMandatory, x.CharacteristicsValueFreeText)">
                                                    [{{x.CharacteristicsName}}] value is required.
                                                </label>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="clearfix"></div>

                        <div class="col-xs-12" ng-hide="true">
                            <div class="table-responsive modal-table voucher-table" ng-hide="true">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th> Material Master</th>
                                            <th>Article</th>
                                            <th colspan="{{parallelCurrencyList.length}}" class="text-center">
                                                Asset Historical Value
                                                <table>
                                                    <tr>
                                                        <td style="color:white;" ng-repeat="x in parallelCurrencyList">{{x.Code}}</td>
                                                    </tr>
                                                </table>
                                            </th>
                                            <th colspan="{{parallelCurrencyList.length}}" class="text-center">
                                                Acc Dep
                                                <table>
                                                    <tr>
                                                        <td style="color:white;" ng-repeat="x in parallelCurrencyList">{{x.Code}}</td>
                                                    </tr>
                                                </table>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                {{register.MaterialMasterName}}
                                            </td>
                                            <td>{{materialArticleInfo.ArticleStandardName}}</td>
                                            <td ng-show="register.FABaseCurrencyId !=null">
                                                <input type="text" class="form-control text-right" ng-model="register.FABaseAmount" n-decimals="4">
                                            </td>
                                            <td ng-show="register.ADBaseCurrencyId !=null">
                                                <input type="text" class="form-control text-right" ng-model="register.ADBaseAmount" n-decimals="4">
                                            </td>

                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <h4><b>Summary of Saved Asset Register</b></h4>
                            <div class="row">
                                <div class="col-sm-12">
                                    <span class="col-sm-4">Total Asset: {{getDataWithFAMSavedRow}}</span>
                                    <div class="col-sm-8" ng-show="register.MaterialMasterId !=null">
                                        <span><b>Asset Master: </b>{{register.AssetMasterName}}</span>
                                        <span><b>Asset GL: </b>{{register.AssetGLName}}</span>
                                        <span><b>Budget: </b>{{register.AssetBudgetName}}</span>
                                        <span><b>Activity: </b>{{register.AssetActivityName}}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="table-responsive modal-table voucher-table">
                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Asset GL And Budget</th>
                                                <th>Quantity</th>
                                                <th colspan="{{parallelCurrencyList.length}}" class="text-center">
                                                    Asset Historical Value
                                                    <table>
                                                        <tr>
                                                            <td style="color:white;" ng-repeat="x in parallelCurrencyList">{{x.Code}}</td>
                                                        </tr>
                                                    </table>
                                                </th>
                                                <th colspan="{{parallelCurrencyList.length}}" class="text-center">
                                                    Acc. Dep.
                                                    <table>
                                                        <tr>
                                                            <td style="color:white;" ng-repeat="x in parallelCurrencyList">{{x.Code}}</td>
                                                        </tr>
                                                    </table>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    Transaction
                                                </td>
                                                <td class="text-right">
                                                    {{getOpeningBalanceDataWithFAM.TotalRow}}
                                                </td>
                                                <td class="text-right" ng-show="register.FABaseCurrencyId !=null">
                                                    {{getOpeningBalanceDataWithFAM.FABaseAmountTotal | number:2}}
                                                </td>
                                                <td class="text-right" ng-show="register.FAGroupCurrencyId !=null">
                                                    {{getOpeningBalanceDataWithFAM.FAGroupAmountTotal | number:2}}
                                                </td>
                                                <td class="text-right" ng-show="register.FAHardCurrencyId !=null">
                                                    {{getOpeningBalanceDataWithFAM.FAHardAmountTotal | number:2}}
                                                </td>
                                                <td class="text-right" ng-show="register.ADBaseCurrencyId !=null">
                                                    {{getOpeningBalanceDataWithFAM.ADBaseAmountTotal | number:2}}
                                                </td>
                                                <td class="text-right" ng-show="register.ADGroupCurrencyId !=null">
                                                    {{getOpeningBalanceDataWithFAM.ADGroupAmountTotal | number:2}}
                                                </td>
                                                <td class="text-right" ng-show="register.ADHardCurrencyId !=null">
                                                    {{getOpeningBalanceDataWithFAM.ADHardAmountTotal | number:2}}
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    Asset Register
                                                </td>
                                                <td class="text-right">
                                                    {{getDataWithFAM.TotalRow}}
                                                </td>
                                                <td class="text-right" ng-show="register.FABaseCurrencyId !=null">
                                                    {{getDataWithFAM.FABaseAmountTotal | number:2}}
                                                </td>
                                                <td class="text-right" ng-show="register.FAGroupCurrencyId !=null">
                                                    {{getDataWithFAM.FAGroupAmountTotal | number:2}}
                                                </td>
                                                <td class="text-right" ng-show="register.FAHardCurrencyId !=null">
                                                    {{getDataWithFAM.FAHardAmountTotal | number:2}}
                                                </td>
                                                <td class="text-right" ng-show="register.ADBaseCurrencyId !=null">
                                                    {{getDataWithFAM.ADBaseAmountTotal | number:2}}
                                                </td>
                                                <td class="text-right" ng-show="register.ADGroupCurrencyId !=null">
                                                    {{getDataWithFAM.ADGroupAmountTotal | number:2}}
                                                </td>
                                                <td class="text-right" ng-show="register.ADHardCurrencyId !=null">
                                                    {{getDataWithFAM.ADHardAmountTotal | number:2}}
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-show="register.registerType=='SubAsset'" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row" ng-form="form1">
                        <div class="col-xs-12 col-sm-4 col-md-4 ">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Sub Asset Type</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
