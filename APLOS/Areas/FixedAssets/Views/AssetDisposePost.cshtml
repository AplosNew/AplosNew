<togglable name="Capitalize Asset Dispose Post"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Select Capitalize Asset Dispose<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" class="form-control" readonly name="DisposeNo" ng-model="voucher.DisposeNo">
            </div>
            <div class="col-sm-2 input-group">
                <span class="input-group-btn">
                    <button ng-click="getDisposeData();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Info</legend>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Disposal Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Disposal Type" ng-model="voucher.Status"  class="form-control" readonly >
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Entry Date" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
                </div>
            </div>
            <div class="form-group" show-errors ng-show="voucher.Status=='Sales'">
                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-5 show-message" style="padding-right:0px;">
                    <div class="select-style">
                        <select id="currencyTransactionId" readonly class="form-control" name="CurrencyTransaction" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();" >
                            <option value="">--Select--</option>
                            <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-3 show-message" style="padding-left:0px;">
                    <input type="text" maxlength="50" id="Rate" readonly name="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" autocomplete="off"  ng-disabled="baseCurrencyId==voucher.CurrencyId">
                </div>
            </div>


            <div class="form-group" show-errors ng-show="voucher.Status=='Sales'">
                <label class="col-sm-3 control-label">Payment Term<sup>*</sup></label>
                <div class="col-sm-3 show-message">
                    <div class="select-style">
                        <select tabindex="10" id="paymentTermId" class="form-control" name="Payment Term" ng-model="voucher.PaymentTermId" ng-change="changePaymentTerm(voucher.PaymentTermId);">
                            <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <label class="col-sm-3 control-label">Due Date BaseOn<sup>*</sup></label>
                <div class="col-sm-3 show-message">
                    <input type="text" name="BaseOnDueDate" ng-model="voucher.BaseOnDueDate" ng-change="getMatureDate(voucher.BaseOnDueDate,voucher.BaseNoOfDays)" datepicker class="form-control datepicker" tabindex="11">
                </div>
            </div>
            <div class="form-group" show-errors ng-show="voucher.Status=='Sales'">
                <label class="col-sm-3 control-label">No Of Days</label>
                <div class="col-sm-3 show-message">
                    <input id="baseNoOfday" type="number" name="No Of Days" ng-model="voucher.BaseNoOfDays" ng-change="getMatureDate(voucher.BaseOnDueDate, voucher.BaseNoOfDays)" class="form-control" tabindex="12">
                </div>
                <label class="col-sm-3 control-label">Mature Date</label>
                <div class="col-sm-3 show-message">
                    <input type="text" name="Mature Date" ng-model="voucher.MatureDate" class="form-control" readonly>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div id="div_PostingDate" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="Posting Date" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
                </div>
            </div>
            <div id="div_DocDate" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input required  id="docDate" type="text" name="Doc Date" ng-model="voucher.DocDate" class="form-control" tabindex="1" readonly>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select ng-change="entityChange(voucher.EntityId)" id="entityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="7" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
    <fieldset class="scheduler-border" ng-show="voucher.Status=='CompensateByEmployee'">
        <legend class="scheduler-border"> Employee Info</legend>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" class="form-control" readonly name="EmployeeName" ng-model="voucher.EmployeeName">
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Designation</label>
                <div class="col-sm-8 show-message">
                    <input type="text" readonly class="form-control" name="Designation" ng-model="voucher.Designation">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Department</label>
                <div class="col-sm-8 show-message">
                    <input type="text" readonly class="form-control" name="Department" ng-model="voucher.Department">
                </div>
            </div>
        </div>
    </fieldset>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border"> Register Info</legend>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="table-responsive modal-table ">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Asset No</th>
                            <th>Serial No</th>
                            <th>Material</th>
                            <th>Article</th>
                            <th>Fixed Asset Master</th>
                            <th>Invoice Date</th>
                            <th>Capitalization Date</th>
                            <th class="text-center">FA Base Amount</th>
                            <th class="text-center">Base Sub Asset</th>
                            <th style="width:100px">Total Base Amount</th>
                            <th class="text-center">Depreciation</th>
                            <th class="text-center">Net Base Amount</th>
                            <th class="text-center">Adjustment Depreciation Amount</th>
                            <th class="text-center" ng-hide="voucher.Status == 'Scrap' || voucher.Status == 'Theft'">Negotiation</th>
                            <th class="text-center" ng-hide="voucher.Status == 'Scrap' || voucher.Status == 'Theft'">Base Negotiation</th>
                            <th>Vendor</th>
                            <th>Invoice No</th>
                            @*<th class="text-center">Trn Currency</th>*@
                            <th class="text-center">OB</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in fixedAssetDisposeDetailList">
                            <td>{{x.AssetNo}}</td>
                            <td>{{x.SerialNo}}</td>
                            <td>{{x.MaterialMasterName}}</td>
                            <td>{{x.Article}}</td>
                            <td>{{x.FixedAssetMasterName}}</td>
                            <td>{{x.PurchaseDate}}</td>
                            <td>{{x.CapitalizationDate}}</td>

                            <td><input type="text" class="form-control text-right" ng-disabled="true" id="Price" ng-model="x.FABaseAmount " n-decimals="2"></td>
                            <td><input type="text" class="form-control text-right" ng-disabled="true" id="SubAssetAmount" ng-model="x.SubAssetBaseAmount " n-decimals="2"></td>
                            <td><input type="text" style="width:100px" class="form-control text-right" ng-disabled="true" id="PurchasePrice" ng-model="x.PurchaseBaseAmount " n-decimals="2"></td>
                            <td><input type="text" class="form-control text-right" ng-disabled="true" id="ADBaseAmount" ng-model="x.ADBaseAmount " n-decimals="2"></td>
                            <td><input type="text" style="width:100px" class="form-control text-right" ng-disabled="true" id="NetBookValue" ng-model="x.NetBaseBookValue " n-decimals="2"></td>
                            <td><input type="text" style="width:100px" class="form-control text-right" ng-disabled="true" id="AdjustmentDepreciationAmount" ng-model="x.AdjustmentDepreciationAmount "  n-decimals="2" autocomplete="off"></td>
                            <td ng-hide="voucher.Status == 'Scrap' || voucher.Status == 'Theft'"><input type="text" style="width:100px" class="form-control text-right" ng-disabled="true" id="NegotiationValue" ng-disabled="voucher.Status == 'Scrap'" ng-model="x.NegotiationValue " n-decimals="2"></td>
                            <td ng-hide="voucher.Status == 'Scrap' || voucher.Status == 'Theft'"><input type="text" class="form-control text-right" ng-disabled="true" id="BaseNagotiationValue" ng-model="x.BaseNagotiationValue " n-decimals="2"></td>
                            <td>{{x.Vendor}}</td>
                            <td>{{x.InvoiceNo}}</td>
                            @*<td>{{x.TrnCurrency}}</td>*@
                            <td>{{x.IsOBBalance}}</td>

                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="text-right">Total</td>
                            <td class="text-right"><b>{{ (fixedAssetDisposeDetailList ) | sumByKey:'FABaseAmount' }}</b></td>
                            <td class="text-right"><b>{{ (fixedAssetDisposeDetailList ) | sumByKey:'SubAssetBaseAmount' }}</b></td>
                            <td class="text-right"><b>{{ (fixedAssetDisposeDetailList ) | sumByKey:'PurchaseBaseAmount' }}</b></td>
                            <td class="text-right"><b>{{ (fixedAssetDisposeDetailList ) | sumByKey:'ADBaseAmount' }}</b></td>
                            <td class="text-right"><b>{{ (fixedAssetDisposeDetailList ) | sumByKey:'NetBaseBookValue' }}</b></td>
                            <td class="text-right"><b>{{ (fixedAssetDisposeDetailList ) | sumByKey:'AdjustmentDepreciationAmount' }}</b></td>
                            <td class="text-right" ng-hide="voucher.Status == 'Scrap' || voucher.Status == 'Theft'"><b>{{ (fixedAssetDisposeDetailList ) | sumByKey:'NegotiationValue' }}</b></td>
                            <td class="text-right" ng-hide="voucher.Status == 'Scrap' || voucher.Status == 'Theft'"><b>{{ (fixedAssetDisposeDetailList ) | sumByKey:'BaseNagotiationValue' }}</b></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </fieldset>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border" ng-show="fixedAssetDisposeJVList.length">
        <legend class="scheduler-border">JV</legend>
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>Dr</th>
                        <th>Cr</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in fixedAssetDisposeJVList| orderBy:'-TrnType'">
                        <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td class="text-right">{{x.Dr | number| setDecimal:4}}</td>
                        <td class="text-right">{{x.Cr | number| setDecimal:4}}</td>
                    </tr>
                    <tr>
                        <td colspan="3"></td>
                        <td class="text-right"><strong>{{fixedAssetDisposeJVList | sumByKey : 'Dr' | number| setDecimal:4}}</strong></td>
                        <td class="text-right"><strong>{{fixedAssetDisposeJVList | sumByKey : 'Cr' | number| setDecimal:4}}</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </fieldset>

    <fieldset class="scheduler-border" ng-show="fixedAssetDisposeJV2List.length">
        <legend class="scheduler-border">Sales</legend>
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>Dr</th>
                        <th>Cr</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in fixedAssetDisposeJV2List| orderBy:'-TrnType'">
                        <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td class="text-right">{{x.Dr | number| setDecimal:4}}</td>
                        <td class="text-right">{{x.Cr | number| setDecimal:4}}</td>
                    </tr>
                    <tr>
                        <td colspan="3"></td>
                        <td class="text-right"><strong>{{fixedAssetDisposeJV2List | sumByKey : 'Dr' | number| setDecimal:4}}</strong></td>
                        <td class="text-right"><strong>{{fixedAssetDisposeJV2List | sumByKey : 'Cr' | number| setDecimal:4}}</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </fieldset>




    <div class="col-md-12 col-sm-12 col-xs-12">
        @*<div class="form-group" ng-show="true">*@
        <fieldset class="scheduler-border" ng-show="voucher.Status=='@Library.Service.Enums.FixedAssetDisposeStatusEnum.CompensateByEmployee.ToString()'">
            <legend class="scheduler-border">Advance Schedule</legend>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div id="div_DocDate" class="form-group" show-errors>
                    <label class="col-sm-4 control-label" title="Repayment Start Date" tooltip>First Installment Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Repayment Start Date" ng-model="voucher.RepaymentStartDate" datepicker="checkDocDate(); LoadRepamentDetail()" class="form-control" tabindex="8">
                    </div>
                </div>
                <div class="form-group" show-errors>

                    <label class="col-sm-4 control-label">Total Payments </label>
                    <div class="col-sm-8 show-message">
                        {{TotalPayments}}
                    </div>
                    <input type="text" maxlength="4" ng-show="false" name="Life Of Year" ng-keyup="totalInstallment();LoadRepamentDetail()" ng-model="voucher.LifeOfYear" class="form-control text-right" tabindex="10" autocomplete="off">
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Interest Rate<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="number" ng-keyup="LoadRepamentDetail()" maxlength="5" name="Interest Rate" ng-model="voucher.ProfitRate" class="form-control" tabindex="12" autocomplete="off">
                    </div>
                </div>
                <div class="form-group" show-errors>

                    <label class="col-sm-4 control-label">Total Interest Paid</label>
                    <div class="col-sm-8 show-message">
                        {{TotalInterestPaid}}
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label" title="No. Of Installment Per Year" tooltip>Advance Loan Term (monthly)<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" maxlength="4" name="No. Of Installment Per Year" ng-keyup="totalInstallment();LoadRepamentDetail()" ng-model="voucher.NoOfInstallmentPerYear" class="form-control text-right" tabindex="11" autocomplete="off">
                        <input type="text" maxlength="10" ng-show="false" name="Total No Of Installment" ng-model="voucher.TotalNoOfInstallment" class="form-control text-right" tabindex="9" disabled autocomplete="off">
                    </div>

                </div>
            </div>


            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">

                </div>

            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">

                </div>

            </div>

        </fieldset>

    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 modal-table" id="loanDetails">
    </div>


    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>


</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="voucherList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="DisposeNo" e-headertext="Dispose No" e-width="80" e-filter="false"></div>
            <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="80" e-filter="false"></div>
            <div e-column e-field="Status" e-headertext="Status" e-width="70"></div>
            @*<div e-column e-field="EmployeeName" e-headertext="Employee" e-width="120"></div>*@
            <div e-column e-field="CustomerName" e-headertext="Customer" e-width="120"></div>
            <div e-column e-field="TrnCurrency" e-headertext="Currency" e-width="60"></div>
            @*<div e-column e-field="BaseCurrency" e-headertext="Base Currency" e-width="60"></div>*@
            <div e-column e-field="NegotiationValue" e-headertext="Negotiation Amount" e-width="80"></div>
            @*<div e-column e-field="NagotiationBooksValue" e-headertext="Base Negotiation" e-width="80"></div>*@

            @*<div e-column e-field="FABaseAmount" e-headertext="FABaseAmount" e-width="80"></div>
            <div e-column e-field="SubAssetBaseAmount" e-headertext="Sub Base Amount" e-width="80"></div>
            <div e-column e-field="PurchaseBaseAmount" e-headertext="Total Base Amount" e-width="80"></div>
            <div e-column e-field="ADBaseAmount" e-headertext="Depreciation" e-width="80"></div>
            <div e-column e-field="NetBaseBookValue" e-headertext="Net Base Amount" e-width="80"></div>*@
            @*<div e-column e-field="NetBookValue" e-headertext="Net Amount" e-width="80"></div>*@
            @*<div e-column e-field="IsPark" e-headertext="Status" e-width="40"></div>*@
            <div e-column e-template="#ShowActionButtonsassigned" e-headertext="PDF&Excel" e-width="70"></div>
            @*<div e-column e-headertext="PDF" e-commands="commandPDF" e-isunbound=true e-textalign="center" e-width="60"></div>
        <div e-column e-headertext="Excel" e-commands="commandExcel" e-isunbound=true e-textalign="left" e-width="60"></div>*@
        </div>
    </div>

    <script type="text/ng-template" id="ShowActionButtonsassigned">
        <div class="common-btn">
            <ul class="common-btn list-inline text-left">
                <li>
                    <div ej-tooltip e-showshadow="true" e-content="Excel" ng-click="$parent.onClickReportDownloadExcel(data);" e-width="width">
                        <button class="btn" style="background-color: #1c1f32;"><i class="fa fa-file-excel-o"></i></button>
                    </div>
                </li>
                <li>
                    <div ej-tooltip e-showshadow="true" e-content="Pdf" ng-click="$parent.onClickReportDownloadWord(data);" e-width="width">
                        <button class="btn" style="background-color: #1c1f32;"><i class="fa fa-file-pdf-o"></i></button>
                    </div>
                </li>

            </ul>
            @*<ul class="list-inline text-left small">
                <li>
                    <button ng-click="$parent.onClickReportDownloadWord(data);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                        <i class="glyphicon glyphicon-minus-sign" style="color:orangered;"></i>
                    </button>
                </li>
                <li>
                    <button ng-click="$parent.onClickReportDownloadExcel(data);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                        <i class="glyphicon glyphicon-play" style="color:{{data.HasBOQ==true?'#00ff00':'orange'}}"></i>
                    </button> 
                </li>
            </ul>*@
        </div>
    </script>
</div>
<style>
    .modellgModify {
        width: 1000px;
    }
</style>

<div class="modal fade site-modal in" id="DisposePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Fixed Asset Lost List <button type="button" class="close" ng-click="closeFixedAssetDisposePopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
