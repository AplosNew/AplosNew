<div class="modal fade site-modal in" id="assetmastermodal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
               Fixed Asset Master
                <button type="button" class="close" ng-click="closeFixedAssetPopUp()" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchMaterialMasterParameters.searchBy">
                                            <option ng-repeat="option in searchByMaterialMasterModalList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchMaterialMasterParameters.search" ng-enter="loadMaterialMasterModalList()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadMaterialMasterModalList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Sub Category</th>
                                <th>Fixed Asset Master</th>
                                <th>Asset Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in materialMasterList1 |itemsPerPage:searchMaterialMasterParameters.pageSize"
                                total-items="searchMaterialMasterParameters.total_count" pagination-id="metaData.name + 'materialMasterList1'"
                                ng-dblclick="selectFixedAssetMaster(x);">
                                <td>{{x.FixedAssetCategory}}</td>
                                <td>{{x.FixedAssetSubCategory}}</td>
                                <td>{{x.FixedAssetMasterName}}</td>
                                <td>{{x.AssetType}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'materialMasterList1'" direction-links="true" boundary-links="true" on-page-change="loadMaterialMasterModalList(newPageNumber)"></dir-pagination-controls>
            </div>
        </div>
    </div>
</div>