<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> FixedAsset Master Budget
</h3>
<div class="form-elements" ng-form id="fixedAssetMasterBudgetTagNew" name="fixedAssetMasterBudgetTagForm">
    <div class="row">
        <input type="hidden" ng-model="fixedAssetMasterBudgetTagNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal  form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">COA<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="fixedAssetMasterBudgetTagNew.COAId" ng-change="getFATagValue()" ng-options="item.Value as item.Text for item in COAList" id="plantId" name="COA" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal form-element-ctrl">
        </div>
        <div class="clearfix"></div>
    </div>
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="fixedAssetMasterBudgetTagListParameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="fixedAssetMasterBudgetTagListParameters.search" ng-enter="loadData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="loadData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>GL</th>
                    <th>Budget Category</th>
                    <th>Budget Subcategory</th>
                    <th>Budget</th>
                    <th>Ref No</th>
                    <th>Asset Master</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in fixedAssetMasterBudgetTagList |itemsPerPage:fixedAssetMasterBudgetTagListParameters.pageSize" pagination-id="metaData.name + 'fixedAssetMasterBudgetTagList'" total-items="fixedAssetMasterBudgetTagListParameters.total_count" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                    <td>{{x.BudgetCategoryName}}</td>
                    <td>{{x.BudgetSubCategoryName}}</td>
                    <td>{{x.BudgetName}}</td>
                    <td>{{x.RefNo}}</td>
                    <td>
                        <div class="select-style">
                            <select class="form-control" ng-model="x.FixedAssetMasterId" ng-options="item.Value as item.Text for item in fixedAssetMasterCboList" id="FixedAssetMasterId" name="FixedAssetMaster" ng-change="selectChValueId(x)">
                                <option value=""></option>
                            </select>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" pagination-id="metaData.name + 'fixedAssetMasterBudgetTagList'" boundary-links="true" on-page-change="loadData(newPageNumber)"></dir-pagination-controls>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
            <li><button ng-click="ClearAll();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
        </ul>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteDeductionRow()"></confirm-archive-generic>
<confirm-modal></confirm-modal>