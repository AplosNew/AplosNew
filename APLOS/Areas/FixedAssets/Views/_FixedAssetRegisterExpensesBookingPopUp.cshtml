<div class="modal fade site-modal in" id="registersearchpopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Fixed Asset Register List</h4>
            </div>
            <div class="modal-body text-center">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="registerListParameters.searchBy">
                                            <option ng-repeat="option in searchbyRegisterlist" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="registerListParameters.search" ng-enter="loadRegisterData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadRegisterData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material Type</th>
                                <th>Material Group Master</th>
                                <th>Asset Code</th>
                                <th>Asset Item</th>
                                <th>Serial No</th>
                                <th>Asset No</th>
                                <th>Asset Type</th>
                                <th>Article</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in registerList | itemsPerPage:registerListParameters.pageSize" pagination-id="metaData.name + 'registerList'" total-items="registerListParameters.total_count" ng-dblclick="GetRegisterIndex(x);">
                                <td>{{x.MaterialTypeName}}</td>
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.MaterialMasterCode}}</td>
                                <td>{{x.MaterialMasterName}}</td>
                                <td>{{x.SerialNo}}</td>
                                <td>{{x.AssetNo}}</td>
                                <td>{{x.AssetType}}</td>
                                <td>{{x.Article}}</td>
                                <td>{{x.Description}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'registerList'" direction-links="true" boundary-links="true" on-page-change="loadRegisterData(newPageNumber)"></dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>