<div class="modal fade site-modal in" id="materialAttributeValuePoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Fixed Asset Attribute Value <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="materialAttributeValueParameters.searchBy">
                                            <option ng-repeat="option in searchMaterialAttributeValueList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="materialAttributeValueParameters.search" ng-enter="getAttributeValueData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getAttributeValueData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                                <th>Default</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in materialAttributeValueList|itemsPerPage:materialAttributeValueParameters.pageSize" pagination-id="metaData.name + 'materialAttributeValueList'"
                                total-items="materialAttributeValueParameters.total_count" ng-click="SelectMA(x.Id, x.UserName, $index)" ng-dblclick="getAttrValue(x.Id, x.UserName);">
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.IsDefault?'Yes':'No'}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls pagination-id="metaData.name + 'materialAttributeValueList'"
                                             max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getAttributeValueData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SelectMAButton();" class="btn"><i class=""></i> Select</button></li>
                        <li> <button type="button" class="btn btn-default" ng-click="ClosematerialAttributePopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="characteristicsValuePoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content row">
            <div class="modal-header">Characteristics Value <button type="button" class="close" ng-click="CloseMaterialMasterCharacteristicsValue();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div id="div_c1" class="form-group">
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" n-decimals="2" name="Sequence" ng-model="characteristicsValueNew.Sequence" class="form-control text-right" tabindex="1" ng-keyup="manualValidationAddRemove('div_c1','Sequence',characteristicsValueNew);">
                        </div>
                    </div>
                    <div id="div_c3" class="form-group">
                        <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short Name" maxlength="15" ng-model="characteristicsValueNew.ShortName" class="form-control" tabindex="3" ng-keyup="manualValidationAddRemove('div_c3','ShortName',characteristicsValueNew);">
                        </div>
                    </div>
                    <div id="div_c5" class="form-group">
                        <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" maxlength="50" ng-model="characteristicsValueNew.UserName" class="form-control" tabindex="5" ng-keyup="manualValidationAddRemove('div_c5','UserName',characteristicsValueNew);">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="2" ng-model="characteristicsValueNew.Remarks" name="Remarks" maxlength="250" tabindex="7"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div id="div_c2" class="form-group">
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Code" maxlength="10" ng-model="characteristicsValueNew.Code" class="form-control" tabindex="2" ng-keyup="manualValidationAddRemove('div_c2','Code',characteristicsValueNew);">
                        </div>
                    </div>
                    <div id="div_c4" class="form-group">
                        <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" maxlength="50" ng-model="characteristicsValueNew.StandardName" class="form-control" tabindex="4" ng-keyup="manualValidationAddRemove('div_c4','StandardName',characteristicsValueNew);">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Description</label>
                        <div class="col-sm-8">
                            <textarea type="text" maxlength="250" rows="2" ng-model="characteristicsValueNew.Description" class="form-control" tabindex="6"></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Is Default</label>
                        <div class="col-sm-2">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="characteristicsValueNew.IsDefault">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                        <label class="col-sm-3 control-label">Active</label>
                        <div class="col-sm-2">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="characteristicsValueNew.Active">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="addMasterCharacteristicsValue();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus"></i> {{characteristicsValueNew.Id==0?'Add':'UpdateRow'}}</button></li>
                        <li><button ng-click="clearMasterCharacteristicsValue();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        <li><button ng-click="CloseMaterialMasterCharacteristicsValue();" class="btn" tabindex="11"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Stander Name</th>
                                <th>User Define Name</th>
                                <th>Default</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in characteristicsValueList">
                                <td>
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="GetMaterialMasterCharacteristicsValue($index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i></button></li>
                                        <li><button ng-disabled="mvindex!=-1" ng-click="DeleteModal($index,'characteristicsValueList',x.UserName)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.IsDefault?'Yes':'No'}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
