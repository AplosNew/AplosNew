<togglable name=" Asset Register"></togglable>
<div class="form-elements form-horizontal">
    <div class="col-xs-12">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Asset</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form="form0">
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">AUC Info</legend>

                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li>
                                            <button ng-click="showSearchData('AUC');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>AUC</button>
                                            <button ng-click="showSearchData('CI');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>CapitalizeInventory</button>
                                            <button ng-click="showSearchData('Expense');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Expense</button>
                                        </li>
                                    </ul>
                                </div>
                                <div class="table-responsive modal-table" ng-show="selectedmaterialMasterList.length">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Action</th>
                                                <th>Voucher No</th>
                                                <th>Material</th>
                                                <th>Article</th>
                                                <th>GRN No</th>
                                                <th>Qty</th>
                                                <th>Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in selectedmaterialMasterList">
                                                <td>
                                                    <div class="common-btn">
                                                        <ul class="list-inline text-left">
                                                            <li>
                                                                <button ng-click="RemoveItemVoucher(x);" class="btn"><i class="glyphicon glyphicon-trash" tabindex="3"></i></button>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </td>
                                                <td>{{x.VoucherNo}}</td>
                                                <td>{{x.MaterialMasterName}}</td>
                                                <td>{{x.ArticleStandardName}}</td>
                                                <td>{{x.GRNNo}}</td>
                                                <td>{{x.Qty}}</td>
                                                <td>{{x.Amount}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="clearfix"></div>
                                
                            </fieldset>

                        </div>

                        <div class="col-xs-12 col-sm-6 col-md-6">

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Asset No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Id" ng-model="register.Id" class="form-control" readonly tabindex="3">
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Asset Item<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="input-group">
                                        <input type="text" name="AssetItem" ng-model="register.AssetItem" class="form-control" readonly required>
                                        <span class="input-group-btn">
                                            <button ng-click="ShowFixedAssetMasterItem();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                            <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Model</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Model" ng-model="register.Model" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>


                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Year of Manufacture<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" required name="Year Of Manufacture" maxlength="4" ng-model="register.YearOfManufacture" class="form-control" tabindex="13">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">For Production</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" name="IsForProduction" ng-model="register.IsForProduction" tabindex="15">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Books Price<sup>*</sup></label>
                                <div class="col-sm-4 show-message" style="padding-right:0px;">
                                    <input type="text" name="Price" n-decimals="4" ng-model="register.TotalPrice" required readonly class="form-control text-right" tabindex="17">
                                </div>
                                <div class="col-sm-4" style="padding-left:0px;">
                                    <input type="text" name="CurrencyCode" ng-model="register.CurrencyCode" maxlength="100" ng-disabled="true" class="form-control text-right" tabindex="11" autocomplete="off">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Number of Quantity</label>
                                <div class="col-sm-4" style="padding-right:0px;">
                                    <input type="text" name="NumberOfQuantity" ng-model="NumberOfQuantity" class="form-control text-right" tabindex="20">
                                </div>
                                <div class="col-sm-4" style="padding-left:0px;">
                                    <input type="text" only-numbers ng-disabled="true" name="BaseUOMName" readonly ng-model="register.BaseUOMName" class="form-control text-right" tabindex="20">
                                </div>
                            </div>


                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Country of Origin<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Country of Origin" class="form-control" required tabindex="22" ng-model="register.CountryOfOriginId" ng-options="register.Value as register.Text for register in countryList">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <textarea class="form-control" rows="1" ng-model="register.Description" tabindex="24" required name="Description"></textarea>
                                </div>
                            </div>

                        </div>


                        <div class="col-xs-12 col-sm-6 col-md-6">



                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Capitalization Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Capitalization Date" ng-model="register.CapitalizationDate" disabled datepicker class="form-control datepicker" tabindex="10" required>
                                </div>
                            </div>


                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Serial No<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Serial No" ng-model="register.SerialNo" class="form-control" tabindex="14" required autocomplete="off">
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Year of Installation<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" only-numbers name="Year Of Installation" maxlength="4" required ng-model="register.YearOfInstallation" class="form-control text-right" tabindex="19" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Useful Life (Years)</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Life Time" n-decimals="2" maxlength="3" ng-model="register.LifeTime" class="form-control" tabindex="20">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Financial Implication</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" name="IsFinancial" ng-model="register.IsFinancial" disabled tabindex="16">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Remarks<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <textarea class="form-control" rows="2" ng-model="register.Remarks" maxlength="250" tabindex="24" required name="Remarks"></textarea>
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Depreciation Rules <sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">

                                        <select ng-model="register.DepreciationRuleId" class="form-control" name="Company FixedAsset DepRule"
                                                ng-options="item.Value as item.Text for item in CompanyFADepRuleList" required tabindex="26">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Multiplication Factor <sup></sup></label>
                                <div class="col-sm-6 remove-right-space">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="register.MultiplicationFactor" tabindex="28">
                                            <option></option>
                                            <option value="1.0000">1</option>
                                            <option value="1.5000">1.5</option>
                                            <option value="2.0000">2</option>
                                            <option value="2.5000">2.5</option>
                                            <option value="3.0000">3</option>
                                            <option value="3.5000">3.5</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>





                        <div class="col-xs-12 col-sm-6 col-md-6 modal-table">
                            <table class="table table-responsive table-striped">
                                <caption>Sub Asset</caption>
                                <thead>
                                    <tr>
                                        <th>Sub Asset </th>
                                        <th>Amount</th>
                                        <th class="text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td id="td_FinancingType">
                                            <div class="select-style show-message">
                                                <select ng-model="subAsseType.SubAssetTypeId">
                                                    <option ng-repeat="option in subAssetTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                                </select>
                                            </div>
                                        </td>
                                        <td id="td_FinancingTypeAmount">
                                            <div class="show-message">
                                                <input type="text" n-decimals="2" class="form-control text-right" ng-model="subAsseType.Amount">
                                            </div>
                                        </td>
                                        <td class="text-right">
                                            <a ng-click="addCharge();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                                        </td>
                                    </tr>
                                    <tr ng-repeat="x in subAssetList">
                                        <td>{{x.SubAssetTypeName}}</td>
                                        <td class="text-right">{{x.Amount | number:2 }}</td>
                                        <td class="text-right">
                                            <button ng-click="removeChargesRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot ng-show="subAssetList.length">
                                    <tr>
                                        <td><b>Sub Total</b></td>
                                        <td class="text-right"><b>{{ subAssetList | sumByKey : 'Amount' }}</b></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="clearfix"></div>


                    </div>
                </div>

            </div>
        </div>
        
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="SaveRegister();" class="btn" ng-disabled="isSave" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-show="btndeleteregister" ng-click="deleteRegisterPop()" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="registerAddEditPopup('NEW')" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
