<togglable name="Capitalize Asset Register"></togglable>
<div class="form-elements form-horizontal">
    <div class="col-xs-12">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Asset</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form="form0">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Asset No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Id" ng-model="register.Id" class="form-control" readonly tabindex="3">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Asset Item<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="input-group">
                                        <input type="text" name="AssetItem" ng-model="register.FixedAssetItem" class="form-control" readonly required>
                                        <span class="input-group-btn">
                                            <button ng-click="ShowFixedAssetMasterItem();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                            <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Approved By<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select id="Approved By" class="form-control" name="Approved By" ng-model="register.ApprovedById" tabindex="8" required>
                                            <option ng-repeat="option in ApprovedByList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Installation Year<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="register.InstallationYear" name="Installation Year" ng-options="item.Value as item.Text for item in yearList" tabindex="3">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Status</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Status" ng-model="register.Status" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Life Time<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Life Time" ng-model="register.Lifetime" n-decimals="2" class="form-control" tabindex="9" autocomplete="off" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="register.Remarks" maxlength="250" tabindex="24" name="Remarks"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Type</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Type" class="form-control" ng-model="register.Type" ng-disabled="register.Id!==null" ng-options="item.Value as item.Text for item in typeList" tabindex="1">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Capitalization Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Capitalization Date" ng-model="register.CapitalizationDate" datepicker class="form-control datepicker" tabindex="10" required>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Quantity<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Qty" ng-model="register.Qty" only-numbers class="form-control text-right" tabindex="20" required>
                                </div>

                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">GRN Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" name="GRNAmount" disabled ng-model="register.GRNAmount" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Issue Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" name="IssueAmount" disabled ng-model="register.IssueAmount" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Expenses Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" name="ExpensesAmount" disabled ng-model="register.ExpensesAmount" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Total Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Total Amount" disabled ng-model="register.TotalAmount" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Other</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Other" ng-model="register.Other" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">Selection</legend>

                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li>
                                            <button ng-disabled="register.IsApproved==true" ng-click="showSearchData('AUC');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>AUC</button>
                                            <button ng-disabled="register.IsApproved==true" ng-click="showSearchData('CI');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Capitalize Inventory</button>
                                            <button ng-disabled="register.IsApproved==true" ng-click="showSearchData('Expense');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Expense</button>
                                        </li>
                                    </ul>
                                </div>
                                <div class="table-responsive modal-table" ng-show="selectedmaterialMasterList.length">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Action</th>
                                                <th>Voucher No</th>
                                                <th>Material</th>
                                                <th>Article</th>
                                                <th>GRN No</th>
                                                <th>GRN RowId</th>
                                                <th>Qty</th>
                                                <th>Amount</th>
                                                <th>Source</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in selectedmaterialMasterList">
                                                <td>
                                                    <div class="common-btn">
                                                        <ul class="list-inline text-left">
                                                            <li>
                                                                <button ng-click="RemoveItemVoucher(x);" ng-disabled="register.IsApproved==true" class="btn"><i class="glyphicon glyphicon-trash" tabindex="3"></i></button>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </td>
                                                <td>{{x.VoucherNo}}</td>
                                                <td>{{x.MaterialMasterName}}</td>
                                                <td>{{x.ArticleStandardName}}</td>
                                                <td>{{x.GRNNo}}</td>
                                                <td>{{x.InventoryReceiveDetailId}}</td>
                                                <td class="text-right">{{x.Qty}}</td>
                                                <td class="text-right">{{x.Amount}}</td>
                                                <td>{{x.Source}}</td>
                                            </tr>
                                            <tr>
                                                <td><label>Total </label></td>
                                                <td colspan="6"></td>
                                                <td class="text-right">
                                                    <label>
                                                        {{selectedmaterialMasterList | sumByKey : 'Amount'|number:2}}
                                                    </label>
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>
                        </div>

                        <div class="clearfix"></div>
                        <div class="col-xs-12 col-sm-12 col-md-12" style="padding-left:0px" ng-show="register.Type=='Addition'">
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button class="btn single-btn" ng-click="showAssetRegisterPopUp()" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Select Asset Register</button>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12" ng-show="checkedAssetRegisterList.length">
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>CM Id</th>
                                            <th>CC Id</th>
                                            <th>Asset Amount</th>
                                            <th>Distributed Amount</th>
                                            <th>Asset Item</th>
                                            <th>Asset Item Id</th>
                                            <th>Asset Register Id</th>
                                            <th>Asset Sl No</th>
                                            <th>Status</th>
                                            <th>Asset Condition</th>
                                            <th>User Reference</th>
                                            <th>Old Reference</th>
                                            <th>User Group</th>
                                            <th>Remarks</th>
                                            <th class="col-sm-1">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in checkedAssetRegisterList">
                                            <td>
                                                <input type="text" title="Capitalization Master Id" class="form-control text-left" name="CapitalizationMasterId" autocomplete="off" ng-model="x.CapitalizationMasterId" readonly>
                                            </td>
                                            <td>
                                                <input type="text" title="Capitalization Child Id" class="form-control text-left" name="CapitalizationChildId" autocomplete="off" ng-model="x.CapitalizationChildId" readonly>
                                            </td>
                                            <td>
                                                <input type="text" n-decimals="2" title="Asset Amount" class="form-control text-right" name="AssetAmount" autocomplete="off" ng-model="x.AssetAmount" readonly>
                                            </td>
                                            <td>
                                                <input ng-keyup="checkDistributedAmount($index,x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="x.Amount">
                                            </td>
                                            <td>{{x.FixedAssetItem}}</td>
                                            <td>{{x.FixedAssetItemId}}</td>
                                            <td>{{x.AssetRegisterId}}</td>
                                            <td>{{x.AssetSlNo}}</td>
                                            <td>{{x.Status}}</td>
                                            <td>{{x.AssetCondition}}</td>
                                            <td>{{x.UserReference}}</td>
                                            <td>{{x.OldReference}}</td>
                                            <td>{{x.UserGroup}}</td>
                                            <td>{{x.Remarks}}</td>
                                            <td class="text-right">
                                                <ul class="list-inline action-list">
                                                    <li><button ng-click="DeleteConfirmation(x.AssetRegisterId)" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                                </ul>
                                            </td>

                                        </tr>
                                        <tr>
                                            <td colspan="2" class="text-right"><strong>Total : </strong></td>
                                            <td class="text-right"><strong>{{checkedAssetRegisterList | sumByKey : 'AssetAmount'|  number:2 }}</strong></td>
                                            <td class="text-right"><strong>{{checkedAssetRegisterList | sumByKey : 'Amount'|  number:2 }}</strong></td>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="SaveRegister();" class="btn" ng-disabled="register.IsApproved==true || saveBtnDisable==true" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            @*<li><button ng-show="btndeleteregister" ng-click="deleteRegisterPop()" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchByCapitalizeData">
                            <option ng-repeat="option in searchByListCapitalizeData" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="searchCapitalizeData" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <div style="color:black;" id="GridMaster" ej-grid e-datasource="masterList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
         e-recorddoubleclick="SelectMaster" e-allowselection="true" e-filtersettings-filterType="excel">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Master Id" e-width="80"></div>
            <div e-column e-field="FixedAssetMasterId" e-headertext="Asset Master Id" e-width="40" e-filter="false"></div>
            <div e-column e-field="FixedAssetItemId" e-headertext="Asset Item Id" e-width="40" e-filter="false"></div>
            <div e-column e-field="FixedAssetItem" e-headertext="Asset Item" e-width="100"></div>
            <div e-column e-field="FixedAssetMaster" e-headertext="Asset Master" e-width="100"></div>
            <div e-column e-field="CD" e-headertext="Capitalization Date" e-width="80"></div>
            <div e-column e-field="Qty" e-headertext="Qty" e-width="50"></div>
            <div e-column e-field="GRNAmount" e-headertext="GRN Amount" e-width="80"></div>
            <div e-column e-field="IssueAmount" e-headertext="Issue Amount" e-width="80"></div>
            <div e-column e-field="ExpensesAmount" e-headertext="Expenses Amount" e-width="60"></div>
            <div e-column e-field="TotalAmount" e-headertext="Total Amount" e-width="80"></div>
            <div e-column e-field="ApprovedByName" e-headertext="ApprovedBy" e-width="80"></div>
            <div e-column e-field="Approved" e-headertext="Approved" e-width="50"></div>
            <div e-column e-field="Type" e-headertext="Type" e-width="50"></div>
            <div e-column e-field="CMStatus" e-headertext="Status" e-width="50"></div>
            <div e-column e-template="#ShowActionButtonsassigned" e-headertext="Actions" e-width="100" e-textalign="center"></div>
        </div>
    </div>
    <script type="text/ng-template" id="ShowActionButtonsassigned">
        <div class="common-btn">
            <ul class="common-btn list-inline text-left">
                <li ng-show="data.Type=='New'">
                    <div ej-tooltip e-showshadow="true" e-content="Asset Register Update" ng-click="$parent.onClickAssetRegisterpopUpByCapitalizationMasterId(data);" e-width="width">
                        <button class="btn" style="background-color: #1c1f32;"><i class="glyphicon glyphicon-floppy-disk"></i></button>
                    </div>
                </li>
                <li ng-show="data.CMStatus=='Parked'">
                    <a class="btn btn-action" ng-click="$parent.confirmDelete(this);" title="Delete" href=""><i class=""></i>Delete</a>
                </li>
            </ul>
        </div>
    </script>
</div>
<confirm-modal></confirm-modal>


@Html.Partial("~/Areas/FixedAssets/Views/_CapitalizeAssetItemPopUpNew.cshtml")

<div class="modal fade site-modal in" id="fixedAssetMasterItemPoUp" role="dialog" data-backdrop="static" style="overflow:scroll" ng-scroll="auto">
    <div class="modal-dialog modal-lg">
        <div class="modal-content row">
            <div class="modal-header">Fixed Asset Master Item <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal" style="overflow:scroll">
                <div style="color:black;" id="GridAssetItem" ej-grid e-datasource="FixedAssetMasterItemList" e-recorddoubleclick="SetFAMI" e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                        <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="60"></div>
                        <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
                        <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="80"></div>
                        <div e-column e-type="string" e-field="FixedAssetMaster" e-headertext="Fixed Asset Master" e-width="80"></div>
                        <div e-column e-type="string" e-field="FixedAssetCategory" e-headertext="Fixed Asset Category" e-width="80"></div>
                        <div e-column e-type="string" e-field="FixedAssetSubCategory" e-headertext="Fixed Asset Subcategory" e-width="80"></div>
                        <div e-column e-type="string" e-field="Active" e-headertext="Active" e-width="30"></div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="AssetRegisterUpdatePopUp" role="dialog" data-backdrop="static" style="overflow:scroll" ng-scroll="auto">
    <div class="modal-dialog modal-lg" style="width:1400px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Asset Register</h4>
            </div>
            <div class="modal-body">
                <div class="col-xs-12 col-sm-12 col-md-12" style="margin-bottom:10px">
                    <div id="AssetRegisterGridPopUpdate" ej-grid e-datasource="AssetRegisterUpdateAvailableList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="CapitalizationMasterId" e-headertext="CM Id" e-width="3"></div>
                            <div e-column e-field="CapitalizationChildId" e-headertext="CC Id" e-width="3"></div>
                            <div e-column e-template="#AssetAmount" e-field="AssetAmount" e-headertext="Amount" e-width="3" e-type="numeric" e-format="{0:0.00}" e-textalign="right"></div>
                            <div e-column e-template="#FixedAssetItem" e-field="FixedAssetItem" e-headertext="Asset Item" e-width="7"></div>
                            <div e-column e-field="FixedAssetItemId" e-headertext="Asset Item Id" e-width="3"></div>
                            <div e-column e-field="AssetRegisterId" e-headertext="Asset Register Id" e-width="3"></div>
                            <div e-column e-template="#AssetSlNo" e-field="AssetSlNo" e-headertext="Asset Sl No" e-width="3"></div>
                            <div e-column e-template="#Status" e-field="Status" e-headertext="Status" e-type='string' e-width="3"></div>
                            <div e-column e-template="#AssetCondition" e-field="AssetCondition" e-headertext="Asset Condition" e-type='string' e-width="3"></div>
                            <div e-column e-template="#UserReference" e-field="UserReference" e-headertext="User Reference" e-width="4"></div>
                            <div e-column e-template="#OldReference" e-field="OldReference" e-headertext="Old Reference" e-type='string' e-width="3"></div>
                            <div e-column e-template="#UserGroup" e-field="UserGroup" e-headertext="User Group" e-type='string' e-width="3"></div>
                            <div e-column e-template="#Remarks" e-field="Remarks" e-headertext="Remarks" e-type='string' e-width="3"></div>
                        </div>
                        <script type="text/template" id="AssetAmount">
                            <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="data.Amount" ng-readonly="data.VoucherDetailId">
                        </script>
                        <script type="text/template" id="FixedAssetItem">
                            <div class="input-group">
                                <input type="text" name="FixedAssetItem" ng-model="data.FixedAssetItem" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button style="height: 34Px;" ng-click="$parent.ShowFixedAssetMasterItemAssetRegisterUpdate(this,data.AssetRegisterId,data.AssetRegisterChildId)" class="btn btn-action tooltip-here" data-placement="top" title="Update Asset Item" ng-disabled="data.VoucherDetailId"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </script>
                        <script type="text/template" id="AssetSlNo">
                            <input type="text" title="AssetSlNo" class="form-control text-left" name="AssetSlNo" autocomplete="off" ng-model="data.AssetSlNo">
                        </script>
                        <script type="text/template" id="Status">
                            <input type="text" title="AssetSlNo" class="form-control text-left" name="Status" autocomplete="off" ng-model="data.Status">
                        </script>
                        <script type="text/template" id="AssetCondition">
                            <input type="text" title="AssetCondition" class="form-control text-left" name="AssetCondition" autocomplete="off" ng-model="data.AssetCondition">
                        </script>
                        <script type="text/template" id="UserReference">
                            <input type="text" title="UserReference" class="form-control text-left" name="UserReference" autocomplete="off" ng-model="data.UserReference">
                        </script>
                        <script type="text/template" id="OldReference">
                            <input type="text" title="OldReference" class="form-control text-left" name="UserReference" autocomplete="off" ng-model="data.OldReference">
                        </script>
                        <script type="text/template" id="UserGroup">
                            <input type="text" title="UserGroup" class="form-control text-left" name="UserGroup" autocomplete="off" ng-model="data.UserGroup">
                        </script>
                        <script type="text/template" id="Remarks">
                            <input type="text" title="Remarks" class="form-control text-left" name="Remarks" autocomplete="off" ng-model="data.Remarks">
                        </script>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="UpdateAssetRegister();" class="btn"><i></i>Update</button></li>
                        <li> <button ng-click="hideAssetRegisterUpdatePopUp();" class="btn"><i class="glyphicon glyphicon-remove"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="fixedAssetMasterItemAssetRegisterUpdatePoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" style="width:1400px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Asset Item</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <div id="fixedAssetMasterItemAssetRegisterUpdateGridPopUp" ng-init="chkinit()" ej-grid e-datasource="FixedAssetMasterItemList"
                         e-recorddoubleclick="SetFAMIAssetRegisterUpdate" e-load="loadGridEdit" e-allowfiltering="true" e-allowpaging="true"
                         e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                            <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="60"></div>
                            <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
                            <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="80"></div>
                            <div e-column e-type="string" e-field="FixedAssetMaster" e-headertext="Fixed Asset Master" e-width="80"></div>
                            <div e-column e-type="string" e-field="FixedAssetCategory" e-headertext="Fixed Asset Category" e-width="80"></div>
                            <div e-column e-type="string" e-field="FixedAssetSubCategory" e-headertext="Fixed Asset Subcategory" e-width="80"></div>
                            <div e-column e-type="string" e-field="Active" e-headertext="Active" e-width="30"></div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="hideAssetRegisterItemUpdatePopUp();" class="btn"><i class="glyphicon glyphicon-remove"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="AssetRegisterPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" style="width:1400px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Asset Register</h4>
            </div>
            <div class="row text-right">
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="searchByAssetRegister">
                                        <option ng-repeat="option in searchByAssetRegisterList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="searchAssetRegister" ng-enter="showAssetRegisterPopUp()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="showAssetRegisterPopUp()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <div id="AssetRegisterGridPopUp" ng-init="chkinit()" ej-grid e-datasource="AssetRegisterAvailableList" e-load="loadGridEdit"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-template="#checkboxTemplateMaster" e-headertext="Check" e-textalign="center" e-width="3"></div>
                            <div e-column e-field="CapitalizationMasterId" e-headertext="CM Id" e-width="3"></div>
                            <div e-column e-field="CapitalizationChildId" e-headertext="CC Id" e-width="3"></div>
                            <div e-column e-field="AssetAmount" e-headertext="Amount" e-width="3" e-type="numeric" e-format="{0:0.00}" e-textalign="right"></div>
                            <div e-column e-field="FixedAssetItem" e-headertext="Asset Item" e-width="7"></div>
                            <div e-column e-field="FixedAssetItemId" e-headertext="Asset Item Id" e-width="3"></div>
                            <div e-column e-field="AssetRegisterId" e-headertext="Asset Register Id" e-width="3"></div>
                            <div e-column e-field="AssetSlNo" e-headertext="Asset Sl No" e-width="2"></div>
                            <div e-column e-field="Status" e-headertext="Status" e-type='string' e-width="3"></div>
                            <div e-column e-field="AssetCondition" e-headertext="Asset Condition" e-type='string' e-width="3"></div>
                            <div e-column e-field="UserReference" e-headertext="User Reference" e-width="4"></div>
                            <div e-column e-field="OldReference" e-headertext="Old Reference" e-type='string' e-width="3"></div>
                            <div e-column e-field="UserGroup" e-headertext="User Group" e-type='string' e-width="3"></div>
                            <div e-column e-field="Remarks" e-headertext="Remarks" e-type='string' e-width="3"></div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxTemplateMaster">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                    </script>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="AddAssetRegister();" class="btn"><i></i> Apply</button></li>
                        <li> <button ng-click="hideAssetRegisterPopUp();" class="btn"><i class="glyphicon glyphicon-remove"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="DeleteConfirmationPopUp" title="Confirmation" message={{message_conf}} data-ng-click-right-button="RemoveAssetRegisterId()"></confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmregisterdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRegisterYes()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmVoucherRemovePopUp" title="Confirmation" message={{message_VoucherRemoveconfirmation}} data-ng-click-right-button="RemoveVoucher();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(capitalizationMasterId)"></confirm-archive-generic>