<div class="table-responsive modal-table aplos-grid-toggle">
    <div style="color:black;" id="GridMaster" ej-grid e-datasource="masterList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
         e-recorddoubleclick="SelectMaster" e-allowselection="true" e-filtersettings-filterType="excel">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
            <div e-column e-field="CapitalizationDate" e-headertext="CapitalizationDate" e-width="80"></div>
            <div e-column e-field="Qty" e-headertext="Qty" e-width="80"></div>
            <div e-column e-field="GRNAmount" e-headertext="GRNAmount" e-width="80"></div>
            <div e-column e-field="IssueAmount" e-headertext="IssueAmount" e-width="80"></div>
            <div e-column e-field="ExpensesAmount" e-headertext="ExpensesAmount" e-width="80"></div>
            <div e-column e-field="Other" e-headertext="Other" e-width="80"></div>
            <div e-column e-field="TotalAmount" e-headertext="TotalAmount" e-width="80"></div>
            <div e-column e-field="ApprovedBy" e-headertext="ApprovedBy" e-width="80"></div>
        </div>
    </div>

</div>
<confirm-modal></confirm-modal>

<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee Information<button type="button" class="close" data-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="SystemId" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closePopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>
@Html.Partial("~/Areas/FixedAssets/Views/_CapitalizeAssetItemPopUpNew.cshtml")

<div class="modal fade site-modal in" id="fixedAssetMasterItemPoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content row">
            <div class="modal-header">Fixed Asset Master Item <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div style="color:black;" id="Grid" ej-grid e-datasource="FixedAssetMasterItemList" e-recorddoubleclick="SetFAMI" e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                        <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="60"></div>
                        <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
                        <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="80"></div>
                        <div e-column e-type="string" e-field="FixedAssetMaster" e-headertext="Fixed Asset Master" e-width="80"></div>
                        <div e-column e-type="string" e-field="FixedAssetCategory" e-headertext="Fixed Asset Category" e-width="80"></div>
                        <div e-column e-type="string" e-field="FixedAssetSubCategory" e-headertext="Fixed Asset Subcategory" e-width="80"></div>
                        <div e-column e-type="string" e-field="Active" e-headertext="Active" e-width="30"></div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmregisterdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRegisterYes()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmVoucherRemovePopUp" title="Confirmation" message={{message_VoucherRemoveconfirmation}} data-ng-click-right-button="RemoveVoucher();"></confirm-archive-generic>