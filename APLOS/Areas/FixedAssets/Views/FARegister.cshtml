<togglable name="Capitalize Asset Register"></togglable>
<div class="form-elements form-horizontal">
    <div class="col-xs-12">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Asset</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form="form0">
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">Selection</legend>

                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li>
                                            <button ng-click="showSearchData('AUC');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>AUC</button>
                                            <button ng-click="showSearchData('CI');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Capitalize Inventory</button>
                                            <button ng-click="showSearchData('Expense');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Expense</button>
                                        </li>
                                    </ul>
                                </div>
                                <div class="table-responsive modal-table" ng-show="selectedmaterialMasterList.length">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Action</th>
                                                <th>Voucher No</th>
                                                <th>Material</th>
                                                <th>Article</th>
                                                <th>GRN No</th>
                                                <th>Qty</th>
                                                <th>Amount</th>
                                                <th>Source</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in selectedmaterialMasterList">
                                                <td>
                                                    <div class="common-btn">
                                                        <ul class="list-inline text-left">
                                                            <li>
                                                                <button ng-click="RemoveItemVoucher(x);" class="btn"><i class="glyphicon glyphicon-trash" tabindex="3"></i></button>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </td>
                                                <td>{{x.VoucherNo}}</td>
                                                <td>{{x.MaterialMasterName}}</td>
                                                <td>{{x.ArticleStandardName}}</td>
                                                <td>{{x.GRNNo}}</td>
                                                <td class="text-right">{{x.Qty}}</td>
                                                <td class="text-right">{{x.Amount}}</td>
                                                <td>{{x.Source}}</td>
                                            </tr>
                                            <tr>
                                                <td><label>Total </label></td>
                                                <td colspan="5"></td>
                                                <td class="text-right">
                                                    <label>
                                                        {{selectedmaterialMasterList | sumByKey : 'Amount'|number:2}}
                                                    </label>
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </fieldset>

                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Asset No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Id" ng-model="register.Id" class="form-control" readonly tabindex="3">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Asset Item<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="input-group">
                                        <input type="text" name="AssetItem" ng-model="register.FixedAssetItem" class="form-control" readonly required>
                                        <span class="input-group-btn">
                                            <button ng-click="ShowFixedAssetMasterItem();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                            <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">GRN Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" name="GRNAmount" disabled ng-model="register.GRNAmount" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Expenses Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" name="ExpensesAmount" disabled ng-model="register.ExpensesAmount" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Approved By<sup>*</sup></label>
                                <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                                    <input type="hidden" name="Approved By" ng-model="register.ApprovedById" class="form-control">
                                    <span class="input-group-addon">{{register.ApprovedByEmployeeCode}}</span>
                                    <input type="text" name="Approved By" ng-model="register.ApprovedByName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="13"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="clearEmp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Installation Year<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" only-numbers name="Installation Year" maxlength="4" required ng-model="register.InstallationYear" class="form-control text-right" tabindex="19" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Status</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Status" ng-model="register.Status" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Capitalization Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Capitalization Date" ng-model="register.CapitalizationDate" datepicker class="form-control datepicker" tabindex="10" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Number of Quantity</label>
                                <div class="col-sm-8">
                                    <input type="text" name="NumberOfQuantity" ng-model="NumberOfQuantity" class="form-control text-right" tabindex="20">
                                </div>

                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Issue Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" name="IssueAmount" disabled ng-model="register.IssueAmount" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Total Amount</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Total Amount" disabled ng-model="register.TotalAmount" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Other</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Other" ng-model="register.Other" class="form-control" tabindex="9" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Useful Life (Years)</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Life Time" n-decimals="2" maxlength="3" ng-model="register.LifeTime" class="form-control" tabindex="20">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="register.Remarks" maxlength="250" tabindex="24" name="Remarks"></textarea>
                                </div>
                            </div>
                        </div>


                    </div>
                </div>

            </div>
        </div>
        
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="SaveRegister();" class="btn" ng-disabled="isSave" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            @*<li><button ng-show="btndeleteregister" ng-click="deleteRegisterPop()" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
