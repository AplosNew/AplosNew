<div class="modal fade site-modal in" id="assetmodal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Asset Item
                <button type="button" class="close" ng-click="closePopUp()" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchMaterialMasterParameters.searchBy">
                                            <option ng-repeat="option in searchByMaterialMasterModalList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchMaterialMasterParameters.search" ng-enter="loadMaterialMasterModalList()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadMaterialMasterModalList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                @*<th>Material Type</th>*@
                                <th>Material Group</th>
                                <th>Code</th>
                                <th>Material Master</th>
                                <th>Base UOM</th>
                                <th>Origin Applicable</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in materialMasterList |itemsPerPage:searchMaterialMasterParameters.pageSize" total-items="searchMaterialMasterParameters.total_count" pagination-id="metaData.name + 'materialMasterList'" ng-dblclick="checkIsRegisterApplyInMaterialMaster(x); pushInTempList(x, $event, activityFAMasterList);">
                                @*<td>{{x.MaterialTypeName}}</td>*@
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.BaseUOMName}}</td>
                                <td>{{x.IsOriginApplicable?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'materialMasterList'" direction-links="true" boundary-links="true" on-page-change="loadMaterialMasterModalList(newPageNumber)"></dir-pagination-controls>
            </div>
        </div>
    </div>
</div>