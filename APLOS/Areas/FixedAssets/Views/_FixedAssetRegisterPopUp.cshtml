<style>
    .modellgModify {
        width: 1400px;
    }
</style>
<div class="modal fade site-modal in" id="assetRegisterPopUpmodal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Fixed Asset Register List <button type="button" class="close" ng-click="closeFARegisterPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByFARegister">
                                            <option ng-repeat="option in searchByFARegisterList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchFARegister" ng-enter="getFixedAssetRegisterPopUpList()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getFixedAssetRegisterPopUpList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        <div style="color:black;" id="partyPopUpGrid" ej-grid e-datasource="assetRegisterPopUpList" e-recorddoubleclick="selectFARegisterPopUp"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="AssetNo" e-headertext="Asset No" e-width="60" e-filter="false"></div>
                                <div e-column e-field="SerialNo" e-headertext="Serial No" e-width="60" e-filter="false"></div>
                                <div e-column e-field="MaterialMasterName" e-headertext="Material Master" e-width="120" e-filter="false"></div>
                                <div e-column e-field="Article" e-headertext="Article" e-width="120"></div>
                                <div e-column e-field="FixedAssetMasterName" e-headertext="Fixed Asset Master" e-width="120" e-filter="false"></div>
                                <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="PurchaseDate" e-headertext="Purchase Date" e-width="60"></div>
                                <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="CapitalizationDate" e-headertext="Capitalization Date" e-width="60"></div>
                                <div e-column e-field="FABaseAmount" e-headertext="FA Base Amount" e-width="80"></div>
                                <div e-column e-field="SubAssetBaseAmount" e-headertext="Base Sub Asset" e-width="80"></div>
                                <div e-column e-field="PurchaseBaseAmount" e-headertext="Total Base Amount" e-width="80"></div>
                                <div e-column e-field="ADBaseAmount" e-headertext="Depreciation" e-width="80"></div>
                                <div e-column e-field="NetBaseBookValue" e-headertext="Net Base Amount" e-width="80"></div>
                                <div e-column e-field="Vendor" e-headertext="Vendor" e-width="120" e-filter="false"></div>
                                <div e-column e-field="InvoiceNo" e-headertext="Invoice No" e-width="80" e-filter="false"></div>
                                <div e-column e-field="TrnCurrency" e-headertext="Trn Currency" e-width="80"></div>
                                @*<div e-column e-field="FixedAssetCategory" e-headertext="FA Category" e-width="80"></div>
                                <div e-column e-field="FixedAssetSubCategory" e-headertext="FA SubCategory" e-width="80"></div>
                                <div e-column e-field="AssetType" e-headertext="AssetType" e-width="60"></div>*@

                                @*<div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="IssueDate" e-headertext="Issue Date" e-width="60"></div>*@
                                @*<div e-column e-field="BaseCurrency" e-headertext="Currency" e-width="80"></div>*@
                                @*<div e-column e-field="NegotiationValue" e-headertext="Negotiation Value" e-width="80"></div>*@

                                <div e-column e-field="IsOBBalance" e-headertext="OB" e-width="40"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeFARegisterPopUp();" class="btn"> Close</button></li>
                </ul>
                <i>**Showing top 300 Register order by Serial No</i>
            </div>
        </div>
    </div>
</div>
