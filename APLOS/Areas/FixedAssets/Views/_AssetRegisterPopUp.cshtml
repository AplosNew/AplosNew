
<style>
    .modellgModify {
        width: 1400px;
    }
</style>
<div class="modal fade site-modal in" id="assetRegistermodal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Asset Register <button type="button" class="close" ng-click="closeAssetRegisterPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="Grid" ej-grid e-datasource="assetRegisterItemForSubAssetList" e-templaterefresh="refreshTemplateMasterOrderOperation" 
                              e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"                         e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionComplete"                         e-showstackedheader="true" e-allowExcelExport='true' e-enableGroupingBar="true">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplateChild" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="FixedAssetRegisterId" e-headertext="Register No" e-width="80" e-filter="false"></div>
                                <div e-column e-field="AssetMasterName" e-headertext="AssetMaster" e-width="80" e-filter="false"></div>
                                <div e-column e-field="MaterialMasterName" e-headertext="Material Master" e-width="80" e-filter="false"></div>
                                <div e-column e-field="ArticleStandardName" e-headertext="Article" e-width="80" e-filter="false"></div>
                                <div e-column e-field="Price" e-headertext="Price" e-width="80" e-filter="false"></div>
                                <div e-column e-field="InvoiceNo" e-headertext="InvoiceNo" e-width="80"></div>
                                @*<div e-column e-field="CapitalizeVoucherNo" e-headertext="CapitalizeVoucherNo" e-width="80" e-filter="false"></div>*@
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplateChild">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="checkassetRegisterApply();" class="btn"> Apply</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>