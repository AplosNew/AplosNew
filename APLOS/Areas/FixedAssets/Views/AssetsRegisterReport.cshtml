                    <label class="col-sm-5 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Form Date" ng-model="report.FromDate" datepicker tabindex="2" class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <div class="form-group" show-errors id="div_ToDate">
                    <label class="col-sm-5 control-label">TO Date<sup>*</sup></label>
                    <div class="col-sm-7  show-message">
                        <input type="text" name="To Date" ng-model="report.ToDate" datepicker tabindex="2" class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">
                <div class="form-group" show-errors id="div_IsDynamic">
                    <label class="col-sm-6 control-label">Is Dynamic</label>
                    <div class="col-sm-6">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="report.IsDynamic">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-1 col-sm-1 col-md-1">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="GetFixedAssetRegisterElasticSearchData();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> View</button></li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
            </div>
        </div>
    </div>
