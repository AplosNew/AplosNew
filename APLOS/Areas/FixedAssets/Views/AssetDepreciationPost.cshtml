<togglable name="Capitalize Asset Depreciation Post"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Select Asset Depreciation Id<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" class="form-control" readonly name="AssetDepreciationId" ng-model="voucher.AssetDepreciationId">
            </div>
            <div class="col-sm-2 input-group">
                <span class="input-group-btn">
                    <button ng-click="getDepreciationData();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Info</legend>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="ProcessName" ng-model="voucher.ProcessName" class="form-control" readonly>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Entry Date" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <textarea rows="2" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div id="div_PostingDate" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input required id="postingDate" type="text" name="Posting Date" ng-model="voucher.PostingDate" class="form-control" tabindex="1" readonly>
                </div>
            </div>
            <div id="div_DocDate" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input required id="docDate" type="text" name="Doc Date" ng-model="voucher.DocDate" class="form-control" tabindex="1" readonly>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select ng-change="entityChange(voucher.EntityId)" id="entityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="7" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">JV</legend>
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>Dr</th>
                        <th>Cr</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in fixedAssetDepreciationJVList| orderBy:'-TrnType'">
                        <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td class="text-right">{{x.Dr | number| setDecimal:4}}</td>
                        <td class="text-right">{{x.Cr | number| setDecimal:4}}</td>
                    </tr>
                    <tr>
                        <td colspan="3"></td>
                        <td class="text-right"><strong>{{fixedAssetDepreciationJVList | sumByKey : 'Dr' | number| setDecimal:4}}</strong></td>
                        <td class="text-right"><strong>{{fixedAssetDepreciationJVList | sumByKey : 'Cr' | number| setDecimal:4}}</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </fieldset>

    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>


</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="voucherList" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="40" e-filter="false"></div>
            <div e-column e-field="PostingDate" e-headertext="Posting Date" e-width="40"></div>
            <div e-column e-field="AssetDepreciationId" e-headertext="Asset Depreciation Id" e-width="30"></div>
            <div e-column e-field="ProcessName" e-headertext="Process Name" e-width="120"></div>
            <div e-column e-field="ProcessDate" e-headertext="Depreciation Process Date" e-width="40"></div>
            <div e-column e-field="Status" e-headertext="Status" e-width="30"></div>
            <div e-column e-field="BaseCurrency" e-headertext="Currency" e-width="30"></div>
            <div e-column e-field="DepreciationAmount" e-headertext="Amount" e-width="40" e-type="numeric" e-format="{0:0.00}" e-textalign="right"></div>
            <div e-column e-template="#ShowActionButtonsassigned" e-headertext="PDF&Excel" e-width="80"></div>

        </div>
    </div>

    <script type="text/ng-template" id="ShowActionButtonsassigned">
        <div class="common-btn">
            <ul class="common-btn list-inline text-left">
                <li>
                    <div ej-tooltip e-showshadow="true" e-content="Excel" ng-click="$parent.onClickReportDownloadExcel(data);" e-width="width">
                        <button class="btn" style="background-color: #1c1f32;"><i class="fa fa-file-excel-o"></i></button>
                    </div>
                </li>
                <li>
                    <div ej-tooltip e-showshadow="true" e-content="Pdf" ng-click="$parent.onClickReportDownloadWord(data);" e-width="width">
                        <button class="btn" style="background-color: #1c1f32;"><i class="fa fa-file-pdf-o"></i></button>
                    </div>
                </li>
                <li ng-show="data.Status=='Parked'">
                    <a class="btn btn-action" ng-click="$parent.confirmDelete(this);" title="Delete" href=""><i class=""></i>Delete</a>
                </li>
            </ul>
        </div>
    </script>
</div>
<style>
    .modellgModify {
        width: 1000px;
    }
</style>

<div class="modal fade site-modal in" id="DepreciationPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Capitalize Asset Depreciation List <button type="button" class="close" ng-click="closeFixedAssetDepreciationPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="DepreciationSearchBy">
                                            <option ng-repeat="option in DepreciationSearchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="DepreciationSearch" ng-enter="getDepreciationData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getDepreciationData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        <div id="GridEdit" ej-grid e-datasource="fixedAssetDepreciationList" e-recorddoubleclick="getDataByDepreciationId" e-load="loadGridEdit"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="AssetDepreciationId" e-headertext="Asset Depreciation Id" e-width="30"></div>
                                <div e-column e-field="ProcessName" e-headertext="Process Name" e-width="100"></div>
                                <div e-column e-field="ProcessDate" e-headertext="Depreciation Process Date" e-width="60"></div>
                                <div e-column e-field="Status" e-headertext="Status" e-width="40"></div>
                                <div e-column e-field="BaseCurrency" e-headertext="Currency" e-width="40"></div>
                                <div e-column e-field="DepreciationAmount" e-headertext="Depreciation Amount" e-width="80" e-type="numeric" e-format="{0:0.00}" e-textalign="right"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeFixedAssetDepreciationPopUp();" class="btn"> Close</button></li>
                </ul>
                <i>**Showing top 100  order by Depreciation Process Date</i>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="confirmDeletePopUp_Remarks" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:600px">
        <div class="modal-content" ng-form name="confirmDeletePopUp_RemarksForm">
            <div class="modal-header">Are you sure to Delete?</div>
            <div class="modal-body">
                <div class="form-group" show-errors>
                    <label class="col-sm-2 control-label">Remarks<sup>*</sup></label>
                    <div class="col-sm-10 show-message">
                        <textarea rows="4" type="text" maxlength="500" name="DeletedRemarks" tabindex="8" class="form-control" ng-model="deletedRemarks" required></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeconfirmDeletePopUp_Remarks()">No</button>
                <button type="button" class="btn btn-default" ng-click="delete()">Yes</button>
            </div>
        </div>
    </div>
</div>