<togglable name="Capitalize Asset Dispose"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Disposal Type<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select class="form-control" ng-disabled="Action == 'Update'" ng-change="DisposeTpye();" name="Status" submit-required="true" ng-model="voucher.Status" required
                            ng-options="item.Value as item.Text for item in fixedAssetDisposeStatusList"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border" ng-show="voucher.Status=='@Library.Service.Enums.FixedAssetDisposeStatusEnum.CompensateByEmployee.ToString()'">
        <legend class="scheduler-border"> Employee Info</legend>
        <div class="col-xs-12 col-sm-5 col-md-5">
            <div class="form-group">
                <label class="col-sm-4 control-label">Select Employee<sup>*</sup></label>
                <div class="col-sm-7 show-message">
                    <input type="text" class="form-control" readonly name="EmployeeName" ng-model="voucher.EmployeeName">
                </div>
                <div class="col-sm-1 input-group">
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Designation</label>
                <div class="col-sm-8 show-message">
                    <input type="text" readonly class="form-control" name="Designation" ng-model="voucher.LegalDesignation">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="form-group">
                <label class="col-sm-4 control-label">DOJ</label>
                <div class="col-sm-8 show-message">
                    <input type="text" readonly class="form-control" name="DOJ" ng-model="voucher.DOJ">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Department</label>
                <div class="col-sm-8 show-message">
                    <input type="text" readonly class="form-control" name="Department" ng-model="voucher.Department">
                </div>
            </div>
        </div>
    </fieldset>
    <fieldset class="scheduler-border" ng-show="voucher.Status=='@Library.Service.Enums.FixedAssetDisposeStatusEnum.Sales.ToString()' ">
        <legend class="scheduler-border"> Customer Info</legend>
        <div class="col-xs-12 col-sm-5 col-md-5">
            <div class="form-group">
                <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="PartyName" ng-model="voucher.PartyName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="showPartyPopUpNew();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                            <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                        </span>

                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-4 show-message" style="padding-right:0px;">
                    <div class="select-style">
                        <select id="currencyId" class="form-control" tabindex="5" name="Currency" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-4 show-message" style="padding-left:0px;">
                    <input type="text" maxlength="50" id="Rate" name="Rate" ng-disabled="voucher.CurrencyId==companyCurrencyId" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Lorry No</label>
                <div class="col-sm-8 show-message">
                    <input type="text" class="form-control" name="LorryNo" ng-model="voucher.LorryNo" max="100">
                </div>
            </div>
        </div>
    </fieldset>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border"> Register Info</legend>

        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="form-group">
                <label class="col-sm-8 control-label">Add Capitalize Asset Register<sup>*</sup></label>
                <div class="col-sm-4 input-group">
                    <span class="input-group-btn">
                        <button ng-click="getFixedAssetRegisterPopUpList();" class="btn single-small-btn" tabindex="2" ng-disabled="Action == 'Update'"><i class="glyphicon glyphicon-plus"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div id="div_DocDate" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Date<sup>  *</sup>  </label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
                </div>
            </div>
        </div>



        <div class="col-xs-12 col-sm-5 col-md-5">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Remarks<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <textarea rows="1" type="text" maxlength="500" name="Remarks" tabindex="8" class="form-control" ng-model="voucher.Remarks" required capitalize></textarea>
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="table-responsive modal-table ">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Asset Register Id</th>
                            <th>Asset Master</th>
                            <th>Asset Item</th>
                            <th>Asset SlNo</th>
                            <th>Asset Condition</th>
                            <th>User Reference</th>
                            <th>Old Reference</th>
                            <th>User Group</th>
                            <th>Remarks</th>

                            <th style="width:100px">Asset Amount</th>
                            <th class="text-center">Depreciation Amount</th>
                            <th class="text-center">NetAmount</th>
                            <th class="text-center">Adjustment Depreciation Amount</th>
                            <th class="text-center" ng-hide="voucher.Status == 'Scrap' || voucher.Status == 'Theft'">Negotiation Amount</th>
                            <th class="text-center">Tax Amount</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in voucherDetailList">
                            <td>{{x.FixedAssetRegisterId}}</td>
                            <td>{{x.FixedAssetMaster}}</td>
                            <td>{{x.FixedAssetItem}}</td>
                            <td>{{x.AssetSlNo}}</td>
                            <td>{{x.AssetCondition}}</td>
                            <td>{{x.UserReference}}</td>
                            <td>{{x.OldReference}}</td>
                            <td>{{x.UserGroup}}</td>
                            <td>{{x.Remarks}}</td>

                            <td><input type="text" style="width:100px" class="form-control text-right" ng-disabled="true" id="AssetAmount" ng-model="x.AssetAmount " n-decimals="2"></td>
                            <td><input type="text" class="form-control text-right" ng-disabled="true" id="DepreciationAmount" ng-model="x.DepreciationAmount " n-decimals="2"></td>
                            <td><input type="text" style="width:100px" class="form-control text-right" ng-disabled="true" id="NetAmount" ng-model="x.NetAmount " n-decimals="2"></td>
                            <td><input type="text" style="width:100px" class="form-control text-right" id="AdjustmentDepreciationAmount" ng-model="x.AdjustmentDepreciationAmount" ng-keyup="calBooksAdjustmentDepreciation(x)" n-decimals="2" autocomplete="off"></td>
                            <td ng-hide="voucher.Status == 'Scrap' || voucher.Status == 'Theft'"><input type="text" style="width:100px" class="form-control text-right" id="NegotiationValue" ng-model="x.NegotiationValue" ng-keyup="calBooksNegotiationValue(x,$index)" n-decimals="2" autocomplete="off"></td>
                            <td><input type="text" style="width:100px" class="form-control text-right" ng-disabled="true" id="TaxAmount" ng-model="x.TaxAmount " n-decimals="2"></td>
                            <td class="text-right">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="getMaterialTaxList(x, false,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button>
                                    </li>
                                    <li>
                                        <button ng-click="removeRow($index)" ng-disabled="Action == 'Update'" data-toggle="modal" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="9" class="text-right">Total</td>
                            <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'AssetAmount'| number:2 }}</b></td>
                            <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'DepreciationAmount'| number:2 }}</b></td>
                            <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'NetAmount'| number:2 }}</b></td>
                            <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'AdjustmentDepreciationAmount'| number:2 }}</b></td>
                            <td class="text-right" ng-hide="voucher.Status == 'Scrap' || voucher.Status == 'Theft'"><b>{{ (voucherDetailList ) | sumByKey:'NegotiationValue'| number:2 }}</b></td>
                            <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'TaxAmount'| number:2 }}</b></td>

                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

    </fieldset>

    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-disabled="voucher.Id" ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <fieldset class="scheduler-border" >
                <legend class="scheduler-border">Additional Tax</legend>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">If Percentage Applicable</label>
                        <div class="col-sm-6">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="TaxOptionAddiTax" ng-model="voucher.TaxOptionAddiTax" value="Yes" ng-click="TaxOptionAdditax('Yes');"> @*ng-hide="HSNCode !=null"*@
                                    <span class="cr"><i class="cr-icon"></i></span>Yes
                                </label>
                                <label>
                                    <input type="radio" name="TaxOptionAddiTax" ng-model="voucher.TaxOptionAddiTax" value="No" ng-click="TaxOptionAdditax('No');">@*ng-hide="HSNCode !=null"*@
                                    <span class="cr"><i class="cr-icon"></i></span>No
                                </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table">
                    <table class="table table-responsive table-striped">
                        <thead>
                            <tr>
                                <th>Input Tax</th>
                                <th>Percentage</th>
                                <th>Amount</th>
                                <th class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td id="td_TaxCode">
                                    <div class="select-style show-message">
                                        <select name="TaxCodeId" ng-model="advanceTax.TaxCodeId" ng-change="selectadditionalTax(advanceTax.TaxCodeId)" class="col-sm-3 form-control"
                                                ng-options="item.Id as item.UserName for item in taxCodCboListWithhold">
                                            <option></option>
                                        </select>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <input type="text" n-decimals="4" class="form-control text-right" ng-disabled="voucher.TaxOptionAddiTax==='No'" ng-model="advanceTax.ValueOfFixed" ng-keyup="calculateTaxAmountForAdditionalTax(advanceTax.ValueOfFixed);">
                                    </div>
                                </td>
                                <td id="td_TaxCodeAmount">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="advanceTax.TaxAmount" ng-keyup="copyTaxesAmount();checkRowValidationSdditionalTax(advanceTax.TaxAmount);" ng-disabled="salesVM.TaxOptionAddiTax==='Yes'">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <a ng-click="additionalTax();" ng-disabled="voucher.Id==null" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                                </td>
                            </tr>
                            <tr ng-repeat="x in advanceTaxesList">
                                <td>{{x.TaxName}}</td>
                                <td>{{x.ValueOfFixed}}</td>
                                <td class="text-right">{{x.TaxAmount | number:2 }}</td>
                                <td class="text-right">
                                    <button ng-click="removeTaxesRow(x.Id,$index)" data-toggle="modal" ng-disabled="x.AdvanceId || voucher.RowState==='Posted'" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot ng-show="advanceTaxesList.length">
                            <tr>
                                <td colspan="2"><b>Sub Total</b></td>
                                <td class="text-right"><b>{{ advanceTaxesList | sumByKey : 'TaxAmount'| setDecimal:2| number:2  }}</b></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="common-btn">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">Total Amount (Total Amount+Service Amount+Additional Tax)</label>
                        <div class="col-sm-2 show-message">
                            <input type="text" n-decimals="2" name="Total Amount" ng-model="advanceTax.TotalSumAfterTCSVal" class="form-control" tabindex="4" readonly>
                        </div>
                    </div>
                    <ul class="list-inline text-right">
                        <li><button ng-click="SaveAdditinalTax();" ng-disabled="voucher.Id==null || voucher.VoucherNo!=null" class="btn"><i class="glyphicon glyphicon-folder-close"></i>&nbsp;Save</button></li>

                    </ul>
                </div>
            </fieldset>
        </div>
    </div>

</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="voucherList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="DisposeNo" e-headertext="Dispose No" e-width="60" e-filter="false"></div>
            <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="60" e-filter="false"></div>
            <div e-column e-field="Status" e-headertext="Type" e-width="70"></div>
            <div e-column e-field="EmployeeName" e-headertext="Employee" e-width="100"></div>
            <div e-column e-field="CustomerName" e-headertext="Customer" e-width="100"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="120"></div>
            <div e-column e-field="LorryNo" e-headertext="Lorry No" e-width="60"></div>
            <div e-column e-field="NegotiationValue" e-headertext="Negotiation Amount" e-width="80" e-type="numeric" e-format="{0:0.00}" e-textalign="right"></div>
            <div e-column e-headertext="Actions" e-template="#TaxInvoiceReport" e-width="90"></div>
        </div>
        <script type="text/template" id="TaxInvoiceReport">

            <ul class="common-btn list-inline text-left">
                @*<li>
            <div ej-tooltip e-showshadow="true" e-content="Detail" ng-click="$parent.LocalTaxInvoiceReport(this);" e-width="width">
                <button class="btn" style="background-color: #1c1f32;"><i class="fa fa-file-excel-o"></i></button>
            </div>

        </li>*@
                <li>
                    <a class="btn btn-action" ng-click="$parent.FixedDisposeTaxInvoice(this);" title="Tax Invoice" href="" target="_blank"><i class=""></i>TI</a>
                </li>
                <li>
                    <a class="btn btn-action" ng-click="$parent.confirmDelete(this);" title="Delete" href="" ><i class=""></i>Delete</a>
                </li>
            </ul>

        </script>
    </div>
</div>
<style>
    .modellgModify {
        width: 1000px;
    }
</style>
<div class="modal fade site-modal in" id="employeeSelectionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content" ng-form name="PopUpForm1">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="col-xs-12 col-sm-8 col-md-8">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Select Employee<sup>*</sup></label>
                            <div class="col-sm-6 ">
                                <input type="text" ng-maxlength="50" name="ParticularName" ng-disabled="true" ng-model="voucherDetail.ParticularName" class="form-control">
                            </div>
                            <div class="col-sm-2 input-group">
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Select GL<sup>*</sup></label>
                            <div class="col-sm-6 ">
                                <input type="text" ng-maxlength="50" name="ActivityName" ng-disabled="true" ng-model="voucherDetail.ActivityName" class="form-control">
                            </div>
                            <div class="col-sm-2 input-group">
                                <span class="input-group-btn">
                                    <button ng-click="GetemployeeReconGLList();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeEmployeeSelectionPopUp();">Add</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="employeeReconGLPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="glPopUpForm1">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">GL List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeReconglListParameters.searchBy">
                                            <option ng-repeat="option in searchglemployeeReconGLByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeReconglListParameters.search" ng-enter="GetemployeeReconGLListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetemployeeReconGLListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Account Group</th>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>RefNo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeReconGLList |itemsPerPage:employeeReconglListParameters.pageSize" pagination-id="metaData.name + 'employeeReconGLList'" total-items="employeeReconglListParameters.total_count"
                                ng-dblclick="setemployeeReconGSelected(x, $index)" ng-class="{selected : x.BudgetMasterId === rowSelected}">
                                <td>{{x.AccountGroupName}}</td>
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td>{{x.RefNo}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'employeeReconGLList'" direction-links="true" boundary-links="true" on-page-change="GetemployeeReconGLListData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeEmployeeReconGLListPopUp()">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="receiveTaxPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Tax Information <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <p>Taxable amount : <b>{{taxAbleAmnt| number| setDecimal:currencyPrecision}}</b>&nbsp;<b>{{Currency}}</b></p>
                </div>
                <div class="clearfix"></div>
                <br />
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="addTax();" class="btn"><i class="glyphicon glyphicon-folder-close"></i>&nbsp;Add Tax</button></li>
                    </ul>
                </div>
                <br />
                <div class="table-responsive modal-table">
                    <table class="table table-striped" border="1" id="AddTax">
                        <thead>
                            <tr>
                                <th ng-hide="true">id</th>
                                <th>Tax Category</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in receiveTaxList |filter:{AssetRegisterId:AssetRegisterId}">
                                <td ng-hide="true">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Id" readonly>
                                    </div>
                                </td>
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList" ng-change="onchangeFunction1(x.TaxCategoryId)"></select>
                                    </div>
                                </td>
                                <td>
                                    <div class="show-message">
                                        <input type="text" n-decimals="4" class="form-control text-right" ng-model="x.Percentage" ng-keyup="calculateTaxAmount(x);">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Amount" ng-keyup="checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="taxDel(x.Id,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right"><strong>{{receiveTaxList | filter:{AssetRegisterId:AssetRegisterId} | sumByKey : 'Amount'| setDecimal:2| number:2 }}</strong></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <br />
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="closeReceiveTaxPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i>&nbsp;Add</button></li>
                        <li><button ng-click="closeReceiveTaxPopUpwindow();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

