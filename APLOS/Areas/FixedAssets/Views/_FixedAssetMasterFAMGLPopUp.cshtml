<div class="modal fade site-modal in" id="fixedAssetMasterFAMModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="glPopUpForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Fixed Asset  GL List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="fAFAMGlListParameters.searchBy">
                                            <option ng-repeat="option in searchFAMglByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="fAFAMGlListParameters.search" ng-enter="GetFAFAMData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetFAFAMData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>FixedAsset Master</th>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>RefNo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in fAFAMList |itemsPerPage:fAFAMGlListParameters.pageSize" pagination-id="metaData.name + 'fAFAMList'" total-items="fAFAMGlListParameters.total_count"
                                ng-dblclick="setFAFAMSelected(x, $index)" ng-class="{selected : x.FixedAssetMasterId === rowSelected}">
                                <td>{{x.FixedAssetName}}</td>
                                <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td>{{x.RefNo}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'fAFAMList'" direction-links="true" boundary-links="true" on-page-change="GetFAFAMData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closefAFAMListPopUp()">OK</button>
            </div>
        </div>
    </div>
</div>