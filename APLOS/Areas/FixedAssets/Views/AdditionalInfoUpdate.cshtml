<style>
    .remove-left-space {
        padding-left: 0px;
    }

    .remove-right-space {
        padding-right: 0px;
    }
</style>

<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Additional Info Update</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

            <togglable name="Additional Info Update"></togglable>
            <div class="form-elements form-horizontal" ng-form name="AdditionalInfoUpdateNewForm">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Code" maxlength="10" ng-model="modelNew.Code" class="form-control" required tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Standard Name" maxlength="100" ng-model="modelNew.StandardName" class="form-control" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Fixed Asset Item<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group" tabindex="208">
                                    <input type="text" name="FixedAssetItem" ng-model="modelNew.FixedAssetItem" ng-disabled="true" class="form-control" maxlength="200" required readonly tabindex="5">
                                    <span class="input-group-btn">
                                        <button ng-click="GetAssetItemData()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="modelNew.Description" ng-trim="false" maxlength="250" tabindex="7"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="modelNew.Active" tabindex="9">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Short Name" maxlength="15" ng-model="modelNew.ShortName" class="form-control" required tabindex="2">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" maxlength="100" ng-model="modelNew.UserName" class="form-control" required tabindex="4">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="modelNew.Remarks" ng-trim="false" maxlength="250" tabindex="10"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="14"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="15"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="16"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            
            <div class="table-responsive modal-table aplos-grid-toggle">
                <div id="GridAddUpdate"ej-grid e-actioncomplete="syncfusiongriddatabound" e-datasource="AdditionalInfoUpdateList"
                     e-allowfiltering="true" e-allowscrolling="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                     @*e-recorddoubleclick="Get"*@ e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="90px"></div>
                        <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="130px"></div>
                        <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="130px"></div>
                        <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="130px"></div>
                        <div e-column e-type="string" e-field="FixedAssetItem" e-headertext="FixedAssetItem" e-width="100px"></div>
                    </div>
                </div>

            </div>

        </div>
       

    </div>
</div>

<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="AssetItemPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Fixed Asset Item</h4>
            </div>
            <div class="modal-body">
                <div class="form-elements form-horizontal" ng-form="AssetItemForm">
                    <div id="GriAssetItem" ej-grid e-actioncomplete="syncfusiongriddatabound" e-datasource="assetItemList"
                         e-allowfiltering="true" e-allowscrolling="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                         e-recorddoubleclick="SetAssetItem" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
                            <div e-column e-field="UserName" e-headertext="User Name" e-width="4"></div>
                            <div e-column e-field="FixedAssetMaster" e-headertext="Fixed Asset Master" e-width="5"></div>
                            <div e-column e-field="CapacityUoM" e-headertext="Capacity UoM" e-width="4"></div>
                            <div e-column e-field="CapacityValue" e-headertext="Capacity Value" e-width="4"></div>
                            <div e-column e-field="Description" e-headertext="Description" e-width="4"></div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="CloseAssetItemPopUp()" class="btn">Close</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>