<div class="form-elements form-horizontal" ng-form="modelNewForm">
   
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">Capitalize Journal :</legend>

        <div class="tab-design">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet2(1) }"><a ng-click="setTab2(1)" href="" aria-controls="general" role="tab" data-toggle="tab2">Issue Material</a></li>
                    <li role="presentation" ng-class="{ active: isSet2(2) }"><a ng-click="setTab2(2);issueJournal()" href="" aria-controls="Service" role="tab" data-toggle="tab2">Journal</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(1), active: isSet2(1) }" ng-form="tabForm1">
                    <div class="row">
                        <div class="table-responsive modal-table" style="overflow:scroll">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Issue No</th>
                                        <th>Issue Date</th>
                                        <th>MaterialGroup</th>
                                        <th>Material</th>
                                        <th>Article</th>
                                        <th>SKU1</th>
                                        <th>SKU2</th>
                                        <th style="width: 200px;">Asset Master</th>
                                        <th>Qty</th>
                                        <th>Currency</th>
                                        <th>Amount (TRN)</th>
                                        <th>Amount (Books)</th>

                                        <th style="width: 200px;">Budget</th>
                                        <th style="width: 150px;">Activity</th>
                                        <th>AUC Budget</th>
                                        <th>AUC Activity</th>
                                        <th>PO No</th>
                                        <th>Vendor</th>
                                        <th>Employee Name</th>
                                        <th>UoM</th>
                                        <th>GRNNo</th>
                                        <th>GRN Date</th>
                                        <th>Gate EntryNo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in selectFixedAssetDataList">
                                        <td>{{x.IssueNo}}</td>
                                        <td>{{x.IssueDate}}</td>
                                        <td>{{x.MaterialGroupMasterName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.FirstCharacteristicsValue}}</td>
                                        <td>{{x.SecondCharacteristicsValue}}</td>
                                        <td>{{x.AssetMasterName}}</td>
                                        <td>{{x.TransactionQty}}</td>
                                        <td>{{x.GRNCurrency}}</td>
                                        <td>{{x.Amount}}</td>
                                        <td>{{x.GRNBooksAmount}}</td>
                                        <td>
                                            <div class="input-group" style="margin-top: -7px;margin-bottom: -7px;">
                                                <input type="text" ng-model="x.DrBudgetName" class="form-control" readonly style="width: 100px;">
                                                <span class="input-group-btn">
                                                    <button tabindex="1" ng-click="GetIssueAUC($index,x);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                                    <button class="btn single-small-btn" ng-click="refreshGLMB($index);"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="input-group">
                                                <div class="select-style" style="width: 150px;">
                                                    <span>
                                                        <select class="form-control" ng-model="x.PostDrActivityId" ng-options="item.ActivityId as item.ActivityName for item in activityList|
                                                                filter:{ BudgetMasterId: x.PostDrBudgetMasterId}:true">
                                                            <option></option>
                                                        </select>
                                                    </span>
                                                </div>

                                            </div>

                                        </td>
                                        <td>{{x.CrBudgetName}}</td>
                                        <td>{{x.CrActivityCode}}</td>
                                        <td>{{x.POId}}</td>
                                        <td>{{x.PartyName}}</td>
                                        <td>{{x.EmployeeName}}</td>
                                        <td>{{x.UnitOfMeasurement}}</td>
                                        <td>{{x.GRNNo}}</td>
                                        <td>{{x.GRNDate}}</td>
                                        <td>{{x.GateEntryNo}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(2), active: isSet2(2) }">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>GL</th>
                                    <th>Budget</th>
                                    <th>Activity</th>
                                    <th>Dr</th>
                                    <th>Cr</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in capitalizeJournalList">
                                    <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                    <td>{{x.BudgetName}}</td>
                                    <td>{{x.ActivityName}}</td>
                                    <td class="text-right">{{x.Dr | number| setDecimal:2}}</td>
                                    <td class="text-right">{{x.Cr | number| setDecimal:2}}</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-right"><strong>Total : </strong></td>
                                    <td class="text-right"><strong>{{capitalizeJournalList | sumByKey : 'Dr'| number| setDecimal:2 }}</strong></td>
                                    <td class="text-right"><strong>{{capitalizeJournalList | sumByKey : 'Cr'| number| setDecimal:2 }}</strong></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>

                </div>

            </div>
            <div class="clearfix"></div>
            <div class="common-btn">
                <ul class="common-btn list-inline text-right">
                    <li > <button ng-click="Post();" class="btn" ng-disabled="PostButton"> Post</button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>


    </fieldset>
</div>
