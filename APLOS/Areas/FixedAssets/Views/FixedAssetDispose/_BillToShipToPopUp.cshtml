<div class="modal fade site-modal in" id="invoicingPartyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Invoicing Party<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 col-md-4 control-label">Bill To</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select ng-model="voucher.InvoicingPartyPlantId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(voucher.InvoicingPartyPlantId,'billTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p ng-hide="voucher.InvoicingPartyPlantId==null">State :{{voucher.InvoicingState}}</p>
                            <p ng-hide="voucher.InvoicingPartyPlantId==null">GSTIN :{{voucher.InvoicingGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Invoicing by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="voucher.InvoicingByAddress" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">ShipTo</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="voucher.DeliveryPartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(salesVM.DeliveryPartyPlantId,'shipTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p ng-hide="voucher.InvoicingPartyPlantId==null">State :{{voucher.DeliveryState}}</p>
                            <p ng-hide="voucher.InvoicingPartyPlantId==null">GSTIN :{{voucher.DeliveryGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="voucher.DeliveryByAddress" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeInvoicingPartyPopUp();" class="btn"> Done</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>