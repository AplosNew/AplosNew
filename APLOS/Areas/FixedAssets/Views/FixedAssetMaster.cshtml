                    <ul class="list-inline text-left">
                        <li> <button data-toggle="modal" ng-click="FixedAssetMasterItemReport();" class="btn" tabindex="10"><i class="glyphicon glyphicon-cloud-download"></i>Download All</button></li>
                    </ul>
                </div>
            </div>
