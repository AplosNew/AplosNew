<confirm-archive-generic modalid="confirmFAMIPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteFAMI();"></confirm-archive-generic>


<!-- #region *************ReconAssetTypeGL****************** -->
<div class="modal fade site-modal in" id="ReconAssetTypeListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="ReconAssetTypeListForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Fixed Asset GL</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="reconAssetTypeListParameters.searchBy">
                                            <option ng-repeat="option in searchReconAssetTypeByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="reconAssetTypeListParameters.search" ng-enter="getData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetReconAssetTypeListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>COA</th>
                                <th>Account Group     </th>
                                <th>GL Code</th>
                                <th>GL </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in ReconAssetTypeGLList |itemsPerPage:reconAssetTypeListParameters.pageSize" pagination-id="metaData.name + 'ReconAssetTypeGLList'" total-items="reconAssetTypeListParameters.total_count"
                                ng-click="setAssetGLSelected(x)" ng-dblclick="closeReconAssetTypeListPopUpSelected()" ng-class="{selected : x.GLGeneralInfoCode === rowSelected}" ng-dblclick="closeCOAICodeListPopUp()">
                                <td>{{x.COAName}}</td>
                                <td>{{x.AccountGroupName}}</td>
                                <td>{{x.GLGeneralInfoCode}}</td>
                                <td>{{x.GLItem}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'ReconAssetTypeGLList'" direction-links="true" boundary-links="true" on-page-change="GetReconAssetTypeListData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closeReconAssetTypeListPopUpSelected()">Select</button>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
