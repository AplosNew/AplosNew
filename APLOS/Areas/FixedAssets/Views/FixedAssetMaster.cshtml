                            <div class="col-sm-8 show-message">
                                <input type="text" name="Sequence" tabindex="1" ej-numerictextbox e-decimalplaces="0" e-minvalue="1" e-enablertl="false" e-value="AIItemModelNew.Sequence" e-width="100%" required />
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
