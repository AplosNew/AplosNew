                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true" e-allowResizing="true">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Sequence" e-headertext="Sequence" e-width="100px"></div>
