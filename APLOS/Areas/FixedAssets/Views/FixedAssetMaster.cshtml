                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="ModelChildNew.Remarks" ng-trim="false" maxlength="250" tabindex="10"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveChild();" class="btn" tabindex="14"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActionItem}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmFAMIPopUp" class="btn" tabindex="15"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="ClearFAMI();" class="btn" tabindex="16"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
                <div class="row">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button style="margin-left: 5px;" ng-click="GetAdditionalInfoItemData();" ng-disabled="ModelChildNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus" style="top: 1px;"></i> Add  Additional Info Item</button></li>
                        </ul>
                    </div>
                    <div class="col-xs-12">
                        <div id="GriAdd" ej-grid e-datasource="AdditionalInfoItemList" e-templaterefresh="refreshTemplateemployee"
