<style>

    .switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 24px;
    }

        .switch input {
            display: none;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        -webkit-transition: .4s;
        transition: .4s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 5px;
            bottom: 4px;
            background-color: white;
            -webkit-transition: .4s;
            transition: .4s;
        }

    input:checked + .slider {
        background-color: darkseagreen;
    }

    input:focus + .slider {
        box-shadow: 0 0 1px #2196F3;
    }

    input:checked + .slider:before {
        -webkit-transform: translateX(16px);
        -ms-transform: translateX(16px);
        transform: translateX(16px);
    }

    .slider.round {
        border-radius: 14px;
    }

        .slider.round:before {
            border-radius: 50%;
        }
</style>

<togglable name="Capitalize Asset Register Posting(Addition)"></togglable>
<div class="form-elements form-horizontal" ng-form="formAddition">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Info</legend>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Master Id<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" ng-model="voucherAddition.CapitalizationMasterId" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="getMasterDataAddition();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Capitalization Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="CapitalizationDateAddition" ng-model="voucherAddition.CapitalizationDate" datepicker class="form-control" disabled required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <textarea rows="3" type="text" name="NarrationAddition" tabindex="8" class="form-control" ng-model="voucherAddition.Narration" required capitalize></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div id="div_PostingDateAddition" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input required datepicker="checkPostingDateAddition();checkDocDateAddition();" id="postingDateAddition" type="text" name="Posting Date Addition" ng-model="voucherAddition.PostingDate" class="form-control" tabindex="1">
                </div>
            </div>
            <div id="div_DocDateAddition" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input required datepicker="checkPostingDateAddition();checkDocDateAddition();" id="docDateAddition" type="text" name="Doc Date Addition" ng-model="voucherAddition.DocDate" class="form-control" tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Entry Date Addition" ng-model="voucherAddition.VoucherDate" datepicker class="form-control" disabled required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-maxlength="50" name="Doc Ref Addition" ng-model="voucherAddition.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type Addition" ng-model="voucherAddition.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucherAddition.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select ng-change="entityChange(voucherAddition.EntityId)" id="entityIdAddition" class="form-control" name="EntityAddition" ng-model="voucherAddition.EntityId" tabindex="7" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Asset Item</label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-maxlength="50" name="Asset Item Addition" ng-model="voucherAddition.FixedAssetItem" class="form-control" tabindex="7" readonly autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Asset Qty</label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-maxlength="50" name="Asset Qty Addition" ng-model="voucherAddition.Qty" class="form-control" tabindex="7" readonly autocomplete="off">
                </div>
            </div>
        </div>
    </fieldset>

    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-12 col-md-12" style="padding-left:0px">
        <div class="col-xs-12 col-sm-2 col-md-2">
            <button class="btn single-btn" ng-click="showAssetRegisterPopUp()" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Select Asset Register</button>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>CM Id</th>
                        <th>CC Id</th>
                        <th>Asset Amount</th>
                        <th>Distributed Amount</th>
                        <th>Asset Item</th>
                        <th>Asset Item Id</th>
                        <th>Asset Register Id</th>
                        <th>Asset Sl No</th>
                        <th>Status</th>
                        <th>Asset Condition</th>
                        <th>User Reference</th>
                        <th>Old Reference</th>
                        <th>User Group</th>
                        <th>Remarks</th>
                        <th class="col-sm-1">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in checkedAssetRegisterList">
                        <td>
                            <input type="text" title="Capitalization Master Id" class="form-control text-left" name="CapitalizationMasterId" autocomplete="off" ng-model="x.CapitalizationMasterId" readonly>
                        </td>
                        <td>
                            <input type="text" title="Capitalization Child Id" class="form-control text-left" name="CapitalizationChildId" autocomplete="off" ng-model="x.CapitalizationChildId" readonly>
                        </td>
                        <td>
                            <input type="text" n-decimals="2" title="Asset Amount" class="form-control text-right" name="AssetAmount" autocomplete="off" ng-model="x.AssetAmount" readonly>
                        </td>
                        <td>
                            <input ng-keyup="checkDistributedAmount($index,x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="x.Amount">
                        </td>
                        <td>{{x.FixedAssetItem}}</td>
                        <td>{{x.FixedAssetItemId}}</td>
                        <td>{{x.AssetRegisterId}}</td>
                        <td>{{x.AssetSlNo}}</td>
                        <td>{{x.Status}}</td>
                        <td>{{x.AssetCondition}}</td>
                        <td>{{x.UserReference}}</td>
                        <td>{{x.OldReference}}</td>
                        <td>{{x.UserGroup}}</td>
                        <td>{{x.Remarks}}</td>
                        <td class="text-right">
                            <ul class="list-inline action-list">
                                <li><button ng-click="DeleteConfirmation(x.AssetRegisterId)" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                            </ul>
                        </td>

                    </tr>
                    <tr>
                        <td colspan="3" class="text-right"><strong>Total : </strong></td>
                        <td class="text-right"><strong>{{checkedAssetRegisterList | sumByKey : 'Amount'|  number:2 }}</strong></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="clearfix"></div>
    <div class="tab-design" style="margin-top:5px;">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Material Info</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Transaction" role="tab" data-toggle="tab">Journal</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form="tabForm1Addition">
                <div class="table-responsive modal-table" ng-show="selectedmaterialMasterListAddition.length">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Voucher No</th>
                                <th>Material</th>
                                <th>Article</th>
                                <th>GRN No</th>
                                <th>Qty</th>
                                <th>Amount</th>
                                <th>Source</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in selectedmaterialMasterListAddition">

                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.MaterialMasterName}}</td>
                                <td>{{x.ArticleStandardName}}</td>
                                <td>{{x.GRNNo}}</td>
                                <td class="text-right">{{x.Qty}}</td>
                                <td class="text-right">{{x.Amount}}</td>
                                <td>{{x.Source}}</td>
                            </tr>
                            <tr>
                                <td><label>Total </label></td>
                                <td colspan="4"></td>
                                <td class="text-right">
                                    <label>
                                        {{selectedmaterialMasterListAddition | sumByKey : 'Amount'|number:2}}
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form="tabForm2Addition" ng-keypress="materialConfigMassege()">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>Dr</th>
                                <th>Cr</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in capitalizationJVListAddition| orderBy:'Dr'">
                                <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td class="text-right">{{x.Dr | number| setDecimal:4}}</td>
                                <td class="text-right">{{x.Cr | number| setDecimal:4}}</td>
                            </tr>
                            <tr>
                                <td colspan="3"></td>
                                <td class="text-right"><strong>{{capitalizationJVListAddition | sumByKey : 'Dr' | number| setDecimal:4}}</strong></td>
                                <td class="text-right"><strong>{{capitalizationJVListAddition | sumByKey : 'Cr' | number| setDecimal:4}}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
    <div class="clearfix"></div>

    <div class="common-btn">
        <ul class="common-btn list-inline text-right">
            <li> <button ng-click="PostAddition();" ng-disabled="saveBtnDisable==true" class="btn"> Post</button></li>
            <li> <button ng-click="ClearAddition();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

