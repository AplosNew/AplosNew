<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Party Account Group GL
</h3>
<div class="form-elements form-horizontal" ng-form name="partyAccountGroupForm">
    <div class="row">
        <div class="col-xs-6 col-sm-6 col-md-6 form-element">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">COA<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="partyAccountGroupGL.COAId" name="COAId" ng-change="GetPartyAccountGroupData();" tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in COAList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-element">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Party Account Group<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" id="PartyAccountGroupId" ng-model="partyAccountGroupGL.PartyAccountGroupId" ng-change="changePartyAccountGroupCbo(partyAccountGroupGL.PartyAccountGroupId);" name="PartyAccountGroupId" tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in partyAccountGroupList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">GL<sup>*</sup></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 15px;">
                    <input type="text" name="GLGeneralInfoName" ng-model="partyAccountGroupGL.GLGeneralInfoName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button name="submit" class="btn single-small-btn" ng-disabled="partyAccountGroupGL.PartyGLType==null || partyAccountGroupGL.PartyAccountGroupId==null|| partyAccountGroupGL.COAId==null" ng-click="GetCOAICodeList()" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-element">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">GL Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="partyAccountGroupGL.PartyGLType" name="GLType" tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in glTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-disabled="partyAccountGroupGL.PartyGLType==null && partyAccountGroupGL.PartyAccountGroupId==null" class="btn" ng-click="addRow()"><i class="glyphicon glyphicon-plus"></i> Add Row</button></li>
                    <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                </ul>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Party Type</th>
                            <th>Party Account Group</th>
                            <th>GL Type</th>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in partyAccountGroupGLList | filter: {'AccountType':'Customer'}">
                            <td ng-hide="$index>0" rowspan="{{(partyAccountGroupGLList | filter: {'AccountType':'Customer'}).length}}">Customer</td>
                            <td>{{x.PartyAccountGroupName}}</td>
                            <td>{{x.PartyGLType}}</td>
                            <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                            <td>{{x.BudgetCode}} - {{x.BudgetName}}</td>
                            <td>{{x.ActivityCode}} - {{x.ActivityName}}</td>
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button data-toggle="modal" data-target="#confirmDelete" ng-click="confirmDelete(x)"
                                                class="btn btn-action tooltip-here" data-placement="top" title="Delete" tooltip>
                                            <i class="glyphicon glyphicon-remove"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                        <tr ng-repeat="x in partyAccountGroupGLList | filter: {'AccountType':'Vendor'}">
                            <td ng-hide="$index>0" rowspan="{{(partyAccountGroupGLList | filter: {'AccountType':'Vendor'}).length}}">Vendor</td>
                            <td>{{x.PartyAccountGroupName}}</td>
                            <td>{{x.PartyGLType}}</td>
                            <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                            <td>{{x.BudgetCode}} - {{x.BudgetName}}</td>
                            <td>{{x.ActivityCode}} - {{x.ActivityName}}</td>
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button data-toggle="modal" data-target="#confirmDelete" ng-click="confirmDelete(x)" class="btn btn-action tooltip-here" data-placement="top" title="Delete" tooltip>
                                            <i class="glyphicon glyphicon-remove"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLPopUp.cshtml")
<confirm-archive-generic data-modalid="confirmDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete()"></confirm-archive-generic>