<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Inter Transaction Ledger</h3>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-6 col-md-6">  
        
        <div id="div_Company" class="form-group">
            <label class="col-sm-4 control-label">Company</label>
            <div class="col-sm-8 ">
                <div class="select-style">
                    <select name="Company Name" id="CompanyId" ng-model="report.CompanyId" class="col-sm-3 form-control"
                            ng-change="getCompanyInfo(advance.CompanyId); companyChange(advance.CompanyId)" ng-options="item.CompanyId as item.CompanyName for item in companyList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
         </div>

        <div id="div_Plant" class="form-group">
            <label class="col-sm-4 control-label">Plant</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select ng-change="getPlantInfo(advance.PlantId);" name="Plant Name" id="PlantId" ng-model="report.PlantId" class="col-sm-3 form-control" ng-options="item.PlantId as item.PlantName for item in interplantList" tabindex="10">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" id="div_FromDate">
            <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="From Date" ng-model="report.FromDate" datepicker class="form-control" required>
            </div>
        </div>
        <div class="form-group" id="div_ToDate">
            <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="To Date" ng-model="report.ToDate" datepicker class="form-control" required>
            </div>
        </div>
        
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Format<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                </label>
                <label>
                    <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                </label>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
        </ul>
    </div>
</div>
