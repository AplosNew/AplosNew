<togglable name="Party Group"></togglable>
<div ng-form id="partyGroup" name="partyGroupForm" class="form-elements form-horizontal">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="home" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Address</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="contact" role="tab" data-toggle="tab">Contact</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="settings" role="tab" data-toggle="tab">Code No</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="brand" role="tab" data-toggle="tab">Party Brand</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="partyGroupForm1">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Sequence" ng-model="partyGroup.Sequence" class="form-control" required placeholder="0" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="ShortName" maxlength="14" ng-model="partyGroup.ShortName" class="form-control" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="UserName" maxlength="40" ng-model="partyGroup.UserName" class="form-control" required tabindex="5">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">PartyGroup Subcategory</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="PartyGroupSubCategoryId" class="form-control" name="PartyGroup Subcategory" ng-model="partyGroup.PartyGroupSubCategoryId">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in partyGroupSubCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" name="Description" maxlength="250" rows="2" ng-model="partyGroup.Description" tabindex="7"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Code" maxlength="10" ng-model="partyGroup.Code" class="form-control" required tabindex="2">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="StandardName" maxlength="40" ng-model="partyGroup.StandardName" class="form-control" required tabindex="4">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">PartyGroup Category</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="PartyGroupCategoryId" class="form-control" name="PartyGroup Category" ng-model="partyGroup.PartyGroupCategoryId">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in partyGroupCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">PartyGroup Class</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="PartyGroupClassId" class="form-control" name="PartyGroup Category" ng-model="partyGroup.PartyGroupClassId">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in partyGroupClassList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" name="Remarks" maxlength="250" rows="2" ng-model="partyGroup.Remarks" tabindex="6"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="partyGroup.Active" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="partyGroupForm2">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Continent</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Continent" ng-model="addressMaster.ContinentId" ng-change="onContinentChange(addressMaster.ContinentId)" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in ContinentList" tabindex="1"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">State/Division</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="State/Division" ng-model="addressMaster.StateId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in StateList" tabindex="3" ng-change="onStateChange(addressMaster.StateId)"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">City</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="City" ng-model="addressMaster.CityId" ng-change="onCityChange(addressMaster.CityId)" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in CityList" tabindex="4">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Area</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Area" ng-model="addressMaster.AreaId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in AreaList" tabindex="5"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Thana</label>
                            <div class="col-sm-8">
                                <input name="Thana" maxlength="50" type="text" ng-model="addressMaster.Thana" class="form-control" tabindex="7">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Ward</label>
                            <div class="col-sm-8">
                                <input type="text" name="Ward" maxlength="50" ng-model="addressMaster.Ward" class="form-control" tabindex="9">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Address Line1</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="addressMaster.Address1" name="Address Line1" maxlength="300" tabindex="11"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Country</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Country" ng-model="addressMaster.CountryId" ng-change="onCountryChange(addressMaster.CountryId);" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in CountryList" tabindex="2"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">District</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="City" ng-model="addressMaster.DistrictId" ng-change="onDistictChange(addressMaster.DistrictId)" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in districtList" tabindex="4"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Circle</label>
                            <div class="col-sm-8">
                                <input type="text" name="Circle" maxlength="50" ng-model="addressMaster.Circle" class="form-control" tabindex="6">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Village</label>
                            <div class="col-sm-8">
                                <input type="text" name="Village" maxlength="100" ng-model="addressMaster.Village" class="form-control" tabindex="8">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Postcode</label>
                            <div class="col-sm-8">
                                <input type="text" name="Postcode" maxlength="50" ng-model="addressMaster.Postcode" class="form-control" tabindex="10">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Address Line2</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="addressMaster.Address2" name="Address Line2" maxlength="300" tabindex="12"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" title="Contact Person Name">Person Name</label>
                            <div class="col-sm-8">
                                <input type="text" name="ContactPerson" maxlength="100" ng-model="contactMaster.ContactPerson" class="form-control" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Phone1</label>
                            <div class="col-sm-8">
                                <input type="text" name="Phone1" maxlength="20" ng-model="contactMaster.Phone1" class="form-control" tabindex="3">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Mobile</label>
                            <div class="col-sm-8">
                                <input type="text" name="Mobile" maxlength="20" ng-model="contactMaster.Phone3" class="form-control" tabindex="5">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email1</label>
                            <div class="col-sm-8">
                                <input type="text" name="Email1" maxlength="50" ng-model="contactMaster.Email1" class="form-control" placeholder="example@gmail.co" tabindex="7">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email3</label>
                            <div class="col-sm-8">
                                <input type="text" name="Email3" maxlength="50" ng-model="contactMaster.Email3" class="form-control" placeholder="example@gmail.co" tabindex="9">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" title="Contact Person Designation">Designation</label>
                            <div class="col-sm-8">
                                <input type="text" name="ContactPersonDesignation" maxlength="30" ng-model="contactMaster.ContactPersonDesignation" class="form-control" tabindex="2">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Phone2</label>
                            <div class="col-sm-8">
                                <input type="text" name="Phone2" maxlength="20" ng-model="contactMaster.Phone2" class="form-control" tabindex="4">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Fax</label>
                            <div class="col-sm-8">
                                <input type="text" name="Fax" maxlength="50" ng-model="contactMaster.Fax" class="form-control" tabindex="6">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email2</label>
                            <div class="col-sm-8">
                                <input type="text" name="Email2" maxlength="50" ng-model="contactMaster.Email2" class="form-control" placeholder="example@gmail.co" tabindex="8">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Website</label>
                            <div class="col-sm-8">
                                <input type="text" maxlength="50" ng-model="contactMaster.Website" class="form-control" tabindex="10">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button class="btn" ng-click="addRow()"><i class="glyphicon glyphicon-plus"></i>{{ContactAction}}</button></li>
                        <li> <button ng-click="ClearContact();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear Contact Form</button></li>
                    </ul>
                </div>
                <div class="table-responsive modal-table" ng-show="showContactMaster">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Person Name</th>
                                <th>Designation</th>
                                <th>Phone</th>
                                <th>Mobile</th>
                                <th>Email</th>
                                <th>Edit</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="c in contactMasters" ng-show="isArchive(c.Archive)">
                                <td>{{c.ContactPerson}}</td>
                                <td>{{c.ContactPersonDesignation}}</td>
                                <td>{{c.Phone1}}</td>
                                <td>{{c.Phone3}}</td>
                                <td>{{c.Email1}}</td>
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="GetContact(c.Id, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                <i class="glyphicon glyphicon-pencil"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="valuePassInDelModal(c.Id, c.ContactPerson)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row" ng-form name="partyGroupForm3">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Pin Code</label>
                            <div class="col-sm-8">
                                <input type="text" name="PINCode" maxlength="50" ng-model="partyGroup.PINCode" class="form-control" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Commission Rate<sup>*</sup></label>
                            <div class="col-sm-8  show-message">
                                <input type="number" name="CommissionRate" ng-model="partyGroup.CommissionRate" class="form-control" tabindex="3" required>
                                <span class="msg-error" ng-show="partyGroupForm.CommissionRate.$error.number">
                                    Not valid number!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Transaction Type</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="TransactionType" ng-model="partyGroup.TransactionType" class="form-control" tabindex="5">
                                        <option value="">--Select--</option>
                                        <option value="Bank">Bank</option>
                                        <option value="Check">Chaque</option>
                                        <option value="Cash">Cash</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Debit Limit</label>
                            <div class="col-sm-8">
                                <input type="number" name="DebitLimit" ng-model="partyGroup.DebitLimit" class="form-control" tabindex="13">
                                <span class="msg-error" ng-show="partyGroupForm.DebitLimit.$error.number">
                                    Not valid number!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Central Sale Tax NO</label>
                            <div class="col-sm-8">
                                <input type="text" name="CentralSaleTaxNO" maxlength="30" ng-model="partyGroup.CSTNO" class="form-control" tabindex="15">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">IEC No</label>
                            <div class="col-sm-8">
                                <input type="text" name="IECNo" maxlength="50" ng-model="partyGroup.IECNo" class="form-control" tabindex="17">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Excise Range</label>
                            <div class="col-sm-8">
                                <input type="text" name="ExciseRange" maxlength="100" ng-model="partyGroup.ExciseRange" class="form-control" tabindex="2">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Group Type</label>
                            <div class="col-sm-8">
                                <input type="text" name="GroupType" maxlength="8" ng-model="partyGroup.GroupType" class="form-control" tabindex="4">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">TIN NO</label>
                            <div class="col-sm-8">
                                <input type="text" name="TINNO" maxlength="50" ng-model="partyGroup.TINNO" class="form-control" tabindex="6">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Credit Limit</label>
                            <div class="col-sm-8">
                                <input type="number" name="CreditLimit" ng-model="partyGroup.CreditLimit" class="form-control" tabindex="14">
                                <span class="msg-error" ng-show="partyGroupForm.CreditLimit.$error.number">
                                    Not valid number!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Local Sale Tax No</label>
                            <div class="col-sm-8">
                                <input type="text" name="LocalSaleTaxNo" maxlength="40" ng-model="partyGroup.LSTNO" class="form-control" tabindex="16">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Ref. No</label>
                            <div class="col-sm-8">
                                <input type="text" name="RefNo" maxlength="50" ng-model="partyGroup.RefNo " class="form-control" tabindex="18">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Brand Code</th>
                                <th>Brand Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in partyBrands">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Active" checked="{{x.Active}}">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.BrandCode}}</td>
                                <td>{{x.BrandName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button tabindex="19" ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="20"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button tabindex="21" ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i>Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in partyGroups |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active? 'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
