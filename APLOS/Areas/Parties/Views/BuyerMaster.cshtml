<togglable name="Buyer Definition"></togglable>
<div class="form-horizontal" ng-form name="buyerMasterNewForm">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors style="margin-left:-30px">
            <label class="col-sm-4 control-label">Buyer<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="buyerMasterNew.BuyerId" required name="Buyer"
                            ng-options="item.Value as item.Text for item in buyerList" ng-change="getData();getBuyerActivity();GetBuyerDivisionCbo();GetBuyerDepartmentCbo()">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <input type="hidden" ng-model="buyerMasterNew.Id">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Department<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" name="Department" id="Department" ng-model="buyerMasterNew.BuyerDepartmentId" required>
                                <option value="ALL">ALL</option>
                                <option ng-repeat="option in departmentList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Defined Name" ng-model="buyerMasterNew.UserName" class="form-control" required tabindex="3" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Second Account Holder</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input type="text" name="SecondAccountHolder" ng-model="buyerMasterNew.SecondAccountHolder" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button name="submit" ng-click="getEmpData('Second')" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="form-group">
                    <label class="col-sm-4 control-label">Repeat Order Lead Time</label>
                    <div class="col-sm-8">
                        <input type="text" name="Repeat Order Lead Time" ng-model="buyerMasterNew.RepeatOrderLeadTime" class="form-control" tabindex="5" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Repeat Production Lead Time</label>
                    <div class="col-sm-8">
                        <input type="text" name="Repeat Production Lead Time" ng-model="buyerMasterNew.RepeatProductionLeadTime" class="form-control" tabindex="7" maxlength="50">
                    </div>
                </div>
                <hr />
                <div class="form-group">
                    <label class="col-sm-4 control-label">Task Template Master</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="buyerMasterNew.TaskTemplateMasterId" name="TaskTemplateMaster" tabindex="2" ng-change="getTaskTemplateData();"
                                    ng-options="item.Value as item.Text for item in taskTemplateMasterCboList">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Division<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" name="Division" id="Division" ng-model="buyerMasterNew.BuyerDivisionId" required>
                                <option value="ALL">ALL</option>
                                <option ng-repeat="option in divisionList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">First Account Holder</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input type="text" name="FirstAccountHolder" ng-model="buyerMasterNew.FirstAccountHolder" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button name="submit" ng-click="getEmpData('First')" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>

                <br />
                <hr style="margin-top: 32px;margin-left: -30px;" />
                <div class="form-group">
                    <label class="col-sm-4 control-label">Normal Order Lead Time</label>
                    <div class="col-sm-8">
                        <input type="text" name="Normal Order Lead Time" ng-model="buyerMasterNew.NormalOrderLeadTime" class="form-control" tabindex="6" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Normal Production Lead Time</label>
                    <div class="col-sm-8">
                        <input type="text" name="Normal Production Lead Time" ng-model="buyerMasterNew.NormalProductionLeadTime" class="form-control" tabindex="8" maxlength="50">
                    </div>
                </div>
                <hr style="margin-top: 20px;margin-left: -30px;" />
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="MOentityPopUp();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> Select Entity</button></li>
                            <li> <button ng-click="GetBuyerMasterEntityPOPUp();" class="btn" tabindex="11"><i class="glyphicon glyphicon-list"></i> Selected Entity</button></li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Entity Assignment</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="address" role="tab" data-toggle="tab">Task</a></li>
                    <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);" href="" aria-controls="address" role="tab" data-toggle="tab">Costing Authorization</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="form-group">
                        <div class="col-sm-3">
                            <button name="submit" class="btn single-small-btn" ng-click="entityPopUp(entityAllowanceNew.CompanyId)" tabindex="3">Entity</button>
                        </div>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Entity</th>
                                    <th>Plant</th>
                                    <th>Division</th>
                                    <th>Unit</th>
                                    <th>Activity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in buyerMasterEntityList | filter:EntityId:true">
                                    <td class="text-right table-td">
                                        <ul class="list-inline action-list">
                                            <li>
                                                <button ng-click="removeRowModal(x,$index)" class="btn btn-action tooltip-here" title="Delete">
                                                    <i class="glyphicon glyphicon-trash"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </td>
                                    <td>{{x.UserName}}</td>
                                    <td>{{x.Plant}}</td>
                                    <td>{{x.Division}}</td>
                                    <td>{{x.Unit}}</td>
                                    <td class="text-right table-td">
                                        <ul class="list-inline action-list">
                                            <li>
                                                <button ng-click="showBuyerActivityPopUp(x.Id,$index)" class="btn btn-action tooltip-here" title="Activity" ng-disabled="x.Id==null">
                                                    <i class="glyphicon glyphicon-list"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
