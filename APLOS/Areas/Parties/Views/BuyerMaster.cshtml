                        </div>
                        <div class="col-sm-6  text-left">
                            <button tabindex="13" ng-click="showEmployeeInformationByRowModal('EmpSystemId','CostingApprovedBy',0);" type="submit" class="btn single-small-btn pull-left"><i class="glyphicon glyphicon-search"></i></button>
