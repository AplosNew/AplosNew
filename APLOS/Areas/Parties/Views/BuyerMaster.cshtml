</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Buyer</th>
                <th>Department</th>
                <th>Division</th>
                <th>User Define Name</th>
                <th>First Account Holder</th>
                <th>Second Account Holder</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in buyerMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.BuyerName}}</td>
                <td>{{x.DepartmentName}}</td>
                <td>{{x.DivisionName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.FirstAccountHolder}}</td>
                <td>{{x.SecondAccountHolder}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<modal-table modalid="search_popup"
             data-title="Search (Finished Goods) Data"
             data-search-parameters="popUpParameters"
             data-exclued-column-list=""
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click=""
             data-double-click="getFinishedGoods(data)"
             data-right-button="false"
             data-left-button="false"
             data-ng-click-left-button=""
             data-ng-click-cancel="">
</modal-table>

<div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Entity Informations</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="entityParameters.searchBy">
                                            <option ng-repeat="option in entitySearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="entityParameters.search" ng-enter="getEntityData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEntityData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" ng-show="entityDataList.length">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th ng-repeat="x in entitySearchList">{{x.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in entityDataList|itemsPerPage:entityParameters.pageSize" total-items="entityParameters.total_count" pagination-id="metaData.name + 'entityDataList'">
                                <td>
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" id="{{x.Id}}" ng-model="x.Flag" ng-checked="x.Flag">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td ng-repeat="y in entitySearchList">{{x[y.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'entityDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEntityData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="selectEntityPopUp();" class="btn">Select</button></li>
                    <li><button type="button" class="btn btn-default" ng-click="closeEntityPopUp();">Close</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

