                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Standard Name</th>
                                    <th>User Define Task</th>
                                    <th>Task Type</th>
                                    <th>Duration</th>
                                    <th>Employee</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in taskTemplateList">
