                        </div>
                        <div class="col-sm-4">
                            <input type="text" name="Responsible Person" ng-model="buyerMasterNew.CostingCreatedByName" class="form-control" readonly>
                        </div>
                        <div class="col-sm-6 text-left">
                            <button tabindex="13" ng-click="showEmployeeInformationByRowModal('EmpSystemId','CostingCreatedBy',0);" type="submit" class="btn single-small-btn pull-left"><i class="glyphicon glyphicon-search"></i></button>
                        </div>
                    </div>
