<togglable name="Party Mapping"></togglable>
<div class="form-element-ctrl form-horizontal" ng-form="partyMappingNewForm">
	<div class="col-xs-12 col-sm-6 col-md-6">
		<div class="form-group" show-errors>
			<label class="col-sm-3 control-label">Party Type<sup>*</sup></label>
			<div class="col-sm-9 show-message">
				<div class="select-style">
					<select class="form-control" name="Party Type" ng-model="partyMapping.PartyType" ng-options="item.Value as item.Text for item in partyTypeList" ng-change="getDataList();" required>
						<option value=""></option>
					</select>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="clearfix"></div>
<div class="form-elements form-horizontal" ng-form="partyMappingNewForm">
	<div class="col-xs-12 col-sm-6 col-md-6">
		<div class="form-group" show-errors>
			<label class="col-sm-3 control-label">Old PartyId<sup>*</sup></label>
			<div class="col-sm-9 show-message">
				<input ng-readonly="partyMapping.Id!=null" required maxlength="60" type="text" name="OldGLId" ng-model="partyMapping.OldPartyId" class="form-control">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Old Party</label>
			<div class="col-sm-9">
				<input type="text" readonly name="OldPartyName" ng-model="partyMapping.OldPartyName" class="form-control">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Old Party Country</label>
			<div class="col-sm-9">
				<input type="text" readonly name="OldPartyName" ng-model="partyMapping.OldPartyCountry" class="form-control">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Old Party State</label>
			<div class="col-sm-9">
				<input type="text" readonly name="OldPartyName" ng-model="partyMapping.OldPartyState" class="form-control">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Old Party City</label>
			<div class="col-sm-9">
				<input type="text" readonly name="OldPartyName" ng-model="partyMapping.OldPartyCity" class="form-control">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Old Party GSTIN</label>
			<div class="col-sm-9">
				<input type="text" readonly name="OldPartyName" ng-model="partyMapping.OldPartyGSTIN" class="form-control">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Old Party Address</label>
			<div class="col-sm-9">
				<textarea maxlength="300" readonly class="form-control" rows="3" ng-model="partyMapping.OldPartyAddress"></textarea>
			</div>
		</div>
	</div>
	<div class="col-xs-12 col-sm-6 col-md-6">
		<div class="form-group">
			<label class="col-sm-3 control-label">Party</label>
			<div class="col-sm-9">
				<div class="input-group">
					<input required type="text" name="Party" ng-model="partyMapping.PartyName" class="form-control" readonly>
					<span class="input-group-btn">
						<button ng-click="showPartyPopUp();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
						<button ng-click="Clear()" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
					</span>
				</div>
			</div>
		</div>
		<div class="form-group" show-errors>
			<label class="col-sm-3 control-label">Party Location<sup>*</sup>({{partyPlantList.length}})</label>
			<div class="col-sm-9 show-message">
				<div class="select-style">
					<select ng-change="getPartyLocationDetail(partyMapping.PartyPlantId)" class="form-control" name="Bill To" ng-model="partyMapping.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" required>
						<option value=""></option>
					</select>
				</div>
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Party Country</label>
			<div class="col-sm-9">
				<input type="text" readonly name="OldPartyName" ng-model="partyMapping.PartyCountry" class="form-control">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Party State</label>
			<div class="col-sm-9">
				<input type="text" readonly name="OldPartyName" ng-model="partyMapping.PartyState" class="form-control">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Party City</label>
			<div class="col-sm-9">
				<input type="text" readonly name="OldPartyName" ng-model="partyMapping.PartyCity" class="form-control">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Party GSTIN</label>
			<div class="col-sm-9">
				<input type="text" readonly name="OldPartyName" ng-model="partyMapping.PartyGSTIN" class="form-control">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-3 control-label">Party Address</label>
			<div class="col-sm-9">
				<textarea maxlength="300" readonly class="form-control" rows="3" ng-model="partyMapping.PartyAddress"></textarea>
			</div>
		</div>
	</div>
	<div class="common-btn">
		<ul class="list-inline text-right">
			<li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
			<li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
		</ul>
	</div>
</div>
<div class="row text-right aplos-grid-toggle">
	<div class="col-xs-12 col-sm-12 col-sm-12">
		<div class="search-form">
			<div class="row">
				<div class="col-xs-12 col-sm-3 col-md-3">
					<div class="select-style">
						<select ng-model="$root.parameters.searchBy">
							<option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
						</select>
					</div>
				</div>
				<div class="col-xs-12 col-sm-7 col-md-7">
					<input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
				</div>
				<div class="col-xs-12 col-sm-2 col-md-2">
					<button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Old PartyId</th>
				<th>Old Party</th>
				<th>Old Party Country</th>
				<th>Old Party State</th>
				<th>Old Party City</th>
				<th>Old Party GSTIN</th>
				<th>Party</th>
				<th>Location</th>
				<th>GSTIN</th>
				<th>Remove</th>
			</tr>
		</thead>
		<tbody>
			<tr dir-paginate="x in partyMappingList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
				<td>{{x.OldPartyId}}</td>
				<td>{{x.OldPartyName}}</td>
				<td>{{x.OldPartyCountry}}</td>
				<td>{{x.OldPartyState}}</td>
				<td>{{x.OldPartyCity}}</td>
				<td>{{x.OldPartyGSTIN}}</td>
				<td>{{x.PartyCode}} - {{x.PartyName}}</td>
				<td>{{x.PartyLocation}}</td>
				<td>{{x.GSTIN}}</td>
				<td class="text-right">
					<button ng-click="valuePassInDelModal($index,x)" class="btn-action tooltip-here" data-placement="top" title="Delete">
						<i class="glyphicon glyphicon-remove"></i>
					</button>
				</td>
			</tr>
		</tbody>
	</table>
	<dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic data-modalid="confirmDocumentdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
