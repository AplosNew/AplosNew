<div class="modal fade site-modal in" id="GLListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">GL List</h4>
            </div>
            <div class="modal-body">
                <div class="col-xs-12 col-sm-6 col-sm-6 form-elements">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">GL Type</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" id="PartyGLType" ng-model="party.PartyGLType" name="GLType" tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in glTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-sm-6 form-elements">
                    <div class="common-btn">
                        <button class="btn" ng-click="GlList()" ng-disabled="party.PartyGLType==null"><i class="glyphicon glyphicon-plus"></i> ADD GL</button>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL Type</th>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in companyPartyGLList | filter:{'CompanyPartyId':currentClickedCompanyPartyId}|orderBy:'PartyGLType'">
                                <td>{{x.PartyGLType}}</td>
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button data-toggle="modal" data-target="#confirmDelete" ng-click="confirmDelete(x)" class="btn btn-action tooltip-here" data-placement="top" title="Delete" tooltip>
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn" style="float:right">
                    <button class="btn" ng-click="Done()"> Done</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="GLPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">GL List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="glparameters.searchBy">
                                            <option ng-repeat="option in searchModalList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="glparameters.search" ng-enter="getGLModalData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getGLModalData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Account Group</th>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="gl in GList|itemsPerPage:glparameters.pageSize" pagination-id="metaData.name + 'GList'" total-items="glparameters.total_count" ng-dblclick="selectGL(gl);"
                                ng-class="{selected : gl.GLGeneralInfoCode === SelectedAccountCode && gl.BudgetMasterId===SelectedBudget && gl.ActivityId===SelectedActivity}">
                                <td>{{gl.AccountGroupName}}</td>
                                <td>{{gl.GLGeneralInfoCode}} - {{gl.GLGeneralInfoName}}</td>
                                <td>{{gl.BudgetName}}</td>
                                <td>{{gl.ActivityName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'GList'" direction-links="true" boundary-links="true" on-page-change="getGLModalData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer">
                <div class="common-btn" style="float:right">
                    <button class="btn" ng-click="Close()"> Close</button>
                </div>
            </div>
        </div>
    </div>
</div>