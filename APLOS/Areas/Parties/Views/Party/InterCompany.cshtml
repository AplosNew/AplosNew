<togglable name="Inter Company Party"></togglable>
<div ng-form name="partyForm">
    <div class="form-elements form-horizontal">
        <input type="hidden" ng-model="party.Id">
        <input type="hidden" ng-model="addressMaster.Id">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="basic" role="tab" data-toggle="tab">General</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Address</a></li>
                    <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="contact" role="tab" data-toggle="tab">Contact</a></li>
                    <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="vendor" role="tab" data-toggle="tab">Vendor</a></li>
                    <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="customer" role="tab" data-toggle="tab">Customer</a></li>
                    <li ng-hide="true" role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" aria-controls="vendorpf" role="tab" data-toggle="tab">Vendor PartnerFunction</a></li>
                    <li ng-hide="true" role="presentation" ng-class="{ active: isSet(7) }"><a ng-click="setTab(7)" href="" aria-controls="customerpf" role="tab" data-toggle="tab">Customer PartnerFunction</a></li>
                    <li role="presentation" ng-class="{ active: isSet(8) }"><a ng-click="setTab(8)" href="" aria-controls="plants" role="tab" data-toggle="tab">Plant</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form name="partyForm2">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Company Group</label>
                                <div class="col-sm-8">
                                    @ViewBag.CompanyGroup
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select id="CompanyId" class="form-control" name="Company" ng-model="party.CompanyId" tabindex="1" ng-change="GetAddressContact(party.CompanyId);getVendorCompanyData(party.Id,party.CompanyId);" ng-disabled="party.Id!=null" required>
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in companyList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row" ng-form name="partyForm2">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" name="Sequence" ng-model="party.Sequence" class="form-control" required placeholder="0" tabindex="1">
                                    <span class="msg-error" ng-show="partyForm2.Sequence.$error.number">
                                        Not valid number!
                                    </span>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Short Name" maxlength="15" ng-model="party.ShortName" class="form-control" required disabled tabindex="3">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Pin Code</label>
                                <div class="col-sm-8">
                                    <input type="text" name="PINCode" maxlength="50" ng-model="party.PINCode" class="form-control" tabindex="5">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">BIN No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="BIN NO" maxlength="50" ng-model="party.BINNO" class="form-control" tabindex="7">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Commission Rate<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" name="Commission Rate" ng-model="party.CommissionRate" class="form-control" tabindex="9" required>
                                    <span class="msg-error" ng-show="partyForm2.CommissionRate.$error.number">
                                        Not valid number!
                                    </span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Transaction Type</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="TransactionType" ng-model="party.TransactionType" class="form-control" tabindex="11">
                                            <option value="">--Select--</option>
                                            <option value="Bank">Bank</option>
                                            <option value="Check">Chaque</option>
                                            <option value="Cash">Cash</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">VAT Registration No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="VATResistrationNo" maxlength="20" ng-model="party.VATResistrationNo" class="form-control" disabled tabindex="13">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Debit Limit</label>
                                <div class="col-sm-8">
                                    <input type="number" name="DebitLimit" ng-model="party.DebitLimit" class="form-control" tabindex="19">
                                    <span class="msg-error" ng-show="partyForm2.DebitLimit.$error.number">
                                        Not valid number!
                                    </span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Central Sale Tax No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="CentralSaleTaxNO" maxlength="30" ng-model="party.CSTNO" class="form-control" tabindex="21">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Certification Of Incorporation No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="CertificationOfIncorporationNo" maxlength="20" ng-model="party.CertificationOfIncorporationNo" class="form-control" tabindex="23">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" name="Remarks" maxlength="250" rows="3" ng-model="party.Remarks" tabindex="25"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Code</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Code" ng-model="party.Code" class="form-control" placeholder="Internal" readonly>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Standard Name" maxlength="50" ng-model="party.StandardName" class="form-control" required disabled tabindex="3">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Excise Range</label>
                                <div class="col-sm-8">
                                    <input type="text" name="ExciseRange" maxlength="100" ng-model="party.ExciseRange" class="form-control" tabindex="7">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">GSTIN</label>
                                <div class="col-sm-8">
                                    <input type="text" name="TINNO" maxlength="50" ng-model="party.TINNO" class="form-control" disabled tabindex="9">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Trade License No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="TradeLicenseNo" maxlength="20" ng-model="party.TradeLicenseNo" class="form-control" tabindex="11">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">IEC No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="IECNo" maxlength="50" ng-model="party.IECNo" class="form-control" tabindex="13">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Credit Limit</label>
                                <div class="col-sm-8">
                                    <input type="number" name="CreditLimit" ng-model="party.CreditLimit" class="form-control" tabindex="19">
                                    <span class="msg-error" ng-show="partyForm2.CreditLimit.$error.number">
                                        Not valid number!
                                    </span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Local Sale Tax No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="LocalSaleTaxNo" maxlength="40" ng-model="party.LSTNO" class="form-control" tabindex="21">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Ref No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="RefNo" maxlength="50" ng-model="party.RefNo " class="form-control" tabindex="23">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" name="Description" maxlength="250" rows="3" ng-model="party.Description" tabindex="25"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Active</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="party.Active" tabindex="27">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row" ng-form name="partyForm3">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Continent<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Continent" ng-model="addressMaster.ContinentId" ng-change="onContinentChange(addressMaster.ContinentId)" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in ContinentList" tabindex="1" required disabled></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">State<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="State" ng-model="addressMaster.StateId" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in StateList" tabindex="3" required disabled></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Area</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Area" ng-model="addressMaster.AreaId" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in AreaList" tabindex="5" disabled></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Thana</label>
                                <div class="col-sm-8">
                                    <input name="Thana" maxlength="50" type="text" ng-model="addressMaster.Thana" class="form-control" tabindex="7" disabled>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Ward</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Ward" maxlength="50" ng-model="addressMaster.Ward" class="form-control" tabindex="9" disabled>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Phone</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Phone" maxlength="20" ng-model="addressMaster.Phone" class="form-control" tabindex="11" disabled>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Website</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Website" maxlength="50" ng-model="addressMaster.Website" class="form-control" tabindex="13" disabled>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Address Line1<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <textarea class="form-control" rows="3" ng-model="addressMaster.Address1" name="Address Line1" maxlength="300" tabindex="15" required disabled></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Country<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Country" ng-model="addressMaster.CountryId" ng-change="onCountryChange(addressMaster.CountryId);onStateChange(addressMaster.CountryId)" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in CountryList" tabindex="2" required disabled></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">City<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="City" ng-model="addressMaster.CityId" ng-change="onCityChange(addressMaster.CityId)" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in CityList" tabindex="4" required disabled></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Circle</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Circle" maxlength="50" ng-model="addressMaster.Circle" class="form-control" tabindex="6" disabled>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Village</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Village" maxlength="100" ng-model="addressMaster.Village" class="form-control" tabindex="8" disabled>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Postcode</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Postcode" maxlength="50" ng-model="addressMaster.Postcode" class="form-control" tabindex="10" disabled>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Email</label>
                                <div class="col-sm-8">
                                    <input type="email" name="Email" maxlength="50" ng-model="addressMaster.Email" class="form-control" tabindex="12" disabled>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Address Line2</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="addressMaster.Address2" name="Address Line2" maxlength="300" tabindex="14" disabled></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped" ng-show="contactMasters.length>0">
                            <thead>
                                <tr>
                                    <th>Person Name</th>
                                    <th>Designation</th>
                                    <th>Phone</th>
                                    <th>Mobile</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="c in contactMasters">
                                    <td>{{c.ContactPerson}}</td>
                                    <td>{{c.ContactPersonDesignation}}</td>
                                    <td>{{c.Phone1}}</td>
                                    <td>{{c.Phone3}}</td>
                                    <td>{{c.Email1}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Apply</th>
                                    <th>Company</th>
                                    <th>Plant</th>
                                    <th>Party Account Group</th>
                                    <th>Transaction Currency</th>
                                    <th>Payment Term</th>
                                    <th>Payment Term Changeable</th>
                                    <th>GL</th>
                                    <th>Bank</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="v in companyPartyList| filter: {'PartyType':'Vendor'}">
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="v.Active" checked="{{v.Active}};" ng-change="GetVendorAccountGroup(v.Active,v.COAId,$index);">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>{{v.CompanyName}}</td>
                                    <td>{{v.PlantName}}</td>
                                    <td>
                                        <select class="form-control" name="Vendor Account Group" id="VendorAccountGroupId" ng-model="v.PartyAccountGroupId" ng-disabled="!v.Active" ng-change="changePartyAccountGroupCbo(c.PartyAccountGroupId)">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in partyAccountGroupList | filter: { 'AccountType': 'Vendor', 'IsInterCompany': true}" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select id="CurrencyIds" class="form-control" name="Currency" ng-model="v.CurrencyId" ng-disabled="!v.Active">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in tranCurrencyList | filter: {'CompanyId': v.CompanyId}" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select id="PaymentTermId" class="form-control" name="Payment Term" ng-model="v.PaymentTermId" ng-disabled="!v.Active">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </td>
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="v.IsPaymentTermChangeable" checked="{{v.IsPaymentTermChangeable}}" ng-disabled="!v.Active">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <button class="btn" ng-click="GetGLList(v.CompanyId, v.Id, v.PartyAccountGroupId)" ng-disabled="!v.Active || v.Id==null"><i class="fa fa-search"></i></button>
                                    </td>
                                    <td class="text-right">
                                        <button name="submit" class="btn" ng-click="GetPartyBankList(v.CompanyId,v.Id);" ng-disabled="!v.Active || v.Id==null"><i class="fa fa-search"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Apply</th>
                                    <th>Company</th>
                                    <th>Plant</th>
                                    <th>Party Account Group</th>
                                    <th>Transaction Currency</th>
                                    <th>Payment Term</th>
                                    <th>Payment Term Changeable</th>
                                    <th>GL</th>
                                    <th>Bank</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="c in companyPartyList| filter: {'PartyType':'Customer'}">
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="c.Active" checked="{{c.Active}};" ng-change="GetCustomerAccountGroup(c.Active,c.COAId,$index);">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>{{c.CompanyName}}</td>
                                    <td>{{c.PlantName}}</td>
                                    <td>
                                        <select class="form-control" name="Customer Account Group" id="CustomerAccountGroupId" ng-disabled="!c.Active" ng-model="c.PartyAccountGroupId" ng-change="changePartyAccountGroupCbo(c.PartyAccountGroupId)">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in partyAccountGroupList | filter: { 'AccountType': 'Customer', 'IsInterCompany': true}" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select id="CurrencyId" class="form-control" name="Currency" ng-model="c.CurrencyId" ng-disabled="!c.Active">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in tranCurrencyList | filter: {'CompanyId': c.CompanyId}" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select id="PaymentTermId" class="form-control" name="Payment Term" ng-model="c.PaymentTermId" ng-disabled="!c.Active">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in customerpaymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </td>
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="c.IsPaymentTermChangeable" checked="{{c.IsPaymentTermChangeable}}" ng-disabled="!c.Active">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <button class="btn" ng-click="GetGLList(c.CompanyId, c.Id, c.PartyAccountGroupId)" ng-disabled="!c.Active || c.Id==null"><i class="fa fa-search"></i></button>
                                    </td>
                                    <td class="text-right">
                                        <button name="submit" class="btn" ng-click="GetPartyBankList(c.CompanyId,c.Id);" ng-disabled="!c.Active || c.Id==null"><i class="fa fa-search"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
