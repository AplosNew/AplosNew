<style>
    .alert-site {
        z-index: 99999 !important;
    }
</style>
<togglable name="Director"></togglable>
<div class="form-elements form-horizontal" ng-form name="partyForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Code</label>
                <div class="col-sm-8">
                    <input type="text" name="Code" ng-model="party.Code" class="form-control" placeholder="Internal" readonly>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" maxlength="50" ng-model="party.UserName" class="form-control" required>
                </div>
            </div>
        </div>
    </div>
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Address</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="contact" role="tab" data-toggle="tab">Contact</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="partyForm2">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Sequence" ng-model="party.Sequence" class="form-control" required placeholder="0" tabindex="1">
                                <span class="msg-error" ng-show="partyForm2.Sequence.$error.number">
                                    Not valid number!
                                </span>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Short Name" maxlength="15" ng-model="party.ShortName" class="form-control" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Pin Code</label>
                            <div class="col-sm-8">
                                <input type="text" name="PINCode" maxlength="50" ng-model="party.PINCode" class="form-control" tabindex="5">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">BIN No</label>
                            <div class="col-sm-8">
                                <input type="text" name="BIN NO" maxlength="50" ng-model="party.BINNO" class="form-control" tabindex="7">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Commission Rate<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Commission Rate" ng-model="party.CommissionRate" class="form-control" tabindex="9" required>
                                <span class="msg-error" ng-show="partyForm2.CommissionRate.$error.number">
                                    Not valid number!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Transaction Type</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Transaction Type" ng-model="party.TransactionType" class="form-control" tabindex="11">
                                        <option value="">--Select--</option>
                                        <option value="Bank">Bank</option>
                                        <option value="Check">Cheque</option>
                                        <option value="Cash">Cash</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">VAT Registration No</label>
                            <div class="col-sm-8">
                                <input type="text" name="VAT Resistration No" maxlength="20" ng-model="party.VATResistrationNo" class="form-control" tabindex="13">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Debit Limit</label>
                            <div class="col-sm-8">
                                <input type="number" name="DebitLimit" ng-model="party.DebitLimit" class="form-control" tabindex="19">
                                <span class="msg-error" ng-show="partyForm2.DebitLimit.$error.number">
                                    Not valid number!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Central Sale Tax No</label>
                            <div class="col-sm-8">
                                <input type="text" name="CentralSaleTaxNO" maxlength="30" ng-model="party.CSTNO" class="form-control" tabindex="21">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Certification of Incorporation No</label>
                            <div class="col-sm-8">
                                <input type="text" name="CertificationOfIncorporationNo" maxlength="20" ng-model="party.CertificationOfIncorporationNo" class="form-control" tabindex="23">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" name="Remarks" maxlength="250" rows="3" ng-model="party.Remarks" tabindex="25"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Standard Name" maxlength="50" ng-model="party.StandardName" class="form-control" required tabindex="2">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Party Group</label>
                            <div class="col-sm-8">
                                @ViewBag.CompanyGroup
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Excise Range</label>
                            <div class="col-sm-8">
                                <input type="text" name="Excise Range" maxlength="100" ng-model="party.ExciseRange" class="form-control" tabindex="6">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">GSTIN</label>
                            <div class="col-sm-8">
                                <input type="text" name="TINNO" maxlength="50" ng-model="party.TINNO" class="form-control" tabindex="8">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Trade License No</label>
                            <div class="col-sm-8">
                                <input type="text" name="TradeLicenseNo" maxlength="20" ng-model="party.TradeLicenseNo" class="form-control" tabindex="10">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">IEC No</label>
                            <div class="col-sm-8">
                                <input type="text" name="IECNo" maxlength="50" ng-model="party.IECNo" class="form-control" tabindex="12">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Credit Limit</label>
                            <div class="col-sm-8">
                                <input type="number" name="Credit Limit" ng-model="party.CreditLimit" class="form-control" tabindex="18">
                                <span class="msg-error" ng-show="partyForm2.CreditLimit.$error.number">
                                    Not valid number!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Local Sale Tax No</label>
                            <div class="col-sm-8">
                                <input type="text" name="LocalSaleTaxNo" maxlength="40" ng-model="party.LSTNO" class="form-control" tabindex="20">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Ref No</label>
                            <div class="col-sm-8">
                                <input type="text" name="RefNo" maxlength="50" ng-model="party.RefNo " class="form-control" tabindex="22">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" name="Description" maxlength="250" rows="3" ng-model="party.Description" tabindex="24"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="party.Active" tabindex="26">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="partyForm3">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Continent<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Continent" ng-model="addressMaster.ContinentId" ng-change="onContinentChange(addressMaster.ContinentId)" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in ContinentList" tabindex="1" required></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">State<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="State" ng-model="addressMaster.StateId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in StateList" tabindex="3" required></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Area</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Area" ng-model="addressMaster.AreaId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in AreaList" tabindex="5"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Thana</label>
                            <div class="col-sm-8">
                                <input name="Thana" maxlength="50" type="text" ng-model="addressMaster.Thana" class="form-control" tabindex="7">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Ward</label>
                            <div class="col-sm-8">
                                <input type="text" name="Ward" maxlength="50" ng-model="addressMaster.Ward" class="form-control" tabindex="9">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Phone</label>
                            <div class="col-sm-8">
                                <input type="text" name="Phone" maxlength="20" ng-model="addressMaster.Phone" class="form-control" tabindex="11">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Website</label>
                            <div class="col-sm-8">
                                <input type="text" name="Website" maxlength="50" ng-model="addressMaster.Website" class="form-control" tabindex="13">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Address Line1<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <textarea class="form-control" rows="3" ng-model="addressMaster.Address1" name="Address Line1" maxlength="300" tabindex="15" required></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Country<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Country" ng-model="addressMaster.CountryId" ng-change="onCountryChange(addressMaster.CountryId);onStateChange(addressMaster.CountryId)" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in CountryList" tabindex="2" required></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">City<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="City" ng-model="addressMaster.CityId" ng-change="onCityChange(addressMaster.CityId)" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in CityList" tabindex="4" required></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Circle</label>
                            <div class="col-sm-8">
                                <input type="text" name="Circle" maxlength="50" ng-model="addressMaster.Circle" class="form-control" tabindex="6">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Village</label>
                            <div class="col-sm-8">
                                <input type="text" name="Village" maxlength="100" ng-model="addressMaster.Village" class="form-control" tabindex="8">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Postcode</label>
                            <div class="col-sm-8">
                                <input type="text" name="Postcode" maxlength="50" ng-model="addressMaster.Postcode" class="form-control" tabindex="10">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email</label>
                            <div class="col-sm-8">
                                <input type="email" name="Email" maxlength="50" ng-model="addressMaster.Email" class="form-control" placeholder="example@gmail.co" tabindex="12">
                                <span class="msg-error" ng-show="partyForm3.Email.$error.email">
                                    Not valid email!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Address Line2</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="addressMaster.Address2" name="Address Line2" maxlength="300" tabindex="14"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row" ng-form name="partyForm4">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" title="Contact Person Name">Person Name</label>
                            <div class="col-sm-8">
                                <input type="text" name="ContactPerson" maxlength="100" ng-model="contactMaster.ContactPerson" class="form-control" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Phone1</label>
                            <div class="col-sm-8">
                                <input type="text" name="Phone1" maxlength="20" ng-model="contactMaster.Phone1" class="form-control" tabindex="3">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Mobile</label>
                            <div class="col-sm-8">
                                <input type="text" name="Mobile" maxlength="20" ng-model="contactMaster.Phone3" class="form-control" tabindex="5">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email1</label>
                            <div class="col-sm-8">
                                <input type="email" name="Email1" maxlength="50" ng-model="contactMaster.Email1" class="form-control" placeholder="example@gmail.co" tabindex="7">
                                <span class="msg-error" ng-show="partyForm4.Email1.$error.email">
                                    Not valid email!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email3</label>
                            <div class="col-sm-8">
                                <input type="email" name="Email3" maxlength="50" ng-model="contactMaster.Email3" class="form-control" placeholder="example@gmail.co" tabindex="9">
                                <span class="msg-error" ng-show="partyForm4.Email3.$error.email">
                                    Not valid email!
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" title="Contact Person Designation">Designation</label>
                            <div class="col-sm-8">
                                <input type="text" name="ContactPersonDesignation" maxlength="30" ng-model="contactMaster.ContactPersonDesignation" class="form-control" tabindex="2">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Phone2</label>
                            <div class="col-sm-8">
                                <input type="text" name="Phone2" maxlength="20" ng-model="contactMaster.Phone2" class="form-control" tabindex="4">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Fax</label>
                            <div class="col-sm-8">
                                <input type="text" name="Fax" maxlength="50" ng-model="contactMaster.Fax" class="form-control" tabindex="6">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email2</label>
                            <div class="col-sm-8">
                                <input type="email" name="Email2" maxlength="50" ng-model="contactMaster.Email2" class="form-control" placeholder="example@gmail.co" tabindex="8">
                                <span class="msg-error" ng-show="partyForm4.Email2.$error.email">
                                    Not valid email!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Website</label>
                            <div class="col-sm-8">
                                <input type="text" maxlength="50" ng-model="contactMaster.Website" class="form-control" tabindex="10">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button class="btn" ng-click="addRow()"><i class="glyphicon glyphicon-plus"></i>{{ContactAction}}</button></li>
                        <li> <button ng-click="ClearContact();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear Contact Form</button></li>
                    </ul>
                </div>
                <div class="table-responsive modal-table" ng-show="showContactMaster">
                    <table class="table table-striped" ng-show="contactMasters.length>0">
                        <thead>
                            <tr>
                                <th>Edit</th>
                                <th>Delete</th>
                                <th>Person Name</th>
                                <th>Designation</th>
                                <th>Phone</th>
                                <th>Mobile</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="c in contactMasters" ng-show="isArchive(c.Archive)">
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="GetContact(c.Id, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                <i class="glyphicon glyphicon-pencil"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="valuePassInDelModal(c.Id, c.ContactPerson)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                                <td>{{c.ContactPerson}}</td>
                                <td>{{c.ContactPersonDesignation}}</td>
                                <td>{{c.Phone1}}</td>
                                <td>{{c.Phone3}}</td>
                                <td>{{c.Email1}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i>Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>GL</th>
                <th>Budget</th>
                <th>Activity</th>
                <th>Active</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in parties |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.GLGeneralInfoName}}</td>
                <td>{{x.BudgetName}}</td>
                <td>{{x.ActivityName}}</td>
                <td>{{x.Active? 'Yes':'No'}}</td>
                <td><button class="btn" ng-click="GetDirectorGlList(x)"><i class="fa fa-search"></i></button></td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>

<div class="modal fade site-modal in" id="DirectorListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">GL List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="DirectorListParameters.searchBy">
                                            <option ng-repeat="option in searchDirectorByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="DirectorListParameters.search" ng-enter="GetDirectorGlList()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetDirectorGlList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in DirectorGLList |itemsPerPage:DirectorListParameters.pageSize" pagination-id="metaData.name + 'DirectorGLList'" total-items="DirectorListParameters.total_count" ng-dblclick="SelectItemGL(x);">
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                            </tr>

                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'DirectorGLList'" direction-links="true" boundary-links="true" on-page-change="getDirectorListData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer">
                <div class="common-btn" style="float:right">
                    <button class="btn" ng-click="Done()"> Done</button>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>
<toaster-container toaster-options="{'close-button':true, 'animation-class': 'toast-top-center'}"></toaster-container>
<confirm-archive-generic data-modalid="confirmContactdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeContactMasterRow()"></confirm-archive-generic>