<div class="modal fade site-modal in" id="BankPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bank Info</h4>
            </div>
            <div class="modal-body">
                <div class="form-group common-btn">
                    <button class="btn" name="submit" ng-click="BankSearch();"><i class="glyphicon glyphicon-search"></i> Add Bank</button>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Bank</th>
                                <th>Bank Branch</th>
                                <th>Account Title</th>
                                <th>Account No</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in PartyBankList | filter:{'CompanyPartyId':currentClickedCompanyPartyId}">
                                <td>{{x.BankCode}} - {{x.BankName}}</td>
                                <td>{{x.BankBranchCode}} - {{x.BankBranchName}}</td>
                                <td>{{x.AccountTitle}}</td>
                                <td>{{x.AccountNumber}}</td>
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button data-toggle="modal" data-target="#confirmPartyBankDelete" ng-click="confirmPartyBankDelete(x)"
                                                    class="btn btn-action tooltip-here" data-placement="top" title="Delete" tooltip>
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button type="submit" class="btn btn-default" ng-click="CloseBank();">Done</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="BankSearchPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Select {{bankPartyType}} Bank</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="bankparameters.searchBy">
                                            <option ng-repeat="option in searchBankModalList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="bankparameters.search" ng-enter="BankModalList()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="BankModalList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Bank</th>
                                <th>Bank Branch</th>
                                <th>Account Title</th>
                                <th>Account No</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in bankList|itemsPerPage:bankparameters.pageSize" pagination-id="metaData.name + 'bankList'"
                                total-items="bankparameters.total_count" ng-dblclick="selectBank(x);">
                                <td>{{x.BankCode}} - {{x.BankName}}</td>
                                <td>{{x.BankBranchCode}} - {{x.BankBranchName}}</td>
                                <td>{{x.AccountTitle}}</td>
                                <td>{{x.AccountNumber}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="5"
                                         pagination-id="metaData.name + 'bankList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="BankModalList(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer">
                <div class="common-btn" style="float:right">
                    <button class="btn" ng-click="Close()"> Close</button>
                </div>
            </div>
        </div>
    </div>
</div>