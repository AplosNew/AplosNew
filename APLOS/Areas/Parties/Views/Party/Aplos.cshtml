                                </div>
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Party SubCategory<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Party SubCategory" ng-model="party.PartySubCategoryId" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in partySubCategoryList" tabindex="4" required></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Responsible Person</label>
