                            <div class="col-sm-8">
                                <textarea class="form-control" name="Remarks" maxlength="250" rows="3" ng-model="party.Remarks" tabindex="25"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Latitude</label>
                            <div class="col-sm-8">
                                <input type="text" name="Latitude" maxlength="30" ng-model="party.Latitude" class="form-control" tabindex="2">
                            </div>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
