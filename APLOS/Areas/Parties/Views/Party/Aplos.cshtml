                                <input type="text" name="Standard Name" maxlength="100" ng-model="party.StandardName" class="form-control" required tabindex="2" capitalize>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Party Group<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Party Group" ng-model="party.PartyGroupId" class="col-sm-3 form-control"
