                            <div class="col-sm-8">
                                <input type="text" name="TINNO" maxlength="50" ng-model="party.TINNO" class="form-control" tabindex="8" capitalize>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Trade License No</label>
                            <div class="col-sm-8">
                                <input type="text" name="TradeLicenseNo" maxlength="20" ng-model="party.TradeLicenseNo" class="form-control" tabindex="10">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">IEC No</label>
                            <div class="col-sm-8">
                                <input type="text" name="IECNo" maxlength="50" ng-model="party.IECNo" class="form-control" tabindex="12">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Credit Limit</label>
                            <div class="col-sm-8">
                                <input type="number" name="CreditLimit" ng-model="party.CreditLimit" class="form-control" tabindex="18">
                                <span class="msg-error" ng-show="partyForm2.CreditLimit.$error.number">
                                    Not valid number!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Local Sale Tax No</label>
                            <div class="col-sm-8">
                                <input type="text" name="LocalSaleTaxNo" maxlength="40" ng-model="party.LSTNO" class="form-control" tabindex="20">
