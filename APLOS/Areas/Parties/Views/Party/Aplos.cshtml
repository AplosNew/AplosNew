                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">District<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="District" ng-model="addressMaster.DistrictId" ng-change="onDistictChange(addressMaster.DistrictId)" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in districtList" tabindex="4" required></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Circle</label>
                            <div class="col-sm-8">
                                <input type="text" name="Circle" maxlength="50" ng-model="addressMaster.Circle" class="form-control" tabindex="6">
