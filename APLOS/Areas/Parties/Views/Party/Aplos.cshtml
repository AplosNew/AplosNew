                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Bank</th>
                                <th>Bank Branch</th>
                                <th>Account No</th>
                                <th>IFSCCode</th>
                                <th>MICR Code</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in PartyBankList | filter:{'CompanyPartyId':currentClickedCompanyPartyId}">
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="GetPartyBankById(x)" class="btn btn-action tooltip-here" data-placement="top" title="Edit" tooltip><i class="glyphicon glyphicon-pencil"></i></button>
                                        </li>
                                        <li>
                                            <button data-toggle="modal" data-target="#confirmPartyBankDelete" ng-click="confirmPartyBankDelete(x)" class="btn btn-action tooltip-here" data-placement="top" title="Delete" tooltip><i class="glyphicon glyphicon-remove"></i></button>
                                        </li>
                                    </ul>
                                </td>
                                <td>{{x.Bank}}</td>
                                <td>{{x.BankBranch}}</td>
                                <td>{{x.BankAccountNo}}</td>
                                <td>{{x.IFSCCode}}</td>
                                <td>{{x.MICRCode}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>

                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                {{popUpTitle}}
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in popUpList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="popUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="popUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th ng-repeat="x in popUpList">{{x.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
                                ng-dblclick="selectdblClick(x);">
                                <td ng-repeat="hh in popUpList">{{x[hh.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="popUpData(newPageNumber)"></dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>
