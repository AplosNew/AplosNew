<togglable name="Party"></togglable>
<div class="form-elements form-horizontal" ng-form name="partyForm">
    <div class="row" ng-form name="partyForm1">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Code</label>
                <div class="col-sm-8">
                    @*<input type="text" name="Code" ng-model="party.Code" class="form-control" placeholder="Internal" readonly>*@
                    <input type="text" name="Code" maxlength="20" ng-model="party.Code" class="form-control">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Define Name" maxlength="100" ng-model="party.UserName" class="form-control" required capitalize>
                </div>
            </div>
        </div>
    </div>
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Address</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="contact" role="tab" data-toggle="tab">Contact</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="vendor" role="tab" data-toggle="tab">Vendor</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="customer" role="tab" data-toggle="tab">Customer</a></li>
                <li ng-hide="true" role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" aria-controls="vendorpf" role="tab" data-toggle="tab">Vendor PartnerFunction</a></li>
                <li ng-hide="true" role="presentation" ng-class="{ active: isSet(7) }"><a ng-click="setTab(7)" href="" aria-controls="customerpf" role="tab" data-toggle="tab">Customer PartnerFunction</a></li>
                <li role="presentation" ng-class="{ active: isSet(8) }"><a ng-click="setTab(8)" href="" aria-controls="plant" role="tab" data-toggle="tab">Plant</a></li>
                <li role="presentation" ng-class="{ active: isSet(9) }"><a ng-click="setTab(9);GetPartyAdditionalInfoDataList();" href="" data-toggle="tab">Additional Info</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="partyForm2">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Sequence" ng-model="party.Sequence" class="form-control" required placeholder="0" tabindex="1">
                                <span class="msg-error" ng-show="partyForm2.Sequence.$error.number">
                                    Not valid number!
                                </span>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Short Name" maxlength="15" ng-model="party.ShortName" class="form-control" required tabindex="3" capitalize>
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Party Category<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Party Category" ng-model="party.PartyCategoryId" class="col-sm-3 form-control"
