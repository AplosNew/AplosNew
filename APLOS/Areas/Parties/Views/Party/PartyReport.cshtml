<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Party Report
</h3>
<div class="form-elements form-horizontal" ng-form id="partyReportNew" name="partyNewReportForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        @*<div class="form-group">
            <label class="col-sm-4 control-label">Company Group Level</label>
            <div class="col-sm-8">
                <div class="radio">
                    <label>
                        <input type="radio" name="CompanyGroupLevel" ng-model="partyReportNew.CompanyGroupLevel" ng-change="CompanyShowFn();" value="CompanyGroupLevel">
                        <span class="cr"><i class="cr-icon"></i></span>
                    </label>
                </div>
            </div>
        </div>*@
        <div class="form-group">
            <label class="col-sm-4 control-label">Company Level</label>
            <div class="col-sm-8">
                <div class="radio">
                    <label>
                        <input type="radio" name="CompanyLevel" ng-model="partyReportNew.CompanyGroupLevel" ng-change="CompanyShowFn();" value="CompanyLevel">
                        <span class="cr"><i class="cr-icon"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant Level</label>
            <div class="col-sm-8">
                <div class="radio">
                    <label>
                        <input type="radio" name="PlantLevel" ng-model="partyReportNew.CompanyGroupLevel" ng-change="CompanyShowFn();" value="PlantLevel">
                        <span class="cr"><i class="cr-icon"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors ng-show="CompanyGroupShow">
            <label class="col-sm-4 control-label">Company Group<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="partyReportNew.CompanyGroupId" name="CompanyGroup" ng-options="item.Value as item.Text for item in companyGroupList" ng-change="getCboCompanyByCompanyGroup(plant.CompanyGroupId)" tabindex="2" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors ng-show="CompanyShow">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="partyReportNew.CompanyId" name="Company" tabindex="3"
                            ng-options="item.Value as item.Text for item in companyList" ng-change="getPlantList()">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors ng-show="PlantShow">
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="partyReportNew.PlantId" name="Plant" tabindex="3"
                            ng-options="item.Value as item.Text for item in plantList">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Party Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="TransactionType" ng-model="partyReportNew.Type" class="form-control" tabindex="1">
                        <option value="Customer">Customer</option>
                        <option value="Vendor">Vendor</option>
                        <option value="Both">Both</option>
                    </select>
                </div>
                <p ng-show="selectMessage" style="color:red" class="show-message">{{selectMessage}}</p>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="partyReport();" class="btn"><i class="glyphicon glyphicon-print"></i> Print</button></li>
        </ul>
    </div>
</div>
<confirm-modal></confirm-modal>