<togglable name="{{title}}"></togglable>

<div class="form-elements form-horizontal" ng-form name="ServiceTypeForm">
    <div class="row" ng-form name="General">
        <input type="hidden" ng-model="ServiceType.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Service<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Service" ng-model="ServiceType.Service" class="form-control" required tabindex="1" maxlength="50">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">UOM<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ServiceType.UOMId" name="UOM"
                                ng-options="item.Value as item.Text for item in UOMList" required tabindex="3">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Selection Mode<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ServiceType.SelectionMode" name="Selection Mode" required tabindex="5">
                            @*<option value="">--Select--</option>*@
                            <option value="0">Entry</option>
                            <option value="1">Scan</option>
                        </select>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Form<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ServiceType.Form" name="Form" required tabindex="2">
                            <option value="">--Select--</option>
                            <option value="Quantity">Quantity</option>
                            <option value="Reading">Reading</option>
                            <option value="Value">Value</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Salary Head<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ServiceType.SalaryHeadId" name="Salary Head"
                                ng-options="item.Value as item.Text for item in SalaryHeadList" required tabindex="4">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Credit Limit Allowed</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ServiceType.CreditLimitAllowed" tabindex="6">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

        </div>
        <br />
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save()" class="btn" tabindex="5"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="6"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear()" class="btn" tabindex="7"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <confirm-modal></confirm-modal>

    <div class="row">
        <div class="form-elements form-horizontal" ng-form id="QMTab">
            <div class="tab-design" id="tab_show">

                <div class="site-tab">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="servicecategory" role="tab" data-toggle="tab">Service Category</a></li>
                        
                    </ul>
                </div>

                <div class="tab-content">

                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

                        <div class="row">

                            <div ng-form name="ServiceCategoryForm" class="form-horizontal form-element-ctrl">

                                <div class="form-elements">
                                    <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
                                        <div class="form-group" show-errors>
                                            <label class="col-sm-4 control-label">Category/ Location<sup>*</sup></label>
                                            <div class="col-sm-8 show-message">
                                                <input type="text" name="Category" ng-model="ServiceCategory.Category" class="form-control" required tabindex="9" maxlength="50">
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
                                        <div class="common-btn">
                                            <ul class="list-inline text-right">

                                                <li><button ng-click="SaveServiceCategory();" tabindex="10" ng-disabled="ServiceType.Id==null" class="btn"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>
                                            </ul>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-xs-12">
                                <div style="color:black;" id="GridServiceCategoryTab" ej-grid e-datasource="SelectedServiceCategoryTabList"
                                     e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                     e-allowselection="false" e-filtersettings-filterType="excel">
                                    <div e-columns>
                                      
                                        <div e-column e-type="string" e-field="Service" e-headertext="Service" e-width="20"></div>
                                        <div e-column e-type="string" e-field="Category" e-headertext="Category" e-width="20"></div>

                                        <div e-column e-template="#DeleteServiceCategoryTab" e-width="40"></div>
                                    </div>
                                </div>

                                <script type="text/template" id="DeleteServiceCategoryTab">
                                    <div class="common-btn">
                                        <ul class="list-inline text-left">
                                            <li><button ng-click="$parent.ConfirmDeleteServiceCategoryTab(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                        </ul>
                                    </div>
                                </script>

                            </div>

                        </div>
                    </div>
                </div>


            </div>

        </div>
    </div>

</div>


<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">

    <div id="ServiceTypeListGrid" ej-grid e-datasource="ServiceTypeList"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-recorddoubleclick="Get">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Service" e-headertext="Service" e-width="1"></div>
            <div e-column e-field="Form" e-headertext="Form" e-width="2"></div>
            <div e-column e-field="UOM" e-headertext="UOM" e-width="2"></div>
            <div e-column e-field="SalaryHead" e-headertext="Salary Head" e-width="2"></div>
            <div e-column e-field="SelectMode" e-headertext="Selection Mode" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="DeleteServiceCategoryTabPopUp" title="Confirmation" message="Are you sure want to Delete?" data-ng-click-right-button="DeleteServiceCategory();"></confirm-archive-generic>
