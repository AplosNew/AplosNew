@*<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span>Invoice Additional Info</h3>*@
<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <div class="site-tab">
