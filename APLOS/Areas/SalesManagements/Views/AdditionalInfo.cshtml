<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span>Invoice Additional Info</h3>
<div class="form-horizontal form-elements" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="From Date" ng-model="FromDate" datepicker required class="form-control" tabindex="3">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="To Date" ng-model="ToDate" datepicker required class="form-control" tabindex="3">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="getMasterOrderSalesPosted();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> Go</button></li>
                    <li> <button ng-click="GetInvoiceReport();" class="btn" tabindex="9"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchByPostedSales">
                                <option ng-repeat="option in searchByPostedSalesList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="searchSales" ng-enter="getMasterOrderSalesPosted();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getMasterOrderSalesPosted()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content-container-fluid" style="color:black;overflow:scroll">
        <div style="color:black;" id="GridPost" ej-grid e-datasource="MasterOrderSalesPostedList"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-actioncomplete="actionCompleteSelected3">
            <div e-columns>
                <div e-column e-headertext="Actions" e-template="#SalesAdd" e-width="60"></div>
                <div e-column e-field="InvoiceNo" e-headertext="Invoice No" e-width="80" e-filter="false"></div>
                <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="80" e-filter="false"></div>
                <div e-column e-field="PartyCode" e-headertext="PartyCode" e-width="60" e-filter="false"></div>
                <div e-column e-field="PartyName" e-headertext="Party " e-width="150" e-filter="false"></div>
                <div e-column e-field="PartyAccountGroup" e-headertext="Party Type" e-width="150" e-filter="false"></div>
                <div e-column e-field="BillTo" e-headertext="Bill To" e-width="150"></div>
                <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="100"></div>
                <div e-column e-field="Amount" e-headertext="Amount" e-width="100"></div>
                <div e-column e-field="RowState" e-headertext="Status" e-width="100"></div>
            </div>
        </div>
        <script type="text/template" id="SalesAdd">
            <button style="color: #f3f3ec;background-color: #1c1f32;" title="Edit" class="btn"><i class="glyphicon glyphicon-pencil" ng-click="$parent.ShowAdditionalPopup(this);" style="margin: -6px;"></i></button>
        </script>
    </div>
</div>

<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>
@Html.Partial("~/Areas/SalesManagements/Views/_postedSalesPopUp.cshtml")
<div class="modal fade site-modal in" id="detailpopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form="detailFormNew">
            <div class="modal-header">
                Additional Information
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center form-horizontal form-elements">
                @*<div class="row">
                        <div id="GridEdit" ej-grid e-datasource="SalesAdditionalInfoDataList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-headertext="Select" e-template="#checkboxIssueTemplate" e-width="20"></div>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="UserName" e-headertext="UserName" e-width="80"></div>
                                <div e-column e-template="#Value" e-headertext="Value" e-width="40" style="height: 20px;"></div>
                                <div e-column e-template="#Remark" e-headertext="Remark" e-width="80" style="height: 20px;"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxIssueTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                        </script>
                        <script type="text/template" id="Value">
                            <div class="col-sm-10" style="padding:0px; width:100%;" ng-hide="data.datepic == 'datepicker'">
                                <input type="{{data.CharType}}" name="Value" ng-model="data.Value" class="form-control">
                            </div>
                            <div class="col-sm-10" style="padding:0px; width:100%;" ng-hide="data.datepic != 'datepicker'">
                                <input type="{{data.CharType}}" name="Value" datepicker ng-model="data.Value" class="form-control">
                            </div>
                        </script>
                        <script type="text/template" id="Remark">
                            <div class="col-sm-10" style="padding: 0px; width: 100%;">
                                <input type="text" ng-model="data.Remarks" ng-maxlength="250" style="color:black;" class="form-control" />
                            </div>
                        </script>
                    </div>*@
                <div class="row">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Select</th>
                                    <th>InvoiceNo</th>
                                    <th>User Name</th>
                                    <th>Value</th>
                                    <th>Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in SalesAdditionalInfoDataList">
                                    <td class="text-right table-td">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="x.Flag" tabindex="8">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>{{x.SalesId}}</td>
                                    <td>{{x.UserName}}</td>
                                    <td>
                                        <div class="col-sm-10" style="padding:0px; width:100%;" ng-hide="x.datepic == 'datepicker'">
                                            <input type="text" name="Value" ng-model="x.Value" class="form-control">
                                        </div>
                                        <div class="col-sm-10" style="padding:0px; width:100%;" ng-hide="x.datepic != 'datepicker'">
                                            <input type="text" name="Value" placeholder="dd-MMM-yyyy" ng-model="x.Value" class="form-control">
                                        </div>
                                    </td>
                                    <td><input type="text" ng-model="x.Remarks" ng-maxlength="250" style="color:black;" class="form-control" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        <li> <button ng-click="ClosePopUp();" class="btn" tabindex="9"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>

            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmBoMDetailPopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="DeleteItem();"></confirm-archive-generic>