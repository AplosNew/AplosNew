<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>
@Html.Partial("~/Areas/SalesManagements/Views/_postedSalesPopUp.cshtml")
<div class="modal fade site-modal in" id="detailpopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form="detailFormNew">
            <div class="modal-header">
                Additional Information
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center form-horizontal form-elements">
                <div class="row">
                    <div class="form-horizontal form-elements">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Post Code<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" name="PostCode" ng-model="modelNew.PostCode" class="form-control" maxlength="30" tabindex="1">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Shipping Bill<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" name="Shipping Bill" only-numbers ng-model="modelNew.ShippingBill" class="form-control" tabindex="3">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Shipping Date<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" name="Shipping Date" ng-model="modelNew.ShippingDate" datepicker class="form-control" tabindex="2">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">RodTep Amount<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" n-decimals="2" name="RodTep Amount" ng-model="modelNew.RodTepAmount" class="form-control" tabindex="4">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        <li> <button ng-click="ClosePopUp();" class="btn" tabindex="9"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>InvoiceNo</th>
                                <th>Post Code</th>
                                <th>Shipping Date</th>
                                <th>Shipping Bill</th>
                                <th>RodTep Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in SalesAdditionalInfoDataList">
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="EditData(x);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></button></li>
                                        <li><button ng-click="removeLineItem(x)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                                <td>{{x.SalesId}}</td>
                                <td>{{x.PostCode}}</td>
                                <td>{{x.ShippingDate| dateFiltering}}</td>
                                <td>{{x.ShippingBill}}</td>
                                <td>{{x.RodTepAmount}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmBoMDetailPopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="DeleteItem();"></confirm-archive-generic>