<div class="modal fade site-modal in" id="detailPopUp" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Material Sales Entry<button type="button" class="close" ng-click="closeDetaiPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border"> Material</legend>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group div_mm">
                            <label class="col-sm-4 control-label">Material</label>
