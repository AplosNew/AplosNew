<togglable name="{{FormTitle}}"></togglable>
<div class="form-elements form-horizontal row" ng-form="productNewForm">
    <div class="col-xs-4 col-sm-4-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Retrun Type</label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select name="voucherType" ng-model="ReturnType" class="col-sm-3 form-control">
                        <option value="PackingSales">PackingSales</option>
                        <option value="Sales">Sales</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-4 col-sm-4-md-4">
        <div class="form-group">
            <label class="col-sm-2 control-label">Sales No</label>
            <div class="col-sm-4">
                <div class="input-group">
                    <input type="text" ng-model="productNew.SalesId" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="popUp();" ng-disabled="ReturnType==null" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
            <label class="col-sm-3 control-label">Sales Return No</label>
            <div class="col-sm-3">
                <input type="text" ng-model="productNew.Id" class="form-control" readonly>
            </div>
        </div>



        <div class="form-group">
            <label class="col-sm-4 control-label">Customer</label>
            <div class="col-sm-8">
                <div class="input-group">
                    <label style="padding:7px">{{productNew.PartyName}}</label>
                </div>
            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <label style="padding:7px">{{productNew.Remarks}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label" ng-show="checkedByList.length">{{productNew.labelCheckAndApproved}}</label>
            <div class="col-sm-8">
                <label style="padding:7px">{{productNew.CheckedBy}}</label>

            </div>
        </div>
        <div class="form-group" ng-show="ReturnType == 'PackingSales'">
            <label class="col-sm-4 control-label">Location </label>
            <div class="col-sm-8 ">
                <div class="select-style">
                    <select id="BudgetSubCategoryId" class="form-control" name="LocMasterId" ng-model="productNew.LocMasterId">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in locationCbo" value="{{option.Value}}">{{option.TEXT}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-4 col-sm-4-md-4">
        <div class="form-group">
            <label class="col-sm-4 control-label">Sales Date</label>
            <div>
                <label style="padding:7px">{{productNew.SalesDateNew}}</label>
            </div>

        </div>
        <div class="form-group" id="div_docNo">
            <label class="col-sm-4 control-label">Customer Doc. RefNo</label>
            <div class="col-sm-8">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="productNew.DocRefNo" class="form-control" tabindex="4" required autocomplete="off" capitalize>
            </div>
        </div>
        <div class="form-group" id="div_currency">
            <label class="col-sm-4 control-label">Currency</label>
            <div class="col-sm-8">
                <label style="padding:7px">{{productNew.CurrencyCode}}</label>
            </div>
        </div>

    </div>
    <div class="col-xs-4 col-sm-4-md-4">
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sales Return Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="SalesReturnDate" ng-model="productNew.SalesReturnDate" datepicker="checkInvoiceDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group" id="div_rate">
            <label class="col-sm-4 control-label">Rate</label>
            <div class="col-sm-8 ">
                <label style="padding:7px">{{productNew.ToCurrencyRate}}</label>

            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Narration</label>
            <div class="col-sm-8 show-message">
                <textarea rows="2" type="text" maxlength="250" name="Narration" tabindex="8" class="form-control" required ng-model="productNew.Narration" capitalize></textarea>
            </div>
        </div>
    </div>


    <div class="clearfix"></div>
    <div class="col-md-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Payment Term</legend>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Payment Term</label>
                    <div class="col-sm-8">
                        <label style="padding:7px">{{productNew.PaymentTerm}}</label>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-5 control-label">Due Date BaseOn</label>
                    <div class="col-sm-7">
                        <label style="padding:7px">{{productNew.BaseOnDueDate}}</label>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-3 control-label">No Of Days</label>
                    <div class="col-sm-2 pdr3">
                        <label style="padding:7px">{{productNew.BaseNoOfDays}}</label>
                    </div>
                    <label class="col-sm-3 control-label">Mature Date</label>
                    <div class="col-sm-4">
                        <label style="padding:7px">{{productNew.MatureDate}}</label>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="clearfix"></div>


    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Material</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Charges</a></li>
        </ul>
    </div>

    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div ng-form="tabForm1">
                <table class="col-md-6 text-right" ng-show="detailList.length>0">
                    <tbody>
                        <tr>
                            <td></td>
                            <td>Amount</td>
                            <td>Tax</td>
                            <td>Total</td>
                        </tr>
                        <tr>
                            <td>Materials</td>
                            <td>{{detailList | sumByKey : 'Amount'| setDecimal:2| number }}</td>
                            <td>{{detailList | sumByKey : 'TaxAmount'| setDecimal:2 | number}}</td>
                            <td>{{(detailList | sumByKey : 'Amount'| setDecimal:2)+(detailList | sumByKey : 'TaxAmount' | setDecimal:2)|number}}</td>
                        </tr>
                        <tr style="border-bottom: 1px solid;">
                            <td>Service</td>
                            <td>{{chargesList | sumByKey : 'Amount'| setDecimal:2 | number}}</td>
                            <td>{{chargesList | sumByKey : 'TotalTaxAmount'| setDecimal:2 | number}}</td>
                            <td>{{(chargesList | sumByKey : 'Amount'| setDecimal:2)+(chargesList | sumByKey : 'TotalTaxAmount' | setDecimal:2)| number}}</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td>Net Amount</td>
                            <td>{{(detailList | sumByKey : 'TotalAmount'| setDecimal:2) + (detailList | sumByKey : 'TaxAmount'| setDecimal:2) + (chargesList | sumByKey : 'Amount'| setDecimal:2) + (chargesList | sumByKey : 'TotalTaxAmount'| setDecimal:2)| number}}</td>
                        </tr>
                    </tbody>
                </table>
                <div class="clearfix"></div>

                <div class="row">
                    <div class="table-responsive modal-table col-md-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Material</th>
                                    <th>Article</th>
                                    <th>SKU1</th>
                                    <th>SKU2</th>
                                    <th>SKU3</th>
                                    <th>Country Name</th>
                                    <th> Amount</th>
                                    <th>Sales Tax </th>
                                    <th>Total Sales Amount</th>
                                    <th>Sales Rate</th>
                                    <th>Sales Qty</th>
                                    <th>Other Return Qty</th>
                                    <th>Balance Qty</th>
                                    <th style="width:100px">Return_Qty</th>
                                    <th style="width:100px" ng-show="productNew.SourceType == 'Packing'">Verified_Qty</th>
                                    <th>Current Balance Qty</th>
                                    <th>Return Amount</th>
                                    <th>Return Tax</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in detailList">
                                    <td>{{x.MaterialMasterName}}</td>
                                    <td>{{x.ArticleName}}</td>
                                    <td>{{x.FirstCharacteristicText}}</td>
                                    <td>{{x.SecondCharacteristicText}}</td>
                                    <td>{{x.ThirdCharacteristicText}}</td>
                                    <td>{{x.CountryName}}</td>
                                    <td class="text-right">{{x.TransactionAmount}}</td>
                                    <td class="text-right">{{x.SalesTax}}</td>
                                    <td class="text-right">{{x.TotalAmount}}</td>
                                    <td class="text-right">
                                        <input type="text" n-decimals="2" ng-model=" x.TransactionRate" ng-change="returnAmountCalculation(x);" class="form-control text-right">
                                        <input type="text" n-decimals="2" ng-model=" x.BaseRate" ng-hide="x.TransactionUoMId==x.BaseUOMId" ng-change="returnAmountCalculation(x);" class="form-control text-right">
                                    </td>
                                    <td class="text-right">{{x.TransactionQty}}  {{x.TransactionUoM}}</td>
                                    <td class="text-right">{{x.OtherQty}}</td>
                                    <td class="text-right">{{x.BalanceQty}}</td>
                                    <td class="text-right">
                                        <input type="text" n-decimals="2" ng-model=" x.ReturnQty" ng-change="returnAmountCalculation(x);" ng-disabled="productNew.SourceType == 'Packing'" class="form-control text-right">
                                    </td>
                                    <td class="text-right" ng-show="productNew.SourceType == 'Packing'">
                                        <div class="input-group">
                                            <input type="text" n-decimals="2" ng-model=" x.VerifiedQty" ng-disabled="productNew.SourceType == 'Packing'" ng-change="returnAmountCalculation(x);" class="form-control text-right">
                                            <span class="input-group-btn">
                                                <button ng-click="getItemScanChildPopUp(x)" ng-show="productNew.SourceType == 'Packing'" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-right">{{x.CurrentBalanceQty}}</td>
                                    <td class="text-right">{{x.Amount}}</td>
                                    <td class="text-right">{{x.TaxAmount}}</td>
                                    <td class="text-right table-td">
                                        <ul class="list-inline">
                                            <li><button ng-click="getTaxList(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
                                            @*<li><button ng-click="getSpecificMaterialStock(x, $index);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Select GRN"><i class="glyphicon glyphicon-list"></i></button></li>*@
                                            @*<li><button ng-click="removeRowModal(x, $index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>*@
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="6" class="text-right"><strong>Total : </strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'TransactionAmount'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'SalesTax'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'TotalAmount'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'TransactionQty'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'OtherQty'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'BalanceQty'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'ReturnQty'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right" ng-show="productNew.SourceType == 'Packing'"><strong>{{detailList | sumByKey : 'VerifiedQty'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'CurrentBalanceQty'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'Amount'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'TaxAmount'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <ul class="common-btn list-inline text-right">
                            <li><button ng-click="Save();" ng-disabled="IsSaveButtonDisable" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div class="row">
                        <div class="col-xs-12">
                            <fieldset class="scheduler-border" ng-show="detailList.length>0">
                                <legend class="scheduler-border">Additional Tax</legend>
                                <div class="col-xs-12 col-sm-4 col-md-4">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label">If Percentage Applicable</label>
                                        <div class="col-sm-6">
                                            <div class="radio">
                                                <label>
                                                    <input type="radio" name="TaxOptionAddiTax" ng-model="salesVM.TaxOptionAddiTax" value="Yes" ng-click="TaxOptionAdditax('Yes');"> @*ng-hide="HSNCode !=null"*@
                                                    <span class="cr"><i class="cr-icon"></i></span>Yes
                                                </label>
                                                <label>
                                                    <input type="radio" name="TaxOptionAddiTax" ng-model="salesVM.TaxOptionAddiTax" value="No" ng-click="TaxOptionAdditax('No');">@*ng-hide="HSNCode !=null"*@
                                                    <span class="cr"><i class="cr-icon"></i></span>No
                                                </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="clearfix"></div>
                                <div class="table-responsive modal-table">
                                    <table class="table table-responsive table-striped">
                                        <thead>
                                            <tr>
                                                <th>Input Tax</th>
                                                <th>Percentage</th>
                                                <th>Amount</th>
                                                <th class="text-right">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td id="td_TaxCode">
                                                    <div class="select-style show-message">
                                                        <select name="TaxCodeId" ng-model="advanceTax.TaxCodeId" ng-change="selectadditionalTax(advanceTax.TaxCodeId)" class="col-sm-3 form-control"
                                                                ng-options="item.Id as item.UserName for item in taxCodCboListWithhold">
                                                            <option></option>
                                                        </select>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div>
                                                        <input type="text" n-decimals="4" class="form-control text-right" ng-disabled="salesVM.TaxOptionAddiTax==='No'" ng-model="advanceTax.ValueOfFixed" ng-keyup="calculateTaxAmountForAdditionalTax(advanceTax.ValueOfFixed);">
                                                    </div>
                                                </td>
                                                <td id="td_TaxCodeAmount">
                                                    <div class="show-message">
                                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="advanceTax.Amount" ng-keyup="copyTaxesAmount();checkRowValidationSdditionalTax(advanceTax.Amount);" ng-disabled="salesVM.TaxOptionAddiTax==='Yes'">
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    <a ng-click="additionalTax();"  class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                                                </td>
                                            </tr>
                                            <tr ng-repeat="x in advanceTaxesList">
                                                <td>{{x.TaxName}}</td>
                                                <td>{{x.ValueOfFixed}}</td>
                                                <td class="text-right">{{x.Amount | number:2 }}</td>
                                                <td class="text-right">
                                                    <button ng-click="removeTaxesRow(x.Id,$index)" data-toggle="modal" ng-disabled="x.AdvanceId || salesVM.RowState==='Posted'" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot ng-show="advanceTaxesList.length">
                                            <tr>
                                                <td colspan="2"><b>Sub Total</b></td>
                                                <td class="text-right"><b>{{ advanceTaxesList | sumByKey : 'Amount'| setDecimal:2| number:2  }}</b></td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                                <div class="common-btn">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label">Total Amount (Total Amount+Service Amount+Additional Tax)</label>
                                        <div class="col-sm-2 show-message">
                                            <input type="text" n-decimals="2" name="Total Amount" ng-model="advanceTax.TotalSumAfterTCSVal" class="form-control" tabindex="4" readonly>
                                        </div>
                                    </div>
                                    @*<ul class="list-inline text-right">
                                        <li><button ng-click="SaveAdditinalTax();" ng-disabled="salesVM.Id==null || salesVM.RowState==='Posted'" class="btn"><i class="glyphicon glyphicon-folder-close"></i>&nbsp;Save</button></li>

                                    </ul>*@
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>

            </div>

        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div ng-form="tabForm2">

                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th>Description</th>
                                <th>Sale Amount (TRN)</th>
                                <th> Tax </th>
                                <th> Other Sales </th>
                                <th> Balance  </th>
                                <th>Return Amount</th>
                                <th>Return Tax </th>
                                <th class="col-sm-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in chargesList">
                                <td>{{x.ServiceMasterName}}</td>
                                <td> {{x.Description}}</td>
                                <td ng-hide="true">{{x.Id}}</td>
                                <td class="text-right"> {{x.Amount}}</td>
                                <td class="text-right">{{x.SalesServiceTaxAmount}}</td>
                                <td class="text-right">{{x.OtherServiceAmount}}</td>
                                <td class="text-right">{{x.BalanceAmount}}</td>
                                <td class="text-right">
                                    <input type="text" n-decimals="2" class="form-control text-right" width="20" ng-model="x.ReturnAmount" ng-keyup="calculateServiceAmount(x);">
                                </td>
                                <td class="text-right">{{x.TotalTaxAmount}}</td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="getServiceTaxList(x, false,x.Id,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" class="text-right"><strong>Total : </strong></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'Amount'| setDecimal:2| number }}</strong></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'SalesServiceTaxAmount'| setDecimal:2| number }}</strong></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'OtherServiceAmount'| setDecimal:2| number }}</strong></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'BalanceAmount'| setDecimal:2| number }}</strong></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'ReturnAmount'| setDecimal:2| number }}</strong></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'TotalTaxAmount'| setDecimal:2| number }}</strong></td>
                                <td class="text-right"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        @*<li><button ng-click="serviceChargePopUpEdit()" ;" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>*@
                        @*<li><button ng-click="closeDetaiPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>*@
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>


</div>



<div class="aplos-grid-toggle">
