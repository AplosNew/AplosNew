                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-3 show-message" style="padding-left:0px;">
                                <input type="text" maxlength="50" id="Rate" name="Company Currency Rate" ng-model="salesVM.CompanyCurrencyRate" ng-disabled="salesVM.CurrencyId==salesVM.BaseCurrencyId" class="form-control text-right" tabindex="5" required autocomplete="off">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" title="BL Number">BL No.</label>
                            <div class="col-sm-3" style="width: 115px;margin-left: -33px;">
                                <input type="text" ng-maxlength="50" name="BL Number" ng-model="salesVM.BLNumber" class="form-control" tabindex="4" capitalize autocomplete="off">
