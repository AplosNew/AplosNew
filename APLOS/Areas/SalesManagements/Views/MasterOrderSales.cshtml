                                    <button ng-click="GetMasterOrderByContractList()" ng-disabled="salesVM.ContractId==null" class="btn single-small-btn"><i class="glyphicon glyphicon-list-alt"></i></button>
                                </span>
                            </div>
                        </div>
                        <div id="div_DocDate" class="form-group" show-errors>
