<style>
    .modellgModify {
        width: 1200px;
    }
</style>
<div class="modal fade site-modal in" id="masterOrderItemPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Sales Order <button type="button" class="close" ng-click="closeMasterOrderItemPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="Grid" ej-grid e-datasource="masterOrderItemList" e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick="selectDoubleClick"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplates" e-template="#checkboxTemplateChild" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="MasterOrderId" e-headertext="MasterOrder No" e-width="80" e-filter="false"></div>
                                <div e-column e-field="MasterOrderItemId" e-headertext="MasterOrderItemNo" e-width="80" e-filter="false"></div>
                                <div e-column e-field="SONo" e-headertext="SO No" e-width="80" e-filter="false"></div>
                                <div e-column e-field="PONumber" e-headertext="PO No" e-width="80"></div>
                                <div e-column e-field="PODate" e-headertext="PO Date" e-width="80"></div>
                                <div e-column e-field="DeliveryDate" e-headertext="Delivery Date" e-width="80"></div>
                                <div e-column e-field="DestinationName" e-headertext="Destination" e-width="80"></div>
                                <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="80"></div>
                                <div e-column e-field="MaterialMasterArticleName" e-headertext="Article" e-width="80"></div>
                                <div e-column e-field="WithSKU" e-headertext="WithSKU" e-width="50"></div>
                                <div e-column e-field="SKU1" e-headertext="SKU1" e-width="80"></div>
                                <div e-column e-field="SKU2" e-headertext="SKU2" e-width="80"></div>
                                <div e-column e-field="SKU3" e-headertext="SKU3" e-width="80"></div>
                                <div e-column e-field="Rate" e-headertext="Rate" e-width="80"></div>
                                <div e-column e-field="Qty" e-headertext="Qty" e-width="80"></div>
                                <div e-column e-field="PlanQty" e-headertext="PlanQty" e-width="80"></div>
                                <div e-column e-field="ExistSalesQty" e-headertext="Other Qty" e-width="80"></div>
                                <div e-column e-field="Balance" e-headertext="Balance" e-width="80"></div>
                                <div e-column e-field="ProductName" e-headertext="Product" e-width="80"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplateChild">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplates">
                            <input type="checkbox" id="headschk" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="ApplyMasterOrderItemPopUp();" class="btn"> Apply</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>