<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Sales Process</h3>

<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);" href="" aria-controls="Sales" role="tab" data-toggle="tab">Sales Process</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="SalesType" role="tab" data-toggle="tab">Sales Type</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);getSPData();" href="" aria-controls="Purchase" role="tab" data-toggle="tab">Transaction</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form="tabForm1" id="Sales">
            <togglable name="{{title}}"></togglable>
            <div class="form-elements form-horizontal">

                <div class="row">

                    <div ng-form name="ModelNewForm" id="maindiv">
                        <input type="hidden" ng-model="ModelNew.Id">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100%" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sales Process<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="SalesProcess" ng-model="ModelNew.SalesProcess" class="form-control" required tabindex="5" maxlength="50">
                                </div>
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row text-right aplos-grid-toggle">
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="searchBy">
                                        <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-responsive aplos-grid-toggle">
                <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                        <div e-column e-field="SalesProcess" e-headertext="SalesProcess" e-width="5"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="5"></div>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form="tabForm2" id="SalesProcessType">
            <togglable name="{{SalesTypetitle}}"></togglable>
            <div class="form-elements form-horizontal">
                <div class="row">

                    <div ng-form name="SalesTypeModelForm" id="SalesTypediv">
                        <input type="hidden" ng-model="SalesTypeModel.Id">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="SalesTypeModel.Sequence" e-width="100%" required />
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Short Name" ng-model="SalesTypeModel.ShortName" class="form-control" maxlength="15" required tabindex="3">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="User Name" ng-model="SalesTypeModel.UserName" class="form-control" required tabindex="5" maxlength="50">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="SalesTypeModel.Description" tabindex="7" maxlength="250"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Code" ng-model="SalesTypeModel.Code" class="form-control" required tabindex="2" maxlength="10">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Standard Name" ng-model="SalesTypeModel.StandardName" class="form-control" required tabindex="4" maxlength="50">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sales Category<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Sales Category" ng-model="SalesTypeModel.SalesCategory" class="form-control" required tabindex="4" maxlength="50">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="SalesTypeModel.Remarks" maxlength="250" tabindex="6"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Active</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="SalesTypeModel.Active" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveSalesType();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                                <li> <button ng-click="ClearSalesType();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
                <div id="GridST" ej-grid e-datasource="SalesTypeList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                        <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
                        <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
                        <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
                        <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
                        <div e-column e-field="SalesCategory" e-headertext="Sales Category" e-width="5"></div>
                        <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>

                    </div>
                </div>


        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }" ng-form="tabForm3" id="Transaction">

            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="SaveSPT();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                </ul>
            </div>
            <div id="GridSalPT" ej-grid e-datasource="SPList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="strue">
                <div e-columns>
                    <div e-column e-template="#SalesType" e-field="SalesTypeId" e-headertext="Sales Type" e-width="4"></div>
                    <div e-column e-field="Sequence" e-headertext="Sales Sequence" e-width="2"></div>
                    <div e-column e-field="SalesProcess" e-headertext="SalesProcess" e-width="4"></div>
                    <div e-column e-template="#DependentProcess" e-field="DependentProcess" e-headertext="Dependent Process" e-width="5"></div>
                    <div e-column e-template="#PaymentMode" e-field="PaymentMode" e-headertext="Payment Mode" e-width="4"></div>
                    <div e-column e-template="#StandardDaysfromInvoice" e-field="StandardDaysfromInvoice" e-headertext="StandardDaysfromInvoice" e-width="5"></div>
                    <div e-column e-template="#StandardDaysFromPreviousProcess" e-field="StandardDaysFromPreviousProcess" e-headertext="StandardDaysFromPreviousProcess" e-width="5"></div>
                    <div e-column e-template="#BankApplicable" e-field="BankApplicable" e-headertext="BankApplicable" e-width="2"></div>
                    <div e-column e-template="#BankName" e-field="BankName" e-headertext="BankName" e-width="4"></div>
                    <div e-column e-field="AccountNumber" e-headertext="Bank AccountNo" e-width="5"></div>
                    <div e-column e-template="#Department" e-field="Department" e-headertext="Department" e-width="5"></div>
                    <div e-column e-template="#ResponsiblePerson" e-field="ResponsiblePerson" e-headertext="ResponsiblePerson" e-width="5"></div>
                    <div e-column e-template="#Remark" e-headertext="Remark" e-width="5" style="height: 20px;"></div>
                </div>
            </div>
            <script type="text/template" id="SalesType">
                <div class="select-style">
                    <select id="SalesType" name="SalesType" class="form-control" ng-model="data.SalesTypeId" tabindex="8">
                        <option ng-repeat="option in $parent.salesProcessTypeList" value="{{option.Id}}">{{option.UserName}}</option>
                    </select>
                </div>
            </script>
            <script type="text/template" id="PaymentMode">
                <div class="select-style">
                    <select class="form-control" ng-model="data.PaymentModeId" name="PaymentMode">
                        <option value="">--Select--</option>
                        <option value="Bank">Bank</option>
                        <option value="Cheque">Cheque</option>
                        <option value="Cash">Cash</option>
                        <option value="Transfer">Transfer</option>
                    </select>
                </div>
            </script>
            <script type="text/template" id="StandardDaysfromInvoice">
                <div class="col-sm-12">
                    <input tabindex="1" type="text" name="StandardDaysfromInvoice" ng-model="data.StandardDaysfromInvoice" class="form-control">
                </div>
            </script>
            <script type="text/template" id="StandardDaysFromPreviousProcess">
                <div class="col-sm-12">
                    <input tabindex="1" type="text" name="StandardDaysFromPreviousProcess" ng-model="data.StandardDaysFromPreviousProcess" class="form-control">
                </div>
            </script>
            <script type="text/template" id="BankApplicable">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="data.IsBankApplicable" ng-change="$parent.CheckBankApplicable(this)" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </script>
            <script type="text/template" id="ResponsiblePerson">
                <div class="input-group">
                    <input tabindex="1" type="text" name="Responsible Prerson" ng-model="data.ResponsiblePerson" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="$parent.showResponsiblePersonListPopUp(this);" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </script>
            <script type="text/template" id="BankName">
                <div class="input-group">
                    <input tabindex="1" type="text" name="BankName" ng-model="data.BankName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="$parent.GetBankInfo(this);" ng-disabled="data.IsBankApplicable==false" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </script>
            <script type="text/template" id="DependentProcess">
                <div class="input-group">
                    <input tabindex="1" type="text" name="DependentProcess" ng-model="data.DependentProcess" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="$parent.GetDependentProcessInfo(this);" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </script>
            <script type="text/template" id="Department">
                <div class="input-group">
                    <input tabindex="1" type="text" name="Department" ng-model="data.Department" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="$parent.showDepartmentPopUp(this);" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </script>
            <script type="text/template" id="Remark">
                <div class="col-sm-10" style="padding:0px; width:100%;">
                    <input type="text" ng-model="data.Remark" ng-maxlength="250" style="color:black;" class="form-control" />
                </div>
            </script>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="BankInFoPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Bank Info<button type="button" class="close" ng-click="closeBankInfoPopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridEmp" ej-grid e-datasource="BankInfolist" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SetBankData" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="BankName" e-headertext="Bank Name" e-width="80"></div>
                            <div e-column e-field="BankBranchName" e-headertext="Bank Branch" e-width="80"></div>
                            <div e-column e-field="AccountTitle" e-headertext="Account Title" e-width="80"></div>
                            <div e-column e-field="AccountNumber" e-headertext="Account Number" e-width="80"></div>
                            <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="30"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeBankInfoPopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="DPTPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Department List
                <button type="button" class="close" ng-click="closeDPTPopup();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div style="color:black;" id="GridDepartment" ej-grid e-datasource="DepartmentList" e-recorddoubleclick="SetDPTData"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="80"></div>
                                <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="140"></div>
                            </div>
                        </div>

                        <div class="row text-right">
                            <div class="common-btn">
                                <ul class="list-inline ">
                                    <li>
                                        <button ng-click="closeDPTPopup();" class="btn"><i class=""></i> Close</button>
                                    </li>
                                </ul>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee Information<button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <disv class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="SystemId" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </disv>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closePopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>
<div class="modal fade site-modal in" id="SPPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Sales Process List
                <button type="button" class="close" ng-click="closeSPPopup();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div id="GridSP" ej-grid e-datasource="ModelList" e-recorddoubleclick="SetSPData" 
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                                <div e-column e-field="SalesProcess" e-headertext="SalesProcess" e-width="5"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="5"></div>
                            </div>
                        </div>

                        <div class="row text-right">
                            <div class="common-btn">
                                <ul class="list-inline ">
                                    <li>
                                        <button ng-click="closeSPPopup();" class="btn"><i class=""></i> Close</button>
                                    </li>
                                </ul>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>