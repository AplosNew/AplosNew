<div class="modal fade site-modal in" id="serviceChargeTaxPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Service Charge Tax Information</div> @*<button type="button" class="close" ng-click="closeReceiveTaxPopUp();">&times;</button>*@
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <p>Taxable amount : <b>{{taxAbleAmnt| number| setDecimal:currencyPrecision}}</b>&nbsp;<b>{{Currency}}</b></p>
                    <p>HSNCode : <b>{{HSNCode}}</b></p>
                </div>
                <div class="clearfix"></div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">If Percentage Applicable</label>
                        <div class="col-sm-6">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="TaxOptionServiceModify" ng-model="salesVM.TaxOptionServiceModify" value="Yes" ng-click="TaxOptionServiceModify('Yes');"> @*ng-hide="HSNCode !=null"*@
                                    <span class="cr"><i class="cr-icon"></i></span>Yes
                                </label>
                                <label>
                                    <input type="radio" name="TaxOptionServiceModify" ng-model="salesVM.TaxOptionServiceModify" value="No" ng-click="TaxOptionServiceModify('No');">@*ng-hide="HSNCode !=null"*@
                                    <span class="cr"><i class="cr-icon"></i></span>No
                                </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div>
                    <p class="col-md-11"></p>
                    <button type="button" class="btn btn-action" ng-click="addTax();">Add Tax</button>
                </div>
                <div class="table-responsive modal-table">

                    <table class="table table-striped" id="AddTaxCharge">
                        <thead>
                            <tr>
                                <th ng-hide="true">id</th>
                                <th>Tax Category</th>
                                <th ng-hide="true">HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in ServicetaxPopList">
                                <td ng-hide="true">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Id" readonly>
                                    </div>
                                </td>
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList" id="servicedrptax" ng-change="onchangeFunction(x.TaxCategoryId)"></select>
                                    </div>
                                </td>
                                <td ng-hide="true">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.HSNCode">
                                    </div>
                                </td>
                                <td>
                                    <div class="show-message">
                                        <input type="text" n-decimals="{{4}}" class="form-control text-right" ng-model="x.Percentage" ng-keyup="calculateServiceTaxAmount(x);" ng-disabled="salesVM.TaxOptionServiceModify==='No'">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <div class="show-message">
                                        <input type="text" n-decimals="{{2}}" class="form-control text-right" ng-model="x.Amount" ng-keyup="checkServiceRowValidation(x, $index)" ng-disabled="salesVM.TaxOptionServiceModify==='Yes'">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="taxSerDel(x.Id,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right"><strong>{{ServicetaxPopList | sumByKey : 'Amount'| setDecimal:2| number:2 }}</strong></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        @*<li><button ng-click="closeServiceChargeTaxPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Update</button></li>*@
                        <li><button ng-click="closeServiceTaxPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Add</button></li>
                        <li><button ng-click="closeServiceChargeTaxPopUpwindow();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>