@*<togglable name="E-Invoice"></togglable>*@
<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> E-Invoice</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="SearchInvoiceData();" class="btn"><i class="glyphicon glyphicon-search"></i> Invoice</button></li>
        </ul>
    </div>
    <div ng-show="selectedpostedSalesList.length>0">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Invoice List</legend>
            <div style="color:black;overflow:scroll" id="SPSGrid" ej-grid e-datasource="selectedpostedSalesList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-allowscrolling="true">
                <div e-columns>
                    <div e-column e-field="SalesId" e-headertext="Invoice No" e-width="80" e-filter="false"></div>
                    <div e-column e-field="PartyCode" e-headertext="PartyCode" e-width="60" e-filter="false"></div>
                    <div e-column e-field="PartyName" e-headertext="Party " e-width="150" e-filter="false"></div>
                    <div e-column e-field="Tracenent" e-headertext="Tracenent " e-width="150" e-filter="false"></div>
                    <div e-column e-field="BillTo" e-headertext="Bill To" e-width="150"></div>
                    <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="50"></div>
                    <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                    <div e-column e-field="Amount" e-headertext="Amount" e-width="100"></div>
                    <div e-column e-field="RowState" e-headertext="State" e-width="50"></div>
                    <div e-column e-field="SourceType" e-headertext="SourceType" e-width="50"></div>
                </div>
            </div>
        </fieldset>
    </div>
    <div ng-show="salesMaterialList.length>0">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Material List</legend>
            <div style="color:black;" id="SMGrid" ej-grid e-datasource="salesMaterialList" e-allowscrolling="true" @*e-templaterefresh="refreshTemplateMaterial"*@
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowselection="false" e-filtersettings-filterType="excel">
                <div e-columns>
                    @*<div e-column e-headertext="" e-headertemplateid="#headerTemplateMaterial" e-template="#checkboxTemplateMaterial" e-textalign="center" e-width="30"></div>*@
                    <div e-column e-type="string" e-field="DocumentNumber" e-headertext="DocumentNumber" e-width="80"></div>
                    <div e-column e-type="string" e-field="DocumentDate" e-headertext="DocumentDate" e-width="80"></div>
                    <div e-column e-type="string" e-field="BuyerLegalName" e-headertext="BuyerLegalName" e-width="80"></div>
                    <div e-column e-type="string" e-field="BuyerLocation" e-headertext="BuyerLocation" e-width="80"></div>
                    <div e-column e-type="string" e-field="BuyerPinCode" e-headertext="BuyerPinCode" e-width="80"></div>
                    <div e-column e-type="string" e-field="ProductDescription" e-headertext="ProductDescription" e-width="180"></div>
                    <div e-column e-type="string" e-field="HSNcode" e-headertext="HSNcode" e-width="80"></div>
                    <div e-column e-type="number" e-format="{0:0.00}" e-field="Quantity" e-headertext="Quantity" e-width="80"></div>
                    <div e-column e-field="Unit" e-headertext="Unit" e-width="80"></div>
                    <div e-column e-type="number" e-format="{0:0.00}" e-field="UnitPrice" e-headertext="UnitPrice" e-width="80"></div>
                    <div e-column e-type="number" e-format="{0:0.00}" e-field="GrossAmount" e-headertext="GrossAmount" e-width="80"></div>
                    <div e-column e-type="number" e-format="{0:0.00}" e-field="Taxablevalue" e-headertext="Taxablevalue" e-width="80"></div>
                    <div e-column e-type="number" e-format="{0:0.00}" e-field="ItemTotal" e-headertext="ItemTotal" e-textalign="right" e-width="80"></div>
                </div>
            </div>
            @*<script type="text/template" id="checkboxTemplateMaterial">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Active" />
            </script>
            <script type="text/x-jsrender" id="headerTemplateMaterial">
                <input type="checkbox" id="headchk" />
            </script>*@
        </fieldset>
    </div>
    <div class="common-btn" ng-show="salesMaterialList.length>0">
        <ul class="list-inline text-left">
            <li><button ng-click="PrintExcel();" class="btn"><i class="glyphicon glyphicon-download"></i>Report</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i>Clear</button></li>
        </ul>
    </div>

</div>
<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>
@Html.Partial("~/Areas/SalesManagements/Views/_postedSalesPopUp.cshtml")