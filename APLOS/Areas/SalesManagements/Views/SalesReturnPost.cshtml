<togglable name="{{FormTitle}}"></togglable>
<div class="form-elements form-horizontal row" ng-form="productNewForm">
    <div class="col-xs-6 col-sm-6-md-6">
        <div class="form-group">
            <label class="col-sm-3 control-label">Sales No</label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input type="text" ng-model="productNew.InventorySalesId" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="popUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 col-md-4 control-label">Storage Location</label>
            <div class="col-sm-8">
                <label style="padding:7px">{{productNew.MaterialStorage}}</label>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Customer</label>
            <div class="col-sm-8">
                <div class="input-group">
                    <label style="padding:7px">{{productNew.PartyName}}</label>
                </div>
            </div>
        </div>

        <div class="form-group" id="div_docDate">
            <label class="col-sm-4 control-label">Doc Date</label>
            <div class="col-sm-8">
                <label style="padding:7px">{{productNew.DocDate}}</label>
            </div>
        </div>

        <div class="form-group" id="div_rate">
            <label class="col-sm-4 control-label">Rate</label>
            <div class="col-sm-8 ">
                <label style="padding:7px">{{productNew.ToCurrencyRate}}</label>

            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <label style="padding:7px">{{productNew.Remarks}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label" ng-show="checkedByList.length">{{productNew.labelCheckAndApproved}}</label>
            <div class="col-sm-8">
                <label style="padding:7px">{{productNew.CheckedBy}}</label>

            </div>
        </div>

    </div>
    <div class="col-xs-6 col-sm-6-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Sales Date</label>
            <div>
                <label style="padding:7px">{{productNew.SalesDateNew}}</label>

            </div>

        </div>

    </div>
    <div class="col-xs-6 col-sm-6-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Entity</label>
            <div class="col-sm-8">
                <label style="padding:7px">{{productNew.Entity}}</label>

            </div>
        </div>

    </div>

    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="form-group" id="div_docNo">
            <label class="col-sm-4 control-label">Customer Doc. RefNo</label>
            <div class="col-sm-8">

                <label style="padding:7px">{{productNew.DocRefNo}}</label>
            </div>

        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="form-group" id="div_currency">
            <label class="col-sm-4 control-label">Currency</label>
            <div class="col-sm-8">
                <label style="padding:7px">{{productNew.CurrencyCode}}</label>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Note For Accounts</label>
            <div class="col-sm-8">
                <label style="padding:7px">{{productNew.NoteForAccounts}}</label>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-md-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Payment Term</legend>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Payment Term</label>
                    <div class="col-sm-8">
                        <label style="padding:7px">{{productNew.PaymentTerm}}</label>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-5 control-label">Due Date BaseOn</label>
                    <div class="col-sm-7">
                        <label style="padding:7px">{{productNew.BaseOnDueDate}}</label>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-3 control-label">No Of Days</label>
                    <div class="col-sm-2 pdr3">
                        <label style="padding:7px">{{productNew.BaseNoOfDays}}</label>
                    </div>
                    <label class="col-sm-3 control-label">Mature Date</label>
                    <div class="col-sm-4">
                        <label style="padding:7px">{{productNew.MatureDate}}</label>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="clearfix"></div>


    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Material</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Journal</a></li>
        </ul>
    </div>

    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div ng-form="tabForm1">
                <table class="col-md-6 text-right" ng-show="detailList.length>0">
                    <tbody>
                        <tr>
                            <td></td>
                            <td>Amount</td>
                            <td>Tax</td>
                            <td>Total</td>
                        </tr>
                        <tr>
                            <td>Materials</td>
                            <td>{{detailList | sumByKey : 'TotalAmount'| setDecimal:2| number }}</td>
                            <td>{{detailList | sumByKey : 'TaxAmount'| setDecimal:2 | number}}</td>
                            <td>{{(detailList | sumByKey : 'TotalAmount'| setDecimal:2)+(detailList | sumByKey : 'TaxAmount' | setDecimal:2)|number}}</td>
                        </tr>
                        <tr style="border-bottom: 1px solid;">
                            <td>Service</td>
                            <td>{{chargesList | sumByKey : 'Amount'| setDecimal:2 | number}}</td>
                            <td>{{chargesList | sumByKey : 'TotalTaxAmount'| setDecimal:2 | number}}</td>
                            <td>{{(chargesList | sumByKey : 'Amount'| setDecimal:2)+(chargesList | sumByKey : 'TotalTaxAmount' | setDecimal:2)| number}}</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td>Net Amount</td>
                            <td>{{(detailList | sumByKey : 'TotalAmount'| setDecimal:2) + (detailList | sumByKey : 'TaxAmount'| setDecimal:2) + (chargesList | sumByKey : 'Amount'| setDecimal:2) + (chargesList | sumByKey : 'TotalTaxAmount'| setDecimal:2)| number}}</td>
                        </tr>
                    </tbody>
                </table>
                <div class="clearfix"></div>


                <div class="row">
                    <div class="table-responsive modal-table col-md-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>

                                    <th>MaterialGroup</th>
                                    <th>Material</th>
                                    <th>Article</th>
                                    <th>SKU1</th>
                                    <th>SKU2</th>
                                    <th>Return Qty</th>
                                    <th>Return Amount</th>
                                    <th>Return Tax</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in detailList">
                                    <td>{{x.MaterialMasterName}}</td>
                                    <td>{{x.ArticleName}}</td>
                                    <td>{{x.FirstCharacteristicText}}</td>
                                    <td>{{x.SecondCharacteristicText}}</td>
                                    <td class="text-right">{{x.ReturnQty}}{{x.TransactionUoM}}</td>
                                    <td class="text-right">{{x.ReturnAmount}}</td>
                                    <td class="text-right">{{x.TaxAmount}}</td>
                                </tr>
                                <tr>
                                    <td colspan="6" class="text-right"><strong>Total : </strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'InventoryAmount'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'ReturnQty'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'ReturnAmount'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"><strong>{{detailList | sumByKey : 'TaxAmount'| setDecimal:2| number }}</strong></td>
                                    <td class="text-right"></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <ul class="common-btn list-inline text-right">
                            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>

            </div>

        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div ng-form="tabForm2">

                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>Dr</th>
                                <th>Cr</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in newList| orderBy:'Dr'| groupBy: 'MaterialGroupMasterId'">
                                <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td class="text-right">{{x.Dr | number| setDecimal:4}}</td>
                                <td class="text-right">{{x.Cr | number| setDecimal:4}}</td>
                            </tr>
                            <tr>
                                <td colspan="3"></td>
                                <td class="text-right"><strong>{{newList | sumByKey : 'Dr' | number| setDecimal:4}}</strong></td>
                                <td class="text-right"><strong>{{newList | sumByKey : 'Cr' | number| setDecimal:4}}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        @*<li><button ng-click="serviceChargePopUpEdit()" ;" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>*@
                        @*<li><button ng-click="closeDetaiPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>*@
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>


</div>



<div class="aplos-grid-toggle">
    <div class="content-container-fluid" style="color:black;overflow:scroll">
        <div style="color:black;" id="GridMaster" ej-grid e-datasource="SalesdataList" e-recorddoubleclick="getUpdateData"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Sales Return" e-width="20"></div>
