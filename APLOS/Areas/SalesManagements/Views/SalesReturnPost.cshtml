                <div e-column e-field="Entity" e-headertext="Entity" e-width="40"></div>
                <div e-column e-field="MaterialStorage" e-headertext="Material Storage" e-width="20"></div>
                <div e-column e-field="Qty" e-headertext="Qty" e-width="30"></div>
            </div>
        </div>
    </div>

</div>

