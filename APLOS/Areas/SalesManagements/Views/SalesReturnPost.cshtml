<confirm-archive-generic modalid="confirmSavePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Save();"></confirm-archive-generic>

<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow();"></confirm-archive-generic>

<div class="modal fade site-modal in" id="receiveTaxPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Tax Information</div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <p>Taxable amount : <b>{{taxAbleAmnt| number| setDecimal:2}}</b>&nbsp;<b>{{Currency}}</b></p>
                    <p>HSNCode : <b>{{HSNCode}}</b></p>
                    @*<p ng-disabled="true">index : <b>{{index}}</b></p>*@

                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">If Percentage Applicable</label>
                        <div class="col-sm-6">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="TaxOption" disabled ng-model="productNew.TaxOption" value="Yes" ng-click="TaxOption('Yes');"> @*ng-hide="HSNCode !=null"*@
                                    <span class="cr"><i class="cr-icon"></i></span>Yes
                                </label>
                                <label>
                                    <input type="radio" name="TaxOption" disabled ng-model="productNew.TaxOption" value="No" ng-click="TaxOption('No');">@*ng-hide="HSNCode !=null"*@
                                    <span class="cr"><i class="cr-icon"></i></span>No
                                </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div>
                    <p class="col-md-11"></p>
                    <button type="button" class="btn btn-action" disabled ng-click="addTax();">Add Tax</button>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" border="1" id="AddTax">
                        <thead>
                            <tr>
                                <th ng-hide="true">id</th>
                                <th>Tax Category</th>
                                <th ng-hide="true">HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in materialtaxCategoryListSavedData| filter:{ InventorySalesDetailId: filterInventorySalesDetailId }">
                                <td ng-hide="true">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Id" readonly>
                                    </div>
                                </td>
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList" ng-change="onchangeFunction1(x.TaxCategoryId)"></select>
                                    </div>
                                </td>
                                <td ng-hide="true">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.HSNCode">
                                    </div>
                                </td>

                                <td>

                                    <div class="show-message">
                                        <input type="text" n-decimals="4" class="form-control text-right" disabled ng-model="x.Percentage" ng-keyup="calculateTaxAmount(x);">
                                    </div>
                                </td>

                                <td class="text-right">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TaxAmount" ng-keyup="checkRowValidation(x, $index)" ng-disabled="productNew.TaxOption==='Yes'">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="Del(x.Id,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right"><strong>{{materialtaxCategoryListSavedData| filter:{ InventorySalesDetailId: filterInventorySalesDetailId } | sumByKey : 'TaxAmount'| setDecimal:2| number:2 }}</strong></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        @*<li><button ng-click="closeReceiveTaxPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i>&nbsp;Update</button></li>*@
                        <li><button ng-click="closeReceiveTaxPopUpwindow();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>

            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message}} data-ng-click-right-button="serviceDelete();"></confirm-archive-generic>





