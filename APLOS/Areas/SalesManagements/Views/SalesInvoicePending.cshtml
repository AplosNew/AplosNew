<togglable name="Pending Sales Invoice"></togglable>
<div class="form-horizontal form-elements" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group">
            <label class="col-sm-3 control-label">Customer<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="PartyName" ng-model="salesVM.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUp();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearPartyData();" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Bill To<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select class="form-control" name="Bill To" ng-model="salesVM.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList" ng-change="billShippAddress(salesVM.PartyPlantId,'billTo')" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Payment Term<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <div class="select-style">
                    <select tabindex="10" required id="paymentTermId" class="form-control" name="Payment Term" ng-model="salesVM.PaymentTermId" ng-change="changePaymentTerm(salesVM.PaymentTermId);">
                        <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <label class="col-sm-3 control-label">Due Date BaseOn<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <input type="text" name="BaseOnDueDate" ng-model="salesVM.BaseOnDueDate" ng-change="getMatureDate(salesVM.BaseOnDueDate,salesVM.BaseNoOfDays)" datepicker class="form-control datepicker" tabindex="11" required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">No Of Days</label>
            <div class="col-sm-3 show-message">
                <input id="baseNoOfday" type="number" name="No Of Days" ng-model="salesVM.BaseNoOfDays" ng-change="getMatureDate(salesVM.BaseOnDueDate, salesVM.BaseNoOfDays)" class="form-control" tabindex="12" required>
            </div>
            <label class="col-sm-3 control-label">Mature Date</label>
            <div class="col-sm-3 show-message">
                <input type="text" name="Mature Date" ng-model="salesVM.MatureDate" class="form-control" readonly required>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="salesVM.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="salesVM.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyId" class="form-control" tabindex="5" name="Currency" ng-model="salesVM.CurrencyId" ng-change="GetCurrencyExchangeRateList();" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="salesVM.CompanyCurrencyRate" class="form-control text-right" tabindex="5" required autocomplete="off">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="entity" ng-model="salesVM.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="salesVM.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea rows="1" type="text" ng-maxlength="250" name="Narration" tabindex="8" class="form-control" ng-model="salesVM.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Material</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Charges</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div ng-form="tabForm1">
                <ul class="col-md-6 common-btn list-inline text-left">
                    <li><button ng-click="getMaterialMasterSearchData();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Material</button></li>
                </ul>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table" ng-show="salesMaterialList.length>0">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material Group</th>
                                <th>Material</th>
                                <th>Article</th>
                                <th>Base UoM</th>
                                <th>Trn. UoM</th>
                                <th>Rate</th>
                                <th>Qty</th>
                                <th>Amount</th>
                                <th>Tax</th>
                                <th>Net Amount</th>
                                <th class="col-sm-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in salesMaterialList">
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.MaterialMasterName}}</td>
                                <td>{{x.ArticleName}}</td>
                                <td>{{x.UOMName}}</td>
                                <td>
                                    <div class="select-style">
                                        <select name="Transaction UoM" class="form-control" ng-model="x.TransactionUoMId" ng-options="item.Value as item.Text for item in uoMList | filter: {'MaterialMasterId': x.MaterialMasterId }" ng-change="manualValidationAddRemove('div_uom', 'materialMaster','TransactionUoMId');">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </td>
                                <td id="td_Quantity_{{$index}}">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TransactionRate" ng-keyup="calculateAmount(x); checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td id="td_TransactionRate_{{$index}}">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TransactionQty" ng-keyup="calculateAmount(x); checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td id="td_TrnAmount_{{$index}}">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TransactionAmount" ng-keyup="checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td class="text-right">{{x.TaxAmount| number:2}}</td>
                                <td class="text-right">{{x.NetAmount | number:2}}</td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="getMaterialTaxList(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
                                        <li><button ng-click="removeMaterialRow($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="5" class="text-right"><strong>Total : </strong></td>
                                <td class="text-right"><strong>{{salesMaterialList | sumByKey : 'Quantity' }}</strong></td>
                                <td class="text-right"><strong>{{salesMaterialList | sumByKey : 'Rate' }}</strong></td>
                                <td class="text-right"><strong>{{salesMaterialList | sumByKey : 'Amount'| setDecimal:2 | number:2}}</strong></td>
                                <td class="text-right"><strong>{{salesMaterialList | sumByKey : 'TaxAmount'| setDecimal:2 | number:2}}</strong></td>
                                <td class="text-right"><strong>{{salesMaterialList | sumByKey : 'NetAmount'| setDecimal:2 | number:2}}</strong></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div ng-form="tabForm2">
                <ul class="common-btn list-inline text-left">
                    <li><button ng-click="addCharge();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Charges</button></li>
                </ul>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th>Amount</th>
                                <th>Tax Amount</th>
                                <th>Net Amount</th>
                                <th class="col-sm-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in chargesList">
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.ServiceMasterId" ng-options="item.Value as item.Text for item in serviceList" ng-change="getServiceTax($index)"></select>
                                    </div>
                                </td>
                                <td class="text-right">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Amount" ng-keyup="calculateServiceAmount(x); checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td class="text-right">{{x.TaxAmount| number:2}}</td>
                                <td class="text-right">{{x.NetAmount | number:2}}</td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="getServiceTaxList(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
                                        <li><button ng-click="removeServiceRow($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="1" class="text-right"><strong>Total : </strong></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'Amount'| setDecimal:2| number:2 }}</strong></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'TaxAmount'| setDecimal:2| number:2 }}</strong></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'NetAmount'| setDecimal:2| number:2 }}</strong></td>
                                <td class="text-right"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchInvoiceList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>InvoiceNo</th>
                    <th>@Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Bill To</th>
                    <th>Currency</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in invoiceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.InvoiceNo}}</td>
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>{{x.BillTo}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPosted || x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li><a class="btn btn-action" href="Accounts/Invoice/GetCustomerInvoiceVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Invoice/GetCustomerInvoiceVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterPopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterArticleSearchPopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_CharacteristicsValuePopUp.cshtml")
<div class="modal fade site-modal in" id="receiveTaxPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header"> Tax Information<button type="button" class="close" ng-click="closeReceiveTaxPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <p>HSN Code       : <b>{{HSNCode}}</b></p>
                    <p>Taxable amount : <b>{{taxAbleAmnt| number:2}}</b></p>
                    <div>
                        <p class="col-md-10"></p>
                        <button type="button" class="btn btn-action" ng-click="addTax();">Add Tax</button>
                    </div>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Tax Category</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in receiveTaxList">
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList"></select>
                                    </div>
                                </td>
                                <td>
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Percentage" ng-keyup="calculateTaxAmount(x);">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TotalAmount" ng-keyup="checkRowValidation(x, $index)">
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="closeReceiveTaxPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> OK</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="serviceChargePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Charges Entry<button type="button" class="close" ng-click="closeServiceChargePopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" id="div_svc">
                        <label class="col-sm-4 col-md-4 control-label">Service<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Service" ng-model="serviceModel.ServiceMasterId" class="col-sm-3 form-control"
                                        ng-options="item.Value as item.Text for item in serviceList" ng-change="changeService();">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    @*<div class="form-group" id="div_toSvcCRate">
                            <label class="col-sm-4 control-label">To Currency Rate<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" n-decimals="4" ng-model="serviceModel.ToCurrencyRate" disabled class="form-control text-right" placeholder="0.00" />
                            </div>
                        </div>*@
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" id="div_svcRate">
                        <label class="col-sm-4 control-label" data-placement="top" title="Cost and Manufacture">Amount<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-8" style="padding-left:0px;padding-right:0px;">
                                <input type="text" name="Amount" n-decimals="{{currencyPrecision}}" ng-model="serviceModel.TransactionAmount" class="form-control text-right" placeholder="0.00"
                                       ng-keyup="calculateSvcTaxCategory();manualValidationAddRemove('div_svcRate', 'serviceModel', 'TransactionAmount', 'Amount');" />
                            </div>
                            <div class="col-sm-4" style="padding-left:0px;padding-right:0px;">
                                <input type="text" ng-model="serviceModel.CurrencyName" class="form-control" disabled />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12 modal-table table-responsive" style="padding-top: 13px;" ng-show="taxCategoryList.length>0">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Tax Category</th>
                                <th>HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in taxCategoryList">
                                <td>{{x.UserName}}</td>
                                <td>{{x.HSNCode}}</td>
                                <td class="text-right">{{x.Percentage}}</td>
                                <td class="text-right">
                                    <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.TaxAmount" ng-keyup="sumSvcTaxAmount();" class="form-control text-right" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right">Total Tax (BC)</td>
                                <td class="text-right">{{serviceModel.TotalTaxAmount| setDecimal:currencyPrecision}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="serviceSave()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{materialMaster.Id.length>0?'Update':'Save'}}</button></li>
                        <li><button ng-click="closeServiceChargePopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="removerPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="detailDelete();"></confirm-archive-generic>
<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message}} data-ng-click-right-button="serviceDelete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmTaxCodeDelPopUp" title="Confirmation" message={{Taxmessage_confirmation}} data-ng-click-right-button="removeTaxCodeRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(invoiceId)"></confirm-archive-generic>