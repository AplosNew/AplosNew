<div class="common-btn" ng-show="DailyTargetList.length>0">
    <ul class="list-inline text-right">
        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
    </ul>
</div>

<div id="GridDailyTargetList" ej-grid e-datasource="DailyTargetList" e-templaterefresh="DailyTargetAllCheck"
     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-rowdatabound="rowDataBound">
    <div e-columns>
        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="50"></div>
        <div e-column e-field="Line" e-headertext="Work Center" e-width="100"></div>
        <div e-column e-field="WorkStation" e-headertext="Work Stations" e-width="100"></div>
        <div e-column e-field="ProductionOrderId" e-headertext="PO No" e-width="100"></div>
        <div e-column e-template="#templateSearchPR" e-headertext="" e-width="50"></div>
        <div e-column e-template="#LotNumber" e-headertext="Lot Number" e-width="100"></div>
        <div e-column e-field="Article" e-headertext="Article" e-width="100"></div>
        <div e-column e-template="#templateSMV" e-headertext="SPT" e-visible="false" e-width="100"></div>
        <div e-column e-template="#templatePlanHour" e-headertext="Plan Hours" e-width="100"></div>
        <div e-column e-template="#templateEfficiency" e-headertext="Efficiency" e-width="100"></div>
        <div e-column e-template="#templateTargetFD" e-headertext="Target Production FP" e-visible="false" e-width="100"></div>
        <div e-column e-template="#templateTargetProductionFP" e-headertext="Target Production FP" e-width="100"></div>
        <div e-column e-template="#ItemValue" e-headertext="Item Value" e-width="50"></div>
        <div e-column e-template="#Remarks" e-headertext="Remarks" e-width="120"></div>
        <div e-column e-template="#ResponsiblePerson" e-headertext="Responsible Person" e-width="200"></div>
        <div e-column e-template="#InCharge" e-headertext="InCharge" e-width="200"></div>
    </div>
</div>

<script type="text/template" id="templateSMV">
    <input type="text" class="form-control" e-enabled="false" ej-numerictextbox e-decimalplaces="2" e-minValue="0" e-enablertl="false" e-value="data.SMV" e-width="100%" />
</script>
<script type="text/template" id="templatePlanHour">
    <input type="text" class="form-control" ej-numerictextbox e-decimalplaces="2" e-change="$parent.CalculateTargetProductioin" e-minValue="0" e-enablertl="false" e-value="data.PlanHours"  e-width="100%" />
</script>
<script type="text/template" id="templateEfficiency">
    <input type="text" class="form-control" ej-numerictextbox e-decimalplaces="2" e-change="$parent.CalculateTargetProductioin" e-minValue="0" e-enablertl="false" e-value="data.Efficiency"  e-width="100%" />
</script>
<script type="text/template" id="templateTargetFD">
    <input type="text" class="form-control" e-enabled="false" ej-numerictextbox e-decimalplaces="2" e-minValue="0" e-enablertl="false" e-value="data.TargetFD" e-width="100%" />
</script>
<script type="text/template" id="templateTargetProductionFP">
    <input type="text" class="form-control" e-enabled="false" ej-numerictextbox e-decimalplaces="2" e-minValue="0" e-enablertl="false" e-value="data.TargetProductionFP" e-width="100%" />
</script>
<script type="text/x-jsrender" id="headerTemplate">
    <input type="checkbox" id="headchk" />
</script>
<script type="text/template" id="checkboxTemplate">
    <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
</script>
<script type="text/template" id="LotNumber">
    <div class="col-sm-10" style="padding:0px;">
        <input type="text" name="LotNumbers" ng-model="data.LotNumber" class="form-control" maxlength="200">
    </div>
</script>
<script type="text/template" id="templateSearchPR">
    <div class="common-btn">
        <ul class="list-inline text-right small">
            <li>
                <button ng-click="$parent.SearchPRPopup(data);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                    <i class="glyphicon glyphicon-search"></i>
                </button>
            </li>
        </ul>
    </div>
</script>

<script type="text/template" id="Remarks">
    <div class="col-sm-10" style="padding:0px;">
        <input type="text" name="Remarks" ng-model="data.Remarks" ng-click="" class="form-control" maxlength="200">
    </div>
</script>
<script type="text/template" id="ResponsiblePerson">
    <div class="col-sm-8" style="padding:0px;">
        <input type="text" name="Responsible Person" ng-model="data.ResponsiblePerson" ng-disabled="true" class="form-control" readonly>
    </div>
    <div class="col-sm-4 text-left" style="padding:0px;padding-left:2px">
        <button ng-click="$parent.selectGridResponsible(this);" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
    </div>
</script>
<script type="text/template" id="InCharge">
    <div class="col-sm-8" style="padding:0px;">
        <input type="text" name="InCharge" ng-model="data.InCharge" ng-disabled="true" class="form-control" readonly>
    </div>
    <div class="col-sm-4 text-left" style="padding:0px;padding-left:2px">
        <button ng-click="$parent.selectGridIncharge(this);" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
    </div>
</script>
<script type="text/template" id="ItemValue">
    <div class="form-group">
        <div class="col-sm-5 text-left" style="padding:0px;padding-left:2px">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="$parent.getItemValuePopup(this);" ng-disabled="data.Id==null" class="btn"><i class="glyphicon glyphicon-list"></i></button></li>
                </ul>
            </div>
        </div>
    </div>
</script>
<div class="modal fade site-modal in" id="ItemValuePopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Item Value List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Please Select an Item</p>
                        <div style="color:black;" id="GridItemValuePopup" ej-grid e-datasource="RMSTargetItemList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="" e-templaterefresh="refreshTemplateItemValue">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateItemValue" e-template="#checkboxTemplateItemValue" e-textalign="center" e-width="50"></div>
                                <div e-column e-field="ItemId" e-headertext="Id" e-visible="false" e-width="120"></div>
                                <div e-column e-field="Process" e-headertext="Process" e-width="120"></div>
                                <div e-column e-field="ItemName" e-headertext="ItemName" e-width="120"></div>
                                <div e-column e-template="#SNo" e-headertext="Serial No" e-width="50"></div>
                                <div e-column e-template="#Value" e-headertext="Item Value" e-width="50"></div>
                                <div e-column e-template="#Remarks" e-headertext="Remarks" e-width="50"></div>
                            </div>
                            <script type="text/template" id="checkboxTemplateItemValue">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsActive" />
                            </script>
                            <script type="text/x-jsrender" id="headerTemplateItemValue">
                                <input type="checkbox" id="IVheadchk" />
                            </script>
                            <script type="text/template" id="SNo">
                                <div class="col-sm-12" style="padding:0px;">
                                    <input type="number" name="SNo" ng-model="data.SNo" ng-click="" class="form-control">
                                </div>
                            </script>
                            <script type="text/template" id="Value">
                                <div class="col-sm-12" style="padding:0px;">
                                    <input type="number" name="ItemValue" ng-model="data.ItemValue" ng-click="" class="form-control">
                                </div>
                            </script>
                            <script type="text/template" id="Remarks">
                                <div class="col-sm-12" style="padding:0px;">
                                    <input type="text" name="Remarks" ng-model="data.Remarks" ng-click="" class="form-control">
                                </div>
                            </script>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-center">
                        <li>
                            <button ng-click="closeItemValuePopup();" class="btn"><i class=""></i> Close</button>
                            <button ng-click="SaveItemValue();" class="btn"><i class=""></i> Save</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
