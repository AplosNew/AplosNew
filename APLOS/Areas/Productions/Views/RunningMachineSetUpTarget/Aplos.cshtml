<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Running Machine Set up and Target</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Item Details</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(3)" href="" aria-controls="doc" role="tab" data-toggle="tab">Parameter Details</a></li>

    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Running Machine Set up and Target</h3>
        <div class="form-elements form-horizontal" ng-form name="DailyTargetForm" id="MainDivId">
            <div class="row">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-disabled="DailyTargetList.length>0" id="ddlEntity" ng-model="DailyProductionTargetNew.EntityId" ng-change="loadProcessList(DailyProductionTargetNew.EntityId)" name="Entity" ng-options="item.Id as item.UserName for item in entityList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" id="ProcessId" ng-change="GetShiftList();" ng-disabled="DailyTargetList.length>0" ng-model="DailyProductionTargetNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in processList" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Target Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" ng-disabled="DailyTargetList.length>0" ng-model="DailyProductionTargetNew.TargetDate" ng-change="DateValidation(DailyProductionTargetNew.TargetDate);" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" style="margin-bottom: 25px;">
                        <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" id="ShiftId" ng-disabled="DailyTargetList.length>0" ng-model="DailyProductionTargetNew.ProductionShiftId" name="ShiftId" ng-options="item.Value as item.Text for item in shiftList" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Plan Hours<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="number" name="Plan Hours" ng-model="DailyProductionTargetNew.HeaderPlanHour" class="form-control" required maxlength="100" autocomplete="off">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Efficiency<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="number" name="Plan Hours" ng-model="DailyProductionTargetNew.HeaderEfficiency" class="form-control" required maxlength="100" autocomplete="off">
                        </div>
                    </div>
                </div>
            </div>
            @*<div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 contro-label">Responsible Person<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="col-sm-10" style="padding:0px;">
                                    <input type="text" name="Responsible Person" ng-disabled="true" ng-model="DailyProductionTargetNew.HeaderResponsiblePerson" class="form-control" maxlength="100" required autocomplete="off">
                                </div>
                                <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                    <button ng-click="selectResponsiblePerson();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 contro-label">Incharge<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="col-sm-10" style="padding:0px;">
                                    <input type="text" name="Incharge" ng-disabled="true" ng-model="DailyProductionTargetNew.HeaderIncharge" class="form-control" maxlength="100" required autocomplete="off">
                                </div>
                                <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                    <button ng-click="selectIncharge();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>*@
            <div class="row">
                <div class="col-xs-12 col-sm-6 col-md-6">
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="col-sm-2" style="padding-right:0;">
                        <button ng-click="getDailytarget();" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button>
                    </div>
                </div>

            </div>
        </div>
        <div class="table-responsive aplos-grid-toggle">
            @Html.Partial("~/Areas/Productions/Views/RunningMachineSetUpTarget/DailyTargetGrid.cshtml")
        </div>
    </div>
    <div role="tabpanel" ng-form="ItemDetailsForm" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" id="ProcessId" ng-model="ItemNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in ProcessItemList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Item Name</label>
                <div class="col-sm-8">
                    <input type="text" name="ItemName" ng-model="ItemNew.ItemName" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="ItemSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                <li> <button ng-click="ItemClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
        <div id="GridItem" ej-grid e-datasource="ItemList" e-recorddoubleclick="GetItemDetails"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="50"></div>
                <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                <div e-column e-field="ItemName" e-headertext="Item Name" e-width="100"></div>
            </div>
        </div>
    </div>
    <div role="tabpanel" ng-form="ParameterDetailsForm" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" id="ProcessId" ng-model="ParameterNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in ProcessParameterList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Parameter Name</label>
                <div class="col-sm-8">
                    <input type="text" name="ItemName" ng-model="ParameterNew.ParameterName" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="ParameterSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                <li> <button ng-click="ParameterClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
        <div id="GridParameter" ej-grid e-datasource="ParameterList" e-recorddoubleclick="GetParameterDetails"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="50"></div>
                <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                <div e-column e-field="ParameterName" e-headertext="Parameter Name" e-width="100"></div>
            </div>
        </div>
    </div>
</div>
