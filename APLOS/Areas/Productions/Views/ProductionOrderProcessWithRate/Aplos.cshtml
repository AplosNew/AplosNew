                        <div class="col-xs-1 small text-nowrap">Qty</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Qty}}</span></div>
                        <div class="col-xs-1 small text-nowrap">LSD</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.LSD}}</span></div>
