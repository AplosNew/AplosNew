                        <div class="col-xs-1 small text-nowrap">Production Status</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.ProductionStatus}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Buyer Item</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.BuyerItem}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Own Item</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.OwnItem}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Product Category</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.ProductCategory}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Product</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Product}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Customer</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Customer}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Buyer</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Buyer}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Material Master</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.MaterialMaster}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Article</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Article}}</span></div>
                        <div class="col-xs-1 small text-nowrap">PONumber</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.PONumber}}</span></div>
                    </div>
                    <div class="form-elements form-horizontal table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>FG Size</th>
                                    <th ng-repeat="x in ColumnList[0].childList">
                                        {{x.SizeName}}
                                    </th>
                                    @*<th ng-click="addSkuMatrixColumn()"> Add sku Column </th>*@
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in ColumnList">
                                    <td>
                                        {{x.ColorName}}
                                    </td>
                                    <td ng-repeat="y in x.childList">
                                        <input type="text"  ng-model="y.Rate" n-decimals="4" class="form-control text-right">
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="SaveMatrix();" class="btn"><i class=""></i> Save</button>
                        </li>
                        <li> <button ng-click="ConfirmDelete();" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li>
                            <button ng-click="closeCharPopUp();" class="btn">Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion Second Characteristics -->
<!-- #region Third Characteristics -->
<div class="modal fade site-modal in" id="thirdPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Rate
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-6">
                    <label class="col-sm-6 control-label">Rate<sup>*</sup></label>
                    <div class="col-sm-6 ">
                        <input type="text" ng-model="Rate" n-decimals="4" class="form-control text-right">
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="SaveRate();" class="btn"><i class=""></i> Save</button>
                        </li>
                        <li> <button ng-click="ConfirmDeleteThird();" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li>
                            <button ng-click="closeCharPopUp();" class="btn">Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion Third Characteristics -->

<ej-dialog id="DeletePopUp" title="Confirm Delete?" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#secondPopup" e-close="onDialogClose" e-minwidth="240" e-minheight="165" e-open="enableBtn">
    <p>
        Are you sure to delete ?
    </p>
    <p class="text-right">
        <ul class="list-inline text-right">
            <li><button ng-click="Delete();ConfirmDeleteClose()" class="btn">Yes</button></li>
            <li><button ng-click="ConfirmDeleteClose();" class="btn"> No</button></li>
        </ul>
    </p>
</ej-dialog>
<ej-dialog id="DeletePopUpFirst" title="Confirm Delete?" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#firstPopup" e-close="onDialogClose" e-minwidth="240" e-minheight="165" e-open="enableBtn">
