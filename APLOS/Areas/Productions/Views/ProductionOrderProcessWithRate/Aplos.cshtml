@*<togglable name="{{FormTitle}}"></togglable>*@
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="form-horizontal" ng-form name="ModelNewForm">
    <div class="form-elements" id="ProductionOrderProcessWithRate">
        <div class="row">
            <div class="col-xs-12 col-sm-5 col-md-5">
                <div class="form-group" show-errors>
                    <label class="col-sm-5 control-label">Production Entity<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.ProductionEntityId" name="Entity" ng-options="item.Id as item.UserName for item in entityList" ng-change="loadProcessList()">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-5 col-md-5">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in processList" @*ng-change="loadSKU()"*@>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-2 col-md-2">
                <div class="form-group">
                    <div class="common-btn">
                        <button ng-click="getData();" class="btn"> <i class="glyphicon glyphicon-download"></i>Go</button>
                    </div>
                </div>
            </div>

            <div class="col-xs-12 " ng-show="ProductionOrderList.length>0">
                <div style="color:black;" id="Grid" ej-grid e-datasource="ProductionOrderList" e-allowscrolling="true" e-allowResizing="true"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" @*e-recorddoubleclick="SelectPOItem"*@
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-type="string" e-field="POId" e-headertext="ProductionOrderNo" e-width="80"></div>
                        <div e-column e-type="string" e-field="BuyerOrder" e-headertext="Buyer Ord" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnOrder" e-headertext="Own Ord#" e-width="80"></div>
                        <div e-column e-type="string" e-field="SONo" e-headertext="SONo" e-width="80"></div>
                        <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
                        <div e-column e-type="string" e-field="Qty" e-headertext="Qty" e-width="80"></div>
                        <div e-column e-type="date" e-formate="{0:dd-MMM-yyyy}" e-field="LSD" e-headertext="LSD" e-width="80"></div>
                        <div e-column e-type="date" e-formate="{0:dd-MMM-yyyy}" e-field="CommitmentDate" e-headertext="Commitment Date" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductionStatus" e-headertext="Production Status" e-width="80"></div>
                        <div e-column e-type="string" e-field="BuyerItem" e-headertext="Buyer Item#" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnItem" e-headertext="Own Item#" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Category" e-width="80"></div>
                        <div e-column e-type="string" e-field="Product" e-headertext="Product" e-width="80"></div>
                        <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                        <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                        <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material Master" e-width="80"></div>
                        <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="80"></div>
                        <div e-column e-type="string" e-field="PONumber" e-headertext="PO Number" e-width="80"></div>
                        <div e-column e-type="string" e-field="RequiredTimeUnit" e-headertext="Required Time Unit" e-width="80"></div>
                        <div e-column e-type="string" e-template="#SKU" e-headertext="SKU" e-width="100"></div>
                        <div e-column e-template="#ButtonSD" e-width="100"></div>
                    </div>
                </div>
                <script type="text/template" id="SKU">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="data.IsDisable" ng-model="data.SKUId" name="SKUId" ng-options="item.Value as item.Text for item in data.Charactaristics" required>
                            <option value=""></option>
                        </select>
                    </div>
                </script>
                <script type="text/template" id="ButtonSD">
                    <div class="common-btn">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn">
                            <i class="glyphicon glyphicon-list" ng-click="$parent.AddButton(data);"></i>
                        </button>
                    </div>
                </script>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>


<!-- #region First Characteristics -->
<div class="modal fade site-modal in" id="firstPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                SKU
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-element-ctrl form-horizontal">

                <div class="row" style="padding-bottom:10px;">
                    <div class="col-xs-1 small text-nowrap">Prod. Order No</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.POId}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Buyer Order</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.BuyerOrder}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Own Order</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.OwnOrder}}</span></div>
                    <div class="col-xs-1 small text-nowrap">SO No</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.SONo}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Description</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Description}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Qty</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Qty}}</span></div>
                    <div class="col-xs-1 small text-nowrap">LSD</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.LSD}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Commitment Date</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.CommitmentDate}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Production Status</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.ProductionStatus}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Buyer Item</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.BuyerItem}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Own Item</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.OwnItem}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Product Category</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.ProductCategory}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Product</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Product}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Customer</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Customer}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Buyer</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Buyer}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Material Master</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.MaterialMaster}}</span></div>
                    <div class="col-xs-1 small text-nowrap">Article</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.Article}}</span></div>
                    <div class="col-xs-1 small text-nowrap">PONumber</div><div class="col-xs-2 small text-nowrap"><span>: {{SelectedProductionOrder.PONumber}}</span></div>
                </div>


                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    {{FGSizeOrColor}}
                                </th>

                                <th>Rate</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in SKUList">

                                <td>
                                    {{x.CharValue}}
                                </td>
                                <td>
                                    <input type="text" name="ValueFreeText" ng-model="x.Rate" n-decimals="4" maxlength="15" class="form-control" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="charSave(1);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button>
                        </li>
                        <li>
                            <button ng-click="ConfirmDeleteFirst();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button>
                        </li>
                        <li>
                            <button ng-click="closeCharPopUp();" class="btn"><i class="glyphicon glyphicon-remove"></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>


        </div>
    </div>
</div>
<!-- #endregion First Characteristics -->
<!-- #region Second Characteristics -->
