<h3 class="site-heading">{{title}}</h3>

<div class="form-horizontal" ng-form="buyerStyleForm">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select name="Company" ng-model="buyerStyleNew.CompanyId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in companyList" ng-change="getPlantList();" tabindex="1" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select name="Plant" ng-model="buyerStyleNew.PlantId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in plantList" ng-change="getDataList();" tabindex="2" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>

<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sequence</th>
                    <th>Code</th>
                    <th>Short Name</th>
                    <th>Standard Name</th>
                    <th>User Name</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in buyerStyles |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.Sequence}}</td>
                    <td>{{x.Code}}</td>
                    <td>{{x.ShortName}}</td>
                    <td>{{x.StandardName}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.Active? 'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="getData(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>
<confirm-modal></confirm-modal>