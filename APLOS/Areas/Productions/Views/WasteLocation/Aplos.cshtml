<h3 class="site-heading">{{title}}</h3>

<div class="form-horizontal" ng-form="buyerStyleForm">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select name="Company" ng-model="buyerStyleNew.CompanyId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in companyList" ng-change="getPlantList();" tabindex="1" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select name="Plant" ng-model="buyerStyleNew.PlantId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in plantList" ng-change="getDataList();" tabindex="2" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>

<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    

    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="row">
            <div id="wasteLocInfoGrid" ej-grid e-datasource="buyerStyles"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" style="margin-top:10px;">
                <div e-columns>
                    <div e-column e-headertext="" @*e-headertemplateid="#headerTemplate" *@ e-template="#checkboxTemplates" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="Sequence" e-headertext="Sequence" e-width="60"></div>
                    <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                    <div e-column e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                    <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
                    <div e-column e-field="UserName" e-headertext="User Name" e-width="80"></div>
                    <div e-column e-field="Active" e-headertext="Active" e-width="80"></div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/template" id="checkboxTemplates">
        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsWasteLocation" />
    </script>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
        </ul>
    </div>
</div>
<confirm-modal></confirm-modal>