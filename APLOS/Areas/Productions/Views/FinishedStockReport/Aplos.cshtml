<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>

<div class="row">
    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="row">
            <div class="col-xs-5 col-sm-6 col-md-6" style="margin-top:20px;">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="From Date" ng-model="FromDate" datepicker class="form-control" tabindex="4">

                    </div>
                </div>
            </div>
            <div class="col-xs-5 col-sm-6 col-md-6" style="margin-top:20px;">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="To Date" ng-model="ToDate" datepicker class="form-control" tabindex="4">

                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="col-xs-6 col-sm-6 col-md-6" style="margin-top:20px;">
        <div class="col-lg-3">
            <div class="form-group"><label>Location : </label></div>
        </div>
        <div class="col-lg-3">
            <div class="row"><select id="listLoc" ej-dropdownlist e-datasource="LocList" e-text="All" e-value="All" e-change="LocChange" e-placeholder="Location"></select></div>
        </div>
    </div>

    <div class="common-btn" style="margin-top:10px;">
        <ul class="list-inline text-right">
            <li> <button ng-click="getFinishedStocksReport();" class="btn"><i class="glyphicon glyphicon-download"></i> Finished Goods Stock Report </button></li>
            <li> <button ng-click="getFinishedIssueReport();" class="btn"><i class="glyphicon glyphicon-download"></i> Finished Goods Issue Report </button></li>

        </ul>
    </div>
</div>

