<togglable name="Movement Material Master"></togglable>
<div class="form-elements form-horizontal" ng-form name="GeneralForm">
    <input type="hidden" ng-model="selectedValues.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="Company" class="form-control" ng-model="selectedValues.CompanyId" name="Company" ng-change="getPlant();" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in companyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label" title="Entity">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="selectedValues.EntityId" required id="entityId" name="Entity" ng-change="GetStorageLoc();" tabindex="3">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Location<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Location" ng-model="selectedValues.ToLocation" class="form-control" maxlength="200" required tabindex="5">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Storage Location</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="selectedValues.FromStorageLocId" name="StorageLoc"
                            ng-options="item.Value as item.Text for item in StorageLocList" tabindex="7">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Add Prefix</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Prefix" ng-model="selectedValues.Prefix" class="form-control" maxlength="200" tabindex="4">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Start Ref No.</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="StartRefNo" ng-model="selectedValues.StartRefNo" only-numbers class="form-control" maxlength="200" tabindex="4">
            </div>
        </div>
        
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="selectedValues.PlantId" name="Plant" ng-change="getEntityWithChange();" required tabindex="2">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Location<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Location" ng-model="selectedValues.FromLocation" class="form-control" maxlength="200" required tabindex="4">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Movement Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="selectedValues.PurposeId" name="Category"
                            ng-options="item.Value as item.Text for item in CatergoryList" required tabindex="6">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Storage Location</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="selectedValues.ToStorageLocId" name="StorageLoc"
                            ng-options="item.Value as item.Text for item in StorageLocList" tabindex="8">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="selectedValues.ItemId" name="Item"
                            ng-options="item.Value as item.Text for item in ItemList" required tabindex="10">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Inventory check</label>
            <div class="col-sm-8  show-message">
                <div class="checkbox-site">
                    <label>
                        <input id="Check_Invn" type="checkbox" class="css-checkbox" ng-model="selectedValues.Inventorycheck" tabindex="9">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>

    </div>

    <div class="common-btn">
        <ul class="common-btn list-inline text-right">
            @*<li><button ng-click="selectemployee()" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Select Employee</button></li>*@
            <li><button ng-click="savedata()" class="btn" tabindex="10"><i class="glyphicon glyphicon-save"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear()" class="btn" tabindex="10"><i class="glyphicon glyphicon-save"></i> Clear</button></li>

        </ul>
    </div>


</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="aplos-grid-toggle">
    <div class="content-container-fluid">
        <div id="Grid" ng-init="chkinit()" ej-grid e-datasource="editdata" e-recorddoubleclick="editdoubleclick"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                <div e-column e-field="Company" e-type="string" e-headertext="Company" e-visible="false"></div>
                <div e-column e-field="Plant" e-type="string" e-headertext="Plant" e-visible="false"></div>

                <div e-column e-field="FromLocation" e-type="string" e-headertext="From Location" e-width="80"></div>
                <div e-column e-field="ToLocation" e-type="string" e-headertext="To Location" e-width="80"></div>
                <div e-column e-field="MovementCategory" e-type="string" e-headertext="Movement Category" e-width="80"></div>
                <div e-column e-field="Entity" e-type="string" e-headertext="Entity" e-width="80"></div>
                <div e-column e-field="Item" e-type="string" e-headertext="Item" e-width="80"></div>
                <div e-column e-field="FromStorageLoc" e-type="string" e-headertext="From Storage Location" e-width="80"></div>
                <div e-column e-field="ToStorageLoc" e-type="string" e-headertext="To Storage Location" e-width="80"></div>
            </div>
        </div>
    </div>
    <div class="common-btn" style="margin-top:20px;">
        <ul class="list-inline text-right">
            <li> <button ng-click="PrintReport();" class="btn">Export To Excel</button></li>
        </ul>
    </div>
</div>


<confirm-modal></confirm-modal>

<script type="text/x-jsrender" id="checkboxTemplate">
    <input type="checkbox" ng-model="{{:Id}}" class="rowCheckbox" value="{{:Id}}" />
</script>
<script type="text/x-jsrender" id="headerTemplate">
    <input type="checkbox" id="headchk" />
</script>

<style type="text/css">

    .e-grid .e-templatecell {
        padding: 0px 4px 0px 0px;
    }

    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }
</style>