<togglable name="Movement Material Master"></togglable>
<div class="form-elements form-horizontal" ng-form name="GeneralForm">
    <input type="hidden" ng-model="selectedValues.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="Company" class="form-control" ng-model="selectedValues.CompanyId" name="Company" ng-change="getPlant();" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in companyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label" title="Entity">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="selectedValues.EntityId" required id="entityId" name="Entity" ng-change="GetStorageLoc();" tabindex="3">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Movement Purpose<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="selectedValues.PurposeId" ng-change="getLocation();" name="Movement Purpose"
                            ng-options="item.Value as item.Text for item in CatergoryList" required tabindex="6">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Location<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Location" ng-model="selectedValues.FromLocation" class="form-control" maxlength="200" required tabindex="4">
            </div>
        </div>


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Storage Location</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="selectedValues.FromStorageLocId" name="StorageLoc"
                            ng-options="item.Value as item.Text for item in StorageLocList" tabindex="7">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Add Prefix</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Prefix" ng-model="selectedValues.Prefix" class="form-control" maxlength="200" tabindex="4">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Start Ref No.</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="StartRefNo" ng-model="selectedValues.StartRefNo" only-numbers class="form-control" maxlength="200" tabindex="4">
            </div>
        </div>

    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label"></label>
            <div class="col-sm-8">
            </div>
        </div>
        <br />
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="selectedValues.PlantId" name="Plant" ng-change="getEntityWithChange();" required tabindex="2">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Process</label>
            <div class="col-sm-8">
                <input type="text" name="Process" disabled ng-model="selectedValues.Process" class="form-control" maxlength="200" required tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Location<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Location" ng-model="selectedValues.ToLocation" class="form-control" maxlength="200" required tabindex="5">
            </div>
        </div>


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Storage Location</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="selectedValues.ToStorageLocId" name="StorageLoc"
                            ng-options="item.Value as item.Text for item in StorageLocList" tabindex="8">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="selectedValues.ItemId" name="Item"
                            ng-options="item.Value as item.Text for item in ItemList" required tabindex="10">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Inventory check</label>
            <div class="col-sm-8  show-message">
                <div class="checkbox-site">
                    <label>
                        <input id="Check_Invn" type="checkbox" class="css-checkbox" ng-model="selectedValues.Inventorycheck" tabindex="9">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>

    </div>

    <div class="common-btn">
        <ul class="common-btn list-inline text-right">
            @*<li><button ng-click="selectemployee()" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Select Employee</button></li>*@
            <li><button ng-click="savedata()" class="btn" tabindex="10"><i class="glyphicon glyphicon-save"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear()" class="btn" tabindex="10"><i class="glyphicon glyphicon-save"></i> Clear</button></li>

        </ul>
    </div>

    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Employee</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="getEmpPopUpData();" ng-disabled="selectedValues.Id==null" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                            </ul>
                        </div>
                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="GridRPEmpPopUp" ej-grid e-datasource="ResponsiblePersonList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-type="string" e-template="#Remove" e-headertext="Remove" e-width="40"></div>
                                    <div e-column e-field="EmpSystemId" e-headertext="EmpSystemId" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                    <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                                    <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                                    <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                    <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                                </div>
                                <script type="text/template" id="Remove">
                                    <div class="col-sm-2 text-left" style="padding: 0px; padding-left: 2px; width: 20px;">
                                        <button ng-click="$parent.removeEmp(this);" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-trash"></i></button>
                                    </div>
                                </script>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="aplos-grid-toggle">
    <div class="content-container-fluid">
        <div id="Grid" ng-init="chkinit()" ej-grid e-datasource="editdata" e-recorddoubleclick="editdoubleclick"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                <div e-column e-field="Company" e-type="string" e-headertext="Company" e-visible="false"></div>
                <div e-column e-field="Plant" e-type="string" e-headertext="Plant" e-visible="false"></div>

                <div e-column e-field="FromLocation" e-type="string" e-headertext="From Location" e-width="80"></div>
                <div e-column e-field="ToLocation" e-type="string" e-headertext="To Location" e-width="80"></div>
                <div e-column e-field="MovementCategory" e-type="string" e-headertext="Movement Purpose" e-width="80"></div>
                <div e-column e-field="Entity" e-type="string" e-headertext="Entity" e-width="80"></div>
                <div e-column e-field="Item" e-type="string" e-headertext="Item" e-width="80"></div>
                <div e-column e-field="FromStorageLoc" e-type="string" e-headertext="From Storage Location" e-width="80"></div>
                <div e-column e-field="ToStorageLoc" e-type="string" e-headertext="To Storage Location" e-width="80"></div>
            </div>
        </div>
    </div>
    <div class="common-btn" style="margin-top:20px;">
        <ul class="list-inline text-right">
            <li> <button ng-click="PrintReport();" class="btn">Export To Excel</button></li>
        </ul>
    </div>
</div>


<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Employee Information<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridRPEMP" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-templaterefresh="refreshTemplaterp" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="SystemId" e-headertext="EmpSystemId" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>
                    </div>
                    <div class="common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="closePopUp();" class="btn">Apply</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<confirm-archive-generic modalid="confirmRunDelPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteEmployee();"></confirm-archive-generic>
<script type="text/x-jsrender" id="checkboxTemplate">
    <input type="checkbox" ng-model="{{:Id}}" class="rowCheckbox" value="{{:Id}}" />
</script>
<script type="text/x-jsrender" id="headerTemplate">
    <input type="checkbox" id="headchk" />
</script>

<style type="text/css">

    .e-grid .e-templatecell {
        padding: 0px 4px 0px 0px;
    }

    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }
</style>