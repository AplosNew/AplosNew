<style>
    .offDayBorder {
        background-color: gainsboro;
        text-align: center;
        font-weight: bold;
        min-width: 50px;
        cursor: none;
    }

    .production {
        background-color: lightgreen;
        text-align: center;
        font-weight: bold;
        min-width: 50px;
        cursor: pointer;
    }
    .stripe {
        color: #e03218;
        background-size: 12px 10px !important;
        background-image: linear-gradient(-45deg, transparent 46%, #e03218 49%, #e03218 51%, transparent 55%);
    }
</style>
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Main Process Planning</h3>
<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href aria-controls="planning" role="tab" data-toggle="tab">Planning</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href aria-controls="freeze" role="tab" data-toggle="tab">Freeze</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="form-elements form-horizontal" ng-form name="mainProcessPlaningNewForm">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Plant" class="form-control" ng-model="plantId" tabindex="1"
                                        ng-options="item.Value as item.Text for item in plantList" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Process" required class="form-control" tabindex="2" ng-model="processId"
                                        ng-options="item.Value as item.Text for item in processList" ng-disabled="plantId==null">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">To Date</label>
                        <div class="col-sm-8">
                            <input type="text" name="ToDate" ng-model="toDate" datepicker class="form-control" tabindex="2"
                                   ng-disabled="processId==null" ng-change="EnableOrDisableProcessBtn()">
                        </div>
                    </div>
                </div>
                <div class="">
                    <button ng-click="View();" class="btn single-small-btn" ng-disabled="processBtn"><i class="glyphicon glyphicon-eye-open"></i> View</button>
                    <button ng-click="Process();" class="btn single-small-btn" ng-disabled="processBtn"><i class="glyphicon glyphicon-hourglass"></i> Process</button>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="table-responsive modal-table" ng-show="newDataList.length>0">
                <table cellpadding="0" cellspacing="0" style="border: 1px solid #659EC7;">
                    <tr style="border-bottom: 1px solid #659EC7">
                        <td rowspan="2" style="border-right: 1px solid #659EC7;">Line #</td>
                        <td colspan="{{my.DateArr.length}}" ng-repeat="my in monthYearList" style="text-align: center;">{{my.MonthYear}}</td>
                    </tr>
                    <tr>
                        <td ng-repeat="d in dayList" style="text-align: center;">{{d.Day}} </td>
                    </tr>
                    <tr style="height: 30px;  color:darkred ;border: solid 1px #659EC7;" ng-repeat="line in newDataList">
                        <td style="border: 1px solid #659EC7;">{{line.Line}}</td>
                        <td width="80" style="padding:0;" align="center" ng-repeat="c in colList">
                            <table cellpadding="0" cellspacing="0" style="border:none;">
                                <tr ng-class="line.bodyData[c].OffDay?'offDayBorder':'production'" ng-click="onClickChangeFC(line.bodyData[c].ProductionBatchMasterId)"
                                    ng-style="{'background-color':line.bodyData[c].Color}" class="tooltip-here"
                                    id="{{line.bodyData[c].Id}}"
                                    title="P.Ref : {{line.bodyData[c].ProductionBatchMasterId}}&#13;OurStyle : {{line.bodyData[c].OurStyle}}&#13;Line : {{line.Line}}&#13;ActualAllocatedLine : {{line.bodyData[c].ActualAllocatedLine}}&#13;MinAllocatedLine : {{line.bodyData[c].MinAllocatedLine}}&#13;ProductionPriority : {{line.bodyData[c].ProductionPriority}}&#13;FileNo : {{line.bodyData[c].FileNo}}&#13;Lsd : {{line.bodyData[c].Lsd|dateFiltering}}&#13;CommitmentDate : {{line.bodyData[c].CommitmentDate|dateFiltering}}&#13;MinWorkingDays : {{line.bodyData[c].MinWorkingDays}}&#13;StandardDailyOutPut : {{line.bodyData[c].StandardDailyOutPut}}&#13;StandardTime : {{line.bodyData[c].StandardTime}} hrs&#13;TotalQty : {{line.bodyData[c].TotalQty}}">
                                    <td align="center" width="60" style="padding:0;"
                                        ng-class="{stripe:line.bodyData[c].QtyVariance==true}">
                                        <div>
                                            <span style="width: 100%; float:left; display: inline;margin-right:20px;-webkit-font-smoothing: antialiased;"
                                                  ng-style="{'color':line.bodyData[c].textColor,'font-weight':line.bodyData[c].textWeight}">
                                                {{line.bodyData[c].OffDay?line.bodyData[c].OffDayType:line.bodyData[c].DailyOutPut}}
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>
                </table>
            </div>
            <p ng-show="validationMsg!=null" ng-bind-html="validationMsg | safecontent"></p>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal form-elements">
                    <div class="">
                        <label class="col-sm-2 control-label" style="width: auto;">From Date</label>
                        <div class="col-sm-3">
                            <input type="text" ng-change="DateDisable();" ng-model="freezeFromDate" datepicker class="form-control" tabindex="1">
                        </div>
                    </div>
                    <div class="">
                        <label class="col-sm-2 control-label" style="width: auto;">To Date</label>
                        <div class="col-sm-3">
                            <input type="text" id="freezeToDate" ng-disabled="freezeFromDate==''" ng-model="freezeToDate" datepicker class="form-control" tabindex="2">
                        </div>
                    </div>
                    <button ng-click="freezePopUp()" ng-disabled="freezeToDate==''" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i> Production Reference</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="freezePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Production Reference For Freezing <button type="button" class="close" data-dismiss="modal">&times;</button> </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Plant</th>
                                <th>Entity</th>
                                <th>File No</th>
                                <th>Order Ref. No</th>
                                <th>Order Description</th>
                                <th>Buyer</th>
                                <th>Qty</th>
                                <th>First InputDate</th>
                                <th>Lsd</th>
                                <th>Target Lsd</th>
                                <th>Commitment Date</th>
                                <th>Target Commitment Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in freezeDataList|itemsPerPage:freezeParameters.pageSize" total-items="freezeParameters.total_count"
                                pagination-id="metaData.name + 'freezeDataList'">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectPrfId($event,x.Id)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Plant}}</td>
                                <td>{{x.Entity}}</td>
                                <td>{{x.FileNo}}</td>
                                <td>{{x.OrderRefNo}}</td>
                                <td>{{x.OrderDescription}}</td>
                                <td>{{x.Buyer}}</td>
                                <td>{{x.Qty}}</td>
                                <td>{{x.FirstInputDate}}</td>
                                <td>{{x.Lsd|dateFiltering}}</td>
                                <td>{{x.TargetLsd|dateFiltering}}</td>
                                <td>{{x.CommitmentDate|dateFiltering}}</td>
                                <td>{{x.TargetCommitmentDate|dateFiltering}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'freezeDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getfreezeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveForFreezing()" class="btn">Save</button></li>
                        <li> <button ng-click="CloseFreezePopUp()" class="btn">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
