<togglable name="Button Recipe Configuration"></togglable>
<div class="form-horizontal" ng-form="modelForm">
	<div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
		<div class="form-group" show-errors>
			<label class="col-sm-4 control-label">Company<sup>*</sup></label>
			<div class="col-sm-8 show-message">
				<div class="select-style">
					<select class="form-control" ng-model="modelNew.CompanyId" name="Company" ng-options="item.Value as item.Text for item in companyList" ng-change="getCboPlantList();" tabindex="1" required>
						<option value=""></option>
					</select>
				</div>
			</div>
		</div>
	</div>
	<div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
		<div class="form-group" show-errors>
			<label class="col-sm-4 control-label">Plant<sup>*</sup></label>
			<div class="col-sm-8 show-message">
				<div class="select-style">
					<select class="form-control" ng-model="modelNew.PlantId" name="Plant" ng-options="item.Value as item.Text for item in plantList" ng-change="getDataList();" tabindex="2" required>
						<option value=""></option>
					</select>
				</div>
			</div>
		</div>
	</div>
	<div class="clearfix"></div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="modelNew.ProcessId" name="Process" ng-options="item.Value as item.Text for item in processList" ng-change="getProcessList();" tabindex="3" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Output Depend On</legend>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label"></label>
                    <div class="col-sm-8">
                        <div class="radio">
                            <label>
                                <input type="radio" name="source2" ng-model="modelNew.OutputLevel" ng-click="clearLevel('OutputDependAttributeId');" value="CH">
                                <span class="cr"><i class="cr-icon"></i></span>Characteristic
                            </label>
                            <label>
                                <input type="radio" name="source2" ng-model="modelNew.OutputLevel" ng-click="clearLevel('OutputDependCharacteristicsId');" value="AR">
                                <span class="cr"><i class="cr-icon"></i></span>Attribute
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Subprocess<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.OutputDependSubprocessId" name="Subprocess" ng-options="item.Value as item.Text for item in subProcessList" tabindex="5" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors ng-show="modelNew.OutputLevel=='CH'">
                    <label class="col-sm-4 control-label">Characteristics<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.OutputDependCharacteristicsId" name="Characteristic" ng-options="item.Value as item.Text for item in characteristicList" @*ng-required="modelNew.OutputLevel=='CH'"*@ tabindex="4">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors ng-show="modelNew.OutputLevel=='AR'">
                    <label class="col-sm-4 control-label">Attribute<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.OutputDependAttributeId" name="Attribute" ng-options="item.Value as item.Text for item in attributeList" @*ng-required="modelNew.OutputLevel=='AR'"*@ tabindex="4">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">UoM<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.OutPutUoMId" name="OutPutUoM" ng-options="item.Value as item.Text for item in uomList" tabindex="6" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Raw Material Consumption Depend On</legend>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label"></label>
                    <div class="col-sm-8">
                        <div class="radio">
                            <label>
                                <input type="radio" name="source1" ng-model="modelNew.ConsumptionLevel" ng-click="clearLevel('RawMaterialConsumptionAattributeId');" value="CH">
                                <span class="cr"><i class="cr-icon"></i></span>Characteristic
                            </label>
                            <label>
                                <input type="radio" name="source1" ng-model="modelNew.ConsumptionLevel" ng-click="clearLevel('RawMaterialConsumptionCharacteristicsId');" value="AR">
                                <span class="cr"><i class="cr-icon"></i></span>Attribute
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">UoM<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.RmConsumptionUoMId" name="RmConsumptionUoM" ng-options="item.Value as item.Text for item in uomList" tabindex="8" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors ng-show="modelNew.ConsumptionLevel=='CH'">
                    <label class="col-sm-4 control-label">Characteristics<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.RawMaterialConsumptionCharacteristicsId" name="Characteristic" ng-options="item.Value as item.Text for item in characteristicList" ng-required="modelNew.ConsumptionLevel=='CH'" tabindex="7">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors ng-show="modelNew.ConsumptionLevel=='AR'">
                    <label class="col-sm-4 control-label">Attribute<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.RawMaterialConsumptionAattributeId" name="R.M Consumption Depend Attr" ng-options="item.Value as item.Text for item in attributeList" ng-required="modelNew.ConsumptionLevel=='AR'" tabindex="7">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Recipe Depend On</legend>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label"></label>
                    <div class="col-sm-8">
                        <div class="radio">
                            <label>
                                <input type="radio" name="source" ng-model="modelNew.RecipeLevel" ng-click="clearLevel('RecipeDependAttributeId');" value="CH">
                                <span class="cr"><i class="cr-icon"></i></span>Characteristic
                            </label>
                            <label>
                                <input type="radio" name="source" ng-model="modelNew.RecipeLevel" ng-click="clearLevel('RecipeDependCharacteristicsId');" value="AR">
                                <span class="cr"><i class="cr-icon"></i></span>Attribute
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4  control-label">Subprocess<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.RecipeDependonSubprocessId" name="Recipe Depend on Subprocess" ng-options="item.Value as item.Text for item in subProcessList" tabindex="10" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors ng-show="modelNew.RecipeLevel=='CH'">
                    <label class="col-sm-4 control-label">Characteristics<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.RecipeDependCharacteristicsId" name="Characteristic" ng-options="item.Value as item.Text for item in characteristicList" @*ng-required="modelNew.RecipeLevel=='CH'"*@ tabindex="9">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors ng-show="modelNew.RecipeLevel=='AR'">
                    <label class="col-sm-4 control-label">Attribute<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.RecipeDependAttributeId" name="Attribute" ng-options="item.Value as item.Text for item in attributeList" @*ng-required="modelNew.RecipeLevel=='AR'"*@ tabindex="9">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Specification1</legend>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label"></label>
                    <div class="col-sm-8">
                        <div class="radio">
                            <label>
                                <input type="radio" name="source3" ng-model="modelNew.SpecificationLevel1" ng-click="clearLevel('SpecificationAttributeId1');" value="CH">
                                <span class="cr"><i class="cr-icon"></i></span>Characteristic
                            </label>
                            <label>
                                <input type="radio" name="source3" ng-model="modelNew.SpecificationLevel1" ng-click="clearLevel('SpecificationCharacteristicId1');" value="AR">
                                <span class="cr"><i class="cr-icon"></i></span>Attribute
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors ng-show="modelNew.SpecificationLevel1=='CH'">
                    <label class="col-sm-4 control-label">Characteristics</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.SpecificationCharacteristicId1" name="Characteristic" ng-options="item.Value as item.Text for item in characteristicList"  tabindex="11">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors ng-show="modelNew.SpecificationLevel1=='AR'">
                    <label class="col-sm-4 control-label">Attribute</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.SpecificationAttributeId1" name="Attribute" ng-options="item.Value as item.Text for item in attributeList"  tabindex="11">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Specification2</legend>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label"></label>
                    <div class="col-sm-8">
                        <div class="radio">
                            <label>
                                <input type="radio" name="source4" ng-model="modelNew.SpecificationLevel2" ng-click="clearLevel('SpecificationAttributeId2');" value="CH">
                                <span class="cr"><i class="cr-icon"></i></span>Characteristic
                            </label>
                            <label>
                                <input type="radio" name="source4" ng-model="modelNew.SpecificationLevel2" ng-click="clearLevel('SpecificationAttributeId2');" value="AR">
                                <span class="cr"><i class="cr-icon"></i></span>Attribute
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors ng-show="modelNew.SpecificationLevel2=='CH'">
                    <label class="col-sm-4 control-label">Characteristics</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.SpecificationCharacteristicId2" name="Characteristic" ng-options="item.Value as item.Text for item in characteristicList"  tabindex="12">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors ng-show="modelNew.SpecificationLevel2=='AR'">
                    <label class="col-sm-4 control-label">Attribute</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.SpecificationAttributeId2" name="Attribute" ng-options="item.Value as item.Text for item in attributeList"  tabindex="12">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>

        <div class="clearfix"></div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
	<div class="col-xs-12 col-sm-12 col-sm-12">
		<div class="search-form">
			<div class="row">
				<div class="col-xs-12 col-sm-3 col-md-3">
					<div class="select-style">
						<select ng-model="$root.parameters.searchBy">
							<option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
						</select>
					</div>
				</div>
				<div class="col-xs-12 col-sm-7 col-md-7">
					<input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getDataList()">
				</div>
				<div class="col-xs-12 col-sm-2 col-md-2">
					<button type="button" ng-click="getDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Process</th>
				<th>O/P Depend Attr</th>
				<th>O/P Depend Char</th>
				<th>O/P Depend Subprocess</th>
				<th>O/P UoM</th>
				<th>RM Consumption Attr</th>
				<th>RM Consumption Char</th>
				<th>Consumption UoM</th>
				<th>Recipe Depend Attr</th>
				<th>Recipe Depend Char</th>
				<th>Recipe Dependon Subprocess</th>
			</tr>
		</thead>
		<tbody>
			<tr dir-paginate="x in modelList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x,$index);">
				<td>{{x.ProcessName}}</td>
				<td>{{x.OutputDependAttribute}}</td>
				<td>{{x.OutputDependCharacteristics}}</td>
				<td>{{x.OutputDependSubprocess}}</td>
				<td>{{x.OutPutUoM}}</td>
				<td>{{x.RawMaterialConsumptionAattribute}}</td>
				<td>{{x.RawMaterialConsumptionCharacteristics}}</td>
				<td>{{x.RmConsumptionUoM}}</td>
				<td>{{x.RecipeDependAttribute}}</td>
				<td>{{x.RecipeDependCharacteristics}}</td>
				<td>{{x.RecipeDependonSubprocess}}</td>
			</tr>
		</tbody>
	</table>
	<dir-pagination-controls max-size="10"
							 direction-links="true"
							 boundary-links="true"
							 on-page-change="getDataList(newPageNumber)">
	</dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>