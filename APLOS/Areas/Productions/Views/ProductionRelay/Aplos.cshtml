<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Production Relay</h3>
<div class="form-elements form-horizontal" ng-form name="ProductionRelayForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="ProductionRelayList.length>0" id="ddlEntity" ng-model="ProductionRelayNew.EntityId" ng-change="loadProcessList(ProductionRelayNew.EntityId)" name="Entity" ng-options="item.Id as item.UserName for item in entityList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="ProductionRelayList.length>0" ng-model="ProductionRelayNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in processList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="getProductionRelay();" ng-hide="ProductionRelayList.length>0" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>



<div ng-form id="productionRelay" name="productionRelayNewForm" class="form-elements  form-horizontal">

    <div class="tab-design" id="tab_show">


        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="runningProcess" role="tab" data-toggle="tab">To Act</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="completedProcess" role="tab" data-toggle="tab">Completed</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="common-btn" ng-show="ProductionRelayList.length>0">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>

                <div id="GridProductionRelay" ng-init="chkinit()" e-load="actionCompleteSearch" ej-grid e-datasource="ProductionRelayList" e-rowdatabound="rowDataBoundOrder"
                     e-allowfiltering="true" e-allowpaging="true" e-pagesettings-pagesize="100" e-enabletouch="false" e-responsive="true" e-templaterefresh="ProductionRelayAllCheck"
                     e-cellselected="cellSelected" e-selectiontype="single" e-actioncomplete="syncfusiongriddatabound" e-showstackedheader="true"
                     e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                     e-allowselection="false" e-filtersettings-filterType="excel">
                    <div e-stackedheaderrows>
                        <div e-stackedheaderrow>
                            <div e-stackedheadercolumns>
                                <div e-stackedheadercolumn e-headertext="Current Process" e-column="Id,Material,article,CurrentProcess,StyleNo,OwnStyleNo,LSD,OrderQty,PlannedQty,ActualQTY,ProducedQty,Variance,CurrentProcessWIP,StartDate,MasterOrderId,Remarks"></div>
                                <div e-stackedheadercolumn e-headertext="Previous Process" e-column="PreviousProcess,PreviousProcessQty,PreviousProcessWIP,ClosedBy,PreviousProcessStartDate,ClosedDate"></div>
                            </div>
                        </div>
                    </div>
                    <div e-columns>
                        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="25"></div>
                        <div e-column e-template="#btnRemarks" e-textalign="center" e-headertext="Remarks" e-width="70"></div>

                        <div e-column e-type="string" e-field="Id" e-headertext="Prd.Order ID" e-width="50"></div>
                        <div e-column e-type="string" e-field="Material" e-headertext="Material" e-width="180"></div>
                        <div e-column e-type="string" e-field="article" e-headertext="Article" e-width="180"></div>
                        <div e-column e-type="string" e-field="CurrentProcess" e-headertext="Process" e-width="100"></div>
                        <div e-column e-type="string" e-field="LineItemReference" e-headertext="Line Item Reference" e-width="80"></div>
                        <div e-column e-type="string" e-field="StyleNo" e-headertext="Buyer Item#" e-width="100"></div>
                        <div e-column e-type="string" e-field="OwnStyleNo" e-headertext="Own Item#" e-width="100"></div>
                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="LSD" e-headertext="LSD" e-width="80"></div>
                        <div e-column e-type="string" e-field="OrderQty" e-headertext="Order Qty" e-width="80"></div>
                        <div e-column e-type="string" e-field="PlannedQty" e-headertext="Plan Order Qty" e-width="80"></div>

                        <div e-column e-type="string" e-field="ActualQTY" e-headertext="Actual Qty" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProducedQty" e-headertext="Produced Qty" e-width="80"></div>
                        <div e-column e-type="string" e-field="Variance" e-headertext="Variance" e-width="80"></div>
                        <div e-column e-type="string" e-field="CurrentProcessWIP" e-headertext="WIP" e-width="80"></div>

                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="StartDate" e-headertext="Start Date" e-width="80"></div>
                        @*<div e-column e-type="string" e-field="IsCompleted" e-headertext="Is Completed" e-width="80"></div>*@

                        <div e-column e-type="string" e-field="MasterOrderId" e-headertext="Master Order#" e-width="180"></div>
                        <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="200"></div>

                        <div e-column e-type="string" e-field="PreviousProcess" e-headertext="Process" e-width="100"></div>
                        <div e-column e-type="string" e-field="PreviousProcessQty" e-headertext="Qty" e-width="100"></div>
                        <div e-column e-type="string" e-field="PreviousProcessWIP" e-headertext="WIP" e-width="100"></div>

                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="PreviousProcessStartDate" e-headertext="Start Date" e-width="100"></div>
                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="ClosedDate" e-headertext="Completion Date" e-width="100"></div>
                        <div e-column e-type="string" e-field="ClosedBy" e-headertext="Completed By" e-width="100"></div>

                    </div>

                </div>
                <div>
                    <span style="background-color:#6FEAFF;color:#6FEAFF">.....</span>Pre. completed, current started
                    <span style="background-color:#FF502A;color:#FF502A">.....</span>Pre. completed, current not started
                    <span style="background-color:#7EFF87;color:#7EFF87">.....</span>Pre. started, current started
                    <span style="background-color:#FFB42A;color:#FFB42A">.....</span>Pre. started, current not started
                </div>
                <script type="text/x-jsrender" id="headerTemplate">
                    <input type="checkbox" id="headchk" />
                </script>
                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Checked" e-checked="data.Checked" />
                </script>
                <script type="text/template" id="showPRPlanList">
                    <div class="common-btn">
                        <ul class="list-inline text-right small">

                            <li>
                                <button ng-click="$parent.GetProductionPlanningData('',data.Id);" class="btn small" style="height: 20px;width: 20px; padding: 0px; margin: 0px;">
                                    <i class="glyphicon glyphicon-th-list"></i>
                                </button>
                            </li>

                        </ul>
                    </div>
                </script>
                <script type="text/template" id="btnRemarks">
                    <div class="common-btn">
                        <ul class="list-inline small">
                            <li>
                                @*<button ng-click="$parent.ShowRemarksPopUp(data)" class="glyphicon glyphicon-pencil" style="height: 28px; width: 56px; padding: 0px; margin: 0px;font-weight:bolder;">
                        </button>*@
                                <button style="height:28px;width:28px; padding:2px;" type="button" ng-click="$parent.ShowRemarksPopUp(data)" class="btn"><i class="glyphicon glyphicon-pencil"></i></button>

                            </li>
                        </ul>
                    </div>
                </script>
                <div class="common-btn" ng-show="ProductionRelayList.length>0">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
               <div id="GridProductionRelayClosed" ng-init="chkinit()" e-load="actionCompleteSearch" ej-grid e-datasource="ProductionRelayClosedList"
                     e-allowfiltering="true" e-allowpaging="true" e-pagesettings-pagesize="100" e-enabletouch="false" e-responsive="true" e-showstackedheader="true" 
                     e-cellselected="cellSelected" e-selectiontype="single" e-actioncomplete="syncfusiongriddatabound"
                     e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                     e-allowselection="false" e-filtersettings-filterType="excel">
                    <div e-stackedheaderrows>
                        <div e-stackedheaderrow>
                            <div e-stackedheadercolumns>
                                <div e-stackedheadercolumn e-headertext="Current Process" e-column="Id,Material,article,CurrentProcess,StyleNo,OwnStyleNo,LSD,OrderQty,PlannedQty,ActualQTY,ProducedQty,Variance,CurrentProcessWIP,StartDate,EndDate,CompletedBy,MasterOrderId,Remarks"></div>
                                <div e-stackedheadercolumn e-headertext="Previous Process" e-column="PreviousProcess,PreviousProcessQty,PreviousProcessWIP,ClosedBy,PreviousProcessStartDate,ClosedDate"></div>
                            </div>
                        </div>
                    </div>
                    <div e-columns>
                        <div e-column e-type="string" e-field="Id" e-headertext="Prd.Order ID" e-width="50"></div>
                        <div e-column e-type="string" e-field="Material" e-headertext="Material" e-width="180"></div>
                        <div e-column e-type="string" e-field="article" e-headertext="Article" e-width="180"></div>
                        <div e-column e-type="string" e-field="CurrentProcess" e-headertext="Process" e-width="100"></div>
                        <div e-column e-type="string" e-field="LineItemReference" e-headertext="Line Item Reference" e-width="80"></div>
                        <div e-column e-type="string" e-field="StyleNo" e-headertext="Buyer Item#" e-width="100"></div>
                        <div e-column e-type="string" e-field="OwnStyleNo" e-headertext="Own Item#" e-width="100"></div>
                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="LSD" e-headertext="LSD" e-width="80"></div>
                        <div e-column e-type="string" e-field="OrderQty" e-headertext="Order Qty" e-width="80"></div>
                        <div e-column e-type="string" e-field="PlannedQty" e-headertext="Plan Order Qty" e-width="80"></div>

                        <div e-column e-type="string" e-field="ActualQTY" e-headertext="Actual Qty" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProducedQty" e-headertext="Produced Qty" e-width="80"></div>
                        <div e-column e-type="string" e-field="Variance" e-headertext="Variance" e-width="80"></div>
                        <div e-column e-type="string" e-field="CurrentProcessWIP" e-headertext="WIP" e-width="80"></div>

                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="StartDate" e-headertext="Start Date" e-width="80"></div>
                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="EndDate" e-headertext="End Date" e-width="80"></div>
                        <div e-column e-type="string" e-field="CompletedBy" e-headertext="Closed By" e-width="50"></div>

                        @*<div e-column e-type="string" e-field="IsCompleted" e-headertext="Is Completed" e-width="80"></div>*@

                        <div e-column e-type="string" e-field="MasterOrderId" e-headertext="Master Order#" e-width="180"></div>
                        <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="200"></div>

                        <div e-column e-type="string" e-field="PreviousProcess" e-headertext="Process" e-width="100"></div>
                        <div e-column e-type="string" e-field="PreviousProcessQty" e-headertext="Qty" e-width="100"></div>
                        <div e-column e-type="string" e-field="PreviousProcessWIP" e-headertext="WIP" e-width="100"></div>

                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="PreviousProcessStartDate" e-headertext="Start Date" e-width="100"></div>
                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="ClosedDate" e-headertext="Completion Date" e-width="100"></div>
                        <div e-column e-type="string" e-field="ClosedBy" e-headertext="Completed By" e-width="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal site-modal" id="RemarksPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">Remarks<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row">
                    <div class="row" style="padding-bottom:10px;">
                        <div class="col-xs-1 small text-nowrap">Prd.Order ID</div><div class="col-xs-2 small text-nowrap"><span>:{{SelectedProductionRelay.Id}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Material</div><div class="col-xs-2 small text-nowrap"><span>:{{SelectedProductionRelay.Material}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Article</div><div class="col-xs-2 small text-nowrap"><span>:{{SelectedProductionRelay.article}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Buyer Item#</div><div class="col-xs-2 small text-nowrap"><span>:{{SelectedProductionRelay.StyleNo}}</span></div>
                        <div class="col-xs-1 small text-nowrap">Own Item#</div><div class="col-xs-2 small text-nowrap"><span>:{{SelectedProductionRelay.OwnStyleNo}}</span></div>
                    </div>
                    <div class="form-elements form-horizontal">
                        <div class=" col-md-12">
                            <div class="form-group">
                                <label class="col-sm-2 control-label">Remarks<sup>*</sup></label>
                                <div class="col-sm-10">
                                    <textarea rows="3" name="Remarks" ng-model="SelectedProductionRelay.Remarks" class="form-control" maxlength="510"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class=" col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="submitRemarks()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Submit </button></li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
<div class="modal site-modal" id="IsLastProcessPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="row">
                    <div class="form-elements form-horizontal">
                        <div class=" col-md-12">
                            <div class="form-group">
                                <label class="col-sm-2 control-label">The following production orders: {{LastProcessPRList}} are going to be closed.<br />
                                Are you sure to procced??
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class=" col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveWithLastProcess();" class="btn"><i class="glyphicon glyphicon-floppy-save"></i> Yes </button></li>
                                <li> <button ng-click="closePopup('IsLastProcessPopUp')" class="btn"><i class="glyphicon glyphicon-backward"></i> No</button></li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
