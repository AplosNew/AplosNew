<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Production Relay</h3>
<div class="form-elements form-horizontal" ng-form name="DailyTargetForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" @*ng-disabled="DailyTargetList.length>0"*@ id="ddlEntity" ng-model="ProductionRelayNew.EntityId" ng-change="loadProcessList(ProductionRelayNew.EntityId)" name="Entity" ng-options="item.Id as item.UserName for item in entityList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProductionRelayNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in processList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            @*<div class="form-group" style="margin-bottom: 25px;">
                <label class="col-sm-4 control-label"></label>
                <div class="col-sm-2" style="padding-right:0;">
                    <button ng-click="getProductionRelay();" ng-hide="" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button>
                </div>
            </div>*@

            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="getProductionRelay();" ng-hide="ProductionRelayList.length>0" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button></li>
                </ul>
            </div>

        </div>  
        

        <div class="col-xs-12" style="color:black;">

            <div id="GridProductionRelay" ng-init="chkinit()" e-load="actionCompleteSearch" ej-grid e-datasource="ProductionRelayList"
                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-templaterefresh="ProductionRelayAllCheck"
                 e-cellselected="cellSelected" e-selectiontype="single" e-actioncomplete="syncfusiongriddatabound"
                 e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                 e-allowselection="false" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="25"></div>
                    @*<div e-column e-template="#showPRPlanList" e-headertext="" e-width="28"></div>*@
                    <div e-column e-type="string" e-field="Id" e-headertext="Prd.Order ID" e-width="50"></div>
                    <div e-column e-type="string" e-field="PreviousProcess" e-headertext="Previous Process" e-width="50"></div>
                    <div e-column e-type="string" e-field="ClosedBy" e-headertext="Closed By" e-width="50"></div>
                    <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="ClosedDate" e-headertext="Closed Date" e-width="80"></div>
                    @*<div e-column e-type="number" e-field="ProductionPriority" e-headertext="Priority" e-format="{0:N2}" e-width="30"></div>*@
                    <div e-column e-type="string" e-field="BuyerRefNo" e-headertext="Cust. Order#" e-width="100"></div>
                    <div e-column e-type="string" e-field="SONo" e-headertext="SO Nos" e-width="100"></div>
                    <div e-column e-type="string" e-field="SODesc" e-headertext="SO Desc" e-width="100"></div>
                    @*<div e-column e-type="string" e-field="TargetPerDay" e-headertext="Target Per Day" e-width="80"></div>*@
                    <div e-column e-type="string" e-field="POQuantity" e-headertext="Qty" e-width="80"></div>
                    <div e-column e-type="string" e-field="SOQuantity" e-headertext="Plan SO Qty" e-width="80"></div>

                    <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="FirstShipmentDate" e-headertext="First Delivery Date" e-width="80"></div>
                    <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="LastShipmentDate" e-headertext="Last Delivery Date" e-width="80"></div>


                    <div e-column e-type="string" e-field="ProductionStatus" e-headertext="Production Status" e-width="80"></div>
                    @*<div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="LSD" e-headertext="LSD" e-width="80"></div>*@

                    @*<div e-column e-type="string" e-field="buyer" e-headertext="Buyer" e-width="180"></div>*@
                    <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="180"></div>
                    <div e-column e-type="string" e-field="EntityName" e-headertext="Entity" e-width="90"></div>

                    <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Category" e-width="180"></div>
                    <div e-column e-type="string" e-field="Product" e-headertext="Product" e-width="180"></div>
                    <div e-column e-type="string" e-field="Material" e-headertext="Material" e-width="180"></div>
                    <div e-column e-type="string" e-field="article" e-headertext="Article" e-width="180"></div>

                    <div e-column e-type="string" e-field="MasterOrderId" e-headertext="Master Order#" e-width="180"></div>
                    <div e-column e-type="string" e-field="OwnRefNo" e-headertext="Own Order#" e-width="100"></div>
                    <div e-column e-type="string" e-field="StyleNo" e-headertext="Customer Item#" e-width="100"></div>
                    <div e-column e-type="string" e-field="OwnStyleNo" e-headertext="Own Item#" e-width="100"></div>

                    @*<div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="LSD" e-headertext="LSD" e-width="80"></div>*@
                    @*<div e-column e-type="string" e-field="CommitmentDate" e-headertext="Commitment Date" e-width="80"></div>*@

                    <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="200"></div>
                </div>

            </div>
            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
            </script>
            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Checked" e-checked="data.Checked" />
            </script>
            <script type="text/template" id="showPRPlanList">
                <div class="common-btn">
                    <ul class="list-inline text-right small">

                        <li>
                            <button ng-click="$parent.GetProductionPlanningData('',data.Id);" class="btn small" style="height: 20px;width: 20px; padding: 0px; margin: 0px;">
                                <i class="glyphicon glyphicon-th-list"></i>
                            </button>
                        </li>

                    </ul>
                </div>
                @*<button type="button" ng-click="$parent.getSalesOrderOfProdOrderList(data.Id);" class="btn"><i class="glyphicon glyphicon-th-list"></i></button>*@
            </script>
            <div class="common-btn" @*ng-show="DailyTargetList.length>0*@>
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>

        </div>

    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
