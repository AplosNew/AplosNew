@*<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{FormTitle}}</h3>*@
<togglable name="{{FormTitle}}"></togglable>
<div class="form-elements form-horizontal" ng-form="modelNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Infromation</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-3 control-label">Doc Ref & Date<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{modelNew.DocRefNo}}</span>
                        <input type="text" ng-model="modelNew.DocDate" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="popUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" name="Voucher Type" ng-disabled="voucherTypeList.length==1" ng-model="modelNew.VoucherTypeId"
                                ng-options="item.Value as item.Text for item in voucherTypeList" tabindex="2">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-6 col-md-6">
           
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Fisnish Goods No :</label>
                <label class="col-sm-9 control-label">{{modelNew.Id}}</label>
            </div>
           
            <div class="form-group">
                <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <div class="select-style">
                        <select id="entityId" class="form-control" name="Entity" ng-model="modelNew.EntityId" tabindex="7" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Posting Date :</label>
                <div class="col-sm-9 show-message">
                    <input required datepicker="" id="postingDate" type="text" name="PostingDate" ng-model="modelNew.PostingDate" class="form-control" tabindex="1">
                </div>
            </div>
            
            
            <div class="form-group" show-errors>
                <label class="col-sm-3 control-label">Note For Accounts<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <textarea name="Description" class="form-control" rows="2" maxlength="1000" ng-model="modelNew.Narration" tabindex="7"></textarea>
                </div>
            </div>
           

        </div>
        <div></div>

    </fieldset>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Material Info</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="Transaction" role="tab" data-toggle="tab">Journal</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form="tabForm1">
                @*<div class="form-elements">*@
                <div class="col-xs-12 col-sm-4 col-md-4" ng-show="modelNew.Id">
                    <div class="form-group">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-left">
                                <li> <button ng-click="downloadGRN();" class="btn"> GRN Report</button></li>
                            </ul>

                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>

                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material Group</th>
                                <th>Material Master</th>
                                <th>Article</th>
                                <th>Qty</th>
                                <th>Rate</th>
                                <th>Amount (TRN)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in inventoryReceivedList">
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td class="text-right">{{x.TransactionQty}}  {{x.TransactionUoM}}</td>
                                <td class="text-right">{{x.TransactionRate | number| setDecimal:2}}  {{x.CurrencyName}}</td>
                                <td class="text-right">{{x.TrnAmount | number| setDecimal:2}}</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right"><strong>Total : </strong></td>
                                <td class="text-right" ng-hide="sumORnot"></td>
                                <td class="text-right" ng-show="sumORnot"><strong>{{inventoryReceivedList | sumByKey : 'TransactionQty' }}</strong></td>
                                <td class="text-right"><strong>{{inventoryReceivedList | sumByKey : 'TransactionRate'| number| setDecimal:2}}</strong></td>
                                <td class="text-right"><strong>{{inventoryReceivedList | sumByKey : 'TrnAmount'| number| setDecimal:2 }}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                @*<div class="clearfix"></div>*@


                <div class="clearfix"></div>
              
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }" ng-form="tabForm3" ng-keypress="materialConfigMassege()">
              
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="common-btn">
                        <ul class="common-btn list-inline text-left">
                            <li> <button ng-click="materialConfigMassege();" class="btn"> Show Reason</button></li>
                        </ul>

                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>Dr</th>
                                <th>Cr</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in newList| orderBy:'Dr'| groupBy: 'MaterialGroupMasterId'">
                                <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td class="text-right">{{x.Dr | number| setDecimal:4}}</td>
                                <td class="text-right">{{x.Cr | number| setDecimal:4}}</td>
                            </tr>
                            <tr>
                                <td colspan="3"></td>
                                <td class="text-right"><strong>{{newList | sumByKey : 'Dr' | number| setDecimal:4}}</strong></td>
                                <td class="text-right"><strong>{{newList | sumByKey : 'Cr' | number| setDecimal:4}}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table" ng-show="modelNew.AddtionalTax">
                    <table class="table table-responsive table-striped">
                        <caption>TDS </caption>
                        <thead>
                            <tr>
                                <th>Input Tax</th>
                                <th>Percentage</th>
                                <th>Amount</th>
                                <th class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td id="td_TDS_TaxCode">
                                    <div class="select-style show-message">
                                        <select name="TDSTaxCodeId" ng-model="TDS.TaxCodeId" ng-change="selectTDS(TDS.TaxCodeId)" class="col-sm-3 form-control"
                                                ng-options="item.Id as item.UserName for item in TDSCboList">
                                            <option></option>
                                        </select>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <input type="text" n-decimals="4" class="form-control text-right" ng-disabled="TDS.Type =='FixedPercentage' && TDS.ValueOfFixed!=null" ng-model="TDS.ValueOfFixed">
                                    </div>
                                </td>
                                <td id="td_TDS_TaxCodeAmount">
                                    <div class="show-message">
                                        <input type="text" n-decimals="4" class="form-control text-right" ng-model="TDS.TaxAmount" ng-keyup="copyTaxesAmount();">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <a ng-click="addTDS();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                                </td>
                            </tr>
                            <tr ng-repeat="x in TDSList">
                                <td>{{x.TaxName}}</td>
                                <td>{{x.ValueOfFixed}}</td>
                                <td class="text-right">{{x.TaxAmount | number:2 }}</td>
                                <td class="text-right">
                                    <button ng-click="removeTDSRow($index)" data-toggle="modal" ng-disabled="x.AdvanceId" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot ng-show="TDSList.length">
                            <tr>
                                <td colspan="2"><b>Sub Total</b></td>
                                <td class="text-right"><b>{{ TDSList | sumByKey : 'TaxAmount' }}</b></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>

        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="common-btn list-inline text-right">
            <li> <button ng-click="Post();" class="btn"> Post</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchByPostedGRN">
                                <option ng-repeat="option in searchByPostedGRNList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="searchGRN" ng-enter="getDataList();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content-container-fluid" style="color:black;">
        <div style="color:black;" id="GridPrint" ej-grid e-datasource="products" e-allowfiltering="true" e-allowpaging="true"
             e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
             e-actioncomplete="actionCompleteSelected" e-allowscrolling="true" e-showstackedheader="true">
            <div e-columns>
                <div e-column e-field="GRNType" e-headertext="Type" e-width="60" e-filter="false"></div>
                <div e-column e-field="Particular" e-headertext="Particular" e-width="180"></div>
                <div e-column e-field="Id" e-headertext="GRN No" e-width="80" textAlign='Center'></div>
                <div e-column e-field="GRNDate" e-headertext="GRN Date" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="GateEntryNo" e-headertext="Gate EntryNo" e-width="80"></div>
                <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-width="100"></div>
                <div e-column e-field="PostingDate" e-headertext="PostingDate" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="POId" e-headertext="PO Id" e-width="60"></div>
                <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                <div e-column e-field="DocDate" e-headertext="Doc Ref Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="MaterialStorageName" e-headertext="Storage Location" e-width="130"></div>
                <div e-column e-field="TransactionQty" e-headertext="Tran.Qty" e-width="100" textAlign='Right'></div>
                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="60" textAlign='Right'></div>
                <div e-column e-field="TransactionAmount" e-headertext="Tran Amount" e-width="100" textAlign='Right'></div>
                <div e-column e-field="TDSTax" e-headertext=" TDS " e-width="100" textAlign='Right'></div>
                <div e-column e-field="TDSVoucherNo" e-headertext="TDS VoucherNo" e-width="100" textAlign='Right'></div>
                <div e-column e-field="IsTDSTaxPost" e-headertext="Tax Status" e-width="100" textAlign='Right'></div>
                @*<div e-column e-headertext="AdditionalTax" e-commands="additionalTaxPop" e-isunbound=true e-textalign="center" e-width="100"></div>*@

                <div e-column e-headertext="AdditionalTax" e-template="#AdditionalTaxTemplate" e-width="100"></div>


                <div e-column e-headertext="PDF" e-commands="commandPDF" e-isunbound=true e-textalign="center" e-width="60"></div>
                <div e-column e-headertext="Excel" e-commands="commandExcel" e-isunbound=true e-textalign="left" e-width="60"></div>
                <div e-column e-headertext="GRN" e-commands="commandGRN" e-isunbound=true e-textalign="left" e-width="60"></div>

            </div>


        </div>

        <script id="AdditionalTaxTemplate" type="text/template">
            <ul class="common-btn list-inline text-right">
                <li> <button type="button" class="btn" ng-disabled="data.AdditionalTaxId==null" ng-click="$parent.onClickadditionalTaxPop(data);">TDS Post</button></li>
            </ul>

        </script>
    </div>
    <i>**Showing top 100 Posted GRN  order by PostingDate</i>
</div>

@Html.Partial("~/Areas/Accounts/Views/_AdditionalTaxPopUp.cshtml")

<style>
    .modellgModify1 {
        width: 900px;
    }
</style>

<div class="modal fade site-modal in" id="GRNpopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify1">
        <div class="modal-content">
            <div class="modal-header"> FinishGoods Book <button type="button" class="close" ng-click="closeGRNPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        @*style="color:black;overflow:scroll"*@
                        <div style="color:black;overflow:scroll" id="GRNGrid" ej-grid e-datasource="approvedGRNList" e-recorddoubleclick="selectDoubleClick"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" @*e-allowscrolling="true"*@>
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="FinishGoods No" e-width="100"></div>
                                <div e-column e-field="FromDate" e-headertext="From Date" e-width="70" e-format="{0:dd-MMM-yyyy}" type="date"></div>
                                <div e-column e-field="ToDate" e-headertext="To Date" e-width="70" e-format="{0:dd-MMM-yyyy}" type="date"></div>
                                <div e-column e-field="Qty" e-headertext="Qty" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="Amount" e-headertext="Amount (TRN)" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="Description" e-headertext="Description" e-width="130" textAlign='Left'></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeGRNPopUp();" class="btn"> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

