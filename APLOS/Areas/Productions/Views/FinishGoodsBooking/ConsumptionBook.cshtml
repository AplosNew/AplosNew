@*<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{FormTitle}}</h3>*@
<togglable name="{{FormTitle}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="modelForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="modelNew.ProductionEntityId" ng-change="loadProcessList()" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label" id="fDate">From Date<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="From Date" ng-model="modelNew.FromDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required tabindex="2">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Consumption Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="modelNew.ProcessId" disabled name="Consumption Process" ng-options="item.Value as item.Text for item in processList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label" id="tDate">To Date<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="To Date" ng-model="modelNew.ToDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required tabindex="3">
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button style="margin-left: 15px;" ng-click="LoadData();" class="btn"><i class="glyphicon glyphicon-record" style="top:1px"></i> Load</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12" ng-show="LineItemsList.length>0">
        <div style="color:black;" id="GridLineItems" ej-grid e-datasource="LineItemsList" e-allowscrolling="true" e-allowResizing="true"
             e-rowdatabound="rowDataBound" e-allowpaging="true" e-templaterefresh="refreshPackTemplate" e-allowselection="true"
             @*e-allowfiltering="true" e-allowsorting="true"*@ e-enabletouch="false" e-responsive="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-headertext="" e-headertemplateid="#PkheaderTemplate" e-template="#PkcheckboxTemplate" e-textalign="center" e-width="30"></div>
                <div e-column e-field="ProductionOrderId" e-headertext="PrO" e-width="50"></div>
                <div e-column e-field="ProductCode" e-headertext="ProductCode" e-width="80"></div>
                <div e-column e-field="FGQty" e-headertext="Produced Qty" e-width="70" e-textalign="right"></div>
                <div e-column e-template="#Qty" e-headertext="Qty" e-width="100" style="height: 20px;"></div>
                <div e-column e-field="SONo" e-headertext="SONo" e-width="120"></div>
                <div e-column e-field="MasterOrderItemNo" e-headertext="M.Order No" e-width="120"></div>
                <div e-column e-field="MaterialMaster" e-headertext="Material Master" e-width="150"></div>
                <div e-column e-field="Article" e-headertext="Article" e-width="150"></div>
                <div e-column e-field="OrderCostingMasterTemplateId" e-headertext="CostingId" e-width="80"></div>
                @*<div e-column e-headertext="Costing" e-template="#COSTButtons" e-textalign="center" e-width="50"></div>*@
                <div e-column e-field="Rate" e-headertext="Rate" e-width="50" e-textalign="right"></div>
                <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-textalign="center" e-width="50"></div>
            </div>
        </div>
        <script type="text/template" id="PkcheckboxTemplate">
            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Active" />
        </script>
        <script type="text/x-jsrender" id="PkheaderTemplate">
            <input type="checkbox" id="Pkheadchk" />
        </script>

        <script type="text/template" id="Qty">
            <input type="text" class="input ejinputtext form-control" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.Qty" width="80" ng-change="$parent.SetReceiveQty(this)" />

        </script>

        <script type="text/template" id="ShowActionButtons">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button style="margin-left: 5px;" ng-click="$parent.GetCostingItemDetailData(this);" class="btn"><i class="glyphicon glyphicon-list" style="top:1px"></i></button></li>
                </ul>
            </div>
        </script>
        @*<script type="text/template" id="COSTButtons">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button style="margin-left: 5px;" ng-click="$parent.GetCostingItemData(this);" class="btn"><i class="glyphicon glyphicon-list-alt" style="top:1px"></i></button></li>
                </ul>
            </div>
        </script>*@
    </div>

    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button style="margin-left: 5px;" ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-save" style="top:1px"></i> Save</button></li>
            <li><button style="margin-left: 5px;" ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" style="top:1px"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <div class="content-container-fluid" style="color:black;overflow:scroll">
        <div style="color:black;" id="GridMaster" ej-grid e-datasource="masterDataList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="20" e-visible="true"></div>
                <div e-column e-field="ProductionEntity" e-headertext="Production Entity" e-width="60"></div>
                <div e-column e-field="Process" e-headertext="Process" e-width="60"></div>
                @*<div e-column e-field="FromDate" e-headertext="FromDate" e-width="60"></div>
                <div e-column e-field="ToDate" e-headertext="ToDate" e-width="60"></div>*@
                <div e-column e-field="FDate" e-headertext="From Date" e-width="60" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="TDate" e-headertext="To Date" e-width="60" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="CostingItemPoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content" ng-form="CostingItemForm">
            <div class="modal-header">
                Costing Item Detail
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div style="color:black;" id="CostingItemGrid" ej-grid e-datasource="costingItemDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                    <div e-columns>

                        <div e-column e-field="OrderCostingMasterTemplateId" e-headertext="CostingId" e-width="80"></div>
                        <div e-column e-field="UserName" e-headertext="Costing" e-width="80"></div>
                        <div e-column e-field="Rate" e-headertext="Rate" e-textalign="right" e-width="50"></div>
                        <div e-column e-template="#ReceiveRate" e-headertext="ReceiveRate" e-width="80" style="height: 20px;"></div>
                    </div>
                </div>
                <script type="text/template" id="ReceiveRate">
                    <div class="col-sm-10" style="padding:0px; width:70px;">
                        <input type="text" ej-numerictextbox e-decimalplaces="0" e-value="data.ReceiveRate" e-width="80" />
                    </div>
                </script>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="CostingItemDetailDataPoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content" ng-form="CostingItemDetailDataForm">
            <div class="modal-header">
                Costing Item Detail
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div style="color:black;" id="CostingItemDetailDataGrid" ej-grid e-datasource="costingItemDetailDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true" e-summaryrows="SummaryRows">
                    <div e-columns>

                        <div e-column e-field="CostingComponent" e-headertext="Costing Component" e-width="80"></div>
                        <div e-column e-field="CostingItem" e-headertext="Costing Item" e-width="80"></div>
                        <div e-column e-field="Rate" e-headertext="Rate" e-textalign="right" e-width="50"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



