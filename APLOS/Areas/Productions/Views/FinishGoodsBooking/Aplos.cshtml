@*<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{FormTitle}}</h3>*@
<togglable name="{{FormTitle}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="modelForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="modelNew.ProductionEntityId" ng-change="loadProcessList()" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Production Order<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" name="ProductionOrder" ng-model="modelNew.ProductionOrderId" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getProductionOrderPopUp();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Consumption Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="modelNew.ProcessId" disabled name="ProcessId" ng-options="item.Value as item.Text for item in processList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12" ng-show="SalesOrderLineItems.length>0">
        <div style="color:black;" id="GridLineItems" ej-grid e-datasource="SalesOrderLineItems" e-allowscrolling="true" e-allowResizing="true"
             e-allowpaging="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="SalesOrderId" e-headertext="SO No" e-width="80"></div>
                <div e-column e-field="BuyerOrder" e-headertext="Buyer Ord#" e-width="80"></div>
                <div e-column e-field="OwnOrder" e-headertext="Own Ord#" e-width="80"></div>
                <div e-column e-field="BuyerItem" e-headertext="Buyer Item#" e-width="80"></div>
                <div e-column e-field="OwnItem" e-headertext="Own Item#" e-width="80"></div>
                <div e-column e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                <div e-column e-field="MaterialMaster" e-headertext="Material Master" e-width="150"></div>
                <div e-column e-field="Article" e-headertext="Article" e-width="150"></div>
                <div e-column e-field="ProductCode" e-headertext="ProductCode" e-width="80"></div>
                <div e-column e-template="#ProdtCode" e-headertext="Product Code" e-width="80" style="height: 20px;"></div>
                <div e-column e-template="#Qty" e-headertext="Qty" e-width="100" style="height: 20px;"></div>
                <div e-column e-field="OrderQty" e-headertext="OrderQty" e-width="80"></div>
                <div e-column e-field="PlannedQty" e-headertext="PlannedQty" e-width="80"></div>
                <div e-column e-field="OtherBookedQty" e-headertext="Other Booked Qty" e-width="80"></div>
                <div e-column e-field="CostingItem" e-headertext="Costing Item" e-width="80"></div>
                <div e-column e-field="OrderCostingMasterTemplateId" e-headertext="CostingId" e-width="80"></div>
                <div e-column e-field="Rate" e-headertext="Rate" e-width="80"></div>
            </div>
        </div>
        <script type="text/template" id="ProdtCode">
            <div class="select-style">
                <select class="form-control" ng-model="data.ProductLibraryId" name="ProdtCode" ng-change="SetProductCodeQty();">
                    <option value="">--Select--</option>
                    <option ng-repeat="option in $parent.ProductCodeList" value="{{option.ProductLibraryId}}">{{option.ProductCode}}</option>
                </select>
            </div>
        </script>
        <script type="text/template" id="Qty">
            <div class="col-sm-10" style="padding:0px; width:100px;">
                <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="data.Qty" e-width="100" />
            </div>
        </script>
    </div>
    <div class="col-xs-12" ng-show="BookedAndBalancedDataList.length>0">
        <div style="color:black;" id="GridLineItems" ej-grid e-datasource="BookedAndBalancedDataList" e-allowscrolling="true" e-allowResizing="true"
             e-allowpaging="true" e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="POId" e-headertext="PrO" e-width="80"></div>
                <div e-column e-field="ProductCode" e-headertext="Product Code" e-width="80"></div>
                <div e-column e-field="FGQty" e-headertext="FG Qty" e-width="80"></div>
                <div e-column e-field="BookedQty" e-headertext="Booked Qty" e-width="80"></div>
                <div e-column e-field="Balance" e-headertext="Balance" e-width="80"></div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button style="margin-left: 5px;" ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-save" style="top:1px"></i> Save</button></li>
            <li><button style="margin-left: 5px;" ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" style="top:1px"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <div class="content-container-fluid" style="color:black;overflow:scroll">
        <div style="color:black;" id="GridMaster" ej-grid e-datasource="masterDataList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="20" e-visible="true"></div>
                <div e-column e-field="ProductionEntity" e-headertext="Production Entity" e-width="60"></div>
                <div e-column e-field="Process" e-headertext="Process" e-width="60"></div>
                <div e-column e-field="ProductionOrderId" e-headertext="PrO" e-width="60"></div>
            </div>
        </div>
    </div>
</div>
<div class="modal site-modal in" id="POItemPopup" role="dialog" data-backdrop="static">
    <div class="row">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">Production Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body text-center">
                    <div style="color:black;" id="Grid" ej-grid e-datasource="ProductionOrderList" e-allowscrolling="true" e-allowResizing="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-recorddoubleclick="SelectPOItem"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-template="#showSOList" e-headertext="" e-width="30"></div>
                            <div e-column e-field="POId" e-headertext="ProductionOrderNo" e-width="80"></div>
                            <div e-column e-field="BuyerOrder" e-headertext="Buyer Ord#" e-width="80"></div>
                            <div e-column e-field="OwnOrder" e-headertext="Own Ord#" e-width="80"></div>
                            <div e-column e-field="SONo" e-headertext="SONo" e-width="80"></div>
                            <div e-column e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
                            <div e-column e-field="Qty" e-headertext="Qty" e-width="80"></div>
                            <div e-column e-field="LSD" e-headertext="LSD" e-width="80"></div>
                            <div e-column e-field="CommitmentDate" e-headertext="Commitment Date" e-width="80"></div>
                            <div e-column e-field="ProductionStatus" e-headertext="Production Status" e-width="80"></div>
                            <div e-column e-field="BuyerItem" e-headertext="Buyer Item#" e-width="80"></div>
                            <div e-column e-field="OwnItem" e-headertext="Own Item#" e-width="80"></div>
                            <div e-column e-field="ProductCategory" e-headertext="Product Category" e-width="80"></div>
                            <div e-column e-field="Product" e-headertext="Product" e-width="80"></div>
                            <div e-column e-field="Customer" e-headertext="Customer" e-width="80"></div>
                            <div e-column e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                            <div e-column e-field="MaterialMaster" e-headertext="Material Master" e-width="80"></div>
                            <div e-column e-field="Article" e-headertext="Article" e-width="80"></div>
                            <div e-column e-field="PONumber" e-headertext="PO Number" e-width="80"></div>
                            <div e-column e-field="RequiredTimeUnit" e-headertext="Required Time Unit" e-width="80"></div>

                        </div>
                    </div>
                    <script type="text/template" id="showSOList">
                        <div class="common-btn">
                            <ul class="list-inline text-right small">

                                <li>
                                    <button ng-click="$parent.getSalesOrderOfProdOrderList(data.POId);" class="btn small" style="height: 20px;width: 20px;padding: 0px;margin: 0px;">
                                        <i class="glyphicon glyphicon-th-list"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>
<ej-dialog id="dialogSOItemsForProductionOrder" title=" Sales Order Detail" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target="#POItemPopup" e-minheight="200" e-width="900" e-open="enableBtn">
    <div class="row" style="width:890px!important;">
        <div id="GridSOItemsForProductionOrder" ng-init="chkinit()" ej-grid e-datasource="SalesOrderListForProductionOrderId"
             e-allowscrolling="true" e-summaryrows="summaryRows"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-showsummary="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="MasterOrderNo" e-headertext="M. Order No" e-width="120"></div>
                <div e-column e-field="SalesOrderId" e-headertext="SO. ID" e-width="120"></div>

                <div e-column e-field="Customer" e-headertext="Customer" e-width="180"></div>
                <div e-column e-field="Buyer" e-headertext="Buyer" e-width="180"></div>
                <div e-column e-field="BuyerOrderNo" e-headertext="Buyer Order#" e-width="100"></div>
                <div e-column e-field="OwnOrderNo" e-headertext="Own Order#" e-width="100"></div>

                <div e-column e-field="BuyerReferenceNo" e-headertext="Buyer Item#" e-width="100"></div>
                <div e-column e-field="OwnReferenceNo" e-headertext="Own Item#" e-width="100"></div>

                <div e-column e-field="ProductName" e-headertext="Product" e-width="180" e></div>
                <div e-column e-field="ProductionGrouping" e-headertext="Product Grouping" e-width="120" e></div>

                <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="180" e></div>
                <div e-column e-field="ArticleName" e-headertext="Article" e-width="180"></div>
                <div e-column e-field="DeliveryDate" e-headertext="Del. Date" e-width="80"></div>
                <div e-column e-field="CommitmentDate" e-headertext="Commi.Date" e-width="80"></div>
                <div e-column e-field="DestinationName" e-headertext="Dest." e-width="80"></div>
                <div e-column e-field="ShipmentModeName" e-headertext="Ship.Mode" e-width="80"></div>
                <div e-column e-field="PONumber" e-headertext="PO No" e-width="80"></div>

                <div e-column e-field="OrderStatusName" e-headertext="Ord. Status" e-width="80"></div>
                <div e-column e-field="OrderCategoryName" e-headertext="Ord. Cat." e-width="80"></div>
                <div e-column e-field="Qty" e-headertext="Qty" e-width="80" e-textalign="right"></div>
                <div e-column e-field="Rate" e-headertext="Rate" e-width="80" e-textalign="right"></div>
                <div e-column e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
            </div>
        </div>
        @*</div>*@
        <ul class="common-btn list-inline text-right">
            <li><button ng-click="closePopup('dialogSOItemsForProductionOrder')" class="btn"><i> Close</i></button></li>
        </ul>
    </div>
</ej-dialog>




