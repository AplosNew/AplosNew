<togglable name="{{FormTitle}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="modelForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="modelNew.ProductionEntityId" ng-change="loadProcessList()" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label" id="fDate">From Date<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="From Date" ng-model="modelNew.FromDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Storage Location<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Storage Location" ng-model="modelNew.MaterialStorageId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in storageList" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message">
                <div class="select-style">
                    <select class="form-control" name="Currency" ng-model="modelNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList"
                            ng-change="GetCurrencyExchangeRateList();" tabindex="8" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="width: 22%; margin-left: -30px;">
                <input type="text" n-decimals="2" id="ToCurrencyRate" name="ToCurrencyRate" ng-model="modelNew.ToCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off" ng-disabled="modelNew.CurrencyId==companyCurrencyId" required>
            </div>
        </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Consumption Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="modelNew.ProcessId" disabled name="Consumption Process" ng-options="item.Value as item.Text for item in processList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label" id="tDate">To Date<sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <input type="text" name="To Date" ng-model="modelNew.ToDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Level<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">

                        <select class="form-control" ng-model="modelNew.Level" placeholder="Level" name="Level" ng-options="item.Value as item.Text for item in LevelList" ng-change="GetQBOQCostingData();" required tabindex="6">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Description">Description</label>
                <div class="col-sm-8">
                    <textarea rows="2" type="text" ng-maxlength="250" name="Description" tabindex="8" class="form-control" ng-model="modelNew.Description"></textarea>
                </div>
            </div>
        </div>
    
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button style="margin-left: 15px;" ng-click="LoadData();" class="btn"><i class="glyphicon glyphicon-record" style="top:1px"></i> Load</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12" ng-show="LineItemsList.length>0">
        <div style="color:black;" id="GridLineItems" ej-grid e-datasource="LineItemsList" e-allowscrolling="true" e-allowResizing="true"
             e-rowdatabound="rowDataBound" e-allowpaging="true" e-templaterefresh="refreshPackTemplate" e-allowselection="true"
             e-allowfiltering="true" e-enabletouch="false" e-responsive="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-type="string" e-field="ProductionOrderId" e-headertext="PrO" e-width="50"></div>
                <div e-column e-type="string" e-field="ProductCode" e-headertext="ProductCode" e-width="80"></div>
                <div e-column e-type="string" e-field="MasterOrderItemId" e-headertext="MasterOrderItemId" e-width="80"></div>
                <div e-column e-type="string" e-field="SONO" e-headertext="SoNo" e-width="80"></div>
                <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material Master" e-width="150"></div>
                <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="150"></div>
                <div e-column e-type="string" e-field="OrderCostingMasterTemplateId" e-headertext="CostingId" e-width="80"></div>
                <div e-column e-type="number" e-field="Qty" e-headertext="Qty" e-width="70" e-textalign="right" e-format="{0:0.00}"></div>
                <div e-column e-type="number" e-field="Rate" e-headertext="Rate" e-width="50" e-textalign="right" e-format="{0:0.0000}"></div>
                <div e-column e-type="number" e-template="#Rate" e-headertext="Rate" e-width="100" style="height: 20px;" e-textalign="right"></div>
                <div e-column e-type="number" e-field="Amount" e-headertext="Amount" e-width="70" e-textalign="right" e-format="{0:0.00}"></div>
                <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-textalign="center" e-width="50"></div>
            </div>
        </div>
        <script type="text/template" id="Rate">
            <div class="col-sm-10" style="padding:0px; width:100px;">
                <input type="text" style="text-align:right" class="form-control" n-decimals="4" ng-model="data.Rate" ng-blur="$parent.calculateAmount(data)" />

            </div>
        </script>
        <script type="text/template" id="ShowActionButtons">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button style="margin-left: 5px;" ng-click="$parent.GetCostingItemDetailData(this);" class="btn"><i class="glyphicon glyphicon-list" style="top:1px"></i></button></li>
                </ul>
            </div>
        </script>
    </div>

    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button style="margin-left: 5px;" ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-save" style="top:1px"></i> Save</button></li>
            <li><button style="margin-left: 5px;" ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" style="top:1px"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    
        <div style="color:black;" id="GridMaster" ej-grid e-datasource="masterDataList" @*e-recorddoubleclick="Get"*@
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="20" e-visible="true" e-type="string"></div>
                <div e-column e-field="ProductionEntity" e-headertext="Production Entity" e-width="60" e-type="string"></div>
                <div e-column e-field="Process" e-headertext="Process" e-width="60" e-type="string"></div>
                <div e-column e-field="FDate" e-headertext="From Date" e-width="60" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="TDate" e-headertext="To Date" e-width="60" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="MaterialStorage" e-headertext="Material Storage" e-width="60" e-type="string"></div>
                <div e-column e-field="Currency" e-headertext="Currency" e-width="30" e-type="string"></div>
                <div e-column e-field="Description" e-headertext="Description" e-width="60" e-type="string"></div>
                <div e-column e-field="GRNNo" e-headertext="FGInventory" e-width="80" e-type="string"></div>
                <div e-column e-headertext="Actions" e-template="#ShowActionButtonsBOM" e-width="25"></div>
            </div>
        </div>
        <script type="text/template" id="ShowActionButtonsBOM">
            <button style="color: #f3f3ec;background-color: #1c1f32; " title="FGGRN PoPUp" class="btn"><i class="glyphicon glyphicon-list" ng-click="$parent.GetRawMaterialDetail(this);" @*style="width: 50px;"*@></i></button>
        </script>
   
</div>
<div class="modal site-modal in" id="FGInventoryRegisterPopup" role="dialog" data-backdrop="static">
    <div class="row">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">FG Inventory<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body text-center">
                    <div style="color:black;" id="GridGRNID6" ej-grid e-datasource="FGInventoryRegisterPoPUpList" e-allowscrolling="true" e-allowResizing="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-headertext="Actions" e-width="70">
                                <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;padding-top:1px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.AllTabPrint('GridGRNID6');" style="margin: -6px;"></i></button>
                            </div>
                            <div e-column e-field="Id" e-headertext="FGInventory No." e-width="100" textAlign='Left'></div>
                            <div e-column e-field="GRNDate" e-headertext="FGInventory Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                            <div e-column e-field="EntryDate" e-headertext="Entry Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="FixedAssetOrInventory" e-headertext="FixedAssetOrInventory" e-width="100"></div>
                            <div e-column e-field="Status" e-headertext="Status" e-width="50"></div>
                            <div e-column e-field="GRNType" e-headertext="Type" e-width="50"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade site-modal in" id="CostingItemDetailDataPoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content" ng-form="CostingItemDetailDataForm">
            <div class="modal-header">Costing Item Detail<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <p style="color:blue;font-size:11px">Only Direct Material will save.</p>
                <div style="color:black;" id="CostingItemDetailDataGrid" ej-grid e-datasource="costingItemDetailDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true" e-summaryrows="SummaryRows">
                    <div e-columns>
                        <div e-column e-field="CostingSegment" e-headertext="Costing Segment" e-width="80"></div>
                        <div e-column e-field="CostingComponent" e-headertext="Costing Component" e-width="80"></div>
                        <div e-column e-field="CostingItem" e-headertext="Costing Item" e-width="80"></div>
                        <div e-column e-field="GrossConsumption" e-headertext="Gross Consumption" e-textalign="right" e-format="{0:0.0000}" e-width="50"></div>
                        <div e-column e-field="Rate" e-headertext="Rate" e-textalign="right" e-width="50" e-format="{0:0.0000}"></div>
                        <div e-column e-field="GrossAmount" e-headertext="Gross Amount" e-textalign="right" e-width="50" e-format="{0:0.0000}"></div>
                        <div e-column e-field="ConsiderForFGValuation" e-headertext="FG Valuation" e-width="50"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
