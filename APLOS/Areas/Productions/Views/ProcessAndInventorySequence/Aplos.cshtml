<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Process And Inventory Sequence</h3>
<div class="form-elements form-horizontal" ng-form name="CostingTypeForm">
    <div class="row">
        <div class="col-md-12">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-2 control-label">Company<sup>*</sup></label>
                        <div class="col-sm-2">
                            <input id="ddlCompanyList" ej-dropdownlist e-value="SelectedId" e-change="changeCompany" e-datasource="CompanyList" e-fields-value="Id" e-fields-text="CompanyName" />
                        </div>
                        <div class="col-sm-8">
                        </div>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-2 control-label">Plant<sup>*</sup></label>
                        <div class="col-sm-2">
                            <input id="ddlPlantList" ej-dropdownlist e-value="plantId" e-change="LoadData" e-datasource="cboPlantList" e-fields-value="Value" e-fields-text="Text" />
                        </div>
                        <div class="col-sm-8">
                        </div>
                    </div>
                </div>
            </div>



                <div style="color:black;" id="GridProcessAndInventorySequence" ej-grid e-datasource="ProcessAndInventorySeq"
                     e-allowfiltering="true" e-gridlines="vertical" e-allowrowdraganddrop="true" e-actioncomplete="actioncomplete"
                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="true">

                    <div e-columns>
                        @*<div e-column e-type="string" e-field="ProcessId" e-headertext="Process Id" e-width="150"></div>
                    <div e-column e-type="string" e-field="SFGInventoryId" e-headertext="SFGInventory Id " e-width="120"></div>*@
                        <div e-column e-type="string" e-field="UserName" e-headertext="UserName" e-width="420"></div>
                        <div e-column e-type="string" e-field="Sequence" e-headertext="Sequence" e-width="20"></div>
                        <div e-column e-template="#ItemSelected" e-headertext="Active" e-width="20"></div>
                    </div>

                </div>
                <script type="text/template" id="ItemSelected">
                    <span>
                        <input type="checkbox" ej-checkbox e-value="data.Active" e-checked="data.Active" class="nodetext" />
                    </span>
                </script>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> {{Action}}</button></li>

                    </ul>
                </div>

            </div>
        </div>
</div>

