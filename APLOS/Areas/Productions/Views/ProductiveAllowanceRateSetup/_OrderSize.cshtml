<togglable name="Order Size Setup"></togglable>
<div class="form-elements form-horizontal" ng-form id="Header" name="orderSizeForm">
    <div class="row">
        <div ng-form name="orderSizeFormF">
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Days</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="orderSizeObj.Days" name="Days" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Semi Critical</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="orderSizeObj.SemiCritical" name="SemiCritical" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Special</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="orderSizeObj.Special" name="Special" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>
                 

                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="orderSizeObj.Remark" class="form-control" maxlength="100" tabindex="4">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Basic</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="orderSizeObj.Basic" name="Basic" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Critical</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="orderSizeObj.Critical" name="Critical" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>


            </div>


            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveOrderSize();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button ng-click="clearOrderSize();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row text-right aplos-grid-toggle">

    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div style="color:black;" id="OrderSizeGrid" ej-grid e-datasource="orderSizeList"
             e-allowfiltering="true" e-allowpaging="true" e-pagesettings-pagesize="20"
             e-allowselection="true" e-recorddoubleclick="GetOrderSize" e-filtersettings-filterType="excel"
             e-templaterefresh="refreshTemplate" e-enabletouch="true" e-responsive="true" e-allowtextwrap="true" e-allowscrolling="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="120"></div>
                <div e-column e-field="Days" e-headertext="Days" e-width="150"></div>
                <div e-column e-field="Basic" e-headertext="Basic" e-width="150"></div>
                <div e-column e-field="Critical" e-headertext="Critical" e-width="150"></div>
                <div e-column e-field="SemiCritical" e-headertext="SemiCritical" e-width="150"></div>
                <div e-column e-field="Special" e-headertext="Special" e-width="150"></div>
                <div e-column e-field="Remark" e-headertext="Remark" e-width="150"></div>
            </div>
        </div>
    </div>

</div>

<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpDT" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteDT();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpDS" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteDS();"></confirm-archive-generic>

<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>

<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 46) {
            return false;
        }
        return true;
    }

    //onkeypress = "return isNumber(event)"
</script>


<div class="modal fade site-modal in" id="CurrDayStatusModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Day Types</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic"> </div>
                <p style="margin:10px;">
                    Select the Day Type by Double Clicking.
                <p>

                    <div id="getDaysList" ej-grid e-datasource="DayTypesList" e-templaterefresh="refreshTemplate"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-minWidth="450" e-minHeight="400" e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true"
                         e-recorddoubleclick="doubleCurrDayStatus">
                        <div e-columns>
                            <div e-column e-field="DayType" e-headertext="Day Type" e-width="80"></div>
                            <div e-column e-field="Description" e-headertext="Description" e-width="120"></div>
                            <div e-column e-field="Category" e-headertext="Category" e-width="120"></div>
                            <div e-column e-field="OriginalDayType" e-headertext="Original Day Type" e-width="120"></div>

                        </div>
                    </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>

<div class="modal fade site-modal in" id="RespPersonModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Responsible Person</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic"> </div>
                <p style="margin:10px;">
                    Select the Responsible Person by Double Clicking.
                <p>

                    <div id="getRespPerson" ej-grid e-datasource="EmployeesList"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-minWidth="450" e-minHeight="400" e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true"
                         e-recorddoubleclick="doubleRespPerson">
                        <div e-columns>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>

                        </div>
                    </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>
