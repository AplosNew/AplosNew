<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Special Operation Rate
</h3>

<div class=" row">
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group">
            <label class="col-sm-4 control-label">Operation Category</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="OperationCatId" ng-change="fillOperationMaster()" name="operationCat"
                            ng-options="item.Value as item.Text for item in operationCatList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Operation Master</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="OperationMasterId" ng-change="fillMachine()" name="operationCat"
                            ng-options="item.Value as item.Text for item in operationMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group">
            <label class="col-sm-4 control-label">Machine</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="MachineId" ng-change="fillOperationMaster()" name="uom"
                            ng-options="item.Value as item.Text for item in machineList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="common-btn" style="margin:10px;">
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="getOperations()" class="btn "><i class="glyphicon glyphicon-search"></i>View</button></li>
                    <li><button ng-click="clearFilters()" class="btn "><i class="glyphicon glyphicon-repeat"></i> Clear All Filters </button></li>
                </ul>
            </div>
        </div>

    </div>
</div>

<div class="row">

    <div class="row">
        <div class="common-btn" style="margin:10px;">
            <ul class="common-btn list-inline text-right">
                <li><button ng-click="saveOperations()" class="btn "><i class="glyphicon  glyphicon-arrow-down"></i>Save</button></li>
                <li><button ng-click="clearGrid()" class="btn "><i class="glyphicon glyphicon-repeat"></i> Clear All Filters </button></li>
            </ul>
        </div>
    </div>

    <div id="getOperation" ej-grid e-datasource="OperationsList" e-templaterefresh="refreshTemplate"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" style="margin-top:30px;" e-allowtextwrap="true"
         e-tooltipsettings-visible="true" e-tooltip="tooltip">
        <div e-columns>
            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#check" e-textalign="center" e-width="30"></div>
            <div e-column e-field="OperationVariationCode" e-headertext="Operation Variation Code" e-width="80" e-type="string"></div>
            <div e-column e-field="OperationVariation" e-headertext="Operation Variation" e-width="80" e-type="number"></div>

            <div e-column e-headertext="Rate" e-template="#rate" e-textalign="center" e-width="80"></div>
            <div e-column e-headertext="Remarks" e-template="#rem" e-textalign="center" e-width="80"></div>

        </div>
    </div>

    <script type="text/template" id="rate">
        <input type="number" ng-model="data.Rate" style="color:black; text-align:center" />
    </script>

    <script type="text/template" id="rem">
        <input type="text" ng-model="data.Remarks" style="color:black; text-align:center" />
    </script>

    <script type="text/template" id="check">
        <input type="checkbox" class="rowCheckbox" ng-model="data.Active" />
    </script>

</div>