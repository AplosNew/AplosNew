<div class="form-elements form-horizontal" ng-form id="Header" name="HeaderFormOne">
    <div class="row">
        <div ng-form name="HeaderForm">
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="HeaderPa.UserName" name="User Name" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Process<sup></sup></label>
                    <div class="col-sm-8">
                        <input id="selProcess" ej-dropdownlist e-multiselectmode="visualmode" e-datasource="ProcessList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="HeaderPa.Remarks" class="form-control" maxlength="100" tabindex="4">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Effective Date</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="HeaderPa.EffectiveDate" name="Date" datepicker class="form-control" maxlength="50" tabindex="3" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Entity<sup></sup></label>
                    <div class="col-sm-8">
                        <input id="selEntity" ej-dropdownlist e-multiselectmode="visualmode" e-datasource="EntityList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true" />
                    </div>
                </div>
            </div>

            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="saveHeaderPA();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        @*<li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                        <li> <button ng-click="clearHeaderPA();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>

