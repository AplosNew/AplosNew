<style>
    .modal.active{
        display:block
    }
</style>
<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group mb-2">
            <label class="col-sm-4 control-label">Company</label>

            <div class="show-message col-sm-8 ">
                <div class="select-style" style="margin-bottom:12px !important">
                    <select class="form-control" ng-model="companyIdeet" ng-change="getPlant()" name="Comapny"
                            ng-options="item.Value as item.Text for item in companyListeet">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group mb-2">
            <label class="col-sm-4 control-label">Entity</label>
            <div class="col-sm-8 show-message">
                <div class="select-style" style="margin-bottom:12px !important">

                    <select class="form-control" ng-model="ModelNeweet.EntityId" ng-change="getProcesses()" name="Entity"
                            ng-options="item.Value as item.Text for item in entityListeet">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group mb-2">
            <label class="col-sm-4 control-label">Plant</label>
            <div class="col-sm-8 show-message">
                <div class="select-style" style="margin-bottom:12px !important">
                    <select class="form-control" ng-model="plantIdeet" ng-change="getEntity()" name="Plant"
                            ng-options="item.Value as item.Text for item in plantListeet">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group mb-2">
            <label class="col-sm-4 control-label">Process</label>
            <div class="col-sm-8 show-message">
                <div class="select-style" style="margin-bottom:12px !important">
                    <select class="form-control" ng-model="ModelNeweet.ProcessId" name="Process"
                            ng-options="item.Value as item.Text for item in processListeet">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Is Applicable</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNeweet.IsApplicable" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button onclick="openModal()" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            @*<li> <button data-toggle="modal" onclick="openModal()" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div class="col-md-6">
        <div id="GridEdit" ej-grid e-datasource="ModelListeet" e-recorddoubleclick="Get" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                <div e-column e-field="EntityName" e-headertext="Entity Name" e-width="2"></div>
                @*<div e-column e-field="AddedDate" e-format="{0:dd-MMM-yyyy}"  e-type="date" e-headertext="Date Added" e-width="2"></div>*@
                <div e-column e-field="ProcessName" e-headertext="Process" e-width="3"></div>
                <div e-column e-field="IsApplicable" e-headertext="is Applicables" e-width="5"></div>

            </div>
        </div>
    </div>
   
</div>
@*<confirm-modal></confirm-modal>*@
@*<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Deletet();"></confirm-archive-generic>*@

@*------------------------------------------------------------------------------------*@
<style>
    button.btn-primary {
        position: fixed;
        top: 50%;
        left: 50%;
        margin-top: -50px;
        margin-left: -100px;
    }

    .hide {
        display: none;
    }

    .show {
        display: block;
    }
</style>

<div class="container">
    <!-- Button to Open the Modal -->
    
    <!-- The Modal -->
    <div class="modal" id="myModal">
        <div class="modal-dialog">

            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title">Modal Heading</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>

                <!-- Modal body -->
                <div class="modal-body">
                    Modal body..
                </div>
                <div class="confirm-delete hide">
                    <div class="modal-header">
                        <h4 class="modal-title">Delete Confirmed</h4>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <p>Delete Successful!!</p>
                    <div class="modal-footer1">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    </div>
                </div>
                <!-- Modal footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button class="btn btn-danger" onclick="confirmDelete()">Delete</button>
                </div>

            </div>
        </div>
    </div>

</div>

@*--------------------------------------------------------------------------*@
