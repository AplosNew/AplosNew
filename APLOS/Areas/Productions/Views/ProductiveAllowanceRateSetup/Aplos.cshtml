<style>
    .b-tab {
        padding: 20px;
        border: 1px solid #000;
        display: none;
    }

        .b-tab.active {
            display: block;
        }

    .b-nav-tab {
        /*display: inline-block;*/
        padding: 13px 9px;
        font-size:1rem;
        font-family:'poppins', sans-serif;
        font-weight:700;
        box-shadow:0 0 2px rgba(0,0,0,.090);
        margin-bottom:10px
        
    }

        .b-nav-tab.active {
            color: #fff;
            background:#1C1F32;
        }
    .d-grid {
        display: grid;
        /*grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));*/
        grid-template-columns: repeat(6, 1fr);
        grid-gap: 10px;
    }
</style>
<div class="d-grid">
    <div></div>
    <div></div>
    <button data-tab="layout1" class="b-nav-tab active" style="border:none">
        Productivity Allowance
    </button>
    <button data-tab="layout2" class="b-nav-tab" style="border:none">
        Rate Setup
    </button>
    @*<div></div>*@
    <div></div>
</div>

<div id="layout1" class="b-tab active">
    @{
        Html.RenderPartial("_Layout1");
    }
</div>
<div id="layout2" class="b-tab">
    @{
        Html.RenderPartial("_Layout2");
    }
</div>
