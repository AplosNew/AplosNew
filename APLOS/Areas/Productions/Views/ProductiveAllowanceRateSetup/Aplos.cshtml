<style>
    .b-tab {
        padding: 20px;
        border: 1px solid #000;
        display: none;
    }

        .b-tab.active {
            display: block;
        }

    .b-nav-tab {
       
        padding: 13px 9px;
        font-size: .8rem;
        font-family: 'poppins', sans-serif;
        font-weight: 300;
        box-shadow: 0 0 2px rgba(0,0,0,.090);
        margin-bottom: 10px;
        margin-left: 10px
    }

        .b-nav-tab.active {
            color: #fff;
            background: #1C1F32;
        }

    .d-grid {
        
        display: flex;
        justify-content: center;
        justify-items: center;
    }
</style>
<div class="d-grid">
    @*<div></div>*@
    @*<div></div>*@
    <button data-tab="_ProductivityAllowance" class="b-nav-tab active" style="border:none">
        Productivity Allowance
    </button>
    <button data-tab="_RateSetup" class="b-nav-tab" style="border:none">
        Rate Setup
    </button>
    <button data-tab="_SpecialOperationRate" class="b-nav-tab" style="border:none">
        Special Operation Rate
    </button>
    <button data-tab="_BudgetApplicable" class="b-nav-tab" style="border:none">
        Budget Applicable
    </button>
    <button data-tab="_EmployeeTimeOut" class="b-nav-tab" style="border:none">
        Employee Time Out Applicable
    </button>
    <button data-tab="_OrderSize" class="b-nav-tab" style="border:none">
        Order Size
    </button>
    @*<div></div>*@
</div>

<div id="_ProductivityAllowance" class="b-tab active">
    @{
        Html.RenderPartial("_ProductivityAllowance");
    }
</div>
<div id="_RateSetup" class="b-tab">
    @{
        Html.RenderPartial("_RateSetup");
    }
</div>
<div id="_SpecialOperationRate" class="b-tab">
    @{
        Html.RenderPartial("_SpecialOperationRate");
    }
</div>
<div id="_BudgetApplicable" class="b-tab">
    @{
        Html.RenderPartial("_BudgetApplicable");
    }
</div>
<div id="_EmployeeTimeOut" class="b-tab">
    @{
        Html.RenderPartial("_EmployeeTimeOut");
    }
</div>
<div id="_OrderSize" class="b-tab">
    @{ Html.RenderPartial("_OrderSize"); }
</div>
