<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Planning Type</h3>
<div class="row" ng-form name="planningTypeForm">
    <div class="form-elements form-horizontal">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Company" class="form-control" ng-model="planningTypesNew.CompanyId" ng-change="getPlantCbo();getAllEntities();" ng-options="item.Value as item.Text for item in companyList" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Planning Types<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select submit-="true" ng-model="planningTypesNew.PlanningType" class="form-control" name="Planning Type" ng-change="ChangeType();"
                                ng-options="item.Value as item.Text for item in planningTypesList" tabindex="10" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="planningTypesNew.EntityId" ng-change="loadProcessList(planningTypesNew.EntityId)" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User name" ng-model="planningTypesNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Plant" class="form-control" ng-model="planningTypesNew.PlantId" ng-options="item.Value as item.Text for item in plantList" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <input type="text" name="Description" ng-model="planningTypesNew.Description" class="form-control" disabled tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Base Process(Production)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select submit-="true" ng-model="planningTypesNew.BaseProcessId" class="form-control" name="Base Process"
                                ng-options="item.Value as item.Text for item in processList" tabindex="10" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh"></i>Clear</button></li>
                </ul>
            </div>
        </div>


        <div class="col-md-12">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Edit</th>
                            <th>Plant</th>
                            <th>Entity</th>
                            <th>Planning Types</th>
                            <th>Description</th>
                            <th>User Define Name</th>
                            <th>Base Process(Production)</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in planningTypeses">
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li><button ng-click="Get(x.Id, $index);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></button></li>
                                    <li><button ng-click="GetPMData(x);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Product Master"><i class="glyphicon glyphicon-list"></i></button></li>
                                </ul>
                            </td>
                            <td>{{x.Plant}}</td>
                            <td>{{x.Entity}}</td>
                            <td>{{x.PlanningType}}</td>
                            <td>{{x.Description}}</td>
                            <td>{{x.UserName}}</td>
                            <td>{{x.BaseProcess}}</td>
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li><button ng-click="valuePass($index,x);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Delete"><i class="glyphicon glyphicon-trash"></i></button></li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
<div class="modal fade site-modal in" id="PMPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Product Master Info<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div clas="row">
                    <div id="GridSM" ej-grid e-datasource="productMasterList" e-templaterefresh="refreshTemplate"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-headertext="ALL" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="2"></div>
                            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="3"></div>
                            <div e-column e-field="Code" e-headertext="Code" e-width="4"></div>
                            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="10"></div>
                            <div e-column e-field="UserName" e-headertext="User Name" e-width="10"></div>
                            <div e-column e-field="ProductCategory" e-headertext="Product Category" e-width="12"></div>
                            <div e-column e-field="ProductSubCategory" e-headertext="Product SubCategory" e-width="5"></div>
                            <div e-column e-field="Product" e-headertext="Product" e-width="5"></div>
                        </div>
                    </div>

                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headschk" />
                    </script>
                </div>
                <div class="common-btn" style="padding-right: 15px;">
                    <ul class="list-inline text-right">
                        <li><button ng-click="SaveData();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Save</button></li>
                        <li><button ng-click="ClosePopUp();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
