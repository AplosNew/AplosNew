                            <tr>
                                <th>Size</th>
                                <th>Order Qty</th>
                                <th>Marker Ratio</th>
                                <th>Current Alloted Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="c in CutPlanDetailsR1List">
                                <td>{{c.Size}}</td>
                                <td>{{c.FinalQty}}</td>
                                <td><input type="number" name="Ratio" ng-model="c.Ratio1" ng-blur="Ratio1Change(c);" ng-click="" class="form-control" maxlength="100"></td>
                                <td>{{c.AllotedQtyR1}}</td>
                            </tr>
                        </tbody>
