        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">MasterPlan</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="CutPlanEditHeaderNew.MasterPlanId" name="MasterPlan" ng-options="item.Value as item.Text for item in MasterPlanList" ng-change="GetColorLists(CutPlanEditHeaderNew.MasterPlanId)">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label"> Select Color : </label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="CutPlanEditHeaderNew.ColorId" name="ColorId" ng-options="item.Value as item.Text for item in ColorLists">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li> <button ng-click="View();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> Go </button></li>
                </ul>
            </div>
        </div>
    </div>
