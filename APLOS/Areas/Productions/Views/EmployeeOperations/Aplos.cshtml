<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> {{title}}</h3>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm" id="ShowForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Entity</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="EntityId" name="Entity" ng-change="getProcess();getPo();getWkC();"
