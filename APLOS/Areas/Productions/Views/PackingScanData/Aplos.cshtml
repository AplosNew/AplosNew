                             @*e-recorddoubleclick="selectSignleEmployee"
                         e-rowdatabound="onrowdatabound"*@
                             e-allowfiltering="true"
                             e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowscrolling="true" @* e-minwidth="1100" e-minheight="500"*@
                             e-pagesettings-pagesize="25"
                             @*e-allowselection="true"*@
                             e-filtersettings-filterType="excel">
                            <div e-columns>
                                @*<div e-column e-field="Id" e-headertext="Id" e-width="100"></div>
                                <div e-column e-field="MasterId" e-headertext="Master Id" e-width="100"></div>*@
                                <div e-column e-field="ProductCode" e-headertext="Product Code" e-width="100"></div>
                                <div e-column e-field="POId" e-headertext="PO No" e-width="100"></div>
                                <div e-column e-field="LotNo" e-headertext="Lot No" e-width="80"></div>
                                <div e-column e-field="RefNo" e-headertext="Ref No" e-width="80"></div>
                                <div e-column e-field="Cones" e-headertext="Cones" e-width="100"></div>
                                <div e-column e-field="NetWeight" e-headertext="Net Weight" e-width="100"></div>
                                <div e-column e-field="GWeight" e-headertext="GWeight" e-width="100"></div>
                                <div e-column e-field="PackedBy" e-headertext="Packed By" e-width="100"></div>
                                <div e-column e-field="Shade" e-headertext="Shade" e-width="100"></div>
                                <div e-column e-field="Booked" e-headertext="Booked" e-width="100"></div>
                                <div e-column e-field="PackingId" e-headertext="Packing Id" e-width="100"></div>
                                <div e-column e-field="AddedBy" e-headertext="Added By" e-width="100"></div>
                                <div e-column e-field="AddedDate" e-headertext="Added Date" e-width="100"></div>
                                <div e-column e-field="UpdatedBy" e-headertext="Updated By" e-width="100"></div>
                                <div e-column e-field="UpdatedDate" e-headertext="Updated Date" e-width="100"></div>
                                <div e-column e-field="LocMasterId" e-headertext="LocMasterId" e-width="100"></div>
                                <div e-column e-field="IsDespatch" e-headertext="Despatch" e-width="100"></div>
                                <div e-column e-field="BookedDate" e-headertext="Booked Date" e-width="80" e-format="{0:dd-MMM-yyyy}" type="date"></div>
                                <div e-column e-field="InventoryReceiveDetailId" e-headertext="Inventory Receive Detail Id" e-width="100"></div>
                                <div e-column e-field="SalesId" e-headertext="Sales Id" e-width="100"></div>
                            </div>
