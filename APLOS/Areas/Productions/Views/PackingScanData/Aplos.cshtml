                             @*e-recorddoubleclick="selectSignleEmployee"
                         e-rowdatabound="onrowdatabound"*@
                             e-allowfiltering="true"
                             e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             @*e-allowscrolling="true" e-minwidth="1100" e-minheight="500"*@
                             e-pagesettings-pagesize="25"
                             @*e-allowselection="true"*@
                             e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="50"></div>
                                <div e-column e-field="BankName" e-headertext="Bank" e-width="80"></div>
                                <div e-column e-field="FromDate" e-headertext="From Date" e-width="60"></div>
                                <div e-column e-field="ToDate" e-headertext="To Date" e-width="60"></div>
                                <div e-column e-field="EmployeeName" e-headertext="By Whom" e-width="60"></div>
                                <div e-column e-field="OpeningBlance" e-headertext="Opening Balance" e-width="80"></div>
                                <div e-column e-field="ClosingBalance" e-headertext="Closing Balance" e-width="80"></div>
                                <div e-column e-field="BankStatementNo" e-headertext="Statement Ref No" e-width="100"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                                <div e-column e-headertext="Action" e-template="#ReportTemplate" e-width="100"></div>
                            </div>
                        </div>
                    </div>
                    <script id="ReportTemplate" type="text/template">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-center">
                                <li>
                                    <button ng-click="$parent.onClickReportDownloadExcel(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Excel">
                                        <i class="fa fa-file-excel-o"></i>
                                    </button>
                                    <button ng-click="$parent.onClickDeletePopUp(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Delete">
                                        <i class="glyphicon glyphicon-trash" style="color:orangered;"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </script>
                </div>
            </div>
        </div>
</div>

