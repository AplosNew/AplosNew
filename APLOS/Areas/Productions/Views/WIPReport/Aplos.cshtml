<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> WIP Report</h3>
<div class="form-elements form-horizontal" ng-form name="modelNewForm">
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-sm-12">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Date</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="wipDate" datepicker class="form-control" placeholder="dd-MM-yyyy">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                @*<label class="col-sm-4 control-label">Process</label>
                <div class="col-sm-8 text-left">
                    <div class="select-style">
                        <select name="EntityId" ng-model="ProcessId" class="col-sm-3 form-control"
                                ng-options="item.Id as item.UserName for item in prdProcessSetList" tabindex="1">
                        </select>
                    </div>
                </div>*@
            </div>

            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="GetWIPReport();" class="btn"><i class="glyphicon glyphicon-download"></i> WIP Report</button></li>
                        <li><button ng-click="GetWIPReportPivot();" class="btn"><i class="glyphicon glyphicon-download"></i> WIP Report(With Pivot)</button></li>
                    </ul>
                </div>
            </div>
         
        </div>
    </div>
</div>
