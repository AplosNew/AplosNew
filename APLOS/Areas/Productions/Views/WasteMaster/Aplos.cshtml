<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" tabindex="1" e-value="ModelNew.Sequence" e-width="100%" required />
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Process</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.ProcessId" name="Process"
                            ng-options="item.Value as item.Text for item in ProcessList" tabindex="3">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

        @*<div class="form-group">
            <label class="col-sm-4 control-label">Entity</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.EntityId" ng-change="getBudgets()" name="entity"
                            ng-options="item.Value as item.Text for item in EntityList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>*@


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Item Name" ng-model="ModelNew.ItemName" class="form-control" required maxlength="100" tabindex="5">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Category" ng-model="ModelNew.Category" class="form-control" maxlength="30" required tabindex="7" >
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Waste Type</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.WasteTypeId" name="Waste Type"
                            ng-options="item.Value as item.Text for item in WasteTypeList" tabindex="9">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="50" tabindex="11"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="30">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Budget<sup>*</sup></label>
            @*<div class="col-sm-1 show-message">
                <input type="text" name="Location" disabled ng-click="selectBudget()" class="form-control" maxlength="200" tabindex="5">

            </div>*@
            <div class="col-sm-6">
                <button ng-click="selectBudget()" class="btn" tabindex="4"><i class="glyphicon glyphicon-search"></i></button>
            </div>

        </div>
        @*<div class="form-group">
            <label class="col-sm-4 control-label">Company</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="CompanyId" ng-change="getPlant()" name="Company"
                            ng-options="item.Value as item.Text for item in CompanyList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>*@


        <div class="form-group">
            <label class="col-sm-4 control-label">UOM</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.UOMId" name="uom"
                            ng-options="item.Value as item.Text for item in UOMList" tabindex="6">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sub Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sub Category" ng-model="ModelNew.SubCategory" class="form-control" required tabindex="8" maxlength="10">
            </div>
        </div>
        

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Rate<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Standard Rate" style="text-align:left;" ng-model="ModelNew.StandardRate" class="form-control" required tabindex="10" maxlength="50">
            </div>
        </div>

        

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="row">
        <div id="budCh" ej-grid e-datasource="SelBudList" 
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" style="margin-top:10px;">
            <div e-columns>
                <div e-column e-field="Code" e-headertext="Budget Code" e-width="50"></div>
                <div e-column e-field="Position" e-headertext="Position" e-width="120"></div>
                <div e-column e-field="Company" e-headertext="Company" e-width="120"></div>
                <div e-column e-field="Plant" e-headertext="Plant" e-width="100"></div>
                <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>

            </div>
        </div>
    </div>
</div>
