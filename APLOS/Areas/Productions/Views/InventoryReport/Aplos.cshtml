
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Inventory Report</h3>
<div class="row">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" id="div_mm">
            <label class="col-sm-4 control-label">Material</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" ng-model="detailModel.MaterialMasterName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button tabindex="1" ng-click="getMaterialMasterSearchData();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" id="div_ar">
            <label class="col-sm-4 control-label">Article</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Finished Goods" ng-model="detailModel.ArticleName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button tabindex="1" ng-click="getArticleSearchList(detailModel.MaterialMasterId);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-2 col-md-2">
        <button class="btn" style="cursor:pointer;border-radius: 0%; background-color:#242841; color:white;" id="forward1" ng-click="getBankLedgerReport()"><i class="glyphicon glyphicon-arrow-down"></i> Download</button>
    </div>

    </div>

    @Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterPopUp.cshtml")
    @Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterArticleSearchPopUp.cshtml")
