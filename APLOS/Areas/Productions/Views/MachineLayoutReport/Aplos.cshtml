<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{FormTitle}}</h3>
<div class="form-elements form-horizontal" ng-form name="DailyTargetForm" id="MainDivId">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control"  id="ddlEntity" ng-model="DailyProductionTargetNew.EntityId" ng-change="loadProcessList(DailyProductionTargetNew.EntityId)" name="Entity" ng-options="item.Id as item.UserName for item in entityList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control"  ng-model="DailyProductionTargetNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in processList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Target Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text"  ng-model="DailyProductionTargetNew.ProductionDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                </div>
            </div>
        </div>
        <div class="form-group" style="margin-bottom: 25px;">
            <label class="col-sm-4 control-label"></label>

            <div class="col-sm-2" style="padding-right:0;">
                <button ng-click="getDailytarget();"  class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button>
            </div>
        </div>
    </div>
</div>
<div id="GridDTargetList" ej-grid e-datasource="DailyTargetList"
     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
    <div e-columns>
        <div e-column e-field="Line" e-headertext="Work Center" e-width="15"></div>
        <div e-column e-field="PRNo" e-headertext="PR No" e-width="10"></div>
        <div e-column e-field="Material" e-headertext="Material" e-width="15"></div>
        <div e-column e-field="Article" e-headertext="Article" e-width="15"></div>
        <div e-column e-field="ProductionBulletinId" e-headertext="Bul. Id" e-width="10"></div>
        <div e-column e-field="CustomerPONo" e-headertext="PO No." e-width="15"></div>
        <div e-column e-field="BuyerItemNo" e-headertext="Buyer Item No." e-width="15"></div>
        <div e-column e-field="ManPowerWithMachine" e-headertext="Manpower With MC" e-width="15"></div>
        <div e-column e-field="ManPowerWithHand" e-headertext="Manpower Without MC" e-width="15"></div>
        <div e-column e-field="SMV" e-headertext="SPT" e-width="10"></div>
        <div e-column e-field="TotalHour" e-headertext="Target Hours" e-width="15"></div>
        @*<div e-column e-template="#templateQuantitys" e-headertext="Target Per Hour" e-width="15"></div>*@
        <div e-column e-field="Quantity" e-headertext="Quantity" e-width="10"></div>
        <div e-column e-headertext="Report" e-template="#ShowButtons" e-width="18"></div>
    </div>
</div>
@*<script type="text/template" id="templateQuantitys">
    <input type="text" class="form-control" disabled e-focusout="$parent.CalculateTotalQuantity" ej-numerictextbox e-decimalplaces="0" e-minValue="0" e-enablertl="false" e-value="data.QuantityPerHour" e-width="100%" />
</script>*@
<script type="text/ng-template" id="ShowButtons">
    <div class="common-btn">
        <button ng-click="$parent.DownloadReport(data);" title="Report" class="btn">
            <i class="glyphicon glyphicon-download"></i>
        </button>
    </div>
</script>