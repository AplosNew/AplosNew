    <div class="common-btn" style="margin-top:10px;">
        <ul class="list-inline text-right">
            <li> <button ng-click="getData();" class="btn"><i class="glyphicon glyphicon-search"></i> View </button></li>
            <li> <button ng-click="downloadReport();" ng-disabled="masterData.length==0" class="btn"><i class="glyphicon glyphicon-download"></i> Stock Ageing Report </button></li>

        </ul>
    </div>
</div>

<div class="row">
    <div id="masterGrid" ej-grid e-datasource="masterData"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" style="margin-top:10px;">
        <div e-columns>
            <div e-column e-field="ProductCategory" e-headertext="Product Category" e-width="120"></div>
            <div e-column e-field="ProductSubCategory" e-headertext="Product SubCategory" e-width="120"></div>
            <div e-column e-field="Material" e-headertext="Material" e-width="180"></div>
            <div e-column e-field="Article" e-headertext="Article" e-width="200"></div>
            <div e-column e-field="ProductCode" e-headertext="Product Code" e-width="120"></div>
            <div e-column e-field="POId" e-headertext="PO" e-width="100"></div>
            <div e-column e-field="LotNo" e-headertext="Lot No" e-width="100"></div>
            <div e-column e-field="Customers" e-headertext="Customers" e-width="100"></div>
            <div e-column e-field="D15" e-headertext="Upto 15" e-width="70"></div>
            <div e-column e-field="D15T30" e-headertext="15 To 30" e-width="70"></div>
            <div e-column e-field="D30T60" e-headertext="30 To 60" e-width="70"></div>
            <div e-column e-field="D60T90" e-headertext="60 To 90" e-width="70"></div>
            <div e-column e-field="D90T120" e-headertext="90 To 120" e-width="70"></div>
            <div e-column e-field="D120T150" e-headertext="120 To 150" e-width="70"></div>
            <div e-column e-field="D150T180" e-headertext="150 to 180" e-width="70"></div>
            <div e-column e-field="D180T360" e-headertext="180 To 360" e-width="70"></div>
            <div e-column e-field="DG360" e-headertext=" > 360" e-width="70"></div>

        </div>
    </div>
</div>