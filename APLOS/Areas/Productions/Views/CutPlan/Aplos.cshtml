
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="form-horizontal" ng-form name="ModelNewForm">
    <div class="form-elements" id="Marker">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.ProductionEntityId" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Production Order<sup>*</sup></label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input type="text" name="ProductionOrder" ng-model="modelNew.ProductionOrderId" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="getProductionOrderPopUp();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="GridSOItemSelected" ng-init="chkinit()" ej-grid e-datasource="recipeMaterialListSelected"
             e-allowscrolling="true" e-actioncomplete="actionCompleteSelected"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-showsummary="true" e-allowselection="true" e-filtersettings-filterType="excel" @*e-summaryrows="summaryRows"*@ @*e-editsettings-allowediting="true" e-editsettings-editmode="batch"*@>
            <div e-columns>
                <div e-column e-field="SalesOrderId" e-headertext="SO. ID" e-width="120"></div>
                <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="180" e></div>
                <div e-column e-field="ArticleName" e-headertext="Article" e-width="180"></div>
                <div e-column e-field="DestinationName" e-headertext="Dest." e-width="80"></div>
                <div e-column e-field="DestinationDescription" e-headertext="Dest. Description" e-width="80"></div>
                <div e-column e-field="BuyerOrderNo" e-headertext="Customer Order#" e-width="100"></div>
                <div e-column e-field="BuyerReferenceNo" e-headertext="Customer Item#" e-width="100"></div>
                <div e-column e-field="DeliveryWeek" e-headertext="Del. Week" e-width="80"></div>
                <div e-column e-field="DeliveryDate" e-headertext="Del. Date" e-width="80"></div>
                <div e-column e-field="CommitmentDate" e-headertext="Commi.Date" e-width="80"></div>
                <div e-column e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
                <div e-column e-field="MasterOrderNo" e-headertext="M. Order No" e-width="120"></div>
                <div e-column e-field="Qty" e-headertext="Qty" e-width="80" e-textalign="right"></div>
                <div e-column e-field="Customer" e-headertext="Customer" e-width="180"></div>
                <div e-column e-field="Buyer" e-headertext="Buyer" e-width="180"></div>
                <div e-column e-field="OwnOrderNo" e-headertext="Own Order#" e-width="100"></div>
                <div e-column e-field="OwnReferenceNo" e-headertext="Own Item#" e-width="100"></div>
                <div e-column e-field="ProductName" e-headertext="Product" e-width="180" e></div>
                <div e-column e-field="ProductionGrouping" e-headertext="Product Grouping" e-width="120" e></div>
                <div e-column e-field="ShipmentModeName" e-headertext="Ship.Mode" e-width="80"></div>
                <div e-column e-field="PONumber" e-headertext="PO No" e-width="80"></div>
                <div e-column e-field="OrderStatusName" e-headertext="Ord. Status" e-width="80"></div>
                <div e-column e-field="OrderCategoryName" e-headertext="Ord. Cat." e-width="80"></div>
                <div e-column e-field="LSD" e-headertext="LSD" e-width="80"></div>
            </div>
        </div>
        <br />
        <div class="row" ng-show="recipeMaterialListSelected.length>0">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Marker</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" id="MarkerId" ng-model="MarkerId" ng-change="getSKU();">
                                <option value=""></option>
                                <option ng-repeat="option in MarkerList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-2 control-label">Marker SKU</label>
                    <label class="col-sm-2 control-label">{{CharacteristicsName}}</label>
                    <span class="col-sm-8">
                        <button ng-click="getFGCharacteristics();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-send"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="row" ng-show="Iteration ==1">
            <div class="col-md-8" ng-show="CalculationOption">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="flexRadioDefault" ng-model="CalculateOn" id="Round" value="Round">
                    <label class="form-check-label" for="Round">
                        Round
                    </label>

                    <input class="form-check-input" type="radio" name="flexRadioDefault" ng-model="CalculateOn" id="RoundUp" value="RoundUp">
                    <label class="form-check-label" for="RoundUp">
                        Round Up
                    </label>

                    <input class="form-check-input" type="radio" name="flexRadioDefault" ng-model="CalculateOn" id="Down" value="RoundDown">
                    <label class="form-check-label" for="Down">
                        Round Down
                    </label>
                </div>
            </div>
        </div>
        <div class="table-responsive modal-table" ng-show="FGCharacteristicsValueList.length>0 && Iteration ==1">
            @*&& Iteration ==1*@
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th></th>
                        <th>{{CharacteristicsName}}</th>
                        <th ng-repeat="x in FGCharacteristicsValueList">{{x.Characteristicsvalue}}</th>
                    </tr>
                    <tr>
                        <th></th>
                        <th>Ratio</th>
                        <th ng-repeat="x in FGCharacteristicsValueList">{{x.Ratio}}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in SkuValueList">
                        <td>
                            <div class="col-sm-12" style="margin-top: 10px;">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" name="WithFatherName" ng-model="x.IsSelect" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </td>
                        <td>{{x.Characteristicsvalue}}</td>
                        <td ng-repeat="y in x.Qty"><input disabled type="text" maxlength="50" name="Doc Ref" value="{{y.Qty}}" class="form-control" autocomplete="off"></td>
                    </tr>
                </tbody>
            </table>
            <br />
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li> <button ng-click="CalculatePly();" class="btn single-small-btn" tabindex="6"><i class="fa fa-calculator" aria-hidden="true"></i> Calculate</button></li>
                </ul>
            </div>
            <br />
        </div>
        <div class="table-responsive modal-table" ng-show="Clicked && Iteration ==1">
            @*&& Iteration == 1*@
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>{{CharacteristicsName}}</th>
                        <th></th>
                        <th></th>
                        <th ng-repeat="x in FGCharacteristicsValueList" style="text-align:center">{{x.Characteristicsvalue}}</th>
                    </tr>
                    <tr>
                        <th>Ratio</th>
                        <th>Min. Ply Value</th>
                        <th>{{CalculateOn}} Ply Value</th>
                        <th style="text-align:center" ng-repeat="x in FGCharacteristicsValueList">{{x.Ratio}}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in CalculatedSkuValueList">
                        <td>{{x.Characteristicsvalue}}</td>
                        <td>{{x.MinimumPlyActualValue}}</td>
                        <td>{{x.MinimumPlyOptionValue}}</td>
                        <td ng-repeat="y in x.Qty"><input disabled type="text" value="{{y.CalculatedPlyQty}}" class="form-control"></td>
                    </tr>
                </tbody>
            </table>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                </ul>
            </div>
        </div>
        <div class="table-responsive modal-table" ng-show="Iteration == 2">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>{{CharacteristicsName}}</th>
                        <th colspan="3" ng-repeat="x in FGCharacteristicsValueList" style="text-align:center">{{x.Characteristicsvalue}}</th>
                    </tr>
                    <tr>
                        <th>Ratio</th>
                        <th colspan="3" style="text-align:center" ng-repeat="x in FGCharacteristicsValueList">{{x.Ratio}}</th>
                    </tr>
                    <tr>
                        <th></th>
                        <th style="vertical-align: middle; text-align:center" ng-repeat-start="x in FGCharacteristicsValueList">Total</th>
                        <th style="vertical-align: middle; text-align:center">Calculated</th>
                        <th style="vertical-align: middle; text-align:center" ng-repeat-end>Available</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in CalculatedSkuValueList">
                        <td>{{x.Characteristicsvalue}}</td>
                        <td style="vertical-align: middle; text-align:center" ng-repeat-start="y in x.Qty"><input disabled type="text" value="{{y.Qty}}" class="form-control"></td>
                        <td style="vertical-align: middle; text-align:center"><input disabled type="text" value="{{y.CalculatedPlyQty}}" class="form-control"></td>
                        <td style="vertical-align: middle; text-align:center" ng-repeat-end><input disabled type="text" value="{{y.AvailableQty}}" class="form-control"></td>
                    </tr>
                </tbody>
            </table>
            <br />
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li> <button ng-click="CalculatePly();" class="btn single-small-btn" tabindex="6"><i class="fa fa-calculator" aria-hidden="true"></i> Calculate</button></li>
                </ul>
            </div>
            <br />
        </div>
    </div>
</div>
<div class="modal site-modal in" id="POItemPopup" role="dialog" data-backdrop="static">
    <div class="row">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">Production Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body text-center">
                    <div style="color:black;" id="Grid" ej-grid e-datasource="ProductionOrderList" e-allowscrolling="true" e-allowResizing="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-recorddoubleclick="SelectPOItem"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-type="string" e-field="POId" e-headertext="ProductionOrderNo" e-width="80"></div>
                            <div e-column e-type="string" e-field="BuyerOrder" e-headertext="Buyer Ord#" e-width="80"></div>
                            <div e-column e-type="string" e-field="OwnOrder" e-headertext="Own Ord#" e-width="80"></div>
                            <div e-column e-type="string" e-field="SONo" e-headertext="SONo" e-width="80"></div>
                            <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
                            <div e-column e-type="number" e-field="Qty" e-headertext="Qty" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="date" e-field="LSD" e-headertext="LSD" e-format="{0:dd-MMM-yyyy}" e-width="80"></div>
                            <div e-column e-type="string" e-field="CommitmentDate" e-headertext="Commitment Date" e-width="80"></div>
                            <div e-column e-type="string" e-field="ProductionStatus" e-headertext="Production Status" e-width="80"></div>
                            <div e-column e-type="string" e-field="BuyerItem" e-headertext="Buyer Item#" e-width="80"></div>
                            <div e-column e-type="string" e-field="OwnItem" e-headertext="Own Item#" e-width="80"></div>
                            <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Category" e-width="80"></div>
                            <div e-column e-type="string" e-field="Product" e-headertext="Product" e-width="80"></div>
                            <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                            <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                            <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material Master" e-width="80"></div>
                            <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="80"></div>
                            <div e-column e-type="string" e-field="PONumber" e-headertext="PO Number" e-width="80"></div>
                            <div e-column e-type="string" e-field="RequiredTimeUnit" e-headertext="Required Time Unit" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>