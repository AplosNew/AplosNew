                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="col-sm-10" style="padding:0px;">
                            <input type="text" name="User Name" ng-disabled="true" ng-model="cutplanNew.User" class="form-control" maxlength="100" required autocomplete="off">
                        </div>
                        <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                            <button ng-click="selectResponsiblePerson('User');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="col-sm-10" style="padding:0px;">
                            <input type="text" name="Responsible Person" ng-disabled="true" ng-model="cutplanNew.ResponsiblePerson" class="form-control" maxlength="100" required autocomplete="off">
                        </div>
                        <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                            <button ng-click="selectResponsiblePerson('Responsible');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <input type="text" name="Remarks" ng-model="cutplanNew.Remarks " class="form-control" maxlength="100" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-12 control-label"></label>
                <label class="col-sm-12 control-label"></label>
            </div>
            <div class="clearfix"></div>
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="modelNew.ProductionEntityId" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date</label>
                    <div class="col-sm-8">
                        <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="modelNew.FromDate" datepicker class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date</label>
                    <div class="col-sm-8">
                        <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="modelNew.ToDate" datepicker class="form-control" ng-change="">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="View();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> Go </button></li>
                    </ul>
                </div>
            </div>
        </div></div>
