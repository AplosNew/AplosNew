<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">WC/Work Stations Master Control</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Reasoning Details</a></li>
        <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="doc" role="tab" data-toggle="tab">Period Details</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <togglable name="{{title}}"></togglable>
        <div class="form-elements form-horizontal" ng-form name="ModelNewForm">
            <input type="hidden" ng-model="ModelNew.Id">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="UserName" ng-model="ModelNew.UserName" class="form-control" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">IsActive</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="ModelNew.IsActive" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" id="ProcessId" ng-model="ModelNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in processList" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 contro-label">Responsible Person<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="col-sm-10" style="padding:0px;">
                            <input type="text" name="Responsible Person" ng-disabled="true" ng-model="ModelNew.ResponsiblePerson" class="form-control" maxlength="100" required autocomplete="off">
                        </div>
                        <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                            <button ng-click="selectResponsiblePerson();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button ng-click="removeModal($index,ModelNew.Id);" ng-disabled="ModelNew.Id===null" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete </button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Columns Details</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div id="GridColumns" ej-grid e-datasource="WSMColumnsList" e-templaterefresh="refreshTemplateColumns" e-recorddoubleclick=""
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                                <div e-column e-field="ColumnInfo" e-headertext="Columns Info" e-width="100"></div>
                                <div e-column e-template="#ItemName" e-headertext="Item Name" e-width="100"></div>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateColumns" e-template="#checkboxTemplateColumns" e-textalign="center" e-width="30"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplateColumns">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Active" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplateColumns">
                            <input type="checkbox" id="headchk" />
                        </script>
                        <script type="text/template" id="ItemName">
                            <div class="col-sm-12" style="padding:0px;">
                                <input type="text" name="Item Name" ng-model="data.ItemName" ng-click="" class="form-control">
                            </div>
                        </script>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-disabled="ModelNew.Id===null" ng-click="SaveColumnsInfo();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive aplos-grid-toggle">
            <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="100" e-isprimarykey="true"></div>
                    <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="100"></div>
                    <div e-column e-field="UserName" e-headertext="User Name" e-width="100"></div>
                    <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                    <div e-column e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="100"></div>
                    <div e-column e-field="IsActive" e-headertext="IsActive" e-width="100"></div>
                </div>
            </div>
        </div>
    </div>
    <div role="tabpanel" ng-form="ReasoningDetailsForm" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" id="ProcessId" ng-model="ReasonNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in ProcessReasonList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Reason Name</label>
                <div class="col-sm-8">
                    <input type="text" name="Reason Name" ng-model="ReasonNew.ReasonName" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="ReasonSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                <li> <button ng-click="ReasonClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
        <div id="GridReason" ej-grid e-datasource="ReasonList" e-recorddoubleclick="GetReasonDetails"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="50"></div>
                <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                <div e-column e-field="ReasonName" e-headertext="Reason Name" e-width="100"></div>
            </div>
        </div>
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div id="GridControlPeriod" ej-grid e-datasource="ControlPeriodList" e-templaterefresh="refreshTemplateControlPeriod" e-recorddoubleclick=""
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-headertext="All" e-headertemplateid="#headerTemplateControlPeriod" e-template="#checkboxTemplateControlPeriod" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                    <div e-column e-field="ControlPeriodName" e-headertext="Control Period Name" e-width="100"></div>
                    <div e-column e-template="#FromDate" e-headertext="From Date" e-width="100"></div>
                    <div e-column e-template="#fromtime" e-headertext="From Time" e-width="100"></div>
                    <div e-column e-template="#ToDate" e-headertext="To Date" e-width="100"></div>
                    <div e-column e-template="#totime" e-headertext="To Time" e-width="100"></div>
                    <div e-column e-template="#Minute" e-headertext="Minute" e-width="100"></div>
                    <div e-column e-template="#Remarks" e-headertext="Remarks" e-width="200"></div>
                </div>
            </div>
            <script type="text/template" id="checkboxTemplateControlPeriod">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Active" />
            </script>
            <script type="text/x-jsrender" id="headerTemplateControlPeriod">
                <input type="checkbox" id="CPheadchk" />
            </script>
            <script type="text/template" id="ToDate">
                <div class="col-sm-12" style="padding:0px;">
                    <input type="text" id="To Date" ng-model="data.ToDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9">
                </div>
            </script>
            <script type="text/template" id="FromDate">
                <div class="col-sm-12" style="padding:0px;">
                    <input type="text" id="From Date" ng-model="data.FromDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9">
                </div>
            </script>
            <script type="text/template" id="fromtime">
                <input type="text" ej-timepicker e-value="data.FromTime" e-width="100%" />
            </script>
            <script type="text/template" id="totime">
                <input type="text" ej-timepicker e-value="data.ToTime" e-width="100%" />
            </script>
            <script type="text/template" id="Minute">
                <div class="col-sm-6" style="padding:0px;">
                    <input type="text" name="Minute" ng-model="data.Minute" class="form-control" required disabled tabindex="4" maxlength="50">
                </div>
            </script>
            <script type="text/template" id="Remarks">
                <div class="col-sm-10" style="padding:0px;">
                    <input type="text" name="Remarks" ng-model="data.Remarks" ng-click="" class="form-control" maxlength="200">
                </div>
            </script>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="ControlPeriodSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
            </ul>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmRemoveMaster" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>

<div class="modal fade site-modal in" id="ResponsiblePersonPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Employee List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Employee</p>
                        <div style="color:black;" id="GridResponsiblePersonPopUp" ej-grid e-datasource="EmployeeList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleEmployee">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="Id" e-visible="false" e-width="120"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="120"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="120"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="120"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="120"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeResponsiblePersonPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 46) {
            return false;
        }
        return true;
    }

            //onkeypress = "return isNumber(event)"
</script>
