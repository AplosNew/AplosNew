<ej-dialog id="dialogLineDesign"
           title="Line Design"
           e-enablemodal="true"
           e-showoninit="false"
           e-target="#MainDivId"
           e-width="1020"
           e-minheight="470">

    <link href="content/images/diagram/drawingtools/drawingtools.css" rel="stylesheet" />
    <style type="text/css">
        .e-toolbar > .e-horizontal.e-ul > li {
            margin: 5px;
            margin-left: .3px;
            margin-top: 0px;
            width: 36px;
            height: 25px;
        }

        .toolBarIconStyle {
            font-size: 17px;
            color: #6B6B6B;
            margin-top: 4px;
            margin-left: 8px;
        }

        .icon-colors {
            color: #ffffff;
        }

        .router {
            margin-top: 0px;
            margin-bottom: 0px;
        }
    </style>


    <div id="mainContent"></div>

    <div class="row" style="font-size:8pt;">
        <div class="col-xs-12">
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Date </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{DailyProductionTargetNew.ProductionDate}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">WC </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.Line}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Process </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.ProcessName}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">PR No </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.PRNo}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Material </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.Material}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Article </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.Article}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Buyer Item# </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.BuyerItemNo}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Resp. Prsn </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.ResponsiblePersonName}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Machine </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.ManPowerWithMachine}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Hand </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.ManPowerWithHand}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">SPT </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.SMV}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Total Hour </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.TotalHour}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Total Tgt. </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.Quantity}} </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Total Prod. </div><div class="col-xs-12 col-sm-3 col-sm-3 text-nowrap">: {{SelectedLine.ProductionQuantity}} </div>
        </div>
        <div class="col-xs-12">
            <div class="col-xs-12 col-sm-1 col-sm-1 text-nowrap">Cust.PO# </div><div class="col-xs-12 col-sm-11 col-sm-11">: {{SelectedLine.CustomerPONo}} </div>
        </div>
        <div class="col-xs-12">

        </div>




        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <ul class="list-inline">
                        <li> <button ng-click="GetListOfReplaceEmployees();" class="btn"><i class="glyphicon glyphicon-tags"></i> Replace Exception</button></li>
                        <li> <button ng-click="ConstructProductionEntry();" class="btn"><i class="glyphicon glyphicon-plus-sign"></i> Production Entry</button></li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6 text-right">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="ExplicitSave=true;UpdateEmployeeAttendanceAndProductionInfo();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save Layout</button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div id="ToolbarItem" ej-toolbar e-datasource="drawingToolsList" e-fields-tooltiptext="tooltiptext"
             e-width="100%" e-height="33px" e-fields-id="id" e-fields-spritecssclass="spriteCss" e-click="onItemclick"
             style="background-color: #ebeced; border-bottom-color: #bbbbbb; border-top-style: none; border-left-style: none; border-right-style: none">
        </div>
        <div>
            <ej-diagram id="diagram" e-contextmenu="contextMenu" e-contextmenuclick="onDiagramContextMenuClick" e-scrollsettings-horizontaloffset="0" e-scrollsettings-verticaloffset="0" e-height="400px" e-itemclick="itemClick" e-nodecollectionchange="nodeCollectionChange" e-width="100%">
            </ej-diagram>
        </div>
        <script id="htmlTemplate" type="text/template">
            <span ng-mouseover="showCardIcons=true;" ng-mouseleave="showCardIcons=false;">
                <div class="row">
                    <div class="col-xs-12 col-sm-2 col-md-2" ng-click="$parent.employeeButtonClick(this,'card');" style="width: 40px;">
                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{this.items[0].addInfo.EmpPicPath}}"
                             style="height:40px;width:40px;border:2px solid #efefef; border-radius:50%;" />
                    </div>
                    <div class="col-xs-12  col-sm-7 col-md-7" ng-click="$parent.employeeButtonClick(this,'card');" style="font-size:9pt;font-weight:bold;color:{{this.items[0].fontColor}};"> {{this.items[0].addInfo.EmployeeCode}} </div>
                    @*<div class="col-xs-12  col-sm-2 col-md-2" ng-click="$parent.employeeButtonClick(this);" style="font-size:9pt;font-weight:bold;color:{{this.items[0].DayColor}};"> {{this.items[0].addInfo.DayStatus}} </div>*@
                    <div class="col-xs-12  col-sm-2 col-md-2">
                        <div class="common-btn" ng-show="showCardIcons" style="position:fixed;top:0;left:140px;float:right;">
                            <ul class="list-inline text-right small">
                                <li>
                                    <button ng-click="$parent.ViewEmployeeCard(this);" class="btn small" style="height: 20px; width: 20px; padding: 0px; margin: 0px;">
                                        <i class="glyphicon glyphicon-th-list"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12  col-sm-9 col-md-9 text-nowrap" ng-click="$parent.employeeButtonClick(this,'card');" style="font-size:6pt;font-weight:bold;color:{{this.items[0].fontColor}};"> {{this.items[0].addInfo.EmployeeName}} </div>

                </div>
                <div class="row">
                    <div class="col-xs-12 col-sm-9 col-md-9" style="font-size:6pt;color:{{this.items[0].fontColor}};">
                        <span class="glyphicon glyphicon-wrench"></span>    <span title="{{this.items[0].addInfo.OperationVariationDesc?this.items[0].addInfo.OperationVariationDesc:'[select operation]'}}">
                            {{this.items[0].addInfo.OperationVariationDesc?this.items[0].addInfo.OperationVariationDesc:'[select operation]'}}
                        </span>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="common-btn">
                            <ul class="list-inline text-right small">
                                <li>
                                    <button ng-click="$parent.operationButtonClick(this);" class="btn small" style="height: 20px; width: 20px; padding: 0px; margin: 0px;">
                                        <i class="glyphicon glyphicon-search"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12" style="font-size:6pt;color:{{this.items[0].fontColor}};">
                        <span class="glyphicon glyphicon-cog"></span>  <span title=" {{this.items[0].addInfo.ArticleId?this.items[0].addInfo.ArticleShortName:'[select machine]'}}">
                            {{this.items[0].addInfo.ArticleId?this.items[0].addInfo.ArticleShortName:'[select machine]'}}
                        </span>
                    </div>

                </div>

                <div class="row" style="padding-top:6px;">
                    <div class="col-xs-12 col-sm-9 col-md-9" style="white-space: nowrap; overflow: hidden; font-size: 6pt;color:{{this.items[0].fontColor}};">
                        <span title=" {{this.items[0].addInfo.FixedAssetRegisterId?this.items[0].addInfo.FixedAssetRegisterDesc:'[select machine register]'}}">
                            {{this.items[0].addInfo.FixedAssetRegisterId?this.items[0].addInfo.FixedAssetRegisterDesc:'[select machine register]'}}
                        </span>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="common-btn">
                            <ul class="list-inline text-right small">
                                <li>
                                    <button ng-click="$parent.FixedAssetButtonClick(this);" class="btn small" style="height: 20px; width: 20px; padding: 0px; margin: 0px;">
                                        <i class="glyphicon glyphicon-search"></i>
                                    </button>
                                </li>
                            </ul>

                        </div>
                    </div>
                </div>
                <div class="col-xs-12" style="padding:0px;margin:0px;font-size:8pt; font-weight: bolder;  position: absolute; bottom: 0px; left: 0px; float: left;">
                    <div class="col-xs-12  col-sm-2 col-md-2 center-block" style="padding-left:4px; border: 1px solid #ffffff; background-color: yellow; color: blue;">
                        {{this.items[0].addInfo.ProductionQuantity}}
                    </div>
                    <div class="col-xs-12  col-sm-2 col-md-2 center-block" style="padding-left: 4px; border: 1px solid #ffffff; background-color: blue; color: white; ">
                        {{this.items[0].addInfo.MachineOrHand}}
                    </div>
                    <div class="col-xs-12  col-sm-2 col-md-2 center-block" style="padding-left: 4px; border: 1px solid #ffffff; background-color: {{this.items[0].addInfo.DayColor}}; color: white;">
                        [{{this.items[0].addInfo.DayStatus}}]
                    </div>

                </div>
            </span>
        </script>


        <script id="svgTemplate" type="text/x-jsrender">
            <svg version="1.0" xmlns="http://www.w3.org/2000/svg" width="350.000000pt" height="229.000000pt" viewBox="0 0 350.000000 229.000000" preserveAspectRatio="xMidYMid meet">
                <g transform="translate(0.000000,229.000000) scale(0.100000,-0.100000)" fill="#de6ca9" stroke="none">
                    <path d="M0 23l8-8 17 17 7-7-17-17 8-8h-23v23z"></path>
                </g>

            </svg>
        </script>


</ej-dialog>

<ej-dialog id="dialogEditNode" title="Color" e-target="#dialogLineDesign" e-enablemodal="true" e-showoninit="false" e-width="500">
    <div class="row">
        <div class="col-sm-12 col-sm-2 col-sm-2" ng-show="selectednode.target.hasOwnProperty('fontColor')"> Font</div>
        <div class="col-sm-12 col-sm-2 col-sm-2" ng-show="selectednode.target.hasOwnProperty('fontColor')">
            <input ej-colorpicker e-field="fontColor" e-change="UpdateColor" e-value="selectednode.target.fontColor" e-modeltype="palette" />
        </div>
        <div class="col-sm-12 col-sm-2 col-sm-2"> Back</div>
        <div class="col-sm-12 col-sm-2 col-sm-2">
            <input ej-colorpicker e-field="fillColor" e-change="UpdateColor" e-value="selectednode.target.fillColor" e-modeltype="palette" />
        </div>
        <div class="col-sm-12 col-sm-2 col-sm-2"> Border</div>
        <div class="col-sm-12 col-sm-2 col-sm-2">
            <input ej-colorpicker e-field="borderColor" e-change="UpdateColor" e-value="selectednode.target.borderColor" e-modeltype="palette" />
        </div>


    </div>
</ej-dialog>