<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Production Planning Report</h3>
<div class="form-elements form-horizontal" ng-form name="ProductionRelayForm">
    <div class="row">
        <div class="col-xs-12">
           
                <div class="col-md-12">
                    <div class="col-xs-2 col-sm-2 col-md-2">
                        <div class="col-md-12">
                            <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-enablefiltersearch="true" e-value="year" e-databound="SelectDefaultValue" e-fields-value="Text" e-fields-text="Text" e-width="100%" e-change="empGridShow" />
                        </div>
                    </div>
                    <div class="col-xs-2 col-sm-2 col-md-2">
                        <div class="col-md-12">
                            <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-value="month" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-change="empGridShow" />
                        </div>
                    </div>
                    <div class="col-xs- col-sm-1 col-md-1">
                        <div class="form-group">
                            <div class="common-btn">
                                <button ng-click="ProductionPlanningReport();" class="btn small" style="height: 27px; width: 120px; padding: 0px; margin: 0px;font-weight:bolder;">
                                    Download Report
                                </button>
                            </div>                          
                        </div>
                    </div>
        
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
