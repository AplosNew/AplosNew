<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">


        <div class="form-group">
            <label class="col-sm-4 control-label">SKU 1</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.SKU1Id" name="SKU1"
                            ng-options="item.Value as item.Text for item in skuOneList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">SKU 2</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.SKU2Id" name="SKU2"
                            ng-options="item.Value as item.Text for item in skuTwoList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Standard Qty</label>
            <div class="col-sm-8">
                <input type="text" onkeypress="return isNumber(event)" ng-model="ModelNew.StandardQty" class="form-control" maxlength="100" tabindex="2">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Min Qty</label>
            <div class="col-sm-8">
                <input type="text" onkeypress="return isNumber(event)" ng-model="ModelNew.MinQty" class="form-control" maxlength="100" tabindex="2">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Net Weight/Piece</label>
            <div class="col-sm-8">
                <input type="text" onkeypress="return isNumber(event)" ng-model="ModelNew.NetWeightPerPiece" class="form-control" maxlength="100" tabindex="2">
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="UserName" ng-model="ModelNew.UserName" class="form-control" maxlength="50" required tabindex="3">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Category" ng-model="ModelNew.ShortName" class="form-control" maxlength="10" required tabindex="3">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Packet Wt</label>
            <div class="col-sm-8">
                <input type="text" onkeypress="return isNumber(event)" ng-model="ModelNew.PacketWt" class="form-control" maxlength="100" tabindex="2">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Max Qty</label>
            <div class="col-sm-8">
                <input type="text" onkeypress="return isNumber(event)" ng-model="ModelNew.MaxQty" class="form-control" maxlength="100" tabindex="2">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="50" tabindex="6"></textarea>
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" 
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="SKU1" e-headertext="SKU1" e-width="2"></div>
            <div e-column e-field="SKU2" e-headertext="SKU2" e-width="3"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="3"></div>
            <div e-column e-field="StandardQty" e-headertext="Standard Qty" e-type="number" e-width="3"></div>
            <div e-column e-field="MinQty" e-headertext="Min Qty" e-type="number" e-width="3"></div>
            <div e-column e-field="MaxQty" e-headertext="Max Qty" e-type="number" e-width="3"></div>
            <div e-column e-field="NetWeightPerPiece" e-headertext="Net Weight/Piece" e-type="number" e-width="3"></div>
            <div e-column e-field="PacketWt" e-headertext="Packet Wt" e-type="number" e-width="3"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-type="number" e-width="3"></div>

        </div>
    </div>
</div>
<confirm-modal></confirm-modal>

<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
@*<confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to save without any shifts ?" data-ng-click-left-button="restoreChildShifts();" data-ng-click-right-button="SaveShifts();"></confirm-archive-generic>*@

<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 46) {
            return false;
        }
        return true;
    }

    //onkeypress = "return isNumber(event)"
</script>