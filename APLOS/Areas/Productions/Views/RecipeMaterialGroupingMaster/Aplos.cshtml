                                    <div class="form-group form-horizontal">
                                        <label class="col-sm-4 control-label"> Value</label>
                                        <div class="col-sm-8">
                                            <input type="number" name="Value" ng-model="modelNew.Value" class="form-control text-right" tabindex="23" style="width: 80px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">

                            <div class="form-group" id="div_rmValue">
                                <div class="col-sm-12 show-message">
                                    <div class="form-group form-horizontal">
                                        <div class="col-sm-6">
                                            <label class="control-label" style="margin-left: -53px;"> UoM</label>
                                            <div class="select-style" style="margin: -24px;">
                                                <select id="Uom" name="Uom" class="form-control" tabindex="5" ng-model="modelNew.UomId" ng-options="item.Value as item.Text for item in uomList"></select>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <span class="input-group-btn">
                                                <button ng-click="addRawMaterial();" class="btn single-small-btn" tabindex="24">Add</button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Ingredient (MM)</th>
                                            <th>Article</th>
                                            <th>RM Value</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr dir-paginate="x in rawMaterialList |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'rawMaterialList'">
                                            <td>{{x.MaterialMasterName}}</td>
                                            <td>{{x.ArticleName}}</td>
                                            <td>{{x.Value +" "+ x.Description}}</td>
                                            <td class="text-right">
