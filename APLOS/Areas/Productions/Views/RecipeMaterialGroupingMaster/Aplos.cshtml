                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="closeRawPopUp();" class="btn" tabindex="25"> Close</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
    </div>
</div>
<div class="modal fade site-modal in" id="materialMasterbyTypePopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                {{materialTitle}}<button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="mmPopUpParameters.searchBy">
                                            <option ng-repeat="option in searchMaterialMasterList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="mmPopUpParameters.search" ng-enter="getMaterialMasterbyTypeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getMaterialMasterbyTypeData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped text-left">
                        <thead>
                            <tr>
                                <th>Material Type</th>
                                <th>Material Group</th>
                                <th>Product</th>
                                <th>Code</th>
                                <th>Material Name</th>
                                <th>Id</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in materialMasterbyTypeList  |itemsPerPage:$root.pageSize" pagination-id="metaData.name + 'materialMasterbyTypeList'"
                                total-items="mmPopUpParameters.total_count" ng-dblclick="selectMaterialByType(x);">
                                <td>{{x.MaterialTypeName}}</td>
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.ProductMasterName}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.Id}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls pagination-id="metaData.name + 'materialMasterbyTypeList'"
                                             max-size="2"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getMaterialMasterbyTypeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="articleSearchPop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Article<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body text-center">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="articlePopUpParameters.searchBy">
                                            <option ng-repeat="option in searchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="articlePopUpParameters.search" ng-enter="loadArticleData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadArticleData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in dataPlate |itemsPerPage:articlePopUpParameters.pageSize" total-items="articlePopUpParameters.total_count"
                                pagination-id="metaData.name + 'dataPlate'" ng-dblclick="selectArticle(x);">
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="2"
                                             pagination-id="metaData.name + 'dataPlate'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadArticleData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="attributeValuePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Attribute Value <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="valueParameters.searchBy">
                                            <option ng-repeat="option in searchvalueList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="valueParameters.search" ng-enter="getValueData();">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getValueData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Define Name</th>
                                <th>Default</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in valueList|itemsPerPage:valueParameters.pageSize" pagination-id="metaData.name + 'valueList'"
                                total-items="valueParameters.total_count" ng-dblclick="getAttrValue(x);">
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.IsDefault?'Yes':'No'}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls pagination-id="metaData.name + 'valueList'"
                                             max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getValueData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button type="button" class="btn btn-default" ng-click="closeValuePopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic data-modalid="confirmDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteRow()"></confirm-archive-generic>