<togglable name="Recipe Material Group"></togglable>
<div class="form-elements form-horizontal" ng-form name="recipeMaterialGroupingMasterNewForm">
    <input type="hidden" ng-model="recipeMaterialGroupingMasterNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Sequence" ng-model="recipeMaterialGroupingMasterNew.Sequence" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" ng-model="recipeMaterialGroupingMasterNew.ShortName" class="form-control" maxlength="3" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="recipeMaterialGroupingMasterNew.UserName" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Quantity</label>
            <div class="col-sm-8">
                <input type="number" name="Qty" ng-model="recipeMaterialGroupingMasterNew.QtyValue" class="form-control" tabindex="7" maxlength="50">
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="recipeMaterialGroupingMasterNew.Code" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="recipeMaterialGroupingMasterNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">UoM<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select name="Uom" id="uomdrp" class="form-control" tabindex="6" ng-model="recipeMaterialGroupingMasterNew.UomId" ng-options="item.Value as item.Text for item in UnitOfMeasurementList"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="recipeMaterialGroupingMasterNew.Active" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
   
    <div class="row">
        <div class="col-sm-12">
            <div class="common-btn">
                <button ng-click="rawPopUp();" ng-disabled="recipeMaterialGroupingMasterNew.Id===null" class="btn small"><i class="glyphicon glyphicon-plus"></i> Add Line Item</button>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-sm-12">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Ingredient (MM)</th>
                            <th>Article</th>
                            <th>RM Value</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="x in rawMaterialList |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'rawMaterialList'">
                            <td>{{x.MaterialMasterName}}</td>
                            <td>{{x.ArticleName}}</td>
                            <td>{{x.Value +" "+ x.Description}}</td>
                            <td class="text-right">
                                <ul class="list-inline">
                                    <li><button data-target="#confirmDelete" ng-click="DeleteRawMaterial(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Delete" tooltip><i class="glyphicon glyphicon-remove"></i></button></li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Define Name</th>
                <th>Quantity</th>
                <th>UoM</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in recipeMaterialGroupingMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.QtyValue}}</td>
                <td>{{x.Uom}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="rawMaterialPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
                <div class="modal-header"> Raw Material<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="col-xs-12">
                    <label class="control-label col-xs-6"> Quantity : {{QtyValue}}</label>
                </div>
                @*<div class="col-xs-6">
                    <label class="control-label col-xs-6" > UoM</label>
                    <input name="Value" id="=uomdrp" ng-model="recipeMaterialGroupingMasterNew.UomId" class="form-control text-right" tabindex="23" readonly style="width: 80px;  height:30px;">
                </div>*@
                    <div class="modal-body form-horizontal form-elements">

                        <div class="col-md-3">
                            <div class="row form-group" id="div_material" style="margin-left: -35px;">
                                <label class="col-sm-4 control-label">Raw Material</label>
                                <div class="col-sm-8 show-message">
                                    <div class="input-group">
                                        <input type="text" ng-model="modelNew.MaterialMasterName" class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button ng-click="getMaterialMasterbyTypePopUp('');" class="btn single-small-btn" tabindex="21"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
