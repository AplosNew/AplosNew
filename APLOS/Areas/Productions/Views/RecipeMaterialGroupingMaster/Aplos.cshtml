                                <div class="col-sm-8 show-message">
                                    <div class="input-group">
                                        <input type="text" name="Article" ng-model="modelNew.ArticleName" class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button ng-disabled="!hasArticle" ng-click="getArticleSearchList(modelNew.MaterialMasterId);" class="btn single-small-btn" tabindex="22"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="col-md-3">

                            <div class="form-group" id="div_rmValue">
