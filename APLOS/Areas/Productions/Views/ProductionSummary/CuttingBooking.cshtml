<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> Production Booking Cutting</h3>
<p style="color:blue;font-size:11px">This screen has Entity and Process Level access</p>
<div class="form-element-ctrl form-horizontal row" ng-form="modelForm" id="mainform">
    <div class="col-xs-12">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="IsGo" ng-model="productionSummaryNew.EntityId" ng-change="loadProcessList(productionSummaryNew.EntityId)" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-disabled="IsGo" ng-model="productionSummaryNew.ProductionDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                </div>

            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="IsGo" ng-model="productionSummaryNew.ProcessId" ng-change="getProdLevel();GetShiftList();" name="ProcessId" ng-options="item.Value as item.Text for item in processList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="IsGo" ng-model="productionSummaryNew.ProductionShiftId" name="Shift" ng-options="item.Value as item.Text for item in shiftList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="masterGo(true);loadWC(productionSummaryNew.ProcessId,productionSummaryNew.EntityId,productionSummaryNew.ProductionShiftId);SalesOrderStatusloadfilters();" ng-disabled="disGo" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button></li>
                        @*<li><button ng-click="masterGo(true);SalesOrderStatusloadfilters();" ng-disabled="disGo" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button></li>*@
                        <li> <button ng-click="SetBack(false);" class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-left"></i> Back</button>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12">
        <div class="row">
            <div id="filters">
            </div>
        </div>

    </div>
    <div class="col-xs-12">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors ng-show="IsGo===true">
                <label class="col-sm-4 control-label">Cut Plan<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="productionSummaryNew.CutPlanId" name="Cut Plan" ng-options="item.Id as item.UserName for item in CutPlantList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

        </div>
    </div>
    <div class="col-xs-12">
        <div id="GridCP" ej-grid e-datasource="cutMasterPlanList"
             e-allowscrolling="true" e-summaryrows="summaryRows"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-showsummary="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="MasterOrderNo" e-headertext="M. Order No" e-width="120"></div>
                <div e-column e-field="SONo" e-headertext="SO. ID" e-width="120"></div>
                <div e-column e-field="Customer" e-headertext="Customer" e-width="180"></div>
                <div e-column e-field="Buyer" e-headertext="Buyer" e-width="180"></div>
                <div e-column e-field="BuyerOrderNo" e-headertext="Buyer Order#" e-width="100"></div>
                <div e-column e-field="OwnOrderNo" e-headertext="Own Order#" e-width="100"></div>
                <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="180" e></div>
                <div e-column e-field="ArticleName" e-headertext="Article" e-width="180"></div>

                <div e-column e-field="BuyerReferenceNo" e-headertext="Buyer Item#" e-width="100"></div>
                <div e-column e-field="OwnReferenceNo" e-headertext="Own Item#" e-width="100"></div>

                <div e-column e-field="ProductName" e-headertext="Product" e-width="180" e></div>
                <div e-column e-field="ProductionGrouping" e-headertext="Product Grouping" e-width="120" e></div>


                <div e-column e-field="DeliveryDate" e-headertext="Del. Date" e-width="80"></div>
                <div e-column e-field="CommitmentDate" e-headertext="Commi.Date" e-width="80"></div>
                <div e-column e-field="DestinationName" e-headertext="Dest." e-width="80"></div>
                <div e-column e-field="ShipmentModeName" e-headertext="Ship.Mode" e-width="80"></div>
                <div e-column e-field="PONumber" e-headertext="PO No" e-width="80"></div>

                <div e-column e-field="OrderStatusName" e-headertext="Ord. Status" e-width="80"></div>
                <div e-column e-field="OrderCategoryName" e-headertext="Ord. Cat." e-width="80"></div>
                <div e-column e-field="Qty" e-headertext="Qty" e-width="80" e-textalign="right"></div>
                <div e-column e-field="Rate" e-headertext="Rate" e-width="80" e-textalign="right"></div>
                <div e-column e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>

            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors ng-show="IsGo===true">
            <label class="col-sm-4 control-label">Work Center<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="productionSummaryNew.WorkCenterMasterId" name="Work Center" ng-options="item.Value as item.Text for item in wcList" ng-change="getLineGrid();getProdQty();getMentorAndRespPersonByWCM();" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors ng-show="IsGo===true">

            <label class="col-sm-4 control-label">Grade<sup>*</sup></label>
            <div class="col-sm-8 show-message" style="padding-right:-1px;">
                <div class="select-style">
                    <select class="form-control" ng-model="productionSummaryNew.ProductionGrade" placeholder="Grade" name="ProductionGrade" ng-options="item.Value as item.Text for item in gradeList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="IsGo===true">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="1" ng-model="productionSummaryNew.Remarks" name="Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" ng-show="IsGo===true">
            <label class="col-sm-4 control-label">Mentor</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Mentor" ng-model="productionSummaryNew.MentorName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp('Mentor');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        <button ng-click="ClearEmployee('Mentor')" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="IsGo===true">
            <label class="col-sm-4 control-label">Responsible Person</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Responsible Person" ng-model="productionSummaryNew.ResponsiblePersonName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp('ResponsiblePerson');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        <button ng-click="ClearEmployee('ResponsiblePerson')" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="IsGo===true">
            <label class="col-sm-4 control-label">CheckedBy</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Responsible Person" ng-model="productionSummaryNew.CheckedByName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp('CheckedBy');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        <button ng-click="ClearEmployee('CheckedBy')" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="IsGo===true">
            <div class="common-btn" ng-show="IsGo===true">
                <ul class="list-inline text-right">
                    <li><button ng-click="GenerateBundleTicket();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>Standard Bindle Size</button></li>
                </ul>
            </div>
        </div>
    </div>

</div>

<div class="clearfix"></div>
<div class="common-btn" ng-show="IsGo===true">
    <ul class="list-inline text-right">
        <li><button ng-click="SaveMaster();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
        <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
    </ul>
</div>
<div class="table-responsive modal-table" ng-show="IsGo===true && LineGridList.length>0">
    <table class="table table-striped text-left" ng-show="productionSummaryNew.ProductionBookingLevel!=='ProductionOrder'">
        <thead>
            <tr>
                @*<th ng-repeat="h in SearchLineGridList">{{h.Text}}</th>*@
                <th>Action</th>
                <th>Production Order</th>
                <th ng-show="productionSummaryNew.ProductionBookingLevel=='MasterOrderItem'">Master Order</th>
                <th ng-show="productionSummaryNew.ProductionBookingLevel=='MasterOrderItem'">Master Order Item</th>
                <th ng-show="productionSummaryNew.ProductionBookingLevel=='ProductCode'">Product Code</th>
                <th ng-show="productionSummaryNew.ProductionBookingLevel=='SalesOrder'">Sales Order</th>

                <th>Buyer Order</th>
                <th>Own Order</th>
                <th>Buyer Item</th>
                <th>Own Item</th>

                <th>SO Desc</th>
                <th>Lot Number</th>

                <th>Material</th>
                <th>Article</th>
                <th>Grade</th>
                <th>Produced Qty</th>
                <th>Production Booking Period</th>
                <th>Customer</th>
                <th>PO Number</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in LineGridList">
                <td>
                    <ul class="list-inline action-list">
                        <li>
                            <button ng-click="Get(x.Id, $index);" class="btn-action tooltip-here" data-placement="top" title="Edit" tooltip><i class="glyphicon glyphicon-pencil"></i></button>
                            <button ng-click="deleteMaster(x)" class="btn-action tooltip-here" data-placement="top" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i></button>
                        </li>
                    </ul>
                </td>
                <td>{{x.ProductionOrderId}}</td>
                <td ng-show="productionSummaryNew.ProductionBookingLevel=='MasterOrderItem'">{{x.MasterOrderNo}}</td>
                <td ng-show="productionSummaryNew.ProductionBookingLevel=='MasterOrderItem'">{{x.MOrderLineNo}}</td>
                <td ng-show="productionSummaryNew.ProductionBookingLevel=='ProductCode'">{{x.ProductCode}}</td>
                <td ng-show="productionSummaryNew.ProductionBookingLevel=='SalesOrder'">{{x.SalesOrderId}}</td>

                <td>{{x.BuyerOrder}}</td>
                <td>{{x.OwnOrder}}</td>
                <td>{{x.BuyerItem}}</td>
                <td>{{x.OwnItem}}</td>

                <td>{{x.Description}}</td>
                <td>{{x.LotNumber}}</td>

                <td>{{x.MaterialMaster}}</td>
                <td>{{x.Article}}</td>
                <td>{{x.ProductionGrade}}</td>
                <td>{{x.Quantity}}</td>
                <td>{{x.ProductionBookingPeriod}}</td>
                <td>{{x.Customer}}</td>
                <td>{{x.PONumber}}</td>

            </tr>
        </tbody>
    </table>
    <table class="table table-striped text-left" ng-show="productionSummaryNew.ProductionBookingLevel==='ProductionOrder'">
        <thead>
            <tr>
                @*<th ng-repeat="h in SearchLineGridList">{{h.Text}}</th>*@
                <th>Action</th>
                <th>Production Order</th>
                <th>Production Date</th>
                <th>Buyer Order</th>
                <th>Own Order</th>
                <th>Buyer Item</th>
                <th>Own Item</th>
                <th>Lot Number</th>
                <th>Grade</th>
                <th>Produced Qty</th>
                <th>Production Booking Period</th>
                @*<th>SKU</th>*@
            </tr>
        </thead>
        <tbody>
            @*<tr dir-paginate="x in LineGridList  |itemsPerPage:$root.pageSize" pagination-id="metaData.name + 'LineGridList'"
                total-items="mmPopUpParameters.total_count" ng-dblclick="selectLineItem(x);">*@
            <tr ng-repeat="x in LineGridList">
                <td>
                    <ul class="list-inline action-list">
                        <li>
                            <button ng-click="Get(x.Id, $index)" class="btn-action tooltip-here" data-placement="top" title="Edit" tooltip><i class="glyphicon glyphicon-pencil"></i></button>
                            <button ng-click="deleteMaster(x)" class="btn-action tooltip-here" data-placement="top" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i></button>
                        </li>
                    </ul>
                </td>
                <td>{{x.ProductionOrderId}}</td>
                <td>{{x.ProductionDate}}</td>
                <td>{{x.BuyerOrder}}</td>
                <td>{{x.OwnOrder}}</td>
                <td>{{x.BuyerItem}}</td>
                <td>{{x.OwnItem}}</td>
                <td>{{x.LotNumber}}</td>
                <td>{{x.ProductionGrade}}</td>
                <td>{{x.Quantity}}</td>
                <td>{{x.ProductionBookingPeriod}}</td>
                @*<td>
                        <button class="btn single-small-btn" ng-disabled="productionSummaryNew.ProductionBookingLevel==='ProductionOrder' || productionSummaryNew.ProductionBookingLevel==='SalesOrder'"><i class="cr-icon glyphicon glyphicon-list"> </i></button>
                    </td>*@
            </tr>
        </tbody>
    </table>
</div>

<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">{{popUpTitle}}<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in employeeFilterList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Designation</th>
                                <th>Entity</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-click="selectEmployeePopUp($index, x.SystemId)" ng-class="{selected : x.SystemId == selectedEmployee}" ng-dblclick="closeEmployeePopUp();" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOB | dateFiltering}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.EmploymentType}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'employeeList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>
