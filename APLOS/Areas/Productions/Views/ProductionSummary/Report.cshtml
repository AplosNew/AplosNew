<div id="Test">
    <h3 class="site-heading"><span class="glyphicon glyphicon-file"></span> {{FormTitle}}</h3>
    <style type="text/css">
        #myDIV {
            width: 100%;
            text-align: center;
        }

        .e-gridheader .e-headercell { /* grid header color and grid row select color*/
            background: #a2f1ff;
            color: #080076;
            min-height: 100%;
            border-bottom-color: #8B4513;
        }

        .modal-table {
            position: relative;
            height: 300px;
            overflow: auto;
        }

        .modal {
            overflow-y: auto;
        }

        .table-responsive {
            display: block;
        }

        td, th {
            padding: 10px;
        }
    </style>

    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Process Wise</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Perameter Wise</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <fieldset class="scheduler-border">
                    <div class="form-elements form-horizontal" ng-form="from0">
                        <div class="row">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <input id="entityList" ng-model="EntityId" e-watermarktext="Entity" class="form-control" ej-dropdownlist e-enablefiltersearch="true" e-create="create" e-change="getProcessDataList" e-multiselectmode="visualmode" e-datasource="entityList" e-fields-value="Id" e-fields-text="UserName" required tabindex="1" e-showcheckbox="true" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="From Date" ng-model="fromDate" datepicker class="form-control" required tabindex="3">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="To Date" ng-model="toDate" datepicker class="form-control" required tabindex="4">
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <input id="process" e-watermarktext="Process" ng-model="ProcessId" class="form-control" ej-dropdownlist e-enablefiltersearch="true" e-create="create" e-multiselectmode="visualmode" e-datasource="processDataList" e-fields-value="Value" e-fields-text="Text" required tabindex="2" e-showcheckbox="true" />
                                    </div>

                                </div>

                                
                            </div>
                            <div class="col-lg-12">
                                <div class="col-md-2 text-right">
                                    <ul>
                                        <li><button type="button" class="btn single-btn" ng-click="ProcessWiseReport()" style="margin-top:10px;"><i class="glyphicon glyphicon-arrow-down"></i>Report</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div id="MainDiv">
                    <fieldset class="scheduler-border">
                        <div class="form-elements form-horizontal" ng-form="from1">
                            <div class="row">
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <div class="select-style">
                                                <select class="form-control" ng-disabled="IsGo" ng-model="EntityId2" ng-change="loadProcessList(EntityId2)" name="Entity" ng-options="item.Id as item.UserName for item in entityListData" required>
                                                    <option value="--Select--"></option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <input type="text" name="From Date" ng-model="fromDate2" datepicker class="form-control" required tabindex="5">
                                        </div>
                                    </div>

                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-6">

                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <div class="select-style">
                                                <select class="form-control" ng-model="ProcessId2" ng-options="item.Value as item.Text for item in processList" required>
                                                    <option value="--Select--"></option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <input type="text" name="To Date" ng-model="toDate2" datepicker class="form-control" required tabindex="6">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="col-md-2 text-right">
                                        <ul>
                                            <li><button type="button" class="btn single-btn" ng-click="PerameterWiseReport()" style="margin-top:10px;"><i class="glyphicon glyphicon-arrow-down"></i>Report</button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</div>  