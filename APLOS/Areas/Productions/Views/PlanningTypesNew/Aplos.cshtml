@*<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Planning Type</h3>*@
<togglable name="Planning Type"></togglable>
<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script>
<div class="row" ng-form name="planningTypeForm" id="tarekcontainer">
    <div class="form-elements form-horizontal">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Company" class="form-control" ng-model="planningTypesNew.CompanyId" ng-change="getPlantCbo();" ng-options="item.Value as item.Text for item in companyList" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Planning Types<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select submit-="true" ng-model="planningTypesNew.PlanningType" class="form-control" name="Planning Type" ng-change="ChangeType();"
                                ng-options="item.Value as item.Text for item in planningTypesList" tabindex="10" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User name" ng-model="planningTypesNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Base Process(Production)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select submit-="true" ng-model="planningTypesNew.BaseProcessId" class="form-control" name="Base Process" ng-change="GetSubprocessCbo();"
                                ng-options="item.Value as item.Text for item in processList" tabindex="10" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Plant" class="form-control" ng-model="planningTypesNew.PlantId" ng-options="item.Value as item.Text for item in plantList" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <input type="text" name="Description" ng-model="planningTypesNew.Description" class="form-control" disabled tabindex="5" maxlength="50">
                </div>
            </div>
            <div>
                <label class="col-sm-12 control-label"></label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Sub Process</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select submit-="true" ng-model="planningTypesNew.SubProcessId" class="form-control" name="Sub Process"
                                ng-options="item.Value as item.Text for item in subprocessList" tabindex="10">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus">{{Action}}</i></button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh">Clear</i></button></li>
                </ul>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Responsible Persion</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Work Center</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Shift</a></li>
                <li role="presentation" ng-class="{ active: isSet(8) }"><a ng-click="setTab(8)" href="" data-toggle="tab">Date</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">WeekOff</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" data-toggle="tab">Holiday</a></li>
                <li role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" data-toggle="tab">Item</a></li>
                <li role="presentation" ng-class="{ active: isSet(7) }"><a ng-click="setTab(7)" href="" data-toggle="tab">Planning Parameter</a></li>
                <li role="presentation" ng-class="{ active: isSet(9) }"><a ng-click="setTab(9);GetPlanCapacityData();" href="" data-toggle="tab">Capacity Planning</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="popUp();" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                    </ul>
                </div>
                <div style="color:black;" id="Grid" ej-grid e-datasource="SelectedEmpList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-rowdatabound="onrowdatabound" e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                        <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                        <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="40" e-visible="false"></div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="40"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                        <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                        <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                        <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                        <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                        <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        <div e-column e-field="EmployeeStatus" e-headertext="Employee Status" e-width="60"></div>
                        <div e-column e-headertext="Actions" e-width="50">
                            <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.valuePassInRPModal(this);" style="margin: -6px;"></i></button>
                        </div>
                    </div>
                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">

                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Work Center Group</label>
                        <div class="col-sm-8">
                            <input type="text" name="WorkCenterGroup" ng-model="modelWCNew.WorkCenterGroup" class="form-control" tabindex="5">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Work Center Master</label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <input type="text" name="Mentor" ng-model="modelWCNew.WorkCenterMaster" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="GetpopWCUp();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    <button ng-click="ClearEmployee()" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Plan Capacity</label>
                        <div class="col-sm-8">
                            <input type="text" name="PlanCapacity" ng-model="modelWCNew.PlanCapacity" n-decimals="2" class="form-control" tabindex="5">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Capacity Value</label>
                        <label class="col-sm-8 control-label">{{modelWCNew.Capacity}} {{modelWCNew.UOM}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Plan Efficiency</label>
                        <div class="col-sm-8">
                            <input type="text" name="Description" ng-model="modelWCNew.PlanEfficiency" n-decimals="2" class="form-control" tabindex="5">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Avg. Load Factor(if any)</label>
                        <div class="col-sm-8">
                            <input type="text" name="Description" ng-model="modelWCNew.AvgeageLoadFactor" n-decimals="2" class="form-control" tabindex="5">
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveWC();" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Save</button></li>
                        <li> <button ng-click="ClearWC();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="3"></i>Clear</button></li>
                    </ul>
                </div>
                <div id="GridSavedWC" ej-grid e-datasource="SavedWCList" e-recorddoubleclick="EditPlanWC"
                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="true" e-responsive="true"
                     e-allowscrolling="true" e-allowselection="false" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="WorkCenterGroup" e-headertext="WorkCenterGroup" e-width="3"></div>
                        <div e-column e-field="WorkCenterMaster" e-headertext="WorkCenterMaster" e-width="3"></div>
                        <div e-column e-field="Capacity" e-headertext="Capacity Value" e-width="2"></div>
                        <div e-column e-field="UOM" e-headertext="UoM" e-width="3"></div>
                        <div e-column e-field="PlanCapacity" e-headertext="PlanCapacity" e-width="5"></div>
                        <div e-column e-field="PlanEfficiency" e-headertext="Plan Efficiency" e-width="5"></div>
                        <div e-column e-field="AverageLoadFactor" e-headertext="AverageLoadFactor" e-width="5"></div>
                    </div>

                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Shift</label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <input type="text" name="Mentor" ng-model="modelShiftNew.Shift" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="ShiftPopUp();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    <button ng-click="ClearShift()" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Production Shift Start Time</label>
                        <div class="col-sm-7 input-group bootstrap-timepicker timepicker" style="float:right">
                            @*<input type="text" name="PlanCapacity" ng-model="modelShiftNew.ProductionShiftStartTime" n-decimals="2" class="form-control" tabindex="5">*@
                            <input id="StartTime" type="text" class="form-control input-small" ng-change="getMinute();" ng-model="modelShiftNew.ProductionShiftStartTime" style="margin-left:-10%; width:94%">
                            <span class="input-group-addon" style="float:left; width:12%"><i class="glyphicon glyphicon-time"></i></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Production Time</label>
                        <div class="col-sm-8">
                            <input type="text" name="Description" disabled ng-model="modelShiftNew.ProductionTime" n-decimals="2" class="form-control" tabindex="5">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">IsException Applicable</label>
                        <div class="checkbox-site">
                            <label class="control-label">
                                <input type="checkbox" ng-model="modelShiftNew.IsExceptionApplicable">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Production Shift End Time</label>
                        <div class="col-sm-7 input-group bootstrap-timepicker timepicker" style="float:right">
                            @*<input type="text" name="PlanCapacity" ng-model="modelShiftNew.ProductionShiftEndTime" n-decimals="2" class="form-control" tabindex="5">*@
                            <input id="EndTime" type="text" class="form-control input-small" ng-change="getMinute();" ng-model="modelShiftNew.ProductionShiftEndTime" style="margin-left:-10%; width:94%">
                            <span class="input-group-addon" style="float:left; width:12%"><i class="glyphicon glyphicon-time"></i></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remark</label>
                        <div class="col-sm-8">
                            <input type="text" name="Description" ng-model="modelShiftNew.Remark" class="form-control" tabindex="5">
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveShift();" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Save</button></li>
                        <li> <button ng-click="ClearShift();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="3"></i>Clear</button></li>
                    </ul>
                </div>
                <div id="GridSavedShift" ej-grid e-datasource="SavedShiftList" e-recorddoubleclick="EditPlanShift"
                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="true" e-responsive="true"
                     e-allowscrolling="true" e-allowselection="false" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="Shift" e-headertext="Shift" e-width="3"></div>
                        <div e-column e-field="ProductionShiftStartTime" e-headertext="Start Time" e-width="3"></div>
                        <div e-column e-field="ProductionShiftEndTime" e-headertext="End Time" e-width="2"></div>
                        <div e-column e-field="IsExceptionApplicable" e-headertext="IsExceptionApplicable" e-width="5"></div>
                    </div>

                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Week Days</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select ng-model="modelWeekNew.WeekDays" id="WeekDays" class="form-control" name="WeekDays" ng-options="item.Value as item.Text for item in WeekDaysList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Is Working Day</label>
                        <div class="checkbox-site">
                            <label class="control-label">
                                <input type="checkbox" ng-model="modelWeekNew.IsWorkingDays">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveWeek();" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Save</button></li>
                        <li> <button ng-click="ClearWeek();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="3"></i>Clear</button></li>
                    </ul>
                </div>
                <div id="GridSavedWK" ej-grid e-datasource="SavedWeekList" e-recorddoubleclick="EditPlanWK"
                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="true" e-responsive="true"
                     e-allowscrolling="true" e-allowselection="false" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="WeekDays" e-headertext="WeekDays" e-width="3"></div>
                        <div e-column e-field="IsWorkingDay" e-headertext="IsWorkingDay" e-width="5"></div>
                    </div>

                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Holiday Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modelHolidayNew.HolidayDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remark</label>
                        <div class="col-sm-8">
                            <input type="text" name="Description" ng-model="modelHolidayNew.Remark" class="form-control" tabindex="5">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Holiday Name<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modelHolidayNew.HolidayName" class="form-control" placeholder="dd-MM-yyyy" tabindex="9">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Is Working</label>
                        <div class="checkbox-site">
                            <label class="control-label">
                                <input type="checkbox" ng-model="modelHolidayNew.IsWorking">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveHoliday();" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Save</button></li>
                        <li> <button ng-click="ClearHoliday();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="3"></i>Clear</button></li>
                    </ul>
                </div>
                <div id="GridSavedHoliday" ej-grid e-datasource="SavedHolidayList" e-recorddoubleclick="EditPlanHoliday"
                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="true" e-responsive="true"
                     e-allowscrolling="true" e-allowselection="false" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="HolidayName" e-headertext="HolidayName" e-width="3"></div>
                        <div e-column e-field="HD" e-headertext="HolidayDate" e-width="3"></div>
                        <div e-column e-field="IsWorking" e-headertext="IsWorking" e-width="5"></div>
                        <div e-column e-field="Remark" e-headertext="Remark" e-width="5"></div>
                    </div>

                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(6), active: isSet(6) }">
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(7), active: isSet(7) }">
                <div class="row">
                    <div class="modal-body form-elements form-horizontal">
                        <div ng-form="ppForm">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="number" name="Sequence" ng-model="ModelParaNew.Sequence" class="form-control" required tabindex="1">
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Sandard Name<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="Sandard Name" ng-model="ModelParaNew.SandardName" class="form-control" required tabindex="3" maxlength="50">
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Grade<sup>*</sup></label>
                                    <div class="col-sm-8 show-message" style="padding-right:-1px;">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="ModelParaNew.ParameterGrade" placeholder="Grade" name="ProductionGrade" ng-options="item.Value as item.Text for item in gradeList" required>
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label"></label>
                                    <div class="col-sm-8">
                                        <div class="radio">
                                            <label>
                                                <input type="radio" name="Assign" ng-model="ModelParaNew.EntryState" value="Entry">
                                                <span class="cr"><i class="cr-icon"></i></span>Entry
                                            </label>
                                            <label>
                                                <input type="radio" name="Assign" ng-model="ModelParaNew.EntryState" value="Calculate">
                                                <span class="cr"><i class="cr-icon"></i></span>Calculate
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" ng-show="ModelParaNew.EntryState=='Entry'">
                                    <label class="col-sm-4 control-label"></label>
                                    <div class="col-sm-4">
                                        <div class="checkbox-site radio">
                                            <label>
                                                <input type="checkbox" ng-model="ModelParaNew.ValueinPercentage" ng-change="setCheckedValue('ValueinPercentage')">
                                                <span class="cr"><i class="cr-icon"></i></span>
                                            </label>
                                            <label class="control-label">Percentage</label>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="checkbox-site radio">
                                            <label>
                                                <input type="checkbox" ng-model="ModelParaNew.ValueinDecimal" ng-change="setCheckedValue('ValueinDecimal')">
                                                <span class="cr"><i class="cr-icon"></i></span>
                                            </label>
                                            <label class="control-label">Decimal</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" ng-show="ModelParaNew.EntryState=='Entry'">
                                    <label class="col-sm-4 control-label">Default Value</label>
                                    <div class="col-sm-8">
                                        <input type="text" name="Fixed Value" n-decimals="2" ng-model="ModelParaNew.DefaultValue" class="form-control">
                                    </div>
