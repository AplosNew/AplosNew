@*<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Planning Type</h3>*@
<togglable name="Planning Type"></togglable>
<div class="row" ng-form name="planningTypeForm">
    <div class="form-elements form-horizontal">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Company" class="form-control" ng-model="planningTypesNew.CompanyId" ng-change="getPlantCbo();" ng-options="item.Value as item.Text for item in companyList" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Planning Types<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select submit-="true" ng-model="planningTypesNew.PlanningType" class="form-control" name="Planning Type" ng-change="ChangeType();"
                                ng-options="item.Value as item.Text for item in planningTypesList" tabindex="10" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User name" ng-model="planningTypesNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Base Process(Production)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select submit-="true" ng-model="planningTypesNew.BaseProcessId" class="form-control" name="Base Process" ng-change="GetSubprocessCbo();"
                                ng-options="item.Value as item.Text for item in processList" tabindex="10" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Plant" class="form-control" ng-model="planningTypesNew.PlantId" ng-options="item.Value as item.Text for item in plantList" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <input type="text" name="Description" ng-model="planningTypesNew.Description" class="form-control" disabled tabindex="5" maxlength="50">
                </div>
            </div>
            <div>
                <label class="col-sm-12 control-label"></label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sub Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select submit-="true" ng-model="planningTypesNew.SubProcessId" class="form-control" name="Sub Process"
                                ng-options="item.Value as item.Text for item in subprocessList" tabindex="10" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus">{{Action}}</i></button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh">Clear</i></button></li>
                </ul>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Responsible Persion</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Work Center</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Shift</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Date</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" data-toggle="tab">WeekOff</a></li>
                <li role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" data-toggle="tab">Holiday</a></li>
                <li role="presentation" ng-class="{ active: isSet(7) }"><a ng-click="setTab(7)" href="" data-toggle="tab">Item</a></li>
                <li role="presentation" ng-class="{ active: isSet(8) }"><a ng-click="setTab(8)" href="" data-toggle="tab">Planning Parameter</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="popUp();" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                    </ul>
                </div>
                <div style="color:black;" id="Grid" ej-grid e-datasource="SelectedEmpList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-rowdatabound="onrowdatabound" e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                        <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                        <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="40" e-visible="false"></div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="40"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                        <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                        <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                        <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                        <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                        <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        <div e-column e-field="EmployeeStatus" e-headertext="Employee Status" e-width="60"></div>
                        <div e-column e-headertext="Actions" e-width="50">
                            <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.valuePassInRPModal(this);" style="margin: -6px;"></i></button>
                        </div>
                    </div>
                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(6), active: isSet(6) }">
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(7), active: isSet(7) }">
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(8), active: isSet(8) }">
            </div>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Edit</th>
                    <th>Plant</th>
                    <th>Planning Types</th>
                    <th>Description</th>
                    <th>User Define Name</th>
                    <th>Base Process(Production)</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in planningTypeses">
                    <td class="text-right table-td">
                        <ul class="list-inline action-list">
                            <li><button ng-click="Get(x.Id, $index);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></button></li>
                        </ul>
                    </td>
                    <td>{{x.Plant}}</td>
                    <td>{{x.PlanningType}}</td>
                    <td>{{x.Description}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.BaseProcess}}</td>
                    <td class="text-right table-td">
                        <ul class="list-inline action-list">
                            <li><button ng-click="valuePass($index,x);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Delete"><i class="glyphicon glyphicon-trash"></i></button></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-templaterefresh="refreshTemplateemployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" e-value="data.Flag" />
                    </script>

                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headchk" />
                    </script>
                </div>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closePopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button></li>
                </ul>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>

<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="removeRPPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteResponsibleEmployee();"></confirm-archive-generic>