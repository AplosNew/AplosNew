<div class="modal fade site-modal in" id="FGInventoryRegisterPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form="partyForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">{{partyType}} List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="partyParameters.searchBy">
                                            <option value="PartyCode">{{partyType}} Code</option>
                                            <option value="UserName">{{partyType}} Name</option>
                                            <option ng-repeat="option in partySearchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="partyParameters.search" ng-enter="getPartyList()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPartyList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>{{partyType}}</th>
                                <th>Account Group</th>
                                <th ng-show="partyGLType!=null">GL</th>
                                <th ng-show="partyGLType!=null && companyConfig.IsVoucherFromBudget">Budget</th>
                                <th ng-show="partyGLType!=null && companyConfig.IsVoucherFromBudget">Activity</th>
                                <th>Currency</th>
                                <th>Country</th>
                                <th>State</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in partyList |itemsPerPage:partyParameters.pageSize" pagination-id="metaData.name + 'partyList'" total-items="partyParameters.total_count"
                                ng-click="selectPartyPopUpRow($index, x.Id);" ng-class="{selected : x.Id == partySelected}" ng-dblclick="closePartyPopUp()">
                                <td>{{x.Code}} - {{x.UserName}}</td>
                                <td>{{x.PartyAccountGroupName}}</td>
                                <td ng-show="partyGLType!=null && partyGLType=='Reconciliation'">{{x.ReconciliationGLCode}} - {{x.ReconciliationGLName}}</td>
                                <td ng-show="partyGLType!=null && partyGLType=='Reconciliation' && companyConfig.IsVoucherFromBudget">{{x.ReconciliationBudgetName}}</td>
                                <td ng-show="partyGLType!=null && partyGLType=='Reconciliation' && companyConfig.IsVoucherFromBudget">{{x.ReconciliationActivityName}}</td>
                                <td ng-show="partyGLType!=null && partyGLType=='DownPayment'">{{x.DownPaymentGLCode}} - {{x.DownPaymentGLName}}</td>
                                <td ng-show="partyGLType!=null && partyGLType=='DownPayment' && companyConfig.IsVoucherFromBudget">{{x.DownPaymentBudgetName}}</td>
                                <td ng-show="partyGLType!=null && partyGLType=='DownPayment' && companyConfig.IsVoucherFromBudget">{{x.DownPaymentActivityName}}</td>
                                <td ng-show="partyGLType!=null && partyGLType=='Suspense'">{{x.SuspenseGLCode}} - {{x.SuspenseGLName}}</td>
                                <td ng-show="partyGLType!=null && partyGLType=='Suspense' && companyConfig.IsVoucherFromBudget">{{x.SuspenseBudgetName}}</td>
                                <td ng-show="partyGLType!=null && partyGLType=='Suspense' && companyConfig.IsVoucherFromBudget">{{x.SuspenseActivityName}}</td>
                                <td>{{x.CurrencyCode? x.CurrencyCode : '-'}}</td>
                                <td>{{x.CountryName}}</td>
                                <td>{{x.StateCode}} - {{x.StateName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="5" pagination-id="metaData.name + 'partyList'" direction-links="true" boundary-links="true" on-page-change="getPartyList(newPageNumber)"></dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closePartyPopUp()">Select</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="partyPlantPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Detail</h4>
            </div>
            <div class="modal-body">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Country</label>
                        <div class="col-sm-8">
                            <input type="text" readonly name="PartyCountry" ng-model="partyPlant.PartyCountry" class="form-control">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">City</label>
                        <div class="col-sm-8">
                            <input type="text" readonly name="PartyCity" ng-model="partyPlant.PartyCity" class="form-control">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Address</label>
                        <div class="col-sm-8">
                            <textarea maxlength="300" readonly class="form-control" rows="3" ng-model="partyPlant.PartyAddress"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">State</label>
                        <div class="col-sm-8">
                            <input type="text" readonly name="PartyState" ng-model="partyPlant.PartyState" class="form-control">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">GSTIN</label>
                        <div class="col-sm-8">
                            <input type="text" readonly name="PartyGSTIN" ng-model="partyPlant.PartyGSTIN" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button type="button" class="btn btn-default" data-dismiss="modal">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>