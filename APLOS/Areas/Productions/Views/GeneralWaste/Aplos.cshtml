<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="row">
    <div class="form-elements form-horizontal" ng-form name="ModelNewForm">
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="col-sm-6 col-md-6 col-lg-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <input type="text" name="EntityId" ng-disabled="true" ng-model="Entity" ng-click="selectEntity()" class="form-control" maxlength="200" tabindex="5">
                </div>
                <div class="col-sm-2">
                    <button ng-click="selectEntity()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Waste Location<sup>*</sup></label>
                <div class="col-sm-6  show-message">
                    <div class="select-style">
                        <select name="Plant" ng-model="WasteLocationId" class="col-sm-3 form-control"
                                ng-options="item.Id as item.StorageLocation for item in WasteLocationList" tabindex="2" required>
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <input id="datepicker" e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="FromDate" e-width="100%" />
                </div>
            </div>
        </div>

        </div>
    </div>



<div class="common-btn">
    <ul class="list-inline text-right">
        <li> <button ng-model="View" ng-click="getView();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> View</button></li>
        @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>*@
    </ul>
</div>




<div class="row">

    <div id="ViewPop" ej-grid e-datasource="ViewGridPop" e-templaterefresh="refreshTemplate"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" style="margin-top:30px;" e-allowtextwrap="true"
         e-tooltipsettings-visible="true" e-tooltip="tooltip">
        <div e-columns>
            @*<div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>*@
            <div e-column e-field="ItemName" e-headertext="ItemName" e-width="2"></div>
            <div e-column e-field="process" e-headertext="Process" e-width="2"></div>
            <div e-column e-field="Category" e-headertext="Category" e-width="3"></div>
            <div e-column e-field="SubCategory" e-headertext="Sub Category" e-width="3"></div>
            @*<div e-column e-field="Sequence" e-headertext="Sequence" e-width="3"></div>*@
            @*<div e-column e-field="code" e-headertext="code" e-width="3"></div>*@
            <div e-column e-headertext="Quantity" e-template="#allotQty" e-textalign="center" e-width="3"></div>
            <div e-column e-headertext="Remarks" e-template="#rems" e-textalign="center" e-width="3"></div>
            <div e-column e-field="Uom" e-headertext="UOM" e-width="3"></div>
            @*<div e-column e-field="BudgetCode" e-headertext="BudgetCode" e-width="3"></div>*@
            @*<div e-column e-field="EntityName" e-headertext="EntityName" e-width="3"></div>*@
        </div>
    </div>
</div>

<script type="text/template" id="allotQty">
    <input type="number" ng-model="data.Quantity" style="color:black; text-align:center" />
</script>
<script type="text/template" id="rems">
    <input type="text" ng-model="data.Remarks" style="color:black; text-align:center" />
</script>


<div class="row">
    <div class="common-btn" style="margin:10px;">
        <ul class="common-btn list-inline text-right">
            <li><button ng-click="SaveAll()" class="btn "><i class="glyphicon glyphicon-arrow-down"></i> Save All</button></li>
        </ul>
    </div>
</div>



