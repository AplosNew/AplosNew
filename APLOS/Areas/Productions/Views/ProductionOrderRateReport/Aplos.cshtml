<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="form-horizontal" ng-form name="ModelNewForm">
    <div class="form-elements">
        <div class="row">
            <div class="col-xs-12 col-sm-5 col-md-5">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date</label>
                    <div class="col-sm-8">
                        <input type="text" name="Form Date" required e-dateformat="dd-MMM-yyyy" ng-model="FromDate" datepicker class="form-control" ng-change="PreviousDatee();empGridShow();">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-5 col-md-5">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date</label>
                    <div class="col-sm-8">
                        <input type="text" name="Form Date" required e-dateformat="dd-MMM-yyyy" ng-model="ToDate" datepicker class="form-control" ng-change="PreviousDatee();empGridShow();">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-2 col-md-2">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="DonwloadReport();" class="btn" tabindex="9"><i class="glyphicon glyphicon-download-alt"></i> Download</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
