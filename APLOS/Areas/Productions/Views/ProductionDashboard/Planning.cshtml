<ej-dialog id="dialogProductionPlanView" title=" Production Planning Information" e-enablemodal="true" e-position-y="0" e-target="#MainContainer" e-showoninit="false" e-close="onDialogClose" e-minwidth="900px" e-open="enableBtn">


    <div class="row">
        <div class="form-element-ctrl form-horizontal">



            <div class="col-xs-4" ng-hide="!VROWDATA.ProductionOrderId">

                <label class="col-sm-8 control-label">Production Order No.</label>
                <label class="col-sm-4 control-label mouseHand" style="color:blue; font-weight:bold;" ng-click="GetProductionPlanningParametersData('dialogProductionOrderParameters','entrypop')">{{VROWDATA.ProductionOrderId}}</label>



                <label class="col-sm-8 control-label">Plan Qty For Selected Date</label>
                <label class="col-sm-4 control-label">{{VROWDATA.Quantity}}</label>




                <label class="col-sm-8 control-label">Production Hours</label>
                <label class="col-sm-4 control-label">{{VROWDATA.ProductionHours}}</label>



                <label class="col-sm-8 control-label">WorkCenter</label>
                <label class="col-sm-4 control-label mouseHand" style="color:blue; font-weight:bold;" ng-click="GetWorkCenterParametersData(VROWDATA.WorkCenterMasterId)">{{VROWDATA.WorkCenter}}</label>

            </div>
            <div class="col-xs-6" ng-hide="!VROWDATA.ProductionOrderId">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Selected Plan Date</label>
                    <label class="col-sm-8 control-label">{{VROWDATA.ProductionDate}}</label>

                    <label class="col-sm-4 control-label">Product</label>
                    <label class="col-sm-8 control-label mouseHand" ng-click="GetProductPlanningData()" style="color:blue; font-weight:bold;">{{VROWDATA.ProductName}}</label>

                    <label class="col-sm-4 control-label">Material</label>
                    <label class="col-sm-8 control-label">{{VROWDATA.Material}}</label>

                    <label class="col-sm-4 control-label">Style</label>
                    <label class="col-sm-8 control-label">
                        <label class="col-sm-12 control-label mouseHand" style="padding:0px;margin:0px;color:blue;font-weight:bold;" ng-repeat="x in VSTYLEDATA" ng-click="GetStyleGraphData(x.BuyerReferenceNo);">
                            {{x.BuyerReferenceNo}}
                        </label>
                    </label>
                </div>
            </div>
            <div class="col-xs-2" ng-hide="!VROWDATA.ProductionOrderId">



                <div class="col-sm-12 right">
                    <div style="background-color:{{VPRDATA.Color}};height:30px;width:100%">
                    </div>
                </div>


                <div class="col-sm-12">
                    <img src="{{MaterialImagePath}}{{VPRDATA.PicFileName}}" style="height:100px;width:100%" />
                </div>


            </div>

            <div class="col-sm-12">
                <div class="common-btn">
                    <ul class="list-inline text-right small">

                        <li>
                            <button ng-click="showlinegraphPRWise();" class="btn small" style=" height: 20px; width: 60px; padding: 0px; margin: 0px;">
                                Plan  <i class="glyphicon glyphicon-signal small"></i>
                            </button>
                        </li>
                        <li>
                            <button ng-click="showProductionlinegraphPRWise();" class="btn small" style=" height: 20px; width: 90px; padding: 0px; margin: 0px;">
                                Production  <i class="glyphicon glyphicon-signal small"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
            <label class="col-sm-12">This production order has been scheduled for:</label>
            <div class="col-sm-12">
                <div id="gridprview" ng-init="chkinit()" ej-grid e-datasource="VWCDATA" e-showsummary="true" e-summaryrows="summaryRowsForWorkCenter"
                     e-responsive="true">
                    @*e-recorddoubleclick="workcenterclick"*@
                    <div e-columns>
                        <div e-column e-field="WorkCenter" e-headertext="Work Center" e-width="8" e-isprimarykey="true"></div>
                        <div e-column e-field="FromDate" e-headertext="From Plan Date" e-width="3"></div>
                        <div e-column e-field="ToDate" e-headertext="To Plan Date" e-width="3"></div>
                        <div e-column e-field="LSD" e-headertext="LSD" e-width="3"></div>
                        <div e-column e-field="CommitmentDate" e-headertext="Comm. Dt" e-width="3"></div>
                        <div e-column e-type="number" e-field="DelayedProductionDaysOnCommitmentDate" e-headertext="Delay(On Comm. Dt)" e-width="2"></div>

                        <div e-column e-field="PlannedQuantity" e-headertext="Plan Qty" e-width="2"></div>
                        <div e-column e-template="#showGraph" e-headertext="" e-width="3"></div>
                    </div>

                </div>
            </div>
            <script type="text/template" id="showGraph">

                <div class="common-btn">
                    <ul class="list-inline text-right small">

                        <li>
                            <button ng-click="$parent.showlinegraph(this);" class="btn small" style="height: 20px;width: 20px; padding: 0px; margin: 0px;">
                                <i class="glyphicon glyphicon-signal small" style="color:greenyellow;"></i>
                            </button>
                        </li>
                        <li>
                            <button ng-click="$parent.workcenterclick(this);" class="btn small" style="height: 20px; width: 20px; padding: 0px; margin: 0px;">
                                <i class="glyphicon glyphicon-list small" style="color:greenyellow;"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </script>



            <label class="col-sm-12">This production order has been produced in:</label>

            <div class="col-sm-12">


                <div id="gridprview" ng-init="chkinit()" ej-grid e-datasource="VWPRODDATA" e-showsummary="true" e-summaryrows="summaryRowsForProduction"
                     e-responsive="true">
                    <div e-columns>
                        <div e-column e-field="WorkCenter" e-headertext="Work Center" e-width="8" e-isprimarykey="true"></div>
                        <div e-column e-field="FromDate" e-headertext="First Prd. Date" e-width="3"></div>
                        <div e-column e-field="ToDate" e-headertext="Last Prod. Date" e-width="3"></div>
                        <div e-column e-field="ProductionQuantity" e-headertext="Qty" e-width="2"></div>
                        <div e-column e-template="#showProdGraph" e-headertext="" e-width="2"></div>
                    </div>

                </div>

            </div>
            <script type="text/template" id="showProdGraph">

                <div class="common-btn">
                    <ul class="list-inline text-right small">

                        <li>
                            <button ng-click="$parent.showProductionlinegraph(this);" class="btn small" style="height: 20px;width: 20px;padding: 0px;margin: 0px;">
                                <i class="glyphicon glyphicon-signal small" style="color:greenyellow;"></i>
                            </button>
                        </li>
                        <li>
                            <button ng-click="$parent.workcenterclick(this);" class="btn small" style="height: 20px; width: 20px; padding: 0px; margin: 0px;">
                                <i class="glyphicon glyphicon-list small" style="color:greenyellow;"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </script>

            <div class="row" ng-show="SAMEDAYDATA.length>0" style="padding-right:10px;padding-left:10px;">
                <label class="col-sm-12">Also planned following order(s) on {{VROWDATA.ProductionDate}}:</label>
                <div class="col-sm-12">
                    <div style="width:100%;">

                        <div id="GridSameDayPlanning" ng-init="chkinit()" ej-grid e-datasource="SAMEDAYDATA" e-allowscrolling="true" e-actioncomplete="syncfusiongriddatabound"
                             e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-recorddoubleclick="EditProductionPlanningDataSameDay"
                             e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>

                                <div e-column e-template="#showPRPlanListForSameDay" e-headertext="" e-width="28"></div>
                                <div e-column e-type="string" e-field="ProductionOrderID" e-headertext="Production Order ID" e-width="80"></div>
                                <div e-column e-type="number" e-field="Quantity" e-headertext="Qty" e-width="80"></div>
                                <div e-column e-type="string" e-field="PlanningStartDate" e-headertext="Planning Start Date" e-width="80"></div>
                                <div e-column e-type="string" e-field="PlanningEndDate" e-headertext="Planning End Date" e-width="80"></div>
                                <div e-column e-type="string" e-field="buyer" e-headertext="Buyer" e-width="80"></div>
                                <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                                <div e-column e-type="string" e-field="BuyerRefNo" e-headertext="Customer Order#" e-width="60"></div>
                                <div e-column e-type="string" e-field="OwnRefNo" e-headertext="Own Order#" e-width="60"></div>
                                <div e-column e-type="string" e-field="ProductionStatus" e-headertext="Production Status" e-width="60"></div>
                                <div e-column e-type="string" e-field="ProductionPriority" e-headertext="Production Priority" e-width="50"></div>
                                <div e-column e-type="number" e-field="PlannedQty" e-headertext="Total Planned Qty" e-width="80"></div>
                                <div e-column e-type="string" e-field="MasterOrderId" e-headertext="Master Order Id" e-width="80"></div>
                                <div e-column e-type="string" e-field="StyleNo" e-headertext="Customer Item#" e-width="80"></div>
                                <div e-column e-type="string" e-field="OwnStyleNo" e-headertext="Own Item#" e-width="80"></div>
                                <div e-column e-type="string" e-field="SONo" e-headertext="SO No" e-width="80"></div>
                                <div e-column e-type="string" e-field="SODesc" e-headertext="SO Desc" e-width="80"></div>


                            </div>

                        </div>
                    </div>
                </div>
                <script type="text/template" id="showPRPlanListForSameDay">
                    <div class="common-btn">
                        <ul class="list-inline text-right small">

                            <li>
                                <button ng-click="$parent.GetProductionPlanningData(data.Id,'');" class="btn small" style="height: 20px;width: 20px; padding: 0px; margin: 0px;">
                                    <i class="glyphicon glyphicon-th-list"></i>
                                </button>
                            </li>

                        </ul>
                    </div>
                </script>
            </div>

            <label class="col-sm-12">Sales Order List:</label>
            <div class="col-sm-12">
                <div id="GridSOItemsForProductionOrder" ng-init="chkinit()" ej-grid e-datasource="SalesOrderListForProductionOrderId"
                     e-allowscrolling="true" e-summaryrows="summaryRows" e-actioncomplete="syncfusiongriddatabound"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-showsummary="true"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="MasterOrderNo" e-headertext="M. Order No" e-width="120"></div>
                        <div e-column e-field="SalesOrderId" e-headertext="SO. ID" e-width="120"></div>
                        <div e-column e-field="BuyerOrderNo" e-headertext="Customer Order#" e-width="100"></div>
                        <div e-column e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
                        <div e-column e-field="Qty" e-headertext="Qty" e-width="80" e-textalign="right"></div>
                        <div e-column e-field="Rate" e-headertext="Rate" e-width="80" e-textalign="right"></div>
                        <div e-column e-field="CM" e-headertext="CM" e-width="80" e-textalign="right"></div>
                        <div e-column e-field="DeliveryDate" e-headertext="Del. Date" e-width="80"></div>


                        <div e-column e-field="Customer" e-headertext="Customer" e-width="180"></div>
                        <div e-column e-field="Buyer" e-headertext="Buyer" e-width="180"></div>
                        <div e-column e-field="OwnOrderNo" e-headertext="Own Order#" e-width="100"></div>

                        <div e-column e-field="BuyerReferenceNo" e-headertext="Customer Item#" e-width="100"></div>
                        <div e-column e-field="OwnReferenceNo" e-headertext="Own Item#" e-width="100"></div>



                        <div e-column e-field="ProductName" e-headertext="Product" e-width="180" e></div>
                        <div e-column e-field="ProductionGrouping" e-headertext="Product Grouping" e-width="120" e></div>

                        <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="180" e></div>
                        <div e-column e-field="ArticleName" e-headertext="Article" e-width="180"></div>
                        <div e-column e-field="CommitmentDate" e-headertext="Commi.Date" e-width="80"></div>
                        <div e-column e-field="DestinationName" e-headertext="Dest." e-width="80"></div>
                        <div e-column e-field="ShipmentModeName" e-headertext="Ship.Mode" e-width="80"></div>
                        <div e-column e-field="PONumber" e-headertext="PO No" e-width="80"></div>

                        <div e-column e-field="OrderStatusName" e-headertext="Ord. Status" e-width="80"></div>
                        <div e-column e-field="OrderCategoryName" e-headertext="Ord. Cat." e-width="80"></div>

                    </div>
                </div>
            </div>
            <style type="text/css">
                .e-grid .e-templatecell {
                    padding: 0px 4px 0px 0px;
                }
            </style>
        </div>
    </div>
</ej-dialog>


<ej-dialog id="graph" title=" Product Plan Quantity Distribution" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-width="900" e-target="#MainContainer" e-open="enableBtn">
    <div id="graphdiv" style="position:relative;overflow:scroll;width:880px;">
        <div id="chartContainer" ej-chart e-isresponsive="true" style="width:{{graphmaxwidth(dataSourceLineGraph)}};"
             e-primaryxaxis-title-text="Day"
             e-load=onchartload e-size-height="300px" e-size-width="graphmaxwidth(dataSourceLineGraph,70)"
             e-legend-visible="true" e-legend-position="bottom"
             e-title-text="Qty"
             e-primaryyaxis-title-text="Qty" e-primaryyaxis-range-min="0"
             e-primaryyaxis-range-max="graphmaxheight(dataSourceLineGraph,'Quantity')"
             e-commonseriesoptions-type="column"
             e-commonseriesoptions-enableanimation="true" e-commonseriesoptions-tooltip-visible="true"
             e-commonseriesoptions-tooltip-format="#point.x# : #point.y# #series.name#">

            <e-series>
                <e-series e-name="Production Plan" e-marker-dataLabel-visible="true"
                          e-marker-dataLabel-verticaltextalignment="near"
                          e-marker-dataLabel-angle="270"
                          e-marker-dataLabel-font-fontweight="bold"
                          e-marker-dataLabel-font-color="yellow"
                          e-marker-dataLabel-enablecontrastcolor="true" e-datasource=dataSourceLineGraph e-xname="PlanDate" e-yname="Quantity" e-fill="VPRDATA.Color">
                </e-series>
            </e-series>
        </div>
    </div>

</ej-dialog>

<ej-dialog id="graphProduction" title=" Production Info" e-enablemodal="true"
           e-position-y="0" e-showoninit="false" e-width="900" e-target="#MainContainer" e-open="enableBtn">
    <div style="position:relative;overflow:scroll;width:880px;">
        <div id="chartProductionContainer" ej-chart e-isresponsive="true" style="width:{{graphmaxwidth(dataSourceProductionLineGraph)}};"
             e-primaryxaxis-title-text="Day" e-size-width="graphmaxwidth(dataSourceProductionLineGraph,70)"
             e-load=onchartload e-size-height="300px"
             e-legend-visible="true" e-legend-position="bottom"
             e-title-text="Qty">

            <e-series>
                <e-series e-type="column"
                          e-marker-dataLabel-visible="true"
                          e-marker-dataLabel-verticaltextalignment="near"
                          e-marker-dataLabel-angle="270"
                          e-marker-dataLabel-font-fontweight="bold"
                          e-marker-dataLabel-font-color="yellow"
                          e-marker-dataLabel-enablecontrastcolor="true"
                          e-enableanimation="true" e-tooltip-visible="true"
                          e-tooltip-format="#point.x# Qty: #point.y#" e-name="Production" e-datasource=dataSourceProductionLineGraph
                          e-xname="ProductionDate" e-yname="Quantity" e-fill="VPRDATA.Color">
                </e-series>



                <e-series e-type="line"
                          e-marker-dataLabel-visible="true"
                          e-marker-dataLabel-verticaltextalignment="near"
                          e-marker-dataLabel-font-fontweight="bold"
                          e-marker-dataLabel-enablecontrastcolor="true"
                          e-marker-shape="circle" e-marker-visible="true"
                          e-marker-size-height="10" e-marker-size-width="10"
                          e-border-width="2"
                          e-enableanimation="true" e-tooltip-visible="true" e-name="Target" e-datasource=dataSourceProductionLineGraph
                          e-xname="ProductionDate" e-yname="TargetQty" e-fill="#0000ff">
                </e-series>
            </e-series>
        </div>
    </div>

</ej-dialog>

