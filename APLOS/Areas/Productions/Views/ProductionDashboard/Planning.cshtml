<ej-dialog id="dialogWorkCenterParameters" title=" Product Parameters" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#MainContainer" e-minwidth="900" e-open="enableBtn">

    @Html.Partial("~/Areas/OrderManagements/Views/productionOrderSchedulingParametersType1/workCenterParameters.cshtml")

</ej-dialog>
<style type="text/css">
    #chartContainer_svg {
        overflow: visible;
    }

    #chartContainer {
        overflow: visible;
    }

    e-datavisualization-chart e-js {
        overflow: visible;
    }

    element.style {
        overflow: visible;
    }
</style>
