<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign" id="MainContainer"></span>Production Dashboard</h3>
<div class="form-elements form-horizontal" ng-form name="CostingTypeForm">
    <div class="row" style="border-bottom:1px solid #cdcdcd;padding:10px;">
        <div class="col-xs-12 col-sm-8 col-sm-8 small" style="padding:0px;margin:0px;">
            <div class="col-xs-12 col-sm-3 col-sm-3 small">
                Company
                <div class="select-style">
                    <select id="ddlEntity" ng-model="SelectedCompany" ng-change="ChangeCompany();" style="height:26px;">
                        <option ng-repeat="option in CompanyList" value="{{option.CompanyId}}">{{option.Company}}</option>
                    </select>
                </div>

            </div>
            <div class="col-xs-12 col-sm-3 col-sm-3 small">
                Plant
                <div class="select-style">
                    <select id="ddlEntity" ng-model="SelectedPlant" ng-change="ChangePlant();" style="height:26px;">
                        <option ng-repeat="option in PlantList" value="{{option.PlantId}}">{{option.Plant}}</option>
                    </select>
                </div>

            </div>
            <div class="col-xs-12 col-sm-3 col-sm-3 small">
                Entity
                <div class="select-style">
                    <select id="ddlEntity" ng-model="SelectedEntity" style="height:26px;">
                        <option ng-repeat="option in EntityList" value="{{option.Id}}">{{option.UserName}}</option>
                        <option value="">All</option>
                    </select>
                </div>

            </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 small">
                Date
                <input type="text" name="FromDateParameter" ng-model="FromDateParameter" datepicker class="form-control" placeholder="dd-MM-yyyy" @*ng-change="DrawWorkcenterWisePlan();"*@>
            </div>
            <div class="col-xs-12 col-sm-1 col-sm-1 small">
                <br />
                <ul class="list-inline small" style="float:left;position:static;">
                    <li>
                        <button ng-click="DrawWorkcenterWisePlan();" class="btn small" style="height: 32px; width: 32px; padding: 0px; margin: 0px;">
                            <i style="font-size:26px;color:blue;font-weight:bolder;" class="glyphicon glyphicon-refresh"></i>
                        </button>

                    </li>
                </ul>
            </div>
        </div>
        <div class="col-xs-12 col-sm-1 col-sm-1 small text-right">
            <br />
            <ul class="list-inline small" style="float:left;position:static;">
                <li>

                    <button ng-click="ProductionEfficiency();" class="btn small" style="height: 32px; width: 32px; padding: 0px; margin: 0px;">
                        <i style="font-size:26px;color:darkred;font-weight:bolder;" class="glyphicon glyphicon-file"></i>
                    </button>
                </li>
            </ul>
        </div>
        <div class="col-xs-12 col-sm-3 col-sm-3 small">
            <table style="border:1px solid #dcdcdc;">

                <tr style="background-color:#dcdcdc;cursor:pointer" ng-click="openPopup('dialogProfitability');">
                    <td style="color:#470078"><b>Standard Workcenter Cost</b></td>
                    <td style="color:#470078;" class="text-right"><b>{{DailyPrifitability | sumByKey : 'TotalWCCost'|  number:0 }} {{DailyPrifitability.length>0?DailyPrifitability[0].ReportCurrency:''}}</b></td>
                </tr>
                <tr style="background-color:#dcdcdc;cursor:pointer" ng-click="openPopup('dialogProfitability');">
                    <td style="color:#470078"><b>Revenue on Target</b></td>
                    <td style="color:#470078;" class="text-right"><b>{{DailyPrifitability | sumByKey : 'RevenueOnTarget'|  number:0 }} {{DailyPrifitability.length>0?DailyPrifitability[0].ReportCurrency:''}}</b></td>
                </tr>
                <tr style="background-color:#dcdcdc;cursor:pointer" ng-click="openPopup('dialogProfitability');">
                    <td style="color:#470078"><b>Revenue on Production</b></td>
                    <td style="color:#470078;" class="text-right"><b>{{DailyPrifitability | sumByKey : 'RevenueOnProduction'|  number:0 }} {{DailyPrifitability.length>0?DailyPrifitability[0].ReportCurrency:''}}</b></td>
                </tr>
            </table>
        </div>

    </div>
    <div class="row" style="padding-top:10px;">
        <div class="col-xs-12 col-sm-12 col-sm-12 small" style="padding-bottom:10px;">
            <div valign="bottom" style="color:black;" id="GridProductionStatistics" ej-grid e-datasource="DayStatistics"
                 e-allowfiltering="false" e-allowpaging="false" e-allowsorting="true" e-allowresizetofit="true"
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="Caption" e-headertext=""></div>
                    <div e-column e-field="TotalTargetQty" e-headertext="Ttl. Tgt Qty" e-type="number" e-format="{0:N0}" e-textalign="right" e-width="90"></div>
                    <div e-column e-field="TotalTargetAmount" e-headertext="Ttl. Tgt Amt" e-type="number" e-format="{0:N2}" e-textalign="right" e-width="90"></div>

                    <div e-column e-field="AverageTargetQty" e-headertext="Avg. Tgt Qty" e-type="number" e-format="{0:N0}" e-textalign="right" e-width="90"></div>
                    <div e-column e-field="AverageTargetAmount" e-headertext="Avg. Tgt Amt" e-type="number" e-format="{0:N2}" e-textalign="right" e-width="90"></div>

                    <div e-column e-field="TotalProductionQty" e-headertext="Ttl. Prd. Qty" e-type="number" e-format="{0:N0}" e-textalign="right" e-width="90"></div>
                    <div e-column e-field="TotalProductionAmount" e-headertext="Ttl. Prd. Amt" e-type="number" e-format="{0:N2}" e-textalign="right" e-width="90"></div>

                    <div e-column e-field="AverageProductionQty" e-headertext="Avg. Prd. Qty" e-type="number" e-format="{0:N0}" e-textalign="right" e-width="90"></div>
                    <div e-column e-field="AverageProductionAmount" e-headertext="Avg. Prd. Amt" e-type="number" e-format="{0:N2}" e-textalign="right" e-width="90"></div>

                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-8 col-md-8">
            <div class="text-center" style="position:center;font-weight:bold; background-color:#f2f2f2;">
                Process Wise Production
            </div>
            <div id="graphdiv" style="position:relative;overflow:scroll;border:1px solid #e8e8e8;">
                <div id="chartProcessWiseProduction" ej-chart e-isresponsive="true" style="width:{{graphmaxwidth(ProcessWiseProduction)}};"
                     e-primaryxaxis-title-text="" e-legend-shape="seriesType"
                     e-load=onchartload e-size-height="300px" e-size-width="graphmaxwidth(ProcessWiseProduction)"
                     e-legend-visible="true" e-legend-position="right"
                     e-title-text="" e-primaryyaxis-range-max="graphmaxheight(ProcessWiseProduction,'Quantity')"
                     e-primaryyaxis-title-text="Qty" e-primaryyaxis-range-min="0"
                     e-commonseriesoptions-type="column"
                     e-commonseriesoptions-enableanimation="true" e-commonseriesoptions-tooltip-visible="true"
                     e-commonseriesoptions-tooltip-format="#point.x# : #point.y# #series.name#">

                    <e-series>
                        <e-series e-name="Production" e-marker-dataLabel-visible="true"
                                  @*e-marker-dataLabel-verticaltextalignment="near*@
                                  e-marker-datalabel-horizontaltextalignment="Center"
                                  e-marker-datalabel-showedgelabels="true"
                                  e-marker-dataLabel-angle="0"
                                  e-marker-dataLabel-font-fontweight="bold"
                                  e-marker-dataLabel-font-color="yellow"
                                  e-marker-dataLabel-enablecontrastcolor="true" e-datasource="ProcessWiseProduction" e-xname="UserName" e-yname="Quantity" e-fill="#06B200">
                        </e-series>
                    </e-series>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div valign="bottom" style="color:black;" id="GridProcessWiseProduction" ej-grid e-datasource="ProcessWiseProductionGrid"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowresizetofit="true" e-pagesettings-pagesize="7"
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="UserName" e-headertext="Process"></div>
                    <div e-column e-field="Quantity" e-type="number" e-format="{0:N0}" e-textalign="right" e-headertext="Production" e-width="80"></div>
                    <div e-column e-template="#OrderWiseProductionNavigation" e-headertext="" e-width="40"></div>
                    <div e-column e-template="#WCWiseProductionNavigation" e-headertext="" e-width="40"></div>
                    <div e-column e-template="#ProductionRelayWiseProductionNavigation" e-headertext="" e-width="40"></div>
                </div>
            </div>
        </div>


    </div>

    <div class="row" style="padding-top:20px;">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="text-center" style="position:center;font-weight:bold; background-color:#f2f2f2;">
                {{ChartCaptions.PlanVsProductionWC}}
            </div>
            <div id="graphdiv" style="position:relative;overflow:scroll;border:1px solid #e8e8e8;">
                <div id="chartDailyPlanVsProduction" ej-chart e-isresponsive="true" style="width:{{graphmaxwidth(DailyPlanVsProduction)}};"
                     e-primaryxaxis-title-text="" e-legend-shape="seriesType"
                     e-load=onchartload e-size-height="300px" e-size-width="graphmaxwidth(DailyPlanVsProduction,60)"
                     e-legend-visible="true" e-legend-position="right" e-prerender="chartPreRender"
                     e-title-text="" @*e-primaryyaxis-range-max="graphmaxheight(DailyPlanVsProduction,'MaxQuantity')"*@
                     e-primaryyaxis-title-text="Qty" e-primaryyaxis-range-min="0"
                     e-commonseriesoptions-type="column" e-primaryxaxis-labelIntersectAction="rotate45"
                     e-commonseriesoptions-enableanimation="true" e-commonseriesoptions-tooltip-visible="true"
                     e-commonseriesoptions-tooltip-format="#point.x# : #point.y# #series.name#">

                    <e-series>
                        <e-series e-marker-dataLabel-visible="true"
                                  @*e-marker-dataLabel-verticaltextalignment="near"*@
                                  e-marker-datalabel-horizontaltextalignment="Center"
                                  e-marker-datalabel-showedgelabels="true"
                                  e-marker-dataLabel-angle="0"
                                  e-marker-dataLabel-font-color="yellow"
                                  e-marker-dataLabel-font-fontweight="bold"
                                  e-marker-dataLabel-enablecontrastcolor="true"
                                  e-name="Production" e-datasource="DailyPlanVsProduction" e-xname="Workcenter" e-yname="Production" e-fill="#06B200">
                        </e-series>
                        <e-series e-type="line"
                                  e-marker-dataLabel-visible="true"
                                  @*e-marker-dataLabel-verticaltextalignment="near"*@
                                  e-marker-datalabel-horizontaltextalignment="Center"
                                  e-marker-dataLabel-font-fontweight="bold"
                                  e-marker-dataLabel-enablecontrastcolor="true"
                                  e-marker-shape="series" e-marker-visible="true"
                                  e-marker-size-height="10" e-marker-size-width="10"
                                  e-border-width="5"
                                  e-enableanimation="true" e-tooltip-visible="true" e-name="Plan" e-datasource="DailyPlanVsProduction"
                                  e-xname="Workcenter" e-yname="PlanQuantity" e-fill="#0000ff">
                        </e-series>
                    </e-series>
                </div>
            </div>
        </div>


    </div>
    <div class="row" style="padding-top:20px;">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="text-center" style="position:center;font-weight:bold; background-color:#f2f2f2;">
                {{ChartCaptions.DailyPrifitability}} {{DailyPrifitability.length>0?'All Values are expressed in ' + DailyPrifitability[0].ReportCurrency:'(Please setup report currency)'}}
            </div>
            <div id="graphdivchartDailyPrifitability" style="position:relative;overflow:scroll;border:1px solid #e8e8e8;">
                <div id="chartDailyPrifitability" ej-chart e-isresponsive="true" style="width:{{graphmaxwidth(DailyPrifitability)}};"
                     e-primaryxaxis-title-text="" e-legend-shape="seriesType"
                     e-load=onchartload e-size-height="300px" e-size-width="graphmaxwidth(DailyPrifitability,70)"
                     e-legend-visible="true" e-legend-position="right" e-prerender="chartProfitabilityPreRender"
                     e-title-text="" @*e-primaryyaxis-range-max="graphmaxheight(DailyPrifitability,'MaxValue')"*@
                     e-primaryyaxis-title-text="Amount" e-primaryyaxis-range-min="0"
                     e-commonseriesoptions-type="column" e-primaryxaxis-labelIntersectAction="rotate45"
                     e-commonseriesoptions-enableanimation="true" e-commonseriesoptions-tooltip-visible="true"
                     e-commonseriesoptions-tooltip-format="#point.x# : #point.y# #series.name#">

                    <e-series>
                        <e-series e-marker-dataLabel-visible="true"
                                  @*e-marker-dataLabel-verticaltextalignment="near"*@
                                  e-marker-datalabel-horizontaltextalignment="Center"
                                  e-marker-datalabel-showedgelabels="true"
                                  e-marker-dataLabel-angle="0"
                                  e-marker-dataLabel-font-color="yellow"
                                  e-marker-dataLabel-font-fontweight="bold"
                                  e-marker-dataLabel-enablecontrastcolor="true"
                                  e-name="Revenue on Production" e-datasource="DailyPrifitability" e-xname="Workcenter" e-yname="RevenueOnProduction" e-fill="#06B200">
                        </e-series>
                        <e-series e-type="line"
                                  e-marker-dataLabel-visible="false"
                                  @*e-marker-dataLabel-verticaltextalignment="near"*@
                                  e-marker-datalabel-horizontaltextalignment="Center"
                                  e-marker-dataLabel-font-fontweight="bold"
                                  e-marker-dataLabel-enablecontrastcolor="true"
                                  e-marker-shape="series" e-marker-visible="true"
                                  e-marker-size-height="10" e-marker-size-width="10"
                                  e-marker-dataLabel-font-color="green"
                                  e-border-width="5"
                                  e-enableanimation="true" e-tooltip-visible="true" e-name="Standard Workcenter Cost" e-datasource="DailyPrifitability"
                                  e-xname="Workcenter" e-yname="TotalWCCost" e-fill="orange">
                        </e-series>
                        <e-series e-type="line"
                                  e-marker-dataLabel-visible="false"
                                  @*e-marker-dataLabel-verticaltextalignment="near"*@
                                  e-marker-datalabel-horizontaltextalignment="Center"
                                  e-marker-dataLabel-font-fontweight="bold"
                                  e-marker-dataLabel-font-color="red"
                                  e-marker-dataLabel-enablecontrastcolor="true"
                                  e-marker-shape="series" e-marker-visible="true"
                                  e-marker-size-height="10" e-marker-size-width="10"
                                  e-border-width="5"
                                  e-enableanimation="true" e-tooltip-visible="true" e-name="Revenue on Target" e-datasource="DailyPrifitability"
                                  e-xname="Workcenter" e-yname="RevenueOnTarget" e-fill="#0000ff">
                        </e-series>


                    </e-series>
                </div>
            </div>
        </div>


    </div>


    <div class="row" @*ng-show="WorkcenterWiseWIPListGraph.length>0"*@ style="padding-top:20px;">

        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="text-center" style="position:center;font-weight:bold; background-color:#f2f2f2;">
                WIP
            </div>
            <div id="graphdivchartWIP" style="position:relative;overflow:scroll;border:1px solid #e8e8e8;">
                <div id="chartWIP" ej-chart e-isresponsive="true" style="width:{{graphmaxwidth(WorkcenterWiseWIPListGraph)}};"
                     e-primaryxaxis-title-text="" e-legend-shape="seriesType"
                     e-load=onchartload e-size-height="300px" e-size-width="graphmaxwidth(WorkcenterWiseWIPListGraph,70)"
                     e-legend-visible="true" e-legend-position="right" e-prerender="chartWIPPreRender"
                     e-title-text="" @*e-primaryyaxis-range-max="graphmaxheight(WorkcenterWiseWIPListGraph,'MaxValue')"*@
                     e-primaryyaxis-title-text="Qty" e-primaryyaxis-range-min="0"
                     e-commonseriesoptions-type="column" e-primaryxaxis-labelIntersectAction="rotate45"
                     e-commonseriesoptions-enableanimation="true" e-commonseriesoptions-tooltip-visible="true"
                     e-commonseriesoptions-tooltip-format="#point.x# : #point.y# #series.name#">

                    <e-series>
                        <e-series e-marker-dataLabel-visible="true"
                                  @*e-marker-dataLabel-verticaltextalignment="near"*@
                                  e-marker-datalabel-horizontaltextalignment="Center"
                                  e-marker-datalabel-showedgelabels="true"
                                  e-marker-dataLabel-angle="0"
                                  e-marker-dataLabel-font-color="yellow"
                                  e-marker-dataLabel-font-fontweight="bold"
                                  e-marker-dataLabel-enablecontrastcolor="true"
                                  e-name="WIP" e-datasource="WorkcenterWiseWIPListGraph" e-xname="WorkCenter" e-yname="WIP" e-fill="#06B200">
                        </e-series>
                        <e-series e-type="line"
                                  e-marker-dataLabel-visible="false"
                                  @*e-marker-dataLabel-verticaltextalignment="near"*@
                                  e-marker-datalabel-horizontaltextalignment="Center"
                                  @*e-marker-dataLabel-Textposition="Middle"*@
                                  e-marker-dataLabel-font-fontweight="bold"
                                  e-marker-dataLabel-enablecontrastcolor="true"
                                  e-marker-shape="circle" e-marker-visible="false"
                                  e-marker-size-height="10" e-marker-size-width="10"
                                  e-border-width="5"
                                  e-enableanimation="true" e-tooltip-visible="true" e-name="Capacity" e-datasource="WorkcenterWiseWIPListGraph"
                                  e-xname="WorkCenter" e-yname="Capacity" e-fill="#0000ff">
                        </e-series>
                    </e-series>
                </div>
            </div>
        </div>

    </div>

    @*WIP Chart*@

    <div class="row" style="padding-top:20px;">

        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="text-center" style="position:center;font-weight:bold; background-color:#f2f2f2;">
                {{ChartCaptions.PlanVsProduction30}}
            </div>
            <div id="graphdiv" style="position:relative;overflow:scroll;border:1px solid #e8e8e8;">
                <div id="chartDailyLast30DaysPlanVsProduction" ej-chart e-isresponsive="true" style="width:{{graphmaxwidth(DailyLast30DaysPlanVsProduction)}};"
                     e-primaryxaxis-title-text="" e-legend-shape="seriesType"
                     e-load=onchartload e-size-height="300px" e-size-width="graphmaxwidth(DailyLast30DaysPlanVsProduction,70)"
                     e-legend-visible="true" e-legend-position="right" e-prerender="chartPreRender"
                     e-title-text="" @*e-primaryyaxis-range-max="graphmaxheight(DailyLast30DaysPlanVsProduction,'MaxQuantity')"*@
                     e-primaryyaxis-title-text="Qty" e-primaryyaxis-range-min="0"
                     e-commonseriesoptions-type="column" @*e-primaryxaxis-labelIntersectAction="rotate45"*@
                     e-commonseriesoptions-enableanimation="true" e-commonseriesoptions-tooltip-visible="true"
                     e-commonseriesoptions-tooltip-format="#point.x# : #point.y# #series.name#">

                    <e-series>
                        <e-series e-marker-dataLabel-visible="true"
                                  e-marker-datalabel-horizontaltextalignment="Center"
                                  e-marker-datalabel-showedgelabels="true"
                                  e-marker-dataLabel-angle="0"
                                  e-marker-dataLabel-font-color="yellow"
                                  e-marker-dataLabel-font-fontweight="bold"
                                  e-marker-dataLabel-enablecontrastcolor="true"
                                  e-name="Production" e-datasource="DailyLast30DaysPlanVsProduction" e-xname="Date" e-yname="Production" e-fill="#06B200">
                        </e-series>
                        <e-series e-type="line"
                                  e-marker-dataLabel-visible="false"
                                  @*e-marker-dataLabel-verticaltextalignment="near"*@
                                  e-marker-datalabel-horizontaltextalignment="Center"
                                  e-marker-dataLabel-font-fontweight="bold"
                                  e-marker-dataLabel-enablecontrastcolor="true"
                                  e-marker-shape="circle" e-marker-visible="false"
                                  e-marker-size-height="10" e-marker-size-width="10"
                                  e-border-width="5"
                                  e-enableanimation="true" e-tooltip-visible="true" e-name="Plan" e-datasource="DailyLast30DaysPlanVsProduction"
                                  e-xname="Date" e-yname="PlanQuantity" e-fill="#0000ff">
                        </e-series>
                    </e-series>
                </div>
            </div>
        </div>

    </div>
</div>
    <div class="row" style="padding-top:20px;">
        <div class="table-responsive modal-table" >
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Line / WC</th>
                        <th ng-repeat="x in HourlyProductionList">{{x.ProductionBookingPeriod}}</th>
                    </tr>
                </thead>
                <tbody>
                    @*<tr ng-repeat="x in FGCharacteristicsValueList">
                            <td>{{x.Id}}</td>
                            <td>{{x.Ratio}}</td>
                        </tr>*@
                </tbody>
            </table>

        </div>

    </div>

<script type="text/template" id="OrderWiseProductionNavigation">
    <div class="common-btn">
        <ul class="list-inline small">
            <li>
                <button ng-click="$parent.getOrderWiseProduction(data);" class="btn small" style="height: 28px; width: 36px; padding: 0px; margin: 0px;font-weight:bolder;">
                    PRD
                </button>
            </li>
        </ul>
    </div>
</script>
<script type="text/template" id="WCWiseProductionNavigation">
    <div class="common-btn">
        <ul class="list-inline small">
            <li>
                <button ng-click="$parent.GetWorkCenterWiseWIP(data);" class="btn small" style="height: 28px; width: 36px; padding: 0px; margin: 0px;font-weight:bolder;">
                    WC
                </button>
            </li>
        </ul>
    </div>
</script>
<script type="text/template" id="ProductionRelayWiseProductionNavigation">
    <div class="common-btn">
        <ul class="list-inline small">
            <li>
                <button ng-click="$parent.getProductionRelay(data);" class="btn small" style="height: 28px; width: 36px; padding: 0px; margin: 0px;font-weight:bolder;">
                    RL
                </button>
            </li>
        </ul>
    </div>
</script>

<ej-dialog id="dialogProductionOrderWiseProduction" title=" Production(Production Order Wise)" e-enablemodal="true" e-position-y="0" e-target="#MainContainer" e-showoninit="false" e-close="onDialogClose" e-minwidth="900px" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-1 col-md-1"> Entity </div>
        <div class="col-xs-12 col-sm-2 col-md-2"> :{{SelectedEntityText}} </div>
        <div class="col-xs-12 col-sm-1 col-md-1"> Date   </div>
        <div class="col-xs-12 col-sm-2 col-md-2"> :{{FromDateParameter}}</div>
        <div class="col-xs-12 col-sm-1 col-md-1"> Process </div>
        <div class="col-xs-12 col-sm-2 col-md-2">:{{SelectedProcess.UserName}}  </div>
        <div class="col-xs-12 col-sm-1 col-md-1"></div>
        <div class="col-xs-12 col-sm-2 col-md-2"></div>

        <div class="col-xs-12 col-sm-12 col-md-12">
            <div style="color:black;" id="GridProductionOrderWiseProduction" ej-grid e-datasource="ProductionOrderWiseProductionList" e-showstackedheader="true"
                 e-allowfiltering="true" e-allowpaging="true" e-summaryrows="summaryRowsWIP" e-allowsorting="true" e-allowresizetofit="true" @*e-pagesettings-pagesize="12"*@
                 e-allowselection="true" e-filtersettings-filterType="excel" e-rowdatabound="PRWIPRowDataBound">

                <div e-stackedheaderrows>
                    <div e-stackedheaderrow>
                        <div e-stackedheadercolumns>
                            <div e-stackedheadercolumn e-headertext="For The Day Production" e-column="InQuantityToday,OutQuantityToday,KillQuantityToday"></div>
                            <div e-stackedheadercolumn e-headertext="Up To Date Production" e-column="InQuantity,OutQuantity,KillQuantity,WIP"></div>
                        </div>
                    </div>
                </div>
                <div e-columns>
                    @*Id	ProductionRemarks	ProductionStatus	EntityName	EntityId	ProductionStatusName	POID
                        Material	Product	ProductCategory	ProductMasterId	SOQuantity	DeliveryDate	MasterOrderId	BuyerRefNo	OwnRefNo
                        StyleNo	OwnStyleNo	SONo	SODesc	buyer	Customer	ProductionOrderId	InQuantity	OutQuantity	KillQuantity
                        InQuantityToday	OutQuantityToday	KillQuantityToday	Entity	Plant*@

                    @*<div e-column e-field="Entity" e-headertext="Entity"></div>*@
                    <div e-column e-template="#showPRPlanList" e-headertext="Prod. Ord. Id" e-width="100"></div>
