                                <div class=" show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="detailModel.ByProductCategory" tabindex="30" name="By Product Category" required>
                                            <option value=""></option>
                                            <option value="ForSale">For Sale</option>
                                            <option value="ReUse">Re-Use</option>
                                        </select>
                                    </div>
                                </div>
