                                <label class=" control-label">Invisible Loss%<sup>*</sup></label>
                                <div class=" show-message">
                                    <input type="text" ng-model="detailModel.InvisibleLossPercentage" name="Invisible Loss%" required onkeypress="return isNumber(event)" class="form-control" tabindex="32" maxlength="50">
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl" style="margin-left: 0px; padding-right: 44px;">
                            <div class="form-group" show-errors>
                                <label class=" control-label">Production Booking Level<sup>*</sup></label>
                                <div class=" show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="detailModel.ProductionBookingLevel" tabindex="30" name="Production Booking Level" required>
                                            <option value=""></option>
                                            <option value="ProductionReference">Production Reference</option>
                                            <option value="ProductionReferenceandProductCode">Production Reference & Product Code</option>
                                            <option value="SOId">SO Id</option>
                                            <option value="LineItemId">Line Item Id</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl" style="margin-left: -13px; padding-right: 44px;">
                            <div class="form-group" show-errors>
                                <label class=" control-label">Issue/ Consumption Booking<sup>*</sup></label>
                                <div class=" show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="detailModel.IssueConsumptionBooking" tabindex="30" name="Issue/ Consumption Booking" required>
                                            <option value=""></option>
                                            <option value="Issue">Issue</option>
                                            <option value="Consumption">Consumption</option>
                                            <option value="NA">NA</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl" style="margin-left: 12px; margin-right: 0px; padding-right: 44px ">
                            <div class="form-group">
                                <label class="control-label">Remarks</label>
                                <div>
                                    <textarea type="text" ng-model="detailModel.Remarks" class="form-control" tabindex="37" maxlength="250"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="clearfix"></div>

                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="detailSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{DetailAction}}</button></li>
                                @*<li><button ng-click="DetailDelete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                                <li><button ng-click="closeDetaiPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                                <li> <button ng-click="detailClear()" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

