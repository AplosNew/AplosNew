<togglable name="{{FormTitle}}"></togglable>
<div class="form-horizontal" ng-form name="ModelNewForm">
    <div class="form-elements" id="Marker">
        <input type="hidden" ng-model="ModelNew.Id">

        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Sequence" ng-model="ModelNew.Sequence" class="form-control" disabled  n-decimals="4" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" disabled maxlength="15" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" disabled required tabindex="5" maxlength="50">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Width</label>
                    <div class="col-sm-8">
                        <input type="text" name="Length" ng-model="ModelNew.Width" ng-change="GetGrossWeight();" class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Cut Plan<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" disabled ng-model="ModelNew.CutPlanId" name="Cut Plan" ng-change="GetCutPlanRatioCbo();" ng-options="item.Id as item.UserName for item in CutPlantList" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Marker Group<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" disabled ng-model="ModelNew.MarkerGroup" name="Marker Group" ng-options="item.MarkerGroup as item.MarkerGroup for item in MarkerGroupList" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Gross Length</label>
                    <div class="col-sm-8">
                        <input type="text" name="Length" ng-model="ModelNew.GrossLength" ng-change="GetGrossWeight();" class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Gross Weight</label>
                    <div class="col-sm-8">
                        <input type="text" name="Length" ng-model="ModelNew.GrossWeight"  class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">GrossConsuption/Pcs</label>
                    <div class="col-sm-8">
                        <input type="text" name="Length" ng-model="ModelNew.GrossConsuptionperPcs" class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Description</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" disabled rows="3" ng-model="ModelNew.Description" tabindex="7" maxlength="250"></textarea>
                    </div>
                </div>

            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" disabled required tabindex="2" maxlength="10">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" disabled required tabindex="4" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Check By</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select name="Check By" class="form-control" disabled ng-model="ModelNew.CheckById" tabindex="13">
                                <option value=""></option>
                                <option ng-repeat="item in CheckByList" value="{{item.Value}} ">{{item.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Cutable Width</label>
                    <div class="col-sm-8">
                        <input type="text" name="Length" ng-model="ModelNew.CutableWidth" ng-change="GetNetWeight();" class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Cut Plan Ratio<sup>*</sup></label>
                    <div class="col-sm-3 show-message">
                        <div class="select-style">
                            <select class="form-control" disabled ng-model="ModelNew.CutPlanRatioId" name="Cut Plan Ratio" ng-change="GetNoOfPcs();" ng-options="item.Id as item.Ratio for item in CutPlantRatioList" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                    <label class="col-sm-2 control-label">No Of Pcs</label>
                    <div class="col-sm-3">
                        <input type="text" name="NoOfPcs" ng-model="ModelNew.NoOfPcs" class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">GSM</label>
                    <div class="col-sm-8">
                        <input type="text" name="Length" ng-model="ModelNew.GSM" ng-change="GetGrossWeight();GetNetWeight();" class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Net Length</label>
                    <div class="col-sm-8">
                        <input type="text" name="Length" ng-model="ModelNew.NetLength" ng-change="GetNetWeight();" class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Net Weight</label>
                    <div class="col-sm-8">
                        <input type="text" name="Length" ng-model="ModelNew.NetWeight"  class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                    </div>
                </div>


                <div class="form-group">
                    <label class="col-sm-4 control-label">NetConsuption/Pcs</label>
                    <div class="col-sm-8">
                        <input type="text" name="Length" ng-model="ModelNew.NetConsuptionperPcs" class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" disabled rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Active</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>



            </div>
            <div class="col-md-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>

        </div>


    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>

            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
        </div>

    </div>
</div>

