<div class="modal fade site-modal in" id="MasterPlanPoPUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeSubProcessListPopUp()">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Master Plan</h4>
            </div>
            <div class="modal-body">
                <div id="GridMasterPlan" ej-grid e-datasource="MasterPlanList" e-recorddoubleclick="SetMasterPlan"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true">
                    <div e-columns>

                        <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                        <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>
                        <div e-column e-field="PlanName" e-headertext="Plan Name" e-width="100"></div>
                        <div e-column e-field="UserName" e-headertext="User Name" e-width="100"></div>
                        <div e-column e-field="PlanStatus" e-headertext="Plan Status" e-width="100"></div>
                        <div e-column e-field="ResponsiblePerson" e-headertext="Resonsible Person" e-width="100"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="CloseMasterPlanPopUp()" class="btn">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="SOPoPUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="CloseSOPopUp()">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Sales Order</h4>
