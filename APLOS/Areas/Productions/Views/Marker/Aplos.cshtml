<togglable name="{{FormTitle}}"></togglable>
<div class="form-horizontal" ng-form name="ModelNewForm">
    <div class="form-elements" id="Marker">
        <input type="hidden" ng-model="ModelNew.Id">

        <div class="row">
            <div class="col-xs-12">
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100%" required />
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                        </div>
                    </div>

                    
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Master Plan<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <input type="text" name="Master Plan" ng-model="ModelNew.MasterPlan" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="GetMasterPlanPopUp();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                    @*<button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>*@
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Check By</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select name="Check By" class="form-control" ng-model="ModelNew.CheckById" tabindex="13">
                                    <option value=""></option>
                                    <option ng-repeat="item in CheckByList" value="{{item.Value}} ">{{item.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-12 control-label"></label>
                    </div>
                </div>
            </div>

            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button style="margin-left: 5px;" ng-click="GetSOPopUp();" class="btn"><i class="glyphicon glyphicon-plus" style="top: 1px;"></i> Add SO</button></li>
                    </ul>
                </div>
                <div id="GridSSO" ej-grid e-datasource="selectedSOList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true">
                    <div e-columns>
                        <div e-column e-field="DeliveryDate" e-headertext="DeliveryDate" e-width="100"></div>
                        <div e-column e-field="BuyerReferenceNo" e-headertext="BuyerRef" e-width="100"></div>
                        <div e-column e-field="OwnReferenceNo" e-headertext="OwnRef" e-width="100"></div>
                        <div e-column e-field="Qty" e-headertext="Qty" e-width="100"></div>
                        <div e-column e-field="SONo" e-headertext="SONo" e-width="100"></div>
                        <div e-column e-field="SOPlanQty" e-headertext="SOPlanQty" e-width="100"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                    </div>

                </div>
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button style="margin-left: 5px;" ng-click="GetFabricGRNRowList();" class="btn"><i class="glyphicon glyphicon-plus" style="top: 1px;"></i> Add Fabric GRNRow</button></li>
                    </ul>
                </div>
                <div id="GridGSRR" ej-grid e-datasource="SelectedFabricGRNRowList" 
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true">
                    <div e-columns>
                        <div e-column e-field="InventoryReceiveDetailId" e-headertext="GRNRowId" e-width="80"></div>
                        <div e-column e-field="GRNNo" e-headertext="GRNNo" e-width="80"></div>
                        <div e-column e-field="GRNDate" e-headertext="GRNDate" e-width="80"></div>
                        <div e-column e-field="PartyName" e-headertext="Party Name" e-width="100"></div>
                        <div e-column e-field="MaterialMasterName" e-headertext="Material Master" e-width="100"></div>
                        <div e-column e-field="ArticleName" e-headertext="Article" e-width="100"></div>
                        <div e-column e-field="SKUValue" e-headertext="SKU" e-width="80"></div>
                        <div e-column e-field="TransactionQty" e-headertext="Qty" e-width="80"></div>
                        <div e-column e-field="UOM" e-headertext="UOM" e-width="50"></div>
                    </div>
                   
                </div>
            </div>

            <div class="col-xs-12">
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Cut Plan<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.CutPlanId" name="Cut Plan" ng-change="GetCutPlanRatioCbo();" ng-options="item.Id as item.UserName for item in CutPlantList" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Marker Group<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.MarkerGroup" name="Marker Group" ng-options="item.MarkerGroup as item.MarkerGroup for item in MarkerGroupList" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Width</label>
                        <div class="col-sm-6">
                            <input type="text" name="Length" ng-model="ModelNew.Width" ng-change="GetGrossWeight();" class="form-control" maxlength="15" n-decimals="4" required tabindex="3">
                        </div>
                        <div class="col-sm-2">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.WidthUom" name="Width Uom" ng-options="item.Value as item.Text for item in WidthUomList" required>
                                    <option value="Yard">Yard</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Gross Length</label>
                        <div class="col-sm-6">
                            <input type="text" name="Length" ng-model="ModelNew.GrossLength" ng-change="GetGrossWeight();" class="form-control" maxlength="15" n-decimals="4" required tabindex="3">
                        </div>
                        <div class="col-sm-2">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.GrossLengthUom" name="Length Uom" ng-options="item.Value as item.Text for item in lengthUomList" required>
                                    <option value="Inch">Inch</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Gross Weight</label>
                        <div class="col-sm-8">
                            <input type="text" name="Length" ng-model="ModelNew.GrossWeight" disabled class="form-control" maxlength="15" n-decimals="4" tabindex="3">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">GrossConsuption/Pcs</label>
                        <div class="col-sm-8">
                            <input type="text" name="Length" ng-model="ModelNew.GrossConsuptionperPcs" disabled class="form-control" maxlength="15" n-decimals="4" tabindex="3">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Description</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="ModelNew.Description" tabindex="7" maxlength="250"></textarea>
                        </div>
                    </div>

                </div>

                <div class="col-xs-12 col-sm-6 col-md-6">


                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Cut Plan Ratio<sup>*</sup></label>
                        <div class="col-sm-3 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.CutPlanRatioId" name="Cut Plan Ratio" ng-change="GetNoOfPcs();" ng-options="item.Id as item.Ratio for item in CutPlantRatioList" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <label class="col-sm-2 control-label">No Of Pcs</label>
                        <div class="col-sm-3">
                            <input type="text" name="NoOfPcs" ng-model="ModelNew.NoOfPcs" class="form-control" disabled maxlength="15" n-decimals="4" required tabindex="3">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">GSM</label>
                        <div class="col-sm-8">
                            <input type="text" name="Length" ng-model="ModelNew.GSM" ng-change="GetGrossWeight();GetNetWeight();" class="form-control" maxlength="15" n-decimals="4" required tabindex="3">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Cutable Width</label>
                        <div class="col-sm-8">
                            <input type="text" name="Length" ng-model="ModelNew.CutableWidth" ng-change="GetNetWeight();" class="form-control" maxlength="15" n-decimals="4" required tabindex="3">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Net Length</label>
                        <div class="col-sm-6">
                            <input type="text" name="Length" ng-model="ModelNew.NetLength" ng-change="GetNetWeight();" class="form-control" maxlength="15" n-decimals="4" required tabindex="3">
                        </div>
                        <div class="col-sm-2">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.LengthUom" name="Length Uom" ng-options="item.Value as item.Text for item in lengthUomList" required>
                                    <option value="Inch">Inch</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Net Weight</label>
                        <div class="col-sm-8">
                            <input type="text" name="Length" ng-model="ModelNew.NetWeight" disabled class="form-control" maxlength="15" n-decimals="4" tabindex="3">
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-sm-4 control-label">NetConsuption/Pcs</label>
                        <div class="col-sm-8">
                            <input type="text" name="Length" ng-model="ModelNew.NetConsuptionperPcs" disabled class="form-control" maxlength="15" n-decimals="4" tabindex="3">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>



                </div>
            </div>

            <div class="col-md-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>

        </div>


    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>

            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="CheckByStatus" e-headertext="Check Status" e-width="5"></div>
        </div>

    </div>
</div>



@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterByTypePopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterArticleSearchPopUp.cshtml")

<div class="modal fade site-modal in" id="rmaterialmastersearchpopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Raw {{materialTitle}}
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="mmPopUpParameters.searchBy">
                                            <option ng-repeat="option in searchbyMaterialMasterDatalist" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="mmPopUpParameters.search" ng-enter="loadMMData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadMMData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped text-left">
                        <thead>
                            <tr>
                                <th>Material Type</th>
                                <th>Material Group</th>
                                <th>Product</th>
                                <th>Code</th>
                                <th>Material Name</th>
                                <th>Base UoM</th>
                                <th>Id</th>
                                <th>HSN Code</th>
                                <th>WithSKU</th>
                                <th>IsAsset</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in materialmasterSearchData  |itemsPerPage:$root.pageSize" pagination-id="metaData.name + 'materialmasterSearchData'"
                                total-items="mmPopUpParameters.total_count" ng-dblclick="setRMaterialMasterData(x);">
                                <td>{{x.MaterialTypeName}}</td>
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.ProductMasterName}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.BaseUoM}}</td>
                                <td>{{x.Id}}</td>
                                <td>{{x.HSNCode}}</td>
                                <td>{{x.WithSKU?'Yes':'No'}}</td>
                                <td>{{x.IsAsset?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls pagination-id="metaData.name + 'materialmasterSearchData'"
                                             max-size="2"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadMMData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="rarticleSearchPop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Article<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body text-center">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="articlePopUpParameters.searchBy">
                                            <option ng-repeat="option in searchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="articlePopUpParameters.search" ng-enter="loadArticleData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadArticleData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material Group</th>
                                <th>Material Code</th>
                                <th>Material</th>
                                <th>Article Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in dataPlate |itemsPerPage:articlePopUpParameters.pageSize" total-items="articlePopUpParameters.total_count"
                                pagination-id="metaData.name + 'dataPlate'" ng-dblclick="selectRMarticle(x);">
                                <td>{{x.MaterialGroup}}</td>
                                <td>{{x.MaterialCode}}</td>
                                <td>{{x.MaterialMasterName}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="2"
                                             pagination-id="metaData.name + 'dataPlate'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadArticleData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>

