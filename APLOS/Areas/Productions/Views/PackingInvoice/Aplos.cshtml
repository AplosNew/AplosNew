                                <div class="select-style">
                                    <select id="entityId" class="form-control" disabled name="Entity" ng-model="salesVM.EntityId" tabindex="7" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
