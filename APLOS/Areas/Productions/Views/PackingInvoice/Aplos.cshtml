<div class="modal fade site-modal in" id="receiveTaxPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Tax Information <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <p>Taxable amount : <b>{{taxAbleAmnt| number| setDecimal:currencyPrecision}}</b>&nbsp;<b>{{Currency}}</b></p>
                    <p>HSNCode : <b>{{HSNCode}}</b></p>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">If Percentage Applicable</label>
                        <div class="col-sm-6">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="TaxOption" ng-model="salesVM.TaxOption" value="Yes" ng-click="TaxOption('Yes');"> @*ng-hide="HSNCode !=null"*@
                                    <span class="cr"><i class="cr-icon"></i></span>Yes
                                </label>
                                <label>
                                    <input type="radio" name="TaxOption" ng-model="salesVM.TaxOption" value="No" ng-click="TaxOption('No');">@*ng-hide="HSNCode !=null"*@
                                    <span class="cr"><i class="cr-icon"></i></span>No
                                </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div>
                    <p class="col-md-11"></p>
                    <button type="button" class="btn btn-action" ng-click="addTax();">Add Tax</button>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" border="1" id="AddTax">
                        <thead>
                            <tr>
                                <th ng-hide="true">id</th>
                                <th>Tax Category</th>
                                <th ng-hide="true">HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in receiveTaxList">
                                <td ng-hide="true">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Id" readonly>
                                    </div>
                                </td>
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList" ng-change="onchangeFunction1(x.TaxCategoryId)"></select>
                                    </div>
                                </td>
                                <td ng-hide="true">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.HSNCode">
                                    </div>
                                </td>
                                <td>
                                    <div class="show-message">
                                        <input type="text" n-decimals="4" class="form-control text-right" ng-model="x.Percentage" ng-keyup="calculateTaxAmount(x);" ng-disabled="salesVM.TaxOption ==='No'"> @*|| HSNCode !=null"*@
                                    </div>
                                </td>
                                <td class="text-right">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TotalAmount" ng-keyup="checkRowValidation(x, $index)" ng-disabled="salesVM.TaxOption ==='Yes'">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="taxDel(x.Id,$index)" ng-disabled="salesVM.RowState==='Posted'" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right"><strong>{{receiveTaxList | sumByKey : 'TotalAmount'| setDecimal:2| number:2 }}</strong></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
