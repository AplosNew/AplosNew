                                    <select class="form-control" name="Trancastion Type" ng-model="salesVM.TrancastionTypeId" ng-options="item.Value as item.Text for item in TrancastionTypeCboList" tabindex="8"required>
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">

