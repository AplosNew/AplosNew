                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchInvoiceList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th style="width: 22px">InvoiceNo</th>
                <th style="width: 25px">Date</th>
                <th style="width: 50px">@Library.Model.Parties.PartyType.Customer.ToString()</th>
                @*  <th>Bill To</th>
                    <th>DocRef No</th>*@
                <th style="width: 20px">Amount</th>
                <th style="width: 10px">Currency</th>
                <th style="width: 10px">Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in invoiceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                <td>{{x.InvoiceNo}}</td>
                <td>{{x.InvoiceDate}}</td>
                <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                @*<td>{{x.BillTo}}</td>
                    <td>{{x.DocRefNo}}</td>*@
                <td>{{x.Amount | number:2}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td>{{x.RowState}}</td>
                <td class="text-left">
                    <button type="button" ng-click="SendMailToParty(x);" ng-disabled="x.IsMail" title="Mail" class="btn"><i class="glyphicon glyphicon-envelope"></i></button>
                    <button type="button" ng-click="CommercialInvoicePackingListReport(x);" ng-hide="x.CurrencyId==x.BaseCurrencyId" title="Commercial Invoice Packing List" class="btn"><i class=""></i>PK</button>
                    <button type="button" ng-click="GetLotWiseTaxInvoice(x);" title="Lot Wise Tax Invoice" class="btn"><i class=""></i>L-TI</button>
                    <button type="button" ng-click="CommercialInvoiceReport(x);" ng-hide="x.CurrencyId==x.BaseCurrencyId" title="Commercial Invoice" class="btn"><i class=""></i>CI</button>
                    <button type="button" ng-click="LRDraft(x);" ng-hide="x.CurrencyId==x.BaseCurrencyId" title="LR Draft" class="btn"><i class=""></i>Draft</button>
                    <button type="button" ng-click="BillofExchange(x);" ng-hide="x.CurrencyId==x.BaseCurrencyId" title="Bill of Exchange" class="btn"><i class=""></i>BE</button>
                    <button type="button" ng-click="CertificateofOrigin(x);" ng-hide="x.CurrencyId==x.BaseCurrencyId" title="Certificate of Origin" class="btn"><i class=""></i>CTO</button>
                    <button type="button" ng-click="BankLatter(x);" ng-hide="x.CurrencyId==x.BaseCurrencyId" title="Bank Letter" class="btn"><i class=""></i>BL</button>
                    <button type="button" ng-click="BeneficiaryCertificate(x);" ng-hide="x.CurrencyId==x.BaseCurrencyId" title="Beneficiary Certificate" class="btn"><i class=""></i>BC</button>
                    <button type="button" ng-click="InsuranceCoverLetter(x);" ng-hide="x.CurrencyId==x.BaseCurrencyId" title="Insurance Cover Letter" class="btn"><i class=""></i>INS</button>
                    <button type="button" ng-click="ANNEXUREReport(x);" ng-hide="x.CurrencyId==x.BaseCurrencyId" title="ANNEXURE" class="btn"><i class=""></i>AX</button>

                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
