                            <div ng-form="tabForm2">
                                <ul class="common-btn list-inline text-left">
                                    <li>
                                        <button ng-click="serviceChargePopUp();" ng-disabled="salesVM.RowState==='Posted'" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Charges</button>
                                    </li>
                                </ul>
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
