                                                        <strong>{{salesOrderList | sumByKey : 'Balance'| setDecimal:2 | number:2}}</strong>
                                                    </td>*@
                                                <td class="text-right">
                                                    <strong>{{salesOrderList | sumByKey : 'TransactionAmount'| setDecimal:2 | number:2}}</strong>
                                                </td>
                                                <td class="text-right">
                                                    <strong>{{salesOrderList | sumByKey : 'TaxAmount'| setDecimal:2 | number:2}}</strong>
                                                </td>
                                                <td class="text-right"><strong>{{salesOrderList | sumByKey : 'ServiceCharge'| setDecimal:2 | number:2}}</strong></td>
                                                <td class="text-right"><strong>{{salesOrderList | sumByKey : 'ServiceTax'| setDecimal:2 | number:2}}</strong></td>
                                                <td class="text-right">
                                                    <strong>{{salesOrderList | sumByKey : 'NetAmount'| setDecimal:2 | number:2}}</strong>
                                                </td>
                                                <td></td>
                                            </tr>
