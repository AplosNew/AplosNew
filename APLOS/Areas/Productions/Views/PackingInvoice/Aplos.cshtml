                                                <td>
                                                    <input type="text" class="form-control" ng-model="x.GoodsDescription" style="width: 230px;">
                                                </td>
                                                <td>{{x.SKU1}}</td>
                                                <td>{{x.SKU2}}</td>
                                                <td class="text-right">
