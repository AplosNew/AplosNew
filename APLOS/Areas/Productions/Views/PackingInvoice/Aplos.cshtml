                                                <td class="text-right">{{x.TransactionQty | number:2}}</td>
                                                <td class="text-right">{{x.TransactionAmount | number:2}}</td>
                                                <td class="text-right">{{x.TaxAmount | number:2}}</td>
                                                <td class="text-right">{{x.ServiceCharge | number:2}}</td>
                                                <td class="text-right">{{x.ServiceTax | number:2}}</td>
                                                <td class="text-right">{{x.NetAmount | number:2}}</td>
                                                <td class="text-right">
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="getMaterialTaxList(x, false,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button>
                                                        </li>
                                                        <li>
                                                            <button ng-click="removeMaterialRow(x.Id,$index)" ng-disabled="salesVM.RowState==='Posted'" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                        </li>
                                                        <li>
                                                            <button ng-click="cancelMaterialRow(x.Id,$index)" ng-hide="salesVM.RowState==='Posted'" class="btn btn-action tooltip-here" data-placement="top" title="Cancel"><i class="glyphicon glyphicon-off"></i></button>
                                                        </li>
                                                    </ul>
