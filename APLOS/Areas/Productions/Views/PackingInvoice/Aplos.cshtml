                                <input type="text" name="BL Date" ng-model="salesVM.BLDate" datepicker class="form-control">
                                @*<input type="text" class="form-control" ej-numerictextbox e-decimalplaces="0" ej-disabled="true" e-enablertl="false" e-value="model.Amount" e-width="100%" />*@
