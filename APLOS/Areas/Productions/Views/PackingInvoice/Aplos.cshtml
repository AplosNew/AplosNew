                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" title="BL Number">BL No.</label>
                            <div class="col-sm-3" style="width: 115px;margin-left: -33px;">
                                <input type="text" ng-maxlength="50" name="BL Number" ng-model="salesVM.BLNumber" class="form-control" tabindex="4" capitalize autocomplete="off">
