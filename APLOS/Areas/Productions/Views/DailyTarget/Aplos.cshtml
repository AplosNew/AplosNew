<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Daily Target</h3>
<div class="form-elements form-horizontal" ng-form name="DailyTargetForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="DailyTargetList.length>0" id="ddlEntity" ng-model="DailyProductionTargetNew.EntityId" ng-change="loadProcessList(DailyProductionTargetNew.EntityId)" name="Entity" ng-options="item.Id as item.UserName for item in entityList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="DailyTargetList.length>0" ng-model="DailyProductionTargetNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in processList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Target Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-disabled="DailyTargetList.length>0" ng-model="DailyProductionTargetNew.ProductionDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                </div>
            </div>
        </div>
        <div class="form-group" style="margin-bottom: 25px;">
            <label class="col-sm-4 control-label"></label>

            <div class="col-sm-2" style="padding-right:0;">
                <button ng-click="getDailytarget();" ng-hide="DailyTargetList.length>0" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button>
            </div>
        </div>


    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridDailyTargetList" ej-grid e-datasource="DailyTargetList" e-templaterefresh="DailyTargetAllCheck"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-rowdatabound="rowDataBound">
        <div e-columns>
            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="5"></div>
            <div e-column e-field="Line" e-headertext="Work Center" e-width="15"></div>
            <div e-column e-field="PRNo" e-headertext="PR No" e-width="12"></div>
            <div e-column e-template="#templateSearchPR" e-headertext="" e-width="6"></div>
            <div e-column e-field="Material" e-headertext="Material" e-width="20"></div>
            <div e-column e-field="Article" e-headertext="Article" e-width="20"></div>
            <div e-column e-field="CustomerPONo" e-headertext="PO No." e-width="20"></div>
            <div e-column e-field="BuyerItemNo" e-headertext="Buyer Item No." e-width="20"></div>

            <div e-column e-template="#templateManPowerWithMachine" e-headertext="Manpower With MC" e-width="15"></div>
            <div e-column e-template="#templateManPowerWithHand" e-headertext="Manpower Without MC" e-width="15"></div>
            <div e-column e-template="#templateSMV" e-headertext="SPT" e-width="15"></div>
            <div e-column e-template="#templateTotalHour" e-headertext="Target Hours" e-width="15"></div>
            <div e-column e-template="#templateQuantity" e-headertext="Target Per Hour" e-width="15"></div>
            <div e-column e-field="Quantity" e-headertext="Quantity" e-width="10"></div>

        </div>
    </div>


    <script type="text/template" id="templateManPowerWithMachine">
        <input type="text" class="form-control" ej-numerictextbox e-decimalplaces="2" e-minValue="0" e-enablertl="false" e-value="data.ManPowerWithMachine" e-width="100%" />
    </script>
    <script type="text/template" id="templateManPowerWithHand">
        <input type="text" class="form-control" ej-numerictextbox e-decimalplaces="2" e-minValue="0" e-enablertl="false" e-value="data.ManPowerWithHand" e-width="100%" />

    </script>
    <script type="text/template" id="templateSMV">
        <input type="text" class="form-control" ej-numerictextbox e-decimalplaces="2" e-minValue="0" e-enablertl="false" e-value="data.SMV" e-width="100%" />

    </script>
    <script type="text/template" id="templateTotalHour">
        <input type="text" class="form-control" ej-numerictextbox e-decimalplaces="2" e-minValue="0" e-enablertl="false" e-value="data.TotalHour" e-width="100%" />

    </script>
    <script type="text/template" id="templateQuantity">
        <input type="text" class="form-control" e-focusout="$parent.CalculateTotalQuantity" ej-numerictextbox e-decimalplaces="0" e-minValue="0" e-enablertl="false" e-value="data.QuantityPerHour" e-width="100%" />

    </script>
    <script type="text/x-jsrender" id="headerTemplate">
        <input type="checkbox" id="headchk" />
    </script>
    <script type="text/template" id="checkboxTemplate">
        <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
    </script>

    <script type="text/template" id="templateSearchPR">
        <div class="common-btn">
            <ul class="list-inline text-right small">
                <li>
                    <button ng-click="$parent.SearchPRPopup(data);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                        <i class="glyphicon glyphicon-search"></i>
                    </button>
                </li>
            </ul>
        </div>
    </script>
    <div class="common-btn" ng-show="DailyTargetList.length>0">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="modal site-modal" id="POItemPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Production Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div style="color:black;" id="Grid" ej-grid e-datasource="SOItemList" e-allowscrolling="true"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-recorddoubleclick="selectSOItem"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>


                        <div e-column e-type="string" e-field="Id" e-headertext="ID" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Cat." e-width="130"></div>
                        <div e-column e-type="string" e-field="buyer" e-headertext="Buyer" e-width="100"></div>
                        <div e-column e-type="string" e-field="MasterOrderId" e-headertext="Order#" e-width="80"></div>
                        <div e-column e-type="string" e-field="BuyerRefNo" e-headertext="Customer Ord#" e-width="80"></div>
                        <div e-column e-type="string" e-field="SODesc" e-headertext="So.Description" e-width="150"></div>
                        <div e-column e-type="number" e-field="Qty" e-headertext="Qty" e-width="60"></div>
                        <div e-column e-type="string" e-field="DeliveryDate" e-headertext="So.Delivery Date" e-width="80"></div>
                        <div e-column e-type="string" e-field="Product" e-headertext="Product" e-width="150"></div>
                        <div e-column e-type="string" e-field="ProductionStatus" e-headertext="Production Status" e-width="90"></div>
                        <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="150"></div>
                        <div e-column e-type="string" e-field="OwnRefNo" e-headertext="Own Ord#" e-width="80"></div>
                        <div e-column e-type="string" e-field="StyleNo" e-headertext="Customer Item#" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnStyleNo" e-headertext="Own Item#" e-width="80"></div>

                        <div e-column e-type="string" e-field="BuyerItemNo" e-headertext="Buyer Item No#" e-width="80"></div>
                        <div e-column e-type="string" e-field="CustomerPONo" e-headertext="PO No#" e-width="80"></div>

                        <div e-column e-type="string" e-field="EntityName" e-headertext="Entity" e-width="90"></div>
                        <div e-column e-type="string" e-field="ProductionRemarks" e-headertext="Remarks" e-width="150"></div>

                        <div e-column e-type="string" e-field="AddedBy" e-headertext="Created By" e-width="80"></div>
                        <div e-column e-field="CreationDate" e-headertext="Creation Date" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
