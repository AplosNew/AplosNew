<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Daily Target</h3>
<div class="form-elements form-horizontal" ng-form name="DailyTargetForm" id="MainDivId">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="DailyTargetList.length>0" id="ddlEntity" ng-model="DailyProductionTargetNew.EntityId" ng-change="loadProcessList(DailyProductionTargetNew.EntityId)" name="Entity" ng-options="item.Id as item.UserName for item in entityList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="DailyTargetList.length>0" ng-model="DailyProductionTargetNew.ProcessId" name="ProcessId" ng-options="item.Value as item.Text for item in processList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Target Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-disabled="DailyTargetList.length>0" ng-model="DailyProductionTargetNew.ProductionDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                </div>
            </div>
        </div>
        <div class="form-group" style="margin-bottom: 25px;">
            <label class="col-sm-4 control-label"></label>

            <div class="col-sm-2" style="padding-right:0;">
                <button ng-click="getDailytarget();" ng-hide="DailyTargetList.length>0" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button>
            </div>
        </div>


    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    @Html.Partial("~/Areas/Productions/Views/DailyTarget/DailyTargetGrid.cshtml")
</div>


<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
@Html.Partial("~/Areas/Productions/Views/DailyTarget/LineDesignCanvas.cshtml")
@Html.Partial("~/Areas/Productions/Views/DailyTarget/EmployeeCardView.cshtml")
@Html.Partial("~/Areas/Productions/Views/DailyTarget/LineLayoutSearchViews.cshtml")


<ej-dialog id="graph" title=" Product Plan Quantity Distribution" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-width="900" e-target="#MainDIV" e-open="enableBtn">
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li> <button ng-click="printChart('chartContainer');" class="btn">Print</button></li>
        </ul>
    </div>
    <div id="graphdiv" style="position:relative;overflow:scroll;width:880px;">
        <div id="chartContainer" ej-chart e-isresponsive="true" style="width:{{graphmaxwidth}};"
             e-primaryxaxis-title-text="Day"
             e-load=onchartload e-size-height="500px" e-size-width="graphmaxwidth"
             e-legend-visible="true" e-legend-position="bottom"
             e-title-text="Qty"
             e-primaryyaxis-title-text="Qty" e-primaryyaxis-range-min="0"
             e-primaryyaxis-range-max="graphmaxheight"
             e-commonseriesoptions-type="column"
             e-commonseriesoptions-enableanimation="true" e-commonseriesoptions-tooltip-visible="true"
             e-commonseriesoptions-tooltip-format="#point.x# : #point.y# #series.name#">

            <e-series>
                <e-series e-name="Production Plan" e-marker-dataLabel-visible="true"
                          e-marker-dataLabel-verticaltextalignment="near"
                          e-marker-dataLabel-angle="270"
                          e-marker-dataLabel-font-fontweight="bold"
                          e-marker-dataLabel-font-color="yellow"
                          e-marker-dataLabel-enablecontrastcolor="true" e-datasource=dataSourceLineGraph e-xname="PlanDate" e-yname="Quantity" e-fill="VPRDATA.Color">
                </e-series>
            </e-series>
        </div>
    </div>

</ej-dialog>

<ej-dialog id="dialogWorkCenterParameters" title=" Product Parameters" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#MainDIV" e-minwidth="900" e-open="enableBtn">
    @*<div class="form-element-ctrl form-horizontal">*@
    @Html.Partial("~/Areas/OrderManagements/Views/productionOrderSchedulingParametersType1/workCenterParameters.cshtml")
    @*</div>*@
</ej-dialog>

@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterArticleSearchPopUp.cshtml")