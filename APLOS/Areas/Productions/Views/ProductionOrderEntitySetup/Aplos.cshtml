<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> Production Order Entity Setup</h3>
@*<togglable name="ProductionOrderEntitySetup"></togglable>*@
<div class="form-elements form-horizontal" ng-form name="ProductionOrderEntitySetupForm">
    <input type="hidden" ng-model="ProductionOrderEntitySetupNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="CompanyId" class="form-control" ng-model="ProductionOrderEntitySetupNew.CompanyId" name="Company" ng-change="getPlant();" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in companyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ProductionOrderEntitySetupNew.ProductionEntityId" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Type</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select name="Type" class="form-control" ng-model="ProductionOrderEntitySetupNew.Type" ng-options="item.Value as item.Text for item in typeList" tabindex="1">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Applicable</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ProductionOrderEntitySetupNew.IsApplicable">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="ProductionOrderEntitySetupNew.PlantId" name="Plant" ng-change="getEntity();getData();" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ProductionOrderEntitySetupNew.FromEntityId" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Order Type</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select name="OrderType" class="form-control" ng-model="ProductionOrderEntitySetupNew.OrderType" ng-options="item.Value as item.Text for item in OrderTypeList" tabindex="1">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

    </div>
    <div class="col-sm-12">
        <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-headertext="Actions" e-template="#ShowActionButtonsBOM" e-width="1"></div>

                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                <div e-column e-field="ProductionEntity" e-headertext="ProductionEntity" e-width="2"></div>
                <div e-column e-field="FromEntity" e-headertext="FromEntity" e-width="3"></div>
                <div e-column e-field="Type" e-headertext="Type" e-width="5"></div>
                <div e-column e-field="OrderType" e-headertext="OrderType" e-width="5"></div>
                <div e-column e-field="IsApplicable" e-headertext="Applicable" e-width="2"></div>
            </div>
            <script type="text/template" id="ShowActionButtonsBOM">
                <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeDetail(this);" style="margin: -6px;"></i></button>
            </script>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>


<confirm-archive-generic modalid="confirmDetailPopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="DeleteBomDetail();"></confirm-archive-generic>