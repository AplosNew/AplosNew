<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> Production Order Entity Setup</h3>
@*<togglable name="ProductionOrderEntitySetup"></togglable>*@
<div class="form-elements form-horizontal" ng-form name="ProductionOrderEntitySetupForm">
    <input type="hidden" ng-model="ProductionOrderEntitySetupNew.Id">
    <div class="col-sm-12">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select id="CompanyId" class="form-control" ng-model="ProductionOrderEntitySetupNew.CompanyId" name="Company" ng-change="getPlant();" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in companyList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProductionOrderEntitySetupNew.ProductionEntityId" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Type</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select name="Type" class="form-control" ng-model="ProductionOrderEntitySetupNew.Type" ng-options="item.Value as item.Text for item in typeList" tabindex="1">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Applicable</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ProductionOrderEntitySetupNew.IsApplicable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="PlantId" class="form-control" ng-model="ProductionOrderEntitySetupNew.PlantId" name="Plant" ng-change="getEntity();getData();" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProductionOrderEntitySetupNew.FromEntityId" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Order Type</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select name="OrderType" class="form-control" ng-model="ProductionOrderEntitySetupNew.OrderType" ng-options="item.Value as item.Text for item in OrderTypeList" tabindex="1">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-12 control-label"></label>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Dr</legend>
            <div class="form-group">
                <label class="col-sm-4 control-label">GL</label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="GL" ng-model="ProductionOrderEntitySetupNew.DrGLGeneralInfoName" class="form-control" readonly>
                        <input type="hidden" class="form-control" ng-model="ProductionOrderEntitySetupNew.DrGLGeneralInfoId">
                        <span class="input-group-btn">
                            <button ng-click="GetCOAICodeList('Dr');" data-target="#coaItemCodePopUp" data-placement="top" title="GL Change" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearGLData('Dr')" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Budget</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProductionOrderEntitySetupNew.DrBudgetMasterId" ng-options="item.BudgetMasterId as item.BudgetName for item in drbudgetList" id="BudgetId"
                                name="Budget" tabindex="11" ng-change="getDrActivity()"></select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Activity</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProductionOrderEntitySetupNew.DrActivityId" tabindex="12" ng-options="item.ActivityId as item.ActivityName for item in dractivityList" id="ActivityId" name="Activity"></select>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Cr</legend>
            <div class="form-group">
                <label class="col-sm-4 control-label">GL</label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="GL" ng-model="ProductionOrderEntitySetupNew.CrGLGeneralInfoName" class="form-control" readonly>
                        <input type="hidden" class="form-control" ng-model="ProductionOrderEntitySetupNew.CrGLGeneralInfoId">
                        <span class="input-group-btn">
                            <button ng-click="GetCOAICodeList('Cr');" data-target="#coaItemCodePopUp" data-placement="top" title="GL Change" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearGLData('Cr')" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Budget</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProductionOrderEntitySetupNew.CrBudgetMasterId" ng-options="item.BudgetMasterId as item.BudgetName for item in crbudgetList" id="BudgetId"
                                name="Budget" tabindex="11" ng-change="getCrActivity()"></select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Activity</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProductionOrderEntitySetupNew.CrActivityId" tabindex="12" ng-options="item.ActivityId as item.ActivityName for item in cractivityList" id="ActivityId" name="Activity"></select>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="col-sm-12">
        <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="1"></div>

                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                <div e-column e-field="ProductionEntity" e-headertext="ProductionEntity" e-width="3"></div>
                <div e-column e-field="FromEntity" e-headertext="FromEntity" e-width="3"></div>
                <div e-column e-field="Type" e-headertext="Type" e-width="5"></div>
                <div e-column e-field="OrderType" e-headertext="OrderType" e-width="2"></div>
                <div e-column e-field="IsApplicable" e-headertext="Applicable" e-width="1"></div>
                <div e-column e-field="DrGLGeneralInfoName" e-headertext="DrGL" e-width="4"></div>
                <div e-column e-field="DrBudget" e-headertext="DrBudget" e-width="4"></div>
                <div e-column e-field="DrActivity" e-headertext="DrActivity" e-width="4"></div>
                <div e-column e-field="CrGLGeneralInfoName" e-headertext="CrGL" e-width="4"></div>
                <div e-column e-field="CrBudget" e-headertext="CrBudget" e-width="4"></div>
                <div e-column e-field="CrActivity" e-headertext="CrActivity" e-width="4"></div>
            </div>
            <script type="text/template" id="ShowActionButtons">
                <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeDetail(this);" style="margin: -6px;"></i></button>
            </script>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLPopUp.cshtml")
<confirm-archive-generic modalid="confirmDetailPopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>