<togglable name="Master Plan"></togglable>
<div class="form-horizontal" ng-form name="ModelNewForm">
    <div class="form-elements" id="Marker">
        <div>
            <div class="row">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Plan Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Plan Name" ng-model="MasterPlanNew.PlanName " class="form-control" maxlength="100" required autocomplete="off">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Plan Status<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="MasterPlanNew.PlanStatus" name="Plan Status" ng-options="item.UserName as item.UserName for item in PlanStatusList" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">LineItem</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="MasterPlanNew.LineItem">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <input type="text" name="Remarks" ng-model="MasterPlanNew.Remarks " class="form-control" maxlength="100" autocomplete="off">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="User Name" ng-disabled="true" ng-model="MasterPlanNew.User" class="form-control" maxlength="100" required autocomplete="off">
                            </div>
                            <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                <button ng-click="selectResponsiblePerson('User');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="Responsible Person" ng-disabled="true" ng-model="MasterPlanNew.ResponsiblePerson" class="form-control" maxlength="100" required autocomplete="off">
                            </div>
                            <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                <button ng-click="selectResponsiblePerson('Responsible');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">SKU1</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="MasterPlanNew.SKU1">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li> <button ng-click="View();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> Go </button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="MasterPlanNew.ProcessId" name="Process" ng-options="item.Value as item.Text for item in processList" ng-change="GetEntityList(MasterPlanNew.ProcessId);GetMasterPlanFieldStatusList(MasterPlanNew.ProcessId);" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="MasterPlanNew.EntityId" name="Entity" ng-options="item.Value as item.Text for item in entityList" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">SKU2</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="MasterPlanNew.SKU2">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="GridSOItemSelected" ng-init="chkinit()" ej-grid e-datasource="MasterPlanListSelected"
             e-allowscrolling="true" e-actioncomplete="actionCompleteSelected"  e-rowdatabound="rowDataBound"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-showsummary="true" e-allowselection="true" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplateMasterPlan">
            <div e-columns>
                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateMasterPlan" e-template="#checkboxTemplateMasterPlan" e-textalign="center" e-width="30"></div>
                <div e-column e-field="ProductionGrouping" e-headertext="Product Grouping" e-width="120" e></div>
                <div e-column e-field="OwnReferenceNo" e-headertext="Own Reference#" e-width="100"></div>
                <div e-column e-field="POEntity" e-headertext="PO Entity" e-width="80"></div>
                <div e-column e-field="IsJW" e-headertext="IsJW" e-width="80"></div>
                <div e-column e-field="JWType" e-headertext="JWType" e-width="80"></div>
                <div e-column e-field="EntityVendor" e-headertext="Entity/Vendor" e-width="80"></div>
                <div e-column e-field="PONumber" e-headertext="PO No" e-width="80"></div>
                <div e-column e-field="ProductionStatus" e-headertext="PO Status" e-width="80"></div>
                <div e-column e-field="SONo" e-headertext="SO No" e-width="120"></div>
                <div e-column e-field="OrderStatusName" e-headertext="SO Status" e-width="80"></div>
                <div e-column e-field="Qty" e-headertext="SO Qty" e-width="80" e-textalign="right"></div>
                <div e-column e-template="#PlanPercentage" e-headertext="Plan Percentage" e-width="100"></div>
                <div e-column e-field="SOPlanQty" e-headertext="SO Plan Qty" e-width="100"></div>
                <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="180" e></div>
                <div e-column e-field="ArticleName" e-headertext="Article" e-width="180"></div>
                <div e-column e-field="Customer" e-headertext="Customer" e-width="180"></div>
                <div e-column e-field="BuyerReferenceNo" e-headertext="Customer Reference#" e-width="100"></div>
                <div e-column e-field="LineItemNo" e-headertext="LineItemNo" e-width="120"></div>
                <div e-column e-field="MasterOrderNo" e-headertext="MO No" e-width="120"></div>
                <div e-column e-field="MasterPlanId" e-headertext="Master Plan Id" e-width="120"></div>
                <div e-column e-field="MasterPlanStatus" e-headertext="Master Plan Status" e-width="120"></div>
                <div e-column e-field="IsMasterPlan" e-headertext="IsMasterPlan" e-width="120"></div>
            </div>
        </div>
        <script type="text/template" id="checkboxTemplateMasterPlan">
            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Status" />
        </script>
        <script type="text/x-jsrender" id="headerTemplateMasterPlan">
            <input type="checkbox" id="Cheadchk" />
        </script>
        <script type="text/template" id="PlanPercentage">
            <div class="col-sm-10" style="padding:0px;">
                <input type="number" name="PlanPercentage" ng-model="data.PlanPercentage" ng-change="$parent.SOPlanQtyCal(this);" ng-click="" class="form-control" maxlength="200">
            </div>
        </script>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="SaveMasterPlan();" ng-show="MasterPlanListSelected.length>0" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                @* <li> <button ng-click="DeleteMasterPlan();" ng-show="MasterPlanListSelected.length>0" class="btn"><i class="glyphicon glyphicon-refresh"></i> Delete</button></li>*@
                <li> <button ng-click="ClearMasterPlan();" ng-show="MasterPlanListSelected.length>0" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridMasterPlan" ej-grid e-datasource="MasterPlanList" e-recorddoubleclick="GetMasterPlanDetails"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Cut Plan No" e-width="100"></div>
            <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
            <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>
            <div e-column e-field="PlanName" e-headertext="Plan Name" e-width="100"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="100"></div>
            <div e-column e-field="PlanStatus" e-headertext="Plan Status" e-width="100"></div>
            <div e-column e-field="ResponsiblePerson" e-headertext="Resonsible Person" e-width="100"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="ResponsiblePersonPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Responsible Person List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Responsible Person</p>
                        <div style="color:black;" id="GridResponsiblePersonPopUp" ej-grid e-datasource="ResponsiblePersonList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleResponsiblePerson">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="Id" e-visible="false" e-width="120"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="120"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="120"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="120"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="120"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeResponsiblePersonPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal site-modal in" id="POItemPopup" role="dialog" data-backdrop="static">
    <div class="row">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">Production Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body text-center">
                    <div style="color:black;" id="Grid" ej-grid e-datasource="ProductionOrderList" e-allowscrolling="true" e-allowResizing="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-recorddoubleclick="SelectPOItem"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-type="string" e-field="POId" e-headertext="ProductionOrderNo" e-width="80"></div>
                            <div e-column e-type="string" e-field="BuyerOrder" e-headertext="Buyer Ord#" e-width="80"></div>
                            <div e-column e-type="string" e-field="OwnOrder" e-headertext="Own Ord#" e-width="80"></div>
                            <div e-column e-type="string" e-field="SONo" e-headertext="SONo" e-width="80"></div>
                            <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
                            <div e-column e-type="number" e-field="Qty" e-headertext="Qty" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="date" e-field="LSD" e-headertext="LSD" e-format="{0:dd-MMM-yyyy}" e-width="80"></div>
                            <div e-column e-type="string" e-field="CommitmentDate" e-headertext="Commitment Date" e-width="80"></div>
                            <div e-column e-type="string" e-field="ProductionStatus" e-headertext="Production Status" e-width="80"></div>
                            <div e-column e-type="string" e-field="BuyerItem" e-headertext="Buyer Item#" e-width="80"></div>
                            <div e-column e-type="string" e-field="OwnItem" e-headertext="Own Item#" e-width="80"></div>
                            <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Category" e-width="80"></div>
                            <div e-column e-type="string" e-field="Product" e-headertext="Product" e-width="80"></div>
                            <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                            <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                            <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material Master" e-width="80"></div>
                            <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="80"></div>
                            <div e-column e-type="string" e-field="PONumber" e-headertext="PO Number" e-width="80"></div>
                            <div e-column e-type="string" e-field="RequiredTimeUnit" e-headertext="Required Time Unit" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>