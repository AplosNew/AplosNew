<h3 class="site-heading">{{title}}</h3>

<div class="row">
    <div class="col-sm-6 col-md-6 col-lg-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Entity</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="EntityId" name="entity"
                            ng-options="item.Value as item.Text for item in EntityList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-6">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input id="datepicker" e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="FromDate" e-width="100%" />
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="ToDate" e-width="100%" />
                    </div>
                </div>
            </div>

        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="getData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> View </button></li>
            @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>*@
        </ul>
    </div>
</div>
<div class="row">
    <div class="table-responsive">
        <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="GetDet" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                @*<div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>*@
                <div e-column e-field="Dates" e-headertext="Date" e-width="2"></div>
                <div e-column e-field="ItemName" e-headertext="Item Name" e-width="3"></div>
                <div e-column e-field="Category" e-headertext="Category" e-width="3"></div>
                <div e-column e-field="SubCategory" e-headertext="Sub Category" e-width="3"></div>
                <div e-column e-field="Quantity" e-headertext="Quantity" e-type="number" e-width="3"></div>
                <div e-column e-field="AddedBy" e-headertext="Added By" e-width="3"></div>

            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>


<div class="modal fade site-modal in" id="Detail" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Budget</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic">
                    <p style="margin:10px;">
                        You can change the Quantity and then click save to upade the record.
                    <p>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="row" style="margin-top:10px;">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Date</label>
                                <div class="col-sm-8 show-message">
                                    <span>{{ClickDetail.Dates}}</span>
                                </div>

                            </div>
                        </div>
                        <div class="row" style="margin-top:10px;">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <span>{{ClickDetail.Category}}</span>
                                </div>

                            </div>
                        </div>
                        <div class="row" style="margin-top:10px;">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Sub Cateogry<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <span>{{ClickDetail.SubCategory}}</span>
                                </div>

                            </div>
                        </div>
                        
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <div class="row" style="margin-top:10px;">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Item Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <span>{{ClickDetail.ItemName}}</span>
                                </div>

                            </div>
                        </div>
                        <div class="row" style="margin-top:10px;">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Added By<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <span>{{ClickDetail.AddedBy}}</span>
                                </div>

                            </div>
                        </div>
                        <div class="row" style="margin-top:10px;">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Quantity<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" name="Quantity" ng-model="ClickDetail.Quantity" class="form-control" maxlength="200" style="text-align:left;">
                                </div>
                            </div>
                        </div>
                            
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveQnt();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                                @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                            </ul>
                        </div>
                    </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>
