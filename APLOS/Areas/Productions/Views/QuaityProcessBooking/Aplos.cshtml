


<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> Quaity Process Booking</h3>
<p style="color:blue;font-size:11px">This screen has Entity and Process Level access</p>
<div class="form-element-ctrl form-horizontal row" ng-form="modelForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Production Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-disabled="IsGo" ng-model="productionSummaryNew.ProcessId" name="ProcessId" ng-options="item.Id as item.UserName for item in processList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Production Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" ng-disabled="IsGo" ng-model="productionSummaryNew.ProductionDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
            </div>

        </div>
        <h3 class="site-heading" style="cursor:unset;height:25px;"></h3>


        <div class="form-group" ng-show="IsGo===true">
            <label class="col-sm-4 control-label">Production Order<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" name="ProductionOrder" ng-model="productionSummaryNew.ProductionOrderId" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getProductionOrderPopUp();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group" ng-show="IsGo===true">
            <label class="col-sm-3 control-label">Remarks</label>
            <div class="col-sm-9">
                <textarea class="form-control" rows="1" ng-model="productionSummaryNew.Remarks" name="Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Quality Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-disabled="IsGo" ng-model="productionSummaryNew.QualityProcessId" name="ProcessId" ng-options="item.Id as item.UserName for item in qualityprocessList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-disabled="IsGo" ng-model="productionSummaryNew.ProductionShiftId" name="Shift" ng-options="item.Value as item.Text for item in shiftList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="masterGo(true);loadWC(productionSummaryNew.ProcessId,productionSummaryNew.EntityId);" ng-disabled="disGo" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button></li>
                    <li> <button ng-click="SetBack(false);" class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-left"></i> Back</button>
                </ul>
            </div>
        </div>

        <div class="form-group" ng-show="IsGo===true">
            <label class="col-sm-4 control-label">CheckedBy</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Responsible Person" ng-model="productionSummaryNew.CheckedByName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp('CheckedBy');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        <button ng-click="ClearEmployee('CheckedBy')" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    

</div>

<div class="clearfix"></div>
<div class="common-btn" ng-show="IsGo===true">
    <ul class="list-inline text-right">
        <li><button ng-click="SaveMaster();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
        <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
    </ul>
</div>
<div class="table-responsive modal-table" ng-show="IsGo===true && LineGridList.length>0">
    <table class="table table-striped text-left" ng-show="productionSummaryNew.ProductionBookingLevel!=='ProductionOrder'">
        <thead>
            <tr>
                @*<th ng-repeat="h in SearchLineGridList">{{h.Text}}</th>*@
                <th>Action</th>
                <th>Production Order</th>
                <th ng-show="productionSummaryNew.ProductionBookingLevel=='MasterOrderItem'">Master Order</th>
                <th ng-show="productionSummaryNew.ProductionBookingLevel=='MasterOrderItem'">Master Order Item</th>
                <th ng-show="productionSummaryNew.ProductionBookingLevel=='ProductCode'">Product Code</th>
                <th ng-show="productionSummaryNew.ProductionBookingLevel=='SalesOrder'">Sales Order</th>

                <th>Buyer Order</th>
                <th>Own Order</th>
                <th>Buyer Item</th>
                <th>Own Item</th>

                <th>SO Desc</th>
                <th>Lot Number</th>

                <th>Material</th>
                <th>Article</th>
                <th>Grade</th>
                <th>Produced Qty</th>
                <th>Production Booking Period</th>
                <th>Customer</th>
                <th>PO Number</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in LineGridList">
                <td>
                    <ul class="list-inline action-list">
                        <li>
                            <button ng-click="Get(x.Id, $index);" class="btn-action tooltip-here" data-placement="top" title="Edit" tooltip><i class="glyphicon glyphicon-pencil"></i></button>
                            <button ng-click="deleteMaster(x)" class="btn-action tooltip-here" data-placement="top" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i></button>
                        </li>
                    </ul>
                </td>
                <td>{{x.ProductionOrderId}}</td>
                <td ng-show="productionSummaryNew.ProductionBookingLevel=='MasterOrderItem'">{{x.MasterOrderNo}}</td>
                <td ng-show="productionSummaryNew.ProductionBookingLevel=='MasterOrderItem'">{{x.MOrderLineNo}}</td>
                <td ng-show="productionSummaryNew.ProductionBookingLevel=='ProductCode'">{{x.ProductCode}}</td>
                <td ng-show="productionSummaryNew.ProductionBookingLevel=='SalesOrder'">{{x.SalesOrderId}}</td>

                <td>{{x.BuyerOrder}}</td>
                <td>{{x.OwnOrder}}</td>
                <td>{{x.BuyerItem}}</td>
                <td>{{x.OwnItem}}</td>

                <td>{{x.Description}}</td>
                <td>{{x.LotNumber}}</td>

                <td>{{x.MaterialMaster}}</td>
                <td>{{x.Article}}</td>
                <td>{{x.ProductionGrade}}</td>
                <td>{{x.Quantity}}</td>
                <td>{{x.ProductionBookingPeriod}}</td>
                <td>{{x.Customer}}</td>
                <td>{{x.PONumber}}</td>
               
            </tr>
        </tbody>
    </table>
    <table class="table table-striped text-left" ng-show="productionSummaryNew.ProductionBookingLevel==='ProductionOrder'">
        <thead>
            <tr>
                @*<th ng-repeat="h in SearchLineGridList">{{h.Text}}</th>*@
                <th>Action</th>
                <th>Production Order</th>
                <th>Production Date</th>
                <th>Buyer Order</th>
                <th>Own Order</th>
                <th>Buyer Item</th>
                <th>Own Item</th>
                <th>Lot Number</th>
                <th>Grade</th>
                <th>Produced Qty</th>
                <th>Production Booking Period</th>
                @*<th>SKU</th>*@
            </tr>
        </thead>
        <tbody>
            @*<tr dir-paginate="x in LineGridList  |itemsPerPage:$root.pageSize" pagination-id="metaData.name + 'LineGridList'"
                total-items="mmPopUpParameters.total_count" ng-dblclick="selectLineItem(x);">*@
            <tr ng-repeat="x in LineGridList">
                <td>
                    <ul class="list-inline action-list">
                        <li>
                            <button ng-click="Get(x.Id, $index)" class="btn-action tooltip-here" data-placement="top" title="Edit" tooltip><i class="glyphicon glyphicon-pencil"></i></button>
                            <button ng-click="deleteMaster(x)" class="btn-action tooltip-here" data-placement="top" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i></button>
                        </li>
                    </ul>
                </td>
                <td>{{x.ProductionOrderId}}</td>
                <td>{{x.ProductionDate}}</td>
                <td>{{x.BuyerOrder}}</td>
                <td>{{x.OwnOrder}}</td>
                <td>{{x.BuyerItem}}</td>
                <td>{{x.OwnItem}}</td>
                <td>{{x.LotNumber}}</td>
                <td>{{x.ProductionGrade}}</td>
                <td>{{x.Quantity}}</td>
                <td>{{x.ProductionBookingPeriod}}</td>
                @*<td>
            <button class="btn single-small-btn" ng-disabled="productionSummaryNew.ProductionBookingLevel==='ProductionOrder' || productionSummaryNew.ProductionBookingLevel==='SalesOrder'"><i class="cr-icon glyphicon glyphicon-list"> </i></button>
        </td>*@
            </tr>
        </tbody>
    </table>
</div>

