@*To Accept only Numbers with decimals*@
<script>

    function isNumber(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }

     @*To Accept only Numbers*@
    function OnlyNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }
</script>

<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.ProcessId" name="Process" required
                            ng-options="item.Value as item.Text for item in ProcessList" tabindex="1">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Item Name" ng-model="ModelNew.ItemName" class="form-control" maxlength="50" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Parameter<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Parameter" n-decimals="2" onkeypress="return isNumber(event)" ng-model="ModelNew.Parameter" class="form-control" required tabindex="5" maxlength="16">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Output UoM<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.OutputUoMId" name="Output UoM" required
                            ng-options="item.Value as item.Text for item in OutputUoMList" tabindex="7">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="9"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.ItemType" name="ItemType" required tabindex="2">
                        <option value=""></option>
                        <option value="Input">Input</option>
                        <option value="Output">Output</option>
                        <option value="Both">Both</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">UoM<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.UoMId" name="UoM" required
                            ng-options="item.Value as item.Text for item in UoMList" tabindex="4">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry UoM<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.EntryUoMId" name="Entry UoM" required
                            ng-options="item.Value as item.Text for item in EntryUoMList" tabindex="6">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Output Value<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Output Value" n-decimals="2" onkeypress="return isNumber(event)" ng-model="ModelNew.OutputValue" class="form-control" required tabindex="8" maxlength="16">
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Process" e-headertext="Process" e-width="5"></div>
            <div e-column e-field="ItemType" e-headertext="Item Type" e-width="5"></div>
            <div e-column e-field="ItemName" e-headertext="Item Name" e-width="5"></div>
            <div e-column e-field="Unit" e-headertext="Unit" e-width="3"></div>
            <div e-column e-field="Parameter" e-headertext="Parameter" e-width="3"></div>
            <div e-column e-field="EntryUnit" e-headertext="Entry UoM" e-width="4"></div>
            <div e-column e-field="OutputUnit" e-headertext="Output UoM" e-width="4"></div>
            <div e-column e-field="OutputValue" e-headertext="Output Value" e-width="4"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="5"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>