<div class="modal fade site-modal in" id="ProcessPopupId" role="dialog" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"> Process List <button type="button" class="close" ng-click="closeProcessPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
               
                <div class="col-md-12">
                    <div class="content-container-fluid">
                       
                        <div style="color:black;" ej-grid e-datasource="ProcessList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-headertext="Apply" e-template="#ProcesscheckboxTemplate" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="20"></div>
                                <div e-column e-field="Process" e-headertext="Process" e-width="20"></div>
                               
                            </div>
                        </div>

                        <script type="text/template" id="ProcesscheckboxTemplate">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="CreateProcessWithParameterSetup();" class="btn"> Add</button></li>
                    <li><button ng-click="closeProcessPopUp();" class="btn"> Close</button></li>
                </ul>

            </div>
        </div>
    </div>
</div>
