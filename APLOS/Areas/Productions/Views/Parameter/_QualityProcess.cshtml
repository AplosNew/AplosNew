<div class="row" ng-form name="QualityProcessForm">
    <input type="hidden" ng-model="QualityProcess.Id">
    @*COLUMN 1*@
    <div class="col-xs-12 col-sm-8 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Quality Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="QualityProcess.QualityProcess" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>

    </div>

    @*COLUMN 2*@
    <div class="col-xs-12 col-sm-8 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="QualityProcess.StandardProcess" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="QPSave();" id="savebtn" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{QPAction}}</button></li>
            @*<li> <button ng-click="Update();" id="updatebtn" style="display:none" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Update</button></li>*@
            @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li> <button ng-click="QPClear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    @*<div class="table-responsive" style="margin-top:30px">
        <div id="GridEdit" ej-grid e-datasource="QualityProcessList" e-recorddoubleclick="GetOnDblClick" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>

                <div e-column e-field="QualityProcess" e-headertext="Quality Process" e-width="100"></div>
                <div e-column e-field="StandardProcess" e-headertext="Standard Process" e-width="150"></div>

            </div>
        </div>
    </div>*@
</div>


<div class="table-responsive modal-table" ng-dblclick="GetOnDblClick($parent.this)" ng-show="QualityProcessList.length>0">
    <table class="table table-responsive table-striped">
        <thead>
            <tr>
                <th>Quality Process</th>
                <th>Standard Process</th>
                <th>Remove</th>

            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in QualityProcessList">
                <td>
                    {{x.QualityProcess}}
                </td>
                <td>
                    {{x.StandardProcess}}
                </td>

                <td><button ng-click="RemoveQualityPeocess(x)" class="btn" tabindex="9"><i class="glyphicon glyphicon-remove"></i></button></td>

            </tr>
        </tbody>

    </table>

</div>
