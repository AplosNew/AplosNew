<togglable name=" {{title}}"></togglable>
<div class="form-elements form-horizontal" style="margin-bottom:10px">
    
    <div class="row" ng-form name="ModelNewForm">
        <input type="hidden" ng-model="ModelNew.Id">
        @*COLUMN 1*@
        <div class="col-xs-12 col-sm-8 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10" e-width="100%">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Budget Code<sup>*</sup></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="hidden" name="Budget Code" ng-model="ModelNew.BudgetCodeId" class="form-control">
                    <input type="text" name="Code" ng-model="ModelNew.BudgetCode" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="popUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearCode()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>

        @*COLUMN 2*@
        <div class="col-xs-12 col-sm-8 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">

                        <input type="text" name="Responsible Person" ng-model="ModelNew.EmployeeName" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="OpeEmployeePopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="2" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" id="savebtn" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                @*<li> <button ng-click="Update();" id="updatebtn" style="display:none" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Update</button></li>*@
                @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Parameter</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Entity</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="general" role="tab" data-toggle="tab">Process</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="general" role="tab" data-toggle="tab">Machine</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="Service" role="tab" data-toggle="tab">Product</a></li>              
                <li role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" aria-controls="Service" role="tab" data-toggle="tab">Workcenter</a></li>

            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

                    @*<div class="form-elements form-horizontal" ng-form name="ModelNewForm">*@

                    <div class="row" ng-form name="ParameterForm">
                        @*COLUMN 1*@
                        <div class="col-xs-12 col-sm-8 col-md-4">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="ProcessId" required name="Process"
                                                tabindex="2">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in ProcessList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">parameter category<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="ProcessCategory" required name="ProcessCategory"
                                                tabindex="2">
                                            <option value="">--Select--</option>
                                            <option value="Machine">Machine</option>
                                            <option value="Process">Process</option>
                                            <option value="Quality">Quality</option>
                                            <option value="Product">Product</option>
                                            <option value="Other">Other</option>

                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Checkin Period<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="CheckinPeriod" required name="ProcessCategory"
                                                tabindex="2">
                                            <option value="">--Select--</option>
                                            <option value="Overly">Hourly</option>
                                            <option value="Two Hourly">Two Hourly</option>
                                            <option value="Four Hourly">Four Hourly</option>
                                            <option value="Eight Hourly">Eight Hourly</option>
                                            <option value="Shift">Shift</option>
                                            <option value="Daily">Daily</option>
                                            <option value="Weekly">Weekly</option>
                                            <option value="Fortnightly">Fortnightly</option>
                                            <option value="Monthly">Monthly</option>
                                            <option value="Quaterly">Quaterly</option>
                                            <option value="Annualy">Annualy</option>


                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Auditing Days</label>
                                <div class="col-sm-8 show-message">

                                    <input type="number" name="Auditing Days" ng-model="AuditingDays" class="form-control" maxlength="15" required tabindex="3">

                                </div>
                            </div>
                        </div>

                        @*COLUMN 2*@
                        <div class="col-xs-12 col-sm-8 col-md-4">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Machine<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <input ej-dropdownlist e-enablefiltersearch="true" e-datasource="MachineMasterList" e-value="MachineMasterId" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Crititcal Level<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="CriticalLevel" required name="Critical Level"
                                                tabindex="2">
                                            <option value="">--Select--</option>
                                            <option value="Normal">Normal</option>
                                            <option value="Important">Important</option>
                                            <option value="Critical">Critical</option>
                                            <option value="Semi Critical">Semi Critical</option>
                                            <option value="Highly Critical">Highly Critical</option>


                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Checkin Frequency</label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" name="Frequency" ng-model="CheckinFrequency" class="form-control" required tabindex="4" maxlength="50">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="Remarks" maxlength="250" tabindex="6"></textarea>
                                </div>
                            </div>


                        </div>
                        @*COLUMN 3*@
                        <div class="col-xs-12 col-sm-8 col-md-4">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Parameter<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="ParameterId" required name="Parameter"
                                                tabindex="2">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in ParameterMasterList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">UOM<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="input-group">

                                        <input type="text" name="UOM" ng-model="UOMName" class="form-control" required readonly>
                                        <span class="input-group-btn">
                                            <button name="submit" ng-click="openUOMPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Checkin Days</label>
                                <div class="col-sm-8 show-message">

                                    <input type="number" name="Checkin Days" ng-model="CheckinDays" class="form-control" maxlength="15" required tabindex="3">

                                </div>
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="CreateParameter();" id="savebtn" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
                                @*<li> <button ng-click="Update();" id="updatebtn" style="display:none" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Update</button></li>*@
                                <li> <button data-toggle="modal" ng-click="Delete(this)" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                                <li> <button ng-click="ClearParameter();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <div id="GridEdit" ej-grid e-datasource="SavedParameterList" e-recorddoubleclick="GetParameter" e-load="loadGridEdit"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                                <div e-column e-field="Machine" e-headertext="Machine" e-width="100"></div>
                                <div e-column e-field="Parameter" e-headertext="Parameter" e-width="100"></div>
                                <div e-column e-field="ProcessCategory" e-headertext="Process Category" e-width="100"></div>
                                <div e-column e-field="CriticalLevel" e-headertext="CriticalLevel" e-width="100"></div>
                                <div e-column e-field="UOMName" e-headertext="UOM" e-width="100"></div>
                                <div e-column e-field="CheckinPeriod" e-headertext="Checkin Period" e-width="100"></div>
                                <div e-column e-field="CheckinFrequency" e-headertext="Checkin Frequency" e-width="100"></div>
                                <div e-column e-field="CheckinDays" e-headertext="CheckinDays" e-width="100"></div>

                                <div e-column e-field="AuditingDays" e-headertext="AuditingDays" e-width="100"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>

                            </div>
                        </div>
                    </div>

                    @*</div>*@

                    @*Grid Table*@
                    <div class="table-responsive aplos-grid-toggle">
                        <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="ParameterMaster" e-headertext="Parameter" e-width="100"></div>
                                <div e-column e-field="CriticalLevel" e-headertext="Critical Level" e-width="100"></div>
                                <div e-column e-field="PeriodQuality" e-headertext="Period Quality" e-width="100"></div>
                                <div e-column e-field="QA" e-headertext="QA" e-width="100"></div>
                                <div e-column e-field="Frequency" e-headertext="Frequency" e-width="100"></div>
                                <div e-column e-field="ProcessCategory" e-headertext="Process Category" e-width="100"></div>
                                <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                                <div e-column e-field="MachineMaster" e-headertext="Machine" e-width="100"></div>
                                <div e-column e-field="UOMName" e-headertext="UOM" e-width="100"></div>

                                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @*   TAB -2 ENTITY START   *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">

            
            <div class="row">

                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="common-btn" style="margin-bottom:10px">
                        <ul class="list-inline text-left">
                            <li>
                                <button name="submit" class="btn single-small-btn" ng-click="OpenEntityPopUp()" tabindex="1"><i class="cr-icon glyphicon glyphicon-plus"></i>Add Entity</button>

                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="table-responsive modal-table" ng-show="ParameterEntityList.length>0">
                <table class="table table-responsive table-striped">
                    <thead>
                        <tr>
                            <th>Parameter Setup</th>
                            <th>Entity</th>
                            <th>Remove</th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in ParameterEntityList">
                            <td>
                                {{x.ParameterSetup}}
                            </td>
                            <td>
                                {{x.Entity}}
                            </td>

                            <td><button ng-click="RemoveParticularRow(x)" class="btn" tabindex="9"><i class="glyphicon glyphicon-remove"></i></button></td>

                        </tr>
                    </tbody>

                </table>

            </div>
        </div>
            @*   TAB -2 CLOSE   *@

            @*   TAB -3 PROCESS START   *@
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row" ng-form>
                    
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Parameter Entity<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" required name="Process"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in ProcessList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="common-btn" style="margin-bottom:10px">
                            <ul class="list-inline text-left">
                                <li>
                                    <button name="submit" class="btn single-small-btn" ng-click="OpenProcessPopUp()" tabindex="1"><i class="cr-icon glyphicon glyphicon-plus"></i>Add Process</button>

                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
            @*   TAB -3 CLOSE   *@

            @*   TAB -4 MACHINE START   *@
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn" style="margin-bottom:10px">
                            <ul class="list-inline text-left">
                                <li>
                                    <button name="submit" class="btn single-small-btn" ng-click="OpenMachinePopUp()" tabindex="1"><i class="cr-icon glyphicon glyphicon-plus"></i>Add Machine</button>

                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
            @*   TAB -4 CLOSE   *@

            @*  TAB - 5   *@
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button class="btn" ng-click="OpeProductPopUp()"><i class="glyphicon glyphicon-plus"></i> Add Product</button></li>
                            </ul>
                        </div>
                    </div>


                </div>
                <div class="table-responsive modal-table" ng-show="ParameterProductList.length>0">
                    <table class="table table-responsive table-striped">
                        <thead>
                            <tr>
                                <th>Parameter Setup</th>

                                <th>Product</th>
                                <th>Category</th>
                                <th>Sub Category</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in ParameterProductList">
                                <td>
                                    {{x.ParameterSetup}}
                                </td>
                                <td>
                                    {{x.Product}}
                                </td>
                                <td>
                                    {{x.Category}}
                                </td>
                                <td>
                                    {{x.SubCategory}}
                                </td>


                                <td><button ng-click="RemoveParticularRow(x)" class="btn" tabindex="9"><i class="glyphicon glyphicon-remove"></i></button></td>

                            </tr>
                        </tbody>

                    </table>

                </div>
            </div>


            @*  TAB - 6   *@
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(6), active: isSet(6) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn" style="margin-bottom:10px">
                            <ul class="list-inline text-left">
                                <li>
                                    <button name="submit" class="btn single-small-btn" ng-click="OpenWorkcenterPopUp()" tabindex="1"><i class="cr-icon glyphicon glyphicon-plus"></i>Add Workcenter</button>

                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
                <div class="table-responsive modal-table" ng-show="ParameterWorkcenterList.length>0">
                    <table class="table table-responsive table-striped">
                        <thead>
                            <tr>
                                <th>Parameter Setup</th>

                                <th>Workcenter</th>
                                <th>Category</th>
                                <th>Sub Category</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="y in ParameterWorkcenterList">
                                <td>
                                    {{y.ParameterSetup}}
                                </td>
                                <td>
                                    {{y.Workcenter}}
                                </td>
                                <td>
                                    {{y.Category}}
                                </td>
                                <td>
                                    {{y.SubCategory}}
                                </td>


                                <td><button class="btn" tabindex="9"><i class="glyphicon glyphicon-remove"></i></button></td>

                            </tr>
                        </tbody>

                    </table>

                </div>
            </div>


        </div>

    </div>
</div>




@*Grid Table*@
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            @*<div e-column e-field="Sequence" e-headertext="Seq" e-width="80"></div>
                <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>*@
            <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="150"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="130"></div>
            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="130"></div>
            <div e-column e-field="BudgetCode" e-headertext="BudgetCode" e-width="130"></div>


        </div>
    </div>
</div>
@*--------------------------------------------------------------------------------------------------------------------------------*@


@Html.Partial("~/Areas/HumanResource/Views/MedicineMaster/_UOMPopUpScreen.cshtml")
@Html.Partial("~/Areas/Productions/Views/Parameter/_ResponsiblePerson.cshtml")
@Html.Partial("~/Areas/Productions/Views/Parameter/_Product.cshtml")
@Html.Partial("~/Areas/Productions/Views/Parameter/_Workcenter.cshtml")
@Html.Partial("~/Areas/Productions/Views/Parameter/_Entity.cshtml")
@Html.Partial("~/Areas/Productions/Views/Parameter/_Process.cshtml")
@Html.Partial("~/Areas/Productions/Views/Parameter/_Machine.cshtml")

<modal-table modalid="popUpId"
             data-title={{popUpTitle}}
             data-search-parameters="budgetpopUpParameters"
             data-exclued-column-list="Code"
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click="selectSingleClick(data)"
             data-double-click="selectDoubleClick(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectByButton()"
             data-ng-click-cancel="closePopUp()">
</modal-table>
<confirm-modal></confirm-modal>

<confirm-archive-generic data-modalid="confirmPopUp" title="Confirmation" message={{message_confirmation_doc}} data-ng-click-right-button="Delete(x)"></confirm-archive-generic>


