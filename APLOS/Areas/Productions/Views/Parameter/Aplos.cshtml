<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Service" role="tab" data-toggle="tab">Parameter</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Product</a></li>

        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <togglable name=" {{title}}"></togglable>
            <div class="form-elements form-horizontal" ng-form name="ModelNewForm">
                <input type="hidden" ng-model="ModelNew.Id">
                <div class="row">
                    @*COLUMN 1*@
                    <div class="col-xs-12 col-sm-8 col-md-4">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.ProcessId" required name="Process"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in ProcessList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Process category<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.ProcessCategory" required name="ProcessCategory"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option value="Machine">Machine</option>
                                        <option value="Process">Process</option>
                                        <option value="Quality">Quality</option>
                                        <option value="Product">Product</option>
                                        <option value="Other">Other</option>

                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Period(Quality)<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.PeriodQuality" required name="ProcessCategory"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option value="Overly">Overly</option>
                                        <option value="Two Hourly">Two Hourly</option>
                                        <option value="Four Hourly">Four Hourly</option>
                                        <option value="Eight Hourly">Eight Hourly</option>
                                        <option value="Shift">Shift</option>
                                        <option value="Daily">Daily</option>
                                        <option value="Weekly">Weekly</option>
                                        <option value="Fortnightly">Fortnightly</option>
                                        <option value="Monthly">Monthly</option>
                                        <option value="Quaterly">Quaterly</option>
                                        <option value="Annualy">Annualy</option>


                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                            </div>
                        </div>
                    </div>

                    @*COLUMN 2*@
                <div class="col-xs-12 col-sm-8 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Machine<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <input ej-dropdownlist e-enablefiltersearch="true" e-datasource="MachineMasterList" e-value="ModelNew.MachineMasterId" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Crititcal Level<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.CriticalLevel" required name="Critical Level"
                                        tabindex="2">
                                    <option value="">--Select--</option>
                                    <option value="Normal">Normal</option>
                                    <option value="Important">Important</option>
                                    <option value="Critical">Critical</option>
                                    <option value="Semi Critical">Semi Critical</option>
                                    <option value="Highly Critical">Highly Critical</option>


                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Frequency</label>
                        <div class="col-sm-8 show-message">
                            <input type="number" name="Frequency" ng-model="ModelNew.Frequency" class="form-control" required tabindex="4" maxlength="50">
                        </div>
                    </div>
                    
                </div>
                    @*COLUMN 3*@
                    <div class="col-xs-12 col-sm-8 col-md-4">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Parameter<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.ParameterId" required name="Parameter"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in ParameterMasterList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">UOM<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">

                                    <input type="text" name="Responsible Person" ng-model="ModelNew.UOMName" class="form-control" required readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="openUOMPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">QA</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.QA" required name="QA"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option value="">--Select--</option>
                                        <option value="Overly">Overly</option>
                                        <option value="Two Hourly">Two Hourly</option>
                                        <option value="Four Hourly">Four Hourly</option>
                                        <option value="Eight Hourly">Eight Hourly</option>
                                        <option value="Shift">Shift</option>
                                        <option value="Daily">Daily</option>
                                        <option value="Weekly">Weekly</option>
                                        <option value="Fortnightly">Fortnightly</option>
                                        <option value="Monthly">Monthly</option>
                                        <option value="Quaterly">Quaterly</option>
                                        <option value="Annualy">Annualy</option>

                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>



            </div>

            @*Grid Table*@
            <div class="table-responsive aplos-grid-toggle">
                <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                        <div e-column e-field="Sequence" e-headertext="Seq" e-width="80"></div>
                        <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
                        <div e-column e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
                        <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="150"></div>
                        <div e-column e-field="UserName" e-headertext="User Name" e-width="130"></div>

                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                        <div e-column e-field="IsActive" e-headertext="IsActive" e-width="50"></div>
                    </div>
                </div>
            </div>
        </div>

        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">

        </div>

    </div>

</div>

@Html.Partial("~/Areas/HumanResource/Views/MedicineMaster/_UOMPopUpScreen.cshtml")
<confirm-modal></confirm-modal>
