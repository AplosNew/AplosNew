                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>*@
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        @*style="color:black;overflow:scroll"*@
                        <div style="color:black;" ej-grid e-datasource="ApprovedByList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-headertext="Apply" e-template="#ProductcheckboxTemplate" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
                                <div e-column e-field="UserName" e-headertext="Product" e-width="100"></div>
                                <div e-column e-field="Active" e-headertext="Active" e-width="100"></div>
                               
                            </div>
                        </div>

                        <script type="text/template" id="ProductcheckboxTemplate">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="AddProduct();" class="btn"> Add</button></li>
                    <li><button ng-click="CloseProductPopUp();" class="btn"> Close</button></li>
                </ul>

            </div>
        </div>
    </div>
</div>

