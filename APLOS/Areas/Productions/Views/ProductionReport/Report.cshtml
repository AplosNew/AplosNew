<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="form-horizontal" ng-form name="ModelNewForm">
    <div class="form-elements">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ProductionEntityId" name="Entity" Id="EntityId" ng-options="item.Id as item.UserName for item in entityList" ng-change="loadProcessList(ProductionEntityId)">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ProcessId" name="ProcessId" Id="ProcessId" ng-options="item.Value as item.Text for item in processList">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Date</label>
                    <div class="col-sm-8">
                        <input type="text" name="Form Date" required e-dateformat="dd-MMM-yyyy" ng-model="Date" datepicker class="form-control">
                    </div>
                </div>
            </div>
            @*<div class="col-xs-12 col-sm-6 col-md-6">
                
            </div>*@
            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="DonwloadReport();" class="btn" tabindex="9"><i class="glyphicon glyphicon-download-alt"></i> Download</button></li>
                    </ul>
                </div>

            </div>
        </div>
    </div>
</div>
