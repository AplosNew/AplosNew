                            <label class="col-sm-4 control-label">Value<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="number" name="Standard Name" ng-model="RecipeGlobalMaterialGroup.Value" class="form-control" tabindex="4">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-3" style="padding-left: 100px;">
                        <div class="row form-group">
                            <label class="col-sm-4 control-label">UoM<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Uom" class="form-control" tabindex="6" ng-model="RecipeGlobalMaterialGroup.UomId" ng-options="item.Value as item.Text for item in groupuomList"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-3" style="padding-left: 177px;">
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <div class="form-group form-horizontal">
                                    <span class="input-group-btn">
                                        <button ng-click="SaveRecipeMaterialGroup();" class="btn single-small-btn" tabindex="24">Add</button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Sequence</th>
                                    <th>Code</th>
                                    <th>Standard Name</th>
                                    <th>User Define Name</th>
                                    <th>Quantity</th>
                                    <th>Group Detail</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in recipeGroupList">
                                    <td>{{x.Sequence}}</td>
                                    <td>{{x.Code}}</td>
                                    <td>{{x.StandardName}}</td>
                                    <td>{{x.UserName}}</td>
                                    <td>{{x.Value +" "+ x.UnitOfMeasurement}}</td>
                                    <td>
                                        <ul class="list-inline action-list">
                                            <li>
                                                <button ng-click="getRecipeMaterialGroupingDetail(x,$index)" class="btn-action tooltip-here" data-placement="top" title="Recipe Material Group Detail" tooltip>
                                                    <i class="glyphicon glyphicon-list"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </td>
                                    <td class="text-right">
                                        <ul class="list-inline">
                                            <li><button data-target="#confirmDelete" ng-click="DeleteMaterialGroup(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Delete" tooltip><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="closeMaterialGroupPopUp();" class="btn" tabindex="25"> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="RecipeGroupPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Recipe Material Group<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Standard Name</th>
                                <th>User Define Name</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in recipeMaterialGroupList" ng-dblclick="setGroupData(x);">
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.Value +" "+ x.UnitOfMeasurement}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="closeSearchPopUp();" class="btn" tabindex="25"> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="RecipeMaterialGroupingDetailPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Recipe Material Grouping Detail<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-horizontal form-elements">
                <div class="col-sm-12">
                    <label class="form-control">Recipe Global Material Group :{{RecipeGlobalMaterialGroupName}}</label>
                </div>
                <div class="col-sm-12">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Ingredient (MM)</th>
                                    <th>Article</th>
                                    <th>RM Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in recipeMaterialGroupingDetailList">
                                    <td>{{x.MaterialMasterName}}</td>
                                    <td>{{x.ArticleName}}</td>
                                    <td>{{x.Value +" "+ x.Description}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="closeRecipeMaterialGroupingDetailPopup();" class="btn" tabindex="25"> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic data-modalid="confirmmasterdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeMasterYes()"></confirm-archive-generic>
<confirm-archive-generic data-modalid="coperationdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeOperationYes()"></confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmdetaildelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRowDetailYes()"></confirm-archive-generic>
<confirm-archive-generic data-modalid="cutilitydelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeUtilityYes()"></confirm-archive-generic>
<confirm-archive-generic data-modalid="crmdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRawMaterialYes()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteRow()"></confirm-archive-generic>
