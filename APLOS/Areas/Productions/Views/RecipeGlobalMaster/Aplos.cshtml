<style>
    div[class="form-group"] {
        height: 8px !important;
        font-size: 12px !important;
    }

    .control-label {
        text-align: right !important;
        line-height: 8px !important;
        padding-right: 5px !important;
        /*font-weight: bold !important;*/
        font-size: 11px !important;
        font-family: Verdana, Geneva, Tahoma, sans-serif;
    }
</style>
<togglable name="Recipe Master"></togglable>
<div class="form-horizontal" id="RecipeWashMaster" ng-form name="RecipeWashMasterForm">
    <div class="row">
        <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                   
                    <div class="select-style">
                        <select id="Entity" name="Entity" class="form-control" ng-model="mastermodal.EntityId" ng-disabled="mastermodal.Id!==null" ng-options="item.Id as item.UserName for item in entityList" ng-change="ClearBody();" required tabindex="1">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="Process" class="form-control" ng-model="mastermodal.ProcessId" name="Process" ng-disabled="mastermodal.Id!==null" tabindex="2" required ng-change="getDataList();processChange(mastermodal.ProcessId);ClearbyProcess()">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in processList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="form-elements form-horizontal">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" style="display:none;">
                    <label class="col-sm-4 control-label">Id</label>
                    <div class="col-sm-8">
                        <input type="text" name="Id" ng-model="mastermodal.Id" class="form-control" readonly="" tabindex="1">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" name="Code" ng-model="mastermodal.Code" class="form-control" maxlength="20" tabindex="3">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Avg. Weight<sup>*</sup></label>
                    <div class="col-sm-4" style="padding-right:0px;">
                        <input type="number" name="Material Avg. Weight" ng-model="mastermodal.MaterialAvgWeight" class="form-control" tabindex="5">
                    </div>
                    <div class="col-sm-4" style="padding-left:0px;">
                        <div class="select-style">
                            <select id="AvgUom" class="form-control" ng-model="mastermodal.AvgUom" name="Avg Uom" tabindex="6">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in UnitOfMeasurementList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Starting (Temp)</label>
                    <div class="col-sm-8">
                        <input type="number" ng-model="mastermodal.StartTemperature" class="form-control" tabindex="9">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Starting Pressure</label>
                    <div class="col-sm-8">
                        <input type="number" ng-model="mastermodal.StartPressure" class="form-control" tabindex="11">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Gradient (Temp)</label>
                    <div class="col-sm-8">
                        <input type="number" ng-model="mastermodal.GradientTemperature" class="form-control" tabindex="13">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Process Criteria<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select name="Process Criteria" class="form-control" submit-required="true" ng-model="mastermodal.ProcessCriteriaId"
                                    ng-options="item.Value as item.Text for item in processCriteriaList" tabindex="15" required></select>
                        </div>
                    </div>
                </div>

                <div class="form-group" ng-show="modelNew.RecipeLevel!=null" id="div_arCh">
                    <label class="col-sm-4 control-label">{{modelNew.ReipeName}}</label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <input type="text" ng-show="modelNew.RecipeLevel=='AR'" name="{{modelNew.ReipeName}} value" ng-model="modelNew.AttributeValueName" class="form-control" readonly>
                            <input type="text" ng-show="modelNew.RecipeLevel=='CH'" name="{{modelNew.ReipeName}} value" ng-model="modelNew.Characteristics1ValueName" class="form-control" readonly>

                            <span class="input-group-btn">
                                <button ng-show="modelNew.RecipeLevel=='CH'" ng-click="charValuePopUp(modelNew,modelNew.CharacteristicsId,'1')" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                <button ng-show="modelNew.RecipeLevel=='CH'" ng-click="charValueClear('1')" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>

                                <button ng-show="modelNew.RecipeLevel=='AR'" ng-click="attributeValuePopUpNew(modelNew,modelNew.MaterialAttributeId,'1');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                <button ng-show="modelNew.RecipeLevel=='AR'" ng-click="attributeValueClear('1')" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group" ng-show="modelNew.SpecificationLevel1!=null" id="div_arCh">
                    <label class="col-sm-4 control-label">{{modelNew.Specification1}}</label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <input type="text" ng-show="modelNew.SpecificationLevel1=='AR'" name="{{modelNew.Specification1}} value" ng-model="modelNew.Specification1ValueName" class="form-control" readonly>
                            <input type="text" ng-show="modelNew.SpecificationLevel1=='CH'" name="{{modelNew.Specification1}} value" ng-model="modelNew.Characteristics2ValueName" class="form-control" readonly>

                            <span class="input-group-btn">
                                <button ng-show="modelNew.SpecificationLevel1=='CH'" ng-click="charValuePopUp(modelNew,modelNew.SpecificationChar1,'2')" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                <button ng-show="modelNew.SpecificationLevel1=='CH'" ng-click="charValueClear('2')" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>

                                <button ng-show="modelNew.SpecificationLevel1=='AR'" ng-click="attributeValuePopUpNew(modelNew,modelNew.Specification1Id,'2');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                <button ng-show="modelNew.SpecificationLevel1=='AR'" ng-click="attributeValueClear('2')" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group" ng-show="modelNew.SpecificationLevel2!=null">
                    <label class="col-sm-4 control-label">{{modelNew.Specification2}}</label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <input type="text" ng-show="modelNew.SpecificationLevel2=='AR'" name="{{modelNew.Specification2}} value" ng-model="modelNew.Specification2ValueName" class="form-control" readonly>
                            <input type="text" ng-show="modelNew.SpecificationLevel2=='CH'" name="{{modelNew.Specification2}} value" ng-model="modelNew.Characteristics3ValueName" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-show="modelNew.SpecificationLevel2=='CH'" ng-click="charValuePopUp(modelNew,modelNew.SpecificationChar2,'3')" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                <button ng-show="modelNew.SpecificationLevel2=='CH'" ng-click="charValueClear('3')" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>

                                <button ng-show="modelNew.SpecificationLevel2=='AR'" ng-click="attributeValuePopUpNew(modelNew,modelNew.Specification2Id,'3');" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                <button ng-show="modelNew.SpecificationLevel2=='AR'" ng-click="attributeValueClear('3')" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" name="UserName" ng-model="mastermodal.UserName" class="form-control" maxlength="50" tabindex="4">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Batch Size@*<sup>*</sup>*@</label>
                    <div class="col-sm-4" style="padding-right:0px;">
                        <input type="number" name="BatchSize" ng-model="mastermodal.BatchSize" class="form-control" tabindex="7">

                    </div>
                    <div class="col-sm-4" style="padding-left:0px;">

                        <div class="select-style">
                            <select id="Uom" class="form-control" ng-model="mastermodal.Uom" name="Uom" tabindex="8">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in UnitOfMeasurementList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">End (Temp)</label>
                    <div class="col-sm-8">
                        <input type="number" ng-model="mastermodal.EndTemperature" class="form-control" tabindex="10">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">End Pressure</label>
                    <div class="col-sm-8">
                        <input type="number" ng-model="mastermodal.EndPressure" class="form-control" tabindex="12">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Gradient Pressure</label>
                    <div class="col-sm-8">
                        <input type="number" ng-model="mastermodal.GradientPressure" class="form-control" tabindex="14">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Description</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" rows="2" ng-model="mastermodal.Description" maxlength="100" tabindex="16"></textarea>
                    </div>
                </div>

            </div>
            <div class="clearfix"></div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="SaveMaster();" class="btn ng-binding" tabindex="14"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li><button ng-click="DeleteMaster()" data-target="#confirmPopUp" class="btn" tabindex="15"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li><button ng-click="Clear()" class="btn" tabindex="16"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    <li><a class="btn btn-action" ng-disabled="mastermodal.Id===null" href="Productions/RecipeGlobalMaster/GetReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&mmId={{mastermodal.Id}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                    <li><a class="btn btn-action" ng-disabled="mastermodal.Id===null" href="Productions/RecipeGlobalMaster/GetReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&mmId={{mastermodal.Id}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                </ul>
            </div>
            <div class="clearfix"></div>
            <div class="col-xs-12 col-sm-6 col-md-6" style="display: none;">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Material Master</label>
                    <div class="col-sm-8">
                        <button ng-click="showMMModal();" class="btn small"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearMMCode();" class="btn small"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            <hr style="width:95%; text-align:center;margin:0px;" ng-show="master.MaterialMasterId.length>0" />
            @*Addnew Search btn*@
            @*<div class="clearfix"></div>*@
            <div class="col-xs-12 col-sm-6 col-md-6" ng-show="master.MaterialMasterId.length>0">
                <div class="form-group">
                    <div class="col-sm-4 text-right" style="padding-right:0px;">
                        <button ng-click="masterAddEditPopup('NEW');" class="btn small"><i class="glyphicon glyphicon-plus"></i> </button>
                    </div>
                    <div class="col-sm-8">
                        <button ng-click="masterSearchPopup()" class="btn small"><i class="glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="form-elements">
                <div class="tab-design" id="tab_show">
                    <div class="site-tab">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Details</a></li>
                            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">FG Tagging</a></li>
                        </ul>
                    </div>
                    <div class="tab-content">
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                            <!--Master Detail Buttons-->
                            <div class="row">
                                <div class="col-xs-12 col-sm-12 col-md-12" style="padding-bottom:10px;">
                                    @*<div>
                                        
                                        <button ng-click="showSubprocessPopup('','NEW');" ng-disabled="mastermodal.Id===null" class="btn small"><i class="glyphicon glyphicon-plus"></i> Add Line Item</button>
                                        
                                    </div>*@
                                    <div class="common-btn">
                                        <button ng-click="showSubprocessPopup('','NEW');" ng-disabled="mastermodal.Id===null" class="btn small"><i class="glyphicon glyphicon-plus"></i> Add Line Item</button>
                                    </div>
                                </div>
                                <div class="clearfix"></div>

                                <!--Detail Grid-->
                                <div class="table-responsive modal-table col-md-12" ng-show="detailList.length>0">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Edit</th>
                                                <th>Delete</th>
                                                <th ng-repeat="h in searchbyDetaillist">{{h.Text}}</th>
                                                <th>Raw Material</th>
                                                <th>Recipe Material Group</th>
                                                <th>Utility</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in detailList">
                                                <td>
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="showSubprocessPopup(x.Id,'EDIT')" class="btn-action tooltip-here" data-placement="top" title="Edit" tooltip>
                                                                <i class="glyphicon glyphicon-edit"></i>
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </td>
                                                <td>
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="deleteDetailGrid(x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove" tooltip>
                                                                <i class="glyphicon glyphicon-remove"></i>
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </td>
                                                <td ng-repeat="hh in searchbyDetaillist">{{x[hh.Value]}}</td>
                                                <td>
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="rawPopUp(x,$index)" class="btn-action tooltip-here" data-placement="top" title="Raw Material" tooltip>
                                                                <i class="glyphicon glyphicon-list"></i>
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </td>
                                                <td>
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="RecipeMaterialGroupPopUp(x,$index)" class="btn-action tooltip-here" data-placement="top" title="Recipe Material Group" tooltip>
                                                                <i class="glyphicon glyphicon-list"></i>
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </td>
                                                <td>
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="getDetailRow(x,'NEW')" class="btn-action tooltip-here" data-placement="top" title="Utility" tooltip>
                                                                <i class="glyphicon glyphicon-list"></i>
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                            <!--Detail Grid-->
                            <div class="col-xs-12 col-sm-12 col-md-12" style="padding-bottom:10px;">
                                <div class="common-btn">
                                    <button ng-click="getMaterialMasterbyTypePopUp('ProductDefinition');" ng-disabled="mastermodal.Id===null" class="btn small"><i class="glyphicon glyphicon-plus"></i> Add New</button>
                                </div>
                            </div>

                            <div class="table-responsive modal-table col-md-12" ng-show="recipeDetailsRawMaterialUsedList.length>0">
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Material Type</th>
                                                <th>Material Group</th>
                                                <th>Product</th>
                                                <th>Material Code</th>
                                                <th>Material Name</th>
                                                <th>Article Code</th>
                                                <th>Article Name</th>
                                                <th>Remove</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in recipeDetailsRawMaterialUsedList">
                                                <td>{{x.MaterialTypeName}}</td>
                                                <td>{{x.MaterialGroupMasterName}}</td>
                                                <td>{{x.ProductMasterName}}</td>
                                                <td>{{x.Code}}</td>
                                                <td>{{x.MaterialMasterName}}</td>
                                                <td>{{x.ArticleCode}}</td>
                                                <td>{{x.ArticleName}}</td>
                                                <td class="text-right table-td">
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="removeRowModal(x.StandardName, $index,'recipeDetailsRawMaterialUsedList', 'Id', 'MaterialMasterId');" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                                <i class="glyphicon glyphicon-remove"></i>
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            @*Master Search Modal*@
            <div class="modal fade site-modal in" id="mastersearchpopup" role="dialog" data-backdrop="static">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            Recipe Master <button type="button" class="close" data-dismiss="modal">&times;</button>
                        </div>
                        <div class="modal-body ">

                            <div class="row text-right">
                                <div class="col-xs-12 col-sm-12 col-sm-12">
                                    <div class="search-form">
                                        <div class="row">
                                            <div class="col-xs-12 col-sm-3 col-md-3">
                                                <div class="select-style">
                                                    <select ng-model="$root.parameters.searchBy">
                                                        <option ng-repeat="option in searchbyMasterlist" ng-show="option.IsVisible" value="{{option.Value}}">{{option.Text}}</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-xs-12 col-sm-7 col-md-7">
                                                <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="loadMasterData()">
                                            </div>
                                            <div class="col-xs-12 col-sm-2 col-md-2">
                                                <button type="button" ng-click="loadMasterData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th ng-repeat="h in searchbyMasterlist" ng-show="h.IsVisible">{{h.Text}}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr dir-paginate="x in masterList | itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="GetMasterIndex(x.Id);">
                                            <td ng-repeat="h in searchbyMasterlist" ng-show="h.IsVisible">{{x[h.Value]}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<div class="aplos-grid-toggle">
    <div class="row text-right ">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getDataList()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Recipe Name</th>
                    @*<th>Process</th>*@
                    <th>Code</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in RecipeMasterList |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'RecipeMasterList'" ng-dblclick="GetMasterIndex(x);">
                    @*ng-dblclick="Get($index);">*@
                    <td>{{x.Name}}</td>
                    @*<td>{{x.ProcessName}}</td>*@
                    <td>{{x.Code}}</td>
                    <td>{{x.Description}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10"
                                 pagination-id="metaData.name + 'RecipeMasterList'"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="getData(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>
<!-- #region Raw Material PopUp -->

<div class="modal fade site-modal in" id="rawMaterialPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Raw Material<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-horizontal form-elements">
