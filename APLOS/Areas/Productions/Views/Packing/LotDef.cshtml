@*<togglable name="Define Lot"></togglable>*@
<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> Define Lot</h3>
<div class="form-elements form-horizontal" ng-form name="GeneralForm">
    <div class="row">
        <input type="hidden" ng-model="modalNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Lot Number<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" disabled name="LotNumber" ng-model="modalNew.LotNumber" class="form-control text-right" tabindex="13">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Date" ng-model="modalNew.FromDate" datepicker class="form-control" tabindex="4">

                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Movement Purpose<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="modalNew.PurposeId" name="Movement Purpose" ng-change="getLocation()"
                                ng-options="item.Value as item.Text for item in purposeList" required tabindex="6">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Lot Weight<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" n-decimals="2" name="Total Qty" ng-model="modalNew.LotWeight" class="form-control text-right" tabindex="13">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="Customer" ng-model="modalNew.Customer" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="selectCustomer();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Production Order<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="Production Order" ng-model="modalNew.ProductionOrderId" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="getProductionOrderPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Sales Order</label>
                <div class="col-sm-8">
                    <input type="text" name="SalesOrder" disabled ng-model="modalNew.SalesOrder" class="form-control" maxlength="200" tabindex="4">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="modalNew.Remarks" maxlength="250" tabindex="8"></textarea>
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Process" class="form-control" ng-model="modalNew.ProcessId" ng-options="item.Value as item.Text for item in ProcessList" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Date" ng-model="modalNew.ToDate" datepicker required class="form-control" tabindex="4">

                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Location" disabled ng-model="modalNew.Location" class="form-control" maxlength="200" required tabindex="4">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Per Unit Weight<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" n-decimals="2" name="PerUnitWeight" ng-model="modalNew.PerUnitWeight" class="form-control text-right" tabindex="13">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">No Of Unit<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" n-decimals="2" name="NoOfUnit" ng-model="modalNew.NoOfUnit" class="form-control text-right" tabindex="13">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">SubProduction Order<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="Customer" ng-model="modalNew.SubProductionOrderId" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="GetSPOata();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="masterGo()" ng-disabled="disGo" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-xs-12">
            <div style="color:black;" id="GridPRSKU" ej-grid e-datasource="skuList" e-allowscrolling="true"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-type="string" e-field="Customer" e-headertext="Id" e-visible="false" e-width="80"></div>
                    <div e-column e-type="string" e-field="POId" e-headertext="POId" e-width="80"></div>
                    <div e-column e-type="string" e-field="SPOId" e-headertext="SPOId" e-width="80"></div>
                    <div e-column e-type="string" e-field="SalesOrderId" e-headertext="SOId" e-width="80"></div>
                    <div e-column e-type="string" e-field="SKUColor" e-headertext="Color" e-width="80"></div>
                    <div e-column e-type="string" e-field="SKUSize" e-headertext="Size" e-width="80"></div>
                    <div e-column e-field="OrderQty" e-headertext="Order Qty" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-template="#PlanQty" e-headertext="Plan Qty" e-width="80"></div>
                    <div e-column e-type="string" e-template="#LotQty" e-headertext="Lot Qty" e-width="80"></div>
                    <div e-column e-type="string" e-template="#BalanceQty" e-headertext="Balance Qty" e-width="80"></div>
                    <div e-column e-type="string" e-template="#AvaiableQty" e-headertext="Avaiable Qty" e-width="80"></div>

                    <script type="text/template" id="PlanQty">
                        <div class="col-sm-10" style="padding:0px; width:70px;">
                            <input type="text" ng-model="data.PlanQty" disabled n-decimals="2" style="color:black;" class="form-control" />
                        </div>
                    </script>
                    <script type="text/template" id="LotQty">
                        <div class="col-sm-10" style="padding:0px; width:70px;">
                            <input type="text" ng-model="data.LotQty" disabled n-decimals="2" style="color:black;" class="form-control" />
                        </div>
                    </script>
                    <script type="text/template" id="BalanceQty">
                        <div class="col-sm-10" style="padding:0px; width:70px;">
                            <input type="text" ng-model="data.BalanceQty" disabled n-decimals="2" style="color:black;" class="form-control" />
                        </div>
                    </script>
                    <script type="text/template" id="AvaiableQty">
                        <div class="col-sm-10" style="padding:0px; width:70px;">
                            <input type="text" ng-model="data.AvaiableQty" disabled n-decimals="2" style="color:black;" class="form-control" />
                        </div>
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade site-modal in" id="customersModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Customer</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic"> </div>
                <p style="margin:10px;">
                    Select The Customer by Double Clicking the Choice.
                <p>

                    <div id="getCustomers" ej-grid e-datasource="CustomersList" e-templaterefresh="refreshTemplate"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-minWidth="450" e-minHeight="400" e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true"
                         e-recorddoubleclick="doubleCustomer">
                        <div e-columns>
                            <div e-column e-field="id" e-headertext="Id" e-width="80"></div>
                            <div e-column e-field="username" e-headertext="Customer" e-width="120"></div>

                        </div>
                    </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>

<div class="modal site-modal in" id="POItemPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Production Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body text-center">
                <div class="row">
                    <div style="color:black;" id="GridPO" ej-grid e-datasource="ProductionOrderList" e-allowscrolling="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-recorddoubleclick="SetPrOData"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-template="#showSOList" e-headertext="" e-width="30"></div>
                            <div e-column e-type="string" e-field="POId" e-headertext="PrO" e-width="80"></div>
                            <div e-column e-type="string" e-field="ProductionStatus" e-headertext="Production Status" e-width="80"></div>
                            <div e-column e-type="string" e-field="BuyerItem" e-headertext="Buyer Item#" e-width="80"></div>
                            <div e-column e-type="string" e-field="OwnItem" e-headertext="Own Item#" e-width="80"></div>
                            <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Category" e-width="80"></div>
                            <div e-column e-type="string" e-field="Product" e-headertext="Product" e-width="80"></div>
                            <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                            <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                            <div e-column e-type="string" e-field="SONo" e-headertext="SONo" e-width="80"></div>
                            <div e-column e-type="string" e-field="RequiredTimeUnit" e-headertext="Required Time Unit" e-width="80"></div>

                        </div>
                    </div>
                    <script type="text/template" id="showSOList">
                        <div class="common-btn">
                            <ul class="list-inline text-right small">

                                <li>
                                    <button ng-click="$parent.getSalesOrderOfProdOrderList(data.POId);" class="btn small" style="height: 20px;width: 20px;padding: 0px;margin: 0px;">
                                        <i class="glyphicon glyphicon-th-list"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>

