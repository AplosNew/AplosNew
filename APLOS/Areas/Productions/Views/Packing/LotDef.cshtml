<togglable name="Define Lot"></togglable>
<div class="form-elements form-horizontal" ng-form name="GeneralForm">
    <input type="hidden" ng-model="modalNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Lot Number<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" disabled name="LotNumber" ng-model="modalNew.LotNumber" class="form-control text-right" tabindex="13">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="From Date" ng-model="modalNew.FromDate" datepicker class="form-control" tabindex="4">

            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" name="Customer" ng-model="modalNew.Customer" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="selectCustomer();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Lot Weight<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" n-decimals="2" name="Total Qty" ng-model="modalNew.LotWeight" class="form-control text-right" tabindex="13">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">No Of Unit<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" n-decimals="2" name="Total Qty" ng-model="modalNew.NoOfUnit" class="form-control text-right" tabindex="13">
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Process" class="form-control" ng-model="modalNew.ProcessId" ng-options="item.Value as item.Text for item in ProcessList" required>
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="To Date" ng-model="modalNew.ToDate" datepicker class="form-control" tabindex="4">

            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Location<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Location" ng-model="modalNew.LocationId" class="form-control" maxlength="200" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Per Unit Weight<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" n-decimals="2" name="PerUnitWeight" ng-model="modalNew.PerUnitWeight" class="form-control text-right" tabindex="13">
            </div>
        </div>


    </div>

    <div class="common-btn">
        <ul class="common-btn list-inline text-right">
            <li><button ng-click="Save()" class="btn" tabindex="10"><i class="glyphicon glyphicon-save"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear()" class="btn" tabindex="10"><i class="glyphicon glyphicon-save"></i> Clear</button></li>

        </ul>
    </div>


</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>

