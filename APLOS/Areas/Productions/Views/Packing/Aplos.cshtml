<div class="row" ng-form name="General">
    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="row" >
            <div class="col-xs-5 col-sm-6 col-md-6" id="Date" style="margin-top:20px;">
                <div class="form-group" >
                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="From Date" ng-model="selectedValues.FromDate" datepicker class="form-control"  tabindex="4">

                    </div>
                </div>
            </div>
            <div class="col-xs-5 col-sm-6 col-md-6" style="margin-top:20px;">
                <div class="form-group" >
                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="To Date" ng-model="selectedValues.ToDate" datepicker class="form-control"  tabindex="4">

                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="col-xs-6 col-sm-6 col-md-6" id="Filters">
        <div class="row" style="margin-top:10px;">
            <div class="col-xs-5 col-sm-6 col-md-6">
                <div class="col-lg-3">
                    <div class="row" style="margin-left:10px;margin-top:5px;"><select id="dropdown1" ej-dropdownlist e-datasource="list" e-text="All" e-value="All" e-change="change"></select></div>
                </div>

            </div>
            <div class="col-xs-5 col-sm-6 col-md-6">
                <div class="col-lg-3">
                    <div class="row" style="margin-left:10px;margin-top:5px;"><select id="dropdown2" ej-dropdownlist e-datasource="list1" e-text="With Stock" e-value="WithStock" e-change="change1"></select></div>
                </div>
            </div>
            <div class="col-xs-5 col-sm-6 col-md-6">
                
                <div class="col-lg-3">
                    <div class="row" style="margin-left:10px;margin-top:5px;"><select id="listLoc" ej-dropdownlist e-datasource="LocList" e-text="All" e-value="All" e-change="LocChange" e-placeholder="Location"></select></div>
                </div>
            </div>
        </div>


    </div>

</div>

<confirm-modal></confirm-modal>


<div class="row text-right " id="Filters2">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>

