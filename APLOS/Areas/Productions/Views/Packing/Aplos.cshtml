<div id="TDiv">

    <div class="col-md-12 text-center" style="margin-bottom:20px; margin-top:20px;">
        <button class="btn" style="border-radius: 00%;cursor:pointer;background-color:#242841;color:white;" id="forward1" ng-click="clickdde1();">Stock Status</button>
        <button disabled class="btn" style="border-radius: 00%;cursor:pointer;color:black;" id="forward1">Packing Plan</button>
        <button class="btn" style="border-radius: 0%;cursor:pointer;background-color:#242841;color:white;" id="forward1" ng-click="clickdde4();">Packing List</button>
    </div>
    <p><b>Packing Plan</b></p>
    <br>

    <div class="row" style="margin-top:10px;">
        <div class="col-xs-12 col-sm-6 col-md-6">


            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-top:10px">Customer<sup>*</sup></label>
                <div class="col-sm-6 show-message" style="margin-top:10px">
                    <input type="text" name="Location" ng-model="customer" ng-click="selectCustomer()" class="form-control" maxlength="200" tabindex="5">

                </div>
                <div class="col-sm-1" style="margin-top:10px">
                    <button ng-click="selectCustomer()" class="btn" ><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>




            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-top:20px">Storage Location</label>
                <div class="col-sm-8 show-message" style="margin-top:20px">
                    <div class="select-style">
                        <select class="form-control" ng-model="Packing.StorageLocId" name="StorageLoc"
                                ng-options="item.Value as item.Text for item in storageLocList">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-top:10px">Dispatch Responsible Person<sup>*</sup></label>
                <div class="col-sm-8 show-message" style="margin-top:10px">
                    <input type="text" name="Location" ng-model="dRespPerson" ng-click="selectDRespPerson()" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-top:10px">By Whom</label>
                <div class="col-sm-8 show-message" style="margin-top:10px">
                    <input type="text" name="Location" ng-model="byWhom" ng-click="selectByWhom()" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-top:10px">Inactive Date</label>
                <div class="col-sm-8 show-message" style="margin-top:10px">
                    <input type="text" name="To Date" ng-model="Packing.InactiveDate" datepicker class="form-control">

                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-top:10px">Entity</label>
                <div class="col-sm-8 show-message" style="margin-top:10px">
                    <div class="select-style">
                        <select class="form-control" ng-model="Packing.EntityId" name="EntityId"
                                ng-options="item.Value as item.Text for item in EntityList">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-top:10px">Remarks</label>
                <div class="col-sm-8 show-message" style="margin-top:10px">
                    <input type="text" name="Location" ng-model="Packing.Remarks" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

        </div>



        <br>
    </div>
    <div class="row">

        <div id="PackingLineItem" ej-grid e-datasource="PackingLineItemGrid" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
            <div e-columns>
                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplateForPackingLine" e-textalign="center" e-width="30"></div>
                <div e-column e-field="DeliveryDate" e-type="string" e-headertext="Delivery Date" e-width="80"></div>
                <div e-column e-field="SoQty" e-type="number" e-headertext="Sales Order Qty" e-width="80"></div>
                <div e-column e-field="Despatch" e-headertext="Dispatch Qty" e-width="80" e-type="number"></div>
                <div e-column e-field="toDespatch" e-type="number" e-headertext="To Dispatch" e-width="80"></div>

                <div e-column e-field="UOM" e-type="number" e-headertext="UOM" e-width="150"></div>
                <div e-column e-field="SO" e-type="number" e-headertext="Sales Order No" e-width="150"></div>
                <div e-column e-field="SOStatus" e-type="string" e-headertext="Sales Order Status" e-width="150"></div>
                <div e-column e-field="PO" e-type="string" e-headertext="Production Order No" e-width="150"></div>
                <div e-column e-field="ItemId" e-type="string" e-headertext="Master Item ID" e-width="150"></div>
                <div e-column e-field="MasterOrderNo" e-type="string" e-headertext="Master Order Id" e-width="150"></div>
                <div e-column e-field="Product" e-type="string" e-headertext="Product" e-width="150"></div>
                <div e-column e-field="ItemArticle" e-type="string" e-headertext="Article" e-width="150"></div>
                <div e-column e-field="ProductCode" e-type="string" e-headertext="Product Code" e-width="150"></div>
            </div>
        </div>
        <div class="common-btn" style="margin:10px;">
            <ul class="common-btn list-inline text-right">
                <li><button ng-click="getLotRef()" class="btn "><i class="glyphicon glyphicon-arrow-down"></i> View</button></li>
            </ul>
        </div>
    </div>
    <div class="row">
        <div style="text-align:left; margin-left:10px; font-size:large"><b>To Dispatch = </b>  {{toDisp}} | <b>Total Planned =</b> {{totalPlanned}} |  <b>Percentage = </b> {{Percent}}%</div>
        <div id="getPoLot" ej-grid e-datasource="PoLotRefGrid" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" style="margin-top:30px;" e-allowtextwrap="true"
             e-recorddoubleclick="showCartons" e-tooltipsettings-visible="true" e-tooltip="tooltip">
            <div e-columns>
                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplateForPO" e-textalign="center" e-width="30"></div>
                <div e-column e-field="Assigned" e-headertext="Assigned/Unassigned" e-width="80" e-type="string"></div>
                <div e-column e-field="ProductCode" e-headertext="Prod Code" e-width="70" e-type="number"></div>
                <div e-column e-field="PO" e-type="number" e-headertext="PO" e-width="70"></div>
                <div e-column e-field="POStatus" e-headertext="PO Status" e-width="80"></div>
                <div e-column e-field="POQty" e-type="number" e-headertext="PO Qty" e-width="80"></div>
                <div e-column e-field="ProducedQty" e-type="number" e-headertext="Produced Qty" e-width="80"></div>
                <div e-column e-field="BalanceQty" e-type="number" e-headertext="Balance Qty" e-width="80"></div>


                <div e-column e-field="LotNo" e-type="number" e-headertext="Lot No" e-width="70"></div>
                <div e-column e-field="QualityStatus" e-headertext="Quality Status" e-width="80"></div>
                <div e-column e-field="CommentDetails" e-headertext="Final Comment" e-width="80"></div>
                <div e-column e-field="Grade" e-headertext="Final Grade" e-width="80"></div>
                <div e-column e-field="PlannedQty" e-type="number" e-headertext="Planned Qty" e-width="80"></div>
                <div e-column e-field="BookedQty" e-type="number" e-headertext="Booked Qty" e-width="80"></div>
                <div e-column e-field="Bags" e-type="number" e-headertext="Bags" e-width="80"></div>
                <div e-column e-field="StockQty" e-type="number" e-headertext="Stock Qty" e-width="80"></div>
                <div e-column e-headertext="Plan Qty" e-template="#allotQty" e-textalign="center" e-width="80"></div>
                <div e-column e-headertext="Book Qty" e-template="#bookQty" e-textalign="center" e-width="80"></div>
                <div e-column e-field="Available" e-type="number" e-headertext="Available Qty" e-textalign="center" e-width="80"></div>
                <div e-column e-field="comment" e-type="string" e-headertext="Comment" e-width="80"></div>
                <div e-column e-template="#QualityTestReport" e-headertext="Quality Test Report" e-width="100"></div>
            </div>
            <script type="text/template" id="QualityTestReport">
                <div class="form-group">
                    <div class="col-sm-5 text-left" style="padding:0px;padding-left:2px">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li>
                                    <button id="QualityTestReport" ng-click="$parent.ViewReport(this);" class="btn"><i class="glyphicon glyphicon-list"></i></button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </script>
        </div>
    </div>
    <div class="row">
        <div class="common-btn" style="margin:10px;">
            <ul class="common-btn list-inline text-right">
                <li><button ng-click="saveAll()" class="btn "><i class="glyphicon glyphicon-arrow-down"></i> Save All</button></li>
                <li><button ng-click="clearPage()" class="btn "><i class="glyphicon glyphicon-repeat"></i> Clear All</button></li>
            </ul>
        </div>
    </div>





</div>
<script type="text/template" id="allotQty">
    <input type="number" ng-model="data.quant" ng-change="$parent.calculateQty()" style="color:black; text-align:center" />
</script>
<script type="text/template" id="bookQty">
    <input type="number" ng-model="data.bookQty" readonly style="color:black; text-align:center" />
</script>

<script type="text/template" id="checkboxTemplateForPO">
    <input type="checkbox" class="rowCheckbox" ng-model="data.checked" />
</script>
<script type="text/template" id="checkboxTemplateForPackingLine">
    <input type="checkbox" class="rowCheckbox" ng-model="data.checked"  />
</script>


<div id="UDiv">
    <div class="row">
        <div class="col-md-12 text-center" style="margin-bottom:20px; margin-top:20px;">
            <button class="btn" style="border-radius: 0%;cursor:pointer;background-color:#242841;color:white;" id="forward1" ng-click="clickdde1();">Stock Status</button>
            <button class="btn" style="border-radius: 0%;cursor:pointer;background-color:#242841;color:white;" id="forward1" ng-click="clickdde3();">Packing Plan</button>
            <button disabled class="btn" style="border-radius: 0%;cursor:pointer;color:black;" id="forward1">Packing List</button>
        </div>
    </div>
    <p><b>Packing List</b></p>
    <br>
    <div class="content-container-fluid">
        <div id="GridPacking" ej-grid e-datasource="gridPacking" e-recorddoubleclick="openPackingLineItem" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-queryCellInfo="cellDetails" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="PackingId" e-type="string" e-headertext="Packing Id" e-width="80"></div>
                <div e-column e-field="SalesId" e-type="string" e-headertext="InvoiceNo" e-width="80"></div>
                <div e-column e-field="Entity" e-type="string" e-headertext="Entity" e-width="80"></div>
                <div e-column e-field="Customer" e-type="string" e-headertext="Customer" e-width="100"></div>

                <div e-column e-field="StorageLoc" e-type="string" e-headertext="Storage Location" e-width="80"></div>
                <div e-column e-field="ByWhom" e-type="string" e-headertext="By Whom" e-width="80"></div>
                <div e-column e-field="DRespPerson" e-type="string" e-headertext="Despatch Responsible Person" e-width="80"></div>
                <div e-column e-field="AddedDate" e-type="date" e-headertext="Created Date" e-width="80"></div>
                <div e-column e-field="InActiveDate" e-type="date" e-headertext="Inactive Date" e-width="80"></div>
                <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="100"></div>
            </div>
        </div>
        <script type="text/template" id="ShowActionButtons">
            <button style="color: #f3f3ec;background-color: #1c1f32;height: 25px;" title="Summary" class="btn"><i class="glyphicon glyphicon-print" ng-click="$parent.PackingListReport(this);"></i></button>
