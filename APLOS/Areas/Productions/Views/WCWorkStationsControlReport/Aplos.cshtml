<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>WC/Work Stations Control Report
</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .modellgModify {
        width: 2000px;
    }
</style>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">WSM UserName</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="IsGo" ng-model="statusNew.WSMId" name="WSMId" ng-options="item.Value as item.Text for item in WSMUserNameList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="form-group">
                <label class="col-sm-4 control-label">From Date</label>
                <div class="col-sm-8">
                    <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.FromDateMD" datepicker class="form-control">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="form-group">
                <label class="col-sm-4 control-label">To Date</label>
                <div class="col-sm-8">
                    <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.ToDateMD" datepicker class="form-control" ng-change="">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="common-btn">
                <button ng-click="View();" class="btn"> View </button>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="common-btn" ng-show="WCWorkStationsControlReportList.length>0">
                <ul class="list-inline text-right">
                    <li><button ng-click="WCWorkStationsControlReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                </ul>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div id="maindiv" class="table-responsive modal-table">
                <div id="GridWCWorkStationsControlReport" ej-grid e-datasource="WCWorkStationsControlReportList" e-recorddoubleclick="GetDetails"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true" e-rowdatabound="rowDataBoundDetails"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-type="string" e-field="WSMUserName" e-headertext="WSM User Name" e-width="100"></div>
                        <div e-column e-type="string" e-field="Entity" e-headertext="Entity" e-width="100"></div>
                        <div e-column e-type="string" e-field="Process" e-headertext="Process" e-width="100"></div>
                        <div e-column e-type="string" e-field="Date" e-headertext="Date" e-width="100"></div>
                        <div e-column e-type="string" e-field="WorkCenter" e-headertext="Work Center" e-width="100"></div>
                        <div e-column e-type="string" e-field="WorkStation" e-headertext="Work Station" e-width="100"></div>
                        <div e-column e-type="string" e-field="PeriodName" e-headertext="Period Name" e-width="80"></div>
                        <div e-column e-type="string" e-field="CD1" e-headertext="CD1" e-visible="false" e-width="120"></div>
                        <div e-column e-type="string" e-field="CD2" e-headertext="CD2" e-visible="false" e-width="120"></div>
                        <div e-column e-type="string" e-field="CD3" e-headertext="CD3" e-visible="false" e-width="120"></div>
                        <div e-column e-type="string" e-field="CD4" e-headertext="CD4" e-visible="false" e-width="120"></div>
                        <div e-column e-type="string" e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="100"></div>
                        <div e-column e-type="string" e-field="InCharge" e-headertext="InCharge" e-width="100"></div>
                        <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                        <div e-column e-type="string" e-field="ReasonDetails" e-headertext="Reason Details" e-width="200"></div>
                        <div e-column e-type="string" e-field="PeriodFromTime" e-headertext="P.FromTime" e-width="100"></div>
                        <div e-column e-type="string" e-field="PeriodToTime" e-headertext="P.ToTime" e-width="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


