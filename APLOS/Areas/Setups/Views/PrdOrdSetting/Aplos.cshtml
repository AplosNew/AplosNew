<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span>Production Order Setting</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company Group<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="model.CompanyGroupId" name="Company Group"
                            ng-options="item.Value as item.Text for item in companyGroupList"
                            ng-change="getCboCompanyByCompanyGroup()" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="PlantId" class="form-control" ng-model="model.PlantId" ng-options="item.Value as item.Text for item in plantList"
                            ng-change="getData();" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="model.CompanyId" name="Company"
                            ng-options="item.Value as item.Text for item in companyList" ng-change="getPlantList();"
                            required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button tabindex="9" ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{mainList[0].Id==null?'Save':'Update'}}</button></li>
            <li><button tabindex="11" ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="mainList.length>0">
    <table class="table table-striped">
        <thead>
            <tr>
                <th ng-show="mainList.length>1"></th>
                <th>Column</th>
                <th>Column Sequence</th>
                <th class="col-md-1">Marge Allowed</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in mainList">
                <td ng-show="mainList.length>1">
                    <span ng-show="!$first" ng-click="moveUp($index,mainList,'ColumnSequence')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                    <br />
                    <span ng-show="!$last" ng-click="moveDown($index, mainList,'ColumnSequence')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                </td>
                <td>{{x.ColumnName}}</td>
                <td>{{x.ColumnSequence}}</td>
                <td>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.MargeAllowed" ng-checked="x.MargeAllowed">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</div>