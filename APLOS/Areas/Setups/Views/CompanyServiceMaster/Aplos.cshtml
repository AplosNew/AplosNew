<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Company Service Master</h3>
<div class="form-elements row">
    <div class="form-group">
        <label class="col-sm-3 col-md-2 control-label">Company</label>
        <div class="col-sm-3 col-md-4">
            <div class="select-style">
                <select class="form-control" ng-model="serviceMasterCompanyExtension.CompanyId"
                        ng-options="item.Value as item.Text for item in companyList"
                        ng-change="getCompanyServiceMasterOnCompanyChange(serviceMasterCompanyExtension.CompanyId)">
                    <option></option>
                </select>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-left">
            <li>
                <button ng-click="serviceMasterSearchPopup();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add ServiceMaster</button>
            </li>
        </ul>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-right">
            <li>
                <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button>
            </li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="serviceMasterSelectedList.length>0">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Standard Name</th>
                <th>User Defined Name</th>
                <th>Service Group</th>
                <th>Remove</th>
            </tr>
        </thead>
        <tbody>
            @*<tr dir-paginate="x in serviceMasterSelectedList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-class="{unsaveRow : x.Id==null}">*@
            <tr ng-repeat="x in serviceMasterSelectedList" ng-class="{unsaveRow : x.Id==null}">
                <td>{{x.Code}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.ServiceGroupName}}</td>
                <td class="text-right table-td">
                    <ul class="list-inline action-list">
                        <li>
                            <button ng-click="valuePassInDelModal($index, x)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    @*<dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>*@
</div>
<div class="modal fade site-modal in" id="serviceMasterListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Service Master<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="serviceMasterListParameters.searchBy">
                                            <option ng-repeat="option in searchByServiceMasterList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="serviceMasterListParameters.search" ng-enter="loadServiceMasterData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadServiceMasterData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Standard Name</th>
                                <th>User Defined Name</th>
                                <th>Service Group</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in serviceMasterList |itemsPerPage:serviceMasterListParameters.pageSize" pagination-id="metaData.name + 'serviceMasterList'" total-items="serviceMasterListParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="pushInTempList(x,$event,serviceMasterList);">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.ServiceGroupName}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'serviceMasterList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadServiceMasterData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="serviceMasterCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteServiceMasterList()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>