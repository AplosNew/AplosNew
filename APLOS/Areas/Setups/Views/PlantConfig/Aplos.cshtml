<togglable name="Plant Config"></togglable>
<div class="form-elements form-horizontal" ng-form id="plantconfig" name="plantconfigForm">
    <input type="hidden" ng-model="plantConfig.Id">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">Fabric Roll Management</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company Group<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="plantConfig.CompanyGroupId" name="CompanyGroup"
                                ng-options="item.Value as item.Text for item in companyGroupList"
                                ng-change="getCboCompanyByCompanyGroup(plantConfig.CompanyGroupId)" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="PlantId" submit-required="true" class="form-control" ng-model="plantConfig.PlantId" ng-options="item.Value as item.Text for item in plantList" ng-change="getPrdordSettingData();" required>
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>


            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Blanket Default Length</label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="plantConfig.BlanketDefaultLength" name="BlanketDefaultLength" class="form-control">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Blanket Default Width</label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="plantConfig.BlanketDefaultWidth" name="BlanketDefaultWidth" class="form-control">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">After Wash Shrinkage OnActual</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" name="After Wash Shrinkage OnActual" ng-model="plantConfig.IsAfterWashShrinkageOnActual">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Machine Budget Level</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="plantConfig.MachineBudgetLevel" name="MachineBudgetLevel"
                                ng-options="item.Value as item.Text for item in machineBudgetLevelList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-8 control-label">Is Production Hour Open</label>
                <div class="col-sm-4">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" name="Is Production Hour Open" ng-model="plantConfig.IsProductionHourOpen">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="plantConfig.CompanyId" name="Company"
                                ng-options="item.Value as item.Text for item in companyList" ng-change="getPlantList(plantConfig.CompanyId)"
                                required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Fab. Roll Prefix</label>
                <div class="col-sm-8">
                    <input type="text" ng-model="plantConfig.FabRollPrefix" maxlength="2" name="Fab. Roll Prefix" class="form-control">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-8 control-label">Blanket Default Length Values Changeable</label>
                <div class="col-sm-4">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" name="Blanket Default Length Values Changeable" ng-model="plantConfig.IsBlanketDefaultLengthValuesChangeable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-8 control-label">Blanket Default Width Values Changeable</label>
                <div class="col-sm-4">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" name="Blanket Default Width Values Changeable" ng-model="plantConfig.IsBlanketDefaultWidthValuesChangeable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Weekend for Sales Order</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select name="Weekend for Production Order" class="form-control" ng-model="plantConfig.WeekendforProductionOrder" ng-options="item.Value as item.Text for item in dayList">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-8 control-label">Is Machine Changeable in Bulletin Template</label>
                <div class="col-sm-4">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="plantConfig.IsMachineChangeableinBulletinTemplate" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">Order Management</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Buyer Applicable</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" name="Buyer Applicable" ng-model="plantConfig.BuyerApplicable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-8 control-label">Operation in Production Booking Will Be Capture by Bulletin</label>
                <div class="col-sm-4">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="plantConfig.OperationInProductionBookingWillBeCapturebyBulletin" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

    </fieldset>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">Production Order Merge Parameter</legend>
        <div class="col-xs-12">
            <div class="table-responsive modal-table" ng-show="mainList.length>0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th ng-show="mainList.length>1"></th>
                            <th>Column</th>
                            @*<th>Column Sequence</th>*@
                            <th class="col-md-1">Marge Allowed</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in mainList">
                            <td ng-show="mainList.length>1">
                                <span ng-show="!$first" ng-click="moveUp($index,mainList,'ColumnSequence')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                <br />
                                <span ng-show="!$last" ng-click="moveDown($index, mainList,'ColumnSequence')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                            </td>
                            <td>{{x.ColumnName}}</td>
                            @*<td>{{x.ColumnSequence}}</td>*@
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="x.MargeAllowed" ng-checked="x.MargeAllowed">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </fieldset>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">Operation Management</legend>
        <div class="col-xs-12">
            <div class="form-group">


                <div class="col-sm-6 radio">
                    <input type="radio" name="Operation" ng-model="plantConfig.Operation" value="Operation Master">
                    <span></span><span>Operation Master</span><br />

                </div>
                <div class="col-sm-6 radio">
                    <input type="radio" name="Operation" ng-model="plantConfig.Operation" value="Operation Variation">
                    <span></span><span>Operation Variation</span><br />

                </div>

            </div>
        </div>

    </fieldset>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button tabindex="9" ng-click="SaveMaster();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button tabindex="10" data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button tabindex="11" ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select tabindex="13" ng-model="$root.parameters.searchBy" class="form-control">
                            <option ng-repeat="option in searchByList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input tabindex="14" type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button tabindex="15" type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Company Group</th>
                <th>Company</th>
                <th>Plant</th>
                <th>Fab Roll Prefix</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in plantConfigList|itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.CompanyGroupName}}</td>
                <td>{{x.CompanyName}}</td>
                <td>{{x.PlantName}}</td>
                <td>{{x.FabRollPrefix}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>