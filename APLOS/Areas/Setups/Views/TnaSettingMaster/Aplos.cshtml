<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Tna Setting
</h3>
<div class="row">
    <div class="form-horizontal" ng-form id="ShiftGroup" name="tnaSettingMasterForm">
        <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="tnaSettingMaster.PlantId"
                                ng-options="item.Value as item.Text for item in plantList"
                                ng-change="GetList()" required></select>
                    </div>
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline">
                    <li> <button ng-click="employeePopUpShow();" ng-disabled="tnaSettingMaster.PlantId===null" class="btn"><i class="glyphicon glyphicon-search"></i> Add Employee</button></li>
                </ul>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">

        </div>
        <input type="hidden" ng-model="tnaSettingMaster.Id">
        <div class="col-xs-12 col-sm-12 col-md-12  form-element-ctrl">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Employee Code</th>
                            <th>Employee Name</th>
                            <th>Given Designation</th>
                            <th>Department</th>
                            <th>Division</th>
                            <th>Section</th>
                            <th>To User</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in tnaSettingMasterList">
                            <td>{{x.EmployeeCode}}</td>
                            <td>{{x.EmployeeName}}</td>
                            <td>{{x.GivenDesignation}}</td>
                            <td>{{x.Department}}</td>
                            <td>{{x.Division}}</td>
                            <td>{{x.Section}}</td>
                            <td>
                                <button ng-click="showToUserAddPopUp($index, x)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                   Add
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @*<div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>*@
    </div>
</div>

<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Given Designation</th>
                                <th>Department</th>
                                <th>Division</th>
                                <th>Section</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count" pagination-id="metaData.name + 'employeeList'">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="{{x.SystemId}}" ng-model="x.Flag" ng-checked="x.Flag">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.GivenDesignation}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Division}}</td>
                                <td>{{x.Section}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'employeeList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEmployeeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="employeeToPopUpAdd" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="common-btn">
                    <ul class="list-inline">
                        <li> <button ng-click="employeeToPopUpShow();" class="btn"><i class="glyphicon glyphicon-search"></i> Add Employee</button></li>
                    </ul>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Given Designation</th>
                                <th>Department</th>
                                <th>Division</th>
                                <th>Section</th>
                                <th>To User</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in tnaSettingMasterToUserList">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.GivenDesignation}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Division}}</td>
                                <td>{{x.Section}}</td>
                                <td>
                                    <button ng-click="valuePassInTestingStandardDetailSavedListSavedDelModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                        <i class="glyphicon glyphicon-remove"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="Save();" class="btn"><i class=""></i> Save</button>
            </div>
        </div>
    </div>
</div>
