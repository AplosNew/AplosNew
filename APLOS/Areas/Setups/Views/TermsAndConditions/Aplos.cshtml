<ej-dialog id="dialogAPI" title="Confirm Delete?" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#BPMRDistribution" e-close="onDialogClose" e-minwidth="240" e-minheight="165" e-open="enableBtn">
    <p>
        Are you sure to delete ?
    </p>
    <p class="text-right">
        <ul class="list-inline text-right">
            <li><button ng-click="DeleteDistribution();ConfirmClose()" class="btn"><i class="glyphicon glyphicon-floppy-remove"></i> Yes</button></li>
            <li><button ng-click="ConfirmClose();" class="btn"><i class="glyphicon glyphicon-step-backward"></i> No</button></li>
        </ul>
    </p>
</ej-dialog>
