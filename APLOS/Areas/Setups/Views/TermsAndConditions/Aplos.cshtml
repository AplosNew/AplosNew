<togglable name="Terms and Conditions "></togglable>
<div class="form-horizontal" ng-form name="BonusPolicyForm" id="MainDivId">
 
    <div class="form-elements ">
        <div class="row">
            <div class="col-xs-12 col-sm-5 col-md-5">
                <div class="form-group">
                    <label class="col-sm-3 control-label">Type</label>
                    <div class="col-sm-9">
                        <div class="select-style">
                            <select name="SO Type" class="form-control" ng-model="TermsAndConditionModel.Type" tabindex="102">
                                <option value="">--Select--</option>
                                <option value="PO No.">PO No.</option>
                                <option value="PO">PO.</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-3 control-label" style="padding-left: 43px;">Description</label>
                    <div class="col-sm-9">
                        <textarea class="form-control" rows="3" ng-model="TermsAndConditionModel.Description" tabindex="7" maxlength="250"></textarea>
                    </div>
                </div>

            </div>
            <div class="col-xs-12 col-sm-1 col-md-1">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button @*ng-click=""*@ @*ng-disabled="ESICPolicyMaster.ID==null"*@ class="btn"><i class="glyphicon glyphicon-plus"></i></button></li>
                    </ul>
                </div>
            </div>
            <div class="form-group col-md-5" >
                <label class="col-sm-3 control-label">Title</label>
                <input type="hidden" ng-model="TermsAndConditionModel.Id">
                <div class="col-sm-9">
                    <input type="text" ng-model="TermsAndConditionModel.MasterDescription" class="form-control" maxlength="100" tabindex="2">
                </div>
            </div>
            <div class="col-sm-7">
                <div id="Grid2" ej-grid e-datasource="GridList" e-allowsorting="true" e-allowscrolling="true"
                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowResizing="true"
                     e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="false">
                    <div e-columns>
                        <div e-column e-template="#templateHeader" e-headertext="Header" e-width="10"></div>
                        <div e-column e-template="#templateDescription" e-headertext="Description" e-width="15"></div>
                        <div e-column e-headertext=" Action " e-template="#ActionBTN" e-width="6"></div>
                        @*<div e-column e-field="Header" e-headertext="Header" e-width="3"></div>*@
                        @*<div e-column e-field="Description" e-headertext="Description" e-width="3"></div>*@
                        @*<div e-column e-headertext="Delete" e-width="3"><button data-toggle="modal" class="btn" ng-click="$parent.RemoveHead(this);" tabindex="10"><i class="glyphicon glyphicon-trash"></i></button></div>*@
                    </div>
                    <script id="ActionBTN" type="text/template">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-center">
                                <li>
                                    <button ng-click="$parent.loadGrid(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Show">
                                        <i class="glyphicon glyphicon-plus" style="color: greenyellow;"></i>
                                    </button>
                                </li>
                                <li>
                                    <button ng-click="$parent.Remove($index);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Show">
                                        <i class="glyphicon glyphicon-minus" style="color:orangered;"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </script>
                </div>
                <script type="text/template" id="templateHeader">
                    <input type="text" class="form-control" @*ej-numerictextbox e-decimalplaces="2" e-minValue="0"*@ e-enablertl="false" e-value="data.Header" e-width="100%" />
                </script>
                <script type="text/template" id="templateDescription">
                    <input type="text" class="form-control" @*ej-numerictextbox e-decimalplaces="2" e-minValue="0"*@ e-enablertl="false" e-value="data.DetailDescription" e-width="100%" />
                </script>
            </div>
        </div>

    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div class="col-xs-12 col-sm-12 col-sm-12" style="padding-left: 0px; padding-right: 0px;">
            <div id="GridEdit" ej-grid e-datasource="Model" e-recorddoubleclick="getDetails" e-load="loadGridEdit"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="ID" e-width="60"></div>
                    <div e-column e-field="Description" e-headertext="Description" e-width="60"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmPopUpHead" title="Confirmation" message="{{message_confirmation}}" data-ng-click-right-button="DeleteHeadList();"></confirm-archive-generic>

<ej-dialog id="BPMRDetails"
