                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="ESICPolicyDetails.SalaryHeadIDEarning" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetEarningFormula('EarningSHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Operator</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="ESICPolicyDetails.EOperator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="5">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetEarningFormula('EarningOperator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Precedence</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="ESICPolicyDetails.Precedence" class="form-control" name="Precedence" tabindex="5">
                                    <option value=""></option>
                                    <option value="(">(</option>
                                    <option value=")">)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetEarningFormula('EarningPrecedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
