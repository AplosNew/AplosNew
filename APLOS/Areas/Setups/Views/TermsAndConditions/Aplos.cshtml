                        {{ESICPolicyDetails.FormulaDesEarning}}
                    </div>
                </div>
            </fieldset>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6 form-elements">
            <div class="form-group">
                <label class="col-sm-5 control-label">Earning Value Range From</label>
                <div class="col-sm-7">
