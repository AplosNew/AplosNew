<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Country HSN Code</h3>
<div class="form-elements row">
    <div class="form-group">
        <label class="col-sm-3 col-md-2 control-label">Country</label>
        <div class="col-sm-3 col-md-4">
            <div class="select-style">
                <select class="form-control" ng-model="countryHSNCode.CountryId"
                        ng-options="item.Value as item.Text for item in CountryList"
                        ng-change="getCountryHSNCodeOnCountryChange(countryHSNCode.CountryId)">
                    <option></option>
                </select>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-left">
            <li><button ng-click="hSNCodeSearchPopup();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add HSNCode</button></li>
        </ul>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="hSNCodeSelectedList.length>0">
    <table class="table table-striped form-elements form-horizontal">
        <thead>
            <tr>
                <th>HSN Code</th>
                <th>HSN Description</th>
                <th>Remove</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in hSNCodeSelectedList" ng-class="{unsaveRow : x.Id==null}">
                <td><input type="text" only-numbers name="Code" ng-model="x.Code" class="form-control" maxlength="10"></td>
                <td><input type="text" name="Description" ng-model="x.Description" class="form-control" maxlength="100"></td>
                <td class="text-right table-td">
                    <ul class="list-inline action-list">
                        <li><button ng-click="valuePassInDelModal($index, x.HSNCodeId, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="modal fade site-modal in" id="hSNCodeListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                HSN Code
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">

                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="hSNCodeListParameters.searchBy">
                                            <option ng-repeat="option in searchByHSNCodeList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="hSNCodeListParameters.search" ng-enter="loadHSNCodeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadHSNCodeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Code</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in hSNCodeList|itemsPerPage:hSNCodeListParameters.pageSize" pagination-id="metaData.name + 'hSNCodeList'" total-items="hSNCodeListParameters.total_count" ng-dblclick="checkIsRegisterApply(x);">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="pushInTempList(x,$event,hSNCodeList);">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.Description}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'hSNCodeList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadHSNCodeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="hSNCodeCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteHSNCodeList()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>