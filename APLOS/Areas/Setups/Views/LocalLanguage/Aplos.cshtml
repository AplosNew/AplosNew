<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Local Language Master Entry
</h3>
<div ng-form id="salaryHeadNew" name="salaryHeadNewForm" class="form-elements  form-horizontal">
     
      <div class="row" ng-form name="budgetMasterForm2">
           <input type="hidden" ng-model="salaryHeadNew.SalaryHeadId"/>
            <div class="col-xs-12 col-sm-5 col-md-5">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Entry Type<sup>*</sup></label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" name="SalaryHead" ng-model="SelectedType.SelectedItem" ng-change="getLanguage();" tabindex="1">
                                <option value=""></option>
                                <option value="Company">Company</option>
                                <option value="CompanyGroup">Company Group</option>
                                <option value="Designation">Designation</option>
                                <option value="Department">Department</option>
                                <option value="Division">Division</option>
                                <option value="EmpGrade">Employee Grade</option>
                                <option value="EmployeeWorkType">Employee WorkType</option>
                                <option value="FinalSettlementHead">Final Settlement Head</option>
                                <option value="Leave">Leave</option>
                                <option value="Label">Label</option>
                                <option value="Line">Line</option>
                                <option value="LegalDesignation">Legal Designation</option>
                                <option value="Plant">Plant</option>
                                <option value="SalaryHead">Salary Head</option>
                                <option value="Section">Section</option>
                                <option value="SubSection">SubSection</option>
                                <option value="SubDivision">SubDivision</option>
                                <option value="Unit">Unit</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <input type="hidden" ng-model="languageNew.Id" />
            <div class="col-xs-12 col-sm-5 col-md-5">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Language<sup>*</sup></label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select id="languageId" class="form-control" name="Language" ng-model="languageNew.LanguageId" ng-disabled="SelectedType.SelectedItem===''" ng-change="getLanguage();" tabindex="1">
                                <option value=""></option>
                                <option ng-repeat="option in languageList  " value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            @*<div class="col-xs-12 col-sm-2 col-md-2">
                    <button ng-click="AddMultipleLanguage();" class="btn single-small-btn"><i class="glyphicon glyphicon-plus" tabindex="10"></i> {{LanguageCaption}}</button>
                </div>*@
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="table-responsive modal-table">
                    <table class="table table-striped" ng-show="show">
                        <thead>
                            <tr>
                                <th>User Name</th>
                                <th>Language</th>
                                @*<th class="col-md-2">Action</th>*@
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in salaryHeads">
                                <td>{{x.UserName}}</td>
                                <td><input type="text" class="form-control" ng-model="x.Name" ng-disabled="languageNew.LanguageId===''"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

</div>
    <div class="common-btn" ng-disabled="SelectedType.SelectedItem===''">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10" ></i> {{Action}}</button></li>
                @*<li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="12"></i> Clear</button></li>*@
            </ul>
    </div>

<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmlngPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="removeRow()">
</confirm-archive-generic>