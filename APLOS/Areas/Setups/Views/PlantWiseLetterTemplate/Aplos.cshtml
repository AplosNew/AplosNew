<togglable name="Plant Wise Letter Template"></togglable>
<div ng-form id="plantWiseLetterTemplate" name="plantWiseLetterTemplateForm" class="form-horizontal">
        <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Letter Type<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="LetterType" class="form-control" ng-model="plantWiseLetterTemplate.LetterType" ng-change="getData();" name="LetterType" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in letterTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="col-xs-12">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Body 1</label>
                <div class="col-sm-8 show-message">
                    <textarea class="form-control" rows="10" ng-model="plantWiseLetterTemplate.Description1" name="Description1" tabindex="7" required></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Body 2</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="10" ng-model="plantWiseLetterTemplate.Description2" tabindex="6"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Body 3</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="10" ng-model="plantWiseLetterTemplate.Description3" tabindex="6"></textarea>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Plant</th>
                <th>Body 1</th>
                <th>Body 2</th>
                <th>Body 3</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in plantWiseLetterTemplates |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Plant}}</td>
                <td>{{x.Description1}}</td>
                <td>{{x.Description2}}</td>
                <td>{{x.Description3}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>