                                    <script type="text/template" id="checkboxTemplateServiceMaster">
                                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                                    </script>
                                    @*<script type="text/template" id="headerTemplatePO">
                                    <input type="checkbox" ej-checkbox class="rowCheckbox" id="serviceMasterheadchk"  />
                                </script>*@
                                    <script type="text/template" id="remarkTemplate">
                                        <input type="text" name="Remarks" ng-model="data.Remarks" class="form-control" maxlength="100">
                                    </script>

                                    <script type="text/template" id="checkRowIsPO">
                                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsPO">
                                    </script>

                                    <script type="text/template" id="checkRowIsApproved">
                                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsApproved">
                                    </script>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
