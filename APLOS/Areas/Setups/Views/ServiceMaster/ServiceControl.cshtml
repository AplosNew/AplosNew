                                            <div e-column e-headertext="IsPO" @*e-headertemplateid="#headerTemplatePO"*@ e-template="#checkRowIsPO" e-textalign="center" e-width="30"></div>
                                            <div e-column e-headertext="IsApproved" e-headertemplateid="" e-template="#checkRowIsApproved" e-textalign="center" e-width="30"></div>
                                            <div e-column e-headertext="Remarks" e-headertemplateid="" e-template="#remarkTemplate" e-textalign="center" e-width="110"></div>
                                        </div>
                                    </div>
