                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveServiceMaster();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                            </ul>
                        </div>
