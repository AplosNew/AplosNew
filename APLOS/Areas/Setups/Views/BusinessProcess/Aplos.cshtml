<h3 class="site-heading" style="cursor:default;"><span class="glyphicon glyphicon-info-sign"></span> Business Process</h3>
<div class="form-elements form-horizontal" ng-form="brandForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company Group<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Company group" ng-model="brandNew.CompanyGroupId"
                            ng-options="item.Value as item.Text for item in companyGroupList" ng-change="getData();" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Define Name" ng-model="brandNew.UserName" class="form-control" maxlength="50" required tabindex="3">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Business Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Business process" ng-model="brandNew.BusinessProcessName"
                            ng-options="item.Value as item.Text for item in bProcessList" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="GetBPPopUp();" ng-disabled="brandNew.Id==null" class="btn"><i class="glyphicon glyphicon-plus-sign"></i></button></li>
                </ul>
            </div>

        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Business Process</th>
                <th>User Define Name</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in brands |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-click="Get(x.Id, $index);">
                <td>{{x.Id}}</td>
                <td>{{x.BusinessProcessName}}</td>
                <td>{{x.UserName}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>

<div class="modal fade site-modal in" id="BPPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Business Process: {{brandNew.UserName}}</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Column1</th>
                                    <th>Column2</th>
                                    <th>Column3</th>
                                    <th>Column4</th>
                                    <th>Column5</th>
                                    <th>Column6</th>
                                    <th>Column7</th>
                                    <th>Column8</th>
                                    <th>Column9</th>
                                    <th>Column10</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in extraBPList">
                                    <td><input type="text" name="Column1" ng-model="x.Column1" class="col-sm-2 form-control" /></td>
                                    <td><input type="text" name="Column2" ng-model="x.Column2" class="col-sm-2 form-control"></td>
                                    <td><input type="text" name="Column3" ng-model="x.Column3" class="col-sm-2 form-control"></td>
                                    <td><input type="text" name="Column4" ng-model="x.Column4" class="col-sm-2 form-control" /></td>
                                    <td><input type="text" name="Column5" ng-model="x.Column5" class="col-sm-2 form-control"></td>
                                    <td><input type="text" name="Column6" ng-model="x.Column6" class="col-sm-2 form-control"></td>
                                    <td><input type="text" name="Column7" ng-model="x.Column7" class="col-sm-2 form-control" /></td>
                                    <td><input type="text" name="Column8" ng-model="x.Column8" class="col-sm-2 form-control"></td>
                                    <td><input type="text" name="Column9" ng-model="x.Column9" class="col-sm-2 form-control"></td>
                                    <td><input type="text" name="Column10" ng-model="x.Column10" class="col-sm-2 form-control"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveBPS();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Save</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>