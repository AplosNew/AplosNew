                        </div>
                        <button name="submit" class="single-btn" ng-click="GetDownPaymentGlList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshDownPaymentGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="serviceGroupGL.DownPaymentBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in downPaymentBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getDownPaymentActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="serviceGroupGL.DownPaymentActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in downPaymentActivityList" id="ActivityId"
                                        name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Service</legend>
                    <div class="form-group">
                        <label class="col-sm-3 control-label"> GL</label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control col-sm-6" ng-model="ServiceGLInfo" readonly>
                        </div>
                        <button name="submit" class="single-btn" ng-click="GetServiceGlList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshServiceGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="serviceGroupGL.ServiceBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in serviceBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getServiceActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="serviceGroupGL.ServiceActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in serviceActivityList" id="ActivityId"
                                        name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Provisional Payable</legend>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL</label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control col-sm-6" ng-model="ClearingAccGLInfo" readonly>
                        </div>
                        <button name="submit" class="single-btn" data-toggle="modal" ng-click="GetClearingAccountGlList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshClearingAccountGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="serviceGroupGL.ClearingAccountBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in clearingAccountBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getClearingAccountActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="serviceGroupGL.ClearingAccountActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in clearingAccountActivityList" id="ActivityId"
                                        name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
