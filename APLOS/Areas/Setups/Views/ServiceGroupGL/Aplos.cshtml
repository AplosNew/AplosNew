            </div>
        </div>
        <div class="col-xs-12">
            <br /><br />
            <h5><b>Sales GL:</b> </h5>
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Party Account Group</th>
                            <th>Customer Recon GL</th>
                            <th>Budget</th>
