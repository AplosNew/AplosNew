                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Party Account Group</th>
                            <th>Customer Recon GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in accountGroupCustomerList" ng-dblclick="Get(x.Id, $index);">
