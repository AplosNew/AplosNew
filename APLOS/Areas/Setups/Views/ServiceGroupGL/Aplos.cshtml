<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Service Group GL
</h3>
<div class="form-elements form-horizontal" ng-form="serviceGroupGLNewForm">
    <div class="row">
        <div class="form-group  col-lg-6">
            <label class="col-sm-4 control-label">COA<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="serviceGroupGL.COAId"
                            ng-options="item.Value as item.Text for item in COAList" ng-change="clearGlField();getAllWithCoa();">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-xs-12">

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="getServiceGroupMasterWithCoa('assing');setActiveBtn('assing');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> All Assign</button></li>
                        <li>
                            <button ng-click="getServiceGroupMasterWithCoa('notassing');setActiveBtn('notassing');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> Not Assign</button>
                        </li>
                        <li>
                            <button ng-click="getServiceGroupMasterWithCoa('all');setGlLebelHide();setActiveBtn('all');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> All</button>
                        </li>
                        <li>
                            <button ng-click="getServiceGroupGlReport();" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-download"></i> Download</button>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
            </div>
        </div>
        <div class="table-responsive modal-table col-xs-12" ng-show="tableShow">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th style="vertical-align: middle; text-align:center" rowspan="2">Apply</th>
                        <th style="vertical-align: middle; text-align:center" rowspan="2">Service Group</th>
                        <th style="vertical-align: middle; text-align:center" rowspan="2">Service Type</th>
                        <th style="text-align:center" colspan="3">Down Payment GL</th>
                        <th style="text-align:center" colspan="3">Clearing Acc. GL</th>
                        <th style="text-align:center" colspan="3">Service GL</th>
                        <th style="text-align:center" colspan="3">Expense GL</th>
                        <th style=" text-align:center" colspan="3" ng-repeat=" y in accountGroupSalesList">
                            {{"Sales" + " " + y.UserName}}
                        </th>
                        <th style=" text-align:center" colspan="3" ng-repeat=" y in accountGroupCustomerList">
                            {{"Receivable" + " " + y.UserName}}
                        </th>
                        <th style=" text-align:center" colspan="3" ng-repeat=" y in accountGroupVendorList">
                            {{"Payable" + " " + y.UserName}}
                        </th>
                        <th style="vertical-align: middle; text-align:center" rowspan="2"> Untag</th>
                    </tr>
                    <tr>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th ng-repeat=" y in childHeaderSalesAcG track by $index">
                            {{y}}
                        </th>
                        <th ng-repeat=" y in childHeaderCustomerAcG track by $index">
                            {{y}}
                        </th>
                        <th ng-repeat=" y in childHeaderAcG track by $index">
                            {{y}}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr dir-paginate="x in selectServiceGroupMasterWithCombineList|itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'selectServiceGroupMasterWithCombineList'">
                        <td>
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" id="{{x.ServiceGroupId}}" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectChValueId($event,x.ServiceGroupMasterId,x)">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </td>
                        <td>{{x.ServiceGroupName}}</td>
                        <td>
                            {{x.ServiceTypeName}}
                        </td>
                        <td>
                            <span ng-show="btnActionAll">{{x.DownPaymentGLInfo}}</span>
                        </td>
                        <td>{{x.DownPaymentBudgetName}}</td>
                        <td>{{x.DownPaymentActivityName}}</td>
                        <td>
                            <span ng-show="btnActionAll">{{x.ClearingAccountGLInfo}}</span>
                        </td>
                        <td>{{x.ClearingAccountBudgetName}}</td>
                        <td>{{x.ClearingAccountActivityName}}</td>
                        <td>
                            <span ng-show="btnActionAll">{{x.ServiceGLInfo}}</span>
                        </td>
                        <td>{{x.ServiceBudgetName}}</td>
                        <td>{{x.ServiceActivityName}}</td>
                        <td>
                            <span ng-show="btnActionAll">{{x.ExpenseGLInfo}}</span>
                        </td>
                        <td>{{x.ExpenseBudgetName}}</td>
                        <td>{{x.ExpenseActivityName}}</td>
                        <td ng-repeat="z in NewListSales">
                            {{x[z]}}
                        </td>
                        <td ng-repeat="z in NewListCustomer">
                            {{x[z]}}
                        </td>
                        <td ng-repeat="z in NewListA">
                            {{x[z]}}
                        </td>
                        <td class="text-center">
                            <ul class="list-inline action-list">
                                <li><button ng-disabled="x.Id ===null" ng-click="valuePassInDelModal(x,$index,$event)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                            </ul>
                        </td>
                    </tr>
                </tbody>
            </table>
            <dir-pagination-controls max-size="10"
                                     pagination-id="metaData.name + 'selectServiceGroupMasterWithCombineList'"
                                     direction-links="true"
                                     boundary-links="true"
                                     on-page-change="getData(newPageNumber)">
            </dir-pagination-controls>
        </div>
        <div class="col-xs-12">
            <br /><br />
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Down Payment</legend>
                    <div class="form-group">
                        <label class="col-sm-3 control-label"> GL</label>
                        <div class="col-sm-6 pdr3">
