<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Entity Calendar
</h3>
<div ng-form id="entityCalendar" name="entityCalendarForm" class="form-elements form-horizontal">
    <input type="hidden" ng-model="entityCalendar.Id">
    <div class="row">
        <div class="col-sm-12 col-sm-6 col-md-6 form-element-ctrl form-horizontal">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company Name<sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <div class="select-style">
                        <select name="Company Name" ng-model="entityCalendar.CompanyId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in companyList" required tabindex="1" ng-change="getEntity(entityCalendar.CompanyId)"></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-sm-6 col-md-6 form-element-ctrl form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-4  control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Entity" ng-model="entityCalendar.EntityId" class="col-sm-3 form-control"
                                ng-options="item.Value as item.Text for item in entityList" ng-change="getEntityMapData(entityCalendar.EntityId);" required tabindex="2"></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 form-element-ctrl form-horizontal">

            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th ng-repeat="x in entities">{{x.Text}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="y in entityValue">
                            <td ng-repeat="x in entities">{{y[x.Value]}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="clearfix" style="padding-bottom:10px;"></div>
    <div class="row">
        <div class="col-sm-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Year<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="year" id="year" ng-model="entityCalendar.YearlyCalendarId" class="col-sm-3 form-control"
                                ng-change="getYearFTdate(entityCalendar.YearlyCalendarId)" ng-options="item.Value as item.Text for item in yearList" required tabindex="3"></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label ng-show="msg" class="col-sm-10 control-label">{{setMassge}}</label>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>

    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="FromDate" id="FromDate" ng-model="entityCalendar.FromDate" ng-click="setTodateHilight('#FromDate',entityCalendar.FromDate)" datepicker class="form-control datepicker" tabindex="4" required>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="entityCalendar.Remarks" tabindex="6" ng-trim="false"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="ToDate" id="ToDate" ng-model="entityCalendar.ToDate" tabindex="5" ng-click="setTodateHilight('#ToDate',entityCalendar.ToDate)" datepicker class="form-control datepicker" required>
                </div>
            </div>
        </div>
    </div>

    <div class="common-btn">
        <div class="row">
            <ul class="list-inline text-left col-sm-6">
                <li> <button ng-click="addNew();" class="btn">Add New</button></li>
                <li> <button ng-click="vewEdit();getOffdayData()" class="btn"><i class="glyphicon glyphicon-eye-open"></i> Vew</button></li>
            </ul>
            <ul class="list-inline text-right col-sm-6">
                <li> <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-remove"></i> Delete</button></li>*@
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="weekTblShow">
    <table class="table table-striped form-element-ctrl">
        <thead>
            <tr>
                <th>Apply</th>
                <th>Day Name</th>
                <th>Standard Working Hours</th>
                <th>In No Shift</th>
                <th>Standard OT Hours</th>
                <th>Extra OT Hours</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in EntityCalendarDetailLists">
                <td>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.Selected" ng-click="getOffDaySelectedList($event,x,$index)" ng-checked="x.Selected">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td>
                    <p class="col-sm-10">{{x.DayName}}</p>
                </td>
                @*<td>
                        <input type="radio" name="{{'DayLength'+x.DayName}}" ng-model="x.DayLengthType" value="Full Day"> Full Day
                        <input type="radio" name="{{'DayLength'+x.DayName}}" ng-model="x.DayLengthType" value="HalfDayFirstHalf"> Half Day-First Half
                        <input type="radio" name="{{'DayLength'+x.DayName}}" ng-model="x.DayLengthType" value="HalfDaySeconHalf"> Half Day-Second Half
                    </td>*@
                <td>

                    <input type="text" ng-model="x.WorkingTime" name="workingTime" class="form-control" />
                </td>
                @*<td style="width:150px">

                            <div class="select-style">
                                <select name="AccountType" ng-model="x.UomId" class="form-control"
                                        ng-options="item.Value as item.Text for item in uomList"></select>
                            </div>
                    </td>*@
                <td>

                    <input type="text" ng-model="x.InNoShift" name="InNoShift" class="form-control" only-Numbers />
                </td>
                <td>

                    <input type="text" ng-model="x.StandardOT" name="StandardOt" class="form-control" only-Numbers />
                </td>
                <td>

                    <input type="text" ng-model="x.ExtraOT" name="ExtraOt" class="form-control" n-Decimalss="2" only-Numbers />
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div ng-show="dayTblShow">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="getOffdayDataListParameters.searchBy">
                                <option ng-repeat="option in searchByOffDayMasterList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="getOffdayDataListParameters.search" ng-enter="getOffdayData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getOffdayData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Day Name</th>
                    <th>Standard Working Hours</th>
                    <th>In No Shift</th>
                    <th class="tooltip-here" title="Standard Operation Time">Standard OT Hours</th>
                    <th class="tooltip-here" title="Extra Operation Time">Extra OT Hours</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in EntityCalendarLists |itemsPerPage:getOffdayDataListParameters.pageSize" pagination-id="metaData.name + 'EntityCalendarLists'" total-items="getOffdayDataListParameters.total_count">
                    <td>{{x.OffDayDate | dateFiltering}}</td>
                    <td>{{x.DayName}}</td>
                    <td>{{x.WorkingTime}}</td>
                    <td>{{x.InNoShift}}</td>
                    <td>{{x.StandardOT}}</td>
                    <td>{{x.ExtraOT}}</td>
                    <td class="text-right table-td">
                        <ul class="list-inline action-list">
                            <li>
                                <button ng-click="getMaster($index,x)" class="btn-action tooltip-here" data-placement="top" title="Edit">
                                    <i class="glyphicon glyphicon-edit"></i>
                                </button>
                            </li>
                        </ul>
                    </td>
                    <td class="text-right table-td">
                        <ul class="list-inline action-list">
                            <li>
                                <button ng-click="valuePassInDelModal($index, x.CalendarDetailId)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10"
                                 pagination-id="metaData.name + 'EntityCalendarLists'"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="getOffdayData(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>
