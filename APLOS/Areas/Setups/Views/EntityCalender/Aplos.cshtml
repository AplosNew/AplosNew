                    </table>
                </div>

                <!--Master Bottom Buttons-->
                @*<div class="col-xs-12 col-sm-12 col-md-12" style="padding-right:20px;">*@
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="EditChildTable();" class="btn"><i class="glyphicon glyphicon-plus"></i> Update</button>
                        </li>
                    </ul>
                </div>
                @*</div>*@
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteItem()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>