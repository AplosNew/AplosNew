<togglable name="Retention Allowance"></togglable>
<div ng-form name="glMappingNewForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl form-horizontal">
            <div class="form-group">
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" id="plantId" ng-model="retentionAllowanceOb.PlantId" name="plant" ng-options="item.Value as item.Text for item in plantList" ng-change="getListData()">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl form-horizontal">

        </div>
    </div>
</div>
<div class="form-elements form-horizontal" ng-form name="glMappingNewForm">

    <div class="clearfix"></div>
    <input type="hidden" ng-model="retentionAllowanceOb.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Effective Date</label>
                <div class="col-sm-8">
                    <input type="text" ng-model="retentionAllowanceOb.EffectiveDate" datepicker class="form-control" placeholder="dd-MM-yyyy">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <div class="col-sm-1">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="retentionAllowanceOb.IsAbsentismApplicable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
                <label class="col-sm-11 control-label">Is Absenteeism Applicable</label>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Legal Salary Grade<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" id="legalSalaryGrade" ng-model="retentionAllowanceOb.LegalSalaryGradeId" name="Company" ng-options="item.Value as item.Text for item in legalSalaryGradeCboList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-2 col-sm-2 col-md-2 form-element-ctrl">
            <button name="Add" class="single-btn" ng-click="addRow();"><i class="glyphicon glyphicon-plus"></i></button>
        </div>
        <div class="col-xs-4 col-sm-4 col-sm-4">

        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Legal Salary Grade</th>
                            <th>ExperienceSpan</th>
                            <th>Amount</th>
                            <th>Remove</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in retentionAllowanceSelectedList">
                            <td>{{x.LegalSalaryGradeName}}</td>
                            <td>
                                <input maxlength="10" type="text" name="ExperienceSpan" ng-model="x.ExperienceSpan" class="form-control">
                            </td>
                            <td>
                                <input maxlength="10" type="text" name="ExperienceSpan" ng-model="x.Amount" class="form-control">
                            </td>
                            <td class="text-right">
                                <button ng-click="valuePassInDelModal($index,x)" class="btn-action tooltip-here"
                                        data-placement="top" title="Delete">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Effective Date</th>
                <th>Absenteeism</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in retentionAllowanceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                <td>{{x.EffectiveDate}}</td>
                <td>{{x.IsAbsentismApplicable}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>


