<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Entity Config
</h3>
<style>
    .filled {
        background-color: #ff0000 !important;
    }
</style>
<div ng-form name="entityConfigForm" class="form-horizontal">
    <div class="col-xs-12">
        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="Company" class="form-control" ng-model="entityConfig.CompanyId" name="Company" ng-change="getPlant();GetCurrency();" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in companyList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            
            
            

        </div>
        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="PlantId" class="form-control" ng-model="entityConfig.PlantId" name="Plant" ng-change="getEntityWithChange();" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            
            
            
           
        </div>
        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="entityConfig.EntityId" required id="entityId" name="Entity" tabindex="1" ng-change="getSaveList();loadProcessList(entityConfig.EntityId);">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
           
            
            
        </div>
    </div>

    <div class="clearfix"></div>

    <div class="form-elements">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Entity</legend>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">No. of WorkStation</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" only-numbers name="NoOfWorkStation" ng-model="entityConfig.NoOfWorkStation" class="form-control text-right" placeholder="0" tabindex="5" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Fixed Cost<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" n-decimals="4" ng-model="entityConfig.FixedCost" class="form-control text-right" placeholder="0.00">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Production Entity</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label class="control-label">
                                <input type="checkbox" ng-model="entityConfig.IsProductionEntity" ng-change="ChangeValues()">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">General Working Hr/Day</label>
                    <div class="col-sm-8">
                        <input type="text" n-decimals="2" name="GeneralWorkingHourPerDay" @*ng-disabled="entityConfig.IsProductionEntity==false"*@ ng-model="entityConfig.GeneralWorkingHourPerDay" class="form-control text-right" placeholder="0" tabindex="5">
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="col-sm-4 control-label">Variable Cost<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" n-decimals="4" ng-model="entityConfig.VariableCost" class="form-control text-right" placeholder="0.00">
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Machine</legend>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Machine Cost/Hour</label>
                    <div class="col-sm-4">
                        <input type="text" n-decimals="4" name="MachineCostPerHour" @*ng-disabled="entityConfig.IsProductionEntity==false"*@ ng-model="entityConfig.MachineCostPerHour" class="form-control text-right" placeholder="0" tabindex="5">
                    </div>
                    <div class="col-sm-4">
                        <div class="select-style">
                            <select name="Currency" class="form-control" @*ng-disabled="entityConfig.IsProductionEntity==false"*@ ng-model="entityConfig.CurrencyId" ng-options="item.Value as item.Text for item in currencyList" tabindex="16">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Min. Fixed Cost/Day</label>
                    <div class="col-sm-8">
                        <input type="text" n-decimals="4" name="MinFixedCost" @*ng-disabled="entityConfig.IsProductionEntity==false"*@ ng-model="entityConfig.MinFixedCost" class="form-control text-right" placeholder="0" tabindex="5">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group"style="margin-bottom: 30px;">
                    <label class="col-xs-12"></label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Max. Fixed Cost/Day</label>
                    <div class="col-sm-8">
                        <input type="text" n-decimals="4" name="MaxFixedCost" @*ng-disabled="entityConfig.IsProductionEntity==false"*@ ng-model="entityConfig.MaxFixedCost" class="form-control text-right" placeholder="0" tabindex="5">
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Consumption</legend>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Booking</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select id="ConsumptionBooking" class="form-control" ng-model="entityConfig.ConsumptionBooking" name="Consupmtion Booking" tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in ConsumtionBookingList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Process</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="entityConfig.ConsumptionProcessId" name="ConsumptionProcessId" ng-options="item.Value as item.Text for item in processList">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <div class="clearfix"></div>
        <div class="col-xs-12">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Applicable</th>
                            <th>Standard Name</th>
                            <th>User Define Name</th>
                            <th>Value</th>
                            <th>Changeable</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in eList">
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="x.Applicable" checked="{{x.Applicable}};">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>{{x.StandardName}}</td>
                            <td><input maxlength="50" type="text" name="Code" ng-model="x.UserName" class="form-control" tabindex="3"></td>
                            <td><input type="text" only-numbers name="Value" ng-model="x.Value" class="form-control text-right" tabindex="3"></td>
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="x.IsChangeable" checked="{{x.IsChangeable}};">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            </ul>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>

<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>
