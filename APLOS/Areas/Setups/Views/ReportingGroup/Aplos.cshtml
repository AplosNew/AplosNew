<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" id="MainDivId" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100" required />
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Description" tabindex="7" maxlength="250"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>

    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">Budget Code Tag</a></li>
            </ul>
        </div>
        <div class="tab-content" id="tabpaneldiv">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet11(11), active: isSet11(11) }">
                <div class="form-horizontal" ng-form id="TaxID" name="OTSlapForm">
                    <div class="row">
                        <!--<div class="col-xs-12 col-sm-6 col-md-4">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                                <div class="col-sm-8 show-message" style="padding-left: 20px;padding-right: 31px;">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="CompanyId" ng-change="companyOnChange();"
                                                ng-options="item.Value as item.Text for item in companyList" id="CompanyId"
                                                name="Company" required tabindex="1">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-4">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="PlantID"
                                                ng-options="item.Value as item.Text for item in plantList" id="plantId"--> @*ng-change="getData()*@
                                                <!--name="Plant" required tabindex="1">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>-->
                        <div class="col-xs-12 col-sm-6 col-md-4">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Budget Code<sup>*</sup></label>
                                <button ng-click="popUp('Budget');" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-plus"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <div id="Details" ej-grid e-datasource="DetailsList"  e-load="loadGridEdit" e-allowscrolling="true"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="Code" e-headertext="Manpower Code" e-width="5"></div>
                                <div e-column e-field="EntityName" e-headertext="Entity Name" e-width="5"></div>
                                <div e-column e-field="PositionName" e-headertext="Position Name" e-width="5"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-width="5"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="4"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="4"></div>
                                <div e-column e-field="SubSection" e-headertext="Subsection" e-width="4"></div>
                                <div e-column e-field="Line" e-headertext="Line" e-width="3"></div>
                                <div e-column e-field="UnitName" e-headertext="Unit" e-width="3"></div>
                                <div e-column e-headertext="DeleteThis" e-width="3">
                                    <button data-toggle="modal" class="btn" ng-click="$parent.RemoveDetail(this);" tabindex="10"><i class="glyphicon glyphicon-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>

    </div>
</div>

<confirm-modal></confirm-modal>

<modal-table modalid="popUpId"
             data-title={{popUpTitle}}
             data-search-parameters="popUpParameters"
             data-exclued-column-list="Code"
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click="selectSingleClick(data)"
             data-double-click="selectDoubleClick(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectByButton()"
             data-ng-click-cancel="closePopUp()">
</modal-table>


<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteChild();"></confirm-archive-generic>