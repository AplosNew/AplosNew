                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="testingStandardListParameters.searchBy">
                                            <option ng-repeat="option in searchByTestingStandardList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="testingStandardListParameters.search" ng-enter="GetTestingStandardListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetTestingStandardListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in testingStandards |itemsPerPage:testingStandardListParameters.pageSize" total-items="testingStandardListParameters.total_count" ng-dblclick="GetTestingStandardInfo(x);">
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="valuePassInTestingStandardSavedListDelModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="GetTestingStandardListData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="testingSelectdCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
