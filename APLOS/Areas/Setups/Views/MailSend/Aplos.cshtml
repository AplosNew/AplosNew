<div id="rotateStartModal" class="modal fade site-modal in" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title" id="myModalLabel">Shift Rotation</h4>
            </div>
            <div class="modal-body table-responsive modal-table" style="overflow-y:scroll; max-height:375px;">
                <div class="select-style" style="box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19); width:100%;">
                    Date: <input placeholder="Shift Rotation Date*" type="text" ng-model="compliedShiftRotationDate" datepicker required class="form-control datepicker" tabindex="1" style="margin-top: 7px;margin-bottom: -4px;">
                </div>
                <ul>
                    <li>
                        <button ng-click="CompliedshiftChange();" class="btn single-btn">Complied Shift Change</button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

