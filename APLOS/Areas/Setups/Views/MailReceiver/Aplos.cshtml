<togglable name="Mail Recipient"></togglable>
<div class="form-elements" ng-form id="emailReceive" name="emailReceiveForm">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="col-xs-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Name" ng-model="brandNew.Name" class="form-control" required tabindex="1">
                </div>
            </div>
        </div>
        <div class="col-xs-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="2" ng-model="brandNew.Remarks" tabindex="2" maxlength="250"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-4">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" class="css-checkbox" ng-model="brandNew.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li>
                    <button ng-click="popUp('toList','To');" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> To</button>
                </li>
                <li>
                    <button ng-click="addEmailPopUp('toList','To');" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i>Direct</button>
                </li>
            </ul>
        </div>

        <div class="clearfix"></div>
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>UserId</th>
                        <th>Employee Id</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Active</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in toList">
                        <td>
                            <ul class="list-inline action-list">
                                <li><button ng-click="delPop('toList',x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                            </ul>
                        </td>
                        <td>{{x.UserName}}</td>
                        <td>{{x.EmployeeId}}</td>
                        <td>{{x.FullName}}</td>
                        <td ng-class="{unsaveRow : x.Email==''||x.Email==undefined}">{{x.Email}}</td>
                        <td ng-class="{unsaveRow : x.Active===false}">{{x.Active?'Yes':'No'}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li>
                    <button ng-click="popUp('ccList','Cc');" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> Cc</button>
                </li>
                <li>
                    <button ng-click="addEmailPopUp('ccList','Cc');" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> Direct</button>
                </li>
            </ul>
        </div>
        <div class="clearfix"></div>
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>UserId</th>
                        <th>Employee Id</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Active</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in ccList">
                        <td>
                            <ul class="list-inline action-list">
                                <li><button ng-click="delPop('ccList',x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                            </ul>
                        </td>
                        <td>{{x.UserName}}</td>
                        <td>{{x.EmployeeId}}</td>
                        <td>{{x.FullName}}</td>
                        <td>{{x.Email}}</td>
                        <td ng-class="{unsaveRow : x.Active===false}">{{x.Active?'Yes':'No'}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li>
                    <button ng-click="popUp('bccList','Bcc');" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> Bcc</button>
                </li>
                <li>
                    <button ng-click="addEmailPopUp('bccList','Bcc');" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> Direct</button>
                </li>
            </ul>
        </div>
        <div class="clearfix"></div>
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>UserId</th>
                        <th>Employee Id</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Active</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in bccList">
                        <td>
                            <ul class="list-inline action-list">
                                <li><button ng-click="delPop('bccList',x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                            </ul>
                        </td>
                        <td>{{x.UserName}}</td>
                        <td>{{x.EmployeeId}}</td>
                        <td>{{x.FullName}}</td>
                        <td>{{x.Email}}</td>
                        <td ng-class="{unsaveRow : x.Active===false}">{{x.Active?'Yes':'No'}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-enter="getData()" ng-model="$root.parameters.search">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Remarks</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in brands |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Name}}</td>
                <td>{{x.Remarks}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<!-- #region User -->
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                User <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in searchByUserList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>UserId</th>
                                <th>Employee Id</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Auth Token</th>
                                <th>User Type</th>
                                <th>Auth Token Locked</th>
                                <th>User Locked</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
                                pagination-id="metaData.name + 'popUpDataList'" ng-class="{unsaveRow : x.Active===false||x.Email===''}">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-disabled="x.Active === false || x.Email === null" ng-model="x.Flag" ng-click="checkEmail(x,$event,$index);selectchValue($event,x);">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.UserId}}</td>
                                <td>{{x.EmployeeId}}</td>
                                <td>{{x.FullName}}</td>
                                <td>{{x.Email}}</td>
                                <td>{{x.AuthToken}}</td>
                                <td>{{x.UserType}}</td>
                                <td>{{x.AuthTokenLocked?'Locked':'UnLocked'}}</td>
                                <td>{{x.UserLocked?'Locked':'UnLocked'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'popUpDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getPopUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="selectByButton();" class="btn"><i class=""></i> Select</button></li>
                        <li> <button type="button" class="btn btn-default" ng-click="closePopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="popUpMail" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Add Email <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-elements">
                <div class="row" ng-form id="" name="PopUpEmail">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Full Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Name" ng-model="Directmail.FullName" tabindex="1" class="form-control" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Email<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="email" name="Email" ng-model="Directmail.Email" tabindex="2" class="form-control" required>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="addEmail();" class="btn" tabindex="3"><i class=""></i> Add</button></li>
                        <li> <button type="button" class="btn btn-default" ng-click="closePopUpAddMail();" tabindex="4">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmgenericPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="removeRow()"> </confirm-archive-generic>
<!-- #endregion -->