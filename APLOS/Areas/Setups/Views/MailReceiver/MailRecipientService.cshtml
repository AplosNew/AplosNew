
<togglable name="Mail Recipient Service"></togglable>
<div class="form-elements form-horizontal" ng-form id="emailReceiveService" name="emailReceiveServiceForm">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="col-xs-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Service Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" name="Service Name" ng-model="brandNew.ServiceName" ng-options="data.Value as data.Text for data in serviceList" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sender Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" maxlength="50" name="Sender Name" ng-model="brandNew.SenderName" class="form-control" required tabindex="3">
                </div>
            </div>
        </div>
        <div class="col-xs-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Recipient List<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" name="Reciver" required tabindex="2" ng-model="brandNew.MailReceiverId" ng-options="data.Value as data.Text for data in receiverList">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sender Email<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input maxlength="50" type="text" ng-model="brandNew.SenderEmail" name="Sender Email" class="form-control" required tabindex="4">
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="form-group" show-errors>
                <label class="col-sm-2 control-label">Subject<sup>*</sup></label>
                <div class="col-sm-10 show-message">
                    <input type="text" maxlength="50" name="Subject" ng-model="brandNew.Subject" class="form-control" required tabindex="5">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-2 control-label">Message Body<sup>*</sup></label>
                <div class="col-sm-10">
                    <textarea maxlength="5000" class="form-control" rows="3" ng-model="brandNew.MessageBody" required tabindex="6"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-2 control-label">Plant</label>
                <div class="col-sm-4">
                    <div class="select-style">
                        <select name="Plant" class="form-control" tabindex="7" ng-model="brandNew.PlantId" ng-options="data.Value as data.Text for data in plantList">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-2">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" class="css-checkbox" ng-model="brandNew.Active" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-6">
            <div class="form-group">
                <label class="col-sm-11 control-label">Send Email(Even If Attachment Not Created)</label>
                <div class="col-sm-1">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" class="css-checkbox" ng-model="brandNew.IsSendMailIfEmptyData" tabindex="9">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Delete();" data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-enter="getData()" ng-model="$root.parameters.search">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()"  class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Service Name</th>
                <th>Recipient Name</th>
                <th>Sender Name</th>
                <th>Sender Email</th>
                <th>Active</th>
                <th><div data-placement="bottom" title="Send Email(If Attachment Not Created)" tooltip>Email Sending Status</div></th>
                <th>Plant</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in mailReceiverMappingList|itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);" ng-class="{'selected':$index == selectedRow}" ng-click="setClickedRow($index)" style="cursor:pointer;" data-placement="top" title="Double click to Edit/Delete" tooltip>
                <td>{{x.ServiceName}}</td>
                <td>{{x.MailReceiverName}}</td>
                <td>{{x.SenderName}}</td>
                <td>{{x.SenderEmail}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
                <td>{{x.IsSendMailIfEmptyData?'Email Will Send':'Email Will Not Send'}}</td>
                <td>{{x.PlantName}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<!-- #region User -->
<confirm-archive-generic modalid="confirmgenericPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="removeRow()"> </confirm-archive-generic>
<!-- #endregion -->