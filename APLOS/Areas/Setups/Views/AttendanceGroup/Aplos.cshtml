<togglable name="Attendance Group"></togglable>
<div class="form-elements form-horizontal" ng-form id="attendanceGroup" name="attendanceGroupForm">
    <input type="hidden" ng-model="attendanceGroupNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Sequence" ng-model="attendanceGroupNew.Sequence" class="form-control" required tabindex="1">
            </div>
        </div>
        @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ShortName" ng-model="attendanceGroupNew.ShortName" class="form-control"  tabindex="3" maxlength="50">
            </div>
        </div>*@
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="StandardName" ng-model="attendanceGroupNew.StandardName" class="form-control" required tabindex="3" maxlength="50">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="attendanceGroupNew.UserName" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Budgeted ManPower<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" only-numbers name="Budgeted Man Power" ng-model="attendanceGroupNew.BudgetedManPower" class="form-control" required tabindex="8" maxlength="10">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="attendanceGroupNew.Code" class="form-control" maxlength="10" tabindex="2">
            </div>
        </div>*@
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Group-1<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Group1" ng-model="attendanceGroupNew.Group1" class="form-control" maxlength="15" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Group-2<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Group2" ng-model="attendanceGroupNew.Group2" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Group-3<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Group3" ng-model="attendanceGroupNew.Group3" class="form-control" required tabindex="6" maxlength="50">
            </div>
        </div> 

        @*<div class="form-group">
            <label class="col-sm-4 control-label">Group-3<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" name="Group3" ng-model="attendanceGroupNew.Group3" class="form-control" required tabindex="8" maxlength="50">
            </div>
        </div>*@


    </div>
    
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchEmployeeByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Standard Name</th>
                <th>User Define Name</th>
                <th>Group1</th>
                <th>Group2</th>
                <th>Group3</th>
                <th>BudgetedManPower</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in attendanceGroupList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Group1}}</td>
                <td>{{x.Group2}}</td>
                <td>{{x.Group3}}</td>
                <td>{{x.BudgetedManPower}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>