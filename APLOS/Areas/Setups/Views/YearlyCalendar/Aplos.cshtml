<togglable name="Yearly Calendar"></togglable>
<div ng-form name="yearlyCalendarForm">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-3 col-md-2 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-3 col-md-4 show-message">
                <div class="select-style">
                    <select name="AccountType" ng-model="yearlyCalendar.PlantId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in plantList" required ng-change="getData()"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements form-horizontal">
        <input type="hidden" ng-model="yearlyCalendar.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Year<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="YearNo" ng-model="yearlyCalendar.YearNo" class="form-control" required tabindex="1">
                    <span class="msg-error" ng-show="yearlyCalendarForm.YearNo.$error.number">
                        Not valid year!
                    </span>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="FromDate" id="fromdate" ng-model="yearlyCalendar.FromDate" datepicker class="form-control datepicker" required tabindex="19">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="ToDate" id="todate" ng-model="yearlyCalendar.ToDate" datepicker class="form-control datepicker" required tabindex="19">
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="12"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="yearlyCalenderParameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="yearlyCalenderParameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Year No</th>
                <th>From Date</th>
                <th>To Date</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in yearlyCalendars |itemsPerPage:yearlyCalenderParameters.pageSize" total-items="yearlyCalenderParameters.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Id}}</td>
                <td>{{x.YearNo}}</td>
                <td>{{x.FromDate | dateFiltering}}</td>
                <td>{{x.ToDate | dateFiltering}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>