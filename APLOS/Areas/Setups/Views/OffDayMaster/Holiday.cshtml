<togglable name="Holiday"></togglable>
<div class="form-horizontal" ng-form="holidayForm">
    <div class="col-xs-12 col-sm-4 col-md-4 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="holidayCalendar.CompanyId" ng-change="getPlant()"
                            ng-options="item.Value as item.Text for item in companyList" name="Company" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Plant" ng-model="holidayCalendar.PlantId" class="col-sm-3 form-control"
                            ng-change="getPlantList(holidayCalendar.PlantId)" ng-options="item.Value as item.Text for item in plantList" required></select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Year</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="year" id="year" ng-model="holidayCalendar.YearlyCalendarId" class="col-sm-3 form-control"
                            ng-change="getData();getYearFTdate(holidayCalendar.YearlyCalendarId)" ng-options="item.Value as item.Text for item in yearList" required></select>
                </div>
                @*<label ng-show="msg" class="col-sm-10 control-label">{{setMassge}}</label>*@
                <label ng-hide="getYearFTdateList.FromDate==null && getYearFTdateList.ToDate==null" class="col-sm-10 control-label">
                    {{getYearFTdateList.FromDate|dateFiltering}} To {{getYearFTdateList.ToDate|dateFiltering}}
                </label>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" id="FromDate" name="FromDate" ng-model="holidayCalendar.FromDate" datepicker class="form-control" ng-click="setTodateHilight('#FromDate',holidayCalendar.FromDate)" tabindex="1" required>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label"> Holiday Category</label>
                <div class="col-md-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="holidayCalendar.HolidayCategoryId"
                                ng-options="item.Value as item.Text for item in holidayCategoryLists">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="ToDate" id="ToDate" ng-model="holidayCalendar.ToDate" datepicker class="form-control" ng-click="setTodateHilight('#ToDate',holidayCalendar.ToDate)" tabindex="2" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label"> Holiday Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Holiday Name" id="HolidayName" ng-model="holidayCalendar.HolidayName" class="form-control" tabindex="2" required>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">IsMandatory</label>
                <div class="col-sm-8 checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="holidayCalendar.IsMandatory">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            

        </div>
        <div class="col-xs-12 col-sm-2 col-md-10">
            <div class="form-group">
                <label class="col-sm-2 control-label">Remarks</label>
                <div class="col-md-10">
                    <textarea class="form-control" rows="2" ng-model="holidayCalendar.Remarks" tabindex="6" ng-trim="false"></textarea>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <div class="row">
                <ul class="list-inline text-left col-sm-6">
                    <li> <button ng-click="getHolidayOffdayData()" class="btn"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>
                </ul>
                <ul class="list-inline text-right col-sm-6">
                    <li> <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="form-elements" ng-show="OffDayMasterLists.length>0">
        <div class="row text-right">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="search-form">
                    <div class="row">
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="select-style">
                                <select ng-model="getHolidayOffdayDataListParameters.searchBy">
                                    <option ng-repeat="option in searchHolidayByOffDayMasterList" value="{{option.value}}">{{option.name}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-7 col-md-7">
                            <input type="text" class="form-control" placeholder="Search" ng-model="getHolidayOffdayDataListParameters.search" ng-enter="getHolidayOffdayData()">
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2">
                            <button type="button" ng-click="getHolidayOffdayData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Day Name</th>
                    </tr>
                </thead>
                <tbody>
                    <tr dir-paginate="x in OffDayMasterLists |itemsPerPage:getHolidayOffdayDataListParameters.pageSize" pagination-id="metaData.name + 'OffDayMasterLists'" total-items="getHolidayOffdayDataListParameters.total_count" ng-click="Get(x.Id, $index);">
                        <td>{{x.OffDayDate | dateFiltering}}</td>
                        <td>{{x.DayName}}</td>
                    </tr>
                </tbody>
            </table>
            <dir-pagination-controls max-size="10"
                                     pagination-id="metaData.name + 'OffDayMasterLists'"
                                     direction-links="true"
                                     boundary-links="true"
                                     on-page-change="getHolidayOffdayData(newPageNumber)">
            </dir-pagination-controls>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="holidayMainListParameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="holidayMainListParameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>From Date</th>
                <th>To Date</th>
                <th>Holiday Category</th>
                <th>Holiday Name</th>
                <th>Days</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in holidayCalendarLists |itemsPerPage:holidayMainListParameters.pageSize" total-items="holidayMainListParameters.total_count"
                pagination-id="metaData.name + 'holidayCalendarLists'" ng-dblclick="GetMaster(x.Id, $index);">
                <td>{{x.FromDate | dateFiltering}}</td>
                <td>{{x.ToDate | dateFiltering}}</td>
                <td>{{x.HolidayCategoryName}}</td>
                <td>{{x.HolidayName}}</td>
                <td>{{x.TotalDay}}</td>
            </tr>
            <tr ng-show="holidayCalendarLists.length>0">
                <td colspan="3"><b>Total Days</b></td>
                <td><b>{{TotalHolidayDay}}</b></td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             pagination-id="metaData.name + 'holidayCalendarLists'"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteItem()"></confirm-archive-generic>
<confirm-modal></confirm-modal>