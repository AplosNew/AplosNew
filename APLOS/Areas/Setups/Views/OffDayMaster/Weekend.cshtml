<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Weekend
</h3>
<div ng-form id="offDayMaster" name="weekendForm" class="form-elements form-horizontal">
    <input type="hidden" ng-model="offDayMaster.Id">
    <div class="row">
        <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="offDayMaster.CompanyId"
                                ng-change="getPlant();" ng-options="item.Value as item.Text for item in companyList">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Plant" ng-model="offDayMaster.PlantId" class="col-sm-3 form-control"
                                ng-change="getData();getPlantList(offDayMaster.PlantId)" ng-options="item.Value as item.Text for item in plantList" required></select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Year</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="year" id="year" ng-model="offDayMaster.YearlyCalendarId" class="col-sm-3 form-control"
                                ng-change="getYearFTdate(offDayMaster.YearlyCalendarId)" ng-options="item.Value as item.Text for item in yearList" required></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label ng-show="msg" class="col-sm-10 control-label">{{setMassge}}</label>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="FromDate" id="FromDate" ng-model="offDayMaster.FromDate" ng-click="setTodateHilight('#FromDate',offDayMaster.FromDate)" datepicker class="form-control datepicker" tabindex="1" required>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="offDayMaster.Remarks" tabindex="6" ng-trim="false"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="ToDate" id="ToDate" ng-model="offDayMaster.ToDate" tabindex="2" ng-click="setTodateHilight('#ToDate',offDayMaster.ToDate)" datepicker class="form-control datepicker" required>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <div class="row">
            <ul class="list-inline text-left col-sm-6">
                <li><button ng-click="addNew();" class="btn">Add New</button></li>
                <li><button ng-click="vewEdit();getOffdayData()" class="btn"><i class="glyphicon glyphicon-eye-open"></i> Vew</button></li>
            </ul>
            <ul class="list-inline text-right col-sm-6">
                <li> <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="weekTblShow">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Apply</th>
                <th>Day Name</th>
                <th>Day Length Type</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in OffDayMasterDetailLists">
                <td>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.Selected" ng-checked="x.Selected">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td>
                    {{x.DayName}}
                </td>
                <td>
                    <input type="radio" name="{{'DayLength'+x.DayName}}" ng-model="x.DayLengthType" value="Full Day"> Full Day
                    <input type="radio" name="{{'DayLength'+x.DayName}}" ng-model="x.DayLengthType" value="HalfDayFirstHalf"> Half Day-First Half
                    <input type="radio" name="{{'DayLength'+x.DayName}}" ng-model="x.DayLengthType" value="HalfDaySeconHalf"> Half Day-Second Half
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div ng-show="dayTblShow">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="getOffdayDataListParameters.searchBy">
                                <option ng-repeat="option in searchByOffDayMasterList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="getOffdayDataListParameters.search" ng-enter="getOffdayData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getOffdayData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Apply</th>
                    <th>Date</th>
                    <th>Day Name</th>
                    <th>Off Day Type</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in OffDayMasterLists |itemsPerPage:getOffdayDataListParameters.pageSize" pagination-id="metaData.name + 'OffDayMasterLists'" total-items="getOffdayDataListParameters.total_count">
                    <td class="text-right table-td">
                        <ul class="list-inline action-list">
                            <li>
                                <button ng-click="valuePassInDelModal($index, x.OffDayId)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </li>
                        </ul>
                    </td>
                    <td>{{x.OffDayDate | dateFiltering}}</td>
                    <td>{{x.DayName}}</td>
                    <td>{{x.DayLengthType}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10"
                                 pagination-id="metaData.name + 'OffDayMasterLists'"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="getOffdayData(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteItem()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>