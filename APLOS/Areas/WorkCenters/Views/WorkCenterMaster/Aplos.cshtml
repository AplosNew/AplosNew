
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Work Center Master</h3>
<div class="form-elements form-horizontal" ng-form id="WorkCenterMaster" name="MasterForm">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 ">
                <div class="select-style">
                    <select name="Plant" class="form-control" ng-model="master.PlantId" ng-change="getPlantConfigByPlant(master.PlantId);"
                            ng-options="item.Value as item.Text for item in plantList" tabindex="0">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="EntityId" ng-model="master.EntityId" ng-change="getMasterList();" class="form-control"
                            ng-options="item.Id as item.UserName for item in entityList" tabindex="2" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <!--Master Buttons-->
    <div class="common-btn" ng-show="showMasterList();">
        <ul class="list-inline text-left">
            <li>
                <button ng-click="masterAddEditPopup('NEW');" class="btn"> Add Line Item (Work Center)</button>
            </li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="searchbyMasterlist.length>0;">
