    <div style="color:black;" id="Grid" ej-grid e-datasource="masterList" e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
        <div e-columns>
            <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="30"></div>
            <div e-column e-type="string" e-field="Id" e-headertext="Id" e-visible="false" e-width="50"></div>
            <div e-column e-type="string" e-field="Sequence" e-headertext="Sequence" e-width="30"></div>
            <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
            <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="60"></div>
            <div e-column e-type="string" e-field="LineName" e-headertext="Line Name" e-width="60"></div>
            <div e-column e-type="string" e-field="Capacity" e-headertext="Capacity" e-width="30"></div>
            <div e-column e-type="string" e-field="WorkCenterCategory" e-headertext="Work Center Category" e-width="80"></div>
            <div e-column e-type="string" e-field="WorkCenterSubcategory" e-headertext="Work Center Subcategory" e-width="80"></div>
            <div e-column e-type="string" e-field="Process" e-headertext="Process" e-width="80"></div>
            <div e-column e-headertext="Detail" e-template="#ShowActionButtonsD" e-width="20"></div>

        </div>

    </div>
    <script type="text/template" id="ShowActionButtons">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="$parent.getMasterData(this)" class="btn-action tooltip-here" data-placement="top" title="Edit" tooltip><i class="glyphicon glyphicon-edit"></i></button></li>
                <li><button ng-click="$parent.deleteMasterPopup(this)" class="btn-action tooltip-here" data-placement="top" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i></button></li>
            </ul>
        </div>
    </script>
    <script type="text/template" id="ShowActionButtonsD">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="$parent.details(this)" class="btn-action tooltip-here" data-placement="top" title="Details" tooltip><i class="glyphicon glyphicon-list"></i></button></li>
            </ul>
        </div>
    </script>

</div>
<!-- #region Master Entry -->
<div class="form-elements form-horizontal" ng-form id="master" name="masterForm1" ng-submit="SaveMaster()">
