<togglable name="Work Station Daily"></togglable>
<div class="form-horizontal" ng-form="workStationDailyNewForm">
    <div class="form-element-ctrl">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="EntityId" class="form-control" name="Entity" ng-model="workStationDailyNew.EntityId" ng-change="getCboWorkCenterMaster();" required tabindex="1">
                            <option value=""></option>
                            <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Work Center<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="WorkCenterId" class="form-control" name="Work Center" ng-model="workStationDailyNew.WorkCenterId" ng-change="getData();getWorkStation()" required tabindex="3">
                            <option value=""></option>
                            <option ng-repeat="option in workCenterList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Entry Date" ng-model="workStationDailyNew.EntryDate"
                           datepicker class="form-control" tabindex="2" required>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <input type="hidden" ng-model="workStationDailyNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Work Station<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" only-numbers maxlength="50" name="Work Station" ng-model="workStationDailyNew.WorkStation" class="form-control text-right" tabindex="4" required>
                </div>
            </div>
            <div class="form-group show-message" show-errors>
                <label class="col-sm-4 control-label">Operation<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="Operation" ng-model="workStationDailyNew.UserName" class="form-control" readonly required>
                        <span class="input-group-btn">
                            <button ng-click="getOperationData();" class="btn single-small-btn" tabindex="7"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearOperationCode();" class="btn single-small-btn" tabindex="8"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group show-message" show-errors>
                <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="Employee" ng-model="workStationDailyNew.EmployeeName" class="form-control" readonly required>
                        <span class="input-group-btn">
                            <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                            @*<button ng-click="clearEmployeeCode();" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>*@
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group show-message">
                <label class="col-sm-4 control-label">Machine</label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" ng-model="workStationDailyNew.ArticleName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="materialPopUp($index);" class="btn single-small-btn" tabindex="9"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearMachineMaster();" class="btn single-small-btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Work Station</th>
                <th>Operation</th>
                <th>Employee</th>
                <th>Machine Master</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in workStationDailies |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index)">
                <td>{{x.WorkStation}}</td>
                <td>{{x.Operation}}</td>
                <td>{{x.EmployeeName}}</td>
                <td>{{x.ArticleName}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>

<!-- #region Employee -->
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">{{popUpTitle}}<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in employeeFilterList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Designation</th>
                                <th>Entity</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-click="selectEmployeePopUp($index, x.SystemId)" ng-class="{selected : x.SystemId == selectedEmployee}" ng-dblclick="closeEmployeePopUp();" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOB | dateFiltering}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.EmploymentType}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'employeeList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->

<div class="modal fade site-modal in" id="operationmodal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Operation
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="operationParameters.searchBy">
                                            <option ng-repeat="option in searchbyoperationTypelist" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="operationParameters.search" ng-enter="loadOperationData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadOperationData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Short Name</th>
                                <th>User Name</th>
                                <th>Standard Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in operationData  |itemsPerPage:operationParameters.pageSize" total-items="operationParameters.total_count"
                                ng-dblclick="getoperationCode(x);" pagination-id="metaData.name + 'operationData'">
                                <td>{{x.Id}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.StandardName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'operationData'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadOperationData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- #region Material -->
<div class="modal fade site-modal in" id="materialId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeMaterial()">&times;</button>
                <h4 class="modal-title">Machine Master</h4>
            </div>
            <div class="modal-body">
                <div class="">
                    <div class="row text-right">
                        <div class="col-xs-12 col-sm-12 col-sm-12">
                            <div class="search-form">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-3 col-md-3">
                                        <div class="select-style">
                                            <select ng-model="materialParameters.searchBy">
                                                <option ng-repeat="option in materialList" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-7 col-md-7">
                                        <input type="text" class="form-control" placeholder="Search" ng-model="materialParameters.search" ng-enter="getMaterialData()">
                                    </div>
                                    <div class="col-xs-12 col-sm-2 col-md-2">
                                        <button type="button" ng-click="getMaterialData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Material Group</th>
                                    <th>Code</th>
                                    <th>Short Name</th>
                                    <th>Standard Name</th>
                                    <th>Material Master</th>
                                    <th>Asset Master</th>
                                    <th>Budget</th>
                                    <th>Machine</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="x in materialDataList|itemsPerPage:materialParameters.pageSize"
                                    total-items="materialParameters.total_count" pagination-id="metaData.name + 'materialDataList'">
                                    <td>{{x.MaterialGroupMaster}}</td>
                                    <td>{{x.Code}}</td>
                                    <td>{{x.ShortName}}</td>
                                    <td>{{x.StandardName}}</td>
                                    <td>{{x.MaterialMasterName}}</td>
                                    <td>{{x.AssetMaster}}</td>
                                    <td>{{x.BudgetName}}</td>
                                    <td>
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="articlePopUp(x.MaterialMasterId, $index);" class="btn btn-action"><i class="glyphicon glyphicon-list"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <dir-pagination-controls max-size="10"
                                                 pagination-id="metaData.name + 'materialDataList'"
                                                 direction-links="true"
                                                 boundary-links="true"
                                                 on-page-change="getMaterialData(newPageNumber)">
                        </dir-pagination-controls>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="closeMaterial()" class="btn">Close</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
<!-- #region Article -->
<modal-table modalid="articleId"
             data-title="Article"
             data-search-parameters="articleParameters"
             data-exclued-column-list="excluedList"
             data-field-list="articleList"
             data-data-list="articleDataList"
             data-search-function="getarticleData"
             data-single-click=""
             data-double-click="selectArticle(data)"
             data-left-button="false"
             data-right-button="true"
             data-ng-click-left-button=""
             data-ng-click-cancel="closeArticle()">
</modal-table>
<!-- #endregion -->

<confirm-archive-generic data-modalid="confirmDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete()"></confirm-archive-generic>