<h3 class="site-heading" style="cursor:default"><span class="glyphicon glyphicon-info-sign"></span> User Entity</h3>
<div class="form-horizontal form-elements" ng-form="form">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 15px;">
                <span class="input-group-addon">{{model.UserName}}</span>
                <input type="text" name="User" ng-model="model.FullName" class="form-control" required readonly>
                <span class="input-group-btn">
                    <button class="btn single-small-btn" ng-click="popUp()" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="model.PlantId" ng-options="item.Value as item.Text for item in plantList"
                            name="Company Name" ng-change="getData();" tabindex="2" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="model.CompanyId" ng-options="item.Value as item.Text for item in complanyList"
                            name="Company Name" ng-change="getPlantByCompany();" tabindex="2" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn" ng-show="entityList.length>0">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="3"></i> Save</button></li>
        </ul>
    </div>
</div>
<div class="clearfix"></div>
<div class="table-responsive modal-table" ng-show="entityList.length>0">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Apply</th>
                <th>Entity</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in entityList">
                <td>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td>{{x.Code}} - {{x.EntityName}}</td>
            </tr>
        </tbody>
    </table>
</div>
<!-- #region User -->
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                User <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in searchByUserList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Employee Id</th>
                                <th>Full Name</th>
                                <th>Auth Token</th>
                                <th>User Type</th>
                                <th>Auth Token Locked</th>
                                <th>User Locked</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
                                ng-click="selectSingleClick(x)" ng-class="{selected : x.UserId === rowSelected}" ng-dblclick="selectDoubleClick(x);" pagination-id="metaData.name + 'popUpList'">
                                <td>{{x.UserId}}</td>
                                <td>{{x.EmployeeId}}</td>
                                <td>{{x.FullName}}</td>
                                <td>{{x.AuthToken}}</td>
                                <td>{{x.UserType}}</td>
                                <td>{{x.AuthTokenLocked?'Locked':'UnLocked'}}</td>
                                <td>{{x.UserLocked?'Locked':'UnLocked'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'popUpList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getPopUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="selectByButton();" class="btn"><i class=""></i> Select</button></li>
                        <li> <button type="button" class="btn btn-default" ng-click="closePopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->