<!-- #region CSS -->
<style>
    .tbtrheader {
        font-size: 11px;
    }
</style>
<!-- #endregion -->
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Mobile Apps Authorization</h3>
<div class="form-elements form-horizontal" ng-form name="form">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="empMobileAuthSearchParameters.PlantId" name="Plant" ng-change="plantChange();"
                            ng-options="item.Value as item.Text for item in plantList" required tabindex="1">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 col-md-4 control-label">Unit</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select ng-model="empMobileAuthSearchParameters.UnitId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in unitList" tabindex="2">
                        <option value="">ALL</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 col-md-4 control-label">Department</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select ng-model="empMobileAuthSearchParameters.DepartmentId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in departmentList" tabindex="4">
                        <option value="">ALL</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 col-md-4 control-label">SubSection</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select ng-model="empMobileAuthSearchParameters.SubSectionId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in subSectionList" tabindex="6">
                        <option value="">ALL</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 col-md-4 control-label">Designation</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select ng-model="empMobileAuthSearchParameters.DesignationId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in designationList" tabindex="8">
                        <option value="">ALL</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 col-md-4 control-label">Division</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select ng-model="empMobileAuthSearchParameters.DivisionId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in divisionIdList" tabindex="3">
                        <option value="">ALL</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 col-md-4 control-label">Section</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select ng-model="empMobileAuthSearchParameters.SectionId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in sectionList" tabindex="5">
                        <option value="">ALL</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 col-md-4 control-label">Designation Group</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select ng-model="empMobileAuthSearchParameters.DesignationGroupId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in designationGroupList" tabindex="7">
                        <option value="">ALL</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group">
            <label class="col-sm-2 col-md-2 control-label">Employee</label>
            <div class="col-sm-6 pdr3">
                <textarea class="form-control" rows="3" ng-model="empIdList" disabled=""></textarea>
            </div>
            <div class="col-sm-1 pdl3">
                <button ng-click="ShowEmployeeListPopUp()" class="btn single-btn"><i class="glyphicon glyphicon-search"></i> Employee</button>
            </div>
            <div class="col-sm-1 pdl3">
                <button ng-click="ClearList()" class="btn single-btn" style="margin-left:5px"><i class="glyphicon glyphicon-refresh"></i> Clear</button>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="getData();" class="btn"><i class="glyphicons glyphicons-user"></i> List Existing Employee</button></li>
            <li><button ng-click="getData('new');" class="btn"><i class="glyphicons glyphicons-user-add"></i> List New Employee</button></li>
            <li><button ng-click="Save();" ng-disabled="saveDisabled" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table form-elements form-horizontal" ng-show="empMobileAuths.length>0">
    <table class="table table-striped">
        <thead>
            <tr class="tbtrheader">
                <th>Remove</th>
                <th>Employee Id</th>
                <th>Employee Code</th>
                <th>Employee Name</th>
                <th>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-click="CheckAll($event)" name="IsSalaryStructure" ng-model="IsSalaryStructure">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            Salary Structure
                        </label>
                    </div>
                </th>
                <th>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-click="CheckAll($event)" name="IsPaySlip" ng-model="IsPaySlip">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Pay Slip
                        </label>
                    </div>
                </th>
                <th>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-click="CheckAll($event)" name="IsMonthlyAttendance" ng-model="IsMonthlyAttendance">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span> Monthly Attendance
                        </label>
                    </div>
                </th>
                <th>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-click="CheckAll($event)" name="IsDailyAttendanceNotification" ng-model="IsDailyAttendanceNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            Daily Attendance Notification
                        </label>
                    </div>
                </th>
                <th>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-click="CheckAll($event)" name="IsSalaryProcessConfirmationNotification" ng-model="IsSalaryProcessConfirmationNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            Salary Process Confirmation Notification
                        </label>
                    </div>
                </th>
                <th>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-click="CheckAll($event)" name="IsSalaryDisbursementNotification" ng-model="IsSalaryDisbursementNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            Salary Disbursement Notification
                        </label>
                    </div>
                </th>
                <th>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-click="CheckAll($event)" name="IsIncrementNotification" ng-model="IsIncrementNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            Increment Notification
                        </label>
                    </div>
                </th>
                <th>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-click="CheckAll($event)" name="IsPromotionNotification" ng-model="IsPromotionNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            Promotion Notification
                        </label>
                    </div>
                </th>
                <th>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-click="CheckAll($event)" name="IsLeaveNotification" ng-model="IsLeaveNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            Leave Notification
                        </label>
                    </div>
                </th>
                <th>PIN</th>
                <th>Designation</th>
                <th>Department</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in empMobileAuths|itemsPerPage:10" pagination-id="metaData.name + 'empMobileAuths'">
                <td>
                    <ul class="list-inline action-list">
                        <li><button ng-click="rowRemoveModal(x.Id, $index);" class="btn-action tooltip-here" data-placement="top" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i></button></li>
                    </ul>
                </td>
                <td>{{x.EmployeeId}}</td>
                <td>{{x.EmployeeCode}}</td>
                <td>{{x.EmployeeName}}</td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.IsSalaryStructure" ng-click="UnCheck($event)" name="IsSalaryStructure">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.IsPaySlip" ng-click="UnCheck($event)" name="IsPaySlip">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.IsMonthlyAttendance" ng-click="UnCheck($event)" name="IsMonthlyAttendance">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.IsDailyAttendanceNotification" ng-click="UnCheck($event)" name="IsDailyAttendanceNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.IsSalaryProcessConfirmationNotification" ng-click="UnCheck($event)" name="IsSalaryProcessConfirmationNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.IsSalaryDisbursementNotification" ng-click="UnCheck($event)" name="IsSalaryDisbursementNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.IsIncrementNotification" ng-click="UnCheck($event)" name="IsIncrementNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.IsPromotionNotification" ng-click="UnCheck($event)" name="IsPromotionNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.IsLeaveNotification" ng-click="UnCheck($event)" name="IsLeaveNotification">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td>
                    <div class="input-group" style="width: 90px;margin-top: -6px;">
                        <input type="text" ng-model="x.PIN" class="form-control" only-numbers>
                        <span class="input-group-btn">
                            <button ng-click="setNewPin($index)" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </td>
                <td>{{x.DesignationName}}</td>
                <td>{{x.DepartmentName}}</td>
            </tr>
        </tbody>
    </table>
</div>
<dir-pagination-controls max-size="10"
                         pagination-id="metaData.name + 'empMobileAuths'"
                         direction-links="true"
                         boundary-links="true">
</dir-pagination-controls>
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Employee<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="$root.parameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'employeeList'">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="pushTempList(x.EmployeeCode,$event,employeeList);">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DateOfBirth}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'employeeList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEmployeeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SelectEmployeeByButton();" class="btn"><i></i> Select</button></li>
                        <li> <button type="button" class="btn btn-default" ng-click="CloseEmployeePopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmDelPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>