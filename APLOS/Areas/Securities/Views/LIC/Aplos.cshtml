<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        /*background-color: #1c1f32;*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>

<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{title}}</h3>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
       
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="Form Date" ng-model="ModelNew.LicKey1" datepicker required class="form-control" tabindex="3">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">TO Date<sup>*</sup></label>
            <div class="col-sm-9  show-message">
                <input type="text" name="To Date" ng-model="ModelNew.LicKey2" datepicker required class="form-control" tabindex="3">
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
        </ul>
    </div>
</div>

