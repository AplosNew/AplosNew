<h3 class="site-heading" style="cursor:default"><span class="glyphicon glyphicon-info-sign"></span> User Access</h3>
<div class="form-horizontal form-elements" ng-form name="userRoleDetailForm">
    <input type="hidden" ng-model="userRoleDetail.Id" >
    <fieldset style="border:1px solid">
        <div class="col-xs-12 col-sm-6 col-md-6" style="margin-top: 8px;">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Username<sup>*</sup></label>
                <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 15px;">
                    <span class="input-group-addon">{{userRoleDetail.UserName}}</span>
                    <input type="text" name="User" ng-model="userRoleDetail.FullName" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" class="btn single-small-btn" ng-click="popUp()" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6" style="margin-top: 8px;">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" required ng-model="userRoleDetail.CompanyId" ng-change="getData();" ng-options="item.Value as item.Text for item in companyList" ng-disabled="userRoleDetail.UserName==null" id="companyId" name="Company Name" tabindex="2"></select>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
    <div class="col-xs-12 col-sm-6 col-md-6" style="padding-top: 11px;">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Module<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Module" ng-model="userRoleDetail.ModuleId" ng-change="menuFarmeGet()" id="moduleId" required ng-options="item.Value as item.Text for item in moduleList" tabindex="3" ng-disabled="inactive"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6" style="padding-top: 11px;">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Menu Frame<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Menu Frame" ng-model="userRoleDetail.MenuFrameId" id="menuFrameId" required ng-options="item.Value as item.Text for item in menuFrameList" tabindex="4" ng-disabled="inactive"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Add();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add</button></li>
            <li><button ng-click="ClearFields();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="clearfix"></div>
<div class="table table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Module</th>
                <th>Menu Frame</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in roleDetails">
                <td>{{x.ModuleName}}</td>
                <td>{{x.MenuFrameName}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li><a href="{{bootPoint}}additional-role-action" ng-click="send(x)" class="btn btn-action tooltip-here" data-placement="top" title="Additional Role Details" tooltip>Details</a></li>
                        <li><button ng-click="Get(x.Id, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i></button></li>
                        <li><button ng-click="valuePassInDelModal(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                User <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in searchByUserList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Employee Id</th>
                                <th>Full Name</th>
                                <th>Auth Token</th>
                                <th>User Type</th>
                                <th>Auth Token Locked</th>
                                <th>User Locked</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
                                ng-click="selectSingleClick(x);getData(x);" ng-class="{selected : x.UserId === rowSelected}" ng-dblclick="selectDoubleClick(x);" pagination-id="metaData.name + 'popUpList'">
                                <td>{{x.UserId}}</td>
                                <td>{{x.EmployeeId}}</td>
                                <td>{{x.FullName}}</td>
                                <td>{{x.AuthToken}}</td>
                                <td>{{x.UserType}}</td>
                                <td>{{x.AuthTokenLocked?'Locked':'UnLocked'}}</td>
                                <td>{{x.UserLocked?'Locked':'UnLocked'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'popUpList'" direction-links="true" boundary-links="true" on-page-change="getPopUpData(newPageNumber)"></dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="selectByButton();" class="btn"><i class=""></i> Select</button></li>
                        <li> <button type="button" class="btn btn-default" ng-click="closePopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmgenericPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>