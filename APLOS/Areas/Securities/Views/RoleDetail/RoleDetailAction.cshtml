<!-- #region css -->
<style type="text/css">
    label .lblcheckbox {
        position: relative;
        cursor: pointer;
        color: white;
    }

    label [type="checkbox"] {
        display: none;
        /*use your custom sprites instead as background on the span;*/
    }

    [type="checkbox"] + span {
        display: inline-block;
        text-align: center;
        color: white;
        padding-top: .4em;
        padding-right: .5em;
        padding-bottom: .5em;
        padding-left: .5em;
        background: #f00;
        height: 28px;
    }

    :checked + span {
        background: #a6edb2;
    }

    [type="checkbox"][disabled] + span {
        background: #f00;
    }
</style>

<!-- #endregion -->
