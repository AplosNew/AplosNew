<h3 class="site-heading" style="cursor:default"><span class="glyphicon glyphicon-info-sign"></span> User Access App Role</h3>
<div class="form-horizontal  form-elements" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <fieldset style="border:0px solid">
        <div class="col-xs-12 col-sm-6 col-md-6" style="margin-top: 8px;">

            <div class="form-group">

                <label class="col-sm-4 control-label">Username<sup>*</sup></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 15px;">
                    <span class="input-group-addon">{{ModelNew.EmployeeId}}</span>
                    <input type="text" name="User" ng-model="ModelNew.User" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" class="btn single-small-btn" ng-click="OpenContractorPopUp()" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6" style="margin-top: 8px;">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Role<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" name="Role" ng-model="ModelNew.RoleId" id="roleId"
                                required tabindex="1">
                            <option value=""></option>
                            <option ng-repeat="option in roleList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
    <div class="col-xs-12 col-sm-6 col-md-6" style="padding-top: 11px;">
        @*<div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Role<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" name="Role" ng-model="userRole.RoleId" id="roleId"
                                required tabindex="1">
                            <option value=""></option>
                            <option ng-repeat="option in roleList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>*@
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6" style="padding-top: 11px;">
        @*<div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" class="css-checkbox" ng-model="userRole.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>*@
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="ClearFields();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="table-responsive" style="margin-top: 10px; width:30% ">
    <div id="GridEdit" ej-grid e-datasource="AccessedIcon" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="100" e-isprimarykey="true" e-visible="true"></div>
            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="100"></div>
            <div e-column e-field="IconName" e-headertext="Icon Name" e-width="100"></div>
            <div e-column e-headertext="Actions" e-width="100">
                <button style="color: #f3f3ec;background-color: #1c1f32;padding: 3px 7px 3px 6px;" class="btn">
                    <i class="glyphicon glyphicon-trash" title="Delete" data-target="#confirmPopUp" ng-click="$parent.Remove();"></i>
                </button>
              @* <button ng-click="RemoveLevel1s();" data-target="#confirmPopUp" ng-disabled="CheckIdUseLevel2s" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash"></i> Delete</button>*@

            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmDetailPopUp" title="Confirmation" message={{message_Detailconfirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
@Html.Partial("~/Areas/Securities/Views/UserAccessAppRole/_UserDetailPopUp.cshtml")