<togglable name="User"></togglable>
<div class="form-elements form-horizontal" ng-form="userNewForm">
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="materialAttribute" role="tab" data-toggle="tab">Sales Group</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="uom" role="tab" data-toggle="tab">Purchase Group</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="section" role="tab" data-toggle="tab">Section</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="payroll" role="tab" data-toggle="tab">Payroll Group</a></li>
                <li role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" aria-controls="process" role="tab" data-toggle="tab">Process</a></li>
                <li role="presentation" ng-class="{ active: isSet(7) }"><a ng-click="setTab(7)" href="" aria-controls="gate" role="tab" data-toggle="tab">Gate</a></li>
                <li role="presentation" ng-class="{ active: isSet(9) }"><a ng-click="setTab(9)" href="" aria-controls="sfgmovement" role="tab" data-toggle="tab">SFG Inventory</a></li>
                <li role="presentation" ng-class="{ active: isSet(10) }"><a ng-click="setTab(10)" href="" aria-controls="reportinggroup" role="tab" data-toggle="tab">Reporting Group</a></li>
                <li role="presentation" ng-class="{ active: isSet(8) }"><a ng-click="setTab(8)" href="" aria-controls="image" role="tab" data-toggle="tab">Image</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12" ng-show="searchEmployeeBtn">
                        <div class="form-group">
                            <label class="col-sm-2 control-label">Employee Code</label>
                            <div class="col-sm-4">
                                <div class="input-group">
                                    <input type="text" name="Vendor" ng-model="userNew.EmployeeCode" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="ShowEmployeeListPopUp();" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Username<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="1" type="text" name="User" ng-model="userNew.UserId" @*ng-readonly="inactive"*@ class="form-control" required placeholder="jhon">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Date Of Birth<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="3" type="text" name="DoB" required ng-model="userNew.DateOfBirth" datepicker class="form-control" placeholder="dd-Mmm-yyyy">
                            </div>
                        </div>
                        <div class="form-group" show-errors ng-show="passwordShow">
                            <label class="col-sm-4 control-label">Password<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input ng-keyup="compare(userNew.Password, userNew.ConfirmPassword)" tabindex="5" name="Password" type="password" ng-model="userNew.Password" class="form-control" id="pwd" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Phone</label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="7" name="Phone" type="text" ng-model="userNew.Phone" class="form-control">
                            </div>
                        </div>
                        <fieldset style="border:1px solid;">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">User Type</label>
                                <div class="col-sm-9">
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="UserType" ng-model="userNew.UserType" value="System Admin">
                                            <span class="cr"><i class="cr-icon"></i></span>
                                            System Admin
                                        </label>
                                        <label>
                                            <input type="radio" name="UserType" ng-model="userNew.UserType" value="Power User">
                                            <span class="cr"><i class="cr-icon"></i></span>
                                            Power User
                                        </label>
                                        <label>
                                            <input type="radio" name="UserType" ng-model="userNew.UserType" value="General User">
                                            <span class="cr"><i class="cr-icon"></i></span>
                                            General User
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                        <div class="form-group" style="margin-top:8px;">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea tabindex="12" class="form-control" rows="2" ng-model="coalevel1.Remarks"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Full Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="2" type="text" name="Full Name" ng-model="userNew.FullName" class="form-control" required placeholder="Mr. Jhon">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Email<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="4" type="email" name="Email" ng-model="userNew.Email" class="form-control" required placeholder="example@mail.com"
                                       pattern="[a-z0-9._%+-]+&#64[a-z0-9.-]+\.[a-z]{2,3}$">
                            </div>
                        </div>
                        <div class="form-group" ng-show="passwordShow" show-errors>
                            <label class="col-sm-4 control-label">Confirm Password<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="6" type="password" name="Confirm Password" ng-model="userNew.ConfirmPassword" ng-keyup="compare(userNew.Password, userNew.ConfirmPassword)" class="form-control" id="Conpwd" required>
                                <p class="msg-error" ng-show="compareTo">Confirm passwords did not match with password!</p>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Authentication Token<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="8" type="text" name="Authentication Token" ng-model="userNew.AuthToken" class="form-control" required readonly>
                            </div>
                        </div>
                        <fieldset style="border:1px solid;">
                            <div class="form-group" style="margin-bottom:-3px;">
                                <label class="col-sm-4 control-label tooltip-here" tooltip title="Password Change On First Login">Pwd Change First Login</label>
                                <div class="col-sm-2" style="margin-top: 1px;margin-left: -18px">
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="userNew.PasswordChangeOnFirstLogin">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                                <label class="col-sm-4 control-label">Password Never Expired</label>
                                <div class="col-sm-2" style="margin-top: 1px;margin-left: -18px">
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="userNew.PasswordNeverExpired">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                        <div class="form-group" style="margin-top:8px;">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" ng-model="userNew.Active" @*ng-disabled="userNew.EmployeeId!=null"*@>
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #region Sales Group -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="SalesGroupPopUp();" ng-disabled="userNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Sales Group</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="userSalesGroupTblShow">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>
                                        <th>Sales Organization</th>
                                        <th>Sales Group</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userSalesGroupList|filter:{Archive:false} " ng-class="{selected : x.Id==null}">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.SalesOrganizationName}}</td>
                                        <td>{{x.SalesGroupName}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="valuePassInDelModal(x.SalesGroupId, x.SalesGroupName, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Purchase Group -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="PurchaseGroupPopUp();" ng-disabled="userNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Purchase Group</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="userPurchaseGroupTblShow">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>
                                        <th>Purchase Organization</th>
                                        <th>Purchase Group</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userPurchaseGroupList|filter:{Archive:false} " ng-class="{selected : x.Id==null}">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.PurchaseOrganizationName}}</td>
                                        <td>{{x.PurchaseGroupName}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="purchaseDelModal(x.PurchaseGroupId, x.PurchaseGroupName, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Section -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="sectionPopUpDataList();" ng-disabled="userNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Section</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="sectionList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Section</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in sectionList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeRowModal(x.SectionName, $index, 'sectionList', 'Id', 'SectionId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Payroll Group -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="payrollPopUpDataList();" ng-disabled="userNew.Id===null" class="btn" @*ng-disabled="userNew.EmployeeId==null"*@><i class="glyphicon glyphicon-plus"></i> Add Payroll Group</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="payrollGroupList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Payroll Group</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in payrollGroupList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.PayrollGroupName}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeRowModal(x.PayrollGroupName, $index, 'payrollGroupList', 'Id', 'PayrollGroupId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Process -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(6), active: isSet(6) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="processPopUpDataList();" ng-disabled="userNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Process</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="userProcessList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Process</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userProcessList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.ProcessName}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeRowModal(x.ProcessName, $index, 'userProcessList', 'Id', 'ProcessId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Gate -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(7), active: isSet(7) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="gatePopUpDataList();" ng-disabled="userNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Gate</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="userGateList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>
                                        <th>User Define Name</th>
                                        <th>Plant</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userGateList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.GateName}}</td>
                                        <td>{{x.Plant}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeRowModal(x.GateName, $index, 'userGateList', 'Id', 'PlantGateId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region SFGInventory -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(9), active: isSet(9) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="SFGInventoryPopUpDataList();" ng-disabled="userNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add SFGInventory</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="userSFGInventoryList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>
                                        <th>User Define Name</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userSFGInventoryList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeRowModal(x.GateName, $index, 'userSFGInventoryList', 'Id', 'SFGInventoryId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Report Group -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(10), active: isSet(10) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="ReportGroupPopUpDataList();" ng-disabled="userNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Report Group</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="userReportGroupList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Report Group</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userReportGroupList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeRowModal(x.ProcessName, $index, 'userReportGroupList', 'Id', 'ReportingGroupId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Image -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(8), active: isSet(8) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-8 col-sm-offset-2 col-md-6 col-md-offset-3">
                        <div class="form-group">
                            <div class="col-sm-8">
                                <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="border: 1px dashed; height: 250px; width: 200px;" />
                            </div>
                            <div class="col-sm-6">
                                <input ng-file-select type="file" accept=".png,.jpg" id="uploadImage" name="file" />
                            </div>
                            <div class="col-sm-4">
                                <button ng-click="clearImage();" class="btn single-small-btn"><i class="glyphicon glyphicon-remove" ng-disabled="imageBtnDisable"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion Image -->
