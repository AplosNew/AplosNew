<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100%" required />
                </div>
            </div>


            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="SubCategory" ng-model="ModelNew.Category" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Estimated Value<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Budget" ng-model="ModelNew.EstimatedValue" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Item<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Category" ng-model="ModelNew.Item" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sub Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Category" ng-model="ModelNew.SubCategory" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Category" ng-model="ModelNew.Type" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Criticlty level<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Category" ng-model="ModelNew.Criticltylevel" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Full&Final Applicable</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ModelNew.FullFinalApplicable" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="Category" e-headertext="Category" e-width="5"></div>
            <div e-column e-field="SubCategory" e-headertext="SubCategory" e-width="5"></div>
            <div e-column e-field="Item" e-headertext="Item" e-width="5"></div>
            <div e-column e-field="Type" e-headertext="Type" e-width="5"></div>
            <div e-column e-field="EsstimatedValue" e-headertext="EsstimatedValue" e-width="5"></div>
            <div e-column e-field="FullFinalApplicable" e-headertext="Full&FinalApplicable" e-width="2"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>


