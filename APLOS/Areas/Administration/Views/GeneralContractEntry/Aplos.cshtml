<togglable name=" {{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">
        @*COLUMN 1*@
        <div class="col-xs-12 col-sm-8 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Contract Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-change="GetAllContractItem(); GetAllCheckById()" ng-model="ModelNew.GeneralContractId" required name="Process"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in ContractList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="ModelNew.Date"  name="Date" datepicker class="form-control datepicker"  maxlength="50" tabindex="0" required>
                </div>
            </div>

        </div>

        @*COLUMN 2*@
    <div class="col-xs-12 col-sm-8 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.EntityId" required name="Process"
                            tabindex="2">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Check By<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.CheckBySystemId" required name="Process"
                            tabindex="2">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in CheckedByIdList" value="{{option.SystemId}}">{{option.EmployeeName}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
        @*<div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>

            </ul>
        </div>*@
    </div>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Contract Item Entry</a></li>
               
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

                <div class="table-responsive modal-table">
                    <table class="table table-responsive table-striped">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Avg Qty</th>
                                <th>Transaction Qty</th>
                                <th>Rate</th>
                                <th>Amount</th>
                                <th>Remarks</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in ContractItemList">
                                <td>
                                    {{x.UserName}}
                                </td>

                                <td>
                                    {{x.AvgQty}}

                                </td>
                                <td>
                                    <input type="number" name="Transaction Qty" ng-model="x.TransactionQuantity" class="form-control" maxlength="15" ng-keyup="calcAmount(x, $index)" required tabindex="3" style="width:100px">
                                </td>
                                <td>
                                    {{x.Rate}}

                                </td>
                                <td>{{x.Amount | number:2}}</td>
                                <td>
                                    <textarea class="form-control" rows="1" ng-model="x.Remarks" maxlength="250" tabindex="6"></textarea>
                                </td>

                            </tr>
                        </tbody>
                        @*<tfoot ng-show="userMedicineList.length">
                            <tr>
                                <td>Total</td>
                                <td></td>
                                <td></td>
                                <td class="text-right"><strong>{{ContractItemList | sumByKey : 'Amount' | number:2}}</strong></td>

                            </tr>

                        </tfoot>*@
                    </table>

                </div>
            </div>
          
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" id="savebtn" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
                    <li> <button ng-click="Update();" ng-disabled="ModelNew.ApprovedStatus == 'Approved'" id="updatebtn" class="btn" tabindex="9" style="display:none"><i class="glyphicon glyphicon-floppy-disk"></i>Update</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-headertext="Actions" e-width="30">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;padding-top:1px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.PrintData(this);" style="margin: -6px;"></i></button>
            </div>
            <div e-column e-field="GeneralContract" e-headertext="Contract Name" e-width="100"></div>
            <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>
            <div e-column e-field="Date" e-headertext="Date" e-width="130"></div>
            <div e-column e-field="CheckBy" e-headertext="Check By" e-width="130"></div>
            <div e-column e-field="CheckedByStatus" e-headertext="Check Status" e-width="130"></div>
            <div e-column e-field="ApproveBy" e-headertext="Approve By" e-width="130"></div>
            <div e-column e-field="ApprovedStatus" e-headertext="Approved Status" e-width="130"></div>


        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
