<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>
<div><h4><span class="glyphicon glyphicon-info-sign"></span> General Contract Report</h4></div>
<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Un Checked</a></li>

            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="Service" role="tab" data-toggle="tab">Checked</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
                <div>
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="GridISUnchecked" ej-grid e-datasource="GriddataISUnCheckedList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true"
                             e-detailstemplate="detailTemp"
                             e-detailsdatabound="detailgrid">
                            <div e-columns>
                                <div e-column e-headertext="Actions" e-width="60">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk" title="Un Checked" ng-click="$parent.onClickPOA('GridISUnchecked');" style="margin: -6px;"></i></button>
                                    @*<button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.AllTabPrint('GridISUnchecked');" style="margin: -6px;"></i></button>*@
                                </div>
                                <div e-column e-template="#ToBeApprovedBy1" e-headertext="To Be Approved By" e-width="150"></div>
                                <div e-column e-template="#RejectCheckedReason" e-headertext="Hold / Reject Reason" e-width="150" style="height: 20px;"></div>
                                <div e-column e-template="#CheckedStatus1" e-headertext="Checked Status" e-width="150"></div>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="Date" e-headertext="Date" e-width="100"></div>
                                <div e-column e-field="Entity" e-headertext="Entity" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="For Checking" e-width="80"></div>
                                <div e-column e-field="Contract" e-headertext="Contract" e-width="100"></div>
                            </div>

                        </div>
                        <script id="tabGridContents" type="text/x-jsrender">
                            <div class="tabcontrol" id="Test">
                                <ul>
                                    <li><a href="#gridTab{{:Id}}">Contract Item Entry</a></li>
                                    
                                </ul>
                                <div id="gridTab{{:Id}}">
                                    <div id="detailGrid"></div>
                                </div>
                            </div>
                        </script>

                        <script type="text/template" id="ToBeApprovedBy1">
                            <div class="">
                                <div id="control">
                                    <input ej-dropdownlist e-datasource="$parent.CheckedByList" e-value="data.AuthorizedBy" e-fields-text="Text" e-fields-value="Value" e-width="100%" />

                                </div>
                            </div>
                        </script>
                        <script type="text/template" id="CheckedStatus1">
                            <div class="">
                                <div id="control1">
                                    <input id="combo-default" type="text" e-fields-text="Text" e-fields-value="Value" ej-combobox e-datasource="$parent.POApprovalList" e-value="data.CheckedStatus" e-width="100%" />
                                </div>
                            </div>
                        </script>


                        <script type="text/template" id="RejectCheckedReason">

                            <input type="text" ng-model="data.CheckedRejectReason" style="color:black;" class="form-control" />

                        </script>
                    </div>
                </div>
            </fieldset>
        </div>


        @*  TAB - 3   *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
                <div>
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="GridISUnchecked3" ej-grid e-datasource="GriddataISCheckedList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true"
                             e-detailstemplate="detailTemp"
                             e-detailsdatabound="detailgrid">
                            <div e-columns>
                                @*<div e-column e-headertext="Actions" e-width="90">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk" title="Un Checked" ng-click="$parent.onClickSave('GridISUnchecked3');" style="margin: -6px;"></i></button>
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.AllTabPrint('GridISUnchecked3');" style="margin: -6px;"></i></button>
                                </div>*@
                                
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="Date" e-headertext="Date" e-width="100"></div>
                                <div e-column e-field="Contract" e-headertext="Contract" e-width="100"></div>
                                <div e-column e-field="Entity" e-headertext="Entity" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="To Be Approved By" e-width="80"></div>
                                <div e-column e-field="CheckedByStatus" e-headertext="To Be Approved By" e-width="80"></div>
                                <div e-column e-field="CheckedReason" e-headertext="CheckedReason" e-width="80"></div>

                            </div>
                        </div>
                        <script id="tabGridContents" type="text/x-jsrender">
                            <div class="tabcontrol" id="Test">
                                <ul>
                                    <li><a href="#gridTab{{:Id}}">PO Details</a></li>
                                </ul>

                            </div>
                        </script>

                        
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
    <div class="modal fade site-modal in" id="ListOfRequisition1" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg modellgModify">
            <div class="modal-content">
                <div class="modal-header">
                    Requisition Details
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body text-center">

                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>RowId</th>
                                    <th>Budget Type</th>
                                    <th>Activity Name</th>
                                    <th>Material Group</th>
                                    <th>Material Name</th>
                                    <th>Article</th>
                                    <th>Sku1</th>
                                    <th>Sku2</th>
                                    <th>Sku3</th>
                                    <th>Material Details</th>
                                    <th>Qty</th>
                                    @*<th>Approved Qty</th>*@
                                    <th>UOM</th>
                                    <th>Rate</th>
                                    <th>CurrencyName</th>
                                    <th>Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in requisitionMaterialList1">
                                    <td>{{x.RowId}}</td>
                                    <td>{{x.BudgetType}}</td>
                                    <td>{{x.ActivityName}}</td>
                                    <td>{{x.MaterialGroupName}}</td>
                                    <td>{{x.MaterialName}}</td>
                                    <td>{{x.ArticleName}}</td>
                                    <td>{{x.SKU1}}</td>
                                    <td>{{x.SKU2}}</td>
                                    <td>{{x.SKU3}}</td>
                                    <td>{{x.MaterialDetail}}</td>
                                    <td>{{x.TransactionQty}}</td>
                                    @*<td>
                                            <input type="number" class="form-control text-left" ng-model="x.ApprovedQty" ng-keyup="calculateAmount(x);">
                                        </td>*@
                                    <td>{{x.TransactionUoM}}</td>

                                    <td>{{x.EstimatedRate}}	</td>
                                    <td>{{x.CurrencyName}}</td>
                                    <td>{{x.TotalAmount}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade site-modal in" id="ActionPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header"> Reason for approved & Unaooroved</div>  @*<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button>*@
                <div class="modal-body">
                    <div class="col-xs-12 col-sm-12col-md-12">

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Reason</label>
                            <label class="col-sm-4 control-label" ng-model="SystemId" ng-hide="true">{{SystemId}}</label>
                            <div class="col-sm-12">
                                <textarea type="text" rows="3" ng-model="reason" class="form-control" style="border:double"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="form-group">
                        <ul class="common-btn list-inline text-right">
                            <li><button ng-click="poApp1();" class="btn"> Save</button></li>
                            <li><button ng-click="ClosedPOPUp();" class="btn"> Close</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="poapprovealert" title="Confirmation" message={{message}} data-ng-click-right-button="poApp();"></confirm-archive-generic>
