@*<div><h4 class="glyphicon glyphicon-book"> {{title}}</h4></div>*@
<togglable name=" {{title}}"></togglable>

<div class="form-elements form-horizontal" ng-form name="ModelNewForm" style="margin-bottom:10px">

    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">

        @*COLUMN 1*@
        <div class="col-xs-12 col-sm-8 col-md-6"> 
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <div class="col-md-4 text-left" style="padding:0px;">
                    <label class="col-sm-12 control-label text-left" ng-click="FileDownload(ModelNew)"><a href="{{dwonloadUrl}}" style="text-decoration:underline" download="{{ModelNew.FileName}}" target="_self">{{ModelNew.FileName}}</a></label>
                </div>
                <div class="col-md-8 text-right">
                    <div id="UploadDefault" e-id="{{ModelNew.Id}}" e-data="ModelNew.Id" e-dialogPosition-x="0" e-multiplefilesselection="false" e-width="50" e-buttontext-browse="+ File" e-success="getFileList" e-showroundedcorner="false" @*e-height="30"*@ e-autoupload="true" e-begin="onBeginUpload" e-filesize="2097152" ej-uploadbox e-saveurl="uploadUrl" e-extensionsallow=".jpg,.bmp,.png,.jpeg,.pdf,.xls,.xlsx,.doc,.docx,.ppt,.pptx,.txt" e-error="errorUpload"></div>
                </div>
            </div>

        </div>

        @*COLUMN 2*@
        <div class="col-xs-12 col-sm-8 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{ModelNew.PartyCode}}</span>
                        <input type="text" name="Vendor" ng-model="ModelNew.PartyName" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="showPartyPopUpNew()" ng-disabled="inventoryMaterialList.length>0" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>

                        </span>
                    </div>
                </div>
            </div> 
        </div> 
    </div>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Contract Item Detail</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Service" role="tab" data-toggle="tab">Employe</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="Service" role="tab" data-toggle="tab">Check By</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="Service" role="tab" data-toggle="tab">Approve By</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="Service" role="tab" data-toggle="tab">Entity</a></li> 
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li>
                                    <button name="submit" ng-click="openGeneralContractMaster()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-plus"></i> Add Item</button> 
                                </li>
                            </ul>
                        </div>
                    </div>
                </div> 
                <div class="table-responsive modal-table" ng-show="SelectedItemList.length>0">
                    <table class="table table-responsive table-striped">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Min Qty</th>
                                <th>Max Qty</th>
                                <th>Avg Qty</th>
                                <th>Rate</th>
                                <th>Effective Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in SelectedItemList">
                                <td>
                                    {{x.ContractMaster}}
                                </td>
                                <td>
                                    <div class="show-message">
                                        <input type="number" name="Min Qty" ng-model="x.MinQty" class="form-control">
                                    </div>
                                </td>
                                <td>
                                    <div class="show-message">
                                        <input type="number" name="Max Qty" ng-model="x.MaxQty" class="form-control">
                                    </div>
                                </td>
                                <td>
                                    <div class="show-message">
                                        <input type="number" name="Avg Qty" ng-model="x.AvgQty" class="form-control">
                                    </div>
                                </td>
                                <td>
                                    <div class="show-message">
                                        <input type="number" name="Rate" ng-model="x.Rate" class="form-control">
                                    </div>
                                </td>
                                <td>
                                    <div class="show-message">
                                        <input type="text" ng-model="x.EffectiveDate" class="form-control" datepicker>
                                    </div>
                                </td> 
                                <td><button ng-click="RemoveParticularRowConfirmation(x)" class="btn" tabindex="9"><i class="glyphicon glyphicon-remove"></i></button></td> 
                            </tr>
                        </tbody>

                    </table>
                    @*<div class="common-btn" style="margin-top:10px">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveContractItemDetail();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>

                            </ul>
                        </div>*@
                </div>
            </div>
            @*  TAB - 2   *@
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="OpenVendorEmployeePopUp();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Employee</button></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>DOJ</th>
                                <th>Department</th>
                                <th>Section</th>
                                <th>Sub Section</th>
                                <th>Legal Designation</th>
                                <th>Designation</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in SelectedVendorEmployee">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOJ}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                                <td>{{x.SubSection}}</td>
                                <td>{{x.LegalDesignation}}</td>
                                <td>{{x.Designation}}</td>
                                <td><button ng-click="RemoveVendorEmployeeRowConfirmation(x)" class="btn" tabindex="9"><i class="glyphicon glyphicon-remove"></i></button></td> 
                            </tr>
                        </tbody>
                    </table>
                    @*<div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>

                            </ul>
                        </div>*@
                </div>
            </div>

            @*  TAB - 3   *@
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn" style="margin-bottom:10px">
                            <ul class="list-inline text-left">
                                <li>
                                    <button name="submit" ng-click="OpenCheckByPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-plus"></i> Check By</button> 
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>DOJ</th>
                                <th>Department</th>
                                <th>Section</th>
                                <th>Sub Section</th>
                                <th>Legal Designation</th>
                                <th>Designation</th>
                                <th>Action</th> 
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in SelectedCheckedByList">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOJ}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                                <td>{{x.SubSection}}</td>
                                <td>{{x.LegalDesignation}}</td>
                                <td>{{x.Designation}}</td>
                                <td><button ng-click="RemoveCheckedByRowConfirmation(x)" class="btn" tabindex="9"><i class="glyphicon glyphicon-remove"></i></button></td> 
                            </tr>
                        </tbody>
                    </table>
                </div>


            </div>
            @*  TAB - 4   *@
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn" style="margin-bottom:10px">
                            <ul class="list-inline text-left">
                                <li>
                                    <button name="submit" ng-click="OpenApprovedbyPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-plus"></i> Check By</button> 
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>DOJ</th>
                                <th>Department</th>
                                <th>Section</th>
                                <th>Sub Section</th>
                                <th>Legal Designation</th>
                                <th>Designation</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in SelectedApprovedByList">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOJ}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                                <td>{{x.SubSection}}</td>
                                <td>{{x.LegalDesignation}}</td>
                                <td>{{x.Designation}}</td>
                                <td><button ng-click="RemoveApprovedByRowConfirmation(x)" class="btn" tabindex="9"><i class="glyphicon glyphicon-remove"></i></button></td> 
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            @*  TAB - 5   *@
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn" style="margin-bottom:10px">
                            <ul class="list-inline text-left">
                                <li><button ng-click="OpenEntityPopUp();" class="btn"><i class="glyphicon glyphicon-plus"></i> Entity</button></li>
                            </ul>
                        </div>
                    </div>
                </div> 
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Entity</th>
                                <th>Entity Type</th>

                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in SelectedEntityList">
                                <td>{{x.Code}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.EntityType}}</td> 
                                <td><button ng-click="RemoveEntityRowConfirmation(x)" class="btn" tabindex="9"><i class="glyphicon glyphicon-remove"></i></button></td> 
                            </tr>
                        </tbody>
                    </table>
                </div> 
            </div> 
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                    @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div> 
    </div>
</div> 

@*Grid Table*@
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="HeaderList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            @*<div e-column e-field="Sequence" e-headertext="Seq" e-width="80"></div>
                <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>*@
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="150"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="130"></div>
            <div e-column e-field="PartyName" e-headertext="Vendor" e-width="130"></div>
            <div e-column e-field="FileName" e-headertext="Attachment" e-width="130"></div> 
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmParticularRowRemovePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="RemoveContractItemDetailRow();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmVendorEmpRemovePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="RemoveVendorEmpRow();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmCheckedByPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="RemoveCheckedByRow();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmApprovedByPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="RemoveApprovedByRow();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmEntityPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="RemoveEntityRow();"></confirm-archive-generic>


