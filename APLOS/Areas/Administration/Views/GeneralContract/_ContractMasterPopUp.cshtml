<div class="modal fade site-modal in" id="contractmasterPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> General Contract Item Master <button type="button" class="close" ng-click="closeGeneralContractMaster();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal"> 
                <div class="col-md-12">
                    <div class="content-container-fluid"> 
                        <div id="GridConMasterEdit" ej-grid e-datasource="ModelList"  e-load="loadGridEdit"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-type="string" e-headertext="Apply" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>
                                <div e-column e-type="string" e-field="ContractMasterId" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-type="string" e-field="Sequence" e-headertext="Seq" e-width="80"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="100"></div> 
                                <div e-column e-type="string" e-field="ContractMaster" e-headertext="Contract" e-width="130"></div>
                                <div e-column e-type="string" e-field="Category" e-headertext="Category" e-width="130"></div>
                                <div e-column e-type="string" e-field="SubCategory" e-headertext="Sub Category" e-width="130"></div>
                                <div e-column e-type="string" e-field="Purpose" e-headertext="Purpose" e-width="130"></div>
                                <div e-column e-type="string" e-field="Detail" e-headertext="Detail" e-width="130"></div>
                                <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="130"></div> 
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                   <li><button type="button" ng-click="AddItems()" class="btn"><i class="glyphicon glyphicon-plus"></i> Add</button></li>
                </ul> 
            </div>
        </div>
    </div>
</div>

