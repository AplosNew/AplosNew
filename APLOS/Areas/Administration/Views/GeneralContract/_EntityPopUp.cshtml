<div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> Entity List <button type="button" class="close" ng-click="CloseEntityPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByEmployee">
                                            <option ng-repeat="option in EmployeeSearchList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchEmployee" ng-enter="getSearchedEmployee()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getSearchedEmployee()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        @*style="color:black;overflow:scroll"*@
                        <div style="color:black;" ej-grid e-datasource="EntityList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-headertext="Apply" e-template="#EntitycheckboxTemplate" e-textalign="center" e-width="10"></div>
                                <div e-column e-field="EntityId" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="30"></div>
                                <div e-column e-field="UserName" e-headertext="Entity" e-width="30"></div>
                                <div e-column e-field="EntityType" e-headertext="EntityType" e-width="30"></div>
                                
                            </div>
                        </div>

                        <script type="text/template" id="EntitycheckboxTemplate">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="AddEntity();" class="btn"> Add</button></li>
                    <li><button ng-click="CloseEntityPopUp();" class="btn"> Close</button></li>
                </ul>

            </div>
        </div>
    </div>
</div>

