<div class="modal fade site-modal in" id="checkbyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> Employee List <button type="button" class="close" ng-click="CloseCheckByPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        @*style="color:black;overflow:scroll"*@
                        <div style="color:black;" ej-grid e-datasource="CheckedByList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-headertext="Apply" e-template="#EmpcheckboxTemplate" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="SystemId" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Emp Code" e-width="100"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="100"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="100"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="100"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                            </div>
                        </div>
                       
                        <script type="text/template" id="EmpcheckboxTemplate">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="AddCheckedBy();" class="btn"> Add</button></li>
                    <li><button ng-click="CloseCheckByPopUp();" class="btn"> Close</button></li>
                </ul>

            </div>
        </div>
    </div>
</div>
