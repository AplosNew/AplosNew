<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100" required />
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Process</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.ProcessId" name="Process"
                            ng-options="item.Value as item.Text for item in ProcessList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
              

        <div class="form-group">
            <label class="col-sm-4 control-label">Budget<sup>*</sup></label>
        
            <div class="col-sm-6">
                <button ng-click="selectBudget()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
            </div>

        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sub Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sub Category" ng-model="ModelNew.SubCategory" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Item Name" ng-model="ModelNew.ItemName" class="form-control" required  maxlength="100">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="30" maxlength="30">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
     
        <div class="form-group">
            <label class="col-sm-4 control-label">UOM</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.UOMId" name="uom"
                            ng-options="item.Value as item.Text for item in UOMList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Category" ng-model="ModelNew.Category" class="form-control" maxlength="30" required tabindex="3">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Rate<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Standard Rate" style="text-align:left;" ng-model="ModelNew.StandardRate" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="50" tabindex="6"></textarea>
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="row">
        <div id="budCh" ej-grid e-datasource="SelBudList" 
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" style="margin-top:10px;">
            <div e-columns>
                <div e-column e-field="Code" e-headertext="Budget Code" e-width="50"></div>
                <div e-column e-field="Position" e-headertext="Position" e-width="120"></div>
                <div e-column e-field="Company" e-headertext="Company" e-width="120"></div>
                <div e-column e-field="Plant" e-headertext="Plant" e-width="100"></div>
                <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>

            </div>
        </div>
    </div>
</div>


<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ItemName" e-headertext="Item Name" e-width="3"></div>
            <div e-column e-field="Category" e-headertext="Category" e-width="3"></div>
            <div e-column e-field="SubCategory" e-headertext="Sub Category" e-width="3"></div>
            <div e-column e-field="StandardRate" e-headertext="Standard Rate" e-type="number" e-width="3"></div>

        </div>
    </div>
</div>
<confirm-modal></confirm-modal>



<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to save without any shifts ?" data-ng-click-left-button="restoreChildShifts();" data-ng-click-right-button="SaveShifts();"></confirm-archive-generic>

<div class="modal fade site-modal in" id="BudgetPop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Budget List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Please Select All the Budgets.</p>
                        <div style="color:black;" id="GridBudget" ej-grid e-datasource="BudgetList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>
                                <div e-column e-field="Code" e-headertext="Budget Code" e-width="50"></div>
                                <div e-column e-field="Position" e-headertext="Position" e-width="120"></div>
                                <div e-column e-field="Company" e-headertext="Company" e-width="120"></div>
                                <div e-column e-field="Plant" e-headertext="Plant" e-width="100"></div>
                                <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>

                            </div>

                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" e-value="data.isSelected" />
                        </script>
                        


                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="selectBudDetail();" class="btn"><i class=""></i> Select</button>
                            <button ng-click="closeBudPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>

