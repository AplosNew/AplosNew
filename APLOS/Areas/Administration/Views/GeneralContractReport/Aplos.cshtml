<div><h4><span class="glyphicon glyphicon-info-sign"></span> General Contract Report</h4></div>
<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Contract Item Detail</a></li>
          @*  <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Service" role="tab" data-toggle="tab">Summary</a></li>
*@
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="form-elements form-horizontal" ng-form name="ModelNewForm">
                <div class="row">
                    @*COLUMN 1*@
                    <div class="col-xs-12 col-sm-8 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" ng-model="ModelNew.FromDate" name="Date" datepicker class="form-control" maxlength="50" tabindex="0" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Contract Name</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control"  ng-model="ModelNew.GeneralContractId" required name="Process"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in ContractList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    @*COLUMN 2*@

                    <div class="col-xs-12 col-sm-8 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" ng-model="ModelNew.ToDate" name="Date" datepicker class="form-control" maxlength="50" tabindex="0" required>
                            </div>
                        </div>


                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Entity</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.EntityId" required name="Process"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="GetAllTransactionData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>

                            <li> <button ng-click="XlsDownloadContractTransactionReport();" class="btn" tabindex="11"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                        </ul>
                    </div>
                </div>
                <div class="table-responsive">
                    <div id="GridEdit" ej-grid e-datasource="FilteredTransactionList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            @*<div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>*@

                            <div e-column e-field="ContractName" e-headertext="ContractName" e-width="130"></div>
                            <div e-column e-field="Date" e-headertext="Date" e-width="130"></div>
                            <div e-column e-field="Entity" e-headertext="Entity" e-width="130"></div>
                            <div e-column e-field="Item" e-headertext="Item" e-width="130"></div>
                            <div e-column e-field="Quantity" e-headertext="Quantity" e-width="130"></div>
                            <div e-column e-field="Rate" e-headertext="Rate" e-width="130"></div>
                            <div e-column e-field="Amount" e-headertext="Amount" e-width="130"></div>
                            <div e-column e-field="CheckedByStatus" e-headertext="CheckedByStatus" e-width="130"></div>
                            <div e-column e-field="ApprovedStatus" e-headertext="ApprovedStatus" e-width="130"></div>
                            <div e-column e-field="CheckBy" e-headertext="CheckBy" e-width="130"></div>
                            <div e-column e-field="ApproveBy" e-headertext="ApproveBy" e-width="130"></div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*  TAB - 2   *@
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div class="form-elements form-horizontal" ng-form name="ModelNewForm">
            <div class="row">
                @*COLUMN 1*@
                <div class="col-xs-12 col-sm-8 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" ng-model="ModelNew.FromDate" name="Date" datepicker class="form-control" maxlength="50" tabindex="0" required>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Contract Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.GeneralContractId" required name="Process"
                                        tabindex="2">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in ContractList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                @*COLUMN 2*@

                <div class="col-xs-12 col-sm-8 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" ng-model="ModelNew.ToDate" name="Date" datepicker class="form-control" maxlength="50" tabindex="0" required>
                        </div>
                    </div>


                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Entity</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.EntityId" required name="Process"
                                        tabindex="2">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="GetSummaryData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>

                        <li> <button ng-click="XlsDownloadSummaryReport();" class="btn" tabindex="11"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                    </ul>
                </div>
            </div>
            <div class="table-responsive">
                <div id="GridEdit" ej-grid e-datasource="SummaryList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>                      
                        <div e-column e-field="Item" e-headertext="Item" e-width="130"></div>
                        <div e-column e-field="Quantity" e-headertext="Quantity" e-width="130"></div>                      
                        <div e-column e-field="Amount" e-headertext="Amount" e-width="130"></div>                        
                    </div>
                </div>
            </div>
        </div>
    </div>

    </div>

</div>