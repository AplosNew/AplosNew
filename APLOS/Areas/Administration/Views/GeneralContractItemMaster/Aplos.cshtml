<togglable name=" {{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">
        @*COLUMN 1*@
        <div class="col-xs-12 col-sm-8 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100" required />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sub Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">

                    <input type="text" name="Sub Category" ng-model="ModelNew.SubCategory" class="form-control" required tabindex="5" maxlength="50">

                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Detail</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Detail" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
            
            @*<div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.IsActive" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>*@
        </div>

        @*COLUMN 2*@
    <div class="col-xs-12 col-sm-8 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                
                    <input type="text" name="Category" ng-model="ModelNew.Category" class="form-control" required tabindex="5" maxlength="50">
                
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Purpose<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                
                    <input type="text" name="Purpose" ng-model="ModelNew.Purpose" class="form-control" required tabindex="5" maxlength="50">
                
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">UOM<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">

                    <input type="text" name="Responsible Person" ng-model="ModelNew.UOMName" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" ng-click="openUOMPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>

    </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>

</div>

@*Grid Table*@
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Sequence" e-headertext="Seq" e-width="80"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
            @*<div e-column e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="150"></div>*@
            <div e-column e-field="UserName" e-headertext="User Name" e-width="130"></div>
            <div e-column e-field="Category" e-headertext="Category" e-width="130"></div>
            <div e-column e-field="SubCategory" e-headertext="Sub Category" e-width="130"></div>
            <div e-column e-field="Purpose" e-headertext="Purpose" e-width="130"></div>
            <div e-column e-field="Detail" e-headertext="Detail" e-width="130"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="130"></div>

            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
            
        </div>
    </div>
</div>




@Html.Partial("~/Areas/HumanResource/Views/MedicineMaster/_UOMPopUpScreen.cshtml")
<confirm-modal></confirm-modal>
