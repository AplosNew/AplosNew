<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
