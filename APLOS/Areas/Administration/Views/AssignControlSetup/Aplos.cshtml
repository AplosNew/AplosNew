<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal">
    <div ng-form name="ModelNewForm" id="maindiv">
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100%" required />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Description" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Assign Type</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" name="Assign Type" ng-model="ModelNew.AssignType" ng-options="item.Value as item.Text for item in AssignTypeList" required tabindex="6">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="BudgetCode" role="tab" data-toggle="tab">BudgetCode</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5);GetBudgetedEmployee();" href="" aria-controls="BudgetedEmployee" role="tab" data-toggle="tab">Budgeted Employee</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);GetAssignedEmployee('Creation');" href="" aria-controls="Creation" role="tab" data-toggle="tab">Creation</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);GetAssignedEmployee('Checking');" href="" aria-controls="Checking" role="tab" data-toggle="tab">Checking</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4);GetAssignedEmployee('Approving');" href="" aria-controls="Approving" role="tab" data-toggle="tab">Approving</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form="tabForm1" id="BudgetCode">
                <div class="row">
                    <div class="col-sm-12 col-sm-12 col-md-12">
                        <div class="col-sm-12 col-sm-6 col-md-6">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="popUpBudgetCode();" ng-disabled="ModelNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-search" style="top: 1px;"></i>Budget Code</button></li>
                                </ul>
                            </div>
                        </div>

                    </div>
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridBC" ej-grid e-datasource="BudgetCodeList" e-templaterefresh="refreshTemplateRemove"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateRemove" e-template="#checkRemove" e-textalign="center" e-width="30"></div>
                                @*<div e-column e-headertext="Remove" e-headertemplateid="#headerTemplate" e-template="#DeleteBudgetCode" e-textalign="center" e-width="60"></div>*@
                                <div e-column e-type="string" e-field="EntityName" e-headertext="Entity" e-width="80"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Budget Code" e-width="100"></div>
                                <div e-column e-type="string" e-field="Division" e-headertext="Division" e-width="80"></div>
                                <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="80"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="140"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-width="140"></div>
                                <div e-column e-type="string" e-field="EmployeeType" e-headertext="Employee Type" e-width="140"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="140"></div>
                                <div e-column e-type="string" e-field="Activity" e-headertext="Activity" e-width="140"></div>
                                <div e-column e-type="string" e-field="UserGroup" e-headertext="User Group" e-width="140"></div>
                                <div e-column e-type="string" e-field="Process" e-headertext="Process" e-width="140"></div>
                                <div e-column e-type="string" e-field="BudgetedManpower" e-headertext="Budgeted Manpower" e-width="100"></div>
                                <div e-column e-type="string" e-field="DeployedManpower" e-headertext="Deployed Manpower" e-width="100"></div>
                                <div e-column e-type="string" e-field="IsOTEntitled" e-headertext="OT Applicable" e-width="140"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkRemove">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplateRemove">
                            <input type="checkbox" id="headchkRemove" />
                        </script>

                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="BCSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                            <li>
                                <button ng-click="removeBudgetCode();" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-trash" tabindex="119"></i> Delete</button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="row">
                    <div class="col-lg-12">
                        <div style="color:black;" id="GridBE" ej-grid e-datasource="BudgetedEmployeeList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplateBE">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateBE" e-template="#checkBudgetedEmployee" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="EmployeeId" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                <div e-column e-field="EmployeeCategory" e-headertext="Emp Category" e-width="80"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            </div>
                            <script type="text/template" id="checkBudgetedEmployee">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.BEFlag" />
                            </script>
                            <script type="text/x-jsrender" id="headerTemplateBE">
                                <input type="checkbox" id="headchkBE" />
                            </script>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="BESave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form="tabForm2" id="Creation">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="popUpEmployee('Creation');" ng-disabled="ModelNew.Id==null" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                            </ul>
                        </div>
                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="GridCreation" ej-grid e-datasource="CreationBudgetedEmployeeList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-rowdatabound="onrowdatabound" e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="Remove" e-headertemplateid="" e-template="#DeleteAuthority" e-textalign="center" e-width="40"></div>
                                    <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                                    <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="40" e-visible="false"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="40"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                    <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                                    <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                    <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                                </div>
                            </div>
                            <script type="text/template" id="DeleteAuthority">
                                <div class="common-btn">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="$parent.removeEmployee(this);" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-trash" tabindex="119"></i></button>
                                        </li>
                                    </ul>
                                </div>
                            </script>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }" ng-form="tabForm3" id="Checking">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="popUpEmployee('Checking');" ng-disabled="ModelNew.Id==null" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                            </ul>
                        </div>
                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="GridCheck" ej-grid e-datasource="CheckingBudgetedEmployeeList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-rowdatabound="onrowdatabound" e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="Remove" e-headertemplateid="" e-template="#DeleteAuthority" e-textalign="center" e-width="40"></div>
                                    <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                                    <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="40" e-visible="false"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="40"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                    <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                                    <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                    <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                                </div>
                            </div>
                            <script type="text/template" id="DeleteAuthority">
                                <div class="common-btn">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="$parent.removeEmployee(this);" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-trash" tabindex="119"></i></button>
                                        </li>
                                    </ul>
                                </div>
                            </script>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }" ng-form="tabForm4" id="Approving">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="popUpEmployee('Approving');" ng-disabled="ModelNew.Id==null" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                            </ul>
                        </div>
                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="GridApproving" ej-grid e-datasource="ApprovingBudgetedEmployeeList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-rowdatabound="onrowdatabound" e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="Remove" e-headertemplateid="" e-template="#DeleteAuthority" e-textalign="center" e-width="40"></div>
                                    <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                                    <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="40" e-visible="false"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="40"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                    <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                                    <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                    <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                                </div>
                            </div>
                            <script type="text/template" id="DeleteAuthority">
                                <div class="common-btn">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="$parent.removeEmployee(this);" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-trash" tabindex="119"></i></button>
                                        </li>
                                    </ul>
                                </div>
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="AssignType" e-headertext="Assign Type" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>


<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Manpower Budget Info<button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridpopUpId" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="selectDoubleClick" e-allowselection="true" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplate">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="All" e-headertemplateid="#headerTemplateGWS" e-template="#checkGWS" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                            <div e-column e-field="EntityCode" e-headertext="Entity Code" e-width="80"></div>
                            <div e-column e-field="EntityName" e-headertext="Entity" e-width="80"></div>
                            <div e-column e-field="PositionCode" e-headertext="Position Code" e-width="80"></div>
                            <div e-column e-field="PositionName" e-headertext="Position Name" e-width="80"></div>
                            <div e-column e-field="EmploymentType" e-headertext="Employment Type" e-width="80"></div>
                            <div e-column e-type="string" e-field="BudgetedManpower" e-headertext="Budgeted Manpower" e-width="100"></div>
                            <div e-column e-type="string" e-field="DeployedManpower" e-headertext="Deployed Manpower" e-width="100"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="Division" e-headertext="Division" e-width="80"></div>
                            <div e-column e-field="SubDivision" e-headertext="Sub Division" e-width="80"></div>
                            <div e-column e-field="Unit" e-headertext="Unit" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                            <div e-column e-type="string" e-field="EmployeeType" e-headertext="Employee Type" e-width="80"></div>
                            <div e-column e-field="ShiftDefination" e-headertext="Shift Defination" e-width="80"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                        </div>
                    </div>
                    <script type="text/template" id="checkGWS">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplateGWS">
                        <input type="checkbox" id="headchkGWS" />
                    </script>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <ul class="list-inline text-right">
                    <li><button type="button" class="btn btn-default" ng-click="closePopUp();">Close</button></li>
                    <li><button ng-click="selectDoubleClick();" class="btn">Select</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>


