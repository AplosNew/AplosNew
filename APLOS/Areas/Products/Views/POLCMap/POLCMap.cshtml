@*Master Data Entry*@
<div class="form-horizontal form-elements" ng-form="productNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">PO Basic Info</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Order Specific</label>
                <div class="col-sm-8">
                    <div class="radio">
                        <label>
                            <input type="radio" name="OrderSpecific" ng-model="purchaseLCNew.OrderSpecific" value="Yes" ng-click="show()">
                            <span class="cr"><i class="cr-icon"></i></span>Yes
                        </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        <label>
                            <input type="radio" name="OrderSpecific" ng-model="purchaseLCNew.OrderSpecific" value="No" ng-click="hide()">
                            <span class="cr"><i class="cr-icon"></i></span>No
                        </label>
                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Contract">Contract</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" ng-model="productNew.ContractId" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="GetPopUpContract()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearContract()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        <button ng-click="GetMasterOrderByContractList()" class="btn single-small-btn"><i class="glyphicon glyphicon-list-alt"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" hidden id="masterId" /> @*<label id="PartyCode"></label>*@
                        <span class="input-group-addon"> {{productNew.PartyCode}}</span>
                        <input type="text" name="Vendor" id="Vendor" ng-model="productNew.PartyName" class="form-control" readonly>
