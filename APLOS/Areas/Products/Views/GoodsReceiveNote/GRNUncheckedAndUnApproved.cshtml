<togglable name="GRN Check / Un Approve"></togglable>
<div class="tab-design" id="tab_show">
	<div class="site-tab">
		<ul class="nav nav-tabs" role="tablist">
			<li role="presentation" ng-class="{ active: isSetpou(1) }"><a ng-click="setTabpou(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Checked List</a></li>
			<li role="presentation" ng-class="{ active: isSetGRNRejectHoldList(3) }"><a ng-click="setTabGRNRejectHoldList(3)" href="" aria-controls="address" role="tab" data-toggle="tab">Approved List</a></li>
			@*<li role="presentation" ng-class="{ active: isSetpoa(2) }"><a ng-click="setTabpoa(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Checked</a></li>*@
		</ul>

	</div>


	<div class="tab-content">
		<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetpou(1), active: isSetpou(1) }">
			<fieldset>
				<legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
				@*<div id="GRNUncheck">*@
					<div class="content-container-fluid" style="color:black;overflow:scroll">
						<div style="color:black;" id="GridPO" ej-grid e-datasource="GriddataGRNCheckedist" e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick=""
							 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
							 e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true"
							 e-detailstemplate="detailTemp"
							 e-detailsdatabound="detailgrid">

							<div e-columns>
								<div e-column e-headertext="Actions" e-width="80">
									<button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk" title="GRN Un Check" ng-click="$parent.onClickGRNCheckedUpdate('GridPO');" style="margin: -6px;"></i></button>
									<button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.AllTabPrint('GridPO');" style="margin: -6px;"></i></button>
								</div>
								<div e-column e-field="GateName" e-headertext="Gate Name" e-width="120"></div>
								<div e-column e-field="GateEntryNo" e-headertext="Gate Entry No" e-width="120"></div>
								<div e-column e-field="GRNType" e-headertext="Type" e-width="80"></div>
								<div e-column e-field="PartyName" e-headertext="Vendor" e-width="200"></div>
								<div e-column e-field="EmployeeName" e-headertext="Employee" e-width="180"></div>
								<div e-column e-field="Id" e-headertext="GRN No" e-width="120"></div>
								<div e-column e-field="GRNDate" e-headertext="GRN Date" e-width="120"></div>
								<div e-column e-field="TransactionQty" e-headertext="Received Qty" textAlign='Right' e-width="150"></div>
								@*<div e-column e-template="#ToBeApprovedBy" e-headertext="To Be Approved By" e-width="190"></div>
									<div e-column e-template="#RejectCheckedReason" e-headertext="Hold / Reject Reason" e-width="200" style="height: 20px;"></div>
									<div e-column e-template="#CheckbyStatus" e-headertext="Check by Status" e-width="130"></div>*@


								<div e-column e-field="Shortageqty" e-headertext="Shortage Qty" textAlign='Right' e-width="150"></div>
								<div e-column e-field="ShortageRatePercent" e-headertext="Shortage(Percentage)" textAlign='Right' e-width="150"></div>
								<div e-column e-field="ShortageValue" e-headertext="Shortage Value" textAlign='Right' e-width="150"></div>
								<div e-column e-field="RejectionQty" e-headertext="Rejection Qty" textAlign='Right' e-width="150"></div>
								<div e-column e-field="RejectRatePercent" e-headertext="Rejection(Percentage)" textAlign='Right' e-width="150"></div>
								<div e-column e-field="RejectionValue" e-headertext="Rejection Value" textAlign='Right' e-width="150"></div>
								<div e-column e-field="RejectClamPercent" e-headertext="RejectionClam(Percentage)" textAlign='Right' e-width="150"></div>
								<div e-column e-field="NetQty" e-headertext="Net Qty" textAlign='Right' e-width="150"></div>
								<div e-column e-field="TransactionAmount" e-headertext="Amount(TRN)" textAlign='Right' e-width="120"></div>
								<div e-column e-field="TotalMaterialTranAmount" e-headertext="Total Material Tran Amount" textAlign='Right' e-width="120"></div>
								<div e-column e-field="TotalMaterialBooksCurrencyAmount" e-headertext="Total Material Books Currency Amount" textAlign='Right' e-width="120"></div>
								<div e-column e-field="ServiceTranAmount" e-headertext="Service Amount " textAlign='Right' e-width="150"></div>
								<div e-column e-field="ServiceTaxTranAmount" e-headertext="Service Tax " textAlign='Right' e-width="150"></div>
								<div e-column e-field="MaterialTaxAmount" e-headertext="Material Tax" textAlign='Right' e-width="150"></div>
								<div e-column e-field="RequisitionNumber" e-headertext="Requisition Number" textAlign='Right' e-width="150"></div>

							</div>
						</div>
					</div>
					<script id="tabGridContents" type="text/x-jsrender">
						<div class="tabcontrol" id="Test">
							<ul>
								<li><a href="#gridTab{{:Id}}">GRN Details</a></li>
								<li><a href="#gridTab1{{:Id}}">GRN Checked Status</a></li>
								<li><a href="#gridTab2{{:Id}}">Attached Documents List</a></li>
							</ul>
							<div id="gridTab{{:Id}}">
								<div id="detailGrid"></div>
							</div>

							<div id="gridTab1{{:Id}}">
								<div>
									<div class='employee-details'>
										<ul>
											<li><label style="color:maroon;">Account Group:</label><span style="padding-left:8px">{{:PartyAccountGroupName}}</span></li>
											<li><label style="color:maroon;">Vendor Ref No:</label><span style="padding-left:8px">{{:DocRefNo}}</span></li>
											<li><label style="color:maroon;">Prepared By:</label><span style="padding-left:8px">{{:AddedBy}}</span></li>
											<li><label style="color:maroon;">Checked By:</label><span style="padding-left:8px">{{:CheckedBy}}</span></li>
											<li><label style="color:maroon;">Checked Status:</label><span style="padding-left:8px">{{:CheckedByStatus}}</span></li>
											<li><label style="color:maroon;">Authorized By:</label><span style="padding-left:8px">{{:AuthorizedBy}}</span></li>
											<li><label style="color:maroon;">Authorized Status:</label><span style="padding-left:8px">{{:AuthorizedByStatus}}</span></li>
											<li><label style="color:maroon;">Hold /Reject Reason:</label><span style="padding-left:8px">{{:CheckedHoldRejectReason}}</span></li>
											<li><label style="color:maroon;">Appr.No:</label><span style="padding-left:8px">{{:CtnId}}</span></li>
										</ul>
									</div>
								</div>
							</div>


							<div id="gridTab2{{:Id}}">
								<div id="detailGrid1" style="width:800px;"></div>
							</div>
						</div>
					</script>
				@*</div>*@
			</fieldset>
		</div>
