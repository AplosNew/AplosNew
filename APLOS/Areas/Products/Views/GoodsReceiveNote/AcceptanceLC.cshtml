<div class="modal fade site-modal in" id="serviceChargePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Acceptance Charges Entry<button type="button" class="close" ng-click="closeServiceChargePopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" id="div_svc">
                        <label class="col-sm-4 col-md-4 control-label">Charge<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="Service" name="Service" ng-model="AcceptanceCharges.Id" class="col-sm-3 form-control"
                                        ng-options="item.Id as item.UserName for item in AcceptanceChargesList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                   
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" id="div_svcRate">
                        <label class="col-sm-4 control-label" data-placement="top" title="Cost and Manufacture">Amount<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-8" style="padding-left:0px;padding-right:0px;">
                                <input type="text" name="Amount" n-decimals="{{currencyPrecision}}" ng-model="AcceptanceCharges.Amount" class="form-control text-right" placeholder="0.00" />
                            </div>
                            <div class="col-sm-4" style="padding-left:0px;padding-right:0px;">
                                <input type="text" ng-model="serviceModel.CurrencyName" class="form-control" disabled />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12 modal-table table-responsive" style="padding-top: 13px;" ng-show="taxCategoryList.length>0">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Tax Category</th>
                                <th>HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in taxCategoryList">
                                <td>{{x.UserName}}</td>
                                <td>{{x.HSNCode}}</td>
                                <td class="text-right">{{x.Percentage}}</td>
                                <td class="text-right">
                                    <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.TaxAmount" ng-keyup="sumSvcTaxAmount();" class="form-control text-right" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right">Total Tax (BC)</td>
                                <td class="text-right">{{serviceModel.TotalTaxAmount| setDecimal:currencyPrecision}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="acceptanceCharges()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Add</button></li>
                        <li><button ng-click="closeServiceChargePopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>



