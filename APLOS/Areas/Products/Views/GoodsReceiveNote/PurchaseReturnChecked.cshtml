
<style>
	.modellgModify {
		width: 1100px;
	}
</style>
<togglable name="Purchase Return Checked Status"></togglable>
<div id="test">

	<div class="tab-design" id="tab_show">
		<div class="site-tab">
			<ul class="nav nav-tabs" role="tablist">
				<li role="presentation" ng-class="{ active: isSetGatePassUnCheckedList(1) }"><a ng-click="setTabGatePassUnCheckedList(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Un Checked List</a></li>
				<li role="presentation" ng-class="{ active: isSetGatePassHoldRejectList(2) }"><a ng-click="setTabGatePassHoldRejectList(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Hold / Reject List</a></li>
				<li role="presentation" ng-class="{ active: isSetGatePassCheckedList(3) }"><a ng-click="setTabGatePassCheckedList(3)" href="" aria-controls="address" role="tab" data-toggle="tab">Checked List</a></li>
			</ul>
		</div>
		<div class="tab-content">
			<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetGatePassUnCheckedList(1), active: isSetGatePassUnCheckedList(1) }">
				<fieldset class="scheduler-border">
					<legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
                    <div class="content-container-fluid" style="color:black;" id="GatePassUncheckList1">
                        @*e-allowselection="true"*@
                        <div style="color:black;" id="GatePassUncheckList" ej-grid e-datasource="CheckedApproved"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                             e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true"
                                e-detailstemplate="detailTemppurchaseReturn"
                                 e-detailsdatabound="detailgridpurchaseReturn"
                             e-scrollsettings="scroll"
                             e-actioncomplete="ScrollGatePassUncheckList">
                            @*e-actioncomplete="ScrollForPendingRequisition"*@
                            <div e-columns>

                                <div e-column e-field="Id" e-headertext="PR Number" e-width="80"></div>
                                <div e-column e-field="PartyName" e-headertext="Vendor Name" e-width="80"></div>
                                <div e-column e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="80"></div>
                                <div e-column e-field="POReturnDate" e-headertext="Purchase Return Date" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                                <div e-column e-field="DocRefNo" e-headertext="Vendor DocNo" e-width="80"></div>
                                <div e-column e-field="DocDate" e-headertext="Vendor Doc Date" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                                @*<div e-column e-field="TransactionAmount" e-headertext="Amount(TRN)" e-width="80"></div>*@
                                <div e-column e-field="TransactionQty" e-headertext="TransactionQty" e-width="80"></div>
                                <div e-column e-field="BaseAmount" e-headertext="Total Amount" e-width="80"></div>
                                <div e-column e-field="AddedBy" e-headertext="Prepared By" e-width="120"></div>
                                <div e-column e-field="CheckedBy" e-headertext="Checked By" e-width="120"></div>
                                <div e-column e-field="CheckedByStatus" e-headertext="Checked Status" e-width="100"></div>
                                @*<div e-column e-field="CheckedHoldRejectReason" e-headertext="Hold / Reject Reason" e-width="100"></div>*@
                                <div e-column e-template="#ToBeApprovedBy" e-headertext="To Be Approved By" e-width="250"></div>
                                <div e-column e-template="#CheckedHoldRejectReason" e-headertext="Hold / Reject Reason" e-width="250" style="height: 20px; padding-top:-15px;"></div>
                                <div e-column e-template="#CheckedByStatus" e-headertext="Checked Status" e-width="150"></div>
                                <div e-column e-headertext="Actions" e-width="80">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk" title="Checked/H/R" ng-click="$parent.onClickGatePassChecked('GatePassUncheckList');" style="margin: -6px;"></i></button>
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.AllTabPrint('GatePassUncheckList');" style="margin: -6px;"></i></button>
                                </div>



                            </div>

                        </div>
                        <script id="tabGridpurchaseContents" type="text/x-jsrender">
                            <div class="tabcontrol" id="Test">
                                <ul>
                                    <li><a href="#gridTab{{:Id}}">Purchase Return Details</a></li>
                                    <li><a href="#gridTab2{{:Id}}">Purchase Return  Status</a></li>
                                </ul>
                                <div id="gridTab{{:Id}}">
                                    <div id="detailGridPR"></div>
                                </div>
                                <div id="gridTab2{{:Id}}">
                                    <div>
                                        <div class='employee-details'>
                                            <ul>
                                                <li><label style="color:maroon;">Checked By:</label><span style="padding-left:8px">{{:CheckedBy}}</span></li>
                                                <li><label style="color:maroon;">Checked By Status:</label><span style="padding-left:8px">{{:CheckedByStatus}}</span></li>
                                                <li><label style="color:maroon;">Approved By:</label><span style="padding-left:8px">{{:ApprovedBy}}</span></li>
                                                <li><label style="color:maroon;">Approved By Status:</label><span style="padding-left:8px">{{:ApprovedByStatus}}</span></li>
                                                <li><label style="color:maroon;">Checked (Hold/Reject) Reason:</label><span style="padding-left:8px">{{:CheckedHoldRejectReason}}</span></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </script>
                    </div>
					<script type="text/template" id="ToBeApprovedBy">
						<div class="">
							<div id="control">
								<input ej-dropdownlist e-datasource="$parent.ApprovedByList" e-value="data.ApprovedBy" e-fields-text="Text" e-fields-value="Value" e-width="100%" />
							</div>
						</div>
					</script>
					<script type="text/template" id="CheckedByStatus">
						<div class="">
							<div id="control1">
								<input id="combo-default" type="text" e-fields-text="Text" e-fields-value="Value" ej-combobox e-datasource="$parent.checkedstatusList" e-value="data.CheckedByStatus" e-width="100%" />
							</div>
						</div>
					</script>
					<script type="text/template" id="CheckedHoldRejectReason">
						<input type="text" ng-model="data.CheckedHoldRejectReason" style="color:black;" class="form-control" />
					</script>
				</fieldset>
			</div>


			<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetGatePassHoldRejectList(2), active: isSetGatePassHoldRejectList(2) }">
				<fieldset class="scheduler-border">
					<legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
                    <div class="content-container-fluid" style="color:black;" id="GatePassHoldRejectList1">
                        @*e-allowselection="true"*@
                        <div style="color:black;" id="GatePassHoldRejectList" ej-grid e-datasource="CheckedApproved"
