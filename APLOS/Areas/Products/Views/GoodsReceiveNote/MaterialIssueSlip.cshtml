<div class="modal fade site-modal in" id="ShowMachineInventoryIssue" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="clearfix"></div>
                    <div class="table-responsive modal-table">
                        <table class="table table-responsive table-striped">
                            <thead>
                                <tr>
                                    <th>Machine</th>
                                    <th>Qty</th>
                                    <th>Remarks</th>
                                    <th class="text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="input-group">
                                            <input type="text" name="MachineName" ng-model="modelNew.MachineName" class="form-control" readonly required>
                                            <span class="input-group-btn">
                                                <button ng-click="showMachinePopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                                <button ng-click="clearMachine()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                            </span>
                                        </div>
                                    </td>
                                    <td id="td_TaxCodeAmount">
                                        <div class="show-message">
                                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="modelNew.Qty">
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <textarea type="text" name="remarks" class="form-control" maxlength="350" rows="1" ng-model="modelNew.Remarks" tabindex="4" capitalize></textarea>
                                        </div>
                                    </td>
                                    <td class="text-right">
                                        <a ng-click="addMachine();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                                    </td>
                                </tr>
                                <tr ng-repeat="x in machineQtyList| filter:{  MaterialMasterId:tempMaterialMasterId}">
                                    <td>{{x.MachineName}}</td>
                                    <td>{{x.Qty}}</td>
                                    <td class="text-right">{{x.Remarks}}</td>
                                    <td class="text-right">
                                        <button ng-click="removeMachineRow(x.Id,$index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot ng-show="machineQtyList.length">
                                <tr>
                                    <td colspan="2"><b>Sub Total</b></td>
                                    <td class="text-right"><b>{{ machineQtyList | sumByKey : 'Qty' }}</b></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td colspan="2"><b>Total Amount</b></td>
                                    <td class="text-right"><b>{{TotalSumAfterTCSVal}}</b></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="GetPopUpMachineInventoryIssueClosed();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- #region Material Master -->
<div class="modal fade site-modal in" id="MachinePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Machine (Mst)<button type="button" class="close" data-dismiss="modal">&times;</button> </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="machinepopUpParameters.searchBy">
                                            <option ng-repeat="option in machinepopUpList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="machinepopUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <td>MaterialType</td>
                                <td>MaterialGroupMaster</td>
                                <td>ProductMaster</td>
                                <td>Material</td>
                                <td>AssetMaster</td>
                                <td>SKU</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in machinepopUpDataList|itemsPerPage:machinepopUpParameters.pageSize" total-items="machinepopUpParameters.total_count"
                                pagination-id="metaData.name + 'machinepopUpDataList'" ng-dblclick="selectMichineDoubleClick(x)">
                                <td>{{x.MaterialType}}</td>
                                <td>{{x.MaterialGroupMaster}}</td>
                                <td>{{x.ProductMaster}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.AssetMaster}}</td>
                                <td>{{x.SKU}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'machinepopUpDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getPopUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="closeMichinePopUp()" class="btn">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->

<ej-dialog id="workCenterPopUp" title=" Work Center" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-width="550" e-target="#tarekcontainer" e-open="enableBtn">
    <div class="row" style="width:540px">
        <div class="col-xs-12 col-sm-12">
            <div id="GridSelectWC" ej-grid e-datasource="workCenterList" e-recorddoubleclick="SetworkCenter"
                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="true" e-responsive="true"
                 e-allowscrolling="true" e-allowselection="false" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="Plant" e-headertext="Plant" e-width="3"></div>
                    <div e-column e-field="Entity" e-headertext="Entity" e-width="3"></div>
                    <div e-column e-field="Code" e-headertext="Code" e-width="2"></div>
                    <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
                </div>

            </div>

        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="CloseWorkCenter();" class="btn">Close</button></li>
            </ul>
        </div>
    </div>
</ej-dialog>
