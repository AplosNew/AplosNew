<style>
    .modellgModify {
        width: 1460px;
    }
</style>
<div class="modal fade site-modal in" id="ListOfSo" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">  List <button type="button" class="close" ng-click="ClsoeListOfSo();">&times;</button></div>
            <div style="padding-left: 100px;color:maroon;font-weight:bolder;"><label id="totalGRN" ng-model="totalGRNVal" class="text-right">GRN No:{{GRNDetailNo}}</label></div>
            <div style="padding-left: 100px;color:maroon;font-weight:bolder;"><label id="totalGRN" ng-model="totalGRNVal" class="text-right">Total GRN Qty:{{GRNTrnQty}}{{GRNUOM}}</label></div>
            <div class="modal-body ">
                <div class="row">
                    <div class="col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Select</th>
                                        <th>Material Master</th>
                                        <th>Article</th>
                                        <th>SKU1</th>
                                        <th>SKU2</th>
                                        <th>SKU3</th>
                                        <th>Qty</th>
                                        <th>Base Qty</th>
                                        <th>Sale Order</th>
                                        <th>PO No</th>
                                        <th>PO Detail No</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in OutSourceReceiptDetailData">
                                        <td>
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" ng-model="x.Active">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </td>
                                        <td>{{x.MaterialMasterName}}</td>
                                        <td>{{x.ArticleName}}</td>
                                        <td>{{x.FirstCharacteristicsValue}}</td>
                                        <td>{{x.SecondCharacteristicsValue}}</td>
                                        <td>{{x.ThirdCharacteristicsValue}}</td>
                                        <td><input type="text" class="form-control text-right" id="TransactionQty" ng-model="x.TransactionQty " n-decimals="2" tabindex="11" ng-change="calculateAllocationQty(x)" autocomplete="off">{{x.TransactionUoM}}</td>
                                        <td class="text-right">{{x.BaseQty}}{{x.BaseUoM}}</td>
                                        <td class="text-right">{{x.SalesOrderId}}</td>
                                        <td class="text-right">{{x.POId}}</td>
                                        <td class="text-right">{{x.PODetailsId}}</td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-right"><strong>Total : </strong></td>
                                        <td class="text-right"><strong>{{OutSourceReceiptDetailData | sumByKey : 'TransactionQty' }}</strong></td>
                                        <td colspan="3" class="text-right"><strong>Total : </strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="UpdateJWSOAllocation();" class="btn"> Save</button></li>
                    <li><button ng-click="ClsoeListOfSo();" class="btn"> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>


<confirm-archive-generic modalid="poapprovealert" title="Confirmation" message={{message}} data-ng-click-right-button="GRNCheckedBy();"></confirm-archive-generic>
<confirm-archive-generic modalid="poapprovalalert1" title="Confirmation" message={{message}} data-ng-click-right-button="SaveUpdate();"></confirm-archive-generic>



