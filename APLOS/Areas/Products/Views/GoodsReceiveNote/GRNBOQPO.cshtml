
<togglable name="GRN BOQ"></togglable>
<div class="form-horizontal form-elements" ng-form="productNewForm">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSetGRNBOQList(1) }"><a ng-click="setTabGRNBOQList(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Search BOQ</a></li>
            @*<li role="presentation" ng-class="{ active: isSetGRNAcceptance(2) }"><a ng-click="setTabGRNAcceptance(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Search Acceptance</a></li>*@
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetGRNBOQList(1), active: isSetGRNBOQList(1) }">
            <div ng-form="tabForm1">
                <div class="row">
                    <div class="col-xs-12 col-sm-5 col-md-5">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Vendor<sup>*</sup></label>
                            <div class="col-sm-7">
                                <div class="input-group">
                                    <span class="input-group-addon"> {{productNew.PartyCode}}</span>
                                    <input type="text" name="Vendor" id="Vendor" ng-model="productNew.PartyName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="showPartyPopUpNew()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                        <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                                    </span>
                                </div>
                            </div>
                            <div class="col-sm-2 show-message" style="padding-left:0px;">
                                <div class="common-btn">
                                    <button ng-click="GetItemVendor();" class="btn"><i class="glyphicon glyphicon-circle-arrow-down"></i>Select</button>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="GriddataSelected.length>0">
                        <div style="color:black;" id="GriddataSelected" ej-grid e-datasource="GriddataSelected"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="MaterialName" e-headertext="Material" e-width="200"></div>
                                <div e-column e-field="ArticleName" e-headertext="Article" e-width="200"></div>
                                <div e-column e-field="VendorRefNo" e-headertext="Vendor Ref No" e-width="150"></div>
                                <div e-column e-field="CustomerRefNo" e-headertext="Customer Ref No" e-width="100"></div>
                                <div e-column e-field="OwnReferenceNo" e-headertext="OwnReferenceNo" e-width="80"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="DetailList.length>0">
                        <div style="color:black;" id="GriddataSelecteds" ej-grid e-datasource="DetailList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-template="#select" e-headertext="Select" e-width="80"></div>
                                <div e-column e-type="string" e-field="POId" e-headertext="PO No" e-width="100"></div>
                                <div e-column e-type="string" e-field="CustomerName" e-headertext="Customer" e-width="200"></div>
                                <div e-column e-type="string" e-field="ContractId" e-headertext="ContractId" e-width="150"></div>
                                <div e-column e-type="string" e-field="MasterOrderId" e-headertext="MasterOrderId" e-width="100"></div>
                                <div e-column e-type="string" e-field="SalesOrderId" e-headertext="SalesOrderId" e-width="80"></div>
                            </div>
                        </div>
                        <script type="text/template" id="select">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.IsActives" e-checked="data.IsActives" />
                        </script>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-md-12 text-right" ng-show="DetailList.length>0">
                        <div class="form-group">
                            <div class="common-btn">
                                <button ng-click="getDetailsData();" class="btn"> <i class="glyphicon glyphicon-download"></i>Go</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")
<div class="modal fade site-modal in" id="invoicingPartyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Invoicing Party<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 col-md-4 control-label">Invoicing by :</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select ng-model="productNew.InvoicingPartyPlantId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in plantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(productNew.InvoicingPartyPlantId,'billTo')">
                                    <option value=""></option>
                                </select>
                            </div>

                            <p>{{productNew.InvoicingByName}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">State :{{productNew.InvoicingState}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">GSTIN :{{productNew.InvoicingGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Invoicing by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="productNew.InvoicingByAddress" class="form-control" readonly></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="productNew.DeliveryPartyPlantId" ng-options="item.Value as item.Text for item in plantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(productNew.DeliveryPartyPlantId,'shipTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p>{{productNew.InvoicingByName}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">State :{{productNew.DeliveryState}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">GSTIN :{{productNew.DeliveryGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="productNew.DeliveryByAddress" class="form-control" readonly></textarea>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeInvoicingPartyPopUp();" class="btn"> Done</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="itemPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">ItemList<button type="button" class="close" ng-click="closeItemPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-lg-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll" >
                        <div style="color:black;" id="itemPopUp" ej-grid e-datasource="itemList"
                             e-templaterefresh="refreshTemplateMasterOrderOperation"
                             e-recorddoubleclick=""
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-template="#checkboxList" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="MaterialName" e-headertext="Material" e-width="200"></div>
                                <div e-column e-field="ArticleName" e-headertext="Article" e-width="200"></div>
                                <div e-column e-field="VendorRefNo" e-headertext="Vendor Ref No" e-width="150"></div>
                                <div e-column e-field="CustomerRefNo" e-headertext="Customer Ref No" e-width="100"></div>
                                <div e-column e-field="OwnReferenceNo" e-headertext="OwnReferenceNo" e-width="80"></div>
                            </div>

                        </div>
                        <script type="text/template" id="checkboxList">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                        </script>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="recorddoubleclick();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Add</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

