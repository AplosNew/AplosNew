                            <tr ng-repeat="x in taxCategoryList">
                                <td>{{x.UserName}}</td>
                                <td>{{x.HSNCode}}</td>
                                @*<td class="text-right">{{x.Percentage}}</td>
                                    <td class="text-right">
                                        <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.TaxAmount" ng-keyup="sumSvcTaxAmount();" class="form-control text-right" />
                                    </td>*@
                                <td class="text-right">
                                    <input type="text" n-decimals="4" ng-model="x.Percentage" ng-keyup="calculateTaxAmountForService1(x);" class="form-control text-right" ng-disabled="productNew.TaxOptionService1==='No'" />
                                </td>
                                <td class="text-right">
                                    <input type="text" n-decimals="2" ng-model="x.TaxAmount" ng-keyup="checkRowValidationService1(x);" class="form-control text-right" ng-disabled="productNew.TaxOptionService1==='Yes'" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right">Total Tax (BC)</td>
                                @*<td class="text-right">{{serviceModel.TotalTaxAmount| setDecimal:currencyPrecision}}</td>*@
                                <td class="text-right"><strong>{{taxCategoryList | sumByKey : 'TaxAmount'| setDecimal:2 }}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="serviceSave()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{detailModel.Id.length>0?'Update':'Save'}}</button></li>
                        <li><button ng-click="closeServiceChargePopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="receiveTaxPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header"> Tax Information<button type="button" class="close" ng-click="closeReceiveTaxPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <p>Taxable amount : <b>{{taxAbleAmnt| number| setDecimal:currencyPrecision}}</b></p>
                    <p>HSNCode : <b>{{HSNCode}}</b></p>
                    <div class="clearfix"></div>
                    <div class="form-group">
                        <label class="col-sm-6 control-label">If Percentage Applicable</label>
                        <div class="col-sm-6">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="TaxOptionMat" ng-model="productNew.TaxOptionMat" value="Yes" ng-click="TaxOptionMat('Yes');" checked="checked"> @*ng-hide="HSNCode !=null"*@
                                    <span class="cr"><i class="cr-icon"></i></span>Yes
                                </label>
                                <label>
                                    <input type="radio" name="TaxOptionMat" ng-model="productNew.TaxOptionMat" value="No" ng-click="TaxOptionMat('No');">@*ng-hide="HSNCode !=null"*@
                                    <span class="cr"><i class="cr-icon"></i></span>No
                                </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th ng-hide="true">id</th>
                                    <th>Tax Category</th>
                                    <th ng-hide="percentageColumn">Percentage</th>
                                    <th>Tax Amount (BC)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in receiveTaxList" ng-show="receiveTaxList.length">
                                    <td ng-hide="true">
                                        <div class="show-message">
                                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Id" readonly>
                                        </div>
                                    </td>
                                    <td>{{x.TaxCategory}}</td>
                                    <td><input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Percentage" ng-disabled="productNew.TaxOptionMat==='No'" ng-keyup="calculateTaxAmountForMat(x, $index)"></td>  @*ng-keyup="checkRowValidation(x, $index)"*@
                                    <td><input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TaxAmount" ng-disabled="productNew.TaxOptionMat==='Yes'" ng-keyup="checkRowValidationMat(x, $index)"></td>  @*ng-keyup="checkRowValidation(x, $index)"*@
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-right"><strong>{{receiveTaxList | sumByKey : 'TaxAmount'| setDecimal:2| number:2 }}</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-show="productNew.Id" ng-click="MaterialTaxUpdate();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Update</button></li>
                        <li><button ng-click="closeReceiveTaxPopUpNew();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

