<style>
    .modelWithModify {
        width: 1400px;
    }
</style>
<togglable name="GRN BOQ"></togglable>
<div class="form-horizontal form-elements" ng-form="productNewForm" id="MainDivIds">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSetGRNBOQList(1) }"><a ng-click="setTabGRNBOQList(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Search BOQ</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetGRNBOQList(1), active: isSetGRNBOQList(1) }">
            <div ng-form="tabForm1">
                <div class="row">
                    <div class="col-xs-12 col-sm-5 col-md-5">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Vendor<sup>*</sup></label>
                            <div class="col-sm-7">
                                <div class="input-group">
                                    <span class="input-group-addon"> {{productNew.PartyCode}}</span>
                                    <input type="text" name="Vendor" id="Vendor" ng-model="productNew.PartyName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="showPartyPopUpNew()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                        <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                                    </span>
                                </div>
                            </div>
                            <div class="col-sm-2 show-message" style="padding-left:0px;">
                                <div class="common-btn">
                                    <button ng-click="GetItemVendor();" class="btn"><i class="glyphicon glyphicon-circle-arrow-down"></i>Select Material</button>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="GriddataSelected.length>0">
                        <div style="color:black;" id="GriddataSelected" ej-grid e-datasource="GriddataSelected"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="MaterialName" e-headertext="Material" e-width="200"></div>
                                <div e-column e-field="ArticleName" e-headertext="Article" e-width="200"></div>
                                <div e-column e-field="VendorRefNo" e-headertext="Vendor Ref No" e-width="150"></div>
                                <div e-column e-field="CustomerRefNo" e-headertext="Customer Ref No" e-width="100"></div>
                                <div e-column e-field="OwnReferenceNo" e-headertext="OwnReferenceNo" e-width="80"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="DetailList.length>0">
                        <div style="color:black;" id="GriddataSelecteds" ej-grid e-datasource="DetailList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-template="#select" e-headertext="Select" e-width="80"></div>
                                <div e-column e-type="string" e-field="POId" e-headertext="PO No" e-width="80"></div>
                                <div e-column e-type="string" e-field="CustomerName" e-headertext="Customer" e-width="180"></div>
                                <div e-column e-type="string" e-field="ContractNo" e-headertext="Contract No" e-width="100"></div>
                                <div e-column e-type="string" e-field="StyleNo" e-headertext="Style No" e-width="200"></div>
                                <div e-column e-type="string" e-field="POClose" e-headertext="PO_Close" e-width="100"></div>
                                <div e-column e-type="string" e-field="OwnReferenceNo" e-headertext="Own Ref No" e-width="100"></div>
                                <div e-column e-type="string" e-field="MasterOrderId" e-headertext="MasterOrderId" e-width="100"></div>
                                <div e-column e-type="string" e-field="SalesOrderId" e-headertext="SalesOrderId" e-width="80"></div>
                                <div e-column e-type="string" e-field="CurrencyCode" e-headertext="Currency" e-width="80"></div>
                            </div>
                        </div>
                        <script type="text/template" id="select">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.IsActives" e-checked="data.IsActives" />
                        </script>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-md-12 text-right" ng-show="DetailList.length>0">
                        <div class="form-group">
                            <div class="common-btn">
                                <button ng-click="getDetailsData();" class="btn"> <i class="glyphicon glyphicon-download"></i>Go</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">GRN Info</legend>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <span class="input-group-addon">{{productNew.PartyId}}</span>
                                <input type="text" name="Vendor" ng-model="productNew.PartyName" class="form-control" required readonly>
                                <span class="input-group-btn">
                                    <button name="submit" ng-click="showPartyPopUp()" ng-disabled="true" class="btn single-small-btn" tabindex="1" disabled><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 pdl3 pdr3">
                    <div class="col-md-8">
                        <div class="form-group" id="div_docNo">
                            <label class="col-sm-6 control-label">Vendor Doc. RefNo<sup>*</sup></label>
                            <div class="col-sm-6 show-message pdr3">
                                <input type="text" name="DocRefNo" ng-model="productNew.DocRefNo" class="form-control" ng-keyup="modelValidation('div_docNo', 'productNew', 'DocRefNo');CheckSpecialCharecter();" maxlength="300" tabindex="2" autocomplete="off">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group" id="div_docDate">
                            <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                            <div class="col-sm-9 show-message pdl3">
                                @*ng-disabled="productNew.PartyName!=null"*@
                                <input type="text" name="Date" ng-model="productNew.DocDate" datepicker="modelValidation('div_docDate', 'productNew', 'DocDate');changePaymentTerm();getToCurrencyRate();" end-date="currentDate" id="cutOffDate1" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="3">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-6 pdl3 pdr3">
                    <div class="col-md-8">
                        <div class="form-group" id="div_entryNo">
                            <label class="col-sm-6 control-label">Gate Entry No<sup>*</sup></label>
                            <div class="col-sm-6 show-message">
                                <div class="input-group">
                                    <input type="text" name="Gate Entry No" ng-model="productNew.GateEntryNo" class="form-control" readonly required>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-disabled="inventoryMaterialList.length>0" ng-click="POPopUpGateEntry()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group" id="div_entryDate">
                            <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                            <div class="col-sm-9 show-message pdl3">
                                <input type="text" name="Entry Date" ng-model="productNew.EntryDate" ng-disabled="true" datepicker="modelValidation('div_entryDate', 'productNew', 'EntryDate');" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="5">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 pdl3 pdr3">
                    <div class="col-md-8">
                        <div class="form-group" id="div_grnNo">
                            <label class="col-sm-6 control-label">GRN No<sup>*</sup></label>
                            <div class="col-sm-6 show-message pdr3">
                                <input type="text" name="GRN No" ng-model="productNew.Id" class="form-control" maxlength="10" disabled>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group" id="div_grnDate">
                            <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                            <div class="col-sm-9 show-message pdl3">
                                <input type="text" name="GRN Date" ng-disabled="false" ng-model="productNew.GRNDate" datepicker="modelValidation('div_grnDate', 'productNew', 'GRNDate');getTaxCodeByTaxYearWithhold(productNew.GRNDate)" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="6">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 col-md-4 control-label">Storage Location<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Storage Location" ng-model="productNew.MaterialStorageId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in storageList" tabindex="7" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 pdl3 pdr3">
                    <div class="col-md-8">
                        <div class="form-group" id="div_currency">
                            <label class="col-sm-6 control-label">Currency<sup>*</sup></label>
                            <div class="col-sm-6 show-message pdr3">
                                <div class="select-style">
                                    <select class="form-control" id="currency" ng-disabled="MasterList.length>0 " ng-model="productNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList"
                                            ng-change="changeCurrency();getToCurrencyRate();manualValidationAddRemove('div_currency', 'productNew', 'CurrencyId');" tabindex="8">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group" id="div_rate">
                            <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Rate<sup ng-hide="productNew.CurrencyId==productNew.BaseCurrencyId">*</sup></label>
                            <div class="col-sm-9 show-message pdl3">
                                <input type="text" n-decimals="{{currencyPrecision}}" name="GRN Date" ng-model="productNew.ToCurrencyRate" ng-disabled="true" ng-keyup="manualValidationAddRemove('div_rate', 'productNew', 'ToCurrencyRate');" class="form-control text-right" tabindex="9">@*ng-disabled="productNew.CurrencyId==productNew.BaseCurrencyId||inventoryMaterialList.length>0 || AcceptanceId !=null"*@
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Non Creditable</label>
                        <div class="col-sm-1">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-disabled="MasterList.length>0 || inventoryMaterialList.length>0" ng-model="productNew.IsNonCreditable">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label" ng-show="checkedByList.length">{{productNew.labelCheckAndApproved}}<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style" ng-show="checkedByList.length">
                                <select id="CheckedBy" class="form-control" name="Checked By" ng-model="productNew.CheckedBy" tabindex="12" required>
                                    <option ng-repeat="option in checkedByList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Note For Accounts<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <textarea name="NoteForAccounts" class="form-control" rows="2" ng-model="productNew.NoteForAccounts" tabindex="7"></textarea>
                        </div>
                    </div>
                </div>
            </fieldset>
            <div class="clearfix"></div>
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Material</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Charges</a></li>
                    <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Documents Attach</a></li>
                    <li><label class="control-label" style="color:maroon;font-weight:bold;">{{productNew.msgForAllocationNeed}}</label></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div ng-form="tabForm1">
                        <div class="col-md-6 text-left" style="padding-top: 17px;" ng-show="MasterList.length>0">
                            <div>
                                <table class="table-responsive modal-table" ng-show="MasterList.length>0">
                                    <tbody>
                                        <tr>
                                            <td></td>
                                            <td>Amount</td>
                                            <td>Tax</td>
                                            <td>Total</td>
                                        </tr>
                                        <tr>
                                            <td>Materials</td>


                                            <td>{{MasterList | sumByKey : 'TrnAmount'| setDecimal:2| number }}</td>
                                            <td>{{MasterList | sumByKey : 'BaseTaxAmount'| setDecimal:2| number:2}}</td>
                                            <td>{{(MasterList | sumByKey : 'TrnAmount'| setDecimal:2)+(MasterList | sumByKey : 'BaseTaxAmount' | setDecimal:2)|number}}</td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid;">
                                            <td>Service</td>
                                            <td>{{chargesList | sumByKey : 'Amount'| setDecimal:2| number}}</td>
                                            <td>{{chargesList | sumByKey : 'TotalTaxAmount'| setDecimal:2| number}}</td>
                                            <td>{{(chargesList | sumByKey : 'Amount'| setDecimal:2)+(chargesList | sumByKey : 'TotalTaxAmount'| setDecimal:2)| number}}</td>
                                        </tr>
                                        <tr>
                                            <td></td>
                                            <td></td>
                                            <td>Gross Amount</td>
                                            @*<td>{{(MasterList | sumByKey : 'TrnAmount'| number:2)+(MasterList | sumByKey : 'BaseTaxAmount'| number:2 )+(MasterList | sumByKey : 'ServiceCharge'| number:2)+(MasterList | sumByKey : 'ServiceTax'| number:2)| number:2}}</td>*@
                                            <td>{{(MasterList | sumByKey : 'TrnAmount'| setDecimal:2)+(MasterList | sumByKey : 'BaseTaxAmount'| setDecimal:2)+(chargesList | sumByKey : 'Amount'| setDecimal:2)+(chargesList | sumByKey : 'TotalTaxAmount'| setDecimal:2)| number}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="modal fade site-modal in" id="ListOfRequisition" role="dialog" data-backdrop="static">
                            <div class="modal-dialog modal-lg modellgModify">
                                <div class="modal-content">
                                    <div class="modal-header">Requisition List FOR GRN Qty Allocation<button type="button" class="close" ng-click="MasterOrderListHide();">&times;</button></div>
                                    <div class="modal-body form-elements form-horizontal">
                                        <div style="padding-left: 900px;color:maroon;font-weight:bolder;"><label id="totalGRN" ng-model="totalGRNVal" class="text-right">Total GRN Qty:{{totalGRNVal}}|| RejectionQty:{{RejectionQty}}</label></div>

                                        <div class="col-lg-12">
                                            <div class="content-container-fluid" style="color:black;">
                                                <div style="color:black;" id="GridReq" ej-grid e-datasource="GetListForMasterOrder"
                                                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                                     e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel" e-responsive="true"
                                                     e-enabletouch="true" e-allowselection="true">

                                                    <div e-columns>
                                                        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>

                                                        <div e-column e-field="MaterialGroupMasterName" e-headertext="MaterialGroup" e-width="120"></div>
                                                        <div e-column e-field="UserName" e-headertext="Material Master" e-width="120"></div>
                                                        <div e-column e-field="StandardName" e-headertext="Article" e-width="120"></div>
                                                        <div e-column e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="80"></div>
                                                        <div e-column e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="80"></div>
                                                        <div e-column e-field="ThirdCharacteristicsValue" e-headertext="SKU3" e-width="80"></div>
                                                        <div e-column e-field="DeliveryDate" e-headertext="ReqDate" e-width="80"></div>
                                                        <div e-column e-field="ReqQty" e-headertext="BOQQty/ReqQty" e-width="80"></div>
                                                        <div e-column e-field="POTransactionQty" e-headertext="PoRaisedQty" e-width="80"></div>
                                                        <div e-column e-field="allowQty" e-headertext="AlreadyAllocate" e-width="80"></div>
                                                        <div e-column e-field="TransactionQty" e-template="#CurrentQty" e-headertext="GRNQtyAllocation" e-width="80"></div>
                                                        <div e-column e-field="RejectionQty" e-template="#RejectionQty" e-headertext="RejectionQtyAllocation" e-width="80"></div>
                                                        <div e-column e-field="RequisitionDetailId" e-headertext="ReqRowId" e-width="70"></div>
                                                    </div>

                                                </div>
                                                <script type="text/x-jsrender" id="checkboxTemplate">
                                                    <input type="checkbox" ng-click="$parent.getTaxCategoryList1(this)" ng-model="{{:RequisitionDetailId}}" class="rowCheckbox" value="{{:RequisitionDetailId}}" />
                                                </script>

                                                <script type="text/x-jsrender" id="headerTemplate">
                                                    <input type="checkbox" id="headchk" />
                                                </script>

                                                <script type="text/template" id="CurrentQty">
                                                    <div class="form-group">
                                                        <input type="text" id="a" class="input ejinputtext form-control" ng-disabled="RequisitionDetailId" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.TransactionQty" width="150" ng-change="$parent.calculateRequisitionData(this)" />
                                                    </div>
                                                </script>
                                                <script type="text/template" id="RejectionQty">
                                                    <div class="form-group">
                                                        <input type="text" id="b" class="input ejinputtext form-control" ng-disabled="RequisitionDetailId" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.RejectionQty" width="150" ng-change="$parent.calculateRequisitionData(this)" />
                                                    </div>
                                                </script>
                                                <script type="text/template" id="Rate">
                                                    <div class="form-group">
                                                        <input type="text" id="c" class="input ejinputtext form-control" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.TransactionRate" width="150" ng-change="$parent.calculateRequisitionData(this)" />
                                                    </div>
                                                </script>
                                                <script type="text/template" id="Balance">
                                                    <div class="form-group">
                                                        <input type="text" id="d" class="input ejinputtext form-control" ng-disabled="true" style="background-color:white;font-weight:bold;color:black;text-align:right;" ng-model="data.BalanceQty" width="150" />
                                                    </div>
                                                </script>
                                                <script type="text/template" id="Amount">
                                                    <div class="form-group">
                                                        <input type="text" id="e" class="input ejinputtext form-control" ng-disabled="true" style="background-color:white;font-weight:bold;color:black;text-align:right;" ng-model="data.TransactionAmount" width="150" />
                                                    </div>
                                                </script>
                                                <script type="text/template" id="DelButton">
                                                    <div class="form-group">
                                                        <button ng-click="$parent.valuePassInDelModal(this)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                    </div>
                                                </script>

                                                <div id="GridT"></div>

                                            </div>
                                        </div>
                                        <div class="clearfix"></div>
                                        <div class="common-btn">
                                            <ul class="list-inline text-right">
                                                <li><button ng-click="GrnRequisitionAllocationSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action1}}</button></li>
                                                <li><button ng-click="MasterOrderListHide();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal fade site-modal in" id="ListOfSoBoq" role="dialog" data-backdrop="static">
                            <div class="modal-dialog modal-lg modellgModify">
                                <div class="modal-content">
                                    <div class="modal-header">SO List FOR GRN Qty Allocation<button type="button" class="close" ng-click="ListOfSo();">&times;</button></div>
                                    <div class="modal-body form-elements form-horizontal">
                                        <div style="color:maroon;font-weight:bolder;"><label id="totalGRN" ng-model="totalGRNVal" class="text-right">Total GRN Qty:{{totalGRNVal}}|| RejectionQty:{{RejectionQty}}</label></div>
                                        <div class="col-lg-12">
                                            <div style="color:black;" id="GridReqsoboq" ej-grid e-datasource="soList"
                                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                                                 e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionCompleteSelected"
                                                 e-allowscrolling="true" e-showstackedheader="true" e-allowExcelExport='true' e-enableGroupingBar="true">
                                                <div e-columns>
                                                    <div e-column e-headertext="" e-template="#SOChecked" e-textalign="center" e-width="30"></div>
                                                    <div e-column e-field="MaterialGroupMasterName" e-headertext="Group" e-width="80"></div>
                                                    <div e-column e-field="UserName" e-headertext="Material " e-width="120"></div>
                                                    <div e-column e-field="StandardName" e-headertext="Article" e-width="120"></div>
                                                    <div e-column e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="80"></div>
                                                    <div e-column e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="80"></div>
