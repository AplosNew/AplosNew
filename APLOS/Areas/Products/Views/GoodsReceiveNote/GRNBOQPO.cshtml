
<togglable name="GRN BOQ"></togglable>
<div class="form-horizontal form-elements" ng-form="productNewForm">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSetGRNBOQList(1) }"><a ng-click="setTabGRNBOQList(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Search BOQ</a></li>
            @*<li role="presentation" ng-class="{ active: isSetGRNAcceptance(2) }"><a ng-click="setTabGRNAcceptance(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Search Acceptance</a></li>*@
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetGRNBOQList(1), active: isSetGRNBOQList(1) }">
            <div ng-form="tabForm1">
                <div class="row">
                    <div class="col-xs-12 col-sm-5 col-md-5">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Vendor<sup>*</sup></label>
                            <div class="col-sm-7">
                                <div class="input-group">
                                    <span class="input-group-addon"> {{productNew.PartyCode}}</span>
                                    <input type="text" name="Vendor" id="Vendor" ng-model="productNew.PartyName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="showPartyPopUpNew()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                        <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                                    </span>
                                </div>
                            </div>
                            <div class="col-sm-2 show-message" style="padding-left:0px;">
                                <div class="common-btn">
                                    <button ng-click="GetItemVendor();" class="btn"><i class="glyphicon glyphicon-circle-arrow-down"></i>Select</button>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-5 col-md-5" ng-show="poBoqItemList.length">
                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="GridPrint" ej-grid e-datasource="poBoqItemList" e-allowfiltering="true" e-allowpaging="true"
                                 e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
                                 e-actioncomplete="actionCompleteSelected" e-allowscrolling="true" e-showstackedheader="true">
                                <div e-columns>
                                    <div e-column e-template="#CheckBoxTemp" e-headertemplateid="#headerTemplate11" @*e-headertext="Chk"*@ e-width="40" textAlign='center'></div>

                                    <div e-column e-type="string" e-field="CostingItemId" e-headertext="Costing Item Id" e-width="80px"></div>
                                    <div e-column e-field="CostingItemName" e-headertext="Costing Item" e-width="100"></div>
                                    <div e-column e-field="BOQItemRefNo" e-headertext="Item Ref." e-width="100"></div>
                                    <div e-column e-type="string" e-field="BOQCriteria" e-headertext="BOQ Criteria" e-width="80px"></div>
                                    <div e-column e-type="string" e-field="CriteriaDetail" e-headertext="Criteria Detail" e-width="120px"></div>
                                    <div e-column e-field="BOQId" e-headertext="BOQ System Id" e-width="100"></div>
                                    <div e-column e-field="BOQUOM" e-headertext="BOQUOM" e-width="80" textAlign='Right'></div>
                                    <div e-column e-field="RequiredQtyPO" e-headertext="BOQ Qty" e-width="100" textAlign='Right'></div>
                                    <div e-column e-field="OtherMapQty" e-headertext="OtherBOQ Qty" e-width="100" textAlign='Right'></div>
                                    <div e-column e-field="BalanceQty" e-headertext="Balance Qty" e-width="100" textAlign='Right'></div>
                                    <div e-column e-template="#CurrentTextBOQ" e-field="TransactionQty" e-textalign="right" e-headertext="CurrentQty" e-width="100"></div>
                                    @*<div e-column e-field="TransactionRate" e-textalign="right" e-headertext="BOQRate" e-width="100"></div>*@
                                    <div e-column e-template="#BOQQRate" e-field="TransactionRate" e-textalign="right" e-decimalplaces="4" e-headertext="Rate" e-width="100"></div>
                                    <div e-column e-field="TransactionRateBOQ" e-headertext="BOQRate" e-width="80" e-textalign="right"></div>
                                    <div e-column e-field="RMDescription" e-headertext="Item Desc" e-width="100"></div>
                                    <div e-column e-field="RMVendorSpec" e-headertext="Vendor Ref." e-width="100"></div>
                                    <div e-column e-field="RMCustomerSpec" e-headertext="Customer Ref." e-width="100"></div>
                                    <div e-column e-field="BOQOwnReferenceNo" e-headertext="Own Ref." e-width="100"></div>

                                    <div e-column e-template="#UOM" e-headertext="UoM" e-width="100"></div>

                                    <div e-column e-field="RequiredQty" e-headertext="Required Qty" e-width="100" textAlign='Right'></div>
                                    <div e-column e-type="number" e-field="BOMQty" e-headertext="Plan Qty" e-width="100" textAlign='Right'></div>
                                    @*<div e-column e-type="string" e-field="Currency" e-headertext="Currency" e-width="120px"></div>*@
                                    <div e-column e-type="number" e-field="BOMAmount" e-headertext="Required Amount" e-width="60px"></div>
                                    <div e-column e-type="number" e-field="PlanAmount" e-headertext="Plan Amount" e-width="60px"></div>]
                                    <div e-column e-field="Vendor" e-headertext="Vendor" e-width="300"></div>
                                    <div e-column e-type="string" e-field="MaterialCode" e-headertext="Material Code" e-width="120px"></div>
                                    <div e-column e-field="UserName" e-headertext="Material" e-width="120"></div>
                                    <div e-column e-type="string" e-field="ArticleCode" e-headertext="Article Code" e-width="120px"></div>
                                    <div e-column e-field="StandardName" e-headertext="Article" e-width="120"></div>
                                    <div e-column e-type="string" e-field="SKU1" e-headertext="SKU1" e-width="50px"></div>
                                    <div e-column e-type="string" e-field="SKU2" e-headertext="SKU2" e-width="50px"></div>
                                    <div e-column e-type="string" e-field="SKUDescConcat" e-headertext="SKU Desc." e-width="50px"></div>
                                    <div e-column e-field="SalesOrderId" e-headertext="SO Id" e-width="80"></div>
                                    <div e-column e-field="Destination" e-headertext="Destination" e-width="80"></div>
                                    <div e-column e-type="number" e-field="BOMQty" e-headertext="BOM Qty" e-width="60px"></div>
                                    <div e-column e-type="number" e-field="BalanceToPurchase" e-headertext="Reuse From Inventory" e-format="{0:N2}" e-width="100px"></div>
                                    <div e-column e-field="POCriteria" e-headertext="PO Criteria" e-width="100"></div>
                                    <div e-column e-field="Remark" e-headertext="Remark" e-width="100"></div>
                                    <div e-column e-field="FileName" e-headertext="File Name" e-width="100"></div>


                                    //////////Old
                                    <div e-column e-field="BuyerOrderReferenceNo" e-headertext="BuyerOrder#" e-width="100"></div>
                                    <div e-column e-field="OwnOrderReferenceNo" e-headertext="OwnOrder#" e-width="100"></div>

                                    <div e-column e-field="RequiredQtyApproved" e-headertext="Approved" e-width="100"></div>
                                    <div e-column e-field="IncompleteMaterial" e-headertext="Incomplete" e-width="120"></div>

                                    <div e-column e-field="DeliveryDate" e-headertext="DeliveryDate" e-width="100"></div>
                                    <div e-column e-field="PONumber" e-headertext="PONumber" e-width="100"></div>

                                    <div e-column e-field="MasterOrderId" e-headertext="MasterOrderId" e-width="150"></div>
                                    <div e-column e-field="MasterOrderItemId" e-headertext="MasterOrderItemId" e-width="150"></div>
                                </div>


                            </div>
                            <script type="text/x-jsrender" id="headerTemplate11">
                                <input type="checkbox" id="headchk111" />
                            </script>

                            <script type="text/template" id="CheckBoxTemp">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckedStatus" e-value="data.CheckedStatus" @*e-change="$parent.getTaxCategoryList1"*@ /> @*e-enabled="{{data.RequiredQtyApproved==='1'}}"*@
                            </script>
                            <script type="text/template" id="CurrentTextBOQ">
                                <input type="number" class="input form-control" ng-blur="$parent.refreshQtyTemplete(this)" form-control" ng-disabled="RequisitionDetailId" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.TransactionQty" width="80" @*ng-keyup="$parent.refreshQtyTemplete(this)"*@ />

                            </script>
                            <script type="text/template" id="BOQQRate">
                                <input type="number" class="input ejinputtext form-control" ng-disabled="RequisitionDetailId" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.TransactionRate" width="80" ng-change="$parent.calculateRequisitionData(this)" />

                            </script>
                            <script type="text/template" id="UOM">
                                <div class="select-style">
                                    <select name="Entity" ng-model="data.TransactionUoMId" class="form-control" ng-change="$parent.ConvertedDataRow(data)"
                                            ng-options="item.Value as item.Text for item in data.uoMList"></select>
                                </div>

                            </script>

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")
<div class="modal fade site-modal in" id="invoicingPartyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Invoicing Party<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 col-md-4 control-label">Invoicing by :</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select ng-model="productNew.InvoicingPartyPlantId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in plantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(productNew.InvoicingPartyPlantId,'billTo')">
                                    <option value=""></option>
                                </select>
                            </div>

                            <p>{{productNew.InvoicingByName}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">State :{{productNew.InvoicingState}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">GSTIN :{{productNew.InvoicingGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Invoicing by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="productNew.InvoicingByAddress" class="form-control" readonly></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="productNew.DeliveryPartyPlantId" ng-options="item.Value as item.Text for item in plantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(productNew.DeliveryPartyPlantId,'shipTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p>{{productNew.InvoicingByName}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">State :{{productNew.DeliveryState}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">GSTIN :{{productNew.DeliveryGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="productNew.DeliveryByAddress" class="form-control" readonly></textarea>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeInvoicingPartyPopUp();" class="btn"> Done</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="itemPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">ItemList<button type="button" class="close" ng-click="closeItemPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-lg-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll" >
                        <div style="color:black;" id="itemPopUp" ej-grid e-datasource="itemList"
                             e-templaterefresh="refreshTemplateMasterOrderOperation"
                             e-recorddoubleclick=""
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-template="#checkboxList" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="MaterialName" e-headertext="Material" e-width="200"></div>
                                <div e-column e-field="ArticleName" e-headertext="Article" e-width="200"></div>
                                <div e-column e-field="VendorRefNo" e-headertext="Vendor Ref No" e-width="150"></div>
                                <div e-column e-field="CustomerRefNo" e-headertext="Customer Ref No" e-width="100"></div>
                                <div e-column e-field="OwnReferenceNo" e-headertext="OwnReferenceNo" e-width="80"></div>
                            </div>

                        </div>
                        <script type="text/template" id="checkboxList">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                        </script>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="recorddoubleclick();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Add</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

