<togglable name="IssueSlip Approved/UnApproved List"></togglable>

@*Index Grid*@
@*Taufik create list start*@
<div class="tab-design" id="tab_show">
    <div class="site-tab">

        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSetIssueUnApp(1) }"><a ng-click="SetTabIssueUnApp(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Un Approved</a></li>
            <li role="presentation" ng-class="{ active: isSetIssueHR(3) }"><a ng-click="SetTabIssueHR(3)" href="" aria-controls="general" role="tab" data-toggle="tab">Hold / Reject</a></li>
            <li role="presentation" ng-class="{ active: isSetIssueApp(2) }"><a ng-click="SetTabIssueApp(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Approved</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetIssueUnApp(1), active: isSetIssueUnApp(1) }">

            <fieldset class="scheduler-border">
                <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
                <div>
                    @*<div id='Grid'>e-allowselection="true"</div>*@
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="GridIUNApproved" ej-grid e-datasource="GridIssueSlipUnApprovedList"
                             e-allowfiltering="true"
                             e-allowpaging="true"
                             e-allowsorting="true"
                             e-filtersettings-filterType="excel"
                             e-enabletouch="true"
                             e-detailstemplate="detailTemp"
                             e-detailsdatabound="detailgrid">
                            <div e-columns>

                                <div e-column e-headertext="Actions" e-width="30">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk" title="Un Approved" ng-click="$parent.onClickSave('GridIUNApproved');" style="margin: -6px;"></i></button>
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.AllTabPrint('GridIUNApproved');" style="margin: -6px;"></i></button>
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.PrintMICData(this);" style="margin: -6px;"></i></button>
                                </div>
                                <div e-column e-template="#RejectCheckedReason" e-headertext="Hold / Reject Reason" e-width="120" style="height: 20px;"></div>
                                <div e-column e-template="#showGraph" e-headertext="Approved Status" e-width="50"></div>
                                <div e-column e-field="Id" e-headertext="Id" e-width="30"></div>
                                <div e-column e-field="RequestedQty" e-headertext="Qty" e-width="50"></div>
                                <div e-column e-field="ProductionOrderId" e-headertext="PONo" e-width="60"></div>
                                <div e-column e-field="PlanPercentage" e-headertext="Plan%" e-width="60"></div>
                                <div e-column e-field="RecoveryPercentage" e-headertext="Recovery %" e-width="80"></div>
                            </div>

                        </div>
                        <script id="tabGridContents" type="text/x-jsrender">
                            <div class="tabcontrol" id="Test">
                                <ul>
                                    <li><a href="#gridTab{{:Id}}">Requisition Details</a></li>
                                </ul>
                                <div id="gridTab{{:Id}}">
                                    <div id="detailGrid"></div>
                                </div>
                            </div>
                        </script>
                    </div>
                </div>
            </fieldset>
        </div>
        <script type="text/template" id="RejectCheckedReason">
            @*<div class="col-sm-10" style="width:300px;height:20px; ">*@
            <input type="text" ng-model="data.CheckedRejectReason" style="color:black;" class="form-control" />
            @*</div>*@
        </script>

        <script type="text/template" id="showGraph">
            <div class="search-form1">
                <div id="control1">
                    <input id="combo-default12" type="text" e-fields-text="Text" e-fields-value="Value" ej-combobox e-datasource="$parent.approvalStatusList" e-value="data.CheckedByStatus" e-width="100%" />
                </div>
            </div>
        </script>

