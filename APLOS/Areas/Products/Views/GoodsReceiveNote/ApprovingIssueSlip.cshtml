                            <div e-columns>


                                <div e-column e-headertext="Actions" e-width="80">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk" title="Un Approved" ng-click="$parent.onClickSave('GridIUNApproved3');" style="margin: -6px;"></i></button>
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.AllTabPrint('GridIUNApproved3');" style="margin: -6px;"></i></button>
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.PrintMICData(this);" style="margin: -6px;"></i></button>
