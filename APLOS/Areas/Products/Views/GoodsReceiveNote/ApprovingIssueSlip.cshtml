        <script type="text/template" id="CheckedStatus1">
            <div class="">
                <div id="control1">
                    <input id="combo-default" type="text" e-fields-text="Text" e-fields-value="Value" ej-combobox e-datasource="$parent.approvalStatusList" e-value="data.CheckedByStatus" e-width="100%" />
                </div>
            </div>
        </script>


        <script type="text/template" id="RejectCheckedReason">

        </script>

    </div>
</div>
<div class="modal fade site-modal in" id="ActionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Reason for approved & Unaooroved</div>  @*<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button>*@
            <div class="modal-body">
                <div class="col-xs-12 col-sm-12col-md-12">

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Reason</label>
                        <label class="col-sm-4 control-label" ng-model="SystemId" ng-hide="true">{{SystemId}}</label>
                        <div class="col-sm-12">
                            <textarea type="text" rows="3" ng-model="reason" class="form-control" style="border:double"></textarea>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="form-group">
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-click="poApp1();" class="btn"> Save</button></li>
                        <li><button ng-click="ClosedPOPUp();" class="btn"> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

</div>

