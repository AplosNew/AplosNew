
<style>

    .loaderr {
        width: 300px;
        height: 200px;
        background-color: #0780BA;
        color: #fff;
        padding: 100px;
        font-size: 25px;
    }

    .e-grid .e-headercelldiv {
        font-weight: bold;
        font-size: 10px;
        display: block;
        border: 0 none;
        height: 29px;
        line-height: 29px;
        margin: -7px;
        padding: 0 .7em;
        text-align: left;
        white-space: nowrap;
        text-overflow: ellipsis;
        font-family: "Arial Narrow";
    }

    .e-grid .e-rowcell {
        border-width: 1px 0 0 1px;
        padding: .7em;
        line-height: 10px;
        white-space: nowrap;
        width: auto;
        vertical-align: middle;
    }

    .e-grid.e-wrap .e-columnheader .e-headercelldiv {
        margin-bottom: 2px;
        margin-top: 0;
        font-size: 9px;
    }

    e-grid .e-columnheader .wrap .e-headercelldiv {
        height: Auto;
    }

    .e-grid .e-excelfilter .e-btncontainer input {
        padding: .2em .4em .3em;
    }

    .e-grid.e-dlgcontainer .e-dlgBtns .e-clear {
        padding: 3px;
    }

    .e-grid.e-dlgcontainer .e-dlgBtns .e-filter {
        padding: 3px;
    }

    ::-ms-clear {
        display: none;
    }

    .e-grid.filtered .e-filteredicon {
        color: red;
    }
</style>

