<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-info-sign"></span> Product SubCategory Attribute</h3>
<div class="form-elements" ng-form id="productSubCategoryAttributeNew" name="materialAttributeMasterForm">
    <input type="hidden" ng-model="productSubCategoryAttributeNew.Id">
    <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Product Subcategory<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="productSubCategoryAttributeNew.ProductSubCategoryId"
                            ng-change="getData(productSubCategoryAttributeNew.ProductSubCategoryId)" ng-disabled="productSubCategoryAttributes.length>0"
                            ng-options="item.Value as item.Text for item in productSubCategoryList" id="productSubCategoryId"
                            name="Product SubCategory" required tabindex="1">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" value="" ng-model="productSubCategoryAttributeNew.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-left">
            <li> <button class="btn" ng-click="popUp()" ng-disabled="productSubCategoryAttributeNew.ProductSubCategoryId==null"><i class="glyphicon glyphicon-plus"></i> Material Attribute</button></li>
        </ul>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="tableShow">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sequence</th>
                    <th>Material Attribute</th>
                    <th>Free Field</th>
                    <th>Pre-Defined Field</th>
                    <th>Mandatory</th>
                    <th>Active</th>
                    <th>Remove</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in productSubCategoryAttributes">
                    <td>
                        <input type="text" name="Sequence" ng-model="x.Sequence" class="form-control" required maxlength="18">
                    </td>
                    <td>{{x.MaterialAttributeName}}</td>
                    <td class="text-center">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="x.IsFreeField">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </td>
                    <td class="text-center">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="x.IsPreDefinedField">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </td>
                    <td class="text-center">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="x.IsMandatory">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                    <td class="text-center table-td">
                        <ul class="list-inline action-list">
                            <li>
                                <button ng-click="DeleteModal($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmAttributePopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="removeRow()">
</confirm-archive-generic>
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Material Attribute</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in popUpList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th ng-repeat="y in popUpList">{{y.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count" ng-dblclick="selectDoubleClick(x);"
                                ng-click="selectSingleClick(x)">
                                <td ng-repeat="y in popUpList">{{x[y.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getPopUpData(newPageNumber)">
                </dir-pagination-controls>
            </div>
        </div>
    </div>
</div>