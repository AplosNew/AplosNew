<div>
    <input type="text" value="Inventory" id="SlipAssetIssueUI" ng-hide="true" />
</div>

<togglable name="inventory Issue BOQ"></togglable>
<div class="form-elements form-horizontal row" ng-form="productNewForm" id="MainDivId">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Info</legend>
        <div class="col-xs-6 col-sm-6-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Order Specific</label>
                <div class="col-sm-8">
                    <div class="radio">
                        <label>
                            <input type="radio" name="OrderSpecific" ng-model="productNew.OrderSpecific" value="Yes" ng-click="ClearList('Yes');">@*show();*@
                            <span class="cr"><i class="cr-icon"></i></span>Yes
                        </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 col-md-4 control-label">Storage Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Storage" ng-model="productNew.MaterialStorageId" class="form-control" ng-options="item.Value as item.Text for item in storageList" tabindex="1" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Issue Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="paymentTermId" class="form-control" name="Requisition Type" ng-change="changeType(productNew.IssueType)" ng-model="productNew.IssueType" tabindex="12" required>
                            <option value="Capital">Capital </option>
                            <option value="Revenue">Revenue</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea type="text" name="remarks" class="form-control" maxlength="350" rows="1" ng-model="productNew.Remarks" tabindex="4" capitalize></textarea>
                </div>
            </div>
            <div class="form-group" id="div_docNo1" ng-show="productNew.ConsumptionBookingName==='MasterOrder' && productNew.OrderSpecific==='Yes'">
                <label class="col-sm-4 control-label">Order Ref No<sup></sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="Order Ref No" ng-model="productNew.OrderRefNo" class="form-control" maxlength="300" tabindex="2" autocomplete="on" readonly>
                        <span class="input-group-btn">
                            <button ng-click="GetMasterOrderByContractList()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="ClearMasterOrder()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                            <button ng-click="GetPopUpMasterOrderDetails()" class="btn single-small-btn" ng-hide="productNew.OrderSpecific==='No'"><i class="glyphicon glyphicon-list-alt"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            @*<div class="col-xs-12 col-sm-4 col-md-4">*@
            <div class="form-group" ng-show="productNew.ConsumptionBookingName==='Contract'  && productNew.OrderSpecific==='Yes'">
                <label class="col-sm-4 control-label" title="Contract" @*ng-hide="productNew.OrderSpecific==='No'"*@>Contract</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" name="ContractId" ng-model="productNew.ContractId" class="form-control" maxlength="100" ng-hide="true">
                    <input type="text" name="ContractNo" ng-model="productNew.ContractNo" ng-disabled="true" class="form-control" maxlength="100" @*ng-hide="productNew.OrderSpecific==='No'"*@>

                    <span class="input-group-btn">
                        <button ng-click="GetPopUpContract()" class="btn single-small-btn" @*ng-hide="productNew.OrderSpecific==='No'"*@><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="Clearcontract()" class="btn single-small-btn" @*ng-hide="productNew.OrderSpecific==='No'"*@><i class="glyphicon glyphicon-refresh"></i></button>
                        <button ng-click="GetMasterOrderByContractList1()" @*ng-hide="productNew.OrderSpecific==='No'"*@ class="btn single-small-btn"><i class="glyphicon glyphicon-list-alt"></i></button>
                    </span>
                </div>
            </div>
            @*</div>*@
            <div class="form-group" show-errors ng-show="productNew.ConsumptionBookingName==='ProductionOrder'&& productNew.OrderSpecific==='Yes'">
                <label class="col-sm-4 control-label">Production Order<sup></sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="Production Order" ng-model="productNew.ProductionOrderId" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="getProductionOrderPopUp();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Refference No</label>
                <div class="col-sm-8">
                    <textarea maxlength="1000" name="RefferenceNo" class="form-control" rows="2" ng-model="productNew.RefferenceNo" tabindex="7"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-6-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="paymentTermId" ng-disabled="detailModel.CostCenterId!=null" class="form-control" name="Entity" ng-model="productNew.EntityId" tabindex="1" required ng-change="GetEntityWiseConsumptionList()">
                            <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-6-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 col-md-4 control-label">ConsumptionBooking<sup></sup></label>
                <div class="col-sm-8 show-message">
                    <label class="col-sm-4 col-md-4 control-label">{{productNew.ConsumptionBookingName}}</label>
                </div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-6-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Issue Id</label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="productNew.Id" disabled class="form-control text-left" />
                </div>
            </div>

        </div>
        <div class="col-xs-6 col-sm-6-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Issue Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Issue Date" ng-model="productNew.IssueDate" datepicker end-date="currentDate" class="form-control" placeholder="dd-mmm-yyyy" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="EmployeeName" ng-model="productNew.EmployeeName" class="form-control" readonly required>
                        <span class="input-group-btn">
                            <button ng-click="showEmployeeListPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearEmployee()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>


    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-left">
            <li><button ng-click="SearchMaterialPopup();" class="btn" ng-disabled="ispostDisable">Search Material</button></li>
            <li><button ng-click="SearchPopup();" class="btn" ng-disabled="ispostDisable">Search PO</button></li>
        </ul>
        
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-8 col-md-8" ng-show="selectedSearchDataList.length">
        <div style="color:black;" id="GridselectedSearchData" ej-grid e-datasource="selectedSearchDataList"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
            <div e-columns>
                <div e-column e-type="string" e-field="POId" e-headertext="PO No" e-width="100"></div>
                <div e-column e-type="string" e-field="CustomerName" e-headertext="Customer" e-width="200"></div>
                <div e-column e-type="string" e-field="ContractId" e-headertext="ContractId" e-width="150"></div>
                <div e-column e-type="string" e-field="MasterOrderId" e-headertext="MasterOrderId" e-width="100"></div>
                <div e-column e-type="string" e-field="SalesOrderId" e-headertext="SalesOrderId" e-width="80"></div>
                <div e-column e-type="string" e-field="OwnReferenceNo" e-headertext="Own Ref. No" e-width="80"></div>
                <div e-column e-type="string" e-field="BuyerOrderReferenceNo" e-headertext="Style" e-width="80"></div>
                <div e-column e-type="string" e-field="VendorName" e-headertext="Vendor" e-width="150"></div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-8 col-md-8" ng-show="selectedSearchDataList.length">
        <ul class="common-btn list-inline text-left">
            <li><button ng-show="x.Id==null" ng-click="getSpecificMaterialStockNew();" class="btn" tooltip data-placement="top" title="Select Specific GRN">Select GRN BOQ</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <ul class="common-btn list-inline text-right">
            <li><button ng-click="Save();" class="btn" ng-disabled="ispostDisable"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table col-md-12">
        <table class="table table-striped">
            <thead>
                <tr>

                    <th>Material</th>
                    <th>Article</th>
                    <th>SKU1</th>
                    <th>SKU2</th>
                    <th>SKU3</th>
                    <th>Country Name</th>
                    <th>Issue Qty</th>
                    <th>Base Issue Qty</th>
                    <th>Lot No.</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in detailList ">
                    <td>{{x.MaterialMasterName}}</td>
                    <td>{{x.ArticleName}}</td>
                    <td>{{x.SKU1}}</td>
                    <td>{{x.SKU2}}</td>
                    <td>{{x.ThirdCharacteristicText}}</td>
                    <td>{{x.CountryName}}</td>
                    <td>{{x.RequisitionQty}}  {{x.TransactionUoM}}</td>
                    <td>{{x.RequisitionQty}}  {{x.BUoM}}</td>
                    <td>{{x.LotNumber}}</td>
                    <td class="text-right table-td">
                        <ul class="list-inline">
                            <li><button ng-click="removeRowModal(x, $index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                            <li>@*<a class="btn btn-action" ng-click="IssueReport(x);" href="" target="_blank"><i class="fa fa-file-word-o"></i></a>*@</li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="aplos-grid-toggle">

    <fieldset class="scheduler-border">
        <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
        <div>
            <div id='Grid'></div>
            <div class="content-container-fluid" style="color:black;">
                @*e-allowselection="true"*@
                <div style="color:black;" id="GridIIssue" ej-grid e-datasource="GridInventoryIssuedata"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                     e-recorddoubleclick="GetDataList" e-filtersettings-filterType="excel"
                     e-enabletouch="true" e-allowselection="true"
                     e-detailstemplate="detailTemp"
                     e-detailsdatabound="detailgrid">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Issue No" e-width="80"></div>
                        <div e-column e-field="issuetype" e-headertext="Issue Type" e-width="80"></div>
                        <div e-column e-field="Entity" e-headertext="Entity Name" e-width="80"></div>
                        <div e-column e-field="OrderRefNo" e-headertext="OrderRefNo" e-width="80"></div>
                        <div e-column e-field="ContractNo" e-headertext="Contract No" e-width="80"></div>
                        <div e-column e-field="ProductionOrderId" e-headertext="ProductionOrderId" e-width="80"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee" e-width="80"></div>
                        <div e-column e-field="MaterialStorage" e-headertext="Storage Location" e-width="80"></div>
                        <div e-column e-field="IssueDate" e-headertext="Issue Date" e-width="80"></div>
                        <div e-column e-field="Qty" e-headertext="Qty" e-width="50"></div>
                        <div e-column e-field="Amount" e-headertext="Amount" e-width="80"></div>
                        <div e-column e-headertext="Actions" e-width="50">
                            <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print Report" ng-click="$parent.AllTabPrint('GridIIssue');" style="margin: -6px;"></i></button>
                            <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Issue Excel Report" ng-click="$parent.ConfirmIssueReportPrint(data);" style="margin: -6px;"></i></button>
                        </div>

                    </div>

                </div>

            </div>
            <script id="tabGridContents" type="text/x-jsrender">
                <div class="tabcontrol" id="Test">
                    <ul>
                        <li><a href="#gridTab{{:Id}}">Material Issue Details</a></li>
                    </ul>
                    <div id="gridTab{{:Id}}">
                        <div id="detailGrid"></div>
                    </div>
                </div>
            </script>
        </div>
    </fieldset>


</div>


<div class="modal fade site-modal in" id="detailPopUp" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Material Issue Entry<button type="button" class="close" ng-click="closeDetaiPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border"> Material</legend>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group div_mm">
                            <label class="col-sm-4 control-label">Material</label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Finished Goods" ng-model="detailModel.MaterialMasterName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button tabindex="1" ng-click="getMaterialMasterbyTypePopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group div_ar" ng-show="hasArticle">
                            <label class="col-sm-4 control-label">Article</label>
                            <div class="input-group show-message">
                                <input type="text" name="Finished Goods" ng-model="detailModel.ArticleName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button tabindex="1" ng-click="getArticleSearchList(detailModel.MaterialMasterId);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Material Group</label>
                            <label class="col-sm-8 control-label">{{detailModel.MaterialGroupMasterName}}</label>
                        </div>
                        <div class="form-group" ng-show="detailModel.IsProductMstRequired">
                            <label class="col-sm-4 control-label">Prd Master</label>
                            <label class="col-sm-8 control-label">{{detailModel.ProductMasterName}}</label>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="char1.CharacteristicsId.length>0;">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{char1.Name}}<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" ng-model="char1.FreeText" class="form-control"
                                           ng-keyup="nullByFreeText('char1')" disabled ng-required="char1.IsMandatory">
                                    <span class="input-group-btn">
                                        <button ng-click="findCharValueSearchData(char1, 'char1')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="clearCharValueField('char1');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                                <p class="msg-error" ng-show="IsMandatoryButNull(char1.IsMandatory, char1.FreeText)">value is required.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="char2.CharacteristicsId.length>0;">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{char2.Name}}<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" ng-model="char2.FreeText" class="form-control"
                                           ng-keyup="nullByFreeText('char2')" disabled ng-required="char2.IsMandatory">
                                    <span class="input-group-btn">
                                        <button ng-click="findCharValueSearchData(char2, 'char2')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="clearCharValueField('char2');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                                <p class="msg-error" ng-show="IsMandatoryButNull(char2.IsMandatory, char2.FreeText)">value is required.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="char3.CharacteristicsId.length>0;">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{char3.Name}}<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" ng-model="char3.FreeText" class="form-control"
                                           ng-keyup="nullByFreeText('char3')" disabled ng-required="char3.IsMandatory">
                                    <span class="input-group-btn">
                                        <button ng-click="findCharValueSearchData(char3, 'char3')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="clearCharValueField('char3');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                                <p class="msg-error" ng-show="IsMandatoryButNull(char3.IsMandatory, char3.FreeText)">value is required.</p>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>


                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group div_Cost_Center">
                            <label class="col-sm-4 control-label">Cost Center<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" name="Cost Center" ng-model="detailModel.CostCenterId" ng-options="item.Value as item.Text for item in costCenterList" required></select>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group div_budget">
                            <label class="col-sm-4 control-label">Budget Activity<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Budget Activity" ng-model="detailModel.BudgetName" class="form-control" readonly required>
                                    <span class="input-group-btn">
                                        <button tabindex="1" ng-click="GetCOAICodeList();" ng-hide="IssueType=='Capital'" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        <button tabindex="1" ng-click="GetIssueAUCList();" ng-hide="IssueType=='Revenue'" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group div_budget">
                            <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="detailModel.ActivityId" ng-options="item.ActivityId as item.ActivityName for item in activityList">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" id="div_country">
                            <label class="col-sm-4 col-md-4 control-label">Country<sup ng-show="detailModel.IsOriginApplicable">*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="CountryName" name="Country" ng-disabled="!detailModel.IsOriginApplicable" ng-model="detailModel.CountryId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in countryList" ng-change="getMaterialStockCountryWise();">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Comments</label>
                            <div class="col-sm-8">
                                <textarea type="text" name="comments" class="form-control" maxlength="500" rows="1" ng-model="detailModel.Comments" tabindex="4" capitalize></textarea>
                            </div>
                        </div>
                    </div>
                    <sqan class="msg-error" ng-show="errorText!=null">{{errorText}}</sqan>
                </fieldset>
                <div class="clearfix"></div>
                <!--detailModel Entry Rigt-->

                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-2 control-label">Approved Stock</label>
                        <div class="col-sm-2 form-group">
                            <label class="control-label">{{detailModel.ApprovedQty| number| setDecimal:2}} {{detailModel.BaseUoM}} </label>
                            <button ng-click="getApprovedStock(detailModel);getApprovedStockDetailBeyondIssueDate(detailModel)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Approved Stock List"><i class="glyphicon glyphicon-list"></i></button>
                        </div>

                        <label class="col-sm-2 control-label">UnApproved Stock</label>
