<style>
    .modelWithModify {
        width: 1460px;
    }
</style>
<div class="modal fade site-modal in" id="stockboqPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modelWithModify">
        <div class="modal-content">
            <div class="modal-header">Material Stock<button type="button" class="close" ng-click="closeStockPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-lg-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GRnBOQGrid" ej-grid e-datasource="materialStockList"
                             e-templaterefresh="refreshTemplateMasterOrderOperation"
                             e-recorddoubleclick="" e-summaryrows="summaryUnassignRows" e-allowResizing="true"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                @*<div e-column e-template="#checkBOQboxList" e-textalign="center" e-width="60"></div>*@
                                <div e-column e-field="PartyName" e-headertext="Party" e-width="80"></div>
                                <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="80"></div>
                                <div e-column e-field="ArticleName" e-headertext="Article" e-width="200"></div>
                                <div e-column e-field="SKU1" e-headertext="SKU1" e-width="100"></div>
                                <div e-column e-field="PONo" e-headertext="PO No." e-width="60"></div>
                                <div e-column e-field="BOQDetailId" e-headertext="BOQDetailId" e-width="60"></div>
                                <div e-column e-field="SalesOrderId" e-headertext="SO No" e-width="60"></div>
                                <div e-column e-field="GRNDate" e-headertext="GRN Date" e-width="60"></div>
                                <div e-column e-field="InventoryReceiveDetailId" e-headertext="GRN Detail Row" e-width="80"></div>
                                <div e-column e-field="BaseQty" e-headertext="GRN Qty" e-width="40"></div>
                                <div e-column e-field="BUoM" e-headertext="UOM" e-width="40"></div>
                                <div e-column e-field="BaseIssueQty" e-headertext="BaseIssueQty" e-width="60"></div>
                                <div e-column e-field="BalanceStock" e-headertext="BalanceStock" e-width="80"></div>
                                @*<div e-column e-template="#CurrentTextPOQtyBOQ" e-field="TransactionQty" e-textalign="right" e-headertext="CurrentQty" e-width="100"></div>*@
                                <div e-column e-template="#CurrentTextGRNRecvQty" e-field="RequisitionQty" e-textalign="right" e-headertext="Current Qty" e-width="80"></div>
                                <div e-column e-field="LotNumber" e-headertext="LotNumber" e-width="80"></div>
                                <div e-column e-field="ShortageRate" e-headertext="ShortageRate" e-width="80"></div>
                                <div e-column e-field="ShortageValue" e-headertext="ShortageValue" e-width="80"></div>
                                <div e-column e-field="RejectionRate" e-headertext="RejectionRate" e-width="80"></div>
                                <div e-column e-field="RejectionClamRate" e-headertext="RejectionClamRate" e-width="80"></div>
                                <div e-column e-field="MaterialGroupMasterName" e-headertext="MaterialGroup" e-width="120"></div>
                                <div e-column e-field="MaterialDetail" e-headertext="MaterialDetail" e-width="80"></div>
                            </div>

                        </div>
                        <script type="text/template" id="CurrentTextGRNRecvQty">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-keyup="calculateBaseQty(data);" width="200" ng-model="data.RequisitionQty" >
                        </script>
                       
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="addMaterialStockNew();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> SubmitList</button></li>
                        <li><button ng-click="closeStockPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>