<togglable name="Material Issue"></togglable>

<div class="aplos-grid-toggle">
	<div class="row text-right">
		<div class="col-xs-12 col-sm-12 col-sm-12">
			<div class="search-form">
				<div class="row">
					<div class="col-xs-12 col-sm-3 col-md-3">
						<div class="select-style">
							<select ng-model="$root.parameters.searchBy">
								<option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
							</select>
						</div>
					</div>
					<div class="col-xs-12 col-sm-7 col-md-7">
						<input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData();">
					</div>
					<div class="col-xs-12 col-sm-2 col-md-2">
						<button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="table-responsive modal-table">
		<table class="table table-striped">
			<thead>
                <tr>
                    <th>Issue Type</th>
                    <th>Voucher No</th>
                    <th>Entity Name</th>
                    <th>Employee</th>
                    <th>Issue No</th>
                    <th>Storage Location</th>
                    <th>Issue Date</th>
                    <th>Qty</th>
                    <th>Amount</th>
                    <th>Posting Status</th>
                    <th>Action</th>
                </tr>
			</thead>
			<tbody>
                <tr dir-paginate="x in issueList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get($index);">

                    <td>{{x.IssueType}}</td>
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.Entity}}</td>
                    <td>{{x.EmployeeName}}</td>
                    <td>{{x.Id}}</td>
                    <td>{{x.MaterialStorage}}</td>
                    <td>{{x.IssueDate}}</td>
                    <td class="text-right">{{x.Qty}}</td>
                    <td class="text-right">{{x.Amount| number| setDecimal:2}}</td>
                    <td>{{x.VoucherNo?'Yes':'No'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" ng-click="IssueReport(x);" href="" target="_blank"><i class="fa fa-file-word-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
			</tbody>
		</table>
		<dir-pagination-controls max-size="10" direction-links="true" boundary-links="true"	 on-page-change="getData(newPageNumber)">
		</dir-pagination-controls>
	</div>
</div>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(issueId,voucherId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow();"></confirm-archive-generic>
