<div class="modal fade site-modal in" id="detailPopUp" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Material Issue Entry<button type="button" class="close" ng-click="closeDetaiPopUp();">&times;</button></div>
