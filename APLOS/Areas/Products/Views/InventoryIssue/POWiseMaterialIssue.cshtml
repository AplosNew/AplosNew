                            <label class="col-sm-4 control-label">Material</label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Finished Goods" ng-model="detailModel.MaterialMasterName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button tabindex="1" ng-click="getMaterialMasterbyTypePopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
