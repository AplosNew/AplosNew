                                    </span>
                                </div>
                                <p class="msg-error" ng-show="IsMandatoryButNull(char1.IsMandatory, char1.FreeText)">value is required.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="char2.CharacteristicsId.length>0;">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{char2.Name}}<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" ng-model="char2.FreeText" class="form-control"
                                           ng-keyup="nullByFreeText('char2')" disabled ng-required="char2.IsMandatory">
                                    <span class="input-group-btn">
                                        <button ng-click="findCharValueSearchData(char2, 'char2')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="clearCharValueField('char2');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                                <p class="msg-error" ng-show="IsMandatoryButNull(char2.IsMandatory, char2.FreeText)">value is required.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="char3.CharacteristicsId.length>0;">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{char3.Name}}<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" ng-model="char3.FreeText" class="form-control"
                                           ng-keyup="nullByFreeText('char3')" disabled ng-required="char3.IsMandatory">
                                    <span class="input-group-btn">
                                        <button ng-click="findCharValueSearchData(char3, 'char3')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="clearCharValueField('char3');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                                <p class="msg-error" ng-show="IsMandatoryButNull(char3.IsMandatory, char3.FreeText)">value is required.</p>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>


                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group div_Cost_Center">
                            <label class="col-sm-4 control-label">Cost Center<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" name="Cost Center" ng-model="detailModel.CostCenterId" ng-options="item.Value as item.Text for item in costCenterList"></select>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group div_budget">
                            <label class="col-sm-4 control-label">Budget Activity<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Budget Activity" ng-model="detailModel.BudgetName" class="form-control" readonly required>
                                    <span class="input-group-btn">
                                        <button tabindex="1" ng-click="GetCOAICodeList();" ng-hide="IssueType=='Capital'" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        <button tabindex="1" ng-click="GetIssueAUCList();" ng-hide="IssueType=='Revenue'" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group div_budget">
                            <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="detailModel.ActivityId" ng-options="item.ActivityId as item.ActivityName for item in activityList">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>



                    <sqan class="msg-error" ng-show="errorText!=null">{{errorText}}</sqan>
                </fieldset>
                <div class="clearfix"></div>
                <!--detailModel Entry Rigt-->

                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-2 control-label">Approved Stock</label>
                        <div class="col-sm-2 form-group">
                            <label class="control-label">{{detailModel.ApprovedQty| number| setDecimal:2}} {{detailModel.BaseUoM}} </label>
                            <button ng-click="getApprovedStock(detailModel);getApprovedStockDetailBeyondIssueDate(detailModel)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Approved Stock List"><i class="glyphicon glyphicon-list"></i></button>
                        </div>

                        <label class="col-sm-2 control-label">UnApproved Stock</label>
                        <div class="col-sm-2 form-group">
                            <label class="control-label">{{detailModel.UnApprovedQty| number| setDecimal:2}} {{detailModel.BaseUoM}} </label>
                            <button ng-click="getUnApprovedStock(detailModel);getUnApprovedStockDetailBeyondIssueDate(detailModel)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="UnApproved Stock List"><i class="glyphicon glyphicon-list"></i></button>
                        </div>
                        <label class="col-sm-1 control-label">Total Stock</label>
                        <label class="col-sm-1 control-label">{{detailModel.TotalQty| number| setDecimal:2}} {{detailModel.BaseUoM}}</label>
                    </div>

                    <div class="form-group" ng-show="detailModel.IsOurStyleNameRequired">
                        <label class="col-sm-4 control-label">OurStyleName</label>
                        <label class="col-sm-8 control-label">{{detailModel.OurStyleName}}</label>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-2 control-label">Ready For Issue</label>
                        <div class="col-sm-2 form-group">
                            <label class="control-label">{{detailModel.PostingQty| number| setDecimal:2}} {{detailModel.BaseUoM}}</label>
                            <button ng-click="getPostingStock(detailModel);getPostingStockBeyondIssueDate(detailModel);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Ready For Issue List"><i class="glyphicon glyphicon-list"></i></button>
                        </div>
                    </div>
                </div>
                <hr style="width:100%;" />
                <div class="col-xs-12 col-sm-6 col-md-6">
                    @*<div class="form-group div_qty">
                            <label class="col-sm-4 control-label">Issue Qty<sup>*</sup></label>
                            <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 15px;">
                                <input type="text" only-numbers ng-model="detailModel.TransactionQty" class="form-control text-right" ng-keyup="manualValidationAddRemove('div_qty','TransactionQty');">
                                <span class="input-group-addon">{{detailModel.BaseUoM}}</span>
                            </div>
                        </div>*@
                    <div class="form-group" id="div_qty">
                        <label class="col-sm-4 control-label">Issue Qty<sup>*</sup></label>
                        <div class="col-sm-4 show-message" style="padding-right:0px;">
                            <input type="text" n-decimals="2" ng-model="detailModel.TransactionQty" class="form-control text-right" ng-keyup="manualValidationAddRemove('div_qty','TransactionQty');">
                        </div>
                        <div class="col-sm-4 show-message" style="padding-left:0px;">
                            <div class="select-style">
                                <select name="Isssue UoM" id="issueUoM" class="form-control" ng-model="detailModel.TransactionUoMId" ng-options="item.Value as item.Text for item in uoMList" ng-change="manualValidationAddRemove('div_qty', 'detailModel','TransactionUoMId');">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="detailAdd();" ng-disabled="detailModel.PostingQty==0" class="btn"><i class="glyphicon glyphicon-plus"></i> Add</button></li>
                        <li> <button ng-click="closeDetaiPopUp();" class="btn">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
