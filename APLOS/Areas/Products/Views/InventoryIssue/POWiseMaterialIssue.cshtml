<div>
    <input type="text" value="Inventory" id="SlipAssetIssueUI" ng-hide="true" />
</div>



<togglable name="PO Wise Material Issue"></togglable>
<div class="form-elements form-horizontal row" ng-form="productNewForm">

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label"><b>Order Specific</b></label>
            <div class="col-sm-4">
                <label class="col-sm-4 control-label" ng-model="productNew.OrderSpecific"><span style="color:maroon;font-weight:bold;"><sup>{{productNew.OrderSpecific}}</sup></span></label>

            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label"><span style="color:maroon;font-weight:bold;">Search Slip No:<sup>*</sup></span></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="IssueSlipNo" ng-model="issueId" class="form-control" readonly required>
                    <input type="text" ng-hide="POId1==null" name="Vendor1" ng-model="POId1" class="form-control">
                    <span class="input-group-btn">
                        <button name="submit" ng-disabled="inventoryMaterialList.length>0" ng-click="POPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>

        </div>



        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="paymentTermId" class="form-control" name="Requisition Type" ng-change="changeType(productNew.IssueType)" ng-model="productNew.IssueType" tabindex="12" required>
                        <option value="Capital">Capital </option>
                        <option value="Revenue">Revenue</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" id="div_docNo1" ng-show="productNew.OrderSpecific1==='Yes'">
            <label class="col-sm-4 control-label">Order Ref No<sup></sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Order Ref No" ng-model="productNew.OrderRefNo" class="form-control" maxlength="300" tabindex="2" autocomplete="on">
                    <span class="input-group-btn">

                        <button ng-click="GetMasterOrderByContractList()" class="btn single-small-btn" ng-disabled="productNew.OrderSpecific1==='No'"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="ClearMasterOrder()" class="btn single-small-btn" ng-disabled="productNew.OrderSpecific1==='No'"><i class="glyphicon glyphicon-refresh"></i></button>
                        <button ng-click="GetPopUpMasterOrderDetails()" class="btn single-small-btn" ng-disabled="productNew.OrderSpecific1==='No'"><i class="glyphicon glyphicon-list-alt"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Slip Wise PO No<sup></sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Slip Wise PO No" ng-model="productNew.SlipWisePRNo" class="form-control" readonly>
            </div>

        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User PO<sup></sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="User PO" ng-model="productNew.ProductionOrderId" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getProductionOrderPopUp();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>

                    </span>
                </div>
            </div>

        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea type="text" name="remarks" class="form-control" maxlength="250" rows="2" ng-model="productNew.Remarks" tabindex="4" capitalize></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Refference No</label>
            <div class="col-sm-8">
                <textarea maxlength="1000" name="RefferenceNo" class="form-control" rows="2" ng-model="productNew.RefferenceNo" tabindex="7"></textarea>
            </div>
        </div>
    </div>



    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Issue Date" ng-model="productNew.IssueDate" datepicker end-date="currentDate" class="form-control" placeholder="dd-mmm-yyyy" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Slip Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="PoDate" ng-model="isuuedate" datepicker end-date="currentDate" class="form-control" placeholder="dd-mmm-yyyy" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue Id</label>
            <div class="col-sm-8 show-message">
                <input type="text" ng-model="productNew.Id" disabled class="form-control text-left" />
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="paymentTermId" ng-disabled="detailModel.CostCenterId!=null" class="form-control" name="Entity" ng-model="productNew.EntityId" tabindex="1" required>
                        <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>

                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">ConsumptionBooking<sup></sup></label>
            <div class="col-sm-8 show-message">
                <label class="col-sm-4 col-md-4 control-label">{{productNew.ConsumptionBookingName}}</label>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="EmployeeName" ng-model="productNew.EmployeeName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearEmployee()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">ProcessName:<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <label class="col-sm-4 control-label">{{productNew.ProcessName}}</label>
                    @*<input type="text" name="ProcessName" ng-model="productNew.ProcessName" class="form-control" readonly required>*@

                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    @*<div class="col-xs-12 col-sm-6 col-md-6">
            <ul class="common-btn list-inline text-left">
                <li><button ng-click="detailPopUp();" class="btn" ng-disabled="productNew.Id!=null">Issue Material</button></li>
            </ul>
        </div>*@

    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-left">
            <li><button ng-click="ViewSlipDetail();" class="btn">View Issue slip Detail</button></li>
        </ul>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-right">
            <li><button ng-click="SaveSlipIssue();" class="btn" ng-disabled="productNew.Id!=null"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table col-md-12">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        <div class="checkbox-site text-center">
                            <label>
                                <input type="checkbox" ng-click="CheckAll1($event);">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </th>
                    <th style="width:500px;">CostCenter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                    <th>Material</th>
                    <th>ArticleName</th>
                    <th>SKU1</th>
                    <th>SKU2</th>
                    <th>SKU3</th>
                    <th>Country</th>
                    <th>SalesOrder</th>
                    <th>Requested-UOM</th>
                    <th>ReadyForIssue</th>

                    <th>RequestedQty</th>
                    <th ng-hide="false">IssuedQty</th>

                    <th>IssueQty</th>
                    <th ng-hide="false">BlanceQty</th>
                    <td ng-hide="false">Actual Issued</td>

                    <th ng-hide="false">BaseUoM</th>
                    <th ng-hide="false">BaseUoMStock</th>
                    <th>Budget</th>
                    <th style="width:500px;">ExpenseActivityCode&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                    <th style="width:300px;">Comments&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in detailList">
                    <td>
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-click="Change($event,$index,x)" ng-model="x.check" ng-disabled="x.RequestedQty===x.IssuedQty">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </td>
                    <td>
                        <div class="select-style">
                            <select class="form-control" ng-model="x.CostCenterId" ng-options="item.Value as item.Text for item in costCenterList"></select>
                        </div>
                    </td>
                    <td>{{x.Material}}</td>
                    <td>{{x.ArticleName}}</td>
                    <td>{{x.Sku1}}</td>
                    <td>{{x.Sku2}}</td>
                    <td>{{x.Sku3}}</td>
                    <td>{{x.CountryName}}</td>
                    <td>{{x.SalesOrderId}}</td>
                    <td>{{x.TransactionUoM}}</td>
                    <td>{{x.PostingQty}}</td>
                    <td>{{x.RequestedQty}}</td>
                    <td ng-hide="false">{{x.RequestIssuedQty}}</td>


                    <td class="text-right" ng-hide="false"><input type="text" n-decimals="3" class="form-control text-right" width="200" ng-model="x.TransactionQty" ng-change="qtyFunc(x, $index)" ;></td>
                    <td ng-hide="false">{{x.BalanceQty}}</td>
                    <td ng-hide="false">{{x.IssuedQty}}</td>
                    <td ng-hide="false">{{x.BaseUoM}}</td>
                    <td ng-hide="false">{{x.BaseUoMStock}}</td>
                    <td>{{x.BudgetName}}</td>

                    <td>
                        <button ng-click="popUp($index)" class="btn btn-action tooltip-here" data-placement="top" title="Tax">
                            <i class="glyphicon glyphicon-search"></i>
                        </button>
                        {{x.ActivityName}}
                    </td>
                    <td class="text-right" ng-hide="false"><input type="text" class="form-control text-right" width="400" ng-model="x.Comments"></td>
                    <td class="text-right table-td">
                        <ul class="list-inline">
                            <li><button ng-click="showMaterialWiseStockModal(x, $index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Select Requisition Qty"><i class="glyphicon glyphicon-info-sign"></i></button></li>
                            <li><button ng-show="x.Id==null" ng-click="getSpecificMaterialStockForSlipIssue(x, $index);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Add Requisition List"><i class="glyphicon glyphicon-list"></i></button></li>
                            <li><button ng-show="x.Id!=null" ng-click="getRequisitionList(x.Id);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Get Requisition List"><i class="glyphicon glyphicon-list"></i></button></li>
                            <li><button ng-click="removeRowModal(x, $index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                            <li><a class="btn btn-action" ng-click="IssueReport(x);" href="" target="_blank"><i class="fa fa-file-word-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="aplos-grid-toggle">
   
