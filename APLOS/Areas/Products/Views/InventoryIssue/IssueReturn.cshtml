                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-2 control-label">Approved Stock</label>
                        <div class="col-sm-2 form-group">
                            <label class="control-label">{{detailModel.ApprovedQty| number| setDecimal:2}} {{detailModel.BaseUoM}} </label>
                            <button ng-click="getApprovedStock(detailModel);getApprovedStockDetailBeyondIssueDate(detailModel)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Approved Stock List"><i class="glyphicon glyphicon-list"></i></button>
                        </div>

                        <label class="col-sm-2 control-label">UnApproved Stock</label>
                        <div class="col-sm-2 form-group">
                            <label class="control-label">{{detailModel.UnApprovedQty| number| setDecimal:2}} {{detailModel.BaseUoM}} </label>
                            <button ng-click="getUnApprovedStock(detailModel);getUnApprovedStockDetailBeyondIssueDate(detailModel)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="UnApproved Stock List"><i class="glyphicon glyphicon-list"></i></button>
                        </div>
                        <label class="col-sm-1 control-label">Total Stock</label>
                        <label class="col-sm-1 control-label">{{detailModel.TotalQty| number| setDecimal:2}} {{detailModel.BaseUoM}}</label>
