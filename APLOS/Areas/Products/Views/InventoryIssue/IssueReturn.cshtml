                    </div>
                </div>
                <hr style="width:100%;" />
                <div class="col-xs-12 col-sm-6 col-md-6">
                    @*<div class="form-group div_qty">
                            <label class="col-sm-4 control-label">Issue Qty<sup>*</sup></label>
                            <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 15px;">
                                <input type="text" only-numbers ng-model="detailModel.TransactionQty" class="form-control text-right" ng-keyup="manualValidationAddRemove('div_qty','TransactionQty');">
                                <span class="input-group-addon">{{detailModel.BaseUoM}}</span>
                            </div>
                        </div>*@
                    <div class="form-group" id="div_qty">
                        <label class="col-sm-4 control-label">Issue Qty<sup>*</sup></label>
                        <div class="col-sm-4 show-message" style="padding-right:0px;">
                            <input type="text" n-decimals="2" ng-model="detailModel.TransactionQty" class="form-control text-right" ng-keyup="manualValidationAddRemove('div_qty','TransactionQty');">
                        </div>
                        <div class="col-sm-4 show-message" style="padding-left:0px;">
                            <div class="select-style">
                                <select name="Isssue UoM" id="issueUoM" class="form-control" ng-model="detailModel.TransactionUoMId" ng-options="item.Value as item.Text for item in uoMList" ng-change="manualValidationAddRemove('div_qty', 'detailModel','TransactionUoMId');">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="detailAdd();" ng-disabled="detailModel.PostingQty==0" class="btn"><i class="glyphicon glyphicon-plus"></i> Add</button></li>
                        <li> <button ng-click="closeDetaiPopUp();" class="btn">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
