                    <div class="form-group" ng-show="detailModel.IsOurStyleNameRequired">
                        <label class="col-sm-4 control-label">OurStyleName</label>
                        <label class="col-sm-8 control-label">{{detailModel.OurStyleName}}</label>
                    </div>
                </div>
