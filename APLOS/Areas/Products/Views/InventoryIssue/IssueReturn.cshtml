                    <div class="form-group">
                        <label class="col-sm-2 control-label">Ready For Issue</label>
                        <div class="col-sm-2 form-group">
                            <label class="control-label">{{detailModel.PostingQty| number| setDecimal:2}} {{detailModel.BaseUoM}}</label>
                            <button ng-click="getPostingStock(detailModel);getPostingStockBeyondIssueDate(detailModel);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Ready For Issue List"><i class="glyphicon glyphicon-list"></i></button>
