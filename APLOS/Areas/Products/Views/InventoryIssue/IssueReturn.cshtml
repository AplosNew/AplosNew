                                        <button tabindex="1" ng-click="GetIssueAUCList();" ng-hide="IssueType=='Revenue'" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group div_budget">
                            <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="detailModel.ActivityId" ng-options="item.ActivityId as item.ActivityName for item in activityList">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>



                    <sqan class="msg-error" ng-show="errorText!=null">{{errorText}}</sqan>
                </fieldset>
                <div class="clearfix"></div>
