<style>
    .modellgModify {
        width: 1600px;
    }
</style>
<div class="modal fade site-modal in" id="stockPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content modellgModify" style="overflow:scroll">
            <div class="modal-header" style="width:1620px;"> Material Stock<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">

                <div class="col-md-12">
                    <div style="width:1610px; color:forestgreen;font-weight:bold;" class="text-right">Qty will reduce from total balance qty</div>
                    <table class="table table-striped" style="font-size: 12px;white-space: nowrap; ">
                        <thead>
							<tr>
								<th ng-hide="productNew.Id!=null">Select</th>
								<th>Vendor</th>
								<th>Entry Date</th>
								<th>PO No</th>
								<th>GRN Date</th>
								<th>GRN No</th>
								<th>Receive Qty</th>
								<th>Base Qty</th>
								<th>Issue Qty</th>
								<th>Issue Return Qty</th>
								<th>Purchase Return Qty</th>
								<th>Reduction By Adjustment Qty</th>
								<th>Inventory Sales Qty</th>
								<th>Inventory Scrap Qty</th>
								<th>Balance Qty</th>
								<th>Rate</th>
								<th>Base Rate</th>
								<th>Approved</th>
								<th>Posting</th>
								<th class="col-md-2">Adjustment Qty&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
							</tr>
                        </thead>
                        <tbody>
							<tr ng-repeat="x in materialStockList">
								<td ng-hide="productNew.Id!=null">
									<div class="checkbox-site">
										<label>
											<input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag">
											<span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
										</label>
									</div>
								</td>
								<td>{{x.PartyCode}}-{{x.PartyName}}</td>
								<td>{{x.ReceiveDate}}</td>
								<td>{{x.PONo}}</td>
								<td>{{x.GRNDate}}</td>
								<td>{{x.GRNNo}}</td>
								<td>{{x.TransactionQty}} {{x.TUoM}}</td>
								<td>{{x.BaseQty}} {{x.BUoM}}</td>
								<td>{{x.BaseIssueQty}} {{x.TUoM}}</td>
								<th>{{x.IssueReturnQty}}</th>
								<th>{{x.PurchaseReturnQty}}</th>
								<th>{{x.ReductionByAdjustmentQty}}</th>

								<th>{{x.InventorySalesQty}}</th>
								<th>{{x.InventoryScrapQty}}</th>

								<td>{{x.BalanceStock}} {{x.TUoM}}</td>
								<td>{{x.BaseRate|setDecimal:2}} {{x.TCurrency}}</td>
								<td>{{x.BaseCurrencyRate|setDecimal:2}} {{x.BCurrency}}</td>
								<td>{{x.IsApproved}}</td>
								<td>{{x.IsPosting}}</td>
								<td class="text-right" colspan="2">
									<div class="input-group">
										<input type="text" n-decimals="2" ng-model="x.RequisitionQty" width="200" class="form-control text-right" @*ng-keyup="calculateBaseQty(x)"*@ ng-disabled="productNew.Id!=null" />
										<span class="input-group-addon">{{x.TUoM}}</span>
									</div>
								</td>
							</tr>
							<tr>
								<td colspan="6" class="text-right"><strong>Total : </strong></td>
								<td class="text-left"><strong>{{materialStockList | sumByKey : 'TransactionQty' }}</strong></td>
								<td class="text-left"><strong>{{materialStockList | sumByKey : 'BaseQty' }}</strong></td>
								<td class="text-left"><strong>{{materialStockList | sumByKey : 'BaseIssueQty' }}</strong></td>
								@*<td class="text-left"><strong>{{materialStockList | sumByKey : 'IssueQty' }}</strong></td>*@
								<td class="text-left"><strong>{{materialStockList | sumByKey : 'IssueReturnQty' }}</strong></td>
								<td class="text-left"><strong>{{materialStockList | sumByKey : 'PurchaseReturnQty' }}</strong></td>
								<td class="text-left"><strong>{{materialStockList | sumByKey : 'ReductionByAdjustmentQty' }}</strong></td>
								<td class="text-left"><strong>{{materialStockList | sumByKey : 'InventorySalesQty' }}</strong></td>
								<td class="text-left"><strong>{{materialStockList | sumByKey : 'InventoryScrapQty' }}</strong></td>
								<td class="text-left"><strong>{{materialStockList | sumByKey : 'BalanceStock' }}</strong></td>

								<td colspan="4"></td>
								<td class="text-left"><strong>{{materialStockList | sumByKey : 'RequisitionQty' }}</strong></td>
								<td></td>
							</tr>
                        </tbody>
                    </table>
                </div>
                <div class="common-btn" style="width:1620px;">
                    <ul class="list-inline text-right">
                        <li><button ng-hide="productNew.Id!=null" ng-click="addMaterialStock();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add</button></li>
                        <li><button ng-hide="productNew.Id==null" ng-click="closeStockPopUp();" class="btn">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>