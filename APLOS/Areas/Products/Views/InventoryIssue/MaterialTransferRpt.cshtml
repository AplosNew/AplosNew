
<style>

    .loaderr {
        width: 300px;
        height: 200px;
        background-color: #0780BA;
        color: #fff;
        padding: 100px;
        font-size: 25px;
    }

    .e-grid .e-headercelldiv {
        font-weight: bold;
        font-size: 10px;
        display: block;
        border: 0 none;
        height: 29px;
        line-height: 29px;
        margin: -7px;
        padding: 0 .7em;
        text-align: left;
        white-space: nowrap;
        text-overflow: ellipsis;
        font-family: "Arial Narrow";
    }

    .e-grid .e-rowcell {
        border-width: 1px 0 0 1px;
        padding: .7em;
        line-height: 10px;
        white-space: nowrap;
        width: auto;
        vertical-align: middle;
    }
    .e-grid.e-wrap .e-columnheader .e-headercelldiv {
        margin-bottom: 2px;
        margin-top: 0;
        font-size: 9px;
    }


    e-grid .e-columnheader .wrap .e-headercelldiv {
        height: Auto;
    }

    .e-grid .e-excelfilter .e-btncontainer input {
        padding: .2em .4em .3em;
    }

    .e-grid.e-dlgcontainer .e-dlgBtns .e-clear {
        padding: 3px;
    }

    .e-grid.e-dlgcontainer .e-dlgBtns .e-filter {
        padding: 3px;
    }

    ::-ms-clear {
        display: none;
    }

    .e-grid.filtered .e-filteredicon {
        color: red;
    }
</style>

<script>



	function chkChange(Id, UserName) {
		debugger;
		$("#message").text(Id);
		$("#PartyCode").text(Id);
		$("#Vendor").val(UserName);
		$('#partyPopUp').modal('hide');
		PartyId = $("#PartyCode").text();
	}
	function getMasterId(Id) {
		debugger;
		$("#masterId").text(Id);

	}
</script>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>

<div id="Test">

    <h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Material Transfer Register</h3>
    <div class="form-elements form-horizontal">
        <div class="col-xs-12 col-sm-12 col-md-12" ng-form="from0">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Filter By GRN Date</legend>
                        <div class="clearfix"></div>
                        <div class="form-group" show-errors id="div_FromDate">
                            <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                            <div class="col-sm-9 show-message">
                                <input type="text" name="Form Date" ng-model="report.FromDate" datepicker tabindex="2" class="form-control">
                            </div>
                        </div>

                        <div class="form-group" show-errors id="div_ToDate">
                            <label class="col-sm-3 control-label">TO Date<sup>*</sup></label>
                            <div class="col-sm-9  show-message">
                                <input type="text" name="To Date" ng-model="report.ToDate" datepicker tabindex="3" class="form-control">
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="getMaterialTransferView();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> View</button></li>
                            </ul>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
        @*<div class="common-btn">
            <ul class="list-inline text-left">
                <li> <button id="go2" class="btn" ng-click="PurchaseOrderReportPdf();"><i class="glyphicon glyphicon-download"></i> Export To Pdf</button></li>
                <li> <button id="go3" class="btn" ng-click="PurchaseOrderReportExcel();"><i class="glyphicon glyphicon-download"></i> Export To Excel</button></li>
            </ul>
        </div>*@


        <div class="common-btn">
            <ul class="list-inline text-left">

                <li>
                    <div ej-tooltip e-showshadow="true" e-content="All active orders with individual line items" ng-click="PurchaseOrderReportPdf('Pdf');" e-width="width">
                        <button class="btn"><i class="glyphicon glyphicon-file"></i>Export To Pdf</button>
                    </div>
                </li>

                <li>
                    <div ej-tooltip e-showshadow="true" e-content="All active orders with individual line items" ng-click="PurchaseOrderReportExcel('Excel');" e-width="width">
                        <button class="btn"><i class="glyphicon glyphicon-file"></i>Export To Excel</button>
                    </div>
                </li>
            </ul>
        </div>
        <div class="clearfix"></div>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
            <div id="PR">
                <div class="content-container-fluid" style="color:black;">

                    <div style="color:black;" id="GridPrint" ej-grid e-datasource="MaterialTransferList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionCompleteSelected"
                         e-allowscrolling="true" e-showstackedheader="true" e-allowExcelExport='true' e-enableGroupingBar="true">
                        <div e-columns>
                            <div e-column e-field="GRNId" e-headertext="PR No" e-width="100" textAlign='Left'></div>
                            <div e-column e-field="InventoryReceiveDetailId" e-headertext="GRN Row No" e-width="100" textAlign='Left'></div>
                            <div e-column e-field="GRNEntryDate" e-headertext="PR Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="PartyName" e-headertext="Party" e-width="180" textAlign='Left'></div>
                            <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                            <div e-column e-field="DocDate" e-headertext="Doc Ref Date" e-width="100"></div>
                            <div e-column e-field="MaterialType" e-headertext="Material Type" e-width="180"></div>
                            <div e-column e-field="MaterialGroupMasterName" e-headertext="Material Group" e-width="180"></div>
                            <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="180"></div>
                            <div e-column e-field="ArticleName" e-headertext="Article" e-width="180"></div>
                            <div e-column e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="80"></div>
                            <div e-column e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="80"></div>
                            <div e-column e-field="ThirdCharacteristicsValue" e-headertext="SKU3" e-width="80"></div>
                            <div e-column e-field="TransactionQty" e-headertext="Transaction Qty" e-width="130" textAlign='Right'></div>
                            <div e-column e-field="UOM" e-headertext="UoM" e-width="100"></div>
                            <div e-column e-field="MaterialTranRate" e-headertext="Transaction Rate" e-width="130" textAlign='Right'></div>
                            <div e-column e-field="CredtibleStatus" e-headertext="Credtible Status" e-width="130"></div>
                            <div e-column e-field="MaterialTranAmount" e-headertext="Transaction Amount" e-width="180" textAlign='Right'></div>
                            <div e-column e-field="TaxAmount" e-headertext="Tax Amount" e-width="130" textAlign='Right'></div>
                            <div e-column e-field="ServiceCharge" e-headertext="Service Charge" e-width="130" textAlign='Right'></div>
                            <div e-column e-field="ServiceTax" e-headertext="Service Tax" e-width="130" textAlign='Right'></div>
                            <div e-column e-field="TotalMaterialTranAmount" e-headertext="Total Material Tran Amount" e-width="130" textAlign='Right'></div>
                            <div e-column e-field="TotalMaterialBaseAmount" e-headertext="Total Material Books Currency Amount" e-width="130" textAlign='Right'></div>
                            <div e-column e-field="TrnCurrencyBaseRate" e-headertext="Trn Currency Base Rate" e-width="130" textAlign='Right'></div>
                            <div e-column e-field="BooksCurrencyBaseRate" e-headertext="Books Currency Base Rate" e-width="130" textAlign='Right'></div>
                            <div e-column e-field="IsAsset" e-headertext="MM-IsAsset" e-width="80"></div>
                            <div e-column e-field="GrnDetailId" e-headertext="PR Row ID" e-width="130"></div>
                            <div e-column e-field="AddedBy" e-headertext="Prepared By" e-width="130"></div>
                            <div e-column e-field="GRNCheckStatus" e-headertext="Status" e-width="130"></div>
                            <div e-column e-field="CheckedBY" e-headertext="Checking Name" e-width="130"></div>
                            <div e-column e-field="AuthorizedBy" e-headertext="Approving Name" e-width="130"></div>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
</div>
