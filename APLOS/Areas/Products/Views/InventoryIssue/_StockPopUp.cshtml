<style>
	.modellgModify {
		width: 1460px;
	}
</style>
<div class="modal fade site-modal in" id="stockPopUp" role="dialog" data-backdrop="static">
	<div class="modal-dialog modal-lg modellgModify">
		<div class="modal-content" style="overflow:scroll">
			<div class="modal-header" style="width:1960px;"> Material Stock<button type="button" class="close" data-dismiss="modal">&times;</button></div>
			<div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped" style="font-size: 12px;white-space: nowrap; ">
                            <thead>
                                <tr>
                                    <th ng-hide="productNew.Id!=null">Select</th>
                                    <th>IsOpeningBalance</th>
                                    <th>Vendor</th>
                                    <th>Entry Date</th>
                                    <th>PO No</th>
                                    <th>GRN Date</th>
                                    <th>GRN No</th>
                                    <th>SO No</th>
                                    <th>Storage Location</th>
                                    <th>Balance Qty</th>
                                    <th class="col-md-3" colspan="3" style="width:300px;">Requisition Qty&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                                    <th colspan="2" style="width:200px;">Bale Qty&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                                    <th>Lot No.</th>
                                    <th>Receive Qty</th>
                                    <th>Issue Qty</th>
                                    <th>Shortage Qty</th>
                                    <th>Purchase Return Qty</th>
                                    <th>Issue Return Qty</th>
                                    <th>Adjustment Qty</th>
                                    <th>InventorySales Qty</th>
                                    <th>InventoryScrap Qty</th>


                                    <th>Rate</th>
                                    <th>Base Rate</th>
                                    <th>Approved</th>
                                    <th>Posting</th>
                                    <th>IssueByUoM</th>
                                    <th>TransferedFromGrnId</th>
                                    @*<th class="col-md-3">Requisition Qty&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>*@
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in materialStockList">
                                    <td ng-hide="productNew.Id!=null">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>{{x.IsOpeningBalance}}</td>
                                    <td>{{x.PartyCode}}-{{x.PartyName}}</td>
                                    <td>{{x.ReceiveDate}}</td>
                                    <td>{{x.PONo}}</td>
                                    <td>{{x.GRNDate}}</td>
                                    <td>{{x.InventoryReceiveDetailId}}</td>
                                    <td>{{x.SalesOrderId}}</td>
                                    <td>{{x.MaterialStorage}}</td>
                                    <td>{{x.BalanceStock}} {{x.BUoM}}</td>
                                    <td class="text-right" colspan="3">
                                        <div class="input-group">
                                            <input type="text" n-decimals="20" ng-model="x.RequisitionQty" class="form-control text-right" ng-keyup="calculateBaseQty(x)" ng-disabled="productNew.Id!=null" width="200" />
                                            <span class="input-group-addon">{{x.TrasactopmUomQty}}</span>
                                            <span class="input-group-addon">{{x.IssueTransactionUoM}}</span>
                                        </div>
                                    </td>
                                    <td class="text-right" colspan="2">
                                        <div class="input-group">
                                            <span class="input-group-addon">{{x.BalanceBaleQty}}</span>
                                            <input type="text" n-decimals="20" ng-model="x.CurrentIssueBaleQty" class="form-control text-right"  ng-disabled="productNew.Id!=null" width="200" />
                                        </div>
                                    </td>
                                    <td>{{x.LotNumber}}</td>
                                    <td>{{x.TransactionQty}} {{x.TUoM}}</td>
                                    @*<td>{{x.BaseQty}} {{x.BUoM}}</td>*@
                                    <td>{{x.BaseIssueQty}} {{x.BUoM}}</td>
                                    <td>{{x.ShortageQty}} {{x.BUoM}}</td>

                                    <td>{{x.PurchaseReturnQty}} {{x.BUoM}}</td>
                                    <td>{{x.IssueReturnQty}} {{x.BUoM}}</td>
                                    <td>{{x.ReductionByAdjustmentQty}} {{x.BUoM}}</td>

                                    <td>{{x.InventorySalesQty}} {{x.BUoM}}</td>
                                    <td>{{x.InventoryScrapQty}} {{x.BUoM}}</td>


                                    <td>{{x.BaseRate|setDecimal:4}} {{x.TCurrency}}</td>
                                    <td>{{x.BaseCurrencyRate|setDecimal:4}} {{x.BCurrency}}</td>
                                    <td>{{x.IsApproved}}</td>
                                    <td>{{x.IsPosting}}</td>
                                    <td>{{x.TransferedFromGrnId}}</td>
                                    <td>{{x.IssueByUoM}}</td>


                                </tr>
                                <tr>
                                    <td colspan="9" class="text-right"><strong>Total : </strong></td>
                                    <td class="text-left"><strong>{{materialStockList | sumByKey : 'BalanceStock' }}</strong></td>
                                    <td class="text-center"><strong>{{materialStockList | sumByKey : 'RequisitionQty' }}</strong></td>
                                    <td colspan="5"></td>
                                    <td class="text-left"><strong>{{materialStockList | sumByKey : 'TransactionQty' }}</strong></td>
                                    @*<td class="text-left"><strong>{{materialStockList | sumByKey : 'BaseQty' }}</strong></td>*@
                                    <td class="text-left"><strong>{{materialStockList | sumByKey : 'IssueQty' }}</strong></td>

                                    <td class="text-left"><strong>{{materialStockList | sumByKey : 'PurchaseReturnQty' }}</strong></td>
                                    <td class="text-left"><strong>{{materialStockList | sumByKey : 'IssueReturnQty' }}</strong></td>
                                    <td class="text-left"><strong>{{materialStockList | sumByKey : 'ReductionByAdjustmentQty' }}</strong></td>

                                    <td class="text-left"><strong>{{materialStockList | sumByKey : 'InventorySalestQty' }}</strong></td>
                                    <td class="text-left"><strong>{{materialStockList | sumByKey : 'InventoryScraptQty' }}</strong></td>
                                    <td class="text-left"><strong>{{materialStockList | sumByKey : 'InventoryTransfertQty' }}</strong></td>



                                    <td class="text-left"><strong>&nbsp;@*{{materialStockList | sumByKey : 'BaseQty' }}*@</strong></td>
                                    <td colspan="4"></td>


                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                    <div class="common-btn">
                        <ul class="list-inline text-left" @*style="width:1960px;"*@>
                            <li><button ng-hide="productNew.Id!=null" ng-click="addMaterialStock();" class="btn"><i class="glyphicon glyphicon-plus"></i> Submit</button></li>
                            <li><button @*ng-hide="productNew.Id==null"*@ ng-click="closeStockPopUp();" class="btn">Close</button></li>
                        </ul>
                    </div>
                </div>
		</div>
	</div>
</div>