                                <td class="text-right">{{x.Percentage}}</td>
                                <td class="text-right">
                                    <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.TaxAmount" ng-keyup="sumTaxAmount();" class="form-control text-right" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right">Total Tax (BC)</td>
                                <td class="text-right">{{detailModel.TotalTaxAmount| setDecimal:currencyPrecision}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="detailSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{detailModel.Id.length>0?'Update':'Save'}}</button></li>
                        <li><button ng-click="closeDetaiPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
