<togglable name="Employee Purchase"></togglable>
<div class="form-horizontal form-elements" ng-form="productNewForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Employee.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-addon">{{productNew.EmployeeCode}}</span>
                    <input type="text" name="@Library.Model.Parties.PartyType.Employee.ToString()" ng-model="productNew.EmployeeName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                        @*<button ng-click="clearEmployeePopUp()" class="btn single-small-btn" tabindex="3"><i class="glyphicon glyphicon-refresh"></i></button>*@
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-addon">{{productNew.PartyCode}}</span>
                    <input type="text" name="Vendor" ng-model="productNew.PartyName" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" ng-click="showPartyPopUp()" ng-disabled="inventoryMaterialList.length>0" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 pdl3 pdr3">
        <div class="col-md-8">
            <div class="form-group" id="div_docNo">
                <label class="col-sm-6 control-label">Vendor Doc. RefNo<sup>*</sup></label>
                <div class="col-sm-6 show-message pdr3">
                    <input type="text" name="DocRefNo" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.DocRefNo" class="form-control" ng-keyup="modelValidation('div_docNo', 'productNew', 'DocRefNo');" maxlength="20" tabindex="2">
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group" id="div_docDate">
                <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                <div class="col-sm-9 show-message pdl3">
                    <input type="text" name="Date" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.DocDate" datepicker="modelValidation('div_docDate', 'productNew', 'DocDate');changePaymentTerm();getToCurrencyRate();" end-date="currentDate" id="cutOffDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="3">
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-md-6 pdl3 pdr3">
        <div class="col-md-8">
            <div class="form-group" id="div_entryNo">
                <label class="col-sm-6 control-label">Gate Entry No<sup>*</sup></label>
                <div class="col-sm-6 show-message pdr3">
                    <input type="text" name="Gate EntryNo" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.GateEntryNo" class="form-control" ng-keyup="modelValidation('div_entryNo', 'productNew', 'GateEntryNo');" maxlength="10" tabindex="4">
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group" id="div_entryDate">
                <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                <div class="col-sm-9 show-message pdl3">
                    <input type="text" name="Entry Date" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.EntryDate" datepicker="modelValidation('div_entryDate', 'productNew', 'EntryDate');" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="5">
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 pdl3 pdr3">
        <div class="col-md-8">
            <div class="form-group" id="div_grnNo">
                <label class="col-sm-6 control-label">GRN No<sup>*</sup></label>
                <div class="col-sm-6 show-message pdr3">
                    <input type="text" name="GRN No" ng-model="productNew.Id" class="form-control" maxlength="10" disabled>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group" id="div_grnDate">
                <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                <div class="col-sm-9 show-message pdl3">
                    <input type="text" name="GRN Date" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.GRNDate" datepicker="modelValidation('div_grnDate', 'productNew', 'GRNDate');" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="6">
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Storage Location<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Storage Location" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.MaterialStorageId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in storageList" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 pdl3 pdr3">
        <div class="col-md-8">
            <div class="form-group" id="div_currency">
                <label class="col-sm-6 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-6 show-message pdr3">
                    <div class="select-style">
                        <select class="form-control" id="currency" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList"
                                ng-change="changeCurrency();getToCurrencyRate();manualValidationAddRemove('div_currency', 'productNew', 'CurrencyId');" tabindex="8">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group" id="div_rate">
                <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Rate<sup ng-hide="productNew.CurrencyId==productNew.BaseCurrencyId">*</sup></label>
                <div class="col-sm-9 show-message pdl3">
                    <input type="text" n-decimals="{{currencyPrecision}}" name="GRN Date" ng-model="productNew.ToCurrencyRate" ng-disabled="productNew.CurrencyId==productNew.BaseCurrencyId||inventoryMaterialList.length>0" ng-keyup="manualValidationAddRemove('div_rate', 'productNew', 'ToCurrencyRate');" class="form-control text-right" tabindex="9">
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Non Creditable</label>
            <div class="col-sm-1">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.IsNonCreditable">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-3 control-label">Along with Invoice</label>
            <div class="col-sm-1">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.AlongwithInvoice" ng-click="changeAllInvoice();">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-2 control-label" ng-show="productNew.TaxApplicable=='Mandatory'">Revers Charge</label>
            <div class="col-sm-1" ng-show="productNew.TaxApplicable=='Mandatory'">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-disabled="!productNew.IsTaxApplicableChangeable" ng-model="productNew.IsTaxApplicable">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors ng-show="productNew.AlongwithInvoice">
            <label class="col-sm-4 control-label">Invoice No<sup>*</sup></label>
            <div class="col-sm-4 show-message pdr3 ">
                <input type="text" name="Invoice No" ng-model="productNew.InvoiceNo" class="form-control" maxlength="20" ng-required="productNew.AlongwithInvoice" tabindex="10">
            </div>
            <label class="col-sm-1 control-label pdl3 pdr3">Date<sup>*</sup></label>
            <div class="col-sm-3 show-message pdl3">
                <input type="text" name="Invoice Date" ng-model="productNew.InvoiceDate" datepicker class="form-control" placeholder="dd-Mmm-yyyy" ng-required="productNew.AlongwithInvoice" tabindex="11">
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Payment Term</legend>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Payment Term<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select id="paymentTermId" class="form-control" name="Payment Term" ng-model="productNew.PaymentTermId" ng-change="changePaymentTerm();" tabindex="12" required>
                                <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-5 control-label">Due Date BaseOn<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="BaseOnDueDate" ng-model="productNew.BaseOnDueDate" ng-disabled="IsBaseOnDueDateEnable"
                               datepicker="getMatureDate(productNew.BaseOnDueDate, productNew.BaseNoOfDays);" class="form-control datepicker" tabindex="13" required>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">No Of Days</label>
                    <div class="col-sm-2 pdr3 show-message">
                        <input id="baseNoOfday" type="text" ng-disabled="inventoryMaterialList.length>0" only-numbers name="baseNoOfday" ng-model="productNew.BaseNoOfDays" ng-keyup="getMatureDate(productNew.BaseOnDueDate, productNew.BaseNoOfDays)" class="form-control text-right" tabindex="14">
                    </div>
                    <label class="col-sm-3 control-label">Mature Date</label>
                    <div class="col-sm-4 show-message">
                        <input type="text" name="DueDate" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.MatureDate" class="form-control" readonly>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="clearfix"></div>
    <ul class="common-btn list-inline text-right">
        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{productNew.Id.length>0?'Update':'Save'}}</button></li>
        <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
    </ul>
    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Material</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Charges</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div ng-form="tabForm1">
                <ul class="col-md-6 common-btn list-inline text-left">
                    <li><button ng-click="detailPopUp();" ng-disabled="productNew.Id==null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Material</button></li>
                </ul>
                @*<div class="col-md-6 form-group text-right" style="padding-top: 17px;">
                        <label class="control-label" style="margin-right: -32px;" ng-hide="grossTotal==0">Gross Amount : {{grossTotal| number| setDecimal:currencyPrecision}}</label>
                    </div>*@
                <table class="col-md-6 text-right" ng-show="inventoryMaterialList.length>0">
                    <tbody>
                        <tr>
                            <td></td>
                            <td>Amount</td>
                            <td>Tax</td>
                            <td>Total</td>
                        </tr>
                        <tr>
                            <td>Materials</td>
                            <td>{{inventoryMaterialList | sumByKey : 'TrnAmount'| setDecimal:currencyPrecision| number }}</td>
                            <td>{{inventoryMaterialList | sumByKey : 'BaseTaxAmount'| setDecimal:currencyPrecision | number}}</td>
                            <td>{{(inventoryMaterialList | sumByKey : 'TrnAmount'| setDecimal:currencyPrecision)+(inventoryMaterialList | sumByKey : 'BaseTaxAmount' | setDecimal:currencyPrecision)|number}}</td>
                        </tr>
                        <tr style="border-bottom: 1px solid;">
                            <td>Service</td>
                            <td>{{inventoryMaterialList | sumByKey : 'ServiceCharge'| setDecimal:currencyPrecision | number}}</td>
                            <td>{{inventoryMaterialList | sumByKey : 'ServiceTax'| setDecimal:currencyPrecision | number}}</td>
                            <td>{{(inventoryMaterialList | sumByKey : 'ServiceCharge'| setDecimal:currencyPrecision)+(inventoryMaterialList | sumByKey : 'ServiceTax' | setDecimal:currencyPrecision)| number}}</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td>Gross Amount</td>
                            <td>{{(inventoryMaterialList | sumByKey : 'TrnAmount'| setDecimal:currencyPrecision)+(inventoryMaterialList | sumByKey : 'BaseTaxAmount'| setDecimal:currencyPrecision )+(inventoryMaterialList | sumByKey : 'ServiceCharge'| setDecimal:currencyPrecision)+(inventoryMaterialList | sumByKey : 'ServiceTax'| setDecimal:currencyPrecision)| number}}</td>
                        </tr>
                    </tbody>
                </table>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table" ng-show="inventoryMaterialList.length>0">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material Group</th>
                                <th>Material Master</th>
                                <th>Article</th>
                                <th>Char1</th>
                                <th>Char2</th>
                                <th>Char3</th>
                                <th>Qty</th>
                                <th>Rate</th>
                                <th>Amount (TRN)</th>
                                <th>Tax</th>
                                <th>Service Charge</th>
                                <th>Service Tax</th>
                                <th>Material Amount (BC)</th>
                                <th class="col-sm-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in inventoryMaterialList">
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.FirstCharacteristicsValue}}</td>
                                <td>{{x.SecondCharacteristicsValue}}</td>
                                <td>{{x.ThirdCharacteristicsValue}}</td>
                                <td class="text-right">{{x.TransactionQty}}  {{x.TransactionUoM}}</td>
                                <td class="text-right">{{x.TransactionRate| setDecimal:currencyPrecision| number}}  {{x.CurrencyName}}</td>
                                <td class="text-right">{{x.TrnAmount| setDecimal:currencyPrecision| number}}</td>
                                <td class="text-right">{{x.BaseTaxAmount| setDecimal:currencyPrecision| number}}</td>
                                <td class="text-right">{{x.ServiceCharge| setDecimal:currencyPrecision| number}}</td>
                                <td class="text-right">{{x.ServiceTax| setDecimal:currencyPrecision| number}}</td>
                                <td class="text-right">{{x.BaseAmount| setDecimal:currencyPrecision| number}}</td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="getReceiveTaxList(x, false)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
                                        <li><button ng-click="valuePassInDelModal(x.InventoryReceiveDetailId)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6" class="text-right"><strong>Total : </strong></td>
                                <td class="text-right" ng-hide="sumORnot"></td>
                                <td class="text-right" ng-show="sumORnot"><strong>{{inventoryMaterialList | sumByKey : 'TransactionQty' }}</strong></td>
                                <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'TransactionRate' }}</strong></td>
                                <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'TrnAmount'| setDecimal:currencyPrecision| number }}</strong></td>
                                <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'BaseTaxAmount'| setDecimal:currencyPrecision | number}}</strong></td>
                                <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'ServiceCharge'| setDecimal:currencyPrecision | number}}</strong></td>
                                <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'ServiceTax'| setDecimal:currencyPrecision | number}}</strong></td>
                                <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'BaseAmount'| setDecimal:currencyPrecision | number}}</strong></td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="getTotalReceiveTaxList(inventoryMaterialList | sumByKey : 'TrnAmount',true)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div ng-form="tabForm2">
                <ul class="common-btn list-inline text-left">
                    <li><button ng-click="serviceChargePopUp();" ng-disabled="productNew.Id==null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Charges</button></li>
                </ul>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th>Amount (TRN)</th>
                                <th>Total Tax Amount</th>
                                <th class="col-sm-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in chargesList">
                                <td>{{x.ServiceMasterName}}</td>
                                <td class="text-right">{{x.Amount|number}}</td>
                                <td class="text-right">{{x.TotalTaxAmount|number}}</td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="getServiceTaxList(x, false)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
                                        <li><button ng-click="delModal(x.Id)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Vendor</th>
                    <th>Account Group</th>
                    <th>GRN No</th>
                    <th>GRN Date</th>
                    <th>Vendor DocNo</th>
                    <th>Invoice No</th>
                    <th>Invoice Date</th>
                    <th>Qty</th>
                    <th>Amount (TRN)</th>
                    <th>Amount (BC)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in products |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'products'" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.EmployeeCode}} - {{x.EmployeeName}}</td>
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>{{x.PartyAccountGroupName}}</td>
                    <td>{{x.Id}}</td>
                    <td>{{x.GRNDate | date:'dd-MMM-yyyy'}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.InvoiceNo}}</td>
                    <td>{{x.InvoiceDate}}</td>
                    <td class="text-right">{{x.TransactionQty|number}}  {{x.TransactionUoM}}</td>
                    <td class="text-right">{{x.TransactionAmount|number}} {{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.BaseAmount|number}}</td>
                    <td>
                        <ul class="list-inline action-list">
                            <li> <button ng-click="inventoryReceiveReport(x.Id, 'Pdf');" class="btn"><i class="fa fa-file-pdf-o"></i></button></li>
                            <li> <button ng-click="inventoryReceiveReport(x.Id, 'Excel');" class="btn"><i class="fa fa-file-excel-o"></i></button></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'products'"
                                 direction-links="true" boundary-links="true"
                                 on-page-change="getData(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUp.cshtml")
<div class="modal fade site-modal in" id="invoicingPartyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Invoicing Party<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 col-md-4 control-label">Invoicing by</label>
                        <div class="col-sm-8">
                            <div class="select-style">
