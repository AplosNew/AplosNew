<style>
    .modellgModify {
        width: 1250px;
    }
</style>
<togglable name="Vendor GRN (Independent)"></togglable> @*Inventory Receive(GRN Without PO) GRN (Through Vendor)*@
<div class="form-horizontal form-elements" ng-form="productNewForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <div class="col-sm-4">
                <div class="radio">
                    <label>
                        <input type="radio" name="PType" ng-model="partyType" value="Vendor" ng-click="hide()">
                        <span class="cr"><i class="cr-icon"></i></span>Vendor<sup>*</sup>
                    </label>
                    <label>
                        <input type="radio" name="PType" ng-model="partyType" value="Director" ng-click="show()">
                        <span class="cr"><i class="cr-icon"></i></span>Director<sup>*</sup>
                    </label>
                </div>
            </div>


            @*<label class="col-sm-4 control-label">Vendor<sup>*</sup></label>*@
            <input type="text" value="GRN" id="GRNIdLoad" ng-hide="true" />
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-addon">{{productNew.PartyCode}}</span>
                    <input type="text" name="Vendor" ng-model="productNew.PartyName" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" ng-click="showPartyByGateEntryPopUpNew()" ng-disabled="inventoryMaterialList.length>0" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" id="div_TT" show-errors>
            <label class="col-sm-4 control-label">Trancastion Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Trancastion Type" ng-model="productNew.TrancastionTypeId" ng-options="item.Value as item.Text for item in TrancastionTypeCboList" tabindex="8"required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 pdl3 pdr3">
        <div class="col-md-8">
            <div class="form-group" id="div_docNo">
                <label class="col-sm-6 control-label">Vendor Doc. RefNo<sup>*</sup></label>
                <div class="col-sm-6 show-message pdr3">
                    <input type="text" name="DocRefNo" @*ng-disabled="inventoryMaterialList.length>0"*@ ng-model="productNew.DocRefNo" class="form-control" ng-keyup="modelValidation('div_docNo', 'productNew', 'DocRefNo');CheckSpecialCharecter();" maxlength="20" tabindex="2" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group" id="div_docDate">
                <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                <div class="col-sm-9 show-message pdl3">
                    <input type="text" name="Date" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.DocDate" datepicker="modelValidation('div_docDate', 'productNew', 'DocDate');changePaymentTerm();getToCurrencyRate();" end-date="currentDate" id="cutOffDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="3">
                </div>

            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-md-6 pdl3 pdr3">

        <div class="col-md-8">
            <div class="form-group" id="div_entryNo">
                <label class="col-sm-6 control-label">Gate Entry No<sup>*</sup></label>

                <div class="col-sm-6 show-message">
                    <div class="input-group">
                        <input type="text" name="Gate Entry No" ng-model="productNew.GateEntryNo" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-disabled="inventoryMaterialList.length>0" ng-click="POPopUpGateEntry()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group" id="div_entryDate">
                <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                <div class="col-sm-9 show-message pdl3">
                    <input type="text" name="Entry Date" ng-disabled="true" ng-model="productNew.EntryDate" datepicker="modelValidation('div_entryDate', 'productNew', 'EntryDate');" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="5" readonly>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 pdl3 pdr3">
        <div class="col-md-8">
            <div class="form-group" id="div_grnNo">
                <label class="col-sm-6 control-label">GRN No<sup>*</sup></label>
                <div class="col-sm-6 show-message pdr3">
                    <input type="text" name="GRN No" ng-model="productNew.Id" class="form-control" maxlength="10" disabled>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group" id="div_grnDate">
                <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                <div class="col-sm-9 show-message pdl3">
                    <input type="text" name="GRN Date" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.GRNDate" datepicker="modelValidation('div_grnDate', 'productNew', 'GRNDate');getTaxCodeByTaxYearWithhold(productNew.GRNDate)" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="6">
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Storage Location<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Storage Location" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.MaterialStorageId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in storageList" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 pdl3 pdr3">
        <div class="col-md-8">
            <div class="form-group" id="div_currency">
                <label class="col-sm-6 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-6 show-message pdr3">
                    <div class="select-style">
                        <select class="form-control" id="currency" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList"
                                ng-change="changeCurrency();getToCurrencyRate();manualValidationAddRemove('div_currency', 'productNew', 'CurrencyId');" tabindex="8">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group" id="div_rate">
                <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Rate<sup ng-hide="productNew.CurrencyId==productNew.BaseCurrencyId">*</sup></label>
                <div class="col-sm-9 show-message pdl3">
                    <input type="text" n-decimals="{{currencyPrecision}}" name="GRN Date" ng-model="productNew.ToCurrencyRate" ng-disabled="productNew.CurrencyId==productNew.BaseCurrencyId||inventoryMaterialList.length>0" ng-keyup="manualValidationAddRemove('div_rate', 'productNew', 'ToCurrencyRate');" class="form-control text-right" tabindex="9">
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Non Creditable</label>
            <div class="col-sm-1">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.IsNonCreditable">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            @*<label class="col-sm-3 control-label">Along with Invoice</label>
                <div class="col-sm-1">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.AlongwithInvoice" ng-click="changeAllInvoice();">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>*@
            <label class="col-sm-2 control-label" ng-show="productNew.TaxApplicable=='Mandatory'">Revers Charge</label>
            <div class="col-sm-1" ng-show="productNew.TaxApplicable=='Mandatory'">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-disabled="!productNew.IsTaxApplicableChangeable" ng-model="productNew.IsTaxApplicable">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>

        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Note For Accounts<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea name="Description" class="form-control" rows="2" ng-model="productNew.NoteForAccounts" tabindex="7"></textarea>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">

    </div>

    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label" ng-show="checkedByList.length">{{productNew.labelCheckAndApproved}}</label>
            <div class="col-sm-8 show-message">
                <div class="select-style" ng-show="checkedByList.length">
                    <select id="CheckedBy" class="form-control" name="Checked By" ng-model="productNew.CheckedBy" tabindex="12">
                        <option ng-repeat="option in checkedByList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Is FOC</label>
            <div class="col-sm-1">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.IsFOC">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    
    <div class="clearfix"></div>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">Order Specific(Yes/No)</legend>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-6 control-label">Order Specific</label>
                <div class="col-sm-6">
                    <div class="radio">
                        <label>
                            <input type="radio" name="OrderSpecific" ng-model="productNew.OrderSpecific" value="No" ng-click="hide()">
                            <span class="cr"><i class="cr-icon"></i></span>No
                        </label>
                        <label>
                            <input type="radio" name="OrderSpecific" ng-model="productNew.OrderSpecific" value="Yes" ng-click="show()">
                            <span class="cr"><i class="cr-icon"></i></span>Yes
                        </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Contract" ng-hide="productNew.OrderSpecific==='No'">Contract</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" name="Contract" ng-model="productNew.ContractId" class="form-control" maxlength="100" disabled ng-hide="productNew.OrderSpecific==='No'">
                    <span class="input-group-btn">
                        <button ng-click="GetPopUpContract()" class="btn single-small-btn" ng-hide="productNew.OrderSpecific==='No'"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="Clearcontract()" class="btn single-small-btn" ng-hide="productNew.OrderSpecific==='No'"><i class="glyphicon glyphicon-refresh"></i></button>
                        <button ng-click="GetMasterOrderByContractList()" ng-hide="productNew.OrderSpecific==='No'" class="btn single-small-btn"><i class="glyphicon glyphicon-list-alt"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Customer Name" ng-hide="productNew.OrderSpecific==='No'">Customer Name</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" name="Customer Name" ng-model="productNew.CustomerName" class="form-control" maxlength="100" disabled ng-hide="productNew.OrderSpecific==='No'">
                </div>
            </div>
        </div>

        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-4 col-md-4" ng-show="productNew.OrderSpecific==='Yes'">
            <div class="form-group">
                <label class="col-sm-4 control-label">Contract No</label>
                <div class="col-sm-6">
                    <div class="radio">
                        <label class="col-sm-6 control-label" style="padding-top:1px;">{{productNew.ContractNo}}</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4" ng-show="productNew.OrderSpecific==='Yes'">
            <div class="form-group">
                <label class="col-sm-4 control-label">Master LC Ref No</label>
                <div class="col-sm-6">
                    <div class="radio">
                        <label class="col-sm-6 control-label" style="padding-top:1px;">{{productNew.LCRef}}</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4" ng-show="productNew.OrderSpecific==='Yes'">
            <div class="form-group">
                <label class="col-sm-4 control-label">Trading PO</label>
                <div class="col-sm-1">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-disabled="productNew.OrderSpecific==='No'" ng-model="productNew.IsTradingPO">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

    </fieldset>
    <div class="clearfix"></div>
    <ul class="common-btn list-inline text-right">
        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{productNew.Id.length>0?'Update':'Save'}}</button></li>
        <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
    </ul>
    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Material</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Same Vendor Charges</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Other Vendor Charges</a></li>
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Documents Attach</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div ng-form="tabForm1">
                <ul class="col-md-6 common-btn list-inline text-left">
                    <li><button ng-click="detailPopUp();" ng-show="productNew.Id!=null  && (productNew.OrderSpecific=='No')" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Material</button></li>
                    <li><button ng-click="GetBOQItemList();" ng-show="productNew.Id!=null  && (productNew.OrderSpecific=='Yes')" class="btn"><i class="glyphicon glyphicon-plus"></i> Add BOQ Material</button></li>
                </ul>
                @*<div class="col-md-6 text-right" style="padding-top: 17px;">
                        <label class="control-label" style="margin-right: -32px;" ng-hide="grossTotal==0">Gross Amount : {{grossTotal| number| setDecimal:currencyPrecision}}</label>
                    </div>*@
                <table class="col-md-6 text-right" ng-show="inventoryMaterialList.length>0">
                    <tbody>
                        <tr>
                            <td></td>
                            <td>Amount</td>
                            <td>Tax</td>
                            <td>Total</td>
                        </tr>
                        <tr>
                            <td>Materials</td>
                            <td>{{inventoryMaterialList | sumByKey : 'TrnAmount'| setDecimal:currencyPrecision| number }}</td>
                            <td>{{inventoryMaterialList | sumByKey : 'TaxAmount'| setDecimal:currencyPrecision | number}}</td>
                            <td>{{(inventoryMaterialList | sumByKey : 'TrnAmount'| setDecimal:currencyPrecision)+(inventoryMaterialList | sumByKey : 'BaseTaxAmount' | setDecimal:currencyPrecision)|number}}</td>
                        </tr>
                        <tr style="border-bottom: 1px solid;">
                            <td>Service</td>
                            <td>{{inventoryMaterialList | sumByKey : 'ServiceCharge'| setDecimal:currencyPrecision | number}}</td>
                            <td>{{inventoryMaterialList | sumByKey : 'ServiceTax'| setDecimal:currencyPrecision | number}}</td>
                            <td>{{(inventoryMaterialList | sumByKey : 'ServiceCharge'| setDecimal:currencyPrecision)+(inventoryMaterialList | sumByKey : 'ServiceTax' | setDecimal:currencyPrecision)| number}}</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td>Net Amount</td>
                            <td>{{(inventoryMaterialList | sumByKey : 'TrnAmount'| setDecimal:currencyPrecision)+(inventoryMaterialList | sumByKey : 'BaseTaxAmount'| setDecimal:currencyPrecision )+(inventoryMaterialList | sumByKey : 'ServiceCharge'| setDecimal:currencyPrecision)+(inventoryMaterialList | sumByKey : 'ServiceTax'| setDecimal:currencyPrecision)| number}}</td>
                        </tr>
                    </tbody>
                </table>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table" ng-show="inventoryMaterialList.length>0">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>RowId</th>
                                <th>Material Group</th>
                                <th>Material Master</th>
                                <th>Article</th>
                                <th>Sku1</th>
                                <th>Sku2</th>
                                <th>Sku3</th>
                                <th>MaterialStorage</th>
                                <th>MaterialDetail</th>
                                <th>Lot Number</th>
                                <th>Diameter</th>
                                <th>Type</th>
                                <th>Country Name</th>
                                <th>Qty</th>
                                <th style="width:500px;">Shortage Qty &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                                <th style="width:500px;">Rejection Qty &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                                <th style="width:500px;">Valid Qty&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                                <th style="width:500px;">Net Qty&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                                <th>Rate</th>
                                <th>Amount (TRN)</th>
                                <th>Tax</th>
                                <th>Service Charge</th>
                                <th>Service Tax</th>
                                <th>Material Amount (Trn)</th>
                                <th>Material Amount (BC)</th>
                                <th>Additional Charges</th>
                                <th>Additional Charges Tax</th>
                                <th>QualityStatus</th>
                                <th>Master Order No</th>
                                <th class="col-sm-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in inventoryMaterialList">

                                <td>{{x.InventoryReceiveDetailId}}</td>
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.FirstCharacteristicsValue}}</td>
                                <td>{{x.SecondCharacteristicsValue}}</td>
                                <td>{{x.ThirdCharacteristicsValue}}</td>
                                <td>{{x.MaterialStorageName}}</td>
                                <td>{{x.Description}}</td>
                                <td>{{x.LotNumber}}</td>
                                <td>{{x.Diameter}}</td>
                                <td>{{x.Type}}</td>
                                <td>{{x.CountryName}}</td>
                                <td class="text-right">{{x.TransactionQty}}  {{x.TransactionUoM}}</td>
                                <td class="text-right"><input type="text" n-decimals="2" class="form-control text-right" ng-keyup="calculateAmount(x,$index);" width="500" ng-model="x.ShortageQty" ng-disabled="true"></td>  @*ng-keyup="calculateAmount(x);"*@
                                @*<td class="text-right">{{x.TransactionUoM}}</td>*@
                                <td class="text-right"><input type="text" n-decimals="2" class="form-control text-right" ng-keyup="calculateAmount(x,$index);" width="500" ng-model="x.RejectionQty" ng-disabled="true"></td>  @* ng-disabled="x.enableid"ng-keyup="calculateAmount(x);"*@
                                @*<td class="text-right">{{x.TransactionUoM}}</td>*@
                                <td class="text-right"><input type="text" n-decimals="2" class="form-control text-right" width="500" ng-model="x.ApprovedQty" ng-disabled="true"></td>  @*ng-keyup="calculateAmount(x);"*@
                                @*<td class="text-right">{{x.TransactionUoM}}</td>*@
                                <td class="text-right"><input type="text" n-decimals="2" class="form-control text-right" width="500" ng-model="x.NetQty" ng-disabled="true"></td>  @*ng-keyup="calculateAmount(x);"*@
                                @*<td class="text-right">{{x.TransactionUoM}}</td>*@


                                <td class="text-right" ng-hide="true"><input type="text" n-decimals="2" class="form-control text-right" width="200" ng-model="x.ShortageRate"></td>
                                <td class="text-right" ng-hide="true"><input type="text" n-decimals="2" class="form-control text-right" width="200" ng-model="x.ShortageValue"></td>
                                <td class="text-right" ng-hide="true"><input type="text" n-decimals="2" class="form-control text-right" width="200" ng-model="x.RejectionRate"></td>
                                <td class="text-right" ng-hide="true"><input type="text" n-decimals="2" class="form-control text-right" width="200" ng-model="x.RejectionValue"></td>
                                <td class="text-right" ng-hide="true"><input type="text" n-decimals="2" class="form-control text-right" width="200" ng-model="x.RejectionClamRate"></td>
                                <td class="text-right" ng-hide="true"><input type="text" n-decimals="2" class="form-control text-right" width="200" ng-model="x.ShortRejFlag"></td>

                                @*| setDecimal:currencyPrecision| number*@

                                <td class="text-right">{{x.TransactionRate| number}}  {{x.CurrencyName}}</td>
                                <td class="text-right">{{x.TrnAmount | setDecimal:currencyPrecision| number}}</td>
                                <td class="text-right">{{x.TaxAmount | setDecimal:currencyPrecision| number}}</td>
                                <td class="text-right">{{x.ServiceCharge | setDecimal:currencyPrecision| number}}</td>
