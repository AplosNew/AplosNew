<h3 class="site-heading">GRN Approved</h3>
<div class="form-horizontal form-elements row">
	<div class="col-md-6">
		<ul class="common-btn list-inline text-left">
			<li><button ng-click="grnPopUp();" class="btn"><i class="glyphicon glyphicon-search"></i> GRN</button></li>
		</ul>
	</div>
	<div class="col-md-6">
		<ul class="common-btn list-inline text-right">
			<li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
			<li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
		</ul>
	</div>
	<div class="col-md-12 table-responsive modal-table">
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Approved</th>
					<th>Vendor</th>
					<th>Account Group</th>
					<th>GRN No</th>
					<th>GRN Date</th>
					<th>Vendor DocNo</th>
					<th>Invoice No</th>
					<th>Invoice Date</th>
					<th>Qty</th>
					<th>Amount (TRN)</th>
					<th>Amount (BC)</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="x in modelList">
					<td>
						<div class="checkbox-site">
							<label>
								<input type="checkbox" ng-model="x.IsApproved">
								<span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
							</label>
						</div>
					</td>
					<td>{{x.PartyCode}} - {{x.PartyName}}</td>
					<td>{{x.PartyAccountGroupName}}</td>
					<td>{{x.Id}}</td>
					<td>{{x.GRNDate | date:'dd-MMM-yyyy'}}</td>
					<td>{{x.DocRefNo}}</td>
					<td>{{x.InvoiceNo}}</td>
					<td>{{x.InvoiceDate}}</td>
					<td class="text-right">{{x.TransactionQty|number}}  {{x.TransactionUoM}}</td>
					<td class="text-right">{{x.TransactionAmount|number}} {{x.CurrencyCode}}</td>
					<td class="text-right">{{x.BaseAmount|number}}</td>
					<td class="text-right">
						<ul class="list-inline action-list">
							<li><button ng-click="detailPopUp(x.Id);" class="btn btn-action tooltip-here" data-placement="top" title="Detail"><i class="glyphicon glyphicon-info-sign"></i></button></li>
							<li><button ng-click="removeRowModal(x.PartyCode - x.PartyName, $index,'modelList', 'Id', 'Id');" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
						</ul>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
</div>
<div class="modal fade site-modal in" id="grnPopUp" role="dialog" data-backdrop="static">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">Shift Defination<button type="button" class="close" data-dismiss="modal">&times;</button></div>
			<div class="modal-body">
				<div class="row text-right">
					<div class="col-xs-12 col-sm-12 col-sm-12">
						<div class="search-form">
							<div class="row">
								<div class="col-xs-12 col-sm-3 col-md-3">
									<div class="select-style">
										<select ng-model="popUpParameters.searchBy">
											<option ng-repeat="option in searchGrnList" value="{{option.value}}">{{option.name}}</option>
										</select>
									</div>
								</div>
								<div class="col-xs-12 col-sm-7 col-md-7">
									<input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getGrnData();">
								</div>
								<div class="col-xs-12 col-sm-2 col-md-2">
									<button type="button" ng-click="getGrnData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="table-responsive modal-table">
					<table class="table table-striped">
						<thead>
							<tr>
								<th>Select</th>
								<th>Vendor</th>
								<th>Account Group</th>
								<th>GRN No</th>
								<th>GRN Date</th>
								<th>Vendor DocNo</th>
								<th>Invoice No</th>
								<th>Invoice Date</th>
								<th>Qty</th>
								<th>Amount (TRN)</th>
								<th>Amount (BC)</th>
							</tr>
						</thead>
						<tbody>
							<tr dir-paginate="x in grnList | itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count" pagination-id="metaData.name + 'grnList'">
								<td>
									<div class="checkbox-site">
										<label>
											<input type="checkbox" ng-model="x.Flag" ng-click="genericPushInTempList(x,$event, modelList,'Id', 'Id');">
											<span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
										</label>
									</div>
								</td>
								<td>{{x.PartyCode}} - {{x.PartyName}}</td>
								<td>{{x.PartyAccountGroupName}}</td>
								<td>{{x.Id}}</td>
								<td>{{x.GRNDate | date:'dd-MMM-yyyy'}}</td>
								<td>{{x.DocRefNo}}</td>
								<td>{{x.InvoiceNo}}</td>
								<td>{{x.InvoiceDate}}</td>
								<td class="text-right">{{x.TransactionQty|number}}  {{x.TransactionUoM}}</td>
								<td class="text-right">{{x.TransactionAmount|number}} {{x.CurrencyCode}}</td>
								<td class="text-right">{{x.BaseAmount|number}}</td>
							</tr>
						</tbody>
					</table>
					<dir-pagination-controls max-size="10"
											 pagination-id="metaData.name + 'grnList'"
											 direction-links="true"
											 boundary-links="true"
											 on-page-change="getGrnData(newPageNumber)">
					</dir-pagination-controls>
				</div>
			</div>
			<div class="modal-footer">
				<div class="common-btn">
					<ul class="list-inline text-right">
						<li> <button ng-click="grnAdd();" class="btn">Select</button></li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<div class="modal fade site-modal in" id="detailPopUp" role="dialog" data-backdrop="static">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">Detail Information<button type="button" class="close" data-dismiss="modal">&times;</button></div>
			<div class="modal-body">
				<div class="site-tab">
					<ul class="nav nav-tabs" role="tablist">
						<li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Material</a></li>
						<li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Charges</a></li>
					</ul>
				</div>
				<div class="tab-content">
					<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
						<div ng-form="tabForm1">
							<div class="table-responsive modal-table">
								<table class="table table-striped">
									<thead>
										<tr>
											<th>Material Group</th>
											<th>Material Master</th>
											<th>ArticleName</th>
											<th>Qty</th>
											<th>Rate</th>
											<th>Amount (TRN)</th>
											<th>Tax</th>
											<th>Charges Amnt</th>
											<th>Amount (BC)</th>
											@*<th class="col-sm-1"></th>*@
										</tr>
									</thead>
									<tbody>
										<tr ng-repeat="x in inventoryMaterialList">
											<td>{{x.MaterialGroupMasterName}}</td>
											<td>{{x.UserName}}</td>
											<td>{{x.StandardName}}</td>
											<td class="text-right">{{x.TransactionQty}}  {{x.TransactionUoM}}</td>
											<td class="text-right">{{x.TransactionRate| number| setDecimal:currencyPrecision}}  {{x.CurrencyName}}</td>
											<td class="text-right">{{x.TrnAmount| number| setDecimal:currencyPrecision}}</td>
											<td class="text-right">{{x.BaseTaxAmount| number| setDecimal:currencyPrecision}}</td>
											<td class="text-right">{{x.ChargesAmount| number| setDecimal:currencyPrecision}}</td>
											<td class="text-right">{{x.BaseAmount| number| setDecimal:currencyPrecision}}</td>
											@*<td class="text-right">
													<ul class="list-inline action-list">
														<li><button ng-click="getReceiveTaxList(x, false)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
														<li><button ng-click="valuePassInDelModal(x.InventoryReceiveDetailId)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
													</ul>
												</td>*@
										</tr>
										<tr ng-hide="inventoryMaterialList.length==0">
											<td colspan="3" class="text-right"><strong>Total : </strong></td>
											<td class="text-right" ng-hide="sumORnot"></td>
											<td class="text-right" ng-show="sumORnot"><strong>{{inventoryMaterialList | sumByKey : 'TransactionQty' }}</strong></td>
											<td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'TransactionRate' }}</strong></td>
											<td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'TrnAmount'| number| setDecimal:currencyPrecision }}</strong></td>
											<td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'BaseTaxAmount' | number| setDecimal:currencyPrecision}}</strong></td>
											<td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'ChargesAmount' | number| setDecimal:currencyPrecision}}</strong></td>
											<td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'BaseAmount' | number| setDecimal:currencyPrecision}}</strong></td>
											@*<td class="text-right">
													<ul class="list-inline action-list">
														<li><button ng-click="getTotalReceiveTaxList(inventoryMaterialList | sumByKey : 'TrnAmount',true)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
													</ul>
												</td>*@
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
					<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
						<div ng-form="tabForm2">
							<div class="table-responsive modal-table">
								<table class="table table-striped">
									<thead>
										<tr>
											<th>Service</th>
											<th>Amount (TRN)</th>
											<th>Total Tax Amount</th>
											@*<th class="col-sm-1"></th>*@
										</tr>
									</thead>
									<tbody>
										<tr ng-repeat="x in chargesList">
											<td>{{x.ServiceMasterName}}</td>
											<td class="text-right">{{x.Amount|number}}</td>
											<td class="text-right">{{x.TotalTaxAmount|number}}</td>
											@*<td class="text-right">
													<ul class="list-inline action-list">
														<li><button ng-click="getServiceTaxList(x, false)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
														<li><button ng-click="delModal(x.Id)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
													</ul>
												</td>*@
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<div class="common-btn">
					<ul class="list-inline text-right">
						<li> <button ng-click="closeDetailPopUp();" class="btn">Close</button></li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>


