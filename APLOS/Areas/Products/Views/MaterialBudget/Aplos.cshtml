                               ng-keyup="calculateTaxCategoryRate();manualValidationAddRemove('div_Rt', 'detailModel','TransactionRate');" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-4 col-sm-4 col-md-4" ng-hide="true">
            <div class="form-group" id="div_tamnt">
                <label class="col-sm-5 control-label" data-placement="top" title="Cost and Manufacture">Total Amount<sup>*</sup></label>
                <div class="col-sm-7 show-message">
                    <div class="col-sm-8" style="padding-left:0px;padding-right:0px;">
                        <input type="text" name="Amount" n-decimals="{{currencyPrecision}}" ng-model="detailModel.TotalAmount" class="form-control text-right" placeholder=""
                               ng-keyup="calculateTaxCategory();manualValidationAddRemove('div_tamnt', 'detailModel','TotalAmount');" disabled />
                    </div>
                    <div class="col-sm-4" style="padding-left:0px;padding-right:0px;">
                        <input type="text" ng-model="detailModel.CurrencyName" class="form-control" disabled />
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>
        <div class="col-md-12 text-left" style="padding-top: 17px;">
            <ul class="common-btn list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{productNew.Id.length>0?'Update':'Save'}}</button></li>
                <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="clearfix"></div>
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
