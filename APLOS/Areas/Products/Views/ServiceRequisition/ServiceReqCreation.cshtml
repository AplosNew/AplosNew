@*Master Data Entry*@
<div class="form-horizontal form-elements" ng-form="productNewForm">

	<div class="col-md-12">
		<fieldset class="scheduler-border">
			<legend class="scheduler-border">Requisition</legend>

			<div class="col-xs-12 col-sm-4 col-md-4">
				<div class="form-group" id="div_docNo1">
					<label class="col-sm-4 control-label">Requisition Id<sup>*</sup></label>
					<div class="col-sm-8 show-message">
						<input type="text" name="Requisition Id" ng-model="productNew.Id" class="form-control" ng-keyup="modelValidation('div_docNo', 'productNew', 'RequisitionId');" maxlength="20" tabindex="2" autocomplete="off" readonly>
					</div>
				</div>
				<div class="form-group" show-errors>
					<label class="col-sm-4 control-label">Entity<sup>*</sup></label>
					<div class="col-sm-8 show-message">
						<div class="select-style">
							<select id="paymentTermId" class="form-control" name="Entity" ng-model="productNew.EntityId" tabindex="1" required>
								<option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>

							</select>
						</div>
					</div>
				</div>
				<div class="form-group" show-errors>
					<label class="col-sm-4 control-label">Requisition Type<sup>*</sup></label>
					<div class="col-sm-8 show-message">
						<div class="select-style">
							<select id="paymentTermId" class="form-control" name="Requisition Type" ng-model="productNew.RequisitionType" ng-change="changePaymentTerm();" tabindex="12" required>
								<option value="Capital">Capital </option>
								<option value="Revenue">Revenue</option>
							</select>
						</div>
					</div>
				</div>

			</div>

			<div class="col-xs-12 col-sm-4 col-md-4">
				<div class="form-group" show-errors>
					<label class="col-sm-4 control-label">RequirmentType<sup>*</sup></label>
					<div class="col-sm-8 show-message">
						<div class="select-style">
							<select id="paymentTermId" class="form-control" name="RequirmentType" ng-model="productNew.RequirmentType" ng-change="changePaymentTerm();" tabindex="12" required>
								<option value="Critical">Critical</option>
								<option value="Urgent">Urgent</option>
								<option value="Important">Important</option>
								<option value="Normal">Normal</option>
							</select>
						</div>
					</div>

				</div>
				<div class="form-group" show-errors>
					<label class="col-sm-4 control-label">Requisition Date<sup>*</sup></label>
					<div class="col-sm-8 show-message">
						<input type="text" name="Requisition Date" ng-model="productNew.RequisitionDate" @*ng-disabled="IsBaseOnDueDateEnable"*@
							   @*datepicker="getMatureDate(productNew.BaseOnDueDate, productNew.BaseNoOfDays);"*@ datepicker class="form-control" tabindex="13" required ng-disabled="true">
					</div>
				</div>

				<div class="form-group" show-errors>
					<label class="col-sm-4 control-label">Need Special Approval<sup></sup></label>
					<div class="col-sm-8 show-message">
						<div class="input-group">
							<input type="text" name="EmployeeName" ng-model="productNew.EmployeeName" class="form-control" readonly>
							<span class="input-group-btn">
								<button ng-click="showEmployeeListPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
								<button ng-click="clearNeedSpecialApproval()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
							</span>
						</div>
					</div>
				</div>

			</div>

			<div class="col-xs-12 col-sm-4 col-md-4">
				<div class="form-group">
					<label class="col-sm-4 control-label">Reason</label>
					<div class="col-sm-8">
						<textarea class="form-control" name="Reason" rows="1" ng-model="productNew.ReasonWhyItIsNotPlanEarlier" maxlength="500" tabindex="6"></textarea>
					</div>
				</div>
				<div class="form-group">
