<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        /*background-color: #1c1f32;*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12 ">
            <div class="col-md-4">
                <div class="form-group" show-errors id="div_FromDate">
                    <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Form Date" ng-model="model.FromDate" datepicker class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" show-errors id="div_ToDate">
                    <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="To Date" ng-model="model.ToDate" datepicker class="form-control"> 
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="getFiltersData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-ok-circle"></i> Go </button></li>
                    </ul>
                </div>
            </div>
        </div>
       
    </div>
</div>
