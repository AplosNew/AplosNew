<togglable name="Product Master"></togglable>
<div class="form-elements form-horizontal" ng-form name="productMasterNewForm">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">General</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Product Data</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Planning Data</a></li>
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Costing Data</a></li>
            <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" data-toggle="tab">Alternative UOM</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row" ng-form="formTab1">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="number" name="Sequence" ng-model="productMasterNew.Sequence" class="form-control" required tabindex="1">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short name" ng-model="productMasterNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User name" ng-model="productMasterNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Product SubCategory<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="productMasterNew.ProductSubCategoryId"
                                        ng-options="item.Value as item.Text for item in productSubCategoryList" id="productSubCategoryId" name="Product SubCategory" tabindex="7" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Description</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="2" ng-model="productMasterNew.Description" tabindex="15" name="Description" maxlength="250"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Code" ng-model="productMasterNew.Code" class="form-control" required tabindex="2" maxlength="10">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard name" ng-model="productMasterNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Product Category<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="productMasterNew.ProductCategoryId"
                                        ng-options="item.Value as item.Text for item in productCategoryList" id="productCategoryId" name="Product Category" required tabindex="6">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Product</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="productMasterNew.ProductId" ng-options="item.Value as item.Text for item in productList" id="productId" name="Product" tabindex="8">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Base UOM<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select submit-="true" ng-model="productMasterNew.BaseUOMId" class="form-control" name="Base UOM"
                                        ng-disabled="materialMasterAlternativeUOMs.length>0" ng-options="item.Value as item.Text for item in uOMList" ng-change="putValueInAltUom();createUomList();" tabindex="8" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="productMasterNew.Active">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div ng-form="formTab2">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Efficency</th>
                                <th>No of WorkStation</th>
                                <th>Efficency in %</th>
                                <th>SPT</th>
                                <th>Standard Working Hours/Work Center</th>
                                <th>Standard Working Hours Cost/Work Center</th>
                                <th>Additional Per Hour Cost/Work Center</th>
                                <th>Value Loss Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in efficencyList">
                                <td>{{x.EfficencyName}}</td>
                                <td><div><input type="text" n-decimals="2" ng-model="x.NoOfWorkStation" class="form-control text-right" placeholder="0"></div></td>
                                <td><div><input type="text" n-decimals="2" ng-model="x.EfficencyPercentage" class="form-control text-right" placeholder="0.00"></div></td>
                                <td><div><input type="text" n-decimals="2" ng-model="x.SPT" class="form-control text-right" placeholder="0"></div></td>
                                <td><div><input type="text" n-decimals="2" ng-model="x.StandardWorkingHours" class="form-control text-right" placeholder="0.00"></div></td>
                                <td><div><input type="text" n-decimals="2" ng-model="x.StandardWorkingHourCost" class="form-control text-right" placeholder="0.00"></div></td>
                                <td><div><input type="text" n-decimals="2" ng-model="x.AdditionalWorkingHourCostPerHour" class="form-control text-right" placeholder="0.00"></div></td>
                                <td><div><input type="text" n-decimals="2" ng-model="x.ValueLossPercentage" class="form-control text-right" placeholder="0.00"></div></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
            <div class="row" ng-form="formTab3">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Planning Type<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" name="Planning Type" id="PlanningType" ng-model="productMasterNew.PlanningType" required tabindex="7">
                                    <option value="N/A">N/A</option>
                                    <option ng-repeat="option in planningTypesList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">First day Output Per hour<sup ng-show="productMasterNew.PlanningType!=='N/A'">*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" name="First day OutPut" only-numbers ng-model="productMasterNew.FirstdayOutPut" class="form-control text-right" tabindex="11"
                                       ng-change="GetDays(productMasterNew.IsFixed,productMasterNew.IncrementValue,productMasterNew.FirstdayOutPut,productMasterNew.TargetQty)" placeholder="0">
                                <span class="input-group-addon">{{productMasterNew.BaseUoM}}</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Increment Value<sup ng-show="productMasterNew.PlanningType!=='N/A'">*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" name="Increment value" only-numbers ng-model="productMasterNew.IncrementValue" class="form-control text-right"
                                   ng-change="GetDays(productMasterNew.IsFixed,productMasterNew.IncrementValue,productMasterNew.FirstdayOutPut,productMasterNew.TargetQty)" tabindex="13" placeholder="0">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Increment Type</label>
                        <div class="col-sm-8">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="incrementtype" ng-model="productMasterNew.IsFixed" ng-change="GetDays(productMasterNew.IsFixed,productMasterNew.IncrementValue,productMasterNew.FirstdayOutPut,productMasterNew.TargetQty)" value="Fixed" />
                                    <span class="cr"><i class="cr-icon"></i></span>Fixed
                                </label>
                                <label>
                                    <input type="radio" name="incrementtype" ng-model="productMasterNew.IsFixed" ng-change="GetDays(productMasterNew.IsFixed,productMasterNew.IncrementValue,productMasterNew.FirstdayOutPut,productMasterNew.TargetQty)" value="Percentage" />
                                    <span class="cr"><i class="cr-icon"></i></span>Percentage(%)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Base Process(Production)<sup ng-show="productMasterNew.PlanningType!=='N/A'">*</sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select submit-="true" ng-model="productMasterNew.BaseProcessId" class="form-control" name="Process"
                                        ng-options="item.Value as item.Text for item in processList" tabindex="10">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Standard Target Per hour<sup ng-show="productMasterNew.PlanningType!=='N/A'">*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" only-numbers ng-model="productMasterNew.TargetQty" name="Total Qty" class="form-control text-right" tabindex="12" autocomplete="off"
                                   ng-change="GetDays(productMasterNew.IsFixed,productMasterNew.IncrementValue,productMasterNew.FirstdayOutPut,productMasterNew.TargetQty)" placeholder="0" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Days To Reach The Target<sup ng-show="productMasterNew.PlanningType!=='N/A'">*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" name="Days to reach the target" only-numbers ng-model="productMasterNew.DaysToReachTheTarget" class="form-control text-right" disabled>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
            <div class="row" ng-form="formTab4">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Costing Type<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" name="CostingType" id="CostingType" ng-model="productMasterNew.CostingType" required tabindex="7">
                                    <option value="N/A">N/A</option>
                                    <option ng-repeat="option in CostingTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label" data-placement="top" title="Cost and Manufacture" tooltip>CM<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-6" style="padding-left:0px;padding-right:0px;">
                                <input type="text" name="CM" n-decimals="4" ng-model="productMasterNew.CostAndManufacture" class="form-control text-right" tabindex="9" placeholder="0.00" required />
                            </div>
                            <div class="col-sm-6" style="padding-left:0px;padding-right:0px;">
                                <div class="select-style">
                                    <select name="UOM" class="form-control" ng-model="productMasterNew.CostAndManufactureCurrencyId" ng-options="item.Value as item.Text for item in currencyList" tabindex="9" required>
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
            <div class="row" ng-form name="materialMasterFormTab2">
                <div class="form-elements" id="materialMasterAlternativeUOMNew">
                    <input type="hidden" ng-model="materialMasterAlternativeUOMNew.Id">
                    <input type="hidden" ng-model="materialMasterAlternativeUOMNew.MaterialMasterId">
                    <div class="col-xs-12 col-sm-9 col-md-9" style="padding-right: 0px;">
                        <div class="form-group">
                            <div class="col-sm-1">
                                <input type="number" class="form-control text-center" value="1" readonly>
                            </div>
                            <label class="col-sm-2 control-label">Alternative UOM</label>
                            <div class="col-sm-3">
                                <div class="select-style">
                                    <select ng-model="materialMasterAlternativeUOMNew.AlternativeUOMId" class="form-control" name="Unit Of Masurement" ng-change="GetToUoMFactor();"
                                            id="altUOMId" ng-options="item.Value as item.Text for item in uOMList" tabindex="1">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                            <label class="col-sm-1 control-label">Is</label>
                            <div class="col-sm-2">
                                <input type="number" name="Base uom factor" string-to-number ng-model="materialMasterAlternativeUOMNew.BaseUOMFactor" class="form-control" tabindex="2" maxlength="50">
                            </div>
                            <div class="col-sm-3">
                                <input type="text" name="Base uom" ng-model="baseUOM" class="form-control" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2" style="padding-left: 0px;">
                        <button ng-click="addRow();createNewUomList();" ng-disabled="productMasterNew.Id==null" class="btn single-small-btn" tabindex="3"><i class=""></i> {{AltUomAction}}</button>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="table-responsive modal-table" ng-show="altUOMtbl">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Alternative UOM Factor</th>
                                    <th>Alternative UOM</th>
                                    <th>Base UOM Factor</th>
                                    <th>Base UOM</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in materialMasterAlternativeUOMs">
                                    <td>
                                        <ul class="list-inline action-list">
                                            <li>
                                                <button ng-click="GetMaterialMasterAlternativeUom(x.Id, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                    <i class="glyphicon glyphicon-pencil"></i>
                                                </button>
                                            </li>
                                            <li>
                                                <button ng-click="valuePassInDelModal(x.Id, $index, x.AlternativeUOMName)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                    <i class="glyphicon glyphicon-remove"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </td>
                                    <td>{{x.AlternativeUOMFactor}}</td>
                                    <td>{{x.AlternativeUOMName}}</td>
                                    <td>{{x.BaseUOMFactor}}</td>
                                    <td>{{x.BaseUOMName}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByProductMasterList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Product Category</th>
                <th>Product Subcategory</th>
                <th>Product</th>
                <th>Base Process</th>
                <th>Base UoM</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in productMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.ProductCategoryName}}</td>
                <td>{{x.ProductSubCategoryName}}</td>
                <td>{{x.ProductName}}</td>
                <td>{{x.BaseProcess}}</td>
                <td>{{x.BaseUom}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="materialAttributeValuePoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="materialAttributeValueParameters.searchBy">
                                            <option ng-repeat="option in searchMaterialAttributeValueList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getAttributeValueData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getAttributeValueData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Description</th>
                                <th>Default</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in materialAttributeValueList|itemsPerPage:materialAttributeValueParameters.pageSize" pagination-id="metaData.name + 'materialAttributeValueList'"
                                total-items="materialAttributeValueParameters.total_count" ng-click="SelectMA(x.Id, x.Description, $index)" ng-dblclick="getAttrValue(x.Id, x.Description);">
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.Description}}</td>
                                <td>{{x.IsDefault?'Yes':'No'}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls pagination-id="metaData.name + 'materialAttributeValueList'"
                                             max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getAttributeValueData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SelectMAButton();" class="btn"><i class=""></i> Select</button></li>
                        <li> <button type="button" class="btn btn-default" ng-click="ClosematerialAttributePopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="mmaltuom" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
