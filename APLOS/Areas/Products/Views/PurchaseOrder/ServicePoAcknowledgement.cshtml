									<td>{{x.TaxCategory}}</td>
									<td ng-hide="percentageColumn">{{x.Percentage}}</td>
									@*<td ng-hide="percentageColumn">{{x.HSNCode}}</td>*@
									@*<td>{{x.TaxAmount}}</td>*@
									<td><input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TaxAmount" ng-keyup="calculateSerciceTax(x, $index)"></td>
									<td></td>
								</tr>
								<tr>
									@*<td colspan="3" class="text-right"><label class="control-label"><b>Total : {{total}}</b>&nbsp;{{Currency}}</label></td>*@
									<td colspan="3" class="text-right"><strong>{{ServiceTaxList | sumByKey : 'TaxAmount'| setDecimal:2| number:2 }}</strong></td>
									<td></td>
								</tr>

							</tbody>
						</table>
					</div>
				</div>
				<div class="clearfix"></div>
				<div class="common-btn">
					<ul class="list-inline text-right">
						<li><button ng-click="closeReceiveTaxPopUp1();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="modal fade site-modal in" id="serviceChargePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Charges Entry<button type="button" class="close" ng-click="closeServiceChargePopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" id="div_svc">
                        <label class="col-sm-4 col-md-4 control-label">Service<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Service" ng-model="serviceModel.ServiceMasterId" class="col-sm-3 form-control"
                                        ng-options="item.Value as item.Text for item in serviceList" ng-change="changeService();">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" id="div_svcRate">
                        <label class="col-sm-4 control-label" data-placement="top" title="Cost and Manufacture">Amount<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-8" style="padding-left:0px;padding-right:0px;">
                                <input type="text" name="Amount" n-decimals="{{currencyPrecision}}" ng-model="serviceModel.TransactionAmount" class="form-control text-right" placeholder="0.00"
                                       ng-keyup="calculateSvcTaxCategory();manualValidationAddRemove('div_svcRate', 'serviceModel', 'TransactionAmount', 'Amount');" />
                            </div>
                            <div class="col-sm-4" style="padding-left:0px;padding-right:0px;">
                                <input type="text" ng-model="serviceModel.CurrencyName" class="form-control" disabled />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12 modal-table table-responsive" style="padding-top: 13px;" ng-show="taxCategoryList.length>0">
                    <div class="col-xs-12 col-sm-4 col-md-4" ng-show="serviceModel.ServiceMasterId">
                        <div class="form-group">
                            <label class="col-sm-6 control-label">If Percentage Applicable</label>
                            <div class="col-sm-6">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="TaxOptionService" ng-model="productNew.TaxOptionService" value="Yes" >
                                        <span class="cr"><i class="cr-icon"></i></span>Yes
                                    </label>
                                    <label>
                                        <input type="radio" name="TaxOptionService" ng-model="productNew.TaxOptionService" value="No" >
                                        <span class="cr"><i class="cr-icon"></i></span>No
                                    </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </div>
                            </div>
                        </div>
                    </div>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Tax Category</th>
                                <th>HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in taxCategoryList">
                                <td>{{x.UserName}}</td>
                                <td>{{x.HSNCode}}</td>
                                @*<td class="text-right">{{x.Percentage}}</td>*@
                                <td class="text-right">
                                    <input type="text" n-decimals="4" ng-model="x.Percentage" ng-keyup="calculateTaxAmountForService(x);" class="form-control text-right" ng-disabled="productNew.TaxOptionService==='No'" />
                                </td>
                                <td class="text-right">
                                    <input type="text" n-decimals="2" ng-model="x.TaxAmount" ng-keyup="checkRowValidationService(x);" class="form-control text-right" ng-disabled="productNew.TaxOptionService==='Yes'" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right">Total Tax (BC)</td>
                                @*<td class="text-right">{{serviceModel.TotalTaxAmount| setDecimal:currencyPrecision}}</td>*@
                                <td class="text-right"><strong>{{taxCategoryList | sumByKey : 'TaxAmount'| setDecimal:2 }}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="serviceSave()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{ActionService}}</button></li>
                        <li><button ng-click="closeServiceChargePopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


<confirm-archive-generic modalid="removerPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="detailDelete();"></confirm-archive-generic>
<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message}} data-ng-click-right-button="serviceDelete();"></confirm-archive-generic>
<confirm-archive-generic modalid="removePopUpForDoc" title="Confirmation" message={{message}} data-ng-click-right-button="DeletePOIgame();"></confirm-archive-generic>

<confirm-archive-generic modalid="ConfirmationForReqClosePopUp" title="Confirmation" message={{message}} data-ng-click-left-button="NoMessageForClosed();" data-ng-click-right-button="YesMessageForClosed();"></confirm-archive-generic>
