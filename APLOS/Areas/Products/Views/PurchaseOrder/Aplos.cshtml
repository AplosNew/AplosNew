<div class="form-horizontal form-elements" ng-form="productNewForm">
    <div class="col-md-12">
        <ul class="common-btn list-inline text-right">
            <li><button ng-click="GetBOQItemsDetailsData();" ng-hide="productNew.OrderSpecific==='No'" class="btn"><i class="glyphicon glyphicon-list"></i> Material Info</button></li>
        </ul>
    </div>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">PO Basic Info</legend>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Order Specific</label>
                <div class="col-sm-8">
                    <div class="radio">
                        <label>
                            <input type="radio" name="OrderSpecific" ng-model="productNew.OrderSpecific" value="No" ng-click="hide();ClearList('No');">
                            <span class="cr"><i class="cr-icon"></i></span>No
                        </label>
                        <label>
