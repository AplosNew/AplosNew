@*<togglable name="Create Purchase Order"></togglable>*@
<fieldset class="MyFieldset">
    <legend style="width:10%;padding-left:15px;" class="MyLegend">PO Master</legend>
    <div class="form-horizontal form-elements" ng-form="productNewForm">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{productNew.PartyCode}}</span>
                        <input type="text" name="Vendor" ng-model="productNew.PartyName" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="showPartyPopUp()" ng-disabled="inventoryMaterialList.length>0" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 pdl3 pdr3">
            <div class="col-md-8">
                <div class="form-group" id="div_docNo">
                    <label class="col-sm-6 control-label">Vendor Doc. RefNo<sup>*</sup></label>
                    <div class="col-sm-6 show-message pdr3">
                        <input type="text" name="DocRefNo" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.DocRefNo" class="form-control" ng-keyup="modelValidation('div_docNo', 'productNew', 'DocRefNo');" maxlength="20" tabindex="2" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" id="div_docDate">
                    <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                    <div class="col-sm-9 show-message pdl3">
                        <input type="text" name="Date" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.DocDate" datepicker="modelValidation('div_docDate', 'productNew', 'DocDate');changePaymentTerm();getToCurrencyRate();" end-date="currentDate" id="cutOffDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="3">
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-md-6 pdl3 pdr3">
            <div class="col-md-8">
                <div class="form-group" id="div_entryNo">
                    <label class="col-sm-6 control-label">Gate Entry No<sup>*</sup></label>
                    <div class="col-sm-6 show-message pdr3">
                        <input type="text" name="Gate EntryNo" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.GateEntryNo" class="form-control" ng-keyup="modelValidation('div_entryNo', 'productNew', 'GateEntryNo');" maxlength="10" tabindex="4" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" id="div_entryDate">
                    <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                    <div class="col-sm-9 show-message pdl3">
                        <input type="text" name="Entry Date" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.EntryDate" datepicker="modelValidation('div_entryDate', 'productNew', 'EntryDate');" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="5">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 pdl3 pdr3">
            <div class="col-md-8">
                <div class="form-group" id="div_grnNo">
                    <label class="col-sm-6 control-label">GRN No<sup>*</sup></label>
                    <div class="col-sm-6 show-message pdr3">
                        <input type="text" name="GRN No" ng-model="productNew.Id" class="form-control" maxlength="10" disabled>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" id="div_grnDate">
                    <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                    <div class="col-sm-9 show-message pdl3">
                        <input type="text" name="GRN Date" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.GRNDate" datepicker="modelValidation('div_grnDate', 'productNew', 'GRNDate');" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="6">
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 col-md-4 control-label">Storage Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Storage Location" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.MaterialStorageId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in storageList" tabindex="7" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 pdl3 pdr3">
            <div class="col-md-8">
                <div class="form-group" id="div_currency">
                    <label class="col-sm-6 control-label">Currency<sup>*</sup></label>
                    <div class="col-sm-6 show-message pdr3">
                        <div class="select-style">
                            <select class="form-control" id="currency" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList"
                                    ng-change="changeCurrency();getToCurrencyRate();manualValidationAddRemove('div_currency', 'productNew', 'CurrencyId');" tabindex="8">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" id="div_rate">
                    <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Rate<sup ng-hide="productNew.CurrencyId==productNew.BaseCurrencyId">*</sup></label>
                    <div class="col-sm-9 show-message pdl3">
                        <input type="text" n-decimals="{{currencyPrecision}}" name="GRN Date" ng-model="productNew.ToCurrencyRate" ng-disabled="productNew.CurrencyId==productNew.BaseCurrencyId||inventoryMaterialList.length>0" ng-keyup="manualValidationAddRemove('div_rate', 'productNew', 'ToCurrencyRate');" class="form-control text-right" tabindex="9">
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Non Creditable</label>
                <div class="col-sm-1">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.IsNonCreditable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
                <label class="col-sm-3 control-label">Along with Invoice</label>
                <div class="col-sm-1">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.AlongwithInvoice" ng-click="changeAllInvoice();">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
                <label class="col-sm-2 control-label" ng-show="productNew.TaxApplicable=='Mandatory'">Revers Charge</label>
                <div class="col-sm-1" ng-show="productNew.TaxApplicable=='Mandatory'">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-disabled="!productNew.IsTaxApplicableChangeable" ng-model="productNew.IsTaxApplicable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors ng-show="productNew.AlongwithInvoice">
                <label class="col-sm-4 control-label">Invoice No<sup>*</sup></label>
                <div class="col-sm-4 show-message pdr3 ">
                    <input type="text" name="Invoice No" ng-model="productNew.InvoiceNo" class="form-control" maxlength="20" ng-required="productNew.AlongwithInvoice" tabindex="10" autocomplete="off">
                </div>
                <label class="col-sm-1 control-label pdl3 pdr3">Date<sup>*</sup></label>
                <div class="col-sm-3 show-message pdl3">
                    <input type="text" name="Invoice Date" ng-model="productNew.InvoiceDate" datepicker class="form-control" placeholder="dd-Mmm-yyyy" ng-required="productNew.AlongwithInvoice" tabindex="11">
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Payment Term</legend>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Payment Term<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="paymentTermId" class="form-control" name="Payment Term" ng-model="productNew.PaymentTermId" ng-change="changePaymentTerm();" tabindex="12" required>
                                    <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Due Date BaseOn<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <input type="text" name="BaseOnDueDate" ng-model="productNew.BaseOnDueDate" ng-disabled="IsBaseOnDueDateEnable"
                                   datepicker="getMatureDate(productNew.BaseOnDueDate, productNew.BaseNoOfDays);" class="form-control datepicker" tabindex="13" required>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">No Of Days</label>
                        <div class="col-sm-2 pdr3 show-message">
                            <input id="baseNoOfday" type="text" ng-disabled="inventoryMaterialList.length>0" only-numbers name="baseNoOfday" ng-model="productNew.BaseNoOfDays" ng-keyup="getMatureDate(productNew.BaseOnDueDate, productNew.BaseNoOfDays)" class="form-control text-right" tabindex="14">
                        </div>
                        <label class="col-sm-3 control-label">Mature Date</label>
                        <div class="col-sm-4 show-message">
                            <input type="text" name="DueDate" ng-disabled="inventoryMaterialList.length>0" ng-model="productNew.MatureDate" class="form-control" readonly>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
</fieldset>



<div>
    <fieldset class="MyFieldset">
        <legend style="width:10%;padding-left:15px;" class="MyLegend">PO Details</legend>
        <div class="row">
            <div class="col-lg-12">
                <div style="overflow-x:auto; height:300px;">

                    <table class="table table-striped table-bordered table-responsive" style="background-color:#e9f4f9; border:1px; font-weight:bold;" id="tblChallanDetails">
                        <thead>
                            <tr>
                                @*<th>Slno</th>*@
                                <th></th>
                                <th>Test1</th>
                                <th>Test1</th>
                                <th>Test1</th>
                                <th>Test1</th>
                                <th>Test1</th>
                                <th>Test1</th>
                                <th>Test1</th>
                                <th>Test1</th>
                                <th>Test1</th>
                                <th>Test1</th>
                                <th>Test1</th>
                                <th>Test1</th>

                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

    </fieldset>
</div>
<div class="clearfix"></div>
<ul class="common-btn list-inline text-right">
    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{productNew.Id.length>0?'Update':'Save'}}</button></li>
    <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
</ul>
<div class="clearfix"></div>




