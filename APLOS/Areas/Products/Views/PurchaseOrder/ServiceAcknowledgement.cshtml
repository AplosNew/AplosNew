    <fieldset class="scheduler-border">
        <legend class="scheduler-border">Ackowledgement Info</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{productNew.PartyId}}</span>
                        <input type="text" name="Vendor" ng-model="productNew.PartyName" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="showPartyPopUpNew()" ng-disabled="inventoryMaterialListPO.length>0 || inventoryMaterialList.length>0" class="btn single-small-btn" tabindex="1" disabled><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 pdl3 pdr3">
            <div class="col-md-8">
                <div class="form-group" id="div_docNo">
                    <label class="col-sm-6 control-label">Vendor Doc. RefNo<sup>*</sup></label>
                    <div class="col-sm-6 show-message pdr3">
                        <input type="text" name="DocRefNo" ng-model="productNew.DocRefNo" class="form-control" ng-keyup="modelValidation('div_docNo', 'productNew', 'DocRefNo');" maxlength="20" tabindex="2" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" id="div_docDate">
                    <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                    <div class="col-sm-9 show-message pdl3">
                        <input type="text" name="Date" ng-model="productNew.DocDate" datepicker="modelValidation('div_docDate', 'productNew', 'DocDate');changePaymentTerm();getToCurrencyRate();" end-date="currentDate" id="cutOffDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="3">
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-md-6 pdl3 pdr3">
            <div class="col-md-8">
                <div class="form-group" id="div_entryNo">
                    <label class="col-sm-6 control-label">Gate Entry No</label>
                    <div class="col-sm-6 show-message">
                        <div class="input-group">
                            <input type="text" name="Gate Entry No" ng-model="productNew.GateEntryNo" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button name="submit" ng-click="POPopUpGateEntry()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" id="div_gateEntryDate">
                    <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date</label>
                    <div class="col-sm-9 show-message pdl3">
                        <input type="text" name="Gate Entry Date" ng-disabled="true" ng-model="productNew.GateEntryDate" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="5" readonly>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 pdl3 pdr3">
            <div class="col-md-8">
                <div class="form-group" id="div_grnNo">
                    <label class="col-sm-6 control-label">Acknowledgement No<sup>*</sup></label>
                    <div class="col-sm-6 show-message pdr3">
                        <input type="text" name="Ack No" ng-model="productId" class="form-control" maxlength="10" disabled>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" id="div_grnDate">
                    <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Date<sup>*</sup></label>
                    <div class="col-sm-9 show-message pdl3">
                        <input type="text" name="GRN Date" ng-disabled="true" ng-model="productNew.AcknowledgementDate" datepicker="modelValidation('div_grnDate', 'productNew', 'AcknowledgementDate');" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="6">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 pdl3 pdr3">
            <div class="col-md-8">
                <div class="form-group" id="div_currency">
                    <label class="col-sm-6 control-label">Currency<sup>*</sup></label>
                    <div class="col-sm-6 show-message pdr3">
                        <div class="select-style">
                            <select class="form-control" id="currency" ng-disabled="chargesListPO.length>0" ng-model="productNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList"
                                    ng-change="changeCurrency();getToCurrencyRate();manualValidationAddRemove('div_currency', 'productNew', 'CurrencyId');" tabindex="8">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" id="div_rate">
                    <label class="col-sm-3 control-label pdl3 pdr3" style="padding-left: 0px;">Rate<sup ng-hide="productNew.CurrencyId==productNew.BaseCurrencyId">*</sup></label>
                    <div class="col-sm-9 show-message pdl3">
                        <input type="text" n-decimals="{{currencyPrecision}}" name="GRN Date" ng-model="productNew.ToCurrencyRate" ng-disabled="productNew.CurrencyId==productNew.BaseCurrencyId||chargesListPO.length>0" ng-keyup="manualValidationAddRemove('div_rate', 'productNew', 'ToCurrencyRate');" class="form-control text-right" tabindex="9">
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>

        <div class="clearfix"></div>
        <div class="col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Non Creditable</label>
                <div class="col-sm-1">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-disabled="chargesListPO.length>0" ng-model="productNew.IsNonCreditable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">{{productNew.labelCheckAndApproved}}</label>@*ng-show="checkedByList.length"*@
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        @*ng-show="checkedByList.length"*@
                        <select id="CheckedBy" class="form-control" name="Checked By" ng-model="productNew.CheckedBy" tabindex="12">
                            <option ng-repeat="option in checkedByList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>



        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Note For Accounts<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <textarea name="Description" class="form-control" rows="2" ng-model="productNew.NoteForAccounts" tabindex="7"></textarea>
                </div>
            </div>
        </div>
    </fieldset>
    <div class="clearfix"></div>
    <div class="clearfix"></div>
    <ul class="common-btn list-inline text-right">
        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
        <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
    </ul>
    <div class="clearfix"></div>
    <div class="col-md-6 text-right" style="padding-top: 17px;">
        <div>
            <table class="table-responsive modal-table">
                <tbody>
                    <tr>
                        <td></td>
                        <td>Amount</td>
                        <td>Tax</td>
                        <td>Total</td>
                    </tr>
                    <tr style="border-bottom: 1px solid;" ng-show="chargesListPO.length">
                        <td>Service</td>
                        <td>{{chargesListPO | sumByKey : 'Amount'| setDecimal:2 | number}}</td>
                        <td>{{chargesListPO | sumByKey : 'TotalTaxAmount'| setDecimal:2 | number}}</td>
                        <td>{{(chargesListPO | sumByKey : 'Amount'| setDecimal:2)+(chargesListPO | sumByKey : 'TotalTaxAmount' | setDecimal:2)| number}}</td>
                    </tr>
                    <tr ng-show="chargesListPO.length">
                        <td></td>
                        <td></td>
                        <td>Gross Amount</td>
                        <td>{{(chargesListPO | sumByKey : 'Amount'| setDecimal:2)+(chargesListPO | sumByKey : 'TotalTaxAmount' | setDecimal:2)| number}}</td>
                    </tr>


                </tbody>
            </table>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Service</a></li>
            <li role="presentation" ng-show="productNew.Id != null" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Charges</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Documents Attach</a></li>
        </ul>
    </div>

    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div ng-form="tabForm1">

                <ul class="col-md-6 common-btn list-inline text-left">
                    <li><button ng-click="serviceChargePopUp();" ng-disabled="productNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i>Add Services</button></li>
                </ul>

                <div class="col-xs-12 col-sm-6 col-md-6" ng-hide="true">
                    <div class="form-group">
                        <label class="col-sm-2 control-label"><span style="color:maroon;font-weight:bold">Requisition</span></label>
                        <div class="col-sm-4">
                            <div class="input-group">
                                <input type="text" hidden id="masterId" />

                                <input type="text" name="Vendor" id="Vendor" ng-model="MONo" class="form-control" readonly ng-hide="true">
                                <span class="input-group-btn">
                                    <button name="submit" ng-click="MasterOrderList()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>

                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table" ng-show="chargesList.length>0">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Service Name</th>
                                <th>Qty</th>
                                <th>UoM</th>
                                <th>Rate</th>
                                <th>Amount (TRN)</th>
                                <th>Total Tax Amount</th>
                                <th class="col-sm-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in chargesList">
                                <td>{{x.ServiceMasterName}}</td>
                                <td>{{x.CurrentQty}}</td>
                                <td>{{x.UoM}}</td>
                                <td>{{x.Rate}}</td>
                                <td class="text-right"><input type="text" n-decimals="2" class="form-control text-right" width="20" ng-model="x.Amount" ng-keyup="calculateAmountForServiceCharge(x);" ng-disabled="true"></td>
                                <td class="text-right"><input type="text" n-decimals="2" class="form-control text-right" width="20" ng-model="x.TotalTaxAmount" ng-disabled="true"></td>  @*{{x.TotalTaxAmount|number}}*@
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="getServiceTaxPopUp(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button></li>
                                        <li><button ng-click="removeDetailRow(x.ServicePODetailId)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-right"><strong>Total : </strong></td>
                                <td class="text-left"><strong>{{chargesList | sumByKey : 'CurrentQty'| setDecimal:currencyPrecision| number }}</strong></td>
                                <td class="text-right"></td>
                                <td class="text-right"></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'Amount'| setDecimal:currencyPrecision| number }}</strong></td>
                                <td class="text-right"><strong>{{chargesList | sumByKey : 'TotalTaxAmount'| setDecimal:currencyPrecision| number }}</strong></td>
                                <td class="text-right"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="detailPopUpEdit();" class="btn" ng-show="inventoryMaterialList.length>0"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
                        @*<li><button ng-click="closeDetaiPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>*@

                    </ul>
                </div>
            </div>

        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div ng-form="tabForm2">

                <div class="col-xs-12 col-sm-12 col-md-12">
