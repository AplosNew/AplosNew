<div class="modal fade site-modal in" id="ServiceTaxPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">Service Tax Information<button type="button" class="close" ng-click="CloseServiceTaxPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <p>Taxable amount : <b>{{taxAbleAmnt | number| setDecimal:currencyPrecision}}</b></p>
                    <p>HSNCode : <b>{{HSNCode}}</b></p>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th ng-hide="true">id</th>
                                    <th>Tax Category</th>
                                    <th ng-hide="percentageColumn">Percentage</th>
                                    <th>Tax Amount (BC)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in ServiceTaxPopUpList" ng-show="ServiceTaxPopUpList.length">
                                    <td>{{x.TaxCategory}}</td>
                                    <td ng-hide="percentageColumn">{{x.Percentage}}</td>
                                    <td><input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TaxAmount"></td>
                                    <td></td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-right"><strong>{{ServiceTaxPopUpList | sumByKey : 'TaxAmount'| setDecimal:2| number:2 }}</strong></td>
                                    <td></td>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="CloseServiceTaxPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade site-modal in" id="serviceChargePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Service Entry</div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" id="div_svc">
                        <label class="col-sm-4 col-md-4 control-label">Service<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <input type="text" ng-model="serviceModel.ServiceName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button tabindex="1" ng-click="getServiceMasterPopUpData();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" id="div_UOM">
                        <label class="col-sm-4 control-label">UoM<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Transaction UoM" class="form-control" ng-model="serviceModel.TransactionUoMId" ng-options="item.Value as item.Text for item in uoMList" ng-change="manualValidationAddRemove('div_uom', 'detailModel','TransactionUoMId');">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>


                    <div class="form-group" id="div_toSvcCRate">
                        <label class="col-sm-4 control-label">To Currency Rate<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" n-decimals="4" ng-model="serviceModel.ToCurrencyRate" disabled class="form-control text-right" placeholder="0.00" />
                        </div>
                    </div>
                    <div class="form-group" id="div_toSvcCRate">
                        <label class="col-sm-4 control-label">Budget<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" n-decimals="4" ng-model="serviceModel.BudgetName" disabled class="form-control text-right" placeholder="0.00" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Description</label>
                        <div class="col-sm-8">
                            <textarea maxlength="1000" name="Description" class="form-control" rows="2" ng-model="serviceModel.Description"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" id="div_Qty">
                        <label class="col-sm-4 control-label" data-placement="top" title="Cost and Manufacture">Qty<sup>*</sup></label>
                        <div class="col-sm-8 show-message">

                            <input type="text" name="Qty" n-decimals="{{currencyPrecision}}" ng-model="serviceModel.Qty" class="form-control text-right" placeholder=""
                                   ng-keyup="calculateRate();" />


                        </div>
                    </div>

                    <div class="form-group" id="div_Amount">
                        <label class="col-sm-4 control-label" data-placement="top" title="Cost and Manufacture">Amount<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-8" style="padding-left:0px;padding-right:0px;">
                                <input type="text" name="Amount" n-decimals="{{2}}" ng-model="serviceModel.TransactionAmount" class="form-control text-right" placeholder=""
                                       ng-keyup="calculateRate();" />
                            </div>
                            <div class="col-sm-4" style="padding-left:0px;padding-right:0px;">
                                <input type="text" ng-model="serviceModel.CurrencyName" class="form-control" disabled />
                            </div>
                        </div>
                    </div>
                    <div class="form-group" id="div_Rate">
                        <label class="col-sm-4 control-label" data-placement="top" title="Cost and Manufacture">Rate<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Rate" n-decimals="{{4}}" ng-model="serviceModel.Rate" class="form-control text-right" placeholder=""
                                   ng-disabled="true" />
                        </div>


                    </div>
                    <div class="form-group" id="div_toSvcCRate">
                        <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" n-decimals="4" ng-model="serviceModel.ActivityName" disabled class="form-control text-right" placeholder="0.00" />
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12 modal-table table-responsive" style="padding-top: 13px;" ng-show="taxCategoryList.length>0">
                    <div class="col-xs-12 col-sm-4 col-md-4" ng-show="serviceModel.ServiceMasterId">
                        <div class="form-group">
                            <label class="col-sm-6 control-label">If Percentage Applicable</label>
                            <div class="col-sm-6">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="TaxOptionService" ng-model="productNew.TaxOptionService" value="Yes" ng-click="TaxOptionService('Yes');"> @*ng-hide="HSNCode !=null"*@
                                        <span class="cr"><i class="cr-icon"></i></span>Yes
                                    </label>
                                    <label>
                                        <input type="radio" name="TaxOptionService" ng-model="productNew.TaxOptionService" value="No" ng-click="TaxOptionService('No');">@*ng-hide="HSNCode !=null"*@
                                        <span class="cr"><i class="cr-icon"></i></span>No
                                    </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                </div>
                            </div>
                        </div>
                    </div>
                    <table class="table table-striped" ng-show="serviceModel.ServiceMasterId">
                        <thead>
                            <tr>
                                <th>Tax Category</th>
                                <th>HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in taxCategoryList">
                                <td>{{x.UserName}}</td>
                                <td>{{x.HSNCode}}</td>
                                <td class="text-right">
                                    <input type="text" n-decimals="{{4}}" ng-model="x.Percentage" ng-keyup="calculateTaxAmountForService(x);" ng-disabled="productNew.TaxOptionService==='No'" class="form-control text-right" />
                                </td>
                                <td class="text-right">
                                    <input type="text" n-decimals="{{2}}" ng-model="x.TaxAmount" ng-keyup="checkRowValidationService(x);" ng-disabled="productNew.TaxOptionService==='Yes'" class="form-control text-right" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right">Total Tax (BC)</td>
                                <td class="text-right">{{serviceModel.TotalTaxAmount| setDecimal:currencyPrecision}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="DetailSaveIndividualService();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> {{DetailAction}}</button></li>
                        <li><button ng-click="closeServiceChargePopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
