                        <label class="col-sm-2">&nbsp;</label>
                        <div class="inputBtnSection common-btn" style="padding-top:5px;">
                            <label class="fileUpload col-sm-2 ">
                                <input id="uploadBtn" type="file" name="file[]" class="upload" />
                                <span class="uploadBtn"><i class="fa fa-paperclip" aria-hidden="true"> Attach</i></span>
                            </label>
                        </div>
                        <div class="col-sm-3">
                            <label class="col-sm-2 ">UserFilename</label>
                            <input type="text" id="uploadFile" ng-model="productDocMap.UserFilename" name="uploadFile" class="form-control" disabled="disabled" />
                        </div>
                        <div class="col-sm-3">
                            <label class="col-sm-2 ">Description</label>
                            <input type="text" id="Description" ng-model="productDocMap.Description" name="Description" class="form-control" />
                        </div>
                        <div class="col-sm-3">
                            <label class="col-sm-2 ">Remarks</label>
                            <input type="text" id="Remarks" ng-model="productDocMap.Remarks" name="Remarks" class="form-control" />
                        </div>
                        <div class="col-sm-1">
                            <label class="col-sm-2">&nbsp;</label>
