<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">Checked</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Approved</a></li>
        </ul>
    </div>
    <div class="tab-content" id="tabpaneldiv">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet11(11), active: isSet11(11) }">
            <div>
                <div class="content-container-fluid" style="color:black;overflow:scroll">
                    <div style="color:black;" id="GridChecked" ej-grid e-datasource="Griddata"
                         e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick=""
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true"
                         e-detailstemplate="detailTemp"
                         e-detailsdatabound="detailgrid">
                        <div e-columns>
                            <div e-column e-headertext="Actions" e-width="70">
                                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk" title="PO Un Check" ng-click="$parent.onClickGRNCheckedUpdate('GridChecked');" style="margin: -6px;"></i></button>
                                <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;padding-top:1px;" class="btn"><i class="glyphicon glyphicon-print" title="Print Report" ng-click="$parent.AllTabPrint('GridChecked');" style="margin: -6px;"></i></button>
                            </div>
                            <div e-column e-field="PartyName" e-headertext="Vendor" e-width="250"></div>
                            <div e-column e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="150"></div>
                            <div e-column e-field="Id" e-headertext="PO No" e-width="150"></div>
                            <div e-column e-field="GRNId" e-headertext="GRN" e-width="150"></div>
                            <div e-column e-field="PODate1" e-headertext="PO Date" e-width="150" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="PurchaseLC" e-headertext="Purchase LC Ref" e-width="170"></div>
                            <div e-column e-field="CustomerName" e-headertext="Customer" e-width="170"></div>
                            <div e-column e-field="DocRefNo" e-headertext="Vendor DocNo" e-width="150"></div>
                            <div e-column e-field="TransactionQty" e-headertext="Qty" textAlign='Right' e-width="50"></div>

                            <div e-column e-field="ContructNumber" e-headertext="Contruct Number" e-width="100"></div>
                            <div e-column e-field="Customer" e-headertext="Customer" e-width="100"></div>
                            <div e-column e-field="CurrencyCode" e-headertext="Currency" textAlign='Right' e-width="100"></div>
                            <div e-column e-field="TransactionAmount" e-headertext="Amount" textAlign='Right' e-width="80"></div>
                            <div e-column e-field="BaseAmount" e-headertext="Total Amount" textAlign='Right' e-width="100"></div>
                            <div e-column e-field="PreparedBy" e-headertext="Prepared By" e-width="180"></div>
                            <div e-column e-field="CheckedBy" e-headertext="Checked By" e-width="180"></div>
                            <div e-column e-field="CheckedByStatus" e-headertext="Checked Status" e-width="180"></div>
                            <div e-column e-field="ApprovedBy" e-headertext="To be Approved By" e-width="180"></div>
                            <div e-column e-field="AuthorizedByStatus" e-headertext="Approved Status" e-width="180"></div>
                        </div>
                    </div>
                </div>
                <script id="tabGridContents" type="text/x-jsrender">
                    <div class="tabcontrol" id="Test">
                        <ul>
                            <li><a href="#gridTab{{:Id}}">Po Details</a></li>
                            <li><a href="#gridTab1{{:Id}}">Attached Documents List</a></li>
                        </ul>
                        <div id="gridTab{{:Id}}">
                            <div id="detailGrid"></div>
                        </div>

                        <div id="gridTab1{{:Id}}">
                            <div id="detailGrid1" style="width:800px;"></div>
                        </div>

                    </div>
                </script>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet22(22), active: isSet22(22) }">
            <div class="form-horizontal" ng-form id="TaxID" name="OTSlapForm">
                <div>
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridApproved" ej-grid e-datasource="GriddataPoApp"
                             e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick=""
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true"
                             e-detailstemplate="detailTemp"
                             e-detailsdatabound="detailgrid">
                            <div e-columns>
                                <div e-column e-headertext="Actions" e-width="70">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk" title="PO Un Approve" ng-click="$parent.onClickGRNCheckedUpdate('GridApproved');" style="margin: -6px;"></i></button>
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;padding-top:1px;" class="btn"><i class="glyphicon glyphicon-print" title="Print Report" ng-click="$parent.AllTabPrint('GridApproved');" style="margin: -6px;"></i></button>
                                </div>
                                <div e-column e-field="PartyName" e-headertext="Vendor" e-width="250"></div>
                                <div e-column e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="150"></div>
                                <div e-column e-field="Id" e-headertext="PO No" e-width="150"></div>
                                <div e-column e-field="GRNId" e-headertext="GRN" e-width="150"></div>
                                <div e-column e-field="PODate" e-headertext="PO Date" e-width="150" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                                <div e-column e-field="PurchaseLC" e-headertext="Purchase LC Ref" e-width="170"></div>
                                <div e-column e-field="ContructNumber" e-headertext="Contact Number" e-width="170"></div>
                                <div e-column e-field="CustomerName" e-headertext="Customer" e-width="170"></div>
                                <div e-column e-field="DocRefNo" e-headertext="Vendor DocNo" e-width="150"></div>
                                <div e-column e-field="TransactionQty" e-headertext="Qty" textAlign='Right' e-width="150"></div>
                                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="100"></div>
                                <div e-column e-field="TransactionAmount" e-headertext="Amount" textAlign='Right' e-width="150"></div>
                                <div e-column e-field="BaseAmount" e-headertext="Total Amount" textAlign='Right' e-width="150"></div>
                                <div e-column e-field="CheckedByStatus" e-headertext="Checked Status" e-width="180"></div>
                                <div e-column e-field="ApprovedBy" e-headertext="Approved By" e-width="180"></div>
                                <div e-column e-field="AuthorizedByStatus" e-headertext="Approved Status" e-width="180"></div>
                                <div e-column e-field="Customer" e-headertext="Customer" e-width="100"></div>
                                <div e-column e-field="CheckedBy" e-headertext="Checked By" e-width="200"></div>
                            </div>
                        </div>
                    </div>
                    <script id="tabGridContents" type="text/x-jsrender">
                        <div class="tabcontrol" id="Test">
                            <ul>
                                <li><a href="#gridTab{{:Id}}">Po Details</a></li>
                                <li><a href="#gridTab1{{:Id}}">Attached Documents List</a></li>
                            </ul>
                            <div id="gridTab{{:Id}}">
                                <div id="detailGrid"></div>
                            </div>

                            <div id="gridTab1{{:Id}}">
                                <div id="detailGrid1" style="width:800px;"></div>
                            </div>

                        </div>
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="poapprovealert" title="Confirmation" message={{message}} data-ng-click-right-button="Checked();"></confirm-archive-generic>
<confirm-archive-generic modalid="poapprovealert2" title="Confirmation" message={{message}} data-ng-click-right-button="Approved();"></confirm-archive-generic>
<style>
    .modellgModify {
        width: 1400px;
    }

    .modellgModify1 {
        width: 1200px;
    }
</style>