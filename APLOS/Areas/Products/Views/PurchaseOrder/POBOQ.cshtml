<style>
    .modellgModify {
        width: 1400px;
    }
</style>
<togglable name="PO BOQ"></togglable>@*PO Without Requisition*@
<div class="form-horizontal form-elements" ng-form="poBOQForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">PO Basic Info</legend>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Contract">Contract</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" name="ContractId" ng-model="productNew.ContractId" class="form-control" maxlength="100" ng-hide="true">
                    <input type="text" name="ContractNo" ng-model="productNew.ContractNo" ng-disabled="true" class="form-control" maxlength="100">
                    <span class="input-group-btn">
                        <button ng-click="GetPopUpContract()" class="btn single-small-btn" ng-disabled="inventoryMaterialList.length"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="Clearcontract()" class="btn single-small-btn" ng-disabled="inventoryMaterialList.length"><i class="glyphicon glyphicon-refresh"></i></button>
                        <button ng-click="GetMasterOrderByContractList()" class="btn single-small-btn"><i class="glyphicon glyphicon-list-alt"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Customer Name" ng-hide="productNew.OrderSpecific==='No'">Customer Name</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" name="Customer Name" ng-model="productNew.CustomerName" class="form-control" maxlength="100" disabled ng-hide="productNew.OrderSpecific==='No'">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-5 col-md-5">
            <div class="form-group">
                <label class="col-sm-3 control-label">Vendor<sup>*</sup></label>
                <div class="col-sm-7">
                    <div class="input-group">
                        <input type="text" hidden id="masterId" /> @*<label id="PartyCode"></label>*@
                        <span class="input-group-addon"> {{productNew.PartyCode}}</span>
                        <input type="text" name="Vendor" id="Vendor" ng-model="productNew.PartyName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="showPartyPopUpNew()" ng-disabled="inventoryMaterialList.length>0" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                        </span>
                    </div>
                </div>
                <div class="col-sm-2 show-message" style="padding-left:0px;">
                    <div class="common-btn">
                        <button ng-click="GetPOBoqItem();" class="btn"><i class="glyphicon glyphicon-circle-arrow-down"></i>Go</button>
                    </div>
                </div>
            </div>

        </div>
        <div class="clearfix"></div>
        <div class="col-lg-12">
            <div class="content-container-fluid" style="color:black;">
                <div style="color:black;" id="GridPrint" ej-grid e-datasource="poBoqItemList" e-allowfiltering="true" e-allowpaging="true"
                     e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
                     e-actioncomplete="actionCompleteSelected" e-allowscrolling="true" e-showstackedheader="true">
                    <div e-columns>
                        <div e-column e-field="BOQId" e-headertext="BOQ Id" e-width="60"></div>
                        <div e-column e-field="CostingItemName" e-headertext="Costing Item " e-width="100"></div>
                        <div e-column e-field="BuyerOrderReferenceNo" e-headertext="BuyerOrder#" e-width="100"></div>
                        <div e-column e-field="OwnOrderReferenceNo" e-headertext="OwnOrder#" e-width="100"></div>
                        <div e-column e-field="UserName" e-headertext="Material" e-width="120"></div>
                        <div e-column e-field="StandardName" e-headertext="Article" e-width="120"></div>
                        <div e-column e-field="BOMQty" e-headertext="BOQ" e-width="100" textAlign='Right'></div>
                        <div e-column e-field="BOQUOM" e-headertext="BOQUOM" e-width="80" textAlign='Right'></div>
                        <div e-column e-field="RequiredQty" e-headertext="Booking Qty" e-width="100" textAlign='Right'></div>
                        <div e-column e-template="#UOM" e-headertext="UoM" e-width="100"></div>
                        <div e-column e-template="#CurrentTextBOQ" e-field="TransactionQty" e-textalign="right" e-headertext="CurrentQty" e-width="100"></div>
                        @*<div e-column e-field="TransactionRate" e-textalign="right" e-headertext="BOQRate" e-width="100"></div>*@
                        <div e-column e-template="#BOQQRate" e-field="TransactionRate" e-textalign="right" e-decimalplaces="4" e-headertext="Rate" e-width="100"></div>
                        <div e-column e-field="TransactionRateBOQ" e-headertext="BOQRate" e-width="80" e-textalign="right"></div>

                        <div e-column e-field="RequiredQtyApproved" e-headertext="Approved" e-width="100"></div>
                        <div e-column e-field="IncompleteMaterial" e-headertext="Incomplete" e-width="120"></div>
                        <div e-column e-field="RMDescription" e-headertext="RM Description" e-width="100"></div>
                        <div e-column e-field="RMVendorSpec" e-headertext="Vendor Specification" e-width="100"></div>
                        <div e-column e-field="RMCustomerSpec" e-headertext="Customer Specification" e-width="100"></div>

                        <div e-column e-field="Destination" e-headertext="Destination" e-width="80"></div>
                        <div e-column e-field="SalesOrderId" e-headertext="SalesOrderId" e-width="80"></div>
                        <div e-column e-field="BuyerItemReferenceNo" e-headertext="BuyerItem#" e-width="80"></div>
                        <div e-column e-field="OwnItemReferenceNo" e-headertext="OwnItem#" e-width="80"></div>
                        <div e-column e-field="DeliveryDate" e-headertext="DeliveryDate" e-width="100"></div>
                        <div e-column e-field="PONumber" e-headertext="PONumber" e-width="100"></div>
                        <div e-column e-field="Vendor" e-headertext="Vendor" e-width="300"></div>
                        <div e-column e-field="MasterOrderId" e-headertext="MasterOrderId" e-width="150"></div>
                        <div e-column e-field="MasterOrderItemId" e-headertext="MasterOrderItemId" e-width="150"></div>
                        <div e-column e-field="BOQId" e-headertext="BOQ Id" e-width="100"></div>

                        <div e-column e-type="boolean" e-field="Consignment" e-headertext="Consignment" e-width="60"></div>
                        <div e-column e-type="string" e-field="PurchaseAuthority" e-headertext="Purh. Authority" e-width="150"></div>
                        <div e-column e-type="string" e-field="ProductionAuthority" e-headertext="Prod. Authority" e-width="150"></div>
                        <div e-column e-type="string" e-field="Type" e-headertext="Type" e-width="80"></div>
                    </div>


                </div>
                <script type="text/template" id="CurrentTextBOQ">
                    <input type="text" class="input form-control" ng-blur="$parent.refreshQtyTemplete(this)" form-control" ng-disabled="RequisitionDetailId" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.TransactionQty" width="80" @*ng-keyup="$parent.refreshQtyTemplete(this)"*@ />

                </script>
                <script type="text/template" id="BOQQRate">
                    <input type="text" class="input ejinputtext form-control" ng-disabled="RequisitionDetailId" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.TransactionRate" width="80" ng-change="$parent.calculateRequisitionData(this)" />

                </script>
                <script type="text/template" id="UOM">
                    <div class="select-style">
                        <select name="Entity" ng-model="data.TransactionUoMId" class="form-control" ng-change="$parent.ConvertedDataRow(data)"
                                ng-options="item.Value as item.Text for item in data.uoMList"></select>
                    </div>

                </script>
                @*<script id="DeleteTemplate" type="text/template">
            <div class="common-btn">
                <ul class="common-btn list-inline text-center">
                    <li>
                        <button ng-disabled="data.AdditionalTaxId==null" ng-click="$parent.onClickadditionalTaxPop(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="TDS">
                            TDS
                        </button>
                        <button ng-disabled="data.IsPark==false" ng-click="$parent.onClickDeletePopUp(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Delete">
                            <i class="glyphicon glyphicon-trash" style="color:orangered;"></i>
                        </button>
                        <button ng-show="data.WrittenOffAmount" ng-click="$parent.getInvoiceSetOffDetailByInvoice(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="SetOff">
                            <i class="glyphicon glyphicon-eye-open" style="color:orangered;"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>*@
            </div>
        </div>
    </fieldset>
</div>
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")

<div class="modal fade site-modal in" id="invoicingPartyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Invoicing Party</div>  @*<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button>*@
            <div class="modal-body form-elements form-horizontal">
                @*//here some problem*@
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 col-md-4 control-label">Invoicing by</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select ng-model="productNew.InvoicingPartyPlantId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in plantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(productNew.InvoicingPartyPlantId,'billTo')">
                                    @*<option value="">ddd</option>*@
                                </select>
                            </div>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">State :{{productNew.InvoicingState}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">GSTIN :{{productNew.InvoicingGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Invoicing by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="productNew.InvoicingByAddress" class="form-control" maxlength="300"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                @*<select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList" ng-change="onchangeFunction1(x.TaxCategoryId)"></select>*@
                                <select class="form-control" ng-model="productNew.DeliveryPartyPlantId" ng-options="item.Value as item.Text for item in plantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(productNew.DeliveryPartyPlantId,'shipTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">State :{{productNew.DeliveryState}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">GSTIN :{{productNew.DeliveryGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="productNew.DeliveryByAddress" class="form-control" maxlength="300"></textarea>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeInvoicingPartyPopUp();" class="btn"> Done</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="ContractPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Contract <button type="button" class="close" ng-click="CloseContractPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="Gridd" ej-grid e-datasource="contractList" e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick="SelectedContract"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="ContractId" e-headertext="Contract Id" e-width="70"></div>
                                <div e-column e-field="ContractNo" e-headertext="Contract No" e-width="80"></div>
                                <div e-column e-field="CustomerName" e-headertext="Customer" e-width="150"></div>
                                <div e-column e-field="Buyer" e-headertext="Buyer" e-width="150"></div>
                                <div e-column e-field="LCRef" e-headertext="Master LC Ref No" e-width="80"></div>
                                <div e-column e-field="MasterLCNo" e-headertext="Master Lc Id" e-width="70"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplateChild">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="CloseContractPopUp();" class="btn"> Apply</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

