                                 e-allowfiltering="true"
                                 e-allowpaging="true"
                                 e-allowsorting="true" 
                                 e-allowResizing="true"
                                 e-filtersettings-filterType="excel" e-recorddoubleclick=""
                                 e-enabletouch="true" @*e-actioncomplete="ReqistionHRScroll"*@
                                 e-detailstemplate="detailTemp"
                                 e-detailsdatabound="detailgrid">
                                <div e-columns>
                                    <div e-column e-headertext="Actions" e-width="50">
                                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk" title="Checked/Hold/Reject" ng-click="$parent.onClickChecked('GridPOChk');" style="margin: -6px;"></i></button>
                                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.AllTabPrint('GridPOChk');" style="margin: -6px;"></i></button>
                                    </div>
                                    <div e-column e-template="#ApprovedBy" e-headertext="To Be Approved By" e-width="200"></div>
                                    <div e-column e-template="#RejectCheckedReason1" e-headertext="Hold / Reject Reason" e-width="200" style="height: 20px;"></div>
                                    <div e-column e-template="#ApprovedStatus" e-headertext="Checked Status" e-width="150"></div>
                                    
                                    <div e-column e-field="PartyName" e-headertext="Vendor" e-width="100"></div>
                                    <div e-column e-field="PartyCode" e-headertext="Vendor Code" e-width="100"></div>
                                    <div e-column e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="120"></div>
                                    <div e-column e-field="PODate" e-headertext="PO Date" e-width="100"></div>
                                    <div e-column e-field="Id" e-headertext="PO No" e-width="100"></div>
                                    <div e-column e-field="DocRefNo" e-headertext="Vendor DocNo" e-width="100"></div>
                                    <div e-column e-field="Amount" e-headertext="Total Amount" textAlign='Right' e-width="120"></div>
                                    <div e-column e-field="AddedBy" e-headertext="Prepared By" e-width="120"></div>
                                    <div e-column e-field="CheckedBy" e-headertext="Checked By" e-width="120"></div>
                                    <div e-column e-field="CheckedByStatus" e-headertext="Checked Status" e-width="100"></div>
                                    <div e-column e-field="CheckedHoldRejectReason" e-headertext="Hold / Reject Reason" e-width="100"></div>


                                </div>
                            </div>
                        </div>
                        <script id="tabGridContents" type="text/x-jsrender">
                            <div class="tabcontrol" id="Test">
                                <ul>
                                    <li><a href="#gridTab{{:Id}}">PO Details</a></li>
                                    <li><a href="#gridTab1{{:Id}}">PO Checked Status</a></li>
                                    <li><a href="#gridTab2{{:Id}}">Attached Documents List</a></li>

                                </ul>
                                <div id="gridTab{{:Id}}">
                                    <div id="detailGrid"></div>
                                </div>
                                <div id="gridTab1{{:Id}}">
                                    <div>
                                        <div class='employee-details'>
                                            <ul>
                                                <li><label style="color:maroon;">Prepared By:</label><span style="padding-left:8px">{{:AddedBy}}</span></li>
                                                <li><label style="color:maroon;">Checked By:</label><span style="padding-left:8px">{{:CheckedBy}}</span></li>
                                                <li><label style="color:maroon;">Checked Status:</label><span style="padding-left:8px">{{:CheckedByStatus}}</span></li>
                                                <li><label style="color:maroon;">Approved By:</label><span style="padding-left:8px">{{:ApprovedBy}}</span></li>
                                                <li><label style="color:maroon;">Approved Status:</label><span style="padding-left:8px">{{:ApprovedByStatus}}</span></li>
                                                <li><label style="color:maroon;">Hold /Reject Reason:</label><span style="padding-left:8px">{{:CheckedHoldRejectReason}}</span></li>

                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <div id="gridTab2{{:Id}}">
                                    <div id="detailGrid1" style="width:800px;"></div>
                                </div>

                            </div>
                        </script>
                    </div>
                </fieldset>
            </div>
