                                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.AllTabPrint('GridPOHRchk');" style="margin: -6px;"></i></button>

                                    </div>
                                    <div e-column e-template="#holdRejectGraph1" e-headertext="To Be Approved By" e-width="200"></div>
