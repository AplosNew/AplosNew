                    </div>
                </fieldset>
            </div>

        </div>
    </div>
    <div class="modal fade site-modal in" id="ActionPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header"> Reason for approved & Unaooroved</div>
                <div class="modal-body">
                    <div class="col-xs-12 col-sm-12col-md-12">

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Reason</label>
                            <label class="col-sm-4 control-label" ng-model="SystemId" ng-hide="true">{{SystemId}}</label>
                            <div class="col-sm-12">
                                <textarea type="text" rows="3" ng-model="reason" class="form-control" style="border:double"></textarea>
                            </div>



                        </div>

                    </div>
                    <div class="clearfix"></div>
                    <div class="">
                        <ul class="common-btn list-inline text-right">
                            <li><button ng-click="poApp1();" class="btn"> Save</button></li>
