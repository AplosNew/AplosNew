							<div e-column e-template="#actionTemplateAmount" e-headertext="Amount" e-width="80"></div>

						</div>
					</div>
				</div>
				<script type="text/template" id="actionTemplateAmount">

					<label id="BudgetDetailTemplate" ng-click="$parent.GetExpenseDetailJS(this)" style="color:blue;text-decoration:underline;cursor:pointer">{{data.Amount}}</label>

