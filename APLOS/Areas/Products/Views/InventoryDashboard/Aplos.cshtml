<div id="BudgetWiseExpenseListModal" class="modal fade site-modal in" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-left:115px;">
	<div class="modal-dialog" style="width:1250px;">
		<div class="modal-content" style="width:1250px; ">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal">&times;</button>
				<h4 class="modal-title" id="myModalLabel"></h4>
			</div>
			<div class="modal-body table-responsive modal-table" style="overflow-y:scroll; max-height:375px;">
				<div class="content-container-fluid" style="color:black;">
					<div id="BudgetAmountDetailList" ej-grid e-datasource="BudgetWiseExpenseDetailList"
						 e-allowfiltering="true"
						 e-filtersettings-filterType="excel">
						<div e-columns>
