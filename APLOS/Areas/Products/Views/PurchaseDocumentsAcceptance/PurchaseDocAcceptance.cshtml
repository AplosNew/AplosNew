                                            <select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList" ng-change="onchangeFunction1(x.TaxCategoryId)"></select>
                                        </div>
                                    </td>
                                    <td><input type="text" n-decimals="4" class="form-control text-right" ng-disabled="productNew.TaxOptionServicePOModify==='No'" ng-model="x.Percentage" ng-keyup="calculateTaxAmountForServicePO(x, $index)"></td>  @*ng-keyup="checkRowValidation(x, $index)"*@
                                    @*<td ng-hide="percentageColumn">{{x.Percentage}}</td>*@
                                    @*<td ng-hide="percentageColumn">{{x.HSNCode}}</td>*@
                                    @*<td>{{x.TaxAmount}}</td>*@
                                    <td><input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TaxAmount" ng-disabled="productNew.TaxOptionServicePOModify==='Yes'" ng-keyup="checkRowValidationServicePO(x, $index)"></td>  @*ng-keyup="checkRowValidation(x, $index)"*@
                                    @*<td></td>*@
                                </tr>
                                <tr>
                                    @*<td colspan="3" class="text-right"><label class="control-label"><b>Total : {{total}}</b>&nbsp;{{Currency}}</label></td>*@
                                    <td colspan="3" class="text-right"><strong>{{ServicePOTaxList | sumByKey : 'TaxAmount'| setDecimal:2| number:2 }}</strong></td>
                                    @*<td></td>*@
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="UpdateServicePOAckTax();" class="btn" ng-show="Action==='Update'"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
                        <li><button ng-click="closegetServicePOTaxList();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


