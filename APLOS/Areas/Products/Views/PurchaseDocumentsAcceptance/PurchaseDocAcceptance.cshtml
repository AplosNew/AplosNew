<div class="modal fade site-modal in" id="invoicingPartyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Invoicing Party<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 col-md-4 control-label">Invoicing by :</label>
                        <div class="col-sm-8">
                            <div class="select-style" hidden>
                                <select ng-model="productNew.InvoicingPartyPlantId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in plantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(productNew.InvoicingPartyPlantId,'billTo')">
                                    <option value=""></option>
                                </select>
                            </div>

                            <p>{{productNew.InvoicingByName}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">State :{{productNew.InvoicingState}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">GSTIN :{{productNew.InvoicingGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Invoicing by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="productNew.InvoicingByAddress" class="form-control" readonly></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by</label>
                        <div class="col-sm-8">
                            <div class="select-style" hidden>
                                <select class="form-control" ng-model="productNew.DeliveryPartyPlantId" ng-options="item.Value as item.Text for item in plantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(productNew.DeliveryPartyPlantId,'shipTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p>{{productNew.InvoicingByName}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">State :{{productNew.DeliveryState}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">GSTIN :{{productNew.DeliveryGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="productNew.DeliveryByAddress" class="form-control" readonly></textarea>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeInvoicingPartyPopUp();" class="btn"> Done</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="detailPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Detail Data Entry<button type="button" class="close" ng-click="closeDetaiPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border"> Material</legend>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" id="div_mm">
                            <label class="col-sm-4 control-label">Material</label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" ng-model="detailModel.MaterialMasterName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button tabindex="1" ng-click="getMaterialMasterbyTypePopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" id="div_ar" ng-show="hasArticle">
                            <label class="col-sm-4 control-label">Article</label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Finished Goods" ng-model="detailModel.ArticleName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button tabindex="1" ng-click="getArticleSearchList(detailModel.MaterialMasterId);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Material Group</label>
                            <label class="col-sm-8 control-label">{{detailModel.MaterialGroupMasterName}}</label>
                        </div>
                        <div class="form-group" ng-show="detailModel.IsProductMstRequired">
                            <label class="col-sm-4 control-label">Prd Master</label>
                            <label class="col-sm-8 control-label">{{detailModel.ProductMasterName}}</label>
                        </div>
                        <div class="form-group" id="div_storage">
                            <label class="col-sm-4 col-md-4 control-label">Storage Location</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Storage Location" ng-model="detailModel.MaterialStorageId" class="form-control" ng-options="item.Value as item.Text for item in storageList"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" id="div_country">
                            <label class="col-sm-4 col-md-4 control-label">Country<sup ng-show="detailModel.IsOriginApplicable">*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Country" ng-disabled="!detailModel.IsOriginApplicable" ng-model="detailModel.CountryId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in countryList">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Base UoM</label>
                            <label class="col-sm-8 control-label">{{detailModel.BaseUoM}}</label>
                        </div>
                        <div class="form-group" ng-show="detailModel.IsOurStyleRequired">
                            <label class="col-sm-4 control-label">OurStyle</label>
                            <label class="col-sm-8 control-label">{{detailModel.OurStyleName}}</label>
                        </div>
                        <div class="form-group" id="div_toCrate">
                            <label class="col-sm-4 control-label">To Currency Rate<sup>*</sup></label>

                            <div class="col-sm-8 show-message">
                                <input type="text" name="Currency Rate" n-decimals="{{currencyPrecision}}" ng-model="detailModel.ToCurrencyRate" disabled class="form-control text-right" placeholder="0.00"
                                       ng-keyup="calculateTaxCategory();" />
                            </div>
                        </div>
                    </div>
                </fieldset>
                <!--detailModel Entry Right-->
                <hr ng-show="char1.CharacteristicsId.length>0;" />
                <div class="col-xs-12 col-sm-6 col-md-6" ng-show="char1.CharacteristicsId.length>0;">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">{{char1.Name}}<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" ng-model="char1.FreeText" class="form-control"
                                       ng-keyup="nullByFreeText('char1')" disabled ng-required="char1.IsMandatory">
                                <span class="input-group-btn">
                                    <button ng-click="findCharValueSearchData(char1, 'char1')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="clearCharValueField('char1');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                            <p class="msg-error" ng-show="IsMandatoryButNull(char1.IsMandatory, char1.FreeText)">value is required.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6" ng-show="char2.CharacteristicsId.length>0;">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">{{char2.Name}}<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" ng-model="char2.FreeText" class="form-control"
                                       ng-keyup="nullByFreeText('char2')" disabled ng-required="char2.IsMandatory">
                                <span class="input-group-btn">
                                    <button ng-click="findCharValueSearchData(char2, 'char2')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="clearCharValueField('char2');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                            <p class="msg-error" ng-show="IsMandatoryButNull(char2.IsMandatory, char2.FreeText)">value is required.</p>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6" ng-show="char3.CharacteristicsId.length>0;">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">{{char3.Name}}<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" ng-model="char3.FreeText" class="form-control"
                                       ng-keyup="nullByFreeText('char3')" disabled ng-required="char3.IsMandatory">
                                <span class="input-group-btn">
                                    <button ng-click="findCharValueSearchData(char3, 'char3')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="clearCharValueField('char3');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                            <p class="msg-error" ng-show="IsMandatoryButNull(char3.IsMandatory, char3.FreeText)">value is required.</p>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <hr style="width:100%;" />
                <div class="col-xs-4 col-sm-4 col-md-4">
                    <div class="form-group" id="div_qty">
                        <label class="col-sm-4 control-label">Transaction Qty<sup>*</sup></label>
                        <div class="col-sm-4 show-message" style="padding-right:0px;">
                            <input type="text" n-decimals="{{currencyPrecision}}" name="Transaction Qty" maxlength="18" ng-model="detailModel.TransactionQty" class="form-control text-right" ng-keyup="calculateTaxCategory();manualValidationAddRemove('div_qty', 'detailModel','TransactionQty');">
                        </div>
                        <div class="col-sm-4 show-message" style="padding-left:0px;">
                            <div class="select-style">
                                <select name="Transaction UoM" class="form-control" ng-model="detailModel.TransactionUoMId" ng-options="item.Value as item.Text for item in uoMList" ng-change="manualValidationAddRemove('div_uom', 'detailModel','TransactionUoMId');">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">Unit Rate<sup>*</sup></label>
                        <label class="col-sm-6 control-label">{{detailModel.TransactionRate| number| setDecimal:currencyPrecision}} {{detailModel.CurrencyName}}</label>
                    </div>
                </div>
                <div class="col-xs-4 col-sm-4 col-md-4">
                    <div class="form-group" id="div_tamnt">
                        <label class="col-sm-5 control-label" data-placement="top" title="Cost and Manufacture">Total Amount<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="col-sm-8" style="padding-left:0px;padding-right:0px;">
                                <input type="text" name="Amount" n-decimals="{{currencyPrecision}}" ng-model="detailModel.TransactionAmount" class="form-control text-right" placeholder="0.00"
                                       ng-keyup="calculateTaxCategory();manualValidationAddRemove('div_tamnt', 'detailModel','TransactionAmount');" />
                            </div>
                            <div class="col-sm-4" style="padding-left:0px;padding-right:0px;">
                                <input type="text" ng-model="detailModel.CurrencyName" class="form-control" disabled />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 modal-table table-responsive" style="padding-top: 13px;" ng-show="taxCategoryList.length>0">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Tax Category</th>
                                <th>HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount (BC)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in taxCategoryList">
                                <td>{{x.UserName}}</td>
                                <td>{{x.HSNCode}}</td>
                                <td class="text-right">{{x.Percentage}}</td>
                                <td class="text-right">
                                    <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.TaxAmount" ng-keyup="sumTaxAmount();" class="form-control text-right" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-right">Total Tax (BC)</td>
                                <td class="text-right">{{detailModel.TotalTaxAmount| setDecimal:currencyPrecision}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="detailSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{detailModel.Id.length>0?'Update':'Save'}}</button></li>
                        <li><button ng-click="closeDetaiPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
