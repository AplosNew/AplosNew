                            <label class="col-sm-4 control-label">Required Qty<sup>*</sup></label>
                            <div class="col-sm-4 show-message" style="padding-right:0px;">
                                <input type="text" n-decimals="{{currencyPrecision}}" name="Required Qty" maxlength="18" ng-model="detailModel.TransactionQty" class="form-control text-right" ng-keyup="calculateTaxCategory();manualValidationAddRemove('div_qty', 'detailModel','TransactionQty');" required>
                            </div>
                            <div class="col-sm-4" style="padding-left:0px;">
                                <div class="select-style">
                                    <select name="Transaction UoM" class="form-control" ng-model="detailModel.TransactionUoMId" ng-options="item.Value as item.Text for item in uoMList" ng-change="manualValidationAddRemove('div_uom', 'detailModel','TransactionUoMId');">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="form-group" id="div_Rt" show-errors>
                            <label class="col-sm-5 control-label">Estimated Rate/Unit<sup>*</sup></label>
                            @*<label class="col-sm-6 control-label">{{detailModel.EstimatedRate| number| setDecimal:currencyPrecision}} {{detailModel.CurrencyName}}</label>*@
                            <div class="col-sm-7 show-message">
                                <div class="col-sm-8" style="padding-left:0px;padding-right:0px;">
                                    <input type="text" name="Rate" n-decimals="{{currencyPrecision}}" ng-model="detailModel.EstimatedRate" class="form-control text-right" placeholder=""
                                           ng-keyup="calculateTaxCategoryRate();manualValidationAddRemove('div_Rt', 'detailModel','TransactionRate');" required />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="form-group" id="div_tamnt" show-errors>
                            <label class="col-sm-5 control-label" data-placement="top" title="Cost and Manufacture">Total Amount<sup>*</sup></label>
                            <div class="col-sm-7 show-message">
                                <div class="col-sm-8" style="padding-left:0px;padding-right:0px;">
                                    <input type="text" name="Amount" n-decimals="{{currencyPrecision}}" ng-model="detailModel.TotalAmount" class="form-control text-right" placeholder=""
                                           ng-keyup="calculateTaxCategory();manualValidationAddRemove('div_tamnt', 'detailModel','TotalAmount');" disabled />
                                </div>
                                <div class="col-sm-4" style="padding-left:0px;padding-right:0px;">
                                    <input type="text" ng-model="detailModel.CurrencyName" class="form-control" disabled />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 modal-table table-responsive" style="padding-top: 13px;" ng-show="taxCategoryList.length>0">

                    </div>
                    <div class="clearfix"></div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="detailSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{detailModel.Id.length>0?'Update':'Save'}}</button></li>
                            <li><button ng-click="closeDetaiPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*END Detail Data Entry*@
