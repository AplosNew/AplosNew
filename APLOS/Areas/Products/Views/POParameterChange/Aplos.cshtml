<togglable name="PO Parameter Change"></togglable>
<style>
    .modellgModify {
        width: 1400px;
    }

    .modellgModify1 {
        width: 1200px;
    }
</style>
<div class="row">
    <div class="form-horizontal form-elements" ng-form="productNewForm">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-6 control-label">Order Specific</label>
                <div class="col-sm-6">
                    <div class="radio">
                        <label>
                            <input type="radio" name="OrderSpecific" ng-model="productNew.OrderSpecific" disabled value="No">
                            <span class="cr"><i class="cr-icon"></i></span>No
                        </label>
                        <label>
                            <input type="radio" name="OrderSpecific" ng-model="productNew.OrderSpecific" disabled value="Yes">
                            <span class="cr"><i class="cr-icon"></i></span>Yes
                        </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" hidden id="masterId" />
                        <span class="input-group-addon"> {{productNew.PartyCode}}</span>
                        <input type="text" name="Vendor" id="Vendor" ng-model="productNew.PartyName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="showPartyPopUpNew()" ng-disabled="GRNValue!==0 || AcptValue!==0" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            <button name="submit" ng-click="invoicingPartyPopUp()" ng-disabled="LCRef!==null || GRNValue!==0 || AcptValue!==0" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group" id="div_grnNo">
                <label class="col-sm-4 control-label">PO No</label>
                <div class="col-sm-8">
                    <input type="text" name="PO No" ng-model="productNew.Id" class="form-control" maxlength="10" disabled>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Payment Term<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="paymentTermId" class="form-control" name="Payment Term" ng-model="productNew.PaymentTermId" ng-change="changePaymentTerm();PaymentModeByPaymentTerm();" tabindex="12" required>
                            <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label" style="color:blue">LC No: {{LCRef}}</label>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Customer Name">Customer Name</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" name="Customer Name" ng-model="productNew.CustomerName" class="form-control" maxlength="100" disabled ng-hide="productNew.OrderSpecific==='No'">
                </div>
            </div>
            <div class="form-group" id="div_docNo">
                <label class="col-sm-4 control-label">Vendor Doc/PI RefNo<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" name="DocRefNo" ng-disabled="GRNValue!==0 || AcptValue!==0" ng-model="productNew.DocRefNo" class="form-control" maxlength="100" tabindex="2" autocomplete="off">
                </div>
            </div>
            <div class="form-group" id="div_PODate">
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" name="PO Date" disabled ng-model="productNew.PODate" datepicker="modelValidation('div_PODate', 'productNew', 'PODate');" end-date="currentDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="6">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Payment Mode:{{productNew.PaymentMode}}</label>
                <label class="col-sm-4 control-label">Total Amount</label>
                <div class="col-sm-4">
                    <input type="text" name="Total Amount" ng-model="productNew.TransactionAmount| number:2" class="form-control" maxlength="10" disabled>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-12 control-label" style="color:blue">Total GRN Amount: {{GRNValue| number:2}}</label>

            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Contract">Contract</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" name="ContractId" ng-model="productNew.ContractId" class="form-control" maxlength="100" ng-hide="true">
                    <input type="text" name="ContractNo" ng-model="productNew.ContractNo" ng-disabled="true" class="form-control" maxlength="100" ng-hide="productNew.OrderSpecific==='No'">
                </div>
            </div>
            <div class="form-group" id="div_docDate">
                <label class="col-sm-4  control-label">Date</label>
                <div class="col-sm-8">
                    <input type="text" name="Date" ng-model="productNew.DocDate" datepicker="modelValidation('div_docDate', 'productNew', 'DocDate');changePaymentTerm();getToCurrencyRate();" end-date="currentDate" id="cutOffDate" class="form-control" placeholder="dd-Mmm-yyyy" tabindex="3">
                </div>
            </div>
            <div class="form-group" id="div_currency">
                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-5">
                    <div class="select-style">
                        <select class="form-control" id="currency" ng-model="productNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList" disabled>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-3" style="padding-left: 0px;margin-left: -16px;width: 108px;">
                    <input type="text" n-decimals="2" name="ToCurrencyRate" ng-model="productNew.ToCurrencyRate" ng-disabled="true" ng-keyup="manualValidationAddRemove('div_rate', 'productNew', 'ToCurrencyRate');" class="form-control text-right" tabindex="9">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Is Tolerance Update</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input tabindex="8" ng-change="IsToleranceUpdateChange()" type="checkbox" ng-model="IsToleranceUpdate">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-12 control-label" style="color:blue"></label>
            </div>
            <div class="form-group">
                <label class="col-sm-12 control-label" style="color:blue"></label>
            </div>
            <div class="form-group">
                <label class="col-sm-12 control-label" style="color:blue">Total Acceptance Amount: {{AcptValue| setDecimal:2| number:2}}</label>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{productNew.Id.length>0?'Update':'Save'}}</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Material</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div ng-form="tabForm1">
                    <div class="table-responsive modal-table" ng-show="inventoryMaterialList.length>0">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>RowId</th>
                                    <th>Material Group</th>
                                    <th>Material Master</th>
                                    <th>Article</th>
                                    <th>Sku1</th>
                                    <th>Sku2</th>
                                    <th>Sku3</th>
                                    <th>CountryName</th>
                                    <th>Trn_Qty</th>
                                    <th>UOM</th>
                                    <th>Trn_Rate</th>
                                    <th>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Amount&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                                    <th>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Tax&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                                    <th>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;TotalAmount&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>
                                    <th style="width:500px;">Description</th>
                                    <th style="width:500px;">Reference No</th>
                                    <th>Delivery Date</th>
                                    <th>GRN Amount</th>
                                    <th>Acceptance Amount</th>
                                    <th>Tolerance</th>
                                    <th class="col-sm-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in inventoryMaterialList">
                                    <td>{{x.InventoryReceiveDetailId}}</td>
                                    <td>{{x.MaterialGroupMasterName}}</td>
                                    <td>{{x.UserName}}</td>
                                    <td>{{x.StandardName}}</td>
                                    <td>{{x.FirstCharacteristicsValue}}</td>
                                    <td>{{x.SecondCharacteristicsValue}}</td>
                                    <td>{{x.ThirdCharacteristicsValue}}</td>
                                    <td>{{x.CountryName}}</td>
                                    <td class="text-right" style="width:200px;" ><input type="number" ng-disabled="IsToleranceUpdate" name="TransactionQty" ng-model="x.TransactionQty" ng-keyup="calculateAmount(x)" class="form-control"></td>
                                    <td class="text-right" style="width:50px;">{{x.TransactionUoM}}</td>
                                    <td class="text-right" style="width:200px;"><input type="number" ng-disabled="IsToleranceUpdate" name="TransactionRate" ng-model="x.TransactionRate" ng-keyup="calculateAmount(x)" class="form-control"></td>
                                    <td class="text-right" style="width:150px;">{{x.TrnAmount| number:2}}</td>
                                    <td class="text-right" style="width:150px;">{{x.BaseTaxAmount| number:2}}</td>
                                    <td class="text-right" style="width:150px;">{{x.TotalAmount| number:2}}</td>
                                    <td>{{x.Description}}</td>
                                    <td>{{x.RefferenceNo}}</td>
                                    <td>
                                        <div class="form-group">
                                            <div class="col-sm-12 show-message">
                                                <input type="text" name="DeliveryDate" ng-model="x.DeliveryDate" datepicker class="form-control" required>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-right" style="width:150px;">{{x.GRNAmount| number:2}}</td>
                                    <td class="text-right" style="width:150px;">{{x.ACPTAmount| number:2}}</td>
                                    <td class="text-right" style="width:150px;"><input type="text" name="Tolerance" ng-disabled="IsToleranceUpdate==false" ng-model="x.Tolerance" class="form-control"></td>
                                    <td class="text-right">
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="UpdateDetail(x)" class="btn btn-action tooltip-here" data-placement="top" title="Update"><i class="glyphicon glyphicon-floppy-saved"></i></button></li>
                                            @*<li><button ng-click="valuePassInDelModal(x)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-trash"></i></button></li>*@
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="8" class="text-right"><strong>Total : </strong></td>
                                    <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'TransactionQty'}}</strong></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'TrnAmount'| setDecimal:2| number:2}}</strong></td>
                                    <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'BaseTaxAmount'| setDecimal:2| number:2}}</strong></td>
                                    <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'TotalAmount'| setDecimal:2| number:2}}</strong></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'GRNAmount'| setDecimal:2| number:2}}</strong></td>
                                    <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'ACPTAmount'| setDecimal:2| number:2}}</strong></td>
                                    <td class="text-right"></td>
                                    <td class="text-right"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>

    </div>
</div>
<div class="row aplos-grid-toggle">
    <div class="col-md-12">
        <div style="color:black;" id="Grid" ej-grid e-datasource="POdataList" e-recorddoubleclick="recorddoubleclick"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="true">
            <div e-columns>
                <div e-column e-type="string" e-field="Id" e-headertext="PO No" e-width="150"></div>
                <div e-column e-type="string" e-field="PartyName" e-headertext="Vendor" e-width="250"></div>
                <div e-column e-type="string" e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="150"></div>
                <div e-column e-type="date" e-field="PODate1" e-headertext="PO Date" e-width="100" e-format="{0:dd-MMM-yyyy}"></div>
                <div e-column e-type="string" e-field="DocRefNo" e-headertext="Vendor DocNo" e-width="150"></div>
                <div e-column e-type="string" e-field="PurchaseLC" e-headertext="Purchase LC Ref" e-width="170"></div>
                <div e-column e-type="string" e-field="ContractNo" e-headertext="Contract No" e-width="100"></div>
                <div e-column e-type="string" e-field="CustomerName" e-headertext="Customer" e-width="170"></div>
                <div e-column e-type="number" e-field="TransactionQty" e-headertext="Qty" e-textalign="right" e-width="120"></div>
                <div e-column e-type="number" e-field="TransactionAmount" e-headertext="Amount" e-textalign="right" e-width="120"></div>
                <div e-column e-type="number" e-field="BaseAmount" e-headertext="Total Amount" e-textalign="right" e-width="150"></div>
                <div e-column e-type="string" e-field="CurrencyCode" e-headertext="Currency" e-width="100"></div>
                <div e-column e-type="string" e-field="POType" e-headertext="PO Type" e-width="100"></div>
                <div e-column e-type="string" e-field="CheckedBy" e-headertext="To be Checked By" e-width="180"></div>
                <div e-column e-type="string" e-field="CheckedByStatus" e-headertext="Checked Status" e-width="180"></div>
                <div e-column e-type="string" e-field="ApprovedBy" e-headertext="To be Approved By" e-width="180"></div>
                <div e-column e-type="string" e-field="AuthorizedByStatus" e-headertext="Approved Status" e-width="180"></div>
            </div>
        </div>

    </div>
