            <div class="tabcontrol" id="Test">
                <ul>
                    <li><a href="#gridTab{{:Id}}">Po Details</a></li>
                    <li><a href="#gridTab1{{:Id}}">Attached Documents List</a></li>
                </ul>
                <div id="gridTab{{:Id}}">
                    <div id="detailGrid"></div>
