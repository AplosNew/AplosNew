<style>
    .listClass {
        width: auto;
        text-align: right;
    }

    .listClassLbl {
        width: 170px;
        text-align: left;
        font-weight: normal;
    }

    .customLbl {
        padding-right: 0px;
    }

    .customControl {
        padding-left: 0px;
        padding-right: 20px;
    }
</style>
<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> Product Definition</h3>
<div class="form-elements form-horizontal" ng-form="form">
    <div class="col-md-12 divborder mark">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="form-group">
                <label class="col-sm-2 control-label">Material (Mst)<sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <div class="input-group">
                        <input type="text" name="Mterial (Mst)" ng-model="modelNew.UserName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="GetFabricList();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="popUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-plus"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Code :</label>
                <label class="col-sm-8 control-label">{{modelNew.Code}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Standard Name :</label>
                <label class="col-sm-8 control-label">{{modelNew.StandardName}}</label>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Short Name :</label>
                <label class="col-sm-8 control-label">{{modelNew.ShortName}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Base UoM :</label>
                <label class="col-sm-8 control-label">{{modelNew.BaseUoM}}</label>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">General</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Efficency</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row" ng-form name="formTab1">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Product Master<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select ng-model="modelNew.ProductMasterId" class="form-control" name="Product Master"
                                        ng-change="changeOnProductMaster(modelNew.ProductMasterId)"
                                        ng-options="item.Value as item.Text for item in productMasterList" tabindex="1" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Base Process(Production)<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select submit-="true" ng-model="modelNew.ProcessId" class="form-control" name="Process"
                                        ng-options="item.Value as item.Text for item in processList" tabindex="3" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-xs-12 col-sm-12 col-md-12" ng-repeat="x in prdNameList">
                    <label class="listClass">Product Category :</label>
                    <label class="listClassLbl">{{x.ProductCategoryName}}</label>
                    <label class="listClass">Product SubCategory :</label>
                    <label class="listClassLbl">{{x.ProductSubCategoryName}}</label>
                    <label class="listClass">Product :</label>
                    <label class="listClassLbl">{{x.ProductName}}</label>
                    <hr />
                </div>
                <div class="clearfix"></div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Season<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select submit-="true" ng-model="modelNew.SeasonId" class="form-control" name="Season"
                                        ng-options="item.Value as item.Text for item in seasonsList" tabindex="2" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label" data-placement="top" title="Cost and Manufacture" tooltip>CM<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-6" style="padding-left:0px;padding-right:0px;">
                                <input type="text" name="CM" n-decimals="4" ng-model="modelNew.CostAndManufacture" class="form-control text-right" tabindex="6" placeholder="0.00" required />
                            </div>
                            <div class="col-sm-6" style="padding-left:0px;padding-right:0px;">
                                <div class="select-style">
                                    <select name="Currency" class="form-control" ng-model="modelNew.CostAndManufactureCurrencyId" ng-options="item.Value as item.Text for item in currencyList" tabindex="7" required>
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">First day Output per hour<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <input type="text" name="First day OutPut" only-numbers ng-model="modelNew.FirstdayOutPut" class="form-control text-right" tabindex="9"
                                       ng-change="GetDays(modelNew.IsFixed,modelNew.IncrementValue,modelNew.FirstdayOutPut,modelNew.TotalQty)" placeholder="0" required>
                                <span class="input-group-addon">{{modelNew.BaseUoM}}</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Increment Type</label>
                        <div class="col-sm-8">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="incrementtype" ng-model="modelNew.IsFixed" ng-change="GetDays(modelNew.IsFixed,modelNew.IncrementValue,modelNew.FirstdayOutPut,modelNew.TotalQty)" value="Fixed" />
                                    <span class="cr"><i class="cr-icon"></i></span>Fixed
                                </label>
                                <label>
                                    <input type="radio" name="incrementtype" ng-model="modelNew.IsFixed" ng-change="GetDays(modelNew.IsFixed,modelNew.IncrementValue,modelNew.FirstdayOutPut,modelNew.TotalQty)" value="Percentage" />
                                    <span class="cr"><i class="cr-icon"></i></span>Percentage(%)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Our Style<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select submit-="true" ng-model="modelNew.OurStyleId" class="form-control" name="Our Style"
                                        ng-options="item.Value as item.Text for item in styleList" tabindex="3" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    @*<div class="form-group">
                <label class="col-sm-4 control-label">Bulletin<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="Bulletin" ng-model="modelNew.BulletinId" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="" class="btn single-small-btn"><i class="glyphicon glyphicon-plus"></i></button>
                        </span>
                    </div>
                </div>
            </div>*@
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">@*Target Qty*@Standard Target Per hour<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" only-numbers ng-model="modelNew.TotalQty" name="Total Qty" class="form-control text-right" tabindex="8"
                                   ng-change="GetDays(modelNew.IsFixed,modelNew.IncrementValue,modelNew.FirstdayOutPut,modelNew.TotalQty)" placeholder="0" required />
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">DaysToReachTheTarget<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Days to reach the target" only-numbers ng-model="modelNew.DaysToReachTheTarget" class="form-control text-right" required disabled>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Increment Value<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Increment value" only-numbers ng-model="modelNew.IncrementValue" class="form-control text-right"
                                   ng-change="GetDays(modelNew.IsFixed,modelNew.IncrementValue,modelNew.FirstdayOutPut,modelNew.TotalQty)" tabindex="10" placeholder="0" required>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table" ng-show="articleList.length>0">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in articleList|itemsPerPage:10" pagination-id="metaData.name + 'articleList'">
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="processEntryPopUp($index);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Add Process"><i class="glyphicon glyphicon-list"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'articleList'"
                                             direction-links="true"
                                             boundary-links="true">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div ng-form="formTab2">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Efficency</th>
                                <th>No of WorkStation</th>
                                <th>Efficency in %</th>
                                <th>SPT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in efficencyList">
                                <td>{{x.EfficencyName}}</td>
                                <td><div><input type="text" only-numbers ng-model="x.NoOfWorkStation" class="form-control text-right" placeholder="0"></div></td>
                                <td><div><input type="text" n-decimals="4" ng-model="x.EfficencyPercentage" class="form-control text-right" placeholder="0.00"></div></td>
                                <td><div><input type="text" only-numbers ng-model="x.SPT" class="form-control text-right" placeholder="0"></div></td>
                            </tr>                    
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="12"></i> Clear</button></li>
        </ul>
    </div>
</div>
<confirm-modal></confirm-modal>
<!-- #region Material Master -->
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Material (Mst)<button type="button" class="close" data-dismiss="modal">&times;</button> </div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Material Type</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" ng-model="materialModel.materialTypeId" ng-enter="getPopUpData();">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Material Category</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" ng-model="materialModel.materialCategoryId" ng-enter="getPopUpData();">
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Material Group(Mst)</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" ng-model="materialModel.materialGroupMasterId" ng-enter="getPopUpData();">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Material SubCategory</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" ng-model="materialModel.materialSubCategoryId" ng-enter="getPopUpData();">
                        </div>
                    </div>
                </div>
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in popUpList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr><th ng-repeat="x in popUpList">{{x.Text}}</th></tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
                                pagination-id="metaData.name + 'popUpDataList'" ng-dblclick="selectDoubleClick(x)">
                                <td ng-repeat="hh in popUpList">{{x[hh.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'popUpDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getPopUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="closePopUp()" class="btn">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
<!-- #region Product Definition -->
<div class="modal fade site-modal in" id="fabricId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Product Definition<button type="button" class="close" data-dismiss="modal">&times;</button> </div>
            <div class="modal-body form-elements form-horizontal">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material Master</th>
                                <th>Base UoM</th>
                                <th>Product Master</th>
                                <th>Season</th>
                                <th>Our Style</th>
                            </tr>
                            @*<tr>
                                <th><div><input type="text" class="form-control" ng-model="searchModel.UserName" ng-enter="getData();"></div></th>
                                <th><div><input type="text" class="form-control" ng-model="searchModel.BaseUoM" ng-enter="getData();"></div></th>
                                <th><div><input type="text" class="form-control" ng-model="searchModel.ProductMasterName" ng-enter="getData();"></div></th>
                                <th><div><input type="text" class="form-control" ng-model="searchModel.SeasonName" ng-enter="getData();"></div></th>
                                <th><div><input type="text" class="form-control" ng-model="searchModel.OurStyleName" ng-enter="getData();"></div></th>
                            </tr>*@
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in buyerStyles |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                                <td>{{x.UserName}}</td>
                                <td>{{x.BaseUoM}}</td>
                                <td>{{x.ProductMasterName}}</td>
                                <td>{{x.SeasonName}}</td>
                                <td>{{x.OurStyleName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
<!-- #region Article Process -->
<div class="modal fade site-modal in" id="processEntryPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Process<button type="button" class="close" ng-click="closeEntryProcessPopUp();">&times;</button></div>
            <div class="modal-body">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="processPopUp();" class="btn">Add Process</button></li>
                    </ul>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Remove</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in sprocessList">
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="removeProcessRowModal(x, $index);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="closeEntryProcessPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="processPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeProcess();">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Process</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="processParameters.searchBy">
                                            <option ng-repeat="option in searchProcessByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="processParameters.search" ng-enter="getProcessData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getProcessData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in processList|itemsPerPage:processParameters.pageSize"
                                pagination-id="metaData.name + 'processList'" total-items="processParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="pushInTempList(x,$event,processList);">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'processList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getProcessData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="addProcess();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeProcessRow();"></confirm-archive-generic>
