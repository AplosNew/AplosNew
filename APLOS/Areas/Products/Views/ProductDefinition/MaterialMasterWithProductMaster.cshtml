<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }

    .e-grid .e-rowcell {
        line-height: 22px;
        /*font-size: 14px;*/
        padding: 0px 2px 0px 2px;
    }
</style>
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> MaterialMaster Tag With ProductMaster</h3>
<div id="payrollGroupMasterNew" class="form-horizontal" ng-form name="productmaterialForm">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);getSavedData();" href="" aria-controls="assign" role="tab" data-toggle="tab">Assign List</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);LoadUnsavedData();" href="" aria-controls="assigned" role="tab" data-toggle="tab">Unassign List</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="body-content" style="color:black">
                        <div id="Grid" ej-grid e-datasource="materialMasters"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                             e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false"></div>
                                <div e-column e-field="MaterialType" e-headertext="Material Type" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                                <div e-column e-field="MaterialGroupMaster" e-headertext="Material Group Master" e-width="80"></div>
                                <div e-column e-field="BaseUoM" e-headertext="BaseUoM" e-width="30"></div>
                                <div e-column e-field="MaterialCategory" e-headertext="Material Category" e-width="80"></div>
                                <div e-column e-field="MaterialSubCategory" e-headertext="Material SubCategory" e-width="80"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
                                <div e-column e-field="UserName" e-headertext="UserName" e-width="100"></div>
                                <div e-column e-field="ProductMaster" e-headertext="Product Master" e-width="80"></div>
                                <div e-column e-headertext=" Delete" e-commands="command" e-isunbound=true e-textalign="center" e-width="75"></div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="col-sm-12">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            @*<li style="float:left"><button ng-click="LoadUnsavedData();" class="btn"><i class="glyphicon glyphicon-search"></i> Load Data</button></li>*@
                            <li style="float:right"><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
                        </ul>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-sx-12">
                    <div class="row">
                        <div class="clearfix"></div>
                        <div class="content-container-fluid" style="color:black;">

                            <div id="Gridemployee" ng-init="chkinit()" ej-grid e-datasource="searchdata" e-templaterefresh="refreshTemplateemployee"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true" e-allowResizing="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>
                                    <div e-column e-field="MaterialType" e-headertext="Material Type" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                                    <div e-column e-field="MaterialGroupMaster" e-headertext="Material Group Master" e-width="80"></div>
                                    <div e-column e-field="BaseUoM" e-headertext="BaseUoM" e-width="30"></div>
                                    <div e-column e-field="MaterialCategory" e-headertext="Material Category" e-width="80"></div>
                                    <div e-column e-field="MaterialSubCategory" e-headertext="Material SubCategory" e-width="80"></div>
                                    <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                                    <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
                                    <div e-column e-field="UserName" e-headertext="UserName" e-width="100"></div>
                                    <div e-column e-template="#showGraph" e-headertext="Product Master" e-width="100"></div>
                                </div>
                            </div>

                        </div>
                    </div>
                    @*<script type="text/template" id="showGraph">
                        <div class="search-form">
                            <div id="control">
                                <input id="combo-default" type="text" e-fields-text="Text" e-fields-value="Value" ej-combobox e-datasource="$parent.productMasterList" e-value="data.ProductMasterId" e-width="100%" />
                            </div>

                        </div>
                    </script>*@
                    <script type="text/template" id="showGraph">
                        <div class="select-style">
                            <select class="form-control" ng-model="data.ProductMasterId" name="FGZone" ng-change="$parent.ValidationForUoM();">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in $parent.productMasterList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </script>
                    <script type="text/x-jsrender" id="checkboxTemplate">
                        <input type="checkbox" ng-model="{{:MaterialMasterId}}" class="rowCheckbox" value="{{:MaterialMasterId}}" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headchk" />
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirm_PopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>

