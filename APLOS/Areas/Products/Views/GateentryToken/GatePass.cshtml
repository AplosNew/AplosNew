                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSetReqList(1) }"><a ng-click="setTabReqList(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Created Gate Pass</a></li>
                    <li role="presentation" ng-class="{ active: isSetReqList1(2) }"><a ng-click="setTabReqList1(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Checked(Hold/Reject)</a></li>
