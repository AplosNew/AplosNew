								</div>
								<div class="col-xs-12 col-sm-2 col-md-2">
									<button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="table-responsive modal-table">
					<table class="table table-striped">
						<thead>
							<tr>
								<th>Employee Code</th>
								<th>First Name</th>
								<th>Middle Name</th>
								<th>Last Name</th>
								<th>Employee Name</th>
								<th>Date Of Birth</th>
								<th>Designation</th>
								@*<th>Entity</th>*@
								<th>Department</th>
								@*<th>Type</th>*@
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							<tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
								ng-click="selectEmployeePopUp($index, x.SystemId)" ng-class="{selected : x.SystemId == selectedEmployee}" ng-dblclick="closeDeptEmployeePopUp();" pagination-id="metaData.name + 'employeeList'">
								<td>{{x.EmployeeCode}}</td>
								<td>{{x.FirstName}}</td>
								<td>{{x.MiddleName}}</td>
								<td>{{x.LastName}}</td>
								<td>{{x.EmployeeName}}</td>
								<td>{{x.DOB | dateFiltering}}</td>
								<td>{{x.Designation}}</td>
								@*<td>{{x.EntityName}}</td>*@
								<td>{{x.Department}}</td>
								@*<td>{{x.EmploymentType}}</td>*@
								<td>{{x.EmployeeStatus}}</td>
							</tr>
						</tbody>
					</table>
				</div>
				<dir-pagination-controls max-size="10"
										 pagination-id="metaData.name + 'employeeList'"
