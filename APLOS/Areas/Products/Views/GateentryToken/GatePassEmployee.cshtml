										 boundary-links="true"
										 on-page-change="getEmployeeData(newPageNumber)">
				</dir-pagination-controls>
			</div>
			<div class="modal-footer common-btn">
				<button ng-click="closeDeptEmployeePopUp();" class="btn"><i class=""></i> Select</button>
			</div>
		</div>
	</div>
</div>
