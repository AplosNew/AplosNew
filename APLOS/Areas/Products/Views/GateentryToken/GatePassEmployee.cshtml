						<div class="form-group">
							<label class="col-sm-4 control-label">{{char2.Name}}<sup>*</sup></label>
							<div class="col-sm-8">
								<div class="input-group">
									<input type="text" ng-model="char2.FreeText" class="form-control"
										   ng-keyup="nullByFreeText('char2')" disabled ng-required="char2.IsMandatory">
									<span class="input-group-btn">
										<button ng-click="findCharValueSearchData(char2, 'char2')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
										<button ng-click="clearCharValueField('char2');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
									</span>
								</div>
								<p class="msg-error" ng-show="IsMandatoryButNull(char2.IsMandatory, char2.FreeText)">value is required.</p>
							</div>
						</div>
					</div>
					<div class="col-xs-12 col-sm-6 col-md-6" ng-show="char3.CharacteristicsId.length>0;">
						<div class="form-group">
							<label class="col-sm-4 control-label">{{char3.Name}}<sup>*</sup></label>
							<div class="col-sm-8">
								<div class="input-group">
									<input type="text" ng-model="char3.FreeText" class="form-control"
										   ng-keyup="nullByFreeText('char3')" disabled ng-required="char3.IsMandatory">
									<span class="input-group-btn">
										<button ng-click="findCharValueSearchData(char3, 'char3')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
										<button ng-click="clearCharValueField('char3');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
									</span>
								</div>
								<p class="msg-error" ng-show="IsMandatoryButNull(char3.IsMandatory, char3.FreeText)">value is required.</p>
							</div>
						</div>
					</div>
					<div class="clearfix"></div>


					<hr style="width:100%;" />
					<div class="col-xs-10 col-sm-10 col-md-10">
						<div class="form-group" id="div_qty">
							<label class="col-sm-2 control-label">Challan Qty<sup>*</sup></label>
							<div class="col-sm-4 show-message" style="padding-right:0px;">
								<input type="text" n-decimals="{{currencyPrecision}}" name="Transaction Qty" maxlength="18" ng-model="detailModel.TransactionQty" class="form-control text-right" ng-keyup="calculateTaxCategory();manualValidationAddRemove('div_qty', 'detailModel','TransactionQty');">
							</div>
							<div class="col-sm-4 show-message" style="padding-left:0px;">
								<div class="select-style">
									<select name="Transaction UoM" class="form-control" ng-model="detailModel.TransactionUoMId" ng-options="item.Value as item.Text for item in uoMList" ng-change="manualValidationAddRemove('div_uom', 'detailModel','TransactionUoMId');">
										<option value=""></option>
									</select>
								</div>
							</div>
						</div>
					</div>

					<div class="clearfix"></div>
					<div class="common-btn">
						<ul class="list-inline text-right">
							<li><button ng-click="detailSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{detailModel.Id.length>0?'Update':'Save'}}</button></li>
							<li><button ng-click="closeDetaiPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>



