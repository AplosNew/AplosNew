<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Gate Entry Register/Returnable/Non-Returnable</h3>

<div class="row">
    <div class="form-elements form-horizontal" ng-form id="from" name="from">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">For the Period</legend>
                <div>
                    <div class="form-group" show-errors id="div_FromDate">
                        <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Date" ng-model="report.FromDate" datepicker class="form-control" required tabindex="3">
                        </div>
                    </div>
                    <div class="form-group" show-errors id="div_WDToDate">
                        <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Date" ng-model="report.ToDate" datepicker class="form-control" required tabindex="4">
                        </div>
                    </div>
                </div>
                <div class="form-elements form-horizontal">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="GetGateentryRegister();" class="btn"><i class="glyphicon glyphicon-download"></i>View</button></li>
                        </ul>
                    </div>

                </div>
            </fieldset>
        </div>
    </div>
</div>



