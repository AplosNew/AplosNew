<togglable name="Issue/Task Manager"></togglable>
<!-- Md. Monir Hossain-->
<div class="form-elements form-horizontal" ng-form name="issueTransactionNewForm">
    <div class="row">
        <input type="hidden" ng-model="issueTransactionNew.Id">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">Create Issue/Task Type<sup>*</sup></label>
                    <div class="col-sm-9 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="issueTransactionNew.IssueType" ng-change="ChangeIssueStatus(issueTransactionNew.IssueType)" name="IssueType" required tabindex="1">
                                <option value="New" selected>New</option>
                                <option value="Standard">Standard</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" ng-show="issueTransactionNew.IssueType=='Standard'">
                    <label class="col-sm-4 control-label">Issue Standard<sup>*</sup></label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="issueTransactionNew.IssueStandardId" ng-change="ChangeIssueStandard(issueTransactionNew.IssueStandardId)" name="IssueStandardId" ng-options="item.Value as item.Text for item in issueStandardList" tabindex="2">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12 ">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">{{standardStatus}}</legend>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm- col-md-3 control-label">Issue/Task<sup>*</sup></label>
                        <div class="col-sm-9 col-md-9 show-message">
                            <input type="text" name="Issue" ng-model="issueTransactionNew.Issue" class="form-control" required tabindex="3" autocomplete="off" maxlength="120">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm- col-md-3 control-label">Current Status/Details <sup>*</sup></label>
                        <div class="col-sm-9 col-md-9 show-message">
                            <textarea required class="form-control" name="IssueDetail" rows="3" ng-model="issueTransactionNew.IssueDetail" maxlength="1024" tabindex="4"></textarea>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm- col-md-3 control-label">Issue/Task Category<sup>*</sup></label>
                        <div class="col-sm-9 col-md-9 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="issueTransactionNew.TaskCategoryId" name="TaskCategoryId" ng-options="item.Id as item.UserName for item in taskCategoryList" required tabindex="5">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm- col-md-3 control-label">Issue Sub Category </label>
                        <div class="col-sm-9 col-md-9 ">
                            <div class="select-style">
                                <select class="form-control" ng-model="issueTransactionNew.TaskSubCategoryId" name="TaskSubCategoryId" ng-options="item.Id as item.UserName for item in taskSubCategoryList" tabindex="6">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 col-md-3 control-label">Issue Group </label>
                        <div class="col-sm-9 col-md-9 ">
                            <div class="input-group">
                                <input type="text" name="IssueGroupName" ng-model="issueTransactionNew.IssueGroupName" class="form-control" readonly tabindex="7">
                                <span class="input-group-btn">
                                    <button ng-click="getIssueGroups();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="showIssueGroupPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-plus"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 col-md-3 control-label">
                            <a ej-tooltip e-content="The story point depends on the required time of completion of the task.">
                                Story Point
                            </a>
                        </label>
                        <div class="col-sm-9 col-md-9 ">
                            <div class="input-group">
                                <input type="text" e-minvalue="0" e-maxvalue="1000" e-watermarktext="Story Point" ej-numerictextbox e-decimalplaces="0" e-enablertl="false" e-value="issueTransactionNew.StoryPoint" e-width="100" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Is Expiry Applicable</label>
                        <div class="col-sm-1">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="issueTransactionNew.IsExpiry" tabindex="8" ng-change="setEnableDate();">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <input type="text" name="Expiry Date" ng-disabled="ExpiryDateFlag" ng-model="issueTransactionNew.ExpiryDate" datepicker class="form-control" tabindex="6">
                        </div>
                    </div>
                </div>

                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-3 col-md-3 control-label">Customer</label>
                        <div class="col-sm-9 col-md-9">
                            <div class="input-group">
                                <input type="text" name="Customer" ng-model="issueTransactionNew.Customer" autocomplete="off" tabindex="9" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showPartyPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-3 col-md-3 control-label">Issue Importance<sup>*</sup></label>
                        <div class="col-sm-9 col-md-9 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="issueTransactionNew.IssueImportanceId" name="IssueImportanceId" ng-options="item.Value as item.Text for item in issueImportanceList" required tabindex="8">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-3 col-md-3 control-label">Final Status<sup>*</sup></label>
                        <div class="col-sm-9 col-md-9 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="issueTransactionNew.FinalStatus" name="IssueStatus" required tabindex="9">
                                    <option value="ToStart">To Start</option>
                                    <option value="ToClose">To Close</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 col-md-3 control-label">Remarks </label>
                        <div class="col-sm-9 col-md-9">
                            <textarea class="form-control" rows="2" ng-model="issueTransactionNew.Remarks" maxlength="250" tabindex="10"></textarea>
                        </div>
                    </div>
                    <div id="div_IssueDate" class="form-group">
                        <label class="col-sm-3 col-md-3 control-label">Issue Creation Date</label>
                        <div class="col-sm-9 col-md-9 ">
                            <input @*ng-change="checkIssueDate()"*@ id="IssueDate" type="text" name="IssueDate" ng-model="issueTransactionNew.IssueDate" class="form-control" tabindex="11" readonly>
                        </div>
                    </div>
                    <br /><br /><br />
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Cost (If Applicable)</label>
                        <div class="col-sm-3" style="padding-right:0px;">
                            <input type="text" ej-numerictextbox e-decimalplaces="2" e-enablertl="false" e-value="issueTransactionNew.CostIfAny" e-width="100" />
                        </div>
                        <div class="col-sm-2 input-group" style="padding-left:0px;">
                            <label class="control-label">{{currency}}</label>
                        </div>
                    </div>

                </div>
            </fieldset>
        </div>

        <div class="clearfix"></div>

        <div class="col-xs-12 col-sm-12 col-md-12">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border"></legend>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-2 col-md-2 control-label">Observed By<sup>*</sup></label>
                        <div class="col-sm-10 col-md-10 show-message">
                            <input type="text" name="ObservedBy" ng-model="issueTransactionNew.ObservedBy" class="form-control" required autocomplete="off" tabindex="12" maxlength="100">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-2 col-md-2 control-label">Assign By<sup>*</sup></label>
                        <div class="col-sm-10 col-md-10 show-message">
                            <div class="input-group">
                                <input type="text" name="AssignBy" ng-model="issueTransactionNew.AssignBy" tabindex="13" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="showAuthorisePersonListPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="clearAuthorisedEmployee()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-2 col-md-2 control-label">Assign To <sup>*</sup></label>
                        <div class="col-sm-10 col-md-10 show-message">
                            <div class="input-group">
                                <input type="text" name="AssignToName" ng-model="issueTransactionNew.AssignToName" tabindex="14" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="clearEmployee()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-3 col-md-3 control-label">Mentor<sup>*</sup></label>
                        <div class="col-sm-9 col-md-9 show-message">
                            <div class="input-group ">
                                <input type="text" name="Mentor" ng-model="issueTransactionNew.Mentor" tabindex="15" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="showMentorPersonListPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="clearMentorEmployee()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div id="div_IssueRequireDate" class="form-group" show-errors>
                        <label class="col-sm-3 col-md-3 control-label">Required Date<sup>*</sup></label>
                        <div class="col-sm-9 col-md-9 show-message">
                            <input required datepicker ng-change="checkIssueRequiredDate()" id="RequiredDate" type="text" name="RequiredDate" ng-model="issueTransactionNew.RequiredDate" class="form-control" tabindex="16">
                        </div>
                    </div>
                    <div id="div_IssueCloseDate" class="form-group" show-errors>
                        <label class="col-sm-3 col-md-3 control-label">Issue/Task Closing Date</label>
                        <div class="col-sm-9 col-md-9 show-message">
                            <input datepicker ng-change="checkIssueCloseDate();" id="CloseDate" type="text" name="CloseDate" ng-model="issueTransactionNew.CloseDate" class="form-control" tabindex="17">
                        </div>
                    </div>
                </div>

            </fieldset>
        </div>
        <div class="clearfix"></div>
        <div style="padding:0px 0px 0px 15px">
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group">
                    <label>
                        <input tabindex="18" type="checkbox" class="form-check-input" id="IsUpdateApplicable" ng-model="issueTransactionNew.IsUpdateApplicable">
                        <label class="form-check-label" for="IsUpdateApplicable">Recurring/Update Applicable</label>
                    </label>
                </div>
            </div>
            <div class="clearfix"></div>
            <fieldset class="scheduler-border" ng-show="issueTransactionNew.IsUpdateApplicable" style="background-color:#F0F0F0">
                <legend class="scheduler-border"></legend>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-1 control-label">Recurring<sup></sup></label>
                        <div class="col-sm-1">
                            <div class="checkbox-site">
                                <label>
                                    <input tabindex="19" type="checkbox" ng-model="issueTransactionNew.IsUpdateRecurring" ng-change="checkUpdateFrequencyTypeAndDay()">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                        <div ng-show="!issueTransactionNew.IsUpdateRecurring">
                            <label class="col-sm-1 control-label">One Time</label>
                            <div class="col-sm-1 ">
                                <input datepicker id="UpdateOneTimeDateTime" type="text" name="UpdateOneTimeDateTime" ng-model="issueTransactionNew.UpdateOneTimeDateTime" class="form-control" tabindex="21">
                            </div>
                        </div>

                        <label class="col-sm-1 control-label">Res Person</label>

                        <div class="col-sm-2">
                            <div class="input-group">
                                <input type="text" name="UpdateResponsiblePerson" ng-model="issueTransactionNew.UpdateResponsiblePerson" tabindex="23" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showUpdateResponsiblePersonListPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div ng-show="(issueTransactionNew.UpdateAuditTaskSchedulerMasterId != null)" class="col-xs-12 col-sm-12 col-md-12">
                    <a href="" @*ng-click="checkUpdateFrequencyTypeAndDay()"*@ style="color:blue"> {{updateTaskScheduleDetails}} </a>
                </div>
            </fieldset>
        </div>
        <div class="clearfix"></div>
        <div style="padding:0px 0px 0px 15px">
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group">
                    <label>
                        <input tabindex="24" type="checkbox" class="form-check-input" id="IsInternalApplicable" ng-model="issueTransactionNew.IsInternalApplicable">
                        <label class="form-check-label" for="IsInternalApplicable">Internal Audit Applicable</label>
                    </label>

                </div>
            </div>
            <div class="clearfix"></div>
            <fieldset class="scheduler-border" ng-show="issueTransactionNew.IsInternalApplicable" style="background-color:#F0F0F0">
                <legend class="scheduler-border"></legend>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-1 control-label">Recurring</label>
                        <div class="col-sm-1 ">

                            <div class="checkbox-site">
                                <label>
                                    <input tabindex="25" type="checkbox" ng-model="issueTransactionNew.IsInternalRecurring" ng-change="checkInternalFrequencyTypeAndDay()">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                        <div ng-show="!issueTransactionNew.IsInternalRecurring">
                            <label class="col-sm-1 control-label">One Time</label>
                            <div class="col-sm-1 ">

                                <input datepicker id="InternalOneTimeDateTime" type="text" name="InternalOneTimeDateTime" ng-model="issueTransactionNew.InternalOneTimeDateTime" class="form-control" tabindex="27">
                            </div>
                        </div>
                        <label class="col-sm-1 control-label">Res Person</label>
                        <div class="col-sm-2 ">
                            <div class="input-group">
                                <input type="text" name="InternalResponsiblePerson" ng-model="issueTransactionNew.InternalResponsiblePerson" tabindex="29" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showInternalResponsiblePersonListPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div ng-show="(issueTransactionNew.InternalAuditTaskSchedulerMasterId != null)" class="col-xs-12 col-sm-12 col-md-12">
                    <a href="" ng-click="checkInternalFrequencyTypeAndDay()" style="color:blue">{{internalTaskScheduleDetails}} </a>
                </div>
            </fieldset>
        </div>

        <div class="clearfix"></div>
        <div style="padding:0px 0px 0px 15px">
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group">

                    <label>
                        <input tabindex="30" type="checkbox" class="form-check-input" id="IsFollowUpApplicable" ng-model="issueTransactionNew.IsFollowUpApplicable">
                        <label class="form-check-label" for="IsFollowUpApplicable">FollowUp Audit Applicable</label>
                    </label>
                </div>
            </div>
            <div class="clearfix"></div>
            <fieldset class="scheduler-border" ng-show="issueTransactionNew.IsFollowUpApplicable" style="background-color:#F0F0F0">
                <legend class="scheduler-border"></legend>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-1 control-label">Recurring</label>
                        <div class="col-sm-1">
                            <div class="checkbox-site">
                                <label>
                                    <input tabindex="31" type="checkbox" ng-model="issueTransactionNew.IsFollowUpRecurring" ng-change="checkFollowUpFrequencyTypeAndDay()">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>

                        <div ng-show="!issueTransactionNew.IsFollowUpRecurring">
                            <label class="col-sm-1 control-label">One Time</label>
                            <div class="col-sm-1">
                                <input datepicker id="FollowUpOneTimeDateTime" type="text" name="FollowUpOneTimeDateTime" ng-model="issueTransactionNew.FollowUpOneTimeDateTime" class="form-control" tabindex="33">
                            </div>
                        </div>
                        <label class="col-sm-1 control-label">Res Person</label>
                        <div class="col-sm-2">
                            <div class="input-group">
                                <input type="text" name="FollowUpResponsiblePerson" ng-model="issueTransactionNew.FollowUpResponsiblePerson" tabindex="35" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showFollowUpResponsiblePersonListPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>

                    </div>
                </div>

                <div ng-show="(issueTransactionNew.FollowUpAuditTaskSchedulerMasterId != null)" class="col-xs-12 col-sm-12 col-md-12">
                    <a href="" style="color:blue"> {{followUpTaskScheduleDetails}} </a>
                </div>
            </fieldset>
        </div>

        <div class="clearfix"></div>
        <div style="padding:0px 0px 0px 15px">
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group">
                    <label>
                        <input tabindex="36" type="checkbox" class="form-check-input" id="IsExternalApplicable" ng-model="issueTransactionNew.IsExternalApplicable">
                        <label class="form-check-label" for="IsExternalApplicable">External Audit Applicable</label>
                    </label>
                </div>
            </div>
            <div class="clearfix"></div>
            <fieldset class="scheduler-border" ng-show="issueTransactionNew.IsExternalApplicable" style="background-color:#F0F0F0">
                <legend class="scheduler-border"></legend>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-1 control-label">Recurring</label>
                        <div class="col-sm-1">

                            <div class="checkbox-site">
                                <label>
                                    <input tabindex="8" type="checkbox" ng-model="issueTransactionNew.IsExternalRecurring" ng-change="checkExternalFrequencyTypeAndDay()">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                        <div ng-show="!issueTransactionNew.IsExternalRecurring">
                            <label class="col-sm-1 control-label">One Time</label>
                            <div class="col-sm-1">

                                <input datepicker id="ExternalOneTimeDateTime" type="text" name="ExternalOneTimeDateTime" ng-model="issueTransactionNew.ExternalOneTimeDateTime" class="form-control" tabindex="19">
                            </div>
                        </div>
                        <label class="col-sm-1 control-label">Internal Res Person</label>
                        <div class="col-sm-2">
                            <div class="input-group">
                                <input type="text" name="ExternalResponsiblePersonName" ng-model="issueTransactionNew.ExternalResponsiblePersonName" tabindex="16" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showExternalResponsiblePersonListPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-2 control-label">External Res Person <sup>*</sup></label>
                    <div class="col-sm-2">
                        <div class="input-group">
                            <input type="text" name="ExternalResponsiblePerson" ng-model="issueTransactionNew.ExternalResponsiblePerson" class="form-control" autocomplete="off" maxlength="50">
                        </div>
                    </div>

                    <label class="col-sm-2 control-label">Email</label>
                    <div class="col-sm-2">
                        <div class="input-group">
                            <input type="text" ng-keyup="checkEmailValidity()" name="ExternalRespPersonEmail" ng-model="issueTransactionNew.ExternalRespPersonEmail" class="form-control" autocomplete="off" maxlength="100">
                            <span style="color:red" ng-show="isEmailValidate">Invalid Email</span>
                        </div>
                    </div>


                    <label class="col-sm-2 control-label"> Designation</label>
                    <div class="col-sm-2">
                        <div class="input-group">
                            <input type="text" name="ExternalRespPersonDesignation" ng-model="issueTransactionNew.ExternalRespPersonDesignation" class="form-control" autocomplete="off" maxlength="50">
                        </div>
                    </div>
                </div>
                <div ng-show="(issueTransactionNew.ExternalAuditTaskSchedulerMasterId != null)" class="col-xs-12 col-sm-12 col-md-12">
                    <a href="" style="color:blue"> {{externalTaskScheduleDetails}} </a>
                </div>
            </fieldset>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-show="Action == 'Save'" ng-click="Save()" ng-disabled="savebtndisable" class="btn" tabindex="37"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                <li> <button ng-show="Action == 'Update'" ng-click="Update()" ng-disabled="savebtndisable" class="btn" tabindex="38"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
                <li> <button ng-click="confirmRelease();" ng-disabled="issueTransactionNew.IsReleased" class="btn" tabindex="31" style="background-color:{{colorOfReleseButton}}"><i class="glyphicon glyphicon-floppy-disk"></i> Release</button></li>
                <li> <button ng-click="AddSubTaskconfirmRelease();" ng-disabled="isSubTaskDisabled" class="btn" tabindex="39"><i class="glyphicon glyphicon-floppy-disk"></i> AddSubTask</button></li>
                @*<li> <button ng-show="Action == 'Update'" ng-click="AddSubTaskWhenUpdateconfirmRelease();" ng-disabled="isSubTaskDisabled" class="btn" tabindex="31"><i class="glyphicon glyphicon-floppy-disk"></i> Add SubTask</button></li>*@
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="40"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="41"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>

