<div class="modal fade site-modal in" id="buyerPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Buyer List<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="buyerParameters.searchBy">
                                            <option ng-repeat="option in searchByBuyerList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="buyerParameters.search" ng-enter="getBuyerData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getBuyerData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Buyer Code</th>
                                <th>Short Name</th>
                                <th>User Name </th>
                                <th>Standard Name  </th>
                                
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in buyerList|itemsPerPage:buyerParameters.pageSize" total-items="buyerParameters.total_count"
                                ng-click="selectBuyerPopUp($index, x.SystemId)" ng-class="{selected : x.Id == selectedEmployee}" ng-dblclick="closeBuyerPopUp();" pagination-id="metaData.name + 'buyerList'">
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.StandardName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'buyerList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getBuyerData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeBuyerPopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>