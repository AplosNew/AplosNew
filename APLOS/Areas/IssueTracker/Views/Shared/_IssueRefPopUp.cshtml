<div class="modal fade site-modal in" id="issueUpdateAuditPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Issue Reference Details<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                            <div class="row" >
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                   <h4 style="text-align:center">Select Employee</h4>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="common-btn">
                                        <ul class="list-inline text-right">
                                            <li><button ng-click="showEmployeeListPopUp();" class="form-control btn" tabindex="1"><i class="glyphicon glyphicon-plus-sign"></i> Add Employee</button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                    </div>+

                </div>
            </div>
            <div class="modal-footer common-btn">
                <div class="table-responsive modal-table">
                    <table class="table ">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in issueRefDetailList">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                                <td>
                                <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="2"><i class="glyphicon glyphicon-trash"></i> Delete</button>
                                </td>
                                </tr>
                        </tbody>
                    </table>
                </div>
                <button ng-click="Save();" class="btn" tabindex="3"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button>
                <button ng-click="closeIssueRefDetailPopUp();" class="btn" tabindex="4"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>