<div class="modal fade site-modal in" id="issueSubTaskPopUpForUpdates" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Issue Sub Task<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="form-elements form-horizontal" ng-form>
                        <div class="col-xs-12 col-sm-12 col-sm-12 ">
                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group show-errors">
                                    <label class="col-sm-4 control-label">Task Details</label>
                                    <div class="col-sm-8">
                                        <textarea class="form-control" name="TaskDetail" rows="5" ng-model="issueSubTaskNew.TaskDetail"  maxlength="250" required tabindex="55" autofocus></textarea>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Remarks</label>
                                    <div class="col-sm-8">
                                        <textarea class="form-control" name="Remarks" rows="3" ng-model="issueSubTaskNew.Remarks" maxlength="250" tabindex="57"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                                    <div class="col-sm-8 ">
                                        @*<div class="input-group">
                                            <input type="text" name="ResponsiblePerson" ng-model="issueSubTaskNew.issueSubTaskNewResponsiblePerson" tabindex="56" class="form-control" readonly required>
                                            <span class="input-group-btn">
                                                <button ng-click="showissueSubTaskNewResponsiblePersonPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                                <button ng-click="clearissueSubTaskNewResponsiblePerson()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                            </span>
                                        </div>*@
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label" show-errors>Required Date</label>
                                    <div class="col-sm-8 show-message">
                                        <input required datepicker id="RequiredDate" type="text" name="RequiredDate" ng-model="issueSubTaskNew.RequiredDate" class="form-control" tabindex="58">
                                    </div>
                                </div>
                                @*<div class="form-group">
                                    <label>
                                        <input tabindex="5" type="checkbox" class="form-check-input" id="IsDone" ng-model="issueSubTaskNew.IsDone">
                                        <label class="form-check-label" for="IsUpdateApplicable"> IsDone</label>
                                    </label>
                                </div>*@

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="UpdateIssueSubTask();" class="btn" tabindex="6"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button>
                @*<button ng-click="hideIssueTaskPopUpForUpdate();" class="btn"><i class=""></i> Close</button>*@
            </div>
        </div>
    </div>
</div>
