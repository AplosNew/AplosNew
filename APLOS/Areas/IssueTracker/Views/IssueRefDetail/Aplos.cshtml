<togglable name="Issue RefDetail"></togglable>
<div class="form-elements form-horizontal" ng-form name="issueRefDetailNewForm">

    <input type="hidden" ng-model="issueRefDetailNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue Transaction<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="issueRefDetailNew.IssueTransactionId" name="IssueTransactionId" ng-options="item.Value as item.Text for item in issueTransactionlist" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">On Schedul<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="OnSchedul" ng-model="issueRefDetailNew.OnSchedul" class="form-control" maxlength="15" required tabindex="2">
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Attachment<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Attachment" ng-model="issueRefDetailNew.Attachment" class="form-control" required tabindex="5" maxlength="10">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" name="Remarks" rows="3" ng-model="issueRefDetailNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-group">
        <label class="col-sm-4 control-label">Select Employee<sup>*</sup></label>
        <div class="col-sm-2 input-group">
            <span class="input-group-btn">
                <button tabindex="7" ng-click="showEmployeeListPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                <button ng-click="clearEmployee()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
            </span>
        </div>
    </div>
    <div class="table-responsive modal-table ">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Employee </th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in issueRefDetailList">
                    <td>{{x.EmployeeName}}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>

</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            @*<tr>
               
            </tr>*@
        </thead>
        <tbody>
            @*<tr dir-paginate="x in issueCategorys |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Issue}}</td>
                <td>{{x.IssueDetail}}</td>
                <td>{{x.IssueRefTime}}</td>
                <td>{{x.Remarks}}</td>
                <td>{{x.OnSchedul}}</td>
            </tr>*@
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>

<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
