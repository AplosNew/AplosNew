<togglable name="Issue Standard"></togglable>
<div class="form-elements form-horizontal" ng-form name="issueStandardNewForm">
    <input type="hidden" ng-model="issueStandardNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="issueStandardNew.Code" class="form-control" autocomplete="off" required tabindex="1" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="issueStandardNew.UserName" class="form-control" autocomplete="off" required tabindex="3" maxlength="50">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Issue" ng-model="issueStandardNew.Issue" class="form-control" required tabindex="5" autocomplete="off" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Details</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="issueStandardNew.IssueDetail" maxlength="1024" tabindex="7"></textarea>
            </div>
        </div>
       
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue Importance<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="issueStandardNew.IssueImportanceId" name="IssueImportanceId" ng-options="item.Value as item.Text for item in issueImportanceList" tabindex="9" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue Status<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="issueStandardNew.IssueStatusId" name="IssueStatus" ng-options="item.Value as item.Text for item in issuestatuslist" tabindex="15" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>*@
        @*<div class="form-group" show-errors>
            <label class="col-sm-3 col-md-3 control-label">Final Status<sup>*</sup></label>
            <div class="col-sm-9 col-md-9 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="issueTransactionNew.FinalStatus" name="IssueStatus" required tabindex="9">
                        <option value="ToStart">To Start</option>
                        <option value="ToClose">To Close</option>
                    </select>
                </div>
            </div>
        </div>*@
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="issueStandardNew.TaskCategoryId" name="TaskCategoryId" ng-options="item.Id as item.UserName for item in taskCategoryList" tabindex="2" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue SubCategory<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="issueStandardNew.TaskSubCategoryId" name="TaskSubCategoryId" ng-options="item.Id as item.UserName for item in taskSubCategoryList" tabindex="4" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sort Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="SortName" ng-model="issueStandardNew.SortName" class="form-control" maxlength="15" autocomplete="off" required tabindex="6">
            </div>
        </div>


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="issueStandardNew.StandardName" class="form-control" autocomplete="off" required tabindex="8" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="issueStandardNew.Remarks" maxlength="250" tabindex="10"></textarea>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="13"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="14"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
              
                <th>Code</th>
                <th>Sort Name</th>
                <th>User Defined Name</th>
                <th>Standard Name</th>
                <th>Issue</th>
                <th>Detail</th>
                <th>Category</th>
                <th>SubCategory</th>
                <th>Status</th>
                <th>Importance</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in issueStandards |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Code}}</td>
                <td>{{x.SortName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.Issue}}</td>
                <td>{{x.IssueDetail}}</td>
                <td>{{x.TaskCategory}}</td>
                <td>{{x.TaskSubCategory}}</td>
                <td>{{x.IssueStatus}}</td>
                <td>{{x.IssueImportance}}</td>
                <td>{{x.Remarks}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="buyerSearchModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="glyphicon glyphicon-info-sign"></i> Buyer
                </h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchBy">
                                            <option ng-repeat="option in searchByBuyerList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getBuyerData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getBuyerData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Buyer</th>
                                <th>Department</th>
                                <th>Division</th>
                                <th>Product Master</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in buyerList | itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="buyerCloseListPopUp(x)">
                                <td>{{x.BuyerName}}</td>
                                <td>{{x.DepartmentName}}</td>
                                <td>{{x.DivisionName}}</td>
                                <td>{{x.ProductMasterName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getBuyerData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
            </div>
        </div>
    </div>
</div>
