<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> Issue Recap</h3>
<div class="content-container-fluid" style="color:black;">
    <div id="gridIssueGroup" ej-grid e-datasource="IssueGroups"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>

            @*<div e-column e-headertext="" e-template="#IssueGroupCheckbox" e-textalign="center" e-width="10"></div>*@

            <div e-column e-field="Id" e-headertext="Id" e-width="10"></div>
            <div e-column e-field="Name" e-headertext="Name" e-width="25"></div>
            <div e-column e-field="ResponsiblePerson" e-headertext="ResponsiblePerson" e-width="50"></div>
            <div style="float:left;" e-column e-headertext="Actions" e-width="10">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn">   <i class="fa fa-file-excel-o" ng-click="$parent.onClickExcelPrint(this);" style="margin: -6px;" title="Excel"></i></button>
                @*<button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="fa fa-file-pdf-o" ng-click="$parent.onClickPdfPrint(this);" style="margin: -6px;" title="PDF"></i></button>*@
            </div>
        </div>
    </div>
    @*<button style="display:inline-block" class="btn" title="Excel"> <i class="fa fa-file-excel-o" ng-click="onClickExcelPrint()"></i></button>
        <button class="btn" title="Excel"> <i class="fa fa-file-pdf-o" ng-click="onClickPdfPrint()"></i></button>*@

</div>


