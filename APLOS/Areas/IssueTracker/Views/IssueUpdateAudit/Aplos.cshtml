                    <th>Remarks </th>
                    <th>Attachment </th>
                    <th colspan="2">Employee </th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in issueUpdateAuditList">
                    <td>{{x.OnSchedul}}</td>
                    <td>{{x.Remarks}}</td>
                    <td>{{x.Attachment}}</td>
                    <td>
                        {{x.EmployeeName}}
                        <span class="input-group-btn">
                            <button tabindex="7" ng-click="showIssueUpdateAuditPopUp($index,x.Id);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearEmployee()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </td>

                </tr>
            </tbody>
        </table>
