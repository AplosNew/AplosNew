<togglable name=" To be Uploaded & Downloaded"></togglable>
<div class="form-elements form-horizontal row" ng-form name="ModelNewForm">
    <div class="col-md-10">
        <div class="inputBtnSection common-btn">
            <label class="fileUpload col-sm-4 ">
                <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
            </label>
            <input type="button" value="Import Data" class="btn btn-success"
                   ng-click="ImportData()" />
        </div>
    </div>
    <div class="col-md-2">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="GetSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File Download</button></li>
            </ul>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div id="GridWorkCenterProduct"
             ng-init="chkinit()"
             ej-grid e-datasource="BalanceSheetSchedulingUploadedData"
             e-allowfiltering="true"
             e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowscrolling="true"
             e-pagesettings-pagesize="25"
             e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="BudgetMasterActivityId" e-headertext="ControlId" e-width="60"></div>
                <div e-column e-field="Level1" e-headertext="Level1" e-width="100"></div>
                <div e-column e-field="Level2" e-headertext="Level2" e-width="100"></div>
                <div e-column e-field="Level3" e-headertext="Level3" e-width="100"></div>
                <div e-column e-field="Level4" e-headertext="Level4" e-width="100"></div>
                <div e-column e-field="GLGeneralInfoCode" e-headertext="GLGeneralInfoCode" e-width="60"></div>
                <div e-column e-field="GLName" e-headertext="GLName" e-width="100"></div>
                <div e-column e-field="BudgetGroup" e-headertext="BudgetGroup" e-width="60"></div>
                <div e-column e-field="BudgetCategory" e-headertext="BudgetCategory" e-width="100"></div>
                <div e-column e-field="BudgetSubCategory" e-headertext="BudgetSubCategory" e-width="100"></div>
                <div e-column e-field="Budget" e-headertext="Budget" e-width="100"></div>
                <div e-column e-field="RefNo" e-headertext="RefNo" e-width="60"></div>
                <div e-column e-field="Activity" e-headertext="Activity" e-width="100"></div>
                <div e-column e-field="Register" e-headertext="Register" e-width="100"></div>
                <div e-column e-field="BalanceSheetSchedulingId" e-headertext="BalanceSheetSchedulingId" e-width="60"></div>
                <div e-column e-field="TaxApplicable" e-headertext="TaxApplicable" e-width="60"></div>
                <div e-column e-field="TaxType" e-headertext="TaxType" e-width="100"></div>
                <div e-column e-field="UserCategory" e-headertext="UserCategory" e-width="100"></div>
                <div e-column e-field="UserSubCategory" e-headertext="UserSubCategory" e-width="100"></div>
                <div e-column e-field="UserItem" e-headertext="UserItem" e-width="100"></div>
                <div e-column e-field="UserReport" e-headertext="UserReport" e-width="60"></div>
                <div e-column e-field="IsAllowed" e-headertext="Is Allowed" e-width="60"></div>
                <div e-column e-field="AllowedDays" e-headertext="Allowed Days" e-width="60"></div>
                <div e-column e-field="MonthDay" e-headertext="Month Day" e-width="60"></div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 ">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li ng-show="ShowSaveBtn"> <button ng-click="saveBalanceSheetSchedulingUploadedData();" class="btn"><i class="glyphicon glyphicon-check"></i> Update</button></li>
            </ul>
        </div>
    </div>
</div>
