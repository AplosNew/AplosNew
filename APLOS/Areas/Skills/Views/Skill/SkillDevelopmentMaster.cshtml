<style>
    .selected {
        background-color: rgba(234, 97, 83, 0.42) !important;
        border: 1px solid black;
    }
</style>
<togglable name="Skill Development Master"></togglable>
<div class="form-elements form-horizontal">
    <input type="hidden" ng-model="skillNew.Id">
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Skill Defination</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Position" role="tab" data-toggle="tab">Position Applicable</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="Skill" role="tab" data-toggle="tab">Skill Applicable</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form="skillNewForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Training Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" ng-model="skillNew.UserTrainingName" class="form-control" required tabindex="1" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Report Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Report Name" ng-model="skillNew.ReportName" class="form-control" maxlength="15" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="ResponsiblePerson" ng-model="skillNew.ResponsiblePerson" required class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="getPopUpData()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">

                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-2">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" ng-model="skillNew.Active">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Training Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Standard Name" ng-model="skillNew.StandardTrainingName" class="form-control" required tabindex="2" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Training Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Training Name" ng-model="skillNew.TrainingName" class="form-control" required tabindex="4" maxlength="10">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="skillNew.Remarks" maxlength="250" tabindex="5"></textarea>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="positionPopUp();" ng-disabled="skillNew.Id==null" class="btn"> Add Position</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12" ng-show="positionList.length>0">
                        <div class="table-responsive">
                            <div style="color:black;" id="GridSPS" ej-grid e-datasource="positionList"
                                 e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
                                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                                <div e-columns>
                                    <div e-column e-headertext="Actions" e-template="#ShowActionBtn" e-width="3"></div>
                                    <div e-column e-field="Code" e-headertext="Code" e-width="6" e-isprimarykey="true"></div>
                                    <div e-column e-field="UserName" e-headertext="User Name" e-width="6" e-isprimarykey="true"></div>
                                    <div e-column e-field="Division" e-headertext="Division" e-width="6" e-isprimarykey="true"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="6" e-isprimarykey="true"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="6" e-isprimarykey="true"></div>
                                    <div e-column e-field="Subsection" e-headertext="Subsection" e-width="6" e-isprimarykey="true"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="6" e-isprimarykey="true"></div>
                                </div>
                            </div>
                            <script type="text/template" id="ShowActionBtn">
                                <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.RemovePosition(this);" style="margin: -6px;"></i></button>
                            </script>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row" ng-form="skillDevNewForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Skill<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Skill" ng-model="skillDevNew.SkillName" required class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="SkillPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">On Job Training Duration<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="On Job Training Duration" ng-model="skillDevNew.OnJobTrainingDuration" class="form-control" required tabindex="1" maxlength="50">
                            </div>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Training Centre Duration<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Training Centre Duration" ng-model="skillDevNew.TrainingCentreDuration" class="form-control" required tabindex="1" maxlength="50">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="skillDevNew.Remarks" maxlength="250" tabindex="5"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveSkillDev();" ng-disabled="skillNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                            <li> <button ng-click="ClearSD();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12" ng-show="selectedSkillList.length>0">
                        <div class="table-responsive modal-table">
                            <div class="content-container-fluid" style="color:black;">
                                <div style="color: black;" id="GridSD" ej-grid e-actioncomplete="syncfusiongriddatabound" e-datasource="selectedSkillList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                     e-recorddoubleclick="GetSD" e-allowselection="true" e-filtersettings-filterType="excel">
                                    <div e-columns>
                                        <div e-column e-headertext="Actions" e-template="#SkillActionBtn" e-width="30"></div>
                                        <div e-column e-type="string" e-field="Id" e-headertext="Id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                        <div e-column e-type="string" e-field="SkillName" e-headertext="SkillName" e-width="80"></div>
                                        <div e-column e-type="string" e-field="TrainingCentreDuration" e-headertext="TrainingCentreDuration" e-width="80"></div>
                                        <div e-column e-type="string" e-field="OnJobTrainingDuration" e-headertext="OnJobTrainingDuration" e-width="80"></div>
                                    </div>
                                </div>
                                <script type="text/template" id="SkillActionBtn">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.RemoveSkill(this);" style="margin: -6px;"></i></button>
                                </script>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <div class="content-container-fluid" style="color:black;">
            <div style="color: black;" id="GridMaster" ej-grid e-actioncomplete="syncfusiongriddatabound" e-datasource="skills" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-recorddoubleclick="Get" e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-type="string" e-field="Id" e-headertext="Id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                    <div e-column e-type="string" e-field="StandardTrainingName" e-headertext="StandardTrainingName" e-width="80"></div>
                    <div e-column e-type="string" e-field="UserTrainingName" e-headertext="UserTrainingName" e-width="80"></div>
                    <div e-column e-type="string" e-field="ReportName" e-headertext="ReportName" e-width="80"></div>
                    <div e-column e-type="string" e-field="TrainingName" e-headertext="TrainingName" e-width="80"></div>
                    <div e-column e-type="string" e-field="ResponsiblePerson" e-headertext="ResponsiblePerson" e-width="80"></div>
                    <div e-column e-type="string" e-field="Active" e-headertext="Active" e-width="80"></div>
                </div>
            </div>
        </div>
    </div>

</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDelPosPopUp" title="Confirmation" message={{message_DelPosconfirmation}} data-ng-click-right-button="DeletePosition();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDelSkillPopUp" title="Confirmation" message={{message_DelPosconfirmation}} data-ng-click-right-button="DeleteSkill();"></confirm-archive-generic>
<div class="modal site-modal" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closePopup('employeeNewPopUp');">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color: black;" id="Grid" ej-grid e-actioncomplete="syncfusiongriddatabound" e-datasource="employee" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-type="string" e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-type="string" e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-type="string" e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-type="string" e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="positionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Position Informations
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <div class="table-responsive ">
                        <div style="color:black;" id="GridPS" ej-grid e-datasource="positionDataList"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-templaterefresh="refreshPSTemplate"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="2"></div>
                                <div e-column e-field="Id" e-headertext="Id" e-width="4" e-isprimarykey="true"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="6" e-isprimarykey="true"></div>
                                <div e-column e-field="UserName" e-headertext="User Name" e-width="6" e-isprimarykey="true"></div>
                                <div e-column e-field="Division" e-headertext="Division" e-width="6" e-isprimarykey="true"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="6" e-isprimarykey="true"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="6" e-isprimarykey="true"></div>
                                <div e-column e-field="Subsection" e-headertext="Subsection" e-width="6" e-isprimarykey="true"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-width="6" e-isprimarykey="true"></div>
                                <div e-column e-field="DirectManpowerCost" e-headertext="Direct Manpower Cost" e-width="6" e-isprimarykey="true"></div>
                            </div>
                        </div>

                    </div>
                </div>
                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplate">
                    <input type="checkbox" id="headchk" />
                </script>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button type="button" class="btn btn-default" ng-click="closePositionPopUp();">Apply</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="SkillPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Skill Informations
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <div class="table-responsive ">
                        <div style="color:black;" id="GridSkill" ej-grid e-datasource="skillList" e-recorddoubleclick="SetSkill"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="4" e-isprimarykey="true"></div>
                                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="3" e-isprimarykey="true"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="4" e-isprimarykey="true"></div>
                                <div e-column e-field="ShortName" e-headertext="ShortName" e-width="4" e-isprimarykey="true"></div>
                                <div e-column e-field="UserName" e-headertext="User Name" e-width="6" e-isprimarykey="true"></div>
                                <div e-column e-field="StandardName" e-headertext="StandardName" e-width="6" e-isprimarykey="true"></div>
                                <div e-column e-field="SkillCategoryName" e-headertext="SkillCategoryName" e-width="6" e-isprimarykey="true"></div>
                                <div e-column e-field="SkillGroup" e-headertext="SkillGroup" e-width="6" e-isprimarykey="true"></div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button type="button" class="btn btn-default" ng-click="closeSkillPopUp();">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>