<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Access Log</h3>
<form class="form-horizontal form-elements">
    <div class="row">
        <div class="col-xs-4 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-9">
                    <input type="text" ng-model="accesslog.fromDate" datepicker class="form-control">
                </div>
            </div>
        </div>
        <div class="col-xs-4 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-9">
                    <input type="text" ng-model="accesslog.toDate" datepicker class="form-control">
                </div>
            </div>
        </div>
        <div class="col-xs-4 col-sm-4 col-md-4">
            <button type="button" ng-click="getData()" class="btn single-btn"><i class="glyphicon glyphicon-search"></i> Search</button>
            <button type="button" ng-click="Delete(accesslog.fromDate, accesslog.toDate)" class="btn single-btn"><i class="glyphicon glyphicon-trash"></i> Delete</button>
        </div>
    </div>
</form>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Username</th>
                <th>Access Time</th>
                <th>Work Station</th>
                <th>IP</th>
                <th>OS</th>
                <th>Browser</th>
                <th>Panel</th>
                <th>Status</th>
                <th>Registered</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in filtered = (accesslogs | orderBy:'UserId') |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                <td>{{x.UserId}}</td>
                <td>{{x.AccessTimeWithCountry}}</td>
                <td>{{x.WorkStationName}}</td>
                <td>{{x.WorkStationIP}}</td>
                <td>{{x.OS}}</td>
                <td>{{x.Browser}}</td>
                <td>{{x.Panel}}</td>
                <td>{{x.Status ? 'Success' : 'Fail'}}</td>
                <td>{{x.IsResister ? 'Authorize' : 'Unauthorize'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
    <confirm-modal></confirm-modal>
</div>