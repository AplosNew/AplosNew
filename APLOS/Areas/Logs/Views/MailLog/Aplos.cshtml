<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Mail Log</h3>
<form class="form-horizontal form-elements">
    <div class="row">
        <div class="col-xs-4 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-3 control-label">From Date<sup></sup></label>
                <div class="col-sm-9">
                    <input type="text" ng-model="mailLog.fromDate" datepicker class="form-control datepicker">
                </div>
            </div>
        </div>
        <div class="col-xs-4 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-3 control-label">To Date<sup></sup></label>
                <div class="col-sm-9">
                    <input type="text" ng-model="mailLog.toDate" datepicker class="form-control datepicker">
                </div>
            </div>
        </div>
        <div class="col-xs-4 col-sm-4 col-md-4">
            <button type="button" ng-click="getMailLogList(mailLog.fromDate,mailLog.toDate)" class="btn single-btn"><i class="glyphicon glyphicon-search"></i> Search </button>

        </div>
    </div>
</form>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Company Group</th>
                <th>Mail Receiver Name</th>
                <th>MailGenerator</th>
                <th>Sender Name</th>
                <th>Sender Email</th>
                <th>Subject</th>
                <th>Service Name</th>
                <th>Attachment Name</th>
                <th>Record Time</th>
                <th>Is Success</th>
                <th>Is Service Active</th>
                <th>Is ReciepientList Active</th>
                <th>Has Attachment</th>
                <th>Inactive Users</th>
                <th>Missing EMails</th>
                <th>To Address Problem</th>
                <th>To List</th>
                <th>Cc List</th>
                <th>Bcc List</th>
                <th>Remarks</th>

            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in mailLogList |itemsPerPage:mailLogListParameters.pageSize" total-items="mailLogListParameters.total_count" ng-class="{'selected':$index == selectedRow}" ng-click="setClickedRow($index)">
                <td>{{x.CompanyGroup}}</td>
                <td>{{x.MailReceiverName}}</td>
                <td>{{x.MailGenerator}}</td>
                <td>{{x.SenderName}}</td>
                <td>{{x.SenderEmail}}</td>
                <td>{{x.Subject}}</td>
                <td>{{x.ServiceName}}</td>
                <td>{{x.AttachmentName}}</td>
                <td>{{x.RecordTime}}</td>
                <td>{{x.IsSuccess}}</td>
                <td>{{x.IsServiceActive}}</td>
                <td>{{x.IsServiceActive}}</td>
                <td>{{x.HasAttachment}}</td>
                <td>{{x.InactiveUsers}}</td>
                <td>{{x.MissingEMails}}</td>
                <td>{{x.ToAddressProblem}}</td>
                <td>{{x.ToList}}</td>
                <td>{{x.CcList}}</td>
                <td>{{x.BccList}}</td>
                <td>{{x.Remarks}}</td>
            </tr>
        </tbody>
    </table>

</div>
<dir-pagination-controls max-size="10"
                         direction-links="true"
                         boundary-links="true"
                         on-page-change="getMailLogListpagin(newPageNumber)">
</dir-pagination-controls>
