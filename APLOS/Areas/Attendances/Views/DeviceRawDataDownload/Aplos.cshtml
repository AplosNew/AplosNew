<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Raw Data Download
</h3>
<div class="form-elements form-horizontal" ng-form name="RawDataDownloadForm">
    <div class="row">
        <div class="clearfix"></div>

        <div class="col-xs-12">

            <div class="col-xs-12 col-sm-6 col-md-6 ">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Work Date</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="From Date" ng-change="changefilename()" placeholder="dd-MM-yyyy" ng-model="rawdatadownload.WorkDate" datepicker class="form-control datepicker" tabindex="1">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6 ">
                <label class="col-sm-6 control-label">File Name</label>
                <div class="col-sm-6">
                    <input type="text" ng-model="someText" required="required" ng-disabled="rawdatadownload.TextOrExcel=='excel'" placeholder="Initial Text" class="form-control" maxlength="30" tabindex="2">
                </div>
                <div class="col-xs-12">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="Download();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>

     </div>
    </div>
