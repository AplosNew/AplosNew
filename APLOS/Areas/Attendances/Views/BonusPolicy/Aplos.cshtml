<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">Bonus Policy</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Bonus Policy (Plant Wise)</a></li>
        </ul>
    </div>
    <div class="tab-content" id="tabpaneldiv">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet11(11), active: isSet11(11) }">
            <togglable name="Add New Policy"></togglable>
            <div class="form-elements form-horizontal" id="MainDivId">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label" style="padding-left: 110px;">Policy Name</label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="BonusPolicy.PolicyName" class="form-control" maxlength="100" tabindex="2">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label" style="padding-left: 110px;">Entitle From<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select id="EntitleFromId" class="form-control" ng-model="BonusPolicy.EntitleFrm" name="EntitleFromId" required tabindex="1">
                                    <option value="">--Select--</option>
                                    <option Value="DOJ">DOJ</option>
                                    <option Value="DOC">DOC</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label" >Description</label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="BonusPolicy.BonusDescription" class="form-control" maxlength="100" tabindex="2">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label" >Service Length Type</label>
                        <div class="col-sm-8 ">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="Month" ng-model="BonusPolicy.ServiceLengthType" value="Month">
                                    <span class="cr"><i class="cr-icon"></i></span>Month
                                </label>
                                <label>
                                    <input type="radio" name="Day" ng-model="BonusPolicy.ServiceLengthType" value="Day">
                                    <span class="cr"><i class="cr-icon"></i></span>Day
                                </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveMaster();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="ClearM();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>


                <fieldset class="scheduler-border" ng-show="BonusPolicy.MID">
                    <legend class="scheduler-border">Policy Details</legend>
                    <div class="row">
                        <div class="col-sm-12 table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Service Length ({{BonusPolicy.ServiceLengthType}}) Minimum</th>
                                        <th>Service Length ({{BonusPolicy.ServiceLengthType}}) Maximum </th>
                                        <th>Bonus Type</th>
                                        <th>{{item.DisbursementType}}</th>
                                        <th>Add</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in DataList">
                                        <th>{{$index>0?'Above':''}}</th>
                                        <td><input type="number" min="0" ng-model="item.MinServLen" class="form-control" ng-disabled="DataList.length>1" /></td>
                                        <td><input type="number" min="0" ng-model="item.MaxServLen" class="form-control" ng-disabled="$index<DataList.length-1" /></td>
                                        <td>
                                            <label>
                                                <input type="radio" name="{{'saad'+item.MinServLen}}" ng-model="item.DisbursementType" value="Fixed">
                                                <span class="cr"><i class="cr-icon"></i></span>Fixed
                                            </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                            <label>
                                                <input type="radio" name="{{'saad'+item.MinServLen}}" ng-model="item.DisbursementType" value="Percentage">
                                                <span class="cr"><i class="cr-icon"></i></span>Percentage
                                            </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                            <label>
                                                <input type="radio" name="{{'saad'+item.MinServLen}}" ng-model="item.DisbursementType" value="Proportionate">
                                                <span class="cr"><i class="cr-icon"></i></span>Proportionate
                                            </label>
                                        </td>
                                        <td>
                                            <div class="form-group" ng-show="item.DisbursementType=='Fixed'">
                                                <label class="col-sm-4 control-label">Fixed Amount</label>
                                                <div class="col-sm-8">
                                                    <input type="text" ng-model="item.FixedAmount" only-numbers class="form-control" maxlength="100" tabindex="2">
                                                </div>
                                            </div>
                                            <div class="form-group" ng-show="item.DisbursementType != 'Fixed'">
                                                <label class="col-sm-4 control-label">Salary Head<sup>*</sup></label>
                                                <div class="col-sm-8 show-message" style=" margin-top: 3px;">
                                                    <div class="select-style">
                                                        <select id="SalaryHeadId" class="form-control" ng-model="item.PerctSalaryHeadID" name="SalaryHead" required tabindex="1">
                                                            <option value="">--Select--</option>
                                                            <option ng-repeat="option in SalaryHeadList" value="{{option.Id}}">{{option.UserName}}</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group" ng-show="item.DisbursementType=='Proportionate'">
                                                <label class="col-sm-4 control-label">Division Factor</label>
                                                <div class="col-sm-8">
                                                    <input type="text" ng-model="item.DivisionFactor" only-numbers class="form-control" maxlength="100" tabindex="2">
                                                </div>
                                            </div>
                                            <div class="form-group" ng-show="item.DisbursementType !='Fixed'">
                                                <label class="col-sm-4 control-label">Minimum Bonus Amount	</label>
                                                <div class="col-sm-8">
                                                    <input type="text" ng-model="item.MinBonusAmt" only-numbers class="form-control" maxlength="100" tabindex="2">
                                                </div>
                                            </div>
                                            <div class="form-group" ng-show="item.DisbursementType !='Fixed'">
                                                <label class="col-sm-4 control-label">Percentage Value</label>
                                                <div class="col-sm-8">
                                                    <input type="text" ng-model="item.BonusPercentage" only-numbers class="form-control" maxlength="100" tabindex="2">
                                                </div>
                                            </div>

                                        </td>

                                        <td class="text-right" ng-hide="$index<DataList.length-1">
                                            <ul class="list-inline">
                                                <li><button ng-click="SubmitH(item);Clear();" class="btn btn-action "><i class="glyphicon glyphicon-plus"></i></button></li>
                                                <li><button ng-hide="DataList.length<2" ng-click="Remove($index);Clear();" class="btn btn-action "><i class="glyphicon glyphicon-minus"></i></button></li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                        </ul>
                    </div>
                </fieldset>
                <confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteMaster();"></confirm-archive-generic>
            </div>
            <div class="table-responsive aplos-grid-toggle">
                <div class="col-xs-12 col-sm-12 col-sm-12" style="padding-left: 0px; padding-right:0px;">
                    <div style="color:black;" id="BonusPolicyMasterId" ej-grid e-datasource="ModelList"
                         e-allowfiltering="true" e-pageSettings-pageSize="15" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                         e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="PolicyName" e-headertext="PolicyName" e-width="60"></div>
                            <div e-column e-field="BonusDescription" e-headertext="BonusDescription" e-width="60"></div>
                            <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="10"></div>
                        </div>
                    </div>
                </div>
                <script type="text/ng-template" id="ShowActionButtons">
                    <div class="common-btn">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Consumption" class="btn"><i class="glyphicon glyphicon-list" ng-click="$parent.AddItem(this);" ></i></button>
                    </div>
                </script>
            </div>

        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet22(22), active: isSet22(22) }">
            <div class="form-horizontal" ng-form id="OTSlapFormId" name="OTSlapForm">
                <div class="row">
                    <div class="aplos-grid-toggle">
                        <div class="col-xs-12 col-sm-12 col-sm-12" style="padding-left: 0px; padding-right:0px;">
                            <div style="color:black;" id="PlantId" ej-grid e-datasource="PlantList"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionComplete"
                                 e-allowscrolling="true" e-showstackedheader="true" e-allowExcelExport='true' e-enableGroupingBar="true">
                                <div e-columns>
                                    <div e-column e-field="CompanyName" e-headertext="Company Name " e-width="60"></div>
                                    <div e-column e-field="PlantName" e-headertext="Plant Name" e-width="60"></div>                                    
                                    <div e-column e-headertext="Actions" e-template="#ShowActionButtonsBOM" e-width="30"></div>
                                </div>
                                <script type="text/ng-template" id="ShowActionButtonsBOM">
                                    <div class="common-btn">
                                        <button style="color: #f3f3ec;background-color: #1c1f32;" ng-disabled="data.IsConsumptionDetail==false" title="Consumption" class="btn"><i class="glyphicon glyphicon-list" ng-click="$parent.AddLineItem(this);" @*style="margin: -6px;"*@></i></button>
                                    </div>
                                </script>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>


<ej-dialog id="PpolicyID"
           title="Plant Tag With Policy"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#tab_show"
           e-close="onDialogClose"
           e-width="800"
           e-minheight="400" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="col-xs-12 form-element-ctrl form-horizontal" ng-show="ShowDiv">
                <div class="col-xs-12">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Select Bonus Policy</legend>
                        <div class="form-group" style="margin-right: 0px; margin-left: 0px;">
                            <div id="GridOperation" ej-grid e-datasource="PlantWiseBPolicyListt" e-templaterefresh=""
                                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                                <div e-columns>
                                    <div e-column e-headertext="Select" e-headertemplateid="#headerTemplate" e-template="#checkbox" e-textalign="center" e-width="3"></div>
                                    <div e-column e-field="PlantName" e-headertext="Plant Name" e-width="5"></div>
                                    <div e-column e-field="CompanyName" e-headertext="Company Name" e-width="5"></div>
                                </div>
                            </div>
                            <script type="text/template" id="checkbox">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelectPolicy" />
                            </script>
                        </div>
                    </fieldset>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveBPlant();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</ej-dialog>


<ej-dialog id="policyID"
           title="Plant Wise Policy"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#OTSlapFormId"
           e-close="onDialogClose"
           e-width="800"
           e-minheight="400" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="col-xs-12 form-element-ctrl form-horizontal" ng-show="ShowDiv">
                <div class="col-xs-12">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Select Bonus Policy</legend>
                        <div class="form-group" style="margin-right: 0px; margin-left: 0px;">
                            <div id="GridOperation" ej-grid e-datasource="PlantWiseBPolicyList" e-templaterefresh=""
                                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                                <div e-columns>
                                    <div e-column e-headertext="Select" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="3"></div>
                                    <div e-column e-field="PolicyID" e-headertext="Leave ID" e-headertext-color="black" e-textalign="left" e-width="2" e-visible="false"></div>
                                    <div e-column e-field="PolicyName" e-headertext="Policy Name" e-width="5"></div>
                                </div>
                            </div>
                            <script type="text/template" id="checkboxTemplate">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelectPolicy" />
                            </script>
                        </div>
                    </fieldset>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveBP();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</ej-dialog>

<ej-dialog id="dialogAPI" title="Confirm Delete?" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#dialogEmployeeInfo" e-close="onDialogClose" e-minwidth="240" e-minheight="165" e-open="enableBtn">
    <p>
        Are you sure to delete ?
    </p>
    <p class="text-right">
        <ul class="list-inline text-right">
            <li><button ng-click="DeleteDetailsFunction();ConfirmClose()" class="btn"><i class="glyphicon glyphicon-floppy-remove"></i> Yes</button></li>
            <li><button ng-click="ConfirmClose();" class="btn"><i class="glyphicon glyphicon-step-backward"></i> No</button></li>
        </ul>
    </p>
</ej-dialog>