<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="row">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Entity</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">BudgetCode</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Authority</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">CheckBy</a></li>
                @*<li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" data-toggle="tab">Document Location</a></li>*@
            </ul>
        </div>

        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-sm-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="showProcessPopUp();" ng-disabled="sopDocumentNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridSelectedProcess" ej-grid e-datasource="SelectedProcessList"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="80"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="80"></div>
                                <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="140"></div>
                                @*delete*@
                                <div e-column e-template="#DeleteDocumentProcess" e-width="40"></div>
                            </div>
                        </div>

                        <script type="text/template" id="DeleteDocumentProcess">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="$parent.ConfirmDeleteProcess(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                </ul>
                            </div>
                        </script>

                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    @*Department body*@

                    <div class="col-sm-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="showDepartmentPopUp();" ng-disabled="sopDocumentNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridSelectedDepartment" ej-grid e-datasource="SelectedDepartmentList"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="80"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="80"></div>
                                <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="140"></div>
                                @*delete*@
                                <div e-column e-template="#DeleteDocumentDepartment" e-width="40"></div>
                            </div>
                        </div>

                        <script type="text/template" id="DeleteDocumentDepartment">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="$parent.ConfirmDeleteDepartment(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                </ul>
                            </div>
                        </script>

                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    @*DocumentSource body*@
                    <div class="col-sm-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="showDocumentSourcePopUp();" ng-disabled="sopDocumentNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridSelectedDocumentSource" ej-grid e-datasource="SelectedDocumentSourceList"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="80"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="80"></div>
                                <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="140"></div>
                                @*delete*@
                                <div e-column e-template="#DeleteDocumentDocumentSource" e-width="40"></div>
                            </div>
                        </div>

                        <script type="text/template" id="DeleteDocumentDocumentSource">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="$parent.ConfirmDeleteDocumentSource(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                </ul>
                            </div>
                        </script>

                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row">
                    @*DocumentPreparedBy body*@
                    <div class="col-sm-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="showDocumentPreparedByPopUp();" ng-disabled="sopDocumentNew.Id==null" class="btn"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>
                            </ul>
                        </div>
                        <div>
                            <input type="radio" ng-model="EntryType" value="Employee">
                            <span>Employee</span>
                            <input type="radio" ng-model="EntryType" value="Position">
                            <span>Position</span>

                        </div>
                    </div>

                    <div class="col-xs-12">
                        <div style="color:black;" id="GridSelectedDocumentPreparedBy" ej-grid e-datasource="SelectedDocumentPreparedByList"
                             e-gridlines="vertical" e-allowfiltering="true" e-rowdatabound="preparedByrowcolor" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="EntryTypeName" e-headertext="Entry Type" e-width="80"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                                <div e-column e-type="string" e-field="EmployeeName" e-headertext="EmployeeName" e-width="140"></div>
                                <div e-column e-type="string" e-field="PositionName" e-headertext="Position" e-width="80"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="80"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                                @*delete*@
                                <div e-column e-template="#DeleteDocumentDocumentPreparedBy" e-width="40"></div>
                            </div>
                        </div>

                        <script type="text/template" id="DeleteDocumentDocumentPreparedBy">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="$parent.ConfirmDeleteDocumentPreparedBy(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                </ul>
                            </div>
                        </script>

                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="row">

                    @*Location body*@
                    <div class="col-sm-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="showLocationPopUp();" ng-disabled="sopDocumentNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridSelectedLocation" ej-grid e-datasource="SelectedLocationList"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="80"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="80"></div>
                                <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="140"></div>
                                @*delete*@
                                <div e-column e-template="#DeleteDocumentLocation" e-width="40"></div>
                            </div>
                        </div>

                        <script type="text/template" id="DeleteDocumentLocation">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="$parent.ConfirmDeleteLocation(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                </ul>
                            </div>
                        </script>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            @*<div e-column e-field="AddedDate" e-format="{0:dd-MMM-yyyy}"  e-type="date" e-headertext="Date Added" e-width="2"></div>*@
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <disv class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="SystemId" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </disv>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closePopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>

<confirm-modal></confirm-modal>