<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Defined Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
            <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                <input type="hidden" name="ByWhom" ng-model="ModelNew.ResponsiblePersonId" class="form-control">
                <span class="input-group-addon">{{ModelNew.ResponsiblePersonCode}}</span>
                <input type="text" name="ByWhom" ng-model="ModelNew.ResponsiblePerson" class="form-control" readonly>
                <span class="input-group-btn">
                    <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="13"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="clearEmp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                </span>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="UserCode" ng-model="ModelNew.UserCode" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="row">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Entity</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">BudgetCode</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Check By</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Approved By</a></li>
            </ul>
        </div>

        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-sm-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="entityPopUp();" ng-disabled="ModelNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridSelectedEntity" ej-grid e-datasource="selectedEntityList"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-headertext="Remove" e-headertemplateid="" e-template="#DeleteEntity" e-textalign="center" e-width="50"></div>
                                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="80" e-visible="false"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="80"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="Plant" e-headertext="Plant" e-width="80"></div>
                                <div e-column e-type="string" e-field="Division" e-headertext="Division" e-width="140"></div>
                                <div e-column e-type="string" e-field="SubDivision" e-headertext="SubDivision" e-width="140"></div>
                                <div e-column e-type="string" e-field="Unit" e-headertext="Unit" e-width="140"></div>
                                <div e-column e-type="string" e-field="EffectiveDate" e-headertext="EffectiveDate" e-width="140"></div>
                            </div>
                        </div>
                        <script type="text/template" id="DeleteEntity">
                            <div class="common-btn">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="$parent.removeEntity(this);" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-trash" tabindex="119"></i></button>
                                    </li>
                                </ul>
                            </div>
                        </script>
                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-sm-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="popUpBudgetCode();" ng-disabled="ModelNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridBC" ej-grid e-datasource="BudgetCodeList" e-templaterefresh="refreshTemplateRemove"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateRemove" e-template="#checkRemove" e-textalign="center" e-width="30"></div>

                                <div e-column e-headertext="Remove" e-headertemplateid="#headerTemplate" e-template="#DeleteBudgetCode" e-textalign="center" e-width="60"></div>
                                <div e-column e-type="string" e-field="EntityName" e-headertext="Entity" e-width="80"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Budget Code" e-width="100"></div>
                                <div e-column e-type="string" e-field="Division" e-headertext="Division" e-width="80"></div>
                                <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="80"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="140"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-width="140"></div>
                                <div e-column e-type="string" e-field="EmployeeType" e-headertext="Employee Type" e-width="140"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="140"></div>
                                <div e-column e-type="string" e-field="Activity" e-headertext="Activity" e-width="140"></div>
                                <div e-column e-type="string" e-field="UserGroup" e-headertext="User Group" e-width="140"></div>
                                <div e-column e-type="string" e-field="Process" e-headertext="Process" e-width="140"></div>
                                <div e-column e-type="string" e-field="IsOTEntitled" e-headertext="OT Applicable" e-width="140"></div>
                                <div e-column e-headertext="Good Work Applicable" e-headertemplateid="#headerTemplate" e-template="#GWcheckboxTemplate" e-textalign="center" e-width="130"></div>
                                <div e-column e-headertext="Compensatory Applicable" e-headertemplateid="#headerTemplate" e-template="#CAcheckboxTemplate" e-textalign="center" e-width="130"></div>
                                <div e-column e-headertext="Employee Applicable" e-headertemplateid="#headerTemplate" e-template="#EAcheckboxTemplate" e-textalign="center" e-width="130"></div>
                                <div e-column e-headertext="Good Work Category" e-headertemplateid="#headerTemplate" e-template="#GWCcheckboxTemplate" e-textalign="center" e-width="130"></div>
                                <div e-column e-headertext="Remark" e-headertemplateid="#headerTemplate" e-template="#REcheckboxTemplate" e-textalign="center" e-width="130"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkRemove">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplateRemove">
                            <input type="checkbox" id="headchkRemove" />
                        </script>

                        <script type="text/template" id="OTcheckboxTemplate">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="OTApplicable">
                                    <span class="cr" tabindex="1008"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </script>
                        <script type="text/template" id="GWcheckboxTemplate">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="data.IsGoodWorkApplicable">
                                    <span class="cr" tabindex="1008"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </script>
                        <script type="text/template" id="CAcheckboxTemplate">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="data.IsCompensatoryApplicable">
                                    <span class="cr" tabindex="1008"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </script>
                        <script type="text/template" id="EAcheckboxTemplate">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="data.IsEmployeeApplicable ">
                                    <span class="cr" tabindex="1008"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </script>

                        <script type="text/template" id="GWCcheckboxTemplate">
                            <div class="select-style">
                                <select id="ECID" class="form-control" ng-model="data.GoodWorkCategory" name="GoodWorkCategory" required tabindex="1">
                                    <option value="A">A</option>
                                    <option value="B">B</option>
                                    <option value="C">C</option>
                                </select>
                            </div>
                        </script>
                        <script type="text/template" id="REcheckboxTemplate">
                            <input type="text" name="Remarks" ng-model="data.Remarks" class="form-control" tabindex="6" maxlength="50">
                        </script>
                        <script type="text/template" id="DeleteBudgetCode">
                            <div class="common-btn">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="$parent.removeBudgetCode(this);" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-trash" tabindex="119"></i></button>
                                    </li>
                                </ul>
                            </div>
                        </script>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="BCSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{BCAction}}</button></li>
                            <li>
                                <button ng-click="removeBudgetCode();" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-trash" tabindex="119"></i></button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="popUpEmployee('Authority');" ng-disabled="ModelNew.Id==null" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                            </ul>
                        </div>
                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="GridCheck" ej-grid e-datasource="authorizationList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-rowdatabound="onrowdatabound" e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="Remove" e-headertemplateid="" e-template="#DeleteAuthority" e-textalign="center" e-width="40"></div>
                                    <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                                    <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="40" e-visible="false"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="40"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                    <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                                    <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                    <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                                </div>
                            </div>
                            <script type="text/template" id="DeleteAuthority">
                                <div class="common-btn">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="$parent.removeAuthority(this);" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-trash" tabindex="119"></i></button>
                                        </li>
                                    </ul>
                                </div>
                            </script>
                        </div>
                    </div>
                </div>

            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="popUpEmployee('CheckBy');" ng-disabled="ModelNew.Id==null" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                            </ul>
                        </div>
                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="Grid" ej-grid e-datasource="CheckByList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-rowdatabound="onrowdatabound" e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="Remove" e-headertemplateid="" e-template="#DeleteCheckBy" e-textalign="center" e-width="40"></div>
                                    <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                                    <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="40" e-visible="false"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="40"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                    <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                                    <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                    <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                                </div>
                            </div>
                        </div>
                        <script type="text/template" id="DeleteCheckBy">
                            <div class="common-btn">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="$parent.removeCheckBy(this);" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-trash" tabindex="119"></i></button>
                                    </li>
                                </ul>
                            </div>
                        </script>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="UserCode" e-headertext="User Code" e-width="3"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <disv class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpEmpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="SystemId" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </disv>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closeEmpPopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>

<div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Entity Informations</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="entityParameters.searchBy">
                                            <option ng-repeat="option in entitySearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="entityParameters.search" ng-enter="getEntityData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEntityData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" ng-show="entityDataList.length">
                        <thead>
                            <tr>
                                @*<th ng-repeat="x in entitySearchList">{{x.Text}}</th>*@
                                <th>Select</th>
                                <th>Code</th>
                                <th>User Name</th>
                                <th>Plant</th>
                                <th>Division</th>
                                <th>Sub Division</th>
                                <th>Unit</th>
                                <th>Effective Date</th>
                                <th>Is Production Entity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in entityDataList|itemsPerPage:entityParameters.pageSize" total-items="entityParameters.total_count" pagination-id="metaData.name + 'entityDataList'">
                                @*<td ng-repeat="y in entitySearchList">{{x[y.Value]}}</td>*@
                                <td class="text-right table-td">
                                    <div class="checkbox-site">
                                        <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" @*ng-click="selectChValueId($event,x)"*@>
                                    </div>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.Plant}}</td>
                                <td>{{x.Division}}</td>
                                <td>{{x.SubDivision}}</td>
                                <td>{{x.Unit}}</td>
                                <td>{{x.EffectiveDate | dateFiltering}}</td>
                                <td>{{x.IsProductionEntity?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'entityDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEntityData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <ul class="list-inline text-right">
                    <li><button type="button" class="btn btn-default" ng-click="closeEntityPopUp();">Close</button></li>
                    <li><button ng-click="selectEntityPopUp();" class="btn">Select</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

