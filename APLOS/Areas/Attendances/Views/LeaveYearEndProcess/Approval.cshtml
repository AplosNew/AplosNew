<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Leave Encanshment Approve/Unapprove(Year End)</h3>
<div class="col-xs-12 col-sm-6 col-md-6">
    <div class="form-group">
        <label class="col-sm-4 control-label">Date <sup>*</sup></label>
        <div class="col-sm-8 show-message">
            <input type="text" name="FromDateParameter" ng-model="Date" datepicker class="form-control" placeholder="dd-MM-yyyy" @*ng-change="DrawWorkcenterWisePlan();"*@>

        </div>
    </div>
</div>
<div class="col-xs-12 col-sm-6 col-md-6">
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li style=" margin:2px"> <button ng-click="GetEncashmentForEdit();" class="btn"><i class="glyphicon glyphicon-check"></i> Load</button></li>
        </ul>
    </div>
</div>
<div class="tab-design">

    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);" href="" aria-controls="general" role="tab" data-toggle="tab">To Approve</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="general" role="tab" data-toggle="tab">Already Approved </a></li>
        </ul>
    </div>

    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12" ng-show="EncashedPendingData.length>0">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li style=" margin:2px"> <button ng-click="ApproveYearlyEncashent();" class="btn"><i class="glyphicon glyphicon-check"></i> Approve</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-sm-12">

                    <div style="color:black;"
                         id="GridEncashedPendingData"
                         ej-grid e-datasource="EncashedPendingData" e-actioncomplete="actionCompleteSelected" e-pagesettings-pagesize="20"
                         e-templaterefresh="PendingCheckboxAll" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true"
                         e-allowscrolling="true"
                         e-allowsorting="true" e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplatePending" e-template="#checkboxTemplatePending" e-textalign="center" e-width="20"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Name" e-width="120"></div>
                            <div e-column e-field="DOB" e-headertext="DOB" e-width="70"></div>
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-width="70"></div>
                            <div e-column e-field="DOS" e-headertext="DOS" e-width="70"></div>

                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="120"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="120"></div>
                            <div e-column e-field="YearEndEncashOriginal" e-headertext="Max. Encash" e-width="100"></div>
                            <div e-column e-template="#EncashedDaysTemplate" e-headertext="Encash" e-width="100"></div>
                            <div e-column e-field="Rate" e-headertext="Rate" e-width="70"></div>
                            <div e-column e-field="BasicAmmount" e-headertext="Basic" e-width="70"></div>
                            <div e-column e-field="GrossAmmount" e-headertext="Gross" e-width="70"></div>
                            <div e-column e-field="PaymentMode" e-headertext="PaymentMode" e-width="70"></div>
                            <div e-column e-field="YearEndLapse" e-headertext="Lapse" e-width="70"></div>
                            <div e-column e-field="AvailedLeave" e-headertext="AvailedLeave" e-width="70"></div>

                        </div>

                    </div>
                    <script type="text/x-jsrender" id="headerTemplatePending">
                        <input type="checkbox" id="headchkPending" />
                    </script>
                    <script type="text/template" id="checkboxTemplatePending">
                        <input type="checkbox" ng-model="data.Checked">
                    </script>
                    <script type="text/template" id="EncashedDaysTemplate">
                        <input type="text" e-enabled="{{data.Isdisburse==true?'false':'true'}}" ej-numerictextbox e-decimalplaces="2" e-value="data.YearEndEncash" e-width="90" />
                    </script>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12" ng-show="EncashedPendingData.length>0">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li style=" margin:2px"> <button ng-click="ApproveYearlyEncashent();" class="btn"><i class="glyphicon glyphicon-check"></i> Approve</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12" ng-show="EncashedSavedData.length>0">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li style=" margin:2px"> <button ng-click="UnApproveYearlyEncashent();" class="btn"><i class="glyphicon glyphicon-check"></i> Un-Approve/Rollback</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-sm-12">

                    <div style="color:black;"
                         id="GridEncashedSavedData"
                         ej-grid e-datasource="EncashedSavedData" e-actioncomplete="actionCompleteSelected" e-pagesettings-pagesize="20"
                         e-templaterefresh="SavedCheckboxAll" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true"
                         e-allowscrolling="true"
                         e-allowsorting="true" e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplateSaved" e-template="#checkboxTemplateSaved" e-textalign="center" e-width="20"></div>

                            <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Name" e-width="120"></div>
                            <div e-column e-field="DOB" e-headertext="DOB" e-width="70"></div>
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-width="70"></div>
                            <div e-column e-field="DOS" e-headertext="DOS" e-width="70"></div>

                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="120"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="120"></div>
                            <div e-column e-field="Days" e-headertext="Days" e-width="80"></div>
                            <div e-column e-field="Rate" e-headertext="Rate" e-width="70"></div>
                            <div e-column e-field="BasicAmmount" e-headertext="Basic" e-width="70"></div>
                            <div e-column e-field="GrossAmmount" e-headertext="Gross" e-width="70"></div>
                            <div e-column e-field="PaymentMode" e-headertext="PaymentMode" e-width="70"></div>
                            <div e-column e-field="YearEndLapse" e-headertext="Lapse" e-width="70"></div>
                            <div e-column e-field="AvailedLeave" e-headertext="AvailedLeave" e-width="70"></div>

                        </div>

                    </div>
                    <script type="text/x-jsrender" id="headerTemplateSaved">
                        <input type="checkbox" id="headchkSaved" />
                    </script>
                    <script type="text/template" id="checkboxTemplateSaved">
                        <input type="checkbox" ng-model="data.Checked">
                    </script>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12" ng-show="EncashedSavedData.length>0">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li style=" margin:2px"> <button ng-click="UnApproveYearlyEncashent();" class="btn"><i class="glyphicon glyphicon-check"></i> Un-Approve/Rollback</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>






