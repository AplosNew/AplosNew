


<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Leave Year End Process</h3>
<div class="row">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">


        <div class="form-group">
            <label class="col-sm-4 control-label">Year <sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <select id="SalaryHeadFormula" class="form-control" ng-model="YearlyCalendarId" name="YearlyCalendarId" tabindex="1">
                    <option value="">--Select--</option>
                    <option ng-repeat="option in YearlyCalendar" value="{{option.Id}}">{{option.YearNo}}</option>
                </select>
            </div>
        </div>




    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal ">


        <div class="common-btn">
            <ul class="list-inline text-right">
                <li style=" margin:2px"> <button ng-click="GetLeaveYearEndProcessSummaryData();" class="btn"><i class="glyphicon glyphicon-check"></i> Load</button></li>
                <li style=" margin:2px" ng-show="ShowProcButton" > <button ng-click="LeaveYearEndProcess();" class="btn"><i class="glyphicon glyphicon-check"></i> Leave Proc</button></li>
            </ul>
        </div>

      


    </div>
</div>
<hr />

<div class="row" id="tabpaneldiv">
    <div class="col-xs-12 col-sm-12 col-sm-12">

        <div style="color:black;"
             id="GridLeaveYearEndProcessSummary"
             ej-grid e-datasource="LeaveYearEndProcessSummary"
             @*e-templaterefresh="refreshTemplateemployee"*@
             e-actioncomplete="actionCompleteSelected"
             e-pagesettings-pagesize="25"
             e-gridlines="vertical"
             e-allowfiltering="true"
             e-allowpaging="true"
             e-allowsorting="true"
             e-allowselection="true"
             e-filtersettings-filterType="excel" e-allowtouch="true">
            <div e-columns>


                @*<div e-column e-field="EmployeeId" e-headertext="EmployeeId	" e-width="100"></div>*@
                <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="100"></div>
                <div e-column e-field="EmployeeName" e-headertext="Name" e-width="100"></div>
                <div e-column e-field="LeaveName" e-headertext="Leave Name" e-width="100"></div>
                <div e-column e-field="OpeningBalance" e-headertext="OB" e-width="100"></div>
                @*<div e-column e-field="EarnedDaysOB" e-headertext="Earned OB" e-width="100"></div>*@
                <div e-column e-field="DaysCanBeSanctioned" e-headertext="Calculated Earned" e-width="100"></div>
                @*<div e-column e-field="Allocation" e-headertext="Allocation" e-width="100"></div>*@
                <div e-column e-field="AvailedOB" e-headertext="Availed OB" e-width="100"></div>
                <div e-column e-field="Availd" e-headertext="Availd" e-width="100"></div>
                <div e-column e-field="TotalAvailed" e-headertext="Availed" e-width="100"></div>
                <div e-column e-field="EncashedInbetween" e-headertext="Encashed" e-width="100"></div>
                <div e-column e-field="Balance" e-headertext="Balance" e-width="100"></div>
                <div e-column e-field="CarryForward" e-headertext="CF" e-width="100"></div>
                <div e-column e-field="YearEndEncash" e-headertext="Encash" e-width="100"></div>
                <div e-column e-field="YearEndLapse" e-headertext="Lapse" e-width="100"></div>
                @*<div e-column e-field="YearEndEncashCumulative" e-headertext="YearEndEncashCumulative" e-width="100"></div>
        <div e-column e-field="YearEndLapseCumulative" e-headertext="YearEndLapseCumulative" e-width="100"></div>*@


            </div>

        </div>

    </div>

</div>


