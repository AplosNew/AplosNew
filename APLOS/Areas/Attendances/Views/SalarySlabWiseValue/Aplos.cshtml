<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Salary Slab Wise Value
</h3>

<div class="form-elements form-horizontal" ng-form id="JobLocationFormId" name="JobLocationForm">
    <div class="row">
        <div class="col-xs-12">
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="col-md-12 ">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Value Salary Head<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="SalaryHeadId" class="form-control" ng-model="SalarySlabWiseValueModel.ValueSalaryHeadId" name="SalaryHead" required tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in SalaryHeadList" value="{{option.Id}}">{{option.UserName}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12 ">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Base Salary Head<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="SalaryHeadId" class="form-control" ng-model="SalarySlabWiseValueModel.BaseSalaryHeadId" name="SalaryHead" required tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in SalaryHeadList" value="{{option.Id}}">{{option.UserName}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xs-12">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="SalarySlabWiseValueModel.Active" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="col-md-12 ">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Head Amount</label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="SalarySlabWiseValueModel.ValueSalaryHeadAmount" only-numbers class="form-control" maxlength="100" tabindex="2">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="col-md-12 ">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Min Amount</label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="SalarySlabWiseValueModel.BaseSalaryHeadMinAmount" only-numbers class="form-control" maxlength="100" tabindex="2">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="col-md-12 ">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Max Amount</label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="SalarySlabWiseValueModel.BaseSalaryHeadMaxAmount" only-numbers class="form-control" maxlength="100" tabindex="2">
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;" id="salaryslabwisevalue" ej-grid e-datasource="SalarySlabWiseValueList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="ValueSalaryHead" e-headertext="Value Salary Head" e-width="70"></div>
                    <div e-column e-field="ValueSalaryHeadAmount" e-headertext="Value Salary Head Amount" e-width="70"></div>
                    <div e-column e-field="BaseSalaryHead" e-headertext="Base Salary Head" e-width="120"></div>
                    <div e-column e-field="BaseSalaryHeadMinAmount" e-headertext="Base Salary Head Min Amount" e-width="120"></div>
                    <div e-column e-field="BaseSalaryHeadMaxAmount" e-headertext="Base Salary Head Max Amount" e-width="120"></div>
                    <div e-column e-field="Active" e-headertext="Active" e-width="120"></div>
                </div>
            </div>
        </div>

    </div>
</div>
<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>



