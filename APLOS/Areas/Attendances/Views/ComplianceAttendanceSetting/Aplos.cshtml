<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Compliance Attendance Setting
</h3>
<div class="row">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ComplianceAttendanceModel.CompanyId" ng-change="companyOnChange();"
                            ng-options="item.Value as item.Text for item in companyList" id="plantId"
                            name="Company" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ComplianceAttendanceModel.PlantID"
                            ng-options="item.Value as item.Text for item in plantList" id="plantId" ng-change="getListData()"
                            name="Plant" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>
<br />
<div class="form-elements form-horizontal" ng-form id="JobLocationFormId" name="JobLocationForm">
    <div class="row">

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Max OT Per Day(In Minutes)</label>
                    <div class="col-sm-6">
                        <input type="text" ng-model="ComplianceAttendanceModel.MaxOTPerDay" class="form-control" maxlength="100" tabindex="2" only-numbers>
                    </div>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="checkbox-site" style="margin-top: 6px;">
                    <label>
                        <input tabindex="2" type="checkbox" ng-model="ComplianceAttendanceModel.IsNoPunchOnWeekOffForOTEntitle">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Non OT Entitled Treat Week Off as Off day (Even if Worked)
                    </label>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="checkbox-site" style="margin-top: 6px;">
                    <label>
                        <input tabindex="2" type="checkbox" ng-model="ComplianceAttendanceModel.IsNoPunchOnWeekOffForOTNotEntitle">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>OT Entitled Treat Week Off as Off Day (Even if Worked)
                    </label>
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-6 control-label" style=" padding-left: 30px;">Max Extra OT Per Day(In Minutes)</label>
                <div class="col-sm-6" style="padding-right: 30px;">
                    <input type="text" ng-model="ComplianceAttendanceModel.MaxExtraOTPerDay" class="form-control" maxlength="100" tabindex="2" only-numbers>
                </div>
            </div>           
            <div class="col-sm-12">
                <div class="checkbox-site" style="margin-top: 6px;">
                    <label>
                        <input tabindex="2" type="checkbox" ng-model="ComplianceAttendanceModel.IsNoPunchOnHolidayForOTEntitle">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Non OT Entitled Treat Holiday as Off Day (Even if Worked)
                    </label>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="checkbox-site" style="margin-top: 6px;">
                    <label>
                        <input tabindex="2" type="checkbox" ng-model="ComplianceAttendanceModel.IsNoPunchOnHolidayForOTNotEntitle">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>OT Entitled Treat Holiday as Off Day (Even if Worked)
                    </label>
                </div>
            </div>

        </div>

        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> @*<button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button>*@</li>
                </ul>
            </div>
        </div>

        @*<div class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;" id="GridComplianceAttendance" ej-grid e-datasource="ComplianceAttendanceList"                 
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclick" >
                <div e-columns>
                    <div e-column e-field="MaxOTPerDay" e-headertext="Max OT Per Day" e-width="70"></div>
                    <div e-column e-field="IsNoPunchOnWeekOffForOTEntitle" e-headertext="No Punch On Week Off For OT Entitle" e-width="120"></div>
                    <div e-column e-field="IsNoPunchOnWeekOffForOTNotEntitle" e-headertext="No Punch On Week Off For OT Not Entitle" e-width="120"></div>
                    <div e-column e-field="IsNoPunchOnHolidayForOTEntitle" e-headertext="No Punch On Holiday For OT Entitle" e-width="120"></div>
                    <div e-column e-field="IsNoPunchOnHolidayForOTNotEntitle" e-headertext="No Punch On Holiday For OT Not Entitle" e-width="120"></div>
                </div>
            </div>
        </div>*@

    </div>
</div>
<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>



