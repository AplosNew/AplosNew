<div class="row">

    <div class="col-xs-12">
        <div class="col-xs-4"><h3 class="site-heading"><span class="glyphicon glyphicon-file"></span>Year Present Days Summary</h3></div>
        <div class="col-md-8">
            <div class="col-md-12">
                <div class="col-xs-4 col-sm-4 col-md-4">
                    <div class="col-md-12">
                        <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-enablefiltersearch="true" e-value="year" e-databound="SelectDefaultValue" e-fields-value="Text" e-fields-text="Text" e-width="100%" e-change="empGridShow" />
                    </div>
                </div>
                <div class="col-xs-4 col-sm-4 col-md-4">
                    <div class="col-md-12">
                        <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-value="month" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-change="empGridShow" />
                    </div>
                </div>
                <div class="col-xs- col-sm-1 col-md-1">
                    <div class="form-group">
                        <div class="common-btn">
                            <button ng-click="GetEmployeeInformation();" class="btn"> <i class="glyphicon glyphicon-download"></i>Go</button>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>   
<br />
<div class="row">
    <div id="PresentId" ej-grid e-datasource="EmpList" e-templaterefresh="refreshTemplate"
          e-allowpaging="true"  e-enabletouch="true" e-responsive="true"
         e-allowselection="true"  e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
        <div e-columns>
            <div e-column e-field="EmployeeCode" e-type="string" e-headertext="EmployeeCode" e-width="80"></div>
            <div e-column e-field="Plant" e-type="string" e-headertext="Plant" e-width="80"></div>
            <div e-column e-field="WorkDate" e-type="string" e-headertext="WorkDate" e-width="80"></div>
            <div e-column e-field="DayStatus" e-type="string" e-headertext="DayStatus" e-width="80"></div>
            <div e-column e-field="Department" e-type="string" e-headertext="Department" e-width="80"></div>
            <div e-column e-field="Section" e-type="string" e-headertext="Section" e-width="80"></div>
            <div e-column e-field="SubSection" e-type="string" e-headertext="SubSection" e-width="80"></div>
            <div e-column e-field="Designation" e-type="string" e-headertext="Designation" e-width="80"></div>
            <div e-column e-field="Past3rdDay" e-type="string" e-headertext="Past3rdDay" e-width="80"></div>
            <div e-column e-field="Past2ndDay" e-type="string" e-headertext="Past2ndDay" e-width="80"></div>
            <div e-column e-field="Tomorrow" e-type="string" e-headertext="Tomorrow" e-width="80"></div>
            <div e-column e-field="Future2ndDay" e-type="string" e-headertext="Future2ndDay" e-width="80"></div>
            <div e-column e-field="Future3rdDay" e-type="string" e-headertext="Future3rdDay" e-width="80"></div>
        </div>
    </div>

</div>


