<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>OT Final Information</h3>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-sm-12">
            <div class="col-xs-12 col-sm-6 col-md-6 ">
                <div class="form-group">
                    <label class="col-sm-4 control-label" >Year<sup style="color:red">*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select id="LeaveTypeID" class="form-control" ng-model="OTFinalInformation.YearNo" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in yearlist" value="{{option.YearNo}}">{{option.YearNo}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6 ">
                <div class="form-group">
                    <label class="col-sm-4 control-label" >Month<sup style="color:red">*</sup></label>
                    <div class="col-sm-8">
                        <div class="select-style" style="color:red">
                            <select id="MonthId" class="form-control" ng-model="OTFinalInformation.MonthNo" name="MonthId" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in monthList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="GetOTFinalReport('EXCEL');" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                            @*<li><button ng-click="GetReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Monthly LunchOut Report</button></li>*@
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
    <div class="bounce3"></div>
</div>

