<togglable name="{{title}}"></togglable>
<div ng-form name="ModelNewForm" class="form-horizontal">
    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.CompanyId" ng-change="companyOnChange();"
                            ng-options="item.Value as item.Text for item in companyList" id="CompanyId"
                            name="Company" required tabindex="1" ng-disabled="ModelNew.ID != null">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.PlantID"
                            ng-options="item.Value as item.Text for item in plantList" id="plantId" ng-disabled="ModelNew.ID != null" ng-change="getData()"
                            name="Plant" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Policy Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="PolicyName" ng-model="ModelNew.OverTimePolicyName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Default</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" name="IsDefault" ng-model="ModelNew.IsDefault" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>


        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.OverTimePolicyDescription" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>


        </div>
        <hr style="width:100%;text-align:left;margin-left:0; border-top: 1px solid black;">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">OverTime for Day Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="OTDT" class="form-control" ng-model="PolicyDetail.OverTimeDayType" name="OTDayType" required tabindex="1">
                            <option value=""></option>
                            <option Value="Working Day">Working Day</option>
                            <option Value="Week Off">Week Off</option>
                            <option Value="Holiday">Holiday</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Over Time Calculation<sup>*</sup></label>
                <div class="col-sm-4 radio">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="PolicyDetail.IsFixed" ng-change="setRadioFixedValue();">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                        <label class="control-label">Fixed Value</label>
                    </div>
                </div>
                <div class="col-sm-4 radio">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="PolicyDetail.IsFormula" ng-change="setRadioFormulaValue();">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                        <label class="control-label">Formula</label>
                    </div>
                </div>
                <div class="form-group" ng-show="radioFormulaValue">
                    <label class="col-sm-4 control-label" style="padding-left: 31px;">Depend On Earning</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site" style="margin-top: 11px; padding-left: 6px;">
                            <label>
                                <input type="checkbox" ng-model="PolicyDetail.IsDependOnEarning" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12" ng-show="radioFixedValue" style="margin-left:-29px">
                    <fieldset class="scheduler-border" style="width:1076px">
                        <div class=" col-sm-5" style="margin-top: 30px; padding-left: 55px;">
                            <label class="col-sm-4 control-label"></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" ng-model="PolicyDetail.FixedValue" name="Policy ID" class="form-control" maxlength="15" required tabindex="3">
                            </div>
                        </div>

                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="Submit();ClearDescription('')" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action1}}</button></li>
                            </ul>
                        </div>
                    </fieldset>
                </div>
                <div class="col-sm-12" ng-show="radioFormulaValue" style="margin-left:-29px">
                    <fieldset class="scheduler-border" style="width:1076px">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Salary Head</label>
                                <div class="col-sm-6">
                                    <div class="select-style">
                                        <select ng-model="PolicyDetail.SalaryHeadIdFormula" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="common-btn">
                                        <ul class="list-inline text-left">
                                            <li> <button ng-click="SetFormula('SHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Operator</label>
                                <div class="col-sm-6">
                                    <div class="select-style">
                                        <select ng-model="PolicyDetail.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="5">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="common-btn">
                                        <ul class="list-inline text-left">
                                            <li> <button ng-click="SetFormula('Operator');ClearFormulaSource('');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Precedence</label>
                                <div class="col-sm-6">
                                    <div class="select-style">
                                        <select ng-model="PolicyDetail.Precedence" class="form-control" name="Precedence" tabindex="5">
                                            <option value=""></option>
                                            <option value="(">(</option>
                                            <option value=")">)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <div class="common-btn">
                                        <ul class="list-inline text-left">
                                            <li> <button ng-click="SetFormula('Precedence');ClearFormulaSource('');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Value</label>
                                <div class="col-sm-6">
                                    <input type="number" name="Value" ng-model="PolicyDetail.Value" class="form-control" required tabindex="2" maxlength="50">
                                </div>
                                <div class="col-sm-2">
                                    <div class="common-btn">
                                        <ul class="list-inline text-left">
                                            <li> <button ng-click="SetFormula('Value');ClearFormulaSource('');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="RemoveFormula();" class="btn" tabindex="9"><i class="glyphicon glyphicon-backward"></i></button></li>
                                </ul>
                            </div>
                            <div class="form-group">
                                {{PolicyDetail.FormulaDescription}}
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="Submit();ClearDescription('')" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Submit</button></li>
                            </ul>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
        <div class="col-xs-12">
            <div id="Grid1" ej-grid e-datasource="DetailList" e-recorddoubleclick="" e-allowsorting="true" e-allowscrolling="true"
                 e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowResizing="true"
                 e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="false">
                <div e-columns>
                    <div e-column e-field="ID" e-headertext="ID" e-width="3" e-isprimarykey="true" e-visible="false"></div>
                    <div e-column e-field="OverTimeDayType" e-headertext="Over Time Day Type" e-width="5"></div>
                    @*<div e-column e-field="IsFixed" e-headertext="IsFixed" e-width="3"></div>*@
                    <div e-column e-field="FixedValue" e-headertext="Fixed Value" e-width="3"></div>
                    @*<div e-column e-field="IsFormula" e-headertext="IsFormula" e-width="3"></div>*@
                    <div e-column e-field="FormulaDescription" e-headertext="Formula Description" e-width="7"></div>
                    @*<div e-column e-field="IsDependOnEarning" e-headertext="Depend On Earning" e-width="5"></div>*@
                    @*<div e-column e-field="FormulaIDDescription" e-headertext="FormulaIDDescription" e-width="5"></div>*@
                    @*<div e-column e-field="SalaryHeadIdFormula" e-headertext="SalaryHeadIdFormula" e-width="5"></div>*@
                    <div e-column e-headertext="Delete" e-width="3"><button data-toggle="modal" class="btn" ng-click="$parent.RemoveDetail(this);" tabindex="10"><i class="glyphicon glyphicon-trash"></i></button></div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="table-responsive aplos-grid-toggle">
        <div style="color:black;" id="Grid" ej-grid e-datasource="ModelList" e-recorddoubleclick="getDetail"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-field="ID" e-headertext="ID" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                <div e-column e-field="OverTimePolicyName" e-headertext="OverTimePolicyName" e-width="5"></div>
                <div e-column e-field="OverTimePolicyDescription" e-headertext="OverTimePolicyDescription" e-width="5"></div>
                <div e-column e-field="IsDefault" e-headertext="IsDefault" e-width="5"></div>
                <div e-column e-headertext="Delete" e-width="3">
                    <button data-toggle="modal" class="btn" ng-click="$parent.RemoveMaster(this);" tabindex="10"><i class="glyphicon glyphicon-trash"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteChild();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmMasterPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteMaster();"></confirm-archive-generic>
