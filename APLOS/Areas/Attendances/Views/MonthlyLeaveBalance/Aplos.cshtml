<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> {{title}}</h3>
<style>
    .glyphicon.fast-right-spinner {
        -webkit-animation: glyphicon-spin-r 1s infinite linear;
        animation: glyphicon-spin-r 1s infinite linear;
    }
</style>
<div class="row form-elements form-horizontal">
    <div class="col-sm-3">
        <div class="form-group">
            <label class="col-sm-4 control-label">Month<sup>*</sup></label>
            <div class="col-sm-6">
                <div class="select-style">
                    <select class="form-control" ng-model="salaryProcessModel.MonthId" name="Month">
                        <option value="">--Select--</option>
                        <option value="01">Jan</option>
                        <option value="02">Feb</option>
                        <option value="03">Mar</option>
                        <option value="04">Apr</option>
                        <option value="05">May</option>
                        <option value="06">Jun</option>
                        <option value="07">Jul</option>
                        <option value="08">Aug</option>
                        <option value="09">Sep</option>
                        <option value="10">Oct</option>
                        <option value="11">Nov</option>
                        <option value="12">Dec</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="form-group">
            <label class="col-sm-4 control-label">Year<sup>*</sup></label>
            <div class="col-sm-6">
                <div class="select-style">
                    @*<select id="Year" class="form-control" ng-model="salaryProcessModel.YearId" name="Year" required tabindex="1" ng-change="getData();">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in yearList" value="{{option.Text}}">{{option.Text}}</option>
                        </select>*@
                    <select class="form-control" ng-model="salaryProcessModel.YearId" name="Month">
                        <option value="">--Select--</option>
                        <option value="2020">2020</option>
                        <option value="2021">2021</option>
                        <option value="2022">2022</option>
                        <option value="2023">2023</option>
                        <option value="2024">2024</option>
                        <option value="2025">2025</option>

                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-3">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>Process</button></li>
            </ul>
        </div>
    </div>
</div>










