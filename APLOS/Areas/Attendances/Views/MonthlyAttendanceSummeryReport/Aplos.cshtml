<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Monthly Attendance Summary</h3>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-sm-12">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Year</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="YearId" @*ng-options="option.Id as option.YearNo for "*@>
                                <option value=""></option>
                                <option ng-repeat="option in YearList" value="{{option.YearNo}}">{{option.YearNo}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 ">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Month</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="MonthId">
                                <option value=""></option>
                                <option value="01">Jan</option>
                                <option value="02">Feb</option>
                                <option value="03">Mar</option>
                                <option value="04">Apr</option>
                                <option value="05">May</option>
                                <option value="06">Jun</option>
                                <option value="07">Jul</option>
                                <option value="08">Aug</option>
                                <option value="09">Sep</option>
                                <option value="10">Oct</option>
                                <option value="11">Nov</option>
                                <option value="12">Dec</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="GetMonthlyAttendanceSummeryReport()" class="btn" tabindex="9"><i class="glyphicon glyphicon-cloud-download"></i>Download</button></li>
        </ul>
    </div>
</div>
<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>









