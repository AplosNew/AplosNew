<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="col-xs-12 form-elements form-horizontal">
    <div class="col-md-12">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Select Date</label>
                <div class="col-sm-8">
                    <input type="text" name="Form Date" required e-dateformat="dd-MMM-yyyy" ng-model="effectiveDate" datepicker class="form-control" ng-change="PreviousDatee();empGridShow();">
                </div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group">
                <div class="common-btn">
                    <button ng-click="getData();" class="btn"> <i class="glyphicon glyphicon-download"></i>Go</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-lg-12" ng-show="empGrid">
            <div id="empInfoGrid" ej-grid e-datasource="GetList" e-allowscrolling="true" e-pageSettings-pageSize="10"
                 e-actioncomplete="actionCompleteSelected" e-templaterefresh="refreshTemplateemployee"
                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" style="margin-left:1%">
                <div e-columns>
                    <div e-column e-field="Entity" e-headertext="Entity" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmpCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="JobLocation" e-headertext="Job Location" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                </div>
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-lg-12" ng-show="empGrid">
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Shift</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <input id="ShiftList" ej-dropdownlist e-create="create" e-watermarktext="ALL" e-multiselectmode="visualmode" e-datasource="ShiftList" e-fields-value="SystemID" e-fields-text="ShiftType" e-width="100%" e-showcheckbox="true" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">With Father Name</label>
                    <div class="col-sm-8" style="padding-top: 7px;">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" name="WithFatherName" ng-model="WithFatherName" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-xs-8 col-sm-8 col-md-8">
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-7 control-label">InTime Blank OutTime not Blank</label>
                        <div class="col-sm-5" style="padding-top: 7px;">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" name="chkIntime" ng-model="chkIntime" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-7 control-label">OutTime Blank inTime not Blank</label>
                        <div class="col-sm-5" style="padding-top: 7px;">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" name="chkoutTime" ng-model="chkoutTime" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn" ng-show="empGrid">
        <ul class="list-inline text-right">
            <li><button ng-click="GetMissedPunchReport();" class="btn"> <i class="glyphicon glyphicon-download"></i> Download Report</button></li>
        </ul>
    </div>
</div>





