<togglable name="Bonus Policy Monthly Retain"></togglable>
<div class="form-horizontal" ng-form name="BonusPolicyForm" id="MainDivId">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-right: 107px;">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="BnsPlcMthRetain.CompanyId" ng-change="companyOnChange();"
                                ng-options="item.Value as item.Text for item in companyList" id="plantId" ng-disabled="BnsPlcMthRetain.ID != null"
                                name="Company" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-right: 107px;">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="BnsPlcMthRetain.PlantID"
                                ng-options="item.Value as item.Text for item in plantList" ng-disabled="BnsPlcMthRetain.ID != null" id="plantId" ng-change="getData()"
                                name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-elements ">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Policy Name</label>
                    <input type="hidden" ng-model="BnsPlcMthRetain.ID">
                    <div class="col-sm-8">
                        <input type="text" ng-model="BnsPlcMthRetain.BnsPlcMthRetainName" class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-7 control-label">If DOJ is within the specified month, Bonus will not be entitled</label>
                    <div class="col-sm-3 show-message" style=" margin-left: 45px;">
                        <div class="select-style">
                            <select class="form-control" ng-model="BnsPlcMthRetainMthNo.MonthName" required tabindex="1">
                                <option value=""></option>
                                <option Value="January">January</option>
                                <option Value="February">February</option>
                                <option Value="March">March</option>
                                <option Value="April">April</option>
                                <option Value="May">May</option>
                                <option Value="June">June</option>
                                <option Value="July">July</option>
                                <option Value="August">August</option>
                                <option Value="September">September</option>
                                <option Value="October">October</option>
                                <option Value="November">November</option>
                                <option Value="December">December</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-1">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="SubmitMonths();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Submit</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-5 control-label">All Employee Applicable For Bonus</label>
                    <div class="col-sm-7" style=" padding-top: 10px;">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" name="IsDefault" ng-model="BnsPlcMthRetain.IsAllEmpApplocable" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-5 control-label">Individual Level Change is Allowed</label>
                    <div class="col-sm-7 " style=" padding-top: 10px;">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" name="IsDefault" ng-model="BnsPlcMthRetain.IsIndividual" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Salary Head For Report</label>
                    <div class="col-sm-4">
                        <div class="select-style">
                            <select id="SalaryHeadId" class="form-control" ng-model="BonusPolicyMonthlyRetainHead.SalaryHeadID" name="SalaryHead" ng-options="item.Value as item.Text for item in salaryHeadList"  required tabindex="1">
                                <option value=""> </option>
                            </select>
                            @*<select ng-model="BnsPlcMthRetainDetail.SalaryHeadIDEarning" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5">
                                <option value=""></option>
                            </select>*@
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="SubmitHeads();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Submit</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label" style="padding-left: 43px;">Description</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" rows="3" ng-model="BnsPlcMthRetain.BnsPlcMthRetainDescription" tabindex="7" maxlength="250"></textarea>
                    </div>
                </div>
                <div class="col-sm-12" style="padding-left: 185px;">
                    <div id="Grid2" ej-grid e-datasource="MonthList" e-allowsorting="true" e-allowscrolling="true"
                         e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowResizing="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="false" e-pageSettings-pageSize="2">
                        <div e-columns>
                            <div e-column e-field="BnsPlcMthRetainMstID" e-headertext="ID" e-width="3" e-isprimarykey="true" e-visible="false"></div>
                            <div e-column e-field="MonthName" e-headertext="Month Name" e-width="2"></div>
                            <div e-column e-headertext="Delete" e-width="3"><button data-toggle="modal" class="btn" ng-click="$parent.RemoveMonth(this);" tabindex="10"><i class="glyphicon glyphicon-trash"></i></button></div>
                        </div>
                    </div>
                </div>
                
                <div class="col-sm-12" style="padding-left: 185px;">
                    <div id="Grid2" ej-grid e-datasource="HeadList" e-allowsorting="true" e-allowscrolling="true"
                         e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowResizing="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="false" e-pageSettings-pageSize="2">
                        <div e-columns>
                            <div e-column e-field="BonusPolicyMasterID" e-headertext="ID" e-width="3" e-isprimarykey="true" e-visible="false"></div>
                            <div e-column e-field="SalaryHeadName" e-headertext="Salary Head" e-width="3"></div>
                            <div e-column e-headertext="Delete" e-width="3"><button data-toggle="modal" class="btn" ng-click="$parent.RemoveHead(this);" tabindex="10"><i class="glyphicon glyphicon-trash"></i></button></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                    <ul class="list-inline text-left">
                        <li><button ng-click="AddLineIdem();" ng-disabled="BnsPlcMthRetain.ID==null" class="btn"><i class="glyphicon glyphicon-plus"></i>New Details</button></li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-sm-12" id="NewId">
                <div style="color:black;" id="BPolicyId" ej-grid e-datasource="DetailsList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-recorddoubleclick="recorddoubleclickDetails" e-filtersettings-filterType="excel" e-actioncomplete="actionCompleteSelected">
                    <div e-columns>
                        <div e-column e-field="ID" e-headertext="ID" e-width="3" e-isprimarykey="true" e-visible="false"></div>
                        <div e-column e-field="FormulaDesEarning" e-headertext="E. Value Calcu." e-width="6"></div>
                        @*<div e-column e-field="FormulaDesIDEarning" e-headertext="E. Value Calcu. ID" e-width="6"></div>*@
                        <div e-column e-field="EarningValueRangeFrom" e-headertext="From" e-width="2"></div>
                        <div e-column e-field="EarningValueRangeTo" e-headertext="To" e-width="2"></div>
                        <div e-column e-field="IsMinWages" e-headertext="Min. Wages" e-width="2"></div>
                        <div e-column e-field="CompMinWagesAndOrginal" e-headertext="Option" e-width="3"></div>
                        <div e-column e-field="FormulaDescription" e-headertext="Fromula Description" e-width="6"></div>
                        @*<div e-column e-field="FormulaIDDescription" e-headertext="Fromula Description ID" e-width="6"></div>*@
                        <div e-column e-headertext="Distribution" e-width="3">
                            <button class="btn" id="test" data-toggle="modal" ng-click="$parent.AddLineItem(this);" tabindex="10">
                                <i class="glyphicon glyphicon-plus"></i>
                            </button>
                        </div>
                        <div e-column e-headertext="Delete" e-width="3"><button data-toggle="modal" class="btn" ng-click="$parent.RemoveDetail(this);" tabindex="10"><i class="glyphicon glyphicon-trash"></i></button></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div class="col-xs-12 col-sm-12 col-sm-12" style="padding-left: 0px; padding-right: 0px;">
            <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="getDetails" e-load="loadGridEdit"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-field="BnsPlcMthRetainName" e-headertext="Bonus Policy Monthly Retain Name" e-width="60"></div>
                    <div e-column e-field="BnsPlcMthRetainDescription" e-headertext="Bonus Policy Monthly Retain Description" e-width="60"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmPopUpHead" title="Confirmation" message="{{message_confirmation}}" data-ng-click-right-button="DeleteHeadList();"></confirm-archive-generic>
<ej-dialog id="BPMRDetails"
           title="Bonus Policy Monthly Retain Details"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#MainDivId"
           e-close="onDialogClose"
           e-width="1020"
           e-minheight="470"
           e-open="enableBtn">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border" style="color:red">Earning Value Calculation:-</legend>
        <div class="col-sm-12 form-elements" style="margin-left:-29px">
            <fieldset class="scheduler-border">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Salary Head</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="BnsPlcMthRetainDetail.SalaryHeadIDEarning" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetEarningFormula('EarningSHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Operator</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="BnsPlcMthRetainDetail.EOperator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="5">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetEarningFormula('EarningOperator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Precedence</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="BnsPlcMthRetainDetail.Precedence" class="form-control" name="Precedence" tabindex="5">
                                    <option value=""></option>
                                    <option value="(">(</option>
                                    <option value=")">)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetEarningFormula('EarningPrecedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Value</label>
                        <div class="col-sm-6">
                            <input type="text" name="Value" ng-model="BnsPlcMthRetainDetail.EValue" class="form-control" required tabindex="2" maxlength="50">
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetEarningFormula('EarningValue');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li> <button ng-click="RemoveEarningFormula();" class="btn" tabindex="9"><i class="glyphicon glyphicon-backward"></i></button></li>
                        </ul>
                    </div>
                    <div class="form-group">
                        {{BnsPlcMthRetainDetail.FormulaDesEarning}}
                    </div>
                </div>
            </fieldset>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6 form-elements">
            <div class="form-group">
                <label class="col-sm-5 control-label">Earning Value Range From</label>
                <div class="col-sm-7">
                    <input type="text" ng-model="BnsPlcMthRetainDetail.EarningValueRangeFrom" class="form-control" maxlength="100" tabindex="2">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Mandatory</label>
                <div class="col-sm-8" style=" padding-top: 10px;">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" name="IsDefault" ng-model="BnsPlcMthRetainDetail.IsMandatory" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-elements">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-left: 60px;">To</label>
                <div class="col-sm-8">
                    <input type="text" ng-model="BnsPlcMthRetainDetail.EarningValueRangeTo" class="form-control" maxlength="100" tabindex="2">
                </div>
            </div>
        </div>
    </fieldset>

    <fieldset class="scheduler-border">
        <legend class="scheduler-border" style="color:red">Bonus Value Calculation:-</legend>
        <div class="col-xs-12 col-sm-6 col-md-6 form-elements">
            <label class="col-sm-4 control-label"></label>
            <div class="col-sm-4 radio">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="BnsPlcMthRetainDetail.IsFixed" ng-change="setRadioFixedValue();">
                        <span class="cr"><i class="cr-icon "></i></span>
                    </label>
                    <label class="control-label">Fixed Value</label>
                </div>
            </div>
            <div class="col-sm-4 radio">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="BnsPlcMthRetainDetail.IsFormula" ng-change="setRadioFormulaValue();">
                        <span class="cr"><i class="cr-icon"></i></span>
                    </label>
                    <label class="control-label">Formula</label>
                </div>
            </div>
            <div class="form-group" ng-show="radioFormulaValue">
                <label class="col-sm-4 control-label" style="padding-left: 31px;">Based On Netpay</label>
                <div class="col-sm-8">
                    <div class="checkbox-site" style="margin-top: 11px; padding-left: 6px;">
                        <label>
                            <input type="checkbox" ng-model="BnsPlcMthRetainDetail.IsDependOnEarning" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group" ng-show="radioFormulaValue">
                <label class="col-sm-4 control-label" style="padding-left: 31px;">Based Minimum Wages</label>
                <div class="col-sm-2">
                    <div class="checkbox-site" style="margin-left: 5px; margin-top: 9px;">
                        <label>
                            <input type="checkbox" ng-model="BnsPlcMthRetainDetail.IsMinWages" ng-change="setRadioMinValue();">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok "></i></span>
                        </label>
                    </div>
                </div>
                <div class="col-sm-6 form-group" ng-show="radioMinValue">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8 show-message" style="padding-left: 0px; padding-right: 0px;">
                            <div class="select-style">
                                <select class="form-control" name="CompMinWagesAndOrginal" id="CompMinWagesAndOrginal" ng-model="BnsPlcMthRetainDetail.CompMinWagesAndOrginal">
                                    <option value=""></option>
                                    <option value="Which Ever is Less">Which Ever is Less</option>
                                    <option value="Which Ever is More">Which Ever is More</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 form-elements" ng-show="radioFixedValue" style="margin-left:-29px">
            <fieldset class="scheduler-border">
                <div class=" col-sm-5" style="margin-top: 30px; padding-left: 55px;">
                    <label class="col-sm-4 control-label"></label>
                    <div class="col-sm-8 show-message">
                        <input type="number" ng-model="BnsPlcMthRetainDetail.FixedValue" name="Policy ID" class="form-control" maxlength="15" required tabindex="3">
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="col-sm-12 form-elements" ng-show="radioFormulaValue">
            <fieldset class="scheduler-border">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Salary Head</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="BnsPlcMthRetainDetail.SalaryHeadIdFormula" id="SalaryHeadFormula1" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('SHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Operator</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="BnsPlcMthRetainDetail.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="5">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('Operator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Precedence</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="BnsPlcMthRetainDetail.Precedence" class="form-control" name="Precedence" tabindex="5">
                                    <option value=""></option>
                                    <option value="(">(</option>
                                    <option value=")">)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('Precedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Value</label>
                        <div class="col-sm-6">
                            <input type="text" name="Value" ng-model="BnsPlcMthRetainDetail.Value" class="form-control" required tabindex="2" maxlength="50">
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('Value');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li> <button ng-click="RemoveFormula();" class="btn" tabindex="9"><i class="glyphicon glyphicon-backward"></i></button></li>
                        </ul>
                    </div>
                    <div class="form-group">
                        {{BnsPlcMthRetainDetail.FormulaDescription}}
                    </div>
                </div>
            </fieldset>
        </div>
    </fieldset>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="SaveD();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
            @*<li><button ng-disabled="DisableActionButtons" ng-click="Confirm();" class="btn"><i class="glyphicon glyphicon-floppy-remove" tabindex="9"></i> Delete</button></li>*@
