<togglable name="{{title}}"></togglable>
<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script>
<div class="form-elements form-horizontal">
    <div  ng-form name="ModelNewForm">
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Work Date<sup>*</sup></label>
                <div class="col-sm-8 show-message" ng-show="dateControlShow==true">
                    <input type="text" name="Work Date" ng-model="ModelNew.WorkDate" datepicker class="form-control datepicker" placeholder="dd-Mmm-yyyy" required tabindex="1">
                </div>
                <div class="col-sm-8" ng-show="LBLShow==true">
                    <label class="control-label">{{DT}}</label>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Purpose<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Purpose" ng-model="ModelNew.Purpose" class="form-control" maxlength="100" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Time<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group bootstrap-timepicker timepicker">
                        <input id="FromTime"name="FromTime" type="text" class="form-control" ng-model="ModelNew.FromTime" ng-change="getMinute();" required e-width="100" tabindex="5">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-time"></i></span>
                    </div>
                </div>
            </div>


            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Time<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group bootstrap-timepicker timepicker">
                        <input id="ToTime" name="ToTime" type="text" class="form-control" ng-model="ModelNew.ToTime" ng-change="getMinute();" required e-width="100" tabindex="7">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-time"></i></span>
                    </div>
                </div>
            </div>
            
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="11"></textarea>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Group<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="UserGroup" class="form-control" ng-model="ModelNew.UserGroupId" name="User Group" ng-change="getFiltersData();GetGoodWorkCheckByCbo();" required tabindex="9">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in userGroupDataList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group" tabindex="208">
                        <input type="text" name="Shift" ng-model="ModelNew.Shift" ng-disabled="true" class="form-control" maxlength="200" tabindex="2" required readonly>
                        <span class="input-group-btn">
                            <button ng-click="selectShift()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Purpose Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="PC" name="Purpose Category" class="form-control" ng-model="ModelNew.PurposeCategory" required tabindex="4">
                            <option value="">--Select--</option>
                            <option value="BreakDown">BreakDown</option>
                            <option value="Additional">Additional</option>
                            <option value="New">New</option>
                            <option value="Normal">Normal</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Calculated Minute<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" class="form-control" name="Calculated Minute" ng-model="ModelNew.Minute" e-width="100" disabled required tabindex="6" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Check By<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="CheckedBy" name="Check By" class="form-control" ng-model="ModelNew.CheckedBy" tabindex="8" required>
                            <option ng-repeat="option in checkedByList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Reason</label>
                <div class="col-sm-8 show-message">
                    <textarea class="form-control"name="Reason"  rows="3" ng-model="ModelNew.Reason" maxlength="250" tabindex="10" required></textarea>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div id="filters">
        </div>
    </div>
    <ul class="col-md-6 common-btn list-inline text-left">
        <li><button ng-click="getEmploymeeList();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Employee</button></li>
    </ul>

    <div class="clearfix"></div>

    <div class="table-responsive modal-table ">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Actions</th>
                    <th>Employee Code</th>
                    <th>Employee Name</th>
                    <th>From Time</th>
                    <th>To Time</th>
                    <th>Minute</th>
                    <th>Purpose</th>
                    <th>Purpose Category</th>
                    <th>Over Stay</th>
                    <th>InTime</th>
                    <th>OutTime</th>
                    <th>Day Status</th>
                    <th>Late Duration</th>
                    <th>Department</th>
                    <th>Section</th>
                    <th>SubSection</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in GoodWorkList" ng-class="{selected : x.Id==null}">
                    <td class="text-right">
                        <button ng-click="$parent.selectEdit(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit Time">
                            <i class="glyphicon glyphicon-edit"></i>
                        </button>

                        <button ng-click="$parent.removeRow(x)" data-toggle="modal"
                                ng-disabled="ModelNew.CheckedStatus=='Checked' || ModelNew.ApprovedStatus=='Approved'" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                    <td>{{x.EmployeeCode}}</td>
                    <td>{{x.EmployeeName}}</td>
                    <td>{{x.FromTime}}</td>
                    <td>{{x.ToTime}}</td>
                    <td><input type="number" class="form-control" name="Minute" ng-model="x.Minute" e-width="100" /></td>

                    <td><input type="text" name="Purpose" ng-model="x.Purpose" class="form-control" maxlength="100" required tabindex="3"></td>
                    <td>
                        <select name="PurposeCategory" ng-model="x.PurposeCategory" id="pc" class="form-control">
                            <option value="BreakDown">BreakDown</option>
                            <option value="Additional">Additional</option>
                            <option value="New">New</option>
                            <option value="Normal">Normal</option>
                        </select>
                    </td>
                    <td>{{x.OverStay}}</td>
                    <td>{{x.InTime}}</td>
                    <td>{{x.OutTime}}</td>
                    <td>{{x.DayStatus}}</td>
                    <td>{{x.LateDuration}}</td>
                    <td>{{x.Department}}</td>
                    <td>{{x.Section}}</td>
                    <td>{{x.SubSection}}</td>
                    <td><input type="text" name="Remarks" ng-model="x.Remark" class="form-control" maxlength="15" required tabindex="3"></td>

                </tr>
            </tbody>
        </table>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" ng-disabled="ModelNew.CheckedStatus=='Checked' || ModelNew.ApprovedStatus=='Approved' || btnDisable==true" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(bankReconciliationUploadId)"></confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteRow()"></confirm-archive-generic>

<div class="table-responsive aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group">
            <label class="col-sm-1 control-label">Work Date</label>
            <div class="col-sm-11 show-message">
                <div class="col-sm-4">
                    <input type="text" name="Date" ng-model="WorkDates" datepicker class="form-control" placeholder="dd-Mmm-yyyy" tabindex="1">
                </div>
                <div class="col-sm-1">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="getData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy"></i> Go</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-sm-7">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button data-toggle="modal" ng-click="GoodWorkReport();" class="btn" tabindex="10"><i class="glyphicon glyphicon-cloud-download"></i>Download</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-12">
        <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="GetDblClick"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="WorkDate" e-headertext="Work Date" e-width="30"></div>
                <div e-column e-field="Shift" e-headertext="Shift" e-width="80"></div>
                <div e-column e-field="UserGroup" e-headertext="UserGroup" e-width="50"></div>
                <div e-column e-field="CheckedStatus" e-headertext="Checked Status" e-width="50"></div>
                <div e-column e-field="ApprovedStatus" e-headertext="Approved Status" e-width="50"></div>
                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="80"></div>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>

<div class="modal fade site-modal in" id="ShiftPop" role="dialog" data-backdrop="static">
