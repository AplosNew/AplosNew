<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Work Date<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" name="Date" ng-model="ModelNew.WorkDate" datepicker class="form-control" placeholder="dd-Mmm-yyyy" tabindex="3">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Employee Category</label>
            <div class="col-sm-6" show-message>
                <div class="select-style">
                    <select id="Category" class="form-control" ng-model="ModelNew.EmployeeCategory" name="subSectionId" tabindex="3">
                        <option value="All">--All--</option>
                        <option ng-repeat="option in EmployeeCategoryList" value="{{option.Id}}">{{option.EmployeeCategory}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Section<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select id="Category" class="form-control" ng-model="ModelNew.Section" name="Department" tabindex="3">
                        <option value="All">--Select--</option>
                        <option ng-repeat="option in SectionList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Designation<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select id="Category" class="form-control" ng-model="ModelNew.Designation" name="Designation" tabindex="3">
                        <option value="All">--Select--</option>
                        <option ng-repeat="option in designationList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Shift<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="input-group" tabindex="208">
                    <input type="text" name="Shift" ng-model="ModelNew.Shift" ng-disabled="true" class="form-control" maxlength="200" required readonly>
                    <span class="input-group-btn">
                        <button ng-click="selectShift()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Department<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select id="Category" class="form-control" ng-model="ModelNew.Department" name="Department" tabindex="3">
                        <option value="All">--Select--</option>
                        <option ng-repeat="option in DepartmentList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Sub-Section<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select id="Category" class="form-control" ng-model="ModelNew.SubSection" name="SubSection" tabindex="3">
                        <option value="All">--Select--</option>
                        <option ng-repeat="option in SubSectionList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Remarks</label>
            <div class="col-sm-6 show-message">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="8"></textarea>
            </div>
        </div>

    </div>

    @*<ul class="col-md-6 common-btn list-inline text-left">
        <li><button ng-click="showEmployeeListPopUp();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Employee</button></li>
    </ul>*@
    <ul class="col-md-6 common-btn list-inline text-left">
        <li><button ng-click="getEmploymeeList();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Employee</button></li>
    </ul>

    <div class="clearfix"></div>
    <div class="table-responsive modal-table ">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Employee Code</th>
                    <th>Employee Name</th>
                    <th>From Time</th>
                    <th>To Time</th>
                    <th>Purpose</th>
                    <th>Purpose Category</th>
                    <th>Approved By</th>
                    <th>Remarks</th>
                    <th>Minute</th>
                    <th>SubSection</th>
                    <th>Section</th>
                    <th>Department</th>
                    <th>Remove</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in GoodWorkList" ng-class="{selected : x.Id==null}">
                    <td>{{x.EmployeeCode}}</td>
                    <td>{{x.EmployeeName}}</td>
                    <td><input id="FromTime" type="time" timepicker class="form-control" ng-model="x.FromTime" ng-change="getMinute(x,$index);"></td>
                    <td><input id="ToTime" type="time" timepicker class="form-control" ng-model="x.ToTime" ng-change="getMinute(x,$index);"></td>
                    <td><input type="text" name="Purpose" ng-model="x.Purpose" class="form-control" maxlength="15" required tabindex="3"></td>
                    <td>
                        <select name="PurposeCategory" ng-model="x.PurposeCategory" id="pc" class="form-control">
                            <option value="BreakDown">BreakDown</option>
                            <option value="Additional">Additional</option>
                            <option value="New">New</option>
                            <option value="Normal">Normal</option>
                        </select>
                    </td>
                    <td>
                        <span class="input-group-addon">{{x.ApprovedByName}}</span>
                        <span class="input-group-btn">
                            <button ng-click="$parent.showByWhomEmployeeListPopUp($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearEmp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </td>
                    <td><input type="text" name="Remarks" ng-model="x.Remarks" class="form-control" maxlength="15" required tabindex="3"></td>
                    <td><input type="number" class="form-control" name="CalculatedTime" ng-model="x.CalculatedTime" e-width="100" disabled /></td>
                    <td>{{x.SubSection}}</td>
                    <td>{{x.SubSection}}</td>
                    <td>{{x.Department}}</td>

                    <td class="text-right">
                        <button ng-click="$parent.removeRow(x)" data-toggle="modal" ng-disabled="currencyDisable" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>


    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-click="Delete();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(bankReconciliationUploadId)"></confirm-archive-generic>


<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="GetDblClick" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="WorkDate" e-headertext="Work Date" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="Shift" e-headertext="Shift" e-width="3"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
        </div>
    </div>
</div>



<confirm-modal></confirm-modal>

