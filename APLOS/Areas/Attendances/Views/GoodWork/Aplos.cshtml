    <div class="row">
        <div id="GridGD" ng-init="chkinit()" ej-grid e-datasource="GoodWorkList"
             e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-querycellinfo="queryCellInfo"
             e-allowscrolling="true" e-minheight="400" e-gridlines="vertical" @*e-showstackedheader="true"*@
             e-height="400px" e-rowdatabound="rowDataBoundSingleEmployee"
             e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="30" e-primarykey="true"></div>
                <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="50"></div>
                <div e-column e-type="string" e-template="#fromTime" e-headertext="FromTime" e-width="70"></div>
                <div e-column e-type="string" e-template="#toTime" e-headertext="ToTime" e-width="70"></div>
                <div e-column e-template="#purpose" e-headertext="Purpose" e-width="50"></div>
                <div e-column e-template="#purposeCategory" e-headertext="Purpose Category" e-width="50"></div>
                <div e-column e-template="#approvedBy" e-headertext="Approved By" e-width="120"></div>
                <div e-column e-template="#remarks" e-headertext="Remarks" e-width="80"></div>
                <div e-column e-template="#minute" e-headertext="Minute" e-width="50"></div>

                <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-width="50"></div>
                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="50"></div>
                <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="50"></div>
                
            </div>
            <script type="text/template" id="fromTime">
                <input type="text" ej-timepicker e-value="data.FromTime" e-width="100%" />
            </script>

            <script type="text/template" id="toTime">
                <input type="text" ej-timepicker e-value="data.ToTime" e-width="100%" />
            </script>

            <script type="text/template" id="purpose">
                <input type="text" name="Purpose" ng-model="data.Purpose" class="form-control" maxlength="15" required tabindex="3">
            </script>

            <script type="text/template" id="purposeCategory">
                <select name="PurposeCategory" ng-model="data.PurposeCategory" id="pc" class="form-control">
                    <option value="BreakDown">BreakDown</option>
                    <option value="Additional">Additional</option>
                    <option value="New">New</option>
                    <option value="Normal">Normal</option>
                </select>
            </script>

            <script type="text/template" id="approvedBy">
                <span class="input-group-addon">{{data.ApprovedByName}}</span>
                <span class="input-group-btn">
                    <button ng-click="$parent.showByWhomEmployeeListPopUp();" class="btn single-small-btn" tabindex="13"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="clearEmp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                </span>
            </script>

            <script type="text/template" id="remarks">
                <input type="text" name="Purpose" ng-model="data.Remarks" class="form-control" maxlength="15" required tabindex="3">
            </script>

            <script type="text/template" id="minute">
                <div class="col-sm-6" style="padding:0px;">
                    <input type="text" name="Minute" ng-model="data.Minute" class="form-control" required disabled tabindex="4" maxlength="50">
                </div>
            </script>

        </div>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-click="Delete();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(bankReconciliationUploadId)"></confirm-archive-generic>


<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="GetDblClick" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="UserId" e-headertext="User Name" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="FullName" e-headertext="Full Name" e-width="3"></div>
            <div e-column e-field="UserType" e-headertext="User Type" e-width="3"></div>
        </div>
    </div>
</div>



<confirm-modal></confirm-modal>

<div class="modal fade site-modal in" id="ShiftPop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Shift List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Shift</p>
                        <div style="color:black;" id="GridShift" ej-grid e-datasource="ShiftList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleShift">
                            <div e-columns>
                                @*<div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>*@

                                <div e-column e-field="Plant" e-headertext="Plant" e-width="50"></div>
                                <div e-column e-field="ShiftDefinationDescription" e-headertext="ShiftDefinationDescription" e-width="50"></div>
                                <div e-column e-field="ShiftDefination" e-headertext="Shift Defination" e-width="120"></div>
                                <div e-column e-field="InTime" e-headertext="In Time" e-width="120"></div>
                                <div e-column e-field="OutTime" e-headertext="Out Time" e-width="120"></div>
                            </div>

                        </div>
                        @*
                            <script type="text/template" id="checkboxTemplate">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" e-value="data.isSelected" />
                            </script>*@



                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeShiftPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")

<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <disv class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="SystemId" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </disv>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closePopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>
