<script type="text/javascript">
    $('[id*=FromTime]').timepicker({ showMeridian: false, defaultTime: false }).on('changeTime.timepicker', function (e) {
        var hours = e.time.hours, //Returns a string
            min = e.time.minutes
        //merdian = e.time.meridian;

        if (hours.length == 1) {
            $('[id*=FromTime]').timepicker('setTime', '0' + hours + ':' + min);

        }
    });
    $('[id*=ToTime]').timepicker({ showMeridian: false, defaultTime: false }).on('changeTime.timepicker', function (e) {
        var hours = e.time.hours, //Returns a string
            min = e.time.minutes
        //merdian = e.time.meridian;

        if (hours.length == 1) {
            $('[id*=ToTime]').timepicker('setTime', '0' + hours + ':' + min);

        }
    });
</script>

