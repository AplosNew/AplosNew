<togglable name="{{title}}"></togglable>
<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="PCAACModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="FromDate" ng-model="PCAACModelNew.FromDate" datepicker class="form-control datepicker" placeholder="dd-Mmm-yyyy" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Reference<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" class="form-control" name="UserRef" ng-model="PCAACModelNew.UserRef" e-width="100" disabled />
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Percentage<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" class="form-control" name="Percentage" ng-model="PCAACModelNew.Percentage" e-width="100" disabled />
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Approved By<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="ApprovedBy" ng-model="PCAACModelNew.ApprovedBy" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp('AB');" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Prepared By<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="PreparedBy" ng-model="PCAACModelNew.PreparedBy" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp('PB');" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ToDate" ng-model="PCAACModelNew.ToDate" datepicker class="form-control datepicker" placeholder="dd-Mmm-yyyy" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">No Of Days<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" class="form-control" name="NoOfDays" ng-model="PCAACModelNew.NoOfDays" e-width="100" disabled />
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Checked By<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="CheckedBy" ng-model="PCAACModelNew.CheckedBy" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp('CB');" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8 show-message">
                <textarea class="form-control" rows="3" ng-model="PCAACModelNew.Remarks" maxlength="250" tabindex="8"></textarea>
            </div>
        </div>
    </div>

    <ul class="col-md-6 common-btn list-inline text-left">
        <li><button ng-click="getEmploymeeList();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Employee</button></li>
    </ul>

    <div class="clearfix"></div>
    <div class="table-responsive modal-table ">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Employee Code</th>
                    <th>Employee Name</th>
                    <th>From Time</th>
                    <th>To Time</th>
                    <th>Purpose</th>
                    <th>Purpose Category</th>
                    <th>Approved By</th>
                    <th>Remarks</th>
                    <th>Minute</th>
                    <th>SubSection</th>
                    <th>Section</th>
                    <th>Department</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in GoodWorkList" ng-class="{selected : x.Id==null}">
                    <td>{{x.EmployeeCode}}</td>
                    <td>{{x.EmployeeName}}</td>
                    <td>{{x.FromTime}}</td>
                    <td>{{x.ToTime}}</td>

                    <td><input type="text" name="Purpose" ng-model="x.Purpose" class="form-control" maxlength="15" required tabindex="3"></td>
                    <td>
                        <select name="PurposeCategory" ng-model="x.PurposeCategory" id="pc" class="form-control">
                            <option value="BreakDown">BreakDown</option>
                            <option value="Additional">Additional</option>
                            <option value="New">New</option>
                            <option value="Normal">Normal</option>
                        </select>
                    </td>
                    <td>
                        <span class="input-group-addon">{{x.ApprovedByName}}</span>
                        <span class="input-group-btn">
                            <button ng-click="$parent.showByWhomEmployeeListPopUp($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearEmp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </td>
                    <td><input type="text" name="Remarks" ng-model="x.Remarks" class="form-control" maxlength="15" required tabindex="3"></td>
                    <td><input type="number" class="form-control" name="CalculatedTime" ng-model="x.CalculatedTime" e-width="100" disabled /></td>
                    <td>{{x.SubSection}}</td>
                    <td>{{x.SubSection}}</td>
                    <td>{{x.Department}}</td>

                    <td class="text-right">
                        <button ng-click="$parent.selectEdit(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                            <i class="glyphicon glyphicon-edit"></i>
                        </button>

                        <button ng-click="$parent.removeRow(x)" @*data-toggle="modal"*@ ng-disabled="currencyDisable" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            @*<li> <button ng-click="Delete();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Delete</button></li>*@
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(bankReconciliationUploadId)"></confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteRow()"></confirm-archive-generic>


