                                <th>Employee Name</th>
                                <th>Section</th>
                                <th>SubSection</th>
                                <th>Department</th>
                                <th title="SUM(CalculatedMinute/1440)">Pay Days</th>
                                <th>Extra OT</th>
                                <th>Standard OT</th>
                                <th>Additional OT</th>
                                <th>Good Work</th>
                                <th title="(((Gross/208)*2)*2)">Rate Per Day</th>
                                <th title="((Gross/208)*2)">Rate Per Hour</th>
                                <th title="Basic/26*PayDays*Percentage">Amount</th>
                                <th>AdvanceGiven</th>
                                <th title="(Basic/26*PayDays*Percentage)-AdvanceGiven">NetPayable</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in EmployeeMainList" ng-class="{selected : x.Id==null}">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.Section}}</td>
                                <td>{{x.SubSection}}</td>
                                <td>{{x.Department}}</td>
                                <td>
                                    <label>{{x.PayDays}}</label>
                                </td>
                                <td><input type="number" class="form-control" name="Extra OT" ng-model="x.OverStay" e-width="100" ng-disabled="true" /></td>
                                <td><input type="number" class="form-control" name="Standard OT" ng-model="x.StandardOT" e-width="100" ng-disabled="true" /></td>
                                <td><input type="number" class="form-control" name="Additional OT" ng-model="x.AdditionalOT" e-width="100" ng-disabled="true" /></td>
                                <td><input type="number" class="form-control" name="Good Work" ng-model="x.GoodWork" e-width="100" ng-disabled="true" /></td>
                                <td><input type="number" class="form-control" title="Gross: {{x.Gross}}" name="Rate Per Day" ng-model="x.RatePerDay" e-width="100" ng-disabled="true" /></td>
                                <td><input type="number" class="form-control" title="Gross: {{x.Gross}}" name="Rate Per Hour" ng-model="x.RatePerHour" e-width="100" ng-disabled="true" /></td>
                                <td><input type="number" class="form-control" title="Basic: {{x.Basic}}" name="Amount" ng-model="x.Amount" e-width="100" ng-disabled="true" /></td>
                                <td><input type="number" class="form-control" name="AdvanceGiven" ng-model="x.AdvanceGiven" e-width="100" ng-disabled="true" /></td>
                                <td><input type="number" class="form-control" name="NetPayable" ng-model="x.NetPayable" e-width="100" ng-disabled="true" /></td>
                                <td class="text-right">
                                    <button ng-click="$parent.removeRow(x)" @*data-toggle="modal"*@ ng-="currencyDisable" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
