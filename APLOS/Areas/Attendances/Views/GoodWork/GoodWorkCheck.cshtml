         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-detailstemplate="detailTemp"
         e-detailsdatabound="detailgrid" e-templaterefresh="refreshTemplate">
        <div e-columns>
          
            <div e-column e-field="WorkDate" e-headertext="Work Date" e-width="30"></div>
            <div e-column e-field="Shift" e-headertext="Shift" e-width="80"></div>
            <div e-column e-field="UserGroup" e-headertext="UserGroup" e-width="50"></div>
            <div e-column e-field="CheckedStatus" e-headertext="Checked Status" e-width="50"></div>
            <div e-column e-field="ApprovedStatus" e-headertext="Approved Status" e-width="50"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="80"></div>
        </div>
       
    </div>
    <script id="tabGridContents" type="text/x-jsrender">
        <div class="tabcontrol" id="Test">
            <ul>
                <li><a href="#gridTab{{:Id}}">Item</a></li>
            </ul>
            <div id="gridTab{{:Id}}">
                <div id="detailGrid"></div>
            </div>
        </div>
    </script>
</div>



