                            <div class="input-group bootstrap-timepicker timepicker">
                                <input id="FromTime" type="text" class="form-control" ng-model="ModelNewtemp.FromTime" ng-change="getMinuteEdit();" e-width="100" tabindex="7">
                                <span class="input-group-addon"><i class="glyphicon glyphicon-time"></i></span>
                            </div>
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-sm-3 control-label">To Time</label>
                        <div class="col-sm-6">
                            <div class="input-group bootstrap-timepicker timepicker">
                                <input id="ToTime" type="text" class="form-control" ng-model="ModelNewtemp.ToTime" ng-change="getMinuteEdit();" e-width="100" tabindex="7">
                                <span class="input-group-addon"><i class="glyphicon glyphicon-time"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
