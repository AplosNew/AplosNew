<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Daily Allowance</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">

            <div class="col-md-4">
                <div class="form-group" show-errors id="div_FromDate">
                    <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Form Date" ng-model="DailyAllowance.FromDate" datepicker class="form-control">
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group" show-errors id="div_ToDate">
                    <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="To Date" ng-model="DailyAllowance.ToDate" datepicker class="form-control">
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Allowance Type<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select id="StopageId" class="form-control" ng-model="DailyAllowance.AllowanceDailyId" name="Stopage" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in AllowanceTypeList" value="{{option.Id}}">{{option.UserName}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Report Group</label>
                    <div class="col-sm-8" style="left:-25px;">
                        <input type="text" ng-model="DailyAllowance.ReportGroup" class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="GetEmployeeInformation();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Go </button></li>
                    </ul>
                </div>
            </div>

            <div class="col-sm-1" style="left:-100px;">
                <div class="common-btn">
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-click="showEmployeeFilterScreen()" class="btn" tabindex="10"><i class="glyphicon glyphicon-filter"></i></button></li>
                    </ul>
                </div>
            </div>

        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-12">
        <div id="Grid" ej-grid
             e-datasource="EmployeeList"
             e-recorddoubleclick="Get"
             e-allowscrolling="true"
             e-pageSettings-pageSize="8"
             e-actioncomplete="actionCompleteSelected"
             e-templaterefresh="refreshTemplateemployee"
             e-allowfiltering="true"
             e-allowpaging="true"
             e-enabletouch="false"
             e-responsive="true"
             e-allowselection="true"
             e-filtersettings-filterType="excel">
            <div e-columns>

                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Unit" e-headertext="Unit" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="WorkDate" e-headertext="Work Date" e-allowediting="false" e-width="80"></div>
                @*<div e-column e-field="AllowanceType" e-headertext="Allowance Type" e-allowediting="false" e-width="80"></div>*@

            </div>
        </div>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="DailyAllowanceFunc('Excel');" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
        </ul>
    </div>

</div>

<div class="modal fade site-modal in" id="JobCardPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Select Employees<button type="button" class="close" data-dismiss="modal">&times;</button></div>

            <div class="col-xs-12 col-sm-6 col-md-12">
                <div id="GridPopUp" ej-grid
                     ng-init="chkinit()"
                     e-datasource="EmployeePopUpList"
                     e-recorddoubleclick="Get"
                     e-allowscrolling="true"
                     e-pageSettings-pageSize="15"
                     e-actioncomplete="actionCompleteSelected"
                     e-templaterefresh="refreshTemplateemployee"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-enabletouch="false"
                     e-responsive="true"
                     e-allowselection="true"
                     e-filtersettings-filterType="excel">
                    <div e-columns>

                        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Unit" e-headertext="Unit" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="WorkDate" e-headertext="Work Date" e-allowediting="false" e-width="80"></div>
                        @*<div e-column e-field="AllowanceType" e-headertext="Allowance Type" e-allowediting="false" e-width="80"></div>*@

                    </div>

                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" e-value="data.CheckBoxSelect" />
                    </script>

                    <script type="text/x-jsrender" id="headerTemplate">

                        <input type="checkbox" id="headchk" />
                    </script>

                </div>
            </div>

            <ul class="common-btn list-inline text-right" style="padding: 20px;">
                <li><button ng-click="saveemployeedata();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button></li>
                <li><button ng-click="Back();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Back</button></li>
            </ul>

        </div>
    </div>
</div>

<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
    <div class="bounce3"></div>
</div>

