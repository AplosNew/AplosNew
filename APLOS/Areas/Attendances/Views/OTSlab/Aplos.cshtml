<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> OT Slab
</h3>

<div class="row">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="WorkingDayModel.CompanyId" ng-change="companyOnChange();"
                            ng-options="item.Value as item.Text for item in companyList" id="plantId"
                            name="Company" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="WorkingDayModel.PlantID"
                            ng-options="item.Value as item.Text for item in plantList" id="plantId" ng-change="getData()"
                            name="Plant" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>
<br />
<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">General OT Slab (Working Day)</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab">General OT Slab (Week Off)</a></li>
            <li role="presentation" ng-class="{ active: isSet22(33) }"><a ng-click="setTab22(33)" href="" aria-controls="aria2" role="tab" data-toggle="tab">General OT Slab (Holiday)</a></li>
        </ul>
    </div>
    <div class="tab-content" id="tabpaneldiv">        
        <br/>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet11(11), active: isSet11(11) }">
            <div class="form-elements form-horizontal" ng-form id="OTSlapFormId" name="OTSlapForm">
                
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label" style="color:red">From Date<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="WorkingDayModel.FromDate" e-width="100%" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Over Time Allow For A Day</label>
                                <div class="col-sm-6">
                                    <input type="text" ng-model="WorkingDayModel.firstSlab" class="form-control" maxlength="100" only-numbers tabindex="2">
                                </div>
                            </div>
                        </div>                        
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label" style="color:red">To Date<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="WorkingDayModel.ToDate" e-width="100%" />
                                </div>
                            </div>
                        </div>
                        @*<div class="col-sm-12">
                            <div class="checkbox-site" style="margin-top: 6px;">
                                <label>
                                    <input tabindex="2" type="checkbox" ng-model="WorkingDayModel.IsOTExtentNextSlab">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Extend OT Update In Next Slab.
                                </label>
                            </div>
                        </div>*@
                    </div>
                    <div class="col-xs-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveWorkingDay();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{WDAction}}</button></li>
                                <li> <button data-toggle="modal" data-target="#confirmWorkingDay" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet22(22), active: isSet22(22) }">
            <div class="form-elements form-horizontal" ng-form id="OTSlapFormId" name="OTSlapForm">                
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label" style="color:red">From Date<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="WeekOffModel.FromDate" e-width="100%" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Over Time Allow For A Day</label>
                                <div class="col-sm-6">
                                    <input type="text" ng-model="WeekOffModel.firstSlab" class="form-control" maxlength="100" only-numbers tabindex="2">
                                </div>
                            </div>
                        </div>
                        @*<div class="col-sm-12">
                            <div class="checkbox-site" style="margin-top: 6px;">
                                <label>
                                    <input tabindex="2" type="checkbox" ng-model="WeekOffModel.IsOTExtentNextSlab">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Extent OT Update In Next Slab.
                                </label>
                            </div>
                        </div>*@
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label" style="color:red">To Date<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="WeekOffModel.ToDate" e-width="100%" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="checkbox-site" style="margin-top: 6px;">
                                <label>
                                    <input tabindex="8" type="checkbox" ng-model="WeekOffModel.IsTotalWorkTimeAsOT">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Total Work Time As OT(Punch Time)
                                </label>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="checkbox-site" style="margin-top: 6px;">
                                <label>
                                    <input tabindex="8" type="checkbox" ng-model="WeekOffModel.IsTotalWorkTimeAsOTFromShift">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Total Work Time As OT(From Shift)
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveWeekOff();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{WOAction}}</button></li>
                                <li> <button data-toggle="modal" data-target="#confirmWeekOff" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>                                
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet22(33), active: isSet22(33) }">
            <div class="form-elements form-horizontal" ng-form id="OTSlapFormId" name="OTSlapForm">                
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label" style="color:red">From Date<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="HolidayModel.FromDate" e-width="100%" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Over Time Allow For A Day</label>
                                <div class="col-sm-6">
                                    <input type="text" ng-model="HolidayModel.firstSlab" class="form-control" maxlength="100" only-numbers tabindex="2">
                                </div>
                            </div>
                        </div>
                        @*<div class="col-sm-12">
                            <div class="checkbox-site" style="margin-top: 6px;">
                                <label>
                                    <input tabindex="2" type="checkbox" ng-model="HolidayModel.IsOTExtentNextSlab">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Extent OT Update In Next Slab.
                                </label>
                            </div>
                        </div>*@
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label" style="color:red">To Date<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="HolidayModel.ToDate" e-width="100%" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="checkbox-site" style="margin-top: 6px;">
                                <label>
                                    <input tabindex="8" type="checkbox" ng-model="HolidayModel.IsTotalWorkTimeAsOT">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Total Work Time As OT(Punch Time)
                                </label>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="checkbox-site" style="margin-top: 6px;">
                                <label>
                                    <input tabindex="8" type="checkbox" ng-model="HolidayModel.IsTotalWorkTimeAsOTFromShift">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Total Work Time As OT(From Shift)
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveHoliday();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{HDAction}}</button></li>
                                <li> <button data-toggle="modal" data-target="#confirmHoliday" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>                                
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmWorkingDay" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteWorkingDay();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmWeekOff" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteWeekOff();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmHoliday" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteHolidayday();"></confirm-archive-generic>



