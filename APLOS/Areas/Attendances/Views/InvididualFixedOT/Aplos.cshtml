<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Individual Fixed OT
</h3>
<div class="form-elements form-horizontal" ng-form name="IndividualFixedOTForm">
    <div class="row">
        <div class="clearfix"></div>

        <div class="col-xs-12">

            <div class="col-xs-12 col-sm-6 col-md-6 ">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Year<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select id="LeaveTypeID" class="form-control" ng-model="IndividualFixedOT.YearNo" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in yearlist" value="{{option.YearNo}}">{{option.YearNo}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6 ">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Month<sup>*</sup></label>
                    <div class="col-sm-8">
                        <div class="select-style" style="color:red">
                            <select id="MonthId" class="form-control" ng-model="IndividualFixedOT.MonthNo" name="MonthId" required tabindex="1">
                                <option value="">--Select--</option>
                                <option Value="Jan">Jan</option>
                                <option Value="Feb">Feb</option>
                                <option Value="Mar">Mar</option>
                                <option Value="Apr">Apr</option>
                                <option Value="May">May</option>
                                <option Value="Jun">Jun</option>
                                <option Value="Jul">Jul</option>
                                <option Value="Aug">Aug</option>
                                <option Value="Sep">Sep</option>
                                <option Value="Oct">Oct</option>
                                <option Value="Nov">Nov</option>
                                <option Value="Dec">Dec</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Employee Select<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <span class="input-group-addon">{{employeeInfo.EmployeeCode}}</span>
                        <input type="text" name="EmployeeName" ng-model="employeeInfo.EmployeeName" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="GetEmployeeDeleteInfo()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">DOJ :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.DOJ}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">DOC :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.DOC}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label"> Designation :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.LegalDesignation}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Department :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.Department}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Section :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.Section}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">SubSection :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.SubSection}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">OT Allow(Hour) :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.MinimumOT}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">OT Allow(Hour) :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.Allow}}</label>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <div class="col-sm-8">
                    <div>
                        <img id="uploadImageSrc" ng-src="{{employeeInfo.EmpPic}}" style="margin-left: 180px; border: 1px solid; height: 200px; width: 200px;" />
                    </div>
                </div>
            </div>
            <div>
                <br />
                <br />
            </div>
        </div>

        <div class="row form-horizontal form-elements">
            <div class="col-xs-12 col-sm-12 col-md-12 ">

                <div id="GridIndividualFixedOT" ej-grid
                     e-datasource="GetIndividualFixedOTList"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-allowsorting="true"
                     e-responsive="true"
                     e-pagesettings-pagesize="31"
                     e-allowselection="true"
                     e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="WorkDate" e-headertext="Work Date" e-width="60"></div>
                        <div e-column e-field="DayStatus" e-headertext="Day Status" e-width="40"></div>
                        <div e-column e-field="InTime" e-headertext="In Time" e-width="80"></div>
                        <div e-column e-field="OutTime" e-headertext="Out Time" e-width="80"></div>
                        <div e-column e-field="ShiftDefinationName" e-headertext="Shift Name" e-width="80"></div>
                        <div e-column e-field="ShiftInTime" e-headertext="Shift In Time" e-width="50"></div>
                        <div e-column e-field="ShiftOutTime" e-headertext="Shift Out Time" e-width="50"></div>
                        <div e-column e-field="OTHr" e-headertext="OT Min" e-width="40"></div>
                        <div e-column e-template="#OTHour" e-headertext="Add OT Min" e-width="70"></div>
                    </div>
                </div>

                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" @*e-change="$parent.Changevalue($event);"*@ e-checked="data.CheckBoxSelect" />
                </script>

                <script type="text/x-jsrender" id="headerTemplate4">
                    <input type="checkbox" id="headchk4" />
                </script>

                <script type="text/template" id="OTHour">
                    <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                        <input type="text" ng-model="data.OTHrNew" ng-change="$parent.ChangeOutTime($event);" ng-disabled="!data.CheckBoxSelect" style="color:black;" class="form-control" />
                    </div>
                </script>

            </div>
        </div>

        <div class="clearfix"></div>
        <div class="col-xs-12">
            <div class="common-btn">

                <div class="col-xs-12 col-sm-6">

                    <div class="col-xs-12 col-sm-4 ">
                        <label class="col-sm-10 control-label">Previous Total OT</label>
                        <div class="col-sm-2">
                            <label>{{PreTotal}}</label>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-4 ">

                        <label class="col-sm-10 control-label">New Total OT</label>
                        <div class="col-sm-2">
                            <label>{{TotalOT}}</label>
                            <div class="col-xs-12 col-sm-4 ">
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-4 ">

                        <label class="col-sm-10 control-label">Remaining OT</label>
                        <div class="col-sm-2">
                            <label>{{RemainingOT}}</label>
                        </div>
                    </div>

                </div>
                <div class="col-xs-12 col-sm-6">

                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear(LeavePolicyModel); getListData();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>

    </div>

    <div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    Employee List
                    <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="GridEmp" ej-grid e-datasource="dataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-recorddoubleclick="SetData" e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer common-btn">
                    <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
                </div>
            </div>
        </div>
    </div>

    <confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>

