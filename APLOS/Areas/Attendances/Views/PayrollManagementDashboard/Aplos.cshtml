
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="form-elements form-horizontal">
    <div class="row">
        <div class="col-md-12">
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date</label>
                    <div class="col-sm-8">
                        <input type="text" name="Form Date" required e-dateformat="dd-MMM-yyyy" ng-model="effectiveDate" datepicker class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date</label>
                    <div class="col-sm-8">
                        <input type="text" name="To Date" ng-disabled="true" e-dateformat="dd-MMM-yyyy" ng-model="ToDate" datepicker class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <div class="common-btn">
                        <button ng-click="Report();" class="btn"> <i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div id="GridSummary" ej-grid e-datasource="SummaryData" e-doubleclick=""
                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-minheight="400"
                 e-allowselection="false" e-filtersettings-filterType="excel" e-allowscrolling="true">
                <div e-columns>
                    <div e-column e-field="PlantName" e-headertext="Plant" e-width="15"></div>
                    <div e-column e-field="Particulars" e-headertext="Particulars" e-width="20"></div>
                    <div e-column e-template="#templateYesterday" e-headertext="Last Day" e-width="5"></div>
                    <div e-column e-template="#templateUpToDate" e-headertext="Up to Date" e-width="5"></div>
                </div>
            </div>
        </div>
        <script type="text/template" id="templateYesterday">
            <a href="" ng-click="$parent.onSummaryItemSelection(data,false)"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{data.Yesterday}}</span></a>
        </script>
        <script type="text/template" id="templateUpToDate">
            <a href="" ng-click="$parent.onSummaryItemSelection(data,true)"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{data.UpToDate}}</span></a>
        </script>
    </div>
</div>

<div class="modal site-modal" id="modalAttendance" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> {{ModalTitle}}<button type="button" class="close" data-dismiss="modal">&times;</button></div>

            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="content-container-fluid">

                    <div id="GridAttendance" ng-init="chkinit()" ej-grid e-datasource="DetailData"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50" e-primarykey="true"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="InTime" e-headertext="InTime" e-width="80"></div>
                            <div e-column e-field="OutTime" e-headertext="OutTime" e-width="80"></div>
                            <div e-column e-field="DayStatus" e-headertext="DayStatus" e-width="80"></div>
                            <div e-column e-field="OTHr" e-headertext="OTHr" e-width="80"></div>
                            <div e-column e-field="IsOTComfirm" e-headertext="IsOTComfirm" e-width="80"></div>
                            <div e-column e-field="PunchInTime" e-headertext="PunchInTime" e-width="80"></div>
                            <div e-column e-field="PunchOutTime" e-headertext="PunchOutTime" e-width="80"></div>
                        </div>
                    </div>


                </div>

            </div>
            <ul class="common-btn list-inline text-right" style="padding: 20px;">
                <li><button ng-click="closePopup('modalAttendance')" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Back</button></li>
            </ul>

        </div>
    </div>
</div>

<div class="modal site-modal" id="modalProfile" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">  {{ModalTitle}}<button type="button" class="close" data-dismiss="modal">&times;</button></div>

            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="content-container-fluid">

                    <div id="GridProfile" ng-init="chkinit()" ej-grid e-datasource="DetailData"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50" e-primarykey="true"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                        </div>
                    </div>


                </div>

            </div>
            <ul class="common-btn list-inline text-right" style="padding: 20px;">
                <li><button ng-click="closePopup('modalProfile')" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Back</button></li>
            </ul>

        </div>
    </div>
</div>

