<togglable name="Gratuity Policy"></togglable>
<div class="form-horizontal" ng-form name="GratuityPolicyForm" id="MainDivId">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
            <div class="form-group">
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="GratuityPolicyModel.CompanyId" ng-change="companyOnChange();"
                                ng-options="item.Value as item.Text for item in companyList" id="CompanyId"
                                name="Company" required tabindex="1" ng-disabled="GratuityPolicyModel.Id != null">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
            <div class="form-group">
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="GratuityPolicyModel.plantId"
                                ng-options="item.Value as item.Text for item in plantList" id="plantId" ng-disabled="GratuityPolicyModel.Id != null" ng-change="getListData()"
                                name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements form-horizontal" ng-form id="GratuityPolicyFormId" name="GratuityPolicyForm">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Name</label>
                    <div class="col-sm-8">
                        <input type="text" name="Standard Name" ng-model="GratuityPolicyModel.UserName" class="form-control" tabindex="4" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-sm-12">
                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="GratuityPolicyModel.IsRoudingSixMonth">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>SubSequent Maturity Rounding Based On Six Month
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <div class="col-sm-4">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="GratuityPolicyModel.Active" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Active
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                    <ul class="list-inline text-left">
                        <li><button ng-click="AddLineIdem();" ng-disabled="GratuityPolicyModel.Id==null" class="btn"><i class="glyphicon glyphicon-plus"></i>Add New</button></li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-sm-12" id="NewId">
                <div style="color:black;" id="GratuityId" ej-grid e-datasource="GratuityDetailsList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-recorddoubleclick="recorddoubleclickDetails" e-filtersettings-filterType="excel" e-actioncomplete="actionCompleteSelected">
                    <div e-columns>
                        <div e-column e-field="MaturityFromYear" e-headertext="Maturity From Year" e-width="70"></div>
                        <div e-column e-field="MaturityToYear" e-headertext="Maturity To Year" e-width="70"></div>
                        <div e-column e-field="MaturityFormulaDescription" e-headertext="Maturity Formula Description" e-width="70"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<ej-dialog id="gratuityDialog"
           title="Gratuity Policy Details"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#MainDivId"
           e-close="onDialogClose"
           e-width="1020"
           e-minheight="470" e-open="enableBtn">

    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="col-xs-12 form-element-ctrl form-horizontal" ng-show="ShowDiv">
                <div class="col-xs-12">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Gratuity Details</legend>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Maturity Year From</label>
                                <div class="col-sm-4">
                                    <input type="text" ng-model="GratuityPolicyDetailsModel.MaturityFromYear" class="form-control" maxlength="100" tabindex="2">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Maturity Year To</label>
                                <div class="col-sm-4">
                                    <input type="text" ng-model="GratuityPolicyDetailsModel.MaturityToYear" class="form-control" maxlength="100" tabindex="2">
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12" style="margin-left:-29px">
                            <fieldset class="scheduler-border">
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Salary Head</label>
                                        <div class="col-sm-6">
                                            <div class="select-style">
                                                <select ng-model="salaryRuleGeneral.SalaryHeadIdFormula" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Id as item.UserName for item in salaryHeadList" tabindex="5">
                                                    <option value=""></option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="common-btn">
                                                <ul class="list-inline text-left">
                                                    <li> <button ng-click="SetFormula('SHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Operator</label>
                                        <div class="col-sm-6">
                                            <div class="select-style">
                                                <select ng-model="salaryRuleGeneral.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="5">
                                                    <option value=""></option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="common-btn">
                                                <ul class="list-inline text-left">
                                                    <li> <button ng-click="SetFormula('Operator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Precedence</label>
                                        <div class="col-sm-6">
                                            <div class="select-style">
                                                <select ng-model="salaryRuleGeneral.Precedence" class="form-control" name="Precedence" tabindex="5">
                                                    <option value=""></option>
                                                    <option value="(">(</option>
                                                    <option value=")">)</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="common-btn">
                                                <ul class="list-inline text-left">
                                                    <li> <button ng-click="SetFormula('Precedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Value</label>
                                        <div class="col-sm-6">
                                            <input type="text" name="Value" ng-model="salaryRuleGeneral.Value" class="form-control" required tabindex="2" maxlength="50">
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="common-btn">
                                                <ul class="list-inline text-left">
                                                    <li> <button ng-click="SetFormula('Value');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="common-btn">
                                        <ul class="list-inline text-left">
                                            <li> <button ng-click="RemoveFormula();" class="btn" tabindex="9"><i class="glyphicon glyphicon-backward"></i></button></li>
                                        </ul>
                                    </div>
                                    <div class="form-group">
                                        {{salaryRuleGeneral.FormulaDescription}}
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        
                    </fieldset>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveD();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i></button></li> 
                        <li><button ng-disabled="DisableActionButtons" ng-click="Confirm();" class="btn"><i class="glyphicon glyphicon-floppy-remove" tabindex="9"></i> Delete</button></li>
                        <li> <button ng-click="ClearD();" class="btn" tabindex="13"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        
                    </ul>
                </div>                
            </div>
        </div>
    </div>    
</ej-dialog>
<div class="aplos-grid-toggle">
    <div class="table-responsive aplos-grid-toggle">
        <div class="col-xs-12 col-sm-12 col-sm-12" style="padding-left: 0px;padding-right: 0px;">
            <div style="color:black;" id="GridMaster" ej-grid e-datasource="GratuityList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="UserName" e-headertext="User Name" e-width="120"></div>
                    <div e-column e-field="IsRoudingSixMonth" e-headertext="Rouding Six Month" e-width="120"></div>
                    <div e-column e-field="Active" e-headertext="Active" e-width="120"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>

<ej-dialog id="dialogAPI" title="Confirm Delete?" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#gratuityDialog" e-close="onDialogClose" e-minwidth="240" e-minheight="165" e-open="enableBtn">
    <p>
        Are you sure to delete ?
    </p>
    <p class="text-right">
        <ul class="list-inline text-right">
            <li><button ng-click="DeleteDetailsFunction();ConfirmClose()" class="btn"><i class="glyphicon glyphicon-floppy-remove"></i> Yes</button></li>
            <li><button ng-click="ConfirmClose();" class="btn"><i class="glyphicon glyphicon-step-backward"></i> No</button></li>
        </ul>
    </p>
</ej-dialog>