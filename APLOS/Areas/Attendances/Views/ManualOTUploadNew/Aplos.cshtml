<togglable name="{{FormTitle}}"></togglable>

<div class="form-elements form-horizontal" ng-form name="OTManualForm">
    <div class="row" ng-form name="General">
        <input type="hidden" ng-model="OTManual.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="PlantId" class="form-control" ng-model="OTManual.PlantId" name="Plant" ng-change="getEntityWithChange();" ng-disabled="enable" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Date" ng-model="OTManual.ToDate" datepicker class="form-control" required tabindex="3" ng-change="ValidateToDate();" ng-disabled="enable">

                </div>
            </div>
  
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name=" From Date" ng-model="OTManual.FromDate" datepicker class="form-control" required tabindex="2" ng-disabled="enable">

                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" ng-model="OTManual.Remarks" tabindex="4" maxlength="250"></textarea>
                </div>
            </div>

        </div>
        <br />

    </div>
    <confirm-modal></confirm-modal>
    <br />
    <div class="row">
        <div class="form-elements form-horizontal" ng-form id="EmpInOutTab">
            <div class="tab-design" id="tab_show">

                <div class="site-tab">
                    <ul class="nav nav-tabs" role="tablist">
                        
                        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="uploadexcel" role="tab" data-toggle="tab">Upload Excel</a></li>
                    </ul>
                </div>

                <div class="tab-content">

                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

                        <div class="row" ng-form name="uploadexcelForm">

                            <div  class="form-horizontal form-element-ctrl">

                                <div class="form-elements">

                                    <div class="col-md-10">

                                        <div class="inputBtnSection common-btn">
                                            <label class="fileUpload col-sm-4 " style="padding: 0 0 0 0">
                                                <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                                            </label>
                                            <input type="button" value="Import Data" ng-disabled="enable" class="btn btn-success" ng-click="ImportData()" />
                                            <button ng-click="GetSample();" class="btn"><i class="glyphicon glyphicon-download"></i> Get Sample File </button>
                            
                                        </div>
                                    </div>
                      
                                </div>

                            </div>
                            <br />
                 
                            <div class="col-xs-12">
                                <div style="color:black;" id="GridSelectedEmpINOUTExcelTab" ej-grid e-datasource="SelectedEmpINOUTListExcel"
                                     e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                     e-allowselection="false" e-filtersettings-filterType="excel">
                                    <div e-columns>
                                        <div e-column e-type="string" e-field="Code" e-headertext="Employee Code" e-width="30"></div>
                                        @*<div e-column e-type="string" e-field="EmployeeCode" e-headertext="Employee Code" e-width="30"></div>*@
                                        <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="30"></div>
                                        @*<div e-column e-type="string" e-field="APDInTime" e-headertext="In Time" e-width="15"></div>
        <div e-column e-type="string" e-field="APDOutTime" e-headertext="Out Time" e-width="15"></div>*@
                                        <div e-column e-type="string" e-field="OTHr" e-headertext="OT Hour" e-width="15"></div>
                                        @*<div e-column e-type="string" e-field="OTHour" e-headertext="OT Hour" e-width="15"></div>*@
                                        @*<div e-column e-type="string" e-field="WorkingDate" e-headertext="Work Date" e-width="25"></div>*@
                                        <div e-column e-type="string" e-field="APDEmpWorkDate" e-headertext="Work Date" e-width="25"></div>

                                        @*<div e-column e-type="string" e-field="ManualOT" e-headertext="Manual OT" e-width="15"></div>
        <div e-column e-type="string" e-field="APDEmpWorkDate" e-headertext="Work Date" e-width="25"></div>*@

                                        <div e-column e-template="#RemoveEMPData" e-headertext="Remove" e-width="30"></div>

                                    </div>
                                </div>

                                <script type="text/template" id="RemoveEMPData">
                                    <div class="common-btn">
                                        <ul class="list-inline text-left">
                                            <li><button ng-click="$parent.ConfirmRemoveEmpINOUTDataForExcel(data);" ng-disabled="data.Id!=null" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                        </ul>
                                    </div>
                                </script>
                            </div>
                            <div class="common-btn" style="padding-right: 15px;">
                                <ul class="list-inline text-right">
                                    <li>

                                        <button ng-click="SaveExcel();" ng-disabled="OTManual.Id!=null" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button>
                                        <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button>

                                    </li>
                                </ul>
                            </div>

                        </div>
                    </div>

                </div>


            </div>

        </div>
    </div>
</div>


<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">

    <div id="OTFilingListGrid" ej-grid e-datasource="OTFilingList"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-recorddoubleclick="Get">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="2"></div>
            <div e-column e-field="EmpName" e-headertext="Employee Name" e-width="2"></div>
            <div e-column e-field="OTWorkDate" e-headertext="Work Date" e-width="2"></div>
            <div e-column e-field="ManualOt" e-headertext="OT Hour" e-width="2"></div>
        </div>
    </div>
</div>



<confirm-archive-generic modalid="RemoveEmpDataForExcel" title="Confirmation" message="Are you sure want to Remove?" data-ng-click-right-button="RemoveEMPDataExcel();"></confirm-archive-generic>

