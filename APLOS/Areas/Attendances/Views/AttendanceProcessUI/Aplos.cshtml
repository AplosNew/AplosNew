
<div class="form-elements form-horizontal" ng-form id="leavePolicyFormId" name="AttendanceProceForm">

    <div class="row">

        <div class="col-sm-12">

            <div class="col-sm-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="AttendanceProcess.FromDate" datepicker class="form-control datepicker" tabindex="1">
                    </div>
                </div>
            </div>

            <div class="col-sm-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="AttendanceProcess.ToDate" datepicker class="form-control datepicker" tabindex="1">
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                @*<label class="col-sm-8 control-label">Process With Shift</label>
                <div class="col-sm-4">
                    <div class="checkbox-site" style="margin-top: 6px;">
                        <label>
                            <input tabindex="8" type="checkbox" ng-model="AttendanceProcess.CheckBox">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>*@
            </div>
            <div class="col-md-3">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="GetEmployeeInformation();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Load Employee </button></li>
                    </ul>
                </div>
            </div>

        </div>

        <div class="row">
            <div class="col-md-12 col-sm-12">
                <div class="col-md-4 col-sm-4">
                </div>
                <div class="col-md-4 col-sm-4">
                </div>
                <div class="col-md-4 col-sm-4">
                    <div class="common-btn">
                        <ul class="common-btn list-inline text-right">
                            <li><button ng-click="showEmployeeFilterScreen()" class="btn" tabindex="10"><i class="glyphicon glyphicon-filter"></i></button></li>
                            <li><button ng-click="clearManualFilter()" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i></button></li>

                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-12">

            <div id="empInfoGrid" ng-init="chkinit()" ej-grid e-datasource="EmployeeListTemp" e-gridlines="vertical" e-templaterefresh="refreshTemplateemployee"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-pagesettings-pagesize="15">
                <div e-columns>

                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="JobLocation" e-headertext="Job Location" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>

                </div>
            </div>

            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>

            <script type="text/x-jsrender" id="headerTemplate">

                <input type="checkbox" id="headchk" />
            </script>

        </div>

        <div class="col-sm-12">
            <div class="col-sm-4">
                <br />
            </div>

            <div class="col-sm-4">
                <br />
            </div>

            <div class="col-sm-4">
                <br />
            </div>

            <div class="col-sm-4">
                <div class="common-btn">
                    <ul>
                        <li> <button ng-click="Process();" class="btn"><i></i> {{Action}}</button></li>
                    </ul>
                </div>
            </div>

        </div>


    </div>

</div>



<div class="modal fade site-modal in" id="empfilterPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Select Employees<button type="button" class="close" data-dismiss="modal">&times;</button></div>

            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="content-container-fluid">

                    <div id="Gridemployee" ng-init="chkinit()" ej-grid e-datasource="EmployeeList" e-gridlines="vertical" 
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-pagesettings-pagesize="15" e-rowdatabound ="dataBoundemployee">
                        <div e-columns>

                            <div e-column e-headertext="" e-headertemplateid="#headerTemplatePOPUp" e-template="#checkboxTemplatePopUp" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>

                        </div>
                    </div>


                </div>

                <script type="text/template" id="checkboxTemplatePopUp">
                    <input type="checkbox" ej-checkbox class="nodetext" e-value="data.isToBeSelect" e-checked="data.isToBeSelect" />
                </script>
                <script type="text/x-jsrender" id="headerTemplatePOPUp">
                    <input type="checkbox" id="headchkd" />
                </script>
            </div>
            <ul class="common-btn list-inline text-right" style="padding: 20px;">
                <li><button ng-click="saveemployeedata();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button></li>
                <li><button ng-click="Back();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Back</button></li>
            </ul>

        </div>
    </div>
</div>




<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>
