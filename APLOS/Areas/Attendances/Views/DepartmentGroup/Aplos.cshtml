@*<h3 class="site-heading">
        <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Department Group
    </h3>*@
<togglable name="Department Group"></togglable>
<div class="form-elements  form-horizontal" ng-form id="ShiftAssignment" name="ShiftAssignment">
    <div class="row">

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Sequence" ng-model="DepartmentGroupModel.Sequence" class="form-control" required tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="DepartmentGroupModel.ShortName" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="DepartmentGroupModel.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="DepartmentGroupModel.Description" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="DepartmentGroupModel.Code" class="form-control" required tabindex="10" maxlength="10">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="DepartmentGroupModel.StandardName" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="DepartmentGroupModel.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="DepartmentGroupModel.Active" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-left">
                <li><button ng-click="GetDepartmentInformation();" class="btn"><i class="glyphicon glyphicon-search" tabindex="9"></i>Add Departmen</button></li>
            </ul>
        </div>

        <hr />

        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div id="GridNew" ej-grid
                 e-datasource="DepartmentListNew"
                 e-recorddoubleclick="Get"
                 e-pageSettings-pageSize="15"
                 e-actioncomplete="actionCompleteSelected"
                 e-templaterefresh="refreshTemplateemployee"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-enabletouch="false"
                 e-responsive="true"
                 e-allowselection="true"
                 e-filtersettings-filterType="excel">

                <div e-columns>
                    <div e-column e-field="Code" e-headertext="Code" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="ShortName" e-headertext="Short Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="StandardName" e-headertext="Standard Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="UserName" e-headertext="User Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Actives" e-headertext="Active" e-allowediting="false" e-width="80"></div>
                    <div e-column e-headertext="Actions" e-width="70" e-template="#GridNewDelete"></div>
                </div>
            </div>

            <script type="text/template" id="GridNewDelete">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.remove(this);" style="margin: -6px;"></i></button>
            </script>
        </div>

    </div>

    </div>

<hr />


<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>


<ej-dialog id="dialogDepartmentInfo"
           title="Department Information"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target=".site-heading"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="500" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-12">

            <div id="empInfoGrid" ng-init="chkinit()" ej-grid e-datasource="DepartmentList" e-gridlines="vertical" e-templaterefresh="refreshTemplateemployee"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel">

                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="Code" e-headertext="Code" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="ShortName" e-headertext="Short Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="StandardName" e-headertext="Standard Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="UserName" e-headertext="User Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Actives" e-headertext="Active" e-allowediting="false" e-width="80"></div>
                </div>

            </div>

            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>

            <script type="text/x-jsrender" id="headerTemplate">

                <input type="checkbox" id="headchk" />
            </script>

        </div>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right" ng-show="true">
            <li><button ng-click="OK();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Ok </button></li>
        </ul>
    </div>


</ej-dialog>

<div class="row text-right aplos-grid-toggle">

    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div style="color:black;" id="GridDesignation" ej-grid e-datasource="DepartmenthkpList"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
             e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                <div e-column e-field="UserName" e-headertext="User Name" e-width="70"></div>
                <div e-column e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="60"></div>
                <div e-column e-field="Actives" e-headertext="Active" e-width="60"></div>
            </div>
        </div>
    </div>

</div>







