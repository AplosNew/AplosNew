<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Final Attendance Process</h3>
<div class="form-horizontal form-elements" ng-form="FinalAttendanceProcess">
    <div class="row">
        <div class="col-sm-12">
            <div class="col-sm-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="From Date" ng-model="FromDate" datepicker class="form-control" required tabindex="6">
                    </div>
                </div>
            </div>
            <div class="col-sm-6 ">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="To Date" ng-model="ToDate" datepicker class="form-control" required tabindex="6">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="AttendanceProcess()" class="btn" tabindex="9"><i class="glyphicon glyphicon-retweet"></i> Process</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>









