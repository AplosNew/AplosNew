<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Salary Head Wise Amount Setting
</h3>

<div class="form-elements form-horizontal" ng-form id="JobLocationFormId" name="JobLocationForm">
    <div class="row">

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Salary Particular</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="salaryHeadWiseAmountSettingModel.AllowanceComponent" class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>
            </div>

            <div class="col-md-12 ">
                <div class="form-group">
                    <label class="col-sm-5 control-label">Salary Head<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <div class="select-style">
                            <select id="SalaryHeadId" class="form-control" ng-model="salaryHeadWiseAmountSettingModel.SalaryHeadId" name="SalaryHead" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in SalaryHeadList" value="{{option.Id}}">{{option.UserName}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Duration Type<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select id="LeaveTypeID" class="form-control" ng-model="salaryHeadWiseAmountSettingModel.DurationType" name="Leave Type" required tabindex="1">
                                <option value="">-Select-</option>
                                <option Value="DateSpecific">Date Specific</option>
                                <option Value="Monthly">Monthly One Time</option>                          
                                <option Value="Recurring">Monthly Recurring</option>                          
                            </select>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;" id="GridSalaryHeadWiseAmountSetting" ej-grid e-datasource="SalaryHeadWiseAmountSettingList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="AllowanceComponent" e-headertext="Allowance Component" e-width="70"></div>
                    <div e-column e-field="DurationType" e-headertext="Duration Type" e-width="120"></div>
                    @*<div e-column e-field="IsRemaining" e-headertext="IsRemaining" e-width="120"></div>*@
                    <div e-column e-field="SalaryHead" e-headertext="Salary Head" e-width="120"></div>
               
                </div>
            </div>
        </div>

    </div>
</div>
<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>



