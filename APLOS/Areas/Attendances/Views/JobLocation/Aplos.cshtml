<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Job Location
</h3>

<div class="form-elements form-horizontal" ng-form id="JobLocationFormId" name="JobLocationForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-left: 31px;">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message" style="margin-left: -82px;">
                    <div class="select-style">
                        <select class="form-control" ng-model="JobLocationModel.CompanyId" ng-change="companyOnChange();"
                                ng-options="item.Value as item.Text for item in companyList" id="plantId" ng-disabled="JobLocationModel.SystemID != null"
                                name="Company" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-left: 31px;">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message" style="margin-left: -82px;">
                    <div class="select-style">
                        <select class="form-control" ng-model="JobLocationModel.PlantID"
                                ng-options="item.Value as item.Text for item in plantList" ng-disabled="JobLocationModel.SystemID != null" id="plantId" ng-change="getListData()"
                                name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Job Location</label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="JobLocationModel.JobLocation" class="form-control" maxlength="100" tabindex="2">
                        </div>
                    </div>
                </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">


        </div>

        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;" id="GridJobLocation" ej-grid e-datasource="JobLocationList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="SystemID" e-headertext="SystemID" e-width="70"></div>
                    <div e-column e-field="JobLocation" e-headertext="JobLocation" e-width="120"></div>
                </div>
            </div>
        </div>

    </div>
</div>
<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>



