<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Access Controller Employee Tag
</h3>
<div class="form-elements form-horizontal" ng-form name="AccessControllerEmployeeTagForm">
    <input type="hidden" ng-model="AccessControllerEmployeeTagNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="PlantDropdown" class="form-control" ng-model="AccessControllerEmployeeTagNew.PlantID" name="Plant" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Register FP</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="RegisterFP" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label" title="Employee">Employee</label>
            <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                <span class="input-group-addon">{{AccessControllerEmployeeTagNew.EmployeeCode}}</span>
                <input type="text" ng-model="AccessControllerEmployeeTagNew.EmployeeName" class="form-control" readonly>
                <span class="input-group-btn">
                    <button ng-click="getEmployeeModal()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="ClearEmployee()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                </span>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Register Proximate</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="RegisterProximate" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12">
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Select</th>
                        <th>Device SystemID</th>
                        <th>Machine ID</th>
                        <th>Description</th>
                        <th>Machine IP</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in selectedDeviceList">
                        <td>
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" id="selectDevice" ng-model="x.Flag" ng-checked="x.Flag" @*ng-click="selectChValueId($event,x)"*@>
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </td>
                        <td>{{x.DeviceSystemID}}</td>
                        <td>{{x.MachineID}}</td>
                        <td>{{x.Description}}</td>
                        <td>{{x.MachineIP}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="modal fade site-modal in" id="PopUpEmployee" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Select Employee</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="EmployeePopUpParameters.searchBy">
                                            <option ng-repeat="option in searchingEmpList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="EmployeePopUpParameters.search" ng-enter="getEmployeeModal()" >
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeModal()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Email</th>
                                <th>Department</th>
                                <th>Given Designation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="dr in dataListEmployee |itemsPerPage:EmployeePopUpParameters.pageSize" pagination-id="metaData.name + 'dataListEmployee'"
                                total-items="EmployeePopUpParameters.total_count" ng-dblclick="selectEmployee(dr)">
                                <td>{{dr.EmployeeCode}}</td>
                                <td>{{dr.EmployeeName}}</td>
                                <td>{{dr.EmailId}}</td>
                                <td>{{dr.Department}}</td>
                                <td>{{dr.GivenDesignation}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'dataListEmployee'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeModal(newPageNumber)">
                </dir-pagination-controls>
            </div>
        </div>
    </div>
</div>
