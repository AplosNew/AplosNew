<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Raw Data Set In Out</h3>
<div class="form-elements form-horizontal" ng-form id="leavePolicyFormId" name="AttendanceProceForm">
    <div class="row">
        <div class="col-sm-12">
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Work Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="AttendanceProcess.FromDate" datepicker class="form-control datepicker" tabindex="1">
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="Process();" class="btn"><i class="glyphicon glyphicon-paste"></i>Set</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>
