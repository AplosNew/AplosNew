



<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Attendance Raw Data Delete</h3>


<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">Employee Wise</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Date Wise</a></li>


        </ul>
    </div>

    <div class="tab-content" id="tabpaneldiv">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet11(11), active: isSet11(11) }">
            <div id="TabEmployee">
                <div class="row">

                    <div class="col-sm-12">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="customPara.fromdate" datepicker class="form-control datepicker" tabindex="1">
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="To Date" placeholder="dd-MM-yyyy" ng-model="customPara.todate" datepicker class="form-control datepicker" tabindex="1">
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="col-sm-8 control-label">Select Employee<sup>*</sup></label>
                                <div class="col-sm-4 show-message">
                                    <div class="common-btn">
                                        <ul class="common-btn list-inline text-right">
                                            <li><button ng-click="getAllEmployee()" class="btn" tabindex="10"><i class="glyphicon glyphicon-search"></i></button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>








                <ej-dialog id="dialogEmployeeSelect" title=" Employees" e-enablemodal="true" e-position-y="0" e-showoninit="false"
                           e-target=".site-heading" e-minwidth="1100" e-height="580" e-open="enableBtn">
                    <div class="row">
                        <div class="col-sm-12">
                            <div id="GridWorkCenterProduct" ng-init="chkinit()" ej-grid e-datasource="Employeelist"
                                 e-recorddoubleclick="selectSignleEmployee"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                 e-pagesettings-pagesize="25"
                                 e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>

                                    @*<div e-column e-field="CheckBoxSelect" e-headertext="CheckBoxSelect" e-allowediting="false" e-width="200"></div>
                                <div e-column e-field="SystemId" e-headertext="SystemId" e-allowediting="false" e-width="200"></div>*@
                                    <div e-column e-field="EmployeeCode" e-headertext="EmployeeCode" e-allowediting="false" e-width="200"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-allowediting="false" e-width="200"></div>
                                    <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="200"></div>
                                    <div e-column e-field="EmpCategoryName" e-headertext="EmpCategoryName" e-allowediting="false" e-width="200"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="200"></div>
                                    <div e-column e-field="Unit" e-headertext="Unit" e-allowediting="false" e-width="200"></div>
                                    <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="200"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="200"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="200"></div>
                                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="200"></div>

                                </div>
                            </div>
                        </div>
                    </div>

                </ej-dialog>
                <div class="row form-horizontal form-elements">
                    <div class="col-xs-12 col-sm-6 col-md-4">

                        Employee Code :   {{employees.EmployeeCode}}
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-8">

                        Employee Name :   {{employees.EmployeeName}}
                    </div>

                </div>
                <br />




            </div>
            <div id="GridAttendanceRawDataEmployeeWise" ej-grid
                 e-datasource="AttendanceRawDataEmployeeWise"
                 e-allowscrolling="true"
                 e-actioncomplete="actionCompleteSelected1"
                 e-templaterefresh="refreshTemplateAttendanceRawDataEmployeeWise"
                 e-endedit="updatedata"
                 e-rowdatabound="onrowdatabound1"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 @*e-editsettings-allowediting="true"
                 e-editsettings-editmode="dialogtemplate"
                 e-editsettings-dialogEditorTemplateID="#dialogtemplateID"*@
                 e-allowsorting="true"
                 e-enabletouch="false"
                 e-responsive="true"
                 e-allowselection="true"
                 e-pagesettings-pagesize="17"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate1" e-template="#checkboxTemplate1" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="PDate" e-headertext="PDate" e-width="90" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                    <div e-column e-field="PType" e-headertext="PType" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="PTime" e-headertext="PTime" e-allowediting="false" e-width="200"></div>
                 
                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="90" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                    <div e-column e-field="EmpCategoryName" e-headertext="EmpCategoryName" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Unit" e-headertext="Unit" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="200"></div>




                </div>
            </div>
            <script type="text/template" id="checkboxTemplate1">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>
            <script type="text/x-jsrender" id="headerTemplate1">
                <input type="checkbox" id="headchk1" />
            </script>

            <div class="row form-horizontal form-elements">
                <div class="col-xs-12 col-sm-10 col-md-12">
                    <div class="common-btn">
                        <ul class="list-inline text-right">

                            <li style="float:right"> <button ng-click="SaveDataEmployeeWise();" class="btn"><i class="glyphicon glyphicon-check"></i> Delete</button></li>
                        </ul>
                    </div>

                </div>





            </div>
        </div>


        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet22(22), active: isSet22(22) }">
            <div class="row form-horizontal form-elements">
                <div class="col-xs-12 col-sm-6 col-md-6 ">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"> Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <input class="form-control" ng-model="customPara.procdate" ng-change="datewiseEmpDataLoad()" datepicker placeholder="dd-MM-yyyy" @*value="customPara.procdate"*@ type="text" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6 ">
                    <div class="row form-horizontal form-elements">
                        <div class="col-xs-12 col-sm-10 col-md-12">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li style="float:right"> <button ng-click="GetAttendanceRawDataDateWise();" class="btn"><i class="glyphicon glyphicon-check"></i> Go</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            @*<h4>To be Confirmed (REG)</h4>*@
            <div id="Grid" ej-grid
                 e-datasource="AttendanceRawDataDateWise"
                 e-allowscrolling="true"
                 e-actioncomplete="actionCompleteSelected"
                 e-templaterefresh="refreshTemplateAttendanceRawDataDateWise"
                 e-endedit="updatedata"
                 e-rowdatabound="onrowdatabound"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 @*e-editsettings-allowediting="true"
                 e-editsettings-editmode="dialogtemplate"
                 e-editsettings-dialogEditorTemplateID="#dialogtemplateID"*@
                 e-allowsorting="true"
                 e-enabletouch="false"
                 e-responsive="true"
                 e-allowselection="true"
                 e-pagesettings-pagesize="17"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="EmployeeCode" e-headertext="EmployeeCode" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="PType" e-headertext="PType" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="PTime" e-headertext="PTime" e-allowediting="false" e-width="200"></div>
                   
                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                    <div e-column e-field="EmpCategoryName" e-headertext="EmpCategoryName" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Unit" e-headertext="Unit" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="200"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="200"></div>




                </div>
            </div>
            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>
            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
            </script>


            <div class="row form-horizontal form-elements">
                <div class="col-xs-12 col-sm-10 col-md-12">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li style="float:right"> <button ng-click="SaveData();" ng-show="ShowSaveButton" class="btn"><i class="glyphicon glyphicon-check"></i> Delete</button></li>
                        </ul>
                    </div>
                </div>
            </div>


        </div>

    </div>





</div>

