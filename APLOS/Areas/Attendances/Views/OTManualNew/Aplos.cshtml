<togglable name="{{FormTitle}}"></togglable>
<style>

    .filled {
        background-color: #ff0000 !important;
    }
</style>
<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script>
@*To Accept only Numbers*@
<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }
</script>

<div class="form-elements form-horizontal" ng-form name="OTManualForm">
    <div class="row" ng-form name="General">
        <input type="hidden" ng-model="OTManual.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>

                <div class="col-sm-8 show-message">
                    <input type="text" name="Plant" required ng-model="OTManual.PlantId" readonly class="form-control" ng-change="getEntityWithChange();" tabindex="1" maxlength="50" ng-disabled="enable">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Department</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="OTManual.DepartmentId" ng-change="GetSectionList();" ng-disabled="enable"
                                ng-options="item.Value as item.Text for item in DepartmentList" tabindex="3">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Sub-Section</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="OTManual.SubSectionId" ng-disabled="enable"
                                ng-options="item.Value as item.Text for item in SubSectionList" tabindex="5">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">OT Hour(Enter in Minutes) <sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="OT Hour" required ng-model="OTManual.OThour" class="form-control" tabindex="7" maxlength="15" ng-disabled="enable" onkeypress="return isNumber(event)">
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" ng-model="OTManual.Remarks" tabindex="9" maxlength="250"></textarea>
                </div>
            </div>


        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label" title="Entity">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="OTManual.EntityId" required id="entityId" name="Entity" ng-change="GetShift();" tabindex="2" ng-disabled="enable">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Section</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="OTManual.SectionId" ng-change="GetSubSectionList();" ng-disabled="enable"
                                ng-options="item.Value as item.Text for item in SectionList" tabindex="4">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Date" ng-model="OTManual.WorkDate" datepicker class="form-control" ng-change="ValidateSelectedDate();" required tabindex="6" ng-disabled="enable">

                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Shift</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="OTManual.ShiftSystemId"
                                ng-options="item.Value as item.Text for item in ShiftIdList" tabindex="8" ng-change="EnableDisableShift();" ng-disabled="enable">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>


        </div>
        <br />

    </div>
    <confirm-modal></confirm-modal>
    <br />
    <div class="row">
        <div class="form-elements form-horizontal" ng-form id="EmpInOutTab">
            <div class="tab-design" id="tab_show">

