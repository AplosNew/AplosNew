                    </ul>
                </div>

                <div class="tab-content">

                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

                        <div class="row" ng-form name="empinoutForm">

                            <div class="form-horizontal form-element-ctrl">

                                <div class="form-elements">

                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label" title="Employee"><span>Employee </span></label>
                                            <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">

                                                <input id="empc" type="text" class="form-control input-small" ng-model="OTManual.EmployeeCode" style="width:100px" ng-change="GetEMPSysId();" tabindex="10">
                                                <input type="text" ng-model="OTManual.EmpName" class="form-control input-small" readonly style="width:175px" ng-class="{filled:OTManual.EmployeeStatus==='Separated'}">
