                                                <span class="input-group-addon" style="float:left; width:30px"><i class="glyphicon glyphicon-time"></i></span>
                                            </div>
                                        </div>

                                     


                                    </div>

                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Day Status</label>
                                            <div class="col-sm-8">
                                                <input type="text" ng-model="OTManual.EmpDayStatus" class="form-control" style="width:275px" maxlength="15" readonly>

                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Over Stay</label>
                                            <div class="col-sm-8">
                                                <input type="text" ng-model="OTManual.EMPOThour" class="form-control" style="width:275px" maxlength="15" readonly>

                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Out Date and Time</label>
                                            <div class="col-sm-7 input-group bootstrap-timepicker timepicker" style="float:right">
                                                <input id="Time" type="text" class="form-control input-small" ng-model="OTManual.OutTime" style="margin-left:-36px; width:245px" readonly>
                                                <span class="input-group-addon" style="float:left; width:30px"><i class="glyphicon glyphicon-time"></i></span>
                                            </div>
                                        </div>


                                    </div>

                                </div>

                            </div>
                            <div class="col-xs-12">
                                <div style="color:black;" id="GridSelectedEmpINOUTTab" ej-grid e-datasource="SelectedEmpINOUTList"
                                     e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                     e-allowselection="false" e-filtersettings-filterType="excel">
                                    <div e-columns>
                                        <div e-column e-type="string" e-field="Code" e-headertext="Employee Code" e-width="30"></div>
                                        <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="30"></div>
                                        <div e-column e-type="string" e-field="APDEmpInDateAndTime" e-headertext="In Date and Time" e-width="25"></div>
                                        <div e-column e-type="string" e-field="APDEmpOutDateAndTime" e-headertext="Out Date and Time" e-width="25"></div>
                                        <div e-column e-type="string" e-field="Category" e-headertext="Day Status" e-width="15"></div>
                                        <div e-column e-type="string" e-field="OTHr" e-headertext="Current OT" e-width="15"></div>
                                        <div e-column e-type="string" e-field="ManualOT" e-headertext="Previous OT" e-width="15"></div>
                                        <div e-column e-type="string" e-field="APDEmpWorkDate" e-headertext="Work Date" e-width="25"></div>

                                        <div e-column e-template="#RemoveEMPDataTab" e-headertext="Remove" e-width="30"></div>

                                    </div>
                                </div>

                                <script type="text/template" id="RemoveEMPDataTab">
                                    <div class="common-btn">
                                        <ul class="list-inline text-left">
                                            <li><button ng-click="$parent.ConfirmRemoveEmpINOUTDataTab(data.EmployeeSystemId);" ng-disabled="data.Id!=null" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                        </ul>
                                    </div>
                                </script>

              
                            </div>
                            <div class="common-btn" style="padding-right: 15px;">
                                <ul class="list-inline text-right">
