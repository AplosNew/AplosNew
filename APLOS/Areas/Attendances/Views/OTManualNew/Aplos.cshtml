                                                    <button ng-click="EmpClear()" tabindex="12" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Manual OT</label>
