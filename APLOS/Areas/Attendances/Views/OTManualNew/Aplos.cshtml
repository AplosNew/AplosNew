                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" e-value="data.isSelected" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>
        

                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="SelectEmPDetails('EmployeePop');" class="btn"><i class=""></i> Select</button>
                            <button ng-click="closeEmpPopUp('EmployeePop');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>


<confirm-archive-generic modalid="RemoveEmpData" title="Confirmation" message="Are you sure want to Remove?" data-ng-click-right-button="RemoveEMPData();"></confirm-archive-generic>

<script type="text/javascript">
    $('[id*=Time]').timepicker({ showMeridian: false, defaultTime: false }).on('changeTime.timepicker', function (e) {
        var hours = e.time.hours, //Returns a string
            min = e.time.minutes
        //merdian = e.time.meridian;

        if (hours.length == 1) {
            $('[id*=Time]').timepicker('setTime', '0' + hours + ':' + min);

        }
    });
</script>
