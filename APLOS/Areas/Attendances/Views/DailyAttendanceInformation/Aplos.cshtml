<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Daily Attendance Information</h3>
<div class="col-xs-12" id="pagecontent">
    @*<div class="col-xs-3"><h3 class="site-heading"><span class="glyphicon glyphicon-file"></span> Daily Attendance Information</h3></div>*@
    <div class="col-md-9">
        <div class="col-md-12">
            <div class="col-xs-6 col-sm-6 col-md-6 form-elements">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Select Date</label>
                    <div class="col-sm-8 ">
                        <input type="text"  ng-model="date" datepicker class="form-control" tabindex="6">
                    </div>
                </div>
            </div>
            <div class="col-xs-5 col-sm-5 col-md-5">
                <div class="col-md-12">
                    <div class="col-xs-4 col-sm-4 col-md-4">                       
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">                       
                    </div>
                </div>
            </div>
            <div class="col-xs-1 col-sm-1 col-md-1">
                <div class="form-group">
                    <div class="common-btn">
                        <button ng-click="GetEmployeeInformation();" class="btn"> <i class="glyphicon glyphicon-download"></i>Go</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="form-horizontal form-elements">
    <div class="row">
    </div>
    <div class="row" ng-show="empGrid">
        <div class="col-sm-12">



            <div class="form-group">
                <div class="col-xs-12">

                    <div class=" col-md-12 col-sm-12">
                        <div class="radio">
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-6 col-sm-6">
                        </div>
                        <div class="col-md-2 col-sm-2">
                            <div class="form-group">
                                <label class="col-sm-6 " style="font-weight:normal;">With Color<sup></sup></label>
                                <div class="col-sm-6">
                                    <input type="checkbox" ej-checkbox class="nodetext" e-value="withColor" e-checked="withColor" e-model="withColor" />
                                </div>
                            </div>
                        </div>
                        <div class=" col-md-4 col-sm-4">

                            <div class="form-group">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li><button ng-click="GetMonthlyAttendanceSummaryReport('EXCEL');" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>



        </div>
        <br />

        <div class="col-md-12 col-sm-12">
            <div class="col-md-4 col-sm-4">
            </div>
            <div class="col-md-4 col-sm-4">
            </div>
            <div class="col-md-4 col-sm-4">
                <div class="common-btn">
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-click="showEmployeeFilterScreen()" class="btn" tabindex="10"><i class="glyphicon glyphicon-filter"></i></button></li>
                        <li><button ng-click="clearManualFilter()" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i></button></li>

                    </ul>
                </div>
            </div>
        </div>
        <div class="col-lg-12">

            <div id="empInfoGrid" ej-grid e-datasource="EmployeeListTemp" e-recorddoubleclick="Get" e-allowscrolling="true" e-pageSettings-pageSize="20"
                 e-actioncomplete="actionCompleteSelected" e-templaterefresh="refreshTemplateemployee"
                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" style="margin-left:1%">

                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                    @*<div e-column e-field="PayRollGroup" e-headertext="PayRoll Gruop" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="JobLocation" e-headertext="Job Location" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="PaymentMode" e-headertext="Payment Mode" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="BankName" e-headertext="Bank Name" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="EmployeeCurrentStatus" e-headertext="EmployeeCurrentStatus" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>*@
                    <div e-column e-field="CurrentMonthEmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>

                </div>
            </div>
        </div>

    </div>
    <div class="col-md-1">
        @*<div class="form-group">
                <div class="common-btn">
                    <button ng-click="GetEmployeeSalaryProcessedReport();" style="margin-top: 42%;margin-left: 24%; padding:31px 40px" class="btn"> <i class="glyphicon glyphicon-file"></i>Download</button>
                </div>
            </div>*@
    </div>
</div>
<ej-dialog id="empfilterPopUp" title=" Select Employees" e-enablemodal="true" e-position-y="0" e-target="#pagecontent" e-showoninit="false" e-close="onDialogClose" e-minwidth="900px" e-open="enableBtn">
    <div class="row">

        <div id="Gridemployee" ng-init="chkinit()" ej-grid e-datasource="EmployeeList" @*e-actioncomplete="actionCompleteSelected"
                         e-templaterefresh="refreshTemplateemployee"*@ e-templaterefresh="refreshTemplateemployee"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>
                <div e-column e-type="string" e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Unit" e-headertext="Unit" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="PayRollGroup" e-headertext="PayRoll Gruop" e-allowediting="false" e-width="120"></div>
                <div e-column e-field="JobLocation" e-headertext="Job Location" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="PaymentMode" e-headertext="Payment Mode" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="BankName" e-headertext="Bank Name" e-allowediting="false" e-width="80"></div>
                <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="EmployeeCurrentStatus" e-headertext="EmployeeCurrentStatus" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="SalaryProcFlag" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
            </div>
        </div>

    </div>
    <ul class="common-btn list-inline text-right" style="padding: 20px;">
        <li><button ng-click="saveemployeedata();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button></li>
        <li><button ng-click="Back();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Back</button></li>
    </ul>
</ej-dialog>

