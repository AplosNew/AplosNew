<togglable name="PF Policy"></togglable>
<div class="form-horizontal" ng-form name="stoppageNewForm" id="MainDivId">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-right: 93px;">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message" style="padding-left: 20px;padding-right: 31px;">
                    <div class="select-style">
                        <select class="form-control" ng-model="PFPolicyMaster.CompanyId" ng-change="companyOnChange();"
                                ng-options="item.Value as item.Text for item in companyList" id="CompanyId"
                                name="Company" required tabindex="1" ng-disabled="PFPolicyMaster.ID != null">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-right: 135px;">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="PFPolicyMaster.PlantID"
                                ng-options="item.Value as item.Text for item in plantList" id="plantId" ng-disabled="PFPolicyMaster.ID != null" ng-change="getData()"
                                name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>

    <input type="hidden" ng-model="ShiftTimeChangeForm.Id">
    <div class="form-elements ">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="col-sm-12">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Policy Name</label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="PFPolicyMaster.PFPolicyName" class="form-control" maxlength="100" tabindex="2">
                        </div>
                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Eligibility<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="LeaveTypeID" class="form-control" ng-model="PFPolicyMaster.Eligibility" name="Leave Type" required tabindex="1">
                                    <option value="">-Select-</option>
                                    <option Value="DOJ">DOJ</option>
                                    <option Value="DOC">DOC</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label>Eligibility base on of</label>
                            <div class="radio">
                                <label>
                                    <input type="radio" name="EligibilityDay" ng-model="PFPolicyMaster.EligibilityBaseOn" ng-change="EligibilityDay()" value="DAY">
                                    <span class="cr"><i class="cr-icon"></i></span>DAY
                                </label>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <input type="text" ng-model="PFPolicyMaster.EligibilityTimeLenghtDay" only-numbers ng-disabled="PFPolicyMaster.EligibilityBaseOn != 'DAY'" class="form-control" maxlength="100" tabindex="2">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="EligibilityMonth" ng-model="PFPolicyMaster.EligibilityBaseOn" ng-change="EligibilityMonth()" value="MONTH">
                                    <span class="cr"><i class="cr-icon"></i></span>MONTH
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <input type="text" ng-model="PFPolicyMaster.EligibilityTimeLenghtMonth" only-numbers ng-disabled="PFPolicyMaster.EligibilityBaseOn != 'MONTH'" class="form-control" maxlength="100" tabindex="2">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label>Maturity base on of</label>
                            <div class="radio">
                                <label>
                                    <input type="radio" name="MaturityDay" ng-model="PFPolicyMaster.MaturityBaseOn" ng-change="MaturityMonth()" value="MONTH">
                                    <span class="cr"><i class="cr-icon"></i></span>MONTH
                                </label>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <input type="text" ng-model="PFPolicyMaster.MaturityTimeLenghtMonth" only-numbers class="form-control" ng-disabled="PFPolicyMaster.MaturityBaseOn != 'MONTH'" maxlength="100" tabindex="2">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="MaturityMonth" ng-model="PFPolicyMaster.MaturityBaseOn" ng-change="MaturityYear()" value="YEAR">
                                    <span class="cr"><i class="cr-icon"></i></span>YEAR
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <input type="text" ng-model="PFPolicyMaster.MaturityTimeLenghtYear" only-numbers class="form-control" ng-disabled="PFPolicyMaster.MaturityBaseOn != 'YEAR'" maxlength="100" tabindex="2">
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Description</label>
                    <div class="col-sm-8">
                        <textarea type="text" ng-model="PFPolicyMaster.PFPolicyDescription" class="form-control" maxlength="100" tabindex="2"></textarea>
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="checkbox-site" style="margin-top: 6px;">
                        <label>
                            <input tabindex="2" type="checkbox" ng-model="PFPolicyMaster.IsAllEmpApplocable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>All Employee Applicable For PF
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Salary Head For Report</label>
                    <div class="col-sm-4">
                        <div class="select-style">
                            <select id="SalaryHeadId" class="form-control" ng-model="PFPolicyHead.SalaryHeadID" name="SalaryHead" required tabindex="1">
                                <option value=""> </option>
                                <option ng-repeat="option in salaryHeadList" value="{{option.Id}}">{{option.UserName}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="SubmitHeads();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Submit</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12" @*style="padding-left: 150px; margin-left: -65px;"*@>
                    <div id="Grid2" ej-grid e-datasource="HeadList" e-allowsorting="true" e-allowscrolling="true"
                         e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowResizing="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="false" e-pageSettings-pageSize="2">
                        <div e-columns>
                            <div e-column e-field="PFPolicyMasterID" e-headertext="ID" e-width="3" e-isprimarykey="true" e-visible="false"></div>
                            <div e-column e-field="SalaryHeadName" e-headertext="Salary Head" e-width="3"></div>
                            <div e-column e-headertext="Delete" e-width="3"><button data-toggle="modal" class="btn" ng-click="$parent.RemoveHead(this);" tabindex="10"><i class="glyphicon glyphicon-trash"></i></button></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveMaster();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="ClearM();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                    <ul class="list-inline text-left">
                        <li><button ng-click="AddLineIdem();" ng-disabled="PFPolicyMaster.ID==null" class="btn"><i class="glyphicon glyphicon-plus"></i>Add Line Item</button></li>
                    </ul>
                </div>
            </div>

            <div class="col-xs-12 " id="NewId">
                <div style="color:black;" id="PFBonusPolicyDetails" ej-grid e-datasource="PFPolicyDetailsList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-recorddoubleclick="recorddoubleclickDetails" e-filtersettings-filterType="excel" e-actioncomplete="actionCompleteSelected">
                    <div e-columns>
                        <div e-column e-field="FormulaDesEarning" e-headertext="FormulaDes Earning" e-width="30"></div>
                        <div e-column e-field="EarningValueRangeFrom" e-headertext="EarningVal. RangeFrom" e-width="20"></div>
                        <div e-column e-field="EarningValueRangeTo" e-headertext="EarningVal. RangeTo" e-width="20"></div>
                        <div e-column e-field="FixedValueEmp" e-headertext="FixedValue Empoyee" e-width="20"></div>
                        <div e-column e-field="FixedValueEmployer " e-headertext="FixedValue Employer" e-width="20"></div>
                        <div e-column e-field="FormulaDesEmp" e-headertext="FormulaDes Employee" e-width="30"></div>
                        <div e-column e-field="FormulaDesEmployer" e-headertext="FormulaDes Employer" e-width="35"></div>
                    </div>
                </div>
            </div>

            <confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteMaster();"></confirm-archive-generic>

        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmPopUpHead" title="Confirmation" message="{{message_confirmation}}" data-ng-click-right-button="DeleteHeadList();"></confirm-archive-generic>
<ej-dialog id="dialogPFSetting"
           title="PF Bonus Policy Details"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#MainDivId"
           e-close="onDialogClose"
           e-minwidth="930"
           e-minheight="500" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="col-sm-12">
                    <div class="checkbox-site" style="margin-top: 6px;">
                        <label>
                            <input tabindex="2" type="checkbox" ng-model="PFPolicyDetailsMaster.IsNotEntGetEmplrAlwn">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>If not entitled, Employer Contribution as an Allowance
                        </label>
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="checkbox-site" style="margin-top: 6px;">
                        <label>
                            <input tabindex="2" type="checkbox" ng-model="PFPolicyDetailsMaster.IsIndividualAlwn">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Allow Individual Allowance
                        </label>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="col-md-12 ">
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Allowance Salary Head<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="select-style">
                                <select id="SalaryHeadId" class="form-control" ng-model="PFPolicyDetailsMaster.AlwnSlrHd" name="SalaryHead" required tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in salaryHeadList" value="{{option.Id}}">{{option.UserName}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 ">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border" style="color:red">Earning Value Calculation:-</legend>
                    <div class="col-sm-12" style="margin-left:-29px">
                        <fieldset class="scheduler-border" style="width: 866px;">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Salary Head</label>
                                    <div class="col-sm-6">
                                        <div class="select-style">
                                            <select ng-model="salaryRuleGeneral.SalaryHeadIdFormula" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Id as item.UserName for item in salaryHeadList" tabindex="5">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li> <button ng-click="SetFormula('SHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Operator</label>
                                    <div class="col-sm-6">
                                        <div class="select-style">
                                            <select ng-model="salaryRuleGeneral.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="5">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li> <button ng-click="SetFormula('Operator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Precedence</label>
                                    <div class="col-sm-6">
                                        <div class="select-style">
                                            <select ng-model="salaryRuleGeneral.Precedence" class="form-control" name="Precedence" tabindex="5">
                                                <option value=""></option>
                                                <option value="(">(</option>
                                                <option value=")">)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li> <button ng-click="SetFormula('Precedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Value</label>
                                    <div class="col-sm-6">
                                        <input type="text" name="Value" ng-model="salaryRuleGeneral.Value" class="form-control" required tabindex="2" maxlength="50">
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li> <button ng-click="SetFormula('Value');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="RemoveFormula();" class="btn" tabindex="9"><i class="glyphicon glyphicon-backward"></i></button></li>
                                    </ul>
                                </div>
                                <div class="form-group">
                                    {{salaryRuleGeneral.FormulaDescription}}
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label class="col-sm-6 control-label">Earning Value Range From	</label>
                                <div class="col-sm-6">
                                    <input type="text" ng-model="PFPolicyDetailsMaster.EarningValueRangeFrom" class="form-control" maxlength="100" tabindex="2">
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="checkbox-site" style="margin-top: 6px;">
                                <label>
                                    <input tabindex="2" type="checkbox" ng-model="PFPolicyDetailsMaster.IsMandatory">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Mandatory
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">To</label>
                                <div class="col-sm-8">
                                    <input type="text" ng-model="PFPolicyDetailsMaster.EarningValueRangeTo" class="form-control" maxlength="100" tabindex="2">
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-xs-12 ">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border" style="color:red">*Employee Contribution Value Calculation*</legend>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-8 control-label">Employee Contribution Value Based On</label>
                            <div class="col-sm-2">
                                <input type="text" ng-model="PFPolicyDetailsMaster.EmpCntValPer" class="form-control" maxlength="100" tabindex="2">
                            </div>
                            <label class="col-sm-2 control-label">% Of</label>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="FixedValue" ng-model="PFPolicyDetailsMaster.IsFixedEmp" ng-change="ChangeFixedValueCheckboxEmployee()" value="FixedValue">
                                        <span class="cr"><i class="cr-icon"></i></span>Fixed Value
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <div class="col-sm-6">
                                    <input type="text" ng-model="PFPolicyDetailsMaster.FixedValueEmp" only-numbers ng-disabled="PFPolicyDetailsMaster.IsFixedEmp != 'FixedValue'" class="form-control" maxlength="100" tabindex="2">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="Formula" ng-model="PFPolicyDetailsMaster.IsFixedEmp" ng-change="ChangeEmployeeFormula()" value="Formula">
                                        <span class="cr"><i class="cr-icon"></i></span>Formula
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6" ng-show="PFPolicyDetailsMaster.IsFixedEmp != 'FixedValue'">
                            <div class="checkbox-site" style="margin-top: 6px;">
                                <label>
                                    <input tabindex="2" type="checkbox" ng-model="PFPolicyDetailsMaster.IsContributionSlrHDdependOnEarningEmp" ng-disabled="PFPolicyDetailsMaster.IsFixedEmp != 'Formula'">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Based On Netpay
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12" ng-show="PFPolicyDetailsMaster.IsFixedEmp != 'FixedValue'" style="margin-left:-29px">
                        <fieldset class="scheduler-border" style="width: 866px;">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Salary Head</label>
                                    <div class="col-sm-6">
                                        <div class="select-style">
                                            <select ng-model="salaryRuleGeneralEmployee.SalaryHeadIdFormula" id="SalaryHeadFormulaEmployee" class="form-control" name="Salary Head" ng-options="item.Id as item.UserName for item in salaryHeadList" tabindex="5">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li> <button ng-click="SetFormulaEmployee('SHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Operator</label>
                                    <div class="col-sm-6">
                                        <div class="select-style">
                                            <select ng-model="salaryRuleGeneralEmployee.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="5">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li> <button ng-click="SetFormulaEmployee('Operator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Precedence</label>
                                    <div class="col-sm-6">
                                        <div class="select-style">
                                            <select ng-model="salaryRuleGeneralEmployee.Precedence" class="form-control" name="Precedence" tabindex="5">
                                                <option value=""></option>
                                                <option value="(">(</option>
                                                <option value=")">)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li> <button ng-click="SetFormulaEmployee('Precedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Value</label>
                                    <div class="col-sm-6">
                                        <input type="text" name="Value" ng-model="salaryRuleGeneralEmployee.Value" class="form-control" required tabindex="2" maxlength="50">
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li> <button ng-click="SetFormulaEmployee('Value');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
