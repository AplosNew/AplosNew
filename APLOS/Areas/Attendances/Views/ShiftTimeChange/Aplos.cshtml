<togglable name="Shift Time Change"></togglable>
<div class="form-elements form-horizontal" ng-form name="stoppageNewForm">
    <input type="hidden" ng-model="ShiftTimeChangeForm.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label" style="color:red">From Date<sup>*</sup></label>
            <div class="col-sm-6">
                <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="ShiftTimeChangeModel.FromDate" e-width="100%" />
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Shift Name<sup>*</sup></label>
            <div class="col-sm-6">
                <div class="input-group">
                    <span class="input-group-addon">{{ShiftInfo.ShiftSystemID}}</span>
                    <input type="text" name="EmployeeName" ng-model="ShiftInfo.ShiftDefinationName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button name="submit" ng-click="GetShiftInfo()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-6">
                <input type="text" ng-model="ShiftInfo.ShiftDefinationDescription" class="form-control" maxlength="100" tabindex="2" readonly>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label" style="color:red">To Date<sup>*</sup></label>
            <div class="col-sm-6">
                <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="ShiftTimeChangeModel.ToDate" e-width="100%" />
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Shift Type</label>
            <div class="col-sm-6">
                <input type="text" ng-model="ShiftInfo.ShiftType" class="form-control" maxlength="100" tabindex="2" readonly>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-6">
                <input type="text" ng-model="ShiftTimeChangeModel.Remarks" class="form-control" maxlength="100" tabindex="2">
            </div>
        </div>
    </div>

    <div class="col-xs-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">In-Time Information</legend>
            <div class="col-xs-12 col-sm-6 col-md-6 ">

                <div class="form-group">
                    <label class="col-sm-3 control-label" style="color:red">In-Time<sup>*</sup></label>
                    <input class="col-sm-6" type="text" ej-timepicker e-value="ShiftTimeChangeModel.InTime" e-width="80%" />
                </div>

                <div class="form-group">
                    <label class="col-sm-5 control-label">Late margin(Min/Sec after In-Time)</label>
                    <div class="col-sm-2">
                        <input type="text" ng-model="ShiftTimeChangeModel.LateMargin" class="form-control" only-numbers maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                    <div class="col-sm-2">
                        <input type="text" ng-model="ShiftTimeChangeModel.LateMarginSeconds" class="form-control" only-numbers maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label" style="left:-25px;">[sec]</label>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6 ">

                <div class="form-group">
                    <label class="col-sm-7 control-label" style="color:red">In-Time start margin (min before In-Time)</label>
                    <div class="col-sm-3">
                        <input type="text" ng-model="ShiftTimeChangeModel.InTimeStartMargin" class="form-control" only-numbers maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                </div>

                <div class="form-group">
                    <label class="col-sm-7 control-label"> Absent End Margin (min after In-Time)</label>
                    <div class="col-sm-3">
                        <input type="text" ng-model="ShiftTimeChangeModel.AbsentEndMargin" class="form-control" only-numbers maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                </div>
            </div>
        </fieldset>
    </div>

    <div class="col-xs-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Out-Time Information</legend>

            <div class="col-xs-12 col-sm-6 col-md-6 ">


                <div class="form-group">
                    <label class="col-sm-3 control-label" style="color:red">Out-Time<sup>*</sup></label>
                    <input class="col-sm-6" type="text" ej-timepicker e-value="ShiftTimeChangeModel.OutTime" e-width="80%" />
                </div>

                <div class="col-sm-12">
                    <div class="form-group">
                        <label class="col-sm-5 control-label">OT start time (min after Out-Time)<sup>*</sup></label>
                        <div class="col-sm-2">
                            <input type="text" ng-model="ShiftTimeChangeModel.OTStartTime" class="form-control" only-numbers maxlength="100" tabindex="2">
                        </div>
                        <label class="col-sm-1 control-label" style="left:-25px;">[min]</label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Consider as OT</label>
                    <div class="col-sm-1">
                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="ShiftTimeChangeModel.IsGapInclude">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                    <label class="col-sm-6 control-label">The gap between out time & OT start time</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">IN after OUT as OT start Time</label>
                    <div class="col-sm-1">
                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="ShiftTimeChangeModel.INAfterOUTAsOTStart">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-xs-12 col-sm-6 col-md-6 ">

                <div class="col-sm-12">
                    <div class="form-group">
                        <label class="col-sm-7 control-label">Out-Time end margin (min after Out-Time)<sup>*</sup></label>
                        <div class="col-sm-3">
                            <input type="text" ng-model="ShiftTimeChangeModel.OutTimeEndMargin" class="form-control" only-numbers maxlength="100" tabindex="2">
                        </div>
                        <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="form-group">
                        <label class="col-sm-7 control-label" style="color:blue">Working Time [min]</label>
                        <div class="col-sm-3">
                            <input type="text" ng-model="ShiftTimeChangeModel.WorkingHour" readonly class="form-control" only-numbers maxlength="100" tabindex="2">
                        </div>
                        <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                    </div>
                </div>

            </div>

        </fieldset>
    </div>

    <div class="col-xs-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Break-Time Information</legend>

            <div class="col-xs-12 col-sm-6 col-md-6 ">

                <div class="form-group">
                    <label class="col-sm-3 control-label">Break Start Time<sup>*</sup></label>
                    <input class="col-sm-6" type="text" ej-timepicker e-value="ShiftTimeChangeModel.BreakStratTime" e-width="80%" />
                </div>

                <div class="form-group">
                    <label class="col-sm-5 control-label" style="color:blue">Break Period</label>
                    <div class="col-sm-2">
                        <input type="text" ng-model="ShiftTimeChangeModel.BreakPeriod" only-numbers readonly class="form-control" maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                </div>

                <div class="form-group">
                    <div class="col-sm-12">
                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="ShiftTimeChangeModel.IsLunchOutApplicable">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Lunch Out Applicable
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Late In Applicable</label>
                    <div class="col-sm-1">
                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="ShiftTimeChangeModel.IsLateInApplicable" ng-change="ChangeLateInApplication()">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>

                    <label class="col-sm-4 control-label">Late In Max Limite</label>
                    <div class="col-sm-2">
                        <input type="text" ng-model="ShiftTimeChangeModel.LateInMaxLimit" ng-disabled="!ShiftTimeChangeModel.IsLateInApplicable" only-numbers class="form-control" maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                </div>

                <div class="form-group">
                    <label class="col-sm-5 control-label">Late IN Tolarance Margin</label>
                    <div class="col-sm-2">
                        <input type="text" ng-model="ShiftTimeChangeModel.LateInToleranceMargin" ng-disabled="!ShiftTimeChangeModel.IsLateInApplicable" only-numbers class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>

            </div>

            <div class="col-xs-12 col-sm-6 col-md-6 ">


                <div class="form-group">
                    <label class="col-sm-3 control-label">Break End Time<sup>*</sup></label>
                    <input class="col-sm-6" type="text" ej-timepicker e-value="ShiftTimeChangeModel.BreakEndTime" e-width="80%" />
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Break Period</label>
                    <div class="col-sm-1">
                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="ShiftTimeChangeModel.IncludeBreakTimeInOT">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                    <label class="col-sm-5 control-label">Include in Working Hour</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-7 control-label">Half Day Absent max Limit</label>
                    <div class="col-sm-3">
                        <input type="text" ng-model="ShiftTimeChangeModel.HalfDayAbsentMaxLimit" class="form-control" only-numbers maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Early Out Applicable</label>
                    <div class="col-sm-1">
                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="ShiftTimeChangeModel.IsEarlyOutApplicable" ng-change="ChangeEarlyOutApplication()">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                    <label class="col-sm-3 control-label">Early Out Max Limit</label>
                    <div class="col-sm-3">
                        <input type="text" ng-model="ShiftTimeChangeModel.EarlyOutMaxLimit" ng-disabled="!ShiftTimeChangeModel.IsEarlyOutApplicable" only-numbers class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Early Out Tolarance Margin</label>
                    <div class="col-sm-3">
                        <input type="text" ng-model="ShiftTimeChangeModel.EarlyOutToleranceMargin" ng-disabled="!ShiftTimeChangeModel.IsEarlyOutApplicable" only-numbers class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>
            </div>

        </fieldset>
    </div>


    <div class="col-xs-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Raw Punch Defination</legend>
            <div class="col-xs-12 col-sm-6 col-md-6 ">

                <div class="form-group">
                    <label class="col-sm-5 control-label">Raw IN Definition From</label>
                    <div class="col-sm-3">
                        <input type="text" ng-model="ShiftTimeChangeModel.RawINDefinitionFrom" only-numbers class="form-control" maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                </div>

                <div class="form-group">
                    <label class="col-sm-5 control-label">Raw OUT Definition From</label>
                    <div class="col-sm-3">
                        <input type="text" ng-model="ShiftTimeChangeModel.RawOUTDefinitionFrom" only-numbers class="form-control" maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                </div>

            </div>

            <div class="col-xs-12 col-sm-6 col-md-6 ">

                <div class="form-group">
                    <label class="col-sm-5 control-label">Raw IN Definition To</label>
                    <div class="col-sm-3">
                        <input type="text" ng-model="ShiftTimeChangeModel.RawINDefinitionTo" only-numbers class="form-control" maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                </div>

                <div class="form-group">
                    <label class="col-sm-5 control-label">Raw OUT Definition To</label>
                    <div class="col-sm-3">
                        <input type="text" ng-model="ShiftTimeChangeModel.RawOUTDefinitionTo" only-numbers class="form-control" maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label"  style="left:-25px;">[min]</label>
                </div>

            </div>

        </fieldset>
    </div>


    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i></button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="12"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="13"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>

</div>

        <div class="table-responsive aplos-grid-toggle">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div style="color:black;" id="GridShiftTimeChange" ej-grid e-datasource="ModelList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                     e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="SystemID" e-headertext="SystemID" e-width="60"></div>
                        <div e-column e-field="ShiftDefinationName" e-headertext="ShiftDefinationName" e-width="130"></div>
                        <div e-column e-field="ShiftType" e-headertext="ShiftType" e-width="60"></div>
                        <div e-column e-field="FromDate" e-headertext="FromDate" e-width="80"></div>
                        <div e-column e-field="ToDate" e-headertext="ToDate" e-width="80"></div>
                        <div e-column e-field="InTime" e-headertext="InTime" e-width="70"></div>
                        <div e-column e-field="OutTime" e-headertext="OutTime" e-width="70"></div>
                        <div e-column e-field="BreakStratTime" e-headertext="BreakStratTime" e-width="70"></div>
                        <div e-column e-field="BreakEndTime" e-headertext="BreakEndTime" e-width="70"></div>
                        <div e-column e-field="BreakPeriod" e-headertext="BreakPeriod" e-width="60"></div>
                        <div e-column e-field="InTimeStartMargin" e-headertext="InTimeStartMargin" e-width="60"></div>
                        <div e-column e-field="LateMargin" e-headertext="LateMargin" e-width="60"></div>
                        <div e-column e-field="AbsentEndMargin" e-headertext="AbsentEndMargin" e-width="60"></div>
                        <div e-column e-field="OutTimeEndMargin" e-headertext="OutTimeEndMargin" e-width="60"></div>
                        <div e-column e-field="OTStartTime" e-headertext="OTStartTime" e-width="60"></div>
                        <div e-column e-field="WorkingHour" e-headertext="WorkingHour" e-width="60"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade site-modal in" id="ShiftPopUp" role="dialog" data-backdrop="static">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        Shift List
                        <button type="button" class="close" ng-click="closeShiftPopUp();">&times;</button>
                    </div>
                    <div class="modal-body">
                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="GridShift" ej-grid e-datasource="dataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-recorddoubleclick="SetShiftData" e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                    <div e-column e-field="ShiftDefinationName" e-headertext="ShiftDefinationName" e-width="140"></div>
                                    <div e-column e-field="ShiftDefinationDescription" e-headertext="ShiftDefinationDescription" e-width="140"></div>
                                    <div e-column e-field="InTime" e-headertext="InTime" e-width="90"></div>
                                    <div e-column e-field="OutTime" e-headertext="OutTime" e-width="90"></div>
                                    <div e-column e-field="BreakStratTime" e-headertext="BreakStratTime" e-width="90"></div>
                                    <div e-column e-field="BreakEndTime" e-headertext="BreakEndTime" e-width="90"></div>
                                    <div e-column e-field="BreakPeriod" e-headertext="BreakPeriod" e-width="80"></div>
                                    <div e-column e-field="InTimeStartMargin" e-headertext="InTimeStartMargin" e-width="80"></div>
                                    <div e-column e-field="LateMargin" e-headertext="LateMargin" e-width="80"></div>
                                    <div e-column e-field="AbsentEndMargin" e-headertext="AbsentEndMargin" e-width="80"></div>
                                    <div e-column e-field="LateInToleranceMargin" e-headertext="LateInToleranceMargin" e-width="80"></div>
                                    <div e-column e-field="OutTimeEndMargin" e-headertext="OutTimeEndMargin" e-width="80"></div>
                                    <div e-column e-field="OTStartTime" e-headertext="OTStartTime" e-width="80"></div>
                                    <div e-column e-field="WorkingHour" e-headertext="WorkingHour" e-width="80"></div>
                                    <div e-column e-field="IsActive" e-headertext="IsActive" e-width="80"></div>
                                    <div e-column e-field="DefaultShift" e-headertext="DefaultShift" e-width="80"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer common-btn">
                        <button ng-click="closeShiftPopUp();" class="btn"><i class=""></i> Close</button>
                    </div>
                </div>
            </div>
        </div>

        <confirm-modal></confirm-modal>
