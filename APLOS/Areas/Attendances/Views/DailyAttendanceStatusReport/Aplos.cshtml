<h3 class="site-heading"><span class="glyphicon glyphicon-file"></span> Daily Attendance Status Report</h3>

<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">
        <div class="col-md-12 col-sm-12 col-md-12">
            <div class="col-md-6 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Select Date</label>
                    <div class="col-sm-8">
                        <input e-watermarktext="Workdate" required e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="effectiveDate" e-width="100%" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Shift</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select id="shiftList" class="form-control" ng-model="shift" name="subSectionId" tabindex="3" @*ng-change="changeLineBySubSection();"*@>
                                <option value="All">--All--</option>
                                <option ng-repeat="option in ShiftList" value="{{option.SystemID}}">{{option.ShiftType}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Previous Date<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="Prev" e-width="100%" e-change="empGridShow" />
                    </div>
                </div>                
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li>
                        <a class="btn" style="color: #f3f3ec;background-color: #1c1f32;height: 30px;"
                           href="Attendances/DailyAttendanceStatusReport/GetDailyAttendanceStatusReportView?workDate={{effectiveDate}}"
                           target="_blank"><i class="fa fa-eye" style="margin: -6px;"> View</i></a>
                    </li>
                    <li><button ng-click="GetDailyAttendanceStatusReport();" class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button></li>
                </ul>
            </div>
            <div class="row" style="margin-top:10px;">
                <div id="InfoGrid"></div>
            </div>
        </div>

    </div>
</div>

<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
    <div class="bounce3"></div>
</div>

