<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="form-horizontal form-elements">
    <div class="row">

        <div class="col-sm-12">
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">                        
                        <input type="text" name="Form Date" required e-dateformat="dd-MMM-yyyy" ng-model="FromDateSingleDate" datepicker class="form-control" ng-change="empGridShow();">
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Form Date" required e-dateformat="dd-MMM-yyyy" ng-model="ToDate" datepicker class="form-control" ng-change="">
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="form-group">
                    <div class="common-btn">
                        <button ng-click="selectSigleDate();getEmployee();" class="btn"> <i class="glyphicon glyphicon-download"></i>Go</button>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-3">
                <div class="common-btn" ng-show="empGrid">
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-click="showEmployeeFilterScreen()" class="btn" tabindex="10"><i class="glyphicon glyphicon-filter"></i></button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row" ng-show="empGrid">
        <div class="col-sm-12">
            <div id="GridChangeAttendanceBySingleDate" ej-grid e-datasource="employeeAttendanceBySingleDate"
                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                 e-allowscrolling="true" e-minheight="400" e-gridlines="none" e-querycellinfo="queryCellInfo"
                 e-actioncomplete="actionCompleteSingleDay" e-height="400px" e-rowdatabound="rowDataBoundSingleEmployee"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    @*<div e-column e-headertext="Check" e-template="#checkbox" e-width="50"></div>*@
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80" e-primarykey="true"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="150"></div>
                    <div e-column e-field="WorkDate" e-format="{0:dd-MMM-yyyy}" e-allowediting="false" e-type="date" e-headertext="Work Date" e-width="80"></div>
                    @*<div e-column e-field="Todate" e-format="{0:dd-MMM-yyyy}" e-allowediting="false" e-type="date" e-headertext="To Date" e-width="80"></div>*@
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                    <div e-column e-headertext="Actions" e-template="#DeleteButton" e-width="20"></div>
                </div>
            </div>
        </div>
        <script type="text/template" id="DeleteButton" >
            <button ng-show="data.Id" style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash"  ng-click="$parent.removeDetail(this);" style="margin: -6px;"></i></button>
        </script>
    </div>
    <div class="row" ng-show="empGrid">
        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li>  <button type="button" ng-click="Save()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>



<div class="modal fade site-modal in" id="empfilterPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Select Employees<button type="button" class="close" data-dismiss="modal">&times;</button></div>

            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="content-container-fluid">

                    <div id="Gridemployee" ej-grid e-datasource="EmployeeList" 
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-headertext="" @*e-headertemplateid="#headerTemplate"*@ e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Unit" e-headertext="Unit" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                            <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                        </div>
                    </div>
                </div>
                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="nodetext" e-value="data.isToBeSelect" e-checked="data.isToBeSelect" />
                </script>
                <script type="text/x-jsrender" id="headerTemplate">
                    <input type="checkbox" id="headchk" />
                </script>
            </div>
            <ul class="common-btn list-inline text-right" style="padding: 20px;">
                <li><button ng-click="saveemployeedata();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button></li>
                <li><button ng-click="Back();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Back</button></li>
            </ul>

        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmBoMDetailPopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="DeleteDetail();"></confirm-archive-generic>
