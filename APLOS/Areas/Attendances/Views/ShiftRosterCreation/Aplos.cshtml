
<togglable name="Roster Creation"></togglable>
<div class="form-elements form-horizontal" ng-form id="ShiftRosterCreation" name="ShiftRosterCreation">

    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">

            <div class="form-group col-xs-6">
                <label class="col-md-3 control-label">Roster Name :</label>
                <div class="col-md-9">
                    <label class="col-md-3 control-label" ng-show="false">{{master.SystemId}}</label>
                    <input type="text" placeholder="Shift Roster" ng-model="master.ShiftRosterName" class="form-control" required tabindex="1">
                </div>
            </div>

            <div class="form-group col-xs-6">
                <label class="col-md-3 control-label">Description :</label>
                <div class="col-md-9">
                    <textarea type="text" rows="2" placeholder="Description" ng-model="master.ShiftRosterDescription" class="form-control" required tabindex="1" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-md-3 control-label">Rostering Pattern :</label>
                <div class="col-md-9">

                    <div class="form-group">
                        <div class="radio col-md-4">
                            <label>
                                <input type="radio" name="groupitem" ng-click="Change();" value="IndividualWeekOff" ng-model="master.RosteringPattern">
                                <span class="cr"><i class="cr-icon"></i></span>Change After Individual Weekoff
                            </label>
                        </div>
                    </div>


                    <div class="form-group col-xs-6">
                        <div class="form-group">
                            <div class="radio col-md-6">
                                <label>
                                    <input type="radio" name="groupitem" ng-model="master.RosteringPattern" value="ChangeAfterDayLength" ng-change="ChangeAfterDay()">
                                    <span class="cr"><i class="cr-icon"></i></span>Change After Day-Length
                                </label>
                            </div>
                            <div class="col-md-6">
                                <input type="text" ng-model="master.ChangeAfterDayLength" class="form-control" ng-disabled="master.RosteringPattern !== 'ChangeAfterDayLength'" only-numbers tabindex="1">
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-xs-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Effective Date</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="master.EffectiveDate" ng-disabled="master.RosteringPattern !== 'ChangeAfterDayLength'" datepicker class="form-control datepicker" tabindex="1">
                            </div>
                        </div>
                    </div>


                    <div class="form-group">
                        <div class="radio col-md-4">
                            <label>
                                <input type="radio" name="groupitem" ng-model="master.RosteringPattern" ng-change="changeWeeklyon()" value="WeekDays">
                                <span class="cr"><i class="cr-icon"></i></span>Change Weekly On
                            </label>
                        </div>

                        <div class="col-md-6">
                            <div class="select-style">
                                <select id="Month" class="form-control" ng-model="master.WeekDays" ng-disabled="master.RosteringPattern !== 'WeekDays'" name="MonthId" required tabindex="1">

                                    <option value="">--Select--</option>
                                    <option Value="Sunday">Sunday</option>
                                    <option Value="Monday">Monday</option>
                                    <option Value="Tuesday">Tuesday</option>
                                    <option Value="Wednesday">Wednesday</option>
                                    <option Value="Thursday">Thursday</option>
                                    <option Value="Friday">Friday</option>
                                    <option Value="Saturday">Saturday</option>

                                </select>
                            </div>
                        </div>

                    </div>

                    <div class="form-group">

                        <div class="radio col-md-4">
                            <label>
                                <input type="radio" name="groupitem" ng-model="master.RosteringPattern" ng-change="changeSpecific()" value="MultiDate">
                                <span class="cr"><i class="cr-icon"></i></span>On Specific Date
                            </label>
                        </div>

                        <div class="col-sm-4">
                            <div class="form-group">
                                <div class="col-sm-12">

                                    <input type="text" placeholder="Input Ex. [7, 10, 14]" ng-disabled="master.RosteringPattern !== 'MultiDate'" ng-model="master.MultiDate" class="form-control" required tabindex="1">
                                </div>
                            </div>
                        </div>

                    </div>


                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="SearchShift();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Add Shift</button></li>
        </ul>
    </div>
    <hr />

    <div class="row ">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="table-responsive modal-table">

                <table class="table table-striped">

                    <thead>
                        <tr>
                            <th></th>
                            <th>SystemId</th>
                            <th>ShiftDefinationName</th>
                            <th>ShiftDefinationDescription</th>
                            <th>ShiftType</th>
                            <th>InTime</th>
                            <th>OutTime</th>
                            <th>ShiftSequence</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr ng-repeat="x in detail">
                            <td ng-show="detail.length>1">
                                <span ng-show="!$first" ng-click="moveUp($index,'detail')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                <br />
                                <span ng-show="!$last" ng-click="moveDown($index,'detail')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                            </td>
                            <td>{{x.ShiftDefinationID}}</td>
                            <td>{{x.ShiftDefinationName}}</td>
                            <td>{{x.ShiftDefinationDescription}}</td>
                            <td>{{x.ShiftType}}</td>
                            <td>{{x.InTime}}</td>
                            <td>{{x.OutTime}}</td>
                            <td>{{x.ShiftSequence}}</td>
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="DeleteShift(x)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                            <i class="glyphicon glyphicon-remove"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="common-btn" ng-show="detail.length>0">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i>Save</button></li>
            <li><button ng-click="Clear(master);" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div style="color:black;"
             id="Griddetail"
             ej-grid e-datasource="LoadRosterList"
             e-recorddoubleclick="SelectedRoster"
             e-gridlines="vertical"
             e-allowfiltering="true"
             e-allowpaging="true"
             e-allowsorting="true"
             e-allowselection="true"
             e-filtersettings-filterType="excel" e-allowtouch="true">
            <div e-columns>
                <div e-column e-field="SystemId" e-headertext="SystemId" e-width="80"></div>
                <div e-column e-field="ShiftRosterName" e-headertext="Name" e-width="80"></div>
                <div e-column e-field="ShiftRosterDescription" e-headertext="Description" e-width="100"></div>
                @*<div e-column e-field="IsChangeAfterIndividualWeekoff" e-headertext="IsChangeAfterIndividualWeekoff" e-width="80"></div>*@
                @*<div e-column e-field="IsChangeAfterDayLength" e-headertext="IsChangeAfterDayLength" e-width="50"></div>*@
                <div e-column e-field="ChangeAfterDayLength" e-headertext="ChangeAfterDayLength" e-width="50"></div>
                @*<button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-edit" ng-click="$parent.EditFinalSettlement($event);" style="margin: -6px;"></i></button>*@
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.remove($event);" style="margin: -6px;"></i></button>
            </div>
        </div>
    </div>
</div>
<hr />

<hr />


<ej-dialog id="dialogShiftInfo"
           title=" Shift Information"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target=".site-heading"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="500" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;"
                 id="GridSearchShiftList"
                 ej-grid e-datasource="SearchShiftList"
                 e-recorddoubleclick="SelectedShift"
                 e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowselection="true"
                 e-pagesettings-pagesize="25"
                 e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>

                    <div e-column e-field="ShiftDefinationID" e-headertext="SystemId" e-width="70"></div>
                    <div e-column e-field="ShiftDefinationName" e-headertext="Shift Name" e-width="70"></div>
                    <div e-column e-field="ShiftDefinationDescription" e-headertext="Description" e-width="100"></div>
                    <div e-column e-field="ShiftType" e-headertext="Shift Type" e-width="40"></div>
                    <div e-column e-field="ShiftSequence" e-headertext="Seq" e-width="20"></div>
                    <div e-column e-field="InTime" e-headertext="InTime" e-width="30"></div>
                    <div e-column e-field="LateMargin" e-headertext="Late Margin" e-width="30"></div>
                    <div e-column e-field="OutTime" e-headertext="OutTime" e-width="30"></div>
                    <div e-column e-field="DefaultShift" e-headertext="Default" e-width="30"></div>
                </div>
            </div>
        </div>
    </div>

</ej-dialog>

<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteRow()">
</confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
