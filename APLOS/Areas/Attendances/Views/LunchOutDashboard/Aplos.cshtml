    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Details </a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Previous Day Status</a></li>
            </ul>
        </div>
        <div class="tab-content" id="tabpaneldiv">
            <br />
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="form-elements form-horizontal" ng-form>
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <div class="form-group">
                                <label class="col-sm-12 control-label" style="text-align:center"><b>{{EmpModel.TodaysDate}}</b></label>
                            </div>
                            <div class="form-elements ">
                                <div class=" col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label"><b>Day Status</b></label>
                                        <label class="col-sm-6 control-label" style="color:{{clr}};">{{EmpModel.DayStatus}}</label>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label"><b>Shift InTime</b></label>
                                        <label class="col-sm-6 control-label">{{EmpModel.ShiftInTime}}</label>
