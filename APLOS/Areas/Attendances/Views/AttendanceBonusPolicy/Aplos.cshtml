<togglable name="Attendance Bonus Policy"></togglable>
<div class="form-horizontal" id="MainDivId">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-left: -95px;">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message" style="margin-left: 95px;">
                    <div class="select-style">
                        <select class="form-control" ng-model="AttendanceBPMaster.CompanyId" ng-change="companyOnChange();"
                                ng-options="item.Value as item.Text for item in companyList" id="plantId" ng-disabled="AttendanceBPMaster.MID != null"
                                name="Company" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-left: -120px;">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message" style="margin-left: 120px;">
                    <div class="select-style">
                        <select class="form-control" ng-model="AttendanceBPMaster.PlantID"
                                ng-options="item.Value as item.Text for item in plantList" ng-disabled="AttendanceBPMaster.MID != null" id="plantId" ng-change="getMaster();"
                                name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-elements ">
        <input type="hidden" ng-model="ShiftTimeChangeForm.Id">
        <div class="row">

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Policy Name</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="AttendanceBPMaster.AttenBnsPolicyName" class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Description</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="AttendanceBPMaster.AttenBnsPolicyDescription" class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>
            </div>

            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveMaster();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="ClearM(AttendanceBPMaster);" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                    <ul class="list-inline text-left">
                        <li><button ng-click="AddLineIdem();" ng-disabled="AttendanceBPMaster.MID==null" class="btn"><i class="glyphicon glyphicon-plus"></i>Add Line Item</button></li>
                    </ul>
                </div>
            </div>


            <div class="col-xs-12 col-sm-12 col-sm-12" id="NewId">
                <div style="color:black;" id="AttendanceBonusD" ej-grid e-datasource="AttendanceBonusDetailsList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-recorddoubleclick="recorddoubleclickDetails" e-filtersettings-filterType="excel" e-actioncomplete="actionCompleteSelected">
                    <div e-columns>

                        <div e-column e-field="FixedOrFormula" e-headertext="Fixed Or Formula" e-width="70"></div>
                        <div e-column e-field="FixedValue" e-headertext="Fixed Value" e-width="70"></div>
                        <div e-column e-field="FormulaDes" e-headertext="Formula Description" e-width="70"></div>
                        <div e-column e-field="IsEarlyOutApplicable" e-headertext="EarlyOut Applicable" e-width="70"></div>
                        <div e-column e-field="IsLateInApplicable" e-headertext="LateIn Applicable" e-width="80"></div>
                        <div e-column e-field="EOLIFromValue" e-headertext="EarlyOut LunchOut From Value" e-width="60"></div>
                        <div e-column e-field="EOLIToValue" e-headertext="EarlyOut LunchOut TO Value" e-width="60"></div>
                        <div e-column e-field="IsLunchOutApplicable " e-headertext="LunchOut Applicable" e-width="60"></div>
                        <div e-column e-field="MaxEncashment" e-headertext="Max Encashment" e-width="60"></div>
                        <div e-column e-field="MaxEncashmentLapse" e-headertext="Max Encashment Lapse" e-width="60"></div>

                    </div>
                </div>
            </div>

            <confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteMaster();"></confirm-archive-generic>

        </div>
    </div>
    </div>

    <ej-dialog id="dialogEmployeeInfo"
               title="Attendance Bonus Policy Detail"
               e-enablemodal="true"
               e-position-y="0"
               e-showoninit="false"
               e-target="#MainDivId"
               e-close="onDialogClose"
               e-width="1050"
               e-minheight="400" e-open="enableBtn">
        <div class="row">

            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="form-group">
                    <label class="col-sm-12 control-label" style="color:red">
                        **Attendance bonus will be applicable if the below conditions are satisfied **
                    </label>
                </div>
                <div class="col-xs-12 form-element-ctrl form-horizontal" ng-show="ShowDiv">
                    <div class="col-xs-12">
                        <fieldset class="scheduler-border">
                            <legend class="scheduler-border">Attendance Bonus Wise Value Calculation</legend>

                            <div class="col-sm-12">

                                <div class="col-sm-3">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="8" type="checkbox" ng-model="AttendanceBP.IsEarlyOutApplicable" ng-change="ChangeEarlyOut()">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Early Out Applicable
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-12">

                                <div class="col-sm-4">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="5" type="checkbox" ng-model="AttendanceBP.IsLateInApplicable" ng-change="ChangeEarlyOut()">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Late In Applicable
                                        </label>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Count Between</label>
                                        <div class="col-sm-8">
                                            <input type="text" ng-model="AttendanceBP.EOLIFromValue" ng-disabled="!AttendanceBP.IsEarlyOutApplicable && !AttendanceBP.IsLateInApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">To</label>
                                        <div class="col-sm-10">
                                            <input type="text" ng-model="AttendanceBP.EOLIToValue" ng-disabled="!AttendanceBP.IsEarlyOutApplicable && !AttendanceBP.IsLateInApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="col-sm-12">
                                <div class="col-sm-4">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="8" type="checkbox" ng-model="AttendanceBP.IsLunchOutApplicable" ng-change="ChangeLunchOut()">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Lunch Out Applicable
                                        </label>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Count Between</label>
                                        <div class="col-sm-8">
                                            <input type="text" ng-model="AttendanceBP.LunchOutFromValue" ng-disabled="!AttendanceBP.IsLunchOutApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">To</label>
                                        <div class="col-sm-10">
                                            <input type="text" ng-model="AttendanceBP.LunchOutToValue" ng-disabled="!AttendanceBP.IsLunchOutApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-sm-12">

                                <div class="col-sm-4">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="8" type="checkbox" ng-model="AttendanceBP.IsAbsentApplicable" ng-change="ChangeAbsent()">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Absent Applicable
                                        </label>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Count Between</label>
                                        <div class="col-sm-8">
                                            <input type="text" ng-model="AttendanceBP.AbsentFromValue" ng-disabled="!AttendanceBP.IsAbsentApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">To</label>
                                        <div class="col-sm-10">
                                            <input type="text" ng-model="AttendanceBP.AbsentToValue" ng-disabled="!AttendanceBP.IsAbsentApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="col-sm-12">
                                <div class="col-sm-4">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="8" type="checkbox" ng-model="AttendanceBP.IsLateApplicable" ng-change="ChangeLate()">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Late Applicable
                                        </label>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Count Between</label>
                                        <div class="col-sm-8">
                                            <input type="text" ng-model="AttendanceBP.LateFromValue" ng-disabled="!AttendanceBP.IsLateApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">To</label>
                                        <div class="col-sm-10">
                                            <input type="text" ng-model="AttendanceBP.LateToValue" ng-disabled="!AttendanceBP.IsLateApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-sm-12">
                                <div class="col-sm-1">

                                </div>

                                <div class="col-sm-11">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="2" type="checkbox" ng-model="AttendanceBP.IsRouteApplicableForLate">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Including Route Availing Employees
                                        </label>
                                    </div>
                                </div>

                            </div>



                            <div class="col-sm-12">
                                <div class="col-sm-4">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="8" type="checkbox" ng-model="AttendanceBP.IsLeaveApplicable" ng-change="ChangeLeave()">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Leave Applicable
                                        </label>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Count Between</label>
                                        <div class="col-sm-8">
                                            <input type="text" ng-model="AttendanceBP.LeaveFromValue" ng-disabled="!AttendanceBP.IsLeaveApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">To</label>
                                        <div class="col-sm-4">
                                            <input type="text" ng-model="AttendanceBP.LeaveToValue" ng-disabled="!AttendanceBP.IsLeaveApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="common-btn">
                                                <ul class="list-inline text-left">
                                                    <li><button ng-click="OpenAdditionalPolicyDialog();" class="btn"><i class="glyphicon glyphicon-plus"></i></button></li>
                                                </ul>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>

                            <div class="col-sm-12">
                                <div class="col-sm-4">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="8" type="checkbox" ng-model="AttendanceBP.IsLeaveWithOutPayApplicable" ng-change="ChangeLeaveWithOut()">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Leave WithOut Pay Applicable
                                        </label>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Count Between</label>
                                        <div class="col-sm-8">
                                            <input type="text" ng-model="AttendanceBP.LeaveWithOutPayFromValue" ng-disabled="!AttendanceBP.IsLeaveWithOutPayApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">To</label>
                                        <div class="col-sm-10">
                                            <input type="text" ng-model="AttendanceBP.LeaveWithOutPayToValue" ng-disabled="!AttendanceBP.IsLeaveWithOutPayApplicable" class="form-control" maxlength="100" tabindex="2" only-numbers>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12 ">
                                <div class="col-xs-4 ">
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="Fixed" ng-model="AttendanceBP.FixedOrFormula" value="Fixed">
                                            <span class="cr"><i class="cr-icon"></i></span>Fixed Value
                                        </label>
                                    </div>
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="Formula" ng-model="AttendanceBP.FixedOrFormula" value="Formula" ng-change="ChangeFixedValue()">
                                            <span class="cr"><i class="cr-icon"></i></span>Formula
                                        </label>
                                    </div>
                                </div>

                                <div class="col-xs-12 col-sm-4">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"></label>
                                        <div class="col-sm-8">
                                            <input type="text" ng-model="AttendanceBP.FixedValue" ng-show="AttendanceBP.FixedOrFormula=='Fixed'" only-numbers class="form-control" maxlength="100" tabindex="2">
                                        </div>
                                    </div>
                                </div>

                            </div>



                            <div class="row col-md-12" style="margin-left:-10px" ng-show="AttendanceBP.FixedOrFormula=='Formula'">
                                <fieldset class="scheduler-border" style="width:937px ;padding:15px !important">

                                    <div class="col-xs-12 col-sm-6 col-md-6">

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Salary Head</label>
                                            <div class="col-sm-6">
                                                <div class="select-style">

                                                    <select id="SalaryHeadFormula" class="form-control" ng-model="salaryRuleGeneral.SalaryHeadIdFormula" name="SalaryHeadType" tabindex="1">
                                                        <option value="">--Select--</option>
                                                        <option ng-repeat="option in SalaryHeadlist" value="{{option.SalaryHeadID}}">{{option.SalaryHead}}</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('SHead');" style="margin: -4px;"></i></button>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Operator</label>
                                            <div class="col-sm-6">
                                                <div class="select-style">
                                                    <select ng-model="salaryRuleGeneral.Operator" class="form-control" name="Operator" tabindex="5">
                                                        <option value=""></option>
                                                        <option value="*">*</option>
                                                        <option value="/">/</option>
                                                        <option value="+">+</option>
                                                        <option value="-">-</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('Operator');" style="margin: -4px;"></i></button>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Precedence</label>
                                            <div class="col-sm-6">
                                                <div class="select-style">
                                                    <select ng-model="salaryRuleGeneral.Precedence" class="form-control" name="Precedence" tabindex="5">
                                                        <option value=""></option>
                                                        <option value="(">(</option>
                                                        <option value=")">)</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('Precedence');" style="margin: -4px;"></i></button>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Value</label>
                                            <div class="col-sm-6">
                                                <input type="text" name="Value" ng-model="salaryRuleGeneral.Value" class="form-control" required tabindex="2" maxlength="50">
                                            </div>
                                            <div class="col-sm-2">
                                                <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('Value');" style="margin: -4px;"></i></button>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                        <div class="form-group" style="margin-top: -8px;">
                                            <button style="color: #f3f3ec;background-color: #1c1f32;margin-top: 8px;" class="btn"><i class="glyphicon glyphicon-backward" ng-click="RemoveFormula();" style="margin: -4px;"></i></button>
                                        </div>
                                        <div class="form-group">
                                            {{salaryRuleGeneral.FormulaDescription}}
                                        </div>
                                    </div>

                                </fieldset>
                            </div>

                        </fieldset>

                    </div>

                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i></button></li>
                            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="12"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            <li> <button ng-click="Clear();" class="btn" tabindex="13"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>

        <confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteDetailsFunction();"></confirm-archive-generic>

    </ej-dialog>

    <div class="table-responsive aplos-grid-toggle">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;" id="GridShiftTimeChange" ej-grid e-datasource="ModelList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="MID" e-headertext="SystemID" e-width="60"></div>
                    <div e-column e-field="AttenBnsPolicyName" e-headertext="AttenBnsPolicyName" e-width="60"></div>
                    <div e-column e-field="AttenBnsPolicyDescription" e-headertext="AttenBnsPolicyDescription" e-width="60"></div>
                </div>
            </div>
        </div>
    </div>

    <confirm-modal></confirm-modal>

    <ej-dialog id="dialogPFSetting" title="Additional Policy Setting" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#MainDivId" e-close="onDialogClose" e-minwidth="50%" e-minheight="50" e-open="enableBtn">
        <div class="row">

            <div class="col-xs-12 col-sm-6 col-md-12">
                <div class="content-container-fluid" style="color:black;">
                    <div id="EmpGrid"
                         ng-init="chkinit()"
                         ej-grid e-datasource="dataList"
                         e-gridlines="vertical"
                         e-templaterefresh="refreshTemplateemployee"
                         e-allowfiltering="true"
                         e-allowpaging="true"
                         e-allowsorting="true"
                         e-enabletouch="false"
                         e-responsive="true"
                         e-allowselection="true"
                         e-filtersettings-filterType="excel"
                         e-pagesettings-pagesize="15">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="LeaveId" e-headertext="Leave Id" e-width="60"></div>
                            <div e-column e-field="UserName" e-headertext="User Name" e-width="60"></div>
                            <div e-column e-template="#preApplied" e-headertext="Pre Applied" e-width="70"></div>
                        </div>
                    </div>

                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                    </script>

                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headchk" />
                    </script>

                    <script type="text/template" id="preApplied">

                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="data.IsPreApplied">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </script>

                </div>
            </div>
        </div>

    </ej-dialog>
