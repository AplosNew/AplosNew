<togglable name="Holiday Pay Days Setting"></togglable>
<div class="row">

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="CustomPara.CompanyId" ng-change="companyOnChange();"
                            ng-options="item.Value as item.Text for item in companyList" id="plantId"
                            name="Company" ng-disabled="AdditionalPayDayMasterModel.Id != null" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="AdditionalPayDayMasterModel.PlantId"
                            ng-options="item.Value as item.Text for item in plantList" id="plantId" ng-change="getData()"
                            name="Plant" ng-disabled="AdditionalPayDayMasterModel.Id != null" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>   
<br />



<div class="form-elements form-horizontal" ng-form name="AdditionalPayDayForm" id="MainDivId">
    <input type="hidden" ng-model="AdditionalPayDayForm.Id">

    <div class="row">

        <div class="col-xs-12 col-sm-6 col-md-6">


            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-left: 30px;">Policy Name</label>
                <div class="col-sm-8">
                    <input type="text" ng-model="AdditionalPayDayMasterModel.PolicyName" class="form-control" maxlength="100" tabindex="2">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-left: 30px;">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="AdditionalPayDayMasterModel.IsActive" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-left: 30px;">Description</label>
                <div class="col-sm-8">
                    <textarea type="text" ng-model="AdditionalPayDayMasterModel.PolicyDescription" class="form-control" maxlength="100" tabindex="2"></textarea>
                </div>
            </div>

        </div>

        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="SaveMaster();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="ClearM(AdditionalPayDayMasterModel);" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
                <ul class="list-inline text-left">
                    <li><button ng-click="AddLineIdem();" ng-disabled="AdditionalPayDayDetailsModel.MID==null" class="btn"><i class="glyphicon glyphicon-plus"></i>Add Line Item</button></li>
                </ul>
            </div>
        </div>


        <div class="col-xs-12 col-sm-12 col-sm-12" id="NewId">
            <div style="color:black;" id="AdditionalPayDayDetails" ej-grid e-datasource="AdditionalPayDayDetailsList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclickDetails" e-filtersettings-filterType="excel" e-actioncomplete="actionCompleteSelected">
                <div e-columns>
                    @*<div e-column e-field="Id" e-headertext="Id" e-width="70"></div>*@
                    <div e-column e-field="UserName" e-headertext="Salary Head" e-width="70"></div>
                    <div e-column e-field="HeadType" e-headertext="Head Type" e-width="70"></div>
                    <div e-column e-template="#Delete" e-headertext="Delete" e-width="20"></div>
                </div>
            </div>

            <script type="text/template" id="Delete">
                <li><button ng-click="$parent.DeleteDetails($event);" class="btn"><i class="glyphicon glyphicon-trash" tabindex="10"></i></button></li>
            </script>

        </div>

        <confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteMaster();"></confirm-archive-generic>

    </div>

</div>

<div class="table-responsive aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div style="color:black;" id="GridAdditionalPayDay" ej-grid e-datasource="ModelList"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
             e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="PolicyName" e-headertext="Policy Name" e-width="60"></div>
                <div e-column e-field="PolicyDescription" e-headertext="PolicyDescription" e-width="60"></div>
                <div e-column e-field="IsActive" e-headertext="Active" e-width="60"></div>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>

<ej-dialog id="dialogAdditionalPayDay" title="Holiday Pay Days" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#MainDivId" e-close="onDialogClose" e-minwidth="50%" e-minheight="50" e-open="enableBtn">
    <div class="row">

        <div class="col-xs-12 col-sm-6 col-md-12">
            <div class="content-container-fluid" style="color:black;">
                <div id="EmpGrid"
                     ng-init="chkinit()"
                     ej-grid e-datasource="SalaryHeadList"
                     e-gridlines="vertical"
                     e-templaterefresh="refreshTemplateemployee"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-allowsorting="true"
                     e-enabletouch="false"
                     e-responsive="true"
                     e-allowselection="true"
                     e-filtersettings-filterType="excel"
                     e-pagesettings-pagesize="15">
                    <div e-columns>
                        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="UserName" e-headertext="Salary Head" e-width="60"></div>
                        <div e-column e-field="HeadType" e-headertext="Head Type" e-width="70"></div>
                    </div>
                </div>

                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                </script>

                <script type="text/x-jsrender" id="headerTemplate">
                    <input type="checkbox" id="headchk" />
                </script>

            </div>
        </div>

        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="SaveDetails();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                </ul>
            </div>
        </div>
        <confirm-archive-generic modalid="confirmPopUpDetails" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteDetails();"></confirm-archive-generic>

    </div>

</ej-dialog>
