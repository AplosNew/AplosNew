
<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Shift Assignment
</h3>

<div class="form-elements" ng-form id="ShiftAssignment" name="ShiftAssignment">

    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal">

            <div class="form-group">
                <label class="col-md-3 control-label">Effective Date :</label>
                <div class="col-md-3">
                    <input class="form-control" datepicker autocomplete="off" id="EffectiveDate" ng-model="master.EffectiveDate" placeholder="dd-MMM-yyyy" type="text" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-md-3 control-label">Shift info :</label>
                <div class="col-md-9">
                    <div class="form-group">
                        <div class="radio col-md-2">
                            <label>

                                <input type="radio" name="groupitem" ng-model="master.IsFix" value="true" ng-click="ChangeFixed();">
                                <span class="cr"><i class="cr-icon"></i></span>Fixed Shift

                            </label>
                        </div>
                        <div class="col-md-4">
                            <div class="select-style">
                                <select id="ID" class="form-control" ng-model="master.FixSystemID" ng-disabled="master.IsFix=='false'" name="FixSystemID" required tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in FixedShiftList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>

                    </div>
                    <div class="form-group">
                        <div class="radio col-md-2">
                            <label>

                                <input type="radio" ng-click="ChangeRoster();" name="groupitem" ng-model="master.IsFix" value="false">
                                <span class="cr"><i class="cr-icon"></i></span>Roster Shift

                            </label>
                        </div>
                        <div class="col-md-4">
                            <div class="select-style">
                                <select id="ID" class="form-control" ng-disabled="master.IsFix=='true'" ng-model="master.RosterSystemID" name="RosterSystemID" required tabindex="1" ng-change="GetRosterShift(master.RosterSystemID);">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in RosterMasterList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label>
                                <span class="cr"><i class="cr-icon"></i></span>Starting Shift
                            </label>
                        </div>
                        <div class="col-md-4">
                            <div class="select-style">
                                <select id="ID" class="form-control" ng-model="master.RosterStartShiftID" ng-disabled="master.IsFix=='true'" name="RosterStartShiftID" required tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in RosterShiftList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>

                    </div>

                    <div class="col-sm-6">
                        <div class="col-sm-12"  style="left:-30px;">
                            <div class="checkbox-site" style="margin-top: 6px;">
                                <label>
                                    <input tabindex="8" type="checkbox" ng-model="master.CheckBox">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>With Attendance Process
                                </label>
                            </div>
                        </div>
                    </div>


                </div>
            </div>

        </div>

    </div>

    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="GetEmployeeInformation();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Load Employees</button></li>

        </ul>
    </div>

    <hr />

    <div class="common-btn">
        <ul class="list-inline text-right">

            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>

            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
        </ul>
    </div>

</div>
    <hr />

    <ej-dialog id="dialogShiftInfo"
               title="Employee Information"
               e-enablemodal="true"
               e-position-y="0"
               e-showoninit="false"
               e-target=".site-heading"
               e-close="onDialogClose"
               e-minwidth="95%"
               e-minheight="500" e-open="enableBtn">
        <div class="row">

            <div class="col-xs-12 col-sm-6 col-md-12">

                <div id="empInfoGrid" ng-init="chkinit()" ej-grid e-datasource="EmployeeList" e-gridlines="vertical" e-templaterefresh="refreshTemplateemployee"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>

                        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                        @*<div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>*@
                        <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Unit" e-headertext="Unit" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                        @*<div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>*@
                        <div e-column e-field="EffectiveDate" e-headertext="Last EffectiveDate" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="ShiftDefinationName" e-headertext="Shift Name" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="SingleDayShift" e-headertext="Single Day Shift" e-allowediting="false" e-width="80"></div>

                    </div>
                </div>

                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                </script>

                <script type="text/x-jsrender" id="headerTemplate">

                    <input type="checkbox" id="headchk" />
                </script>

            </div>

        </div>

        <div class="common-btn">
            <ul class="list-inline text-right" ng-show="true">
                <li><button ng-click="OK();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Ok </button></li>
            </ul>
        </div>

    </ej-dialog>

    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-12">
            <div id="GridNew" ej-grid
                 e-datasource="EmployeeListNew"
                 e-recorddoubleclick="Get"
                 e-allowscrolling="true"
                 e-pageSettings-pageSize="15"
                 e-actioncomplete="actionCompleteSelected"
                 e-templaterefresh="refreshTemplateemployee"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-enabletouch="true"
                 e-responsive="true"
                 e-allowselection="true"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                    <div e-column e-headertext="Actions" e-width="70" e-template="#GridNewDelete"></div>
                </div>
            </div>

        </div>
        <script type="text/template" id="GridNewDelete">
            <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.remove(this);" style="margin: -6px;"></i></button>
        </script>
    </div>

    <hr />







