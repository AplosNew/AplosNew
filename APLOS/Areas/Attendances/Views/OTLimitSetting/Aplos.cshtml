<togglable name=" OT Limit Setting"></togglable>

<div ng-form name="ModelNewForm" class="form-horizontal">
    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="OTLimitSettingModel.CompanyId" ng-change="companyOnChange();"
                            ng-options="item.Value as item.Text for item in companyList" id="CompanyId"
                            name="Company" required tabindex="1" ng-disabled="OTLimitSettingModel.Id != null">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="OTLimitSettingModel.PlantId"
                            ng-options="item.Value as item.Text for item in plantList" id="plantId" ng-disabled="OTLimitSettingModel.Id != null" ng-change="GetOTLimitSettingList()"
                            name="Plant" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements" ng-form name="bloodGroupNewForm">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="OTLimitSettingModel.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Min OT Limit/Day (Minuite)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" ng-model="OTLimitSettingModel.MinOTLimitParDay" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max OT Limit/Day (Minuite)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" ng-model="OTLimitSettingModel.MaxOTLimitParDay" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max OT Limit/Week (Minuite)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" ng-model="OTLimitSettingModel.MaxOTLimitParWeek" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max OT Limit(W)/Day (Minuite)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" ng-model="OTLimitSettingModel.MaxWeekOffOTLimitParDay" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max OT Limit(H)/Day (Minuite)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" ng-model="OTLimitSettingModel.MaxHolidayOTLimitParDay" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Week<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="OTLimitSettingModel.Week" name="Week" required tabindex="1">
                            <option value="First Week">First Week</option>
                            <option value="Second Week">Second Week</option>
                            <option value="Third Week">Third Week</option>
                            <option value="Last Week">Last Week</option>
                        </select>
                    </div>
                </div>
            </div>
            @*<div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">To Day<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Code" ng-model="OTLimitSettingModel.ToDay" class="form-control" required tabindex="2" maxlength="10">
                    </div>
                </div>*@
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="OTLimitSettingModel.Description" tabindex="9" maxlength="250"></textarea>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">OT Multiplying Factor<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" ng-model="OTLimitSettingModel.OTReductionFactor" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="OTLimitSettingModel.Active" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
    <div class="table-responsive modal-table aplos-grid-toggle" id="siteheaders">
        <div style="color:black;"
             id="GridOTLimitSettinglist"
             ej-grid e-datasource="OTLimitSettinglist"
             e-recorddoubleclick="GetEditData"
             e-gridlines="vertical"
             e-allowfiltering="true"
             e-allowpaging="true"
             e-allowsorting="true"
             e-allowselection="true"
             e-filtersettings-filterType="excel"
             e-allowtouch="false">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false" e-primarykey="true"></div>
                @*<div e-column e-field="Id" e-headertext="Id" e-allowediting="false" e-width="80"></div>*@
                @*<div e-column e-field="PlantID" e-headertext="PlantID" e-allowediting="false" e-width="80"></div>*@
                <div e-column e-field="Week" e-headertext="Week" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="UserName" e-headertext="UserName" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Description" e-headertext="Description" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="MinOTLimitParDay" e-headertext="MinOTLimitParDay" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="MaxOTLimitParDay" e-headertext="MaxOTLimitParDay" e-allowediting="false" e-width="80"></div>
                @*<div e-column e-field="MinOTLimitParWeek" e-headertext="MinOTLimitParWeek" e-allowediting="false" e-width="80"></div>*@
                <div e-column e-field="MaxOTLimitParWeek" e-headertext="MaxOTLimitParWeek" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="OTReductionFactor" e-headertext="OTReductionFactor" e-allowediting="false" e-width="80"></div>
                @*<div e-column e-field="PlantName" e-headertext="PlantName" e-allowediting="false" e-width="80"></div>*@
                @*<div e-column e-template="#checkboxTemplateIsActive" e-headertext="Active" e-width="100"></div>*@
                @*<div e-column e-headertext="Designation" e-width="70">
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px; display:{{data.IsRateBasedOnSalaryRange==true ? 'none' : 'inherit'}}" class="btn"><i class="glyphicon glyphicon-plus" ng-click="$parent.OpendialogDesignation($event);" style="margin: -6px;"></i></button>
                    </div>
                    <div e-column e-headertext="Shift" e-width="70">
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px; display:{{data.Catagory=='HourlyOffDuty'|| data.Catagory=='HourlyOffDutyDeduction'? 'none' : 'inherit'}}" class="btn">
                            <i class="glyphicon glyphicon-plus" ng-click="$parent.OpendialogShift($event);" style="margin: -6px;"></i>
                        </button>
                    </div>
                    <div e-column e-headertext="Salary" e-width="70">
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px; display:{{data.IsRateBasedOnSalaryRange==false ? 'none' : 'inherit'}}" class="btn"><i class="glyphicon glyphicon-plus" ng-click="$parent.OpendialogSalaryRange($event);" style="margin: -6px;"></i></button>
                    </div>*@
            </div>
        </div>
        <script type="text/template" id="checkboxTemplateIsActive">

            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Active" />
        </script>


    </div>


    <confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
