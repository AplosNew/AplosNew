<togglable name="TBS Transaction"></togglable>

<div class="form-elements form-horizontal" ng-form name="TBSForm"  id="MainDivID" >
    <div class="row">

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div  class="form-group">
                <label class="col-sm-4 control-label">Employee Select<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <span class="input-group-addon">{{employeeInfo.EmployeeCode}}</span>
                        <input type="text" name="EmployeeName" ng-model="employeeInfo.EmployeeName" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="GetEmployeeDeleteInfo()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Employee DOJ :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.DOJ}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Employee DOC :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.DOC}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label"> Designation :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.LegalDesignation}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Department :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.Department}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Section :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.Section}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">SubSection :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.SubSection}}</label>
                </div>
            </div>


            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="AddLineIdem();" ng-disabled="employeeInfo.EmpSystemID==null" class="btn"><i class="glyphicon glyphicon-plus"></i>Add New</button></li>
                        <li> <button ng-click="ClearM();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <div class="col-sm-8">
                    <div>
                        <img id="uploadImageSrc" ng-src="{{employeeInfo.EmpPic}}" style="margin-left: 180px; border: 1px solid; height: 200px; width: 200px;" />
                    </div>
                </div>
            </div>

        </div>

        <div id="NewId" class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;" id="Grid" ej-grid e-datasource="GetTBSList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel"  e-actioncomplete="actionCompleteSelected">
                <div e-columns>
                    <div e-column e-field="EntryDate" e-headertext="Effective Date" e-width="60"></div>
                    <div e-column e-field="Description" e-headertext="Description" e-width="80"></div>
                    <div e-column e-field="ActionCategory" e-headertext="Action Category" e-width="60"></div>
                    <div e-column e-field="ActionType" e-headertext="Action Type" e-width="60"></div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="content-container-fluid" style="color:black;">
            <div style="color:black;" id="GridTBS" ej-grid e-datasource="TBSModelList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclickTBS" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="EmployeeCode" e-width="60"></div>
                    <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="60"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="60"></div>
                    <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="60"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="60"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="60"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-width="60"></div>
                    <div e-column e-field="EntryDates" e-headertext="Effective Date" e-width="60"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<ej-dialog id="dialogEmployeeInfo"
           title="TBS Transaction"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#MainDivID"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="200" e-open="enableBtn" >
    <div class="row">
        <div class="col-xs-12 form-element-ctrl form-horizontal" ng-show="ShowDiv">

            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group">
                    <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select id="LeaveTypeID" class="form-control" ng-model="TBSModel.DisciplinaryActionCategoryId" name="Leave Type" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in Actionlist" value="{{option.Id}}">{{option.UserName}}</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Description</label>
                    <div class="col-sm-8">
                        <input type="text" name="User Name" ng-model="TBSModel.Description" class="form-control" ng-change="ChangeDuration()" tabindex="2" maxlength="10">
                    </div>
                </div>

            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group">
                    <label class="col-sm-3 control-label">Effective Date</label>
                    <div class="col-sm-8">
                        <input type="text" ej-datepicker e-width="50%" e-dateformat="dd-MMM-yyyy" e-value="TBSModel.EntryDate" />
                    </div>
                </div>

            </div>

            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear(TBSModel);" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>

        </div>
    </div>

    <confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>

</ej-dialog>

<div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridEmp" ej-grid e-datasource="dataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SetData" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>
<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>
<confirm-modal></confirm-modal>
