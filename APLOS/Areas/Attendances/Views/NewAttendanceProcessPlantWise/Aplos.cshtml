<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>

<div class="form-elements form-horizontal" ng-form name="NewAttdnProcessPlantWise">
    <div class="row" ng-form name="General">        

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Date" ng-model="Attnd.Date" datepicker class="form-control" required>
            </div>
        </div>

    </div>

</div>

<div class="row" id="overall" style="background-color:white; padding-top:5%">

    <div class="col-md-12">
        <div id="Detail" class="col-lg-12" style="padding-left:3%">
            <div class="row">
                <div class="" style="margin-left:0%;  max-height:375px; max-width:100%;">
                    <table class="table table-hover" style="overflow-y:scroll;border:1px solid black; box-shadow:1px 1px 1px 1px grey;">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Description</th>
                                
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td style="padding:2px; cursor:pointer;" class="hoverItem" ng-click="RunRoster();">Roster Process</td>
                                <td style="padding:2px; text-align:left;cursor:pointer;" class="hoverItem">This Process is used to Process the Roster Shift for the Day</td>
                            </tr>
                            <tr><td></td><td></td></tr>
                            <tr>
                                <td style="padding:2px; cursor:pointer;" class="hoverItem" ng-click="RunShiftProcess();">Shift Process</td>
                                <td style="padding:2px; text-align:left;cursor:pointer;" class="hoverItem">This Process is used to create the Row of Active Employees along with their Assigned Shift,WeekOff,Applied Leave for the Day</td>
                            </tr>
                            <tr><td></td><td></td></tr>
                            <tr>
                                <td style="padding:2px; cursor:pointer;" class="hoverItem" ng-click="RunAttnd();">Attendance Process</td>
                                <td style="padding:2px; text-align:left;cursor:pointer;" class="hoverItem">This Process is used to Process the In,Out,OutpunchLimit of the Employee</td>
                            </tr>
                            <tr><td></td><td></td></tr>
                            <tr>
                                <td style="padding:2px; cursor:pointer;" class="hoverItem" ng-click="RunDayStatus();">DayStatus Process</td>
                                <td style="padding:2px; text-align:left;cursor:pointer;" class="hoverItem">This Process is used to Process the Day Status for the WorkDate</td>
                            </tr>
                            <tr><td></td><td></td></tr>
                            <tr>
                                <td style="padding:2px; cursor:pointer;" class="hoverItem" ng-click="RunManualScheduler();">Manual Process</td>
                                <td style="padding:2px; text-align:left;cursor:pointer;" class="hoverItem">This Process is used to trigger the Attendance of Changed Employee's Attendance</td>
                            </tr>
                            <tr><td></td><td></td></tr>
                            <tr>
                                <td style="padding:2px; cursor:pointer;" class="hoverItem" ng-click="RunDOJProcess();">Past DOJ Process</td>
                                <td style="padding:2px; text-align:left;cursor:pointer;" class="hoverItem">This Process is used to Create the Rows of Past DOJ Employees </td>
                            </tr>
                            <tr><td></td><td></td></tr>
                            <tr>
                                <td style="padding:2px; cursor:pointer;" class="hoverItem" ng-click="RunTBS_LA_Process();">TBS LA Process</td>
                                <td style="padding:2px; text-align:left;cursor:pointer;" class="hoverItem">This Process is used to Change Current Status of Employees </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

</div>



