
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="form-elements form-horizontal">    
    <div class="row">
        <div class="col-md-12">
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date</label>
                    <div class="col-sm-8">
                        <input type="text" name="Form Date" required e-dateformat="dd-MMM-yyyy" ng-model="effectiveDate" datepicker class="form-control" >
                    </div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date</label>
                    <div class="col-sm-8">
                        <input type="text" ng-disabled="true" name="To Date" required e-dateformat="dd-MMM-yyyy" ng-model="ToDate" datepicker class="form-control" >
                    </div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <div class="common-btn">
                        <button ng-click="Report();" class="btn"> <i class="glyphicon glyphicon-download"></i>Download Report</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


