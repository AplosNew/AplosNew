<h3 class="site-heading" id="hhhh">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Sandwich Absenteeism Assignment
</h3>




<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">Absenteeism Assignment</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Assigned Absenteeism </a></li>


        </ul>
    </div>

    <div class="tab-content" id="tabpaneldiv">


        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet11(11), active: isSet11(11) }">
            <div class="row form-horizontal">
                <div class="col-xs-12 col-sm-5 col-md-4 ">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">From Date</label>
                        <div class="col-sm-8 show-message">
                            <input type="text" ng-model="FromDate" datepicker class="form-control" required tabindex="1">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-5 col-md-4 ">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">To Date</label>
                        <div class="col-sm-8 show-message">
                            <input type="text" ng-model="ToDate" datepicker class="form-control" required tabindex="1">
                        </div>
                    </div>
                </div>

                <div class="col-xs-12 col-sm-12 col-md-4">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="GetEmployeeList();" style="margin-right: 3px;" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Load</button></li>
                        </ul>
                    </div>
                </div>

            </div>

            <br />
            <div style="color:black;" id="Grid" ej-grid e-datasource="EmployeeList" e-templaterefresh="refreshTemplateemployee"
                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-recorddoubleclick="SelectAttdnDetails" e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                    @*<div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>*@
                    <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Name" e-width="90"></div>
                    <div e-column e-field="DayStatus" e-headertext="DayStatus" e-width="50"></div>
                    <div e-column e-field="AttdnProcDate" e-headertext="Work Date" e-width="60"></div>
                    @*<div e-column e-field="DOJ" e-headertext="DOJ" e-width="60"></div>*@
                    <div e-column e-field="GivenDesignation" e-headertext="Designation" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="EntityName" e-headertext="Entity" e-width="80"></div>

                    @*<div e-column e-field="DOB" e-headertext="DOB" e-width="80"></div>*@
                    <div e-column e-field="PositionName" e-headertext="PositionName" e-width="80"></div>



                    @*<div e-column e-headertext="Actions" e-width="60">
                            <button style="color: #f3f3ec;background-color: #1c1f32;height: 32px;" class="btn" ng-click="$parent.SelectLvDetails($event);"> Details</button>
                        </div>*@





                </div>
            </div>

            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>
            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
            </script>
            <br />
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="SaveAbsent();" class="btn"><i class="glyphicon glyphicon-saved" tabindex="9"></i> Create Absent</button></li>


                </ul>
            </div>


        </div>


        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet22(22), active: isSet22(22) }">
            <div style="color:black;" id="GridAssigned" ej-grid e-datasource="AssignedEmployeeList" e-templaterefresh="refreshTemplateemployee"
                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"                
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Name" e-width="90"></div>
                    <div e-column e-field="AttdnProcDate" e-headertext="Work Date" e-width="60"></div>
                    @*<div e-column e-field="DOJ" e-headertext="DOJ" e-width="60"></div>*@
                    <div e-column e-field="GivenDesignation" e-headertext="Designation" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="EntityName" e-headertext="Entity" e-width="80"></div>
                    <div e-column e-field="PositionName" e-headertext="PositionName" e-width="80"></div>
                     <div e-column e-field="DayStatus" e-headertext="DayStatus" e-width="50"></div>
                     <div e-column e-headertext="Actions" e-width="60" e-textalign="center">

                         <button style="color: #f3f3ec;background-color: #1c1f32;height: 32px;" class="btn" ng-click="$parent.remove($event);"> <i class="glyphicon glyphicon-remove"></i></button>

                     </div>
                </div>
            </div>
        </div>


    </div>





</div>
<ej-dialog id="dialogAttdnDetails"
           title=" Attdence Details"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#hhhh"
           e-close="onDialogClose"
           e-minwidth="50%"
           e-minheight="200" e-open="enableBtn">
    <div class="row">

        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="table-responsive modal-table">
                <div style="color:black;" id="Gridd"
                     ej-grid e-datasource="AttdnBalanceList"
                     e-templaterefresh="refreshTemplateemployee"
                     e-gridlines="vertical" e-allowfiltering="true"
                     e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="AttdnProcDate" e-headertext="Work Date" e-width="60"></div>
                        <div e-column e-field="DayStatus" e-headertext="DayStatus" e-width="50"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>

</ej-dialog>
<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>