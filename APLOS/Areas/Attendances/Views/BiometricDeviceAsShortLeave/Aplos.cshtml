<togglable name="Biometric Device As Short Leave"></togglable>
<div class="form-elements form-horizontal" ng-form name="biometricDeviceAsShortLeaveNewForm">
    <input type="hidden" ng-model="biometricDeviceAsShortLeaveNew.SystemID">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="biometricDeviceAsShortLeaveNew.PlantID" name="Plant" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Machine IP<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Machine IP" ng-model="biometricDeviceAsShortLeaveNew.MachineIP" class="form-control" maxlength="50" required tabindex="3">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="biometricDeviceAsShortLeaveNew.Description" tabindex="5" maxlength="200"></textarea>
            </div>
        </div>
