<togglable name="Bank Reconciliation Closing"></togglable>
<div class="form-elements form-horizontal">
    <div class="col-xs-12">
        <div class="row" ng-form="form0">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Fiscal Year<sup>*</sup></label>
                    <div class="col-sm-8  show-message">
                        <div class="select-style">
                            <select name="FiscalYear" ng-model="bankReconciliationClosing.FiscalYearId" class="col-sm-3 form-control"
                                    ng-options="item.Value as item.Text for item in fiscalYearList" required tabindex="3"></select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <input type="text" ng-model="bankReconciliationClosing.BankName" class="form-control" required readonly>
                            <span class="input-group-btn">
                                <button ng-click="showBankPopUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Dr. Amount</label>
                    <div class="col-sm-8">
                        <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right " name="DrAmount"  ng-model="bankReconciliationClosing.DrAmount" class="form-control" tabindex="9" autocomplete="off">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Cr. Amount</label>
                    <div class="col-sm-8">
                        <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right " name="CrAmount"  ng-model="bankReconciliationClosing.CrAmount" class="form-control" tabindex="9" autocomplete="off">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <div style="color:black;" id="GridMaster" ej-grid e-datasource="masterList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
         e-recorddoubleclick="SelectMaster" e-allowselection="true" e-filtersettings-filterType="excel">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="80"></div>
            <div e-column e-field="FixedAssetMasterId" e-headertext="Asset Master Id" e-width="40" e-filter="false"></div>
            <div e-column e-field="FixedAssetItemId" e-headertext="Asset Item Id" e-width="40" e-filter="false"></div>
            <div e-column e-field="FixedAssetItem" e-headertext="Asset Item" e-width="100"></div>
            <div e-column e-field="GRNAmount" e-headertext="GRN Amount" e-width="80"></div>
            <div e-column e-field="TotalAmount" e-headertext="Total Amount" e-width="80"></div>
            @*<div e-column e-template="#ShowActionButtonsassigned" e-headertext="Actions" e-width="50" e-textalign="center"></div>*@
        </div>
    </div>
    @*<script type="text/ng-template" id="ShowActionButtonsassigned">
            <div class="common-btn">
                <ul class="common-btn list-inline text-left">
                    <li ng-show="data.Type=='New'">
                        <div ej-tooltip e-showshadow="true" e-content="Asset Register Update" ng-click="$parent.onClickAssetRegisterpopUpByCapitalizationMasterId(data);" e-width="width">
                            <button class="btn" style="background-color: #1c1f32;"><i class="glyphicon glyphicon-floppy-disk"></i></button>
                        </div>
                    </li>

                </ul>
            </div>
        </script>*@
</div>
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")










