<togglable name="Bank Branch"></togglable>
<div ng-form name="bankBrchForm">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-3 col-md-2 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-3 col-md-4  show-message">
                <div class="select-style">
                    <select name="Bank" ng-model="bankbranch.BankId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in bankList" tabindex="1" required ng-change="getData()">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements form-horizontal">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="basic" role="tab" data-toggle="tab">General</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Address</a></li>
                    <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="contact" role="tab" data-toggle="tab">Contact</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form name="bankBrchForm1">
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" maxlength="18" name="Sequence" ng-model="bankbranch.Sequence" class="form-control" tabindex="1" required>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="ShortName" maxlength="15" ng-model="bankbranch.ShortName" class="form-control" tabindex="3" required>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="UserName" maxlength="100" ng-model="bankbranch.UserName" class="form-control" tabindex="5" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">SWIFT Code</label>
                                <div class="col-sm-8">
                                    <input type="text" ng-model="bankbranch.SWIFTCode" name="SWIFTCode" maxlength="15" class="form-control" tabindex="7">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="bankbranch.Description" name="Description" maxlength="250" tabindex="9"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Code" maxlength="10" ng-model="bankbranch.Code" class="form-control" tabindex="2" required>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="StandardName" maxlength="100" ng-model="bankbranch.StandardName" class="form-control" tabindex="4" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Routing No</label>
                                <div class="col-sm-8">
                                    <input type="text" ng-model="bankbranch.RoutingNo" name="RoutingNo" maxlength="15" class="form-control" tabindex="6">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">IFSC Code</label>
                                <div class="col-sm-8">
                                    <input type="text" ng-model="bankbranch.IFSCCode" name="IFSCCode" maxlength="15" class="form-control" tabindex="7">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="bankbranch.Remarks" name="Remarks" maxlength="250" tabindex="8"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Active</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="bankbranch.Active" tabindex="10">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row" ng-form name="bankBrchForm2">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Continent<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Continent" ng-model="addressMaster.ContinentId" ng-change="onContinentChange(addressMaster.ContinentId)" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in ContinentList" tabindex="1" required></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">State/Division<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="State/Division" ng-model="addressMaster.StateId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in StateList" tabindex="3" required></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Area</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Area" ng-model="addressMaster.AreaId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in AreaList" tabindex="5"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Thana</label>
                                <div class="col-sm-8">
                                    <input name="Thana" maxlength="50" type="text" ng-model="addressMaster.Thana" class="form-control" tabindex="7">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Ward</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Ward" maxlength="50" ng-model="addressMaster.Ward" class="form-control" tabindex="9">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Phone</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Phone" maxlength="20" ng-model="addressMaster.Phone" class="form-control" tabindex="11">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Website</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Website" maxlength="50" ng-model="addressMaster.Website" class="form-control" tabindex="13">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Address Line1<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <textarea class="form-control" rows="3" ng-model="addressMaster.Address1" name="Address Line1" maxlength="300" tabindex="15" required></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Country<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Country" ng-model="addressMaster.CountryId" ng-change="onCountryChange(addressMaster.CountryId);onStateChange(addressMaster.CountryId)" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in CountryList" tabindex="2" required></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">City<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="City" ng-model="addressMaster.CityId" ng-change="onCityChange(addressMaster.CityId)" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in CityList" tabindex="4" required></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Circle</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Circle" maxlength="50" ng-model="addressMaster.Circle" class="form-control" tabindex="6">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Village</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Village" maxlength="100" ng-model="addressMaster.Village" class="form-control" tabindex="8">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Postcode</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Postcode" maxlength="50" ng-model="addressMaster.Postcode" class="form-control" tabindex="10">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Email</label>
                                <div class="col-sm-8">
                                    <input type="email" name="Email" maxlength="50" ng-model="addressMaster.Email" class="form-control" placeholder="example@gmail.co" tabindex="12">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Address Line2</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="addressMaster.Address2" name="Address Line2" maxlength="300" tabindex="14"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                    <div class="row">
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Phone1</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Phone1" maxlength="20" ng-model="contactMaster.Phone1" class="form-control" tabindex="13">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Mobile</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Mobile" maxlength="20" ng-model="contactMaster.Phone3" class="form-control" tabindex="15">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Email1</label>
                                <div class="col-sm-8">
                                    <input type="email" name="Email1" maxlength="50" ng-model="contactMaster.Email1" class="form-control" placeholder="example@gmail.co" tabindex="17">
                                    <span class="msg-error" ng-show="bankBrchForm.Email1.$error.email">
                                        Not valid email!
                                    </span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Email3</label>
                                <div class="col-sm-8">
                                    <input type="email" name="Email3" maxlength="50" ng-model="contactMaster.Email3" class="form-control" placeholder="example@gmail.co" tabindex="19">
                                    <span class="msg-error" ng-show="bankBrchForm.Email3.$error.email">
                                        Not valid email!
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal form-elements">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Phone2</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Phone2" maxlength="20" ng-model="contactMaster.Phone2" class="form-control" tabindex="14">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Fax</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Fax" maxlength="50" ng-model="contactMaster.Fax" class="form-control" tabindex="16">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Email2</label>
                                <div class="col-sm-8">
                                    <input type="email" name="Email2" maxlength="50" ng-model="contactMaster.Email2" class="form-control" placeholder="example@gmail.co" tabindex="18">
                                    <span class="msg-error" ng-show="bankBrchForm.Email2.$error.email">
                                        Not valid email!
                                    </span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Website</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Website" maxlength="50" ng-model="contactMaster.Website" class="form-control" tabindex="20">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i>Delete</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in bankbranches |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active? 'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>