<togglable name="Bank Opening Balance"></togglable>
<div class="form-elements form-horizontal row" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Posting Date" ng-model="openingBalance.PostingDate" datepicker disabled required class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="Doc Ref" ng-model="openingBalance.DocRefNo" class="form-control" tabindex="2" required>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" id="DocDate" name="Doc Date" ng-model="openingBalance.DocDate" datepicker="checkDocDate('div_DocDate', openingBalance.DocDate)" required class="form-control datepicker" tabindex="1">
            </div>
        </div>
        <div id="div_entity" class="form-group" ng-show="isEntityLevel">
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-change="entityValidation()" name="Entity" class="form-control" ng-model="openingBalance.EntityId" tabindex="3">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea maxlength="250" type="text" name="Narration" class="form-control" rows="3" ng-model="openingBalance.Narration" tabindex="4" ng-keyup="copyNarration(openingBalance.Narration)" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li><button ng-click="showBankPopUp(openingBalance.EntityId);" ng-disabled="openingBalance.EntityId==NULL" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Add Line Items</button></li>
            </ul>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="clearFields();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 modal-table">
        <table class="table table-responsive table-striped">
            <thead>
                <tr>
                    <th>Bank</th>
                    <th>Account Title</th>
                    <th>Doc Date</th>
                    <th>Doc Ref</th>
                    <th>Narration</th>
                    <th>Trn. Currency</th>
                    <th>Trn. Amount</th>
                    <th>{{companyCurrencyCode}}</th>
                    <th ng-hide="companyGroupCurrencyId==null">{{companyGroupCurrencyCode}}</th>
                    <th ng-hide="hardCurrencyId==null">{{hardCurrencyCode}}</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in openingBalanceDetailList">
                    <td>{{x.BankName}}</td>
                    <td>{{x.AccountTitle}}</td>
                    <td id="td_DocDate_{{$index}}">
                        <div class="show-message">
                            <input type="text" class="form-control" ng-model="x.DocDate" datepicker="checkDocDate('tr_DocDate', x.DocDate); checkRowValidation(x, $index)">
                        </div>
                    </td>
                    <td id="td_DocRef_{{$index}}">
                        <div class="show-message">
                            <input type="text" class="form-control" ng-model="x.DocRefNo" placeholder="Doc Ref" maxlength="50" ng-keyup="checkRowValidation(x, $index)">
                        </div>
                    </td>
                    <td id="td_Narration_{{$index}}">
                        <div class="show-message">
                            <input type="text" class="form-control" ng-model="x.Narration" placeholder="Narration" ng-keyup="copyNarration(x.Narration); checkRowValidation(x, $index)" maxlength="250">
                        </div>
                    </td>
                    <td>{{x.CurrencyCode}}</td>
                    <td id="td_Amount_{{$index}}">
                        <div class="show-message">
                            <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.Amount" ng-keyup="copyAmount($index); checkRowValidation(x, $index)">
                        </div>
                    </td>
                    <td id="td_CompanyCurrencyAmount_{{$index}}">
                        <div class="show-message">
                            <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.CompanyCurrencyAmount" ng-keyup="checkRowValidation(x, $index)">
                        </div>
                    </td>
                    <td id="td_CompanyGroupCurrencyAmount_{{$index}}" ng-hide="companyGroupCurrencyId==null">
                        <div class="show-message">
                            <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.CompanyGroupCurrencyAmount" ng-keyup="checkRowValidation(x, $index)">
                        </div>
                    </td>
                    <td id="td_HardCurrencyAmount_{{$index}}" ng-hide="hardCurrencyId==null">
                        <div class="show-message">
                            <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.HardCurrencyAmount" ng-keyup="checkRowValidation(x, $index)">
                        </div>
                    </td>
                    <td class="text-right">
                        <button ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="openingBalanceDetailList.length">
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ openingBalanceDetailList | sumByKey : 'Amount' }}</b></td>
                    <td class="text-right"><b>{{ openingBalanceDetailList | sumByKey : 'CompanyCurrencyAmount'  }}</b></td>
                    <td class="text-right" ng-hide="companyGroupCurrencyId==null"><b>{{ openingBalanceDetailList | sumByKey : 'CompanyGroupCurrencyAmount'  }}</b></td>
                    <td class="text-right" ng-hide="hardCurrencyId==null"><b>{{ openingBalanceDetailList | sumByKey : 'HardCurrencyAmount'  }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Entity</th>
                <th>VoucherNo</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Doc Ref</th>
                <th>Amount</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in openingBalanceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById($index);">
                <td>{{x.EntityName}}</td>
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.DocDate | dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td class="text-right">{{x.Amount | number:4}}</td>
                <td>{{x.IsPark?'Park':'Post'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
<confirm-modal></confirm-modal>