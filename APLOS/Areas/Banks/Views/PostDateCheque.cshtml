<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" name="Bank" ng-model="pdcNew.BankName" ng-disabled="true" class="form-control" maxlength="200" tabindex="1" required>
            </div>
            <div class="col-sm-2">
                <button ng-click="showBankPopUp()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Doc Date" ng-model="pdcNew.DocDate" datepicker class="form-control" tabindex="4">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Base Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Base Date" ng-model="pdcNew.BaseDate" datepicker class="form-control" tabindex="7">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="pdcNew.Remarks" maxlength="150" tabindex="10"></textarea>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">@Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="pdcNew.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn"  tabindex="2">
                        @*<button ng-click="showPartyPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>*@
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Posting Date" ng-model="pdcNew.PostingDate" datepicker class="form-control" tabindex="5">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Amount" ng-model="pdcNew.Amount" class="form-control" required tabindex="8" maxlength="150">
            </div>
        </div>


    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Reference No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocReference" ng-model="pdcNew.DocRefNo" class="form-control" required tabindex="3" maxlength="150">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="EffectiveDate" ng-model="pdcNew.EffectiveDate" datepicker class="form-control" tabindex="6">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Currency" ng-model="pdcNew.Currency" class="form-control" required tabindex="9" maxlength="150">
            </div>
        </div>


    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="11"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="12"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="13"></i> Clear</button></li>
        </ul>
    </div>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_ChequeLotDetailPopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")