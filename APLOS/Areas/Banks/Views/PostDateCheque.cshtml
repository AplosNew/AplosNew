<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Bank" ng-model="pdcNew.BankName" ng-disabled="true" class="form-control" maxlength="200" required>
                    <span class="input-group-btn" tabindex="1">
                        <button ng-click="showBankPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Doc Date" ng-model="pdcNew.DocDate" datepicker class="form-control" tabindex="4">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Base Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Base Date" ng-model="pdcNew.BaseDate" datepicker class="form-control" tabindex="7">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-addon">{{pdcNew.ResponsiblePersonCode}}</span>
                    <input type="text" name="Responsible Person" ng-model="pdcNew.ResponsiblePerson" class="form-control" required readonly>
                    <span class="input-group-btn"  tabindex="10">
                        <button name="submit" ng-click="showEmployeeListPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">PO No</label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" name="PO No" ng-model="pdcNew.POId" ng-disabled="true" class="form-control" maxlength="200" required>
                    <span class="input-group-btn" tabindex="13">
                        <button ng-click="GetPO()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>


    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="pdcNew.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn" tabindex="2">
                        @*<button ng-click="showPartyPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>*@
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Posting Date" ng-model="pdcNew.PostingDate" datepicker class="form-control" tabindex="5">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8 show-message" @*style="padding-right:0px;*@>
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" name="CurrencyTransaction" ng-model="pdcNew.CurrencyId" tabindex="8" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Remainder Days<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Remainder Days" ng-model="pdcNew.RemainderDays" class="form-control" required tabindex="11" maxlength="150">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Cheque No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Cheque No" ng-model="pdcNew.ChequeNo" class="form-control" required tabindex="14" maxlength="150">
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Reference No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocReference" ng-model="pdcNew.DocRefNo" class="form-control" required tabindex="3" maxlength="150">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Payment Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="PaymentDate" ng-model="pdcNew.PaymentDate" datepicker class="form-control" tabindex="6">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Amount" ng-model="pdcNew.Amount" class="form-control" required tabindex="9" maxlength="150">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Days<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Days" ng-model="pdcNew.Days" class="form-control" required tabindex="12" maxlength="150">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="pdcNew.Remarks" maxlength="150" tabindex="15"></textarea>
            </div>
        </div>

    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="16"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"  tabindex="17"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="18"></i> Clear</button></li>
        </ul>
    </div>
</div>


<div class="table-responsive aplos-grid-toggle">
    <div class="content-container-fluid" style="color:black;overflow:scroll">
        <div style="color:black;" id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="recorddoubleclick"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-field="BankName" e-headertext="Bank" e-width="5"></div>
                <div e-column e-field="PartyName" e-headertext="Party" e-width="4"></div>
                <div e-column e-field="Id" e-headertext="Doc Reference No" e-width="4"></div>
                <div e-column e-field="PaymentDate" e-headertext="Payment Date" e-width="4"></div>
                <div e-column e-field="CurrencyId" e-headertext="Currency" e-width="4"></div>
                <div e-column e-field="Amount" e-headertext="Amount" e-width="4"></div>

                <div e-column e-headertext="Actions" e-template="#ShowActionButtonsBOM" e-width="2"></div>
            </div>
        </div>
    </div>

        <script type="text/template" id="ShowActionButtonsBOM">
            <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="fa fa-file-excel-o" ng-click="$parent.Report(this);" style="margin: -6px;"></i></button>
        </script>
    </div>



    <div class="modal fade site-modal in" id="employeePopUps" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    Employee List
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row text-right">
                        <div class="col-xs-12 col-sm-12 col-sm-12 ">
                            <div class="search-form">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-3 col-md-3">
                                        <div class="select-style">
                                            <select ng-model="employeeParameters.searchBy">
                                                <option ng-repeat="option in searchEmployeeByList" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-7 col-md-7">
                                        <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                    </div>
                                    <div class="col-xs-12 col-sm-2 col-md-2">
                                        <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Employee Code</th>
                                    <th>First Name</th>
                                    <th>Middle Name</th>
                                    <th>Last Name</th>
                                    <th>Employee Name</th>
                                    <th>Date Of Birth</th>
                                    <th>Designation</th>
                                    <th>Entity</th>
                                    <th>Department</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                    ng-dblclick="selectEmployeePopUp($index, x)" pagination-id="metaData.name + 'employeeList'">
                                    <td>{{x.EmployeeCode}}</td>
                                    <td>{{x.FirstName}}</td>
                                    <td>{{x.MiddleName}}</td>
                                    <td>{{x.LastName}}</td>
                                    <td>{{x.EmployeeName}}</td>
                                    <td>{{x.DOB | dateFiltering}}</td>
                                    <td>{{x.Designation}}</td>
                                    <td>{{x.EntityName}}</td>
                                    <td>{{x.Department}}</td>
                                    <td>{{x.EmploymentType}}</td>
                                    <td>{{x.EmployeeStatus}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'employeeList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEmployeeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="modal-footer common-btn">
                    <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade site-modal in" id="POPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">Approved PO List<button type="button" class="close" ng-click="POPopUpClose();">&times;</button></div>
                <div class="modal-body form-elements form-horizontal">
                    <div class="col-lg-12">
                        @*<div class="content-container-fluid" style="color:black;" ng-show="productNew.PO==='PO'">
                            <div style="color:black;" id="Grid" ej-grid e-datasource="Griddata"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-allowselection="true" e-recorddoubleclick="" e-filtersettings-filterType="excel"
                                 e-enabletouch="false">*@


                        <div class="content-container-fluid" style="color:black;overflow:scroll">
                            <div style="color:black;" id="GriddataMaster1" ej-grid e-datasource="POGridData"
                                 e-templaterefresh="refreshTemplateMasterOrderOperation"
                                 e-recorddoubleclick="POAdd"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                                <div e-columns>
                                    <div e-column e-field="POId" e-headertext="PO No" e-width="80"></div>
                                    <div e-column e-field="PODate" e-headertext="PO Date" e-width="100"></div>
                                    <div e-column e-field="CustomerName" e-headertext="Vendor" e-width="200"></div>
                                    <div e-column e-field="ContractNo" e-headertext="Contract No" e-width="80"></div>
                                    <div e-column e-field="POType" e-headertext="POType" e-width="100"></div>
                                    <div e-column e-field="LCNo" e-headertext="LC Ref No" e-width="150"></div>
                                    <div e-column e-field="UDNo" e-headertext="UD" e-width="80"></div>

                                </div>

                            </div>
                        </div>

                    </div>
                    <div class="clearfix"></div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="POPopUpClose();" class="btn"><i class="glyphicon glyphicon-folder-close"></i>Close</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <confirm-modal></confirm-modal>
    @Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
    @Html.Partial("~/Areas/Banks/Views/_ChequeLotDetailPopUp.cshtml")
    @Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")
