<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_entity" class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="6" required ng-change="changeEntityForBankCash(voucher.EntityId);">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">To<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="voucherType" ng-change="changeJournalType()" ng-disabled="voucher.Id" ng-model="voucher.BankJournalType" class="col-sm-3 form-control" required>
                        <option value="BankToVendor">Vendor</option>
                        <option value="BankToBank">Bank</option>
                        <option value="BankToCash">Cash</option>
                        <option value="BankToEmployee">Employee</option>
                        <option value="BankToGL">GL</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group">
            <label class="col-sm-3 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="2" />
            </div>
        </div>
        @*<div class="form-group">
            <label class="col-sm-3 control-label">GL</label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <span class="input-group-btn">
                        <button ng-click="popUp();" ng-disabled="voucher.Id && voucher.BankJournalType!='BankToGL'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-plus">Add</i></button>
                    </span>
                </div>
            </div>
        </div>*@
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">From Bank<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Bank" class="form-control" ng-model="voucher.BankMasterId" ng-options="item.Id as item.AccountTitle for item in bankMasterList" required ng-change="onBankChange(voucher.BankMasterId)">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.BankToBank.ToString()'">
            <label class="col-sm-3 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="To Bank" class="form-control" ng-model="voucher.OtherBankMasterId" ng-options="item.Id as item.AccountTitle for item in bankMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.BankToCash.ToString()'">
            <label class="col-sm-3 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Cash" class="form-control" ng-model="voucher.OtherCashMasterId" ng-options="item.Id as item.UserName for item in cashMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.BankToVendor.ToString()'">
            <label class="col-sm-3 control-label">@Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="voucher.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.BankToEmployee.ToString()'">
            <label class="col-sm-3 control-label">@Library.Model.Parties.PartyType.Employee.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Employee.ToString()" ng-model="voucher.EmployeeName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" id="Doc Ref" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="5" required autocomplete="off" capitalize>
            </div>
        </div>
        <div id="div_DocDate" class="form-group">
            <label class="col-sm-3 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <textarea rows="2" type="text" name="Narration" tabindex="13" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
        <div class="form-group" ng-show="isBankAmount">
            <label class="col-sm-3 control-label">Bank Amount<sup>*</sup></label>
            <div class="col-sm-9">
                <input type="text" n-decimals="2" class="form-control text-right" name="Amount" ng-model="voucher.BankAmount">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.BankToVendor.ToString()'">
            <label class="col-sm-3 control-label">Vendor Plant<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="4" class="form-control" name="Vendor Plant" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }"
                                ng-change="changePartyPlantList(voucher.PartyPlantId)">
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(voucher.PartyPlantId);" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div id="div_TransactionType" class="form-group" ng-show="voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.BankToEmployee.ToString()'">
            <label class="col-sm-3 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Transaction Type" class="form-control" ng-model="voucher.EmployeeTransactionTypeId" tabindex="7">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in employeeTransactionTypeList" value="{{option.EmployeeTransactionTypeId}}">{{option.EmployeeTransactionTypeName}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" id="div_Amount" show-errors>
            <label class="col-sm-3 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-6 show-message" style="padding-right:0px;">
                <input ng-disabled="voucher.JournalId" tabindex="11" name="Amount" ng-model="voucher.Amount" ng-change="copyAmount();" type="text" n-decimals="2" class="form-control text-right" required autocomplete="off">
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="12" name="Currency" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();" required>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Rate<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" n-decimals="4" id="Rate" name="Rate" ng-model="voucher.CompanyCurrencyRate" ng-keyup="rateChangeBankCharge(voucher.CompanyCurrencyRate)" class="form-control text-right" tabindex="5" required autocomplete="off" ng-disabled="voucher.CurrencyId==companyCurrencyId">
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row form-elements">
        <div class="col-xs-12 col-sm-12 col-md-12 modal-table" ng-show="voucherDetailList.length">
            <table class="table table-responsive table-striped">
                <thead>
                    <tr>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>Amount</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in voucherDetailList">
                        <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td id="td_Amount">
                            <div class="show-message">
                                <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Amount">
                            </div>
                        </td>
                        <td class="text-right">
                            <button ng-click="removeRow($index)" ng-disabled="voucher.Id" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                        </td>
                    </tr>
                </tbody>
                <tfoot ng-show="voucherDetailList.length">
                    <tr>
                        <td></td>
                        <td></td>
                        <td><b>Sub Total</b></td>
                        <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'Amount' }}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>AccountTitle</th>
                    <th>Type</th>
                    <th>Doc Ref No</th>
                    <th>Posting Date</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.AccountTitle}}</td>
                    <td>{{x.BankJournalType}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.TotalAmount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li><a class="btn btn-action" href="Banks/BankReport/GetPaymentByBankReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Banks/BankReport/GetPaymentByBankReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_GLBudgetActivityPopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(advanceId)"></confirm-archive-generic>