<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select id="EntityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="7" required ng-change="changeEntityForBankCash(voucher.EntityId)">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Cash" class="form-control" ng-model="voucher.CashMasterId" ng-options="item.Id as item.UserName for item in cashMasterList" ng-change="onCashChange(voucher.CashMasterId)" tabindex="1" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="4" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Journal Type<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input ng-click="clearBankPopUp();clearJournalType();" type="radio" name="source" ng-disabled="voucher.VoucherId" ng-model="voucher.BankJournalType" value="@Library.Model.Banks.BankJournalType.CashToCash.ToString()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>@Library.Model.Banks.BankJournalType.CashToCash.ToString()
                </label>
                <label>
                    <input ng-click="clearBankPopUp();clearJournalType();" type="radio" name="source" ng-disabled="voucher.VoucherId" ng-model="voucher.BankJournalType" value="@Library.Model.Banks.BankJournalType.CashToBank.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>@Library.Model.Banks.BankJournalType.CashToBank.ToString()
                </label>
                <label>
                    <input ng-click="clearBankPopUp();clearJournalType();" type="radio" name="source" ng-disabled="voucher.VoucherId" ng-model="voucher.BankJournalType" value="@Library.Model.Banks.BankJournalType.CashExpense.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>@Library.Model.Banks.BankJournalType.CashExpense.ToString()
                </label>
                <label>
                    <input ng-click="clearBankPopUp();clearJournalType();" type="radio" name="source" ng-disabled="voucher.VoucherId" ng-model="voucher.BankJournalType" value="@Library.Model.Banks.BankJournalType.ExpenseReverse.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>@Library.Model.Banks.BankJournalType.ExpenseReverse.ToString()
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.CashToCash.ToString()'">
            <label class="col-sm-3 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="To Cash" class="form-control" submit-required="true" ng-model="voucher.OtherCashMasterId" ng-options="item.Id as item.UserName for item in cashMasterList">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.CashToBank.ToString()'">
            <label class="col-sm-3 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Bank" class="form-control" submit-required="true" ng-model="voucher.OtherBankMasterId" ng-options="item.Id as item.AccountTitle for item in bankMasterList">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkPostingDate();checkDocDate();" required class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group" id="div_qty" show-errors>
            <label class="col-sm-3 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-6 show-message" style="padding-right:0px;">
                <input ng-disabled="voucher.JournalId" tabindex="11" ng-model="voucher.Amount" ng-change="copyAmount();" type="text" n-decimals="2" class="form-control text-right" required>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="12" name="CurrencyTransaction" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" required>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.OtherBankMasterId">
            <label class="col-sm-3 control-label">Bank Reference No <sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" id="Bank Reference No" name="Doc Ref" ng-model="voucher.BankReferenceNo" class="form-control" tabindex="5" autocomplete="off">
            </div>
        </div>
        <div class="form-group" ng-show="isBankAmount">
            <label class="col-sm-3 control-label">Bank Amount<sup>*</sup></label>
            <div class="col-sm-9">
                <input type="text" n-decimals="2" class="form-control text-right" name="Amount" ng-model="voucher.BankAmount">
            </div>
        </div>
        <div class="form-group" ng-show="approvedByList.length">
            <label class="col-sm-3 control-label">Approved By<sup>*</sup></label>
            <div class="col-sm-9">
                <div class="select-style" style="font-size:smaller">
                    <select name="ApprovedById" id="ApprovedById" ng-model="voucher.ApprovedById" class="form-control"
                            ng-options="item.Id as item.Value for item in approvedByList" tabindex="6"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-3 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" id="Doc Ref" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="5" required autocomplete="off" capitalize>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Rate<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" n-decimals="4" id="Rate" name="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off" required ng-disabled="voucher.CurrencyId==companyCurrencyId">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" ng-show="voucher.OtherBankMasterId">
            <label class="col-sm-3 control-label">BankTransactionDate<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="BankTransactionDate" ng-model="voucher.BankTransactionDate" datepicker required class="form-control" tabindex="4">
            </div>
        </div>
    </div>
    <div class="col-sx-12 col-sm-8 col-sm-8">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea ng-keyup="updateCrAmount();" rows="3" type="text" name="Narration" tabindex="13" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div ng-show="voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.CashExpense.ToString()' || voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.ExpenseReverse.ToString()'">
        <ul class="list-inline">
            <li><button class="btn single-btn" ng-click="popUp()" tabindex=""><i class="glyphicon glyphicon-plus"></i> GL</button></li>
        </ul>
    </div>
    <div class="row form-elements">
        <div class="col-xs-12 col-sm-12 col-md-12 modal-table" ng-show="voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.CashExpense.ToString()' || voucher.BankJournalType=='@Library.Model.Banks.BankJournalType.ExpenseReverse.ToString()'">
            <table class="table table-responsive table-striped">
                <thead>
                    <tr>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>Amount</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in voucherDetailList">
                        <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td id="td_Amount">
                            <div class="show-message">
                                <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Amount">
                            </div>
                        </td>
                        <td class="text-right">
                            <button ng-click="removeDetaillRow(x.Id,x.VoucherId,x.VoucherDetailId,$index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                        </td>
                    </tr>
                </tbody>
                <tfoot ng-show="voucherDetailList.length">
                    <tr>
                        <td></td>
                        <td></td>
                        <td><b>Sub Total</b></td>
                        <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'Amount' }}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>Cash</th>
                    <th>Posting Date</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id,x);" href="" ng-disabled="x.ApprovedByStatus=='ToBeApproved'" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Banks/CashReport/GetCashJournalReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Banks/CashReport/GetCashJournalReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/_GLBudgetActivityPopUp.cshtml")
<confirm-archive-generic modalid="removePopUp" title="Confirmation" message={{message}} data-ng-click-right-button="detailDelete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(cashJournalId,voucherId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(advanceId)"></confirm-archive-generic>