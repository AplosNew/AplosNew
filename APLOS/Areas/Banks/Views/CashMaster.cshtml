<togglable name="Cash Master"></togglable>
<div class="form-horizontal" ng-form name="cashMasterForm">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-3 col-md-2 control-label">Company<sup>*</sup></label>
            <div class="col-sm-3 col-md-4  show-message">
                <div class="select-style">
                    <select name="Company" ng-model="cashMaster.CompanyId" class="col-sm-3 form-control" ng-change="getData(); onCompanyChange(cashMaster.CompanyId); getCboPlantByCompany(cashMaster.CompanyId)" id="companyId"
                            ng-options="item.Value as item.Text for item in companyList" required></select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
<div ng-form name="cashMasterForm" class="form-elements form-horizontal">
    <input type="hidden" ng-model="cashMaster.Id">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select required id="PlantId" class="form-control" name="Plant" ng-model="cashMaster.PlantId" ng-change="getCboEntityByPlant(cashMaster.CompanyId, cashMaster.PlantId)" tabindex="2">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in plantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" min="1" name="Sequence" ng-model="cashMaster.Sequence" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="15" name="ShortName" ng-model="cashMaster.ShortName" class="form-control" required tabindex="6">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" ng-model="cashMaster.UserName" name="UserName" class="form-control" required tabindex="8">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">GL</label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" name="GL" ng-model="cashMaster.GLGeneralInfoName" class="form-control" readonly>
                    <input type="hidden" class="form-control" ng-model="cashMaster.GLGeneralInfoId">
                    <span class="input-group-btn">
                        <button ng-click="GetCOAICodeList();" data-target="#coaItemCodePopUp" data-placement="top" title="GL Change" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearGLData()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Activity</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="cashMaster.ActivityId" tabindex="12" ng-options="item.ActivityId as item.ActivityName for item in activityList" id="ActivityId" name="Activity"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="2" ng-model="cashMaster.Remarks" name="Remarks" maxlength="250" tabindex="14"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Entity</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="PlantId" class="form-control" name="Plant" ng-model="cashMaster.EntityId" tabindex="3">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="10" name="Code" ng-model="cashMaster.Code" class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="StandardName" ng-model="cashMaster.StandardName" class="form-control" required tabindex="7">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select required id="CurrencyId" class="form-control" name="Currency" ng-model="cashMaster.CurrencyId" tabindex="9">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in currencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Budget</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="cashMaster.BudgetMasterId" ng-options="item.BudgetMasterId as item.BudgetName for item in budgetList" id="BudgetId"
                            name="Budget" tabindex="11" ng-change="getActivity()"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="cashMaster.Active" tabindex="13">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="2" ng-model="cashMaster.Description" name="Remarks" maxlength="250" tabindex="15"></textarea>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Short Name</th>
                <th>User Name</th>
                <th>GL</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in cashMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-archive-generic data-modalid="confirmContactdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeContactMasterRow()"></confirm-archive-generic>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLPopUp.cshtml")