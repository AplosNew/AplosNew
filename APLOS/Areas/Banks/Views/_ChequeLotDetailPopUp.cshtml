<div class="modal fade site-modal in" id="chequeLotPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="bankForm">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closePopUp()" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Cheque Detail List</h4>
            </div>
            <div class="modal-body">
                <p>ChequeLot No : {{TempchequeLot}}</p>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                @*<th>ChequeLot No</th>*@
                                <th>Cheque No</th>
                                <th>IsPrint</th>
                                <th>IsCancel</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in chequeLotDetailList">
                                @*<td>{{x.CheckLotId}}</td>*@
                                <td>{{x.CheckNumber}}</td>
                                <td>{{x.IsPrint?'Yes':'No'}}</td>
                                <td>{{x.IsCancel?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closePopUp()">Close</button>
            </div>
        </div>
    </div>
</div>