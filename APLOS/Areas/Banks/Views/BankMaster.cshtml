<togglable name="Bank Master"></togglable>
<div class="form-horizontal" ng-form name="bankMasterForm">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-3 col-md-2 control-label">Company<sup>*</sup></label>
            <div class="col-sm-3 col-md-4  show-message">
                <div class="select-style">
                    <select name="Company" ng-model="bankMaster.CompanyId" class="col-sm-3 form-control" ng-change="getData(1); onCompanyChange(bankMaster.CompanyId); getCboPlantByCompany(bankMaster.CompanyId);clearGLData()" id="companyId"
                            ng-options="item.Value as item.Text for item in companyList" required></select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
<div ng-form name="bankMasterForm" class="form-elements form-horizontal">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Contact</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="bankMasterForm1">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="10" name="Code" ng-model="bankMaster.Code" class="form-control" tabindex="1" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Bank Category<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="bankCategoryId" class="form-control" name="Bank Category" ng-model="bankMaster.BankCategoryId" required tabindex="3">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in bankCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="bankId" class="form-control" name="Bank" ng-model="bankMaster.BankId" ng-change="onBankChange(bankMaster.BankId)" required tabindex="5">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in bankList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Account Title<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Account Title" ng-model="bankMaster.AccountTitle" class="form-control" tabindex="7" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Account Number<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Account Number" ng-model="bankMaster.AccountNumber" class="form-control" tabindex="9" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Entity</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="PlantId" class="form-control" name="Plant" ng-model="bankMaster.EntityId" tabindex="11">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="CurrencyId" class="form-control" name="Currency" ng-model="bankMaster.CurrencyId" tabindex="13" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in currencyList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">GL</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" name="GL" ng-model="bankMaster.GLGeneralInfoName" class="form-control" readonly>
                                    <input type="hidden" class="form-control" ng-model="bankMaster.GLGeneralInfoId">
                                    <span class="input-group-btn">
                                        <button ng-click="GetCOAICodeList();" data-target="#coaItemCodePopUp" data-placement="top" title="GL Change" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="clearGLData()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="bankMaster.ActivityId" ng-options="item.ActivityId as item.ActivityName for item in activityList" id="ActivityId" name="Activity" tabindex="16"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Review Date</label>
                            <div class="col-sm-8">
                                <input type="text" name="ReviewDate" ng-model="bankMaster.ReviewDate" datepicker class="form-control datepicker" tabindex="19">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Limit Applicable</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="bankMaster.IsLimitApplicable" tabindex="21">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Beyond Limit Transaction Allowed</label>
                            <div class="col-sm-2">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="bankMaster.IsBeyondLimitTransactionAllowed" tabindex="23">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                            <label class="col-sm-4 control-label">Is Negotiating Bank</label>
                            <div class="col-sm-2">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="bankMaster.IsNegotiatingBank" tabindex="23">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="bankMaster.Description" name="Description" maxlength="250" tabindex="25"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Plant</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="PlantId" class="form-control" name="Plant" ng-model="bankMaster.PlantId" ng-change="getCboEntityByPlant(bankMaster.CompanyId, bankMaster.PlantId)" tabindex="2">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in plantList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Bank Subcategory</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="bankSubCategoryId" class="form-control" name="Bank Sub Category" ng-model="bankMaster.BankSubCategoryId" tabindex="4">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in bankSubCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Bank Branch<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="bankBranchId" ng-model="bankMaster.BankBranchId" class="form-control" name="BankBranchName" required tabindex="6">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in bankBranchList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Bank Account Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="bankAccountTypeId" class="form-control" name="Bank Account Type" ng-model="bankMaster.BankAccountTypeId" required tabindex="8">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in bankAccountTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Account Number<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Short Account Number" ng-model="bankMaster.ShortAccountNumber" class="form-control" tabindex="10" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Opening Date</label>
                            <div class="col-sm-8">
                                <input type="text" name="Opening Date" ng-model="bankMaster.OpeningDate" datepicker class="form-control datepicker" tabindex="12">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Reponsible Person</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" name="Responsible Person" ng-model="bankMaster.ResponsiblePerson" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="popUp('ResponsiblePersonId','ResponsiblePerson')" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="clearResponsiblePersonData()" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Budget</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="bankMaster.BudgetMasterId" ng-options="item.BudgetMasterId as item.BudgetName for item in budgetList" id="BudgetMasterId"
                                            name="Budget" tabindex="17" ng-change="getActivity()"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Effective Date" ng-model="bankMaster.EffectiveDate" datepicker class="form-control datepicker" tabindex="18" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="AccountType" class="form-control" name="Type" ng-model="bankMaster.AccountType" required tabindex="20">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in accountTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Limit Amount<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="LimitAmount" ng-model="bankMaster.LimitAmount" class="form-control" tabindex="22" required>
                                <span class="msg-error" ng-show="bankMasterForm.LimitAmount.$error.number">
                                    Not valid number!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="bankMaster.Active" tabindex="24">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="bankMaster.Remarks" name="Remarks" maxlength="250" tabindex="26"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-3 col-md-2 control-label">Contact Type</label>
                            <div class="col-sm-3 col-md-4">
                                <div class="select-style">
                                    <select class="form-control" ng-model="contactMaster.Type" name="Type" tabindex="30">
                                        <option value="Company">Company</option>
                                        <option value="Bank">Bank</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="row" ng-form name="bankMasterForm2">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" title="Contact Person Name">Person Name</label>
                            <div class="col-sm-8">
                                <input type="text" name="ContactPerson" maxlength="100" ng-model="contactMaster.ContactPerson" class="form-control" tabindex="31">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Phone1</label>
                            <div class="col-sm-8">
                                <input type="text" name="Phone1" maxlength="20" ng-model="contactMaster.Phone1" class="form-control" tabindex="33">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Mobile</label>
                            <div class="col-sm-8">
                                <input type="text" name="Mobile" maxlength="20" ng-model="contactMaster.Phone3" class="form-control" tabindex="35">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email1</label>
                            <div class="col-sm-8">
                                <input type="email" name="Email1" maxlength="50" ng-model="contactMaster.Email1" class="form-control" placeholder="example@gmail.co" tabindex="37">
                                <span class="msg-error" ng-show="bankMasterForm2.Email1.$error.email">
                                    Not valid email!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email3</label>
                            <div class="col-sm-8">
                                <input type="email" name="Email3" maxlength="50" ng-model="contactMaster.Email3" class="form-control" placeholder="example@gmail.co" tabindex="39">
                                <span class="msg-error" ng-show="bankMasterForm2.Email3.$error.email">
                                    Not valid email!
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" title="Contact Person Designation">Designation</label>
                            <div class="col-sm-8">
                                <input type="text" name="ContactPersonDesignation" maxlength="30" ng-model="contactMaster.ContactPersonDesignation" class="form-control" tabindex="32">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Phone2</label>
                            <div class="col-sm-8">
                                <input type="text" name="Phone2" maxlength="20" ng-model="contactMaster.Phone2" class="form-control" tabindex="34">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Fax</label>
                            <div class="col-sm-8">
                                <input type="text" name="Fax" maxlength="50" ng-model="contactMaster.Fax" class="form-control" tabindex="36">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Email2</label>
                            <div class="col-sm-8">
                                <input type="email" name="Email2" maxlength="50" ng-model="contactMaster.Email2" class="form-control" placeholder="example@gmail.co" tabindex="38">
                                <span class="msg-error" ng-show="bankMasterForm2.Email2.$error.email">
                                    Not valid email!
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Website</label>
                            <div class="col-sm-8">
                                <input type="text" maxlength="50" ng-model="contactMaster.Website" class="form-control" tabindex="40">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button class="btn" ng-click="addRow()"><i class="glyphicon glyphicon-plus"></i>{{ContactAction}}</button></li>
                        <li> <button ng-click="ClearContact();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear Contact Form</button></li>
                    </ul>
                </div>
                <div class="table-responsive modal-table" ng-show="showContactMaster">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Person Name</th>
                                <th>Designation</th>
                                <th>Phone</th>
                                <th>Mobile</th>
                                <th>Email</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="c in contactMasters" ng-show="isArchive(c.Archive)">
                                <td>{{c.ContactPerson}}</td>
                                <td>{{c.ContactPersonDesignation}}</td>
                                <td>{{c.Phone1}}</td>
                                <td>{{c.Phone3}}</td>
                                <td>{{c.Email1}}</td>
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="GetContact(c.Id, $index)" class="btn-action tooltip-here" data-placement="top" title="Edit">
                                                <i class="glyphicon glyphicon-pencil"></i>
                                            </button>
                                        </li>
                                        <li>
                                            <button ng-click="valuePassInDelModal(c.Id, c.ContactPerson)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Bank</th>
                <th>Bank Branch</th>
                <th>Account Number</th>
                <th>Account Title</th>
                <th>Type</th>
                <th>Currency</th>
                <th>GL</th>
                <th>Plant</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in bankMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Code}}</td>
                <td>{{x.BankName}}</td>
                <td>{{x.BankBranch}}</td>
                <td>{{x.AccountNumber}}</td>
                <td>{{x.AccountTitle}}</td>
                <td>{{x.AccountType}}</td>
                <td>{{x.CurrencyName}}</td>
                <td>{{x.GLGeneralInfoName}}</td>
                <td>{{x.PlantName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-archive-generic data-modalid="confirmContactdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeContactMasterRow()"></confirm-archive-generic>
<confirm-modal></confirm-modal>
@Html.Partial("_ConfirmModal")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLPopUp.cshtml")
@Html.Partial("_DynamicPopUp")