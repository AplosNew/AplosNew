<togglable name="Entity Expense Booking Posting"></togglable>
<div class="form-elements form-horizontal" ng-form="form1">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div >
                    <select id="EntityId" class="form-control" name="Entity" ng-disabled="true" ng-model="voucher.EntityId" tabindex="7" required>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div >
                    <select name="Cash" class="form-control" ng-model="voucher.CashMasterId" ng-disabled="true" ng-options="item.Id as item.UserName for item in cashMasterList" tabindex="1" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    
    
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoice Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Currency Code" ng-model="voucher.CurrencyName" class="form-control" tabindex="4" disabled required>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Invoice Number<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" disabled required>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <textarea rows="3" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="expensesBookingDetailList.length">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>GL</th>
                    <th>Budget</th>
                    <th>Activity</th>
                    <th>Expense Date</th>
                    <th class="text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in expensesBookingDetailList">
                    <td>{{x.BudgetName}}</td>
                    <td>{{x.BudgetName}}</td>
                    <td>{{x.ActivityName}}</td>
                    <td>{{x.DocDate | dateFiltering}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                </tr>
            </tbody>
            <tfoot ng-show="expensesBookingDetailList.length">
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ expensesBookingDetailList | sumByKey : 'Amount' }}</b></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Voucher No</th>
                <th>Invoice Number</th>
                <th>Invoice Date</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Approved Status</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in budgetTransactionMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.InvoiceNumber}}</td>
                <td>{{x.InvoiceDate | dateFiltering}}</td>
                <td>{{x.CurrencyName}}</td>
                <td>{{x.Amount}}</td>
                <td>{{x.ApprovalStatus}}</td>
                <td>{{x.IsPosted?'Posted':'Parked'}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li><a class="btn btn-action" ng-show="x.VoucherId" href="Banks/CashReport/GetCashJournalReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" ng-show="x.VoucherId" href="Banks/CashReport/GetCashJournalReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>