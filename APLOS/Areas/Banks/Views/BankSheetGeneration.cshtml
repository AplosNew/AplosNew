<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Bank Sheet Generation</h3>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5">

        <div class="form-group" show-errors id="div_FromDate">
            <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="From Date" ng-model="report.FromDate" datepicker class="form-control" required tabindex="5">
            </div>
        </div>

    </div>

    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors id="div_ToDate">
            <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="To Date" ng-model="report.ToDate" datepicker class="form-control" required tabindex="6">
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-2 col-md-2">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li><button ng-click="getPartyData();" class="btn"><i class="glyphicon glyphicon-download"></i> Go</button></li>
            </ul>
        </div>
    </div>

    <div class="col-md-12" ng-show="ShowData">
        <div class="content-container-fluid">
            @*style="color:black;overflow:scroll"*@
            <div style="color:black;" id="partyPopUpGrid" ej-grid e-datasource="newPartyList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                <div e-columns>
                    <div e-column e-headertext="Select" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>
                    <div e-column e-field="PartyCode" e-headertext="Code" e-width="50" e-filter="false"></div>
                    <div e-column e-field="Party" e-headertext="Party" e-width="130"></div>
                    <div e-column e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="130"></div>
                    <div e-column e-field="Currency" e-headertext="Currency" e-width="50"></div>
                    <div e-column e-field="Country" e-headertext="Country" e-width="80" textAlign='Right'></div>
                    <div e-column e-field="PartyState" e-headertext="State" e-width="80" textAlign='Right'></div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/template" id="checkboxTemplate">
        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelect" />
    </script>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-show="ShowData" ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i>Download</button></li>
        </ul>
    </div>
</div>
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@*@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")*@
