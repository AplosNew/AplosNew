            <thead>
                <tr>
                    <th>Id</th>
                    <th>BankName</th>
                    <th>Bank Statement No</th>
                    <th>From Date</th>
                    <th>To Date</th>
                    <th>Opening Blance</th>
                    <th>Closing Balance</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in bankreconciliationList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.Id}}</td>
                    <td>{{x.BankName}}</td>
                    <td>{{x.BankStatementNo}}</td>
                    <td>{{x.FromDate | dateFiltering}}</td>
                    <td>{{x.ToDate | dateFiltering}}</td>
                    <td class="text-right">{{x.OpeningBlance | number:2}}</td>
                    <td class="text-right">{{x.ClosingBalance | number:2}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li><a ng-click="confirmDelete(x.Id);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            @*<li><a class="btn btn-action" href="Accounts/Advance/ReportCustomerAdvance?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/ReportCustomerAdvance?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>*@
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
        <confirm-modal></confirm-modal>
        <confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(bankReconciliationId)"></confirm-archive-generic>
        @Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
