<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Cheque Lot Creation</h3>
<div class="form-elements form-horizontal" ng-form id="checkLotNew" name="checkLotNewForm">
    <input type="hidden" ng-model="checkLotNew.Id">
    @*{{checkLotNew.babu}}*@
    <div class="col-xs-12 col-sm-6 col-md-6">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Bank Information</legend>
            <div class="form-group">
                <label class="col-sm-3 control-label">Bank</label>
                <div class="col-sm-7 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" ng-model="checkLotNew.BankName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showBankPopUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Branch</label>
                <label class="col-sm-7 control-label">: {{checkLotNew.BankBranch}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Account</label>
                <label class="col-sm-7 control-label">: {{checkLotNew.BankAccount}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Bank GL</label>
                <label class="col-sm-7 control-label">: {{checkLotNew.BankGL}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Bank Currency</label>
                <label class="col-sm-7 control-label">: {{checkLotNew.BankCurrency}}</label>
            </div>
        </fieldset>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Lot Number</label>
            <div class="col-sm-5 pdr3 show-message">
                <input type="text" name="Lot Number"  ng-model="checkLotNew.LotNumber" class="form-control" required>
            </div>
        </div>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Check No</legend>
            <div class="form-group">
                <label class="col-sm-1 control-label">From</label>
                <div class="col-sm-5 pdr3">
                    <input type="text" ng-model="checkLotNew.FromNo" class="form-control" n-decimals="2" tabindex="2">
                </div>
                <label class="col-sm-1 control-label pdl3" style="margin-right: -19px;">To</label>
                <div class="col-sm-5 pdl3 pdr3">
                    <input type="text" ng-model="checkLotNew.ToNo" class="form-control" n-decimals="2" tabindex="3">
                </div>
            </div>
        </fieldset>
        <div class="form-group">
            <label class="col-sm-4 control-label">Can issue non sequential</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" class="css-checkbox" ng-model="checkLotNew.IsNonSequential">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" class="css-checkbox" ng-model="checkLotNew.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>

    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Lot Number</th>
                    <th>From No</th>
                    <th>To No</th>
                    <th>Non Sequential</th>
                    <th>Detail</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in chequeList |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                    <td>{{x.Id}}</td>
                    <td>{{x.LotNumber}}</td>
                    <td>{{x.FromNo}}</td>
                    <td>{{x.ToNo}}</td>
                    <td>{{x.IsNonSequential?'Yes':'No'}}</td>
                    <td class="text-right">
                        <button ng-click="Get(x)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Edit">
                            <i class="glyphicon glyphicon-edit"></i>
                        </button>
                        <button ng-click="getchequeLotDetailList(x.Id)" class="btn btn-action tooltip-here" data-placement="top" title="Detail">
                            <i class="cr-icon glyphicon glyphicon-list-alt"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_ChequeLotDetailPopUp.cshtml")