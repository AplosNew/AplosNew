                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="invoiceParameters.search" ng-enter="getBankReconciliationUploadedData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getBankReconciliationUploadedData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Id</th>
                                <th>Date</th>
                                <th>Bank RefNo</th>
                                <th>Bank Particulars</th>
                                <th class="text-right">DrAmount</th>
                                <th class="text-right">CrAmount</th>
                                <th>Remarks</th>
                                <th>OwnRefNo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in invoiceList |itemsPerPage:invoiceParameters.pageSize" pagination-id="metaData.name + 'invoiceList'"
                                total-items="invoiceParameters.total_count" ng-class="{selected : x.VoucherDetailId == selectedVoucherDetailId}">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Active">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Id}}</td>
                                <td>{{x.BankStatementDate}}</td>
                                <td>{{x.BankRefNo}}</td>
                                <td>{{x.BankParticulars}}</td>
                                <td class="text-right">{{x.DrAmount | number:2}}</td>
                                <td class="text-right">{{x.CrAmount | number:2}}</td>
                                <td>{{x.Remarks}}</td>
                                <td>{{x.OwnRefNo}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'invoiceList'" direction-links="true" boundary-links="true" on-page-change="getBankReconciliationUploadedData(newPageNumber)"></dir-pagination-controls>
                </div>
            </div>
