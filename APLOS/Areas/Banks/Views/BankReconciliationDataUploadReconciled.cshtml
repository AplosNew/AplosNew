<style>
    .tbl table {
        border: 1px solid #659EC7;
    }

        .tbl table thead th {
            border: 1px solid #659EC7;
        }

    .tbl tbody td {
        border: 1px solid #659EC7;
    }
</style>

<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Bank Reconciliation</h3>
<div class="form-elements form-horizontal" ng-form id="bankReconciliationNew" name="bankReconciliationNewForm">
    <input type="hidden" ng-model="bankReconciliationNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Bank Information</legend>
            <div class="form-group">
                <label class="col-sm-3 control-label">Bank</label>
                <div class="col-sm-7 pdr3">
                    <input type="text" ng-model="bankReconciliationNew.BankName" class="form-control" readonly>
                </div>
                <button ng-click="showBankPopUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Branch</label>
                <label class="col-sm-7 control-label">: {{bankReconciliationNew.BankBranch}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Account</label>
                <label class="col-sm-7 control-label">: {{bankReconciliationNew.BankAccount}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Bank GL</label>
                <label class="col-sm-7 control-label">: {{bankReconciliationNew.BankGL}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Bank Currency</label>
                <label class="col-sm-7 control-label">: {{bankReconciliationNew.BankCurrency}}</label>
            </div>
        </fieldset>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Date Range</legend>
            <div class="form-group" id="div_ToDate" show-errors>
                <label class="col-sm-1 control-label">From</label>
                <div class="col-sm-4 pdr3">
                    <input type="text" ng-model="bankReconciliationNew.FromDate" datepicker class="form-control" required tabindex="2">
                </div>
                <label class="col-sm-1 control-label pdl3" style="margin-right: -19px;">To</label>
                <div class="col-sm-4 show-message">
                    <input type="text" ng-model="bankReconciliationNew.ToDate" datepicker="checkDocDate();" class="form-control" required tabindex="3">
                </div>
                <div class="pdr3">
                    <button ng-click="getBnkReconList()" ng-disabled="bankReconciliationNew.BankName==null" class="btn single-small-btn" tabindex="4"><i class="glyphicon glyphicon-hourglass"></i> Load</button>
                </div>
            </div>

        </fieldset>
        
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" ng-disabled="saveBtnDisable==true"  tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
        </ul>
    </div>
    <!-- #region Tab -->
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                @*<li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>*@

                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="address" role="tab" data-toggle="tab">Dr. Reconcile Pending</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Dr. Reconciled</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="address" role="tab" data-toggle="tab">Cr. Reconcile Pending</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="address" role="tab" data-toggle="tab">Cr. Reconciled</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <fieldset class="scheduler-border">
                            <legend class="scheduler-border">Dr. Reconcile Pending</legend>
                            <div class="content-container-fluid" style="color:black;overflow:scroll">
                                <div style="color:black;" id="GridbankDrReconList"
