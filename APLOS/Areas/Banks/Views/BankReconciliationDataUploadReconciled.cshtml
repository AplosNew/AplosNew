                                     e-allowfiltering="true"
                                     e-allowpaging="true"
                                     e-gridlines="vertical" e-allowscrolling="true"
                                     e-filtersettings-filterType="excel"
                                     e-enabletouch="false"
                                     e-allowresizing="true"
                                     e-allowselection="false"
                                     e-allowsorting="true">
                                    <div e-columns>
                                        <div e-column e-field="VoucherDetailId" e-headertext="Id" e-width="60" e-textalign="center"></div>
                                        <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="50" e-textalign="center"></div>
                                        <div e-column e-field="PostingDate" e-headertext="Posting Date" e-width="40" e-textalign="center"></div>
                                        <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="40" e-textalign="center"></div>
                                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Amount" e-headertext="Amount" e-width="50" e-textalign="right" style="height: 20px;"></div>
                                        <div e-column e-headertext="Select" e-template="#checkbankDrRecon" e-textalign="center" e-width="30"></div>
                                    </div>
                                </div>
                                <script type="text/template" id="checkbankDrRecon">
                                    <input type="checkbox" ng-model="data.Flag" ng-checked="data.Flag" ng-click="$parent.isReconciledBankDrReconAmount($event,data,4,'bankDrReconAmount');$parent.listMergebankDrTempList($event,data);">
                                </script>
                            </div>
                            <fieldset>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">Selected Reconciled Amount </label>
                                    <label class="col-sm-7 control-label">: {{bankDrReconAmount}}</label>
                                </div>
                            </fieldset>
                        </fieldset>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
