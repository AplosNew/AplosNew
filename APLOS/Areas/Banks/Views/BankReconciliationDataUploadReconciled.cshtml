                                    <ul class="common-btn list-inline text-center">
                                        <li>
                                            <button ng-click="$parent.onClickDeletePopUp(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Delete">
                                                <i class="glyphicon glyphicon-trash" style="color:orangered;"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </script>
                        </fieldset>
                    </div>
