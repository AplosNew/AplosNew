<togglable name="Country"></togglable>
<div class="form-elements form-horizontal" ng-form="countryForm">
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" role="tab" data-toggle="tab">Language</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Sequence" ng-model="countryNew.Sequence" class="form-control" required placeholder="0" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input maxlength="15" type="text" name="Short Name" ng-model="countryNew.ShortName" class="form-control" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input maxlength="50" type="text" name="User Name" ng-model="countryNew.UserName" class="form-control" required tabindex="5">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label tooltip-here" data-placement="top" title="International Calling Code" tooltip>ICC<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input maxlength="10" type="text" name="Internation countryNew code" ng-model="countryNew.ICC" class="form-control" required tabindex="7">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">GMT Hour<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="GMT Hour" ng-model="countryNew.GMTHour" class="form-control" required placeholder="0" tabindex="9">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-change="GetAll()" name="Currency Name" submit-required="true" ng-model="countryNew.CurrencyId"
                                            ng-options="item.Value as item.Text for item in currencyList" tabindex="11" required>
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">NID Caption</label>
                            <div class="col-sm-8">
                                <input maxlength="30" type="text" name="NID Caption" ng-model="countryNew.NIDCaption" class="form-control" tabindex="13">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">TIN Caption</label>
                            <div class="col-sm-8">
                                <input maxlength="30" type="text" name="TIN Caption" ng-model="countryNew.TINCaption" class="form-control" tabindex="15">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <textarea maxlength="250" class="form-control" rows="2" ng-model="countryNew.Description" tabindex="17"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="countryNew.Active">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input maxlength="10" type="text" name="Code" ng-model="countryNew.Code" class="form-control" required tabindex="2">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input maxlength="50" type="text" name="Standard Name" ng-model="countryNew.StandardName" class="form-control" required tabindex="4">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Continent<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-change="GetAll()" name="Continent Name" submit-required="true" ng-model="countryNew.ContinentId" ng-options="item.Value as item.Text for item in continentList" tabindex="6" required>
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Nationality<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Nationality" ng-model="countryNew.Nationality" class="form-control" required tabindex="8">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">GMT Minute<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="GMT Minute" ng-model="countryNew.GMTMinute" class="form-control" required tabindex="10">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Phone Length</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Phone Length" only-numbers ng-model="countryNew.PhoneLength" class="form-control text-right" tabindex="12">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">NID Length</label>
                            <div class="col-sm-8">
                                <input type="text" name="NID Length" ng-model="countryNew.NIDLength" class="form-control text-right" only-numbers tabindex="14">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">TIN Length</label>
                            <div class="col-sm-8">
                                <input type="text" name="TIN Length" ng-model="countryNew.TINLength" class="form-control text-right" only-numbers tabindex="16">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea maxlength="250" class="form-control" rows="2" ng-model="countryNew.Remarks" tabindex="18"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Language</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="languageId" class="form-control" name="Language" ng-model="languageNew.LanguageId" tabindex="1">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in languageList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Nationality in Locally</label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="languageNew.UtilityName" name="Name" maxlength="20" class="form-control" tabindex="3">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Locally Translated Name</label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="languageNew.Name" name="Name" maxlength="50" class="form-control" tabindex="2">
                            </div>
                        </div>
                        <button ng-click="AddMultipleLanguage();" class="btn single-small-btn"><i class="glyphicon glyphicon-plus" tabindex="4"></i> {{LanguageCaption}}</button>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="languageDataList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Language</th>
                                        <th>Locally Translated Name</th>
                                        <th>Nationality in Locally</th>
                                        <th class="col-md-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="x in languageDataList |itemsPerPage:languageDataParameters.pageSize" total-items="languageDataParameters.total_count"
                                        pagination-id="metaData.name + 'languageDataList'">
                                        <td>{{x.LanguageName}}</td>
                                        <td>{{x.Name}}</td>
                                        <td>{{x.UtilityName}}</td>
                                        <td class="text-center table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="languageEdit(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                        <i class="glyphicon glyphicon-edit"></i>
                                                    </button>
                                                </li>
                                                <li>
                                                    <button ng-click="languageDelete(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <dir-pagination-controls max-size="10"
                                                     pagination-id="metaData.name + 'languageDataList'"
                                                     direction-links="true"
                                                     boundary-links="true"
                                                     on-page-change="getlanguageData(newPageNumber)">
                            </dir-pagination-controls>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="19"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="20"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="21"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Nationality</th>
                <th>ICC</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in  filtered = (countries | orderBy:'Sequence') |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get($index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Nationality}}</td>
                <td>{{x.ICC}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmlngPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>