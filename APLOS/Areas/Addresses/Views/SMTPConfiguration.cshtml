<togglable name="SMTP Configuration"></togglable>
<div class="form-horizontal" ng-form id="area" name="areaForm">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Company Group<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="area.CompanyGroupId" ng-change="companyGroupOnChange()"
                            ng-options="item.Value as item.Text for item in companyGroupList" name="CompanyGroup" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sender System Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input maxlength="30" type="text" name="Sender System Name" ng-model="area.SenderSystemName" class="form-control" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Host<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input maxlength="150" type="text" name="Host" ng-model="area.Host" class="form-control" required tabindex="4" placeholder="example.com">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Mailing UserName<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input maxlength="150" type="text" name="Mailing UserName" ng-model="area.MailingUserName" class="form-control" required tabindex="6" placeholder="example@mail.com">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Company</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="area.CompanyId" id="companyId"
                                ng-options="item.Value as item.Text for item in companyList" name="Company" tabindex="8">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sender System Email<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input maxlength="30" type="text" name="Sender System Email" ng-model="area.SenderSystemEmail" class="form-control" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Port<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" only-numbers name="Host" ng-model="area.Port" class="form-control" required tabindex="5">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Mailing Password<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Mailing Password" ng-model="area.Password" class="form-control" required tabindex="7">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">SSL</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label class="control-label">
                            <input type="checkbox" ng-model="area.IsSSL" tabindex="9">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>CompanyName</th>
                <th>Sender System Name</th>
                <th>Sender System Email</th>
                <th>Host</th>
                <th>Port</th>
                <th>Mailing User Name</th>
                <th>Password</th>
                <th>SSL</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in areas |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.CompanyName}}</td>
                <td>{{x.SenderSystemName}}</td>
                <td>{{x.SenderSystemEmail}}</td>
                <td>{{x.Host}}</td>
                <td>{{x.Port}}</td>
                <td>{{x.MailingUserName}}</td>
                <td>{{x.Password}}</td>
                <td>{{x.IsSSL?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>