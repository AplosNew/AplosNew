<togglable name="{{title}}"></togglable>
<style>

    .filled {
        background-color: #ff0000 !important;
    }
</style>
<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script>

<div class="form-elements form-horizontal" ng-form name="VoucherForm">
    <div class="row" ng-form name="General">
        <input type="hidden" ng-model="Voucher.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Date" ng-model="Voucher.FromDate" datepicker class="form-control" required tabindex="1">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">ICS Master<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="Voucher.ICSMasterID" ng-change="GetCropPlanning();" name="ICS Master"
                                ng-options="item.Value as item.Text for item in ICSMasterList" required tabindex="3">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Time<sup>*</sup></label>
                <div class="col-sm-7 input-group bootstrap-timepicker timepicker" style="float:right">
                    <input id="Time" type="text" class="form-control input-small" ng-model="Voucher.Time" style="margin-left:-36px; width:345px" tabindex="5">
                    <span class="input-group-addon" style="float:left; width:37px"><i class="glyphicon glyphicon-time"></i></span>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label" title="Prepared By"><span>Prepared By</span></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon" ng-class="{filled:Voucher.EmployeeStatus==='Separated'}">{{Voucher.EmployeeCode}}</span>
                    <input type="text" ng-model="Voucher.ResponsiblePerson" class="form-control" readonly ng-class="{filled:Voucher.EmployeeStatus==='Separated'}">
                    <span class="input-group-btn">
                        <button ng-click="ResponsiblePersonPopUp()" tabindex="7" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="ResponsiblePersonClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Date" ng-model="Voucher.ToDate" datepicker class="form-control" required tabindex="2">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Date" ng-model="Voucher.Date" datepicker class="form-control" required tabindex="4">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Approve By"><span>Approve By</span></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon" ng-class="{filled:Voucher.EmpStatus==='Separated'}">{{Voucher.EmpCode}}</span>
                    <input type="text" ng-model="Voucher.EmpName" class="form-control" readonly ng-class="{filled:Voucher.EmpStatus==='Separated'}">
                    <span class="input-group-btn">
                        <button ng-click="ApproveByPopUp()" tabindex="6" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="ApproveByClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>

        </div>
        <br />
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="SearchVoucher()" class="btn" tabindex="8"><i class="glyphicon glyphicon-search"></i>Search</button></li>
            </ul>
        </div>

        <div class="col-xs-12">
            <div style="color:black;" id="GridVoucherChildTab" ej-grid e-datasource="VoucherChildList"
                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>

                    <div e-column e-type="string" e-field="ICSMaster" e-headertext="ICS Master" e-width="20"></div>
                    <div e-column e-type="string" e-field="FarmerName" e-headertext="Farmer Name" e-width="30"></div>
                    <div e-column e-type="string" e-field="FarmerRegistrationID" e-headertext="Farmer Registration ID" e-width="30"></div>
                    <div e-column e-type="string" e-field="MobileNo" e-headertext="Mobile No" e-width="30"></div>
                    <div e-column e-type="string" e-field="NationalID" e-headertext="Aadhar No" e-width="30"></div>
                    <div e-column e-type="string" e-field="BankName" e-headertext="Bank Name" e-width="30"></div>
                    <div e-column e-type="string" e-field="AccountNo" e-headertext="Account No" e-width="35"></div>
                    <div e-column e-type="string" e-field="IFSCCode" e-headertext="IFSC Code" e-width="30"></div>
                    <div e-column e-type="string" e-field="TotalTransaction" e-headertext="Total Transaction" e-width="20"></div>
                    <div e-column e-type="string" e-field="TotalAmount" e-headertext="Total Amount" e-width="20"></div>
                    <div e-column e-type="string" e-field="DebitGLCode" e-headertext="Debit Code" e-width="35"></div>
                    <div e-column e-type="string" e-field="CreditGLCode" e-headertext="Credit-Code" e-width="35"></div>
                    <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="35"></div>

                    @*<div e-column e-template="#DeletePurchaseBookingSodaChildTab" e-width="40"></div>*@
                </div>
            </div>

            @*<script type="text/template" id="DeletePurchaseBookingSodaChildTab">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="$parent.ConfirmDeletePurchaseBookingSodaChildTab(data.Id);" class="btn" tabindex="15"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                    </ul>
                </div>
            </script>*@

        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="GenerateVoucher()" class="btn" ng-disabled="Voucher.Id!=null" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Generate</button></li>
                @*<li> <button ng-click="Save()" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="12"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                <li> <button ng-click="Clear()" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <confirm-modal></confirm-modal>

</div>


<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">

    <div id="VoucherListGrid" ej-grid e-datasource="VoucherList"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-recorddoubleclick="Get">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="VoucherDate" e-headertext="Date" e-width="1"></div>
            <div e-column e-field="VoucherTime" e-headertext="Time" e-width="1"></div>
            <div e-column e-field="ResponsiblePerson" e-headertext="Prepared By" e-width="2"></div>
            <div e-column e-field="EmpName" e-headertext="Approved By" e-width="2"></div>            
        </div>
    </div>

</div>

<div class="modal fade site-modal in" id="EmployeePopUpResPerson" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Prepared By List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridEmployeeResPerson" ej-grid e-datasource="EmpResPersonList"
                             e-allowfiltering="true" e-recorddoubleclick="setEmpData" e-allowpaging="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>

                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                                <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="PositionName" e-headertext="Position" e-width="140"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-type="string" e-field="DepartmentName" e-headertext="Department Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                            </div>

                        </div>

                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>

                            <button ng-click="closeEmpResPersonPopUp('EmployeePopUpResPerson');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>

</div>

<div class="modal fade site-modal in" id="EmpPopUpResPerson" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Approve By List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridEmpResPerson" ej-grid e-datasource="EmpApproveByList"
                             e-allowfiltering="true" e-recorddoubleclick="setEmpApproveByData" e-allowpaging="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>

                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                                <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="PositionName" e-headertext="Position" e-width="140"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-type="string" e-field="DepartmentName" e-headertext="Department Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                            </div>

                        </div>

                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>

                            <button ng-click="closeEmpApproveByPopUp('EmpPopUpResPerson');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>

</div>

<confirm-archive-generic modalid="DeletePurchaseBookingSodaChildTabPopUp" title="Confirmation" message="Are you sure want to Delete?" data-ng-click-right-button="DeletePurchaseBookingSodaChild();"></confirm-archive-generic>

<script type="text/javascript">
    $('[id*=Time]').timepicker({ showMeridian: false, defaultTime: false }).on('changeTime.timepicker', function (e) {
        var hours = e.time.hours, //Returns a string
            min = e.time.minutes
        //merdian = e.time.meridian;

        if (hours.length == 1) {
            $('[id*=Time]').timepicker('setTime', '0' + hours + ':' + min);

        }
    });
</script>