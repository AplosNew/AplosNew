<togglable name="{{title}}"></togglable>
<style>

    .filled {
        background-color: #ff0000 !important;
    }
</style>
<div class="form-elements form-horizontal" ng-form name="DailyCropRateForm">
    <div class="row" ng-form name="General">
        <input type="hidden" ng-model="DailyCropRate.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="DailyCropRate.Date" datepicker class="form-control" name="Date" required tabindex="1">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Crop<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="DailyCropRate.CropId" name="Crop" ng-change="GetCropType();"
                                ng-options="item.Value as item.Text for item in CropList" required tabindex="3">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Target Rate</label>
                <div class="col-sm-8">
                    <input type="text" ng-model="DailyCropRate.TargetRate" class="form-control" tabindex="5" maxlength="50">
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label" title="Approve By"><span>Approve By</span></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon" ng-class="{filled:DailyCropRate.EmployeeStatus==='Separated'}">{{DailyCropRate.EmployeeCode}}</span>
                    <input type="text" ng-model="DailyCropRate.ResponsiblePerson" class="form-control" readonly ng-class="{filled:DailyCropRate.EmployeeStatus==='Separated'}">
                    <span class="input-group-btn">
                        <button ng-click="ResponsiblePersonPopUp()" tabindex="7" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="ResponsiblePersonClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="DailyCropRate.LocationId" name="Location"
                                ng-options="item.Value as item.Text for item in LocationList" required tabindex="2">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Crop Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="DailyCropRate.CropTypeId" name="Crop Type" ng-change="GetPlanMaximumRate();"
                                ng-options="item.Value as item.Text for item in CropTypeList" required tabindex="4">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Maximum Rate</label>
                <div class="col-sm-8">
                    <input type="text" ng-model="DailyCropRate.MaximumRate" class="form-control" tabindex="6" maxlength="50">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Plan Maximum Rate</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="DailyCropRate.PlanMaximumRateId" ng-disabled="DailyCropRate.Id==null || DailyCropRate.Id!=null"
                                ng-options="item.Value as item.Text for item in PlanMaximumRateList" tabindex="8">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" ng-model="DailyCropRate.Remarks" tabindex="10" maxlength="250"></textarea>
                </div>
            </div>

        </div>
        <br />
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save()" class="btn" tabindex="18"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="19"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear()" class="btn" tabindex="20"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <confirm-modal></confirm-modal>

    
    @*<div id="DailyCropRateListGrid" ej-grid e-datasource="DailyCropRateList2"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-recorddoubleclick="Get">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Date" e-headertext="Date" e-width="1"></div>
            <div e-column e-field="Location" e-headertext="Location" e-width="1"></div>
            <div e-column e-field="Crop" e-headertext="Crop" e-width="2"></div>
            <div e-column e-field="CropType" e-headertext="Crop Type" e-width="2"></div>
            <div e-column e-field="TargetRate" e-headertext="Target Rate" e-width="2"></div>
            <div e-column e-field="MaximumRate" e-headertext="Maximum Rate" e-width="2" e-visible="true"></div>

        </div>
    </div>*@
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">

    <div id="DailyCropRateListGrid" ej-grid e-datasource="DailyCropRateList"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-recorddoubleclick="Get">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Date" e-headertext="Date" e-width="2"></div>
            <div e-column e-field="Location" e-headertext="Location" e-width="1"></div>
            <div e-column e-field="Crop" e-headertext="Crop" e-width="2"></div>
            <div e-column e-field="CropType" e-headertext="Crop Type" e-width="2"></div>
            <div e-column e-field="TargetRate" e-headertext="Target Rate" e-width="2"></div>
            <div e-column e-field="MaximumRate" e-headertext="Maximum Rate" e-width="2" e-visible="true"></div>


        </div>
    </div>
</div>



<div class="modal fade site-modal in" id="EmployeePopUpResPerson" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Responsible Person List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridEmployeeResPerson" ej-grid e-datasource="EmpResPersonList"
                             e-allowfiltering="true" e-recorddoubleclick="setEmpData" e-allowpaging="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>

                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                                <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="PositionName" e-headertext="Position" e-width="140"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-type="string" e-field="DepartmentName" e-headertext="Department Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                            </div>

                        </div>

                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>

                            <button ng-click="closeEmpResPersonPopUp('EmployeePopUpResPerson');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>

</div>
