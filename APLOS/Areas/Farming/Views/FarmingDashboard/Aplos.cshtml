                            <button type="button" ng-click="InactiveFarmersReport(currentGroup)" class="btn single-btn"><i class="glyphicon glyphicon-arrow-down"></i> Download </button>

                            <div style="color:black;" ej-grid e-datasource="InactiveFarmersModal"
