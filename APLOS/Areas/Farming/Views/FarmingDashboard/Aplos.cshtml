                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-primary" data-dismiss="modal" ng-click="pageSet();">Close</button>
                    </div>
                </div>

            </div>
        </div>


        <!--The total Area Modal-->
        <div class="modal fade site-modal in" id="ShowTotalArea" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <button class="close" data-dismiss="modal">&times;</button>
                        <h1 class="modal-title" style="font-size:50px; text-align:center; margin:-10px;">Total Area</h1>
                    </div>
                    <div class="modal-body" style="min-height:300px;">
                        <div class="row" style="margin: 20px; font-style:italic"> Total Area under {{currentGroup.Group}} </div>

                        <div>
                            <button type="button" ng-click="TotalAreaReport(currentGroup)" class="btn single-btn"><i class="glyphicon glyphicon-arrow-down"></i> Download </button>
                            <div style="color:black;" ej-grid e-datasource="TotalAreaModal"
                                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enableColumnResizing="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel">

                                <div e-columns>
                                    <div e-column e-type="string" e-field="Snum" e-headertext="S. No" e-width="10" textAlign="center"></div>
                                    <div e-column e-type="string" e-field="FarmerId" e-headertext="Farmer ID" e-width="20"></div>
                                    <div e-column e-type="string" e-field="TracenetId" e-headertext="Tracenet ID" e-width="20"></div>
                                    <div e-column e-type="string" e-field="FarmerName" e-headertext="Farmer Name" e-width="30"></div>
                                    <div e-column e-type="string" e-field="FarmerFatherName" e-headertext="Farmer Father Name" e-width="30"></div>
                                    <div e-column e-type="string" e-field="TotalArea" e-headertext="Total Area" e-width="30"></div>
                                    <div e-column e-type="number" e-field="TotalPlots" e-headertext="Total Plots" e-width="30"></div>



                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn" data-dismiss="modal" ng-click="pageSet();">Close</button>
                    </div>
                </div>

            </div>
        </div>


        <!--The Planned Area Modal-->
        <div class="modal fade site-modal in" id="ShowPlannedArea" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <button class="close" data-dismiss="modal">&times;</button>
                        <h1 class="modal-title" style="font-size:50px; text-align:center; margin:-10px;">Planned Area</h1>
                    </div>
                    <div class="modal-body" style="min-height:300px;">
                        <div class="row" style="margin: 20px; font-style:italic"> Planned Area under {{currentGroup.Group}} </div>
                        <button type="button" ng-click="PlannedAreaReport(currentGroup)" class="btn single-btn"><i class="glyphicon glyphicon-arrow-down"></i> Download </button>
                        <div>

                            <div style="color:black;" ej-grid e-datasource="PlannedAreaModal"
                                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enableColumnResizing="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel">

                                <div e-columns>
