                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="y in positionData">
                                        <td ng-repeat="x in positionSearch">{{y[x.Value]}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="clearfix" style="padding-bottom:10px;"></div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
