                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Roster Applicable</label>
                                <div class="col-sm-3">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="manPowerbudgetmasterNew.IsRosterApplicable" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                                <label class="col-sm-3 control-label">Scatted week off Applicable</label>
                                <div class="col-sm-2">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="manPowerbudgetmasterNew.IsScattedWeekOffApplicable" tabindex="10">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">IsResidencePlan</label>
                                <div class="col-sm-3">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="manPowerbudgetmasterNew.IsResidencePlan" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                                <label class="col-sm-3 control-label">IsTransportPlan</label>
                                <div class="col-sm-2">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="manPowerbudgetmasterNew.IsTransportPlan" tabindex="10">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
