                            getPosition(manPowerbudgetmasterNew.CompanyId);" ng-options="item.Value as item.Text for item in companyList" tabindex="1">
                        <option value=""></option>
                    </select>
                </div>
                <p ng-show="selectMessage" style="color:red" class="show-message">{{selectMessage}}</p>
            </div>
        </div>
    </div>
    <div class="clearfix">
    </div>
    <div class="form-elements">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Manpower Budget</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Job Description</a></li>
                    <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="address" role="tab" data-toggle="tab">Detail</a></li>
                    <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="address" role="tab" data-toggle="tab">Allowance</a></li>
                    <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="AdditionalPlan" role="tab" data-toggle="tab">AdditionalPlan</a></li>
                    <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(6)" href="" aria-controls="KPIResponsiblePerson" role="tab" data-toggle="tab">KPI Responsible Person</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
