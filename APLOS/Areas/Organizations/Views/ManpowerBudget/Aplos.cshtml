                                        <input type="text" name="Vendor" ng-model="manPowerbudgetmasterNew.ResponsiblePerson" class="form-control" style="display: none;">
                                        <span class="input-group-btn">
                                            <button name="submit" ng-click="ShowEmployeeListPopUp();" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="manPowerbudgetmasterNew.Remarks" maxlength="250" tabindex="14"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="manPowerbudgetmasterNew.ShiftDefinationId" ng-options="item.Value as item.Text for item in shiftList" name="Shift" tabindex="6" required></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Employee Location</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="manPowerbudgetmasterNew.EmployeeLocationId" ng-options="item.Value as item.Text for item in employeeLocationList" name="Employee Location" tabindex="7"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Active</label>
                                <div class="col-sm-3">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="manPowerbudgetmasterNew.Active" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                                <label class="col-sm-3 control-label">OT Entitled</label>
                                <div class="col-sm-2">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="manPowerbudgetmasterNew.IsOTEntitled" tabindex="10">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Deployment</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Deployment" ng-model="manPowerbudgetmasterNew.Deployment" only-numbers class="form-control" maxlength="50" tabindex="12">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Email</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Deployment" ng-model="manPowerbudgetmasterNew.Email" class="form-control" maxlength="50" tabindex="12">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Accounts Group</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="AccountsGroup" ng-model="manPowerbudgetmasterNew.AccountsGroupId" class="col-sm-3 form-control" required title="Account Group use for Salary Payable GL Groupping"
                                                ng-options="item.Value as item.Text for item in accountsGroupList">
                                            <option></option>
                                        </select>
                                    </div>
