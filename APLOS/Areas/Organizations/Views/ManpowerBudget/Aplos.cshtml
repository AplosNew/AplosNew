<togglable name="Manpower Budget"></togglable>
<div id="manPowerbudgetmasterNew" name="manPowerbudgetmasterNewForm" class="form-horizontal">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group form-element-ctrl">
            <label class="col-sm-2 col-md-2 control-label">Company<sup>*</sup></label>
            <div class="col-sm-4 col-md-4">
                <div class="select-style">
                    <select class="form-control" ng-model="manPowerbudgetmasterNew.CompanyId" required name="Company"
