                        <label class="col-sm-4 control-label">Cost Center</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select name="CostCenter" ng-model="manPowerbudgetmasterNew.CostCenterId" class="col-sm-3 form-control"
                                        ng-options="item.Value as item.Text for item in CostCenterList">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>*@


                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row" ng-form name="formTab2">
                        <div class="col-xs-12">
                            <ul class="common-btn list-inline text-right">
                                <li><button ng-click="addJobDescription();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add</button></li>
                            </ul>
                        </div>
                        <div class="col-xs-12">
                            <div class="table-responsive modal-table" ng-show="tableShow">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Category</th>
                                            <th>Subcategory</th>
                                            <th>Item</th>
                                            <th>Level</th>
                                            <th>Primary/Secondary</th>
                                            <th>Frequency</th>
                                            <th>Nature of Activity</th>
                                            <th>Document Applicable</th>
                                            <th>Total Attachment</th>
                                            <th>Remove</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in jobDescriptionSelectedList | filter:{Archive:false}" ng-class="{unsaveRow : x.Id==null}">
                                            <td>{{x.JobDescriptionCategoryName}}</td>
                                            <td>{{x.JobDescriptionSubCategoryName}}</td>
                                            <td>{{x.JobDescriptionItemName}}</td>
                                            <td>{{x.JobLevel}}</td>
                                            <td>{{x.PrimaryOrSecondary}}</td>
                                            <td>{{x.Frequency}}</td>
                                            <td>{{x.NatureOfActivity}}</td>
                                            <td>{{x.DocumentApplicable?'Yes':'No'}}</td>
                                            <td>{{x.TotalAttachment !=null?x.TotalAttachment:'N/A'}}</td>
                                            <td class="text-right table-td">
                                                <ul class="list-inline action-list">
                                                    <li>
                                                        <button ng-click="valuePassInDelModal($index, x.JobDescriptionId, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                            <i class="glyphicon glyphicon-remove"></i>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                    <div class="row" ng-form name="formTab3">
                        <input type="hidden" ng-model="manpowerBudgetDetail.Id">
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control datepicker" datepicker ng-model="manpowerBudgetDetail.EffectiveDate" name="EffectiveDate" tabindex="1">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Female<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" name="Female" ng-model="manpowerBudgetDetail.Female" class="form-control text-right"
                                           ng-keyup="countTotalNumber(manpowerBudgetDetail.Male, manpowerBudgetDetail.Female);" tabindex="3" only-numbers>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Residence Vacancy<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" name="Residence Vacancy" ng-model="manpowerBudgetDetail.ResidenceVacancy" class="form-control text-right" tabindex="3" only-numbers>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Deployment</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Deployment" ng-model="manpowerBudgetDetail.Deployment" only-numbers class="form-control" maxlength="50" tabindex="12">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Male<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" name="Male" ng-model="manpowerBudgetDetail.Male" class="form-control text-right"
                                           ng-keyup="countTotalNumber(manpowerBudgetDetail.Male, manpowerBudgetDetail.Female);" tabindex="2" only-numbers>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Total Number<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input readonly type="text" ng-model="manpowerBudgetDetail.TotalNumber" class="form-control text-right" only-numbers tabindex="4">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Transport Vacancy<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" name="Transport Vacancy" ng-model="manpowerBudgetDetail.TransportVacancy" class="form-control text-right" tabindex="3" only-numbers>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li><button ng-click="addManpowerBudgetDetail();" class="btn"><i class="glyphicon glyphicon-plus"></i> {{ActionManpowerBudgetDetail}}</button></li>
                                    <li><button ng-click="clearManpowerBudgetDetail();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                </ul>
                            </div>
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Effective Date</th>
                                            <th>Male</th>
                                            <th>Female</th>
                                            <th>TotalNumber</th>
                                            <th>Deployment</th>
                                            <th>Residence Vacancy</th>
                                            <th>Transport Vacancy</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr dir-paginate="x in manpowerBudgetDetailList |itemsPerPage:allowanceParameters.pageSize" pagination-id="metaData.name + 'manpowerBudgetDetailList'" total-items="allowanceParameters.total_count">
                                            <td>{{x.EffectiveDate | dateFiltering}}</td>
                                            <td class="text-right">{{x.Male}}</td>
                                            <td class="text-right">{{x.Female}}</td>
                                            <td class="text-right">{{x.TotalNumber}}</td>
                                            <td class="text-right">{{x.Deployment}}</td>
                                            <td class="text-right">{{x.ResidenceVacancy}}</td>
                                            <td class="text-right">{{x.TransportVacancy}}</td>
                                            <td class="text-right">
                                                <ul class="list-inline action-list">
                                                    <li><button ng-click="getManpowerBudgetDetailUpdate(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i></button></li>
                                                    <li><button ng-click="valuePassInManpowerDetailDelModal(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                                </ul>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'manpowerBudgetDetailList'"
                                                         direction-links="true" boundary-links="true"
                                                         on-page-change="getManpowerBudgetDetailData(newPageNumber)">
                                </dir-pagination-controls>
                            </div>
                        </div>
