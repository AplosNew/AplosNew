<togglable name="Manpower Budget Allowance"></togglable>
<div ng-form name="plantForm" id="plantForm" class="form-horizontal">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="allowanceNew.CompanyId" name="Company" ng-options="item.Value as item.Text for item in companyList" ng-change="getCompanyCurrencyId()" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Manpower Budget<sup>*</sup></label>
            <div class="col-sm-4 pdr3">
                <input type="hidden" ng-model="allowanceNew.ManpowerBudgetId" class="form-control">
                <input type="text" name="Position" ng-model="allowanceNew.ManpowerBudgetCode" class="form-control" disabled required>
            </div>
            <div class="pdl3">
                <button name="submit" class="btn single-small-btn" ng-click="manpowerBudgetPopUp()" tabindex="3">
                    <i class="cr-icon glyphicon glyphicon-search"></i>
                </button>
                <button name="submit" class="btn single-small-btn" ng-click="positionAllowancePopUp()" tabindex="3">
                    <i class="cr-icon glyphicon glyphicon-search"></i> Position ALW
                </button>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div ng-form id="companyStructureRelation" name="form1" class="form-elements">
        <input type="hidden" ng-model="allowanceNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" class="form-control" datepicker ng-model="allowanceNew.EffectiveDate" placeholder="Every month 1st day" name="EffectiveDate" id="EffectiveDate" tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Minimum Salary<sup>*</sup></label>
                @*<div class="col-sm-8 show-message">
            <input only-numbers ng-keyup="compare(allowanceNew.MaximumSalary, allowanceNew.MinimumSalary,'Min')" type="text" name="Minimum Salary" maxlength="20" ng-model="allowanceNew.MinimumSalary" class="form-control text-right" n-decimals="4" required tabindex="3">
            <p class="msg-error" ng-show="compareMin">{{_validationMin}}</p>
        </div>*@
                <div class="col-sm-8 show-message">
                    <input type="text" name="Minimum Salary" maxlength="20" ng-model="allowanceNew.MinimumSalary" class="form-control text-right" n-decimals="4" required tabindex="4">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Skill Allowance<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Skill Allowance" maxlength="20" ng-model="allowanceNew.SkillAllowance" class="form-control text-right" n-decimals="4" required tabindex="5">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group">
                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select disabled ng-change="currencyExchangeRate(allowanceNew.CurrencyId)" class="form-control" id="currencyId" ng-model="allowanceNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList" name="Currency" tabindex="1"></select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Maximum Salary<sup>*</sup></label>
                @*<div class="col-sm-8 show-message">
            <input only-numbers ng-keyup="compare(allowanceNew.MaximumSalary, allowanceNew.MinimumSalary,'Max')" type="text" name="Maximum Salary" maxlength="20" ng-model="allowanceNew.MaximumSalary" class="form-control text-right" n-decimals="4" required tabindex="4">
            <p class="msg-error" ng-show="compareMax">{{_validationMax}}</p>
        </div>*@
                <div class="col-sm-8 show-message">
                    <input type="text" name="Maximum Salary" maxlength="20" ng-model="allowanceNew.MaximumSalary" class="form-control text-right" n-decimals="4" required tabindex="4">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsibility Allowance<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Responsibility Allowance" maxlength="20" ng-model="allowanceNew.ResponsibilityAllowance" class="form-control text-right" n-decimals="4" required tabindex="6">
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="allowanceParameters.searchBy">
                            <option ng-repeat="option in searchByAllowanceList | orderBy:'name'" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="allowanceParameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Effective Date</th>
                <th>Currency</th>
                <th>Minimum Salary</th>
                <th>Maximum Salary</th>
                <th>Skill Allowance</th>
                <th>Responsibility Allowance</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in allowanceList | itemsPerPage:allowanceParameters.pageSize" total-items="allowanceParameters.total_count" ng-dblclick="Get(x);" pagination-id="metaData.name + 'allowanceList'">
                <td>{{x.EffectiveDate | dateFiltering}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.MinimumSalary | number : 2 }}</td>
                <td class="text-right">{{x.MaximumSalary | number : 2 }}</td>
                <td class="text-right">{{x.SkillAllowance | number : 2 }}</td>
                <td class="text-right">{{x.ResponsibilityAllowance | number : 2 }}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             pagination-id="metaData.name + 'allowanceList'"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Organizations/Views/ManpowerBudget/_ManpowerBudgetPopUp.cshtml")
@Html.Partial("~/Areas/Organizations/Views/Position/_PositionAllowancePopUp.cshtml")
<confirm-archive-generic data-modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeAllowanceRow()"></confirm-archive-generic>
<div class="modal fade site-modal in" id="currencyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Currency Exchange Rate
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row form-horizontal">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Unit</th>
                                    <th>From </th>
                                    <th>To </th>
                                    <th>Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1</td>
                                    <td>{{FromCurrencyCode}}</td>
                                    <td>{{ToCurrencyCode}}</td>
                                    <td>
                                        <input type="number" class="form-control" ng-model="currencyRate" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button type="button" class="btn btn-default" ng-click="closeCurrencyExchangeRate();">OK</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>