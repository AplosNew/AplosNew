<div class="modal fade site-modal in" id="manpowerBudgetPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Mampower Budget
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="manpowerBudgetParameters.searchBy">
                                            <option ng-repeat="option in manpowerBudgetSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="manpowerBudgetParameters.search"  ng-enter="getManpowerBudgetData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getManpowerBudgetData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" ng-show="manpowerBudgetDataList.length">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th ng-repeat="x in manpowerBudgetSearchList">{{x.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in manpowerBudgetDataList|itemsPerPage:manpowerBudgetParameters.pageSize" total-items="manpowerBudgetParameters.total_count" pagination-id="metaData.name + 'manpowerBudgetDataList'">
                                <td><input type="radio" name="selectedManpowerBudget" id="selectedManpowerBudget" ng-checked="{{x.Id == selectedManpowerBudgetId}}" value="{{$index}}" /></td>
                                <td ng-repeat="y in manpowerBudgetSearchList">{{x[y.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'manpowerBudgetDataList'"
                                             direction-links="true" boundary-links="true"
                                             on-page-change="getManpowerBudgetData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button type="button" class="btn btn-default" ng-click="closeManpowerBudgetPopUp()">Close</button></li>
                        <li><button ng-click="selectManpowerBudgetPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>