<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Entity Line</h3>
<div class="form-elements row">
    <div class="form-group">
        <label class="col-sm-3 col-md-2 control-label">Production Entity</label>
        <div class="col-sm-3 col-md-4">
            <div class="select-style">
                <select class="form-control" ng-model="companyLine.EntityId"
                        ng-options="item.Value as item.Text for item in companyList"
                        ng-change="getLineMasterOnCompanyChange(companyLine.EntityId); getEntityMapData(companyLine.EntityId)"></select>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table">
        <table class="table table-striped" ng-show="entityData.length">
            <thead>
                <tr>
                    <th>Id</th>
                    <th ng-repeat="x in entitySearch">{{x.Text}}</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="y in entityData">
                    <td>{{y.Id}}</td>
                    <td ng-repeat="x in entitySearch">{{y[x.Value]}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="clearfix" style="padding-bottom:10px;"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-left">
            <li>
                <button ng-click="ShowLineList();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add Line</button>
            </li>
        </ul>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-right">
            <li>
                <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button>
            </li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="tableShow">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>User Name</th>
                <th>Remove</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in companyLineList" ng-class="{unsaveRow : x.Id==null}">
                <td>{{x.Code}}</td>
                <td>{{x.UserName}}</td>
                <td class="text-right table-td">
                    <ul class="list-inline action-list">
                        <li>
                            <button ng-click="valuePassInDelModal($index, x)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="modal fade site-modal in" id="linePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Line</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right  aplos-grid-toggle">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="$root.parameters.searchBy">
                                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table aplos-grid-toggle">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Code</th>
                                <th>User Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in lineListWithCompanyWise | itemsPerPage:$root.pageSize" total-items="$root.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="{{x.LineId}}" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectChValueId($event,x)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.UserName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="LineSelectdCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteLineList()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>