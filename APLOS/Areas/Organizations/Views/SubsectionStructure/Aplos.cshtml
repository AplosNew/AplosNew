                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade site-modal in" id="operationmodal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    Operation
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body text-center">

                    <div class="row text-right">
                        <div class="col-xs-12 col-sm-12 col-sm-12">
                            <div class="search-form">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-3 col-md-3">
                                        <div class="select-style">
                                            <select ng-model="$root.parameters.searchBy">
                                                <option ng-repeat="option in searchbyOperationDatalist" value="{{option.value}}">{{option.name}}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-7 col-md-7">
                                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getOperationData()">
                                    </div>
                                    <div class="col-xs-12 col-sm-2 col-md-2">
                                        <button type="button" ng-click="getOperationData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Code</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="x in operationData  |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getOperationCode(x.Id, x.UserName);">
                                    <td>{{x.Id}}</td>
                                    <td>{{x.Code}}</td>
                                    <td>{{x.UserName}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade site-modal in" id="machinetypemodal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    Machine Type
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body text-center">

                    <div class="row text-right">
                        <div class="col-xs-12 col-sm-12 col-sm-12">
                            <div class="search-form">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-3 col-md-3">
                                        <div class="select-style">
                                            <select ng-model="$root.parameters.searchBy">
                                                <option ng-repeat="option in searchbyMachineTypelist" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-7 col-md-7">
                                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="loadMTData()">
                                    </div>
                                    <div class="col-xs-12 col-sm-2 col-md-2">
                                        <button type="button" ng-click="loadMTData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    @*mc.UserName as MachineClassName, msc.UserName as MachineSubClassName, mct.UserName as MachineCategoryName, "+
                                        " msct.UserName as MachineSubCategoryName, m.UserName as MachineName, p.UserName as ProcessName*@
                                    <th>Id</th>
                                    <th>Code</th>
                                    <th>Description</th>
                                    <th>MachineClassName</th>
                                    <th>MachineSubClassName</th>
                                    <th>MachineCategoryName</th>
                                    <th>MachineSubCategoryName</th>
                                    <th>MachineName</th>
                                    <th>ProcessName</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="x in machineTypeData  |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getMachineTypeCode(x.Id);">
                                    <td>{{x.Id}}</td>
                                    <td>{{x.Code}}</td>
                                    <td>{{x.UserName}}</td>
                                    <td>{{x.MachineClassName}}</td>
                                    <td>{{x.MachineSubClassName}}</td>
                                    <td>{{x.MachineCategoryName}}</td>
                                    <td>{{x.MachineSubCategoryName}}</td>
                                    <td>{{x.MachineName}}</td>
                                    <td>{{x.ProcessName}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>
<confirm-archive title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRowYes()"></confirm-archive>
<confirm-archive-generic data-modalid="confirmmasterdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeMasterYes()"></confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmdetaildelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeDetailYes()"></confirm-archive-generic>
