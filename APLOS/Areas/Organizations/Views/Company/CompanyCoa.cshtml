<togglable name="Company COA"></togglable>
<div ng-form id="companyCoa" name="companyCoaForm" class="form-elements">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-model="company.Id" name="Company" class="form-control" ng-init="company.Id=Id" ng-options="item.Value as item.Text for item in companyList" required tabindex="1"></select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Alternate COA</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Alternate COA" ng-model="company.AlternativeCOAId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in AlternateCOAList"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Profit Center Applicable</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="company.IsProfitCenterApplicable" tabindex="24">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Voucher From Budget</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="company.IsVoucherFromBudget" tabindex="22">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">COA<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="COA" ng-model="company.COAId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in COAList" required></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label"> Buying Selling Applicable</label>
            <div class="checkbox-site">
                <label class="col-sm-8">
                    <input type="checkbox" id="IsBuyingSellingApplicable" ng-model="company.IsBuyingSellingApplicable" tabindex="5">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Cost Center Applicable</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="company.IsCostCenterApplicable" tabindex="21">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Budget Period Applicable</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="company.IsBudgetPeriod" tabindex="23">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Update();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table  aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Company Code</th>
                <th>Company Name</th>
                <th>COA</th>
                <th>Alternative COA</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in companies |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-click="Get(x, $index)">
                <td>{{x.Code}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.COA}}</td>
                <td>{{x.AlternativeCOA}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>