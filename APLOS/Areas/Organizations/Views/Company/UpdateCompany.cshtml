<togglable name="Company"></togglable>
<div class="form-horizontal form-element-ctrl" ng-form name="companyForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company Group<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="company.CompanyGroupId" name="Company Group" ng-change="getData(company.CompanyGroupId);onComGroupChange(company.CompanyGroupId)"
                            id="companyGroupId" ng-options="item.Value as item.Text for item in companyGroupList" required></select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
