                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="company.Remarks" name="Remarks" maxlength="250" tabindex="20"></textarea>
                                </div>
                            </div>
