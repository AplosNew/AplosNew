                                        </label>
                                    </div>
                                </div>
                                <label class="col-sm-4 control-label">FixedAsset Sales Book as SALES</label>
                                <div class="col-sm-2">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="company.IsFixedAssetSalesBook" tabindex="22">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
