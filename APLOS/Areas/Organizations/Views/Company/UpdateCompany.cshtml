                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="company.Description" tabindex="23" name="Description" maxlength="250"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Is Account Module Running</label>
                                <div class="col-sm-2">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="company.IsAccountModuleRunning" tabindex="22">
