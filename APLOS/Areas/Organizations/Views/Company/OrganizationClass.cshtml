<togglable name="Organization Class"></togglable>
<div ng-form id="organizationClass" name="organizationClassForm" class="form-elements">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="number" ng-model="organizationClass.Sequence" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="15" type="text" name="Short Name" ng-model="organizationClass.ShortName" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="User Name" ng-model="organizationClass.UserName" class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea maxlength="250" class="form-control" rows="3" ng-model="organizationClass.Description" tabindex="7" ng-trim="false"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="15" type="text" name="Code" ng-model="organizationClass.Code" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="Standard Name" ng-model="organizationClass.StandardName" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea maxlength="250" class="form-control" rows="3" ng-model="organizationClass.Remarks" tabindex="6" ng-trim="false"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="organizationClass.Active" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in  filtered = (organizationClasses | orderBy:'Sequence') |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>