<div class="modal fade site-modal in" id="positionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Position Informations
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="positionParameters.searchBy">
                                            <option ng-repeat="option in positionSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="positionParameters.search" ng-enter="getPositionData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPositionData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" ng-show="positionDataList.length">
                        <thead>
                            <tr>
                                <th ng-repeat="x in positionSearchList">{{x.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in positionDataList|itemsPerPage:positionParameters.pageSize" total-items="positionParameters.total_count" pagination-id="metaData.name + 'positionDataList'" ng-dblclick="selectPositionPopUp(x)">
                                <td ng-repeat="y in positionSearchList">{{x[y.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'positionDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getPositionData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button type="button" class="btn btn-default" ng-click="closePositionPopUp();">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>