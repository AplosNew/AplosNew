<togglable name="Position Allowance"></togglable>
<div class="form-group form-element-ctrl">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <label class="col-sm-4 control-label">Position<sup>*</sup></label>
        <div class="col-sm-5 pdr3">
            <input type="hidden" ng-model="positionAllowance.PositionId" class="form-control" disabled required>
            <input type="text" name="Position" ng-model="positionAllowance.PositionName" class="form-control" disabled required>
        </div>
        <div class="pdl3">
            <button name="submit" class="btn single-small-btn" ng-click="positionPopUp()" tabindex="3">
                <i class="cr-icon glyphicon glyphicon-search"></i>
            </button>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<br />
<div ng-form id="companyStructureRelation" name="form1" class="form-elements">
    <input type="hidden" ng-model="positionAllowance.Id">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" class="form-control" datepicker ng-model="positionAllowance.EffectiveDate" placeholder="Every month 1st day" name="EffectiveDate" tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Minimum Salary<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Minimum Salary" maxlength="20" ng-model="positionAllowance.MinimumSalary" class="form-control text-right" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Skill Allowance<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Skill Allowance" maxlength="20" ng-model="positionAllowance.SkillAllowance" class="form-control text-right" required tabindex="5">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select disabled class="form-control" id="currencyId" ng-model="positionAllowance.CurrencyId" ng-options="item.Value as item.Text for item in currencyList" name="Currency" tabindex="1"></select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Maximum Salary<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Maximum Salary" maxlength="20" ng-model="positionAllowance.MaximumSalary" class="form-control text-right" required tabindex="4">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Responsibility Allowance<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Responsibility Allowance" maxlength="20" ng-model="positionAllowance.ResponsibilityAllowance" class="form-control text-right" required tabindex="6">
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="allowanceParameters.searchBy">
                            <option ng-repeat="option in searchByAllowanceList | orderBy:'name'" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="allowanceParameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Effective Date</th>
                <th>Currency</th>
                <th>Minimum Salary</th>
                <th>Maximum Salary</th>
                <th>Skill Allowance</th>
                <th>Responsibility Allowance</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in positionAllowanceList | itemsPerPage:allowanceParameters.pageSize" total-items="allowanceParameters.total_count" ng-dblclick="Get(x);">
                <td>{{x.EffectiveDate | dateFiltering}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.MinimumSalary | number : 2 }}</td>
                <td class="text-right">{{x.MaximumSalary | number : 2 }}</td>
                <td class="text-right">{{x.SkillAllowance | number : 2 }}</td>
                <td class="text-right">{{x.ResponsibilityAllowance | number : 2 }}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true"
                             on-page-change="getAllowanceData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Organizations/Views/Position/_PositionPopUp.cshtml")