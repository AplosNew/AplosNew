                         message={{message_confirmation}} data-ng-click-right-button="deletePRJobDescriptionList()">
</confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmgenericAllowancePopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="removeAllowanceRow()">
</confirm-archive-generic>
