<togglable name="Position Setup"></togglable>
<div ng-form id="companySSForm" name="companySSForm" class="form-elements">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Position Setup</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Job Description</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="address" role="tab" data-toggle="tab">Allowance</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="address" role="tab" data-toggle="tab">Grouping Data</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="companySSFormTab1">
                    <input type="hidden" ng-model="companyStructureSetup.Id">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal" compile="left">
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal" compile="right">
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="companySSFormTab2">
                    <div class="col-xs-12">
                        <ul class="common-btn list-inline text-right">
                            <li>
                                <button ng-click="addJobDescription();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add</button>
                            </li>
                        </ul>
                    </div>
                    <div class="col-xs-12">
                        <div class="table-responsive modal-table" ng-show="tableShow">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th>Subcategory</th>
                                        <th>Item</th>
                                        <th>Level</th>
                                        <th>Primary/Secondary</th>
                                        <th>Frequency</th>
                                        <th>Nature Of Activity</th>
                                        <th>Document Applicable</th>
                                        <th>Total Attachment</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in jobDescriptionSelectedList | filter:{Archive:false}" ng-class="{unsaveRow : x.Id==null}">
                                        <td>{{x.JobDescriptionCategoryName}}</td>
                                        <td>{{x.JobDescriptionSubCategoryName}}</td>
                                        <td>{{x.JobDescriptionItemName}}</td>
                                        <td>{{x.JobLevel}}</td>
                                        <td>{{x.PrimaryOrSecondary}}</td>
                                        <td>{{x.Frequency}}</td>
                                        <td>{{x.NatureOfActivity}}</td>
                                        <td>{{x.DocumentApplicable?'Yes':'No'}}</td>
                                        <td>{{x.TotalAttachment !=null?x.TotalAttachment:'N/A'}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li><button ng-click="valuePassInDelModal($index, x.JobDescriptionId, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row" ng-form name="companySSFormTab3">
                    <div class="col-sm-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Effective Date</th>
                                        <th>Currency</th>
                                        <th>Minimum Salary</th>
                                        <th>Maximum Salary</th>
                                        <th>Skill Allowance</th>
                                        <th>Responsibility Allowance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="x in positionAllowanceList |itemsPerPage:allowanceParameters.pageSize" pagination-id="metaData.name + 'positionAllowanceList'" total-items="allowanceParameters.total_count">
                                        <td>{{x.EffectiveDate | dateFiltering}}</td>
                                        <td>{{x.CurrencyCode}}</td>
                                        <td class="text-right">{{x.MinimumSalary | number : 2 }}</td>
                                        <td class="text-right">{{x.MaximumSalary | number : 2 }}</td>
                                        <td class="text-right">{{x.SkillAllowance | number : 2 }}</td>
                                        <td class="text-right">{{x.ResponsibilityAllowance | number : 2 }}</td>
                                    </tr>
                                </tbody>
                            </table>
                            <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'positionAllowanceList'"
                                                     direction-links="true" boundary-links="true"
                                                     on-page-change="getAllowanceData(newPageNumber)">
                            </dir-pagination-controls>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row" ng-form name="companySSFormTab14">
                    <input type="hidden" ng-model="companyStructureSetup.Id">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{PositionGroupingData.UserDefineGroup1}}</label>
                            <div class="col-sm-8">
                                <input type="text" name="User Define Group1" maxlength="50" ng-model="companyStructureSetup.UserDefineGroup1" class="form-control" tabindex="20">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{PositionGroupingData.UserDefineGroup3}}</label>
                            <div class="col-sm-8">
                                <input type="text" name="User Define Group3" maxlength="50" ng-model="companyStructureSetup.UserDefineGroup3" class="form-control" tabindex="22">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{PositionGroupingData.UserDefineGroup5}}</label>
                            <div class="col-sm-8">
                                <input type="text" name="User Define Group5" maxlength="50" ng-model="companyStructureSetup.UserDefineGroup5" class="form-control" tabindex="22">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{PositionGroupingData.UserDefineGroup2}}</label>
                            <div class="col-sm-8">
                                <input type="text" name="User Define Group2" maxlength="50" ng-model="companyStructureSetup.UserDefineGroup2" class="form-control" tabindex="21">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{PositionGroupingData.UserDefineGroup4}}</label>
                            <div class="col-sm-8">
                                <input type="text" name="User Define Group4" maxlength="50" ng-model="companyStructureSetup.UserDefineGroup4" class="form-control" tabindex="24">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">{{PositionGroupingData.UserDefineGroup6}}</label>
                            <div class="col-sm-8">
                                <input type="text" name="User Define Group6" maxlength="50" ng-model="companyStructureSetup.UserDefineGroup6" class="form-control" tabindex="22">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            <li><button ng-click="positionReport()" class="btn"><i class="glyphicon glyphicon-print"></i> Report</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="dataListParameters.searchBy">
                            <option ng-repeat="option in fieldDataList | orderBy:'Text'" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="dataListParameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th ng-repeat="x in fieldDataList" ng-show="{{x.Value!='Archive'}}">{{x.Text}}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in dataList |itemsPerPage:dataListParameters.pageSize" total-items="dataListParameters.total_count" ng-dblclick="Get(x.Id, $index);"
                pagination-id="metaData.name + 'dataList'">
                <td ng-repeat="hh in fieldDataList" ng-show="{{hh.Value!='Archive'}}">{{x[hh.Value]}}</td>
                <td>
                    <div class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" href=""><i class="glyphicon glyphicon-menu-down"></i></a>
                        <ul class="dropdown-menu dropdown-menu-right" role="menu" aria-labelledby="dLabel">
                            <li><a href="{{bootPoint}}position-budget-master/{{x.Id}}/{{x.UserName}}">Budget Master</a></li>
                        </ul>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'dataList'"
                             direction-links="true" boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<div class="modal fade site-modal in" id="jobDescriptionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="jobDescriptionForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Job Description</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in searchByJobDescriptionList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Category</th>
                                <th>Subcategory</th>
                                <th>Item</th>
                                <th>Level</th>
                                <th>Primary/Secondary</th>
                                <th>Frequency</th>
                                <th>Document Applicable</th>
                                <th>Total Attachment</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in jobDescriptionList |itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="{{x.Id}}" ng-model="x.Flag" ng-checked="x.Flag">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.JobDescriptionCategoryName}}</td>
                                <td>{{x.JobDescriptionSubCategoryName}}</td>
                                <td>{{x.JobDescriptionItemName}}</td>
                                <td>{{x.JobLevel}}</td>
                                <td>{{x.PrimaryOrSecondary}}</td>
                                <td>{{x.Frequency}}</td>
                                <td>{{x.DocumentApplicable?'Yes':'No'}}</td>
                                <td>{{x.TotalAttachment !=null?x.TotalAttachment:'N/A'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true"
                                             on-page-change="getData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="jobDescriptionSelectdCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="processPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Process<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="">
                    <div class="row text-right">
                        <div class="col-xs-12 col-sm-12 col-sm-12">
                            <div class="search-form">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-3 col-md-3">
                                        <div class="select-style">
                                            <select ng-model="processPopUpParameters.searchBy">
                                                <option ng-repeat="option in processSearchList | orderBy:'name'" value="{{option.value}}">{{option.name}}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-7 col-md-7">
                                        <input type="text" class="form-control" placeholder="Search" ng-model="processPopUpParameters.search" ng-enter="getProcessData()">
                                    </div>
                                    <div class="col-xs-12 col-sm-2 col-md-2">
                                        <button type="button" ng-click="getProcessData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    @*<th>Select</th>*@
                                    <th>Sequence</th>
                                    <th>Code</th>
                                    <th>Short Name</th>
                                    <th>Standard Name</th>
                                    <th>User Name</th>
                                    <th>Production Process</th>
                                    <th>Process Routing</th>
                                    <th>Locked</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="x in processPopUpDataList|itemsPerPage:processPopUpParameters.pageSize" ng-dblclick="processAdd(x);"
                                    total-items="processPopUpParameters.total_count" pagination-id="metaData.name + 'processPopUpList'">
                                    @*<td>
                                            <div class="checkbox-site">
                                                <label class="control-label">
                                                    <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </td>*@
                                    <td>{{x.Sequence}}</td>
                                    <td>{{x.Code}}</td>
                                    <td>{{x.ShortName}}</td>
                                    <td>{{x.StandardName}}</td>
                                    <td>{{x.UserName}}</td>
                                    <td>{{x.IsProductionProcess?'Yes':'No'}}</td>
                                    <td>{{x.IsProcessRouting?'Yes':'No'}}</td>
                                    <td>{{x.IsLocked?'Yes':'No'}}</td>
                                    <td>{{x.Active?'Yes':'No'}}</td>
                                </tr>
                            </tbody>
                        </table>
                        <dir-pagination-controls max-size="10"
                                                 pagination-id="metaData.name + 'processPopUpList'"
                                                 direction-links="true"
                                                 boundary-links="true"
                                                 on-page-change="getProcessData(newPageNumber)">
                        </dir-pagination-controls>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button type="button" class="btn btn-default" ng-click="closeProcessPopUp();">Cancel</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="GWPCPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Good Work Position Code<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="">
                    <div class="row text-right">
                        <div class="col-xs-12 col-sm-12 col-sm-12">
                            <div class="search-form">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-3 col-md-3">
                                        <div class="select-style">
                                            <select ng-model="GWPCPopUpParameters.searchBy">
                                                <option ng-repeat="option in GWPCSearchList | orderBy:'name'" value="{{option.value}}">{{option.name}}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-7 col-md-7">
                                        <input type="text" class="form-control" placeholder="Search" ng-model="GWPCPopUpParameters.search" ng-enter="getGWPCData()">
                                    </div>
                                    <div class="col-xs-12 col-sm-2 col-md-2">
                                        <button type="button" ng-click="getGWPCData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr> 
                                    <th>Code</th>
                                    <th>User Name</th>
                                    <th>Division</th>
                                    <th>Sub Division</th>
                                    <th>Department</th>
                                    <th>Section</th>
                                    <th>Sub Section</th>
                                    <th>Designation</th>
                                    <th>Direct Manpower Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="x in GWPCPopUpDataList|itemsPerPage:GWPCPopUpParameters.pageSize" ng-dblclick="GWPCAdd(x);"
                                    total-items="GWPCPopUpParameters.total_count" pagination-id="metaData.name + 'GWPCPopUpList'">
                                    <td>{{x.Code}}</td>
                                    <td>{{x.UserName}}</td>
                                    <td>{{x.Division}}</td>
                                    <td>{{x.SubDivision}}</td>
                                    <td>{{x.Department}}</td>
                                    <td>{{x.Section}}</td>
                                    <td>{{x.SubSection}}</td>
                                    <td>{{x.Designation}}</td>
                                    <td>{{x.IsDirectManpowerCost?'True':'False'}}</td> 
                                </tr>
                            </tbody>
                        </table>
                        <dir-pagination-controls max-size="10"
                                                 pagination-id="metaData.name + 'GWPCPopUpList'"
                                                 direction-links="true"
                                                 boundary-links="true"
                                                 on-page-change="getGWPCData(newPageNumber)">
                        </dir-pagination-controls>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button type="button" class="btn btn-default" ng-click="closeGWPCPopUp();">Cancel</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

