<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Entity Cost Center</h3>
<div class="form-elements row">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="entityCostCenterNew.CompanyId" ng-change="getEntityList()"
                            ng-options="item.Value as item.Text for item in companyList" id="CostCenterCategoryId" name="Cost Center Category" tabindex="5">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="entityCostCenterNew.EntityId" ng-change="getCostCenterList()"
                            ng-options="item.Value as item.Text for item in entityList" id="CostCenterCategoryId" name="Cost Center Category" required tabindex="5">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12">
        <div class="clearfix"><br /></div>
        <div class="table-responsive modal-table" ng-show="costCenterList.length>0">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Select</th>
                        <th>Code</th>
                        <th>User Name</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in costCenterList">
                        <td>
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" id="{{x.Id}}" ng-model="x.Flag" ng-checked="x.Flag">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </td>
                        <td>{{x.Code}}</td>
                        <td>{{x.UserName}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="col-xs-12">
            <ul class="common-btn list-inline text-right">
                <li>
                    <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button>
                </li>
            </ul>
        </div>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteCostCenterList()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>