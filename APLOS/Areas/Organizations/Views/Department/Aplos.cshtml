<togglable name="Department"></togglable>
<div ng-form id="departmentNew" name="departmentNewForm" class="form-elements  form-horizontal">
    <input type="hidden" ng-model="departmentNew.Id">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="bank" role="tab" data-toggle="tab">Basic</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="localLanguage" role="tab" data-toggle="tab">Local Language</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Sequence" ng-model="departmentNew.Sequence" class="form-control" required tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Short Name" maxlength="50" ng-model="departmentNew.ShortName" class="form-control" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" maxlength="50" ng-model="departmentNew.UserName" class="form-control" required tabindex="5">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox">
                                    <input type="checkbox" class="css-checkbox" id="active" ng-model="departmentNew.Active">
                                    <label class="css-label" for="active" tabindex="6"></label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="departmentNew.Description" ng-trim="false" maxlength="250" tabindex="7"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Code" maxlength="10" ng-model="departmentNew.Code" class="form-control" required tabindex="2">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Standard Name" maxlength="50" ng-model="departmentNew.StandardName" class="form-control" required tabindex="4">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Department Head<sup>*</sup></label>
                            <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                                <input type="hidden" name="ByWhom" ng-model="departmentNew.DepartmentHeadId" class="form-control">
                                <span class="input-group-addon">{{departmentNew.DepartmentHeadCode}}</span>
                                <input type="text" name="ByWhom" ng-model="departmentNew.DepartmentHead" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="13"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="clearEmp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="departmentNew.Remarks" ng-trim="false" maxlength="250" tabindex="8"></textarea>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="budgetMasterForm2">
                    <input type="hidden" ng-model="languageNew.Id" />
                    <div class="col-xs-12 col-sm-5 col-md-5">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Language</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="languageId" class="form-control" name="Language" ng-model="languageNew.LanguageId" tabindex="1">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in languageList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-5 col-md-5">
                        <div class="form-group">
                            <label class="col-sm-5 control-label">Locally Translated Name</label>
                            <div class="col-sm-7">
                                <input type="text" ng-model="languageNew.Name" name="Name" maxlength="50" class="form-control" tabindex="2">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button ng-click="AddMultipleLanguage();" class="btn single-small-btn"><i class="glyphicon glyphicon-plus" tabindex="10"></i> {{LanguageCaption}}</button>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="languageTbl">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Language</th>
                                        <th>Locally Translated Name</th>
                                        <th class="col-md-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="x in languageDataList |itemsPerPage:languageDataParameters.pageSize" total-items="languageDataParameters.total_count"
                                        pagination-id="metaData.name + 'languageDataList'">
                                        <td>{{x.LanguageName}}</td>
                                        <td>{{x.Name}}</td>
                                        <td class="text-center table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="languageEdit(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                        <i class="glyphicon glyphicon-edit"></i>
                                                    </button>
                                                </li>
                                                <li>
                                                    <button ng-click="languageDelete(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <dir-pagination-controls max-size="10"
                                                     pagination-id="metaData.name + 'languageDataList'"
                                                     direction-links="true"
                                                     boundary-links="true"
                                                     on-page-change="getlanguageData(newPageNumber)">
                            </dir-pagination-controls>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="12"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right  aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in departments |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.DepartmentId, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>

<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <disv class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="SystemId" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </disv>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closePopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>

<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmlngPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()">

    
</confirm-archive-generic>