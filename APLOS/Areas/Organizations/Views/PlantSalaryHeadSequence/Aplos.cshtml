<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Plant Salary Head Sequence
</h3>
<div class="form-elements" ng-form id="plantSalaryHeadSequenceNew" name="plantSalaryHeadSequenceForm">
    <div class="row">
        <input type="hidden" ng-model="plantSalaryHeadSequenceNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal  form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="plantSalaryHeadSequenceNew.CompanyId" ng-change="getPlantList()"
                                ng-options="item.Value as item.Text for item in companyList" id="plantId"
                                name="Company" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal  form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="plantSalaryHeadSequenceNew.PlantId" ng-change="getPlantSalaryHeadSequence()"
                                ng-options="item.Value as item.Text for item in plantList" id="plantId"
                                name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-sm-12">
            <div class="tab-design" id="tab_show">
                <div class="site-tab">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href aria-controls="general" role="tab" data-toggle="tab">Earning Head Sequence</a></li>
                        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href aria-controls="address" role="tab" data-toggle="tab">Deduction Head Sequence</a></li>
                    </ul>
                </div>
                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1)}" id="general">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="GetSalaryHeadList('E');" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus"></i>Add Salary Head</button></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-xs-12" ng-show="earningPlantSalaryHeadSequenceSelectedList.length>0">
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th ng-show="earningPlantSalaryHeadSequenceSelectedList.length>1">Sort</th>
                                                <th>Salary Head</th>
                                                <th>Description</th>
                                                <th>HeadCategory</th>
                                                <th>Delete</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in earningPlantSalaryHeadSequenceSelectedList" ng-class="{unsaveRow : x.Id==null}">
                                                <td ng-show="earningPlantSalaryHeadSequenceSelectedList.length>1">
                                                    <span ng-show="!$first" ng-click="moveUp($index,'earningPlantSalaryHeadSequenceSelectedList')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                                    <br />
                                                    <span  ng-show="!$last" ng-click="moveDown($index,'earningPlantSalaryHeadSequenceSelectedList')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                                </td>
                                                <td>{{x.SalaryHead}}</td>
                                                <td>{{x.Description}}</td>
                                                <td>{{x.HeadCategory}}</td>
                                                <td class="text-right table-td">
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="valuePassInEarningDelModal(x,$index)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                                <i class="glyphicon glyphicon-remove"></i>
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="GetSalaryHeadList('D');" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus"></i>Add Salary Head</button></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-xs-12" ng-show="deductionPlantSalaryHeadSequenceSelectedList.length>0">
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th ng-show="deductionPlantSalaryHeadSequenceSelectedList.length>1">Sort</th>
                                                <th>Salary Head</th>
                                                <th>Description</th>
                                                <th>HeadCategory</th>
                                                <th>Delete</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in deductionPlantSalaryHeadSequenceSelectedList" ng-class="{unsaveRow : x.Id==null}">
                                                <td ng-show="deductionPlantSalaryHeadSequenceSelectedList.length>1">
                                                    <a ng-show="!$first" ng-click="moveUp($index,'deductionPlantSalaryHeadSequenceSelectedList')"><i class="glyphicon glyphicon-triangle-top"></i></a>
                                                    <br />
                                                    <a ng-show="!$last" ng-click="moveDown($index,'deductionPlantSalaryHeadSequenceSelectedList')"><i class="glyphicon glyphicon-triangle-bottom"></i></a>
                                                </td>
                                                <td>{{x.SalaryHead}}</td>
                                                <td>{{x.Description}}</td>
                                                <td>{{x.HeadCategory}}</td>
                                                <td class="text-right table-td">
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="valuePassInDeductionDelModal(x,$index)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                                <i class="glyphicon glyphicon-remove"></i>
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    </ul>
                </div>
        </div>
    </div>
        </div>
<div class="modal fade site-modal in" id="plantSalaryHeadSequencePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Salary Head</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Salary Head</th>
                                <th>Description</th>
                                <th>HeadCategory</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in plantSalaryHeadSequenceList"  ng-show="x.HeadType===assignSalaryType">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="{{x.SalaryHeadID}}" ng-model="x.Flag" ng-checked="x.Flag">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.SalaryHead}}</td>
                                <td>{{x.Description}}</td>
                                <td>{{x.HeadCategory}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="salaryHeadCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteRow()">
</confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmgenericDeductionPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteDeductionRow()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>