<togglable name="Legal/Given Designation"></togglable>
<div class="form-horizontal" ng-form="legalDesignationNewForm">
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="tab-design">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="bank" role="tab" data-toggle="tab">Basic</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="plantGrade" role="tab" data-toggle="tab">Plant & Salary Grade</a></li>
                    <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="address" role="tab" data-toggle="tab">Local Language</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" min="1" name="Sequence" ng-model="legalDesignationNew.Sequence" class="form-control" required tabindex="1">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" maxlength="15" name="ShortName" ng-model="legalDesignationNew.ShortName" class="form-control" required tabindex="3">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input maxlength="100" type="text" ng-model="legalDesignationNew.UserName" name="UserName" class="form-control" required tabindex="5">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Legal User Category<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select required name="Employee Category" ng-model="legalDesignationNew.LegalUserCategoryId" class="col-sm-3 form-control"
                                                id="empTypeId" ng-options="item.Value as item.Text for item in empTypeList" tabindex="5">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Active</label>
                                <div class="col-sm-3">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="legalDesignationNew.Active">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea maxlength="250" name="Description" class="form-control" rows="3" ng-model="legalDesignationNew.Description" tabindex="7"></textarea>
                                </div>
                            </div>

                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" maxlength="10" name="Code" ng-model="legalDesignationNew.Code" class="form-control" required tabindex="2">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input maxlength="100" type="text" name="StandardName" ng-model="legalDesignationNew.StandardName" class="form-control" required tabindex="4">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">User Define Report Designation</label>
                                <div class="col-sm-8">
                                    <input maxlength="50" type="text" name="User Define Report Designation" ng-model="legalDesignationNew.UserDefineReportDesignation" class="form-control" tabindex="6">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Factor</label>
                                <div class="col-sm-8">
                                    <input maxlength="50" type="text" name="Factor" n-decimals="2" ng-model="legalDesignationNew.Factor" class="form-control" tabindex="8">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Is Grade Specific</label>
                                <div class="col-sm-2">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="legalDesignationNew.IsGradeSpecific">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>

                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea maxlength="250" name="Remarks" class="form-control" rows="3" ng-model="legalDesignationNew.Remarks" tabindex="10"></textarea>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>
                                            <div class="checkbox-site text-center">
                                                <input type="checkbox" ng-click="CheckAll($event);">
                                            </div>
                                        </th>
                                        <th>Company Name</th>
                                        <th>Plant Name</th>
                                        <th>Salary Grade</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in PlantList">
                                        @*<td>
                                                <div class="checkbox-site">
                                                    <label>
                                                        <input type="checkbox" ng-model="x.Flag" checked="{{x.Flag}};">
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </td>*@
                                        <td class="text-right table-td">
                                            <div class="checkbox-site">
                                                <input type="checkbox" ng-model="x.Flag" ng-click="selectChValueId($event,x)">
                                            </div>
                                        </td>
                                        <td>{{x.Company}}</td>
                                        <td>{{x.Plant}}</td>
                                        <td>
                                            <div class="select-style">
                                                @*<select class="form-control" name="LegalSalaryGradeId" ng-disabled="!x.Flag" id="LegalSalaryGradeId" ng-model="x.LegalSalaryGradeId" ng-change="setLGD(x.LegalSalaryGradeId,$index)">
                                                        <option value="">--Select--</option>
                                                        <option ng-repeat="option in LegalSalaryGradeList" value="{{option.LegalSalaryGradeId}}">{{option.UserName}}</option>
                                                    </select>*@
                                                <select class="form-control" ng-disabled="!x.Flag" ng-model="x.LegalSalaryGradeId" ng-options="item.LegalSalaryGradeId as item.UserName for item in LegalSalaryGradeList| filter:{PlantId:x.PlantId }" ng-change="setLGD(x.LegalSalaryGradeId,$index)">
                                                    <option value="">--Select--</option>
                                                </select>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                    <div class="row">
                        <input type="hidden" ng-model="languageNew.Id" />
                        <div class="col-xs-12 col-sm-5 col-md-5">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Language</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select id="languageId" class="form-control" name="Language" ng-model="languageNew.LanguageId" tabindex="1">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in languageList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-5 col-md-5">
                            <div class="form-group">
                                <label class="col-sm-5 control-label">Locally Translated Name</label>
                                <div class="col-sm-7">
                                    <input type="text" ng-model="languageNew.Name" name="Name" maxlength="50" class="form-control" tabindex="2">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2">
                            <button ng-click="AddMultipleLanguage();" class="btn single-small-btn"><i class="glyphicon glyphicon-plus" tabindex="10"></i> {{LanguageCaption}}</button>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <div class="table-responsive modal-table" ng-show="languageDataList.length>0">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Language</th>
                                            <th>Locally Translated Name</th>
                                            <th class="col-md-2">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr dir-paginate="x in languageDataList |itemsPerPage:languageDataParameters.pageSize" total-items="languageDataParameters.total_count"
                                            pagination-id="metaData.name + 'languageDataList'">
                                            <td>{{x.LanguageName}}</td>
                                            <td>{{x.Name}}</td>
                                            <td class="text-center table-td">
                                                <ul class="list-inline action-list">
                                                    <li>
                                                        <button ng-click="languageEdit(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                            <i class="glyphicon glyphicon-edit"></i>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button ng-click="languageDelete(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                            <i class="glyphicon glyphicon-remove"></i>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <dir-pagination-controls max-size="10"
                                                         pagination-id="metaData.name + 'languageDataList'"
                                                         direction-links="true"
                                                         boundary-links="true"
                                                         on-page-change="getlanguageData(newPageNumber)">
                                </dir-pagination-controls>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>

<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sequence</th>
                    <th>Code</th>
                    <th>Short Name</th>
                    <th>Standard Name</th>
                    <th>User Name</th>
                    <th>User Define Report Designation</th>
                    <th>Designation Master</th>
                    <th>Designation Group</th>
                    <th>Designation</th>
                    <th>Legal User Category</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in legalDesignations |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get($index);">
                    <td>{{x.Sequence}}</td>
                    <td>{{x.Code}}</td>
                    <td>{{x.ShortName}}</td>
                    <td>{{x.StandardName}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.UserDefineReortDesignation}}</td>
                    <td>{{x.DesignationMaster}}</td>
                    <td>{{x.DesignationGroup}}</td>
                    <td>{{x.Designation}}</td>
                    <td>{{x.LegalUserCategory}}</td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="getData(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmlngPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>