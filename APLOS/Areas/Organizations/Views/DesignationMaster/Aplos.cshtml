<togglable name="Designation Master"></togglable>
<div class="form-elements form-horizontal" ng-form id="designationMasterNew" name="designationMasterNewForm">
    <input type="hidden" ng-model="designationMasterNew.Id">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Basic</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="legaldesignation" role="tab" data-toggle="tab">Legal Designation</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="FormTab1">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="10" name="Code" ng-model="designationMasterNew.Code" class="form-control" required tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Designation Group<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select required name="DesignationGroup" ng-model="designationMasterNew.DesignationGroupId" class="col-sm-3 form-control"
                                            id="designationGroupId" ng-options="item.Value as item.Text for item in designationGroupList" tabindex="3">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Employee Category<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select required name="Employee Category" ng-model="designationMasterNew.EmployeeCategoryId" class="col-sm-3 form-control"
                                            id="empTypeId" ng-options="item.Value as item.Text for item in empTypeList" tabindex="5">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="designationMasterNew.Active" tabindex="6">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input maxlength="50" type="text" ng-model="designationMasterNew.UserName" name="User name" class="form-control" required tabindex="2">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Designation<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select required name="Designation" ng-model="designationMasterNew.DesignationId" class="col-sm-3 form-control"
                                            id="designationId" ng-options="item.Value as item.Text for item in designationList" tabindex="4">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        @*<div class="form-group">
                            <label class="col-sm-4 control-label">Recruitment Process Set</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select tabindex="6" ng-model="designationMasterNew.RecruitmentProcessSetId" class="form-control" ng-options="item.Value as item.Text for item in recruitmentProcessSetList" name="RecruitmentProcessSet"><option value=""></option></select>
                                </div>
                            </div>
                        </div>*@
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="FormTab2">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="legalDesignationPopUp();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Legal Designation</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12" ng-show="desLegalList.length>0">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Sequence</th>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>
                                        <th>User Name</th>
                                        <th>Active</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in desLegalList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Sequence}}</td>
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td>{{x.Active?'Yes':'No'}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="valuePassInDelModal($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="17"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="18"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="19"></i> Clear</button></li>
            <li><button ng-click="designationMasterReport();" class="btn"><i class="glyphicon glyphicon-print"></i> Report</button></li>
            <li><button ng-click="confirmToSync();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Sync. Designation</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>User Name</th>
                <th>Designation Group</th>
                <th>Designation</th>
                <th>Employee Category</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in designationMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Code}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.DesignationGroupName}}</td>
                <td>{{x.DesignationName}}</td>
                <td>{{x.EmployeeCategoryName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmLegalDesigPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="removeLegalDesigRow()">
</confirm-archive-generic>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="SyncDesignation()"></confirm-archive-generic>
<!-- #region Legal Designation -->
<div class="modal fade site-modal in" id="legalDesigPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Legal Designation <button type="button" class="close" data-dismiss="modal">&times;</button> </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="legalDesigParameters.searchBy">
                                            <option ng-repeat="option in searchlegalDesigList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="legalDesigParameters.search" ng-enter="getLegalDesigData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getLegalDesigData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in legalDesignationList|itemsPerPage:legalDesigParameters.pageSize" total-items="legalDesigParameters.total_count"
                                pagination-id="metaData.name + 'legalDesignationList'">
                                <td class="text-center">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectLdValueId($event,x.Id);">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'legalDesignationList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getLegalDesigData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="addLegalDesig()" class="btn">Add</button></li>
                        <li> <button ng-click="closeLegalDesigPopUp()" class="btn">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->