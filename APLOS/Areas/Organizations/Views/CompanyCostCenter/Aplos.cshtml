<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Company Cost Center</h3>
<div class="form-elements row">
    <div class="form-group">
        <label class="col-sm-3 col-md-2 control-label">Company</label>
        <div class="col-sm-3 col-md-4">
            <div class="select-style">
                <select class="form-control" ng-model="companyCostCenter.CompanyId"
                        ng-options="item.Value as item.Text for item in companyList"
                        ng-change="getCompanyCostCenterOnCompanyChange(companyCostCenter.CompanyId)"><option></option></select>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-left">
            <li>
                <button ng-click="costCenterSearchPopup();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add CostCenter</button>
            </li>
        </ul>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-right">
            <li>
                <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button>
            </li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="tableShow">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>User Name</th>
                <th>Category</th>
                <th>Subcategory</th>
                <th>Remove</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in costCenterSelectedList" ng-class="{unsaveRow : x.Id==null}">
                <td>{{x.Code}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.CostCenterCategoryName}}</td>
                <td>{{x.CostCenterSubCategoryName}}</td>
                <td class="text-right table-td">
                    <ul class="list-inline action-list">
                        <li>
                            <button ng-click="valuePassInDelModal($index, x.CostCenterId, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="modal fade site-modal in" id="costCenterListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Cost Center
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">

                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="costCenterListParameters.searchBy">
                                            <option ng-repeat="option in searchByCostCenterList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="costCenterListParameters.search" ng-enter="loadCostCenterData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadCostCenterData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Code</th>
                                <th>User Name</th>
                                <th>Category</th>
                                <th>Subcategory</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in costCenterList  |itemsPerPage:costCenterListParameters.pageSize" pagination-id="metaData.name + 'costCenterList'" total-items="costCenterListParameters.total_count" ng-dblclick="checkIsRegisterApply(x);">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="{{x.Id}}" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectCostCenterChValue($event,x)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.CostCenterCategoryName}}</td>
                                <td>{{x.CostCenterSubCategoryName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="20"
                                             pagination-id="metaData.name + 'costCenterList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadCostCenterData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="costCenterCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteCostCenterList()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>