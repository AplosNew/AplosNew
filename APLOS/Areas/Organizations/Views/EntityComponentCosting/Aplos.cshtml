<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> Entity Component Costing</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="model.CompanyId" name="Company" ng-change="getEntityList();"
                            ng-options="item.Value as item.Text for item in companyList" tabindex="1" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="model.CurrencyId" name="Currency" ng-change="currencyChange();"
                            ng-options="item.Value as item.Text for item in currencyList" tabindex="3" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">No of WorkStation<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" only-numbers name="Exchange Rate" ng-model="model.NoOfWorkStation" class="form-control text-right" placeholder="0.00" tabindex="5" required>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="model.EntityId" name="Entity" ng-change="getData();"
                            ng-options="item.Value as item.Text for item in entityList" tabindex="2" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Exchange Rate<sup ng-show="exchangeRate">*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" n-decimals="4" name="Exchange Rate" ng-model="model.ExchangeRate" class="form-control text-right" placeholder="0.00" ng-disabled="exchangeRate" tabindex="4" ng-required="exchangeRate">
                    <span class="input-group-addon">{{model.CompanyCurrency}}</span>
                </div>
            </div>
        </div>
        
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="6" ></i> {{model.Id==null?'Save':'Update'}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="7"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="mainList.length>0">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Component</th>
                <th>Hourly Fixed</th>
                <th>Hourly Variable</th>
                <th class="col-md-1">Option 1</th>
                <th class="col-md-1">Option 2</th>
                <th class="col-md-1">Option 3</th>
            </tr>
        </thead>
        <tbody class="form-elements">
            <tr ng-repeat="x in mainList">
                <td>{{x.ComponentAlias}}</td>
                <td><div><input type="text" n-decimals="4" ng-model="x.MonthlyFixedCost" class="form-control text-right" placeholder="0.00"></div></td>
                <td><div><input type="text" n-decimals="4" ng-model="x.SemiVariableCost" class="form-control text-right" placeholder="0.00"></div></td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label style="margin-top: 4px;">
                            <input type="checkbox" ng-model="x.FirstOption" ng-checked="x.FirstOption">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label style="margin-top: 4px;">
                            <input type="checkbox" ng-model="x.SecondOption" ng-checked="x.SecondOption">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td class="text-center">
                    <div class="checkbox-site">
                        <label style="margin-top: 4px;">
                            <input type="checkbox" ng-model="x.ThirdOption" ng-checked="x.ThirdOption">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</div>