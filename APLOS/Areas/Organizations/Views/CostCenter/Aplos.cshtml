<togglable name="Cost Center"></togglable>
<div class="form-elements" ng-form id="costCenterNew" name="costCenterForm">
    <input type="hidden" ng-model="costCenterNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" max="100" name="Sequence" ng-model="costCenterNew.Sequence" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="costCenterNew.StandardName" class="form-control" required tabindex="3" maxlength="50">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="costCenterNew.CostCenterCategoryId"
                            ng-options="item.Value as item.Text for item in costCenterCategoryCboList" id="CostCenterCategoryId"
                            name="Cost Center Category" required tabindex="5">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Type</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" name="CurrencyTransaction" ng-model="costCenterNew.CostType" required tabindex="3">
                        <option ng-repeat="option in costCenterTypeList" value="{{option.Text}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" name="Description" ng-model="costCenterNew.Description" tabindex="7" maxlength="250"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="costCenterNew.Code" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="costCenterNew.UserName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Subcategory<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="costCenterNew.CostCenterSubCategoryId"
                            ng-options="item.Value as item.Text for item in costCenterSubCategoryCboList" id="CostCenterSubCategoryId"
                            name="Cost Center SubCategory" required tabindex="6">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label" ng-show="costCenterNew.CostType=='@Library.Model.Enums.CostCenterType.Employee.ToString()'">Employee</label>
            <label class="col-sm-4 control-label" ng-show="costCenterNew.CostType=='@Library.Model.Enums.CostCenterType.Department.ToString()'">Department</label>
            <label class="col-sm-4 control-label" ng-show="costCenterNew.CostType=='@Library.Model.Enums.CostCenterType.Line.ToString()'">Line</label>
            <label class="col-sm-4 control-label" ng-show="costCenterNew.CostType=='@Library.Model.Enums.CostCenterType.Unit.ToString()'">Unit</label>
            <div class="col-sm-8 show-message">
                <div class="input-group" ng-show="costCenterNew.CostType=='@Library.Model.Enums.CostCenterType.Employee.ToString()'">
                    <input type="text" name="EmployeeName" ng-model="costCenterNew.EmployeeName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeGroupListPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearEmployee()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
                <div class="select-style" ng-show="costCenterNew.CostType=='@Library.Model.Enums.CostCenterType.Unit.ToString()'">
                    <select ng-model="costCenterNew.UnitId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in unitList" tabindex="2">
                        <option value=""></option>
                    </select>
                </div>
                <div class="select-style" ng-show="costCenterNew.CostType=='@Library.Model.Enums.CostCenterType.Department.ToString()'">
                    <select ng-model="costCenterNew.DepartmentId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in departmentList" tabindex="4">
                        <option value=""></option>
                    </select>
                </div>
                <div class="select-style" ng-show="costCenterNew.CostType=='@Library.Model.Enums.CostCenterType.Line.ToString()'">
                    <select ng-model="costCenterNew.LineId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in lineList" tabindex="4">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="costCenterNew.Remarks" maxlength="250" tabindex="8"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="costCenterNew.Active" tabindex="10">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="12"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="13"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByCostCenterList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>User Name</th>
                <th>Category</th>
                <th>Subcategory</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in costCenters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.CostCenterCategoryName}}</td>
                <td>{{x.CostCenterSubCategoryName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>

<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
