<togglable name="Recruitment Planning"></togglable>
<div class="form-horizontal" ng-form name="recruitmentPlanningForm">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select tabindex="1" class="form-control" ng-model="recruitmentPlanning.CompanyId" name="Company"
                            ng-options="item.Value as item.Text for item in companyList"
                            ng-change="getCboPlantByCompany(recruitmentPlanning.CompanyId)" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select tabindex="2" class="form-control" ng-model="recruitmentPlanning.PlantId" name="Plant"
                            ng-options="item.Value as item.Text for item in plantList" ng-change="getData();
                            getCboRecruitmentGroupByPlant(recruitmentPlanning.PlantId);
                            getCboManpowerBudgetByCompanyAndPlant(recruitmentPlanning.CompanyId, recruitmentPlanning.PlantId);" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <input type="hidden" ng-model="recruitmentPlanning.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" maxlength="50" name="UserName" ng-model="recruitmentPlanning.UserName" class="form-control" tabindex="5" required>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="recruitmentPlanning.Active" tabindex="9">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea maxlength="250" class="form-control" rows="3" ng-model="recruitmentPlanning.Remarks" tabindex="8"></textarea>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="table-responsive modal-table voucher-table">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Manpower Budget</th>
                        <th>Recruitment Group</th>
                        <th>OnBoard Date</th>
                        <th>Male</th>
                        <th>Female</th>
                        <th>Total</th>
                        <th style="width:125px">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="6">
                            <button name="submit" class="btn single-small-btn" ng-click="manpowerBudgetPopUp(recruitmentPlanning.PlantId)" tabindex="1" style="Width:22%;float:left">
                                Select Manpower Budget <i class="cr-icon glyphicon glyphicon-search"></i>
                            </button>
                        </td>
                        <td></td>
                    </tr>
                    <tr ng-repeat="x in recruitmentPlanningDetailList">
                        <td>{{x.ManpowerBudgetCode}}</td>
                        <td>
                            <div class="select-style">
                                <select ng-change="getOnboard(x.RecruitmentGroupId, $index);" class="form-control" ng-model="x.RecruitmentGroupId"
                                        ng-options="item.Value as item.Text for item in recruitmentGroupList" name="Position Manpower Budget" tabindex="4"></select>
                            </div>
                        </td>
                        <td>{{x.OnBoardDate}}</td>
                        <td class="text-right"><input ng-keyup="countTotalNumber(x.Male, x.Female, $index);" type="number" class="form-control text-right" ng-model="x.Male"></td>
                        <td class="text-right"><input ng-keyup="countTotalNumber(x.Male, x.Female, $index);" type="number" class="form-control text-right" ng-model="x.Female"></td>
                        <td class="text-right"><input type="text" class="form-control text-right" ng-model="x.TotalManpower" readonly></td>
                        <td class="text-right">
                            <button ng-click="removeRow($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                            <button ng-click="recruitmentProcessSetDetailPopUp(x.PositionId, x.OnBoardDate)" class="btn btn-action tooltip-here" data-placement="top" title="Detail">
                                <i class="glyphicon glyphicon glyphicon-list"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="110"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="12"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList | orderBy:'name'" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>User Name</th>
                <th>Remarks</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in recruitmentPlannings|itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Id}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Remarks}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
@Html.Partial("_ConfirmModal")
@Html.Partial("~/Areas/Organizations/Views/ManpowerBudget/_ManpowerBudgetMultiSelectPopUp.cshtml")
<div class="modal fade site-modal in" id="recruitmentProcessSetDetailPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Recruitment Process Set Detail
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sequence</th>
                                <th>Recruitment Process</th>
                                <th>Required Days</th>
                                <th>Start Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in recruitmentProcessSetDetailList| orderBy:'Sequence'">
                                <td>{{x.Sequence}}</td>
                                <td>{{x.RecruitmentProcess.UserName}}</td>
                                <td>{{x.RequiredDays}}</td>
                                <td>{{x.AddedBy}}</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td></td>
                                <td><b>OnBoardDate</b></td>
                                <td>{{OnBoardDate | dateFiltering}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button type="button" class="close" data-dismiss="modal">OK</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>