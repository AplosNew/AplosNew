<togglable name="Entity Allowance"></togglable>
<div ng-form name="entityAllowanceForm" id="entityAllowanceNew" class="form-horizontal">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="entityAllowanceNew.CompanyId" name="Company" ng-options="item.Value as item.Text for item in companyList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-5 pdr3">
                <input type="hidden" ng-model="entityAllowanceNew.EntityId" class="form-control">
                <input type="text" ng-model="entityAllowanceNew.EntityName" class="form-control" disabled required>
            </div>
            <div class="pdl3">
                <button name="submit" class="btn single-small-btn" ng-click="entityPopUp(entityAllowanceNew.CompanyId)" tabindex="3">
                    <i class="cr-icon glyphicon glyphicon-search"></i>
                </button>
                <button class="btn single-small-btn" ng-click="clearEntity()">
                    <i class="cr-icon glyphicon glyphicon-refresh"></i>
                </button>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Designation Group<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="entityAllowanceNew.DesignationGroupId" ng-options="item.Value as item.Text for item in designationGroupList"
                            name="Designation Group" required tabindex="4" ng-change="getAllowanceData()"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" class="form-control" datepicker ng-model="entityAllowanceNew.EffectiveDate" placeholder="Every month 1st day" name="EffectiveDate" tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Allowance<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Skill Allowance" maxlength="20" ng-model="entityAllowanceNew.Allowance" class="form-control text-right" n-decimals="4" required tabindex="5">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group">
                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" id="currencyId" ng-model="entityAllowanceNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList" name="Currency" tabindex="1"></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="allowanceParameters.searchBy">
                            <option ng-repeat="option in searchByAllowanceList | orderBy:'name'" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="allowanceParameters.search" ng-enter="getAllowanceData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getAllowanceData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Effective Date</th>
                <th>Currency</th>
                <th>Allowance</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in entityAllowanceList | itemsPerPage:allowanceParameters.pageSize" total-items="allowanceParameters.total_count" ng-dblclick="Get($index)">
                <td>{{x.EffectiveDate| dateFiltering}}</td>
                <td>{{x.CurrencyName}}</td>
                <td>{{x.Allowance}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getAllowanceData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Organizations/Views/Entity/_EntityPopUp.cshtml")