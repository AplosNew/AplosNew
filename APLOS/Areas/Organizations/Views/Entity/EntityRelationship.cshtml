<togglable name="Entity Relationship"></togglable>
<div class="col-sm-6 col-md-6 form-element-ctrl form-horizontal">
    <div class="form-group">
        <label class="col-sm-4 col-md-4 control-label">Company Group</label>
        <div class="col-sm-8 col-md-8 show-message">
            <div class="select-style">
                <select class="form-control" ng-model="companyStructureRelation.CompanyGroupId" ng-options="item.Value as item.Text for item in companyGroupList" ng-change="getCompany()" required>
                    <option value=""></option>
                </select>
            </div>
        </div>
    </div>
</div>
<div class="col-sm-6 col-md-6 form-element-ctrl form-horizontal">
    <div class="form-group">
        <label class="col-sm-4 col-md-4 control-label">Company</label>
        <div class="col-sm-8 col-md-8 show-message">
            <div class="select-style">
                <select class="form-control" ng-model="companyStructureRelation.CompanyId" ng-options="item.Value as item.Text for item in companyList" ng-change="getData(companyStructureRelation.CompanyId)" required>
                    <option value=""></option>
                </select>
            </div>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<div class="form-elements form-horizontal" ng-form id="companyStructureRelation" name="comSRForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Sequence" ng-model="companyStructureRelation.Sequence" class="form-control" required placeholder="0" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Standard Name" ng-model="companyStructureRelation.StandardName" required tabindex="3">
                        <option value="">--Select--</option>
                        <option value="Division">Division</option>
                        <option value="EmployeeGroup">EmployeeGroup</option>
                        <option value="Line">Line</option>
                        <option value="Plant">Plant</option>
                        <option value="SubDivision">SubDivision</option>
                        <option value="ShiftDefination">ShiftDefination</option>
                        <option value="Unit">Unit</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" maxlength="50" ng-model="companyStructureRelation.UserName" class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="companyStructureRelation.Active" ng-checked="true">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="companyStructureRelation.Description" tabindex="2" maxlength="250"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="companyStructureRelation.Remarks" tabindex="4" maxlength="250"></textarea>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle" ng-show="ngShowTbl">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle" ng-show="ngShowTbl">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in   filtered = (comSR | orderBy:'Sequence') |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>