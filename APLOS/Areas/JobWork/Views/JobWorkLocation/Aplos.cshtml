<togglable name={{title}}></togglable>
<div class="form-elements form-horizontal" ng-form name="jobWorkLocation" style="padding:10px;">
    <div class="row">
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlPlantId">
                    Plant<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <select name="PlantId" id="ddlPlantId" class="form-control" submit-required="true" tabindex="1" ng-model="JobWorkLocation.PlantId" ng-options="item.Id as item.UserName for item in plantList" required ng-change="getAllEntity()"></select>
                        <input type="hidden" id="txtId" name="txtId" ng-model="JobWorkLocation.Id" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlEntityId">
                    Entity<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <select name="EntityId" id="ddlEntityId" class="form-control" submit-required="true" tabindex="2" ng-model="JobWorkLocation.EntityId" ng-options="item.Id as item.UserName for item in entityList" required></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="txtLocationName">
                    Location Name<sup>*</sup>
                </label>
                <div class="show-message">
                    <input type="text" id="txtLocationName" name="Location Name" class="form-control" ng-model="JobWorkLocation.LocationName" required tabindex="3" />

                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="txtLocationCode">
                    Location Code<sup>*</sup>
                </label>
                <div class="show-message">
                    <input type="text" id="txtLocationCode" name="Location Code" class="form-control" ng-model="JobWorkLocation.LocationCode" required tabindex="4" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group">
                <label class="control-label" for="ddlStoreLocationId">
                    Store Location(If Applicable)
                </label>
                <div class="select-style">
                    <select name="StoreLocationId" id="ddlStoreLocationId" class="form-control" tabindex="5" ng-model="JobWorkLocation.StoreLocationId" ng-options="item.Id as item.UserName for item in storeLocationList"></select>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <div class="row">
                    <label class="col-sm-12 control-label">Responsible Person-1<sup>*</sup></label>
                    <div class="col-sm-12 show-message">
                        <div class="input-group">
                            <input type="hidden" name="EmployeeId1" ng-model="JobWorkLocation.ResponsiblePerson1Id" />
                            <input type="text" name="ResponsiblePerson1Name" ng-model="JobWorkLocation.ResponsiblePerson1Name" class="form-control" readonly required tabindex="6" />
                            <span class="input-group-btn">
                                <button ng-click="showResponsiblePersonListPopUp('EmployeeId1','ddlResponsiblePerson1')" tabindex="6" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                <button ng-click="clearResponsiblePerson(1)" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <div class="row">
                    <label class="col-sm-12 control-label">Responsible Person-2<sup>*</sup></label>
                    <div class="col-sm-12 show-message">
                        <div class="input-group">
                            <input type="hidden" name="EmployeeId2" ng-model="JobWorkLocation.ResponsiblePerson2Id" />
                            <input type="text" name="ResponsiblePerson2Name" ng-model="JobWorkLocation.ResponsiblePerson2Name" class="form-control" readonly required tabindex="7" />
                            <span class="input-group-btn">
                                <button ng-click="showResponsiblePersonListPopUp('EmployeeId2','ddlResponsiblePerson2')" tabindex="7" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                <button ng-click="clearResponsiblePerson()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="txtCycleTime">
                    Active / In-Active
                </label>
                <div class="show-message">
                    <div class="checkbox-site">
                        <label>
                            <input tabindex="8" type="checkbox" ng-model="JobWorkLocation.IsActive">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group">
                <label>Remarks</label>

                <textarea class="form-control" ng-model="JobWorkLocation.Remarks" tabindex="9" maxlength="250"></textarea>
            </div>
        </div>
    </div>
 
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{JobWorkLocation.Id==null?'Save':'Update'}}</button></li>
                <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
 
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top: 20px;">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="AddNewItem();" ng-disabled="JobWorkLocation.Id==null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Activity</button></li>
                </ul>
            </div>
        </div>
        <div class="col-xs-12">
            <div style="color:black;" id="GridSelectedEmpCategoryTab" ej-grid e-datasource="SelectedEmpCategoryTabList"
                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="false" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-type="string" e-field="LocationName" e-headertext="Job Work Location Master" e-width="40"></div>
                    <div e-column e-type="string" e-field="JobWorkActivity" e-headertext="Job Work Activtiy" e-width="40"></div>
                    <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                    <div e-column e-type="string" e-field="JobWorkActivityType" e-headertext="Type" e-width="40"></div>
                    <div e-column e-type="string" e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="40"></div>


                    <div e-column e-template="#DeleteEmpCategoryTab" e-width="40"></div>
                </div>
            </div>

            <script type="text/template" id="DeleteEmpCategoryTab">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="$parent.ConfirmDeleteEmpCategoryTab(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                    </ul>
                </div>
            </script>

        </div>
    
    </div>
</div>

<div class="aplos-grid-toggle">
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <div id="GridData" ej-grid e-datasource="gridDataList" e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowResizing="true"
                 e-allowTextWrap="true"
                 e-allowscrolling="true"
                 e-filtersettings-filterType="excel"
                 e-enabletouch="true" e-responsive="true"
                 e-recorddoubleclick="recorddoubleclick">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                    <div e-column e-field="PlantId" e-headertext="Plant" e-width="150"></div>
                    <div e-column e-field="EntityId" e-headertext="Entity" e-width="150"></div>
                    <div e-column e-field="LocationName" e-headertext="Location Name" e-width="150"></div>
                    <div e-column e-field="LocationCode" e-headertext="Location Code" e-width="100"></div>
                    <div e-column e-field="StoreLocationId" e-headertext="Store Location" e-width="150"></div>
                    <div e-column e-field="ResponsiblePerson1Name" e-headertext="Responsible 1" e-width="150"></div>
                    <div e-column e-field="ResponsiblePerson2Name" e-headertext="Responsible 2" e-width="150"></div>
                    <div e-column e-field="IsActive" e-headertext="Active" e-width="100"></div>
                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="200"></div>
                    <div e-column e-template="#GridActions" e-width="75" textAlign='center'></div>
                </div>
            </div>
            <script type="text/template" id="GridActions">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnApprove">
                    <i class="fa fa-pencil" title="Load Data" ng-click="$parent.LoadSelectedData('GridData');" style="margin: -6px;"></i>
                </button>
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnDelete">
                    <i class="fa fa-trash" title="Delete Data" ng-click="$parent.DeleteSelectedData('GridData');" style="margin: -6px;"></i>
                </button>
            </script>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="EmpCatTabPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Job Work Activity List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridEmpCatTab" ej-grid e-datasource="EmpCatList"
                             e-allowfiltering="true" e-allowpaging="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-template="#checkedEmpCatTabItem" e-width="20"></div>
                                <div e-column e-type="string" e-field="Sequence" e-headertext="Sequence" e-width="40"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="140"></div>
                                <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="StandardName" e-headertext="StandardName" e-width="80"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="Job Work Activity Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="Type" e-headertext="Type" e-width="80"></div>
                                <div e-column e-type="string" e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="40"></div>

                            </div>

                        </div>
                        <script type="text/template" id="checkedEmpCatTabItem">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.isSelected" e-checked="data.isSelected" />
                        </script>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="SaveEmpCatTab();closeEmpCatTabPopUp('EmpCatTabPopUp');" class="btn"><i class=""></i> Save</button>
                            <button ng-click="closeEmpCatTabPopUp('EmpCatTabPopUp');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Employees/Views/Shared/_ResponsiblePersonPopUp.cshtml")

<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="removerPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="removeChildRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDelEmpCatPopUp" title="Confirmation" message="Are you sure want to Delete?" data-ng-click-right-button="DelLocationChild();"></confirm-archive-generic>


