<togglable name={{title}}></togglable>
<div class="form-elements form-horizontal">
    <div class="row" ng-form name="jobWorkTransformationMasterform">
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3" ng-show="LabelActivity">
                <div class="form-group" show-errors>
                    <label class="control-label">Job Work Activity<sup>*</sup></label>
                    <div class="show-message">
                        <input type="text" tabindex="1" name="Job Work Activity" submit-required="true" n-decimals="2" class="form-control" readonly ng-model="Transformation.ActivityName" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3" ng-show="ShowActivity">
                <div class="form-group" show-errors>
                    <label class="control-label" for="ddlJobWorkActivityId">
                        Job Work Activity<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <div class="select-style">
                            <div class="select-style">
                                <select id="ddlJobWorkActivityId" name="Job Work Activity" tabindex="1" class="form-control" submit-required="true" ng-model="Transformation.JobWorkActivityId" ng-options="item.Id as item.UserName for item in jobWorkActivityList" required ng-change="getActivityChildItems()"></select>
                                <input type="hidden" id="txtId" name="Id" class="form-control" ng-model="Transformation.Id" tabindex="0" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="ddlType">
                        Output Material<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <div class="select-style">
                            <div class="select-style">
                                <select id="ddlType" name="Type" tabindex="3" class="form-control" submit-required="true" ng-model="Transformation.JobWorkActivityChildId" ng-options="item.JobWorkItemId as item.JobWorkItem for item in activityChildItemsList" required ng-change="getJobWorkItemUOM()"></select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="ddlMaterialUOM">
                        Item UOM<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" name="Item UOM" tabindex="4" class="form-control" ng-model="Transformation.UOM" readonly required />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <div class="row">
                        <label class="col-sm-12 control-label">Material Master</label>
                        <div class="col-sm-12">
                            <div class="input-group">
                                <span class="input-group-addon">{{Transformation.MaterialCode}}</span>
                                <input type="text" ng-model="Transformation.MaterialName" class="form-control" readonly>
                                <input type="hidden" ng-model="Transformation.MaterialMasterId" />
                                @*<span class="input-group-btn">
                                <button ng-click="MaterialMstPopUp()" tabindex="8" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                <button ng-click="MaterialMstClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                            </span>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="ddlRateApplicable">
                        Rate Applicable<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <div class="select-style">
                            <div class="select-style">
                                <select id="ddlRateApplicable" name="Rate Applicable" tabindex="7" class="form-control" submit-required="true" ng-model="Transformation.RateApplicable" ng-options="item.name as item.name for item in rateApplicableList" required></select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="ddlCurrencyId">
                        Currency<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <div class="select-style">
                            <select id="ddlCurrencyId" name="Currency" tabindex="8" class="form-control" submit-required="true" ng-model="Transformation.CurrencyId" ng-options="item.CurrencyId as item.Code for item in currencyList" required></select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <label class="control-label">Min Rate</label>
                    <input type="text" name="Min Rate" tabindex="9" n-decimals="2" class="form-control" ng-model="Transformation.MinRate" />
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <label class="control-label">Max Rate</label>
                    <input type="text" name="Max Rate" tabindex="10" n-decimals="2" class="form-control" ng-model="Transformation.MaxRate" />
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <label class="control-label">Cycle Time(Days)</label>
                    <input type="text" name="Cycle Time" tabindex="11" n-decimals="2" class="form-control" ng-model="Transformation.CycleTime" />
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <div class="row">
                        <label class="col-sm-12 control-label">Responsible Person</label>
                        <div class="col-sm-12">
                            <div class="input-group">
                                <input type="text" name="Responsible Person" ng-model="Transformation.ResponsiblePerson" class="form-control" readonly />
                                <input type="hidden" name="EmployeeId" ng-model="Transformation.ResponsiblePersonId" />
                                <span class="input-group-btn">
                                    <button ng-click="showResponsiblePersonListPopUp('Master')" tabindex="12" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="clearResponsiblePerson()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="ddlByProductApplicable">
                        By Product Applicable<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <div class="select-style">
                            <div class="select-style">
                                <select id="ddlByProductApplicable" name="By Product Applicable" tabindex="7" class="form-control" submit-required="true" ng-model="Transformation.ByProductApplicable" ng-options="item.name as item.name for item in byProductApplicable" required ng-change="SetShowHideTab()"></select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <label class="control-label">Remarks</label>
                    <input type="text" name="Remarks" tabindex="13" class="form-control" ng-model="Transformation.Remarks" />
                </div>
            </div>
        </div>


        <div class="row">
            <div class="form-group" show-errors>
                <label class="col-sm-12 control-label">Process<sup>*</sup></label>
                <div class="col-sm-12 show-message">
                    <input id="ddlProcess" ej-dropdownlist e-create="create" name="Process" required e-headertemplate='<input class="temp" type="checkbox" id="checkBox" />' e-multiselectmode="visualmode" e-datasource="processList" e-fields-value="Id" e-fields-text="UserName" e-width="100%" e-showcheckbox="true" />
                </div>
            </div>
        </div>
    </div>
    <div class="site-tab" style="margin-top:10px;">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="MaterialInput" role="tab" data-toggle="tab">Material Input</a></li>
            <li ng-show="Transformation.ByProductApplicable=='Yes'" role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="ByProduct" role="tab" data-toggle="tab">By Product</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div id="MaterialInput">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top: 0px;">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="AddNewRow();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Material Input</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <div class="table-responsive modal-table table-wrapper-scroll-y my-custom-scrollbar">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th ng-hide="true">Id</th>
                                        <th ng-hide="true">JobWorkItemId</th>
                                        <th>Item Name</th>
                                        <th>Item Specification</th>
                                        <th>Item UOM</th>
                                        <th>Net Consumption</th>
                                        <th>Rejection</th>
                                        <th>Value Loss</th>
                                        <th>Gross Consumption</th>
                                        <th>Responsible Person</th>
                                        <th>Remarks</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in materialInputList">
                                        <td ng-hide="true">{{x.Id}}</td>
                                        <td ng-hide="true">{{x.JobWorkItemId}}</td>
                                        <td>
                                            <div class="select-style">
                                                <select name="JobWorkItemId" class="form-control" ng-model="x.JobWorkItemId" ng-options="item.Id as item.UserName for item in materialNameList" ng-change="ChangeMaterial(x.MaterialMasterId,$index)" style="height: 30px;width:200px;" tabindex="16"></select>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control" ng-model="x.ItemSpecification" style="width:200px;" /></td>
                                        <td><input type="text" class="form-control" ng-model="x.UOM" readonly style="width: 100px;" /></td>
                                        <td><input type="text" class="form-control" ng-model="x.NetConsumption" style="width: 100px;" ng-blur="grdCalculateMaterialInputGrossConsumption(x.NetConsumption,x.ValueLoss,$index)" /></td>
                                        <td><input type="text" class="form-control" ng-model="x.Rejection" style="width: 100px;" /></td>
                                        <td><input type="text" class="form-control" ng-model="x.ValueLoss" style="width: 100px;" ng-blur="grdCalculateMaterialInputGrossConsumption(x.NetConsumption,x.ValueLoss,$index)" /></td>
                                        <td><input type="text" class="form-control" ng-model="x.GrossConsumption" style="width: 100px;" readonly/></td>
                                        <td ng-hide="true"><input type="text" class="form-control" ng-model="x.ResponsiblePersonId" /></td>
                                        <td>
                                            <div class="input-group">
                                                <input type="text" name="Responsible Person" ng-model="x.ResponsiblePerson" class="form-control" readonly style="width:200px;" />
                                                <span class="input-group-btn">
                                                    <button ng-click="showResponsiblePersonListPopUp('Child1',$index)" tabindex="12" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                                    <button ng-click="clearResponsiblePerson()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control" ng-model="x.Remarks" style="width:200px;" /></td>
                                        <td class="text-right table-td" style="vertical-align: middle;">
                                            <ul class="list-inline action-list">
                                                <li><center><button ng-click="removeRowModalMaterial($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></center></li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div id="ByProduct">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top: 0px;">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="AddNewByProductRow();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add By Product</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th ng-hide="true">Id</th>
                                        <th ng-hide="true">JobWorkItemId</th>
                                        <th>Item Name</th>
                                        <th>Item Specification</th>
                                        <th>Item UOM</th>
                                        <th>Percentage Of Input</th>
                                      
                                        <th>Currency</th>
                                        <th>Standard Rate</th>
                                        <th>Responsible Person</th>
                                        <th>Remarks</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in byProductList">
                                        <td ng-hide="true">{{x.Id}}</td>
                                        <td ng-hide="true">{{x.JobWorkItemId}}</td>
                                        <td>
                                            <div class="select-style">
                                                <select name="JobWorkItemId" class="form-control" ng-model="x.JobWorkItemId" ng-options="item.Id as item.UserName for item in materialNameList" ng-change="ChangeByProductMaterial(x.JobWorkItemId,$index)" style="height: 30px;width:200px" tabindex="16"></select>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control" ng-model="x.ItemSpecification" style="width:200px" /></td>
                                        <td><input type="text" class="form-control" ng-model="x.UOM" readonly style="width:100px" /></td>
                                        <td><input type="text" class="form-control" ng-model="x.PercentageOfInput" style="width:100px" /></td>
                                        @*<td><input type="text" class="form-control" ng-model="x.Rejection" style="width:100px" ng-blur="grdCalculateByProductGrossConsumption(x.StandardQty,x.Rejection,x.ValueLoss,$index)" /></td>
                                        <td><input type="text" class="form-control" ng-model="x.ValueLoss" style="width:100px" ng-blur="grdCalculateByProductGrossConsumption(x.StandardQty,x.Rejection,x.ValueLoss,$index)" /></td>
                                        <td><input type="text" class="form-control" ng-model="x.GrossQty" style="width:100px" readonly /></td>*@
                                        <td>
                                            <div class="select-style">
                                                <select class="form-control" name="Currency" ng-model="x.CurrencyId" style="width:200px; height:30px;">
                                                    <option ng-repeat="option in currencyList" value="{{option.Value}}">{{option.Text}}</option>
                                                </select>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control" ng-model="x.StandardRate" style="width:100px" /></td>
                                        <td ng-hide="true"><input type="text" class="form-control" ng-model="x.ResponsiblePersonId" /></td>
                                        <td>
                                            <div class="input-group">
                                                <input type="text" name="Responsible Person" ng-model="x.ResponsiblePerson" class="form-control" readonly style="width:200px" />
                                                <span class="input-group-btn">
                                                    <button ng-click="showResponsiblePersonListPopUp('Child2',$index)" tabindex="12" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                                    <button ng-click="clearResponsiblePerson()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td><input type="text" class="form-control" ng-model="x.Remarks" style="width:200px" /></td>
                                        <td class="text-right table-td" style="vertical-align: middle;">
                                            <ul class="list-inline action-list">
                                                <li><center><button ng-click="removeRowModalProduct($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></center></li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Transformation.Id==''?'Save':'Update'}}</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            <li> <button ng-click="Cancel();" class="btn"><i class="glyphicon glyphicon-remove-circle"></i> Cancel</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <div id="GridData" ej-grid e-datasource="gridDataList" e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowResizing="true"
                 e-allowTextWrap="true"
                 e-allowscrolling="true"
                 e-filtersettings-filterType="excel"
                 e-enabletouch="true" e-responsive="true"
                 e-recorddoubleclick="recorddoubleclick">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                    <div e-column e-field="JobWorkActivityId" e-headertext="Activity Name" e-width="100"></div>
                    <div e-column e-field="JobWorkActivityChildId" e-headertext="Activity Child Name" e-width="150"></div>
                    <div e-column e-field="ItemUOM" e-headertext="Item UOM" e-width="100"></div>
                    <div e-column e-field="RateApplicable" e-headertext="Rate Applicable" e-width="100"></div>
                    <div e-column e-field="Currency" e-headertext="Currency" e-width="100"></div>
                    <div e-column e-field="MinRate" e-headertext="Min Rate" e-width="100"></div>
                    <div e-column e-field="MaxRate" e-headertext="Max Rate" e-width="100"></div>
                    <div e-column e-field="CycleTime" e-headertext="Cycle Time" e-width="100"></div>
                    <div e-column e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="150"></div>
                    <div e-column e-field="ByProductApplicable" e-headertext="By Product Applicable" e-width="100"></div>
                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="200"></div>
                    <div e-column e-template="#GridActions" e-width="75" textAlign='center'></div>
                </div>
            </div>
            <script type="text/template" id="GridActions">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnApprove">
                    <i class="fa fa-pencil" title="Load Data" ng-click="$parent.LoadSelectedData('GridData');" style="margin: -6px;"></i>
                </button>
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnDelete">
                    <i class="fa fa-trash" title="Delete Data" ng-click="$parent.DeleteSelectedData('GridData');" style="margin: -6px;"></i>
                </button>
            </script>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="modalMaterialInput" role="dialog" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content modal-lg">
            <div class="modal-header">Material Input<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row form-elements" ng-form name="materialInputForm">
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <div class="row">
                            <div class="col-sm-12 col-md-4 col-lg-4">
                                <div class="form-group" show-errors>
                                    <label class="control-label" for="ddlMaterialMasterId">
                                        Item Name<sup>*</sup>
                                    </label>
                                    <div class="show-message">
                                        <div class="select-style">
                                            <select name="Item Name" class="form-control" ng-model="MaterialInput.JobWorkItemId" ng-options="item.Id as item.UserName for item in materialNameList" ng-change="ChangePopupMaterialUOM()" style="height: 30px;" tabindex="201" submit-required="true" required></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-4 col-lg-4">
                                <div class="form-group" show-errors>
                                    <label class="control-label" for="txtMaterialSpecification">
                                        Item Specification<sup>*</sup>
                                    </label>
                                    <div class="show-message">
                                        <input type="text" name="Item Specification" class="form-control" ng-model="MaterialInput.ItemSpecification" tabindex="202" required />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-4 col-lg-4">
                                <div class="form-group" show-errors>
                                    <label class="control-label" for="txtInputMaterialUOM">
                                        Item UOM<sup>*</sup>
                                    </label>
                                    <div class="show-message">
                                        <input type="text" name="Item UOM" class="form-control" ng-model="MaterialInput.UOM" tabindex="203" disabled  required/>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-sm-12 col-md-4 col-lg-4">
                                <div class="form-group" show-errors>
                                    <label class="control-label" for="txtNetConsumption">
                                        Net Consumption / Output Unit<sup>*</sup>
                                    </label>
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" name="Net Consumption" class="form-control" ng-model="MaterialInput.NetConsumption" tabindex="204" ng-blur="CalculateMaterialInputGrossConsumption()"  required/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-4 col-lg-4">
                                <div class="form-group" show-errors>
                                    <label class="control-label" for="txtRejection">
                                        Rejection(%)<sup>*</sup>
                                    </label>
                                    <div class="show-message">
                                        <input type="text" name="Rejection" class="form-control" n-decimals="2" ng-model="MaterialInput.Rejection" tabindex="205"  required/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-4 col-lg-4">
                                <div class="form-group" show-errors>
                                    <label class="control-label" for="txtValueLoss">
                                        Value Loss(%)<sup>*</sup>
                                    </label>
                                    <div class="show-message">
                                        <input type="text" name="Value Loss" n-decimals="2" class="form-control" ng-model="MaterialInput.ValueLoss" tabindex="206" ng-blur="CalculateMaterialInputGrossConsumption()"  required/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12 col-md-4 col-lg-4">
                                <div class="form-group" show-errors>
                                    <label class="control-label" for="txtValueLoss">
                                        Gross Consumption<sup>*</sup>
                                    </label>
                                    <div class="show-message">
                                        <input type="text" name="Gross Consumption" n-decimals="2" class="form-control" required ng-model="MaterialInput.GrossConsumption" tabindex="207" readonly/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-4 col-lg-4">
                                <div class="form-group" show-errors>
                                    <label class="control-label" for="MaterialInputResponsiblePersonId">
                                        Responsible Person<sup>*</sup>
