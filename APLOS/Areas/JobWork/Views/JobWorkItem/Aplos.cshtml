<togglable name={{title}}></togglable>
<div style="padding:0px;">
    <div class="form-elements form-horizontal" ng-form name="jobWorkItem">
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtCode">
                        Sequence<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtSequence" name="Sequence" class="form-control" ng-model="JobWorkItem.Sequence" required tabindex="1" />
                        <input type="hidden" id="txtId" name="txtId" ng-model="JobWorkItem.Id" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtCode">
                        Code<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtCode" name="Code" class="form-control" ng-model="JobWorkItem.Code" required tabindex="2" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtShortName">
                        Short Name<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtShortName" name="Short Name" class="form-control" ng-model="JobWorkItem.ShortName" required tabindex="3" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtStandardName">
                        Standard Name<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtStandardName" name="Standard Name" class="form-control" ng-model="JobWorkItem.StandardName" required tabindex="4" />
                    </div>
                </div>
            </div>            
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtUserName">
                        User Define Name<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtUserName" name="User Name" class="form-control" ng-model="JobWorkItem.UserName" required tabindex="5" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <label class="control-label" for="ddlUOM">
                        UOM
                    </label>
                    <div>
                        <div class="select-style">
                            <div class="select-style">
                                <select id="ddlUOM" tabindex="6" class="form-control" submit-required="true" ng-disabled="JobWorkItem.MaterialMasterId!==null" ng-model="JobWorkItem.UOMId" ng-options="item.Id as item.UserName for item in uomList"></select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <label class="control-label" for="chkActive">
                        Active / In-Active
                    </label>
                    <div class="checkbox-site" style="padding-top:5px;">
                        <label>
                            <input id="chkActive" tabindex="7" type="checkbox" ng-checked="true" ng-model="JobWorkItem.IsActive" />
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <div class="row">
                        <label class="col-sm-12 control-label">Responsible Person<sup>*</sup></label>
                        <div class="col-sm-12 show-message">
                            <div class="input-group">
                                <input type="text" name="Responsible Person" ng-model="JobWorkItem.ResponsiblePersonName" class="form-control" readonly required>
                                <input type="hidden" name="EmployeeId" ng-model="JobWorkItem.ResponsiblePersonId" />
                                <span class="input-group-btn">
                                    <button ng-click="ResponsiblePersonListPopUp()" tabindex="8" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="ResponsiblePersonClearDetails()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <div class="row">
                        <label class="col-sm-12 control-label">Material Master</label>
                        <div class="col-sm-12">
                            <div class="input-group">
                                <span class="input-group-addon">{{JobWorkItem.MaterialCode}}</span>
                                <input type="text" ng-model="JobWorkItem.MaterialName" class="form-control" readonly>
                                <input type="hidden" ng-model="JobWorkItem.MaterialMasterId" />
                                <span class="input-group-btn">
                                    <button ng-click="MaterialMstPopUp()" tabindex="8" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="MaterialMstClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <label class="control-label">Remarks</label>
                    <input type="text" name="Remarks" tabindex="9" class="form-control" ng-model="JobWorkItem.Remarks" />
                </div>
            </div>
        </div>
        <div class="common-btn" style="padding-top: 20px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{JobWorkItem.Id==null?'Save':'Update'}}</button></li>
                <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>                
            </ul>
        </div>
    </div>
    <div class="aplos-grid-toggle">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12" style="padding-top: 0px;">
                <div id="GridData" ej-grid e-datasource="gridDataList" e-gridlines="vertical" e-templaterefresh="refreshGridGridElementCode"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-allowsorting="true"
                     e-allowResizing="true"
                     e-allowTextWrap="true"
                     e-allowscrolling="true"
                     e-filtersettings-filterType="excel"
                     e-enabletouch="true" e-responsive="true"
                     e-recorddoubleclick="recorddoubleclick">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-width="100" e-format="{0:n2}"></div>
                        <div e-column e-field="Code" e-headertext="Code" e-width="150"></div>
                        <div e-column e-field="ShortName" e-headertext="Short Name" e-width="150"></div>
                        <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="150"></div>
                        <div e-column e-field="UserName" e-headertext="User Define Name" e-width="150"></div>
                        <div e-column e-field="UOMName" e-headertext="UOM" e-width="150"></div>
                        <div e-column e-field="ResponsiblePersonName" e-headertext="Responsible Person" e-width="150"></div>
                        <div e-column e-field="MaterialCode" e-headertext="Material Code" e-width="120"></div>
                        <div e-column e-field="MaterialName" e-headertext="Material Name" e-width="150"></div>
                        <div e-column e-field="IsActive" e-headertext="Active" e-width="100" e-allowfiltering="false"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="200"></div>
                        <div e-column e-template="#GridActions" e-width="75" textAlign='center'></div>
                    </div>
                </div>
                <script type="text/template" id="GridActions">
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnApprove">
                        <i class="fa fa-pencil" title="Load Data" ng-click="$parent.LoadSelectedData('GridData');" style="margin: -6px;"></i>
                    </button>
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnDelete">
                        <i class="fa fa-trash" title="Delete Data" ng-click="$parent.DeleteSelectedData('GridData');" style="margin: -6px;"></i>
                    </button>
                </script>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Employees/Views/Shared/_ResponsiblePersonPopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterByTypePopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterArticleSearchPopUp.cshtml")
<confirm-modal></confirm-modal>
