<div class="form-horizontal form-elements" ng-form="productNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">PO Basic Info</legend>
        <div class="row">
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Order Specific</label>
                    <div class="col-sm-6">
                        <div class="radio">
                            <label>
                                <input type="radio" name="OrderSpecific" ng-model="productNew.OrderSpecific" value="No" ng-click="hide();ClearList('No');" ng-disabled="productNew.Id.length>0">
                                <span class="cr"><i class="cr-icon"></i></span>No
                            </label>
                            <label>
                                <input type="radio" name="OrderSpecific" ng-model="productNew.OrderSpecific" value="Yes" ng-click="show();ClearList('Yes');" ng-disabled="productNew.Id.length>0">
                                <span class="cr"><i class="cr-icon"></i></span>Yes
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group" id="div_grnNo">
                    <label class="col-sm-4 control-label">PO No<sup>*</sup></label>
                    <div class="col-sm-8 show-message ">
                        <input type="text" name="PO No" ng-model="productNew.Id" class="form-control" maxlength="10" disabled>
                    </div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group" id="div_PODate">
