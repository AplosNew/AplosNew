<style>

    .filled {
        background-color: #ff0000 !important;
    }
</style>
@*To Accept only Numbers with decimals*@
<script>

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }
</script>
<h3>Register</h3>
<div class="row">
    <div ng-form name="GeneralForm" class="form-elements form-horizontal">
        <input type="hidden" ng-model="Register.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Date" ng-model="Register.FromDate" ng-disabled="TransDisable" datepicker class="form-control" required tabindex="2">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label" title="Vendor/ Party"><span>Vendor/ Party</span></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon">{{Register.PartyVendorCode}}</span>
                    <input type="text" ng-model="Register.PartyVendorName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="PartyVendorPopUp()" ng-disabled="TransDisable" tabindex="2" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="PartyVendorClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>


        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Date" ng-model="Register.ToDate" ng-disabled="TransDisable" datepicker class="form-control" required tabindex="2">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label" title="Vendor/ Party"><span>Contract</span></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon">{{Register.ContractId}}</span>
                    <input type="text" ng-model="Register.ContractDate" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="ContractPopUpShow()" ng-disabled="TransDisable" tabindex="2" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="ContractDataClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>

        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Generate();" class="btn" tabindex="5"><i class="glyphicon glyphicon-floppy-disk"></i>Generate</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="7"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>

</div>

<confirm-modal></confirm-modal>

<div class="modal fade site-modal in" id="PartyVendorPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg modellgModify">
            <div class="modal-content">
                <div class="modal-header"> Vendor/ Party List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body form-elements form-horizontal">
                    <div class="col-md-12">
                        <div class="content-container-fluid" style="color:black;overflow:scroll">
                            <div style="color:black;" id="GridPartyVendor" ej-grid e-datasource="PartyVendorList"
                                 e-allowfiltering="true" e-recorddoubleclick="setPartyVendorData" e-allowpaging="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                                <div e-columns>
                                    <div e-column e-type="string" e-field="Sequence" e-headertext="Sequence" e-width="40"></div>
                                    <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                                    <div e-column e-type="string" e-field="ShortName" e-headertext="ShortName" e-width="40"></div>
                                    <div e-column e-type="string" e-field="StandardName" e-headertext="StandardName" e-width="40"></div>
                                    <div e-column e-type="string" e-field="UserName" e-headertext="Party" e-width="40"></div>
                                    <div e-column e-type="string" e-field="PartyGroup" e-headertext="Party Group" e-width="40"></div>

                                </div>

                            </div>

                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li>

                                <button ng-click="closePartyVendorPopUp('PartyVendorPopUp');" class="btn"><i class=""></i> Close</button>
                            </li>
                        </ul>

                    </div>
                </div>
            </div>
        </div>

    </div>

<div class="modal fade site-modal in" id="ContractPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> PO List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridContract" ej-grid e-datasource="ContractList"
                             e-allowfiltering="true" e-recorddoubleclick="setContractData" e-allowpaging="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="PO Number" e-width="40"></div>
                                <div e-column e-type="string" e-field="ContractDate" e-headertext="PO Date" e-width="40"></div>
                                <div e-column e-type="string" e-field="POType" e-headertext="PO Type" e-width="40"></div>
                                <div e-column e-type="string" e-field="Plant" e-headertext="Plant" e-width="40"></div>
                                <div e-column e-type="string" e-field="Entity" e-headertext="Entity" e-width="40"></div>
                                <div e-column e-type="string" e-field="Party" e-headertext="Party" e-width="40"></div>
                                <div e-column e-type="string" e-field="ContractProStartDate" e-headertext="Process Start Date" e-width="40"></div>
                                <div e-column e-type="string" e-field="ContractProEndDate" e-headertext="Process End Date" e-width="40"></div>
                                <div e-column e-type="string" e-field="ContractCloseDate" e-headertext="Contract Close Date" e-width="40"></div>

                            </div>

                        </div>

                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>

                            <button ng-click="closeContractPopUp('ContractPopUp');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>

</div>
