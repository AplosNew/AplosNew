                                    <input type="number" ng-model="ModelNewByProdcuct.ValueLoss" name="ValueLoss" ng-change="GrossConsumptionByProduct()" required class="form-control" tabindex="6" >
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Gross Qty / Input Unit<sup>*</sup></label>
