                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Standard Rate / Unit<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" name="Standard Rate/ Unit" ng-model="ModelNewByProdcuct.StandardRateORUnit" class="form-control" required tabindex="6" maxlength="10">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Currency <sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" name="Currency" required ng-model="ModelNewByProdcuct.CurrencyId">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in currencyList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Responsible Person<sup></sup></label>
                                <div class="col-sm-8 ">
                                    <div class="input-group">
                                        <input type="text" name="Responsible Person" ng-model="ModelNewByProdcuct.ResponsiblePersonName" class="form-control" readonly>
                                        <input type="hidden" name="EmployeeId" ng-model="ModelNewByProdcuct.ResponsiblePersonId" />
                                        <span class="input-group-btn">
                                            <button ng-click="showAllEmployeeListPopUp()" tabindex="8" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                            <button ng-click="closeResponsiblePersonPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="ModelNewByProdcuct.Remarks" maxlength="250" tabindex="6"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="saveByProduct();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{byProductAction}}</button></li>
                            <li> <button data-toggle="modal" ng-click="DeleteByPrduct()" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            <li> <button ng-click="byProductClear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer common-btn">
                    <button ng-click="closeByProductPOPUP();" class="btn"><i class=""></i> Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="materialMasterbyTypePopupNew" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                JW Item  List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
