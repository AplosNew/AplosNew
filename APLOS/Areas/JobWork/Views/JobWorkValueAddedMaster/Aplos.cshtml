<togglable name={{title}}></togglable>
<div class="form-elements form-horizontal" ng-form name="jobWorkValueAddedMaster">
    <div class="row">
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlJobWorkActivityId">
                    Job Work Activity<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <div class="select-style">
                            <select id="ddlJobWorkActivityId" name="Job Work Activity" tabindex="1" ng-disabled="DisableJWActivity" class="form-control" submit-required="true" ng-model="ValueAdded.JobWorkActivityId" ng-options="item.Id as item.UserName for item in jobWorkActivityList" required ng-change="getActivityChildItems()"></select>
                        </div>
                    </div>
                    <input type="hidden" id="txtId" name="Id" class="form-control" ng-model="ValueAdded.Id" tabindex="0" />
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlType">
                    Activity Item<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <div class="select-style">
                            <select id="ddlType" name="Type" tabindex="3" class="form-control" submit-required="true" ng-model="ValueAdded.JobWorkActivityChildId" ng-options="item.Id as item.UserName for item in activityChildItemsList" required ng-change="getJobWorkItemUOM()"></select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlMaterialUOM">
                    Item UOM<sup>*</sup>
                </label>
                <div class="show-message">
                    <input type="text" name="Material UOM" tabindex="5" n-decimals="2" class="form-control" ng-model="ValueAdded.MaterialUOMId" readonly />
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group">
                <div class="row">
                    <label class="col-sm-12 control-label">Material Master</label>
                    <div class="col-sm-12">
                        <div class="input-group">
                            <span class="input-group-addon">{{ValueAdded.MaterialCode}}</span>
                            <input type="text" ng-model="ValueAdded.MaterialName" class="form-control" readonly>
                            <input type="hidden" ng-model="ValueAdded.MaterialMasterId" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

      
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label">Std Rejection(%) <sup>*</sup></label>
                <div class="show-message">
                    <input type="text" name="Std Rejection" tabindex="5" n-decimals="2" class="form-control" ng-model="ValueAdded.StdRejection" />
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label">Std Value Loss(%)<sup>*</sup></label>
                <div class="show-message">
                    <input type="text" name="Std Value Loss" tabindex="6" n-decimals="2" class="form-control" ng-model="ValueAdded.StdValueLoss" />
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlRateApplicable">
                    Rate Applicable<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <div class="select-style">
                            <select id="ddlRateApplicable" name="Rate Applicable" tabindex="7" class="form-control" submit-required="true" ng-model="ValueAdded.RateApplicable" ng-options="item.name as item.name for item in rateApplicableList" required></select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlCurrency">
                    Currency<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <div class="select-style">
                            <select id="ddlCurrency" name="Currency" tabindex="8" class="form-control" ng-model="ValueAdded.CurrencyId" submit-required="true" required>
                                <option ng-repeat="option in currencyList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="row">
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group">
                <label class="control-label">Min Rate</label>
                <input type="text" name="Min Rate" tabindex="9" class="form-control" n-decimals="2" ng-model="ValueAdded.MinRate" />
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group">
                <label class="control-label">Max Rate</label>
                <input type="text" name="Max Rate" tabindex="10" class="form-control" n-decimals="2" ng-model="ValueAdded.MaxRate" />
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group">
                <label class="control-label">Cycle Time(Days)</label>
                <input type="text" name="Cycle Time" tabindex="11" class="form-control" n-decimals="2" ng-model="ValueAdded.CycleTime" />
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group">
                <div class="row">
                    <label class="col-sm-12 control-label">Responsible Person</label>
                    <div class="col-sm-12">
                        <div class="input-group">
                            <input type="text" name="Responsible Person" ng-model="ValueAdded.ResponsiblePerson" class="form-control" readonly />
                            <input type="hidden" name="EmployeeId" ng-model="ValueAdded.ResponsiblePersonId" />
                            <span class="input-group-btn">
                                <button ng-click="showResponsiblePersonListPopUp()" tabindex="12" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                <button ng-click="clearResponsiblePerson()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="row">
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group">
                <label class="control-label">Remarks</label>
                <input type="text" name="Remarks" tabindex="13" class="form-control" ng-model="ValueAdded.Remarks" />
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-12 control-label">Process<sup>*</sup></label>
            <div class="col-sm-12">
                <input id="ddlProcess" ej-dropdownlist e-create="create" e-headertemplate='<input class="temp" type="checkbox" id="checkBox" />' e-multiselectmode="visualmode" e-datasource="processList" e-fields-value="Id" e-fields-text="UserName" e-width="100%" e-showcheckbox="true" />
            </div>
        </div>
    </div>
    <div class="common-btn" style="padding-top:20px;">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ValueAdded.Id==''?'Save':'Update'}}</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            <li> <button ng-click="Cancel();" class="btn"><i class="glyphicon glyphicon-remove-circle"></i> Cancel</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <div id="GridData" ej-grid e-datasource="gridDataList" e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowResizing="true"
                 e-allowTextWrap="true"
                 e-allowscrolling="true"
                 e-filtersettings-filterType="excel"
                 e-enabletouch="true" e-responsive="true"
                 e-recorddoubleclick="recorddoubleclick">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                    <div e-column e-field="JobWorkActivityId" e-headertext="Activity Name" e-width="150"></div>
                    <div e-column e-field="JobWorkActivityChildId" e-headertext="Activity Child" e-width="150"></div>
                    <div e-column e-field="StdRejection" e-headertext="Std Rejection" e-width="100"></div>
                    <div e-column e-field="StdValueLoss" e-headertext="Std Value Loss" e-width="100"></div>
                    <div e-column e-field="RateApplicable" e-headertext="Rate Applicable" e-width="100"></div>
                    <div e-column e-field="Currency" e-headertext="Currency" e-width="100"></div>
                    <div e-column e-field="MinRate" e-headertext="Min Rate" e-width="100"></div>
                    <div e-column e-field="MaxRate" e-headertext="Max Rate" e-width="100"></div>
                    <div e-column e-field="CycleTime" e-headertext="Cycle Time" e-width="100"></div>
                    <div e-column e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="150"></div>
                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="200"></div>
                    <div e-column e-template="#GridActions" e-width="75" textAlign='center'></div>
                </div>
            </div>
            <script type="text/template" id="GridActions">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnApprove">
                    <i class="fa fa-pencil" title="Load Data" ng-click="$parent.LoadSelectedData('GridData');" style="margin: -6px;"></i>
                </button>
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnDelete">
                    <i class="fa fa-trash" title="Delete Data" ng-click="$parent.DeleteSelectedData('GridData');" style="margin: -6px;"></i>
                </button>
            </script>
        </div>
    </div>
</div>
@Html.Partial("~/Areas/Employees/Views/Shared/_ResponsiblePersonPopUp.cshtml")
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="removerPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="removeChildRow()"></confirm-archive-generic>

