<h3 class="site-heading" id="hhhh">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Leave Approval
</h3>
<div style="color:black;" id="Grid" ej-grid e-datasource="AvailedLvDetails" e-templaterefresh="refreshTemplateemployee"
     e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
     e-recorddoubleclick="SelectLvDetails" e-allowselection="true" e-filtersettings-filterType="excel">
    <div e-columns>
        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
        @*<div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>*@
        <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="80"></div>
        <div e-column e-field="EmployeeName" e-headertext="Name" e-width="80"></div>
        <div e-column e-field="GivenDesignation" e-headertext="Designation" e-width="80"></div>
        <div e-column e-field="Entity" e-headertext="Entity" e-width="80"></div>
        <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>
        <div e-column e-field="LeaveAppliedDate" e-headertext="Leave Applied Date" e-width="110"></div>
        <div e-column e-field="LeaveName" e-headertext="Leave" e-width="80"></div>
        <div e-column e-field="FromDate" e-headertext="From Date" e-width="80"></div>
        <div e-column e-field="ToDate" e-headertext="To Date" e-width="80"></div>
        <div e-column e-field="LeaveDays" e-headertext="Leave Days" e-width="80"></div>
        <div e-column e-headertext="Actions" e-width="60">
            <button style="color: #f3f3ec;background-color: #1c1f32;height: 32px;" class="btn" ng-click="$parent.SelectLvDetails($event);"> Details</button>
        </div>

    </div>
</div>

<script type="text/template" id="checkboxTemplate">
    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
</script>
<script type="text/x-jsrender" id="headerTemplate">
    <input type="checkbox" id="headchk" />
</script>
<div class="common-btn">
    <ul class="list-inline text-right">
        <li><button ng-click="SavelvApproval();" class="btn"><i class="glyphicon glyphicon-saved" tabindex="9"></i> Approve</button></li>
        <li><button ng-click="GetdialogCancelationReason();" class="btn"><i class="glyphicon glyphicon-remove" tabindex="9"></i> Reject</button></li>

    </ul>
</div>


<ej-dialog id="dialogLvDetails"
           title=" Leave Approval"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#hhhh"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="300" e-open="enableBtn">
    <div class="row">

        <div class="col-xs-12 col-sm-12 col-md-12">
            @*<div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Leave Name</th>
                        <th>Brought Forward</th>
                        <th>Current Year Allocation</th>
                        <th>Leave Days Allowed</th>
                        <th>Applied</th>
                        <th>Availed</th>
                        <th>Encashed</th>
                        <th>Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in LeaveBalanceList">
                        <td>{{x.LeaveName}}</td>
                        <td>{{x.BroughtForward}}</td>
                        <td>{{x.CurrentAllocation}}</td>
                        <td>{{x.LeaveDays}}</td>
                        <td>{{x.Applied}}</td>
                        <td>{{x.Availed}}</td>
                        <td>{{x.EncashedInbetween}}</td>
                        <td>{{x.Balance}}</td>
                    </tr>
                </tbody>
            </table>
        </div>*@
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Leave Name</th>
                            <th>Brought Forward</th>
                            <th>Earned</th>
                            <th>Current Year Allocation</th>
                            <th>Leave Days Allowed</th>
                            <th>Applied</th>
                            <th>Availed</th>
                            <th>Encashed</th>
                            <th>Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in LeaveBalanceList">
                            <td>{{x.LeaveName}}</td>
                            <td>{{x.BroughtForward}}</td>
                            <td>{{x.Earned}}</td>
                            <td>{{x.CurrentAllocation}}</td>
                            <td>{{x.LeaveDays}}</td>
                            <td>{{x.Applied}}</td>
                            <td>{{x.Availed}}</td>
                            <td>{{x.EncashedInbetween}}</td>
                            <td>{{x.Balance}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            @*<label ng-model="leaveApplicationNew.ExceptionLeave">You are taking  exception  leave  </label>*@
        </div>
    </div>

</ej-dialog>


<ej-dialog id="dialogCancelationReason"
           title=" Cancelation Reason"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#hhhh"
           e-close="onDialogClose"
           e-minwidth="60%"
           e-minheight="200" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="form-group">              
                <div class="col-sm-12">
                    <textarea maxlength="250" name="Description" placeholder="Write here....." class="form-control" rows="3" ng-model="CancelationReason"  tabindex="7"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <br />
            <div class="common-btn">
                <ul class="list-inline text-right">

                    <li><button ng-click="Reject();" class="btn"><i class="glyphicon glyphicon-remove" tabindex="9"></i> Reject</button></li>
                    <li><button ng-click="Cancel();" class="btn"><i class="glyphicon glyphicon-saved" tabindex="9"></i> Cancel</button></li>

                </ul>
            </div>

        </div>
    </div>

</ej-dialog>

