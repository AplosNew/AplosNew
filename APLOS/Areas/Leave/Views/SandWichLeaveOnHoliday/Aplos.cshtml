<h3>Sandwich Leave On Holiday</h3>

<div class="form-elements form-horizontal" ng-form name="SandwichLeaveOnHoliday">
    <div class="row">


        <div class="col-xs-4">
            <div class="form-group" id="div_FromDate">
                <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-7 show-message">
                    <input type="text" name="From Date" ng-model="ModelNew.FromDate" datepicker class="form-control" required>
                </div>
            </div>
        </div>

        <div class="col-xs-4">
            <div class="form-group" id="div_ToDate">
                <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-7 show-message">
                    <input type="text" name="To Date" ng-model="ModelNew.ToDate" datepicker class="form-control" required>
                </div>
            </div>
       </div>


            @*<div class="clearfix"></div>*@
            <div class="col-xs-4">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Process</button></li>
