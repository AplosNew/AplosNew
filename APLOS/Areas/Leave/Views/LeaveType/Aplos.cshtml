<togglable name="Leave Type"></togglable>
<div class="form-elements form-horizontal" ng-form name="LeaveTypeForm" id="MainDivId">
    <div class="form-elements form-horizontal" ng-form id="LeaveTypeFormFormId" name="LeaveTypeForm">

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="LeaveTypeModel.Sequence" e-width="100" required />
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Leave Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="LeaveTypeModel.UserName" class="form-control" required tabindex="7" maxlength="50">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="LeaveTypeModel.Description" tabindex="9" maxlength="250"></textarea>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="LeaveTypeModel.Code" class="form-control" required tabindex="4" maxlength="10">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Leave Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="LeaveTypeID" class="form-control" ng-model="LeaveTypeModel.LeaveType" name="Leave Type" required tabindex="1">
                            <option value="">-Select-</option>
                            <option Value="General">General</option>
                            <option Value="Earn">Earn</option>
                            <option Value="Maternity">Maternity</option>
                            <option Value="Company Assigned">Company Assigned</option>
                            <option Value="Leave Without Pay">Leave Without Pay</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="LeaveTypeModel.Remarks" maxlength="250" tabindex="8"></textarea>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Is ESIC Applicable</label>
                <div class="col-sm-8">
                    <div class="checkbox-site" style="margin-top: 6px;">
                        <label>
                            <input type="checkbox" ng-model="LeaveTypeModel.IsESIC">
                            <span class="cr" tabindex="10"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Is General</label>
                <div class="col-sm-8">
                    <div class="checkbox-site" style="margin-top: 6px;">
                        <label>
                            <input type="checkbox" ng-model="LeaveTypeModel.IsGeneral">
                            <span class="cr" tabindex="10"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i></button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="12"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="13"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>

    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div style="color:black;" id="GridMaster" ej-grid e-datasource="ModelList"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
             e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="70"></div>
                <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                <div e-column e-field="UserName" e-headertext="UserName" e-width="80"></div>
                <div e-column e-field="IsESICS" e-headertext="IsESICS" e-width="80"></div>
                <div e-column e-field="IsGenerals" e-headertext="IsGenerals" e-width="80"></div>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>
