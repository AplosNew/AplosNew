<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>{{FormTitle}}
</h3>
<div class="form-elements form-horizontal" ng-form name="OnDutyForm" id="OnDutyForm">
    <div class="row">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">From Date</label>
                <div class="col-sm-8">
                    <input type="text" name="Form Date" required e-dateformat="dd-MMM-yyyy" ng-model="FromDate" datepicker class="form-control">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">To Date</label>
                <div class="col-sm-8">
                    <input type="text" name="To Date" required e-dateformat="dd-MMM-yyyy" ng-model="ToDate" datepicker class="form-control" ng-change="">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="ReportForEarnLeave();" class="btn"><i class="glyphicon glyphicon-download-alt"></i> Report</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>



