<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Off Duty Hours
</h3>
<div class="form-elements form-horizontal" ng-form name="OffDutyHoursForm">
    <div class="row">
        <div class="clearfix"></div>
        <input type="hidden" ng-model="maternityLeaveTransactionNew.Id">

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Employee Select<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <span class="input-group-addon">{{employeeInfo.EmployeeCode}}</span>
                        <input type="text" name="EmployeeName" ng-model="employeeInfo.EmployeeName" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="GetEmployeeDeleteInfo()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Employee DOJ :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.DOJ}}</label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Employee DOC :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.DOC}}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label"> Designation :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.LegalDesignation}}</label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Department :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.Department}}</label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Section :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.Section}}</label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">SubSection :</label>
                <div class="col-sm-8">
                    <label>{{employeeInfo.SubSection}}</label>
                </div>
            </div>

            <div class="form-group" show-errors id="div_FromDate">
                <label class="col-sm-4 control-label">From Time</label>
                <div class="col-sm-8">
                    <input type="text" ej-datetimepicker e-width="50%" e-datetimeformat="dd-MMM-yyyy hh:mm tt" e-change="ChangeDatedoublefunction" e-value="OffDutyHoursModel.FromDate" />
                </div>
            </div>

          

            <div class="form-group">
                <label class="col-sm-4 control-label">Duration(Min) :</label>
                <div class="col-sm-4">
                    <input type="text" name="User Name" ng-model="OffDutyHoursModel.DurationInMin" class="form-control" ng-change="ChangeDuration()" only-numbers tabindex="2" maxlength="10">
                </div>
            </div>

            <div class="form-group" id="div_FromDate">
                <label class="col-sm-4 control-label">To Time</label>
                <div class="col-sm-8 show-message">
                    <label>{{OffDutyHoursModel.ToDate |date:'dd-MMM-yyyy h:mma' }}</label>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Leave Reason<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="LeaveTypeID" class="form-control" ng-model="OffDutyHoursModel.HourlyLeaveReasonId" name="Leave Type" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in leaveTypelist" value="{{option.Id}}">{{option.UserName}}</option>
                        </select>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <div class="col-sm-8">
                    <div>
                        <img id="uploadImageSrc" ng-src="{{employeeInfo.EmpPic}}" style="margin-left: 180px; border: 1px solid; height: 200px; width: 200px;" />
                    </div>
                </div>
            </div>

            <div>
                <br />
                <br />
            </div>
         
                <div class="form-group" show-errors id="div_FromDate">
                    <label class="col-sm-3 control-label">Work Date</label>
                    <div class="col-sm-8">
                        <input type="text" ej-datepicker e-width="50%" e-dateformat="dd-MMM-yyyy" e-change="changeshiftInfo" e-value="OffDutyHoursModel.WorkDate" />
                        @*<input type="text" name="Work Date" placeholder="dd-MM-yyyy" ng-model="OffDutyHoursModel.WorkDate" datepicker class="form-control" tabindex="1">*@
                    </div>
                </div>

                <div class="col-xs-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Shift Name :</label>
                        <div class="col-sm-8" style="margin-top: 6px;">
                            <label>{{GetShiftList.UserName}}</label>
                        </div>
                    </div>
                </div>

                <div class="col-xs-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Day Status:</label>
                        <div class="col-sm-8" style="margin-top: 6px;">
                            <label>{{GetShiftList.DayStatus}}</label>
                        </div>
                    </div>
                </div>

                <div class="col-xs-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">In Time:</label>
                        <div class="col-sm-8" style="margin-top: 6px;">
                            <label>{{GetShiftList.InTime}}</label>
                        </div>
                    </div>
                </div>

                <div class="col-xs-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Out Time :</label>
                        <div class="col-sm-8" style="margin-top: 6px;">
                            <label>{{GetShiftList.OutTime}}</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="clearfix"></div>
            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear(LeavePolicyModel); getListData();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>

            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="Grid" ej-grid e-datasource="GetOffDutyList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="WorkDate" e-headertext="Work Date" e-width="60"></div>
                            <div e-column e-field="FromDate" e-headertext="From Time" e-width="80"></div>
                            <div e-column e-field="ToDate" e-headertext="To Time" e-width="60"></div>
                            <div e-column e-field="DurationInMin" e-headertext="Duration(Min)" e-width="60"></div>
                            <div e-column e-field="IsApprove" e-headertext="IsApprove" e-width="60"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
</div>

<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>

<div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridEmp" ej-grid e-datasource="dataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SetData" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>
