        </div>
    </div>
</div>




<ej-dialog id="dialogAction"
           title="Action"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target=".site-heading"
           e-close="onDialogClose"
           e-minwidth="90%"
           e-minheight="50"
           e-open="enableBtn">

    <div class="row form-group form-elements form-horizontal">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="form-group">
                <label class="col-sm-4 control-label">Leave Reason<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="LeaveTypeID" class="form-control" ng-model="ApproveModel.HourlyLeaveReasonId" name="Leave Type" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in HourlyLeaveReasonIdList" value="{{option.Id}}">{{option.UserName}}</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Duration</label>
                <div class="col-sm-8 show-message">
                    <input type="text" class="form-control" ng-model="ApproveModel.Duration" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Approve Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="ApproveTypeId" class="form-control" ng-model="ApproveModel.ApproveType" ng-change="ApproveTypeChange()" name="Leave Type" required tabindex="1">
                            @*<option value="">--Select--</option>*@
                            <option ng-repeat="option in ApproveTypeList" value="{{option.Text}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Leave Type</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="LeaveTypeID" class="form-control" ng-model="ApproveModel.LeaveTypeId" name="Leave Type" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in LeaveTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">

        <ul class="list-inline text-right">

            @*<li> <button ng-click="DownloadOutPunchMissingDataForAlert()" class="btn"><i class="glyphicon glyphicon-check"></i> Download Data</button></li>*@
            <li> <button ng-click="TakeAction()" class="btn"><i class="glyphicon glyphicon-check"></i> Take Action </button></li>
        </ul>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">



        </div>
    </div>

</ej-dialog>

