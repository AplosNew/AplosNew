<togglable name="Leave Policy"></togglable>
<div class="form-horizontal" ng-form id="leavePolicyFormId" name="leavePolicyForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-right: 107px;">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="LeavePolicyModel.CompanyId" ng-change="companyOnChange();"
                                ng-options="item.Value as item.Text for item in companyList" id="plantId" ng-disabled="LeavePolicyModel.SystemID != null"
                                name="Company" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-right: 107px;">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="LeavePolicyModel.PlantID"
                                ng-options="item.Value as item.Text for item in plantList" ng-disabled="LeavePolicyModel.SystemID != null" id="plantId" ng-change="getListData()"
                                name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-elements ">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group">
                    <label class="col-sm-4 control-label">Code</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="LeavePolicyModel.PolicyCode" class="form-control" maxlength="30" tabindex="2">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Policy Name</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="LeavePolicyModel.PolicyName" class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Default</label>
                    <div class="col-sm-9">
                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="LeavePolicyModel.DefaultPolicy">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear(LeavePolicyModel); getListData();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                    <ul class="list-inline text-left">
                        <li><button ng-click="AddLineIdem();" ng-disabled="LeavePolicyModel.SystemID==null" class="btn"><i class="glyphicon glyphicon-plus"></i>Add Line Item</button></li>
                    </ul>
                </div>
            </div>

            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div style="color:black;" id="DetailsABC" ej-grid e-datasource="LeavePolicyDetailsList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-recorddoubleclick="recorddoubleclickDetails" e-filtersettings-filterType="excel">
                    <div e-columns>

                        <div e-column e-field="UserName" e-headertext="User Name" e-width="70"></div>
                        <div e-column e-field="Description" e-headertext="Description" e-width="80"></div>
                        <div e-column e-field="LeaveDays" e-headertext="Leave Days" e-width="60"></div>
                        <div e-column e-field="CarryForwardDay" e-headertext="Carry Forward Day" e-width="60"></div>
                        <div e-column e-field="CarryForwardCumulative " e-headertext="Carry Forward Cumulative" e-width="60"></div>
                        <div e-column e-field="MaxEncashment" e-headertext="Max Encashment" e-width="60"></div>
                        <div e-column e-field="MaxEncashmentLapse" e-headertext="Max Encashment Lapse" e-width="60"></div>

                    </div>
                </div>
            </div>

        </div>

    </div>

    <div class="row text-right aplos-grid-toggle">

        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;" id="GridLeavePolicy" ej-grid e-datasource="LeavePolicyList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                <div e-columns>

                    <div e-column e-field="PolicyCode" e-headertext="Policy Code" e-width="70"></div>
                    <div e-column e-field="PolicyName" e-headertext="Policy Name" e-width="80"></div>
                    <div e-column e-field="Policy" e-headertext="Default Policy" e-width="60"></div>
                    <div e-column e-field="DateAdded" e-headertext="DateAdded" e-width="60"></div>

                </div>
            </div>
        </div>

    </div>
</div>

<ej-dialog id="dialogEmployeeInfo"
           title="Leave Policy Detail"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#leavePolicyFormId"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="500" e-open="enableBtn">
    <div class="row">


        <div class="col-xs-12 col-sm-12 col-sm-12">

            <div class="col-xs-12 form-element-ctrl form-horizontal" ng-show="ShowDiv">

                <div class="col-xs-12 ">

                    <div class="col-sm-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" style="color:red">System ID</label>
                            <label class="col-sm-8 control-label">: {{LeavePolicyModelDetails.SystemID}}</label>
                        </div>
                    </div>


                    <div class="col-md-4 ">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" style="color:red">Leave Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="LeaveTypeID" class="form-control" ng-change="ShowEarnLeavePolicy()" ng-model="LeavePolicyModelDetails.LTSystemID" name="Leave Type" required tabindex="1">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in leaveTypelist" value="{{option.Id}}">{{option.UserName}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label" style="color:red">Days</label>
                                <div class="col-sm-4">
                                    <input type="text" ng-model="LeavePolicyModelDetails.LeaveDays" class="form-control" maxlength="100" only-numbers tabindex="2">
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-xs-12 ">

                    <div class="col-xs-12 col-sm-6 col-md-6 ">
                        <fieldset class="scheduler-border">
                            <legend class="scheduler-border">Week Off</legend>


                            <div class="col-xs-12 col-sm-6 col-md-6">
                                @*<div class="form-group">
                                    <label class="col-sm-8 control-label">In Between Week Off </label>
                                    <div class="col-sm-4">
                                        <div class="checkbox-site" style="margin-top: 6px;">
                                            <label>
                                                <input tabindex="8" type="checkbox" ng-model="LeavePolicyModelDetails.InBetweenWeekoff">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>*@

                                <div class="checkbox-site radio">
                                    <label>
                                        <input type="checkbox" name="Formula" ng-model="LeavePolicyModelDetails.InBetweenWeekoff" ng-change="setRadioInBetweenWeekoff()">
                                        <span class="cr"><i class="cr-icon"></i></span>In Between Weekoff
                                    </label>
                                </div>
                                <div class="checkbox-site radio">
                                    <label>
                                        <input type="checkbox" name="Formula" ng-model="LeavePolicyModelDetails.IsAsperEntryOnW" ng-change="setRadioIsAsperEntryOnW()">
                                        <span class="cr"><i class="cr-icon"></i></span>As Per Entry On Weekoff
                                    </label>
                                </div>
                                <div class="checkbox-site radio">
                                    <label>
                                        <input type="checkbox" name="Formula" ng-model="LeavePolicyModelDetails.IsNoLeaveOnW" ng-change="setRadioIsNoLeaveOnW()">
                                        <span class="cr"><i class="cr-icon"></i></span>No Leave On Weekoff
                                    </label>
                                </div>
                            </div>


                            @*<div class="col-xs-12 col-sm-6 col-md-6 ">
                                    <div class="form-group">
                                        <label class="col-sm-8 control-label">Succeeding Week Off</label>
                                        <div class="col-sm-4">
                                            <div class="checkbox-site" style="margin-top: 10px;">
                                                <label>
                                                    <input tabindex="1" type="checkbox" ng-model="LeavePolicyModelDetails.IsSucceedignWeekoff">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>*@

                        </fieldset>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 ">
                        <fieldset class="scheduler-border">
                            <legend class="scheduler-border">Holiday</legend>

                            <div class="col-xs-12 col-sm-6 col-md-6 ">

                                @*<div class="form-group">
                                    <label class="col-sm-8 control-label">In Between Holiday</label>
                                    <div class="col-sm-4">
                                        <div class="checkbox-site" style="margin-top: 6px;">
                                            <label>
                                                <input tabindex="8" type="checkbox" ng-model="LeavePolicyModelDetails.InBetweenHoliday">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>*@
                                <div class="checkbox-site radio">
                                    <label>
                                        <input type="checkbox" name="Formula" ng-model="LeavePolicyModelDetails.InBetweenHoliday" ng-change="setRadioInBetweenHoliday()">
                                        <span class="cr"><i class="cr-icon"></i></span>In Between Holiday
                                    </label>
                                </div>
                                <div class="checkbox-site radio">
                                    <label>
                                        <input type="checkbox" name="Formula" ng-model="LeavePolicyModelDetails.IsAsperEntryOnH" ng-change="setRadioIsAsperEntryOnH()">
                                        <span class="cr"><i class="cr-icon"></i></span>As Per Entry On Holiday
                                    </label>
                                </div>
                                <div class="checkbox-site radio">
                                    <label>
                                        <input type="checkbox" name="Formula" ng-model="LeavePolicyModelDetails.IsNoLeaveOnH" ng-change="setRadioIsNoLeaveOnH()">
                                        <span class="cr"><i class="cr-icon"></i></span>No Leave On Holiday
                                    </label>
                                </div>
                            </div>

                            @*<div class="col-xs-12 col-sm-6 col-md-6 ">
                                    <div class="form-group">
                                        <label class="col-sm-8 control-label">Succeeding Holiday</label>
                                        <div class="col-sm-4">
                                            <div class="checkbox-site" style="margin-top: 6px;">
                                                <label>
                                                    <input tabindex="8" type="checkbox" ng-model="LeavePolicyModelDetails.IsSucceedignHoliday">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>*@

                        </fieldset>
                    </div>

                </div>

                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Avail</legend>

                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" ng-show="!EarnLeaveVar">
                                <label class="col-sm-8 control-label">Current year (Pro rata)</label>
                                <div class="col-sm-4" style="margin-top: 6px;">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="1" type="checkbox" ng-model="LeavePolicyModelDetails.IsProratacurrentyear" @*ng-change="setVisible();"*@>
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-4 col-md-4  col-md-4" ng-show="LeavePolicyModelDetails.IsProratacurrentyear === true && !EarnLeaveVar">
                            <div class="form-group">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="IsProrataMonthlyColu" ng-model="LeavePolicyModelDetails.IsProrataMonthly" value="true">
                                        <span class="cr"><i class="cr-icon"></i></span>Monthly
                                    </label>
                                    <label>
                                        <input type="radio" name="IsProrataMonthlyColu" ng-model="LeavePolicyModelDetails.IsProrataMonthly" value="false">
                                        <span class="cr"><i class="cr-icon"></i></span>Daily
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label class="col-sm-6 control-label">Is Post Application Allowed</label>
                                <div class="col-sm-6">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="8" type="checkbox" ng-model="LeavePolicyModelDetails.IsPostApplicationAllowed">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Min Leave at a time  </label>
                                <div class="col-sm-4">
                                    <input type="text" ng-model="LeavePolicyModelDetails.MinAllocationLimit" class="form-control" only-numbers maxlength="100" tabindex="2">
                                </div>
                                <label class="col-sm-4 control-label">Days</label>
                            </div>
                        </div>


                        <div class="col-sm-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Max Leave at a time  </label>
                                <div class="col-sm-4">
                                    <input type="text" ng-model="LeavePolicyModelDetails.MaxAllocationLimit" class="form-control" only-numbers maxlength="100" tabindex="2">
                                </div>
                                <label class="col-sm-4 control-label">Days</label>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label class="col-sm-6 control-label">Is Proof Doc Required</label>
                                <div class="col-sm-6">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="8" type="checkbox" ng-change="ChangeProofDocRequired()" ng-model="LeavePolicyModelDetails.IsProofDocRequired">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">

                            <div class="form-group">
                                <label class="col-sm-6 control-label">Leave Calculation Starts From</label>
                                <div class="col-sm-6">
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="IsCalculationDoj" ng-model="LeavePolicyModelDetails.LvCalculationOnDOJOrDoc" value="CalculateDoj">
                                            <span class="cr"><i class="cr-icon"></i></span>DOJ
                                        </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                        <label>
                                            <input type="radio" name="IsCalculationDoj" ng-model="LeavePolicyModelDetails.LvCalculationOnDOJOrDoc" value="CalculateDoc">
                                            <span class="cr"><i class="cr-icon"></i></span>DOC
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="col-xs-12 col-sm-6 col-md-6 ">
                            <div class="form-group">
                                <label class="col-sm-8 control-label">Can Avail after</label>
                                <div class="col-sm-4">
                                    <input type="text" ng-model="LeavePolicyModelDetails.LvCanAvailAfter" only-numbers class="form-control" maxlength="100" tabindex="2">
                                </div>
                            </div>
                        </div>


                        <div class="col-xs-12 col-sm-6 col-md-6 ">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <div class="col-sm-12">
                                        <div class="select-style">
                                            <select id="MonthId" class="form-control" ng-model="LeavePolicyModelDetails.CanAvailUOM" name="MonthId" required tabindex="1">
                                                <option value="">--Select--</option>
                                                <option Value="Day">Day</option>
                                                <option Value="Month">Month</option>
                                                <option Value="Year">Year</option>
                                            </select>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 ">
                            <div class="form-group">
                                <label class="col-sm-8 control-label">Can Avail Quantity</label>
                                <div class="col-sm-4">
                                    <input type="text" ng-model="LeavePolicyModelDetails.LvCanAvailQuantity" only-numbers class="form-control" maxlength="100" tabindex="2">
                                </div>
                            </div>
                        </div>
                        <label class="col-sm-2 control-label" style="margin-left: -30px;">(Current Year)</label>
                        <div class="col-sm-4 ">
                            <div class="radio col-md-12">
                                <label>
                                    <input type="radio" name="Fixed" ng-model="LeavePolicyModelDetails.LvAvailedOnFixedOrPercentage" value="Fixed">
                                    <span class="cr"><i class="cr-icon"></i></span>Fixed
                                </label>
                                <label>
                                    <input type="radio" name="Percentage" ng-model="LeavePolicyModelDetails.LvAvailedOnFixedOrPercentage" value="Percentage">
                                    <span class="cr"><i class="cr-icon"></i></span>Percentage
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-6 col-md-6 ">
                        <div class="form-group" @*ng-show="!EarnLeaveVar"*@>
                            <label class="col-sm-6 control-label">Exception allowed on special approval</label>
                            <div class="col-sm-6">
                                <div class="checkbox-site" style="margin-top: 6px;">
                                    <label>
                                        <input tabindex="8" type="checkbox" @*ng-disabled="LeavePolicyModelDetails.IsProratacurrentyear==false"*@ ng-model="LeavePolicyModelDetails.IsAvailExceptionAllowedOnSpecialAppeal">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" @*ng-show="!EarnLeaveVar"*@>
                                <label class="col-sm-10 control-label">Back Date Posting Not Allowed</label>
                                <div class="col-sm-2" style="margin-top: 6px;">
                                    <div class="checkbox-site" style="margin-top: 6px;">
                                        <label>
                                            <input tabindex="1" type="checkbox" ng-model="LeavePolicyModelDetails.IsBackDatePosting">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-4 col-md-4  col-md-4" ng-show="LeavePolicyModelDetails.IsBackDatePosting === true">
                            <div class="form-group">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Emp Cat.</label>
                                    <div class="col-sm-8">
                                        <div class="select-style">
                                            <select id="EmpCatId" class="form-control" name="EmpCat" ng-model="LeavePolicyModelDetails.EmpCatId" tabindex="1">
                                                <option value="">--Select--</option>
                                                <option ng-repeat="option in EmployeeCategoryList" value="{{option.Id}}">{{option.UserName}}</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2  col-md-2" ng-show="LeavePolicyModelDetails.IsBackDatePosting === true">
                            <div class="form-group">
                                <div class="form-group">
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="LeavePolicyModelDetails.BackDatePostingAllowedDays" class="form-control" only-numbers maxlength="100" tabindex="2">
                                    </div>
                                    <label class="col-sm-4 control-label">Days</label>
                                </div>
                            </div>
                        </div>

                        <br />
                        <br />

                        <div class="form-group">
                            <label class="col-sm-3 control-label">Is Exception Allowed</label>
                            <div class="col-sm-3">
                                <div class="checkbox-site" style="margin-top: 6px;">
                                    <label>
                                        <input tabindex="8" type="checkbox" ng-change="changeexceptionallowed()" ng-model="LeavePolicyModelDetails.IsExceptionAllowed">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>

                            <label class="col-sm-3 control-label">Subject to approval</label>
                            <div class="col-sm-3">
                                <div class="checkbox-site" style="margin-top: 6px;">
                                    <label>
                                        <input tabindex="8" type="checkbox" ng-disabled="LeavePolicyModelDetails.IsExceptionAllowed==false" ng-model="LeavePolicyModelDetails.IsSubjectToApproval">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>

                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Required for more than</label>
                            <div class="col-sm-4">
                                <input type="text" ng-readonly="!LeavePolicyModelDetails.IsProofDocRequired" ng-model="LeavePolicyModelDetails.ProofDocReqAfterDays" class="form-control" only-numbers maxlength="100" tabindex="2">
                            </div>
                            <label class="col-sm-4 control-label">Days</label>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-6 control-label">Calculation Round Option</label>
                            <div class="col-sm-6">
                                <div class="select-style">
                                    <select id="CalculationRoundId" class="form-control" ng-model="LeavePolicyModelDetails.LeaveCalculationRoundOption" name="CalculationRoundId" required tabindex="1">
                                        <option value="">--Select--</option>
                                        <option Value="Round Up">Round Up</option>
                                        <option Value="Round Down">Round Down</option>
                                        <option Value="Round">Round</option>
                                        <option Value="Exact">Exact</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">From</label>
                            <div class="col-sm-6 ">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="IsDeviceBasedInOut" ng-model="LeavePolicyModelDetails.LvAvailedOnDOJorDoc" value="CalAvailDoj">
                                        <span class="cr"><i class="cr-icon"></i></span>DOJ
                                    </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                    <label>
                                        <input type="radio" name="IsDeviceBasedInOut" ng-model="LeavePolicyModelDetails.LvAvailedOnDOJorDoc" value="CalAvailDoc">
                                        <span class="cr"><i class="cr-icon"></i></span>DOC
                                    </label>
                                </div>
                            </div>
                        </div>

                    </div>

                </fieldset>

                <fieldset class="scheduler-border" ng-show="EarnLeaveVar">
                    <legend class="scheduler-border">Carry Forward</legend>

                    <div class="col-xs-12 ">
                        <div class="row">

                            <div class="col-xs-12 col-sm-4  col-md-3">

                                <div class="form-group">
                                    <label class="col-sm-8 control-label">Carry Forward</label>
