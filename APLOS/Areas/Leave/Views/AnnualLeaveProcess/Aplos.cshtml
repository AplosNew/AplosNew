<div id="FDiv">
    <div class="col-md-12 text-left" style="margin-bottom:20px; ">
        <button disabled class="btn" style="border-radius: 00%;cursor:pointer;color:black;" id="forward1">Annual Leave Processing</button>
        <button class="btn" style="border-radius: 00%;cursor:pointer;background-color:#242841;color:white;" id="forward1" ng-click="clickdde2();">Opening Upload</button>

    </div>
   
</div>

<div id="SDiv">

    <div class="col-md-12 text-left" style="margin-bottom:20px; ">
        <button class="btn" style="border-radius: 00%;cursor:pointer;background-color:#242841;color:white;" id="forward1" ng-click="clickdde1();">Annual Leave Processing</button>

        <button disabled class="btn" style="border-radius: 00%;cursor:pointer;color:black;" id="forward1">Opening Upload</button>

    </div>

    <togglable name="Opening Upload"></togglable>
    <div class="form-elements form-horizontal" ng-form name="HeaderForm">
        <div class="row">
            <div class="form-elements">
                <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Plant</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="BudgetPlantId" name="Plant"
                                        ng-options="item.Value as item.Text for item in PlantList" tabindex="2">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-10">

                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-4 " style="padding: 0 0 0 0 ; margin-right:8px;">
                            <input id="uploadFile" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                        </label>
                        <input type="button" style="margin-right: 8px;" value="Import Data" ng-disabled="enable" class="btn btn-success" ng-click="ImportData()" />
                        <button ng-click="GetSample();" class="btn" style="margin-right: 8px;"><i class="glyphicon glyphicon-download"></i> Get Buget And Roster Report File </button>

                    </div>
                </div>

            </div>

        </div>
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="saveFileList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> Save </button></li>
                <li> <button ng-click="clearFileList();" class="btn" tabindex="12"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

            </ul>
        </div>

        <div id="RosterBudgetGrid" ej-grid e-datasource="ExcelUploadData" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
            <div e-columns>
                <div e-column e-field="BudgetId" e-type="string" e-headertext="Budget Id" e-width="80"></div>
                <div e-column e-field="BudgetCode" e-type="string" e-headertext="Budget Code" e-width="80"></div>
                <div e-column e-field="RosterId" e-type="string" e-headertext="Roster Id" e-width="80"></div>
            </div>
        </div>

    </div>

    <div class="row aplos-grid-toggle">
        <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
            <div class="form-group">
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="Company" ng-change="getPlants()" name="Entity"
                                ng-options="item.Value as item.Text for item in CompanyList" tabindex="2">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
            <div class="form-group">
                <label class="col-sm-4 control-label">Plant</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="BudgetPlantId" name="Plant"
                                ng-options="item.Value as item.Text for item in PlantList" tabindex="2">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="getCurrentFileList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-search"></i> View </button></li>

            </ul>
        </div>
        <div id="CurrentListRoster" ej-grid e-datasource="currentList" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;"
             e-recorddoubleclick="fillUpdates">
            <div e-columns>
                <div e-column e-field="Rows" e-headertext="Sr. No." e-width="2"></div>
                <div e-column e-field="BudgetId" e-headertext="Budget Id" e-width="2"></div>
                <div e-column e-field="RosterId" e-headertext="Roster Id" e-width="2"></div>
                <div e-column e-field="AddedDate" e-headertext="Creation Date" e-width="2"></div>
                <div e-column e-field="AddedBy" e-headertext="Added By" e-width="2"></div>
            </div>
        </div>
    </div>
    <confirm-modal></confirm-modal>



</div>



<!--Modal For Shift Selection-->
<div class="modal fade site-modal in" id="ShiftModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Shift Definition Plant Wise</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic"> </div>
                <p style="margin:10px;">
                    Select the Shift by Double Clicking.
                <p>

                    <div id="shiftsList" ej-grid e-datasource="ShiftsList" e-templaterefresh="refreshTemplate"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-minWidth="450" e-minHeight="400" e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true"
                         e-recorddoubleclick="shiftSelected">
                        <div e-columns>

                            <div e-column e-field="ShiftDefinationID" e-headertext="SystemId" e-width="70"></div>
                            <div e-column e-field="ShiftDefinationName" e-headertext="Shift Name" e-width="30"></div>
                            <div e-column e-field="ShiftDefinationDescription" e-headertext="Description" e-width="100"></div>
                            <div e-column e-field="ShiftType" e-headertext="Shift Type" e-width="40"></div>
                            <div e-column e-field="ShiftSequence" e-headertext="Seq" e-width="20"></div>
                            <div e-column e-field="InTime" e-headertext="InTime" e-width="50"></div>
                            <div e-column e-field="LateMargin" e-headertext="Late Margin" e-width="50"></div>
                            <div e-column e-field="OutTime" e-headertext="OutTime" e-width="50"></div>
                        </div>
                    </div>


            </div>
        </div>

    </div>
</div>

<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to save without any shifts ?" data-ng-click-left-button="restoreChildShifts();" data-ng-click-right-button="SaveShifts();"></confirm-archive-generic>
