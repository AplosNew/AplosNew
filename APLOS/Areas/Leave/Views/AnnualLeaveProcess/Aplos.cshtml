<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="AnnualLeaveProcessing" role="tab" data-toggle="tab">Annual Leave Processing</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="OpeningUpload" role="tab" data-toggle="tab">Opening Upload</a></li>
        </ul>
    </div>
    <div class="tab-content">

        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row">
                
            </div>
        </div>


        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row">                             

                <togglable name="Opening Upload"></togglable>
                <div class="form-elements form-horizontal" ng-form name="HeaderForm">
                    <div class="row">
                        <div class="form-elements" style="margin:10px;">
                            <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="BudgetPlantId" name="Plant" ng-change="getLeaveYear()"
                                                    ng-options="item.Value as item.Text for item in PlantList">
                                                <option value="">--Select--</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Leave Year<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="SelectedYearId" name="Year"
                                                    ng-options="item.Value as item.Text for item in YearList">
                                                <option value="">--Select--</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>



                            <div class="col-md-10" style="margin:10px;">

                                <div class="inputBtnSection common-btn">
                                    <label class="fileUpload col-sm-4 " style="padding: 0 0 0 0 ; margin-right:8px;">
                                        <input id="uploadFile" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                                    </label>
                                    <input type="button" style="margin-right: 8px;" value="Import Data" ng-disabled="enable" class="btn btn-success" ng-click="ImportData()" />
                                    <button ng-click="GetSample();" class="btn" style="margin-right: 8px;"><i class="glyphicon glyphicon-download"></i> Opening Upload Sample File </button>

                                </div>
                            </div>

                        </div>

                    </div>
                    <div class="common-btn" style="margin:10px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="saveFileList();" class="btn"><i class="glyphicon glyphicon-save"></i> Save </button></li>
                            <li> <button ng-click="clearFileList();" class="btn"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

                        </ul>
                    </div>

                    <div id="OpeningDataGrid" ej-grid e-datasource="ExcelUploadData" e-templaterefresh="refreshTemplate"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
                        <div e-columns>
                            <div e-column e-field="EmployeeId" e-type="string" e-headertext="EmployeeId" e-width="80"></div>
                            <div e-column e-field="LeaveType" e-headertext="LeaveType" e-width="80"></div>
                            <div e-column e-field="Opening" e-type="string" e-headertext="Opening" e-width="60"></div>
                            <div e-column e-field="Earned" e-type="string" e-headertext="Earned" e-width="60"></div>
                            <div e-column e-field="Availed" e-type="string" e-headertext="Availed" e-width="60"></div>
                            <div e-column e-field="RegularEncashment" e-type="string" e-headertext="RegularEncashment" e-width="70"></div>
                            <div e-column e-field="Adjustment" e-type="string" e-headertext="Adjustment" e-width="60"></div>
                        </div>
                    </div>

                </div>

                <div class="row aplos-grid-toggle">
                    <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="Company" ng-change="getPlants()" name="Company"
                                            ng-options="item.Value as item.Text for item in CompanyList">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div><br /></div>
                        <br />
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Leave Year<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="SelectedYearId" name="Year"
                                            ng-options="item.Value as item.Text for item in YearList">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="BudgetPlantId" name="Plant" ng-change="getLeaveYear()"
                                            ng-options="item.Value as item.Text for item in PlantList">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="table-responsive aplos-grid-toggle">
                    <div class="common-btn" style="margin:10px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="getCurrentFileList();" class="btn"><i class="glyphicon glyphicon-search"></i> View </button></li>

                        </ul>
                    </div>
                    <div style="margin-right:10px;" id="CurrentListData" ej-grid e-datasource="currentList" e-templaterefresh="refreshTemplate"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;"
                         e-recorddoubleclick="fillUpdates">
                        <div e-columns>
                            <div e-column e-field="EmployeeId" e-headertext="EmployeeId" e-width="3"></div>
                            <div e-column e-field="LeaveType" e-headertext="LeaveType" e-width="3"></div>
                            <div e-column e-field="Opening" e-headertext="Opening" e-width="2"></div>
                            <div e-column e-field="Earned" e-headertext="Earned" e-width="2"></div>
                            <div e-column e-field="Availed" e-headertext="Availed" e-width="2"></div>
                            <div e-column e-field="RegularEncashment" e-type="string" e-headertext="RegularEncashment" e-width="3"></div>
                            <div e-column e-field="Adjustment" e-headertext="Adjustment" e-width="2"></div>
                            <div e-column e-field="Closing" e-headertext="Closing" e-width="2"></div>
                        </div>
                    </div>
                </div>
                <confirm-modal></confirm-modal>
            </div>
        </div>
    </div>
</div>


