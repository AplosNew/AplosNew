<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="Company" class="form-control" ng-model="ModelNew.CompanyId" name="Company" ng-change="getPlant();" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in companyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100" required />
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="FromDate" ng-model="ModelNew.FromDate" datepicker class="form-control" required>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Processing Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ProcessingDate" ng-model="ModelNew.ProcessingDate" datepicker class="form-control" required>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required maxlength="50">
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="ModelNew.PlantId" ng-change="getStartUp();" name="Plant" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required maxlength="10">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ToDate" ng-model="ModelNew.ToDate" datepicker class="form-control" required>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" name="RespPerson" ng-model="ModelNew.RespersonId" ng-click="selectResp()" class="form-control" maxlength="200" >

            </div>            
        </div>


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="FromDate" e-headertext="From Date" e-width="3"></div>
            <div e-column e-field="ToDate" e-headertext="To Date" e-width="3"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
        </div>
    </div>
</div>
<script>
        function isNumber(evt) {
            evt = (evt) ? evt : window.event;
            var charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 46) {
                return false;
            }
            return true;
        }
</script>
<confirm-modal></confirm-modal>

<div class="modal fade site-modal in" id="employeesModal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Responsible Person</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic"> </div>
                <p style="margin:10px;">
                    Select The Responsible Person by Double Clicking the Choice.
                <p>

                    <div id="getCustomers" ej-grid e-datasource="EmployeeList" e-templaterefresh="refreshTemplate"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true"
                         e-recorddoubleclick="doubleResp">
                        <div e-columns>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>

                        </div>
                    </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>