
<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Off Duty Hours Approval
</h3>

<div class="row form-horizontal form-elements">
    <div class="col-xs-12 col-sm-12 col-md-12 ">
        <div id="GridShiftInfo" ej-grid
             e-datasource="OffDutyInfoList"
             @*e-templaterefresh="refreshTemplateemployee4"*@
             e-allowfiltering="true"
             e-allowpaging="true"
             e-allowsorting="true"
             @*e-enabletouch="true"*@
             e-responsive="true"
             e-allowselection="true"
             e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-template="#checkboxTemplate4" e-textalign="center" e-width="30"></div>
                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="70" e-primarykey="true"></div>
                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="40"></div>
                <div e-column e-template="#FromDate" e-headertext="From Date" e-width="70"></div>
                <div e-column e-template="#ToDate" e-headertext="To Date" e-width="70"></div>
                <div e-column e-template="#DurationMin" e-headertext="Duration(Min)" e-width="30"></div>
                <div e-column e-template="#DurationDay" e-headertext="Duration(Day)" e-width="30"></div>
                <div e-column e-template="#LeaveReason" e-headertext="Leave Reason" e-width="70"></div>
                <div e-column e-template="#AllowanceLeaveDeducation" e-headertext="Allowance" e-width="70"></div>
                <div e-column e-template="#LeaveType" e-headertext="Leave Type" e-width="70"></div>
            </div>
        </div>
        <script type="text/template" id="checkboxTemplate4">
            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
        </script>

        <script type="text/x-jsrender" id="headerTemplate4">
            <input type="checkbox" id="headchk4" />
        </script>

        <script type="text/template" id="FromDate">
            <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                <input type="text" ng-model="data.FromDate" style="color:black;" class="form-control" readonly />
            </div>
        </script>

        <script type="text/template" id="ToDate">
            <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                <input type="text" ng-model="data.ToDate" style="color:black;" class="form-control" readonly />
            </div>
        </script>

        <script type="text/template" id="DurationMin">
            <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                <input type="text" ng-model="data.DurationInMin" only-numbers style="color:black;" readonly class="form-control" />
            </div>
        </script>

        <script type="text/template" id="DurationDay">
            <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                <input type="text" ng-model="data.DurationInHours" style="color:black;" class="form-control" />
            </div>
        </script>

        <script type="text/template" id="LeaveReason">
            <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                <input type="text" ng-model="data.UserName" style="color:black;" readonly class="form-control" />
            </div>
        </script>

        <script type="text/template" id="AllowanceLeaveDeducation">
            <input ej-dropdownlist e-datasource="$parent.ApproveTypeList" e-change="$parent.changeLeave" e-value="data.ApproveType" e-fields-value="Text" e-fields-text="Text" e-width="100%" />
        </script>

        <script type="text/template" id="LeaveType">
            <input ej-dropdownlist e-datasource="data.LeaveTypeList" e-value="data.EmploymentType" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
        </script>

    </div>
</div>
<br />
<div class="row form-horizontal form-elements">

    @*<div class="col-xs-12 col-sm-5 col-md-5 ">
        </div>
        <div class="col-xs-12 col-sm-5 col-md-5 ">

        </div>*@

    <div class="col-xs-12 col-sm-6 col-md-6">

    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="col-xs-12 col-sm-6 col-md-6">

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="col-xs-12 col-sm-6">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="SaveDailyAllowanceData();" style="margin-right: 3px;" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Approve </button></li>
                    </ul>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    </ul>
                </div>
            </div>

        </div>

    </div>

    </div>

    <div class="clearfix"></div>
    <confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>

