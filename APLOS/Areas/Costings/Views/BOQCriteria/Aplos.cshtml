<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>BOQ Criteria</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" @*e-recorddoubleclick="Get"*@
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Criteria" e-headertext="Criteria" e-width="100"></div>
            <div e-column e-template="#code" e-headertext="Code" e-width="100"></div>
            <div e-column e-template="#username" e-headertext="User Defined Name"></div>
            <div e-column e-template="#ShortName" e-headertext="Short Name" e-width="150"></div>
            <div e-column e-template="#StandardName" e-headertext="Standard Name"></div>
            <div e-column e-template="#Sequence" e-headertext="Sequence" e-width="80"></div>
            <div e-column e-template="#Active" e-headertext="Sequence" e-width="50"></div>
        </div>
    </div>
    <script type="text/template" id="username">
        <input type="text" name="UserName" ng-model="data.UserName" class="form-control" maxlength="255">
    </script>
    <script type="text/template" id="code">
        <input type="text" name="Code" ng-model="data.Code" class="form-control" maxlength="10">
    </script>
    <script type="text/template" id="ShortName">
        <input type="text" name="ShortName" ng-model="data.ShortName" class="form-control" maxlength="50">
    </script>
    <script type="text/template" id="StandardName">
        <input type="text" name="StandardName" ng-model="data.StandardName" class="form-control" maxlength="50">
    </script>
    <script type="text/template" id="Sequence">
        <input type="text" ej-numerictextbox e-minvalue="1" e-decimalplaces="0" e-enablertl="false" e-value="data.Sequence" e-width="100" />
    </script>
    <script type="text/template" id="Active">
        <input type="checkbox" ej-checkbox e-value="data.Active" e-checked="data.Active" class="nodetext" />
    </script>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
        </ul>
    </div>
</div>
<confirm-modal></confirm-modal>