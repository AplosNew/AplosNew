
<div class="modal site-modal" id="ContractPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Contract <button type="button" class="close" ng-click="closePopup('ContractPopUp');">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row">
                    <div class="col-md-12">
                        <div class="content-container-fluid" style="color:black;overflow:scroll">
                            <div style="color:black;" id="Gridd" ej-grid e-datasource="contractList" e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick="SelectedContract"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                                <div e-columns>
                                    <div e-column e-field="ContractId" e-headertext="Contract Id" e-width="70"></div>
                                    <div e-column e-field="ContractNo" e-headertext="Contract No" e-width="80"></div>
                                    <div e-column e-field="CustomerName" e-headertext="Customer" e-width="150"></div>
                                    <div e-column e-field="Buyer" e-headertext="Buyer" e-width="150"></div>
                                    <div e-column e-field="LCRef" e-headertext="Master LC Ref No" e-width="80"></div>
                                    <div e-column e-field="MasterLCNo" e-headertext="Master Lc Id" e-width="70"></div>
                                </div>
                            </div>
                            <script type="text/template" id="checkboxTemplateChild">
                                <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                            </script>
                        </div>
                    </div>
                    @*<ul class="common-btn list-inline text-right">
                            <li><button ng-click="closePopup('ContractPopUp');" class="btn"> Apply</button></li>
                        </ul>*@
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal site-modal" id="invoicingPartyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Invoicing Party</div>  @*<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button>*@
            <div class="modal-body form-elements form-horizontal">
                @*//here some problem*@
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 col-md-4 control-label">Invoicing by</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select ng-model="productNew.InvoicingPartyPlantId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in plantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(productNew.InvoicingPartyPlantId,'billTo')">
                                    @*<option value="">ddd</option>*@
                                </select>
                            </div>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">State :{{productNew.InvoicingState}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">GSTIN :{{productNew.InvoicingGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Invoicing by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="productNew.InvoicingByAddress" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                @*<select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList" ng-change="onchangeFunction1(x.TaxCategoryId)"></select>*@
                                <select class="form-control" ng-model="productNew.DeliveryPartyPlantId" ng-options="item.Value as item.Text for item in plantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(productNew.DeliveryPartyPlantId,'shipTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">State :{{productNew.DeliveryState}}</p>
                            <p ng-hide="productNew.InvoicingPartyPlantId==null">GSTIN :{{productNew.DeliveryGSTIN}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Delivery by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="productNew.DeliveryByAddress" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeInvoicingPartyPopUp();" class="btn"> Done</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="modal site-modal" id="ListOfPOMaterial" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify1">
        <div class="modal-content">
            <div class="modal-header">Add BOQ Materials<button type="button" class="close" ng-click="RequisitionListHide();">&times;</button></div>

            <div id="ReqaddId">
                <div class="col-lg-12">
                    @*<div class="content-container-fluid" style="color:black;">*@

                    <div style="color:black;" id="GridReq" ej-grid e-datasource="GetListForMasterOrder" ng-init="chkinit()"
                         e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick="" e-allowResizing="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">

                        <div e-columns>
                            <div e-column e-template="#CheckBoxTemp" e-headertext="Chk" e-width="40" textAlign='center'></div>
                            <div e-column e-field="CostingItem" e-headertext="Costing Item" e-width="200"></div>
                            <div e-column e-field="Destination" e-headertext="Destination" e-width="80"></div>
                            <div e-column e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="80"></div>
                            <div e-column e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="80"></div>
                            <div e-column e-field="ThirdCharacteristicsValue" e-headertext="SKU3" e-width="80"></div>

                            <div e-column e-field="SalesOrderId" e-headertext="SalesOrderId" e-width="80"></div>
                            <div e-column e-field="UserName" e-headertext="Material" e-width="100"></div>
                            <div e-column e-field="StandardName" e-headertext="Article" e-width="100"></div>
                            <div e-column e-field="BOMQty" e-headertext="BOQ" e-width="80" textAlign='Right'></div>
                            <div e-column e-field="BOQUOM" e-headertext="UoM" e-width="70"></div>
                            <div e-column e-field="RequiredQtyPO" e-headertext="Booking Qty" e-width="70"></div>
                            <div e-column e-field="OtherPOQty" e-headertext="Other PO Qty" e-width="80" textAlign='Right'></div>
                            <div e-column e-template="#CurrentText" e-field="TransactionQty" textAlign='right' e-headertext="Current Qty" e-width="100"></div>

                            <div e-column e-template="#UOM" e-headertext="UOM" e-width="150"></div>
                            <div e-column e-field="TransactionRate" textAlign='right' e-headertext="Rate" e-width="100"></div>

                            <div e-column e-field="RequiredQtyApproved" e-headertext="Approved" e-width="100"></div>
                            <div e-column e-field="Vendor" e-headertext="Vendor" e-width="300"></div>
                            <div e-column e-field="BOQId" e-headertext="BOQ Id" e-width="100"></div>


                        </div>

                    </div>

                    @*<script type="text/template" id="CheckBoxTemp">
                            <input type="checkbox" e-change="$parent.getTaxCategoryList1" e-value="data.CheckedStatus" ej-checkbox class="rowCheckbox" e-checked="data.CheckedStatus" />
                        </script>*@
                    <script type="text/template" id="CheckBoxTemp">
                        <input type="checkbox" ng-model="data.CheckedStatus" />
                        <!--<input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckedStatus" e-value="data.CheckedStatus"--> @*e-change="$parent.getTaxCategoryList1"*@ <!--/>--> @*e-enabled="{{data.RequiredQtyApproved==='1'}}"*@
                    </script>
                    <script type="text/template" id="CurrentText">
                        <input type="text" class="input ejinputtext form-control" ng-disabled="RequisitionDetailId" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.TransactionQty" width="80" ng-change="$parent.calculateRequisitionData(this)" />

                    </script>
                    <script type="text/template" id="UOM">
                        <div class="select-style">
                            <select name="Entity" ng-model="data.TransactionUoMId" class="form-control" ng-change="$parent.ConvertedDataRow(data)"
                                    ng-options="item.Value as item.Text for item in data.uoMList">
                            </select>
                        </div>
                        @*<input ej-dropdownlist e-datasource="data.uoMList" e-value="data.TransactionUoMId" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-change="$parent.ConvertedDataRow" />*@
                    </script>
                 
                    @*</div>*@
                </div>
            </div>

            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="detailPOSaveForBOQ();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActionPOBOQ}}</button></li>
                    <li><button ng-click="RequisitionListHide();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>

                </ul>
            </div>
        </div>
    </div>
</div>


<div class="modal site-modal" id="ListOfPOMaterialSelected" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify1">
        <div class="modal-content">
            <div class="modal-header">Selected BOQ Materials<button type="button" class="close" ng-click="RequisitionListHide();">&times;</button></div>


            <div class="col-lg-12">
                <div id="GridBOMListSelected" ng-init="chkinit()" ej-grid e-datasource="BOMItemListSelected" e-allowfiltering="true"
                     e-allowscrolling="true"
                     e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-type="Customer" e-field="Customer" e-headertext="Customer" e-width="80px"></div>
                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="BOMCreationDate" e-headertext="BOM Creation Dt" e-width="90px"></div>
                        <div e-column e-type="string" e-field="BOQRef" e-headertext="BOQ Ref" e-width="100px"></div>
                        <div e-column e-type="string" e-field="BOMMaterialRefNo" e-headertext="BOM Material Ref No" e-width="100px"></div>
                        <div e-column e-type="string" e-field="CostingItem" e-headertext="Costing Item" e-width="200px"></div>
                        <div e-column e-type="string" e-field="Material" e-headertext="Material" e-width="200px"></div>
                        <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="200px"></div>
                        <div e-column e-type="number" e-field="NoOfBOQItems" e-headertext="No Of BOQ Items" e-width="100px"></div>
                        <div e-column e-type="number" e-field="RequiredQty" e-headertext="Required Qty" e-width="100px"></div>
                        <div e-column e-type="string" e-field="UOM" e-headertext="UOM" e-width="70px"></div>
                        <div e-column e-type="number" e-field="OrderQty" e-headertext="Order Qty" e-width="100px"></div>
                        <div e-column e-type="number" e-field="BalanceToOrderQty" e-headertext="BalanceToOrderQty" e-width="100px"></div>
                        <div e-column e-type="string" e-field="Vendor" e-headertext="Vendor" e-width="200px"></div>
                        <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="200px"></div>
                    </div>
                </div>
            </div>


            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="ApplyItemsForPO();" class="btn"><i class="glyphicon glyphicon-ok"></i> Apply</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

