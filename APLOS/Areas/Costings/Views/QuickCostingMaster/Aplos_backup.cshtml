                <li ng-hide="ModelNew.Id == null || ModelNew.Id == '' " role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="general" role="tab" data-toggle="tab">Order Attachments </a></li>
            </ul>
