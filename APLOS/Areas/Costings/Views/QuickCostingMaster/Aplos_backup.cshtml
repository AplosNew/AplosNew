                                                Costing Summary
                                            </td>
                                            <td style="padding-right:4px!important;text-align:right;width:20%;">
                                                Value(Quick Costing)
                                            </td>
                                            <td style="padding-right:4px!important;text-align:right;width:20%;">
                                                Value(Pre Costing)
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
