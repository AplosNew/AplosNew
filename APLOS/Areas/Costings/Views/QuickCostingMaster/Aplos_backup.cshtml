                                                            <div class="col-xs-12 col-sm-6 col-md-6">


                                                                <span class="form-group" show-errors>

                                                                    <span class="show-message">
                                                                        <span>
                                                                            <input style="width:70px;padding:0px;" type="text" ng-change="CalculateProfit();" name="Target Profit" n-decimals="2" ng-model="ModelNew.TargetProfit" class="form-control text-right" autocomplete="off" min="1" required tabindex="9">
                                                                        </span>
                                                                        <span>
                                                                            <label style="width:70px;" class="form-check-label">
                                                                                <input class="form-check-input" ng-model="ModelNew.IsPercentage" type="radio" name="IsPercentage" value="true" ng-change="CalculateProfit()">
                                                                                %
                                                                            </label>
                                                                        </span>
                                                                        <span>
                                                                            <label style="width:70px;" class="form-check-label">
                                                                                <input class="form-check-input" ng-model="ModelNew.IsPercentage" type="radio" name="IsPercentage" value="false" ng-change="CalculateProfit()">
                                                                                Fixed
                                                                            </label>
                                                                        </span>
                                                                    </span>

                                                                </span>

                                                    </div>*@

                                                <div class="col-xs-12 col-sm-6 col-md-6">
                                                    Remarks
                                                </div>
                                                <div class="col-xs-12 col-sm-6 col-md-6">
                                                    <div class="form-group">

                                                        <div class="">
                                                            <textarea class="form-control" rows="1" ng-model="ModelNew.Remarks" maxlength="250" tabindex="13"></textarea>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-xs-12 col-sm-6 col-md-6">
                                                    Currency
                                                </div>
                                                <div class="col-xs-12 col-sm-6 col-md-6">

                                                    <div class="form-group" show-errors>
                                                        <div class="show-message">
                                                            <div class="select-style">
                                                                <select id="CurrencyId" class="form-control" name="Currency" ng-disabled="tranCurrencyList.length == 1" ng-model="ModelNew.CurrencyId">
                                                                    <option value="">--Select--</option>
                                                                    <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>

                                                </div>



                                            </td>

                                    </table>
                                </div>

                                <div class="common-btn" style="padding-top:20px!important;">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                                        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-5 col-md-5" style="padding-left:20px;">
                    <div class="tab-design">
                        <div class="row site-tab">
                            <ul class="nav nav-tabs" role="tablist">
                                <li role="presentation" ng-class="{ active: isSetQ(1) }"><a ng-click="setTabQ(1);" href="" aria-controls="general" role="tab" data-toggle="tab">Quick Costing</a></li>
                                <li role="presentation" ng-class="{ active: isSetQ(2) }"><a ng-click="setTabQ(2);" href="" aria-controls="general" role="tab" data-toggle="tab">Segment </a></li>
                                <li role="presentation" ng-class="{ active: isSetQ(3) }"><a ng-click="setTabQ(3);" href="" aria-controls="general" role="tab" data-toggle="tab">View </a></li>
                            </ul>
                        </div>

                        <div class="tab-content" style="border:none;padding:0px;">
                            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetQ(1), active: isSetQ(1) }">
                                <div class="row" style="padding:0px;margin:0px;">
                                    <style type="text/css">
                                        body {
                                            font-family: 'Arial Narrow', Arial, 'Franklin Gothic Medium', sans-serif !important;
                                            font-size: 2.0vh !important;
                                        }


                                        tr {
                                            padding: 0px !important;
                                            margin: 0px !important;
                                            font-size: 2.0vh !important;
                                            border: none !important;
                                            vertical-align: top !important;
                                        }

                                        td {
                                            padding: 0px !important;
                                            margin: 0px !important;
                                            font-size: 2.0vh !important;
                                            vertical-align: top !important;
                                        }

                                            td .form-group {
                                                padding: 0px !important;
                                                margin: 0px !important;
                                            }

                                            td input {
                                                height: 100%;
                                                font-size: 2.0vh !important;
                                            }

                                            td .select-style select {
                                                font-size: 2.0vh !important;
                                            }

                                            td div {
                                                padding: 0px !important;
                                            }

                                            td .text-center {
                                                padding: 0px !important;
                                                margin: 0px !important;
                                                vertical-align: central;
                                            }

                                            td .btn {
                                                padding: 0px !important;
                                                margin: 0px !important;
                                            }

                                            td .select-style {
                                                padding-top: 10px !important;
                                                padding: 0px !important;
                                                margin: 0px !important;
                                                height: 100% !important;
                                            }

                                            td .input-group {
                                                padding: 0px !important;
                                                margin: 0px !important;
                                                height: 100% !important;
                                            }

                                        .cellBorder {
                                            font-size: 2.0vh !important;
                                            padding: 0px 2px 0px 0px !important;
                                            margin: 0px !important;
                                            border: none !important;
                                        }

                                            .cellBorder td {
                                                padding: 0px 2px 0px 0px !important;
                                                margin: 0px !important;
                                                border: 1px solid #dcdcdc !important;
                                            }

                                            .cellBorder th {
                                                padding: 0px 2px 0px 0px !important;
                                                margin: 0px !important;
                                                border: none !important;
                                            }
                                    </style>
                                    <table class="row" style="border:1px solid #dcdcdc">
                                        <tr style="font-size:2.5vh!important;font-weight:bold;background-color:black;color:white;">

                                            <td>Costing Component</td>
                                            <td class="text-right cellBorder" style="width:15%;">Buyer Target(A)</td>
                                            <td class="text-right cellBorder" style="width:15%;">Quick Costing(B)</td>
                                            <td class="text-right cellBorder" style="width:15%;">Buyer Tgt. Diff(A-B)</td>
                                            <td class="text-right cellBorder" style="width:15%;">Pre Costing(C)</td>
                                            <td class="text-right cellBorder" style="width:15%;">Quick Costing Diff(B-C)</td>
                                        </tr>
                                        <tr ng-repeat="x in QuickCostingDetailList" style="background-color:{{x.isToBeDeleted=='DELETE'?'red':''}}; color:blue">

                                            <td class="cellBorder" style="cursor:pointer;" ng-click="NavigateToOrderCosting(x);">

                                                <label style="color:blue;cursor:pointer; font-weight:inherit;">{{x.UserName}}</label>

                                            </td>

                                            <td>
                                                <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.BuyerTarget" ng-disabled="x.Status">
                                            </td>
                                            <td>
                                                <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.CostingValue" ng-change="SumCostingValue()" ng-disabled="x.Status">
                                            </td>
                                            <td class="text-right cellBorder" style="background-color:#dcdcdc; color:{{x.BuyerTarget-x.CostingValue<0?'red':'black'}};">
                                                {{x.BuyerTarget-x.CostingValue!=0?(x.BuyerTarget-x.CostingValue| number:4):'-'}}
                                            </td>
                                            <td class="text-right cellBorder" style="background-color:#dcdcdc;color:black;">
                                                {{x.TotalGrossAmount!=0?(x.TotalGrossAmount|number:4):'-'}}
                                            </td>
                                            <td class="text-right cellBorder" style="background-color:#dcdcdc;color:{{x.CostingValue-x.TotalGrossAmount<0?'red':'black'}};">
                                                {{x.CostingValue-x.TotalGrossAmount!=0?(x.CostingValue-x.TotalGrossAmount|number:4):'-'}}
                                            </td>

                                        </tr>
                                        <tr style="background-color:#dcdcdc;" ng-show="QuickCostingDetailList.length > 0">
                                            <td style="color:#470078"><b>Total</b></td>

                                            <td style="color:#470078;" class="text-right "><b>{{QuickCostingDetailList | sumByKey : 'BuyerTarget'|  number:4 }}</b></td>
                                            <td style="color:#470078;" class="text-right "><b>{{QuickCostingDetailList | sumByKey : 'CostingValue'|  number:4 }}</b></td>
                                            <td class=""></td>
                                            <td style="color:#470078;" class="text-right "><b>{{QuickCostingDetailList | sumByKey : 'TotalGrossAmount'|  number:4 }}</b></td>
                                            <td class=""></td>
                                        </tr>

                                    </table>
                                    <br />
