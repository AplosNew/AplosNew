<div class="modal site-modal" id="SubMaterialPOPup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">SubMaterial <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-disabled="Segment=='Operation'" ng-click="showCostingItemListWithOperationPopUpInSubMaterial();" class="btn"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i> </button></li>
                    </ul>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Costing Item</label>
                    <label class="col-sm-3 control-label">{{SelectedLine.UserName}}</label>
                    <label class="col-sm-3 control-label">Particulars</label>
                    <label class="col-sm-3 control-label">{{SelectedLine.Particulars}}</label>
                    <label class="col-sm-3 control-label">UOM</label>
                    <label class="col-sm-3 control-label">{{SelectedLine.UnitOfMeasurement}}</label>
                    <label class="col-sm-3 control-label">Consumption</label>
                    <label class="col-sm-3 control-label">{{SelectedLine.Consumption}}</label>
                    <label class="col-sm-3 control-label">Value Loss (%)</label>
                    <label class="col-sm-3 control-label">{{SelectedLine.ValueLoss}}</label>
                    <label class="col-sm-3 control-label">Min. Quantity</label>
                    <label class="col-sm-3 control-label">{{SelectedLine.MinimumOfQuantity}}</label>
                    <label class="col-sm-3 control-label">Rate</label>
                    <label class="col-sm-3 control-label">{{SelectedLine.Rate}}</label>
                    <label class="col-sm-3 control-label">Gross Consumption</label>
                    <label class="col-sm-3 control-label">{{SelectedLine.GrossConsumption}}</label>
                    <label class="col-sm-3 control-label">Gross Amount</label>
                    <label class="col-sm-3 control-label">{{SelectedLine.GrossAmount}}</label>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                @*<th>PreCostingDirectMaterialId</th>*@
                                <th>Costing Master Template</th>
                                <th>Costing Item</th>
                                <th>Consumption</th>
                                <th>Value Loss</th>
                                <th>Rate</th>
                                <th>Gross Consumption</th>
                                <th>Gross Amount</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in SubMaterialList">
                                @*<td>{{item.PCDMCID}}></td>*@
                                <td>{{item.CostingMasterTemplate}}</td>
                                <td>{{item.CostingItemName}}</td>
                                <td><input type="number" step="any" ng-change="CalculationSubMaterial(item,$index)" ng-model="item.Consumption" class="form-control" /></td>
                                <td><input type="number" step="any" ng-change="CalculationSubMaterial(item,$index)" ng-model="item.ValueLoss" class="form-control" /></td>
                                <td><input type="number" step="any" ng-change="CalculationSubMaterial(item,$index)" ng-model="item.Rate" class="form-control" /></td>
                                <td><input type="number" step="any" ng-change="CalculationSubMaterial(item,$index)" ng-disabled="true" ng-model="item.GrossConsumption" class="form-control" disabled /></td>
                                <td><input type="number" step="any" ng-change="CalculationSubMaterial(item,$index)" ng-disabled="true" ng-model="item.GrossAmount" class="form-control" disabled /></td>
                                <td>
                                    <div class="common-btn">
                                        <ul class="list-inline text-center">
                                            <li> <button ng-click="DeleteSubMaterial(item.Id);" class="btn"><i class="glyphicon glyphicon-trash"></i> </button></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <label class="col-sm-6 control-label" style="color:blue">Note: Please enter consumption for each {{SelectedLine.UnitOfMeasurement}}</label>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="SaveSubMaterial();CloseSubMaterial();" class="btn"><i class=""></i> Save </button>
                <button ng-click="CloseSubMaterial();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>

