    <table class="row" style="background-color:#dcdcdc;">
        <tr style="background-color:black;color:white;font-size:2.5vh!important;font-weight:bold;">
            <td style="width:120px;">
                Work Center Days
            </td>
            <td style="padding-right:4px!important;text-align:right;width:25%;">
                Basic %
            </td>
            <td style="padding-right:4px!important;text-align:right;width:25%;">
                Semi Critical %
            </td>
            <td style="padding-right:4px!important;text-align:right;width:25%;">
                Critical %
            </td>
            <td style="padding-right:4px!important;text-align:right;width:25%;">
                Highly Critical %
            </td>
        </tr>
        <tr ng-repeat="data in UpchargeListMatrix">
            <td style="width:120px;">
                {{data.WorkCenterDays}}
            </td>
            <td style="padding-right:4px!important;text-align:right;width:25%;">
                <input type="number" name="Basic" min="0" ng-model="data.Basic" class="form-control">

            </td>
            <td style="padding-right:4px!important;text-align:right;width:25%;">
                <input type="number" name="SemiCritical" min="0" ng-model="data.SemiCritical" class="form-control">

            </td>
            <td style="padding-right:4px!important;text-align:right;width:25%;">
                <input type="number" name="Critical" min="0" ng-model="data.Critical" class="form-control">
            </td>
            <td style="padding-right:4px!important;text-align:right;width:25%;">
                <input type="number" name="HighlyCritical" min="0" ng-model="data.HighlyCritical" class="form-control">
            </td>
        </tr>

    </table>
    <div class="row text-right staticSave">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li>  <button type="button" ng-click="Save()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
            </ul>
        </div>

    </div>


</div>

<style type="text/css">
    body {
        font-family: 'Arial Narrow', Arial, 'Franklin Gothic Medium', sans-serif !important;
