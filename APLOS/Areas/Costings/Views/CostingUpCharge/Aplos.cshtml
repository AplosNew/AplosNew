<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-horizontal form-elements" id="mainContainer" style="padding-bottom:30px;padding-left:30px;">
    <div class="col-xs-12 col-sm-4">
        <div class="form-group">
            <label class="col-sm-4 control-label">Costing Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="CostingType"
                            ng-options="item.Value as item.Text for item in CostingTypeList" id="CostingType" ng-change="GetCostingTypeComponent();" name="Costing Type">
                    </select>
                </div>
            </div>
        </div>
    </div> <div class="col-xs-12 col-sm-8"></div>
