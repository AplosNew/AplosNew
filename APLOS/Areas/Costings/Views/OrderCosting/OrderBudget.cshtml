@*<h3 class="site-heading">
        <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>{{SelectedOrderCostingComponent.UserName}}({{SelectedOrderCostingComponent.CostingSegment}})
    </h3>*@
@*Direct Material*@
<div class="table-responsive" ng-show="Segment=='DirectMaterial' && ModelNew.Id!='' ">
    <div id="GridM" ej-grid e-datasource="OrderBudgetDirectMaterialList" e-summaryrows="TotalOrderCostTotal"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="CostingItems" e-headertext="Costing Item" e-width="6"></div>
            <div e-column e-field="UOM" e-headertext="UoM" e-width="4"></div>
            @*<div e-column e-field="Particulars" e-headertext="Particulars" e-width="8"></div>*@
            <div e-column e-field="Consumption" e-type='number' e-headertext="Consumption" e-width="5"></div>
            <div e-column e-field="ValueLoss" e-type='number' e-headertext="Value Loss" e-width="4"></div>
            <div e-column e-field="GrossConsumption" e-type='number' e-headertext="Gross Consumption" e-width="5"></div>
            <div e-column e-field="Rate" e-type='number' e-headertext="Rate" e-width="4"></div>
            <div e-column e-field="GrossAmount" e-type='number' e-headertext="Gross Amount" e-width="5"></div>
            <div e-column e-field="TotalQty" e-type='number' e-headertext="Total Qty" e-width="4"></div>
            <div e-column e-field="TotalMaterialRequirement" e-type='number' e-headertext="Total Material Requirement" e-width="6"></div>
            <div e-column e-field="TotalOrderCost" e-type='number' e-headertext="Total Order Cost" e-width="4"></div>
            <div e-column e-field="Currency" e-headertext="Currency" e-width="4"></div>
        </div>
    </div>
</div>

