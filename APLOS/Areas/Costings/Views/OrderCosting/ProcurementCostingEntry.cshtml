        <tbody>
            <tr style="background-color:{{x.Error?'red':'white'}};" ng-repeat="x in ProfitProcurementCostingList">
                <td sstyle="width:250px!important;color:blue!important;cursor:pointer!important;" ng-click="ShowToolTip('PROCUREMENT',x)">{{x.UserName}}</td>

                <td style="width:100px!important;">
                    <div class="select-style">
                        <select style="margin-left: 0px;" name="Profit" id="Profit"
                                ng-change="CalculateFinalCostingProcurement(x)"
                                ng-model="x.Type">

                            <option value="Fixed">Fixed</option>
                            <option value="Percentage">Percentage</option>
                        </select>
                    </div>

                </td>
                <td style="width:40px!important;">

                    <input type="number" style="min-width:40px;background-color:{{x.Value<0?'red':'white'}}" name="MaterialMasterName" min="0" ng-model="x.Value" ng-change="CalculateFinalCostingProcurement(x);" class="form-control">

                </td>
                <td class="text-right" style="padding-right:4px!important;width:80px;">
                    {{x.Amount | number:4}}
                </td>

                <td style="width:220px;">
                    <div class="input-group">
                        <input type="text" name="ResponsiblePerson" ng-model="x.ResponsiblePersoin" style="width:180px;" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="getPopUpData($index,'PROCUREMENT')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </td>
                <td>
                    <div class="form-control">
                        <input type="text" ng-model="x.Description" />
                    </div>
                </td>
                <td>
                    <div class="input-group" style="width:150px!important">
                        <button name="submit" ng-click="ShowUploadBox(x,'PROCUREMENT','OrderProcurementCostingProfit')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-paperclip"></i></button>

                        <a href="POPResources/OrderCosting/{{x.FileName}}" target="_blank">
                            <span style="color:red;padding:4px;">  </span>
                            <span style="height:20px;width:20px;color:blue;">
                                {{x.FileOriginalName}}
                            </span>
                        </a>


                    </div>


                </td>
            </tr>
            <tr>
                <td style="color:blue;" colspan="3">Total</td>
                <td class="text-right" style="color: blue;padding-right:4px!important;"><label>{{TotalProcurementSegmentedValueByComponent| number:4}}</label></td>

            </tr>
        </tbody>
    </table>
</div>

<div class="modal-footer common-btn">
    <button ng-click="SaveCostingComponentItems('PROCUREMENT');" class="btn" tabindex="4"><i class=""></i> Update</button>
    <button ng-click="BackToOrderCostingComponent();" class="btn" tabindex="4"><i class=""></i> Back</button>
</div>

<!--#region Update by Saad-->
<ej-dialog id="UpdatePOPupP"
           title="Item Consumption Update"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#CostingItemsEntryP"
           e-close="onDialogClose"
           e-width="1020"
           e-minheight="470"
           e-open="enableBtn">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Product Master:</label>
                <label class="col-sm-8 control-label">{{ModelNew.ProductMaster}}</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Costing Item:</label>
                <label class="col-sm-8 control-label">{{SelectedDirectMaterialP.UserName}}</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Item Consumption</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ItemConsumptionP">
                            <option value=""> </option>
                            <option ng-repeat="option in ItemListPro" value="{{option.Id}}">{{option.Description}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6" id="BPMRDistribution">
            <div class="common-btn">
                <ul class="list-inline small">
                    <li><button ng-click="ConfirmP();" class="btn small"><i class="glyphicon glyphicon-saved"></i> Apply</button></li>
                </ul>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Parameter 1</legend>
                <div class="form-group">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-12 table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Parameter</th>
                                            <th>Actual</th>
                                            <th>Allowance</th>
                                            <th>With Allowance</th>
                                            <th>Number of Components</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in HeightP">
                                            <td><input type="text" ng-model="item.Parameter" class="form-control" /></td>
                                            <td><input type="number" step="any" ng-change="CalculationP(item)" ng-model="item.Actual" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-change="CalculationP(item)" ng-model="item.Allowance" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-disabled="true" ng-model="item.WithAllowance" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-change="CalculationP(item)" ng-model="item.NoOfParameter" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-disabled="true" ng-model="item.Total" class="form-control" style="width:80px;" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <b style="color:blue">**All Values are in Centimeter</b>
            </fieldset>
        </div>

        <div class="col-xs-12 col-sm-12 col-md-12" @*ng-hide="ComponentNew.AreaType == 'Circle' "*@>
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Parameter 2</legend>
                <div class="form-group">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-12 table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Parameter</th>
                                            <th>Actual</th>
                                            <th>Allowance</th>
                                            <th>With Allowance</th>
                                            <th>Number of Components</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in WidthP">
                                            <td><input type="text" ng-model="item.Parameter" class="form-control" /></td>
                                            <td><input type="number" step="any" ng-change="CalculationP(item)" ng-model="item.Actual" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-change="CalculationP(item)" ng-model="item.Allowance" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-disabled="true" ng-model="item.WithAllowance" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-change="CalculationP(item)" ng-model="item.NoOfParameter" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-disabled="true" ng-model="item.Total" class="form-control" style="width:80px;" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <b style="color:blue">**All Values are in Centimeter</b>
            </fieldset>
        </div>


        <div class="col-xs-12 col-sm-12 col-md-12 text-right">
            <div class="col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Consumption Value:</label>
                    <label class="col-sm-8 control-label">{{SelectedDirectMaterialP.Consumption}}</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="common-btn">
                    <ul class="list-inline small">
                        <li><button ng-click="SaveUpdateP();" ng-show="HeightP.length != 0 || WidthP.length != 0" class="btn small"><i class="glyphicon glyphicon-saved"></i> Save</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</ej-dialog>

<ej-dialog id="dialogAPIP" title="Confirm?" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#CostingItemsEntryP" e-close="onDialogClose" e-minwidth="240" e-minheight="165" e-open="enableBtn">
    <p>
        All exsisting data will be removed. And replaced with selected  Item Consumption data. Are you Sure?
    </p>
    <p class="text-right">
        <ul class="list-inline text-right">
            <li><button ng-click="ApplyItemConsumptionP();ConfirmCloseP()" class="btn"><i class="glyphicon glyphicon-floppy-remove"></i> Yes</button></li>
            <li><button ng-click="ConfirmCloseP();" class="btn"><i class="glyphicon glyphicon-step-backward"></i> No</button></li>
        </ul>
    </p>
</ej-dialog>
<!--#endregion-->