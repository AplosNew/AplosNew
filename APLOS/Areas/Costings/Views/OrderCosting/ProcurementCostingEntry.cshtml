<div class="table-responsive modal-table" ng-show="Segment=='DirectMaterial' && ModelNew.Id!='' " id="CostingItemsEntryP">
    <table class="col-md-12">
        <thead>
            <tr>
                <th style="width: 150px !important">Costing Item</th>
                <th style="width: 40px !important">Seq.No.</th>
                <th style="width: 150px !important;text-align:center!important;">Particulars</th>
                <th>UoM</th>
                <th class="text-right">Consumption</th>
                <th class="text-right">Value Loss (%)</th>

                <th class="text-right">Min. Qty</th>
                <th class="text-right">Rate</th>
                <th class="text-right">Gross Consumption</th>
                <th class="text-right">Gross Amount</th>

                <th>Procurement Level</th>
                <th>BOQ Days</th>
                <th>Dependent Date</th>
                <th>BOQ Criteria</th>

                <th>Sourcing Type</th>
                <th>Res. Person</th>
                <th>IsMandatory</th>
                <th>Predefined Material</th>

                <th>Meterial</th>
                <th>Article</th>
                <th>Usage</th>
                <th>Vendor</th>

                <th>Remarks</th>
                <th>Pur. Grp</th>


                <th style="text-align:center!important;">Lead Days</th>

                <th>IsUDApplicable</th>
                <th>Attachment</th>




            </tr>
        </thead>
        <tbody>

            <tr style="background-color:{{x.Error?'red':'white'}};" ng-repeat="x in DirectProcurementCostingMaterialList">
                <td style="width:250px!important;color:blue!important;cursor:pointer!important;" ng-click="ShowToolTip('PROCUREMENT',x)">{{x.UserName}}</td>

                <td class="text-right">
                    <input type="number" style="min-width:40px;background-color:{{x.Sequence<0?'red':'white'}}" name="Sequence" @*ng-click="x.Consumption>0?x.Consumption:x.Consumption=''"*@ ng-model="x.Sequence" class="form-control">
                </td>

                <td style="width:150px!important;">
                    <input style="min-width:150px;" type="text" ng-model="x.Particulars" class="form-control" />

                </td>
                <td>
                    <span>{{x.UnitOfMeasurement}}</span>
                </td>

                <td class="text-right">
                    <input type="number" style="color: blue; min-width: 80px; background-color:{{x.Consumption<0?'red':'white'}}" name="MaterialMasterName" @*min="0" ng-click="x.Consumption>0?x.Consumption:x.Consumption=''"*@ ng-model="x.Consumption" ng-change="CalculateFinalCostingProcurement(x);" class="form-control" @*ng-dblclick="getValueP(x)"*@>
                </td>
                <td class="text-right">
                    <input type="number" style="min-width:80px;background-color:{{x.ValueLoss<0?'red':'white'}}" name="MaterialMasterName" min="0" ng-click="x.ValueLoss>0?x.ValueLoss:x.ValueLoss=''" ng-model="x.ValueLoss" ng-change="CalculateFinalCostingProcurement(x);" class="form-control">
                </td>
                <td class="text-right">
                    <input type="number" style="min-width:80px;background-color:{{x.MinimumOfQuantity<0?'red':'white'}}" name="MaterialMasterName" min="0" ng-click="x.MinimumOfQuantity>0?x.MinimumOfQuantity:x.MinimumOfQuantity=''" ng-model="x.MinimumOfQuantity" class="form-control">
                </td>
                <td class="text-right">
                    <input type="number" style="min-width:80px;background-color:{{x.Rate<0?'red':'white'}}" name="MaterialMasterName" min="0" ng-model="x.Rate" ng-click="x.Rate>0?x.Rate:x.Rate=''" ng-change="CalculateFinalCostingProcurement(x);" class="form-control">
                </td>

                <td class="text-right">
                    <span style="min-width:80px!important;">{{x.GrossConsumption | number:4}}</span>

                </td>
                <td class="text-right">
                    <span style="min-width:80px!important;">  {{x.GrossAmount  | number:4}}</span>
                </td>

                <td>
                    <div class="select-style">
                        <select style="width: 90px;margin-left: 0px;" name="ProcurementLevel" ng-model="x.ProcurementLevel">
                            <option value=""></option>
                            <option value="SO">Sales Order</option>
                            <option value="SKU">SKU</option>
                        </select>
                    </div>
                </td>
                <td class="text-right">
                    <input type="number" style="min-width:40px;" min="0" ng-model="x.BOQDays" class="form-control">
                </td>
                <td>
                    <div class="select-style">
                        <select style="width: 90px;margin-left: 0px;" name="DependentDate" ng-model="x.DependentDate">
                            <option value=""></option>
                            <option value="SOCreationDate">Sales Order Creation Date</option>
                            <option value="SODeliveryDate">Sales Order Delivery Date</option>
                        </select>
                    </div>
                </td>
                <td>
                    <div class="select-style">
                        <select name="Entity" ng-model="x.BOQCriteria" style="width: 90px;margin-left: 0px;"
                                ng-options="item.Criteria as item.UserName for item in BOQCriteriaList">
                            <option value=""></option>
                        </select>
                    </div>
                </td>
                <td>
                    <div class="select-style">
                        <select style="width: 90px;margin-left: 0px;" name="SourcingType" id="SourcingType" ng-model="x.SourcingType">
                            <option value="Imported">Imported</option>
                            <option value="Local">Local</option>
                        </select>
                    </div>
                </td>
                <td style="width:180px;">
                    <div class="input-group">
                        <input type="text" name="ResponsiblePerson" ng-model="x.ResponsiblePersoin" style="width:120px;" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="getPopUpData($index,'PROCUREMENT')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </td>
                <td>
                    <div class="text-center">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="x.IsMandatory" e-checked="x.IsMandatory" />

                    </div>

                </td>
                <td>
                    <div class="text-center">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="x.IsGeneric" e-checked="x.IsGeneric" />
                    </div>
                </td>
                <td>
                    <div ng-show="x.IsGeneric" class="input-group">
                        <input type="text" name="MaterialMasterName" ng-model="x.MaterialMasterName" class="form-control" readonly style="width: 120px">
                        <span class="input-group-btn">
                            <button ng-click="getMaterial($index,'PROCUREMENT');" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>

                </td>
                <td>

                    <div ng-show="x.IsGeneric" class="input-group">
                        <input type="text" name="MaterialMasterName" ng-model="x.ArticleName" class="form-control" readonly style="width: 120px;">
                        <span class="input-group-btn">
                            <button ng-click="getArticle($index,'PROCUREMENT');" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearArticle($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>

                        </span>
                    </div>

                </td>
                <td>

                    <div class="select-style">
                        <select style="width:90px;margin-left: 0px;" name="Usage" id="Usage" ng-model="x.Usage">
                            <option value="BeforeProduction">Before Production</option>
                            <option value="DurringProduction">Durring Production</option>
                            <option value="AfterProduction">After Production</option>
                        </select>
                    </div>

                </td>
                <td style="width:180px;">
                    <div class="input-group">
                        <input type="text" name="ResponsiblePerson" ng-model="x.Vendor" style="width:120px;" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="MaterialVendorPopUp($index,'PROCUREMENT')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </td>
                <td>
                    <input style="min-width:150px;" type="text" ng-model="x.Remarks" class="form-control" />
                </td>



                <td>
                    <div class="select-style">
                        <select style="width: 90px;margin-left: 0px;" class="form-control" ng-model="x.PurchaseGroupId" name="PurchaseGroup" ng-options="item.Id as item.UserName for item in PurchaseGroupList">
                            <option value=""></option>
                        </select>
                    </div>
                </td>
                <td class="text-right">
                    <input type="number" style="min-width:80px;background-color:{{x.POIssueDeadLine<0?'red':'white'}}" name="MaterialMasterName" min="0" ng-model="x.POIssueDeadLine" class="form-control">
                </td>

                <td>
                    <div class="text-center">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="x.IsUDApplicable" e-checked="x.IsUDApplicable" />
                    </div>

                </td>
                <td>
                    <div class="input-group" style="width:150px!important">
                        <button name="submit" ng-click="ShowUploadBox(x,'PROCUREMENT','OrderProcurementCostingDirectMaterial')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-paperclip"></i></button>

                        <a href="POPResources/OrderCosting/{{x.FileName}}" target="_blank">
                            <span style="color:red;padding:4px;">  </span>
                            <span style="height:20px;width:20px;color:blue;">
                                {{x.FileOriginalName}}
                            </span>
                        </a>


                    </div>


                </td>
            </tr>
            <tr style="border:1px solid #dcdcdc !important">
                <td>Total</td>
                <td style="color:blue" class="text-right" colspan="7">@*{{toatalItemGrossConsumption | number:4}}*@</td>
                <td style="color:blue" class="text-right">{{TotalProcurementSegmentedValueByComponent | number:4}}</td>
                <td style="color:blue" colspan="10"></td>
            </tr>
        </tbody>
    </table>
</div>

