<ej-dialog id="UpdatePOPup"
           title="Item Consumption Update"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#CostingItemsEntry"
           e-close="onDialogClose"
           e-width="1020"
           e-minheight="470"
           e-open="enableBtn">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Product Master:</label>
                <label class="col-sm-8 control-label">{{ModelNew.ProductMaster}}</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Costing Item:</label>
                <label class="col-sm-8 control-label">{{SelectedDirectMaterial.UserName}}</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Item Consumption</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ItemConsumption">
                            <option value=""> </option>
                            <option ng-repeat="option in ItemList" value="{{option.Id}}">{{option.Description}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6" id="BPMRDistribution">
            <div class="common-btn">
                <ul class="list-inline small">
                    <li><button ng-click="Confirm();" class="btn small"><i class="glyphicon glyphicon-saved"></i> Apply</button></li>
                </ul>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Parameter 1</legend>
                <div class="form-group">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-12 table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Parameter</th>
                                            <th>Actual</th>
                                            <th>Allowance</th>
                                            <th>With Allowance</th>
                                            <th>Number of Components</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in Height">
                                            <td><input type="text" ng-model="item.Parameter" class="form-control" /></td>
                                            <td><input type="number" step="any" ng-change="Calculation(item)" ng-model="item.Actual" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-change="Calculation(item)" ng-model="item.Allowance" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-disabled="true" ng-model="item.WithAllowance" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-change="Calculation(item)" ng-model="item.NoOfParameter" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-disabled="true" ng-model="item.Total" class="form-control" style="width:80px;" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <b style="color:blue">**All Values are in Centimeter</b>
            </fieldset>
        </div>

        <div class="col-xs-12 col-sm-12 col-md-12" ng-hide="ComponentNew.AreaType == 'Circle' ">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Parameter 2</legend>
                <div class="form-group">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-12 table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Parameter</th>
                                            <th>Actual</th>
                                            <th>Allowance</th>
                                            <th>With Allowance</th>
                                            <th>Number of Components</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in Width">
                                            <td><input type="text" ng-model="item.Parameter" class="form-control" /></td>
                                            <td><input type="number" step="any" ng-change="Calculation(item)" ng-model="item.Actual" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-change="Calculation(item)" ng-model="item.Allowance" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-disabled="true" ng-model="item.WithAllowance" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-change="Calculation(item)" ng-model="item.NoOfParameter" class="form-control" style="width:80px;" /></td>
                                            <td><input type="number" step="any" ng-disabled="true" ng-model="item.Total" class="form-control" style="width:80px;" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <b style="color:blue">**All Values are in Centimeter</b>
            </fieldset>
        </div>


        <div class="col-xs-12 col-sm-12 col-md-12 text-right">
            <div class="col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Consumption Value:</label>
                    <label class="col-sm-8 control-label">{{SelectedDirectMaterial.Consumption}}</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="common-btn">
                    <ul class="list-inline small">
                        <li><button ng-click="SaveUpdate();" ng-show="Height.length != 0 || Width.length != 0" class="btn small"><i class="glyphicon glyphicon-saved"></i> Save</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</ej-dialog>

<ej-dialog id="dialogAPI" title="Confirm?" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#CostingItemsEntry" e-close="onDialogClose" e-minwidth="240" e-minheight="165" e-open="enableBtn">
    <p>
        All exsisting data will be removed. And replaced with selected  Item Consumption data. Are you Sure?
    </p>
    <p class="text-right">
        <ul class="list-inline text-right">
            <li><button ng-click="ApplyItemConsumption();ConfirmClose()" class="btn"><i class="glyphicon glyphicon-floppy-remove"></i> Yes</button></li>
            <li><button ng-click="ConfirmClose();" class="btn"><i class="glyphicon glyphicon-step-backward"></i> No</button></li>
        </ul>
    </p>
</ej-dialog>
