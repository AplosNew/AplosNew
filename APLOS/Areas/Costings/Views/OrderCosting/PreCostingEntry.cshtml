                    </span>
                </td>
                <td class="text-right">
                    <input type="number" style="min-width:15px;background-color:{{x.Sequence<0?'red':'white'}}" name="MaterialMasterName" min="0" ng-click="x.Sequence>0?x.Sequence:x.Sequence=''" ng-model="x.Sequence" ng-change="CalculateFinalCosting(x);" class="form-control">
                </td>

                <td style="width:150px!important;">
                    <input style="min-width:150px;" type="text" ng-model="x.Particulars" class="form-control" />

