                </td>

                <td class="text-right">
                    <input type="number" style="min-width:80px;background-color:{{x.Rate<0?'red':'white'}}" name="MaterialMasterName" min="0" ng-model="x.Rate" ng-click="x.Rate>0?x.Rate:x.Rate=''" ng-change="CalculateFinalCosting(x);" class="form-control">
                </td>

                <td class="text-right">
                    <span style="min-width:80px!important;">{{x.GrossConsumption | number:4}}</span>

