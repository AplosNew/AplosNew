                    <input type="number" style="color: blue; min-width: 80px; background-color:{{x.Consumption<0?'red':'white'}}" name="MaterialMasterName" @*ng-click="x.Consumption>0?x.Consumption:x.Consumption=''"*@ ng-model="x.Consumption" ng-change="CalculateFinalCosting(x);" class="form-control" @*ng-dblclick="getValue(x)"*@>
