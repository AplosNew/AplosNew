<style type="text/css">

    .tooltipAplos {
        position: relative;
        display: inline-block;
        text-align: justify;
    }

        .tooltipAplos .tooltipAplostext {
            content: "";
            display: inline-block;
            width: 200px;
            visibility: hidden;
            background-color: black;
            color: #fff;
            text-align: center;
            border-radius: 6px;
            padding: 5px 0;
            position: absolute;
            z-index: 11111111;
            top: -5px;
            right: 110%;
        }

            .tooltipAplos .tooltipAplostext::after {
                display: inline-block;
                width: 100%;
                content: "";
                position: absolute;
                top: 50%;
                left: 100%;
                margin-top: -5px;
                border-width: 5px;
                border-style: solid;
                border-color: transparent transparent transparent black;
            }

        .tooltipAplos:hover .tooltipAplostext {
            visibility: visible;
        }

    .blue {
        color: blue;
    }

    .red {
        color: red;
    }
</style>


