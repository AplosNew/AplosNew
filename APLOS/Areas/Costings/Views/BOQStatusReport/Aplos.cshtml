<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        /*background-color: #1c1f32;*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>
@*<togglable name="{{title}}"></togglable>*@

<div class="form-elements form-horizontal">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12 ">
            <div class="row">
                <div class="col-md-6">
                    <div class="col-md-4"><span style="font-size: 19px;margin-left: -15%;margin-bottom:10px;"><span class="glyphicon glyphicon-stats"></span>&nbsp;{{title}}</span></div>
                </div>
            </div>
            <div class="row">
                <div id="filters">
                </div>

                <div class="table-responsive aplos-grid-toggle">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridEdit" ej-grid e-datasource="ModelList"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-field="SLNo" e-headertext="SL No" e-width="2"></div>
                                <div e-column e-field="Category" e-headertext="Category" e-width="3"></div>
                                <div e-column e-field="Bank_CashName" e-headertext="Bank CashName" e-width="6"></div>
                                <div e-column e-field="AccountNumber" e-headertext="Account Number" e-width="6"></div>
                                <div e-column e-field="Currency" e-headertext="Currency" e-width="2"></div>
                                <div e-column e-field="Amount" e-headertext="Amount" e-width="4"></div>
                                <div e-column e-field="LimitAmount" e-headertext="Limit Amount" e-width="4"></div>
                                <div e-column e-field="TotalAvailableAmount" e-headertext="Total Available Amount" e-width="4"></div>
                                <div e-column e-field="PDCOverDue" e-headertext="PD COver Due" e-width="4"></div>
                                <div e-column e-field="PDCInNext_7_Days" e-headertext="PDC In Next 7 Days" e-width="4"></div>
                                @*<div e-column e-field="PaymentOverdue" e-headertext="Payment Over due" e-width="4"></div>
                                    <div e-column e-field="PaymentOverdueInNext_7_Days" e-headertext="Payment Over due In Next 7 Days" e-width="4"></div>
                                    <div e-column e-field="Surplus_Short_AsOnDate" e-headertext="Surplus Short As On Date" e-width="4"></div>
                                    <div e-column e-field="Short_SurplusInNext_7_Days" e-headertext="Short Surplus In Next 7 Days" e-width="4"></div>*@
                                <div e-column e-field="Remark" e-headertext="Remark" e-width="4"></div>
                            </div>
                        </div>
                        <div class="col-md-1 text-right" style="margin-top:20px;">
                            <button type="button" class="btn single-btn" ng-click="ReportCurrentFundPosition()" style="margin-top:10px;"><i class="glyphicon glyphicon-arrow-down"></i>Download</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<confirm-modal></confirm-modal>
