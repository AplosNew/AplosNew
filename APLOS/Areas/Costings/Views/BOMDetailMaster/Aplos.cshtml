<div class="modal fade site-modal in" id="DetailChildPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> SO Data<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements from-horizontal">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">SO NO<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" name="SONo" ng-model="ModelSO.SOId" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="GetSOPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>

                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="ModelSO.Remarks" maxlength="250" tabindex="6"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveSOData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                            <li> <button ng-click="ClearSO();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div class="col-xs-12">
                        <div id="GridSO" ej-grid e-datasource="SODataList" e-recorddoubleclick="GetSOData"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-headertext="Actions" e-template="#ShowActionButtonsSO" e-width="1"></div>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false" e-isprimarykey="true"></div>
                                <div e-column e-field="SOId" e-headertext="SONo" e-width="5"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="2"></div>
                            </div>
                        </div>
                        <script type="text/template" id="ShowActionButtonsSO">
                                <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeChildSO(this);" style="margin: -6px;"></i></button>
                            </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
