            <div e-column e-type="number" e-field="ItemWithoutBOQ" e-headertext="Items Wihout BOQ" e-width="80"></div>
            <div e-column e-type="number" e-field="OverdueSOList" e-headertext="SO Overdue" e-width="80"></div>
            <div e-column e-type="number" e-field="DueSOList" e-headertext="SO Due" e-width="80"></div>
        </div>
    </div>
</ej-dialog>
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")
<div class="modal fade site-modal in" id="ProductLibraryPopUp" role="dialog" data-backdrop="static">
