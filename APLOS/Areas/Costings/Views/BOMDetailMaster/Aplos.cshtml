                    <div style="color:black;" id="ProductLibraryGrid" ej-grid e-datasource="ProductLibraryList" e-recorddoubleclick="SetProductLibrary"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                        <div e-columns>
                            <div e-column e-field="Code" e-headertext="Code" e-width="50" e-filter="false"></div>
                            <div e-column e-field="ShortName" e-headertext="ShortName" e-width="50"></div>
                            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="130"></div>
