@*<h3 class="site-heading">
        <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Costing Group Formula
    </h3>*@
<togglable name="Costing Group Formula"></togglable>
<div class="form-elements form-horizontal" ng-form="costingGroupFormulaNewForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Costing Type<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="costingGroupFormula.CostingType"
                            ng-options="item.Value as item.Text for item in CostingTypeList" id="CostingType" @*ng-change="GetcostingGroupFormula();"*@ name="Costing Type" tabindex="7" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Costing Group<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="costingGroupFormula.CostingGroupId" name="CostingGroup" ng-options="item.Id as item.UserName for item in CostingGroupList" tabindex="6" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>


    <div class="col-sm-12 form-elements form-horizontal">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Formula</legend>
            <br />
            <div class="clearfix"></div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Costing Group</label>
                    <div class="col-sm-6">
                        <div class="select-style">
                            <select class="form-control" id="SalaryHeadFormula" ng-model="costingGroupFormula.CostingGroupFormulaId" name="CostingGroup" ng-options="item.Id as item.UserName for item in CostingGroupList" tabindex="6" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="SetFormula('SHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Operator</label>
                    <div class="col-sm-6">
                        <div class="select-style">
                            <select ng-model="costingGroupFormula.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="5">
                                <option value=""></option>
                            </select>
                        </div>

                    </div>
                    <div class="col-sm-2">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="SetFormula('Operator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Precedence</label>
                    <div class="col-sm-6">
                        <div class="select-style">
                            <select ng-model="costingGroupFormula.Precedence" class="form-control" name="Precedence" tabindex="5">
                                <option value=""></option>
                                <option value="(">(</option>
                                <option value=")">)</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="SetFormula('Precedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Value</label>
                    <div class="col-sm-6">
                        <input type="text" name="Value" ng-model="costingGroupFormula.Value" class="form-control" required tabindex="2" maxlength="50">
                    </div>
                    <div class="col-sm-2">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="SetFormula('Value');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="RemoveFormula();" class="btn" tabindex="9"><i class="glyphicon glyphicon-backward"></i></button></li>
                    </ul>
                </div>
                <div class="form-group">
                    {{costingGroupFormula.FormulaDescription}}
                </div>
            </div>
        </fieldset>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-show="Action=='Save'" ng-click="Save();" class="btn" tabindex="8"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-show="Action=='Update'" ng-click="Update();" class="btn" tabindex="8"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>


<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="costingGroupFormulaList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="CostingTypeDesc" e-headertext="Costing Type" e-width="50"></div>
            <div e-column e-field="CostingGroup" e-headertext="Costing Group" e-width="50"></div>
            <div e-column e-field="Formula" e-headertext="Formula" e-width="50"></div>
           
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>