<togglable name="{{title}}">Costing Template</togglable>
<div id="costingMain"></div>

<div class="row">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div id="filters">
        </div>
        <div class="col-md-1 text-right" style="margin-top:20px;">
             <button type="button" class="btn single-btn" ng-click="getData()"><i class="glyphicon glyphicon-send"></i>GO</button>
        </div>
    </div>
</div>

<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <div class="col-xs-12 text-right">

        <span style="display:{{ModelNew.CostingStage==null?'none':''}}">
            <span style="font-size:{{ModelNew.CostingStage=='QuickCosting'?'2em':'1em'}}">Quick Costing</span>
            <span style="font-size:{{ModelNew.CostingStage=='QuickCosting'?'4em':'2em'}}; color:{{ModelNew.isQuickCostingApproved==true?'green':'gray'}};" ng-click="ApproveCostingPopup('QUICK');" class="glyphicon glyphicon-ok-circle"></span>
        </span>

        <span style="display:{{ModelNew.CostingStage=='PreCosting' || ModelNew.CostingStage=='ProcurementCosting'?'':'none'}}">
            <span style="font-size:{{ModelNew.CostingStage=='PreCosting'?'2em':'1em'}}">Pre Costing</span>
            <span style="font-size:{{ModelNew.CostingStage=='PreCosting'?'4em':'2em'}}; color:{{ModelNew.isPreCostingApproved==true?'green':'gray'}};" ng-click="ApproveCostingPopup('PRE');" class="glyphicon glyphicon-ok-circle"></span>
        </span>

        <span style="display:{{ModelNew.CostingStage=='ProcurementCosting'?'':'none'}}">
            <span style="font-size:{{ModelNew.CostingStage=='ProcurementCosting'?'2em':'1em'}}">Procurement Costing</span>
            <span style="font-size:{{ModelNew.CostingStage=='ProcurementCosting'?'4em':'2em'}}; color:{{ModelNew.isProcurementCostingApproved==true?'green':'gray'}};" ng-click="ApproveCostingPopup('PROCUREMENT');" class="glyphicon glyphicon-ok-circle"></span>
        </span>


    </div>
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);" href="" aria-controls="general" role="tab" data-toggle="tab">General Info.</a></li>
                @*<li ng-hide="ModelNew.Id == null || ModelNew.Id == '' " role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="general" role="tab" data-toggle="tab">Buyer Info. </a></li>*@
                <li ng-hide="ModelNew.Id == null || ModelNew.Id == '' " role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="general" role="tab" data-toggle="tab">Order Attachments </a></li>
                <li ng-hide="ModelNew.Id == null || ModelNew.Id == '' " role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);" href="" aria-controls="general" role="tab" data-toggle="tab">Costing Summary </a></li>
            </ul>
        </div>

        <div class="tab-content">

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-10 col-md-10">

                        <div class="col-xs-12">


                            <div class="col-sm-2 ">
                                Product Master
                                <div>
                                    <b>  {{ModelNew.ProductMaster}}</b>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                Prod. Cat.
                                <div>
                                    <b>     {{ModelNew.ProductCategory}}</b>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                Prod.Sub Cat.
                                <div>
                                    <b>     {{ModelNew.ProductSubCategory}}</b>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                Cost.Type
                                <div>
                                    <b>   {{ModelNew.CostingType}}</b>
                                </div>

                            </div>
                            <div class="col-sm-2">
                                Cost.Stage
                                <div>
                                    <b>   {{ModelNew.CostingStage}}</b>
                                </div>

                            </div>

                        </div>

                        <div style="padding:6px"></div>
                    </div>
                    <div class="col-sm-2">
                        <table>
                            <tr>
                                <td style="width:100%;"></td>
                                <td class="text-right" style="width:80px;">
                                    <div>
                                        <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="border: 1px solid; height: 80px; width: 80px;" />
                                    </div>
                                </td>

                            </tr>
                        </table>


                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12" style="padding-left:20px;">
                        <div class="row" style="padding:0px;margin:0px;">
                            <style type="text/css">
                                body {
                                    font-family: 'Arial Narrow', Arial, 'Franklin Gothic Medium', sans-serif !important;
                                    font-size: 2.0vh !important;
                                }


                                tr {
                                    padding: 0px !important;
                                    margin: 0px !important;
                                    font-size: 2.0vh !important;
                                    border-bottom: 1px solid #dcdcdc !important;
                                }

                                td {
                                    padding: 0px !important;
                                    margin: 0px !important;
                                    font-size: 2.0vh !important;
                                }

                                    td input {
                                        height: 100%;
                                        font-size: 2.0vh !important;
                                    }




                                .cellBorder {
                                    font-size: 2.0vh !important;
                                    padding: 0px 2px 0px 0px !important;
                                    margin: 0px !important;
                                    border: 1px solid #dcdcdc !important;
                                }

                                    .cellBorder td {
                                        padding: 0px 2px 0px 0px !important;
                                        margin: 0px !important;
                                        border: 1px solid #dcdcdc !important;
                                    }

                                    .cellBorder th {
                                        padding: 0px 2px 0px 0px !important;
                                        margin: 0px !important;
                                        border: 1px solid #dcdcdc !important;
                                    }
                            </style>
                            @*<table class="row" style="border:1px solid #dcdcdc">
                                    <tr style="background-color:black;color:white;font-weight:700; padding:4px;">

                                        <td>Costing Component</td>
                                        <td class="text-right cellBorder" style="width:15%;">Buyer Target(A)</td>
                                        <td class="text-right cellBorder" style="width:15%;">Quick Costing(B)</td>
                                        <td class="text-right cellBorder" style="width:15%;">Buyer Tgt. Diff(A-B)</td>
                                        <td class="text-right cellBorder" style="width:15%;">Pre Costing(C)</td>
                                        <td class="text-right cellBorder" style="width:15%;">Quick Costing Diff(B-C)</td>
                                    </tr>
                                    <tr ng-repeat="x in QuickCostingDetailList" style="background-color:{{x.isToBeDeleted=='DELETE'?'red':''}}; color:blue">

                                        <td class="cellBorder" style="cursor:pointer;">

                                            <label style="color:blue;cursor:pointer; font-weight:bold;">{{x.UserName}}</label>

                                        </td>

                                        <td class="text-right cellBorder">
                                            {{x.BuyerTarget}}
                                        </td>
                                        <td class="text-right cellBorder">
                                            {{x.CostingValue}}
                                        </td>
                                        <td class="text-right cellBorder" style="color:{{x.BuyerTarget-x.CostingValue<0?'red':'black'}};">
                                            {{x.BuyerTarget-x.CostingValue!=0?(x.BuyerTarget-x.CostingValue| number:4):'-'}}
                                        </td>
                                        <td class="text-right cellBorder" style="color:black;">
                                            {{x.TotalGrossAmount!=0?(x.TotalGrossAmount|number:4):'-'}}
                                        </td>
                                        <td class="text-right cellBorder" style="color:{{x.CostingValue-x.TotalGrossAmount<0?'red':'black'}};">
                                            {{x.CostingValue-x.TotalGrossAmount!=0?(x.CostingValue-x.TotalGrossAmount|number:4):'-'}}
                                        </td>

                                    </tr>
                                    <tr ng-show="QuickCostingDetailList.length > 0">
                                        <td style="color:#470078" class="cellBorder"><b>Total</b></td>

                                        <td style="color:#470078;" class="text-right cellBorder"><b>{{QuickCostingDetailList | sumByKey : 'BuyerTarget'|  number:4 }}</b></td>
                                        <td style="color:#470078;" class="text-right cellBorder"><b>{{QuickCostingDetailList | sumByKey : 'CostingValue'|  number:4 }}</b></td>
                                        <td class="cellBorder"></td>
                                        <td style="color:#470078;" class="text-right cellBorder"><b>{{QuickCostingDetailList | sumByKey : 'TotalGrossAmount'|  number:4 }}</b></td>
                                        <td class="cellBorder"></td>
                                    </tr>

                                </table>*@

                            <table class="row" style="border:1px solid #dcdcdc">
                                <tr style="font-size:2.5vh!important;font-weight:bold;background-color:black;color:white;">

                                    <td>Costing Component</td>
                                    <td class="text-right cellBorder" style="width:15%;">Buyer Costing(A)</td>
                                    <td class="text-right cellBorder" style="width:15%;">Quick Costing(B)</td>
                                    <td class="text-right cellBorder" style="width:15%;">Pre Costing(C)</td>
                                    <td class="text-right cellBorder" style="width:15%;">Proc. Costing(D)</td>
                                </tr>
                                <tr ng-repeat="x in QuickCostingDetailList" style="background-color:{{x.isToBeDeleted=='DELETE'?'red':''}}; color:blue">

                                    @*<td class="cellBorder" style="cursor:pointer;" ng-click="NavigateToOrderCosting(x);">

                                            <label style="color:blue;font-weight:inherit;">{{x.UserName}}</label>

                                        </td>*@
                                    <td class="cellBorder" style="cursor:pointer;" ng-click="ModelNew.CostingStage=='PreCosting' || ModelNew.CostingStage=='ProcurementCosting'?NavigateToOrderCosting(x):null;">

                                        <label style="color:blue;cursor:pointer; font-weight:inherit;">{{x.UserName}}</label>

                                    </td>

                                    <td class="text-right cellBorder" style="color:black;">
                                        {{x.BuyerTarget}}
                                    </td>
                                    <td class="text-right cellBorder" style="color:black;">
                                        {{x.CostingValue}}
                                    </td>

                                    <td class="text-right cellBorder" style="color:black;">
                                        {{x.TotalGrossAmount!=0?(x.TotalGrossAmount|number:4):'-'}}
                                    </td>
                                    <td class="text-right cellBorder" style="color:black;">
                                        {{x.TotalProcurementGrossAmount!=0?(x.TotalProcurementGrossAmount|number:4):'-'}}
                                    </td>

                                </tr>
                                <tr style="background-color:#dcdcdc;" ng-show="QuickCostingDetailList.length > 0">
                                    <td style="color:#470078"><b>Total</b></td>

                                    <td style="color:#470078;" class="text-right "><b>{{QuickCostingDetailList | sumByKey : 'BuyerTarget'|  number:4 }}</b></td>
                                    <td style="color:#470078;" class="text-right "><b>{{QuickCostingDetailList | sumByKey : 'CostingValue'|  number:4 }}</b></td>
                                    <td style="color:#470078;" class="text-right "><b>{{QuickCostingDetailList | sumByKey : 'TotalGrossAmount'|  number:4 }}</b></td>
                                    <td style="color:#470078;" class="text-right "><b>{{QuickCostingDetailList | sumByKey : 'TotalProcurementGrossAmount'|  number:4 }}</b></td>

                                    @*<td class=""></td>*@
                                </tr>

                            </table>
                        </div>

                    </div>

                    <div class="row" id="CostingItemsEntry">

                        <div class="col-md-12" ng-hide="Segment=='' || Segment==null">

                            <h3 class="site-heading">
                                <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  {{SelectedOrderCostingComponent.UserName}}({{SelectedOrderCostingComponent.CostingSegment}})
                            </h3>
                            <div class="site-tab">
                                <ul class="nav nav-tabs" role="tablist">
                                    <li role="presentation" ng-class="{ active: isSetCosting(1) }"><a ng-click="setTabCosting(1)" href="" data-toggle="tab">Pre Costing</a></li>
                                    <li role="presentation" ng-show="ModelNew.CostingStage=='ProcurementCosting'" ng-class="{ active: isSetCosting(2) }"><a ng-click="setTabCosting(2)" href="" data-toggle="tab">Procurement Costing</a></li>
                                </ul>
                            </div>
                            <div class="tab-content">
                                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetCosting(1), active: isSetCosting(1) }">
                                    @Html.Partial("~/Areas/Costings/Views/OrderCosting/PreCostingView.cshtml")
                                </div>
                                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetCosting(2), active: isSetCosting(2) }">
                                    @Html.Partial("~/Areas/Costings/Views/OrderCosting/ProcurementCostingView.cshtml")
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
            @*<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row">
                        <div class="col-sm-12 col-sm-12 col-md-12">


                            <div class="content-container-fluid" style="color:black;">
                                <div style="        color: black;" id="GridBuyer" ej-grid e-datasource="buyerList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                     e-pageSettings-pageSize="10" e-allowselection="true" e-filtersettings-filterType="excel">
                                    <div e-columns>
                                        <div e-column e-type="string" e-field="Id" e-headertext="id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                        <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer Name" e-width="80"></div>
                                        <div e-column e-type="string" e-field="BuyerStyleRefNo" e-headertext="Buyer Style Ref No" e-width="80"></div>
                                        <div e-column e-type="string" e-field="OwnStyleRefNo" e-headertext="Own Style Ref No" e-width="60"></div>
                                        <div e-column e-headertext="Actions" e-width="50">
                                            <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;" class="btn"><i class="glyphicon glyphicon-pencil" ng-click="$parent.EditBuyer($event);" style="margin: -6px;"></i></button>
                                            <button style=" color: #f3f3ec; background-color: #1c1f32; height: 20px; " class="btn">
                                                <i class="glyphicon glyphicon-trash" ng-click="$parent.removeBuyer($event);" style="margin: -6px;"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>*@


            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">

                    <div class="col-sm-12 col-sm-12 col-md-12">

                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="GridTemplateSOList" ej-grid e-datasource="SOTemplateList" e-gridlines="both" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-allowselection="false" e-filtersettings-filterType="excel">
                                <div e-columns>

                                    <div e-column e-type="string" e-field="MasterOrderId" e-headertext="Master Order" e-width="80"></div>
                                    <div e-column e-type="string" e-field="ItemId" e-headertext="ItemId" e-width="80"></div>
                                    <div e-column e-type="string" e-field="SalesOrder" e-headertext="Sales Order" e-width="80"></div>
                                    <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                                    <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                                    <div e-column e-type="string" e-field="BuyerReferenceNo" e-headertext="BuyerRef#" e-width="80"></div>
                                    <div e-column e-type="string" e-field="Product" e-headertext="Product" e-width="140"></div>
                                    <div e-column e-type="string" e-field="Material" e-headertext="Material" e-width="140"></div>
                                    <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="140"></div>
                                    <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="DeliveryDate" e-headertext="Delivery Date" e-width="80"></div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    <div style="color:black;" e-summaryrows="GridSummaryBySegmentSummaryRows" id="GridSummaryBySegment" ej-grid e-datasource="SummaryBySegmentList" e-gridlines="both"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-pageSettings-pageSize="10" e-allowselection="true" e-filtersettings-filterType="excel">

                        <div e-columns>
                            <div e-column e-field="SegmentName" e-headertext="Segment" e-width="120"></div>
                            <div e-column e-type="numeric" e-format="{0:N2}" e-textalign="right" e-field="BuyerTarget" e-headertext="Buyer Target" e-width="60"></div>
                            <div e-column e-type="numeric" e-format="{0:N2}" e-textalign="right" e-field="CostingValue" e-headertext="Costing Value" e-width="60"></div>
                            <div e-column e-type="numeric" e-format="{0:N2}" e-textalign="right" e-field="TotalGrossAmount" e-headertext="Pre-Costing" e-width="60"></div>
                            <div e-column e-type="numeric" e-format="{0:N2}" e-textalign="right" e-field="TotalProcurementGrossAmount" e-headertext="Procurement-Costing" e-width="60"></div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="clearfix"></div>
    </div>


</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-type="string" e-field="CurrentCostStage" e-headertext="Costing" e-width="3"></div>
            @*<div e-column e-type="string" e-field="CostingMasterTemplateId" e-headertext="Ref. Template" e-width="3"></div>*@
            <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-type="string" e-field="ProductMaster" e-headertext="Product" e-width="5"></div>
            <div e-column e-type="string" e-field="Currency" e-headertext="Currency" e-width="2"></div>
            <div e-column e-type="numeric" e-field="Version" e-headertext="Version" e-width="2"></div>
            <div e-column e-field="QApproved" e-headertext="Q.Approved" e-width="2"></div>
            <div e-column e-field="PreApproved" e-headertext="Pre.Approved" e-width="2"></div>
            <div e-column e-field="ProcApproved" e-headertext="Proc.Approved" e-width="2"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Costings/Views/OrderCosting/ItemToolTip.cshtml")
<confirm-archive-generic modalid="ApproveCosting" title="Confirmation" message="{{PopupMessage}}" data-ng-click-right-button="ApproveCosting();"></confirm-archive-generic>
