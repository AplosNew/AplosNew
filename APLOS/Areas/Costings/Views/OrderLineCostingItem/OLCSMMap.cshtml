<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Order Line Costing Item Service Master Map</h3>
<div id="GridEdit" ej-grid e-datasource="ModelList"
     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
    <div e-columns>
        <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
        <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
        <div e-column e-field="LineItemCostingSandardName" e-headertext="Standard Name" e-width="5"></div>
        <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
        <div e-column e-field="CostingType" e-headertext="Costing Type" e-width="5"></div>
        <div e-column e-field="CostingComponent" e-headertext="Costing Component" e-width="5"></div>
        <div e-column e-field="SOItemName" e-headertext="SOItemName" e-width="5"></div>
        <div e-column e-field="EntryState" e-headertext="EntryState" e-width="3"></div>
        <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="1"></div>
    </div>
    <script type="text/template" id="ShowActionButtons">
        <button style="color: #f3f3ec;background-color: #1c1f32;" ng-disabled="data.EntryState=='Calculate'" title="Service Master" class="btn"><i class="glyphicon glyphicon-list" ng-click="$parent.GetSMData(this);" style="margin: -6px;"></i></button>
    </script>
</div>

<div class="modal fade site-modal in" id="SMPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">Service Master Info<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div clas="row">
                    <div id="GridSM" ej-grid e-datasource="serviceMasterList" e-templaterefresh="refreshTemplate"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="1"></div>
                            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
                            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
                            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
                        </div>
                    </div>
                    
                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headschk" />
                    </script>
                </div>
                <div class="common-btn" style="padding-right: 15px;">
                    <ul class="list-inline text-right">
                        <li><button ng-click="SaveData();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Save</button></li>
                        <li><button ng-click="ClosePopUp();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>