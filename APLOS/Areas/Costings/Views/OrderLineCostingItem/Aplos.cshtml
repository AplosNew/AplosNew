                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select id="PlantId" class="form-control" ng-model="ModelNew.PlantId" name="Plant" ng-change="GetData();" tabindex="1">
