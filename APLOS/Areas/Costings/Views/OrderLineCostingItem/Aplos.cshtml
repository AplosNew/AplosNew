<togglable name="Order Line Costing Item"></togglable>

<div class="row">
    <div id="main" ng-form name="CostingSOFormulaForm">
        @*<div class="form-element-ctrl form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Company<sup>*</sup></label>
