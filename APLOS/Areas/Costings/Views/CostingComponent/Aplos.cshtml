<togglable name="Costing Component"></togglable>
<div class="form-elements form-horizontal" ng-form="costingSubCategoryNewForm">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12" ng-hide="costingSubCategoryList.length>0">
            System will create default values in order to run the costing module. Press
            <span ng-click="CreateDefaultValues()" style="cursor:pointer; color:blue;font-weight:bolder;"> Continue</span> to proceed
            <br />
            The following items will be created:<br />
            <div id="icons" ej-treeview>
                <ul>
                    <li class="expanded">
                        <span class="glyphicon glyphicon-list"></span>Operation Costs(OPN)
                        <ul>
                            <li>
                                <span class="glyphicon glyphicon-th-list"></span>CM(CM)
                            </li>
                            <li>
                                <span class="glyphicon glyphicon-th-list"></span>Up Charge (UPC)
                            </li>
                        </ul>
                    </li>
                    <li class="expanded">
                        <span class="glyphicon glyphicon-list"></span>Value Loss(VLS)
                        <ul>
                            <li>
                                <span class="glyphicon glyphicon-th-list"></span>Rejections/Value Loss(VLS)
                            </li>

                        </ul>
                    </li>
                    <li class="expanded">
                        <span class="glyphicon glyphicon-list"></span>Profit(PRF)
                        <ul>
                            <li>
                                <span class="glyphicon glyphicon-th-list"></span>Profit(PROF)
                            </li>

                        </ul>
                    </li>
                </ul>
            </div>
            Please set the configuration values(e.g. Category,budget,description) after creation of these items
        </div>
    </div>

    <div class="col-xs-12" style="display:{{costingSubCategoryNew.isSystemGenerated?'inherit':'none'}}">**auto generated item</div>

    <div class="row" ng-show="costingSubCategoryList.length>0">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" n-decimals="2" name="Sequence" ng-model="costingSubCategoryNew.Sequence" class="form-control text-right" required tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="costingSubCategoryNew.ShortName" class="form-control" maxlength="15" required tabindex="3" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="costingSubCategoryNew.UserName" class="form-control" required tabindex="5" maxlength="50" autocomplete="off">
                </div>
            </div>
            @*<div class="form-group">
            <label class="col-sm-4 control-label">Pre-Costing Saving %</label>
            <div class="col-sm-8">
                <input type="text" n-decimals="2" name="Pre Costing Saving" ng-model="costingSubCategoryNew.PreCostingSavingsPercentage" class="form-control text-right">
            </div>
        </div>*@
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="costingSubCategoryNew.Description" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Consider FG Valuation</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" class="css-checkbox" ng-model="costingSubCategoryNew.ConsiderForFGValuation">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input ng-disabled="costingSubCategoryNew.isSystemGenerated" type="text" name="Code" ng-model="costingSubCategoryNew.Code" class="form-control" required tabindex="2" maxlength="10" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input ng-disabled="costingSubCategoryNew.isSystemGenerated" type="text" name="Standard Name" ng-model="costingSubCategoryNew.StandardName" class="form-control" required tabindex="4" maxlength="50" autocomplete="off">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm- col-md-4 control-label">Costing Segment<sup>*</sup></label>
                <div class="col-sm-8 col-md-8 show-message">
                    <div class="select-style">
                        <select ng-disabled="costingSubCategoryNew.isSystemGenerated" class="form-control" ng-model="costingSubCategoryNew.CostingSegment" name="CostingSegment" ng-options="item.Value as item.Text for item in CostingSegmentList" required tabindex="6">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm- col-md-4 control-label">Calculation Method<sup>*</sup></label>
                <div class="col-sm-8 col-md-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="costingSubCategoryNew.CalculationMethod" name="CalculationMethod" required>
                            <option value="FOB">FOB</option>
                            <option value="CUMULATIVE">Cumulative</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" ng-show="costingSubCategoryNew.CostingSegment=='DirectMaterial' ||costingSubCategoryNew.CostingSegment=='DirectProcess'">
                <label class="col-sm-4 control-label">Procurement-Costing Saving %</label>
                <div class="col-sm-8">
                    <input type="text" n-decimals="2" name="Procurement Costing Saving" ng-model="costingSubCategoryNew.ProcurementCostingSavingsPercentage" class="form-control text-right">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="costingSubCategoryNew.Remarks" maxlength="250" tabindex="8"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" class="css-checkbox" ng-model="costingSubCategoryNew.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-disabled="costingSubCategoryList==null || costingSubCategoryList.length==0" ng-click="Save();" class="btn" tabindex="8"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button ng-disabled="costingSubCategoryNew.isSystemGenerated" data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Costing Segment</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in costingSubCategoryList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get($index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.CostingSegment}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
