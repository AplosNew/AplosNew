<togglable name="Menu Creation" id="mainContainer"></togglable>

<div>
    <div class="row">

        <div class="col-sm-12">
            <div id="Tab" ej-tab e-itemactive="tabChange">
                <ul>
                    <li><a href="#TabCreate">Create Menu</a></li>
                    <li><a href="#TabHieararchy">View Menu</a></li>


                </ul>
                <div id="TabCreate">
                    {{SelectedItems.Module}} {{SelectedItems.MenuFrame}} {{SelectedItems.MenuGroup}} {{SelectedItems.MenuSubGroup}}

                    <div class="row">

                        <div class="col-sm-3">
                            <div class="frame">
                                <div class="ctrllabel">Module</div>
                                <ul id="lstmoduleList" ej-listbox e-datasource="moduleList" e-select="selModule" e-fields-text="StandardName" e-width="100%"></ul>


                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="frame">
                                <div class="ctrllabel">Menu Frame</div>
                                <ul id="lstmenuFrameList" ej-listbox e-datasource="menuFrameList" e-select="selFrame" e-fields-text="Text" e-width="100%"></ul>


                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="frame">
                                <div class="ctrllabel">Menu Group</div>
                                <ul id="lstmenuGroupList" ej-listbox e-datasource="menuGroupList" e-select="selGroup" e-fields-text="Text" e-width="100%"></ul>


                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="frame">
                                <div class="ctrllabel">Menu Sub-Group</div>
                                <ul id="lstmenuSubGroupList" ej-listbox e-datasource="menuSubGroupList" e-select="selSubGroup" e-fields-value="Value" e-fields-text="Text" e-width="100%"></ul>


                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-sm-12">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="AddNewEntry();" class="btn">Add New Menu</button></li>
                                    <li> <button ng-click="clear();" class="btn">Clear All</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div id="GridMenuList" ng-init="chkinit()" ej-grid e-datasource="MenuList" e-recorddoubleclick="GetMenuData" e-load="loadGridEdit"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true" e-rowdatabound ="changeBckCol"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="Module" e-headertext="Module" e-width="2" e-isprimarykey="true"></div>
                            <div e-column e-field="Area" e-headertext="Area" e-width="2" e-isprimarykey="true"></div>
                            @*<div e-column e-field="SubModule" e-headertext="Sub Module" e-width="1"></div>*@
                            <div e-column e-field="MenuFrame" e-headertext="Menu Frame" e-width="2"></div>
                            <div e-column e-field="MenuGroup" e-headertext="Menu Group" e-width="2"></div>
                            <div e-column e-field="SubMenuGroup" e-headertext="Menu Sub Group" e-width="2"></div>
                            <div e-column e-field="MenuName" e-headertext="Menu Name" e-width="2"></div>
                            <div e-column e-field="Href" e-headertext="Href" e-width="2"></div>
                            <div e-column e-field="Controller" e-headertext="Controller" e-width="2"></div>
                            <div e-column e-field="PanelName" e-headertext="Panel" e-width="2"></div>
                            <div e-column e-field="MatchingComment" e-headertext="Comment" e-width="4"></div>
                            <div e-column e-headertext="Actions" e-width="1" e-template="#deleteButton"></div>
                        </div>
                    </div>
                    <script type="text/template" id="deleteButton">
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="fa fa-trash-o" ng-click="$parent.DeleteMenu(this);" style="margin: -6px;"></i></button>
                    </script>
                </div>

                <div id="TabHieararchy">
                    <div class="row">
                        <div class="col-sm-2">
                            <div class="frame">
                                <div class="ctrllabel">Panel Name</div>
                                <div class="select-style">
                                    <select class="form-control" name="Group Name" ng-change="hierarchy()" ng-model="SelectedItems.PanelName" tabindex="6" required>
                                        @*<option value="">--Select--</option>*@
                                        <option value="Application">Application</option>
                                        <option value="Master">Master</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="treeView" ej-treeview e-fields-datasource="menuHierarchy"
                         e-allowdraganddrop="true" e-nodedropped="nodeDropped" e-nodedragstop="nodeDragStop"
                         e-fields-id="id" e-fields-parentid="pid" @*e-nodeselect="nodeclick"*@ e-nodeclick="nodeclick"
                         e-fields-text="MenuText" @*e-fields-haschild="hasChild"*@
                         e-fields-expanded="collapsed" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <ej-dialog id="dialogEntry" title=" Menu Entry" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#mainContainer" e-minwidth="900" e-open="enableBtn">
        <div class="form-element-ctrl form-horizontal">
            @Html.Partial("~/Areas/Menus/Views/MenuCreation/MenuEntry.cshtml")
        </div>
    </ej-dialog>
</div>


