<div class="row">

    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="row">
            <div class="col-xs-6 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Module</label>
                    <div class="col-sm-8">
                        <div class="frame">
                            <input e-enabled="{{disable == true?'false':'true'}}" id="ddlModuleList" e-watermarktext="Module" ej-dropdownlist e-datasource="ModuleList" e-enablefiltersearch="true" e-value="menuMaster.ModuleId" e-databound="SelectDefaultValue" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Menu Group</label>
                    <div class="col-sm-8">
                        <div class="frame">
                            <input e-enabled="{{disable == true?'false':'true'}}" id="ddlMenuGroupList" e-watermarktext="Group" ej-dropdownlist e-datasource="menuGroupList" e-enablefiltersearch="true" e-value="menuMaster.MenuGroupId" e-databound="SelectDefaultValue" e-fields-value="Value" e-fields-text="Text" e-width="100%" />

                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Menu Frame</label>
                    <div class="col-sm-8">
                        <div class="frame">
                            <input e-enabled="{{disable == true?'false':'true'}}" id="ddlMenuFrameList" e-watermarktext="Frame" ej-dropdownlist e-datasource="menuFrameList" e-enablefiltersearch="true" e-value="menuMaster.MenuFrameId" e-databound="SelectDefaultValue" e-fields-value="Value" e-fields-text="Text" e-width="100%" />

                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Menu SubGroup</label>
                    <div class="col-sm-8">
                        <div class="frame">
                            <input e-enabled="{{disable == true?'false':'true'}}" id="ddlMenuSubGroupList" e-watermarktext="SubGroup" ej-dropdownlist e-datasource="menuSubGroupList" e-enablefiltersearch="true" e-value="menuMaster.MenuSubGroupId" e-databound="SelectDefaultValue" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-xs-6 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Sequence <sup>*</sup></label>
                    <div class="col-sm-8">
                        <input ng-disabled="disable" type="number" class="form-control" ng-model="menuMaster.Sequence">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Description</label>
                    <div class="col-sm-8">
                        <input type="text" ng-disabled="disable" class="form-control" ng-model="menuMaster.Description">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <input type="text" ng-disabled="disable" class="form-control" ng-model="menuMaster.Remarks">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Panel</label>
                    <div class="col-sm-8">
                        <div class="frame">
                            <div class="select-style">
                                <select ng-disabled="disable" class="form-control" name="Group Name" ng-model="menuMaster.PanelName" tabindex="6" required>
                                    <option value="Application">Application</option>
                                    <option value="Master">Master</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Code</label>
                    <div class="col-sm-8">
                        <input ng-disabled="disable" type="text" class="form-control" ng-model="menuMaster.Code">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">User Define Code</label>
                    <div class="col-sm-8">
                        <input ng-disabled="disable" type="text" class="form-control" ng-model="menuMaster.UserCode">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Controller(As Per Source Code)</label>
                    <div class="col-sm-8">
                        <input ng-disabled="disable" type="text" class="form-control" ng-model="menuMaster.Controller">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Href(As Per Source Code)</label>
                    <div class="col-sm-8">
                        <input ng-disabled="disable" type="text" class="form-control" ng-model="menuMaster.Href">
                    </div>
                </div>
                <div class="form-group">
                    <div class="frame">
                        <div class="ctrllabel">Assign Company Group</div>
                        <ul id="lstCompanyGroup" e-height="60px" ej-listbox e-checkchange="checkChange" e-actioncomplete="onGroupLoad" e-allowmultiselection="true" e-datasource="CompanyGroup" e-showcheckbox="true" e-fields-text="UserName" e-width="100%"></ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 text-right" ng-hide="disable"><button ng-click="add();" class="btn single-small-btn"><i class="glyphicon glyphicon-plus"></i></button></div>
            <div class="col-sm-12 table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Action(As Per Source Code)</th>
                            <th>Display Name</th>
                            <th>Description</th>
                            <th class="col-sm-1 text-right" ng-hide="disable">Remove</th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in actionList" style="background-color:{{(x.Id==null || x.Id=='')?'green':x.Archive==true?'red':'inherit'}}">
                            <td><input ng-disabled="disable" type="text" ng-model="x.Action" class="form-control" maxlength="80" /></td>
                            <td><input ng-disabled="disable" type="text" ng-model="x.UserName" class="form-control" maxlength="80" /></td>
                            <td><input ng-disabled="disable" type="text" ng-model="x.Description" class="form-control"></td>
                            <td class="text-right" ng-hide="disable">
                                <ul class="list-inline">
                                    <li><button ng-click="removePopup(x, $index);" class="btn btn-action tooltip-here"><i class="glyphicon glyphicon-remove"></i></button></li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="row" ng-show="EditButttonShow">
    <div class="col-sm-12">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="saveMenu();" class="btn">{{Action}}</button></li>
            </ul>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="removerPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="removeRow();"></confirm-archive-generic>
<confirm-modal></confirm-modal>
