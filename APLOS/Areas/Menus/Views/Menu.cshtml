<togglable name="Menu"></togglable>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Area<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="model.Area" name="Area" tabindex="1" required>
                        <option value="Accounts">Accounts</option>
                        <option value="Aplos">Aplos</option>
                        <option value="Banks">Banks</option>
                        <option value="Employees">Employees</option>
                        <option value="FixedAssets">FixedAssets</option>
                        <option value="HumanResource">HumanResource</option>
                        <option value="IE">IE</option>
                        <option value="Machines">Machines</option>
                        <option value="Materials">Materials</option>
                        <option value="OrderManagements">OrderManagements</option>
                        <option value="Organizations">Organizations</option>
                        <option value="Parties">Parties</option>
                        <option value="Processes">Processes</option>
                        <option value="Productions">Productions</option>
                        <option value="Products">Products</option>
                        <option value="Projects">Projects</option>
                        <option value="Setups">Setups</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Controller<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Controller" ng-model="model.Controller" class="form-control" maxlength="80" tabindex="3" required />
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">IFCodes</label>
            <div class="col-sm-8">
                <input type="text" ng-model="model.IFCodes" class="form-control" maxlength="8" tabindex="5" />
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="model.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="model.UserName" class="form-control" maxlength="100" tabindex="2" required />
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Href<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Href" ng-model="model.Href" class="form-control" maxlength="50" tabindex="4" required autocomplete="off" />
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="2" ng-model="model.Description" tabindex="6" maxlength="250"></textarea>
            </div>
        </div>
    </div>
    <div class="col-md-12 text-right"><button ng-click="add();" class="btn single-small-btn"><i class="glyphicon glyphicon-plus"></i></button></div>
    <div class="col-sm-12 table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Display Name</th>
                    <th>Description</th>
                    <th class="col-sm-1 text-right">Remove</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in actionList">
                    <td><input type="text" ng-model="x.Action" class="form-control" maxlength="80" /></td>
                    <td><input type="text" ng-model="x.UserName" class="form-control" maxlength="80" /></td>
                    <td><input type="text" ng-model="x.Description" class="form-control"></td>
                    <td class="text-right">
                        <ul class="list-inline">
                            <li><button ng-click="removePopup(x, $index);" class="btn btn-action tooltip-here"><i class="glyphicon glyphicon-remove"></i></button></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="clearfix common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="7"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="8"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select tabindex="18" ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input tabindex="19" type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button tabindex="20" type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Area</th>
                    <th>Controller</th>
                    <th>User Name</th>
                    <th>Href</th>
                    <th>Description</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in menuList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="get($index)">
                    <td>{{x.Id}}</td>
                    <td>{{x.Area}}</td>
                    <td>{{x.Controller}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.Href}}</td>
                    <td>{{x.Description? x.Description:'N/A'}}</td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="removerPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="removeRow();"></confirm-archive-generic>