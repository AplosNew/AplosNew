<h3 class="site-heading" style="cursor:default"><span class="glyphicon glyphicon-info-sign"></span>  Company Group Menu Master</h3>
<div class="form-horizontal form-elements row" ng-form="form">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Company Group</label>
            <div class="col-sm-8 col-md-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="companyGroupMenuMaster.CompanyGroupId" ng-change="getCboModuleByCompanyGroup()"
                            ng-options="item.Value as item.Text for item in companyGroupList" name="Company Group" tabindex="1" required>
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Menu Frame</label>
            <div class="col-sm-8 col-md-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="companyGroupMenuMaster.MenuFrameId" ng-change="getData()"
                            ng-options="item.Value as item.Text for item in menuFrameList|orderBy:'Text'" name="Menu Frame" tabindex="3" required>
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 col-md-4 control-label">Module</label>
            <div class="col-sm-8 col-md-8">
                <div class="select-style">
                    <select class="form-control" ng-model="companyGroupMenuMaster.ModuleId" ng-change="menuFarmeGet()"
                            ng-options="item.Value as item.Text for item in moduleList" name="Module" tabindex="2" required>
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="menuMasters.length>0">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Apply</th>
                <th>Id</th>
                <th>Menu Group</th>
                <th>Menu Subgroup</th>
                <th>Menu Item</th>
                <th>Panel</th>
                <th>External Menu</th>
                <th>Menu Id</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in menuMasters">
                <td>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td>{{x.Id}}</td>
                <td>{{x.MenuGroup? x.MenuGroup:'-'}}</td>
                <td>{{x.MenuSubGroup? x.MenuSubGroup:'-'}}</td>
                <td>{{x.MenuItem}}</td>
                <td>{{x.PanelName}}</td>
                <td>{{x.IsExternalMenu?'Yes':'No'}}</td>
                <td>{{x.MenuId}}</td>
            </tr>
        </tbody>
    </table>
</div>
<div class="common-btn" ng-show="menuMasters.length>0">
    <ul class="list-inline text-right">
        <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="4"></i> Save</button></li>
    </ul>
</div>