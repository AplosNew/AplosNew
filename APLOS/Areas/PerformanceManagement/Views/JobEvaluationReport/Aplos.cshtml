<h3 style="margin-top:5px">Job Evaluation Report</h3>
<style>

    .filled {
        background-color: #ff0000 !important;
    }
</style>
<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script>
@*To Accept only Numbers*@
<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }
</script>
<br />

<div class="form-elements form-horizontal" ng-form name="JobEvaluationReportForm">
    <div class="row" ng-form name="General">
        <input type="hidden" ng-model="JobEvaluationReport.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label" title="Position Code"><span>Position Code</span><sup>*</sup></label>
                <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon">{{JobEvaluationReport.PositionCode}}</span>
                    <input type="text" ng-model="JobEvaluationReport.PositionName" name="Position Name" required class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="PositionPopUp()" tabindex="2" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="PositionClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label" title="Employee"><span>Employee</span></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon" ng-class="{filled:JobEvaluationReport.EmployeeStatus==='Separated'}">{{JobEvaluationReport.EmployeeCode}}</span>
                    <input type="text" ng-model="JobEvaluationReport.ResponsiblePerson" class="form-control" readonly ng-class="{filled:JobEvaluationReport.EmployeeStatus==='Separated'}">
                    <span class="input-group-btn">
                        <button ng-click="ResponsiblePersonPopUp()" tabindex="3" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="ResponsiblePersonClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>

        </div>
        <br />
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Search()" ng-disabled="enable" class="btn" tabindex="5"><i class="glyphicon glyphicon-search"></i>Search</button></li>
            </ul>
        </div>
        <div class="col-xs-12">
            <div style="color:black;" id="SearchedJobEvalReportsTab" ej-grid e-datasource="SearchedJobEvalReportsList"
                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="false" e-filtersettings-filterType="excel">
                <div e-columns>

                    <div e-column e-type="string" e-field="PositionCode" e-headertext="Position Code" e-width="15"></div>
                    <div e-column e-type="string" e-field="PositionName" e-headertext="Position Name" e-width="15"></div>
                    <div e-column e-type="string" e-field="Division" e-headertext="Division" e-width="15"></div>
                    <div e-column e-type="string" e-field="SubDivision" e-headertext="Sub-Division" e-width="15"></div>
                    <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="15"></div>
                    <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="15"></div>
                    <div e-column e-type="string" e-field="SubSection" e-headertext="Sub-Section" e-width="20"></div>
                    <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="20"></div>
                    <div e-column e-type="string" e-field="PerformanceAttribute" e-headertext="Attribute" e-width="20"></div>
                    <div e-column e-type="string" e-field="JECode" e-headertext="JE Code" e-width="20"></div>
                    <div e-column e-type="string" e-field="JEMCCCategory" e-headertext="Category" e-width="20"></div>
                    <div e-column e-type="string" e-field="JEMCCCriteria" e-headertext="Criteria" e-width="20"></div>

                    <div e-column e-type="string" e-field="Dimension1ControlName" e-headertext="Dimension1 Control Name" e-width="15"></div>
                    <div e-column e-type="string" e-field="Dimension1ControlLevel" e-headertext="Dimension1 Control Level" e-width="15"></div>
                    <div e-column e-type="string" e-field="Dimension2ControlName" e-headertext="Dimension2 Control Name" e-width="15"></div>
                    <div e-column e-type="string" e-field="Dimension2ControlLevel" e-headertext="Dimension2 Control Level" e-width="15"></div>
                    <div e-column e-type="string" e-field="JEMCCPoints" e-headertext="Points" e-width="20"></div>

                    <div e-column e-type="string" e-field="Factoring" e-headertext="Factoring" e-width="15"></div>
                    <div e-column e-type="string" e-field="JEPoints" e-headertext="JE Points" e-width="20"></div>
                    <div e-column e-type="string" e-field="JECRemarks" e-headertext="Remarks" e-width="15"></div>

                </div>
            </div>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="GenerateReport()" class="btn" tabindex="6"><i class="glyphicon glyphicon-floppy-disk"></i>Generate</button></li>

                <li> <button ng-click="Clear()" class="btn" tabindex="7"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>

    </div>
    <confirm-modal></confirm-modal>
    <br />

</div>
<div class="modal fade site-modal in" id="PosPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Position List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridPosition" ej-grid e-datasource="PositionList"
                             e-allowfiltering="true" e-recorddoubleclick="setPositionData" e-allowpaging="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>

                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="Position" e-width="140"></div>
                                <div e-column e-type="string" e-field="Division" e-headertext="Division" e-width="140"></div>
                                <div e-column e-type="string" e-field="SubDivision" e-headertext="SubDivision" e-width="140"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-type="string" e-field="Department" e-headertext="Department Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                            </div>

                        </div>

                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>

                            <button ng-click="closePositionPopUp('PosPopUp');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>

</div>

<div class="modal fade site-modal in" id="EmployeePopUpResPerson" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Employee List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridEmployeeResPerson" ej-grid e-datasource="EmpResPersonList"
                             e-allowfiltering="true" e-recorddoubleclick="setEmpData" e-allowpaging="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                                <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="PositionName" e-headertext="Position" e-width="140"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-type="string" e-field="DepartmentName" e-headertext="Department Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeEmpResPersonPopUp('EmployeePopUpResPerson');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>