<togglable name="{{title}}"></togglable>
<style>

    .filled {
        background-color: #ff0000 !important;
    }
</style>
@*To Accept only Numbers with decimals*@
<script>

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }
</script>

<div class="row">
    <div ng-form name="GeneralForm" class="form-elements form-horizontal">
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Evaluation Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Evaluation Date" ng-model="ModelNew.EvaluationDate" datepicker class="form-control" required tabindex="1">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label" title="Evaluator Name"><span>Evaluator Name</span><sup>*</sup></label>
                <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon" ng-class="{filled:ModelNew.EmployeeStatus==='Separated'}">{{ModelNew.EmployeeCode}}</span>
                    <input type="text" ng-model="ModelNew.ResponsiblePerson" name="Evaluator Name" required class="form-control" readonly ng-class="{filled:ModelNew.EmployeeStatus==='Separated'}">
                    <span class="input-group-btn">
                        <button ng-click="ResponsiblePersonPopUp()" tabindex="3" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="ResponsiblePersonClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label" title="Position Code"><span>Position Code</span><sup>*</sup></label>
                <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon">{{ModelNew.PositionCode}}</span>
                    <input type="text" ng-model="ModelNew.PositionName" name="Position Name" required class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="PositionPopUp()" tabindex="2" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="PositionClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label" title="Evaluator Name"><span>Approved By</span><sup>*</sup></label>
                <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon" ng-class="{filled:ModelNew.EmpStatus==='Separated'}">{{ModelNew.EmpCode}}</span>
                    <input type="text" ng-model="ModelNew.ApprovedByName" name="Approved By" required class="form-control" readonly ng-class="{filled:ModelNew.EmpStatus==='Separated'}">
                    <span class="input-group-btn">
                        <button ng-click="ApprovedByPopUp()" tabindex="4" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="ApprovedByClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="5"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="6"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="7"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="form-elements form-horizontal" ng-form id="QMTab">
        <div class="tab-design" id="tab_show">

            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="dimensiondata" role="tab" data-toggle="tab">Job Evaluation Master</a></li>

                </ul>
            </div>

            <div class="tab-content">

                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

                    <div class="row">
                        <div class="form-horizontal form-element-ctrl" ng-form name="JobEvalChildForm">
                            <div class="form-elements">
                                <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Job Evaluation Attribute<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <div class="select-style">
                                                <select class="form-control" ng-model="JobEvalChild.JobEvaluationAttributeId" name="Job Evaluation Attribute" required
                                                        ng-options="item.Value as item.Text for item in JobEvalAttributeList" tabindex="8" ng-change="JobEvalPopUp();">
                                                    <option value="">--Select--</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Job Evaluation Master<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <input type="text" readonly name="Job Evaluation Master" ng-model="JobEvalChild.JobEvalMaster" class="form-control" maxlength="50" required>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Factoring<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <input type="text" name="Factoring" ng-model="JobEvalChild.Factoring" class="form-control" maxlength="15" required tabindex="9" ng-change="CheckFactoring();" onkeypress="return isNumber(event)">
                                        </div>
                                    </div>
                                </div>
                                <div class="clearfix"></div>

                                <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Remarks</label>
                                        <div class="col-sm-8">
                                            <textarea class="form-control" ng-model="JobEvalChild.Remarks" tabindex="10" maxlength="250"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div class="common-btn">
                                <ul class="list-inline text-right">

                                    <li><button ng-click="SaveJobEvalChild();" ng-disabled="ModelNew.Id==null" tabindex="11" class="btn"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>

                                </ul>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div style="color:black;" id="GridJobEvalChildTab" ej-grid e-datasource="SelectedJobEvalChildTabList"
                                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-allowselection="false" e-filtersettings-filterType="excel">
                                <div e-columns>
                                     <div e-column e-type="string" e-field="PerformanceAttribute" e-headertext="Attribute" e-width="20"></div>
                                    <div e-column e-type="string" e-field="JobEvaluationMaster" e-headertext="Job Evaluation Master" e-width="20"></div>
                                    <div e-column e-type="string" e-field="Factoring" e-headertext="Factoring" e-width="15"></div>
                                    <div e-column e-type="string" e-field="Dimension1ControlName" e-headertext="Dimension1 Control Name" e-width="20"></div>
                                    <div e-column e-type="string" e-field="Dimension1ControlLevel" e-headertext="Dimension1 Control Level" e-width="20"></div>
                                    <div e-column e-type="string" e-field="Dimension2ControlName" e-headertext="Dimension2 Control Name" e-width="20"></div>
                                    <div e-column e-type="string" e-field="Dimension2ControlLevel" e-headertext="Dimension2 Control Level" e-width="20"></div>
                                    <div e-column e-type="string" e-field="DimPoints" e-headertext="Dimension Points" e-width="15"></div>
                                    <div e-column e-type="string" e-field="Category" e-headertext="Category" e-width="20"></div>
                                    <div e-column e-type="string" e-field="Criteria" e-headertext="Criteria" e-width="20"></div>
                                    <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="15"></div>
                                    <div e-column e-type="string" e-field="Points" e-headertext="Points" e-width="15"></div>
                                    <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="20"></div>

                                    <div e-column e-template="#DeleteJobEvaluationChildTab" e-width="15"></div>
                                </div>
                            </div>

                            <script type="text/template" id="DeleteJobEvaluationChildTab">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li><button ng-click="$parent.ConfirmDeleteJobEvaluationChildTab(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                    </ul>
                                </div>
                            </script>

                        </div>
                    </div>
                </div>
            </div>


        </div>

    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="JobEvalDate" e-headertext="Evaluation Date" e-width="3"></div>
            <div e-column e-field="Position" e-headertext="Position Name" e-width="4"></div>
            <div e-column e-field="PositionCode" e-headertext="Position Code" e-width="3"></div>
            <div e-column e-field="Division" e-headertext="Division" e-width="3"></div>
            <div e-column e-field="Department" e-headertext="Department" e-width="3"></div>
            <div e-column e-field="ResponsiblePerson" e-headertext="Evaluator Name" e-width="4"></div>
            <div e-column e-field="ApprovedByName" e-headertext="Approved By" e-width="4"></div>

        </div>
    </div>
</div>
