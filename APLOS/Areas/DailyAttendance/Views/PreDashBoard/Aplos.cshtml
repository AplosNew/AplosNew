<div id="ModalSelfDocument" class="modal fade site-modal in" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" onload="AutoRefresh(120000);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">×</button>
                <h5 class="modal-title" id="myModalLabel"><u><strong>List of Self Document</strong></u></h5>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>
                                <span style="color:#1abc9c">Emp. Id:</span>{{empId}} |
                                <span style="color:#1abc9c">
                                    Emp. Name:
                                </span>{{empName}} |
                                <span style="color:#1abc9c"> Given Desig.:</span>{{GivenDesignation}}
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="modal-body table-responsive modal-table" style="overflow-y:scroll; max-height:375px;">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Document Name</th>
                            <th>Category of the Document</th>
                            <th>Uploaded</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="y in IntervieweeWiseDocList">
                            <td>{{y.docName}}</td>
                            <td>{{y.OptionalOrMandatory}}</td>
                            <td ng-class="{nSubmitted:y.UploadStatus == 'No',Submitted:y.UploadStatus != 'No'}">{{y.UploadStatus}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

