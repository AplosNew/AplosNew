                                <input style="color:black !important;" ng-model="search.FullName">
                            </th>
                            <th ng-click="sortBy('BudgetId')">
                                Budget Code<span class="verticalLine"></span>&nbsp;<span class="sortorder" ng-show="propertyName === 'BudgetId'" ng-class="{reverse: reverse}"></span>
                                <input style="color:black !important;" ng-model="search.BudgetId">
                            <th ng-click="sortBy('GivenDesignation')">
                                Given Designation<span class="verticalLine"></span>&nbsp;<span class="sortorder" ng-show="propertyName === 'GivenDesignation'" ng-class="{reverse: reverse}"></span>
                                <input style="color:black !important;" ng-model="search.GivenDesignation">
                            </th>
                            <th ng-click="sortBy('Designation')">
                                Designation<span class="verticalLine"></span>&nbsp;<span class="sortorder" ng-show="propertyName === 'Designation'" ng-class="{reverse: reverse}"></span>
                                <input style="color:black !important;" ng-model="search.Designation">
                            </th>
                            <th ng-click="sortBy('TotalFileSelfPanding')">Self  Documents-Not Uploaded<span class="verticalLine"></span>&nbsp;<span class="sortorder" ng-show="propertyName === 'TotalFileSelfPanding'" ng-class="{reverse: reverse}"></span></th>
                            <th ng-click="sortBy('TotalFileDeptPanding')">Dept/ORG. Documents-Not Uploaded<span class="verticalLine"></span>&nbsp;<span class="sortorder" ng-show="propertyName === 'TotalFileDeptPanding'" ng-class="{reverse: reverse}"></span></th>

                            <th ng-click="sortBy('TotalFileSelf')">Self Documents-Uploaded<span class="verticalLine"></span>&nbsp;<span class="sortorder" ng-show="propertyName === 'TotalFileSelf'" ng-class="{reverse: reverse}"></span></th>
                            <th ng-click="sortBy('TotalFileDept')">Dept/ORG. Documents-Uploaded<span class="verticalLine"></span>&nbsp;<span class="sortorder" ng-show="propertyName === 'TotalFileDept'" ng-class="{reverse: reverse}"></span></th>

                            <th ng-repeat="x in ColList" ng-show="x.Sequence > -2">
                                {{x.ColumnName}}
                            </th>
                            <th @*ng-click="sortBy('EmpCategory')"*@>Employee Category@*<span class="verticalLine"></span>*@&nbsp;<span class="sortorder" ng-show="propertyName === 'EmpCategory'" ng-class="{reverse: reverse}"></span></th>
                            <th @*ng-click="sortBy('DesigNationGroup')"*@>Designation Group@*<span class="verticalLine"></span>*@&nbsp;<span class="sortorder" ng-show="propertyName === 'DesigNationGroup'" ng-class="{reverse: reverse}"></span></th>
                        </tr>
                    </thead>
                    <tbody id="searchTextResults">
                        <tr dir-paginate="x in SelITList| orderBy:propertyName:reverse| filter:search:strict|itemsPerPage:projectPlanningListParametersSTI.pageSize" total-items="projectPlanningListParametersSTI.total_count" pagination-id="metaData.name + 'SelITList'" ng-class="{'selected':$index == selectedRow}" ng-click="setClickedRowSTI($index)">

                            <td>{{x.RowNum}}</td>
                            <td>{{x.Id}}</td>
                            <td>{{x.EmployeeCode}}</td>
                            <td>{{x.FullName}}</td>
                            <td ng-class="{exceess: x.GivenDesignation != x.Designation}">{{x.BudgetId}}</td>
                            <td>{{x.GivenDesignation}}</td>
                            <td>{{x.Designation}}</td>
                            <td ng-click="IntervieweeWiseDocSelfNU(x);" style="cursor:pointer;" onmouseover='this.style.backgroundColor = "blue";' onmouseout='this.style.backgroundColor=""'><span ng-class="{redFont:x.TotalFileSelfPanding>0}"><b><u>{{x.TotalFileSelfPanding}}</u></b></span>  </td>
                            <td ng-click="IntervieweeWiseDocDeptNU(x);" style="cursor:pointer;" onmouseover='this.style.backgroundColor = "blue";' onmouseout='this.style.backgroundColor=""'>
                                <span ng-class="{redFont:x.TotalFileDeptPanding>0}"><b><u>{{x.TotalFileDeptPanding}}</u></b></span>
                            </td>
                            <td ng-click="modalIntervieweeWiseDoc(x)" style="cursor:pointer;" onmouseover='this.style.backgroundColor = "blue";' onmouseout='this.style.backgroundColor=""'>
                                <span ng-class="{greenFont:x.TotalFileSelf>0}"><b><u>{{x.TotalFileSelf}}</u></b></span>
                            </td>
                            <td ng-click="IntervieweeWiseDocDept(x);" style="cursor:pointer;" onmouseover='this.style.backgroundColor = "blue";' onmouseout='this.style.backgroundColor=""'>
                                <span ng-class="{greenFont:x.TotalFileDept>0}"><b><u>{{x.TotalFileDept}}</u></b></span>
                            </td>
                            <td ng-repeat="y in ColList" ng-show="y.Sequence > -2">
                                {{x[y.ColumnName]}}
                            </td>
                            <td>{{x.EmpCategory}}</td>
                            <td>{{x.DesigNationGroup}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer common-btn">
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'SelITList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="GetProjectPlanningListDataSTI(newPageNumber)">
                </dir-pagination-controls>
                <div class="row">
                    <div class="col-md-6 table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th colspan="2">
                                        <div data-placement="bottom" title="Total Documents(Mandatory)" tooltip>Total Doc.(M)</div>
                                    </th>
                                    <th colspan="2">
                                        <div data-placement="bottom" title=" Pending Documents(Mandatory)" tooltip>Pending Doc.(M)</div>
                                    </th>
                                    <th colspan="2">
                                        <div data-placement="bottom" title=" Total Documents(Optional)" tooltip>Total Doc.(O)</div>
                                    </th>
                                    <th colspan="2">
                                        <div data-placement="bottom" title=" Pending Documents(Optional)" tooltip>Pending Doc.(O)</div>
                                    </th>
                                </tr>
                                <tr>
                                    <th>Self</th>
                                    <th><div data-placement="top" title="Department" tooltip>Dept.</div></th>
                                    <th>Self</th>
                                    <th><div data-placement="top" title="Department" tooltip>Dept.</div></th>
                                    <th>Self</th>
                                    <th><div data-placement="top" title="Department" tooltip>Dept.</div></th>
                                    <th>Self</th>
                                    <th><div data-placement="top" title="Department" tooltip>Dept.</div></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in docStatList">
                                    <td>{{x.totalDocMandtSelf}}</td>
                                    <td>{{x.totalDocMandtDept}}</td>
                                    <td>{{x.totalDocMandtpandingSelf}}</td>
                                    <td>{{x.totalDocMandtpandingDept}}</td>
                                    <td>{{x.totalDocOptSelf}}</td>
                                    <td>{{x.totalDocOptDept}}</td>
                                    <td>{{x.totalDocOptpandingSelf}}</td>
                                    <td>{{x.totalDocOptpandingDept}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-3">
                    </div>
                    <div class="col-md-3">
                        <table class="table table-striped" style="border:none !important">
                            <tbody>
                                <tr>
                                    <td>Mismatched Designation</td>
                                    <td> <span style="background-color:orangered;"> &nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <button type="button" class="btn" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

