    <meta charset="utf-8" />
    <base href="@ViewBag.BasePath">
    <title>{{title}}</title>
    <link rel="shortcut icon" href="images/title.gif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    @Scripts.Render("~/bundles/jq")
    @Scripts.Render("~/bundles/angular")
    @Scripts.Render("~/bundles/recruitment")
</head>
<body ng-controller="dailyAttdInOutController">
    <nav class="navbar navbar-default navbar-fixed-top navbar-site">
        <div class="container-fluid">
            <div class="navbar-header">
                <a href="{{bootPoint}}" class="navbar-brand">
                    <img class="logo" src="images/aplos-logo.png" alt="Logo">
                    <span style="font-size: 8px;">V-@typeof(WebApiApplication).Assembly.GetName().Version</span>
                    <span style="font-size: 9px;text-transform: none;color:white">aPOP</span>
                </a>
            </div>
            <div class="navbar-collapse collapse" id="navbar">
                <ul class="nav navbar-nav navbar-right">
                    <li class="dropdown">
                        <a href="" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                            <img class="img-responsive img-circle" ng-src="" style="height:30px;display:inline;" />&nbsp;<b>Welcome</b> &nbsp;{{FullName}} <i class="fa fa-angle-down"></i>
                            <img class="logo" src="{{CompanyGroupLogo}}" style="height:25px">
                        </a>
                        <ul class="dropdown-menu">
                            <li><a ng-click="Logout()" href=""><i class="fa fa-power-off"></i>  Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container-fluid" id="main" style="overflow-y: auto; height: 600px;">
        <div class="row">
