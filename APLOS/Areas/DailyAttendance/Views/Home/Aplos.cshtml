                <div class="inner-content">
                    <style>
                        #accordion section, #accordion .pointer, #accordion h1, #accordion p {
                            -webkit-transition: all 0.20s ease-in-out;
                            -moz-transition: all 0.5s ease-in-out;
                            transition: all 0.5s ease-in-out;
                        }

                        #accordion {
                            margin-bottom: 30px;
                        }

                            #accordion h1 {
                                line-height: 1.2;
                                font-size: 15px;
                                background-color: #3e445a;
                                margin: 0;
                                padding: 10px 10px 10px 30px;
                            }

                                #accordion h1 a {
                                    color: #fff;
                                }

                            #accordion section {
                                overflow: hidden;
                            }

                            #accordion p {
                                padding: 0 10px;
                                color: #fff;
                            }

                            #accordion section.ac_hidden p:not(.pointer) {
                                color: #fff;
                            }

                            #accordion section.ac_hidden {
                                height: 44px;
                            }

                            #accordion .pointer {
                                padding: 0;
                                margin: 10px 0 0 6px;
                                line-height: 20px;
                                width: 13px;
                                position: absolute;
                            }

                            #accordion section:not(.ac_hidden) h1 {
                                background-color: #204d74;
                            }

                            #accordion section:not(.ac_hidden) .pointer {
                                display: block;
                                -webkit-transform: rotate(90deg);
                                -moz-transform: rotate(90deg);
                                -o-transform: rotate(90deg);
                                transform: rotate(90deg);
                                padding: 0;
                            }

                        #drpdwnfont {
                            color: #95a5a6;
                        }

                        html {
                            overflow: scroll;
                        }

                        .filled {
                            background-color: #0dbe67 !important;
                        }
                    </style>
                    <h3 class="site-heading">
                        <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> My Information<label style="float:right">{{message}}</label>
                    </h3>
