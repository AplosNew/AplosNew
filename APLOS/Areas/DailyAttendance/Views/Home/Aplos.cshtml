                                                        <input type="text" name="Special Review Duration" ng-model="preRecruitmentEmployee.SpecialReviewDuration" class="form-control" ng-disabled="true" tabindex="1">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                                    <div class="row">
                                        <div class="table-responsive modal-table">
                                        </div>
                                        <div>
                                            <label style="text-align:center">&nbsp;&nbsp;&nbsp;&nbsp; Job Description</label>
                                        </div>
                                        <ul class="list-inline text-left" ng-repeat="jd in jobDescriptions">
                                            <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <i class="glyphicon glyphicon-record"></i> &nbsp;&nbsp;  {{jd.JobDescription}}</li>
                                        </ul>
                                    </div>
                                </div>
                                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                                    <div class="table-responsive modal-table">
                                        <table class="table table-striped" ng-show="documentdataList.length>0">
                                            <thead>
                                                <tr>
                                                    <th>Document Name</th>
                                                    <th>Documentation By</th>
                                                    <th>Emp Type</th>
                                                    <th>Candidate Category</th>
                                                    <th>Optional Or Mandatory</th>
                                                    <th>Skill Based</th>
                                                    <th>Due Date</th>
                                                    <th>File Name</th>
                                                    <th>File</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat="d in documentdataList">
                                                    <td>{{d.DocumentName}}</td>
                                                    <td>{{d.DocumentationBy}}</td>
                                                    <td>{{d.EmpType}}</td>
                                                    <td>{{d.EmployeeCategory}}</td>
                                                    <td>{{d.OptionalOrMandatory}}</td>
                                                    <td>{{d.IsSkillBased?'Yes':'No'}}</td>
                                                    <td>{{d.DueDate | dateFiltering}}</td>
                                                    <td ng-click="DocDownload(d)"><a href="{{dwonloadUrl}}" style="text-decoration:underline" download="{{d.FileName}}" target="_self">{{d.FileName}}</a></td>
                                                    <td>
                                                        <button ng-click="DocShow(d);" ng-class="getColor(d)" class="btn" ng-disabled="disableBtn();savedisable"><i class="fa fa-paperclip"></i> Document</button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                                    <div class="tab-design">
                                        <div class="site-tab">
                                            <ul class="nav nav-tabs" role="tablist">
                                                <li role="presentation" ng-class="{ active: isSet2(6) }"><a ng-click="setTab2(6)" href="" aria-controls="monthly" role="tab" data-toggle="tab2">Monthly Cash</a></li>
                                                <li role="presentation" ng-class="{ active: isSet2(7) }"><a ng-click="setTab2(7)" href="" aria-controls="annualCash" role="tab" data-toggle="tab2">Annual Cash</a></li>
                                                <li role="presentation" ng-class="{ active: isSet2(8) }"><a ng-click="setTab2(8)" href="" aria-controls="annualNonCash" role="tab" data-toggle="tab2">Annual Non-Cash</a></li>
                                                <li role="presentation" ng-class="{ active: isSet2(9) }"><a ng-click="setTab2(9)" href="" aria-controls="leave" role="tab" data-toggle="tab2">Leave</a></li>
                                            </ul>
                                        </div>
                                        <div class="tab-content">
                                            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(6), active: isSet2(6) }">
                                                <div class="row">
                                                    <div class="table-responsive modal-table col-md-12">
                                                        <table class="table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th>Salary Head</th>
                                                                    <th>Current Amount</th>
                                                                    <th>Expected Amount</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr ng-repeat="dr in salaryHeadListMonth">
                                                                    <td>{{dr.SalaryHead}}</td>
                                                                    <td><input type="text" class="form-control" style="height: 25px;" ng-model="dr.CurrentAmount" /></td>
                                                                    <td><input type="text" class="form-control" style="height: 25px;" ng-model="dr.ExpectedAmount" /></td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(7), active: isSet2(7) }">
                                                <div class="row">
                                                    <div class="table-responsive modal-table col-md-12">
                                                        <table class="table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th>Salary Head</th>
                                                                    <th>Current Amount</th>
                                                                    <th>Expected Amount</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr ng-repeat="dr in salaryHeadListAc">
                                                                    <td>{{dr.SalaryHead}}</td>
                                                                    <td><input type="text" class="form-control" style="height: 25px;" ng-model="dr.CurrentAmount" /></td>
                                                                    <td><input type="text" class="form-control" style="height: 25px;" ng-model="dr.ExpectedAmount" /></td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(8), active: isSet2(8) }">
                                                <div class="row">
                                                    <div class="table-responsive modal-table col-md-12">
                                                        <table class="table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th>Salary Head</th>
                                                                    <th>Current Status</th>
                                                                    <th>Expected Status</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr ng-repeat="dr in salaryHeadListAnc">
                                                                    <td>{{dr.SalaryHead}}</td>
                                                                    <td>
                                                                        <div class="checkbox-site">
                                                                            <label>
                                                                                <input type="checkbox" ng-model="dr.CurrentStatus">
                                                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                                            </label>
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <div class="checkbox-site">
                                                                            <label>
                                                                                <input type="checkbox" ng-model="dr.ExpectedStatus">
                                                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                                            </label>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(9), active: isSet2(9) }">
                                                <div class="row">
                                                    <div class="table-responsive modal-table col-md-12">
                                                        <table class="table table-striped">
                                                            <thead>
                                                                <tr>
                                                                    <th>Salary Head</th>
                                                                    <th>Current Status</th>
                                                                    <th>Expected Status</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr ng-repeat="dr in salaryHeadListLeave">
                                                                    <td>{{dr.SalaryHead}}</td>
                                                                    <td>
                                                                        <div class="checkbox-site">
                                                                            <label>
                                                                                <input type="checkbox" ng-model="dr.CurrentStatus">
                                                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                                            </label>
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <div class="checkbox-site">
                                                                            <label>
                                                                                <input type="checkbox" ng-model="dr.ExpectedStatus">
                                                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                                            </label>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="common-btn" style="padding-right:18px">
                                            <ul class="list-inline text-right">
                                                <li> <button ng-click="SaveSalary();" ng-disabled="disableBtn();savedisable" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                                <li>
                                                    <button style="background:#EA6153;border:#EA6153;" ng-click="confirmSubmit()" ng-disabled="disableBtn();savedisable" class="btn tooltip-here" data-placement="top" title="Submit">
                                                        <i class="glyphicon glyphicon-briefcase"></i> Submit
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <confirm-modal></confirm-modal>
                    <script>
                        $(document).ready(function () {
                            $("#accordion section h1").click(function (e) {
                                if (!$(this).closest('section').hasClass('ac_hidden')) {
                                    $(this).closest("section").addClass("ac_hidden");
                                } else {
                                    $(this).closest("section").siblings().addClass("ac_hidden");
                                    $(this).closest("section").removeClass("ac_hidden");
                                }
                                e.preventDefault();
                            });
                        });
                    </script>
                    <div class="modal fade site-modal in" id="DocPopUp" role="dialog" data-backdrop="static">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    <h4 class="modal-title">Add Document</h4>
                                </div>
                                <div class="modal-body">
                                    <div class="row form-elements form-horizontal">
                                        <div class="col-xs-12 col-sm-6 col-md-6">
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label">Document Name</label>
                                                <div class="col-sm-8">
                                                    <input type="text" name="Document Name" ng-model="documentdata.DocumentName" readonly class="form-control" tabindex="72">
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label">Employee Category</label>
                                                <div class="col-sm-8">
                                                    <input type="text" name="Employee Category" ng-model="documentdata.EmployeeCategory" readonly class="form-control" tabindex="74">
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <div class="inputBtnSection common-btn">
                                                    <label class="fileUpload col-sm-4 ">
                                                        <input id="uploadBtn4" type="file" name="file[]" class="upload" />
                                                        <span class="uploadBtn"><i class="fa fa-paperclip" aria-hidden="true"> Attach</i></span>
                                                    </label>
                                                    <div class="col-sm-6" style="width: 198px;">
                                                        <input type="text" id="uploadFile4" ng-model="documentdata.FileName" name="uploadFile4" class="disableInputField form-control" disabled="disabled" style="width: 183px;" />
                                                    </div>
                                                    <div class="col-sm-2" style="padding-left:0px;">
                                                        <button ng-click="DocumentRemove(documentdata.Id);" class="btn" ng-disabled="disableBtn();savedisable" style="height: 31px;width: 88px;padding-left: 8px;background: #242841;"><i class="fa fa-chain-broken" aria-hidden="true"></i> Detach</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-xs-12 col-sm-6 col-md-6">
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label">Emp Type</label>
                                                <div class="col-sm-8">
                                                    <input type="text" name="Emp Type" ng-model="documentdata.EmpType" readonly class="form-control" tabindex="74">
                                                </div>
                                            </div>
                                            <div class="form-group" ng-show="documentdata.DocNumberRequired===true">
                                                <label class="col-sm-4 control-label">Document Number<sup>*</sup></label>
                                                <div class="col-sm-8">
                                                    <input type="text" name="Document Number" ng-model="documentdata.DocNumber" class="form-control" tabindex="72" ng-disabled="fg">
                                                </div>
                                            </div>
                                            <div class="form-group" ng-show="documentdata.DocDateRequired===true">
                                                <label class="col-sm-4 control-label">Document Date<sup>*</sup></label>
                                                <div class="col-sm-8">
                                                    <input type="text" ng-model="documentdata.DocDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="10">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="common-btn">
                                        <ul class="list-inline text-right">
                                            <li> <button ng-click="SaveDocument();" class="btn" ng-disabled="disableBtn();savedisable"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <confirm-archive-generic data-modalid="confirmSubmit" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Submit()"></confirm-archive-generic>
                    <confirm-archive-generic data-modalid="confirmQualificationDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteQualification()"></confirm-archive-generic>
                    <confirm-archive-generic data-modalid="confirmTrainingDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteTraining()"></confirm-archive-generic>
                    <confirm-archive-generic data-modalid="confirmExperienceDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteExperience()"></confirm-archive-generic>
                    <confirm-archive-generic modalid="confirmQualiDelete" title="Confirmation" data-ng-click-left-button="confirmCloseQualificationDelete()" message={{message_confirmation}} data-ng-click-right-button="removeQualification()"></confirm-archive-generic>
                    <confirm-archive-generic modalid="confirmTrainDelete" title="Confirmation" data-ng-click-left-button="confirmCloseTrainingDelete()" message={{message_confirmation}} data-ng-click-right-button="removeTraining()"></confirm-archive-generic>
                    <confirm-archive-generic modalid="confirmExpDelete" title="Confirmation" data-ng-click-left-button="confirmCloseExperienceDelete()" message={{message_confirmation}} data-ng-click-right-button="removeExperience()"></confirm-archive-generic>
                    <confirm-archive-generic modalid="confirmDocDelete" title="Confirmation" data-ng-click-left-button="confirmCloseDocDelete()" message={{message_confirmation}} data-ng-click-right-button="removeDoc()"></confirm-archive-generic>
                </div>
            </div>
        </div>
    </div>
    <noscript>
        JavaScript is disable in your browser. Please enable from browser settings.
    </noscript>
    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
</body>
</html>