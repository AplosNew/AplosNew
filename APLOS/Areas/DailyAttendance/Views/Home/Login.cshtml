@{
    ViewBag.Title = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" ng-app="dailyattendanceApp" spellcheck="true">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta charset="utf-8" />
    <title>Login</title>
    <link rel="shortcut icon" href="images/title.gif" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    @Scripts.Render("~/bundles/jq")
    @Scripts.Render("~/bundles/angular")
    @Scripts.Render("~/bundles/recruitment")
</head>
<body class="login-bg" ng-controller="dailyAttendanceInOutLoginController">
    <noscript>
        JavaScript is disable in your browser. Please enable from browser settings.
    </noscript>
    <div class="login-content" ng-form name="">
        <form class="login-inner" autocomplete="off">
            <p id="error" class="login-error" ng-show="errorText!=null">{{errorText}}</p>
            <h4>Please login your account</h4>
            <div class="form-group" show-errors>
                <div class="input-group show-message" ng-init="model.Id='@ViewBag.Id'">
                    <span class="input-group-addon"><span class="glyphicon glyphicon-user"></span></span>
                    <input tabindex="1" type="text" class="form-control" ng-model="model.Id" placeholder="Id" required />
                </div>
            </div>
            <div class="form-group" show-errors>
                <div class="input-group show-message">
                    <span class="input-group-addon"><span class="glyphicon glyphicon-lock"></span></span>
                    <input tabindex="2" ng-enter="Login()" type="password" ng-model="model.Pin" class="form-control" placeholder="PIN" name="InitialPIN" id="InitialPIN" required />
                </div>
            </div>
            <div class="checkbox"></div>
            <button tabindex="3" type="button" class="btn btn-default pull-right" ng-click="Login()"><span class="glyphicon glyphicon-log-in"></span> Login</button>
        </form>
    </div>
    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
</body>
</html>
