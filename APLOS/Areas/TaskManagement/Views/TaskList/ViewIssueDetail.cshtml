<div class="form-elements  form-horizontal" id="editTaskPanel">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6 ">
            <table>
                <tr>
                    <td style="width:30px;">
                        <i style="color:blue;font-size:.6em;">Assigned By</i>
                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoIssueDisplayModel.AssignByEmpPicPath}}"
                             style=" height:50px;width:50px; border-radius:50%;" />
                    </td>
                    <td style="width:70px;"><label>{{ToDoIssueDisplayModel.AssignByEmployeeCode}}</label></td>
                    <td><label>{{ToDoIssueDisplayModel.AssignByEmployeeName}}</label></td>
                </tr>
                <tr>
                    <td style="width:30px;">
                        <i style="color:blue;font-size:.6em;">Update By</i>
                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoIssueDisplayModel.UpdateEmpPicPath}}"
                             style=" height:50px;width:50px; border-radius:50%;" />
                    </td>
                    <td style="width:50px;"><label>{{ToDoIssueDisplayModel.UpdateEmployeeCode}}</label></td>
                    <td><label>{{ToDoIssueDisplayModel.UpdateEmployeeName}}</label></td>
                </tr>
                <tr>
                    <td style="width:30px;">
                        <i style="color:blue;font-size:.6em;">Int. Auditor</i>
                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoIssueDisplayModel.InternalEmpPicPath}}"
