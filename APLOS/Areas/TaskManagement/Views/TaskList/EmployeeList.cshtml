<div class="form-elements" id="employeetemplateddl">

    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Set Date</label>
            <div class="col-sm-8">
                <input e-dateformat="dd-MMM-yyyy" e-enabled="true" ej-datetimepicker e-value="displayModel.MainRawMaterialInhouseDate" e-width="100%" />
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Notes</label>
            <div class="col-sm-8 control-label">
                <input type="text" class="form-control" rows="2" ng-model="snapshotmasterNew.SnapshotName" maxlength="250" />
            </div>
        </div>
       
    </div>

    
</div>

