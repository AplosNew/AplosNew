
<div class="col-sm-12">

    <div class="form-elements form-horizontal">
        <div class="col-xs-12 col-sm-12 col-md-12" style="padding:0px;margin:0px;">
            <div id="groupButtonForFilter" ej-groupbutton e-groupbuttonmode="radiobutton" @*e-width="700px"*@ e-select="ToDoFilter" e-showroundedcorner="false" e-enabletouch="true" e-datasource="TaskinstantFilterMain"></div>

        </div>
        <style type="text/css">
            .e-grid .e-toolbar.e-toolbarspan .e-gridsearchbar {
                width: 400px;
                padding: 0px;
            }

            .tooltipAplos {
                position: relative;
                display: inline-block;
                text-align: justify;
            }

                .tooltipAplos .tooltipAplostext {
                    content: "";
                    display: inline-block;
                    width: 200px;
                    visibility: hidden;
                    background-color: black;
                    color: #fff;
                    text-align: center;
                    border-radius: 6px;
                    padding: 5px 0;
                    position: absolute;
                    z-index: 11111111;
                    top: -5px;
                    right: 110%;
                }

                    .tooltipAplos .tooltipAplostext::after {
                        display: inline-block;
                        width: 100%;
                        content: "";
                        position: absolute;
                        top: 50%;
                        left: 100%;
                        margin-top: -5px;
                        border-width: 5px;
                        border-style: solid;
                        border-color: transparent transparent transparent black;
                    }

                .tooltipAplos:hover .tooltipAplostext {
                    visibility: visible;
                }

            .blue {
                color: blue;
            }

            .red {
                color: red;
            }
        </style>
        <div id="GridIssueTransaction" ng-init="chkinit()" e-textwrapsettings-wrapmode="content" ej-grid e-datasource="issueTransactionList"
             e-recorddoubleclick="Get" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="false" e-filtersettings-filterType="excel" e-gridlines="horizontal" e-querycellinfo="queryCellInfo" e-toolbarclick="TaskListToolbarClick"
             e-pagesettings-pagesize="10" e-toolbarsettings="TaskListToolbarSettings">
            <div e-columns>
                <div e-column e-template="#tasksTemplateCheckIssue" e-textalign="center" e-width="4"></div>
                <div e-column e-headertext="" e-template="#taskDetailTemplate" e-textalign="center" e-width="76"></div>
                <div e-column e-headertext="" e-template="#ColPriority" e-textalign="center" e-width="20"></div>
            </div>
        </div>
        <script type="text/x-jsrender" id="AdditionalFilter">
            <div class="glyphicon glyphicon-filter text-center" style="width:36px;height:22px; padding-top:4px; padding-right:4px;"></div>
        </script>
        <script type="text/x-jsrender" id="ClearAdditionalFilter">
            <div class="glyphicon glyphicon-erase text-center" style="width:36px;height:22px; padding-top:4px; padding-right:4px;"></div>
        </script>
        <script type="text/template" id="tasksTemplateCheckIssue">
            <input type="checkbox" @*e-enabled="{{data.CurrentStatus!='ToClose'}}"*@ e-checked="{{((data.CurrentStatus=='Closed' || data.isDone==true)||(data.AssignToId==$parent.EMPID && data.CurrentStatus=='ToClose'))?'true':'false'}}" ej-checkbox class="nodetext" e-change="$parent.UpdateToDoMasterCurrentStatus" />
        </script>

        <script type="text/template" id="taskDetailTemplate">


            <div class="col-xs-12 col-sm-1 col-md-1 text-left" style="padding:0px;margin:0px;">
                <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{data.AssignToId!=data.CreatedById && data.AssignToId==$parent.EMPID?data.EmpPicPathAssignBy:data.EmpPicPath}}"
                     style="float:left;position:absolute; height:40px;width:40px;border:2px solid #efefef; border-radius:50%;" />


            </div>
            <div class="col-xs-12 col-sm-10 col-md-10  text-left" style="padding-left:4px;margin:0px;">

                <div class="row" style="padding:0px;margin:0px;">

                    <div class="col-xs-12" style="padding:0px;margin:0px;">
                        <div class="row" style="padding: 2px;">
                            @*<span style="color:mediumblue; font-size:small;">
                                    <span>{{data.TaskType==null?'':data.TaskType+'&rarr;'}}</span>
                                    {{data.TaskCategory==null||data.TaskCategory==''?'':data.TaskCategory+'&rarr;'}} <span>  {{data.TaskSubCategory==null || data.TaskSubCategory==''?'':data.TaskSubCategory+'&rarr;'}}</span>
                                </span><span style="font-weight:{{(data.CreatedById!=$parent.EMPID && data.IsRead==false)?'bold':'regular'}}"> {{data.TaskDescription}} {{data.BuyerName}}  </span>*@

                            <span style="color:mediumblue; font-size:small;">
                                <span>{{data.TaskType==null?'':data.TaskType+'&rarr;'}}</span>
                            </span><span style="font-weight:{{(data.CreatedById!=$parent.EMPID && data.IsRead==false)?'bold':'regular'}}"> {{data.TaskDescription}}</span>

                            <br />

                        </div>
                        <div class="row small" style="padding:2px;">
                            <span style="color:darkorchid;">
                                {{(data.AssignToId==$parent.EMPID && data.AssignToId==data.CreatedById)?'My Task':
                                        (data.AssignToId!=$parent.EMPID && data.AssignToId==data.CreatedById)?data.AssignTo==null?'':'Own Task by '+data.AssignTo:

                                        data.AssignToId!=data.CreatedById && data.AssignToId==$parent.EMPID?data.CreatedBy==null?'':'Assigned to me By '+data.CreatedBy:
                                        data.CreatedById==$parent.EMPID && data.AssignToId!=$parent.EMPID?data.AssignTo==null?'':'Assigned to '+data.AssignTo:
                                        data.CreatedById!=$parent.EMPID && data.AssignToId!=data.CreatedById && data.AssignToId!=$parent.EMPID?(data.AssignTo==null?'':'Assigned To ' +data.AssignTo)+ ' '+ (data.CreatedBy==null?'':' By '+data.CreatedBy):''}}
                                <i style="color:#5d5d5d">  {{data.TaskAddedDate}}</i>
                            </span>

                        </div>



                    </div>

                </div>

            </div>

            <div class="col-xs-12 col-sm-1 col-md-1 text-right" style="padding:0px;margin:0px;overflow:visible;">

                <span style="color:{{data.Auth[1].AuditId==null?'lightgrey':data.Auth[1].isDone==false?'red':'green'}}; padding:2px;">
                    <span class="tooltipAplos">
                        <span class="glyphicon glyphicon-ok"></span>
                        <span class="tooltipAplostext">Check By: {{data.Auth[1].EmployeeName}}</span>
                    </span>
                </span>

                <span style="color:{{data.Auth[2].AuditId==null?'lightgrey':data.Auth[2].isDone==false?'red':'green'}}; padding:2px;">
                    <span class="tooltipAplos">
                        <span class="glyphicon glyphicon-check"></span>
                        <span class="tooltipAplostext">Cross-Check By: {{data.Auth[2].EmployeeName}}</span>
                    </span>
                </span>

                <span style="color:{{data.Auth[0].AuditId==null?'lightgrey':data.Auth[0].isDone==false?'red':'green'}}; padding:2px;">
                    <span class="tooltipAplos">
                        <span class="glyphicon glyphicon-pawn"></span>
                        <span class="tooltipAplostext">Approve By: {{data.Auth[0].EmployeeName}}</span>
                    </span>
                </span>


            </div>

        </script>



        <script type="text/template" id="ColPriority">

            <div class="col-xs-12 col-sm-12 col-md-12 text-right">

                <div style="float:right;vertical-align:top;position:absolute;font-size:20px;">



                    <span>
                        <span class="{{
                              data.AuthorizationType=='CheckBy'?'glyphicon glyphicon-ok':
                              data.AuthorizationType=='CrossCheckBy'?'glyphicon glyphicon-check':
                              data.AuthorizationType=='ApproveBy'?'glyphicon glyphicon-pawn':
                              data.AuthorizationType=='AssignTo' && data.AssignToId==data.CreatedById?'glyphicon glyphicon-retweet blue':
                              data.AuthorizationType=='AssignTo' && data.AssignToId!=data.CreatedById?'glyphicon glyphicon-arrow-left blue':
                              data.AuthorizationType=='AssignTo' && data.CreatedById==$parent.EMPID && data.AssignToId!=$parent.EMPID?'glyphicon glyphicon-arrow-right red':

                              data.AuthorizationType=='CreatedBy' && data.AssignToId==data.CreatedById?'glyphicon glyphicon-retweet blue':
                              data.AuthorizationType=='CreatedBy' && data.AssignToId!=data.CreatedById && data.AssignToId==$parent.EMPID?'glyphicon glyphicon-arrow-left blue':
                              data.AuthorizationType=='CreatedBy' && data.CreatedById==$parent.EMPID && data.AssignToId!=$parent.EMPID?'glyphicon glyphicon-arrow-right red':''

                                      }}"></span>
                    </span>


                </div>


                <span>   <b style="color:{{data.CurrentStatus=='ToClose'?'orange':'darkviolet'}}"> {{data.CurrentStatus}}</b> <span class="storyPoint" style="display:{{data.StoryPoint>0?'inherit':'none'}};">{{data.StoryPoint}}</span></span> <br />

                <span>Due: {{data.DueDate}} </span><br ng-hide="data.DueDate==null" />
                <span ng-hide="data.CommitmentDate==null">Comm.: {{data.CommitmentDate}} </span><br ng-hide="data.CommitmentDate==null" />


            </div>

        </script>
    </div>
</div>
<style>
    .storyPoint {
        font-size: 1.2em;
        padding-right: 4px;
        padding-left: 4px;
        color: white;
        background-color: darkblue;
    }
</style>
@Html.Partial("~/Areas/TaskManagement/Views/TaskList/EditIssueTransactionListPopUp.cshtml")






