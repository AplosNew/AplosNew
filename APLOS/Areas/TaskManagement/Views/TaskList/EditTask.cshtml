<div class="form-elements" id="editTaskPanel">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6" style="padding-bottom:20px;">
            <table>
                <tr>
                    <td style="width:100%;">
                        <textarea ng-disabled="AllowToDoEdit?false:true" @*ng-blur="DisableEditTask=true;ToDoModel.TaskDescription=TempTaskDesc"*@ style="font-weight:bold; border:none !important;border-width:0px; font-size:.8em;color:mediumblue;" rows="1" ng-readonly="DisableEditTask" ng-enter="DisableEditTask=true;UpdateToDoMaster();" ng-click="DisableEditTask=false" ng-model="ToDoModel.TaskDescription" class="form-control"></textarea>
                    </td>
                    <td class="glyphicon glyphicon-ok" ng-click="DisableEditTask=true;UpdateToDoMaster();" style="background-color:darkgreen;color:white; font-size:20px; width:40px;display:{{DisableEditTask?'none':'inline'}};"></td>
                    <td class="glyphicon glyphicon-repeat" ng-click="DisableEditTask=true;ToDoModel.TaskDescription=TempTaskDesc" style="margin-left:4px; background-color:firebrick;color:white; font-size:20px; width:40px;display:{{DisableEditTask?'none':'inline'}};"></td>
                </tr>
            </table>

        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <input type="text" e-focusout="saveStoryPoint" e-enabled="AllowToDoEdit" e-minvalue="0" e-maxvalue="1000" e-watermarktext="Story Point" ej-numerictextbox e-decimalplaces="0" e-enablertl="false" e-value="ToDoModel.StoryPoint" e-width="100" />

        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <span style="float:right">

                <input id="taskrating" type="text" ej-rating e-allowreset="false" e-value="ToDoModel.TaskPriority" e-change="UpdateToDoMasterForRating" e-precision="exact">

            </span>
        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <ul class="common-btn list-inline text-left" style="padding: 0px;">
                <li style="padding: 0px;"><button ng-disabled="AllowToDoEdit==false" ng-click="showTaskSchedulerPopUp();" class="btn" style="height:30px;width:30px; padding:0px;color:chartreuse;"><i class="glyphicon glyphicon-calendar e-large"></i></button></li>
                <li style="padding: 0px;"><button ng-disabled="isDisableIssueDetail" ng-click="DisplayIssueDetails();" class="btn" style="height:30px;width:30px; padding:0px;color:chartreuse;"><i class="glyphicon glyphicon-exclamation-sign e-large"></i></button></li>
            </ul>

        </div>
    </div>
    <div class="row" style="padding-left:10px;">
        <div id="multiAccordion" ej-accordion e-enablemultipleopen="multipleopen">
            <h3>
                <a href="#">
                    Task Detail
                    <span style="font-style:normal">By {{ToDoModel.CreatedBy.EmployeeName}}</span>
                    <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoModel.CreatedBy.EmpPicPath}}"
                         style=" height:30px;width:30px; border-radius:50%;" />
                    <span style="font-size:8pt;"> {{ToDoModel.Schedule.Details}}</span>
                </a>
            </h3>
            <div class="row">
                <div class="row tab-content" style="padding-bottom:4px; padding-top:4px;min-height:0px;">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        Detail Description
                        <table>
                            <tr>
                                <td style="width:100%;">

                                    <textarea ng-disabled="AllowToDoEdit?false:true" @*ng-blur="DisableEditTaskDetail=true;ToDoModel.TaskDescription=TempTaskDesc"*@ style="font-weight:300;font-size:8.5pt; border:none !important;border-width:0px; color:#3c0067;" rows="3" ng-readonly="DisableEditTaskDetail" ng-enter="DisableEditTaskDetail=true;UpdateToDoMaster();" ng-click="DisableEditTaskDetail=false" ng-model="ToDoModel.TaskDetailDescription" class="form-control small"></textarea>
                                </td>
                                <td class="glyphicon glyphicon-ok" ng-click="DisableEditTaskDetail=true;UpdateToDoMaster();" style="background-color:darkgreen;color:white; font-size:20px; width:40px;display:{{DisableEditTaskDetail?'none':'inline'}};"></td>
                                <td class="glyphicon glyphicon-repeat" ng-click="DisableEditTaskDetail=true;ToDoModel.TaskDetailDescription=TempTaskDetailDesc" style="margin-left:4px; background-color:firebrick;color:white; font-size:20px; width:40px;display:{{DisableEditTaskDetail?'none':'inline'}};"></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-sm-6">
                            <span>
                                Commitment Date
                                <input e-change="saveAssignToMeDetail" e-dateformat="dd-MMM-yyyy" e-enabled="enableCommitmentDate" ej-datepicker e-value="ToDoModel.AssignTo.CommitmentDate" e-width="100%" />
                            </span>
                        </div>
                        <div class="col-sm-6">
                            <span style="display:{{ToDoModel.AssignTo.CommitmentDate!=null?'inline':'none'}};">
                                Revised Commitment Date
                                <input e-change="saveAssignToMeDetail" e-dateformat="dd-MMM-yyyy" e-enabled="enableRevisedCommitmentDate" ej-datepicker e-value="ToDoModel.AssignTo.RevisedCommitmentDate" e-width="100%" />
                            </span>
                        </div>

                    </div>
                </div>
                <div class="row tab-content" style="padding-bottom:4px; padding-top:4px;min-height:0px;">
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <br />
                        <div class="form-group">
                            @*<div class="col-sm-2" style="float:left;padding:0px;">
                                    <div id="UploadDefault" e-dialogPosition-x="0" e-multiplefilesselection="true" e-width="50" e-buttontext-browse="+File" e-success="getFileList" e-showroundedcorner="false" e-height="30" e-dialogtext-title="File Attachments" e-autoupload="true" e-begin="onBeginUpload" e-filesize="10485760" ej-uploadbox e-saveurl="uploadUrl" e-extensionsallow=".jpg,.bmp,.png,.jpeg,.pdf,.xls,.xlsx,.doc,.docx,.ppt,.pptx,.txt" e-error="errorPicUpload"></div>
                                </div>*@
                            <span class="glyphicon glyphicon-paperclip" style="font-size:14pt; font-weight:bolder; padding:10px;" ng-click="OpenFileUploadPOPUp();"></span>
                            <div class="col-sm-10" style="padding:0px;padding-left:8px;">
                                <div class="form-group">
                                    <div ng-repeat="x in FilesList">
                                        <div style="padding-left:10px; background-color:#feffeb;height:22px;border-bottom:1px solid white;" class="small">
                                            <span class="glyphicon glyphicon-file" style="padding:0px;"></span>
                                            <a href="{{ToDoFilePath+'/'+x.FileName}}" target="_blank">
                                                <span style="color:red;padding:4px;">  </span>
                                                <span style="height:20px;width:20px;color:blue;">
                                                    {{x.FileOriginalName}}
                                                </span>
                                            </a>
                                            @*<span style="color:red;float:right;;display:{{(x.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.CreatedBy.ToString()' ||  x.AddedBy==EMPID)?'inline':'none'}};" ng-click="DeleteToDoFile(x.Id)" class="glyphicon glyphicon-trash"></span>*@
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-8 col-md-8">

                        <div class="col-sm-3">
                            Due

                            <input e-change="UpdateToDoMaster" e-dateformat="dd-MMM-yyyy" e-enabled="AllowToDoEdit" ej-datepicker e-value="ToDoModel.DueDate" e-width="100%" />
                        </div>
                        <div class="col-sm-3">
                            Category
                            <input ej-dropdownlist e-enablefiltersearch="true" e-enabled="AllowToDoEdit" e-minpopupheight="250px" e-change="UpdateToDoMaster" e-datasource="TaskCategoryList" e-value="ToDoModel.TaskCategoryId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                        </div>
                        <div class="col-sm-3">
                            Sub Category
                            <input ej-dropdownlist e-enablefiltersearch="true" e-enabled="AllowToDoEdit" e-minpopupheight="250px" e-change="UpdateToDoMaster" e-datasource="TaskSubCategoryList" e-value="ToDoModel.TaskSubCategoryId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                        </div>
                        <div class="col-sm-3">
                            Status
                            <input ej-dropdownlist e-enablefiltersearch="false" e-enabled="true" e-change="UpdateToDoMaster" e-datasource="TaskCurrentStatus" e-value="ToDoModel.CurrentStatus" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                        </div>


                    </div>

                </div>

            </div>

            <h3>
                <a href="#">
                    <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoModel.AssignTo.EmpPicPath}}"
                         style=" height:30px;width:30px; border-radius:50%; display:{{ToDoModel.AssignTo.EmployeeId!=null?'inline':'none'}}" />

                    <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoModel.CheckBy.EmpPicPath}}"
                         style=" height:30px;width:30px; border-radius:50%; display:{{ToDoModel.CheckBy.EmployeeId!=null?'inline':'none'}}" />


                    <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoModel.CrossCheckBy.EmpPicPath}}"
                         style=" height:30px;width:30px; border-radius:50%; display:{{ToDoModel.CrossCheckBy.EmployeeId!=null?'inline':'none'}}" />


                    <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoModel.ApproveBy.EmpPicPath}}"
                         style=" height:30px;width:30px; border-radius:50%; display:{{ToDoModel.ApproveBy.EmployeeId!=null?'inline':'none'}}" />

                    @*{{ToDoModel.AssignTo.EmployeeCode!=null?' Assign To '+ToDoModel.AssignTo.EmployeeName:''}}
                        {{ToDoModel.CheckBy.EmployeeCode!=null?' Check By '+ToDoModel.CheckBy.EmployeeName:''}}
                        {{ToDoModel.CrossCheckBy.EmployeeCode!=null?' Cross Check By '+ToDoModel.CrossCheckBy.EmployeeName:''}}
                        {{ToDoModel.ApproveBy.EmployeeCode!=null?' Approve By '+ToDoModel.ApproveBy.EmployeeName:''}}*@
                </a>
            </h3>
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12 tab-content" style="padding-bottom:4px; padding-top:4px;min-height:0px;">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">


                            <table>
                                <tr>
                                    <td></td>
                                    <td colspan="3" style="color:royalblue;"> Assigned To</td>
                                </tr>
                                <tr>
                                    <td style="width:30px;">
                                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoModel.AssignTo.EmpPicPath}}"
                                             style=" height:30px;width:30px; border-radius:50%;" />
                                    </td>
                                    <td style="width:50px;"><input class="form-control" type="text" ng-disabled="true" ng-model="ToDoModel.AssignTo.EmployeeCode" /></td>
                                    <td><input class="form-control" name="Owner" type="text" placeholder="Assign To" ng-disabled="true" ng-model="ToDoModel.AssignTo.EmployeeName" /></td>
                                    <td style="width:70px;">
                                        <ul class="common-btn list-inline text-left" style="padding: 0px;">
                                            <li style="padding: 0px;"><button ng-disabled="AllowToDoEdit?false:true" ng-click="OpenEmployeeSearchBox('AssignTo');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-search small"></i></button></li>
                                            @*<li style="padding: 0px;"><button ng-disabled="EMPID==ToDoModel.AssignTo.EmployeeId?false:true" ng-click="EditRemarks('AssignTo');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-edit"></i></button></li>*@
                                        </ul>
                                    </td>
                                </tr>
                            </table>



                        </div>
                        <div class="form-group">


                            <table>
                                <tr>
                                    <td></td>
                                    <td colspan="3" style="color:royalblue;"> Check By</td>
                                </tr>
                                <tr>
                                    <td style="width:30px;">
                                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoModel.CheckBy.EmpPicPath}}"
                                             style=" height:30px;width:30px; border-radius:50%;" />
                                    </td>
                                    <td style="width:50px;"><input class="form-control" type="text" ng-disabled="true" ng-model="ToDoModel.CheckBy.EmployeeCode" /></td>
                                    <td><input class="form-control" name="Owner" type="text" placeholder="Check By" ng-disabled="true" ng-model="ToDoModel.CheckBy.EmployeeName" /></td>
                                    <td style="width:70px;">
                                        <ul class="common-btn list-inline text-left small" style="padding: 0px;">
                                            <li style="padding: 0px;"><button ng-disabled="AllowToDoEdit?false:true" ng-click="OpenEmployeeSearchBox('CheckBy');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-search small"></i></button></li>
                                            <li style="padding: 0px;"><button ng-disabled="AllowToDoEdit?false:true" ng-click="DeleteEmployee('CheckBy');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-remove"></i></button></li>
                                            @*<li style="padding: 0px;"><button ng-disabled="EMPID==ToDoModel.CheckBy.EmployeeId?false:true" ng-click="EditRemarks('CheckBy');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-edit"></i></button></li>*@
                                        </ul>
                                    </td>
                                </tr>
                            </table>




                        </div>


                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">

                            <table>
                                <tr>
                                    <td></td>
                                    <td colspan="3" style="color:royalblue;">Cross Check By</td>
                                </tr>
                                <tr>
                                    <td style="width:30px;">
                                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoModel.CrossCheckBy.EmpPicPath}}"
                                             style=" height:30px;width:30px; border-radius:50%;" />
                                    </td>
                                    <td style="width:50px;"><input class="form-control" type="text" ng-disabled="true" ng-model="ToDoModel.CrossCheckBy.EmployeeCode" /></td>
                                    <td><input class="form-control" name="Owner" type="text" placeholder="Cross Check By" ng-disabled="true" ng-model="ToDoModel.CrossCheckBy.EmployeeName" /></td>
                                    <td style="width:70px;">
                                        <ul class="common-btn list-inline text-left" style="padding: 0px;">
                                            <li style="padding: 0px;"><button ng-disabled="AllowToDoEdit?false:true" ng-click="OpenEmployeeSearchBox('CrossCheckBy');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-search small"></i></button></li>
                                            <li style="padding: 0px;"><button ng-disabled="AllowToDoEdit?false:true" ng-click="DeleteEmployee('CrossCheckBy');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-remove"></i></button></li>
                                            @*<li style="padding: 0px;"><button ng-disabled="EMPID==ToDoModel.CrossCheckBy.EmployeeId?false:true" ng-click="EditRemarks('CrossCheckBy');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-edit"></i></button></li>*@
                                        </ul>
                                    </td>
                                </tr>
                            </table>

                        </div>
                        <div class="form-group">
                            <table>
                                <tr>
                                    <td></td>
                                    <td colspan="3" style="color:royalblue;"> Approve By</td>
                                </tr>
                                <tr>
                                    <td style="width:30px;">
                                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{ToDoModel.ApproveBy.EmpPicPath}}"
                                             style=" height:30px;width:30px; border-radius:50%;" />
                                    </td>
                                    <td style="width:50px;"><input class="form-control" type="text" ng-disabled="true" ng-model="ToDoModel.ApproveBy.EmployeeCode" /></td>
                                    <td><input class="form-control" name="Owner" type="text" placeholder="Approve By" ng-disabled="true" ng-model="ToDoModel.ApproveBy.EmployeeName" /></td>
                                    <td style="width:70px;">
                                        <ul class="common-btn list-inline text-left" style="padding: 0px;">
                                            <li style="padding: 0px;"><button ng-disabled="AllowToDoEdit?false:true" ng-click="OpenEmployeeSearchBox('ApproveBy');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-search small"></i></button></li>
                                            <li style="padding: 0px;"><button ng-disabled="AllowToDoEdit?false:true" ng-click="DeleteEmployee('ApproveBy');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-remove"></i></button></li>
                                            @*<li style="padding: 0px;"><button ng-disabled="EMPID==ToDoModel.ApproveBy.EmployeeId?false:true" ng-click="EditRemarks('ApproveBy');" class="btn" style="height:30px;width:30px; padding:0px;"><i class="glyphicon glyphicon-edit"></i></button></li>*@
                                        </ul>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>



            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 tab-content" style="height:300px; position:relative;">
        <div style="bottom:0;position:absolute;float:none;">
            <div id="wtfCommentScroll" class="form-group" style="height:250px;width:400px; overflow:scroll;">

                <div id="anglistviewComments" ng-init="chkinit()" ej-grid e-textwrapsettings-wrapmode="both" e-datasource="CommentsList" @*e-templaterefresh="refreshTemplateIssueTransaction"*@
                     e-querycellinfo="commentScroll" e-allowfiltering="true" e-allowpaging="false" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="false" e-filtersettings-filterType="excel" e-gridlines="none">
                    <div e-columns>

                        <div e-column e-headertext="" e-template="#TaskDetailView" e-textalign="center" e-width="50"></div>

                    </div>
                </div>

                <script type="text/template" id="TaskDetailView">

                    <div class="col-xs-12 col-sm-2 col-md-2 text-left" style="padding:0px;margin:0px;display:{{data.CreatedById!=$parent.EMPID?'block':'none'}}">
                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{data.EmpPicPath}}"
                             style="float:left;position:absolute; height:30px;width:30px;border:2px solid #efefef; border-radius:50%;" />
                    </div>
                    <div class="col-xs-12 col-sm-10 col-md-10  text-left" style="padding-left:4px;margin:0px;text-align:{{data.CreatedById!=$parent.EMPID?'left':'right'}};">

                        <div class="row" style="padding:2px;color:#000000;display:block;">
                            <span> {{data.CommentText}}  </span>
                        </div>
                        <div class="row small" style="padding:2px;">
                            <b>
                                <span style="color:#bcbcbc;"> {{data.EmployeeName}} </span>
                                <span style="color:#bcbcbc;"> {{data.CreatedTime}}  </span>
                            </b>
                            <br />
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2 text-right" style="padding:0px;padding-right:40px;margin:0px;display:{{data.CreatedById==$parent.EMPID?'block':'none'}}">
                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{data.EmpPicPath}}"
                             style="float:left;position:absolute; height:30px;width:30px;border:2px solid #efefef; border-radius:50%;" />
                    </div>

                </script>

            </div>

            <div class="form-group" style="padding-bottom:10px;margin-bottom:10px !important;">


                <div class="col-xs-12" style="padding:0px;margin:0px;">
                    <div class="col-xs-12 col-sm-10 col-md-10" style="padding:0px;">
                        <input style="color:black;font-weight:400;" type="text" name="User Name" placeholder="Add Comment Here" ng-model="CommentText" ng-enter="AddToDoComment()" class="form-control" maxlength="250" />
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2" style="padding:0px;margin:0px">
                        <ul class="common-btn list-inline text-right" style="padding:0px; margin:0px;width:100%;">
                            <li style="padding:0px;margin:0px;width:100%;">
                                <button type="button" ng-click="AddToDoComment()" class="btn"><i class="glyphicon glyphicon-send"></i></button>
                            </li>
                        </ul>
                    </div>
                </div>


            </div>


        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6  tab-content" style="height:300px;position:relative;">
        <div style="bottom:0;position:absolute;float:none;">
            <div id="wtfSubTaskScroll" class="form-group" style="height:250px;width:400px; overflow:scroll;">
                @*<md-content scroll-to-bottom="0" layout="column" style="background-color: #F5F5F5;height:250px;" ng-style="height:250px;">*@

                <div id="anglistviewSubTasks" ng-init="chkinit()" ej-grid e-textwrapsettings-wrapmode="both" e-datasource="SubTasksList"
                     e-enableresponsiverow="true" e-allowrowdraganddrop="true" e-querycellinfo="SubTaskScroll" e-allowfiltering="true" e-allowpaging="false" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="false" e-filtersettings-filterType="excel" e-gridlines="none">
                    <div e-columns>
                        <div e-column e-headertext="" e-template="#SubTaskDetailView" e-textalign="center" e-width="100"></div>
                    </div>
                </div>
                @*</md-content>*@
            </div>
            <div class="col-xs-12 col-sm-10 col-md-10" style="padding:0px;">
                <input type="text" style="color:black;font-weight:400;" name="User Name" placeholder="Add Sub Task Here" ng-model="SubTaskText" ng-enter="AddToDoSubTask()" class="form-control" maxlength="250" />
            </div>
            <div class="col-xs-12 col-sm-2 col-md-2 text-right" style="padding:0px;margin:0px">
                <ul class="common-btn list-inline text-right" style="padding:0px; margin:0px;width:100%;">
                    <li style="padding:0px;margin:0px;width:100%;">
                        <button type="button" ng-click="AddToDoSubTask()" class="btn"><i class="glyphicon glyphicon-plus-sign"></i> Add</button>
                    </li>
                </ul>
            </div>



        </div>

    </div>
</div>

<script type="text/template" id="SubTaskDetailView">


    <div class="col-xs-12 col-sm-10 col-md-10 text-left" style="padding-left:20px;margin:0px;">
        <div class="row" style="padding:0px;margin:0px;">
            <div class="row" style="padding:2px;">
                <span> <input type="checkbox" e-enabled="{{(data.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.CreatedBy.ToString()' || $parent.ToDoModel.AssignTo.EmployeeId==$parent.EMPID || data.AddedBy==$parent.EMPID)?'true':'false'}}" ej-checkbox class="nodetext" e-value="data.IsDone" e-checked="data.IsDone" e-change="$parent.UpdateToDoSubTask" /></span>
                <span style="text-decoration:{{data.IsDone?'line-through':'inherit'}}">
                    {{data.TaskDetail}}   <button ng-show="data.hasRemarks" ng-click="$parent.showSubTaskRemarks(data,'View')" class="btn" style="height: 20px;width: 20px;padding: 0px;margin: 0px;">
                        <i class="glyphicon glyphicon-info-sign"></i>
                    </button>
                </span>
            </div>

        </div>

    </div>
    <div class="col-xs-12 col-sm-1 col-md-1 text-center" style="padding-left:0px;margin:0px;">
        <ul class="list-inline text-right" style="padding-left:0px;margin:0px;">
            <li style="padding-left:0px;margin:0px;display:{{(data.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.CreatedBy.ToString()' ||  data.AddedBy==$parent.EMPID)?'block':'none'}};">
                <button ng-click="$parent.DeleteToDoSubTask(this);" class="btn" style="height: 20px;width: 20px;padding: 0px;margin: 0px;">
                    <i class="glyphicon glyphicon-trash"></i>
                </button>

            </li>
        </ul>
    </div>
    <div class="col-xs-12 col-sm-1 col-md-1 text-center" style="padding-left:0px;margin:0px;">
        <ul class="list-inline text-right" style="padding-left:0px;margin:0px;">
            <li style="padding-left:0px;margin:0px;">

                <button ng-click="$parent.showSubTaskRemarks(data,'Edit');" class="btn" style="height: 20px;width: 20px;padding: 0px;margin: 0px;">
                    <i class="glyphicon glyphicon-plus-sign"></i>
                </button>
            </li>
        </ul>
    </div>
</script>

<ej-dialog id="dialogSubTaskRemarks" title="Sub Task Remarks" e-enablemodal="false" e-position-y="0" e-showoninit="false" e-target="#mainContent" e-minwidth="600" e-minheight="400" e-open="enableBtn">


    <label class="col-sm-12 control-label">{{SelectedSubTask.TaskDetail}}</label>

    <div class="col-xs-12 col-sm-10 col-md-10 " style="padding:0px;">
        <div class="form-group">
            <input type="text" style="color:black;font-weight:400; border:1px solid #efefef;" name="User Name" placeholder="Add Remarks Here" ng-model="SubTotalRemarks" ng-enter="UpdateToDoSubTasksRemarks()" class="form-control" maxlength="250" />
        </div>
    </div>
    <div class="col-xs-12 col-sm-2 col-md-2 text-right" style="padding:0px;margin:0px">
        <ul class="common-btn list-inline text-right" style="padding:0px; margin:0px;width:100%;">
            <li style="padding:0px;margin:0px;width:100%;">
                <button type="button" ng-click="UpdateToDoSubTasksRemarks()" class="btn"><i class="glyphicon glyphicon-plus-sign"></i> Add</button>
            </li>
        </ul>
    </div>
    <div class="col-xs-12">
        <div class="row" style="height:250px;overflow:scroll;">
            <div class="col-xs-12" ng-repeat="data in SubTaskRemarksList" style="height:32px;padding:4px;">
                <div class="col-xs-1">
                    <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{data.EmpPicPath}}"
                         style="float:left;position:absolute; height:30px;width:30px;border:2px solid #efefef; border-radius:50%;" />
                </div>
                <div class="col-xs-10">
                    {{data.Remarks}} <span style="font-size:8px;"><i>{{data.RemarksTime}}</i></span>
                </div>
                <div class="col-xs-1">
                    <span ng-click="deleteSubTaskRemarks(data.Id)" class="glyphicon glyphicon-trash"></span>
                </div>
            </div>
        </div>
    </div>


</ej-dialog>

<ej-dialog id="dialogFileUpload" title="File Attachments" e-enablemodal="false" e-position-y="0" e-showoninit="false" e-target="#mainContent" e-minwidth="600" e-minheight="400" e-open="enableBtn">


    <label class="col-sm-12 control-label">{{TempTaskDesc}}</label>
    <div class="col-sm-12" style="float:left;padding:0px;">
        <div class="col-sm-2">
            <div id="UploadDefault" e-dialogPosition-x="0" e-multiplefilesselection="false" e-width="50" e-buttontext-browse="+File" e-success="getFileList" e-showroundedcorner="false" e-height="30" e-dialogtext-title="File Attachments" e-autoupload="true" e-begin="onBeginUpload" e-filesize="10485760" ej-uploadbox e-saveurl="uploadUrl" e-extensionsallow=".jpg,.bmp,.png,.jpeg,.pdf,.xls,.xlsx,.doc,.docx,.ppt,.pptx,.txt" e-error="errorPicUpload"></div>
        </div>
        <div class="col-sm-10">
            <input class="form-control" placeholder="Add file description here before selecting file" type="text" ng-model="TempFileDesc" />
        </div>
    </div>
    <div class="col-sm-12" style="padding:0px;padding-left:8px;">
        <div class="form-group">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th style="width:30%;">Url</th>
                        <th>File Description</th>
                        <th style="width:10%;">Action</th>

                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in FilesList">
                        <td>
                            <a href="{{ToDoFilePath+'/'+x.FileName}}" target="_blank">
                                <span style="color:red;padding:4px;">  </span>
                                <span style="color:blue;">
                                    {{x.FileOriginalName}}
                                </span>
                            </a>
                        </td>
                        <td>
                            <input class="form-control" ng-disabled="{{(x.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.CreatedBy.ToString()' ||  x.AddedBy==EMPID)?false:true}}" type="text" ng-model="x.FileDescription" />
                        </td>
                        <td>
                            <span style="color:green;font-size:14pt;display:{{(x.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.CreatedBy.ToString()' ||  x.AddedBy==EMPID)?'inline':'none'}};" ng-click="UpdateToDoFile(x.Id,x.FileDescription)" class="glyphicon glyphicon-floppy-disk"></span>
                            <span style="color:red;font-size:14pt;display:{{(x.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.CreatedBy.ToString()' ||  x.AddedBy==EMPID)?'inline':'none'}};" ng-click="DeleteToDoFile(x.Id)" class="glyphicon glyphicon-trash"></span>
                        </td>
                    </tr>
                </tbody>
            </table>


        </div>
    </div>
</ej-dialog>



