                                 e-toolbarsettings-showtoolbar="true" e-toolbarsettings-toolbaritems="[ej.Grid.ToolBarItems.Search]"
                                 e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="" e-template="#UnreadTaskList" e-textalign="center" e-width="80"></div>
                                    <div e-column e-headertext="" e-template="#UnreadTaskListType" e-textalign="center" e-width="20"></div>
                                </div>
                            </div>

                            <script type="text/template" id="UnreadTaskList">
                                <div style="height:35px;">
                                    <div class="col-xs-12 col-sm-2 col-md-2 text-left" style="padding:0px;margin:0px;">
                                        <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{data.AssignToId!=data.CreatedById && data.AssignToId==$parent.EMPID?data.EmpPicPathAssignBy:data.EmpPicPath}}"
                                             style="float:left;position:absolute; height:30px;width:30px;border:2px solid #efefef; border-radius:50%;" />
                                    </div>
                                    <div class="col-xs-12 col-sm-10 col-md-10  text-left" style="padding-left:4px;margin:0px;">
                                        <div class="row" style="padding:0px;margin:0px;">
                                            {{data.TaskDescription}}
                                        </div>
                                        <div class="row small" style="padding:2px;">
                                            <span style="color:darkorchid;">
                                                {{(data.AssignToId==$parent.EMPID && data.AssignToId==data.CreatedById)?'My Task':
                                        (data.AssignToId!=$parent.EMPID && data.AssignToId==data.CreatedById)?data.AssignTo==null?'':'Own Task by '+data.AssignTo:

                                        data.AssignToId!=data.CreatedById && data.AssignToId==$parent.EMPID?data.CreatedBy==null?'':'Assigned to me By '+data.CreatedBy:
                                        data.CreatedById==$parent.EMPID && data.AssignToId!=$parent.EMPID?data.AssignTo==null?'':'Assigned to '+data.AssignTo:
                                        data.CreatedById!=$parent.EMPID && data.AssignToId!=data.CreatedById && data.AssignToId!=$parent.EMPID?(data.AssignTo==null?'':'Assigned To ' +data.AssignTo)+ ' '+ (data.CreatedBy==null?'':' By '+data.CreatedBy):''}}
                                                <i style="color:blue">  {{data.TaskAddedDate}}</i>

                                            </span>

                                        </div>

                                    </div>

                                </div>
                            </script>
                            <script type="text/template" id="UnreadTaskListType">

                                <div class="col-xs-12 col-sm-12 col-md-12 text-right small">

                                    <div style="float:right;vertical-align:top;position:absolute;font-size:20px;">

                                        <span style="display:{{data.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.CheckBy.ToString()'?'block':'none'}}" class="glyphicon glyphicon-ok"></span>
                                        <span style="display:{{data.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.CrossCheckBy.ToString()'?'block':'none'}}" class="glyphicon glyphicon-check"></span>
                                        <span style="display:{{data.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.ApproveBy.ToString()'?'block':'none'}}" class="glyphicon glyphicon-pawn"></span>


                                        <span style="display:{{data.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.AssignTo.ToString()'?'block':'none'}}">
                                            <span class="glyphicon glyphicon-retweet" style="color:blue; padding:2px;display:{{data.AssignToId==data.CreatedById?'block':'none'}};">
                                            </span>
                                            <span class="glyphicon glyphicon-arrow-left" style="color:green;padding:2px;display:{{data.AssignToId!=data.CreatedById && data.AssignToId==$parent.EMPID?'block':'none'}};">
                                            </span>
                                            <span class="glyphicon glyphicon-arrow-right" style="color:red;padding:2px;display:{{data.CreatedById==$parent.EMPID && data.AssignToId!=$parent.EMPID?'block':'none'}};">
                                            </span>
                                        </span>


                                        <span style="display:{{data.AuthorizationType=='@Library.Service.Enums.AuthorizationTypeEnum.CreatedBy.ToString()'?'block':'none'}}">
                                            <span class="glyphicon glyphicon-retweet" style="color:blue; padding:2px;display:{{data.AssignToId==data.CreatedById?'block':'none'}};">
                                            </span>
                                            <span class="glyphicon glyphicon-arrow-left" style="color:green;padding:2px;display:{{data.AssignToId!=data.CreatedById && data.AssignToId==$parent.EMPID?'block':'none'}};">
                                            </span>
                                            <span class="glyphicon glyphicon-arrow-right" style="color:red;padding:2px;display:{{data.CreatedById==$parent.EMPID && data.AssignToId!=$parent.EMPID?'block':'none'}};">
                                            </span>

                                        </span>

                                    </div>


                                </div>

                            </script>

                        </li>
                    </ul>


                </li>

            </ul>
        </td>
    </tr>
</table>


<div class="row form-elements" @*style="font-family:''Arial Narrow', 'Arial', 'sans-serif', 'Franklin Gothic Medium'' !important;"*@>
