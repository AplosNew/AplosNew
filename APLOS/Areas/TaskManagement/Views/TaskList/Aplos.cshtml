                    <a class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="true">
                        <div style="position:absolute;top:10px;left:6px;color:#0500ff;font-weight:bold; z-index:1;">{{UnreadTaskList.length>0?UnreadTaskList.length:''}}</div>
                        <div class="glyphicon glyphicon-bell" style="height:22px;width:22px; z-index:0; color:{{IsConnectedToHub==true?'#ff0000':'#dfdfdf'}};">
                        </div>&nbsp;
                        <i class="fa fa-angle-down"></i>
                    </a>
                    <ul class="dropdown-menu" style="width:400px;" ng-click="$event.stopPropagation()">
                        <li>
                            <span> Incoming Task List</span>
                            <div id="gridUnreadTaskList" ng-init="chkinit()" style="width:400px;" ej-grid e-datasource="UnreadTaskList" e-gridlines="horizontal"
                                 e-allowtextwrap="true" e-textwrapsettings.wrapmode="content" e-pagesettings-pagesize="8"
