<togglable name="Task Create"></togglable>
<div class="form-elements form-horizontal" ng-form name="taskMasterNewForm">
    <input type="hidden" ng-model="taskMasterNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Task Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="TaskType" ng-model="taskMasterNew.TaskTypeId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in taskTypeList" tabindex="3" required></select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Task Class<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="TaskClass" ng-model="taskMasterNew.TaskClassId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in taskClassList" tabindex="3" required></select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Task Category <sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="TaskCategory" ng-model="taskMasterNew.TaskCategoryId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in taskCategoryList" tabindex="3" required></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="radio">
                    <label>
                        <input type="radio" name="Other" ng-model="taskMasterNew.TaskFor" value="Other">
                        <span class="cr"><i class="cr-icon"></i></span>Other
                    </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <label>
                        <input type="radio" name="Self" ng-model="taskMasterNew.TaskFor" value="Self"  ng-click="AssingToDefault()">
                        <span class="cr"><i class="cr-icon"  ></i></span>Self
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Assign By <sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <input type="text" name="Assign By" ng-model="taskMasterNew.AssignByEmployeeName" class="form-control" readonly>

                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-2">
                    <button class="btn" ng-click="popUp1('AssignBy');"><i class="glyphicon glyphicon-search"></i> Search </button>
                </div>
            </div>
        </div>



        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Assign To <sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <input type="text" name="Assign to" ng-model="taskMasterNew.AssignToEmployeeName" class="form-control" readonly>

                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-2">
                    <button class="btn" ng-click="popUp1();"><i class="glyphicon glyphicon-search"></i> Search </button>
                </div>
            </div>
        </div>
        <div ng-show="taskMasterNew.TaskFor==='Other'">
            <div class="form-group" show-errors>
                <label class="col-sm-6 control-label">Notification <sup>*</sup></label>

                <div class="form-group">
                    <div class="col-sm-2">
                        <button class="btn" ng-click="popUp();"><i class="glyphicon glyphicon-search"></i> Search Employee </button>
                    </div>
                </div>
                <div class="col-sm-12 control-label form-group">
                    <div class="table-condensed modal-table" >
                        <table class="table table-striped">
                            <thead >
                                <tr>
                                    <th>Employee Code</th>
                                    <th>Employee Name</th>
                                    <th>Employee Category</th>
                                    <th>Given Designation</th>
                                    <th>Division</th>
                                    <th>Department</th>
                                    <th>Section</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="x in tempList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count" pagination-id="metaData.name + 'employeeList'">
                                    <td>{{x.EmployeeCode}}</td>
                                    <td>{{x.EmployeeName}}</td>
                                    <td>{{x.EmployeeCategory}}</td>
                                    <td>{{x.GivenDesignation}}</td>
                                    <td>{{x.Division}}</td>
                                    <td>{{x.Department}}</td>
                                    <td>{{x.Section}}</td>
                                    <td> <button style="color:orangered" ng-click="RemoveLst($index)">Remove</button> </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Task org Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="TaskOrgCategory" ng-model="taskMasterNew.TaskOrgCategoryId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in taskOrgCategoryList" tabindex="3" required></select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Task Status<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="TaskStatus" ng-model="taskMasterNew.TaskStatusId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in taskStatusList" tabindex="3" required></select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Task Frequency<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="TaskFrequency" ng-model="taskMasterNew.TaskFrequencyId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in taskFrequencyList" tabindex="3" required></select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Task Description <sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <textarea class="form-control" rows="3" ng-model="taskMasterNew.Description"  draggable="false" required>
               </textarea>
                </div>
            </div>
        </div>



    </div>




</div>

<div class="common-btn">
    <ul class="list-inline text-right">
        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
    </ul>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Assign To</th>
                <th>Short Name</th>
                <th>Target Date</th>
                <th>Confirmation Date</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in taskMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.AssignTo}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.TargetDate}}</td>
                <td>{{x.ConfirmationDate}}</td>
                <td>{{x.Description}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row form-element-ctrl form-horizontal">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div ng-dropdown-multiselect="" options="divisionNewList" selected-model="divisionIds"
                                     extra-settings="multiSelectSettings" translation-texts="example4customTexts" events="multi4events"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div ng-dropdown-multiselect="" options="departmentNewList" selected-model="departmentIds"
                                     extra-settings="multiSelectSettings" translation-texts="example3customTexts" events="multi3events"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div ng-dropdown-multiselect="" options="sectionNewList" selected-model="sectionIds"
                                     extra-settings="multiSelectSettings" translation-texts="example5customTexts" events="multi5events"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div ng-dropdown-multiselect="" options="employeeCategoryNewList" selected-model="employeeCategoryIds"
                                     extra-settings="multiSelectSettings" translation-texts="example6customTexts" events="multi6events"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div ng-dropdown-multiselect="" options="givenDesignationNewList" selected-model="givenDesignationIds"
                                     extra-settings="multiSelectSettings" translation-texts="example7customTexts" events="multi7events"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row form-element-ctrl form-horizontal">
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Employee Code</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="ShortName" ng-model="paidHoursEmployeeAssignNew.EmployeeCode" class="form-control" maxlength="15" tabindex="3">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Employee Name</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="ShortName" ng-model="paidHoursEmployeeAssignNew.EmployeeName" class="form-control" maxlength="15" tabindex="3">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="common-btn">
                            <button type="button" ng-click="getSearchData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                        </div>
                    </div>
                </div>
                <p>Employee Count:{{employeeParameters.total_count}}</p>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Employee Category</th>
                                <th>Given Designation</th>
                                <th>Division</th>
                                <th>Department</th>
                                <th>Section</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count" pagination-id="metaData.name + 'employeeList'">
                                <td>
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" id="{{x.SystemId}}" ng-click="pushTempList(x,$event,employeeList);" ng-model="x.Flag" ng-checked="x.Flag">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.EmployeeCategory}}</td>
                                <td>{{x.GivenDesignation}}</td>
                                <td>{{x.Division}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'employeeList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEmployeeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="SelectEmployeeByButton();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>

