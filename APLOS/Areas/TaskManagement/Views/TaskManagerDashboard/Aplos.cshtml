<table id="maincontainer">
    <tr>
        <td>
            <h3 class="site-heading  class=" form-horizontal form-elements"">
                <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  {{title}}
            </h3>
        </td>
        <td class="text-right" style="width:70px;">
            <span style="font-size:3em; color:green;" ng-hide="ShowFilterScreen==false" ng-click="filterComplete();getTaskMmanagerDashboardList();" class="glyphicon glyphicon-circle-arrow-right"></span>
            <span style="font-size:3em;color:blueviolet;" ng-hide="ShowFilterScreen==true" ng-click="ShowFilterScreen=true" class="glyphicon glyphicon-circle-arrow-left"></span>
        </td>
    </tr>
</table>
@*<h3 class="site-heading" id="maincontainer">

        <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>

    </h3>*@
<fieldset class="scheduler-border" ng-hide="ShowFilterScreen==false">
    <legend class="scheduler-border" style="padding:0px;">Parameters</legend>


    <div class="col-sm-12 col-md-6">
        <div class="form-group">
            <div class="col-sm-4" style="padding-left: 0px;">From Date<sup>*</sup></div>
            <div class="col-sm-8">
                <input e-dateformat="dd-MMM-yyyy" ej-datepicker class="form-control" e-dataBound="filterString.FromDate" e-value="filterString.FromDate" e-width="100%" />
            </div>
        </div>

        <div class="form-group">
            <div class="col-sm-4" style="padding-left: 0px;">To Date<sup>*</sup></div>
            <div class="col-sm-8">
                <input e-dateformat="dd-MMM-yyyy" ej-datepicker class="form-control" e-dataBound="filterString.ToDate" e-value="filterString.ToDate" e-width="100%" />
            </div>

        </div>
        <div class="form-group">
            <div class="col-sm-4" style="padding-left: 0px;">Task Type<sup>*</sup></div>
            <div class="col-sm-8">

                <input type="radio" ng-model="filterString.Status" value="All">
                <span>All</span>
                <input type="radio" ng-model="filterString.Status" value="Issue">
                <span>Issue</span>
                <input type="radio" ng-model="filterString.Status" value="TNA">
                <span>TNA</span>
                <input type="radio" ng-model="filterString.Status" value="ToDo">
                <span>To Do</span>
            </div>

        </div>
    </div>
    @*<div class="col-sm-12 col-md-6 text-center">
            <span style="font-size: 4em;" ng-click="filterComplete();getTaskMmanagerDashboardList();" class="glyphicon glyphicon-circle-arrow-right"></span>
        </div>*@

</fieldset>
<div class="row" ng-hide="ShowFilterScreen==true">
    <div class="col-sm-12 col-md-12">
        Data showing from {{filterString.FromDate}} to {{filterString.ToDate}} for task type: {{filterString.Status}}
    </div>
    <div class="col-md-12" style="padding-right:50px;">
        <div class="row">
            @*<div class="col-md-12">
                    <span class="text-right" style="float:right;position:static;text-align:right;">
                        <span style="font-size:2em;" ng-click="ShowFilterScreen=true" class="glyphicon glyphicon-circle-arrow-left"></span>
                    </span>
                </div>*@

            <div class="col-md-12">
                <div id="multiAccordion" ej-accordion>
                    <h3 class="col-md-12">
                        <a href="#">
                            Summary View
                        </a>
                    </h3>
                    <div class="col-sm-12 tab-content" style="padding:0px !important; padding-right:23px !important">

                        <div class="col-sm-8">

                            <table>
                                <tr style="color:brown;background-color:#f1f1f1;font-weight:bold;">
                                    <td style="width:40%">
                                        Particulars
                                    </td>
                                    <td class="text-center" style="width:15%">
                                        Overall
                                    </td>
                                    <td class="text-center" style="width:15%">
                                        To Do
                                    </td>
                                    <td class="text-center" style="width:15%">
                                        Issue
                                    </td>
                                    <td class="text-center" style="width:15%">
                                        TNA
                                    </td>

                                </tr>
                                <tr ng-repeat="x in Statistics">
                                    <td style="width:40%;height:26px;">
                                        {{x.Particular}}
                                    </td>
                                    <td class="text-center" style="width:15%">
                                        {{x.Total}}
                                    </td>
                                    <td class="text-center" style="width:15%">
                                        <a href="" ng-click="showMainStat(x,'ToDo')"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{x.ToDo}}</span></a>
                                    </td>
                                    <td class="text-center" style="width:15%">
                                        <a href="" ng-click="showMainStat(x,'Issue')"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{x.Issue}}</span></a>
                                    </td>
                                    <td class="text-center" style="width:15%">
                                        <a href="" ng-click="showMainStat(x,'TNA')"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{x.TNA}}</span></a>
                                    </td>

                                </tr>
                            </table>


                        </div>
                        <div class="col-md-4">


                            <div class="col-sm-12">
                                <div class="col-sm-12 col-md-6">
                                    <div id="ChartOverall" style="width: 180px" ej-chart e-commonseriesoptions-marker-datadiv-visible="false"
                                         e-isresponsive="true"
                                         e-size-height="100px"
                                         e-legend-visible="false" e-title-text="Over All" e-title-font-size="9px">
                                        <e-series>
                                            <e-series e-type="pie" e-name="Tasks" e-tooltip-visible="true" e-enableAnimation="true" e-datasource=PieChartMain e-xname="x" e-yname="y" e-divPosition="outsideExtended" e-enablesmartdivs="false" e-startangle="145">
                                            </e-series>
                                        </e-series>
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-6">
                                    <div id="PieToDo" style="width: 180px" ej-chart e-commonseriesoptions-marker-datadiv-visible="false"
                                         e-isresponsive="true"
                                         e-size-height="100px"
                                         e-legend-visible="false" e-title-text="To Do" e-title-font-size="9px">
                                        <e-series>
                                            <e-series e-type="pie" e-name="ToDo" e-tooltip-visible="true" e-enableAnimation="true" e-datasource="PieChartToDo" e-xname="x" e-yname="y" e-divPosition="outsideExtended" e-enablesmartdivs="false" e-startangle="145">
                                            </e-series>
                                        </e-series>
                                    </div>
                                </div>
                            </div>

                            <div class="col-sm-12">
                                <div class="col-sm-12 col-md-6">
                                    <div id="PieIssue" style="width: 180px" ej-chart e-commonseriesoptions-marker-datadiv-visible="false"
                                         e-isresponsive="true"
                                         e-size-height="100px"
                                         e-legend-visible="false" e-title-text="Issue" e-title-font-size="9px">
                                        <e-series>
                                            <e-series e-type="pie" e-name="issue" e-tooltip-visible="true" e-enableAnimation="true" e-datasource="PieChartIssue" e-xname="x" e-yname="y" e-divPosition="outsideExtended" e-enablesmartdivs="false" e-startangle="145">
                                            </e-series>
                                        </e-series>
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-6">
                                    <div id="PieTNA" style="width: 180px" ej-chart e-commonseriesoptions-marker-datadiv-visible="false"
                                         e-isresponsive="true"
                                         e-size-height="100px"
                                         e-legend-visible="false" e-title-text="TNA" e-title-font-size="9px">
                                        <e-series>
                                            <e-series e-type="pie" e-name="TNA" e-tooltip-visible="true" e-enableAnimation="true" e-datasource="PieChartTNA" e-xname="x" e-yname="y" e-divPosition="outsideExtended" e-enablesmartdivs="false" e-startangle="145">
                                            </e-series>
                                        </e-series>
                                    </div>
                                </div>
                            </div>


                        </div>

                    </div>

                    <h3 class="col-md-12">
                        <a href="#">
                            Detail View
                        </a>
                    </h3>
                    <div class="col-sm-12 tab-content" style="padding:0px !important; padding-right:23px !important">

                        <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-type='string' e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-type='string' e-field="AssignByEmployeeName" e-headertext="Assign By" e-width="45"></div>
                                <div e-column e-type='string' e-field="AssignToEmployeeName" e-headertext="Assign To" e-width="45"></div>

                                <div e-column e-type='string' e-field="TaskCategory" e-headertext="Task Category" e-width="30"></div>
                                <div e-column e-type='string' e-field="TaskSubCategory" e-headertext="Task Sub Category" e-width="30"></div>

                                <div e-column e-templateid="#TotalCreated" e-headertext="Created" e-width="20"></div>
                                <div e-column e-templateid="#TotalOverDueRead" e-headertext="Over Due Read" e-width="20"></div>
                                <div e-column e-templateid="#TotalOverDueUnread" e-headertext="Over Due Unread" e-width="20"></div>
                                <div e-column e-templateid="#TodayTask" e-headertext="Today Task" e-width="20"></div>
                                <div e-column e-templateid="#TaskToClose" e-headertext="Task To Close" e-width="20"></div>




                            </div>
                        </div>
                        <script type="text/template" id="TotalCreated">
                            <a href="" ng-click="$parent.showStat(this,'TotalCreated')"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{data.TotalCreated}}</span></a>
                        </script>
                        <script type="text/template" id="TotalOverDueRead">
                            <a href="" ng-click="$parent.showStat(this,'TotalOverDueRead')"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{data.TotalOverDueRead}}</span></a>
                        </script>
                        <script type="text/template" id="TotalOverDueUnread">
                            <a href="" ng-click="$parent.showStat(this,'TotalOverDueUnread')"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{data.TotalOverDueUnread}}</span></a>
                        </script>
                        <script type="text/template" id="TodayTask">
                            <a href="" ng-click="$parent.showStat(this,'TodayTask')"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{data.TodayTask}}</span></a>
                        </script>
                        <script type="text/template" id="TaskToClose">
                            <a href="" ng-click="$parent.showStat(this,'TaskToClose')"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{data.TaskToClose}}</span></a>
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<ej-dialog id="dialogSummaryStat" title=" Task Summary" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target="#maincontainer" e-height="270" e-width="600" e-open="enableBtn">
    <div class="form-elements" style="color:#000000 !important;font-weight:400 !important;">
        <div class="row">
            <div class="form-group">
                <div class="col-sm-4">Department</div>
                <div class="col-sm-8 ">{{SelectedData.Department}}</div>

            </div>
            <div class="form-group">
                <div class="col-sm-4">Assigned By</div>
                <div class="col-sm-8">{{SelectedData.AssignByEmployeeName}}</div>

            </div>
            <div class="form-group">
                <div class="col-sm-4">Assigned To</div>
                <div class="col-sm-8">{{SelectedData.AssignToEmployeeName}}</div>

            </div>
            <div class="form-group">
                <div class="col-sm-4">Category</div>
                <div class="col-sm-8">{{SelectedData.TaskCategory}}</div>

            </div>


        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-4">Sub Cat.</div>
                <div class="col-sm-8">{{SelectedData.TaskSubCategory}}</div>

            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-4"> {{SelectedDataFields.Caption}}</div>
                <div class="col-sm-8">{{SelectedDataFields.Total}}</div>

            </div>
            <div class="form-group">
                <div class="col-sm-4" style="padding-left:30px;">To Do</div>
                <div class="col-sm-8"> <a href="" ng-click="showTaskDetail('ToDo')"><span style="color:#0d4dff; text-decoration:underline;">{{SelectedDataFields.ToDo}}</span></a></div>

            </div>
            <div class="form-group">
                <div class="col-sm-4" style="padding-left:30px;">Issue</div>
                <div class="col-sm-8"> <a href="" ng-click="showTaskDetail('Issue')"><span style="color:#0d4dff; text-decoration:underline;">{{SelectedDataFields.Issue}}</span></a></div>

            </div>
            <div class="form-group">
                <div class="form-group">
                    <div class="col-sm-4" style="padding-left:30px;">TNA</div>
                    <div class="col-sm-8"> <a href="" ng-click="showTaskDetail('TNA')"><span style="color:#0d4dff; text-decoration:underline;">{{SelectedDataFields.TNA}}</span></a></div>

                </div>
            </div>
        </div>
    </div>


</ej-dialog>
<ej-dialog id="dialogDetailTaskMain" title=" Task Detail" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target="#maincontainer" e-width="1000" e-open="enableBtn">
    <div class="common-btn">
        <button type="button" class="btn glyphicon-arrow-down" ng-click="Print();">Download</button>
    </div>

    <div id="GridTaskDetailDashboard" ng-init="chkinit()" ej-grid e-datasource="TaskDetail" e-recorddoubleclick="getTaskDetail"
         e-allowscrolling="true"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-type='string' e-field="IdCode" e-headertext="Id" e-width="70"></div>
            <div e-column e-type='date' e-field="DueDate" e-headertext="Due Date" e-width="80"></div>
            <div e-column e-type='string' e-field="TaskType" e-headertext="Task Type" e-width="100"></div>
            <div e-column e-type='string' e-field="TaskDescription" e-headertext="Task Description" e-width="300"></div>
            <div e-column e-type='string' e-field="CurrentStatus" e-headertext="Current Status" e-width="80"></div>
            <div e-column e-type='date' e-field="CommitmentDate" e-headertext="Commitment Date" e-width="80"></div>
            <div e-column e-type='string' e-field="AssignBy" e-headertext="Assign By" e-width="100"></div>
            <div e-column e-type='string' e-field="AssignTo" e-headertext="Assign To" e-width="100"></div>

            <div e-column e-type='string' e-field="TaskCategory" e-headertext="Task Category" e-width="100"></div>
            <div e-column e-type='string' e-field="TaskSubCategory" e-headertext="Task Sub Category" e-width="100"></div>
            <div e-column e-type='string' e-field="IssueGroup" e-headertext="Issue Group" e-width="80"></div>
            <div e-column e-type='date' e-field="IssueRequiredDate" e-headertext="Iss. Req.Dt" e-width="80"></div>
            <div e-column e-type='date' e-field="IssueExpiryDate" e-headertext="Iss. Exp.Dt" e-width="80"></div>
            <div e-column e-type='date' e-field="IssueCloseDate" e-headertext="Iss. Close.Dt" e-width="80"></div>


        </div>
    </div>
</ej-dialog>

<ej-dialog id="dialogDetailTask" title=" Task Detail" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target="#maincontainer" e-width="900" e-open="enableBtn">
    <div class="form-elements">

        <div class="row">
            <div class="form-group">
                <div class="col-sm-4">Department</div>
                <div class="col-sm-8">{{SelectedData.Department}}</div>

            </div>
            <div class="form-group">
                <div class="col-sm-4">Assigned By</div>
                <div class="col-sm-8">{{SelectedData.AssignByEmployeeName}}</div>

            </div>
            <div class="form-group">
                <div class="col-sm-4">Assigned To</div>
                <div class="col-sm-8">{{SelectedData.AssignToEmployeeName}}</div>

            </div>
            <div class="form-group">
                <div class="col-sm-4">Category</div>
                <div class="col-sm-8">{{SelectedData.TaskCategory}}</div>

            </div>


        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-4">Sub Cat.</div>
                <div class="col-sm-8">{{SelectedData.TaskSubCategory}}</div>

            </div>
        </div>
    </div>

    <div id="GridTaskDetail" ng-init="chkinit()" ej-grid e-datasource="TaskDetail" e-recorddoubleclick="getTaskDetail"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-type='string' e-field="TaskType" e-headertext="Task Type" e-width="100"></div>
            <div e-column e-type='string' e-field="TaskDescription" e-headertext="Task Description"></div>
            <div e-column e-type='string' e-field="CurrentStatus" e-headertext="Current Status" e-width="100"></div>
            <div e-column e-type='string' e-field="DueDate" e-headertext="Due Date" e-width="100"></div>
            <div e-column e-type='string' e-field="CommitmentDate" e-headertext="Commitment Date" e-width="100"></div>

        </div>
    </div>
</ej-dialog>

<ej-dialog id="taskDetails" title=" Task Details" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target="#maincontainer" e-width="900" e-open="enableBtn">
    <div class="form-elements  form-horizontal" id="editTaskPanel">
        @Html.Partial("~/Areas/TaskManagement/Views/Shared/_taskDetails.cshtml")
    </div>
</ej-dialog>
