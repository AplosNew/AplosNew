<table id="screenMain">
    <tr>
        <td>
            <h3 class="site-heading  class=" form-horizontal form-elements"">
                <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  TNA Reports
            </h3>
        </td>
        <td class="text-right" style="width:70px;">
            <span style="font-size:3em; color:green;" ng-hide="ShowFilterScreen==false" ng-click="filterComplete();" class="glyphicon glyphicon-circle-arrow-right"></span>
            <span style="font-size:3em; color:blueviolet;" ng-hide="ShowFilterScreen==true" ng-click="ShowFilterScreen=true; HideGrid=true;" class="glyphicon glyphicon-circle-arrow-left"></span>

        </td>

    </tr>
</table>

<fieldset class="scheduler-border" ng-hide="ShowFilterScreen==false">
    <legend class="scheduler-border" style="padding:0px;">Parameters</legend>


    <div class="col-sm-12 col-md-10">


        <div class="col-xs-12">
            <label class="col-md-2 control-label">Status<sup class="redFont"> *</sup></label>
            <div class="col-md-10 text-left">
                <input type="radio" ng-model="FilterModel.ActiveStatus" value="All">
                <span>All</span>
                <input type="radio" ng-model="FilterModel.ActiveStatus" value="Active">
                <span>Active</span>
                <input type="radio" ng-model="FilterModel.ActiveStatus" value="Closed">
                <span>Closed</span>
            </div>
        </div>
        <div class="col-xs-12">
            <label class="col-md-2 control-label">Date Filter<sup class="redFont"> *</sup></label>
            <div class="col-md-10 text-left">
                <input type="radio" ng-model="FilterModel.DateSelection" value="ASON">
                <span>As on Today</span>
                <input type="radio" ng-model="FilterModel.DateSelection" value="WITHDATE">
                <span>With Date</span>
                <input type="radio" ng-model="FilterModel.DateSelection" value="WITHOUTDATE">
                <span>Without Date</span>
            </div>
        </div>

        <div class="col-xs-12" ng-hide="FilterModel.DateSelection!='WITHDATE'">
            <label class="col-md-2 control-label">From Date<sup class="redFont"> *</sup></label>
            <div class="col-md-4 text-left">
                <input type="text" name="fromdate" ng-model="FilterModel.FromDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required>
            </div>

            <label class="col-md-2 control-label">To Date<sup class="redFont"> *</sup></label>
            <div class="col-md-4 text-left">

                <input type="text" name="fromdate" ng-model="FilterModel.ToDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required>
            </div>
        </div>


    </div>

</fieldset>
<fieldset class="scheduler-border" ng-hide="ShowFilterScreen==true">
    <div class="col-sm-12 col-md-11" style="padding:0px;">
        All tasks will be shown {{FilterModel.DateSelection=='ASON'?'as on today':FilterModel.DateSelection=='WITHOUTDATE'?'without considering date':FilterModel.DateSelection=='WITHDATE'?'from '+FilterModel.FromDate+' to '+FilterModel.ToDate:''}}

        {{FilterModel.ActiveStatus=='All'?'':' for task status '+FilterModel.ActiveStatus}}
    </div>
    <div class="col-sm-12 col-md-1 text-right" style="padding:0px;">
        <span class="glyphicon glyphicon-question-sign" style="height:20px;width:20px;" ng-click="showLegends();"></span>

    </div>
    <legend class="scheduler-border" style="padding:0px;">Select</legend>

    <div class="form-horizontal form-elements" ng-form="modelNewForm">
        <div class="row" ng-hide="ShowFilterScreen==true">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div id="GridElasticSearchTNA" ng-init="chkinit()" ej-grid e-datasource="ElasticSearchData" e-load="filtergridonload"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true" e-actioncomplete="GridFilter"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-type='string' e-field="TaskCategory" e-headertext="Category" e-width="3"></div>
                        <div e-column e-type='string' e-field="TaskSubCategory" e-headertext="Sub Category" e-width="3"></div>
                        <div e-column e-type='string' e-field="Buyer" e-headertext="Buyer" e-width="3"></div>
                        <div e-column e-type='string' e-field="MasterOrderId" e-headertext="Order#" e-width="3"></div>
                        <div e-column e-type='string' e-field="StyleNo" e-headertext="Item" e-width="3"></div>
                        <div e-column e-type='string' e-field="SONo" e-headertext="SO" e-width="3"></div>
                        <div e-column e-type='string' e-field="LineItemReference" e-headertext="LineItemReference" e-width="3"></div>
                        <div e-column e-type='string' e-field="PRNo" e-headertext="Prd. Ord#" e-width="3"></div>

                        <div e-column e-type='string' e-field="ProcessName" e-headertext="Process" e-width="3"></div>
                        <div e-column e-type='string' e-field="Department" e-headertext="Department" e-width="3"></div>
                        <div e-column e-type='string' e-field="AssignToEmployeeName" e-headertext="Assign To" e-width="5"></div>
                        <div e-column e-type='string' e-field="AssignByEmployeeName" e-headertext="Assign By" e-width="5"></div>

                    </div>
                </div>

            </div>
            <div class="col-xs-12 col-sm-12 col-sm-12" style="padding-top:10px;padding-bottom:10px;">
                <label class="col-md-2 control-label">Report Level<sup class="redFont"> *</sup></label>
                <div class="col-md-10 text-left">
                    <input type="radio" ng-model="FilterModel.ReportLevel" value="ALL">
                    <span>All</span>
                    <input type="radio" ng-model="FilterModel.ReportLevel" value="MASTERORDER">
                    <span>Master Order</span>
                    <input type="radio" ng-model="FilterModel.ReportLevel" value="STYLE">
                    <span>Line Item</span>
                    <input type="radio" ng-model="FilterModel.ReportLevel" value="SALESORDER">
                    <span>Sales Order</span>
                    <input type="radio" ng-model="FilterModel.ReportLevel" value="PRODUCTIONORDER">
                    <span>Production Order</span>
                </div>
            </div>



            <div class="col-md-2 col-md-2 col-md-2">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="ClearFilter();" class="btn"><i class="glyphicon glyphicon-circle-arrow-left" tabindex="9"></i> Clear Filter</button></li>

                    </ul>
                </div>
            </div>
            <div class="col-md-10 col-md-10 col-md-10">
                <div class="common-btn">
                    <ul class="list-inline text-right">

                        <li><button ng-click="GetTaskForGrid();" class="btn"><i class="glyphicon glyphicon-file" tabindex="9"></i> View Task List</button></li>
                        <li><button ng-click="PrintExcelException();" class="btn"><i class="glyphicon glyphicon-file" tabindex="9"></i> Exception Task List</button></li>
                        <li><button ng-click="PrintExcel();" class="btn"><i class="glyphicon glyphicon-file" tabindex="9"></i> Export Task List</button></li>
                        <li><button ng-click="ExportToExcel();" class="btn"><i class="glyphicon glyphicon-file" tabindex="9"></i> Export TNA</button></li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12" ng-hide="HideGrid">
                <div class="table-responsive aplos-grid-toggle">
                    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList"
                         e-allowscrolling="true" e-minwidth="450" e-minheight="400" e-recorddoubleclick="getTaskDetail"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true" e-querycellinfo="taskcolorchange"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-type='date' e-field="DueDate" e-headertext="Due Date" e-format="{0:dd-MMM-yyyy}" e-width="100"></div>
                            <div e-column e-type='date' e-field="TempEndDate" e-headertext="Expec. Compl. Date" e-format="{0:dd-MMM-yyyy}" e-width="100"></div>
                            <div e-column e-type='string' e-field="CurrentStatus" e-headertext="Current Status" e-width="100"></div>
                            <div e-column e-type='string' e-field="TaskType" e-headertext="Task Type" e-width="100"></div>
                            <div e-column e-type='string' e-field="Task" e-headertext="Task" e-width="300"></div>
                            <div e-column e-type='string' e-field="AssignTo" e-headertext="Resp. Person" e-width="150"></div>
                            <div e-column e-type='string' e-field="Category" e-headertext="Category" e-width="100"></div>
                            <div e-column e-type='string' e-field="SubCategory" e-headertext="Sub Category" e-width="100"></div>
                            <div e-column e-type='string' e-field="AssignBy" e-headertext="Assign By" e-width="150"></div>
                            <div e-column e-type='date' e-field="CommitmentDate" e-headertext="Commitment Date" e-format="{0:dd-MMM-yyyy}" e-width="100"></div>
                            <div e-column e-type='date' e-field="LastChat" e-headertext="Last Activity" e-width="100"></div>
                            <div e-column e-type='date' e-field="ClosingDate" e-headertext="Closing Date" e-format="{0:dd-MMM-yyyy}" e-width="100"></div>
                            <div e-column e-type='string' e-field="ClosedBy" e-headertext="Closed By" e-width="100"></div>
                            <div e-column e-field="EarlyBy" e-headertext="Early By" e-width="100"></div>
                            <div e-column e-field="LateBy" e-headertext="Late By" e-width="100"></div>
                            <div e-column e-type='string' e-field="Buyer" e-headertext="Buyer" e-width="100"></div>
                            <div e-column e-type='string' e-field="Department" e-headertext="Department" e-width="100"></div>
                            <div e-column e-type='string' e-field="Division" e-headertext="Division" e-width="100"></div>
                            <div e-column e-type='string' e-field="MasterOrderId" e-headertext="Master Order No" e-width="100"></div>
                            <div e-column e-type='string' e-field="StyleNo" e-headertext="Line Item" e-width="200"></div>
                            <div e-column e-type='string' e-field="SONo" e-headertext="SO No" e-width="200"></div>
                            <div e-column e-type='string' e-field="LineItemReference" e-headertext="Line Item Reference" e-width="200"></div>
                            <div e-column e-type='string' e-field="SOQty" e-headertext="SO Qty" e-width="90"></div>
                            <div e-column e-type='string' e-field="PRNo" e-headertext="PR No" e-width="200"></div>
                        </div>
                    </div>
                </div>
            </div>
            @*<div class="col-xs-12 col-sm-12 col-sm-12">
                    <div id="GridResultTNA"></div>

                </div>*@
        </div>
    </div>


</fieldset>
<div class="row">
    <ej-dialog id="dialogLegends" title=" Legends" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#screenMain" e-minwidth="200" e-open="enableBtn">
        @Html.Partial("~/Areas/TaskManagement/Views/Shared/_taskLegends.cshtml")
    </ej-dialog>
</div>
<ej-dialog id="taskDetails" title=" Task Details" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target="#screenMain" e-width="900" e-open="enableBtn">
    <div class="form-elements  form-horizontal" id="editTaskPanel">
        @Html.Partial("~/Areas/TaskManagement/Views/Shared/_taskDetails.cshtml")
    </div>
</ej-dialog>

