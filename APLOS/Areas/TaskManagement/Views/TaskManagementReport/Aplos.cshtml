            <div class="col-xs-12" ng-show="TaskManagementDataList.length>0">
                <div id="GridDesgGpWise" ng-init="chkinit()" ej-grid e-datasource="TaskManagementDataList"
                     e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="DesignationGroup" e-headertext="Designation Group" e-width="140"></div>
                        <div e-column e-field="NoOfEmp" e-headertext="No Of Employee" e-width="120"></div>
                        @*<div e-column e-textalign="right" e-field="CreatedTask" e-headertext="Created Task" e-width="120"></div>
        <div e-column e-textalign="right" e-field="OfTotalTask" e-headertext="% Of Total Task" e-width="120"></div>*@
                        <div e-column e-textalign="right" e-field="TaskDue" e-headertext="Task Due" e-width="120"></div>
                        <div e-column e-textalign="right" e-field="PerTaskDue" e-headertext="% Of Due Task" e-width="120"></div>
