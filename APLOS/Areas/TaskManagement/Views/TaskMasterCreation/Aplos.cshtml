<togglable name="Task Master"></togglable>
@*<div id="treeView"></div>*@
<div class="form-horizontal form-elements" ng-form="modelNewForm">
    <div class="row">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Task Description<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" class="form-control" rows="2" ng-model="model.TaskDescription" maxlength="1024" />
                </div>
            </div>

        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Defined Task<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" class="form-control" rows="2" ng-model="model.UserDefineTask" maxlength="1024" />
                </div>
            </div>

        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" class="form-control" rows="2" ng-model="model.Code" maxlength="1024" />
                </div>
            </div>

        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" class="form-control" rows="2" ng-model="model.StandardName" maxlength="1024" />
                </div>
            </div>

        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence No<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ej-numerictextbox e-decimalplaces="0" e-enablertl="false" e-value="model.Sequence" e-width="100" />
                </div>
            </div>
            <div class="form-group" show-errors>

                <div class="col-sm-4 control-label"><a ej-tooltip e-content="The task can be used as multiple instances. No dependency will be allowed for other tasks" e-width="width">Multiple Instances<sup>*</sup></a></div>

                <div class="col-sm-8">
                    <input type="checkbox" ej-checkbox e-value="model.RepeatTask" e-checked="model.RepeatTask" class="nodetext" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Task Category<sup>*</sup></label>
                <div class="col-sm-8">
                    <input ej-dropdownlist e-enablefiltersearch="true" e-datasource="TaskCategoryList" e-value="model.TaskCategoryId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Task Sub Category<sup>*</sup></label>
                <div class="col-sm-8">
                    <input ej-dropdownlist e-enablefiltersearch="true" e-datasource="TaskSubCategoryList" e-value="model.TaskSubCategoryId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8">
                    <input ej-dropdownlist e-enablefiltersearch="true" e-datasource="ProcessList" e-value="model.ProcessId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Task Department<sup>*</sup></label>
                <div class="col-sm-8">
                    <input ej-dropdownlist e-enablefiltersearch="true" e-minpopupheight="600" e-datasource="DepartmentList" e-value="model.DepartmentId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Task Type<sup>*</sup></label>
                <div class="col-sm-8">
                    <input ej-dropdownlist e-datasource="TaskTypeList" e-value="model.TaskType" @*e-fields-value="Id" e-fields-text="UserName"*@ e-width="100%" />

                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Task Applied On<sup>*</sup></label>
                <div class="col-sm-8">
                    <input ej-dropdownlist e-datasource="TaskAppliedOnList" e-value="model.TaskAppliedOnId" e-change="LoadDependentDates" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                </div>
            </div>
            <div class="form-group">
                <label ng-hide="hideNewOrRepeatOrderCheckbox" class="col-sm-4 control-label">Applied To New Order<sup>*</sup></label>
                <div ng-hide="hideNewOrRepeatOrderCheckbox" class="col-sm-8">
                    <input type="checkbox" ej-checkbox e-value="model.ForNewOrder" e-checked="model.ForNewOrder" class="nodetext" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Task Dependent Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input ej-dropdownlist id="TaskDependentDateList" e-dataBound="SelectDependentDates" e-datasource="TaskDependentDateList" e-value="model.TaskDependentDatesId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Resp. Person Cat.<sup>*</sup></label>
                <div class="col-sm-8">
                    <input ej-dropdownlist e-datasource="ResponsiblePersonCategoryList" e-value="model.ResponsiblePersonCategory" @*e-fields-value="Id" e-fields-text="UserName"*@ e-width="100%" />

                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Active<sup>*</sup></label>
                <div class="col-sm-8">

                    <input type="checkbox" ej-checkbox class="nodetext" e-value="model.Active" e-checked="model.Active" />

                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Assigned Plants<sup>*</sup></label>
                <div class="col-sm-8">
                    <input id="ddlPlantList" ej-dropdownlist e-create="create" e-headertemplate='<input class="temp" type="checkbox" id="checkBox" />' e-multiselectmode="visualmode" e-datasource="PlantList" e-fields-value="Id" e-fields-text="UserName" e-width="100%" e-showcheckbox="true" />
                </div>
            </div>
            <ul class="common-btn list-inline text-left" style="        padding: 20px;">
                <li><button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk right"></i> Save</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Cancel();" class="btn" tabindex="10"><i class="glyphicon glyphicon-repeat"></i> Cancel</button></li>
            </ul>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group">
                <div class="col-xs-12">
                    <div id="gridSubTaskList" ng-init="chkinit()" ej-grid e-datasource="SubTaskList" e-pagesettings-pagesize="4"
                         e-editsettings-allowediting="true" e-editsettings-allowadding="true" e-editsettings-allowdeleting="true"
                         e-toolbarsettings-showtoolbar="true"
                         e-toolbarsettings-toolbaritems="[ej.Grid.ToolBarItems.Add, ej.Grid.ToolBarItems.Edit, ej.Grid.ToolBarItems.Delete, ej.Grid.ToolBarItems.Update, ej.Grid.ToolBarItems.Cancel]"
                         e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filtertype="excel">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-isprimarykey="true"></div>
                            <div e-column e-field="TaskMasterId" e-headertext="TaskMasterId" e-visible="false"></div>
                            <div e-column e-field="SubTaskDescription" e-headertext="Sub Tasks" e-width="5"></div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Lag Days(on dep. date)<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ej-numerictextbox e-decimalplaces="0" e-enablertl="false" e-value="model.LagDays" e-width="100" />
                    <a style="color:blue;font-style:italic;">**Negative value will be considered as lead days</a>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Days(Duration)<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ej-numerictextbox e-decimalplaces="0" e-minvalue="0" e-enablertl="false" e-value="model.StandardDays" e-width="100" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Mandatory<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="checkbox" ej-checkbox class="nodetext" e-value="model.IsMandatory" e-checked="model.IsMandatory" />

                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Milestone<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="checkbox" ej-checkbox class="nodetext" e-value="model.IsTaskMilestone" e-checked="model.IsTaskMilestone" />

                </div>
            </div>
            <div class="form-group" show-errors>

                <label class="col-sm-4 control-label">
                    <a ej-tooltip e-content="The story point depends on the required time of completion of the task.">
                        Story Point
                    </a>
                </label>
                <div class="col-sm-8">
                    <input type="text" ej-numerictextbox e-decimalplaces="0" e-minvalue="0" e-enablertl="false" e-value="model.StoryPoint" e-width="100" />
                </div>
            </div>
            @*<div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Send Email<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="model.WillSendEmail" e-checked="model.WillSendEmail" />

                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Send SMS<sup>*</sup></label>
                    <div class="col-sm-8">

                        <input type="checkbox" ej-checkbox class="nodetext" e-value="model.WillSendSMS" e-checked="model.WillSendSMS" />

                    </div>
                </div>*@
            <div class="form-group" show-errors>

                <div class="col-sm-4 control-label">
                    <a ej-tooltip e-content="The task duration will consider offdays and adjust accordingly if checked">
                        Consider Offdays<sup>*</sup>
                    </a>
                </div>

                <div class="col-sm-8">
                    <input type="checkbox" ej-checkbox class="nodetext" e-value="model.ConsiderOffDays" e-checked="model.ConsiderOffDays" />

                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Remarks<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" class="form-control" rows="2" ng-model="model.Remarks" maxlength="1024" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchCol">
                                <option ng-repeat="option in modelFilterByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="searchVal" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="Gridunassigned" ng-init="chkinit()" ej-grid e-datasource="TaskMasterList" e-recorddoubleclick="Get"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="1"></div>
            <div e-column e-field="Sequence" e-headertext="Seq" e-width="1"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="2"></div>
            <div e-column e-field="TaskDescription" e-headertext="Task Description" e-width="5"></div>
            <div e-column e-field="Process" e-headertext="Process" e-width="3"></div>
            <div e-column e-field="TaskCategory" e-headertext="Task Category" e-width="3"></div>
            <div e-column e-field="Department" e-headertext="Task Department" e-width="3"></div>
            <div e-column e-field="OrderType" e-headertext="Order Type" e-width="3"></div>
            <div e-column e-field="TaskType" e-headertext="Task Type" e-width="3"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="1"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<ej-dialog id="dialogAPI" title="Confirm Delete?" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target=".form-horizontal.form-elements" e-close="onDialogClose" e-minwidth="240" e-minheight="165" e-open="enableBtn">
    <p>
        Are you sure to delete the production order?
    </p>
    <p class="text-right">
        <ul class="list-inline text-right">
            <li><button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-floppy-remove"></i> Yes</button></li>
            <li><button ng-click="ConfirmClose();" class="btn"><i class="glyphicon glyphicon-step-backward"></i> No</button></li>
        </ul>
    </p>
</ej-dialog>

<style>
    .loaderr {
        width: 300px;
        height: 200px;
        background-color: #0780BA;
        color: #fff;
        padding: 100px;
        font-size: 25px;
    }

    .e-grid .e-headercelldiv {
        font-weight: bold;
        font-size: 10px;
        display: block;
        border: 0 none;
        height: 29px;
        line-height: 29px;
        margin: -7px;
        padding: 0 .7em;
        text-align: left;
        white-space: nowrap;
        text-overflow: ellipsis;
        font-family: "Arial Narrow";
    }

    .e-grid .e-rowcell {
        border-width: 1px 0 0 1px;
        padding: .7em;
        line-height: 10px;
        white-space: nowrap;
        width: auto;
        vertical-align: middle;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .e-grid.e-wrap .e-columnheader .e-headercelldiv {
        margin-bottom: 2px;
        margin-top: 0;
        font-size: 9px;
    }

    .e-filterset:before {
        color: white;
    }

    .e-grid .e-headercell, .e-grid .e-headercell-hover {
        height: 30px !important;
    }

    .e-grid .e-rowcell {
        padding: 6px !important;
    }

    .e-pager, .e-grid .e-pagerstatusbar {
        border: none;
        padding: 0px;
        margin: 0px;
    }

    e-grid .e-columnheader .wrap .e-headercelldiv {
        height: Auto;
    }

    .e-grid .e-excelfilter .e-btncontainer input {
        padding: .2em .4em .3em;
    }

    .e-grid.e-dlgcontainer .e-dlgBtns .e-clear {
        padding: 3px;
    }

    .e-grid.e-dlgcontainer .e-dlgBtns .e-filter {
        padding: 3px;
    }

    ::-ms-clear {
        display: none;
    }

    .e-grid.filtered .e-filteredicon {
        color: red;
    }
</style>
