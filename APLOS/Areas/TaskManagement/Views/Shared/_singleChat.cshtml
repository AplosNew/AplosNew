<div class="row" style="height:300px; width:580px; position:relative;">
    <div style="bottom:0;position:absolute;float:none;">
        <div id="wtfChatScroll" class="form-group" style="height:240px;overflow:scroll;width:580px;">

            <div id="anglistviewChats" style="width:570px;" ng-init="chkinit()" ej-grid e-textwrapsettings-wrapmode="both" e-datasource="CurrentChat"
                 e-querycellinfo="ChatScroll" e-allowfiltering="true" e-allowpaging="false" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="false" e-filtersettings-filterType="excel" e-gridlines="none">
                <div e-columns>

                    <div e-column e-headertext="" e-template="#SingleChatDetailView" e-textalign="center"></div>

                </div>
            </div>

            <script type="text/template" id="SingleChatDetailView">

                <div class="col-xs-12 col-sm-2 col-md-2 text-left" style="padding:0px;margin:0px;display:{{data.EmployeeId!=$parent.EMPID?'block':'none'}}">
                    <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{data.EmpPicPath}}"
                         style="float:left;position:absolute; height:30px;width:30px;border:2px solid #efefef; border-radius:50%;" />
                </div>
                <div class="col-xs-12 col-sm-10 col-md-10  text-left" style="padding-left:4px;margin:0px;text-align:{{data.EmployeeId!=$parent.EMPID?'left':'right'}};">

                    <div class="row" style="padding:2px;color:#000000;display:block;">
                        <span> {{data.Chat}}  </span>
                    </div>
                    <div class="row small" style="padding:2px;">
                        <b>
                            <span style="color:#bcbcbc;"> {{data.EmployeeName}} </span>
                            <span style="color:#bcbcbc;"> {{data.DateCreated}}  </span>
                        </b>
                        <br />
                    </div>
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2 text-right" style="padding:0px;padding-right:40px;margin:0px;display:{{data.EmployeeId==$parent.EMPID?'block':'none'}}">
                    <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{data.EmpPicPath}}"
                         style="float:left;position:absolute; height:30px;width:30px;border:2px solid #efefef; border-radius:50%;" />
                </div>

            </script>

        </div>

        <div class="form-group" style="padding-bottom:10px;margin-bottom:10px !important;">
            <table>
                <tr>
                    <td>
                            <input style="color:black;font-weight:400;" type="text" name="User Name" placeholder="Add message here" ng-model="ChatText" ng-enter="AddSingleChat()" class="form-control" maxlength="250" />
                    </td>
                    <td style="width:40px;">
                        <ul class="common-btn list-inline text-right" >
                            <li style="padding:0px;margin:0px;width:100%;">
                                <button type="button" ng-click="AddSingleChat()" class="btn"><i class="glyphicon glyphicon-send"></i></button>
                            </li>
                        </ul>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>