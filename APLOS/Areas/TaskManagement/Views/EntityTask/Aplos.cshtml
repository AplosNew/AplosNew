<style>
    .selected {
        background-color: rgba(234, 97, 83, 0.42) !important;
    }
</style>
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Entity Task</h3>
<div class="row form-elements form-horizontal" ng-form="modelForm">
    <input type="hidden" ng-model="entityTask.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="entityTask.CompanyId"
                            ng-change="getPlant();" ng-options="item.Value as item.Text for item in companyList">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="entityTask.EntityId"
                            ng-change="getEntityMapData();getData();" ng-options="item.Id as item.UserName for item in entityList">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="entityTask.PlantId" name="Plant" ng-change="getEntity();" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>

    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" ng-repeat="x in entities" ng-if="$index % 2 == 0">
            <label class="col-sm-4 control-label">{{x.Text}}</label>
            <div class="col-sm-8" ng-repeat="y in entityValue">
                <label class="col-sm-8 control-label"><b>{{y[x.Value]}}</b></label>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" ng-repeat="x in entities" ng-if="$index % 2 != 0">
            <label class="col-sm-4 control-label">{{x.Text}}</label>
            <div class="col-sm-8" ng-repeat="y in entityValue">
                <label class="col-sm-8 control-label"><b>{{y[x.Value]}}</b></label>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6" style="padding:10px;">
        <ul class="common-btn list-inline text-left">
            <li><button ng-click="TaskMasterPopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Add TaskMaster</button></li>
        </ul>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6" style="padding:10px;">
        <ul class="common-btn list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12" style="margin-top:10px;">
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Sequence</th>
                        <th>Code</th>
                        <th>Standard Name</th>
                        <th>User Name</th>
                        <th>Employee Name</th>
                        <th>Remove</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in entityTaskList" ng-class="{selected : x.Id==null}">
                        <td>{{x.Sequence}}</td>
                        <td>{{x.Code}}</td>
                        <td>{{x.StandardName}}</td>
                        <td>{{x.UserDefineTask}}</td>
                        <td>
                            <div class="form-group">
                                <div class="col-sm-10">
                                    <input type="text" name="Responsible Person" ng-model="x.TaskEmployeeName" class="form-control" readonly>
                                </div>
                                <div class="col-sm-1 show-message">
                                    <button tabindex="13" ng-click="showEmployeeInformationByRowModal('EmpSystemId','TaskEmployeeName',$index);" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                                </div>
                            </div>
                        </td>
                        <td class="text-right table-td">
                            <ul class="list-inline action-list">
                                <li>
                                    <button ng-click="removeRowModal(x.UserDefineTask, $index,'entityTaskList', 'Id', 'TaskMasterId');" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                        <i class="glyphicon glyphicon-remove"></i>
                                    </button>
                                </li>
                            </ul>
                        </td>

                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- #region TaskMasterPopUp -->
<div class="modal fade site-modal in" id="TaskMasterPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Task Master</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="processParameters.searchBy">
                                            <option ng-repeat="option in searchProcessByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="processParameters.search" ng-enter="getTaskData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getTaskData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in taskMasterList|itemsPerPage:processParameters.pageSize"
                                pagination-id="metaData.name + 'taskMasterList'" total-items="processParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="genericPushInTempList(x, $event, entityTaskList, 'Id', 'ProcessId');">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserDefineTask}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'taskMasterList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getTaskData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="addSFG()" class="btn">Done</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->

<div class="modal fade site-modal in" id="Taskemployeepopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">{{popUpTitle}}</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpEmpByEntityParameters.searchBy">
                                            <option ng-repeat="option in sbEmployeeInformation" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpEmpByEntityParameters.search" ng-enter="loadEIData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadEIByEntityData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" ng-show="employeeinformationData.length">
                        <thead>
                            <tr>
                                <th ng-repeat="x in sbEmployeeInformation">{{x.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeinformationData|itemsPerPage:popUpEmpByEntityParameters.pageSize" total-items="popUpEmpByEntityParameters.total_count" pagination-id="metaData.name + 'employeeinformationData'" ng-dblclick="getTaskEmployee(x)">
                                <td ng-repeat="y in sbEmployeeInformation">{{x[y.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'employeeinformationData'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadEIByEntityData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <ul class="list-inline text-right">
                    <li><button type="button" class="btn btn-default" ng-click="closeResponsiblePersonByEntity();">Close</button></li>
                    <li><button ng-click="getEmployeeByEntity();" class="btn">Select</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
