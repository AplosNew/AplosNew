    </div>
</ej-dialog>


<ej-dialog id="dialogSearchEmployee" title="Employees" e-enablemodal="true" e-position-y="0" e-position-x="0" e-showoninit="false" e-target="#ganttContainer" e-close="onDialogClose" e-width="900" e-open="enableBtn">
    <div class="row">
        <div class="row text-right">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="search-form">
                    <div class="row">
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="select-style">
                                <select ng-model="GEEEmployeeSearchCol">
                                    <option ng-repeat="option in GEEEmployeemodelFilterByList" value="{{option.value}}">{{option.name}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-7 col-md-7">
                            <input type="text" class="form-control" placeholder="Search" ng-model="GEEEmployeeSearchVal" ng-enter="GEEgetEmployeeData()">
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2">
                            <button type="button" ng-click="GEEgetEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="SearchEmployee" ng-init="chkinit()" ej-grid e-datasource="GEEEmployeeList" e-gridlines="horizontal"
             e-allowtextwrap="true" e-textwrapsettings.wrapmode="content"
             e-recorddoubleclick="GEEViewEmployeeStatus" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="30" e-primarykey="true" e-visible="false"></div>
