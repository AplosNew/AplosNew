<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Task Dependent Dates</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" @*e-recorddoubleclick="Get"*@
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="DependentDatesEnum" e-headertext="Standard Name" e-width="2"></div>
            <div e-column e-template="#username" e-headertext="User Defined Name" e-width="3"></div>
            <div e-column e-template="#appliedFor" e-headertext="Task Creation Point" e-width="5"></div>
        </div>
    </div>
    <script type="text/template" id="username">

        <input type="text" name="Code" ng-model="data.UserName" class="form-control" maxlength="255">

    </script>
    <script type="text/template" id="appliedFor">
        <table style="padding:0px;margin:0px;">
            <tr>
                <td class="chkrad">
                    <label style="display:inline-flex; vertical-align:top;"><input style=" width:16px;" type="radio" value="MasterOrder" ng-model="data.TaskDependentOn" name="{{data.DependentDatesEnum}}" class="radio"><span style="padding:4px; font-weight:300;">Master Order</span>  </label>
                </td>
                <td class="chkrad">
                    <label style="display:inline-flex; vertical-align:top;"><input style=" width:16px;" type="radio" value="Style" ng-model="data.TaskDependentOn" name="{{data.DependentDatesEnum}}" class="radio"><span style="padding:4px; font-weight:300;">Style </span>  </label>
                </td>
                <td class="chkrad">
                    <label style="display:inline-flex; vertical-align:top;"><input style=" width:16px;" type="radio" value="SalesOrder" ng-model="data.TaskDependentOn" name="{{data.DependentDatesEnum}}" class="radio"><span style="padding:4px; font-weight:300;">Sales Order </span>  </label>
                </td>
                <td class="chkrad">
                    <label style="display:inline-flex; vertical-align:top;"><input style=" width:16px;" type="radio" value="ProductionOrder" ng-model="data.TaskDependentOn" name="{{data.DependentDatesEnum}}" class="radio"><span style="padding:4px; font-weight:300;">Production Order</span>   </label>
                </td>
            </tr>
        </table>

    </script>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
        </ul>
    </div>
</div>
<confirm-modal></confirm-modal>

<style type="text/css">
    .e-grid .e-rowcell {
        padding-top: 0px !important;
        padding-bottom: 0px !important;
        padding-left: 4px !important;
        padding-right: 4px !important;
        font-size: 8.5pt;
    }
</style>