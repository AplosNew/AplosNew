<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Company Group Currency</h3>
<div class="form-horizontal form-elements">
    <div class="form-group">
        <label class="col-sm-2 col-md-2 control-label"> Company Group</label>
        <div class="col-sm-3 col-md-4">
            <div class="select-style">
                <select class="form-control" ng-model="currency.CompanyGroupId" ng-change="getData()" ng-options="item.Value as item.Text for item in companyGroupList" ng-disabled="groupCurrencyList.length>0">
                    <option value=""></option>
                </select>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li><button ng-click="currencyPopUp();" class="btn" ng-disabled="currency.CompanyGroupId==null"><i class="glyphicon glyphicon-plus"></i> Add Currency</button></li>
            </ul>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="groupCurrencyList.length>0">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Currency Name</th>
                    <th>Large unit </th>
                    <th>Small unit </th>
                    <th>In word Format </th>
                    <th>Neglet Decimal </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in  groupCurrencyList|filter:{Archive:false} " ng-class="{selected : x.Id==null}">
                    <td>{{x.Code}}</td>
                    <td>{{x.CurrencyName}}</td>
                    <td>{{x.LargeUnit}}</td>
                    <td>{{x.SmallUnit}}</td>
                    <td>{{x.InWordFormat}}</td>
                    <td>
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="x.IsNeglateDecimal" ng-checked="x.IsNeglateDecimal">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </td>
                    <td class="text-right table-td">
                        <ul class="list-inline action-list">
                            <li>
                                <button ng-click="valuePassInDelModal(x.CurrencyId, x.CurrencyName, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<div class="modal fade site-modal in" id="currencyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Currency
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="currencyParameters.searchBy">
                                            <option ng-repeat="option in currencyList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="currencyParameters.search" ng-enter="getCurrencyData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getCurrencyData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th ng-repeat="x in currencyList">{{x.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in currencies|itemsPerPage:currencyParameters.pageSize" total-items="currencyParameters.total_count"
                                pagination-id="metaData.name + 'currencies'">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td ng-show="{{hh.Value!='Flag'}}" ng-repeat="hh in currencyList">{{x[hh.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'currencies'" direction-links="true" boundary-links="true" on-page-change="getCurrencyData(newPageNumber)"></dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="addCurrency();" class="btn"><i class=""></i> Select</button></li>
                        <li><button type="button" class="btn btn-default" ng-click="CloseCurrencyPopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>