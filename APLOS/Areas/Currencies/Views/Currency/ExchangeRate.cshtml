<togglable name="Exchange Rate"></togglable>
<div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
    <div class="form-group">
        <label class="col-sm-3 col-md-2 control-label">Company<sup>*</sup></label>
        <div class="col-sm-3 col-md-4  show-message">
            <div class="select-style">
                <select ng-model="exchange.CompanyId" class="col-sm-3 form-control" id="compnayId" name="Company" ng-options="item.Value as item.Text for item in companyList"
                        ng-change="CheckParallelCurrencySet(exchange.CompanyId);BaseParallelCurrencySet(exchange.CompanyId);onCompanyChange(exchange.CompanyId);GetCurrencyList();" tabindex="1" required>
                    <option></option>
                </select>
            </div>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<div class="form-elements form-horizontal" ng-form id="exchangeRate" name="exchangeRateForm" ng-show="checkParallelCurrencySet">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="FromDate" ng-disabled="showcurrencyAdd" ng-model="exchange.FromDate" datepicker class="form-control datepicker" tabindex="1" required>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" ng-hide="showcurrencyAdd">
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-6">
                <div class="select-style">
                    <select class="form-control" id="currencyId" ng-model="CurrencyId" ng-options="item.Value as item.Text for item in currencyList" name="Currency" tabindex="5"></select>
                </div>
            </div>
            <div class="col-sm-2 col-md-2">
                <button ng-click="AddCurrency();" class="btn single-small-btn">Add</button>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12" ng-show="insertexchangeratediv">
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>From Currency Unit</th>
                        <th>From Currency</th>
                        <th>To Currency Bank Buying</th>
                        <th>To Currency Bank Selling</th>
                        <th>To Currency Average</th>
                        <th>To Currency</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in exchangeRateList">
                        <td class="text-center">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="x.Active">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </td>
                        <td style="text-align:center">{{x.FromCurrencyUnit}}</td>
                        <td>{{x.CurrencyCode}}</td>
                        <td>
                            <input type="number" class="form-control" ng-model="x.ToCurrencyBankBuying" />
                        </td>
                        <td>
                            <input type="number" class="form-control" ng-model="x.ToCurrencyBankSelling" />
                        </td>
                        <td>
                            <input type="number" class="form-control" ng-model="x.ToCurrencyAverage" />
                        </td>
                        <td>{{x.BaseCurrency}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div ng-show="editexchangeratediv">
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>From Currency Unit</th>
                        <th>From Currency</th>
                        <th>To Currency Bank Buying</th>
                        <th>To Currency Bank Selling</th>
                        <th>To Currency Average</th>
                        <th>To Currency</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in exchangeEditList">
                        <td style="text-align:center">{{x.FromCurrencyUnit}}</td>
                        <td>{{x.FromCurrencyName}}</td>
                        <td><input type="number" class="form-control" ng-model="x.ToCurrencyBankBuying" /></td>
                        <td><input type="number" class="form-control" ng-model="x.ToCurrencyBankSelling" /></td>
                        <td><input type="number" class="form-control" ng-model="x.ToCurrencyAverage" /></td>
                        <td>{{x.ToCurrencyName}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" ng-show="deletebutton" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="exchangeRateParameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="exchangeRateParameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="table-responsive modal-table ">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>From Currency Unit</th>
                    <th>From Currency</th>
                    <th>To Currency Bank Buying</th>
                    <th>To Currency Bank Selling</th>
                    <th>To Currency Average</th>
                    <th>To Currency</th>
                    <th>From Date</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in getexchangeRate |itemsPerPage:exchangeRateParameters.pageSize" total-items="exchangeRateParameters.total_count" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.FromCurrencyUnit}}</td>
                    <td>{{x.FromCurrencyName}}</td>
                    <td>{{x.ToCurrencyBankBuying}}</td>
                    <td>{{x.ToCurrencyBankSelling}}</td>
                    <td>{{x.ToCurrencyAverage}}</td>
                    <td>{{x.ToCurrencyName}}</td>
                    <td>{{x.FromDate |dateFiltering}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
<confirm-modal></confirm-modal>
<toaster-container toaster-options="{'close-button':true, 'animation-class': 'toast-top-center'}"></toaster-container>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeExchangeRow()"></confirm-archive-generic> 