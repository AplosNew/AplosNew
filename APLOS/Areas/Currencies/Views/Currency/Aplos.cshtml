<togglable name="Currency"></togglable>
<div class="form-elements form-horizontal" ng-form id="currency" name="currencyForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input min="1" type="number" name="Sequence" ng-model="currency.Sequence" class="form-control" placeholder="0" required tabindex="1">
                <span class="msg-error" ng-show="currencyForm.Sequence.$error.number">
                    Not valid number!
                </span>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="100" type="text" name="Currency Name" ng-model="currency.Name" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Large Unit<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" ng-model="currency.LargeUnit" name="Large Unit" class="form-control" maxlength="10" tabindex="5" required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Precision<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select name="Precision" ng-model="currency.InWordFormat" class="form-control" ng-options="item.Value as item.Text for item in numberList" required tabindex="7"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="currency.Description" maxlength="250" tabindex="9"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="Code" ng-model="currency.Code" class="form-control" maxlength="10" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">In Word Format<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select name="In Word Format" ng-model="currency.InWordFormat" class="form-control" required tabindex="4">
                        <option value="">--Select--</option>
                        <option>Sub-Continent</option>
                        <option>International</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Small Unit</label>
            <div class="col-sm-8">
                <input type="text" ng-model="currency.SmallUnit" class="form-control" maxlength="10" tabindex="6">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="currency.Remarks" maxlength="250" tabindex="8"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="currency.Active" tabindex="9">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="12"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Name</th>
                <th>Large Unit</th>
                <th>In Word</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in currencies | itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.Name}}</td>
                <td>{{x.LargeUnit}}</td>
                <td>{{x.InWordFormat}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true"
                             boundary-links="true" on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>