<style>
    #medicinereceiptchildId {
        display: none
    }
</style>
<togglable name=" {{title}}"></togglable>

<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Medicine Receipt Head</span></legend>
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="row">
            @*COLUMN 1*@
            <div class="col-xs-12 col-sm-8 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Invoice No.<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="number" name="InvoiceNo" ng-model="ModalNew.InvoiceNo" class="form-control" maxlength="15" required tabindex="3">
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <span class="input-group-addon">{{productNew.PartyCode}}</span>
                            <input type="text" name="Vendor" ng-model="ModalNew.PartyName" class="form-control" required readonly>
                            <span class="input-group-btn">
                                <button name="submit" ng-click="showPartyPopUpNew()" ng-disabled="inventoryMaterialList.length>0" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>

                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @*COLUMN 2*@
            <div class="col-xs-12 col-sm-8 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Invoice Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="ModalNew.InvoiceDate" name="InvoiceDate" datepicker class="form-control" maxlength="50" tabindex="3" required>
                    </div>
                </div>

            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button class="btn" ng-click="displaychild();" tabindex="9"><i class="glyphicon glyphicon-circle-arrow-right"></i> Go</button></li>
                </ul>
            </div>

        </div>

        <div class="table-responsive" id="medicinereceiptchildId" style="margin-top:20px">
            <div id="GridEdit" ej-grid e-datasource="MedicineList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="10"></div>
                    <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                    <div e-column e-field="Medicine" e-headertext="Medicine" e-width="50"></div>
                    <div e-column e-headertext="Expiry Date" e-template="#checkbxExpDate" e-textalign="center" e-width="30"></div>
                    <div e-column e-headertext="Quantity" e-template="#checkboxQty" e-textalign="center" e-width="30"></div>
                    <div e-column e-headertext="Rate" e-template="#checkboxRate" e-textalign="center" e-width="30"></div>
                    <div e-column e-headertext="Amount" e-template="#checkboxAmount" e-textalign="center" e-width="30"></div>

                </div>
            </div>
            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
            </script>
            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
            </script>

            @*Qty*@
            <script type="text/template" id="checkboxQty">
                <input type="number" id="quantityId" name="Quantity" e-change="$parent.functionname" e-value="data.Quantity" class="form-control" maxlength="15" required tabindex="3">
            </script>

            @*Expiry Date*@
            <script type="text/template" id="checkbxExpDate">
                <input type="text" ng-model="data.InvoiceDate" name="InvoiceDate" datepicker class="form-control" maxlength="50" tabindex="3" required>
            </script>

            @*Amount*@
            <script type="text/template" id="checkboxAmount">
                <input type="text" ng-model="data.Amount" name="Amount"  class="form-control" maxlength="50" tabindex="3" required>
            </script>

            @*Rate*@
            <script type="text/template" id="checkboxRate">
                <input type="text" id="rateId" ng-model="data.Rate" name="Rate" class="form-control" maxlength="50" tabindex="3" required>
            </script>
            <div class="common-btn" style="margin-top:10px">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>

        </div>
    </fieldset>


</div>

<confirm-modal></confirm-modal>

@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")



