            <div e-column e-field="InvoiceNumber" e-headertext="Invoice Number" e-width="130"></div>
            <div e-column e-field="InvoiceDate" e-headertext="Invoice Date" e-width="130"></div>
            <div e-column e-field="Medicine" e-headertext="Medicine" e-width="100"></div>
            <div e-column e-field="ExpiryDate" e-headertext="Expiry Date" e-width="100"></div>
            <div e-column e-field="Rate" e-headertext="Rate" e-width="100"></div>
            <div e-column e-field="Quantity" e-headertext="Quantity" e-width="100"></div>
            <div e-column e-field="Amount" e-headertext="Amount" e-width="100"></div>

        </div>
    </div>


</div>
