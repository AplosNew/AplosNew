         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
         e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true"
         
         e-detailsdatabound="detailgrid">
        <div e-columns>
            @*<div e-column e-headertext="Actions" e-width="60">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px; padding-top:1px;" class="btn"><i class="glyphicon glyphicon-print" title="Print Report" ng-click="$parent.AllTabPrint('Grid');" style="margin: -6px;"></i></button>
            </div>*@
            <div e-column e-field="Id" e-headertext="Medicine Receipt Id" e-visible="false" e-width="150"></div>
