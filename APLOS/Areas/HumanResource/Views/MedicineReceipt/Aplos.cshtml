<style>
    #medicinereceiptchildId {
        display: none
    }
</style>
<togglable name=" {{title}}"></togglable>

<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Medicine Receipt Head</span></legend>
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="row">
            @*COLUMN 1*@
            <div class="col-xs-12 col-sm-8 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ModalNew.PlantId" required name="Plant"
                                    tabindex="2">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Invoice No.<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="number" name="InvoiceNo" ng-model="ModalNew.InvoiceNumber" class="form-control" maxlength="15" required tabindex="3">
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Vendor<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <span class="input-group-addon">{{ModalNew.PartyCode}}</span>
                            <input type="text" name="Vendor" ng-model="ModalNew.PartyName" class="form-control" required readonly>
                            <span class="input-group-btn">
                                <button name="submit" ng-click="showPartyPopUpNew()" ng-disabled="inventoryMaterialList.length>0" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>

                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @*COLUMN 2*@
            <div class="col-xs-12 col-sm-8 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Location<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ModelNew.LocationId" required name="Location"
                                    tabindex="2">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in LocationList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Invoice Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="ModalNew.InvoiceDate" name="InvoiceDate" datepicker class="form-control" maxlength="50" tabindex="3" required>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label"></label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">

                            <span class="input-group-btn">
                                <button name="submit" ng-click="openMedicinePopUp()" class="btn single-small-btn" tabindex="1">Add Medicine <i class="cr-icon glyphicon glyphicon-plus-sign"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            @*<div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button class="btn" ng-click="displaychild();" tabindex="9"><i class="glyphicon glyphicon-circle-arrow-right"></i> Go</button></li>
                </ul>
            </div>*@

        </div>


        @*---------------------------------------------------------------------------------------------------------*@
    <div class="table-responsive modal-table">
        <table class="table table-responsive table-striped">
            <thead ng-show="userMedicineList.length">
                <tr>
                    <th>User Name</th>
                    <th>Expiry Date</th>
                    <th>Quantity</th>
                    <th>Amount</th>
                    <th>Rate</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in userMedicineList">
                    <td>{{x.UserName}}</td>
                    <td>
                        <div class="show-message">
                            <input type="text" ng-model="x.ExpiryDate" class="form-control" datepicker>
                        </div>
                    </td>
                    <td>
                        <input type="text" n-decimals="3" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Quantity" ng-model="x.Quantity" ng-keyup="calcAmount(x, $index)">
                    </td>
                    <td>
                        <input type="text" n-decimals="3" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="x.Amount" ng-keyup="calcAmount(x, $index)">
                    </td>
                    <td class="text-right">{{x.Rate | number:2 }}</td>

                </tr>
            </tbody>
            @*<tfoot ng-show="userMedicineList.length">
                <tr>
                    <td colspan="2"><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ TDSList | sumByKey : 'TaxAmount' }}</b></td>
                    <td></td>
                </tr>
            </tfoot>*@
        </table>
    </div>
