<togglable name=" {{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">
        @*COLUMN 1*@
        <div class="col-xs-12 col-sm-8 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Expiry Date</label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="ModalNew.ExpiryDate" name="ExpiryDate" datepicker class="form-control" maxlength="50" tabindex="3" required>
                </div>
            </div>
        </div>

        @*COLUMN 2*@
    <div class="col-xs-12 col-sm-8 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoice Date</label>
            <div class="col-sm-8 show-message">
                <input type="text" ng-model="ModalNew.InvoiceDate" name="InvoiceDate" datepicker class="form-control" maxlength="50" tabindex="3" required>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Select Medicine<sup>*</sup></label>
            <div class="col-sm-6">
                <div class="select-style">
                    <input ej-dropdownlist e-enablefiltersearch="true" e-datasource="MedicineList" e-value="ModalNew.MedicineMasterId" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModalNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>

    </div>
        
    </div>

</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Sequence" e-headertext="Seq" e-width="80"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="150"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="130"></div>

            <div e-column e-field="Category" e-headertext="Category" e-width="100"></div>
            <div e-column e-field="SubCategory" e-headertext="SubCategory" e-width="100"></div>
            <div e-column e-field="Rate" e-headertext="Rate" e-width="100"></div>
            <div e-column e-field="MedicinePurpose" e-headertext="Purpose" e-width="130"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>

        </div>
    </div>
</div>



<confirm-modal></confirm-modal>



