<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{FormTitle}}</h3>
<div class="form-elements form-horizontal" ng-form name="EmployeeJobLocationForm">
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employee Select<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-addon">{{modalNew.EmployeeCode}}</span>
                    <input type="text" name="Vendor" ng-model="modalNew.EmployeeName" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" ng-click="getPopUpData()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>




        <div class="form-group">
            <label class="col-sm-4 control-label">Designation Group :</label>
            <div class="col-sm-8">
                <label>{{modalNew.DesignationGroup}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Legal Designation :</label>
            <div class="col-sm-8">
                <label>{{modalNew.LegalDesignation}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Department :</label>
            <div class="col-sm-8">
                <label>{{modalNew.Department}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee DOJ :</label>
            <div class="col-sm-8">
                <label>{{modalNew.DOJ}}</label>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Job Location<sup>*</sup> </label>
                <div class="col-sm-5 show-message">
                    <div class="select-style">
                        <select id="Religion" class="form-control" name="Job Location" ng-model="modalNew.JobLcSystemID" tabindex="15" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in JobLocationList" value="{{option.SystemID}}">{{option.JobLocation}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-2" ng-show="Flag=='Load All'" style="margin-left:-5px;padding-left:0px;">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button ng-click="LoadAllJobLocation();" class="btn"><i class="glyphicon glyphicon-refresh"></i>Load All</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-sm-2" ng-show="Flag=='Load Less'" style="margin-left:-17px;padding-left:0px;">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button ng-click="LoadPlantJobLocation();" class="btn"><i class="glyphicon glyphicon-refresh"></i>Load Less</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" ng-model="modalNew.EffectiveDate" name="Effective Date" datepicker class="form-control" placeholder="dd-MM-yyyy" required>
            </div>
        </div>
        @*<div class="form-group">
            <label class="col-sm-4 control-label">Shift(Fix)<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="Shit " class="form-control" ng-model="employeeNew.FixSystemID" name="FixedShit" tabindex="16">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in fixedShitList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>*@

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <div class="col-sm-8">
                <div>
                    <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="margin-left: 305px; border: 1px solid; height: 200px; width: 200px;" />
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>


<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="Grid" ej-grid e-datasource="employee" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>