<togglable name="{{FormTitle}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="EmployeeJobLocationForm">
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="col-xs-12">
            <div class="form-group">
                <label class="col-sm-3 control-label">Employee Select<sup>*</sup></label>
                <div class="input-group">
                    <div class="col-sm-4">
                        <input type="text" style="left:-20px;" ng-enter="GetEnterEmployeeOutInfo()" ng-model="leaveApplicationNew.EmployeeCode" placeholder="Employee Code" class="form-control" maxlength="100" tabindex="2">
                    </div>
                    <div class="col-sm-6" style="left:-20px;">
                        <input type="text" name="EmployeeName" ng-model="leaveApplicationNew.EmployeeName" class="form-control" required readonly>
                    </div>
                    <div class="col-sm-2">
                        <span class="input-group-btn">
                            <button name="submit" ng-click="getPopUpData()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Leave Policy :</label>
            <div class="col-sm-8">
                <label>{{LeavePolicyNames}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Designation Group :</label>
            <div class="col-sm-8">
                <label>{{leaveApplicationNew.DesignationGroup}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Legal Designation :</label>
            <div class="col-sm-8">
                <label>{{leaveApplicationNew.LegalDesignation}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee DOJ :</label>
            <div class="col-sm-8">
                <label>{{leaveApplicationNew.DOJ}}</label>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Employee DOC :</label>
            <div class="col-sm-8">
                <label>{{leaveApplicationNew.DOC}}</label>
            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">Approving Authority</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="ID" class="form-control" ng-model="leaveApplicationNew.ApprovalPerson" name="Approval Person">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in empList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Calender Year</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="ID" class="form-control" ng-model="YearNo" name="YearNo" ng-change="getLeaveBalance();getData()">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in leaveYearlist" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-sm-12">
                <div class="radio">
                    <label>
                        <input type="radio" id="fullDay" name="LeaveDayType" ng-model="leaveApplicationNew.LeaveDayType" value="FullDay" ng-checked="leaveApplicationNew.LeaveDayType" ng-click="setEnable()">
                        <span class="cr"><i class="cr-icon"></i></span>Full Day
                    </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <label>
                        <input type="radio" id="fHalfDay" name="LeaveDayType" ng-model="leaveApplicationNew.LeaveDayType" value="FirstHalfDay" ng-click="setDisable()">
                        <span class="cr"><i class="cr-icon"></i></span>First Half Day
                    </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    <label>
                        <input type="radio" id="sHalfDay" name="LeaveDayType" ng-model="leaveApplicationNew.LeaveDayType" value="SecondHalfDay" ng-click="setDisableSec()">
                        <span class="cr"><i class="cr-icon"></i></span>Second Half Day
                    </label>
                </div>
            </div>
        </div>

        <div class="form-group" ng-hide="lvTodate">
            <label class="col-sm-4 control-label" id="tDate">Applied Date<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" name="Applied Date" ng-model="leaveApplicationNew.AppliedDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Leave Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="ID" class="form-control" ng-model="leaveApplicationNew.LTSystemID" name="Leave Type" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in leaveTypelist" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label" id="fDate">From Date<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="From Date" ng-model="leaveApplicationNew.FromDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required tabindex="2">
            </div>
        </div>
        <div class="form-group" ng-hide="lvTodate">
            <label class="col-sm-4 control-label" id="tDate">To Date<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" name="To Date" ng-model="leaveApplicationNew.ToDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="3">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Leave Reason<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <textarea type="text" name="Leave Reason" ng-model="leaveApplicationNew.LvReason" rows="3" class="form-control" required tabindex="4"></textarea>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <div class="col-sm-8">
                <div>
                    <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="margin-left: 305px; border: 1px solid; height: 200px; width: 200px;" />
                </div>
            </div>
        </div>
    </div>
</div>
<div class="common-btn">
    <ul class="list-inline text-left">
        <li> <button ng-click="getData();" ng-disabled="employeeShiftAssign.PlantId===null || employeeShiftAssign.WorkDate===null" class="btn"><i class="glyphicon glyphicon-search"></i> Load</button></li>
    </ul>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Employee Code</th>
                <th>Employee Name</th>
                <th>Shift Name</th>
                <th>Shift InTime</th>
                <th>Effective Date</th>
                @*<th>New Shift</th>*@
                <th>Least InTime</th>
                <th>Day Status</th>
                <th>Deatil</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in EmployeeShiftAssigns |itemsPerPage:ShiftParameters.pageSize" total-items="ShiftParameters.total_count">
                <td>{{x.EmployeeCode}}</td>
                <td>{{x.EmployeeName}}</td>
                <td>{{x.CurrentShift}}</td>
                <td class="text-center">{{x.ShiftInTime}}</td>
                <td>{{x.EffectiveDate | dateFiltering}}</td>
                @*<td>{{x.FixShift}}</td>*@
                <td class="text-center">{{x.InTime}}</td>
                <td class="text-center">{{x.DayStatus}}</td>
                <td>
                    <button ng-click="ShiftPopUp();Hide();Get(x.EmpSystemID, $index)" class="btn" tabindex="9"><i class="glyphicon glyphicon-th-list"></i></button>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="LoadDataList(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="ShiftPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Shift Assignment</h4>
            </div>
            <div class="modal-body">
                <div class="row form-elements form-horizontal">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-sm-6 radio">
                            <input type="radio" name="IsFix" ng-model="employeeShiftAssign.IsFix" ng-value="true" ng-click="ShowShift();">
                            <span></span><span>Fix Shift</span><br />
                        </div>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select id="FixedShit" class="form-control" ng-model="employeeShiftAssign.FixSystemID" name="FixedShit" tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in fixedShitList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-12" id="week">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border"> Week Off Day</legend>
                                <div class="col-sm-12">
                                    <div class="col-sm-12">
                                        <input type="radio" name="WeekOff" ng-model="employeeWeekOffByDay.AlignWithCC" ng-value="true" ng-click="Hide()">
                                        <span></span><span>Aligned with company week off calander</span><br />
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <div class="col-sm-6">
                                        <input type="radio" name="WeekOff" ng-model="employeeWeekOffByDay.AlignWithCC" ng-value="false" ng-click="show()">
                                        <span></span><span>Individualy assign week off day</span><br />
                                        <input type="radio" name="FstDayLengthType" ng-model="employeeWeekOffByDay.FirstHalfRadio" ng-value="Half" id="shift1">
                                        <span></span><span id="shift5">Half</span><br />
                                        <input type="radio" name="FstDayLengthType" ng-model="employeeWeekOffByDay.FirstFullRadio" ng-value="Full" id="shift3">
                                        <span></span><span id="shift4">Full</span>
                                    </div>
                                    <div class="col-sm-6" id="shift2">
                                        <div class="form-group">
                                            <div class="select-style">
                                                <select id="FixedShit" class="form-control" ng-model="employeeWeekOffByDay.FstOffDay" name="StartFromShift" tabindex="1">
                                                    <option value="">--Select--</option>
                                                    <option value="Friday">Friday</option>
                                                    <option value="Saturday">Saturday</option>
                                                    <option value="Sunday">Sunday</option>
                                                    <option value="Monday">Monday</option>
                                                    <option value="Tuesday">Tuesday</option>
                                                    <option value="Tuesday">Tuesday</option>
                                                    <option value="Wednesday">Wednesday</option>
                                                    <option value="Thursday">Thursday</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <div class="select-style">
                                                <select id="FixedShit" class="form-control" ng-model="employeeWeekOffByDay.FstDayLengthType" name="StartFromShift" tabindex="1">
                                                    <option value="">--Select--</option>
                                                    <option value="FirstHalf">First Half</option>
                                                    <option value="SecondHalf">Second Half</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        <div class="col-sm-6 radio">
                            <input type="radio" name="IsFix" ng-model="employeeShiftAssign.IsFix" ng-value="false" ng-click="HideShift();">
                            <span></span><span>Roster Shift</span><br />
                        </div>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select id="FixedShit" class="form-control" ng-model="employeeShiftAssign.RosterSystemID" ng-change="LoadRoasterShift(employeeShiftAssign.RosterSystemID);" name="FixedShit" tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in roasterShitList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="col-sm-12">
                            <div class="form-group">
                                <br />
                                <label class="col-sm-4 control-label" style="margin-right: 70px;">Start From Shift</label>
                                <div class="col-sm-6">
                                    <div class="select-style">
                                        <select id="FixedShit" class="form-control" ng-model="employeeShiftAssign.RosterStartShiftID" name="StartFromShift" tabindex="1">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in rosterStartShiftList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Fix Shift Effective Date</label>
                                <div class="col-sm-8">
                                    <input type="text" ng-model="employeeShiftAssign.EffectiveDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9">
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12" style="margin-top: 25px;" id="shift">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border"></legend>
                                <div class="col-sm-12" style="margin-left: 164px;">
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <div class="select-style">
                                                <select id="FixedShit" class="form-control" ng-model="employeeWeekOffByDay.SndOffDay" name="StartFromShift" tabindex="1">
                                                    <option value="">--Select--</option>
                                                    <option value="Friday">Friday</option>
                                                    <option value="Saturday">Saturday</option>
                                                    <option value="Sunday">Sunday</option>
                                                    <option value="Monday">Monday</option>
                                                    <option value="Tuesday">Tuesday</option>
                                                    <option value="Tuesday">Tuesday</option>
                                                    <option value="Wednesday">Wednesday</option>
                                                    <option value="Thursday">Thursday</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <div class="col-sm-6">
                                        <input type="radio" name="SndDayLengthType" ng-model="employeeWeekOffByDay.SecondHalfRadio" ng-value="Half">
                                        <span></span><span>Half</span><br />
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            <div class="select-style">
                                                <select id="FixedShit" class="form-control" ng-model="employeeWeekOffByDay.SndDayLengthType" name="StartFromShift" tabindex="1">
                                                    <option value="">--Select--</option>
                                                    <option value="FirstHalf">First Half</option>
                                                    <option value="SecondHalf">Second Half</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <div class="col-sm-6">
                                        <input type="radio" name="SndDayLengthType" ng-model="employeeWeekOffByDay.SecondFullRadio" ng-value="Full">
                                        <span></span><span>Full</span><br />
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Roster Shift Effective Date</label>
                                <div class="col-sm-8">
                                    <input type="text" ng-model="employeeShiftAssign.EffectiveDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9">
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label class="col-sm-2 control-label">On The</label>
                                <div class="col-sm-4">
                                    <input type="text" class="form-control" ng-model="employeeShiftAssign.Day" />
                                </div>
                                <label class="col-sm-2 control-label"> th Day</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>