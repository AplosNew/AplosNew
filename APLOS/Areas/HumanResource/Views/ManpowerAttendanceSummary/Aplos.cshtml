<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="assign" role="tab" data-toggle="tab">Manpower Attendance Summary</a></li>
            </ul>
        </div>
        <div class="tab-content">

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="form-elements form-horizontal" ng-form="modelForm">
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                                    <div class="col-sm-8  show-message">
                                        <input type="text" name="Form Date" ng-model="attdnDate" datepicker class="form-control">
                                        <p ng-show="dateMessageFrom" style="color:red" class="show-message">{{dateMessageFrom}}</p>
                                        <p ng-show="dateMessageFrom2" style="color:red" class="show-message">{{dateMessageFrom2}}</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <div class="col-sm-12">
                                        <input id="CWPlant" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                @*<input id="typeList" e-watermarktext="Type" ej-dropdownlist e-enablefiltersearch="true" e-create="create" e-multiselectmode="visualmode" e-datasource="EmployeeCodeTypeList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true" />*@
                                <div class="form-group">
                                    <div class="col-sm-12">
                                        <input id="typeList" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="col-sm-6 " style="font-weight:normal;">With Line<sup></sup></label>
                                    <div class="col-sm-6">
                                        <input type="checkbox" ej-checkbox class="nodetext" e-value="withLine" e-checked="withLine" e-model="withLine" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="col-sm-6 " style="font-weight:normal;">Exclude TBS</label>
                                    <div class="col-sm-6">
                                        <input type="checkbox" ej-checkbox class="nodetext" e-value="WithoutTBS" e-checked="WithoutTBS" e-model="withLine" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="col-sm-6 " style="font-weight:normal;">Exclude Long absenteeism</label>
                                    <div class="col-sm-6">
                                        <input type="checkbox" ej-checkbox class="nodetext" e-value="WithoutLA" e-checked="WithoutLA" e-model="withLine" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="col-sm-6 " style="font-weight:normal;">With Designation<sup></sup></label>
                                    <div class="col-sm-6">
                                        <input type="checkbox" ej-checkbox class="nodetext" e-value="withDesignation" e-checked="withDesignation" e-model="withDesignation" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="GetmanpowerAttendanceSummaryData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>
                            <li>
                                <button ng-click="GetmanpowerAttendanceSummaryrReport();" class="btn"> <i class="glyphicon glyphicon-download"></i> Download</button>
                            </li>

                        </ul>
                    </div>
                    <div class="col-xs-12" ng-show="DataList.length>0">
                        <div id="GridMAD" ej-grid e-datasource="DataList"
                             e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-type="string" e-field="EmpCategory" e-headertext="Emp Category" e-width="80"></div>
                                <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="100"></div>
                                <div e-column e-type="string" e-field="SectionName" e-headertext="Section" e-width="100"></div>
                                <div e-column e-type="string" e-field="SubSectionName" e-headertext="Sub Section" e-width="100"></div>
                                <div e-column e-type="string" e-field="LineName" e-headertext="Line" e-width="100"></div>
                                <div e-column e-type="string" e-field="DesignationName" e-headertext="Designation" e-width="100"></div>
                                <div e-column e-type="string" e-field="ShiftName" e-headertext="ShiftName" e-width="80"></div>
                                <div e-column e-type="string" e-field="BudgetCode" e-headertext="Budget Code" e-width="80"></div>
                                <div e-column e-type="string" e-field="Budgeted" e-headertext="Budgeted" e-width="80"></div>
                                <div e-column e-type="string" e-field="OnRoll" e-headertext="OnRoll" e-width="80"></div>
                                <div e-column e-type="string" e-field="Present" e-headertext="Present" e-width="80"></div>
                                <div e-column e-type="string" e-field="Absent" e-headertext="Absent" e-width="80"></div>
                                <div e-column e-type="string" e-field="Late" e-headertext="Late" e-width="80"></div>
                                <div e-column e-type="string" e-field="Leave" e-headertext="Leave" e-width="80"></div>
                                <div e-column e-type="string" e-field="Others" e-headertext="Others" e-width="80"></div>
                                <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="80"></div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>