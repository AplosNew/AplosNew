                <div id="GridParameterWorkCenter" ej-grid e-datasource="ProcessParameterWorkCenterList" e-templaterefresh="refreshTemplateWorkCenter" e-recorddoubleclick=""
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-headertext="All" e-headertemplateid="#headerTemplateWorkCenter" e-template="#checkboxTemplateWorkCenter" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
                        <div e-column e-field="Workcenter" e-headertext="WorkCenter" e-width="100"></div>
                        <div e-column e-field="WorkcenterCategory" e-headertext="WorkCenter Category" e-width="100"></div>
                        <div e-column e-field="WorkcenterSubCategory" e-headertext="WorkCenter SubCategory" e-width="100"></div>
                        <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                        <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>
                        <div e-column e-field="Capacity" e-headertext="Capacity" e-width="100"></div>
                        <div e-column e-field="UOM" e-headertext="UOM" e-width="100"></div>
                    </div>
                </div>
                <script type="text/template" id="checkboxTemplateWorkCenter">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplateWorkCenter">
                    <input type="checkbox" id="Wheadchk" />
                </script>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-disabled="scheduleNew.Id===null" ng-click="WorkCenterSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
