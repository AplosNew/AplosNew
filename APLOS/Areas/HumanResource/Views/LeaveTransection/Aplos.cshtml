        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="ParameterResponsiblePersonSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
            </ul>
