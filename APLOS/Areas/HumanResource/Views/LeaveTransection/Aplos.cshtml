                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">HR<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="entityId" class="form-control" name="entity" ng-model="ParameterForm.HR" tabindex="7" required>
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in HR" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
