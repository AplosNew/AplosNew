    <div role="tabpanel" ng-form="ReasonMasterDetailsForm" class="tab-pane fade" ng-class="{ 'in':isSetPRM(3), active: isSetPRM(3) }">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">SNO</label>
                <div class="col-sm-8">
                    <input type="text" name="SNO" ng-model="ReasonMasterNew.SNO" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Category</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ReasonMasterNew.ReasonCategory" name="Reason Category"
                                ng-options="item.Value as item.Text for item in ReasonCategoryLists">
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">User Name</label>
                <div class="col-sm-8">
                    <input type="text" name="User Name" ng-model="ReasonMasterNew.UserName" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Type</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ReasonMasterNew.Type" name="Type"
                                ng-options="item.Value as item.Text for item in TypeLists">
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <input type="text" name="Remarks" ng-model="ReasonMasterNew.Remarks" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="ReasonMasterSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                <li> <button ng-click="removeReasonMaster($index,ReasonMasterNew.Id);" ng-disabled="ReasonMasterNew.Id===null" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete </button></li>
                <li> <button ng-click="ReasonMasterClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
        <div id="GridReasonMaster" ej-grid e-datasource="ReasonMasterList" e-recorddoubleclick="GetProcessParaReasonMasterDetails"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="50"></div>
                <div e-column e-field="SNO" e-headertext="SNO" e-width="100"></div>
                <div e-column e-field="UserName" e-headertext="UserName" e-width="100"></div>
                <div e-column e-field="ReasonCategory" e-headertext="ReasonCateogry" e-width="100"></div>
                <div e-column e-field="Type" e-headertext="Type" e-width="100"></div>
                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
            </div>
        </div>
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetPRM(4), active: isSetPRM(4) }">
        <div class="col-xs-12 col-sm-12 col-md-12">
