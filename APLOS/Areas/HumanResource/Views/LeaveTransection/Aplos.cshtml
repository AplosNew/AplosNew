<div class="modal fade site-modal in" id="ProcessParameterPoUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Parameter<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="row" ng-form="ProcessParameterItemForm">
                <div class="col-xs-12">
                </div>
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">SNO<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="SNO" ng-model="ProcessParameterNew.SNO" class="form-control" required maxlength="100" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-xs-12">
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Parameter Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="Parameter Name" ng-disabled="true" ng-model="ProcessParameterNew.ParameterName" class="form-control" maxlength="100" required autocomplete="off">
                            </div>
                            <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                <button ng-click="selectParameter();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12">
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">IsAuditable</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ProcessParameterNew.IsAuditable" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12">
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Critical Level<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="ProcessParameterNew.CriticalLevel" name="Critical Level" required
                                        ng-options="item.Value as item.Text for item in CriticalLevelLists">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12">
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Order Specific</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ProcessParameterNew.OrderSpecific" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" name="Process" ng-disabled="true" ng-model="ProcessParameterNew.Process" class="form-control" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-xs-12">
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Activity Group</label>
                        <div class="col-sm-8">
                            <input type="text" name="Activity Group" ng-disabled="true" ng-model="ProcessParameterNew.ActivityGroup" class="form-control" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-xs-12">
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label" ng-show="ProcessParameterNew.IsAuditable==true">By Whom</label>
