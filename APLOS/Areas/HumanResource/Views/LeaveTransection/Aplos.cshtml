<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetPRM(1), active: isSetPRM(1) }">
        <togglable name="Leave Transection"></togglable>
        <div class="form-elements form-horizontal">
            <div class="row" ng-form="ParameterForm">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100" required />
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="entityId" class="form-control" name="entity" ng-model="ParameterForm.EntityId" tabindex="7" required>
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Budget Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="Position Code" ng-disabled="true" ng-model="ModelNew.BudgetCode" class="form-control" maxlength="100" required autocomplete="off">
                            </div>
                            <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                <button ng-click="selectPositionCode();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ModelNew.IsActive" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-4 show-message">
                            <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Department<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="entityId" class="form-control" name="entity" ng-model="ParameterForm.Department" tabindex="7" required>
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in DepartmentList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveParaMaster();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                        <li> <button ng-click="removeParameter($index,ModelNew.Id);" ng-disabled="ModelNew.Id===null" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete </button></li>
                        <li> <button ng-click="ClearParameter();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="table-responsive aplos-grid-toggle">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                        <div e-column e-field="Sequence" e-headertext="Seq" e-width="80"></div>
                        <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
                        <div e-column e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
                        <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="150"></div>
                        <div e-column e-field="UserName" e-headertext="User Name" e-width="130"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                        <div e-column e-field="IsActive" e-headertext="IsActive" e-width="50"></div>
                    </div>
                </div>
            </div>
        </div>
        <confirm-modal></confirm-modal>
    </div>
