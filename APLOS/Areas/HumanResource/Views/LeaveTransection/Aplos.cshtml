                    <input type="number" name="SNO" ng-model="data.SNO" ng-click="" class="form-control" maxlength="50">
                </div>
            </script>
            <script type="text/template" id="PositionName">
                <div class="col-sm-10" style="padding:0px;">
                    <input type="text" name="Position Name" ng-model="data.PositionName" ng-click="" class="form-control" maxlength="50">
                </div>
