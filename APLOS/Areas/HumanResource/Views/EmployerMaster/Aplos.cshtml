<togglable name=" {{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModalNew.Id">
    <div class="row">
        @*COLUMN 1*@
        <div class="col-xs-12 col-sm-8 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModalNew.Sequence" e-width="100" required />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ModalNew.IsActive" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            </div>

        @*COLUMN 2*@
    <div class="col-xs-12 col-sm-8 col-md-6"> 
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employer Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">

                    <select class="form-control" ng-model="ModalNew.EmployerName" required name="Employer Name"
                            tabindex="2">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in EmployerNameList" value="{{option.Value}}">{{option.Text}}</option>
                        
                    </select>
                </div>
            </div>
        </div>
        @*<div class="form-group">
            <label class="col-sm-4 control-label">Employer Name<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" name="Employer Name" ng-model="ModalNew.EmployerName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>*@
        
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="80"></div>
            
            <div e-column e-field="EmployerName" e-headertext="Employer Name" e-width="70"></div>
            <div e-column e-field="IsActive" e-headertext="Is Active" e-width="100"></div>
            
        </div>
    </div>
</div>



<confirm-modal></confirm-modal>

@Html.Partial("~/Areas/HumanResource/Views/MedicineMaster/_UOMPopUpScreen.cshtml")



