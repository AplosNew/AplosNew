<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Preallocated OT Report</h3>
<div class="form-elements form-horizontal" ng-form name="modelNewForm">
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-sm-12">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Work Date</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="modelNew.WorkDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="11" ng-change="popUp();">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="GetPereAllocatedReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> OT Summary</button></li>
                        <li><button ng-click="GetOTPlanningMatrixReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> OT Planning Matrix</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
