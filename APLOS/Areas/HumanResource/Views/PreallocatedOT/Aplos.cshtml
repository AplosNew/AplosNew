<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{FormTitle}}</h3>
<div class="form-elements form-horizontal" ng-form name="modelNewForm">
    <div class="clearfix"></div>

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Section</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="SectionId" class="form-control" ng-model="modelNew.SectionId" name="Section" tabindex="1" ng-change="popUp();">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in SectionList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-sm-4">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="popUp();" class="btn" style="margin-left:15px"><i class="glyphicon glyphicon-repeat" tabindex="3"></i> Load Employees</button></li>
                    </ul>
                </div>
            </div>
            <div class="col-sm-8">
                <label class="col-sm-5 control-label">Extend The Day Limit</label>
                <div class="col-sm-7" style="margin-top: 5px;">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="modelNew.ExtendTheDayLimit" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Work Date</label>
            <div class="col-sm-8">
                <input type="text" ng-model="modelNew.WorkDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="11" ng-change="popUp();">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Over Time(Hr)</label>
            <div class="col-sm-5">
                <input type="text" only-number name="Over Time(Hr)" ng-model="modelNew.PreallocatedOTHr" placeholder="2.50(decimal)" class="form-control" tabindex="2">
            </div>
            <div class="col-sm-3">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="SetOTHr();" class="btn" style="margin-left:15px"><i class="glyphicon glyphicon-ok-circle" tabindex="3"></i>To All</button></li>
                    </ul>
                </div>
            </div>
        </div>

    </div>
    <div class="col-sm-12">
        <div class="content-container-fluid" style="color:black;">
            <div style="color:black;" id="Grid" ng-init="chkinit()" ej-grid e-datasource="searchdata" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                  e-templaterefresh="refreshTemplateOperation" e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="EmpSystemID" e-headertext="EmpSystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                    <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-width="60"></div>
                    <div e-column e-field="DayStatus" e-headertext="DayStatus" e-width="40"></div>
                    <div e-column e-field="Category" e-headertext="Day Category" e-width="50"></div>
                    <div e-column e-template="#PreallocatedOTHr" e-headertext="Over Time-Hr" e-width="50" style="height: 20px;"></div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="checkboxTemplate">
        <input type="checkbox" ng-model="{{:EmpSystemID}}" class="rowCheckbox" value="{{:EmpSystemID}}" />
    </script>
    <script type="text/x-jsrender" id="headerTemplate">
        <input type="checkbox" id="headchk" />
    </script>
    <script type="text/template" id="PreallocatedOTHr">
        <div class="col-sm-10" style="padding:0px; width:70px;height:20px;">
            <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="data.PreallocatedOTHr" e-watermarktext="2.50(decimal)" e-width="80" />
        </div>
    </script>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>


<confirm-archive-generic data-modalid="confirmDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteDetail()"></confirm-archive-generic>