<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="">
    <div class="tab-design" id="tab_show">

        <div class="tab-content">
            <input type="hidden" name="Id" ng-model="ResidenceData.Id">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                
                <div id="Reportfilters">
                </div>

                <div class="row">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="ViewRSAFilters();" class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-down "></i>View</button></li>
                        </ul>
                    </div>
                </div>


            <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Report</span></legend>
            <div id="PR">
                <div class="content-container-fluid" style="color:black;">

                    <div style="color:black;" id="GridRSA" ej-grid e-datasource="ModelList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionCompleteSelected"
                         e-allowscrolling="true" e-showstackedheader="true" e-allowExcelExport='true' e-enableGroupingBar="true">
                        <div e-columns>
                            <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="180" textAlign='Left'></div>
                            <div e-column e-field="Designation" e-headertext="Employee Given/Legal Designation" e-width="180" textAlign='Left'></div>
                            <div e-column e-field="EmployeeName" e-headertext="Name" e-width="130" textAlign='Left'></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                            <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                            <div e-column e-field="Entity" e-headertext="Entity" e-width="200"></div>
                            <div e-column e-field="ResidenceGroup" e-headertext="Residence Group" e-width="180"></div>
                            <div e-column e-field="ResidenceId" e-headertext="Residence Id" e-width="180"></div>
                            <div e-column e-field="ResidenceNumber" e-headertext="Residence Number" e-width="180"></div>
                            <div e-column e-field="Block" e-headertext="Block" e-width="180"></div>
                            <div e-column e-field="ResidentType" e-headertext="Resident Type" e-width="180"></div>
                            <div e-column e-field="ResidenceSubCategory" e-headertext="Residence Sub Category" e-width="180"></div>
                        </div>
                    </div>

                </div>
            </div>

                        <div class="common-btn">
            <ul class="list-inline text-left">
                <li>
                    <div ej-tooltip e-showshadow="true"  e-content="Export To Excel" ng-click="DownloadResidenceStatusAllocationReport();" e-width="width">
                        <button class="btn"><i class="glyphicon glyphicon-cloud-download"></i>Download</button>
                    </div>
                </li>
            </ul>
        </div>

            </div>
        </div>  
    </div>
</div>

<confirm-modal></confirm-modal>

