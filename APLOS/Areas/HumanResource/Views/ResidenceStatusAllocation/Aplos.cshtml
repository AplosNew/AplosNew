                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="100"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="100"></div>
                            <div e-column e-field="ResidenceNumber" e-headertext="Residence Number" e-width="100"></div>
                            <div e-column e-field="ResidenceName" e-headertext="Residence Name" e-width="100"></div>
                            <div e-column e-field="Block" e-headertext="Block" e-width="100"></div>
                            <div e-column e-field="ResidentType" e-headertext="Resident Type" e-width="100"></div>
                            <div e-column e-field="Location" e-headertext="Location" e-width="100"></div>
