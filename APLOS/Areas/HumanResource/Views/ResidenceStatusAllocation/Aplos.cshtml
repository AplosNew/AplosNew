                            @*<div e-column e-field="Line" e-headertext="Line" e-width="100"></div>*@





                            @* <div e-column e-field="ResidenceGroup" e-headertext="Residence Group" e-width="100"></div>*@

                            @*<div e-column e-field="isOccupied" e-headertext="Occupied" e-width="60"></div>*@
                        </div>
                        <script type="text/template" id="checkboxUnallocationTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
                        </script>
                        <script type="text/x-jsrender" id="headerUnallocationTemplate">
                            <input type="checkbox" id="headcheck" />
                        </script>

                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveRSU();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> UnAllocate</button></li>
                    </ul>

                </div>

                <!--   FOR EMPLOYEE CATEGORY pop up screen    -->
                <div class="modal fade site-modal in" id="EmpCategoryPop" role="dialog" data-backdrop="static">
                    <div class="modal-dialog modal-lg modellgModify ">
                        <div class="modal-content">
                            <div class="modal-header">Employee category Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
                            <div class="modal-body form-elements form-horizontal">
                                <div class="col-md-12">
                                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                                        @*<p>Please Select Employee Goal .</p>*@
                                        <div style="color:black;" id="GridEmployeeGoal" ej-grid e-datasource="EmployeeCategoryList" e-recorddoubleclick="selEmployeeCategory"
                                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                                            <div e-columns>
