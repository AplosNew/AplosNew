                            <div e-column e-template="#OccupiedtemplateAvailable" e-field="Occupied" e-headertext="Occupied" e-width="100"></div>
                            @*<div e-column e-field="Available" e-headertext="Available" e-width="100"></div>*@
                            <div e-column e-template="#templateAvailable" e-field="Available" e-headertext="Available" e-width="70"></div>
