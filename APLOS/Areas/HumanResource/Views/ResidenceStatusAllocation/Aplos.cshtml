                            <div e-column e-field="AddedBy" e-headertext="Added By" e-width="80"></div>
                            <div e-column e-field="AddedDate" e-headertext="Added Date" e-width="80"></div>

                        </div>
                    </div>
                    <script type="text/template" id="AllocationTemplate">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-down "></i>View</button></li>
                            </ul>
                        </div>
                    </script>
                    <script type="text/template" id="templateAvailable">
                                <div class="text-left" style="width:100%">
                                    <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.AvailablePopUpData(this);">{{data.Available}}</a>
                                </div>
                    </script>
                </div>

                 <div class="common-btn">
                    <ul class="list-inline text-right">
                       @* <li> <button ng-click="ResidenceStatusSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>*@
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>

                </div>
                <div class="modal fade site-modal in" id="EmpPop" role="dialog" data-backdrop="static">
                    <div class="modal-dialog modal-lg modellgModify ">
