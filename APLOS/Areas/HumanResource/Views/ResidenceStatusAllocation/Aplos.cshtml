                                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" style="width:100vw !important">
                                                <div e-columns>
                                                    <div e-column e-headertext="Allot / Unallot" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="100"></div>
                                                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="120"></div>
                                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                                    <div e-column e-field="SystemId" e-headertext="System Id" e-width="50"></div>
                                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
