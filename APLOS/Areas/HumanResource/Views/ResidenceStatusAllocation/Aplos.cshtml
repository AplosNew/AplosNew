<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Employee Status/Allocation</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Employee Status/Unallocation</a></li>
            </ul>
        </div>

        <div class="tab-content">
            <input type="hidden" name="Id" ng-model="ResidenceData.Id">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                
        <div id="filters">
        </div>

                <div class="row">
                    <input type="hidden" name="Id" ng-model="ResidenceData.Id">

 
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="view();" class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-down "></i>View</button></li>

                        </ul>

                    </div>
                </div>
