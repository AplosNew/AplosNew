                            @*<div e-column e-field="Allocation" e-headertext="Allocation" e-width="100"></div>*@


                            @* <div e-column e-field="AssetName" e-headertext="Asset Name" e-width="50"></div>*@
                            @* <div e-column e-field="Remarks" e-headertext="Remarks" e-width="50"></div>*@
