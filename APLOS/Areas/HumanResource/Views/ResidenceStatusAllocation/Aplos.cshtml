<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Employee Status/Allocation</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);UnallocationView()" href="" aria-controls="doc" role="tab" data-toggle="tab">Employee Status/Unallocation</a></li>
                @*<li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);UnallocationView()" href="" aria-controls="doc" role="tab" data-toggle="tab">ResidenceMaster Report</a></li>*@
            </ul>
        </div>

        <div class="tab-content">
            <input type="hidden" name="Id" ng-model="ResidenceData.Id">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

                @*<div id="filters">
                    </div>*@

                <div class="row">
                    <input type="hidden" name="Id" ng-model="ResidenceData.Id">


                    @*<div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="view();" class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-down "></i>View</button></li>
                                <li> <button data-toggle="modal" ng-click="ResidenceAllocationReport();" class="btn" tabindex="10"><i class="glyphicon glyphicon-cloud-download"></i> Get Report</button></li>

                            </ul>

                        </div>*@
                </div>
                <div class="table-responsive" id="EGSGrid">
                    <div id="GridEdit" ej-grid style="z-index:3;"
                         e-datasource="ModelList"
                         e-rowdatabound="onactivedatabound"
                         e-allowfiltering="true"
                         e-allowpaging="true"
                         e-allowsorting="true"
                         e-enabletouch="false"
                         e-responsive="true"
                         e-allowselection="true"
                         e-recorddoubleclick="getResidenceNumber"
                         e-filtersettings-filterType="excel">

                        @*<div class="table-responsive" id="EGSGrid" style="margin-top:20px;">
                            <div id="GridEdit" ej-grid e-datasource="ModelList" style="width:100vw !important" e-allowpaging="true">*@
                        <div e-columns>

                            @*<div e-column e-field="Id" e-headertext="Id" e-width="30"></div>*@
                            <div e-column e-field="EmployeeType" e-headertext="Employee Category" e-width="100"></div>
                            <div e-column e-field="Location" e-headertext="Location" e-width="100"></div>

                            @* <div e-column e-field="ResidenceCategory" e-headertext="Residence Category" e-width="100"></div>*@
                            @*<div e-column e-field="ResidenceSubCategory" e-headertext="Residence Sub Category" e-width="100"></div>*@
