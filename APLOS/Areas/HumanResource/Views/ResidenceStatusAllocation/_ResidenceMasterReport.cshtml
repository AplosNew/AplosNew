@*<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Residence Master Report
</h3>*@
<div class="form-elements form-horizontal" ng-form name="EmployeeNewForm">
    <div class=" row">
        <div class="col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-2 control-label">Current Status</label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="EmployeeNew.EmployeeCurrentStatus" required name="Type" tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in EmployeeStatusList" value="{{option.EmployeeCurrentStatus}}">{{option.EmployeeCurrentStatus}}</option>
                        </select>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="gridViewResidenceMAster();" style="margin-top:10px" class="btn" tabindex="9"><i class="glyphicon glyphicon-chevron-down"></i> View</button></li>

                            <li> <button ng-click="ResidenceMasterReport();" style="margin-top:10px" class="btn" tabindex="9"><i class="glyphicon glyphicon-cloud-download"></i> Get Report</button></li>


                        </ul>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">


        <div class="col-xs-12">
            <div class="table-responsive" id="EGSGrid">
                <div id="designationTab" ej-grid style="z-index:3;"
                     e-datasource="ResidenceMasterList"
                     e-rowdatabound="onactivedatabound"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-allowsorting="true"
                     e-enabletouch="false"
                     e-responsive="true"
                     e-allowselection="true"
                     e-filtersettings-filterType="excel">
                    <div e-columns>


                        <div e-column e-field="EmployeeName" e-headertext="Emp Name" e-width="100"></div>
                        <div e-column e-field="DOJ" e-headertext="DOJ" e-width="100"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                        <div e-column e-field="Sub Section" e-headertext="Sub Section" e-width="100"></div>
                        <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                        <div e-column e-field="Legal Designation" e-headertext="Legal Designation" e-width="100"></div>
                        <div e-column e-field="Employee Category" e-headertext="Emp Category" e-width="100"></div>
                        <div e-column e-field="EmployeeStatus" e-headertext="Emp Status" e-width="100"></div>
                        <div e-column e-field="EmployeeCurrentStatus" e-headertext="Emp Ct Sts" e-width="100"></div>
                        <div e-column e-field="Residence Group" e-headertext="Res Group" e-width="100"></div>
                        <div e-column e-field="ResidenceCategory" e-headertext="Res Category" e-width="100"></div>

                        <div e-column e-field="ResidentType" e-headertext="Resi Type" e-width="100"></div>
                        <div e-column e-field="Location" e-headertext="Location" e-width="100"></div>
                        <div e-column e-field="Block" e-headertext="Block" e-width="100"></div>
                        <div e-column e-field="Floor" e-headertext="Floor" e-width="100"></div>
                        <div e-column e-field="ResidenceNumber" e-headertext="Residence Number" e-width="100"></div>
                        <div e-column e-field="Vacancy" e-headertext="Vacancy" e-width="100"></div>


                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="allResidenceMasterReport();" style="margin-top:10px" class="btn" tabindex="9"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>

                    </ul>

                </div>
            </div>


        </div>


    </div>

</div>
