<div class="modal fade site-modal in" id="empPopUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> Employee List <button type="button" class="close" ng-click="closeEmpPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByEmployee">
                                            <option ng-repeat="option in EmployeeSearchList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchEmployee" ng-enter="getSearchedEmployee()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getSearchedEmployee()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        @*style="color:black;overflow:scroll"*@
                        <div style="color:black;" id="partyPopUpGrid" ej-grid e-datasource="EmployeeList" e-recorddoubleclick="doubleEmployee"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                @*<div e-column e-field="Entity" e-headertext="Entity" e-width="50"></div>*@

                                <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="100"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="100"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                            </div>
                        </div>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="SendMedicine();" class="btn"> Add</button></li>
                    <li><button ng-click="closeEmpPopUp();" class="btn"> Close</button></li>
                </ul>

            </div>
        </div>
    </div>
</div>