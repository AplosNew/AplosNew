<togglable name=" {{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModalNewForm">
    <input type="hidden" ng-model="ModalNew.Id">
    <div class="row">
        @*COLUMN 1*@
        <div class="col-xs-12 col-sm-8 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">

                        <input type="text" name="Responsible Person" ng-model="ModalNew.EmployeeName" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="openEmpPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Time<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" id="clock" ej-timepicker ng-model="ModalNew.Time"  e-width="100%" readonly />

                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label"></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">

                        <span class="input-group-btn">
                            <button name="submit" ng-click="openSicknessPopUp()" class="btn single-small-btn" tabindex="1">Add Sickness <i class="cr-icon glyphicon glyphicon-plus-sign"></i></button>
                        </span>

                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModalNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
        </div>

        @*COLUMN 2*@
        <div class="col-xs-12 col-sm-8 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="ModalNew.Date" name="Date" datepicker class="form-control" ng-disabled="true" maxlength="50" tabindex="0" readonly required>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">No. of Visits<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Visits" ng-model="ModalNew.NoOfVisits" class="form-control" maxlength="15" readonly required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label"></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">

                        <span class="input-group-btn">
                            <button name="submit" ng-click="openMedicinePopUp()" class="btn single-small-btn" tabindex="1">Add Medicine <i class="cr-icon glyphicon glyphicon-plus-sign"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Sickness Type</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Service" role="tab" data-toggle="tab">Medicine</a></li>

            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div>
                        <br />
                        <div class="col-xs-12">
                            <div ej-grid style="z-index:3;"
                                 e-datasource="UserSicknessList"
                                 e-rowdatabound="onactivedatabound"
                                 e-allowfiltering="true"
                                 e-allowpaging="true"
                                 e-allowsorting="true"
                                 e-enabletouch="false"
                                 e-responsive="true"
                                 e-allowselection="true"
                                 e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-isprimarykey="true" e-visible="false"></div>
                                    
                                    <div e-column e-field="Category" e-headertext="Category" e-width="100"></div>
                                    <div e-column e-field="Sickness" e-headertext="Purpose" e-width="100"></div>
                                    <div e-column e-headertext="Remarks" e-template="#Remarks" e-textalign="center" e-width="100"></div>
                                </div>
                            </div>
                            <script type="text/template" id="Remarks">
                                <textarea class="form-control" rows="1" ng-model="data.Remarks" maxlength="250" tabindex="6"></textarea>
                            </script>
                        </div>


                    </div>
                </div>


            </div>

            <!--
             / ---------------------------------------------------------------------------------------\
                @*  TAB - 2   *@
             \ ---------------------------------------------------------------------------------------/
            -->

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div>
                        <br />

                        <div class="col-xs-12">
                            <div class="table-responsive" id="medicinereceiptchildId" style="margin-top:20px">
                                <div id="GridEdit" ej-grid e-datasource="userMedicineList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                                    <div e-columns>

                                        <div e-column e-field="Id" e-headertext="Id" e-width="50" e-isprimarykey="true" e-visible="false"></div>

                                        <div e-column e-field="Medicine" e-headertext="Medicine" e-width="100"></div>
                                        <div e-column e-field="Quantity" e-headertext="Quantity" e-width="100"></div>
                                      
                                        <div e-column e-headertext="No. of Days" e-field="NoOfDays"  e-textalign="center" e-width="100"></div>
                                        <div e-column e-headertext="Remarks" e-field="Remarks"  e-textalign="center" e-width="100"></div>
                                    </div>
                                </div>

                               
                            </div>


                        </div>
                    </div>
                </div>



            </div>
        </div>
        <div class="common-btn" style="margin-top:10px">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" id="savebuttonId" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh"></i>Clear</button></li>
               </ul>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="table-responsive aplos-grid-toggle">
    <div style="color:black;" id="Grid" ej-grid e-datasource="MedicalLogGridList"
         e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick="Get" e-allowfiltering="true" e-allowpaging="true"
         e-allowsorting="true" e-allowscrolling="true" e-filtersettings-filterType="excel" e-enabletouch="true"
         e-allowselection="true" e-detailsdatabound="detailgrid">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-visible="true" e-width="50"></div>
            <div e-column e-field="Date" e-headertext="Date" e-width="80"></div>
            <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="100"></div>
            <div e-column e-field="EmployeeName" e-headertext="Name" e-width="100"></div>
            <div e-column e-field="Sickness" e-headertext="Sickness" e-width="100"></div>
            <div e-column e-field="NoOfVisits" e-headertext="No Of Visits" e-width="100"></div>
            @*<div e-column e-field="Days" e-headertext="Days" e-width="100"></div>*@
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>

        </div>
    </div>
   
</div>

@Html.Partial("~/Areas/HumanResource/Views/MedicalLog/_EmployeePopUp.cshtml")
@Html.Partial("~/Areas/HumanResource/Views/MedicalLog/_MedicinePopUp.cshtml")
@Html.Partial("~/Areas/HumanResource/Views/MedicalLog/_SicknessPopUp.cshtml")
@Html.Partial("~/Areas/HumanResource/Views/MedicalLog/_MedicineExpDateWisePopUp.cshtml")

