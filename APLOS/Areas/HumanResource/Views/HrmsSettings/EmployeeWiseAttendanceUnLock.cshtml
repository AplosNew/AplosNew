<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">Employee Wise</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Date Wise</a></li>


        </ul>
    </div>

    <div class="tab-content" id="tabpaneldiv">

        @*Employee Wise*@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet11(11), active: isSet11(11) }">
            <div id="TabEmployee">
                <div class="row">

                    <div class="col-sm-12">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    @*<input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="FromDate" e-width="100%" />*@
                                    <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="FromDate" datepicker class="form-control datepicker" tabindex="1">
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    @*<input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="ToDate" e-width="100%" />*@
                                    <input type="text" name="To Date" placeholder="dd-MM-yyyy" ng-model="ToDate" datepicker class="form-control datepicker" tabindex="1">
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="col-sm-8 control-label">Select Employee<sup>*</sup></label>
                                <div class="col-sm-4 show-message">
                                    <div class="common-btn">
                                        <ul class="common-btn list-inline text-right">
                                            <li><button ng-click="getAllEmployee()" class="btn" tabindex="10"><i class="glyphicon glyphicon-search"></i></button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>








                <ej-dialog id="dialogEmployeeSelect" title=" Employees" e-enablemodal="true" e-position-y="0" e-showoninit="false"
                           e-target=".site-heading" e-minwidth="1100" e-height="580" e-open="enableBtn">
                    <div class="row">
                        <div class="col-sm-12">
                            <div id="GridWorkCenterProduct"
                                 ng-init="chkinit()"
                                 ej-grid e-datasource="allEmployeeList"
                                 e-recorddoubleclick="selectSignleEmployee"
                                 e-allowfiltering="true"
                                 e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                 @*e-allowscrolling="true" e-minwidth="1100" e-minheight="500"*@
                                 e-pagesettings-pagesize="25"
                                 @*e-allowselection="true"*@
                                 e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-field="SystemID" e-headertext="Id" e-width="30" e-primarykey="true"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="30" e-primarykey="true"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                    <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>


                                    @*SystemID
                                        EmployeeCode
                                        EmployeeName
                                        DOJ
                                        DOS
                                        GivenDesignation
                                        Department
                                        PositionName
                                        Designation
                                        DesignationId
                                        PayRollGroupName
                                        PayRollGroupId
                                        LegalDesignation
                                        Section*@

                                </div>
                            </div>
                        </div>
                    </div>

                </ej-dialog>
                <br />
                <div class="row form-horizontal form-elements">
                    <div class="col-xs-12 col-sm-6 col-md-4">

                        Employee Code :   {{selectedSinglemployee.EmployeeCode}}
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-8">

                        Employee Name :   {{selectedSinglemployee.EmployeeName}}
                    </div>

                </div>
                <br /><br />




            </div>
            <div id="GridEmpWise" ej-grid
                 e-datasource="EmployeeLockData"
                 e-recorddoubleclick="Get"
                 @*e-height="500"*@
                 @*e-allowscrolling="true"*@
                 @*e-actioncomplete="actionCompleteSelected4"*@
                 e-templaterefresh="refreshTemplateemployee4"
                 e-endedit="updatedata"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-editsettings-allowediting="true"
                 @*e-editsettings-editmode="dialog"*@
                 e-editsettings-editmode="dialogtemplate"
                 @*e-editsettings-dialogEditorTemplateID="#dialogtemplateID"*@
                 e-allowsorting="true"
                 e-enabletouch="false"
                 e-responsive="true"
                 e-allowselection="true"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-headertext="All" e-headertemplateid="#headerTemplate4" e-template="#checkboxTemplate4" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="WorkDate" e-isprimarykey="true" e-allowediting="false" e-headertext="Locked Date" e-width="100"></div>
                    <div e-column e-field="LockedBy" e-headertext="Locked by" e-width="100"></div>
                    <div e-column e-field="lockedDate" e-isprimarykey="true" e-allowediting="false" e-headertext="Locked Entry Date" e-width="100"></div>

                    <div e-column e-field="IsLock" e-headertext="lock Status" e-width="100"></div>



                </div>
            </div>
            <script type="text/template" id="checkboxTemplate4">
                @*<input type="checkbox" ng-model="data.WorkDate" class="rowCheckbox" enabled="data.IsLock" value="WorkDate" />*@
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" e-enabled="data.IsCheckBoxEnable" />
            </script>
            <script type="text/x-jsrender" id="headerTemplate4">
                <input type="checkbox" id="headchk4" />
                @*<input type="checkbox" ej-checkbox class="rowCheckbox" e-change="$parent.headCheckChangeemployee4" />*@
            </script>

            <div class="row form-horizontal form-elements">
                <div class="col-xs-12 col-sm-10 col-md-12">
                    <div class="common-btn">
                        <ul class="list-inline text-right">

                            <li style="float:right"> <button ng-click="SaveEmployeeWiseLockData();" class="btn"><i class="glyphicon glyphicon-check"></i> Lock</button></li>
                        </ul>
                    </div>

                </div>
                @*<div class="col-xs-12 col-sm-2 col-md-2">
                        <div class="form-group right">
                            <button ng-click="SaveData()" ng-show="ShowSaveButton" class="btn btn-success " style="width:80%">Save</button>
                        </div>
                    </div>*@




            </div>
        </div>

