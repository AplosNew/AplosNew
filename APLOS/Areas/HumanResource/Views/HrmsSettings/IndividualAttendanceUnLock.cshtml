<ej-dialog id="dialogEmployeeSelect" title=" Employees" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target=".site-heading" e-minwidth="800" e-open="enableBtn">

    <div class="row">
        <div class="col-sm-12">
            <div class="col-sm-5">
                <div class="form-group">
                    <label class="col-sm-5 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input class="form-control" type="text" style="visibility:hidden;height:0px;width:0px; border:0px;padding:0px;" autofocus="" />
                        <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="customPara.fromdateWD" datepicker class="form-control datepicker" tabindex="1">
                    </div>
                </div>
            </div>
            <div class="col-sm-5">
                <div class="form-group">
                    <label class="col-sm-5 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="To Date" placeholder="dd-MM-yyyy" ng-model="customPara.todateWD" datepicker class="form-control datepicker" tabindex="1">
                    </div>
                </div>
            </div>
            <div class="col-sm-2">
                <div class="form-group">

                    <div class="col-sm-12 show-message">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-right">
                                <li><button ng-click="LoadWorkDate()" class="btn" tabindex="10"><i class="glyphicon glyphicon-arrow-down"></i>GO</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />
    <div style="display:{{IsSeparatedPart==true? 'inherit' : 'none'}}">
        <div class="row form-horizontal form-elements">
            <div class="col-xs-12 col-sm-6 col-md-3">

                Employee Code :   {{employees.EmployeeCode}}
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3">

                Employee Name :   {{employees.EmployeeName}}
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3">

                DOS :   {{employees.DOS | date : 'dd-MMM-yyyy'}}
            </div>
            <div class="col-xs-12 col-sm-6 col-md-3">


            </div>
        </div>
    </div>

    <div style="display:{{MLVPart==true? 'inherit' : 'none'}}">

        <div class="row form-horizontal form-elements">
            <div class="col-xs-12 col-sm-6 col-md-4">

                Employee Code :   {{employees.EmployeeCode}}
            </div>
            <div class="col-xs-12 col-sm-6 col-md-8">

                Employee Name :   {{employees.EmployeeName}}
            </div>

            <div class="col-xs-12 col-sm-6 col-md-4">

                Lv From Date :   {{employees.FromDate | date : 'dd-MMM-yyyy'}}
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4">

                Lv To Date :   {{employees.ToDate | date : 'dd-MMM-yyyy'}}
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4">

                Baby No :   {{employees.BabyNo}}
            </div>
        </div>

    </div>
    <br />

    <div id="GridSelectEmployeeData" ej-grid
         e-datasource="WorkDateList"
         e-recorddoubleclick="Get"
         e-actioncomplete="actionCompleteSelectedSelectEmployee"
         e-height="400"
         e-allowfiltering="true"
         e-allowpaging="true"
         e-allowsorting="true"
         e-enabletouch="false"
         e-responsive="true"
         e-allowselection="true"
         e-filtersettings-filterType="excel">
        <div e-columns>
            <div e-column @*e-headertext="All" e-headertemplateid="#headerTemplate4"*@ e-template="#checkboxTemplate4" e-textalign="center" e-width="30"></div>
            <div e-column e-field="WorkDate" e-headertext="WorkDate" e-allowediting="false" e-width="200"></div>
            <div e-column e-field="DayStatus" e-headertext="Day Status" e-allowediting="false" e-width="200"></div>
            <div e-column e-field="LockedStatus" e-headertext="Status" e-allowediting="false" e-width="200"></div>
        </div>
    </div>
    <script type="text/template" id="checkboxTemplate4">

        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
    </script>
    <script type="text/x-jsrender" id="headerTemplate4">
        <input type="checkbox" id="headchk4" />

    </script>


    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 ">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="SaveData();" class="btn"><i class="glyphicon glyphicon-check"></i> Un-Lock</button></li>
                </ul>
            </div>
        </div>
    </div>
</ej-dialog>







