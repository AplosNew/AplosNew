

<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Individual Attendance Un-Lock and Lock</h3>












<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">To be Un-Locked</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab">To be Locked</a></li>


        </ul>
    </div>

    <div class="tab-content" id="tabpaneldiv">

        @*Employee Wise*@
