<ej-dialog id="dialogMessageAlert" title="Miss Punch Employee List" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target=".site-heading" e-close="onDialogClose" e-minwidth="90%" e-minheight="50" e-open="enableBtn">

    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">

            <div id="GridOutPunchMissingDataForAlert" ej-grid
                 e-datasource="OutPunchMissingDataForAlert"
                 e-recorddoubleclick="Get"
                 e-allowscrolling="true"
                 @*e-actioncomplete="actionCompleteSelected"
         e-templaterefresh="refreshTemplateemployee"*@
                 @*e-endedit="updatedata"*@
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-enabletouch="false"
                 e-responsive="true"
                 e-allowselection="true"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="110"></div>
                    <div e-column e-field="WorkDate" e-headertext="Work Date" e-allowediting="false" e-width="150"></div>
                    <div e-column e-field="InTime" e-headertext="InTime" e-allowediting="false" e-width="150"></div>
                    <div e-column e-field="OutTime" e-headertext="OutTime" e-allowediting="false" e-width="150"></div>
                    <div e-column e-field="DayStatus" e-headertext="DayStatus" e-allowediting="false" e-width="150"></div>
                    @*<div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="100"></div>
                        <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="100"></div>*@
                    <div e-column e-field="LegalDesignation" e-headertext="Designation" e-allowediting="false" e-width="130"></div>

                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="130"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="130"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="130"></div>
                    <div e-column e-field="PositionName" e-headertext="PositionName" e-allowediting="false" e-width="150"></div>


                </div>
            </div>

        </div>
    </div>
    <div class="common-btn">

        <ul class="list-inline text-right">

            <li> <button ng-click="DownloadOutPunchMissingDataForAlert()" class="btn"><i class="glyphicon glyphicon-check"></i> Download Data</button></li>
            <li> <button ng-click="SaveData()" class="btn"><i class="glyphicon glyphicon-check"></i> Force Lock </button></li>
        </ul>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">



        </div>
    </div>

</ej-dialog>




