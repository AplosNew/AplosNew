                            <label class="col-sm-4 control-label"> Date<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">

                                    <input class="form-control datepicker" datepicker autocomplete="off" ng-change="getUnLockDateList();" ng-model="customPara.lockDate" placeholder="dd-MM-yyyy" type="text" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 ">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="SaveUnLockDateList();" class="btn"><i class="glyphicon glyphicon-check"></i> Lock</button></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <br /><br />




            </div>
