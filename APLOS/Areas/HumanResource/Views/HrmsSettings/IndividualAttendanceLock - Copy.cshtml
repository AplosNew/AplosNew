

<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Individual Attendance Lock</h3>

<div class="row">

    <div class="col-sm-12">
        <div class="col-sm-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="customPara.fromdate" datepicker class="form-control datepicker" tabindex="1">
                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Date" placeholder="dd-MM-yyyy" ng-model="customPara.todate" datepicker class="form-control datepicker" tabindex="1">
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="form-group">
                <label class="col-sm-8 control-label">Select Employee<sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <div class="common-btn">
                        <ul class="common-btn list-inline text-right">
                            <li><button ng-click="getAllEmployee()" class="btn" tabindex="10"><i class="glyphicon glyphicon-search"></i></button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>













<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">To be Locked(Separated)</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab">To be Un-Locked(Separated)</a></li>
            <li role="presentation" ng-class="{ active: isSet33(33) }"><a ng-click="setTab33(33)" href="" aria-controls="aria3" role="tab" data-toggle="tab">To be Locked(MLV)</a></li>
            <li role="presentation" ng-class="{ active: isSet44(44) }"><a ng-click="setTab44(44)" href="" aria-controls="aria3" role="tab" data-toggle="tab">To be Un-Locked(MLV)</a></li>


        </ul>
    </div>

    <div class="tab-content" id="tabpaneldiv">

