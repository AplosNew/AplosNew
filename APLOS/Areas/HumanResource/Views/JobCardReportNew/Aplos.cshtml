<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Job Card</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="col-md-4">
                <div class="form-group" show-errors id="div_FromDate">
                    <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Form Date" ng-model="JobCardReport.FromDate" datepicker class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" show-errors id="div_ToDate">
                    <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="To Date" ng-model="JobCardReport.ToDate" datepicker class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="GetEmployeeInformation();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Load Employee </button></li>
                    </ul>
                </div>
            </div>

            <div class="col-sm-1">
                <div class="common-btn">
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-click="showEmployeeFilterScreen()" class="btn" tabindex="10"><i class="glyphicon glyphicon-filter"></i></button></li>
                    </ul>
                </div>
            </div>

        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-12">
        <div id="Grid" ej-grid
             e-datasource="EmployeeList"
             e-recorddoubleclick="Get"
             e-allowscrolling="true"
             e-pageSettings-pageSize="8"
             e-actioncomplete="actionCompleteSelected"
             e-templaterefresh="refreshTemplateemployee"
             e-allowfiltering="true"
             e-allowpaging="true"
             e-enabletouch="false"
             e-responsive="true"
             e-allowselection="true"
             e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                <div e-column e-headertext="Actions" e-width="40" e-template="#reportButton"></div>
            </div>
        </div>
        <script type="text/template" id="reportButton">
            @*<a style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="fa fa-file-pdf-o" ng-click="$parent.report(this);" style="margin: -6px;">View</i></a>*@
            <a class="btn" style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" href="HumanResource/AttendanceManagement/GetComplianceJobCardReportView?fromDate={{$parent.JobCardReport.FromDate}}&toDate={{$parent.JobCardReport.ToDate}}&EmpIdLoop={{data.EmpSystemId}}&chkAdditionInfo={{$parent.JobCardReport.chkAdditionInfo}}" target="_blank"><i class="fa fa-eye" style="margin: -6px;"></i></a>
            @*<button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="fa fa-file-pdf-o" ng-click="$parent.report(this);" style="margin: -6px;"></i></button>*@

        </script>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Format<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <label>
                        <input type="radio" name="source" ng-model="JobCardReport.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                        <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                    </label>
                    <label>
                        <input type="radio" name="source" ng-model="JobCardReport.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                        <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                    </label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Additional Information</label>
            <div class="col-sm-9">
                <div class="checkbox-site">
                    <label>
                        <input tabindex="8" type="checkbox" ng-model="JobCardReport.chkAdditionInfo">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-left">
            @*<li><button ng-click="jobcardreportFuncView();" class="btn"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>*@
            <li><button ng-click="jobcardreportFunc();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
        </ul>
    </div>
</div>

<div class="modal fade site-modal in" id="JobCardPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Select Employees<button type="button" class="close" data-dismiss="modal">&times;</button></div>

            <div class="col-xs-12 col-sm-6 col-md-12">
                <div id="GridPopUp" ej-grid
                     ng-init="chkinit()"
                     e-datasource="EmployeePopUpList"
                     e-recorddoubleclick="Get"
                     e-allowscrolling="true"
                     e-pageSettings-pageSize="15"
                     e-actioncomplete="actionCompleteSelected"
                     e-templaterefresh="refreshTemplateemployee"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-enabletouch="false"
                     e-responsive="true"
                     e-allowselection="true"
                     e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                    </div>

                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" e-value="data.CheckBoxSelect" />
                    </script>

                    <script type="text/x-jsrender" id="headerTemplate">

                        <input type="checkbox" id="headchk" />
                    </script>

                </div>
            </div>

            <ul class="common-btn list-inline text-right" style="padding: 20px;">
                <li><button ng-click="saveemployeedata();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button></li>
                <li><button ng-click="Back();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Back</button></li>
            </ul>

        </div>
    </div>
</div>

<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
    <div class="bounce3"></div>
</div>

