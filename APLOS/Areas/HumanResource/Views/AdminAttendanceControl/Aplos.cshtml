<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  Admin Attendance Control
</h3>
<div class="form-horizontal form-elements" id="mainContainer">
    <div id="Tab" ej-tab e-create="actionCompleteSingleEmployee">
        <ul>
            <li><a href="#TabEmployee">Employee Wise</a></li>
            <li><a href="#TabDateRange">Date Wise</a></li>
            <li><a href="#TabUpdate">Manual Data Upload</a></li>
        </ul>
        <div id="TabEmployee">
            <div class="row">

                <div class="col-sm-12">

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.CompanyId" ng-change="getPlants()" name="Entity"
                                            ng-options="item.Value as item.Text for item in CompanyList" required>
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="FromDate" e-width="100%" />
                            </div>
                        </div>


                        <div class="form-group">
                            <label class="col-sm-8 control-label">Select Employee<sup>*</sup></label>
                            <div class="col-sm-4 show-message">
                                <div class="common-btn">
                                    <ul class="common-btn list-inline text-right">
                                        <li><button ng-click="getAllEmployee()" class="btn" tabindex="10"><i class="glyphicon glyphicon-search"></i></button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.PlantId" name="Plant"
                                            ng-options="item.Value as item.Text for item in PlantList" required>
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="ToDate" e-width="100%" />
                            </div>
                        </div>
                        
                        <div class="form-group">
                             <label class="col-sm-4 control-label" style="margin-top:10px">Remarks</label>
                             <div class="col-sm-8 show-message" style="margin-top:10px">
                                <input type="text" name="Remarks" ng-model="RemarksEmps" class="form-control" maxlength="250">
                             </div>
                        </div>
                        
                    </div>

                </div>
            </div>

            <div class="row">
                <div class="col-sm-12">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Employee Id</label>
                            <label class="col-sm-8 control-label">{{selectedSinglemployee.Id}}</label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Employee Code</label>
                            <label class="col-sm-8 control-label">{{selectedSinglemployee.EmployeeCode}}</label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Employee Name</label>
                            <label class="col-sm-8 control-label">{{selectedSinglemployee.EmployeeName}}</label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Department</label>
                            <label class="col-sm-8 control-label">{{selectedSinglemployee.Department}}</label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Designation</label>
                            <label class="col-sm-8 control-label">{{selectedSinglemployee.Designation}}</label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Section</label>
                            <label class="col-sm-8 control-label">{{selectedSinglemployee.Section}}</label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">SubSection</label>
                            <label class="col-sm-8 control-label">{{selectedSinglemployee.SubSection}}</label>
                        </div>
                    </div>



                </div>

            </div>

            <div class="row">
                <div id="GridAttendanceControl" ng-init="chkinit()" ej-grid e-datasource="employeeAttendance"
                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-querycellinfo="queryCellInfo"
                     e-allowscrolling="true" e-minheight="400" e-gridlines="vertical" @*e-showstackedheader="true"*@
                     e-actioncomplete="actionCompleteSingleEmployee" e-height="400px" e-rowdatabound="rowDataBoundSingleEmployee"
                     e-filtersettings-filterType="excel">

                    <div e-columns>
                        <div e-column e-field="WorkDate" e-headertext="WorkDate" e-width="100" e-primarykey="true"></div>
                        <div e-column e-field="DayName" e-headertext="Day" e-width="50"></div>
                        <div e-column e-template="#shift" e-headertext="Shift" e-width="220"></div>

                        <div e-column e-template="#indate" e-headertext="In Date" e-width="130"></div>
                        <div e-column e-template="#intime" e-headertext="In Time" e-width="120"></div>
                        <div e-column e-field="IsManualInTime" e-headertext="ManualIn" e-width="50"></div>
                        <div e-column e-template="#outdate" e-headertext="Out Date" e-width="130"></div>
                        <div e-column e-template="#outtime" e-headertext="Out Time" e-width="120"></div>
                        <div e-column e-field="IsManualOutTime" e-headertext="ManualOut" e-width="50"></div>
                        <div e-column e-field="DayStatusCode" e-headertext="DayStatusCode" e-width="70"></div>
                        <div e-column e-template="#daystatus" e-headertext="Day Status" e-width="80"></div>
                        <div e-column e-field="DayStatus" e-headertext="Day Status" e-width="50"></div>
                        <div e-column e-field="IsManualDayStatus" e-headertext="Manual" e-width="40"></div>
                        <div e-column e-template="#showAttendance" e-headertext="Punch" e-width="50"></div>
                        <div e-column e-field="PunchInTime" e-headertext="Punch In Time" e-width="150"></div>
                        <div e-column e-field="PunchOutTime" e-headertext="Punch Out Time" e-width="150"></div>

                        <div e-column e-field="OTHr" e-headertext="OT. Hr" e-width="50"></div>
                        <div e-column e-field="IsOTEntitled" e-headertext="OT Entitled" e-width="50"></div>
                        <div e-column e-field="IsOTComfirm" e-headertext="OT Confirm" e-width="50"></div>
                        <div e-column e-field="ErrorMessage" e-headertext="Error Message" e-width="300"></div>


                    </div>

                </div>



            </div>


            <div class="row">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>  <button type="button" ng-click="SaveSingleEmployee()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    </ul>
                </div>

            </div>
        </div>


        <div id="TabDateRange">

            <div class="row">
                <div class="col-sm-12">

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNewx.CompanyId" ng-change="getPlantsx()" name="Entity"
                                            ng-options="item.Value as item.Text for item in CompanyList" required>
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNewx.PlantId" name="Plant"
                                            ng-options="item.Value as item.Text for item in PlantListx" required>
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-12">
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input e-dateformat="dd-MMM-yyyy" e-change="selectSigleDate" ej-datepicker e-value="FromDateSingleDate" e-width="100%" />
                            </div>
                        </div>

                    </div>
                    <div class="col-sm-3">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Time<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" ej-timepicker e-value="Intime" e-width="100%" />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-right">
                                <li><button ng-click="SetIn()" class="btn" tabindex="10">Set IN</button></li>
                                <li><button ng-click="SetOut()" class="btn" tabindex="10">Set OUT</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-right">
                                <li><button ng-click="showEmployeeFilterScreen()" class="btn" tabindex="10"><i class="glyphicon glyphicon-filter"></i></button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" style="margin-top:10px">Remarks</label>
                            <div class="col-sm-8 show-message" style="margin-top:10px">
                                <input type="text" name="Remarks" ng-model="RemarksEmps" class="form-control" maxlength="250">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                <div class="row">
                    <div id="GridAttendanceControlBySingleDate" ng-init="chkinit()" ej-grid e-datasource="employeeAttendanceBySingleDate"
                         e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                         e-allowscrolling="true" e-minheight="400" e-gridlines="none" e-querycellinfo="queryCellInfo"
                         e-actioncomplete="actionCompleteSingleDay" e-height="400px" e-rowdatabound="rowDataBoundSingleEmployee"
                         e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="100" e-primarykey="true"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="150"></div>
                            <div e-column e-template="#allShiftSingleDay" e-headertext="Shift" e-width="220"></div>

                            <div e-column e-template="#indate" e-headertext="In Date" e-width="130"></div>
                            <div e-column e-template="#intime" e-headertext="In Time" e-width="120"></div>
                            <div e-column e-field="IsManualInTime" e-headertext="ManualIn" e-width="50"></div>
                            <div e-column e-template="#outdate" e-headertext="Out Date" e-width="130"></div>
                            <div e-column e-template="#outtime" e-headertext="Out Time" e-width="120"></div>
                            <div e-column e-field="IsManualOutTime" e-headertext="ManualOut" e-width="50"></div>
                            <div e-column e-field="DayStatusCode" e-headertext="DayStatusCode" e-width="70"></div>
                            <div e-column e-template="#daystatusx" e-headertext="Day Status" e-width="80"></div>
                            <div e-column e-field="DayStatus" e-headertext="Day Status" e-width="50"></div>
                            <div e-column e-field="IsManualDayStatus" e-headertext="Manual" e-width="40"></div>
                            <div e-column e-template="#showAttendance" e-headertext="Punch" e-width="50"></div>
                            <div e-column e-field="PunchInTime" e-headertext="Punch In Time" e-width="150"></div>
                            <div e-column e-field="PunchOutTime" e-headertext="Punch Out Time" e-width="150"></div>

                            <div e-column e-field="OTHr" e-headertext="OT. Hr" e-width="50"></div>
                            <div e-column e-field="IsOTEntitled" e-headertext="OT Entitled" e-width="50"></div>
                            <div e-column e-field="IsOTComfirm" e-headertext="OT Confirm" e-width="50"></div>

                            <div e-column e-field="Department" e-headertext="Department" e-width="150"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-width="150"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="150"></div>
                            <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="150"></div>


                            <div e-column e-field="ErrorMessage" e-headertext="Error Message" e-width="300"></div>


                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li>  <button type="button" ng-click="SaveSingleDay()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        </ul>
                    </div>

                </div>
            </div>


        <div id="TabUpdate">
            <div class="row">

                <div class="col-sm-12">

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.CompanyId" ng-change="getPlants()" name="Entity"
                                            ng-options="item.Value as item.Text for item in CompanyList" required>
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="UpFromDate" e-width="100%" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label" style="margin-top:10px">Employees Selection</label>
                            <div class="col-sm-8 show-message" style="margin-top:10px">
                                <input type="text" name="Location" ng-model="EmpSels" ng-click="selectEmps()" class="form-control" maxlength="200" tabindex="5">
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="UpPlantId" ng-change="EmpsListCh()" name="Plant"
                                            ng-options="item.Value as item.Text for item in PlantList" required>
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="UpToDate" e-width="100%" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" style="margin-top:10px">Remarks</label>
                            <div class="col-sm-8 show-message" style="margin-top:10px">
                                <input type="text" name="Remarks" ng-model="RemarksUpload" class="form-control" maxlength="250">
                            </div>
                        </div>


                    </div>

                </div>
            </div>

            <div class="row">


                <div class="col-md-10">

                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-4 " style="padding: 0 0 0 0 ; margin-right:8px;">
                            <input id="uploadFile" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                        </label>
                        <input type="button" style="margin-right: 8px;" value="Import Data" ng-disabled="enable" class="btn btn-success" ng-click="ImportData()" />
                        <button ng-click="GetSample();" class="btn" style="margin-right: 8px;"><i class="glyphicon glyphicon-download"></i> Get Report File </button>

                    </div>
                </div>


            </div>
            <div class="common-btn" style="margin-top:10px;">
                <ul class="list-inline text-right">
                    <li> <button ng-click="saveFileList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> Save </button></li>
                    @*<li> <button ng-click="clearFileList();" class="btn" tabindex="12"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>*@

                </ul>
            </div>

            <div id="SalGls" ej-grid e-datasource="ExcelUploadData" e-templaterefresh="refreshTemplate"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
                <div e-columns>
                    <div e-column e-field="RowId" e-type="string" e-headertext="Row Id" e-width="80"></div>
                    <div e-column e-field="EmpSystemID" e-type="string" e-headertext="Emp SystemID" e-width="100"></div>
                    <div e-column e-field="EmployeeCode" e-type="string" e-headertext="EmployeeCode" e-width="100"></div>
                    <div e-column e-field="WorkDate" e-type="string" e-headertext="Work Date" e-width="80"></div>
                    <div e-column e-field="InTime" e-type="string" e-headertext="In Time" e-width="80"></div>
                    <div e-column e-field="OutTime" e-type="string" e-headertext="Out Time" e-width="80"></div>
                    <div e-column e-field="ShiftSystemID" e-type="string" e-headertext="Shift SystemID" e-width="100"></div>
                    <div e-column e-field="DayStatus" e-type="string" e-headertext="Day Status" e-width="80"></div>
                </div>
            </div>

        </div>
    </div>
</div>
<style type="text/css">
    .e-grid .e-templatecell {
        padding: 0px 0px 0px 0px;
    }
</style>


<script type="text/template" id="shift">

    <div class="col-sm-10" style="padding:0px; ">

        <div class="select-style">
            <select class="form-control" ng-model="data.ShiftSystemID" name="" required
                    ng-options="item.SystemID as item.UserName for item in $parent.allShift">
                <option value="">--Select--</option>
            </select>

        </div>
    </div>
    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
        <button ng-click="$parent.selectedShiftInfo(this)" class="btn" style="height: 30px;width: 30px; padding: 0px; margin: 0px;">
            <i class="glyphicon glyphicon-list-alt"></i>
        </button>
    </div>
</script>
<script type="text/template" id="allShiftSingleDay">

    <div class="col-sm-10" style="padding:0px; ">

        <div class="select-style">
            <select class="form-control" ng-model="data.ShiftSystemID" name="" required
                    ng-options="item.SystemID as item.UserName for item in $parent.allShiftSingleDay">
                <option value="">--Select--</option>
            </select>

        </div>
    </div>
    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
        <button ng-click="$parent.selectedShiftInfo(this)" class="btn" style="height: 30px;width: 30px; padding: 0px; margin: 0px;">
            <i class="glyphicon glyphicon-list-alt"></i>
        </button>
    </div>
</script>
<script type="text/template" id="showAttendance">
    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
        <button ng-click="$parent.showAttendanceInfo(this)" class="btn" style="height: 30px;width: 30px; padding: 0px; margin: 0px;">
            <i class="glyphicon glyphicon-list-alt"></i>
        </button>
    </div>
</script>

<script type="text/template" id="indate">
    <input type="text" name="Date" ng-model="data.InDate" datepicker class="form-control">
</script>
<script type="text/template" id="intime">

    <input type="text" ej-timepicker e-value="data.InTime" e-width="90%" />

</script>

<script type="text/template" id="outdate">
    <input type="text" name="Date" ng-model="data.OutDate" datepicker class="form-control">
</script>


<script type="text/template" id="outtime">

    <input type="text" ej-timepicker e-value="data.OutTime" e-width="90%" />

</script>

<script type="text/template" id="daystatus">
    <div class="col-sm-10" style="padding:0px;">
        <input type="text" name="NewStatus" ng-model="data.DayStatusNew" ng-click="$parent.getDayStatus(this)" class="form-control" maxlength="200">

    </div>

</script>

<script type="text/template" id="daystatusx">
    <div class="col-sm-10" style="padding:0px;">
        <input type="text" name="NewStatusx" ng-model="data.DayStatusNew" ng-click="$parent.getDayStatusx(this)" class="form-control" maxlength="200">

    </div>

</script>


<div class="row">
    <div class="form-group">
        <ej-dialog id="dialogEmployeeSelect" title=" Employees" e-enablemodal="true" e-position-y="0" e-showoninit="false"
                   e-target="#mainContainer" e-minwidth="900" e-height="580" e-open="enableBtn">
            <div class="row">
                <div id="GridWorkCenterProduct" ng-init="chkinit()" ej-grid e-datasource="selectemployee"
                     e-recorddoubleclick="selectSignleEmployee"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowscrolling="true" e-minwidth="1100" e-minheight="500"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="30" e-primarykey="true"></div>
                        <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="30"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                        <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                        <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                    </div>
                </div>
            </div>

        </ej-dialog>
    </div>
</div>

<div class="row">
    <div class="form-group">
        <ej-dialog id="ViewShiftInfo" title=" Shift Info" e-enablemodal="true" e-position-y="0" e-showoninit="false"
                   e-target="#Tab" e-minwidth="500" e-open="enableBtn">
            <div class="row" style="padding-left:10px;">

                <div class="form-group">
                    <label class="col-sm-4 control-label">Shift Desc</label>
