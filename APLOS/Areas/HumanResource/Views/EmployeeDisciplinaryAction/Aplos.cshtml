<togglable name="Employee Disciplinary Action"></togglable>

<div class="form-elements form-horizontal" id="tabpaneldiv">
    <div class="form-elements form-horizontal" ng-form name="employeeDisciplinaryActionNewForm">
        <div class="clearfix"></div>
        <div class="row">
            <div class="col-sm-12">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="popUp();" class="btn"><i class="glyphicon glyphicon-search" tabindex="3"></i> Search Employees</button></li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Code :</label>
                    <label class="col-sm-8 control-label">{{employeeDisciplinaryActionNew.EmployeeCode}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Name :</label>
                    <label class="col-sm-8 control-label">{{employeeDisciplinaryActionNew.EmployeeName}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Date of Join :</label>
                    <label class="col-sm-8 control-label">{{employeeDisciplinaryActionNew.DOJ}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Given Designation :</label>
                    <label class="col-sm-8 control-label">{{employeeDisciplinaryActionNew.GivenDesignation}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Legal Designation :</label>
                    <label class="col-sm-8 control-label">{{employeeDisciplinaryActionNew.LegalDesignation}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Department :</label>
                    <label class="col-sm-8 control-label">{{employeeDisciplinaryActionNew.Department}}</label>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <div class="col-sm-8">
                        <div>
                            <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="margin-left: 305px; border: 1px solid; height: 200px; width: 200px;" />
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-left">
                <li> <button ng-click="AddNew();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-open"></i> Add New</button></li>
                <li> <button ng-click="Clear();" ng-hide="" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>

        </div>
        <div class="table-responsive modal-table" ng-show="employeeDisciplinaryActions.length>0">
            <table class="table table-striped">
                <thead>
                    <tr>

                        @*<th>Edit</th>*@
                        <th>Employee Code</th>
                        <th>Employee Name</th>
                        <th>Case No</th>
                        <th>Incidence Date</th>
                        <th>DA Category</th>
                        <th>Comment</th>
                        @*<th>Designation</th>
        <th>Given Designation</th>
        <th>Department</th>
        <th>Section</th>
        <th>SubSection</th>*@

                        <th>Letter Issue Date</th>
                        <th>Next Due Date</th>
                        <th>Due Letter</th>
                        <th>Letters</th>
                       
                        
                        
                       
                        
                        
                        <th>Action</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in employeeDisciplinaryActions">
                        @*<td><button ng-click="GetChild(x.Id,$index);" class="btn" tabindex="0"><i class="ng-hide-remove-active"></i>Edit</button></td>*@
                        <td>{{x.EmployeeCode}}</td>
                        <td>{{x.EmployeeName}}</td>
                        <td>{{x.CaseNo}}</td>
                        <td>{{x.EntryDate|dateFiltering}}</td>
                        <td>{{x.DisciplinaryActionCategory}}</td>
                        <td> {{x.Description}}</td>
                        @*<td>{{x.Designation}}</td>
        <td>{{x.GivenDesignation}}</td>
        <td>{{x.Department}}</td>
        <td>{{x.Section}}</td>
        <td>{{x.SubSection}}</td>*@


                        <td>{{x.LetterIssueDate}}</td>
                        <td>{{x.NextLetterDueDate}}</td>
                        <td>{{x.DueLetter}}</td>
                        <td>{{x.Letters}}</td>
                        <td><button ng-click="valuePassInDelModal(x);" data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="0"><i class="ng-hide-remove-active"></i>Remove</button></td>
                        <td><button ng-click="AddFunction(x);" class="btn"><i class="ng-hide-remove-active"></i>TDA</button></td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>

</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Employee Code</th>
                <th>Employee Name</th>
                <th>Designation</th>
                <th>Given Designation</th>
                <th>Department</th>
                <th>Section</th>
                <th>SubSection</th>
                <th>TotalAction</th>
                @*<th>Details</th>*@
            </tr>
        </thead>
        <tbody>

            <tr dir-paginate="x in employeeDisciplinaryActionsCount |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="DisciplinaryActionPopUp1(x.EmpSystemId);Get(x.id,$index);">

                <td>{{x.EmployeeCode}}</td>
                <td>{{x.EmployeeName}}</td>
                <td>{{x.Designation}}</td>
                <td>{{x.GivenDesignation}}</td>
                <td>{{x.Department}}</td>
                <td>{{x.Section}}</td>
                <td>{{x.SubSection}}</td>
                <td>{{x.TotalAction}}</td>
                @*<td>
                        <ul class="list-inline text-right">
                            <li> <button ng-click="DisciplinaryActionPopUp(x.EmpSystemId);" class="btn" tabindex="11"><i class="glyphicon glyphicon-list"></i> Details </button></li>
                        </ul>
                    </td>*@
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getDataCount(newPageNumber)">
    </dir-pagination-controls>
</div>
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="search-form">
                    <div class="row">
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="select-style">
                                <select ng-model="employeeParameters.searchBy">
                                    <option ng-repeat="option in searchEmployeeByList" value="{{option.value}}">{{option.name}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-7 col-md-7">
                            <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2">
                            <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Plant</th>
                                <th>Entity</th>
                                <th>Department</th>
                                <th>Section</th>
                                <th>SubSection</th>
                                <th>Designation</th>
                                <th>Given Designation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                pagination-id="metaData.name + 'employeeList'" ng-dblclick="setData(x)">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.Plant}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                                <td>{{x.SubSection}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.GivenDesignation}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'employeeList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEmployeeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="disciplinaryActionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee Disciplinary Action Details
                <button type="button" class="close" ng-click="CloseDisciplinaryActionPopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Entry Date</th>
                                <th>Disciplinary Action Category</th>
                                <th>Designation</th>
                                <th>Given Designation</th>
                                <th>Department</th>
                                <th>Section</th>
                                <th>SubSection</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in employeeDisciplinaryActions">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.EntryDate|dateFiltering}}</td>
                                <td>{{x.DisciplinaryActionCategory}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.GivenDesignation}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                                <td>{{x.SubSection}}</td>
                            </tr>
                        </tbody>
                    </table>

                </div>


            </div>
            <div class="modal-footer common-btn">
                <button ng-click="CloseDisciplinaryActionPopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="entrydisciplinaryActionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Enter Disciplinary Action
                <button type="button" class="close" ng-click="CloseEntryDisciplinaryActionPopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-elements form-horizontal" ng-form name="employeeDisciplinaryActionNewForm1">
                    <div class="col-xs-12 col-sm-6 col-md-6">

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Disciplinary Action Category<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="DisciplinaryActionCategoryId" class="form-control" ng-model="employeeDisciplinaryActionNew.DisciplinaryActionCategoryId" name="Disciplinary Action Category" required tabindex="1">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in disciplinaryList" value="{{option.Id}}">{{option.UserName}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group" ng-hide="lvTodate" show-errors>
                            <label class="col-sm-4 control-label" id="tDate">Entry Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Entry Date" ng-model="employeeDisciplinaryActionNew.EntryDate" required datepicker class="form-control" placeholder="dd-MMM-yyyy" tabindex="3">
                            </div>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Comments<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <textarea class="form-control" rows="3" ng-model="employeeDisciplinaryActionNew.Description" tabindex="7" maxlength="250" required name="Comments"></textarea>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-save"></i> {{Action}}</button></li>
                        <li> <button ng-click="CloseEntryDisciplinaryActionPopUp();" class="btn" tabindex="11"><i class="glyphicon glyphicon-remove"></i>Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirm_PopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>





<ej-dialog id="LongAbsenteeismInfo"
           title="Employee Disciplinary Action"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#tabpaneldiv"
           e-close="onDialogClose"
           e-minwidth="800"
           e-minheight="300"
           e-open="enableBtn">
    <div class="row form-horizontal form-elements" ng-form>


        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Name:</label>
                    <label class="col-sm-6 control-label">{{EmployeeName}} </label>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Code:</label>
                    <label class="col-sm-6 control-label">{{EmployeeCode}} </label>
                </div>
            </div>
            <div class="col-sm-12">
                @*<div class="form-group">
                        <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="LeaveTypeID" class="form-control" ng-change="getLetterDescription()" ng-model="LongAbsModel.DisciplinaryActionCategoryId" name="Leave Type" required tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in Actionlist" value="{{option.Id}}">{{option.UserName}}</option>
                                </select>
                            </div>
                        </div>

                    </div>*@
                <div class="form-group">
                    <label class="col-sm-4 control-label">Category:</label>
                    <label class="col-sm-6 control-label">{{LongAbsModel.DisciplinaryActionCategory}} </label>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Description</label>
                    <div class="col-sm-8">
                        <input type="text" name="User Name" ng-model="LongAbsModel.Description" class="form-control" ng-change="ChangeDuration()" tabindex="2" maxlength="50">
                    </div>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="form-group" ng-show="ShowcaseLetter=='Yes'">
                    <label class="col-sm-4 control-label">Show Cause Letter:</label>
                    <label class="col-sm-6 control-label">{{ShowcaseLetter}} </label>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="form-group" ng-show="ShowcaseLetter=='Yes'">
                    <label class="col-sm-4 control-label">Letter Name:</label>
                    <label class="col-sm-4 control-label">{{UserName}} </label>
                    <label class="col-sm-2 control-label" style="text-transform:lowercase"> ({{Sequence}} of {{count}})</label>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">designation:</label>
                    <label class="col-sm-6 control-label">{{designation}} </label>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Department:</label>
                    <label class="col-sm-6 control-label">{{Department}} </label>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-5 control-label">Incidence Date</label>
                    <div class="col-sm-7">
                        <input type="text" ej-datepicker e-width="80%" e-dateformat="dd-MMM-yyyy" e-value="LongAbsModel.EntryDate" e-enabled="false" />
                    </div>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-5 control-label">Letter Issue Date</label>
                    <div class="col-sm-7">
                        <input type="text" ej-datepicker e-width="80%" e-dateformat="dd-MMM-yyyy" e-value="LongAbsModel.LetterIssueDate" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-5 control-label">Next Letter Due Date</label>
                    <div class="col-sm-7">
                        <input type="text" ej-datepicker e-width="80%" e-dateformat="dd-MMM-yyyy" e-value="LongAbsModel.NextLetterDueDate" />
                    </div>
                </div>
            </div>




            <div class="col-sm-12">
                <div class="form-group" ng-show="ShowcaseLetter=='Yes'">
                    <label class="col-sm-5 control-label">Letter Format<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <div class="select-style">
                            <select id="LeaveTypeID" class="form-control" ng-model="LongAbsModel.LettersFormat" name="Leave Type" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in LetterFormatList" value="{{option.Id}}">{{option.LetterName}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-12 col-sm-12">

            <div style="color:black;"
                 id="GridEmployeeDisciplinaryActionDetailsList"
                 ej-grid e-datasource="EmployeeDisciplinaryActionDetailsList"
                 @*e-templaterefresh="refreshTemplateemployee"*@
                 e-actioncomplete="actionCompleteSelected"
                 e-pagesettings-pagesize="25"
                 e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowselection="true"
                 e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>

                    <div e-column e-field="ActionName" e-headertext="Letter Name" e-allowediting="false" e-width="150"></div>
                    <div e-column e-field="LetterName" e-headertext="Letter Format" e-allowediting="false" e-width="150"></div>

                    <div e-column e-field="LetterIssueDate" e-headertext="Letter Issue Date" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="NextLetterDueDate" e-headertext="Next Letter Due Date" e-allowediting="false" e-width="80"></div>
                    @*<div e-column e-template="#printandupload" e-headertext="Actions" e-width="100"></div>*@
                    <div e-column e-headertext="Actions" e-template="#printandupload" e-width="140"></div>
                </div>
                <script type="text/template" id="printandupload">
                    <ul class="list-inline text-right">
                        <li><button ng-click="$parent.PrintDisciplinaryActionLetter(this);" class="btn"><i class="glyphicon glyphicon-print" tabindex="10"></i></button></li>
                        @*<li><button ng-click="$parent.AddFunction($event);" class="btn"><i class="glyphicon glyphicon-upload" tabindex="10"></i></button></li>*@
                    </ul>
                </script>

            </div>
        </div>

        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="saveChild();" class="btn" tabindex="9" ng-show="ShowSaveButton"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                </ul>
            </div>
        </div>

        @*<confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteChild();"></confirm-archive-generic>*@
    </div>

</ej-dialog>
