<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>

<div class="form-elements form-horizontal" ng-form name="PhysicalVerificationReport">
    <div class="row" ng-form name="General">



        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">WorkDate<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="WkDate" ng-model="selectedValues.WkDate" datepicker class="form-control" required>


                </div>
            </div>
            
        </div>       
        <br />
        <div class="common-btn" style="padding-right:20px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="loadGrid()" class="btn" tabindex="4"><i class="glyphicon glyphicon-arrow-down"></i> View</button></li>
                <li> <button ng-click="clearFliters()" class="btn" tabindex="5"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>


    </div>
    <confirm-modal></confirm-modal>


    <div id="GridData" style="margin-top:30px;"></div>

    <div class="common-btn" style="margin-top:20px;">
        <ul class="list-inline text-left">
            <li> <button id="but" ng-click="filteringData()" style="display:none;" class="btn" tabindex="6"><i class="glyphicon glyphicon-arrow-down"></i> Transfer to Excel</button></li>
        </ul>
    </div>
</div>


