<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Designation Configuration
</h3>
<div class="form-elements" ng-form id="designationMasterConfigurationNew" name="designationMasterConfigurationForm">
    <div class="row">
        <input type="hidden" ng-model="designationMasterConfigurationNew.Id">

        <div class="form-group col-xs-12 col-sm-4 col-md-4" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="designationMasterConfigurationNew.CompanyId" ng-change="getPlantList();"
                            ng-options="item.Value as item.Text for item in companyList" id="plantId"
                            name="Company" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group col-xs-12 col-sm-4 col-md-4" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="designationMasterConfigurationNew.PlantId" ng-change="reSetDesignationList();getSalaryRuleMasterWithPlant();getLeavePolicyMaster();getAttdnBonusHeaderList();getBonusPolicyMaster();getAttdnBonusPmtPolicyMaster();getBonusPolicyMonthlyRetainMaster();getPFPolicyMaster();getESICPolicyMaster();getOverTimePmtPolicyMaster();GetAdditionalPayDayCbo();"
                            ng-options="item.Value as item.Text for item in plantList" id="plantId"
                            name="Plant" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group col-xs-12 col-sm-4 col-md-4" show-errors>
            <label class="col-sm-5 control-label">Designation Group<sup>*</sup></label>
            <div class="col-sm-7 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="designationMasterConfigurationNew.DesignationGroupId" ng-change="getDesignationMasterConfiguration()"
                            ng-options="item.Value as item.Text for item in designationGroupList" id="plantId"
                            name="Company" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Designation</th>
                            <th>Employee Category</th>
                            <th>Process Set</th>
                            <th>Account Group</th>
                            <th>Salary Rule</th>
                            <th>Leave Policy</th>
                            <th>Salary Fixation</th>
                            <th>Bonus Policy Master</th>
                            <th>Attdn Bonus Pmt Policy Master</th>
                            <th>Bonus Policy Monthly Retain Master</th>
                            <th>PF Policy Master</th>
                            <th>ESIC Policy Master</th>
                            <th>Holiday Pay Day</th>
                            <th>OT Entitle</th>
                            <th>OT Pmt Policy Master</th>
                            <th>Attdn Bonus New</th>
                            <th>Notice Period</th>
                            <th style="width:10px !important;">Legal Designation</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in designationMasterConfigurationList">
                            <td>{{x.UserName}}</td>

                            <td>
                                {{x.EmployeeCategory}}
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.RecruitmentProcessSetId"
                                            ng-options="item.Value as item.Text for item in recruitmentPlanningProcessSetList" id="RecruitmentProcessSetId"
                                            name="RecruitmentPlanningProcessSet" required tabindex="1" style="width: 140px;">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" name="AccountsGroup" ng-model="x.AccountsGroupId" id="AccountsGroupId" tabindex="1" style="width: 140px;"
                                            ng-options="item.Value as item.Text for item in accountsGroupList">
                                        <option></option>
                                    </select>
                                </div>

                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.SalaryRuleMasterId"
                                            ng-options="item.Value as item.Text for item in salaryRuleMasterList" id="SalaryRuleMasterId"
                                            name="SalaryRuleMaster" required tabindex="1" style="width: 140px;">
                                        <option></option>
                                    </select>
                                </div>
                            </td>

                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.LeavePolicyMasterId"
                                            ng-options="item.Value as item.Text for item in LeavePolicyMasterList" id="LeavePolicyMasterId"
                                            name="LeavePolicyMaster" required tabindex="1" style="width: 140px;">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.SalaryFixationSettingId"
                                            ng-options="item.Value as item.Text for item in salaryFixationList" id="SalaryFixationSettingId"
                                            name="SalaryFixation" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.BonusPolicyMasterId"
                                            ng-options="item.Value as item.Text for item in BonusPolicyMasterList" id="BonusPolicyMasterId"
                                            name="BonusPolicyMaster" required tabindex="1" style="width: 140px;">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.AttdnBonusPmtPolicyMasterId"
                                            ng-options="item.Value as item.Text for item in AttdnBonusPmtPolicyMasterList" id="AttdnBonusPmtPolicyMasterId"
                                            name="AttdnBonusPmtPolicyMaster" required tabindex="1" style="width: 140px;">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.BnsPlcMthRetainID"
                                            ng-options="item.Value as item.Text for item in BonusPolicyMonthlyRetainMasterList" id="BnsPlcMthRetainID"
                                            name="BonusPolicyMonthlyRetainMaster" required style="width: 150px;">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.PFPolicyMasterID"
                                            ng-options="item.Value as item.Text for item in PFPolicyMasterList" id="AttdnBonusPmtPolicyMasterId"
                                            name="PFPolicyMaster" required style="width: 150px;">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.ESICPolicyMasterID"
                                            ng-options="item.Value as item.Text for item in ESICPolicyMasterList" id="AttdnBonusPmtPolicyMasterId"
                                            name="ESICPolicyMaster" required style="width: 150px;">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.HolidayPayDayMasterId" name="Rest Type" ng-options="item.Value as item.Text for item in HolidayPayDayMasterList" style="width: 100px;">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="x.IsOTEntitled">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.OverTimePmtPolicyMasterID"
                                            ng-options="item.Value as item.Text for item in OverTimePmtPolicyMasterList" ng-disabled="!x.IsOTEntitled" id="AttdnBonusPmtPolicyMasterId"
                                            name="OverTimePmtPolicyMaster" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.AttdnBonusHeaderId"
                                            ng-options="item.Value as item.Text for item in AttdnBonusHeaderList" id="BonusHeaderId"
                                            name="AttdnBonusHeader" style="width: 140px;">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <input type="text" name="Notice Period" ng-model="x.NoticePeriod"only-numbers class="form-control" required tabindex="5" maxlength="50">
                            </td>
                            <td style="width:10px !important;word-break: break-word;">{{x.LegalDesignation}}</td>
                            <td>
                                <ul class="list-inline">
                                    <li><button ng-click="details(x.DesignationMasterId)" class="btn-action tooltip-here" data-placement="top" title="Details" tooltip><i class="glyphicon glyphicon-list"></i></button></li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
            <li> <button ng-click="ClearAll();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
        </ul>
    </div>
</div>

<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteDeductionRow()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="LegalDesignationPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Legal Designation<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">

                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="Grid" ej-grid e-datasource="legalDesignationList"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-showsummary="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="20"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="20"></div>
                                <div e-column e-field="ShortName" e-headertext="Short Name" e-width="40"></div>
                                <div e-column e-field="UserName" e-headertext="User Define Name" e-width="80"></div>
                                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
                                <div e-column e-field="IsGradeSpecific" e-headertext="Is Grade Specific" e-width="30"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right"></ul>
                </div>
            </div>
        </div>
    </div>
</div>