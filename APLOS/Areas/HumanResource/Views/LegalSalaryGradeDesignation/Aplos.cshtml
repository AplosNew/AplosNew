<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Legal Salary Grade Designation</h3>
<div class="form-elements form-horizontal" ng-form name="legalSalaryGradeNewForm">
    <div class="form-group col-xs-12 col-sm-4 col-md-4" show-errors>
        <label class="col-sm-4 control-label">Company<sup>*</sup></label>
        <div class="col-sm-8 show-message">
            <div class="select-style">
                <select class="form-control" ng-model="legalSalaryGradeNew.CompanyId" ng-change="companyOnChange()"
                        ng-options="item.Value as item.Text for item in companyList" name="Company" required tabindex="1">
                    <option></option>
                </select>
            </div>
        </div>
    </div>
    <div class="form-group col-xs-12 col-sm-4 col-md-4" show-errors>
        <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
        <div class="col-sm-8 show-message">
            <div class="select-style">
                <select class="form-control" ng-model="legalSalaryGradeNew.PlantId" ng-change="getLegalSalaryGradeList();"
                        ng-options="item.Value as item.Text for item in plantList" name="Plant" required tabindex="3">
                    <option></option>
                </select>
            </div>
        </div>
    </div>
    <div class="form-group col-xs-12 col-sm-4 col-md-4" show-errors>
        <label class="col-sm-5 control-label">Legal Salary Grade<sup>*</sup></label>
        <div class="col-sm-7 show-message">
            <div class="select-style">
                <select class="form-control" ng-model="legalSalaryGradeNew.LegalSalaryGradeId" name="Legal Salary Grade" ng-change="getData();"
                        ng-options="item.Value as item.Text for item in legalSalaryGradeList" required tabindex="2">
                    <option></option>
                </select>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left col-md-6">
            <li><button ng-click="popUp();" ng-disabled="legalSalaryGradeNew.LegalSalaryGradeId==null" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Add Legal Designation</button></li>
        </ul>
        <ul class="list-inline text-right col-md-6">
            <li><button ng-click="Save();" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            @*<li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="12"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li><button ng-click="Clear();" class="btn" tabindex="13"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="legalSalaryGradeHeadList.length>0">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Short Name</th>
                    <th>Standard Name</th>
                    <th>User Name</th>
                    <th>Active</th>
                    <th>Grade Specific</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in legalSalaryGradeHeadList" ng-class="{selected : x.Id==null}">
                    <td>{{x.Code}}</td>
                    <td>{{x.ShortName}}</td>
                    <td>{{x.StandardName}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                    <td>{{x.IsGradeSpecific?'Yes':'No'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li><button ng-click="removeRowModal(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">Legal Designation <button type="button" class="close" ng-click="closePopUp()">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in searchPopUpByList|orderBy :'name'" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                                <th>User Define Report Designation</th>
                                <th>Active</th>
                                <th>Grade Specific</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize"
                                total-items="popUpParameters.total_count" pagination-id="metaData.name + 'popUpDataList'">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.UserDefineReportDesignation}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                                <td>{{x.IsGradeSpecific?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'popUpDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getPopUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="selectByButton()" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirm_PopUp" title="Confirmation" message={{confirmationMessage}} data-ng-click-right-button="removeFromHeadList()"></confirm-archive-generic>