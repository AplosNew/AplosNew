<togglable name="Rest"></togglable>
<div class="form-elements form-horizontal" ng-form name="restNewForm">
    <div class="clearfix"></div>
    <input type="hidden" ng-model="restNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Section</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="restNew.SectionId" name="Section" ng-options="item.Value as item.Text for item in sectionList" tabindex="1">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Department</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="restNew.DepartmentId" name="Department" ng-options="item.Value as item.Text for item in departmentList" tabindex="3">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Rest Type</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="restNew.RestTypeId" name="Rest Type" ng-options="item.Value as item.Text for item in restTypeList" tabindex="1">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Attendance Rest Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" ng-model="restNew.AttendanceRestDate" ng-disabled="restNew.Id!==null" datepicker class="form-control" placeholder="dd-MMM-yyyy" name="Rest Date" required tabindex="5">
            </div>
        </div>
        <div class="form-group">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li> <button ng-click="GetEmployeeInformation();" class="btn" style="margin-left:15px"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">SubSection</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="restNew.SubSectionId" name="SubSection" ng-options="item.Value as item.Text for item in subSectionList" tabindex="2">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Is OT Entitle</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="restNew.IsOTEntitle" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="restNew.Remarks" name="Remarks" maxlength="250" tabindex="4"></textarea>
            </div>
        </div>
    </div>


    <div class="col-sm-12">

        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-12">
                <div id="GridNew" ej-grid
                     e-datasource="tempList"
                     e-allowscrolling="true"
                     e-pageSettings-pageSize="15"
                     e-actioncomplete="actionCompleteSelected"
                     e-templaterefresh="refreshTemplateemployee"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-enabletouch="true"
                     e-responsive="true"
                     e-allowselection="true"
                     e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Plant" e-headertext="Plant" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                        <div e-column e-headertext="Actions" e-width="70" e-template="#GridNewDelete"></div>
                    </div>
                </div>

            </div>
            <script type="text/template" id="GridNewDelete"> 
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.DeleteDetail(this);" style="margin: -6px;"></i></button>
            </script>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Attendance Rest Date</th>
                <th>Remarks</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in rests |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.AttendanceRestDate | dateFiltering}}</td>
                <td>{{x.Remarks}}</td>
                <td>{{x.Total}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                {{popUpTitle}}
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in popUpList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="popUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="popUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    <div class="checkbox-site text-center">
                                        <input type="checkbox" ng-click="CheckAll($event);">
                                    </div>
                                </th>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Plant</th>
                                <th>Department</th>
                                <th>Section</th>
                                <th>SubSection</th>
                                <th>Designation</th>
                                <th>Given Designation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count" pagination-id="metaData.name + 'popUpDataList'">
                                <td>
                                    <div class="checkbox-site">
                                        <input type="checkbox" ng-model="x.Active" ng-click="selectChValueId($event,x)">
                                    </div>
                                </td>
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.Plant}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                                <td>{{x.SubSection}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.GivenDesignation}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'popUpDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="popUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="closePopUp();" class="btn">Done</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="empInfoGrid" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee Information
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="col-xs-12 col-sm-6 col-md-12">

                    <div id="empInfo" ng-init="chkinit()" ej-grid e-datasource="EmployeeList" e-gridlines="vertical" e-templaterefresh="refreshTemplateemployee"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>

                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                            @*<div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>*@
                            @*<div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>*@
                            <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Unit" e-headertext="Unit" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                            @*<div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>*@
                            <div e-column e-field="EffectiveDate" e-headertext="Last EffectiveDate" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="ShiftDefinationName" e-headertext="Shift Name" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="SingleDayShift" e-headertext="Single Day Shift" e-allowediting="false" e-width="80"></div>

                        </div>
                    </div>

                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                    </script>

                    <script type="text/x-jsrender" id="headerTemplate">

                        <input type="checkbox" id="headchk" />
                    </script>

                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="OK();" class="btn">Done</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic data-modalid="confirmDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteDetail()"></confirm-archive-generic>