<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Phoenix</h3>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Activity</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" name="Employee Name" ng-model="ModelNew.EmployeeName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp('mo');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Budget Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.MBCode" class="form-control" required autocomplete="off" tabindex="4" maxlength="50" readonly>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Status<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.Status" name="StatusList" ng-options="item.value as item.name for item in StatusList">
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="ModelNew.Date" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Employee Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short Name" ng-model="ModelNew.EmployeeCode" class="form-control" maxlength="15" autocomplete="off" required tabindex="3" readonly>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Position Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.PCode" class="form-control" required autocomplete="off" tabindex="4" maxlength="50" readonly>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="8"></textarea>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                        <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="activityForm">
                    <input type="hidden" ng-model="activityNew.Id" />
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Name" ng-model="activityNew.ActivityName" class="form-control" maxlength="50" placeholder="Activity" tabindex="31">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Activity Category<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.ActivityCategory" name="ActivityCategoryList" ng-options="item.value as item.name for item in ActivityCategoryList"  tabindex="33">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" @*ng-show="otherActivityCategory"*@>
                            <label class="col-sm-4 control-label">Other Activity Category</label>
                            <div class="col-sm-8">
                                <input type="text" maxlength="200" name="Other Activity Category" ng-model="activityNew.OtherActivityCategory" placeholder="Other Activity Category" class="form-control" tabindex="34">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Class<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.ActivityClass" name="ActivityClassList" ng-options="item.value as item.name for item in ActivityClassList" tabindex="36">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Priority<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.Priority" name="PriorityList" ng-options="item.value as item.name for item in PriorityList" tabindex="38">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Period<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.Period" name="PeriodList" ng-options="item.value as item.name for item in PeriodList" tabindex="40">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Average Time (Min)<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="number" name="AverageTime" ng-model="activityNew.AverageTime" placeholder="Average Time (Min)" class="form-control" tabindex="42">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="activityNew.Remarks" name="Remarks" maxlength="200" placeholder="Remarks" tabindex="44"></textarea>
                            </div>
                        </div>
                        
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Detail<sup>*</sup></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="activityNew.ActivityDetail" name="Activity Detail" maxlength="300" placeholder="Activity Detail" tabindex="32"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Importance<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.ActivityImportance" name="ActivityImportanceList" ng-options="item.value as item.name for item in ActivityImportanceList"  tabindex="35">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Type<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.ActivityType" name="ActivityTypeList" ng-options="item.value as item.name for item in ActivityTypeList" tabindex="37">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Frequency<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="number" name="Frequency" ng-model="activityNew.Frequency" placeholder="Frequency" class="form-control" tabindex="39">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Financial Impact<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.FinancialImpact" name="FinancialImpactList" ng-options="item.value as item.name for item in FinancialImpactList" tabindex="41">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Purpose of the activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="activityNew.PurposeOfTheActivity" name="PurposeOfTheActivity" maxlength="200" placeholder="Purpose Of The Activity" tabindex="43"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Applicable Document</label>
                            <div class="col-sm-2">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" class="css-checkbox" ng-model="activityNew.ApplicableDocument">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                            <label class="col-sm-4 control-label">Applicable KPI</label>
                            <div class="col-sm-2">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" class="css-checkbox" ng-model="activityNew.ApplicableKPI">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveActivity();" ng-disabled="ModelNew.Id == null || ModelNew.Id == '' && savebtndisable" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
                            <li> <button ng-click="clearactivity();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div class="col-xs-12">
                        <div id="GridActivityEdit" ng-init="chkinit()" ej-grid e-datasource="ActivityList" e-recorddoubleclick="GetActivity" e-load="loadGridEdit"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="ActivityName" e-headertext="Activity Name" e-width="5"></div>
                                <div e-column e-field="ActivityDetail" e-headertext="Activity Detail" e-width="7"></div>
                                <div e-column e-field="ActivityCategory" e-headertext="Activity Category" e-width="5"></div>
                                <div e-column e-field="OtherActivityCategory" e-headertext="Other Activity Category" e-width="5"></div>
                                <div e-column e-field="IsApplicableDocument" e-headertext="Applicable Document" e-width="2"></div>
                                <div e-column e-field="IsApplicableKPI" e-headertext="Applicable KPI" e-width="2"></div>
                                <div e-column e-headertext="" e-template="#Allocation" e-width="2"></div>
                            </div>
                        </div>
                        <script type="text/template" id="Allocation">
                            <button style="color: #f3f3ec;background-color: #1c1f32;" title="Applicable Document" ng-disabled="data.IsApplicableDocument==='No'" class="btn"><i class="glyphicon glyphicon-open-file" ng-click="$parent.GetApplicableDocument(this);" style="margin: -6px;"></i></button>
                            <button style="color: #f3f3ec;background-color: #1c1f32;" title="Applicable KPI" ng-disabled="data.IsApplicableKPI==='No'" class="btn"><i class="glyphicon glyphicon-open-file" ng-click="$parent.GetApplicableKPI(this);" style="margin: -6px;"></i></button>
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>

<div class="modal fade site-modal in" id="documentPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="CloseDocumentPopUp()"> &times;</button>
                <h4 class="modal-title">Document</h4>
            </div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row" ng-form name="documentForm">
                    <input type="hidden" ng-model="documentActivityNew.Id" />
                    <div class="col-md-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document Name<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Document Name" ng-model="documentActivityNew.DocumentName" class="form-control" autocomplete="off" tabindex="100">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document Type<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="documentActivityNew.DocumentType" name="DocumentTypeList" ng-options="item.value as item.name for item in DocumentTypeList"tabindex="102">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document Generation<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="documentActivityNew.DocumentGeneration" name="DocumentGenerationList" ng-options="item.value as item.name for item in DocumentGenerationList"tabindex="104">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document Category<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control"  id="ddldocument" ng-model="documentActivityNew.DocumentCategoryId" name="Document" ng-options="item.Id as item.UserName for item in DocumentCategoryList"tabindex="106">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="documentActivityNew.Remarks" name="Remarks" placeholder="Remarks" maxlength="200" tabindex="108"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="inputBtnSection common-btn">
                                <label class="fileUpload col-sm-3 ">
                                    <input id="uploadBtn" type="file" name="file[]" class="upload" />
                                    <span class="uploadBtn"><i class="fa fa-paperclip" aria-hidden="true"> Attach</i></span>
                                </label>
                                <div class="col-sm-4" style="width: 255px;">
                                    <input type="text" id="uploadFile" name="uploadFile" class="disableInputField form-control" disabled="disabled" style="width: 239px;" />
                                </div>
                                <div class="col-sm-2" style="padding-left:0px;">
                                    <button ng-click="documentRemove();" class="btn" ng-disabled="disableBtn()" style="height: 31px;width: 88px;padding-left: 8px;background: #242841;"><i class="fa fa-chain-broken" aria-hidden="true"></i> Detach</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document No<sup>*</sup></label>
                            <div class="col-sm-7 input-group"style="padding-left: 15px;">
                                <span class="input-group-addon">{{ModelNew.PCode+'-'+ModelNew.EmployeeCode}}</span>
                                <input type="text" name="Document No" ng-model="documentActivityNew.DocNo" only-numbers class="form-control" autocomplete="off" tabindex="100">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document Format<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="documentActivityNew.DocumentFormat" name="DocumentFormatList" ng-options="item.value as item.name for item in DocumentFormatList" tabindex="101">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Document Code" ng-model="documentActivityNew.DocumentCode" class="form-control" autocomplete="off" tabindex="103">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document Prepration Frequency<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="documentActivityNew.DocumentPreprationFrequency" name="DocumentPreprationFrequencyList" ng-options="item.value as item.name for item in DocumentPreprationFrequencyList" tabindex="105">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document Class<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="documentActivityNew.DocumentClass" name="DocumentClassList" ng-options="item.value as item.name for item in DocumentClassList" tabindex="107">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Prepared by<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="documentActivityNew.PreparedBy" name="PreparedByList" ng-options="item.value as item.name for item in PreparedByList" tabindex="109">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="documentActivityNew.PreparedBy=='OtherEmployee'">
                            <div class="form-group">
                                <label class="col-sm-4 control-label" title="Prepared by in Case of other"><span>Prepared by in case of</span><br /><span>other</span></label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="text" name="Employee Name" ng-model="documentActivityNew.PreparedByInCaseOfOtherName" class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button ng-click="showEmployeeListPopUp('PreparedBy');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="common-btn" style="padding-right:18px">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveDocument();" class="btn" @*ng-disabled="activityNew.Id===null"*@ tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
                            <li> <button ng-click="ClearDocument();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            <li> <button ng-click="CloseDocumentPopUp();" class="btn" tabindex="9"><i class="glyphicon glyphicon-close"></i> Close</button></li>
                        </ul>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div id="GridDocumentEdit" ej-grid e-datasource="DocumentList" e-recorddoubleclick="GetDocument"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false" e-isprimarykey="true"></div>
                                <div e-column e-field="DocumentName" e-headertext="Document Name" e-width="2"></div>
                                <div e-column e-field="DocumentNo" e-headertext="Document No" e-width="2"></div>
                                <div e-column e-field="DocumentCode" e-headertext="Document Code" e-width="2"></div>
                                <div e-column e-field="DocumentType" e-headertext="Document Type" e-width="3"></div>
                                <div e-column e-field="DocumentFormat" e-headertext="Document Format" e-width="5"></div>
                                <div e-column e-type="text" e-template="#file" e-headertext="File Name" e-textalign="right" e-width="5"></div>
                            </div>
                        </div>
                        <script type="text/template" id="file">
                            <div class="text-right" style="width:100%">
                                <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.FileDownload(data);">{{data.FileName}}</a>
                            </div>
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Designation</th>
                                <th>Entity</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-click="selectEmployeePopUp($index, x.SystemId)" ng-class="{selected : x.SystemId == selectedEmployee}" ng-dblclick="closeEmployeePopUp();" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOB | dateFiltering}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.EmploymentType}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'employeeList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmdocDelete" title="Confirmation" data-ng-click-left-button="confirmClosedocDelete()" message={{message_confirmation}} data-ng-click-right-button="DeleteAttachment()"></confirm-archive-generic>

<div class="modal fade site-modal in" id="kpiPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="CloseKPIPopUp()">&times;</button>
                <h4 class="modal-title"> KPI</h4>
            </div>
            <div class="modal-body">
                <div class="row" ng-form name="kpiPopUpForm">
                    <input type="hidden" ng-model="kpiNew.Id" />
                    <div class="form-elements form-horizontal">
                        <div class="col-xs-12 col-sm-6 col-md-6 ">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Name of KPI<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="kpiNew.KPIName" name="KPI Name" maxlength="200" tabindex="401"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">KPI Review Period<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="kpiNew.KPIReviewPeriod" name="KPIReviewPeriodList" ng-options="item.value as item.name for item in KPIReviewPeriodList"tabindex="403">
                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">KPI Detail<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="kpiNew.KPIDetail" name="KPI Detail" maxlength="200" tabindex="402"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="kpiNew.Remarks" name="Remarks" maxlength="200" tabindex="404"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="common-btn" style="padding-right:18px">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveKPI();" class="btn" @*ng-disabled="activityNew.Id===null"*@ tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
                                <li> <button ng-click="ClearKPI();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                <li> <button ng-click="CloseKPIPopUp();" class="btn" tabindex="9"><i class="glyphicon glyphicon-close"></i> Close</button></li>
                            </ul>
                        </div>
                        <div class="col-xs-12">
                            <div id="GridKPIEdit" ng-init="chkinit()" ej-grid e-datasource="KPIList" e-recorddoubleclick="GetKPI" e-load="loadGridEdit"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                                <div e-columns>
                                    <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                                    <div e-column e-field="KPIName" e-headertext="KPI Name" e-width="2"></div>
                                    <div e-column e-field="KPIDetail" e-headertext="KPI Detail" e-width="2"></div>
                                    <div e-column e-field="KPIReviewPeriod" e-headertext="KPI Review Period" e-width="3"></div>
                                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="5"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>