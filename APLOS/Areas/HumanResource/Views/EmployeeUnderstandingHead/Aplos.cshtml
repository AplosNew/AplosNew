<togglable name="Employee Understanding"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Activity</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="doc" role="tab" data-toggle="tab">Document</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="doc" role="tab" data-toggle="tab">KPI</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" name="Employee Name" ng-model="ModelNew.EmployeeName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp('mo');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Budget Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.BudgetCode" class="form-control" required autocomplete="off" tabindex="4" maxlength="50" readonly>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Status<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="ModelNew.Status" name="StatusList" ng-options="item.value as item.name for item in StatusList">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="ModelNew.Date" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Employee Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short Name" ng-model="ModelNew.EmployeeCode" class="form-control" maxlength="15" autocomplete="off" required tabindex="3" readonly>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Position Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.PositionCode" class="form-control" required autocomplete="off" tabindex="4" maxlength="50" readonly>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="8"></textarea>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                        <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="activityForm">
                    <input type="hidden" ng-model="activityNew.Id" />
                    <input type="hidden" ng-model="activityNew.EmployeeId" />
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Name" ng-model="activityNew.ActivityName" class="form-control" maxlength="50" placeholder="Activity" tabindex="31">
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Activity Category<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.ActivityCategory" name="PriorityList" ng-options="item.value as item.name for item in ActivityCategoryList">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" @*ng-show="otherActivityCategory"*@>
                            <label class="col-sm-4 control-label">Other Activity Category</label>
                            <div class="col-sm-8">
                                <input type="text" maxlength="200" name="Other Activity Category" ng-model="activityNew.OtherActivityCategory" placeholder="Other Activity Category" class="form-control" tabindex="33">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Activity Class<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.ActivityClass" name="ActivityClassList" ng-options="item.value as item.name for item in ActivityClassList">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Priority<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.Priority" name="PriorityList" ng-options="item.value as item.name for item in PriorityList">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Period<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.Period" name="PeriodList" ng-options="item.value as item.name for item in PeriodList">
                                    </select>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Average Time (Min)<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="number" name="AverageTime" ng-model="activityNew.AverageTime" placeholder="Average Time (Min)" class="form-control" tabindex="37">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="activityNew.Remarks" name="Remarks" maxlength="200" placeholder="Remarks" tabindex="39"></textarea>
                            </div>
                        </div>
                        @*<div class="form-group" ng-show="hidediv">
                            <label class="col-sm-4 control-label">KPI</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="activityNew.KPI">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>*@
                        @*<div class="form-group" ng-show="hidediv">
                            <label class="col-sm-4 control-label">Documents</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="activityNew.Documents">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>*@
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Detail<sup>*</sup></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="activityNew.ActivityDetail" name="Activity Detail" maxlength="500" placeholder="Activity Detail" tabindex="32"></textarea>
                            </div>
                        </div>
                       
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Activity Importance<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.ActivityImportance" name="ActivityImportanceList" ng-options="item.value as item.name for item in ActivityImportanceList">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Activity Type<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.ActivityType" name="ActivityTypeList" ng-options="item.value as item.name for item in ActivityTypeList">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Frequency<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="number" name="Frequency" ng-model="activityNew.Frequency" placeholder="Frequency" class="form-control" tabindex="36">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Financial Impact<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="activityNew.FinancialImpact" name="FinancialImpactList" ng-options="item.value as item.name for item in FinancialImpactList">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Purpose of the activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="activityNew.PurposeOfTheActivity" name="PurposeOfTheActivity" maxlength="200" placeholder="Purpose Of The Activity" tabindex="40"></textarea>
                            </div>
                        </div>
                        @*<div class="form-group">
                            <label class="col-sm-4 control-label">Has Financial Impact</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="activityNew.FinancialImpact" tabindex="10">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>*@
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveActivity();" ng-disabled="ModelNew.Id===null" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
                            <li> <button ng-click="clearactivity();" ng-disabled="disableBtn()" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                            <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ActivityList" e-recorddoubleclick="GetActivity" e-load="loadGridEdit"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                                <div e-columns>
                                    <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                                    <div e-column e-field="ActivityName" e-headertext="Activity Name" e-width="2"></div>
                                    <div e-column e-field="ActivityDetail" e-headertext="Activity Detail" e-width="3"></div>
                                    <div e-column e-field="ActivityCategory" e-headertext="Activity Category" e-width="5"></div>
                                    <div e-column e-field="OtherActivityCategory" e-headertext="Other Activity Category" e-width="5"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="2"></div>
            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="3"></div>
            <div e-column e-field="PositionCode" e-headertext="Position Code" e-width="5"></div>
            <div e-column e-field="BudgetCode" e-headertext="Budge tCode" e-width="5"></div>
            <div e-column e-field="Date" e-headertext="Date" e-width="5"></div>
            <div e-column e-field="Status" e-headertext="Status" e-width="2"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="CustomerPopUpNew" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> {{partyType}} List <button type="button" class="close" ng-click="closeCustomerPopUpNew();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByParty">
                                            <option ng-repeat="option in searchByPartyList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchParty" ng-enter="ShowCustomerPopUpNew()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="ShowCustomerPopUpNew()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="content-container-fluid">

                        <div style="color:black;" id="customerPopUpGrid" ej-grid e-datasource="partyList" e-recorddoubleclick="SetCustomerData"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="Code" e-headertext="Code" e-width="50" e-filter="false"></div>
                                <div e-column e-field="UserName" e-headertext="Party" e-width="130"></div>
                                <div e-column e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="130"></div>
                                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                <div e-column e-field="CountryName" e-headertext="Country" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="StateName" e-headertext="State" e-width="80" textAlign='Right'></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeCustomerPopUpNew();" class="btn"> Close</button></li>
                </ul>
                <i>**Showing top 100 {{partyType}} order by Code</i>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Designation</th>
                                <th>Entity</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-click="selectEmployeePopUp($index, x.SystemId)" ng-class="{selected : x.SystemId == selectedEmployee}" ng-dblclick="closeEmployeePopUp();" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOB | dateFiltering}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.EmploymentType}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'employeeList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>