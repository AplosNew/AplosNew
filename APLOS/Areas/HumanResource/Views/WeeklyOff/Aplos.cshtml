<div id="FDiv">
    <togglable name="{{title}}"></togglable>
    <div class="form-elements form-horizontal" ng-form name="HeaderForm">
        <input type="hidden" ng-model="Header.Id">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors id="WeekOffId" style="display:none;">
                    <label class="col-sm-4 control-label">Week Off Id<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="WeekOffId" ng-model="Header.Id" class="form-control" maxlength="15" readonly>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <input type="text" name="Short Name" ng-model="Header.StandardName" class="form-control" maxlength="50" required tabindex="4">

                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Short Name" ng-model="Header.ShortName" class="form-control" maxlength="15" required tabindex="6">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <textarea name="Description" class="form-control" rows="3" ng-model="Header.Description" tabindex="8" maxlength="250" required></textarea>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Code" ng-model="Header.UserName" class="form-control" required tabindex="3" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" rows="3" ng-model="Header.Remarks" maxlength="250" tabindex="7"></textarea>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Active</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="Header.Active" tabindex="9">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="margin:10px;">

            <label class="col-md-2 control-label">Effective Date<sup>*</sup></label>
            <div class="col-md-4 show-message">
                <input type="text" name="Effective Date" ng-model="EffectiveDate" ng-change="AddDates(data);" datepicker class="form-control" tabindex="5">
            </div>

        </div>
        <div class="row" style="margin:5px;">
            <span ng-repeat="Item in DatesList" ng-click="DeleteDate(Item.EffectiveDate)" style="cursor:pointer; margin:5px;">> {{Item.EffectiveDate}}</span>
        </div>
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="SaveMasters();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> {{Action}} </button></li>
                @*<li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                <li> <button ng-click="ClearMasters();" class="btn" tabindex="12"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

            </ul>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li> <button ng-click="AddDay();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add Day </button></li>
            </ul>
        </div>
        
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="refreshSequence();" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i> Refresh Sequence</button></li>
            </ul>
        </div>
        <div id="WeekList" ej-grid e-datasource="WeekChildList" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
            <div e-columns>
                <div e-column e-field="WOHeaderId" e-type="string" e-headertext="Week Off Id" e-width="80"></div>
                <div e-column e-field="WOSequence" e-type="string" e-headertext="Sequence" e-width="80"></div>
                <div e-column e-template="#Day" e-headertext="Day" e-width="100"></div>
                <div e-column e-template="#DayType" e-headertext="Day Type" e-width="100"></div>
                <div e-column e-template="#AddTile" e-headertext="Add" e-width="20"></div>

                <div e-column e-template="#DeleteTile" e-headertext="Remove" e-width="20"></div>
            </div>
        </div>
        <script type="text/template" id="Day">
            <div class="form-group col-lg-11">
                <div class="select-style ">
                    <select class="form-control" ng-model="data.Day" name="Duration Status">
                        <option value="">--Select--</option>
                        <option value="Monday">Monday</option>
                        <option value="Tuesday">Tuesday</option>
                        <option value="Wednesday">Wednesday</option>
                        <option value="Thursday">Thursday</option>
                        <option value="Friday">Friday</option>
                        <option value="Saturday">Saturday</option>
                        <option value="Sunday">Sunday</option>
                    </select>
                </div>
            </div>
        </script>
        <script type="text/template" id="DayType">
            <div class="form-group col-lg-11">
                <div class="select-style ">
                    <select class="form-control" ng-model="data.DayType" name="Duration Status">
                        <option value="">--Select--</option>
                        <option value="NW">NW (Normal Working)</option>
                        <option value="W">W (Full Day Week Off)</option>
                        <option value="HW">WH (Half Day Week Off)</option>
                    </select>
                </div>
            </div>
        </script>
        <script type="text/template" id="AddTile">
            <div class="common-btn">
                <ul class="list-inline text-center">
                    <li><button ng-click="$parent.AddTile(data);" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus" style="top: 1px;"></i></button></li>
                </ul>
            </div>
        </script>
        <script type="text/template" id="DeleteTile">
            <div class="common-btn">
                <ul class="list-inline text-center">
                    <li><button ng-click="$parent.DeleteTile(data);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                </ul>
            </div>
        </script>
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="checkChildList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> {{Action1}} </button></li>
                <li> <button ng-click="ClearDays();" class="btn" tabindex="12"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

            </ul>
        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div id="Master" ej-grid e-datasource="masterGrid" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;"
             e-recorddoubleclick="fillUpdates">
            <div e-columns>
                
                <div e-column e-field="Id" e-headertext="Roster Id" e-width="2"></div>
                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="2"></div>
                <div e-column e-field="UserName" e-headertext="User Name" e-width="2"></div>
                <div e-column e-field="Description" e-headertext="Description" e-width="2"></div>
                <div e-column e-field="ShortName" e-headertext="Short Name" e-width="2"></div>
                <div e-column e-field="CreationDate" e-headertext="Creation Date" e-width="2"></div>
                <div e-column e-field="Active" e-headertext="Active/Inactive" e-width="2"></div>
                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="2"></div>
            </div>
        </div>
    </div>
    <confirm-modal></confirm-modal>

    
</div>




<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to save without any shifts ?" data-ng-click-left-button="restoreChildShifts();" data-ng-click-right-button="SaveShifts();"></confirm-archive-generic>
