<togglable name="Weekoff Change" id="mainContainer"></togglable>
<div class="row">

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4" style="font-weight:normal;">Effective Date</label>
            <div class="col-sm-8">
                <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="model.EffectiveDate" e-width="100%" />
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-8" style="font-weight:normal;">Select Employee</label>
            <div class="col-sm-4">
                <div class="common-btn">
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-click="getAllEmployee()" class="btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="form-group">
            <label class="col-sm-4" style="font-weight:normal;">Employee Id</label>
            <label class="col-sm-8" style="font-weight:normal;">{{selectedSinglemployee.Id}}</label>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            <label class="col-sm-4" style="font-weight:normal;">Employee Code</label>
            <label class="col-sm-8" style="font-weight:normal;">{{selectedSinglemployee.EmployeeCode}}</label>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            <label class="col-sm-4" style="font-weight:normal;">Employee Name</label>
            <label class="col-sm-8" style="font-weight:normal;">{{selectedSinglemployee.EmployeeName}}</label>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            <label class="col-sm-4" style="font-weight:normal;">Department</label>
            <label class="col-sm-8" style="font-weight:normal;">{{selectedSinglemployee.Department}}</label>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            <label class="col-sm-4" style="font-weight:normal;">Designation</label>
            <label class="col-sm-8" style="font-weight:normal;">{{selectedSinglemployee.Designation}}</label>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            <label class="col-sm-4" style="font-weight:normal;">Section</label>
            <label class="col-sm-8" style="font-weight:normal;">{{selectedSinglemployee.Section}}</label>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            <label class="col-sm-4" style="font-weight:normal;">SubSection</label>
            <label class="col-sm-8" style="font-weight:normal;">{{selectedSinglemployee.SubSection}}</label>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            <label class="col-sm-4" style="font-weight:normal;"> Last Effective Date</label>
            <label class="col-sm-8" style="font-weight:normal;">{{selectedSinglemployee.EffectiveDateDesc}}</label>
        </div>

    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group">
            <label class="col-sm-4" style="font-weight:normal;">Weekoff Day</label>
            <div class="col-sm-8">
                <input type="radio" name="AlignWithCC" ng-model="model.AlignWithCC" value="1">
                <span>Aligned With Company Weekoff Calendar</span> <br />
                <input type="radio" name="AlignWithCC" ng-model="model.AlignWithCC" value="0">
                <span> Individually Assigned Weekoff Day </span>
            </div>
        </div>
        @*<div class="form-group">
                <label class="col-sm-4" style="font-weight:normal;"></label>
                <div class="col-sm-8">

                </div>
            </div>*@

        <div class="form-group" ng-show="model.AlignWithCC != 1">
            <label class="col-sm-4" style="font-weight:normal;">First Weekoff</label>
            <div class="col-sm-6">
                <input ej-dropdownlist e-datasource="daylist" e-value="model.FstOffDay" e-width="100%" />
            </div>
        </div>

        <div class="form-group"  ng-show="model.AlignWithCC != 1">
            <label class="col-sm-4" style="font-weight:normal;">Second Weekoff</label>
            <div class="col-sm-6">
                <input ej-dropdownlist e-datasource="daylist" e-value="model.SndOffDay" e-width="100%" />
            </div>
        </div>

    </div>


    <div class="row" ng-hide="model.AlignWithCC=='1'">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <br />
            <br />
            <br />
            <div class="form-group">
                <label class="col-sm-4" style="font-weight:normal;">Day Length</label>
                <div class="col-sm-8 show-message">
                    <input type="radio" name="FstDayLengthType" ng-model="model.FstDayLengthType" value="Full Day">
                    <span>Full Day</span>
                    <input type="radio" name="FstDayLengthType" ng-model="model.FstDayLengthType" value="First Half">
                    <span>First Half Day</span>
                    <input type="radio" name="FstDayLengthType" ng-model="model.FstDayLengthType" value="Second Half">
                    <span>Second Half Day</span>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4" style="font-weight:normal;">Day Length</label>
                <div class="col-sm-8 show-message">

                    <input type="radio" name="SndDayLengthType" ng-model="model.SndDayLengthType" value="Full Day">
                    <span>Full Day</span>
                    <input type="radio" name="SndDayLengthType" ng-model="model.SndDayLengthType" value="First Half">
                    <span>First Half Day</span>
                    <input type="radio" name="SndDayLengthType" ng-model="model.SndDayLengthType" value="Second Half">
                    <span>Second Half Day</span>
                </div>
            </div>

        </div>
    </div>


    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="showAttendanceInfo();" class="btn"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>
            <li></li>
            <li> <button ng-click="SaveEmployee();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>

    </div>
</div>


<div class="modal fade site-modal in" id="ShiftPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeShiftPopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridShift" ej-grid e-datasource="selectemployee" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="selectSignleEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="30" e-primarykey="true"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="30" e-primarykey="true"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeShiftPopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>

<div class="row">

    <div id="GridAttendance" ng-init="chkinit()" ej-grid e-datasource="attendanceinfo"
         e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-showstackedheader="true"
         e-filtersettings-filterType="excel">
        <div e-stackedheaderrows>
            <div e-stackedheaderrow>
                <div e-stackedheadercolumns>
                    <div e-stackedheadercolumn e-headertext="First Weekoff Day" e-column="FstOffDay,FstDayLengthType"></div>
                    <div e-stackedheadercolumn e-headertext="Second Weekoff Day" e-column="SndOffDay,SndDayLengthType"></div>
                </div>
            </div>
        </div>
        <div e-columns>
            <div e-column e-field="EffectiveDate" e-headertext="Effective Date" e-width="120"></div>
            <div e-column e-field="AlignWithCC" e-headertext="Company Calendar" e-width="120"></div>
            <div e-column e-field="IndividualWeekOff" e-headertext="Individual" e-width="120"></div>
            <div e-column e-field="FstOffDay" e-headertext="Day" e-width="120"></div>
            <div e-column e-field="FstDayLengthType" e-headertext="Length" e-width="120"></div>
            <div e-column e-field="SndOffDay" e-headertext="Day" e-width="120"></div>
            <div e-column e-field="SndDayLengthType" e-headertext="Length" e-width="120"></div>
        </div>
    </div>
    <div class="col-xs-12 redClr">
        **All effective dates shown in the grid will be wiped out
    </div>
</div>
