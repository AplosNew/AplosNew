<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Manpower Control Report</h3>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-sm-12">
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    
                        <label class="col-sm-4 control-label">Evaluation Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Evaluation Date" ng-model="Dates" datepicker class="form-control" required tabindex="1">
                        </div>
                    
                </div>
            </div>

            <div class="col-xs-12 col-sm-4 col-md-4">
                <div id="filters"></div>
            </div>

            <div class="col-sm-12">
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="GetReport('EXCEL');" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                            @*<li><button ng-click="GetReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Monthly LunchOut Report</button></li>*@
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
    <div class="bounce3"></div>
</div>

