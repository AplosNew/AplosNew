<div class="form-elements form-horizontal" ng-form name="ModalNewPositionForm">
    <div class="row">
        <input type="hidden" name="Id" ng-model="ModalNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-6">
                    <div class="select-style">
                        <select class="form-control" id="PlantId" ng-model="ModalNew.PlantId" required name="PlantId" tabindex="4">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in PlantList" value="{{option.value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Budget Code<sup>*</sup></label>
                <div class="col-sm-6">
                    <div class="select-style">
                        <select ng-change="getPosition();" class="form-control" id="BudgetCode" ng-model="ModalNew.MPBudgetCodeId" required name="MPBudgetCodeId" tabindex="4">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in MPBudgetList" value="{{option.value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-6">
                    <div class="select-style">
                        <select ng-change="getBudgetCode();" class="form-control" id="EntityId" ng-model="ModalNew.EntityId" required name="EntityId" tabindex="4">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in EntityList" value="{{option.value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Position<sup>*</sup></label>
                <div class="col-sm-6">
                    <div class="select-style">
                        <select class="form-control" id="Position" ng-model="ModalNew.PositionId" required name="PositionList" tabindex="4">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in PositionList" value="{{option.value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
        </div>
