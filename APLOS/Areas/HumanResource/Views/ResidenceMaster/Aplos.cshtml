<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">

    <div class="row">
        <input type="hidden" ng-model="ModelNew.SystemId">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="" ng-model="" class="form-control" maxlength="200" tabindex="5" ng-disabled="true  ">
                </div>
                <div class="col-sm-2">
                    <button ng-click="" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Location<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="" ng-model="" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Residence Category<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="" ng-model="" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Residence Sub Category<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="" ng-model="" required name="" tabindex="2">
                            <option value="">--Select--</option>
                            <option value="">Male</option>
                            <option value="">Female</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Block If Applicable<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="" ng-model="" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Floor<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="" ng-model="" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Residence Number<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="" ng-model="" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-top:-5px !important">Is Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site" id="checkok">
                        <label>
                            <input type="checkbox" ng-model="" tabindex="8" style="margin-top:10px !important">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">


            <div class="form-group">
                <label class="col-sm-4 control-label">Residence Group<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="" ng-model="" class="form-control" maxlength="200" tabindex="5" ng-disabled="true  ">
                </div>
                <div class="col-sm-2">
                    <button ng-click="" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>



            <div class="form-group">
                <label class="col-sm-4 control-label">Rooms<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="number" name="" ng-model="" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Residence Type<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="ddperfYear" ng-model="" required name=""
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="">Family</option>
                            <option value="">Bechlor</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Vacancy<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="number" name="" ng-model="" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Asset Name<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="" ng-model="" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-6">
                    <textarea class="form-control ng-pristine ng-valid ng-isolate-scope ng-empty ng-valid-maxlength ng-touched" rows="3" ng-model="ModelNew.Remarks" maxlength="50" tabindex="6"></textarea>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>

        </div>
    </div>
    <div class="table-responsive" id="EGSGrid" style="margin-top:20px;">
        <div id="GridEdit" ej-grid e-datasource="ModelListChild" e-recorddoubleclick="Get" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>


                <div e-column e-field="Id" e-headertext="Id" e-width="30"></div>
                <div e-column e-field="" e-headertext="Location" e-width="50"></div>
                <div e-column e-field="" e-headertext="Residence Sub Category" e-width="90"></div>
                <div e-column e-field="" e-headertext="Residence Category" e-width="40"></div>
                <div e-column e-field="" e-headertext="Block" e-width="40"></div>
                <div e-column e-field="" e-headertext="Floor" e-width="50"></div>
                <div e-column e-field="" e-headertext="Residence Number" e-width="50"></div>
                <div e-column e-field="" e-headertext="Rooms" e-width="50"></div>
                <div e-column e-field="" e-headertext="Residence Type" e-width="50"></div>
                <div e-column e-field="" e-headertext="Vacancy" e-width="50"></div>
                <div e-column e-field="" e-headertext="Asset Name" e-width="50"></div>
                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="50"></div>
                <div e-column e-field="AddedBy" e-headertext="Added By" e-width="80"></div>
                <div e-column e-field="AddedDate" e-headertext="Added Date" e-width="80"></div>

            </div>
        </div>
    </div>

</div>
