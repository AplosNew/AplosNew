<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Professional Tax Report</h3>
<div class="row">
    <div class="form-elements form-horizontal" ng-form="modelForm">
        <div class="col-sm-12">
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="col-sm-3 " style="margin-top: 8px;">Year<sup>*</sup></label>
                    <div class="col-sm-7">
                        <div class="select-style">
                            <select id="YearId" class="form-control" ng-model="yearId" name="YearId" ng-change="DateList(yearId)" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in taxYearList" value="{{option.Text}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" name="Form Date" ng-model="fromDate" datepicker class="form-control">
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" name="Form Date" ng-model="toDate" datepicker class="form-control">
                        </div>
                    </div>
                </div>
                @*<div class="form-group">
                        <label class="col-sm-4 control-label">Month<sup></sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <input id="MonthList" ej-dropdownlist e-create="create" e-multiselectmode="visualmode" e-datasource="MonthList" e-fields-value="StartDate" e-fields-text="MonthName" e-width="100%" e-showcheckbox="true" />

                            </div>
                        </div>
                    </div>*@
            </div>

            <div class="col-sm-2">
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button ng-click="GetProfessionalTaxReports('EXCEL');" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>









