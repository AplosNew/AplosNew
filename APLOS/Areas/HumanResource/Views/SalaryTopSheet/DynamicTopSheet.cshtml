<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Salary Top Sheet</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="assign" role="tab" data-toggle="tab">Salary Top Sheet</a></li>
            </ul>
        </div>
        <div class="tab-content">

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="form-elements form-horizontal" ng-form="modelForm">
                        <div class="col-md-12">
                            <div class="col-xs-4 col-sm-3 col-md-3">
                                <div class="form-group">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Year<sup>*</sup></label>
                                        <div class="col-sm-7">
                                            <div class="select-style">
                                                <select id="YearId" class="form-control" ng-model="year" name="YearId" required tabindex="1">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="option in yearList" value="{{option.Text}}">{{option.Text}}</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-4 col-sm-3 col-md-3">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Month<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <div class="select-style">
                                            <select id="MonthId" class="form-control" ng-model="month" name="MonthId" required tabindex="1" ng-change="getSalaryProcessIdList();">
                                                <option value="">--Select--</option>
                                                <option Value="01">Jan</option>
                                                <option Value="02">Feb</option>
                                                <option Value="03">Mar</option>
                                                <option Value="04">Apr</option>
                                                <option Value="05">May</option>
                                                <option Value="06">Jun</option>
                                                <option Value="07">Jul</option>
                                                <option Value="08">Aug</option>
                                                <option Value="09">Sep</option>
                                                <option Value="10">Oct</option>
                                                <option Value="11">Nov</option>
                                                <option Value="12">Dec</option>
                                            </select>

                                        </div>
                                    </div>
                                </div>
                            </div>

                            @*<div class="col-xs-6 col-sm-3 col-md-3">
                                <div class="form-group">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Salary Process Id<sup>*</sup></label>
                                        <div class="col-sm-6">
                                            <div class="select-style">
                                                <select id="YearId" class="form-control" ng-model="salaryProcessId" name="salaryProcessId" required tabindex="3">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="option in cboSalaryProcessIdList" value="{{option.Text}}">{{option.Text}}</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>*@

                            <div class="col-xs-6 col-sm-3 col-md-3">
                                <div class="form-group">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Group By<sup>*</sup></label>
                                        <div class="col-sm-6">
                                            <div class="select-style">
                                                <select id="Group By" class="form-control" ng-model="SalaryTopSheetCategory" name="Group By" required tabindex="3">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="option in SortingParametersList" value="{{option.parameter}}">{{option.parameter}}</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @*<div class="form-group">
                                <div class="col-xs-12">
                                    <div class="radio">
                                        &nbsp;&nbsp;&nbsp;
                                        <label>
                                            <input type="radio" name="SalaryTopSheetRadio" ng-model="SalaryTopSheetCategory" value="PayrollGroup">
                                            <span class="cr"><i class="cr-icon"></i></span>Payroll Group
                                        </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                        <label>
                                            <input type="radio" name="SalaryTopSheetRadio" ng-model="SalaryTopSheetCategory" value="DepartmentEmployeeCategory">
                                            <span class="cr"><i class="cr-icon"></i></span>Department & Employee Category
                                        </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;

                                    </div>
                                </div>
                            </div>*@

                        <div class="col-xs-12">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button style="margin-left: 5px;" ng-click="GetSalaryTopRegistrar();" class="btn"><i class="glyphicon glyphicon-download"></i> Download</button></li>
                                </ul>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>
    <div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    Employee List
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row form-element-ctrl form-horizontal">
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div ng-dropdown-multiselect="" options="divisionNewList" selected-model="divisionIds"
                                         extra-settings="multiSelectSettings" translation-texts="example4customTexts" events="multi4events"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div ng-dropdown-multiselect="" options="departmentNewList" selected-model="departmentIds"
                                         extra-settings="multiSelectSettings" translation-texts="example3customTexts" events="multi3events"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div ng-dropdown-multiselect="" options="sectionNewList" selected-model="sectionIds"
                                         extra-settings="multiSelectSettings" translation-texts="example5customTexts" events="multi5events"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div ng-dropdown-multiselect="" options="employeeCategoryNewList" selected-model="employeeCategoryIds"
                                         extra-settings="multiSelectSettings" translation-texts="example6customTexts" events="multi6events"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div ng-dropdown-multiselect="" options="givenDesignationNewList" selected-model="givenDesignationIds"
                                         extra-settings="multiSelectSettings" translation-texts="example7customTexts" events="multi7events"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row form-element-ctrl form-horizontal">
                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Employee Code</label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="ShortName" ng-model="paidHoursEmployeeAssignNew.EmployeeCode" class="form-control" maxlength="15" tabindex="3">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Employee Name</label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="ShortName" ng-model="paidHoursEmployeeAssignNew.EmployeeName" class="form-control" maxlength="15" tabindex="3">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div class="common-btn">
                                <button type="button" ng-click="getSearchData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                    <p>Employee Count:{{employeeParameters.total_count}}</p>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Select</th>
                                    <th>Employee Code</th>
                                    <th>Employee Name</th>
                                    <th>Employee Category</th>
                                    <th>Given Designation</th>
                                    <th>Division</th>
                                    <th>Department</th>
                                    <th>Section</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count" pagination-id="metaData.name + 'employeeList'">
                                    <td>
                                        <div class="checkbox-site">
                                            <label class="control-label">
                                                <input type="checkbox" id="{{x.SystemId}}" ng-model="x.Flag" ng-checked="x.Flag">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>{{x.EmployeeCode}}</td>
                                    <td>{{x.EmployeeName}}</td>
                                    <td>{{x.EmployeeCategory}}</td>
                                    <td>{{x.GivenDesignation}}</td>
                                    <td>{{x.Division}}</td>
                                    <td>{{x.Department}}</td>
                                    <td>{{x.Section}}</td>
                                </tr>
                            </tbody>
                        </table>
                        <dir-pagination-controls max-size="10"
                                                 pagination-id="metaData.name + 'employeeList'"
                                                 direction-links="true"
                                                 boundary-links="true"
                                                 on-page-change="getEmployeeData(newPageNumber)">
                        </dir-pagination-controls>
                    </div>
                </div>
                <div class="modal-footer common-btn">
                    <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
                </div>
            </div>
        </div>
    </div>
</div>