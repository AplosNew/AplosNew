                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="ToDateO" e-width="100%" />
                                    </div>
                                </div>
                            </div>

