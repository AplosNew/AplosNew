<h3 class="site-heading">{{title}}</h3>

<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Process" role="tab" data-toggle="tab">Process</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Report" role="tab" data-toggle="tab">Report</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div>
                <div class="row">
                    <div class="col-sm-12 col-md-6 col-lg-4">
                        <div id="WeekList" ej-grid e-datasource="filters"
                             e-allowfiltering="true" e-responsive="true"
                             e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Plant" e-type="string" e-headertext="Plant" e-width="80"></div>
                                <div e-column e-field="Entity" e-type="string" e-headertext="Entity" e-width="80"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-md-4 col-lg-2">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Week</label>
                            <div class="col-sm-8 ">
                                <div class="select-style">
                                    <select id="OTWApp" class="form-control" ng-model="Week" ng-change="dateShow()" name="Week">
                                        <option value="">-Select-</option>
                                        <option Value="1">Week 1</option>
                                        <option Value="2">Week 2</option>
                                        <option Value="3">Week 3</option>
                                        <option Value="4">Week 4</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-md-6 col-lg-6">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <div class="col-md-12">
                                    <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-enablefiltersearch="true" e-value="year" e-databound="SelectDefaultValue" e-fields-value="Text" e-fields-text="Text" e-width="100%" e-change="dateShow" />
                                </div>

                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <div class="col-md-12">
                                    <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-value="month" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-change="dateShow" />
                                </div>

                            </div>

                        </div>

                    </div>
                </div>

                <div class="row" style="margin-top:10px">
                    <div class="col-md-6 col-lg-4 col-sm-12">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Select OT Type</label>
                            <div class="col-sm-8 ">
                                <div class="select-style">
                                    <select id="OTWApp" class="form-control" ng-model="SelectedOT" name="SelectedOT" tabindex="1">
                                        <option value="">-Select-</option>
                                        <option Value="1">Allowed OT</option>
                                        <option Value="2">Target OT</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-offset-2 col-lg-6 col-sm-12">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">From Date</label>
                                    <div class="col-sm-8 show-message">
                                        <input id="datepicker" e-dateformat="dd-MMM-yyyy" disabled ej-datepicker e-value="FromDate" e-width="100%" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-12">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">To Date</label>
                                    <div class="col-sm-8 show-message">
                                        <input e-dateformat="dd-MMM-yyyy" ej-datepicker disabled e-value="ToDate" e-width="100%" />
                                    </div>
                                </div>
                            </div>

                        </div>
                     
                    </div>

                </div>

                <div class="row" style="margin-top:10px; padding-right:10px;">
                    <div class="col-md-6 col-lg-12 col-sm-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="getData();" class="btn" tabindex="10"><i class="glyphicon glyphicon-download"></i> View </button></li>
                            </ul>
                        </div>
                    </div>

                </div>
                             

                <div class="row">
                    <div id="GridProcess" ng-init="chkinit()" ej-grid e-datasource="DataList"
                         e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">

                        @*<div style="color:black;" id="getAllDataProcess" ej-grid e-datasource="Data" e-allowscrolling="true"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="true" e-filtersettings-filterType="excel">*@
                            <div e-columns>
                                <div e-column e-field="Plant" e-headertext="Plant" e-width="80" e-type="string"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="80" e-type="number"></div>
                                <div e-column e-field="Section" e-type="number" e-headertext="Section" e-width="80"></div>
                                <div e-column e-field="SubSection" e-type="number" e-headertext="SubSection" e-width="80"></div>
                                <div e-column e-field="Designation" e-type="number" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-field="EmployeeCode" e-type="number" e-headertext="EmpoyeeCode" e-width="80"></div>
                                <div e-column e-field="WorkDate" e-format="{0:dd-MMM-yyyy}" e-type="string" e-headertext="WorkDate" e-width="80"></div>
                                <div e-column e-field="DayStatus" e-type="number" e-headertext="DayStatus" e-width="80"></div>
                                <div e-column e-field="InTime" e-type="number" e-headertext="InTime" e-width="80"></div>
                                <div e-column e-field="OutTime" e-type="number" e-headertext="OutTime" e-width="80"></div>
                                <div e-column e-field="ProcessedOT" e-type="number" e-headertext="ProcessedOT" e-width="80"></div>
                                <div e-column e-field="TargetOT" e-type="number" e-headertext="TargetOT" e-width="80"></div>
                                <div e-column e-headertext="PlanOT" e-template="#PlantOT" e-textalign="center" e-type="number" e-width="80"></div>

                                <div e-column e-field="OTWeek" e-type="number" e-headertext="OTWeek" e-width="80"></div>
                                <div e-column e-field="OTMonth" e-type="number" e-headertext="OTMonth" e-width="80"></div>
                                <div e-column e-field="OTYear" e-type="number" e-headertext="OTYear" e-width="80"></div>
                            </div>
                        </div>

                        <script type="text/template" id="PlantOT">
                            <input type="number" ng-model="data.PlanOT" style="color:black; text-align:center" />
                        </script>
                    </div>
                <div class="row" style="margin:10px;">
                    
                    <div class="col-md-6 col-lg-12 col-sm-12">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-right">
                                <li><button ng-click="ProcessAll()" class="btn " id="ChkBtn"><i class="glyphicon glyphicon-arrow-down"></i> Process </button></li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
