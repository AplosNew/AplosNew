<h3 class="site-heading">{{title}}</h3>
<div class="form-elements form-horizontal">
    <div class="row" ng-form name="ModelNewForm">
        <div class="col-xs-12 col-sm-8 col-md-8">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Work Date<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <input type="text" name="Work Date" ng-model="OTManual.WorkDate" datepicker class="form-control datepicker" placeholder="dd-MMM-yyyy" required tabindex="1">
                </div>
                <div class="col-sm-2">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="GetWorkOverStayData();" class="btn"><i class="glyphicon glyphicon-send" tabindex="9"></i> Go</button></li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="DownloadOTData();" class="btn"><i class="glyphicon glyphicon-download" tabindex="9"></i> DownLoad</button></li>
                    <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Save</button></li>
                </ul>
            </div>
            <div style="color:black;" id="GridEmployeeInfoList" ej-grid e-datasource="otApproveList"
                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true"
                 e-allowsorting="true" e-allowselection="true" e-pagesettings-pagesize="25" e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>
                    <div e-column e-field="Code" e-headertext="EmployeeCode" e-width="70"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                    <div e-column e-field="BudgetCode" e-headertext="BudgetCode" e-width="70"></div>
                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="70"></div>
                    <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                    <div e-column e-field="Entity" e-headertext="Entity" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                    <div e-column e-field="ShiftDefinationName" e-headertext="Shift" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Emp Category" e-width="80"></div>
                    <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-width="80"></div>
                    <div e-column e-field="OverStay" e-headertext="Over Stay" e-textalign="right" e-width="80"></div>
                    <div e-column e-field="CalculatedOT" e-headertext="Calculated OT" e-textalign="right" e-width="80"></div>
                    <div e-column e-headertext="OT Hour" e-template="#ProcessedOT" e-textalign="right" e-type="number" e-width="80"></div>
                    <div e-column e-field="DayStatus" e-headertext="Day Status" e-width="80"></div>
                    <div e-column e-field="InTime" e-headertext="InTime" e-width="80"></div>
                    <div e-column e-field="OutTime" e-headertext="OutTime" e-width="80"></div>
                    <div e-column e-field="OTTitle" e-headertext="Is OT EnTitle" e-width="80"></div>
                </div>
            </div>
            <script type="text/template" id="ProcessedOT">
                <input type="number" ng-model="data.OTHr" class="form-control" style="color:black; text-align:right" />
            </script>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Save</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>