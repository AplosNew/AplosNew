                        <select class="form-control" ng-change="getMaterial();" ng-model="ModelNew.CompensetoryOTId" required name="Compensatory / OT"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="OT">OT</option>
                            <option value="Compensatory">Compensatory</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Duration (min.)</label>
                <div class="col-sm-6 show-message" id="durationDiv">
                    <input type="time" name="inTime" ng-model="Duration" id="duration" tabindex="8">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
