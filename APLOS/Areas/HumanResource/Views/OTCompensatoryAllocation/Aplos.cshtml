                </ul>
            </div>

        </div>

        <div class="row">
            <div id="TabEmployee">
                <br />
                <div class="col-xs-12">
                    <div id="GridOTCompensation" ej-grid style="z-index:3;"
                         e-templaterefresh="ActiveEmpcbx"
                         e-datasource="ModelList"
                         e-rowdatabound="onactivedatabound"
                         e-allowfiltering="true"
                         e-allowpaging="true"
                         e-allowsorting="true"
                         e-enabletouch="false"
                         e-responsive="true"
                         e-allowselection="true"
                         e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-headertext="All" e-headertemplateid="#headerTemplateNewlyJoined" e-template="#checkboxTemplateNewlyJoined" e-textalign="center" e-width="30"></div>

                            <div e-column e-field="SystemId" e-headertext="Employee Id" e-width="70"></div>

                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                            <div e-column e-field="Duration" e-headertext="Duration" e-width="80"></div>
                            <div e-column e-field="Remarks" e-headertext="Remark" e-width="100"></div>


                        </div>
                    </div>
                    <div class="common-btn">

                        <div class="col-xs-12 col-lg-12 col-md-12">
                            <ul class="list-inline text-right">
                                <li> <button class="btn" ng-click="viewOTCompensatory()" tabindex="9"><i class="glyphicon glyphicon-save"></i> Save</button></li>
                                <li> <button class="btn" ng-click="check_OR_uncheck()" tabindex="9"><i class="glyphicon glyphicon-cloud"></i> Select</button></li>

                            </ul>
                        </div>

                    </div>
                </div>

                <script type="text/template" id="checkboxTemplateNewlyJoined">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelectSlrProc" />
                </script>
                <script type="text/x-jsrender" id="headerTemplateNewlyJoined">
                    <input type="checkbox" id="cbxhead" />
                </script>
               
               
            </div>
        </div>
    </div>
</div>

<!--Entity POP UP-->
<div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Entity Informations</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="entityParameters.searchBy">
                                            <option ng-repeat="option in entitySearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="entityParameters.search" ng-enter="getEntityData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEntityData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" ng-show="entityDataList.length">
                        <thead>
                            <tr>
                                <th ng-repeat="x in entitySearchList">{{x.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in entityDataList|itemsPerPage:entityParameters.pageSize" total-items="entityParameters.total_count" pagination-id="metaData.name + 'entityDataList'" ng-dblclick="selectEntityPopUp(x);">
                                <td ng-repeat="y in entitySearchList">{{x[y.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'entityDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEntityData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <ul class="list-inline text-right">
                    <li><button type="button" class="btn btn-default" ng-click="closeEntityPopUp();">Close</button></li>
                    <li><button ng-click="selectEntityPopUp();" class="btn">Select</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>