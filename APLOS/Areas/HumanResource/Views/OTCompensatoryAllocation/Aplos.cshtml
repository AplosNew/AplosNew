<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm" id="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
            <div class="form-group">
                <label class="col-sm-4 control-label">Entity</label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.EntityId" required name="Entity"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Department</label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.DepartmentId" required name="Department"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in DepartmentList" value="{{option.Value}}">{{option.text}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Sub Section<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.SubSectionId" required name="Sub Section" tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in SubSectionList" value="{{option.Value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
