<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-list-alt"></span> Welfare Summary Report
</h3>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-6">

            <div class="form-group">
                <label class="col-sm-4">Calender Year</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select id="yearNo" class="form-control" ng-model="YearNo" name="YearNo">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in calendarYearlist" value="{{option.Text}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="common-btn">
                    <button ng-click="GetWelfareSummarydReport();" class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button>
                </div>
            </div>
        </div>

    </div>
</div>