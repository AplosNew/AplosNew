<div id="FDiv">
    <div class="col-md-12 text-left" style="margin-bottom:20px; ">
        <button disabled class="btn" style="border-radius: 00%;cursor:pointer;color:black;" id="forward1">Roster Creation & Planning</button>
        <button class="btn" style="border-radius: 00%;cursor:pointer;background-color:#242841;color:white;" id="forward1" ng-click="clickdde2();">Budget Upload</button>

    </div>
    <togglable name="{{title}}"></togglable>
    <div class="form-elements form-horizontal" ng-form name="HeaderForm">
        <input type="hidden" ng-model="Header.Id">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" id="RosterId" style="display:none;">
                    <label class="col-sm-4 control-label">Roster Id<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="RosterId" ng-model="Header.Id" class="form-control" maxlength="15" readonly>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="Company" ng-change="getPlants()" name="Entity"
                                    ng-options="item.Value as item.Text for item in CompanyList" tabindex="2">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="Header.PlantId" name="Entity"
                                    ng-options="item.Value as item.Text for item in PlantList" tabindex="2">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <input type="text" name="Short Name" ng-model="Header.StandardName" class="form-control" maxlength="15" required tabindex="4">

                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Short Name" ng-model="Header.ShortName" class="form-control" maxlength="15" required tabindex="6">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <textarea name="Description" class="form-control" rows="3" ng-model="Header.Description" tabindex="8" maxlength="250" required></textarea>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Code" ng-model="Header.UserName" class="form-control" required tabindex="3" maxlength="10">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" rows="3" ng-model="Header.Remarks" maxlength="250" tabindex="7"></textarea>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Active</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="Header.Active" tabindex="9">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="margin:10px;">

            <label class="col-md-2 control-label">Effective Date<sup>*</sup></label>
            <div class="col-md-4 show-message">
                <input type="text" name="Effective Date" ng-model="EffectiveDate" ng-change="AddDates(data);" datepicker class="form-control" tabindex="5">
            </div>

        </div>
        <div class="row" style="margin:5px;">
            <span ng-repeat="Item in DatesList" ng-click="DeleteDate(Item.EffectiveDate)" style="cursor:pointer; margin:5px;">> {{Item.EffectiveDate}}</span>
        </div>
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="SaveMasters();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> {{Action}} </button></li>
                @*<li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                <li> <button ng-click="ClearMasters();" class="btn" tabindex="12"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

            </ul>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li> <button ng-click="AddShift();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add Shift </button></li>
            </ul>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="refreshSequence();" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i> Refresh Sequence</button></li>
            </ul>
        </div>
        <div id="ShiftList" ej-grid e-datasource="ShiftChildList" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
            <div e-columns>
                <div e-column e-field="RPHeaderId" e-type="string" e-headertext="Roster Id" e-width="50"></div>
                @*<div e-column e-field="ShiftSequence" e-type="string" e-headertext="Sequence" e-width="80"></div>*@
                <div e-column e-headertext="31 Days" e-template="#allot31" e-textalign="center" e-width="80"></div>
                <div e-column e-headertext="30 Days" e-template="#allot30" e-textalign="center" e-width="80"></div>
                <div e-column e-headertext="29 Days" e-template="#allot29" e-textalign="center" e-width="80"></div>
                <div e-column e-headertext="28 Days" e-template="#allot28" e-textalign="center" e-width="80"></div>
                <div e-column e-field="ShiftName" e-type="string" e-headertext="Shift Name" e-width="80"></div>
                <div e-column e-field="ShiftDefinitionID" e-headertext="Shift Definition Id" e-width="80" e-type="string"></div>
                <div e-column e-headertext="Weekly Status" e-template="#weekly" e-textalign="center" e-width="100"></div>
                <div e-column e-template="#AddTile" e-headertext="Add" e-width="20"></div>
                <div e-column e-template="#EditTile" e-headertext="Edit" e-width="20"></div>
                <div e-column e-template="#DeleteTile" e-headertext="Remove" e-width="20"></div>
            </div>
        </div>
        <script type="text/template" id="allot31">
            <input type="number" ng-model="data.Days31" style="color:black; text-align:center" />
        </script>
        <script type="text/template" id="allot30">
            <input type="number" ng-model="data.Days30" style="color:black; text-align:center" />
        </script>
        <script type="text/template" id="allot29">
            <input type="number" ng-model="data.Days29" style="color:black; text-align:center" />
        </script>
        <script type="text/template" id="allot28">
            <input type="number" ng-model="data.Days28" style="color:black; text-align:center" />
        </script>
        <script type="text/template" id="allot28">
            <input type="number" ng-model="data.Days28" style="color:black; text-align:center" />
        </script>

        <script type="text/template" id="AddTile">
            <div class="common-btn">
                <ul class="list-inline text-center">
                    <li><button ng-click="$parent.AddTile(data);" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus" style="top: 1px;"></i></button></li>
                </ul>
            </div>
        </script>

        <script type="text/template" id="EditTile">
            <div class="common-btn">
                <ul class="list-inline text-center">
                    <li><button ng-click="$parent.EditTile(data);" class="btn" tabindex="9"><i class="glyphicon glyphicon-edit" style="top: 1px;"></i></button></li>
                </ul>
            </div>
        </script>
        <script type="text/template" id="DeleteTile">
            <div class="common-btn">
                <ul class="list-inline text-center">
                    <li><button ng-click="$parent.DeleteTile(data);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                </ul>
            </div>
        </script>
        <script type="text/template" id="weekly">
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-disabled="DailyTargetList.length>0" ng-model="DailyProductionTargetNew.ShiftId" name="ShiftId"
                            ng-options="item.Value as item.Text for item in ShiftList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
            <div class="input-group">
                <input type="text" class="form-control" ng-model="data.EmployeeCode" ng-keyup="$event.keyCode === 13 && $parent.changeInData(data,'emp')" style="color:black; text-align:center" />
                <span class="input-group-btn">
                    <button name="submit" ng-click="$parent.changeInData(data,'emp')" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </script>
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="checkChildList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> {{Action1}} </button></li>
                <li> <button ng-click="ClearShifts();" class="btn" tabindex="12"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

            </ul>
        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div id="Master" ej-grid e-datasource="masterGrid" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;"
             e-recorddoubleclick="fillUpdates">
            <div e-columns>
                <div e-column e-field="PlantName" e-headertext="Plant" e-width="2"></div>
                <div e-column e-field="Id" e-headertext="Roster Id" e-width="2"></div>
                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="2"></div>
                <div e-column e-field="UserName" e-headertext="User Name" e-width="2"></div>
                <div e-column e-field="Description" e-headertext="Description" e-width="2"></div>
                <div e-column e-field="ShortName" e-headertext="Short Name" e-width="2"></div>
                <div e-column e-field="CreationDate" e-headertext="Creation Date" e-width="2"></div>
                <div e-column e-field="Active" e-headertext="Active/Inactive" e-width="2"></div>
                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="2"></div>
            </div>
        </div>
    </div>
    <confirm-modal></confirm-modal>

    <!--<div class="col-xs-6 col-sm-6 col-md-6">
        <div class="row">
            <h2>This is just for Testing Purpose  of the Roster Process Testing Don't Use It!!</h2>-->
            @*<div class="col-xs-5 col-sm-6 col-md-6" style="margin-top:20px;">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="From Date" ng-model="FromDateF" datepicker class="form-control" tabindex="4">

                        </div>
                    </div>
                </div>
                <div class="col-xs-5 col-sm-6 col-md-6" style="margin-top:20px;">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="To Date" ng-model="ToDateF" datepicker class="form-control" tabindex="4">

                        </div>
                    </div>
                </div>*@
        <!--</div>
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="Run();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> Run Process </button></li>

            </ul>
        </div>
    </div>-->
</div>

<div id="SDiv">

    <div class="col-md-12 text-left" style="margin-bottom:20px; ">
        <button class="btn" style="border-radius: 00%;cursor:pointer;background-color:#242841;color:white;" id="forward1" ng-click="clickdde1();">Roster Creation & Planning</button>

        <button disabled class="btn" style="border-radius: 00%;cursor:pointer;color:black;" id="forward1">Budget Upload</button>

    </div>

    <togglable name="Budget Upload"></togglable>
    <div class="form-elements form-horizontal" ng-form name="HeaderForm">
        <div class="row">
            <div class="form-elements">
                <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Plant</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="BudgetPlantId" name="Plant"
                                        ng-options="item.Value as item.Text for item in PlantList"  tabindex="2">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-10">

                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-4 " style="padding: 0 0 0 0 ; margin-right:8px;">
                            <input id="uploadFile" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                        </label>
                        <input type="button" style="margin-right: 8px;" value="Import Data" ng-disabled="enable" class="btn btn-success" ng-click="ImportData()" />
                        <button ng-click="GetSample();" class="btn" style="margin-right: 8px;"><i class="glyphicon glyphicon-download"></i> Get Buget And Roster Report File </button>

                    </div>
                </div>

            </div>

        </div>
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="saveFileList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> Save </button></li>
                <li> <button ng-click="clearFileList();" class="btn" tabindex="12"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

            </ul>
        </div>

        <div id="RosterBudgetGrid" ej-grid e-datasource="ExcelUploadData" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
            <div e-columns>
                <div e-column e-field="BudgetId" e-type="string" e-headertext="Budget Id" e-width="80"></div>
                <div e-column e-field="BudgetCode" e-type="string" e-headertext="Budget Code" e-width="80"></div>
                <div e-column e-field="RosterId" e-type="string" e-headertext="Roster Id" e-width="80"></div>
            </div>
        </div>

    </div>

    <div class="row aplos-grid-toggle">
        <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
            <div class="form-group" >
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="Company" ng-change="getPlants()" name="Entity"
                                ng-options="item.Value as item.Text for item in CompanyList"  tabindex="2">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Plant</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="BudgetPlantId" name="Plant"
                                    ng-options="item.Value as item.Text for item in PlantList" tabindex="2">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>
        </div>

        </div>

        <div class="table-responsive aplos-grid-toggle">
            <div class="common-btn" style="margin-top:10px;">
                <ul class="list-inline text-right">
                    <li> <button ng-click="getCurrentFileList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-search"></i> View </button></li>

                </ul>
            </div>
            <div id="CurrentListRoster" ej-grid e-datasource="currentList" e-templaterefresh="refreshTemplate"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;"
                 e-recorddoubleclick="fillUpdates">
                <div e-columns>
                    <div e-column e-field="Rows" e-headertext="Sr. No." e-width="2"></div>
                    <div e-column e-field="BudgetId" e-headertext="Budget Id" e-width="2"></div>
                    <div e-column e-field="RosterId" e-headertext="Roster Id" e-width="2"></div>
                    <div e-column e-field="AddedDate" e-headertext="Creation Date" e-width="2"></div>
                    <div e-column e-field="AddedBy" e-headertext="Added By" e-width="2"></div>
                </div>
            </div>
        </div>
        <confirm-modal></confirm-modal>



    </div>



<!--Modal For Shift Selection-->
<div class="modal fade site-modal in" id="ShiftModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Shift Definition Plant Wise</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic"> </div>
                <p style="margin:10px;">
                    Select the Shift by Double Clicking.
                <p>

                    <div id="shiftsList" ej-grid e-datasource="ShiftsList" e-templaterefresh="refreshTemplate"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-minWidth="450" e-minHeight="400" e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true"
                         e-recorddoubleclick="shiftSelected">
                        <div e-columns>

                            <div e-column e-field="ShiftDefinationID" e-headertext="SystemId" e-width="70"></div>
                            <div e-column e-field="ShiftDefinationName" e-headertext="Shift Name" e-width="30"></div>
                            <div e-column e-field="ShiftDefinationDescription" e-headertext="Description" e-width="100"></div>
                            <div e-column e-field="ShiftType" e-headertext="Shift Type" e-width="40"></div>
                            <div e-column e-field="ShiftSequence" e-headertext="Seq" e-width="20"></div>
                            <div e-column e-field="InTime" e-headertext="InTime" e-width="50"></div>
                            <div e-column e-field="LateMargin" e-headertext="Late Margin" e-width="50"></div>
                            <div e-column e-field="OutTime" e-headertext="OutTime" e-width="50"></div>
                        </div>
                    </div>


            </div>
        </div>

    </div>
</div>

<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to save without any shifts ?" data-ng-click-left-button="restoreChildShifts();" data-ng-click-right-button="SaveShifts();"></confirm-archive-generic>
