<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  Employee Week Off Updates
</h3>
<div class="form-horizontal form-elements" id="mainContainer">

    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="DayTypeWithValues" role="tab" data-toggle="tab">Employee Week Off</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="DayStatus" role="tab" data-toggle="tab">Process Attendance</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="weekoffUpload" role="tab" data-toggle="tab">Week Off Upload</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label" style="margin-top:10px">Employee<sup>*</sup></label>
                        <div class="col-sm-8 show-message" style="margin-top:10px">
                            <input type="text" name="Location" ng-model="employee" ng-click="selectEmployee()" class="form-control" maxlength="200" tabindex="5">
                        </div>
                    </div>

                </div>
                <div class="row" style="margin-top:10px;">
                    <div class="col-xs-12 col-sm-6 col-md-6">

                        <div class="form-group" id="normalweek">
                            <label class="col-sm-4 control-label">Week Off</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="WekId" name="Weekly"
                                            ng-options="item.value as item.text for item in weekList">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group" id="scWeekhtml">
                            <label class="col-sm-4 control-label">Scattered Week Off</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <input class="form-control" ng-model="ScWeekName" ng-click="scatteredWeek()" name="ScWeekly">
                                    @*<option value="">--Select--</option>*@
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-xs-12 col-sm-6 col-md-6">

                        <div class="form-group">
                            <label class="col-sm-4 control-label" style="margin-top:10px">Effective Date</label>
                            <div class="col-sm-8 show-message" style="margin-top:10px">
                                <input type="text" id="DD" name="Date" ng-model="EffectiveDates" datepicker class="form-control ssd">

                            </div>
                        </div>

                    </div>



                    <br>
                    <div class="common-btn" style="margin-top:10px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="saveSingle();" class="btn"><i class="glyphicon glyphicon-save"></i> Save </button></li>
                            <li> <button ng-click="clearSingle();" class="btn"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

                        </ul>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div id="showEmp" ej-grid e-datasource="EmpGridList"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-minWidth="450" e-minHeight="400" e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                        <div e-columns>
                            <div e-column e-field="UserName" e-headertext="Week Off" e-width="80"></div>
                            <div e-column e-field="EffectiveDate" e-headertext="Effective Date" e-width="80"></div>

                        </div>
                    </div>

                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group">
                        <label class="col-sm-4 control-label" style="margin-top:10px">Effective Date</label>
                        <div class="col-sm-8 show-message" style="margin-top:10px">
                            <input type="text" id="Ddx" required name="Datex" ng-model="selectedValues.FromDate" ng-change="getEmpDetailsData()" datepicker class="form-control">

                        </div>
                    </div>

                </div>

                <div class="col-xs-12 col-sm-6 col-md-6">


                    <div class="form-group">
                        <label class="col-sm-4 control-label" style="margin-top:10px;padding-right:10px" title="Employee">Employee</label>
                        <div class="col-sm-8 input-group" style="margin-top: 10px; margin-right:10px">

                            <span class="input-group-btn">
                                <button ng-click="EmployeePopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>

                <br />
                <br />

                <div class="table-responsive aplos-grid-toggle">

                    <div id="OTFilingListGrid" ej-grid e-datasource="EmpSelectedData"
                         e-allowfiltering="false" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-recorddoubleclick="Get">
                        <div e-columns>
                            <div e-column e-type="string" e-field="EmployeeCode" e-headertext="EmployeeCode" e-width="140"></div>
                            <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="140"></div>
                            <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="140"></div>
                            <div e-column e-type="string" e-field="Department" e-headertext="Department Name" e-width="140"></div>
                            <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="140"></div>
                            <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="140"></div>

                        </div>
                    </div>
                </div>

                <div class="common-btn" style="padding-top:20px;">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="ProcessAttendance()" class="btn">Process WeekOff</button></li>
                    </ul>
                </div>


            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                   
                    <div class="form-elements form-horizontal row" >
                        <div class="col-md-9">
                            <div class="inputBtnSection common-btn">
                                <label class="fileUpload col-sm-4 ">
                                    <input id="uploadImage2" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                                </label>
                                <input type="button" value="Import Data" class="btn btn-success"
                                       ng-click="ImportData()" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="GetSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File Download</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-12">
                            <div id="GridTDS"
                                 ej-grid e-datasource="UploadedData"
                                 e-allowfiltering="true"
                                 e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                 e-allowscrolling="true"
                                 e-pagesettings-pagesize="25"
                                 e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-field="EmpSystemId" e-headertext="EmpSystemId" e-width="60"></div>
                                    <div e-column e-field="WOHeaderId" e-headertext="WOHeaderId" e-width="60"></div>
                                    <div e-column e-field="EffectiveDate" e-headertext="EffectiveDate" e-width="50"></div>

                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 ">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li ng-show="ShowSaveBtn"> <button ng-click="SaveUploadedData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </div>

    </div>

</div>
<confirm-modal></confirm-modal>


<div class="modal fade site-modal in" id="employeesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Employees</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic"> </div>
                <p style="margin:10px;">
                    Select The Employee by Double Clicking the Choice.
                <p>

                    <div id="getEmployees" ej-grid e-datasource="EmployeesList"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-minWidth="450" e-minHeight="400" e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true"
                         e-recorddoubleclick="doubleEmployee">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="Id" e-width="80"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>

                        </div>
                    </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>

<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to save without any shifts ?" data-ng-click-left-button="restoreChildShifts();" data-ng-click-right-button="SaveShifts();"></confirm-archive-generic>



<div class="modal fade site-modal in" id="EmployeePop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Employee List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridEmployee" ej-grid e-datasource="EmployeeList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplateemployee" e-responsive="true">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>

                                <div e-column e-type="string" e-field="EmployeeCode" e-headertext="EmployeeCode" e-width="140" ></div>
                                <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="140"></div>
                                <div e-column e-type="string" e-field="Department" e-headertext="Department Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="140"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="140"></div>
                            </div>

                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" e-value="data.isSelected" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>


                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="SelectEmPDetails('EmployeePop');" class="btn"><i class=""></i> Select</button>
                            <button ng-click="closeEmpPopUp('EmployeePop');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="scatteredWeekModal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Scattered Weeks Counts</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic"> </div>
                <p style="margin:10px;">
                    Double Click the week off you want to assign (NOTE: Can only select the week off with lowest employees)
                <p>

                    <div id="empsWeek" ej-grid e-datasource="EmpScatteredList"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                        e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true"
                         e-recorddoubleclick="doubleScatteredWeek">
                        <div e-columns>
                            <div e-column e-field="UserName" e-headertext="Week Off Name" e-width="80"></div>
                            <div e-column e-field="Emps" e-headertext="Employees Assigned" e-width="80"></div>
                            @*<div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>*@

                        </div>
                    </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>