<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  Admin Attendance Control
</h3>
<div class="form-horizontal form-elements" id="mainContainer">
    <div id="Tab" ej-tab e-create="actionCompleteSingleEmployee">
        <ul>
            <li><a href="#TabOne">Employee Wise</a></li>
            <li><a href="#TabTwo">Full List Wise</a></li>
        </ul>
        @*Convert.ToDateTime(WkDate).ToString("yyyyMMdd");*@
    <div id="TabOne">
        <p>In Progress ... </p>
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label" style="margin-top:10px">Employee<sup>*</sup></label>
                    <div class="col-sm-8 show-message" style="margin-top:10px">
                        <input type="text" name="Location" ng-model="employee" ng-click="selectEmployee()" class="form-control" maxlength="200" tabindex="5">
                    </div>
                </div>

            </div>
        </div>
        <div class="row" style="margin-top:10px;">
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group">
                    <label class="col-sm-4 control-label">Week Off</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="WekId" name="Weekly"
                                    ng-options="item.value as item.text for item in weekList">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group">
                    <label class="col-sm-4 control-label" style="margin-top:10px">Effective Date</label>
                    <div class="col-sm-8 show-message" style="margin-top:10px">
                        <input type="text" name="Date" ng-model="EffectiveDate" datepicker class="form-control">

                    </div>
                </div>

            </div>



            <br>
            <div class="common-btn" style="margin-top:10px;">
                <ul class="list-inline text-right">
                    <li> <button ng-click="saveSingle();" class="btn" ><i class="glyphicon glyphicon-save"></i> Save </button></li>
                    <li> <button ng-click="clearSingle();" class="btn"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

                </ul>
            </div>
        </div>
    </div>
        <div id="TabTwo">
                <div class="row">
                    <div class="form-elements">

                        <div class="col-md-10">

                            <div class="inputBtnSection common-btn">
                                <label class="fileUpload col-sm-4 " style="padding: 0 0 0 0 ; margin-right:8px;">
                                    <input id="uploadFile" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                                </label>
                                <input type="button" style="margin-right: 8px;" value="Import Data" ng-disabled="enable" class="btn btn-success" ng-click="ImportData()" />
                                <button ng-click="GetSample();" class="btn" style="margin-right: 8px;"><i class="glyphicon glyphicon-download"></i> Get Sample Report File </button>

                            </div>
                        </div>

                    </div>

                </div>
                <div class="common-btn" style="margin-top:10px;">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="getCurrentFileList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-search"></i> View </button></li>
                        <li> <button ng-click="saveFileList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> Save </button></li>
                        <li> <button ng-click="clearFileList();" class="btn" tabindex="12"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

                    </ul>
                </div>

                <div id="RosterBudgetGrid" ej-grid e-datasource="ExcelUploadData" e-templaterefresh="refreshTemplate"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
                    <div e-columns>
                        <div e-column e-field="EmpSystemId" e-type="string" e-headertext="Id" e-width="80"></div>
                        <div e-column e-field="EmployeeCode" e-type="string" e-headertext="Emp Code" e-width="80"></div>
                        <div e-column e-field="WOHeaderId" e-type="string" e-headertext="Week Off Id" e-width="80"></div>
                        <div e-column e-field="EffectiveDate" e-type="string" e-headertext="Effective Date" e-width="80"></div>
                    </div>
                </div>


            <div class="table-responsive" id="SavedTable">
                <div id="CurrentListRoster" ej-grid e-datasource="currentList" e-templaterefresh="refreshTemplate"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
                    <div e-columns>
                        <div e-column e-field="Rows" e-headertext="Sr. No." e-width="2"></div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="2"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="2"></div>
                        <div e-column e-field="WOHeaderId" e-headertext="WO Id" e-width="2"></div>
                        <div e-column e-field="WOName" e-headertext="WO Name" e-width="2"></div>
                        <div e-column e-field="EffectiveDate" e-headertext="Effective Date" e-width="2"></div>
                    </div>
                </div>
            </div>



        </div>

    </div>
</div>

<div class="modal fade site-modal in" id="employeesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Employees</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic"> </div>
                <p style="margin:10px;">
                    Select The Employee by Double Clicking the Choice.
                <p>

                    <div id="getEmployees" ej-grid e-datasource="EmployeesList" 
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-minWidth="450" e-minHeight="400" e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true"
                         e-recorddoubleclick="doubleEmployee">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="Id" e-width="80"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>

                        </div>
                    </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>

<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to save without any shifts ?" data-ng-click-left-button="restoreChildShifts();" data-ng-click-right-button="SaveShifts();"></confirm-archive-generic>
