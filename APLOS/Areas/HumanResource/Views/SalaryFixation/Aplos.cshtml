<togglable name="Salary Fixation"></togglable>
<p style="text-decoration:underline;cursor:pointer;" ng-show="message==null" ng-click="showEntityPopUp();">My Entity List</p>
<p class="msg-success" ng-show="message!=null">*{{message}}</p>
<div class="form-elements form-horizontal" ng-form name="SalaryFixationNewForm">
    <input type="hidden" ng-model="SalaryFixationNew.Id">
    <div class="row" ng-form name="salaryFixation">
        <div class="col-md-12">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <ul class="common-btn list-inline text-left">
                    <li><button class="btn" ng-click="getActiveApprovedEmployee();"><i class="glyphicon glyphicon-search"></i> Search Candidate</button></li>
                </ul>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12" id="hiddenEmpInfo">
                <input type="text" ng-model="SalaryFixation.PreRecruitmentEmployeeID" hidden />
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Candidate Name :</label>
                        <div class="col-sm-8">
                            <label>{{SalaryFixation.FullName}}</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Candidate Code :</label>
                        <div class="col-sm-8">
                            <label>{{SalaryFixation.EmployeeCode}}</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Budget Code :</label>
                        <div class="col-sm-8">
                            <label>{{SalaryFixation.Code}}</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Email :</label>
                        <div class="col-sm-8">
                            <label>{{SalaryFixation.Email}}</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Given Designation :</label>
                        <div class="col-sm-8">
                            <label>{{SalaryFixation.GivenDesignation}}</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Department :</label>
                        <div class="col-sm-8">
                            <label>{{SalaryFixation.Department}}</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Salary Rule :</label>
                        <div class="col-sm-8">
                            <label>{{SalaryFixation.SalaryRuleName}}</label>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <div class="col-sm-8">
                            <div>
                                <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="margin-left: 180px; border: 1px solid; height: 200px; width: 200px;" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-2 control-label">Fomula :</label>
                        <div class="col-sm-10">

                            <div ng-repeat="item in SalaryFixation.Formula">
                                {{item}}<br />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="tab-design" id="tab_show" ng-show="SalaryFixation.PreRecruitmentEmployeeID.length>0">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" aria-controls="monthly" role="tab" data-toggle="tab"> Monthly Cash</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" aria-controls="annualCash" role="tab" data-toggle="tab"> Annual Cash </a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" aria-controls="annualNonCash" role="tab" data-toggle="tab"> Annual Non-Cash </a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" aria-controls="leave" role="tab" data-toggle="tab"> Leave </a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" aria-controls="terms" role="tab" data-toggle="tab"> Terms & Conditions </a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="monthlyTab">

                    <div class="common-btn">
                        <ul class="list-inline text-right" style="padding-right:15px;padding-top:5px;">
                            <li>Agreed Salary</li>
                            <li><input type="text" class="form-control" style="height: 25px;" ng-model="SalaryFixation.TotalSalary" /></li>
                            <li><button ng-click="CalculateFinal();" class="btn" tabindex="8"><i class="fa fa-calculator" aria-hidden="true"></i> Calculate</button></li>
                        </ul>
                    </div>

                    <div class="table-responsive modal-table col-md-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Salary Head</th>
                                    <th>Current Amount</th>
                                    <th>Expected Amount</th>
                                    <th>Fixation Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="dr in salaryHeadListMonth">
                                    <td>{{dr.SalaryHead}}</td>
                                    <td><input type="text" class="form-control" style="height: 25px;" ng-model="dr.CurrentAmount" disabled /></td>
                                    <td><input type="text" class="form-control" style="height: 25px;" ng-model="dr.ExpectedAmount" disabled /></td>
                                    <td><input type="text" class="form-control" style="height: 25px;" ng-disabled="dr.IsOpen===false" ng-model="dr.FixationAmount" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="AnCashTab">
                    <div class="table-responsive modal-table col-md-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Salary Head</th>
                                    <th>Current Amount</th>
                                    <th>Expected Amount</th>
                                    <th>Fixation Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="dr in salaryHeadListAc">
                                    <td>{{dr.SalaryHead}}</td>
                                    <td><input type="text" class="form-control" style="height: 25px;" ng-model="dr.CurrentAmount" disabled /></td>
                                    <td><input type="text" class="form-control" style="height: 25px;" ng-model="dr.ExpectedAmount" disabled /></td>
                                    <td><input type="text" class="form-control" style="height: 25px;" ng-model="dr.FixationAmount" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row" ng-form name="AnNonCashTab">
                    <div class="table-responsive modal-table col-md-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Salary Head</th>
                                    <th>Current Status</th>
                                    <th>Expected Status</th>
                                    <th>Fixation Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="dr in salaryHeadListAnc">
                                    <td>{{dr.SalaryHead}}</td>
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="dr.CurrentStatusN" disabled>
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="dr.ExpectedStatusN" disabled>
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="dr.FixationStatusN">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row" ng-form name="leaveTab">
                    <div class="table-responsive modal-table col-md-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Salary Head</th>
                                    <th>Current Status</th>
                                    <th>Expected Status</th>
                                    <th>Fixation Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="dr in salaryHeadListLeave">
                                    <td>{{dr.SalaryHead}}</td>
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="dr.CurrentStatusL" disabled>
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="dr.ExpectedStatusL" disabled>
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="dr.FixationStatusL">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="row" ng-form name="termsandconditions">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Terms & Condition1</label>
                        <div class="col-sm-8 show-message">
                            <textarea class="form-control" rows="10" ng-model="termsAndconditions.Description1" name="Description1" tabindex="7"></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Terms & Condition2</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="10" ng-model="termsAndconditions.Description2" tabindex="6"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right" style="padding-right:15px;padding-top:5px;">
            <li><button ng-click="SaveAsUpdate(false);" class="btn"><i class="glyphicon glyphicon-floppy-saved"></i> {{Action}}</button></li>
            <li><button ng-click="SaveAsUpdate(true);" class="btn"><i class="glyphicon glyphicon-floppy-open"></i> Save and Mail</button></li>
            <li><button ng-click="SendMail();" class="btn"><i class="icon icon-envelope"></i> Send Mail</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="modal fade site-modal in" id="PopUpEmployee" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Candidate Information</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeePopUpParameters.searchBy">
                                            <option ng-repeat="option in searchInEmpList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeePopUpParameters.search" ng-enter="getActiveApprovedEmployee()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getActiveApprovedEmployee()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Candidate Code</th>
                                <th>Candidate Name</th>
                                <th>Email</th>
                                <th>Budget Code</th>
                                <th>Given Designation</th>
                                <th>Department</th>
                                <th>SalaryRuleName</th>
                                <th>TotalSalary</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="dr in dataListEmployee |itemsPerPage:employeePopUpParameters.pageSize" pagination-id="metaData.name + 'dataListEmployee'"
                                total-items="employeePopUpParameters.total_count" ng-dblclick="getEmployeeDataOnLabels(dr);">
                                <td>{{dr.EmployeeCode}}</td>
                                <td>{{dr.FullName | uppercase}}</td>
                                <td>{{dr.Email}}</td>
                                <td>{{dr.Code}}</td>
                                <td>{{dr.GivenDesignation}}</td>
                                <td>{{dr.Department}}</td>
                                <td>{{dr.SalaryRuleName}}</td>
                                <td>{{dr.TotalSalary}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'dataListEmployee'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getActiveApprovedEmployee(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="salaryHeadAnnualNonCashToTable();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="Delete();">
</confirm-archive-generic>
<div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header"> My Entity List<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Entity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in entityList">
                                <td>{{x.Code}}</td>
                                <td>{{x.EntityName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>