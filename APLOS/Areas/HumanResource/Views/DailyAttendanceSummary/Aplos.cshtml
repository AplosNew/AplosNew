<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Daily Attendance Summary</h3>
<div class="form-horizontal form-elements">
    <div class="row">

        <div class="col-sm-12">

            <div class="col-sm-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Work Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">

                        <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="dailyattendanceReport.WorkDate" datepicker class="form-control datepicker" tabindex="1">
                    </div>
                </div>
            </div>

            <div class="col-sm-4">
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li>
                                <a class="btn" style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" href="humanresource/DailyAttendanceSummary/GetdailyattendanceView?WorkDate={{dailyattendanceReport.WorkDate}}" target="_blank"><i class="fa fa-eye" style="margin: -6px;"> View</i></a>
                            </li>
                            <li><button ng-click="GetdailyattendanceReport('EXCEL');" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>








