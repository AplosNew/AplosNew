<ej-dialog id="dialogMessage" title="{{messageTitle}}" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target=".site-heading" e-close="onDialogClose" e-minwidth="50%" e-minheight="50" e-open="enableBtn">

    @*<div>
            {{messageText}}
        </div>*@
    <h6>Miss Punch List</h6>
    <div id="GridMissPunch"
         ej-grid
         e-datasource="MissPunchEmployeeListAuto"
         e-allowfiltering="true"
         e-allowpaging="true"
         e-allowsorting="true"
         e-enabletouch="false"
         e-responsive="true"
         @*e-minheight="500"*@
         e-allowselection="true"
         e-pagesettings-pagesize="17"
         e-filtersettings-filterType="excel">
        <div e-columns>
            <div e-column e-field="EmployeeCode" e-isprimarykey="true" e-allowediting="false" e-headertext="Employee Code" e-width="150"></div>
            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="250"></div>
            <div e-column e-field="ShiftInTime" e-headertext="Shift In Time" e-allowediting="false" e-width="200"></div>
            <div e-column e-field="ShiftOutTime" e-headertext="Shift Out Time" e-allowediting="false" e-width="200"></div>
            <div e-column e-field="InTime" e-headertext="In Time" e-allowediting="false" e-width="100"></div>
            <div e-column e-field="DayStatus" e-allowediting="false" e-headertext="DayStatus" e-width="100"></div>
            <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
            <div e-column e-field="DepartmentName" e-headertext="DepartmentName" e-width="100"></div>
            <div e-column e-field="EmpCategoryName" e-headertext="EmpCategoryName" e-width="100"></div>
            <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="100"></div>
            <div e-column e-field="Unit" e-headertext="Unit" e-width="100"></div>
            <div e-column e-field="Line" e-headertext="Line" e-width="100"></div>
        </div>
    </div>


</ej-dialog>


