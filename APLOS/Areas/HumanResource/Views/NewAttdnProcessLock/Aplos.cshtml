<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Attendance Lock/UnLock </h3>
<div class="row form-horizontal form-elements" ng-form name="LockUnLockForm">

  
</div>
<br />
<div class="row form-horizontal form-elements" ng-form name="General">
    <div class="col-xs-12 col-sm-6 col-md-7 ">
        <div class="form-group">
            <label class="col-sm-3 control-label"> Date<sup>*</sup></label>
            <div class="col-sm-4">
                <div class="select-style">
                    <input class="form-control" autocomplete="off" datepicker ng-change="GetEmpData()" id="txtLockDate" required ng-model="ModelNew.lockDate" placeholder="dd-MM-yyyy" type="text" />
                   
                </div>

            </div>
          
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-3 ">
        <div class="common-btn">

            <ul class="list-inline text-right">

                <li style="float:left"> <button ng-click="SaveLockData()"  class="btn"><i class="glyphicon glyphicon-check"></i> Lock</button></li>
               
                <li style="float:right"> <button ng-click="getEmpListData()" class="btn"><i class="glyphicon glyphicon-check"></i> UnLock</button></li>
            </ul>
        </div>

    </div>
   

</div>

<br />
