<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="ModalNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">Survey and Feedback</legend>
        <input type="hidden" ng-model="ModalNew.Id">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group">
                    <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                    <div class="col-sm-6 show-message">
                        <input type="text" name="User Name" ng-model="ModalNew.ShortName" class="form-control" required tabindex="5" maxlength="30">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                    <div class="col-sm-6 show-message">
                        <input type="text" name="User Name" ng-model="ModalNew.UserName" class="form-control" required tabindex="5" maxlength="30">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Mentor<sup>*</sup></label>
                    <div class="col-sm-6 show-message">
                        <input type="text" name="User Name" ng-model="ModalNew.Mentor" class="form-control" required tabindex="5" maxlength="30">
                    </div>
                </div>
                @*<div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">

                            <input type="text" name="Responsible Person" ng-model="ResponsiblePerson" class="form-control" required readonly>
                            <span class="input-group-btn">
                                <button name="submit" ng-click="OpeEmployeePopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>*@
                <div class="form-group">
                    <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
                    <div class="col-sm-6 show-message">
                        <input type="text" name="From Date" ng-model="ModalNew.EffectiveDate" datepicker class="form-control" tabindex="4">

                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label" style="margin-top:-5px !important"> Active</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site" id="">
                            <label>
                                <input type="checkbox" name="is Active" ng-model="ModalNew.IsActive" tabindex="8" style="margin-top:10px !important">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!--
         //** ----------------------------------------------------  **//
        -->

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                    <div class="col-sm-6 show-message">
                        <input type="text" name="User Name" ng-model="ModalNew.StandardName" class="form-control" required tabindex="5" maxlength="30">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Importance</label>
                    <div class="col-sm-6 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ModalNew.Importance" required name="Access Type" tabindex="2">
                                <option value="">--Select--</option>
                                <option value="Critical">Critical</option>
                                <option value="Important">Important</option>
                                <option value="Normal">Normal</option>


                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-6">
                        <textarea class="form-control" rows="3" ng-model="ModalNew.Remarks" tabindex="7" maxlength="250"></textarea>
                    </div>
                </div>

            </div>


            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                    @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
            <div class="col-xs-12 col-lg-3 col-md-3"></div>
            

        </div>
    </fieldset>
</div>
    

<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Issue Item</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Service" role="tab" data-toggle="tab">Responsible Person</a></li>

        </ul>
    </div>
    @*TAB - 1*@
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <div class="content-container-fluid" style="color:black;">
            <div style="color:black;" ej-grid e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplateOccupiedEmployee">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerIssueItemTemplate" e-template="#checkboxIssueItemTemplate" e-textalign="center" e-width="10"></div>
                    <div e-column e-headertext="Issue Item" e-template="#IssueItem" e-textalign="left" e-width="50"></div>
                    <div e-column e-headertext="Remarks" e-template="#Remarks" e-textalign="left" e-width="50"></div>
                    <div e-column e-headertext="Active" e-template="#Active" e-textalign="left" e-width="50"></div>
                </div>
            </div>
            <script type="text/template" id="checkboxIssueItemTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
            </script>
            <script type="text/x-jsrender" id="headerIssueItemTemplate">
                <input type="checkbox" id="Occupiedheadcheck" />
            </script>
            <script type="text/template" id="IssueItem">
                <input type="text" name="Issue Item" ng-model="data.IssueItem" class="form-control" required tabindex="5" maxlength="30">
            </script>
            <script type="text/template" id="Remarks">
                <input type="text" name="Remarks" ng-model="data.Remarks" class="form-control" required tabindex="5" maxlength="30">
            </script>
            <script type="text/template" id="Active">
                <input type="text" name="Active" ng-model="data.Active" class="form-control" required tabindex="5" maxlength="30">
            </script>
        </div>
        <div class="common-btn" style="margin-top:10px">

            <ul class="list-inline text-right">


                <li> <button ng-click="SaveMaterialAllocation();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>

            </ul>

        </div>
    </div>
    @*------------------------------------------------------------------------------------------------------------------*@
    @*TAB - 2*@
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div class="table-responsive aplos-grid-toggle">
            <div ej-grid
                 e-load="loadGridEdit"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-enabletouch="false"
                 e-responsive="true"
                 e-allowselection="true"
                 e-filtersettings-filterType="excel"
                 e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerResponsiblePersonTemplate" e-template="#checkboxResponsiblePersonTemplate" e-textalign="center" e-width="10"></div>
                    <div e-column e-headertext="Responsible Person" e-template="#ResponsiblePerson" e-textalign="left" e-width="50"></div>
                    <div e-column e-headertext="Period" e-template="#Period" e-textalign="left" e-width="50"></div>
                    <div e-column e-headertext="Frequency" e-template="#Frequency" e-textalign="left" e-width="50"></div>
                </div>
            </div>
            <script type="text/template" id="checkboxResponsiblePersonTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
            </script>
            <script type="text/x-jsrender" id="headerResponsiblePersonTemplate">
                <input type="checkbox" id="Occupiedheadcheck" />
            </script>
            <script type="text/template" id="ResponsiblePerson">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">

                            <input type="text" name="Responsible Person" ng-model="ResponsiblePerson" class="form-control" required readonly>
                            <span class="input-group-btn">
                                <button name="submit" ng-click="OpeEmployeePopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </script>
            <script type="text/template" id="Period">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Location<sup>*</sup></label>
                    <div class="col-sm-6">

                        <div class="select-style">
                            <select class="form-control" id="Location" ng-model="ModalNew.Location" required name="Residence Type"
                                    tabindex="2">
                                <option value="">--Select--</option>
                                <option value="Daily Routine">Daily Routine</option>
                                <option value="Weekly Routine">Weekly Routine</option>
                                <option value="Fore Night">Fort Nightly</option>
                                <option value="Monthly Routine">Monthly Routine</option>

                            </select>
                        </div>
                    </div>
                </div>
            </script>
            <script type="text/template" id="Frequency">
                <input type="text" name="Frequency" ng-model="data.Frequency" class="form-control" required tabindex="5" maxlength="30">
            </script>
        </div>
        <div class="common-btn" style="margin-top:10px">

            <ul class="list-inline text-right">

                <li> <button  class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>

            </ul>

        </div>
    </div>

</div>
</div>











