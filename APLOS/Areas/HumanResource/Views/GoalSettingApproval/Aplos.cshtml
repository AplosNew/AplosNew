<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    @* ENTER ROBUDGET CODE & PERFORMANCE PERIOD*@
    <div class="row">

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-2 control-label">RO Budget<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="RoBudget" ng-click="selectROBudget()" ng-model="RoBudgetCode" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-3 control-label">Performance Period<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="Performance Period" ng-click="selectPerfPeriod()" ng-model="PerformancePeriod" class="form-control" maxlength="200" tabindex="5">
                </div>
            </div>
        </div>
        <div class="container">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="SearchROPP();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> Search</button></li>

                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>

                </ul>
            </div>
        </div>
    </div>
    @* GOAL SETTING APPROVAL EMPLOYEE INFO*@
    <div class="row" id="">
        <div class="col-lg-12 col-md-12 " style="margin-top:20px; margin-bottom:10px">

            <div style="color:black;" id="Grid" ej-grid e-datasource="ModelList" e-recorddoubleclick=""
               ng-click="OpenEG()"  e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                <div e-columns>
                    <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="50"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="50"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="50"></div>

                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="50"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                    <div e-column e-field="Unit" e-headertext="Unit" e-width="50"></div>
                    <div e-column e-field="PerformanceYearName" e-headertext="Performance Year Name" e-width="50"></div>

                </div>

            </div>
            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">

                        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i>Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!--POP UP SCREEN  FOR SELECT PERFORMANCE PERIOD     -->
<div class="modal fade site-modal in" id="performceperiodPop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify ">
        <div class="modal-content">
            <div class="modal-header">Performance Period Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p style="margin-top:20px">Please Select Performance Period .</p>
                        <div style="color:black;" id="GridEmployee" ej-grid e-datasource="PerformancePeriodList" e-recorddoubleclick="selPerformacePeriod"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="50"></div>
                                <div e-column e-field="PerformanceYearName" e-headertext="Performance Year Name" e-width="80"></div>
                                <div e-column e-field="StartDate" e-headertext="Start Date" e-width="120"></div>
                                <div e-column e-field="EndDate" e-headertext="End Date" e-width="70"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeEmpPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>

<!--    POP UP SCREEN  FOR RO BUDGET     -->
<div class="modal fade site-modal in" id="ROBudgetPop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify ">
        <div class="modal-content">
            <div class="modal-header">Men Power Budget Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p style="margin-top:20px">Please RO Budget Code .</p>
                        <div style="color:black;" id="" ej-grid e-datasource="MenPowerList" e-recorddoubleclick="selRoBudget"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="50"></div>
                                <div e-column e-field="PositionId" e-headertext="Position Id" e-width="80"></div>
                                <div e-column e-field="ROBudgetCode" e-headertext="RO Budget Code" e-width="120"></div>
                                <div e-column e-field="Active" e-headertext="Active" e-width="70"></div>
                                <div e-column e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeEmpPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>

<!--    POP UP SCREEN  FOR EMPLOYEE GOAL SETTING     -->
<div class="modal fade site-modal in" id="ROPop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify ">
        <div class="modal-content">
            <div class="modal-header">Employee Goal Setting Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        @*<p style="margin-top:20px">Please Select Performance Period .</p>*@
                        <div class="row">
                            <div class="col-lg-12 col-md-12 ">
                                <div id="ChildList" ej-grid e-datasource="EGList" e-templaterefresh="refreshTemplate"
                                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:20px;">
                                    <div e-columns>
                                        
                                        <div e-column e-headertext="Performance Year Id" e-template="#PerformanceYearId" e-type="string" e-width="50"></div>
                                        <div e-column e-headertext="Employee Id" e-template="#EmployeeId" e-width="80"></div>
                                        <div e-column e-headertext="Confirmation Status" e-template="#ConfirmationStatus" e-width="80"></div>
                                        <div e-column e-headertext="Is Approved" e-template="#IsApproved" e-width="80"></div>
                                    </div>
                                </div>
                                <script type="text/template" id="PerformanceYearId">
                                    <input type="text" ng-model="data.PerformanceYearId" style="color:black; text-align:center" />
                                </script>
                                <script type="text/template" id="EmployeeId">
                                    <input type="text" ng-model="data.EmployeeId" style="color:black; text-align:center" />
                                </script>
                                <script type="text/template" id="ConfirmationStatus">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="data.ConfirmationStatus" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </script>
                                <script type="text/template" id="IsApproved">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="data.isApproved" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </script>                      
                            </div>


                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeEmpPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>