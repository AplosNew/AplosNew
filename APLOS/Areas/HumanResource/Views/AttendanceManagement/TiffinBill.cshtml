<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Over Stay List</h3>
<div class=" form-elements form-horizontal" ng-form="modelForm">
    <div class="row">
        <div class="col-xs-12 col-sm-5 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">From date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="CustomPara.FromDate" datepicker class="form-control datepicker" tabindex="1">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-5 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="CustomPara.ToDate" datepicker class="form-control datepicker" tabindex="1">
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-5 col-md-6">
            <div class="row">
                <div class="col-xs-12 col-sm-5 col-md-10">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Select Shift <sup>*</sup></label>
                        <div class="col-sm-8  show-message">

                            <ul ng-repeat="x in ShiftName">
                                <li>{{x}}</li>
                            </ul>
                        </div>
                    </div>


                </div>
                <div class="col-xs-12 col-sm-5 col-md-2">
                    <div class="form-group">

                        <div class="col-sm-4 show-message">
                            <div class="common-btn">
                                <ul class="common-btn list-inline text-right">
                                    <li><button ng-click="getAllShiftinfo()" class="btn" tabindex="10"><i class="glyphicon glyphicon-search"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-5 col-md-6">
            <div class="form-group">

                <label class="col-sm-4 control-label">Duration <sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <div class="col-sm-4">
                        <input type="text" class="form-control" ng-model="CustomPara.Hr" />
                    </div>
                    <label class="col-sm-2 control-label">Hr<sup>*</sup></label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" ng-model="CustomPara.Min" />
                    </div>
                    <label class="col-sm-2 control-label">min<sup>*</sup></label>
                </div>
            </div>
        </div>
    </div>
    <div class="row">

        <div class="col-xs-12 col-sm-12 col-md-12">

            <div class="common-btn">
                <button ng-click="tiffinBillreport();" class="btn"> <i class="glyphicon glyphicon-download"></i> Download</button>
            </div>
        </div>





    </div>
</div>






<ej-dialog id="dialogShiftSelect" title=" Shift info" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target=".site-heading" e-minwidth="500" e-height="500" e-open="enableBtn">
    <div class="row">
        <div class="col-sm-12">
            <div id="GridShiftSelect" ng-init="chkinit()" ej-grid
                 e-datasource="shiftinfo"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-enabletouch="false"
                 e-responsive="true"
                 e-actioncomplete="actionCompleteSelected4"
                 e-templaterefresh="refreshTemplateemployee4"
                 e-allowselection="true"
                 e-pageSettings-pageSize="8"
                 e-height="300"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate4" e-template="#checkboxTemplate4" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="SystemID" e-headertext="Code" e-width="30" e-primarykey="true"></div>
                    <div e-column e-field="UserName" e-headertext="Shift Name" e-width="80"></div>
                    <div e-column e-field="ShiftType" e-headertext="Shift Type" e-width="80"></div>

                </div>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="checkboxTemplate4">
        <input type="checkbox" ng-model="{{:SystemID}}" class="rowCheckbox" value="{{:SystemID}}" />
    </script>
    <script type="text/x-jsrender" id="headerTemplate4">
        <input type="checkbox" id="headchk4" />
    </script>
    <br />
    <div class="common-btn pull-right">
        <button ng-click="selectedShif();" class="btn"> <i class="glyphicon glyphicon-send"></i> Select</button>
    </div>

</ej-dialog>



