<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Shift Report</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="col-xs-12 col-sm-5 col-md-5">

        @*<div class="form-group" show-errors id="div_Employee">
            <label class="col-sm-3 control-label">Employee<sup>*</sup></label>
            <div class="col-sm-7 show-message">
                <input type="text" class="form-control" ng-model="ShiftReport.EmployeeName" readonly>
            </div>
            <button class="single-btn tooltip-here" data-placement="top" title="Employee Change" ng-click="showEmployeeListPopUp();"><i class="fa fa-search"></i></button>
        </div>*@

        <div class="form-group">
            <label class="col-sm-3 control-label">Employee Select<sup>*</sup></label>
            <div class="col-sm-7">
                <div class="input-group">
                    <span class="input-group-addon">{{employeeInfo.EmployeeCode}}</span>
                    <input type="text" name="EmployeeName" ng-model="employeeInfo.EmployeeName" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" ng-click="GetEmployeeDeleteInfo()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors id="div_FromDate">
            <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-7 show-message">
                <input type="text" name="Form Date" ng-model="ShiftReport.FromDate" datepicker class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors id="div_ToDate">
            <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-7 show-message">
                <input type="text" name="To Date" ng-model="ShiftReport.ToDate" datepicker class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Format<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input type="radio" name="source" ng-model="ShiftReport.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                </label>
                <label>
                    <input type="radio" name="source" ng-model="ShiftReport.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                </label>
            </div>
        </div>
    </div>
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="report();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                </ul>
            </div>
</div>

@*@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")*@


<div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridEmp" ej-grid e-datasource="dataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SetData" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>



