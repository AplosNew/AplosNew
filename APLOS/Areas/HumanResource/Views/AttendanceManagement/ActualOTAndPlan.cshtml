@*<togglable name="Preallocated OT"></togglable>*@
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Actual OT And Plan</h3>
<div class="form-elements form-horizontal" ng-form name="modelNewForm">
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-sm-12">
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group">
                    <label class="col-sm-4 control-label">Work Date</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="modelNew.WorkDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="11" ng-change="popUp();">
                    </div>
                </div>

            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="GetActualOTReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                    </ul>
                </div>

            </div>

        </div>
    </div>
</div>


    <confirm-archive-generic data-modalid="confirmDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteDetail()"></confirm-archive-generic>

    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
        <div class="bounce3"></div>
    </div>
