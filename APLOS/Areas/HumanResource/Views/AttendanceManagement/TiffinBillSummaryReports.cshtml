@*<togglable name="Preallocated OT"></togglable>*@
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Tiffin Bill Summary Report</h3>
<div class="form-elements form-horizontal" ng-form name="modelNewForm">
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-sm-12">

            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Daily Allowance <sup></sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select id="Id" class="form-control" ng-model="modelNew.DailyAllowance" name="salaryProcessId" required tabindex="3">
                                    <option value="All">--All--</option>
                                    <option ng-repeat="option in dailyAllowanceList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            @*<input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="FromDate" e-width="100%" />*@
                            <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="modelNew.FromDate" datepicker class="form-control datepicker" tabindex="1">
                        </div>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            @*<input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="FromDate" e-width="100%" />*@
                            <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-model="modelNew.ToDate" datepicker class="form-control datepicker" tabindex="1">
                        </div>
                    </div>
                </div>

            </div>

        </div>
        <div class="col-sm-12">
            
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="GetTiffinBillReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>
    <confirm-archive-generic data-modalid="confirmDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteDetail()"></confirm-archive-generic>
