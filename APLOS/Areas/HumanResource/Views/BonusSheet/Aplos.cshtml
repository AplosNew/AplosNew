<div class="form-elements form-horizontal row" ng-form="modelForm">


    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <div class="form-group">
                <label class="col-sm-3 control-label">Payroll Group<sup>*</sup></label>
                <div class="col-sm-7">
                    <div class="select-style">
                        <select class="form-control" ng-model="PeraModel.PayRollGroupId"  required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in payGroupList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="form-group">
                <label class="col-sm-3 control-label">Bonus Point<sup>*</sup></label>
                <div class="col-sm-7">
                    <div class="select-style">
                        <select class="form-control" ng-model="PeraModel.BonusPointId" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in BonusPoint" value="{{option.Id}}">{{option.Name}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">

                @*<li> <button ng-click="BonusSheet();" class="btn" tabindex="5"> <i class="glyphicon glyphicon-download"></i> Download</button></li>*@
                <li><a class="btn btn-action" href="humanresource/BonusSheet/GetBonusData?PayRollGroupId={{PeraModel.PayRollGroupId}}&BonusPointId={{PeraModel.BonusPointId}}" target="_blank"><i class="glyphicon glyphicon-download"> Download</i></a></li>
            </ul>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
    </div>

    </div>
