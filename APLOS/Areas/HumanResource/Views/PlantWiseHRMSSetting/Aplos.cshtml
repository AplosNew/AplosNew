        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="5"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                @*<li> <button ng-click="Clear();" class="btn" tabindex="5"><i class="glyphicon glyphicon-floppy-disk"></i> Clear</button></li>*@
            </ul>
        </div>
    </div>

    <div class="table-responsive modal-table aplos-grid-toggle">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Plant Name</th>
                    <th>Plant Prefix For Employee</th>
                    <th>Date Of Confirmation On</th>
                    <th>OT Entry Consider On</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in MasterList" ng-dblclick="get(x);">
                    <td>{{x.PlantName}}</td>
                    <td>{{x.PlantPrefix}}</td>
                    <td>{{x.DOCBaseON}}</td>
                    <td>{{x.OTConsiderOn}}</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

