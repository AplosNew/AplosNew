                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="col-sm-10 control-label">No Punch On Weekoff</label>
                        <div class="col-sm-2" style="margin-left: -180px;padding-top: 8px;">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" name="NoPunchOnWeekoff" ng-model="PlantWiseHRMSSetting.NoPunchOnWeekoff" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="form-group">
                        <div class="col-md-9" style="padding-left: 0px; padding-right: 0px;">
