                                <label>
                                    <input type="checkbox" name="NoPunchOnHoliday" ng-model="PlantWiseHRMSSetting.NoPunchOnHoliday" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
