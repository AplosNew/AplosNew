                </div>
                <div class="col-md-12 ">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Resignation Alert Before</label>
                        <div class="col-sm-6" style=" padding-left: 96px;padding-right: 9px;">
                            <input type="text" ng-model="PlantWiseHRMSSetting.ResignationAlertBeforeDays" only-numbers class="form-control" maxlength="100" tabindex="2">
