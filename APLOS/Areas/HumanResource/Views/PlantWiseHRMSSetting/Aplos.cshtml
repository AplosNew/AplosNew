                                    <label>
                                        <input type="checkbox" name="IsSandwichAbsentInHoliday" ng-model="PlantWiseHRMSSetting.IsSandwichAbsentInHoliday" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
