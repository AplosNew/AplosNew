                        <div class="col-sm-2" style="margin-left: -163px; padding-top: 8px;">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" name="NoPunchOnHoliday" ng-model="PlantWiseHRMSSetting.NoPunchOnLeave" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="form-group">
