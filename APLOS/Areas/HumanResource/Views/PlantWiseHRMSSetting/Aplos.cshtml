                            <div class="col-sm-2" style="padding-top: 8px;margin-left: -15px;">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" name="IsLongAbsenteeismAuto" ng-model="PlantWiseHRMSSetting.IsLongAbsenteeismAuto" tabindex="8">
