                            <label class="col-sm-7 control-label">Is Auto</label>
                            <div class="col-sm-5" style="padding-top: 8px;">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" name="IsTBSAuto" ng-model="PlantWiseHRMSSetting.IsTBSAuto" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
