                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" name="IsRemoteAttendanceApprovalRequired" ng-model="PlantWiseHRMSSetting.IsRemoteAttendanceApprovalRequired" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="col-md-5 control-label">Sandwich Absenteeism Applicable on</label>
                        <div class="col-md-4">
                            <div class="col-sm-7" style="margin-left: 8px;padding-top: 8px;">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" name="IsSandwichAbsentInWeekend" ng-model="PlantWiseHRMSSetting.IsSandwichAbsentInWeekend" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                            <label class="col-sm-5 control-label" style="margin-left: -45px;">weekend</label>
                        </div>
                        <div class="col-md-3">
                            <div class="col-sm-7" style="margin-left: -50px; padding-top: 9px;">
