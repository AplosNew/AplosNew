<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">

       
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Performance Year<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="PerformanceYear" ng-model="ModelNew.PerformanceYearName" class="form-control" required maxlength="10">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="50"></textarea>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="col-lg-8 col-md-8 col-sm-12">
            <div class="form-group">
                <label class="col-sm-4 control-label">Start Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input id="datepicker" e-dateformat="dd-MMM-yyyy" ej-datepicker ng-model="ModelNew.StartDate" required e-width="100%" />
                </div>
            </div>
        </div>
        <div class="col-lg-8 col-md-8 col-sm-12">
            <div class="form-group">
                <label class="col-sm-4 control-label">End Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker ng-model="ModelNew.EndDate" required e-width="100%" />
                </div>
            </div>
        </div>



    </div>


    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}} </button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>    
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false"></div>
            <div e-column e-field="PerformanceYearName" e-headertext="Performance Year" e-width="3"></div>
            <div e-column e-field="StartDate" e-headertext="Start Date" e-width="3"></div>
            <div e-column e-field="EndDate" e-headertext="End Date" e-width="3"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="3"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="3"></div>


        </div>
    </div>
</div>
<confirm-modal></confirm-modal>

<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>


