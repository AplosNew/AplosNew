<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Manpower Budget and Designation Report </h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">
        <div class="form-elements form-horizontal" ng-form="modelForm">

            <div class="col-md-12 col-sm-6 col-md-6">
                @*<div class="form-group">
                        <label class="col-sm-4 control-label">Company<sup></sup></label>
                        <div class="col-sm-8">
                            <input id="ddlCompanyList" ej-dropdownlist e-datasource="companyList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-change ="getPlant" />
                        </div>
                    </div>*@
                <div class="form-group">
                    <label class="col-sm-4 control-label">Plant<sup></sup></label>
                    <div class="col-sm-8">
                        <input id="ddlPlantList" ej-dropdownlist e-multiselectmode="visualmode" e-datasource="cboPlantList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true" />
                    </div>
                </div>

            </div>
        </div>

    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="tab-design" id="tab_show">
                <div class="tab-design" id="tab_show">
                    <div class="site-tab">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="assign" role="tab" data-toggle="tab">Report 1</a></li>
                            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="assign" role="tab" data-toggle="tab">Report 2</a></li>
                        </ul>
                    </div>
                </div>
                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                        <div class="col-md-12 table-responsive modal-table">

                            <div class="form-group">
                                <div class="col-xs-6" style="margin:1px;">
                                    <div class="common-btn">
                                        <button ng-click="GetManpowerBudgtDesignationReport();" class="btn"> <i class="glyphicon glyphicon-download"></i> Download</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                        <div class="col-md-12 table-responsive modal-table">
                            <div class="col-xs-6" style="margin:1px;">
                                <div class="form-group" show-errors id="div_ToDate">
                                    <label class="col-sm-3 control-label">Date<sup>*</sup></label>
                                    <div class="col-sm-9 show-message">
                                        <input type="text" name="To Date" ng-model="report.ToDate" datepicker class="form-control" required tabindex="1">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-xs-6" style="margin:1px;">
                                        <div class="common-btn text-right">
                                            <button ng-click="GetBudgetedDesignationDetail();" class="btn"> <i class="glyphicon glyphicon-download"></i> Download</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>
<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>


