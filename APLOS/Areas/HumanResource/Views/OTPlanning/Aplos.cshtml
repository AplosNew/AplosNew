<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> OT Planning</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">
        <div class="col-md-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" name="Form Date" ng-model="MasterModel.Date" datepicker class="form-control" ng-change="getData()">
                </div>
            </div>
        </div>
        <div class="col-md-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Shift</label>

                <div class="col-sm-8">
                    <div class="select-style">
                        <select id="shiftList" class="form-control" ng-model="MasterModel.ShiftId" tabindex="3"  ng-change="getData()">
                            <option value=""> </option>
                            <option ng-repeat="option in ShiftList" value="{{option.SystemID}}">{{option.ShiftType}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div id="GridAttendance" ej-grid e-datasource="EmpDataList" e-templaterefresh="refreshTemplateemployee"
             e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="120"></div>
                <div e-column e-field="ManpowerBudgetCode" e-headertext="Budget Code" e-width="80"></div>
                <div e-column e-field="Entity" e-headertext="Entity" e-width="120"></div>

                <div e-column e-field="Department" e-headertext="Depertment" e-width="120"></div>
                <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                <div e-column e-field="SubSection" e-headertext="Sub-Section" e-width="80"></div>

                <div e-column e-field="NoOfEmp" e-headertext="No Of Employee" e-width="80"></div>

                <div e-column e-template="#reson" e-headertext="Allotted Man" e-width="80"></div>

                <div e-column e-template="#Hours" e-headertext="Allotted Hours" e-width="80"></div>

                @*<div e-column e-field="Allotted" e-headertext="Allotted Emp" e-width="80"></div>*@
                @*<div e-column e-field="Allotted" e-headertext="Allotted Hours" e-width="80"></div>*@
            </div>
        </div>
    </div>
    <script type="text/template" id="checkboxTemplate">
        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
    </script>
    <script type="text/x-jsrender" id="headerTemplate">
        <input type="checkbox" id="headchk" />
    </script>
    <script type="text/template" id="reson">
        <input type="text" name="Reason" ng-model="data.AllotedMan" onkeypress="return (event.charCode == 8 || event.charCode == 0) ? null : event.charCode >= 48 && event.charCode <= 57" class="form-control" required tabindex="5" maxlength="50">
    </script>
    <script type="text/template" id="Hours">
        <input type="text" name="Reason" ng-model="data.AllotedHour" onkeypress="return (event.charCode == 8 || event.charCode == 0) ? null : event.charCode >= 48 && event.charCode <= 57" class="form-control" required tabindex="5" maxlength="50">
    </script>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save()" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
        </ul>
    </div>
</div>


