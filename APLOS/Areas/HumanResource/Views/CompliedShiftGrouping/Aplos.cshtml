<togglable name="Complied Shift Grouping"></togglable>

<div class="row form-elements form-horizontal" ng-form name="compliedShiftGroupingNewForm">
    <input type="hidden" ng-model="compliedShiftGroupingNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="compliedShiftGroupingNew.Code" class="form-control" required tabindex="1" maxlength="10">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Description<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea class="form-control" name="Description" rows="3" ng-model="compliedShiftGroupingNew.Description" required tabindex="2" maxlength="50"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <ul class="common-btn list-inline text-left">
            <li>
                <button ng-click="ShowshiftDefinationList();" class="btn" tabindex="3"><i class="glyphicon glyphicon-plus-sign"></i> Add Shift</button>
            </li>
        </ul>
    </div>
    <div class="col-xs-12">
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
					<tr>
						<th>Shift Name</th>
						<th>InTime</th>
						<th>OutTime</th>
						<th>Shift Type</th>
						<th>Description</th>
						<th>Remove</th>
					</tr>
                </thead>
                <tbody>
					<tr ng-repeat="x in shiftgroupDetailList">
						<td>{{x.UserName}}</td>
						<td>{{x.InTime}}</td>
						<td>{{x.OutTime}}</td>
						<td>{{x.ShiftType}}</td>
						<td>{{x.ShiftDefinationDescription}}</td>
						<td class="text-right table-td">
							<ul class="list-inline action-list">
								<li>
									<button ng-click="removeRowModal(x.ShiftDefinationName, $index,'shiftgroupDetailList', 'Id', 'ActualShiftId');" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
										<i class="glyphicon glyphicon-remove"></i>
									</button>
								</li>
							</ul>
						</td>
					</tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-sm-12">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="4"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="5"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div> 
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in shiftgrouplist |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">

                <td>{{x.Code}}</td>
                <td>{{x.Description}}</td>

            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<div class="modal fade site-modal in" id="shiftdefinationPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i>Shift Defination</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="shiftDefinationListParameters.searchBy">
                                            <option ng-repeat="option in searchByDefinationList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="shiftDefinationListParameters.search" ng-enter="getShift()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getShift()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
							<tr>
								<th>Select</th>
								<th>Shift Name</th>
								<th>InTime</th>
								<th>OutTime</th>
								<th>Shift Type</th>
								<th>Description</th>
							</tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in shiftDefinationlist | itemsPerPage:shiftDefinationListParameters.pageSize" total-items="shiftDefinationListParameters.total_count" pagination-id="metaData.name + 'shiftDefinationlist'">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="{{x.Id}}" ng-model="x.Flag" ng-checked="x.Flag" ng-click="genericPushInTempList(x,$event, shiftgroupDetailList,'SystemID', 'ActualShiftId');">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
								<td>{{x.UserName}}</td>
								<td>{{x.InTime}}</td>
								<td>{{x.OutTime}}</td>
                                <td>{{x.ShiftType}}</td>
								<td>{{x.ShiftDefinationDescription}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                            pagination-id="metaData.name + 'shiftDefinationlist'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getShift(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SelectdShiftDefinationCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
