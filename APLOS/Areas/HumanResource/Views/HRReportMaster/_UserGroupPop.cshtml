                <div id="issuegrid" class="table-responsive" style="border:1px solid white">
                    <div ej-grid e-datasource="UserGroupList" e-load="loadGridEdit"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                            <div e-column e-headertext="Active / Inactive" e-template="#checkboxIssueTemplate" e-textalign="center" e-width="100"></div>

                            <div e-column e-field="UserGroup" e-headertext="User Group" e-width="100"></div>
                            <div e-column e-field="UserSubGroup" e-headertext="User Sub Group" e-width="100"></div>
                            <div e-column e-headertext="Grade" e-template="#checkboxGradeTemplate" e-textalign="center" e-width="100"></div>

                        </div>
                    </div>
                    <script type="text/template" id="checkboxIssueTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
                    </script>

                    <script type="text/template" id="checkboxGradeTemplate">
                        <div class="select-style">
                            <select class="form-control" name="User Group" ng-model="data.Grade" required>
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                            </select>
                        </div>
                    </script>


                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="ClosePopupOnSelectAllField();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Select Groups </button></li>

                        </ul>
                    </div>
                </div>

            </div>
                    
