<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSetHeader(1) }"><a ng-click="setTabHeader(1)" href="" aria-controls="general" role="tab" data-toggle="tab">HR Report Master</a></li>
            <li role="presentation" ng-class="{ active: isSetHeader(2) }"><a ng-click="setTabHeader(2)" href="" aria-controls="general" role="tab" data-toggle="tab">User Group / User Sub Group</a></li>

        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetHeader(1), active: isSetHeader(1) }">
