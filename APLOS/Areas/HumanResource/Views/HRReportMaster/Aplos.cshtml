
<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSetHeader(1) }"><a ng-click="setTabHeader(1)" href="" aria-controls="general" role="tab" data-toggle="tab">HR Report Master</a></li>
            <li role="presentation" ng-class="{ active: isSetHeader(2) }"><a ng-click="setTabHeader(2)" href="" aria-controls="general" role="tab" data-toggle="tab">User Group / User Sub Group / Grade</a></li>
            
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetHeader(1), active: isSetHeader(1) }">
            <togglable></togglable>
            <div class="form-elements form-horizontal" ng-form name="ModelNewForm">
                <input type="hidden" ng-model="ModelNew.Id">
                <div class="row" style="background: #F2F0EC;">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100" required />
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10" e-width="100">
                            </div>
                        </div>


                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                            </div>
                        </div>

                        
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>
                <div class="row">
                    <div class="tab-design">
                        <div class="site-tab">
                            <ul class="nav nav-tabs" role="tablist">
                                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Budget Code</a></li>
                                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Employee Person</a></li>

                            </ul>
                        </div>
                        <div class="tab-content">
                            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                                <div class="row" ng-form>

                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Entity</label>
                                            <div class="col-sm-6">
                                                <div class="select-style">
                                                    <input id="entityId" e-change="GetBudget" e-watermarktext="Type" ej-dropdownlist e-enablefiltersearch="true" e-create="create" e-multiselectmode="visualmode" e-datasource="EntityList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <div id="bgtCodeGridId" ej-grid e-datasource="BudgetList" e-load="loadGridEdit"
                                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                                        <div e-columns>
                                            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                            <div e-column e-headertext="Active / Inactive" e-template="#checkboxUnallocationTemplate" e-textalign="center" e-width="60"></div>

                                            <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>
                                            <div e-column e-field="Division" e-headertext="Division" e-width="100"></div>
                                            <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                                            <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>

                                            <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>
                                            <div e-column e-field="Designation" e-headertext="Designation" e-width="150"></div>

                                            @*<div e-column e-field="Activity" e-headertext="Activity" e-width="50"></div>*@
                                            <div e-column e-field="Shift" e-headertext="Shift" e-width="150"></div>
                                            <div e-column e-field="PositionCode" e-headertext="PositionCode" e-width="100"></div>
                                            @*<div e-column e-field="Position" e-headertext="Position" e-width="100"></div>*@
                                            <div e-column e-field="BudgetCode" e-headertext="BudgetCode" e-width="100"></div>
                                            @*<div e-column e-headertext="User Group" e-template="#userGroupId" e-textalign="center" e-width="100"></div>
                                                <div e-column e-headertext="User Sub Group" e-template="#userSubGroupId" e-textalign="center" e-width="100"></div>
                                                <div e-column e-headertext="Grade" e-template="#GradeId" e-textalign="center" e-width="100"></div>*@
                                            <div e-column e-headertext="User Group" e-template="#userGroupId" e-textalign="center" e-width="100"></div>
                                        </div>
                                    </div>
                                    <script type="text/template" id="checkboxUnallocationTemplate">
                                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" ng-model="data.Active" />
                                    </script>

                                    <script type="text/template" id="userGroupId">
                                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 25px; padding-top:1px; padding-bottom:1px; border-radius:0" class="btn"><i class="glyphicon glyphicon-menu-hamburger" title="Print Report" style="margin: -6px;" ng-click="$parent.OpenUserGroupPopUp(this)"></i></button>

                                    </script>


                                </div>
                                @Html.Partial("~/Areas/HumanResource/Views/HRReportMaster/_UserGroupPop.cshtml")

                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li> <button ng-click="SaveBudgetCode();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActionB}}</button></li>
                                       
                                    </ul>

                                </div>
                            </div>
                            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                                <div ng-form>
                                    <div class="form-group">


                                        <div class="col-sm-8" style="display:flex">
                                            <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                                            @*<input type="text" name="" ng-model="Employee" class="form-control" maxlength="200" tabindex="5" ng-disabled="true  ">*@
                                            <button ng-click="selectEmployee()" class="btn" style="background:#3E445A; color:#FFF;border-radius:0"><i class="glyphicon glyphicon-search"></i></button>
                                        </div>

                                    </div>
                                    @Html.Partial("~/Areas/HumanResource/Views/HRReportMaster/_ResponsiblePerson.cshtml")
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
            <div class="table-responsive aplos-grid-toggle">
                <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                        <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
                        <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>

                        <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
                        <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>

                        <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
                    </div>
                </div>
            </div>
        </div>

        @*   TAB -2  *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetHeader(2), active: isSetHeader(2) }">
            <togglable></togglable>
            <div class="form-elements form-horizontal" ng-form name="ModelNewBForm">
                <input type="hidden" ng-model="ModelNewB.Id">
                <div class="row" style="background: #F2F0EC;">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">UserGroup<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="UserGroup" ng-model="ModelNewB.UserGroup" class="form-control" required tabindex="4" maxlength="50">
                            </div>
                        </div>
                        
                    </div>

                    <div class="col-xs-12 col-sm-6 col-md-6">


                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Sub Group<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Sub Group" ng-model="ModelNewB.UserSubGroup" class="form-control" required tabindex="4" maxlength="50">
                            </div>
                        </div>


                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveB();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActionT2}}</button></li>
                            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            <li> <button ng-click="ClearB();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-3"></div>
                <div class="col-md-6">
                    <div class="table-responsive aplos-grid-toggle">
                        <div id="GridEditB" ej-grid e-datasource="ModelListB" e-recorddoubleclick="GetB" e-load="loadGridEdit"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>

                                <div e-column e-field="UserGroup" e-headertext="UserGroup" e-width="100"></div>

                                <div e-column e-field="UserSubGroup" e-headertext="User Sub Group" e-width="100"></div>
                                <div e-column e-field="Grade" e-headertext="Grade" e-width="100"></div>

                            </div>
                        </div>
                    </div>
                    <div class="col-md-3"></div>
                </div>
            </div>

        </div>

        
    </div>

</div>





<!--POP UP SCREEN  FOR EMPLOYEE DETAIL  (EmployeeInformation)   -->


<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 46) {
            return false;
        }
        return true;
    }
</script>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Productions/Views/Parameter/_Entity.cshtml")

