<div class="modal fade site-modal in" id="EmployeePop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Employee Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">

                <div class="content-container-fluid" style="color:black;overflow:scroll">
                    <div class="form-elements form-horizontal">
                        <p>Please Select Employee Detail .</p>
                        <div class="row">

                            <div style="color:black;" id="GridEmployee" ej-grid e-datasource="EmployeeList" e-recorddoubleclick="selectEmpDetail"
                                 e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                                <div e-columns>
                                    <div e-column e-headertext="Check / Uncheck" e-template="#checkboxRPTemplate" e-textalign="center" e-width="100"></div>

                                    <div e-column e-field="SystemId" e-headertext="System Id" e-width="100"></div>

                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="100"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="100"></div>
                                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>

                                    <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>
                                </div>
                            </div>
                            <script type="text/template" id="checkboxRPTemplate">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" ng-model="data.Active" />
                            </script>

                            <script type="text/template" id="userRPId">
                                <button style="color: #f3f3ec;background-color: #1c1f32;height: 25px; padding-top:1px; padding-bottom:1px; border-radius:0" class="btn"><i class="glyphicon glyphicon-menu-hamburger" title="Print Report" style="margin: -6px;" ng-click="$parent.OpenUserGroupPopUp(this)"></i></button>

                            </script>

                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="Save_One_or_MultipleResPers();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActionC}}</button></li>
                                    @*<li> <button ng-click="UpdateSavedBudgetCode();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>*@

                                </ul>

                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

