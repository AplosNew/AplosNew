<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  Bulk Leave Application
</h3>
<div class="form-horizontal form-elements" id="mainContainer">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Apply</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="aria2" role="tab" data-toggle="tab" >Approval</a></li>

            </ul>
        </div>
        <div class="tab-content" id="tabpaneldiv">
            <br />
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="form-elements form-horizontal" ng-form id="OTSlapFormId" name="OTSlapForm">

                    <div id="TabDateRange">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <input e-dateformat="dd-MMM-yyyy" e-change="selectSigleDate" ej-datepicker e-value="FromDateSingleDate" e-width="100%" />
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="col-sm-12">
                                <div id="GridChangeAttendanceBySingleDate" ng-init="chkinit()" ej-grid e-datasource="employeeAttendanceBySingleDate"
                                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" @*e-showstackedheader="true"*@
                                     e-allowscrolling="true" e-minheight="400" e-gridlines="both" @*e-querycellinfo="queryCellInfo"*@
                                     e-actioncomplete="actionCompleteSingleDay" e-allowtextwrap="true" e-height="400px" e-rowdatabound="rowDataBoundSingleEmployee"
                                     e-filtersettings-filterType="excel">

                                    <div e-columns>
                                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="100" e-primarykey="true"></div>
                                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="150"></div>
                                        <div e-column e-template="#LeaveType" e-headertext="Leave Type" e-width="180"></div>

                                        <div e-column e-field="DayStatus" e-headertext="Day Status" e-width="50"></div>
                                        <div e-column e-field="IsManualDayStatus" e-headertext="Manual" e-width="40"></div>
                                        <div e-column e-template="#showAttendance" e-headertext="Balance" e-width="50"></div>

                                        <div e-column e-field="Department" e-headertext="Department" e-width="150"></div>
                                        <div e-column e-field="Designation" e-headertext="Designation" e-width="150"></div>
                                        <div e-column e-field="Section" e-headertext="Section" e-width="150"></div>
                                        <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="150"></div>
                                        <div e-column e-field="ErrorMessage" e-headertext="Error Message" e-width="150"></div>

                                    </div>
                                </div>

                            </div>

                            <div class="col-sm-12">
                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li>  <button type="button" ng-click="SaveSingleDay()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                                    </ul>
                                </div>


                            </div>
                            <script type="text/template" id="showAttendance">
                                <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                    <button ng-click="$parent.getLeaveBalance(this)" class="btn" style="height: 30px;width: 30px; padding: 0px; margin: 0px;">
                                        <i class="glyphicon glyphicon-list-alt"></i>
                                    </button>
                                </div>
                            </script>



                            <script type="text/template" id="LeaveType">

                                <div class="col-sm-12" style="padding:0px;">
                                    <input ej-dropdownlist e-datasource="data.LeaveTypeDataArray" e-value="data.LTSystemID" e-fields-value="LeaveTypeId" e-fields-text="LeaveType" e-width="100%" />
                                </div>

                            </script>

                        </div>

                    </div>

                </div>
                <div class="row">
                    <ej-dialog id="ViewLeaveInfo" title=" Leave Info" e-enablemodal="true" e-position-y="0" e-showoninit="false"
                               e-target="#TabDateRange" e-width="800px" e-height="350px" e-open="enableBtn">
                        <div class="form-elements">
                            <div id="GridAttendance" ng-init="chkinit()" ej-grid e-datasource="LeaveBalanceList"
                                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-field="LeaveName" e-headertext="Leave Name" e-width="200"></div>
                                    <div e-column e-field="CurrentAllocation" e-headertext="Curr. Alloc." e-width="80" e-headertextalign="true" e-textalign="right"></div>
                                    <div e-column e-field="BroughtForward" e-headertext="Brought Forward" e-width="80" e-headertextalign="true" e-textalign="right"></div>
                                    <div e-column e-field="LeaveDays" e-headertext="Leave Days" e-width="80" e-headertextalign="true" e-textalign="right"></div>
                                    <div e-column e-field="Applied" e-headertext="Applied" e-width="80" e-headertextalign="true" e-textalign="right"></div>
                                    <div e-column e-field="Availed" e-headertext="Availed" e-width="80" e-headertextalign="true" e-textalign="right"></div>
                                    <div e-column e-field="Balance" e-headertext="Balance" e-width="80" e-headertextalign="true" e-textalign="right"></div>
                                </div>
                            </div>
                        </div>
                    </ej-dialog>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" id="hhhh" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="form-elements form-horizontal" ng-form id="OTSlapFormId" name="OTSlapForm">
                    <div class="row">
                        <div style="color:black;" id="Grid" ej-grid e-datasource="AvailedLvDetails" e-templaterefresh="refreshTemplateemployee"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-recorddoubleclick="SelectLvDetails" e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                                @*<div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>*@
                                <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Name" e-width="80"></div>
                                <div e-column e-field="GivenDesignation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-field="Entity" e-headertext="Entity" e-width="80"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>
                                <div e-column e-field="LeaveName" e-headertext="Leave" e-width="80"></div>
                                <div e-column e-field="FromDate" e-headertext="From Date" e-width="80"></div>
                                <div e-column e-field="ToDate" e-headertext="To Date" e-width="80"></div>
                                <div e-column e-field="FirstApprovingStatus" e-headertext="First Approving Status" e-width="80"></div>
                                <div e-column e-field="FAEmployeeName" e-headertext="First Authority" e-width="80"></div>
                                <div e-column e-headertext="Actions" e-width="60">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 32px;" class="btn" ng-click="$parent.SelectLvDetails($event);"> Details</button>
                                </div>

                            </div>
                        </div>

                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="SavelvApproval();" class="btn"><i class="glyphicon glyphicon-saved" tabindex="9"></i> Approve</button></li>
                                <li><button ng-click="GetdialogCancelationReason();" class="btn"><i class="glyphicon glyphicon-remove" tabindex="9"></i> Reject</button></li>

                            </ul>
                        </div>


                        <ej-dialog id="dialogLvDetails"
                                   title=" Leave Approval"
                                   e-enablemodal="true"
                                   e-position-y="0"
                                   e-showoninit="false"
                                   e-target="#hhhh"
                                   e-close="onDialogClose"
                                   e-minwidth="95%"
                                   e-minheight="300" e-open="enableBtn">
                            <div class="row">

                                <div class="col-xs-12 col-sm-12 col-md-12">
                                    <div class="table-responsive modal-table">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th>Leave Name</th>
                                                    <th>Brought Forward</th>
                                                    <th>Current Year Allocation</th>
                                                    <th>Leave Days Allowed</th>
                                                    <th>Applied</th>
                                                    <th>Availed</th>
                                                    <th>Encashed</th>
                                                    <th>Balance</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat="x in LeaveBalanceList">
                                                    <td>{{x.LeaveName}}</td>
                                                    <td>{{x.BroughtForward}}</td>
                                                    <td>{{x.CurrentAllocation}}</td>
                                                    <td>{{x.LeaveDays}}</td>
                                                    <td>{{x.Applied}}</td>
                                                    <td>{{x.Availed}}</td>
                                                    <td>{{x.EncashedInbetween}}</td>
                                                    <td>{{x.Balance}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    @*<label ng-model="leaveApplicationNew.ExceptionLeave">You are taking  exception  leave  </label>*@
                                </div>
                            </div>

                        </ej-dialog>


                        <ej-dialog id="dialogCancelationReason"
                                   title=" Cancelation Reason"
                                   e-enablemodal="true"
                                   e-position-y="0"
                                   e-showoninit="false"
                                   e-target="#hhhh"
                                   e-close="onDialogClose"
                                   e-minwidth="60%"
                                   e-minheight="200" e-open="enableBtn">
                            <div class="row">
                                <div class="col-xs-12 col-sm-12 col-md-12">
                                    <div class="form-group">
                                        <div class="col-sm-12">
                                            <textarea maxlength="250" name="Description" placeholder="Write here....." class="form-control" rows="3" ng-model="CancelationReason" tabindex="7"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-12 col-md-12">
                                    <br />
                                    <div class="common-btn">
                                        <ul class="list-inline text-right">

                                            <li><button ng-click="Reject();" class="btn"><i class="glyphicon glyphicon-remove" tabindex="9"></i> Reject</button></li>
                                            <li><button ng-click="Cancel();" class="btn"><i class="glyphicon glyphicon-saved" tabindex="9"></i> Cancel</button></li>

                                        </ul>
                                    </div>

                                </div>
                            </div>

                        </ej-dialog>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

