<togglable name="Complied Shift"></togglable>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <input type="hidden" ng-model="modelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="modelNew.Code" class="form-control" maxlength="10" tabindex="1" required>
            </div>
        </div>
        <div class="form-group" show-errors id="div_inTime">
            <label class="col-sm-4 control-label">InTime<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" class="form-control" style="height: 25px;" ng-model="modelNew.InTime" title="Maximum input 23:59" placeholder="00:00 to 23:59" />
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">IsNight</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="modelNew.IsNight">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Shift Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Shift Name" ng-model="modelNew.ShiftName" class="form-control" maxlength="30" tabindex="2" required>
            </div>
        </div>
        <div class="form-group" show-errors id="div_outTime">
            <label class="col-sm-4 control-label">OutTime<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" class="form-control" style="height: 25px;" ng-model="modelNew.OutTime" title="Maximum input 23:59" placeholder="00:00 to 23:59" />
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="5"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="6"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="7"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
	<div class="row text-right">
		<div class="col-xs-12 col-sm-12 col-sm-12">
			<div class="search-form">
				<div class="row">
					<div class="col-xs-12 col-sm-3 col-md-3">
						<div class="select-style">
							<select ng-model="$root.parameters.searchBy">
								<option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
							</select>
						</div>
					</div>
					<div class="col-xs-12 col-sm-7 col-md-7">
						<input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData();">
					</div>
					<div class="col-xs-12 col-sm-2 col-md-2">
						<button type="button" ng-click="getData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="table-responsive modal-table">
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Code</th>
					<th>Shift Name</th>
					<th>InTime</th>
					<th>OutTime</th>
					<th>IsNight</th>
				</tr>
			</thead>
			<tbody>
                <tr dir-paginate="x in modelList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get($index);">

                    <td>{{x.Code}}</td>
                    <td>{{x.ShiftName}}</td>
                    <td>{{x.InTime}}</td>
                    <td>{{x.OutTime}}</td>
                    <td>{{x.IsNight?'Yes':'No'}}</td>
                </tr>
			</tbody>
		</table>
		<dir-pagination-controls max-size="10"
								 direction-links="true"
								 boundary-links="true"
								 on-page-change="getData(newPageNumber)">
		</dir-pagination-controls>
	</div>
</div>
<confirm-modal></confirm-modal>