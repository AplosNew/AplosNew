<div id="Test">
    <h3 class="site-heading"><span class="glyphicon glyphicon-file"></span> {{FormTitle}}</h3>
    <style type="text/css">
        #myDIV {
            width: 100%;
            text-align: center;
        }

        .e-gridheader .e-headercell { /* grid header color and grid row select color*/
            background: #a2f1ff;
            color: #080076;
            min-height: 100%;
            border-bottom-color: #8B4513;
        }

        .modal-table {
            position: relative;
            height: 300px;
            overflow: auto;
        }

        .modal {
            overflow-y: auto;
        }

        .table-responsive {
            display: block;
        }

        td, th {
            padding: 10px;
        }
    </style>

    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Employee Attendacne Data</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Employee Attendacne Summary</a></li>
            </ul>
        </div>
        <div class="clearfix"></div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <fieldset class="scheduler-border">
                    <div class="form-elements form-horizontal" ng-form="from0">
                        <div class="row">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                                    <div class="col-sm-7 show-message">
                                        <input type="text" name="From Date" ng-model="EmpSingModelNew.FromDate" datepicker class="form-control" required tabindex="3">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Employee<sup>*</sup></label>
                                    <div class="col-sm-2">
                                        <input type="text" style="width:100px;" ng-change="SearchEmployee()" ng-model="EmpSingModelNew.EmployeeCode" placeholder="Employee Code" class="form-control" maxlength="100">
                                    </div>
                                    <div class="col-sm-5 text-left">
                                        <div class="input-group">


                                            <input type="text" name="EmployeeName" ng-model="EmpSingModelNew.EmployeeName" class="form-control" required readonly>
                                            <span class="input-group-btn">
                                                <button name="submit" ng-click="getPopUpData()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                            </span>

                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                                    <div class="col-sm-7 show-message">
                                        <input type="text" name="To Date" ng-model="EmpSingModelNew.ToDate" datepicker class="form-control" required tabindex="4">
                                    </div>
                                </div>

                            </div>
                            <div class="common-btn" style="margin-top:25px;margin-right:20px;">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="GetEmpSingleData();" class="btn"><i class="glyphicon glyphicon-download"></i> Go </button></li>
                                    <li> <button ng-click="EmployeeAttendanceSingleSummaryData();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Report </button></li>
                                </ul>
                            </div>
                            <div id="EmpGrid" ej-grid e-datasource="EmployeeDataList"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
                                <div e-columns>
                                    @*<div e-column e-field="EmpSystemID" e-type="string" e-headertext="EmpSystemID" e-width="80"></div>*@
                                    <div e-column e-field="EmployeeCode" e-type="string" e-headertext="EmployeeCode" e-width="80"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="120"></div>
                                    <div e-column e-field="DOJ" e-type="string" e-headertext="DOJ" e-width="70"></div>
                                    <div e-column e-field="DOS" e-type="string" e-headertext="DOS" e-width="70"></div>
                                    <div e-column e-field="GivenDesignation" e-type="string" e-headertext="Given Designation" e-width="80"></div>
                                    <div e-column e-field="SubSection" e-type="string" e-headertext="Sub Section" e-width="80"></div>
                                    <div e-column e-field="Section" e-type="string" e-headertext="Section" e-width="80"></div>
                                    <div e-column e-field="Department" e-type="string" e-headertext="Department" e-width="120"></div>
                                    <div e-column e-field="Date" e-type="string" e-headertext="Date" e-width="80"></div>
                                    <div e-column e-field="ProcessIntime" e-type="string" e-headertext="Process Intime" e-width="100"></div>
                                    <div e-column e-field="ProcessOuttime" e-type="string" e-headertext="Process Outtime" e-width="100"></div>
                                    <div e-column e-field="Duration" e-type="string" e-headertext="Duration" e-width="80"></div>
                                    <div e-column e-field="OTHr" e-type="string" e-headertext="OT Hr" e-width="80"></div>
                                    <div e-column e-field="DayStatus" e-type="string" e-headertext="DayStatus" e-width="80"></div>
                                    <div e-column e-field="WorkingDayValue" e-type="string" e-headertext="Working Day" e-width="80"></div>
                                    <div e-column e-field="ActualWorkingDayValue" e-type="string" e-headertext="Actual Working Day" e-width="80"></div>
                                    <div e-column e-field="PresentValue" e-type="string" e-headertext="Present Value" e-width="80"></div>
                                    <div e-column e-field="AbsentValue" e-type="string" e-headertext="Absent Value" e-width="80"></div>
                                    <div e-column e-field="Leave" e-type="string" e-headertext="Leave" e-width="80"></div>
                                    <div e-column e-field="LeaveType" e-type="string" e-headertext="LeaveType" e-width="80"></div>
                                    <div e-column e-field="EarnValue" e-type="string" e-headertext="EarnValue" e-width="80"></div>
                                    <div e-column e-field="AvailedValue" e-type="string" e-headertext="AvailedValue" e-width="80"></div>
                                </div>
                            </div>

                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="clearfix"></div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <fieldset class="scheduler-border">
                    <div class="form-elements form-horizontal" ng-form="from0">
                        <div class="row">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                                    <div class="col-sm-7 show-message">
                                        <input type="text" name="From Date" ng-model="EmpSummaryModelNew.FromDate" datepicker class="form-control" required tabindex="3">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Employee<sup>*</sup></label>
                                    <div class="col-sm-2">
                                        <input type="text" style="width:100px;" ng-change="SearchEmployee()" ng-model="EmpSummaryModelNew.EmployeeCode" placeholder="Employee Code" class="form-control" maxlength="100">
                                    </div>
                                    <div class="col-sm-5 text-left">
                                        <div class="input-group">
                                            <input type="text" name="EmployeeName" ng-model="EmpSummaryModelNew.EmployeeName" class="form-control" required readonly>
                                            <span class="input-group-btn">
                                                <button name="submit" ng-click="getPopUpSummary()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                                    <div class="col-sm-7 show-message">
                                        <input type="text" name="To Date" ng-model="EmpSummaryModelNew.ToDate" datepicker class="form-control" required tabindex="4">
                                    </div>
                                </div>

                            </div>
                            <div class="common-btn" style="margin-top:25px;margin-right:20px;">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="GetEmployeeSummaryList();" class="btn"><i class="glyphicon glyphicon-download"></i> Go </button></li>
                                    <li> <button ng-click="EmployeeAttendanceSingleSummaryData();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Report </button></li>
                                </ul>
                            </div>
                            <div id="EmpGrid" ej-grid e-datasource="EmployeeSummaryList"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
                                <div e-columns>
                                    @*<div e-column e-field="EmpSystemID" e-type="string" e-headertext="EmpSystemID" e-width="80"></div>*@
                                    <div e-column e-field="EmployeeCode" e-type="string" e-headertext="EmployeeCode" e-width="80"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="120"></div>
                                    <div e-column e-field="DOJ" e-type="string" e-headertext="DOJ" e-width="70"></div>
                                    <div e-column e-field="DOS" e-type="string" e-headertext="DOS" e-width="70"></div>
                                    <div e-column e-field="GivenDesignation" e-type="string" e-headertext="Given Designation" e-width="80"></div>
                                    <div e-column e-field="SubSection" e-type="string" e-headertext="Sub Section" e-width="80"></div>
                                    <div e-column e-field="Section" e-type="string" e-headertext="Section" e-width="80"></div>
                                    <div e-column e-field="Department" e-type="string" e-headertext="Department" e-width="120"></div>
                                    <div e-column e-field="Date" e-type="string" e-headertext="Date" e-width="80"></div>
                                    <div e-column e-field="ProcessIntime" e-type="string" e-headertext="Process Intime" e-width="100"></div>
                                    <div e-column e-field="ProcessOuttime" e-type="string" e-headertext="Process Outtime" e-width="100"></div>
                                    <div e-column e-field="Duration" e-type="string" e-headertext="Duration" e-width="80"></div>
                                    <div e-column e-field="OTHr" e-type="string" e-headertext="OT Hr" e-width="80"></div>
                                    <div e-column e-field="DayStatus" e-type="string" e-headertext="DayStatus" e-width="80"></div>
                                    <div e-column e-field="WorkingDayValue" e-type="string" e-headertext="Working Day" e-width="80"></div>
                                    <div e-column e-field="ActualWorkingDayValue" e-type="string" e-headertext="Actual Working Day" e-width="80"></div>
                                    <div e-column e-field="PresentValue" e-type="string" e-headertext="Present Value" e-width="80"></div>
                                    <div e-column e-field="AbsentValue" e-type="string" e-headertext="Absent Value" e-width="80"></div>
                                    <div e-column e-field="Leave" e-type="string" e-headertext="Leave" e-width="80"></div>
                                    <div e-column e-field="LeaveType" e-type="string" e-headertext="LeaveType" e-width="80"></div>
                                    <div e-column e-field="EarnValue" e-type="string" e-headertext="EarnValue" e-width="80"></div>
                                    <div e-column e-field="AvailedValue" e-type="string" e-headertext="AvailedValue" e-width="80"></div>
                                </div>
                            </div>

                        </div>
                    </div>
                </fieldset>

            </div>
        </div>
    </div>

    <div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    Employee List
                    <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="Grid" ej-grid e-datasource="employee" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                <div e-type="string" e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                                <div e-type="string" e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer common-btn">
                    <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="clearfix"></div>

    <div class="modal fade site-modal in" id="employeeMultipleNewPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    Employee List
                    <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="Grid" ej-grid e-datasource="employeeSummaryData" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplate" e-template="#checkEmployee" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="SystemId" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                <div e-type="string" e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                                <div e-type="string" e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkEmployee">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>
                    </div>
                </div>
                <div class="modal-footer common-btn">
                    <button ng-click="closeEmployeeMultiplePopUp();" class="btn"><i class=""></i> Close</button>
                </div>
            </div>
        </div>
    </div>

</div>  