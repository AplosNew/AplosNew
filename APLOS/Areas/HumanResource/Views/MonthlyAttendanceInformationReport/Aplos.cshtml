<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Designation Configuration
</h3>
<div class="form-elements" ng-form id="designationMasterConfigurationNew" name="designationMasterConfigurationForm">
    <div class="row">
        <input type="hidden" ng-model="designationMasterConfigurationNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal  form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="designationMasterConfigurationNew.CompanyId" ng-change="getPlantList();"
                                ng-options="item.Value as item.Text for item in companyList" id="plantId"
                                name="Company" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Designation Group<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="designationMasterConfigurationNew.DesignationGroupId" ng-change="getDesignationMasterConfiguration()"
                                ng-options="item.Value as item.Text for item in designationGroupList" id="plantId"
                                name="Company" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal  form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="designationMasterConfigurationNew.PlantId" ng-change="reSetDesignationList();getSalaryRuleMasterWithPlant();getLeavePolicyMaster();getBonusPolicyMaster();getAttdnBonusPmtPolicyMaster();getBonusPolicyMonthlyRetainMaster();getPFPolicyMaster();getESICPolicyMaster();getOverTimePmtPolicyMaster();"
                                ng-options="item.Value as item.Text for item in plantList" id="plantId"
                                name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Designation</th>
                            <th>Employee Category</th>
                            <th>Process Set</th>
                            <th>Salary Rule</th>
                            <th>Leave Policy</th>
                            <th>Salary Fixation</th>
                            <th>BonusPolicy Master</th>
                            <th>AttdnBonusPmtPolicy Master</th>
                            <th>Bonus Policy Monthly Retain Master</th>
                            <th>PFPolicyMaster</th>
                            <th>ESICPolicyMaster</th>
                            <th>OT Entitle</th>
                            <th>OTPmtPolicyMaster</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in designationMasterConfigurationList">
                            <td>{{x.UserName}}</td>
                            <td>
                                {{x.EmployeeCategory}}
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.RecruitmentProcessSetId"
                                            ng-options="item.Value as item.Text for item in recruitmentPlanningProcessSetList" id="RecruitmentProcessSetId"
                                            name="RecruitmentPlanningProcessSet" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.SalaryRuleMasterId"
                                            ng-options="item.Value as item.Text for item in salaryRuleMasterList" id="SalaryRuleMasterId"
                                            name="SalaryRuleMaster" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.LeavePolicyMasterId"
                                            ng-options="item.Value as item.Text for item in LeavePolicyMasterList" id="LeavePolicyMasterId"
                                            name="LeavePolicyMaster" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.SalaryFixationSettingId"
                                            ng-options="item.Value as item.Text for item in salaryFixationList" id="SalaryFixationSettingId"
                                            name="SalaryFixation" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.BonusPolicyMasterId"
                                            ng-options="item.Value as item.Text for item in BonusPolicyMasterList" id="BonusPolicyMasterId"
                                            name="BonusPolicyMaster" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.AttdnBonusPmtPolicyMasterId"
                                            ng-options="item.Value as item.Text for item in AttdnBonusPmtPolicyMasterList" id="AttdnBonusPmtPolicyMasterId"
                                            name="AttdnBonusPmtPolicyMaster" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.BnsPlcMthRetainID"
                                            ng-options="item.Value as item.Text for item in BonusPolicyMonthlyRetainMasterList" id="BnsPlcMthRetainID"
                                            name="BonusPolicyMonthlyRetainMaster" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.PFPolicyMasterID"
                                            ng-options="item.Value as item.Text for item in PFPolicyMasterList" id="AttdnBonusPmtPolicyMasterId"
                                            name="PFPolicyMaster" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.ESICPolicyMasterID"
                                            ng-options="item.Value as item.Text for item in ESICPolicyMasterList" id="AttdnBonusPmtPolicyMasterId"
                                            name="ESICPolicyMaster" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>

                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="x.IsOTEntitled">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.OverTimePmtPolicyMasterID"
                                            ng-options="item.Value as item.Text for item in OverTimePmtPolicyMasterList" id="AttdnBonusPmtPolicyMasterId"
                                            name="OverTimePmtPolicyMaster" required tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
            <li> <button ng-click="ClearAll();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
        </ul>
    </div>
</div>

<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteDeductionRow()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>
