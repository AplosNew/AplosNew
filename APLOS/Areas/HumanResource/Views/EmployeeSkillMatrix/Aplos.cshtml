<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        /*background-color: #1c1f32;*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>
@*<togglable name="{{title}}"></togglable>*@

<div class="form-elements form-horizontal">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12 ">
            <div class="row">
                <div class="col-md-6">
                    <div class="col-md-4"><span style="font-size: 19px;margin-left: -15%;margin-bottom:10px;"><span class="glyphicon glyphicon-stats"></span>&nbsp;{{title}}</span></div>
                </div>
            </div>
                @*<div id="filters">
                </div>*@

                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridEdit" ej-grid e-datasource="EmployeeSkillMatrixList"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-field="BudgetedLine" e-headertext="Budgeted Line" e-width="10"></div>
                                <div e-column e-field="Entity" e-headertext="Entity" e-width="10"></div>
                                <div e-column e-field="EmployeeStatus" e-headertext="Employee Status" e-width="10"></div>
                                <div e-column e-field="EmployeeCategory" e-headertext="Emp. Category" e-width="8"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="6"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="8"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="10"></div>
                                <div e-column e-field="OperationCode" e-headertext="Operation Variation Code" e-width="8"></div>
                                <div e-column e-field="Process" e-headertext="Process Name" e-width="10"></div>
                                <div e-column e-field="Machine" e-headertext="Machine" e-width="8"></div>
                            </div>
                        </div>
                        <div class="col-md-1 text-right" style="margin-top:20px;">
                            <button type="button" class="btn single-btn" ng-click="ReportEmployeeSkillMatrixEmployeeWise()" style="margin-top:10px;"><i class="glyphicon glyphicon-arrow-down"></i>Employee Skill Matrix Employee Wise</button>
                            <button type="button" class="btn single-btn" ng-click="ReportEmployeeSkillMatrixLineWise()" style="margin-top:10px;"><i class="glyphicon glyphicon-arrow-down"></i>Employee Skill Matrix Line Wise</button>
                        </div>
                </div>
        </div>
    </div>
</div>


<confirm-modal></confirm-modal>
