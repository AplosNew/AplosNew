@*<div class="row">*@
<h3 class="site-heading" id="mainContainer">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  Employee Addition Deduction Process
</h3>
@*</div>*@

<div class="row">
    <div class="col-lg-12">
        <div class="form-group" >
            <label class="col-sm-4 control-label">Date (If not selected will get the current Date)- </label>
            <div class="col-sm-2 show-message">
                <input type="text" name="Effective Date" ng-model="SelectedDate" datepicker class="form-control" tabindex="14" >

            </div>
        </div>
    </div>
</div>

<div class="row" style="margin-top:10px;">
    <div class="col-lg-3 ">
        <div> <button ng-click="run();">Process</button></div>
    </div>
    <div class="col-lg-3 col-lg-offset-1">
        <div> <button ng-click="printCurrentReport();">Print Current Report</button></div>
    </div>
    <div class="col-lg-3 col-lg-offset-1">
        <div> <button ng-click="printSavedReport();">Print Already Processed Report</button></div>
    </div>
</div>

<br />
<br />
<div class="row">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div style="color:black;" id="MasterGrid" ej-grid e-datasource="Data"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
             e-allowselection="true" e-filtersettings-filterType="excel"
             e-templaterefresh="refreshTemplate" e-enabletouch="true" e-responsive="true" e-allowtextwrap="true" e-allowscrolling="true">
            <div e-columns>

                <div e-column e-field="SystemId" e-headertext="SystemID" e-width="70"></div>
                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="70"></div>
                <div e-column e-field="Plant" e-headertext="Plant" e-width="70"></div>
                <div e-column e-field="EmpType" e-headertext="Em pType " e-width="70"></div>
                <div e-column e-field="EmpAdditionDeductionHeaderId" e-headertext="EmpAdditionDeductionHeaderId" e-width="70"></div>
                <div e-column e-field="AdditionDeductionHead" e-headertext="Addition Deduction Head" e-width="70"></div>
                <div e-column e-field="Amount" e-headertext="Amount" e-width="70"></div>
                <div e-column e-field="Month" e-headertext="Month" e-width="70"></div>
                <div e-column e-field="MonthDay" e-headertext="MonthDay" e-width="70"></div>
                

            </div>
        </div>
    </div>
</div>
