<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="ModalNewForm">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Training Mode</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">TAB - 2</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <input type="hidden" ng-model="ModelNew.Id">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-3 show-message">
                                <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100" required />
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sub Category<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Sub Category" ng-model="ModelNew.SubCategory" class="form-control" required tabindex="4" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sub Group<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Sub Group" ng-model="ModelNew.SubGroup" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sub Class<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Sub Class" ng-model="ModelNew.SubClass" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Select Employee<sup>*</sup></label>

                            <div class="col-sm-6">
                                <input type="text" name="" ng-model="EmployeeName" class="form-control" maxlength="200" tabindex="5" ng-disabled="true">
                            </div>
                            <div class="col-sm-2">
                                <button ng-click="selectEmployee()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Training Module<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Training Module" ng-model="ModelNew.TrainingModule" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">If Repeated<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" id="ddCostSaving" ng-model="ModelNew.Repeated" name="CostSaving" tabindex="2" ng-change="EnableDisable()">
                                        <option value="">--Select--</option>
                                        <option value="Yes">Yes</option>
                                        <option value="No">No</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Repeated Days<sup></sup></label>
                            <div class="col-sm-8">
                                <input id="RepeatedDays" ng-disabled="true" ej-dropdownlist e-multiselectmode="visualmode" e-datasource="ProcessList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="ModelNew.Description" tabindex="7" maxlength="250"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-3 show-message">
                                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Category" ng-model="ModelNew.Category" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Group<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Group" ng-model="ModelNew.Group" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Class<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Class" ng-model="ModelNew.Class" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Attachment<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <label class="fileUpload" style="padding: 0 0 0 0 ; margin-right:8px;">
                                    <input id="uploadFile" ng-file-select="onFileSelect($files)" ng-model="ModelNew.Attachment" class="form-control ng-isolate-scope" type="file" name="Attachment" accept=".xls,.xlsx" ng-model="ModelNew.Attachment">
                                </label>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">One Time<sup></sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="One Time" ng-model="ModelNew.OneTime" class="form-control" tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Story Points<sup>*</sup></label>
                            <div class="col-sm-3 show-message">
                                <input type="number" name="StoryPoint" ng-model="ModelNew.StoryPoint" class="form-control" required tabindex="2" maxlength="10">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Effective Date</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" ng-model="ModelNew.EffectiveDate" name="Date" datepicker class="form-control" maxlength="50" tabindex="3" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>
                <!--POP UP SCREEN  FOR EMPLOYEE DETAIL  (EmployeeInformation) TAB 2  -->
                <div class="modal fade site-modal in" id="EmployeePop" role="dialog" data-backdrop="static">
                    <div class="modal-dialog modal-lg modellgModify ">
                        <div class="modal-content">
                            <div class="modal-header">Employee Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
                            <div class="modal-body form-elements form-horizontal">
                                <div class="col-md-12">
                                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                                        <p>Please Select Employee Detail .</p>
                                        <div style="color:black;" id="GridEmployee" ej-grid e-datasource="EmployeeList" e-recorddoubleclick="selEmployeeCategory"
                                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                                            <div e-columns>
                                                <div e-column e-field="SystemId" e-headertext="System Id" e-width="50"></div>
                                                @*<div e-column e-field="EmployeeId" e-headertext="EmployeeCode" e-width="50"></div>*@
                                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50"></div>
                                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="120"></div>
                                                <div e-column e-field="DOB" e-headertext="DOB" e-width="100"></div>
                                                <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                                                <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li>
                                            <button ng-click="closeEmpPopUp();" class="btn"><i class=""></i> Close</button>
                                        </li>
                                    </ul>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <h1>Tab 2</h1>
            </div>
        </div>
    </div>
</div>
