<togglable name="OT Control Limit"></togglable>
<div class="table-responsive modal-table aplos-grid-toggle">
    <div class="aplos-grid-toggle">
        <div style="color:black;" id="Grid2" ej-grid e-datasource="dataList"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="50"></div>
                <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="EffectiveDate" e-headertext="Effective Date" e-width="100"></div>
                <div e-column e-type="string" e-field="ByWhomName" e-headertext="ByWhom" e-width="100"></div>
                <div e-column e-type="string" e-field="ApproveByName" e-headertext="ApproveBy" e-width="100"></div>
            </div>
        </div>
    </div>
</div>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">
        <div class="col-md-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" name="Form Date" ng-model="modelNew.EffectiveDate" datepicker class="form-control">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">By Whom<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="By Whom" ng-model="modelNew.ByWhomName" class="form-control" readonly tabindex="115">
                        <span class="input-group-btn">
                            <button ng-click="showEmployeeListPopUp('ByWhom');" class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Last Effective Date</label>
                <div class="col-sm-8">
                    <input type="text" name="Last Effective Date" disabled ng-model="lastEffectiveDate" datepicker class="form-control">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">ApproveBy<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="ApproveBy" ng-model="modelNew.ApproveByName" class="form-control" readonly tabindex="115">
                        <span class="input-group-btn">
                            <button ng-click="showEmployeeListPopUp('ApproveBy');" class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="col-md-10">
                <div class="inputBtnSection common-btn">
                    <label class="fileUpload col-sm-4 ">
                        <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                    </label>
                    <input type="button" value="Import Data" class="btn btn-success" ng-click="ImportData()" />
                </div>
            </div>
            <div class="col-md-2">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="GetSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File</button></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-sm-12" ng-show="OTDetailList.length>0">
            <div id="GridWorkCenterProduct"
                 ng-init="chkinit()"
                 ej-grid e-datasource="OTDetailList"
                 e-allowfiltering="true"
                 e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-pagesettings-pagesize="25"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="Entity" e-headertext="Entity" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                    <div e-column e-field="Activity" e-headertext="Activity" e-width="80"></div>
                    <div e-column e-field="ShiftDefinationName" e-headertext="Shift" e-width="80"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                    <div e-column e-field="ResponsiblePerson" e-headertext="ResponsiblePerson" e-width="80"></div>
                    <div e-column e-field="Direct" e-headertext="Direct" e-width="80"></div>
                    <div e-column e-field="UserGroup2" e-headertext="UserGroup2" e-width="80"></div>
                    <div e-column e-field="AttendanceGroup" e-headertext="AttendanceGroup" e-width="80"></div>
                    <div e-column e-field="EmployeeCat" e-headertext="Employee Category" e-width="80"></div>
                    <div e-column e-field="PositionCode" e-headertext="PositionCode" e-width="80"></div>
                    <div e-column e-field="BudgetCode" e-headertext="BudgetCode" e-width="80"></div>
                    <div e-column e-field="Deployment" e-headertext="Deployment" e-width="80"></div>
                    <div e-column e-field="BudgetedManPower" e-headertext="TotalNumber" e-width="80"></div>
                    <div e-column e-field="ONRoll" e-headertext="ONRoll" e-width="80"></div>
                    <div e-column e-field="ROBudgetCode" e-headertext="ROBudgetCode" e-width="80"></div>
                    <div e-column e-field="PRBudgetCode" e-headertext="PRBudgetCode" e-width="80"></div>
                    <div e-column e-field="BudgetCodeId" e-headertext="BudgetCodeId" e-width="30"></div>
                    <div e-column e-field="DailyOTLimit" e-headertext="DailyOTLimit" e-width="80"></div>
                    <div e-column e-field="WeeklyOTLimit" e-headertext="WeeklyOTLimit" e-width="80"></div>
                    <div e-column e-field="WeekOffOTLimit" e-headertext="WeekOffOTLimit" e-width="80"></div>
                    <div e-column e-field="MonthlyOTLimit" e-headertext="MonthlyOTLimit" e-width="80"></div>
                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="80"></div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12 ">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>

                </ul>
            </div>
        </div>
    </div>

</div>

<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Designation</th>
                                <th>Entity</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-click="selectEmployeePopUp($index, x.SystemId)" ng-class="{selected : x.SystemId == selectedEmployee}" ng-dblclick="closeEmployeePopUp();" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOB | dateFiltering}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.EmploymentType}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'employeeList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>


