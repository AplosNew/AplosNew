<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="row">
    <div class="col-md-12">
        <div class="col-xs-2 col-sm-2 col-md-2">
            <div class="col-md-12">
                <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-enablefiltersearch="true" e-value="year" e-databound="SelectDefaultValue" e-fields-value="Text" e-fields-text="Text" e-width="100%" />
            </div>
        </div>
        <div class="col-xs-2 col-sm-2 col-md-2">
            <div class="col-md-12">
                <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-enablefiltersearch="true" e-value="month" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
            </div>
        </div>
        <div class="col-xs-8 col-sm-7 col-md-7">
            <div class="col-xs-2 col-sm-2 col-md-2">
                <div class="form-group">
                    <label class="col-sm-8 " style="font-weight:normal;margin-left: -55px;">Regular<sup></sup></label>
                    <div class="col-sm-4">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="isActive" e-checked="isActive" />
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">
                <div class="form-group">
                    <label class="col-sm-8" style="font-weight:normal;margin-left: -55px;">Seperated<sup></sup></label>
                    <div class="col-sm-4" style="padding-left: 26px;">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="isSeperated" e-checked="isSeperated" />
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">
                <div class="form-group">
                    <label class="col-sm-8" style="font-weight:normal;margin-left: -55px;">Going Maternity<sup></sup></label>
                    <div class="col-sm-4">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="isMaternity" e-checked="isMaternity" />
                    </div>
                </div>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <div class="form-group">
                    <input id="typeList" e-watermarktext="Type" ej-dropdownlist e-enablefiltersearch="true" e-create="create" e-multiselectmode="visualmode" e-datasource="EmployeeCodeTypeList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true" />
                </div>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <div class="form-group">
                    <div class="col-sm-12">
                        <input id="CWPlant" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="common-btn text-right">
            <button ng-click="GetBsrSalarySummaryReport();" class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button>
        </div>
    </div>
</div>

