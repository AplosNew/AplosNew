<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  OT Adjustment
</h3>
<div class="form-horizontal form-elements" id="mainContainer">
    <div class="row">
        <div class="col-sm-12">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="col-sm-3 control-label">Attendance Date<sup>*</sup></label>
                    <div class="col-sm-9 ">
                        <input e-enabled="showSubmit" e-dateformat="dd-MMM-yyyy" e-change="ChangeAttendanceDate" ej-datepicker e-value="Model.AttendanceDate" />
                    </div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-group">

                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="col-sm-3 control-label">From Time<sup>*</sup></label>
                    <div class="col-sm-9 ">
                        <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-enabled="false" e-value="Model.FromDate" />
                        <input e-enabled="showSubmit" type="text" ej-timepicker e-value="Model.FromTime" />
                    </div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-group">
                    <label class="col-sm-3 control-label">To Time<sup>*</sup></label>
                    <div class="col-sm-9 ">
                        <input e-enabled="showSubmit" e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="Model.ToDate" />
                        <input e-enabled="showSubmit" type="text" ej-timepicker e-value="Model.ToTime" />
                    </div>
                </div>
            </div>

        </div>
        <div class="col-sm-12" ng-show="showSubmit">
            <div class="col-sm-6">
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li>  <button type="button" ng-click="Submit()" class="btn"><i class="glyphicon glyphicon-ok"></i> Load Data</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-12" ng-hide="showSubmit">

            <div class="col-sm-6">
                <div class="form-group">
                    <label class="col-sm-3 control-label">Adjustment(Minutes)<sup>*</sup></label>
                    <div class="col-sm-3">
                        <input type="text" ej-numerictextbox e-minvalue="0" e-maxvalue="999" e-decimalplaces="0" e-enablertl="false" e-value="Model.Minutes" e-width="100" />

                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li>  <button type="button" ng-click="AdditionalMinutes()" class="btn"><i class="glyphicon glyphicon-plus"></i> Add</button></li>
                                    <li>  <button type="button" ng-click="DeductionMinutes()" class="btn"><i class="glyphicon glyphicon-minus"></i> Subtract</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @*<div class="col-sm-6">
                    <div class="form-group">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li>  <button type="button" ng-click="Submit()" class="btn"><i class="glyphicon glyphicon-ok"></i> Submit</button></li>
                            </ul>
                        </div>
                    </div>
                </div>*@

        </div>


        <div class="col-sm-12" ng-hide="showSubmit">
            <div class="tab-design" id="tab_show">
                <div class="site-tab">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);" href="" aria-controls="general" role="tab" data-toggle="tab">Within {{Model.FromTime}} and {{Model.ToTime}}</a></li>
                        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="general" role="tab" data-toggle="tab">Punch-out after {{Model.ToTime}}</a></li>
                    </ul>
                </div>

                <div class="tab-content">

                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">


                        <div class="row">
                            <div id="GridWithinTimeRange" ng-init="chkinit()" e-templaterefresh="onloadRange" ej-grid e-datasource="dataWithinTimeRange"
                                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                                 e-allowscrolling="true" e-gridlines="none" e-rowdatabound="rowDataBound"
                                 e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="" e-headertemplateid="#headerTemplateRange" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>

                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="100" e-primarykey="true"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="150"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="150"></div>
                                    <div e-column e-field="ShiftName" e-headertext="Shift" e-width="150"></div>
                                    <div e-column e-field="ShiftOutTime" e-headertext="Shift Out Time" e-width="150"></div>

                                    @*<div e-column e-field="PunchInTime" e-headertext="Punch In Time" e-width="150"></div>*@
                                    <div e-column e-field="PunchOutTime" e-headertext="Punch Out Time" e-width="150"></div>
                                    @*<div e-column e-template="#NewOTEntry" e-headertext="New OT" e-width="60"></div>*@
                                    <div e-column e-field="NewOTDisplay" e-headertext="New OT Hr." e-width="120"></div>
                                    <div e-column e-field="TotalOTHrDisplay" e-headertext="Total OT Hr." e-width="120"></div>
                                    <div e-column e-field="OTHrDisplay" e-headertext="Overstay Hr." e-width="120"></div>

                                    <div e-column e-field="DayStatus" e-headertext="Day Status" e-width="50"></div>
                                    <div e-column e-field="IsOTEntitled" e-headertext="OT Entitled" e-width="80"></div>
                                    <div e-column e-field="IsOTComfirm" e-headertext="OT Confirm" e-width="80"></div>


                                    <div e-column e-field="Department" e-headertext="Department" e-width="150"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="150"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="150"></div>
                                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="150"></div>



                                </div>
                            </div>

                        </div>


                    </div>


                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">

                        <div class="row">
                            <div id="GridWithoutTimeRange" ng-init="chkinit()" e-templaterefresh="onloadOutRange" ej-grid e-datasource="dataWithoutTimeRange"
                                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                                 e-allowscrolling="true" e-gridlines="none" e-rowdatabound="rowDataBound"
                                 e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="" e-headertemplateid="#headerTemplateOutRange" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>

                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="100" e-primarykey="true"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="150"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="150"></div>
                                    <div e-column e-field="ShiftName" e-headertext="Shift" e-width="150"></div>
                                    <div e-column e-field="ShiftOutTime" e-headertext="Shift Out Time" e-width="150"></div>

                                    @*<div e-column e-field="PunchInTime" e-headertext="Punch In Time" e-width="150"></div>*@
                                    <div e-column e-field="PunchOutTime" e-headertext="Punch Out Time" e-width="150"></div>
                                    @*<div e-column e-template="#NewOTEntry" e-headertext="New OT" e-width="60"></div>*@
                                    <div e-column e-field="NewOTDisplay" e-headertext="New OT Hr." e-width="120"></div>
                                    <div e-column e-field="TotalOTHrDisplay" e-headertext="Total OT Hr." e-width="120"></div>
                                    <div e-column e-field="OTHrDisplay" e-headertext="Overstay Hr." e-width="120"></div>

                                    <div e-column e-field="DayStatus" e-headertext="Day Status" e-width="50"></div>
                                    <div e-column e-field="IsOTEntitled" e-headertext="OT Entitled" e-width="80"></div>
                                    <div e-column e-field="IsOTComfirm" e-headertext="OT Confirm" e-width="80"></div>


                                    <div e-column e-field="Department" e-headertext="Department" e-width="150"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="150"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="150"></div>
                                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="150"></div>



                                </div>
                            </div>

                        </div>



                    </div>
                </div>
            </div>


            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li>  <button type="button" ng-click="SaveSingleEmployee()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    <li>  <button type="button" ng-click="Back()" class="btn"><i class="glyphicon glyphicon-backward"></i> Back</button></li>
                </ul>
            </div>

        </div>
    </div>
</div>


<script type="text/template" id="NewOTEntry">
    <input type="text" ej-numerictextbox e-minvalue="0" e-decimalplaces="0" e-enablertl="false" e-value="data.NewOT" />
</script>

<script type="text/template" id="checkboxTemplate">
    <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
</script>


<script type="text/template" id="headerTemplateRange">
    <input type="checkbox" id="headchkRange" />
</script>
<script type="text/template" id="headerTemplateOutRange">
    <input type="checkbox" id="headchkOutRange" />
</script>

