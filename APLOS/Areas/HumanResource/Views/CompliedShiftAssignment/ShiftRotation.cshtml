<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Shift Rotation
</h3>
<div class="row">
    <div class="col-md-12">
        <div class="col-md-4"></div>
        <div class="col-md-4">
            <div class="form-elements form-horizontal" ng-form="modelForm">
                <div class="modal-body table-responsive modal-table">
                    Select Date:
                    <div>
                        <input placeholder="Shift Rotation Date*" type="text" ng-model="compliedShiftRotationDate" datepicker required class="form-control datepicker" tabindex="1" style="margin-top: 7px;margin-bottom: -4px;">
                    </div>
                    <ul>
                        <li>
                            <button ng-click="CompliedshiftChange();" class="btn single-btn">Ratate Shift</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-4"></div>
    </div>
</div>



