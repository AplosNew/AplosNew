<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Credit Limit Opening</h3>

<div class="form-elements form-horizontal" ng-form name="ModelNewForm">

    <div class="table-responsive aplos-grid-toggle">
        <div id="GridEdit" ej-grid e-datasource="ModelList" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="DesignationId" e-headertext="DesignationId" e-width="2"></div>
                <div e-column e-field="DesgShortName" e-headertext="Designation ShortName" e-width="4"></div>
                <div e-column e-field="Designation" e-headertext="Designation" e-width="4"></div>
                <div e-column e-field="DailyLimit" e-template="#daytemplate" e-headertext="DailyLimit" e-width="2.5"></div>
                <div e-column e-field="MonthlyLimit" e-template="#monthtemplate" e-headertext="MonthlyLimit" e-width="2.5"></div>

            </div>
        </div>
    </div>

    <div class="common-btn" style="padding-top:10px">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
        </ul>
    </div>

</div>


<confirm-modal></confirm-modal>

<script type="text/template" id="daytemplate">
    <input type="number" ng-model="data.DailyLimit" style="color:black; text-align:center; width:100%" />
</script>


<script type="text/template" id="monthtemplate">
    <input type="number" ng-model="data.MonthlyLimit" style="color:black; text-align:center; width:100%" />
</script>

