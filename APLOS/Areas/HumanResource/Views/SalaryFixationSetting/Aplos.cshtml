<togglable name="Salary Fixation Setting"></togglable>
<div class="form-elements form-horizontal" ng-form name="SalaryFixationSettingNewForm">
    <input type="hidden" ng-model="SalaryFixationSettingNew.Id">
    <div class="row" ng-form name="salaryFixationSettingMaster">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence <sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Sequence" ng-model="SalaryFixationSettingNew.Sequence" class="form-control" required tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="ShortName" ng-model="SalaryFixationSettingNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="UserName" ng-model="SalaryFixationSettingNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="SalaryFixationSettingNew.Remarks" maxlength="250" tabindex="7"></textarea>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code <sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="SalaryFixationSettingNew.Code" class="form-control" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="StandardName" ng-model="SalaryFixationSettingNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description </label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="SalaryFixationSettingNew.Description" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="SalaryFixationSettingNew.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="SaveMaster();" class="btn" tabindex="8"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="tab-design" id="tab_show" ng-show="SalaryFixationSettingNew.Id.length>0">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" aria-controls="monthly" role="tab" data-toggle="tab"> Monthly Cash</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" aria-controls="annualCash" role="tab" data-toggle="tab"> Annual Cash </a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" aria-controls="annualNonCash" role="tab" data-toggle="tab"> Annual Non-Cash </a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" aria-controls="leave" role="tab" data-toggle="tab"> Leave </a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="salaryFixationMonthlyTab">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <ul class="common-btn list-inline text-left">
                            <li><button class="btn" ng-click="getSalaryHeadModalData();"><i class="glyphicon glyphicon-plus"></i> Add Line Item</button></li>
                        </ul>
                    </div>
                    <div class="table-responsive modal-table col-md-12" ng-show="selectedsalaryHead.length>0">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Sequence No</th>
                                    <th>Salary Head ID</th>
                                    <th>Salary Head</th>
                                    <th>Description</th>
                                    <th>Head Type</th>
                                    <th>Head Category</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="dr in selectedsalaryHead">
                                    <td ng-show="selectedsalaryHead.length>0">
                                        <span ng-show="!$first" ng-click="moveUp($index,'selectedsalaryHead')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                        <br />
                                        <span ng-show="!$last" ng-click="moveDown($index,'selectedsalaryHead')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                    </td>
                                    <td>{{dr.SalaryHeadID}}</td>
                                    <td>{{dr.SalaryHead}}</td>
                                    <td>{{dr.Description}}</td>
                                    <td>{{dr.HeadType}}</td>
                                    <td>{{dr.HeadCategory}}</td>
                                    <td style="width:2px;">
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="removeMonthlySalaryHeadRow(dr,$index);" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="salaryFixationAnnualCashTab">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <ul class="common-btn list-inline text-left">
                            <li><button class="btn" ng-click="getAnnCashSalaryHeadModalData();"><i class="glyphicon glyphicon-plus"></i> Add Line Item</button></li>
                        </ul>
                    </div>
                    <div class="table-responsive modal-table col-md-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Sequence No</th>
                                    <th>Salary Head ID</th>
                                    <th>Salary Head</th>
                                    <th>Description</th>
                                    <th>Head Type</th>
                                    <th>Head Category</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="dr in selectedAnnCashSalaryHead">
                                    <td ng-show="selectedAnnCashSalaryHead.length>0">
                                        <span ng-show="!$first" ng-click="moveUp($index,'selectedAnnCashSalaryHead')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                        <br />
                                        <span ng-show="!$last" ng-click="moveDown($index,'selectedAnnCashSalaryHead')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                    </td>
                                    <td>{{dr.SalaryHeadID}}</td>
                                    <td>{{dr.SalaryHead}}</td>
                                    <td>{{dr.Description}}</td>
                                    <td>{{dr.HeadType}}</td>
                                    <td>{{dr.HeadCategory}}</td>
                                    <td style="width:2px;">
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="removeAnnualCashSalaryHeadRow(dr,$index);" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row" ng-form name="salaryFixationAnnualNonCashTab">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <ul class="common-btn list-inline text-left">
                            <li><button class="btn" ng-click="getAnnualNonCashModalData();"><i class="glyphicon glyphicon-plus"></i> Add Non Cash</button></li>
                        </ul>
                    </div>
                    <div class="table-responsive modal-table col-md-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Sequence No</th>
                                    <th>Code</th>
                                    <th>Short Name</th>
                                    <th>User Name</th>
                                    <th>Description</th>
                                    <th>Active</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="dr in selectedAnnualNonCash">
                                    <td ng-show="selectedAnnualNonCash.length>0">
                                        <span ng-show="!$first" ng-click="moveUp($index,'selectedAnnualNonCash')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                        <br />
                                        <span ng-show="!$last" ng-click="moveDown($index,'selectedAnnualNonCash')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                    </td>
                                    <td>{{dr.Code}}</td>
                                    <td>{{dr.ShortName}}</td>
                                    <td>{{dr.UserName}}</td>
                                    <td>{{dr.Description}}</td>
                                    <td>{{dr.Active?'Yes':'No'}}</td>
                                    <td style="width:2px;">
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="removeNonCashRow(dr,$index);" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row" ng-form name="salaryFixationLeaveTab">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <ul class="common-btn list-inline text-left">
                            <li><button class="btn" ng-click="getLeaveTypeModalData();"><i class="glyphicon glyphicon-plus"></i> Add Leave Type</button></li>
                        </ul>
                    </div>
                    <div class="table-responsive modal-table col-md-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Sequence No</th>
                                    <th>Leave Type ID</th>
                                    <th>Leave Type</th>
                                    <th>Code</th>
                                    <th>UserName</th>
                                    <th>Description</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="dr in selectedLeaveTypes">
                                    <td ng-show="selectedLeaveTypes.length>0">
                                        <span ng-show="!$first" ng-click="moveUp($index,'selectedLeaveTypes')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                        <br />
                                        <span ng-show="!$last" ng-click="moveDown($index,'selectedLeaveTypes')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                    </td>
                                    <td>{{dr.LeaveTypeId}}</td>
                                    <td>{{dr.LeaveType}}</td>
                                    <td>{{dr.Code}}</td>
                                    <td>{{dr.UserName}}</td>
                                    <td>{{dr.Description}}</td>
                                    <td style="width:2px;">
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="removeLeaveTypeRow(dr,$index);" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="SaveSalaryHead();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in SalaryFixationSettings |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id,$index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<div class="modal fade site-modal in" id="PopUpSalaryHead" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Select Salary Head</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="SalaryHeadPopUpParameters.searchBy">
                                            <option ng-repeat="option in searchSalaryHeadList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="SalaryHeadPopUpParameters.search" ng-enter="getSalaryHeadModalData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getSalaryHeadModalData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th style="text-align:center">Select</th>
                                <th>Salary Head ID</th>
                                <th>Salary Head</th>
                                <th>Description</th>
                                <th>Head Type</th>
                                <th>Head Category</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="dr in dataListSalaryHead |itemsPerPage:SalaryHeadPopUpParameters.pageSize" pagination-id="metaData.name + 'dataListSalaryHead'"
                                total-items="SalaryHeadPopUpParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="IsSelected" ng-model="dr.Flag" ng-checked="dr.Flag" ng-click="selectFirstCheckedValue($event,dr)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{dr.SalaryHeadID}}</td>
                                <td>{{dr.SalaryHead}}</td>
                                <td>{{dr.Description}}</td>
                                <td>{{dr.HeadType}}</td>
                                <td>{{dr.HeadCategory}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'dataListSalaryHead'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getSalaryHeadModalData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="salaryHeadToTable();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
