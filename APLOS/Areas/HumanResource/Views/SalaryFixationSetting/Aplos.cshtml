            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="annualNonCashToTable();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="PopUpLeaveType" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Search Leave Type</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="LeaveTypePopUpParameters.searchBy">
                                            <option ng-repeat="option in searchLeaveTypeList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="LeaveTypePopUpParameters.search" ng-enter="getLeaveTypeModalData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getLeaveTypeModalData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th style="text-align:center">Select</th>
                                <th>Leave Type ID</th>
                                <th>Leave Type</th>
                                <th>Code</th>
                                <th>UserName</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="dr in dataListLeaveType |itemsPerPage:LeaveTypePopUpParameters.pageSize" pagination-id="metaData.name + 'dataListLeaveType'"
                                total-items="LeaveTypePopUpParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="IsSelected" ng-model="dr.Flag" ng-checked="dr.Flag" ng-click="selectCheckedLeave($event,dr)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{dr.LeaveTypeId}}</td>
                                <td>{{dr.LeaveType}}</td>
                                <td>{{dr.Code}}</td>
                                <td>{{dr.UserName}}</td>
                                <td>{{dr.Description}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'dataListLeaveType'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getLeaveTypeModalData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="leaveTypesToTable();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="Delete();">
</confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmMonthlyPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteMonthlyTabRow();">
</confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmAnnualCashPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteAnnualCashTabRow();">
</confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmNonCashPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteNonCashTabRow();">
</confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmLeavePopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="spliceLeaveTypeRow();">
</confirm-archive-generic>
