<div><h3>{{title}}</h3></div>
<hr />
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="Entity" ng-model="ModelNew.EntityId" ng-change="getProcess()" required name="Entity"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in EntityList" value="{{option.Value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="Category" ng-change="getTag()" ng-model="ModelNew.ZoneCategory" required name="Category Id"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in CategoryList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Responsible Department<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="ResponsibleDep" ng-change="geResponsiblePerson()" ng-model="ModelNew.ResponsibleDepartmentId" required name="Department"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in DepartmentList" value="{{option.Value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Detail</label>
                <div class="col-sm-6">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Detail" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>



            <div class="form-group">
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="Category" ng-change="getMachine()" ng-model="ModelNew.ProcessId" required name="Process"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in ProcessList" value="{{option.Value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Machine<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="Machine" ng-change="getMachineRef()" ng-model="ModelNew.MachineMasterId" required name="Machine"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in MachineList" value="{{option.Value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Final Status<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="PriorityLevel" ng-model="ModelNew.FinalStatus" ng-change="getAssetName()" required name="Vacancy Status"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Close">Close</option>
                            <option value="To Start">To Start</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Current Status</label>
                <div class="col-sm-6 show-message">
                    <textarea class="form-control" name="Current Status" rows="3" ng-model="ModelNew.CurrentStatus" maxlength="300" tabindex="6"></textarea>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            
            <div class="form-group">
                <label class="col-sm-4 control-label">Obesrved By<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="Observed By" ng-model="ObserveByName" class="form-control" maxlength="100" tabindex="5" ng-disabled="true  ">
                </div>
                <div class="col-sm-2">
                    <button ng-click="openObservedBy()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Tag<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="Tag" ng-change="getSubCategory()" ng-model="ModelNew.ZoneMasterId" required name="Tag"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in TagList" value="{{option.Value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" name="Responsible Person" ng-model="ResponsiblePerson" class="form-control" maxlength="100" tabindex="5" ng-disabled="true  ">
                </div>
                <div class="col-sm-2">
                    <button ng-click="OpenEmployeePopUp()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Sub Category / Priority<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">

                        <select class="form-control" id="PriorityLevel" ng-model="ModelNew.PriorityLevel" required name="Tag"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in subcategoryList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>


            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Target Date</label>
                <div class="col-sm-6 show-message">
                    <input type="text" ng-model="ModelNew.TargetDate" name="Target Date" datepicker class="form-control" maxlength="50" tabindex="3" required>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Story Points<sup>*</sup></label>
                <div class="col-sm-3 show-message">
                    <input type="number" name="Story Points" ng-model="ModelNew.StoryPoint" class="form-control" required tabindex="5" maxlength="50">

                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Machine No<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <input type="number" name="Machine Number" ng-model="ModelNew.MachineNo" class="form-control" required tabindex="5" maxlength="10">

                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-6">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>

            @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Close Date</label>
            <div class="col-sm-6 show-message">
                <input type="text" ng-model="ModelNew.CloseDate" name="Close Date" datepicker class="form-control" maxlength="50" tabindex="3" required>
            </div>
        </div>*@
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>*@

            </ul>
        </div>
    </div>

</div>

<!--POP UP SCREEN  OBSERVED BY  -->
<div class="modal fade site-modal in" id="ObservedByPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify ">
        <div class="modal-content">
            <div class="modal-header"> Observed By <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        @*<p>Please Select Plant Detail .</p>*@
                        <div style="color:black;" id="GridPlant" ej-grid e-datasource="ObservedByList" e-recorddoubleclick="selectObservedBy"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="30"></div>
                                <div e-column e-field="UserName" e-headertext="User Name" e-width="50"></div>
                                <div e-column e-field="UserId" e-headertext="User Id" e-width="70"></div>
                                <div e-column e-field="Email" e-headertext="Email" e-width="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeObservedBy();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>

<!--POP UP SCREEN  FOR Responsible Person (EmployeeInformation)   -->
<div class="modal fade site-modal in" id="EmployeePop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify ">
        <div class="modal-content">
            <div class="modal-header">Employee Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Please Select Employee Detail .</p>
                        <div style="color:black;" id="GridEmployee" ej-grid e-datasource="ResponsiblePersonList" e-recorddoubleclick="selectResponsible"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="System Id" e-width="50"></div>

                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="120"></div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeEmpPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>
