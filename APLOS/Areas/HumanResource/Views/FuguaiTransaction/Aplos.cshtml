<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="Entity" ng-model="selectedData.EntityList" required name="Entity"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in EntityList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="Category" ng-model="selectedData.CategoryList" required name="Category"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in CategoryList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Responsible Department<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="Category" ng-model="selectedData.DepartmentList" required name="Department"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in DepartmentList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Detail</label>
                <div class="col-sm-6">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Detail" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Commitment Date</label>
                <div class="col-sm-6 show-message">
                    <input type="text" ng-model="ModelNew.CommitmentDate" name="Commitment Date" datepicker class="form-control" maxlength="50" tabindex="3" required>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Machine<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="Machine" ng-model="selectedData.MachineList" required name="Machine"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in MachineList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Final Status<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="PriorityLevel" ng-model="selectedData.FinalStatus" ng-change="getAssetName()" required name="Vacancy Status"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="">To Start</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Close">Close</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-6">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Obesrved By<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="ObservedBy" ng-model="selectedData.ObservedByList" required name="Observed By"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in ObservedByList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Tag<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="ObservedBy" ng-model="selectedData.TagList" required name="Tag"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in TagList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label">Priority Level<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="PriorityLevel" ng-model="selectedData.PriorityLevel" ng-change="getAssetName()" required name="Vacancy Status"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="">Critical</option>
                            <option value="">Important</option>
                            <option value="">Normal</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>

                <div class="col-sm-6">
                    <input type="text" name="" ng-model="Employee" class="form-control" maxlength="200" tabindex="5" ng-disabled="true  ">
                </div>
                <div class="col-sm-2">
                    <button ng-click="selectEmployee()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Target Date</label>
                <div class="col-sm-6 show-message">
                    <input type="text" ng-model="ModelNew.TargetDate" name="Target Date" datepicker class="form-control" maxlength="50" tabindex="3" required>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Story Points<sup>*</sup></label>
                <div class="col-sm-3 show-message">
                    <input type="number" name="Story Points" ng-model="ModelNew.StoryPoints" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Current Status</label>
                <div class="col-sm-6 show-message">
                    <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="Category" ng-model="selectedData.ProcessList" required name="Process"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in ProcessList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Machine Ref<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="MachineRef" ng-model="selectedData.MachineRefList" required name="MachineRef"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in MachineRefList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Close Date</label>
                <div class="col-sm-6 show-message">
                    <input type="text" ng-model="ModelNew.CloseDate" name="Close Date" datepicker class="form-control" maxlength="50" tabindex="3" required>
                </div>
            </div>
        </div>
    </div>

</div>

<!--POP UP SCREEN  FOR EMPLOYEE DETAIL  (EmployeeInformation)   -->
<div class="modal fade site-modal in" id="EmployeePop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify ">
        <div class="modal-content">
            <div class="modal-header">Employee Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Please Select Employee Detail .</p>
                        <div style="color:black;" id="GridEmployee" ej-grid e-datasource="EmployeeList" e-recorddoubleclick="selectEmpDetail"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="System Id" e-width="50"></div>

                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="120"></div>

                                <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeEmpPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>