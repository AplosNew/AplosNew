<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>

                <div class="col-sm-6">
                    <input type="text" name="" ng-model="Entity" class="form-control" maxlength="200" tabindex="5" ng-disabled="true  ">
                </div>
                <div class="col-sm-2">
                    <button ng-click="selectEntity()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Category<sup>*</sup></label>

                <div class="col-sm-6">
                    <input type="text" name="" ng-model="Category" class="form-control" maxlength="200" tabindex="5" ng-disabled="true  ">
                </div>
                <div class="col-sm-2">
                    <button ng-click="selectEntity()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Responsible Department<sup>*</sup></label>

                <div class="col-sm-6">
                    <input type="text" name="" ng-model="ResponsibleDepartment" class="form-control" maxlength="200" tabindex="5" ng-disabled="true  ">
                </div>
                <div class="col-sm-2">
                    <button ng-click="selectEntity()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Detail</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Detail" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">ObservedBy<sup>*</sup></label>

                <div class="col-sm-6">
                    <input type="text" name="" ng-model="ObservedBy" class="form-control" maxlength="200" tabindex="5" ng-disabled="true  ">
                </div>
                <div class="col-sm-2">
                    <button ng-click="selectEntity()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Tag<sup>*</sup></label>

                <div class="col-sm-6">
                    <input type="text" name="" ng-model="Tag" class="form-control" maxlength="200" tabindex="5" ng-disabled="true  ">
                </div>
                <div class="col-sm-2">
                    <button ng-click="selectEntity()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Priority Level<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" id="PriorityLevel" ng-model="selectedData.PriorityLevel" ng-change="getAssetName()" required name="Vacancy Status"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="">Critical</option>
                            <option value="">Important</option>
                            <option value="">Normal</option>
                            
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

