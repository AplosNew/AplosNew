<togglable></togglable>
<div class="form-elements form-horizontal" ng-form name="FuelForm">
    <input type="hidden" ng-model="FuelNewModel.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Fuel Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Fuel Name" ng-model="FuelNewModel.FuelType" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Effective Date" e-dateformat="dd-MMM-yyyy" ng-model="FuelNewModel.EffectiveDate" datepicker class="form-control" required>
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Rate<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Rate" ng-model="FuelNewModel.Rate" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="2" ng-model="FuelNewModel.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
        </div>


        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="SaveFuel();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="ClearFuel();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>

</div>
<div class="table-responsive aplos-grid-toggle">
    <div ej-grid e-recorddoubleclick="GetFuel" e-datasource="FuelList" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="FuelType" e-headertext="Fuel Type" e-width="2"></div>
            <div e-column e-field="Rate" e-headertext="Rate" e-width="3"></div>
            <div e-column e-field="EffectiveDate" e-headertext="EffectiveDate" e-width="5"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="2"></div>
        </div>
    </div>
</div>

