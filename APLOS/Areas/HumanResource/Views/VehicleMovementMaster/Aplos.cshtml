<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Vehicle  Master</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Vehicle Movement Master</a></li>            
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="general" role="tab" data-toggle="tab">Purpose Master</a></li>            
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="general" role="tab" data-toggle="tab">Location Master</a></li>            
            <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="general" role="tab" data-toggle="tab">Fuel Master</a></li>            
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            @Html.Partial("~/Areas/HumanResource/Views/VehicleMovementMaster/_VehicleMaster.cshtml")
        </div>
        @*   TAB -2 *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            @Html.Partial("~/Areas/HumanResource/Views/VehicleMovementMaster/_VehicleMovement.cshtml")
        </div>

        @*   TAB -3  *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
            @Html.Partial("~/Areas/HumanResource/Views/VehicleMovementMaster/_PurposeMaster.cshtml")

        </div>

        @*   TAB -4 *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
            @Html.Partial("~/Areas/HumanResource/Views/VehicleMovementMaster/_LocationMaster.cshtml")

        </div>
        @*   TAB -5 *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
           @Html.Partial("~/Areas/HumanResource/Views/VehicleMovementMaster/_FuelMaster.cshtml")

        </div>

    </div>

</div>

