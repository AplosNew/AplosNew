<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Create Requisition</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Requisition Status</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

            <togglable name="{{title}}"></togglable>
            <div class="form-elements form-horizontal" ng-form name="VehicleRequisitionForm">
                <input type="hidden" ng-model="VehicleRequisitionModel.Id">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="VehicleRequisitionModel.FromDate" ng-change="compareDate(VehicleRequisitionModel.FromDate)" datepicker class="form-control" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">From Time<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input id="FromTime" e-value="VehicleRequisitionModel.FromTime" width="420" ej-timepicker name="Time" tabindex="4" required />

                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Personal / Official<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="VehicleRequisitionModel.PersonalOfficial" name="Personal / Official"
                                            tabindex="2" required>
                                        <option value="">--Select--</option>
                                        <option value="Personal">Personal</option>
                                        <option value="Official">Official</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        


                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">No. Of Passengers<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="VehicleRequisitionModel.NumberOfPassengers" name="NoOfPassengers"
                                            tabindex="2" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in NoOfPassengers" value="{{option.value}}">{{option.name}}</option>

                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="VehicleRequisitionModel.Remarks" maxlength="250" tabindex="7"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="VehicleRequisitionModel.ToDate" ng-change="compareDate(VehicleRequisitionModel.ToDate)" datepicker class="form-control" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">To Time<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input id="ToTime" e-value="VehicleRequisitionModel.ToTime" width="420" ej-timepicker name="Time" tabindex="4" required />

                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Guest Name</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" ng-model="VehicleRequisitionModel.Name" class="form-control" tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Purpose<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="VehicleRequisitionModel.PurposeId" name="Purpose"
                                            tabindex="2" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in PurposeList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <span class="input-group-addon">{{VehicleRequisitionModel.ResponsiblePersonCode}}</span>
                                    <input type="text" name="Responsible Person" ng-model="VehicleRequisitionModel.EmployeeName" class="form-control" readonly required>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="showEmployeeListPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveMovement();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{MovementAction}}</button></li>
                                @* <li> <button ng-click="CreateBlankRows();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign"></i> Add New Rows</button></li>*@
                                <li> <button data-toggle="modal" ng-click="RquisitionCancellation()" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Cancel</button></li>
                                <li> <button ng-click="ClearMovement();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-xs-12">
                        <div class="table-responsive modal-table" id="reqHideShowId">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Apply</th>
                                        <th>From Location</th>
                                        <th>To Location</th>
                                        <th>Remarks</th>
                                        <th>Is Without passenger</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="data in RequisitionList">
                                        <td class="text-right table-td">
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" ng-model="data.isSelected" e-checked="data.isSelected" tabindex="8">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="form-group" show-errors>

                                                <div class="col-sm-12 show-message">
                                                    <div class="select-style">

                                                        <select class="form-control" ng-model="data.FromLocationId" name="Detention" ng-change="isSelectedAutoChecked(data.FromLocationId, $index);GetToLocationList(data.FromLocationId,$index)"
                                                                tabindex="2">
                                                            <option value="">--Select--</option>
                                                            <option ng-repeat="option in FromLocationList" value="{{option.Value}}">{{option.Text}}</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="form-group" show-errors>

                                                <div class="col-sm-12 show-message">
                                                    <div class="select-style">
                                                       

                                                        <select class="form-control" ng-model="data.ToLocationId" name="Detention" ng-change="AssignToLocInFromLoc(data.ToLocationId, $index);"
                                                                tabindex="2">
                                                            <option value="">--Select--</option>
                                                            <option ng-repeat="option in ToLocationList" value="{{option.Value}}">{{option.Text}}</option>
                                                        </select>

                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="form-group">
                                                <label class="col-sm-4 control-label">Remarks</label>
                                                <div class="col-sm-8">
                                                    <textarea class="form-control" rows="2" ng-model="data.Remarks" maxlength="250" tabindex="7"></textarea>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="checkbox-site">
                                                <div class="col-sm-12 show-message">
                                                    <label>
                                                        <input type="checkbox" ng-model="data.WithoutPassenger" e-checked="data.WithoutPassenger" tabindex="8">
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </td>

                                    </tr>

                                </tbody>
                            </table>
                            <div class="common-btn">
                                <ul class="list-inline text-right">

                                    <li> <button ng-click="SaveRequisitionChild();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{MovementChildAction}}</button></li>
                                    <li> <button ng-click="CreateBlankRows();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign"></i> Add New Rows</button></li>

                                </ul>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="table-responsive table-responsive aplos-grid-toggle" style="border:1px solid white">
                <div id="vehiclemovementrequisId" e-datasource="VehicleMovementReqList" ej-grid e-recorddoubleclick="GetVehicleRequisition" e-load="loadGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                        <div e-column e-field="FromDate" e-headertext="From Date" e-width="50"></div>
                        <div e-column e-field="ToDate" e-headertext="To Date" e-width="50"></div>
                        <div e-column e-field="FromTime" e-headertext="From Time" e-width="50"></div>
                        <div e-column e-field="ToTime" e-headertext="To Time" e-width="50"></div>
                        <div e-column e-field="Purpose" e-headertext="Purpose" e-width="50"></div>
                        <div e-column e-field="PersonalOfficial" e-headertext="PersonalOfficialTemplate" e-width="50"></div>
                        <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="50"></div>
                        <div e-column e-field="NumberOfPassengers" e-headertext="Number Of Passengers" e-width="50"></div>
                    </div>
                </div>

            </div>
        </div>
        @*   TAB -2 *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row">
                <div class="col-md-12">
                    <div id="TripGrid">
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDetailPopUp" title="Confirmation" message={{message_Detailconfirmation}} data-ng-click-right-button="RemoveVehicleMovement();"></confirm-archive-generic>
@*Employee Popup*@
<div class="modal fade site-modal in" id="employeePopUps" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Designation</th>
                                <th>Entity</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-dblclick="selectEmployeePopUp($index, x)" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOB | dateFiltering}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.EmploymentType}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'employeeList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>
