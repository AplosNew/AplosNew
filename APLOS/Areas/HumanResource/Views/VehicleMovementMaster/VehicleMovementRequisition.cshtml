<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="VehicleRequisitionForm">
    <input type="hidden" ng-model="VehicleRequisitionModel.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="VehicleRequisitionModel.FromDate" datepicker class="form-control" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Time<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input id="FromTime" e-value="VehicleRequisitionModel.FromTime" width="420" ej-timepicker name="Time" tabindex="4" required />

                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Purpose<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="VehicleRequisitionModel.PurposeId" name="Purpose"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in PurposeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>


            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">No. Of Passengers<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="VehicleRequisitionModel.NumberOfPassengers" name="NoOfPassengers"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="2" ng-model="VehicleRequisitionModel.Remarks" maxlength="250" tabindex="7"></textarea>
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="VehicleRequisitionModel.ToDate" datepicker class="form-control" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Time<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input id="ToTime" e-value="VehicleRequisitionModel.ToTime" width="420" ej-timepicker name="Time" tabindex="4" required />

                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Personal / Official<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="VehicleRequisitionModel.PersonalOfficial" name="Personal / Official"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="Personal">Personal</option>
                            <option value="Official">Official</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{VehicleRequisitionModel.ResponsiblePersonCode}}</span>
                        <input type="text" name="Responsible Person" ng-model="VehicleRequisitionModel.EmployeeName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="showEmployeeListPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="SaveMovement();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    <li> <button ng-click="CreateBlankRows();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign"></i> Go</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

        <div class="col-xs-12" >
            <div class="table-responsive modal-table" id="reqHideShowId">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Apply</th>
                            <th>From Location</th>
                            <th>To Location</th>
                            <th>Without passenger</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="data in RequisitionList">
                            <td class="text-right table-td">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="data.isSelected" e-checked="data.isSelected" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>
                                <div class="form-group" show-errors>

                                    <div class="col-sm-12 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="data.FromLocationId" name="Detention" ng-change="ToLocationListBasedOnFromLoc(data.FromLocationId)"
                                                    tabindex="2">
                                                <option value="">--Select--</option>
                                                <option ng-repeat="option in FromLocationList" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="form-group" show-errors>

                                    <div class="col-sm-12 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="data.ToLocationId" name="Detention" ng-change="AssignToLocInFromLoc(data.ToLocationId, $index)"
                                                    tabindex="2">
                                                <option value="">--Select--</option>
                                                <option ng-repeat="option in ToLocListBasedOnFromLocList" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td><div class="checkbox-site">
                                <div class="col-sm-12 show-message">
                                    <label>
                                        <input type="checkbox" ng-model="data.WithoutPassenger" e-checked="data.WithoutPassenger" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                                </div>
                            </td>

                        </tr>

                    </tbody>
                </table>
                <div class="common-btn">
                    <ul class="list-inline text-right">

                        <li> <button ng-click="SaveRequisitionChid();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>

                    </ul>
                </div>
            </div>
        </div>
