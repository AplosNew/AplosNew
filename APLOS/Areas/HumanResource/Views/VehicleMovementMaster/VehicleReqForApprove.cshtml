<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Pending For Approval</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Approved</a></li>

        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div>
                <div class="content-container-fluid" style="color:black;overflow:scroll">
                    <div style="color:black;" ej-grid e-datasource="VehicleMovementReqList" e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick="EditRequisitionPopup"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true"
                         e-detailstemplate="requisitiondetailTemp"
                         e-detailsdatabound="requisitiondetailgrid">
                        <div e-columns>
                            <div e-column e-headertext="Merged" e-template="#MergedCheckBox" e-width="15"></div>
                            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                            <div e-column e-field="FromDate" e-headertext="From Date" e-width="50"></div>
                            <div e-column e-field="ToDate" e-headertext="To Date" e-width="50"></div>
                            <div e-column e-field="FromTime" e-headertext="From Time" e-width="50"></div>
                            <div e-column e-field="ToTime" e-headertext="To Time" e-width="50"></div>                         
                            <div e-column e-field="EmployeeName" e-headertext="By Whom" e-width="50"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                            <div e-column e-field="Purpose" e-headertext="Purpose" e-width="50"></div>
                            <div e-column e-field="PersonalOfficial" e-headertext="PersonalOfficialTemplate" e-width="50"></div>

                        </div>
                    </div>
                </div>
                <script id="requisitiontabGridContents" type="text/x-jsrender">
                    <div class="tabcontrol" id="Test">
                        <ul>
                            <li><a href="#gridTab{{:Id}}">Requisition Details</a></li>

                        </ul>
                        <div id="gridTab{{:Id}}">
                            <div id="requisitiondetailgrid"></div>
                        </div>

                    </div>
                </script>
                <script type="text/template" id="MergedCheckBox">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="data.isMerge" e-checked="data.isMerge" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </script>

            </div>

            
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="MergeRows();" class="btn" tabindex="9"><i class="glyphicon glyphicon-check"></i> Apply</button></li>

                </ul>
            </div>
        </div>
        @*   TAB -2 *@
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">

        <div class="row">
            <div class="col-md-12">
                <div id="Grid">
                </div>
            </div>
        </div>

    </div>
    </div>

</div>


<div class="modal fade site-modal in" id="reqPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Approve Requisition <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">

                <div class="form-elements form-horizontal" ng-form name="VehicleRequisitionForm">
                    <input type="hidden" ng-model="ApproveRequisitionModel.Id">
                    <div class="row">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="ApproveRequisitionModel.FromDate" datepicker class="form-control" required>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="ApproveRequisitionModel.Remarks" maxlength="250" tabindex="7"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">From Time<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input id="FromTime" e-value="ApproveRequisitionModel.FromTime" width="270" ej-timepicker name="Time" tabindex="4" e-enabled ="false" required />

                                </div>
                            </div>
                            @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="ApproveRequisitionModel.ToDate" datepicker class="form-control" required>
            </div>
        </div>*@
                            @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Time<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input id="ToTime" e-value="ApproveRequisitionModel.ToTime" width="270" ej-timepicker name="Time" tabindex="4" required />

            </div>
        </div>*@
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="SaveVehicleAllocation();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>

                                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="editreqPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Edit Requisition <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">

                <div class="form-elements form-horizontal" ng-form name="VehicleRequisitionForm">
                    <input type="hidden" ng-model="VehicleRequisitionModel.Id">
                    <div class="row">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Purpose<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="VehicleRequisitionModel.PurposeId" name="Purpose"
                                                tabindex="2">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in PurposeList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">No. Of Passengers<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="VehicleRequisitionModel.NumberOfPassengers" name="NoOfPassengers"
                                                tabindex="2">
                                            <option value="">--Select--</option>
                                            <option value="1">1</option>
                                            <option value="2">2</option>
                                            <option value="3">3</option>
                                            <option value="4">4</option>
                                            <option value="5">5</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Personal / Official<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="VehicleRequisitionModel.PersonalOfficial" name="Personal / Official"
                                                tabindex="2">
                                            <option value="">--Select--</option>
                                            <option value="Personal">Personal</option>
                                            <option value="Official">Official</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="VehicleRequisitionModel.Remarks" maxlength="250" tabindex="7"></textarea>
                                </div>
                            </div>
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="SaveMovement();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>

                                    @*<li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>*@
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>


