    <div class="common-btn">
        <ul class="list-inline text-left">
            <li> <button ng-click="XlsVehicleReport();" class="btn" tabindex="9"><i class="glyphicon glyphicon-download"></i> Download</button></li>

        </ul>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div id="GridEdit" ej-grid e-datasource="ReportDataList" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns> 
                <div e-column e-field="VehicleNumber" e-headertext="Vehicle No" e-width="100"></div>
                <div e-column e-field="OutDate" e-type="date" e-headertext="OutDate" e-width="100"></div>
                <div e-column e-field="InDate" e-type="date" e-headertext="InDate" e-width="100"></div>
                <div e-column e-field="OutTime" e-headertext="Out Time" e-width="100"></div>
                <div e-column e-field="InTime" e-headertext="In Time" e-width="100"></div>
                <div e-column e-field="ApprovedRejectBy" e-headertext="Used By" e-width="110"></div>
                <div e-column e-field="Purpose" e-headertext="Purpose" e-width="140"></div>
                <div e-column e-field="DriverName" e-headertext="DR. Name" e-width="100"></div>
                <div e-column e-field="FromLocation" e-headertext="From Location" e-width="120"></div>
                <div e-column e-field="ToLocation" e-headertext="To Location" e-width="120"></div>
                <div e-column e-field="Total_Trip_Time" e-headertext="Total Time" e-width="100"></div>
                <div e-column e-field="TotalTripReading" e-headertext="Total KM" e-width="100"></div>
                <div e-column e-field="ReqRemark" e-headertext="Remark" e-width="120"></div>  
            </div>
        </div>
    </div>
 

