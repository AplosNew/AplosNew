<togglable></togglable>
<div class="form-elements form-horizontal" ng-form name="DriverMasterForm">
    <input type="hidden" ng-model="DriverMasterModel.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Driver Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{DriverMasterModel.DriverCode}}</span>
                        <input type="text" name="Responsible Person" ng-model="DriverMasterModel.DriverName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="showEmployeeListPopUp()" class="btn single-small-btn" tabindex="2"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Expiry Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Expiry Date" e-dateformat="dd-MMM-yyyy" ng-model="DriverMasterModel.ExpiryDate" datepicker class="form-control" tabindex="4" required>
                </div>
            </div>
            
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Grade<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="DriverMasterModel.Grade" name="Grade"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">License Number<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="License Number" ng-model="DriverMasterModel.LicenseNumber" class="form-control" required tabindex="3" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Allow Duty Hrs/Week<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="License Number" ng-model="DriverMasterModel.AllowDutyHoursPerWeek" class="form-control" required tabindex="3" maxlength="50">
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    
                    <li> <button ng-click="SaveDriverMaster();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="ClearDM();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>
    </div>
    </div>
<div class="table-responsive table-responsive aplos-grid-toggle" style="border:1px solid white">
    <div id="vehiclemovementrequisId" e-datasource="DriverMasterList" ej-grid e-recorddoubleclick="GetVehicleRequisition" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="DriverName" e-headertext="DriverName" e-width="50"></div>
            <div e-column e-field="DriverId" e-headertext="DriverId" e-width="50"></div>
            <div e-column e-field="LicenseNumber" e-headertext="LicenseNumber" e-width="50"></div>
            <div e-column e-field="ExpiryDate" e-headertext="ExpiryDate" e-width="50"></div>
            <div e-column e-field="Grade" e-headertext="Grade" e-width="50"></div>
            <div e-column e-field="AllowDutyHoursPerWeek" e-headertext="AllowDutyHoursPerWeek" e-width="50"></div>
            
        </div>
    </div>

</div>


<div class="modal fade site-modal in" id="employeePopUps" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Designation</th>
                                <th>Entity</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-dblclick="selectEmployeePopUp($index, x)" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOB | dateFiltering}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.EmploymentType}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'employeeList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>