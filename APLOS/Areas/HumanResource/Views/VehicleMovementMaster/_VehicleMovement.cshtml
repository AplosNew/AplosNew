<div class="form-elements form-horizontal" ng-form name="VehicleMovementForm">
    <input type="hidden" ng-model="VehicleMovement.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Location" ng-model="VehicleMovement.FromLocation" class="form-control" maxlength="15" required tabindex="0">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Min. Km.<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Min Killometer" ng-model="VehicleMovement.MinKillometer" class="form-control" maxlength="15" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Cost / Km.<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Cost / Km." ng-model="VehicleMovement.CostPerKm" class="form-control" maxlength="15" required tabindex="4">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Vehicle Number<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Vehicle Number" ng-model="VehicleMovement.VehicleNumber" class="form-control" maxlength="15" required tabindex="6">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Milage<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Milage" ng-model="VehicleMovement.Milage" class="form-control" maxlength="15" required tabindex="8">
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Location" ng-model="VehicleMovement.ToLocation" class="form-control" maxlength="15" required tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max. Km.<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Max Killometer" ng-model="VehicleMovement.MaxKillometer" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Vehicle Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Vehicle Name" ng-model="VehicleMovement.VehicleName" class="form-control" maxlength="15" required tabindex="5">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Fuel Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Fuel Type" ng-model="VehicleMovement.FuelType" class="form-control" maxlength="15" required tabindex="7">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="2" ng-model="ModelNew.Remarks" maxlength="250" tabindex="7"></textarea>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    
</div>
