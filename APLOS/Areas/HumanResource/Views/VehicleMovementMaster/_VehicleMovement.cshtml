<togglable></togglable>
<div class="form-elements form-horizontal" ng-form name="VehicleMovementForm">
    <input type="hidden" ng-model="VehicleMovement.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Location" ng-model="VehicleMovement.FromLocation" class="form-control" maxlength="15" required tabindex="0">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Min. Km.<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Min Killometer" ng-model="VehicleMovement.MinKillometer" class="form-control" maxlength="15" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Cost / Km.<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Cost / Km." ng-model="VehicleMovement.CostPerKm" class="form-control" maxlength="15" required tabindex="4">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Vehicle Number<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Vehicle Number" ng-model="VehicleMovement.VehicleNumber" class="form-control" maxlength="15" required tabindex="6">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Milage<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Milage" ng-model="VehicleMovement.Milage" class="form-control" maxlength="15" required tabindex="8">
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Location" ng-model="VehicleMovement.ToLocation" class="form-control" maxlength="15" required tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max. Km.<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Max Killometer" ng-model="VehicleMovement.MaxKillometer" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Vehicle Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Vehicle Name" ng-model="VehicleMovement.VehicleName" class="form-control" maxlength="15" required tabindex="5">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Fuel Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Fuel Type" ng-model="VehicleMovement.FuelType" class="form-control" maxlength="15" required tabindex="7">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="2" ng-model="ModelNew.Remarks" maxlength="250" tabindex="7"></textarea>
                </div>
            </div>
        </div>

        <div class="table-responsive" style="border:1px solid white">
            <div id="vehiclemovementrequisId" ej-grid e-recorddoubleclick="Get" e-load="loadGridEdit"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-headertext="Check / Uncheck" e-template="#checkboxUnallocationTemplate" e-textalign="center" e-width="60"></div>
                    <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                    <div e-column e-headertext="Date" e-template="#DateTemplate" e-width="50"></div>
                    <div e-column e-headertext="Purpose" e-template="#PurposeTemplate" e-width="50"></div>
                    <div e-column e-headertext="PersonalOfficial" e-template="#PersonalOfficialTemplate" e-width="50"></div>
                    <div e-column e-headertext="Employee" e-template="#PersonalOfficialTemplate" e-width="50"></div>

                </div>
            </div>
            <script type="text/template" id="checkboxUnallocationTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" ng-model="data.Active" />
            </script>
            <script type="text/template" id="DateTemplate">
                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Date<sup>*</sup></label>
                    <div class="show-message">
                        <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="data.Date" datepicker class="form-control" required>
                    </div>
                </div>
            </script>
            <script type="text/template" id="PurposeTemplate">
                <div class="mb-3 form-group" style="margin-right:4px" show-errors>

                    <div class="select-style">
                        <select class="form-control" ng-model="data.PurposeId" name="Detention" tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in DetentionList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>

                </div>
            </script>
            <script type="text/template" id="PersonalOfficialTemplate">
                <div class="mb-3 form-group" style="margin-right:4px" show-errors>

                    <div class="select-style">
                        <select class="form-control" ng-model="data.PurposeId" name="Detention" tabindex="2">
                            <option value="Personal">Personal</option>
                            <option value="Official">Official</option>
                        </select>
                    </div>

                </div>
            </script>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>

</div>
<div class="table-responsive aplos-grid-toggle">
    <div ej-grid e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>


            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>

            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>