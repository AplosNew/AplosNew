<togglable></togglable>
<div class="form-elements form-horizontal" ng-form name="VehicleMovementForm">
    <input type="hidden" ng-model="VehicleMovement.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="VehicleMovement.FromLocationId" name="Detention"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in FromLocationList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Min. Km.<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Min Killometer" ng-model="VehicleMovement.MinKillometer" class="form-control" maxlength="15" required tabindex="2">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="2" ng-model="VehicleMovement.Remarks" maxlength="250" tabindex="7"></textarea>
                </div>
            </div>
          
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="VehicleMovement.ToLocationId" name="Detention"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in FromLocationList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max. Km.<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Max Killometer" ng-model="VehicleMovement.MaxKillometer" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
           
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="SaveVehicleMovement();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="ClearVM();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>

</div>
<div class="table-responsive aplos-grid-toggle">
    <div ej-grid e-recorddoubleclick="GetVehicleMovement" e-datasource="VehicleMovementList" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="FromLocation" e-headertext="FromLocation" e-width="2"></div>
            <div e-column e-field="ToLocation" e-headertext="ToLocation" e-width="3"></div>
            <div e-column e-field="MinKillometer" e-headertext="Min. Lillometer" e-width="5"></div>
            <div e-column e-field="MaxKillometer" e-headertext="Max. Lillometer" e-width="5"></div>          
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="2"></div>
        </div>
    </div>
</div>

