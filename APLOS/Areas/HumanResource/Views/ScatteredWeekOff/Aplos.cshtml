<style>
    .b-tab {
        padding: 20px;
        border: 1px solid #000;
        display: none;
    }

        .b-tab.active {
            display: block;
        }

    .b-nav-tab {
        padding: 13px 9px;
        font-size: .8rem;
        font-family: 'poppins', sans-serif;
        font-weight: 300;
        box-shadow: 0 0 2px rgba(0,0,0,.090);
        margin-bottom: 10px;
        margin-left: 10px
    }

        .b-nav-tab.active {
            color: #fff;
            background: #1C1F32;
        }

    .d-grid {
        display: flex;
        justify-content: center;
        justify-items: center;
    }
</style>
<div class="d-grid">
   
    <button data-tab="_ScatteredWeekDefinition" class="b-nav-tab active" style="border:none">
        Scattered Week Definition
    </button>
    <button data-tab="_ScatteredWeekMaster" class="b-nav-tab" style="border:none">
        Scattered Week Master
    </button>
    

    
</div>

<div id="_ScatteredWeekDefinition" class="b-tab active">
    @{
        Html.RenderPartial("_ScatteredWeekDefinition");
    }
</div>
<div id="_ScatteredWeekMaster" class="b-tab">
    @{
        Html.RenderPartial("_ScatteredWeekMaster");
    }
</div>
