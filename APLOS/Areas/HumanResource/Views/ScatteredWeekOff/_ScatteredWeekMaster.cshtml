<togglable name="Scattered Week Master"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group mb-2">
            <label class="col-sm-4 control-label">Company</label>

            <div class="show-message col-sm-8 ">
                <div class="select-style" >
                    <select class="form-control" ng-model="companyId" ng-change="getPlant()" name="Comapny"
                            ng-options="item.Value as item.Text for item in companyList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">Standard Name</label>
            <div class="col-sm-8">
                <input type="text" ng-model="WeekMaster.StandardName" class="form-control" maxlength="30" tabindex="2">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Max Budget Number</label>
            <div class="col-sm-8">
                <input type="text" onkeypress="return isNumber(event)" ng-model="WeekMaster.MaxBudgetNumber" class="form-control" maxlength="100" tabindex="2">
            </div>
        </div>



    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group mb-2">
            <label class="col-sm-4 control-label">Plant</label>
            <div class="col-sm-8 show-message">
                <div class="select-style" ">
                    <select class="form-control" ng-model="WeekMaster.PlantId" name="Plant"
                            ng-options="item.Value as item.Text for item in plantList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">User Name</label>
            <div class="col-sm-8">
                <input type="text" ng-model="WeekMaster.UserName" class="form-control" maxlength="30" tabindex="2">
            </div>
        </div>

        <div class="form-group mb-2">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <input type="text" ng-model="WeekMaster.Remarks" class="form-control" maxlength="100">
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="SaveAll();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button ng-click="DeleteAll()" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            @*<li> <button data-toggle="modal" onclick="openModal()" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <h4>Child Data</h4>
    <div class="row">
        <div class="col-md-4">
            <div id="GridEdit" ej-grid e-datasource="savedWeekList" 
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="1"></div>
                    <div e-column e-field="Day" e-headertext="Days" e-width="4"></div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div class="col-md-10">
        <div id="GridEdit" ej-grid e-datasource="MasterDetails" e-recorddoubleclick="GetMasterDetails" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                <div e-column e-field="PlantName" e-headertext="Plant" e-width="3"></div>
                @*<div e-column e-field="AddedDate" e-format="{0:dd-MMM-yyyy}"  e-type="date" e-headertext="Date Added" e-width="2"></div>*@
                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="2"></div>
                <div e-column e-field="UserName" e-headertext="User Name" e-width="3"></div>
                <div e-column e-field="MaxBudgetNumber" e-headertext="Max Budget Number" e-width="3"></div>
                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="3"></div>

            </div>
        </div>
    </div>

</div>

<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 46) {
            return false;
        }
        return true;
    }

    //onkeypress = "return isNumber(event)"
</script>

<script type="text/template" id="checkboxTemplate">
    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isApplicable" ng-model="data.isApplicable" />
</script>


<div class="modal fade site-modal in" id="confirmPOPUPD" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">x</button>
                <h4 class="modal-title">
                    <i class="glyphicon glyphicon-warning-sign"></i> "Delete"
                </h4>
            </div>
            <div class="modal-body">
                <p class="text-warning">Are you sure to delete ?</p>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-default" data-dismiss="modal" id="btnConfirmed" ng-click="DeleteSelected();">Yes</button>
            </div>
        </div>
    </div>
</div>