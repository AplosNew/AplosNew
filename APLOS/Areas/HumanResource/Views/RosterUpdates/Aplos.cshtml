
<div id="SDiv">
    <togglable name="Roster Employee Upload"></togglable>
    <div class="form-elements form-horizontal" ng-form name="HeaderForm">
        <div class="row">
            <div class="form-elements">
                <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Plant</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="PlantId" name="Plant"
                                        ng-options="item.Value as item.Text for item in PlantList" required tabindex="2">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-10">

                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-4 " style="padding: 0 0 0 0 ; margin-right:8px;">
                            <input id="uploadFile" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                        </label>
                        <input type="button" style="margin-right: 8px;" value="Import Data" ng-disabled="enable" class="btn btn-success" ng-click="ImportData()" />
                        <button ng-click="GetSample();" class="btn" style="margin-right: 8px;"><i class="glyphicon glyphicon-download"></i> Get Roster Report File </button>

                    </div>
                </div>

            </div>

        </div>
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="saveFileList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> Save </button></li>
                <li> <button ng-click="clearFileList();" class="btn" tabindex="12"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

            </ul>
        </div>

        <div id="RosterBudgetGrid" ej-grid e-datasource="ExcelUploadData" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
            <div e-columns>
                <div e-column e-field="EmpSystemId" e-type="string" e-headertext="Id" e-width="80"></div>
                <div e-column e-field="EmployeeCode" e-type="string" e-headertext="Emp Code" e-width="80"></div>
                <div e-column e-field="RosterId" e-type="string" e-headertext="Roster Id" e-width="80"></div>
            </div>
        </div>

    </div>

    <div class="row aplos-grid-toggle">
        <div class="col-md-6 col-xs-6 col-lg-6 col-sm-12">
            <div class="form-group">
                <label class="col-sm-4 control-label">Plant</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="PlantId" name="Plant"
                                ng-options="item.Value as item.Text for item in PlantList" required tabindex="2">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="getCurrentFileList();" class="btn" tabindex="11"><i class="glyphicon glyphicon-search"></i> View </button></li>

            </ul>
        </div>
        <div id="CurrentListRoster" ej-grid e-datasource="currentList" e-templaterefresh="refreshTemplate"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;"
             e-recorddoubleclick="fillUpdates">
            <div e-columns>
                <div e-column e-field="Rows" e-headertext="Sr. No." e-width="2"></div>
                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="2"></div>
                <div e-column e-field="RosterId" e-headertext="Roster Id" e-width="2"></div>
            </div>
        </div>
    </div>
    <confirm-modal></confirm-modal>



</div>




<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to save without any shifts ?" data-ng-click-left-button="restoreChildShifts();" data-ng-click-right-button="SaveShifts();"></confirm-archive-generic>
