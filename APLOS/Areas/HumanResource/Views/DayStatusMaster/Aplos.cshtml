<togglable name="Day Status Master"></togglable>
<div class="form-elements form-horizontal" ng-form id="dayStatus" name="DayStatusMasterForm">
    <div class="row">
        <div ng-form name="HeaderForm">
            <div class="col-xs-12 col-sm-6 col-md-6">


                <div class="form-group">
                    <label class="col-sm-4 control-label">Sequence</label>
                    <div class="col-sm-8">
                        <input type="text" onkeypress="return isNumber(event)" ng-model="Header.Sequence" class="form-control" maxlength="100" tabindex="2" readonly>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Standard Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="Header.StandardName" name="Standard Name" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="Header.Remarks" class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="Header.UserName" name="User Name" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>

                <div class="form-group"  show-errors>
                    <label class="col-sm-4 control-label">Short Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="Header.ShortName" class="form-control" name="Short Name" maxlength="15" tabindex="2" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Active</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site" style="margin-top:7px;">
                            <label>
                                <input type="checkbox" ng-model="Header.Active" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="saveHeader();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        @*<li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                        <li> <button ng-click="clearHeader();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>

        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="DayTypeWithValues" role="tab" data-toggle="tab">Day Type With Values</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="DayStatus" role="tab" data-toggle="tab">Day Status</a></li>
                    <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="PlantChild" role="tab" data-toggle="tab">Plant Entry</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row">
                        <div ng-form name="DayTypeChild">
                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Header Id</label>
                                    <div class="col-sm-8">
                                        <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.HeaderId" class="form-control" maxlength="100" tabindex="2" readonly>
                                    </div>
                                </div>

                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Standard Name</label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" ng-model="DayChild.StandardName" name="Standard Name" class="form-control" maxlength="30" tabindex="2" required>
                                    </div>
                                </div>



                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Code</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="DayChild.Code" class="form-control" maxlength="100" tabindex="2">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Category</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="DayChild.Category" class="form-control" maxlength="100" tabindex="2">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Day Type</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="DayChild.DayType" ng-click="selectCurrDayStatus()" class="form-control" maxlength="100" tabindex="2">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Remarks</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="DayChild.Remarks" class="form-control" maxlength="100" tabindex="2">
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">User Name</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="DayChild.UserName" class="form-control" maxlength="100" tabindex="2">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Short Name</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="DayChild.ShortName" class="form-control" maxlength="100" tabindex="2">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Report Code</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="DayChild.ReportCode" class="form-control" maxlength="100" tabindex="2">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Sub Category</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="DayChild.SubCategory" class="form-control" maxlength="100" tabindex="2">
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">

                                        <input type="text" name="Responsible Person" ng-model="RespPerson" ng-click="selectRespPerson()" class="form-control" maxlength="200" tabindex="15" required>

                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Active</label>
                                    <div class="col-sm-8">
                                        <div class="checkbox-site" style="margin-top:7px;">
                                            <label>
                                                <input type="checkbox" ng-model="DayChild.Active" tabindex="8">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Working Day Value</legend>
                                    <div class="col-xs-12 col-sm-6 col-md-6 ">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Total Working Day</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.TotalWorkingDay" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>

                                    </div>
                                    <div class="col-xs-12 col-sm-6 col-md-6 ">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Actual Woking Day</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.ActualWorkingDay" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>

                                    </div>
                                </fieldset>
                            </div>

                            <div class="col-xs-12">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Pay Day Value</legend>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Pay Day</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.PayDay" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Non Pay Day</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.NonPayDay" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                    </div>

                                </fieldset>
                            </div>

                            <div class="col-xs-12">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Day Status Value</legend>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Present Value (PD)</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.PresentValuePD" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Leave Value (LWP)</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.LeaveValueLWP" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Weekly Off (WO)</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.WeeklyOffWO" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Other</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.Other" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Late Value (LV)</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.LateValueLV" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>

                                    </div>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Leave Value (LP)</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.LeaveValueLP" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Absent value (AB)</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.AbsentValueAB" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Holiday (H)</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.HolidayH" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Week Off HoliDay (WOH)</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.WeekOffHoliDayWOH" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Company Assign (Lv)</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.CompAssignLv" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                    </div>

                                </fieldset>
                            </div>

                            <div class="col-xs-12">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Leave Value</legend>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Casual Leave Value CV</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.CasualLeaveValueCV" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Medical Leave Value MV</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.MedicalLeaveValueMV" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Earned PL</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.EarnedPL" class="form-control" maxlength="16" tabindex="2">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Priviledge Leave PL</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.PriviledgeLeavePL" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Maternity Leave Value MLV</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.MaternityLeaveValueMLV" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Earned CL</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.EarnedCL" class="form-control" maxlength="16" tabindex="2">
                                            </div>
                                        </div>
                                    </div>

                                </fieldset>
                            </div>

                            <div class="col-xs-12">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Other</legend>
                                    <div class="col-xs-12 col-sm-6 col-md-6 ">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Attendance Bonus</label>
                                            <div class="col-sm-8">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="DayChild.AttendanceBonus" class="form-control" maxlength="100" tabindex="2">
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Compensatory Applicable</label>
                                            <div class="col-sm-8">
                                                <div class="checkbox-site" style="margin-top:7px;">
                                                    <label>
                                                        <input type="checkbox" ng-model="DayChild.CompensatoryApplicable" tabindex="8">
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">To Audit</label>
                                            <div class="col-sm-8">
                                                <div class="checkbox-site" style="margin-top:7px;">
                                                    <label>
                                                        <input type="checkbox" ng-model="DayChild.ToAudit" tabindex="8">
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Attendance Re Process Applicable</label>
                                            <div class="col-sm-8">
                                                <div class="checkbox-site" style="margin-top:7px;">
                                                    <label>
                                                        <input type="checkbox" ng-model="DayChild.AttendanceReProcessApplicable" tabindex="8">
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">OT Limit Lock Applicable</label>
                                            <div class="col-sm-8">
                                                <div class="checkbox-site" style="margin-top:7px;">
                                                    <label>
                                                        <input type="checkbox" ng-model="DayChild.OTLimitLockApplicable" tabindex="8">
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Manual Status Allowed</label>
                                            <div class="col-sm-8">
                                                <div class="checkbox-site" style="margin-top:7px;">
                                                    <label>
                                                        <input type="checkbox" ng-model="DayChild.ManualStatusAllowed" tabindex="8">
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Day Status Change</label>
                                            <div class="col-sm-8">
                                                <div class="checkbox-site" style="margin-top:7px;">
                                                    <label>
                                                        <input type="checkbox" ng-model="DayChild.DayStatusChange" tabindex="8">
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Auto Lock</label>
                                            <div class="col-sm-8">
                                                <div class="checkbox-site" style="margin-top:7px;">
                                                    <label>
                                                        <input type="checkbox" ng-model="DayChild.AutoLock" tabindex="8">
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>


                                    </div>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">OT Applicable </label>
                                            <div class="col-sm-8 ">
                                                <div class="select-style">
                                                    <select id="OTWApp" class="form-control" ng-model="DayChild.OTApplicable" name="Working Day OT Applicable" tabindex="1">
                                                        <option value="">-Select-</option>
                                                        <option Value="0">0 - No OT Allowed</option>
                                                        <option Value="1">1 - On OverStay</option>
                                                        <option Value="2">2 - On Duration</option>
                                                        <option Value="3">3 - On (OverStay-EarlyIn)</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Good Work Applicable </label>
                                            <div class="col-sm-8 ">
                                                <div class="select-style">
                                                    <select id="OTNWApp" class="form-control" ng-model="DayChild.GoodWorkApplicable" name="Non Working Day OT Applicable" tabindex="1">
                                                        <option value="">-Select-</option>
                                                        <option Value="0">0</option>
                                                        <option Value="1">1</option>
                                                        <option Value="2">2</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Sandwich Status Flag </label>
                                            <div class="col-sm-8 ">
                                                <div class="select-style">
                                                    <select id="ToCheck" class="form-control" ng-model="DayChild.SandwichStatusFlag" name="To Check" tabindex="1">
                                                        <option value="">-Select-</option>
                                                        <option Value="0">0</option>
                                                        <option Value="1">1</option>
                                                        <option Value="2">2</option>
                                                        <option Value="3">3</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">OT Multiplier </label>
                                            <div class="col-sm-8 ">
                                                <div class="select-style">
                                                    <select id="ToCheck" class="form-control" ng-model="DayChild.OTMultiplier" name="To Check" tabindex="1">
                                                        <option value="">-Select-</option>
                                                        <option Value="0">0</option>
                                                        <option Value="1">1</option>
                                                        <option Value="2">2</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">OT Hour Limit </label>
                                            <div class="col-sm-8 ">
                                                <div class="select-style">
                                                    <select id="ToCheck" class="form-control" ng-model="DayChild.OTHourLimit" name="To Check" tabindex="1">
                                                        <option value="">-Select-</option>
                                                        <option Value="0">0</option>
                                                        <option Value="1">1</option>
                                                        <option Value="2">2</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">OT Calculation </label>
                                            <div class="col-sm-8 ">
                                                <div class="select-style">
                                                    <select id="ToCheck" class="form-control" ng-model="DayChild.OTCalculation" name="To Check" tabindex="1">
                                                        <option value="">-Select-</option>
                                                        <option Value="0">0</option>
                                                        <option Value="1">1</option>
                                                        <option Value="2">2</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Overstay Limit </label>
                                            <div class="col-sm-8 ">
                                                <div class="select-style">
                                                    <select id="ToCheck" class="form-control" ng-model="DayChild.OverStayLimit" name="Over Stay Limit" tabindex="1">
                                                        <option value="">-Select-</option>
                                                        <option value="0">0</option>
                                                        <option value="1">1</option>
                                                        <option value="2">2</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

