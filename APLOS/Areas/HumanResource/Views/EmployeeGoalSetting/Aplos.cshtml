<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <div class="row">
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Performance Year</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" id="ddperfYear" ng-model="PerformanceYearName" name="PerformanceYear"
                                ng-options="item.Value as item.Text for item in PerformanceYearList" tabindex="2" >
                            <option value="0">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Select Employee<sup>*</sup></label>

                    <div class="col-sm-6">
                        <button ng-click="selectEmployee()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                    </div>

                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
    <div class="clearfix"></div>

    <div class="row" id="PerformanceGroupList" style="display: none">
        <div class="col-lg-12 col-md-12 ">
            <div ej-grid e-datasource="PerformanceGroupList" e-templaterefresh="refreshTemplate"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:20px;"
                 e-recorddoubleclick="SaveEmployeeGoalSettingChild">
                <div e-columns>
                    <div e-column e-headertext="Category" e-template="#category" e-textalign="center" e-width="80"></div>
                    <div e-column e-headertext="Sub Category" e-template="#subcategory" e-textalign="center" e-width="80"></div>
                    <div e-column e-headertext="Item Name" e-template="#username" e-textalign="center" e-width="80"></div>
                </div>
            </div>
            <script type="text/template" id="category">
                <input type="text" ng-model="data.Category" style="color:black; text-align:center" e-recorddoubleclick="SaveEmployeeGoalSettingChild"/>
            </script>
            <script type="text/template" id="subcategory">
                <input type="text" ng-model="data.SubCategory" style="color:black; text-align:center" e-recorddoubleclick="SaveEmployeeGoalSettingChild"/>
            </script>
            <script type="text/template" id="username">
                <input type="text" ng-model="data.Username" style="color:black; text-align:center" e-recorddoubleclick="SaveEmployeeGoalSettingChild"/>
            </script>

            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click=";" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        @*<li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                        <li> <button ng-click="" class="btn"><i class="glyphicon glyphicon-refresh"></i>Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>


    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div id="GridEdit" ej-grid e-datasource="" e-recorddoubleclick="" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="50"></div>
                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                <div e-column e-field="DOB" e-headertext="DOB" e-width="50"></div>
                <div e-column e-field="PresentAddress1" e-headertext="Present Address1" e-width="150"></div>
            </div>
        </div>
    </div>
    <confirm-modal></confirm-modal>

    <confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
    <confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to save without any shifts ?" data-ng-click-left-button="restoreChildShifts();" data-ng-click-right-button="SaveShifts();"></confirm-archive-generic>

    <!--   FOR EMPLOYEE DETAIL     -->
    <div class="modal fade site-modal in" id="EmployeePop" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg modellgModify ">
            <div class="modal-content">
                <div class="modal-header">Employee Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body form-elements form-horizontal">
                    <div class="col-md-12">
                        <div class="content-container-fluid" style="color:black;overflow:scroll">
                            <p>Please Select Employee Detail .</p>
                            <div style="color:black;" id="GridEmployee" ej-grid e-datasource="EmployeeList" e-recorddoubleclick="selEmp"
                                 e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                                <div e-columns>
                                    <div e-column e-field="SystemId" e-headertext="System Id" e-width="50"></div>
                                    <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="50"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                    <div e-column e-field="DOB" e-headertext="DOB" e-width="100"></div>
                                    <div e-column e-field="PresentAddress1" e-headertext="Present Address1" e-width="150"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50"></div>
                                    <div e-column e-field="DepartmentId" e-headertext="Department Id" e-width="50"></div>
                                    <div e-column e-field="DesignationGroupId" e-headertext="Designation Group Id" e-width="50"></div>
                                    <div e-column e-field="DesignationSystemID" e-headertext="Designation System ID" e-width="50"></div>
                                    <div e-column e-field="PositionID" e-headertext="Position ID" e-width="50"></div>
                                    <div e-column e-field="EmployeeCurrentStatus" e-headertext="EmployeeC urrent Status" e-width="50"></div>
                                    <div e-column e-field="EmpType" e-headertext="Emp Type" e-width="50"></div>
                                    <div e-column e-field="EmploymentType" e-headertext="Employment Type" e-width="50"></div>
                                    <div e-column e-field="JobLocationID" e-headertext="JobLocation ID" e-width="50"></div>
                                </div>

                            </div>


                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li>

                                <button ng-click="closeEmpPopUp();" class="btn"><i class=""></i> Close</button>
                            </li>
                        </ul>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--   FOR EMPLOYEE GOAL SETTING CHILD    -->
    <div class="modal fade site-modal in" id="PerfGrPop" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg modellgModify ">
            <div class="modal-content">
                <div class="modal-header">Employee Goal Setting <button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body form-elements form-horizontal">
                    <div class="col-md-12">
                        <div class="content-container-fluid" style="color:black;overflow:scroll">
                            <p>Please Fill the Detail .</p>
                            <div style="color:black;" id="GridEmployee" ej-grid e-datasource="EmployeeList" e-recorddoubleclick=""
                                 e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                                <div class="row" id="PerformanceGroupList" style="display: none">
                                    <div class="col-lg-12 col-md-12 ">
                                        <div ej-grid e-datasource="PerformanceGroupList" e-templaterefresh="refreshTemplate"
                                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:20px;">
                                            <div e-columns>
                                                <div e-column e-headertext="Objective Name" e-template="#ObjectiveName" e-textalign="center" e-width="80"></div>
                                                <div e-column e-headertext="Objective Detail" e-template="#ObjectiveDetail" e-textalign="center" e-width="80"></div>
                                                <div e-column e-headertext="Cost Saving If-Any" e-template="#CostSaving" e-textalign="center" e-width="80"></div>
                                                <div e-column e-headertext="Value" e-template="#Value" e-textalign="center" e-width="80"></div>
                                                <div e-column e-headertext="Attachment" e-template="#Attachment" e-textalign="center" e-width="80"></div>
                                                <div e-column e-headertext="Assesment Date" e-template="#AssesmentDate" e-textalign="center" e-width="80"></div>
                                                <div e-column e-headertext="Objective Name Closing Date" e-template="#ClosingDate" e-textalign="center" e-width="80"></div>
                                                <div e-column e-headertext="Max Story Points" e-template="#MaxStoryPoints" e-textalign="center" e-width="80"></div>
                                                <div e-column e-headertext="Remarks" e-template="#Remarks" e-textalign="center" e-width="80"></div>
                                            </div>
                                        </div>
                                        <script type="text/template" id="ObjectiveName">
                                            <input type="text" ng-model="data.ObjectiveName" style="color:black; text-align:center" />
                                        </script>
                                        <script type="text/template" id="ObjectiveDetail">
                                            <input type="text" ng-model="data.ObjectiveDetail" style="color:black; text-align:center" />
                                        </script>
                                        <script type="text/template" id="CostSaving">
                                            <input type="text" ng-model="data.CostSaving" style="color:black; text-align:center" />
                                        </script>
                                        <script type="text/template" id="Value">
                                            <input type="number" ng-model="data.Value" style="color:black; text-align:center" />
                                        </script>
                                        <script type="text/template" id="Attachment">
                                            <input type="file" ng-model="data.Attachment" style="color:black; text-align:center" />
                                        </script>
                                        <script type="text/template" id="AssesmentDate">
                                            <input type="text" ng-model="data.AssesmentDate" name="Date" datepicker=""
                                                   class="form-control ng-isolate-scope datepicker ng-empty ng-dirty ng-valid-parse ng-invalid ng-invalid-required
                                                   ng-valid-maxlength ng-touched" maxlength="50" tabindex="3" required="" autocomplete="off">

                                        </script>
                                        <script type="text/template" id="ClosingDate">
                                            <input type="text" ng-model="data.ClosingDate" name="Date" datepicker=""
                                                   class="form-control ng-isolate-scope datepicker ng-empty ng-dirty ng-valid-parse ng-invalid ng-invalid-required
                                                   ng-valid-maxlength ng-touched" maxlength="50" tabindex="3" required="" autocomplete="off">

                                        </script>
                                        <script type="text/template" id="MaxStoryPoints">
                                            <input type="number" ng-model="data.MaxStoryPoints" style="color:black; text-align:center" />
                                        </script>
                                        <script type="text/template" id="Remarks">
                                            <textarea class="form-control ng-pristine ng-valid ng-isolate-scope ng-empty ng-valid-maxlength ng-touched" 
                                                      rows="3" ng-model="ModelNew.Remarks" maxlength="50" tabindex="6"></textarea>
                                        </script>

                                        <div class="col-xs-12">
                                            <div class="common-btn">
                                                <ul class="list-inline text-right">
                                                    <li> <button ng-click="" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>

                                                    <li> <button ng-click="" class="btn"><i class="glyphicon glyphicon-refresh"></i>Clear</button></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>


                                </div>

                            </div>


                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li>

                                <button ng-click="close();" class="btn"><i class=""></i> Close</button>
                            </li>
                        </ul>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>