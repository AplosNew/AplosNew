<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  Manual Attendance Confirmation
</h3>
<div class="form-horizontal form-elements" id="mainContainer">
    <div id="Tab" ej-tab>
        <ul>
            <li><a href="#TabPending">All Pending Approval</a></li>
            <li><a href="#TabDateRange">Date Wise</a></li>

        </ul>

        <div id="TabPending">
            <div class="row">
                @*<div class="col-sm-12">*@
                <div id="GridChangeAttendanceBySingleDatePending" ng-init="chkinit()" ej-grid e-datasource="employeeAttendanceBySingleDatePending-"
                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-showstackedheader="true"
                     e-allowscrolling="true" e-minheight="400" e-gridlines="both" e-querycellinfo="queryCellInfo"
                     e-actioncomplete="actionCompletePending" e-height="400px" e-rowdatabound="rowDataBoundSingleEmployee"
                     e-filtersettings-filterType="excel">
                    <div e-stackedheaderrows>
                        <div e-stackedheaderrow>
                            <div e-stackedheadercolumns>
                                <div e-stackedheadercolumn e-headertext="Employee Additional Info" e-column="Id,Department,Designation,Section,SubSection"></div>
                                <div e-stackedheadercolumn e-headertext="Attendance Process Data" e-column="ProcessedInTime,ProcessedOutTime,DayStatus"></div>
                                <div e-stackedheadercolumn e-headertext="Original Punch Info" e-column="PunchInTime,PunchOutTime"></div>
                                <div e-stackedheadercolumn e-headertext="In Time Approval" e-column="InTime,Remarks,INLocationDesc"></div>
                                <div e-stackedheadercolumn e-headertext="Out Time Approval" e-column="OutTime,RemarksOUT,OutLocationDesc"></div>
                            </div>
                        </div>
                    </div>
                    <div e-columns>
                        <div e-column e-field="PDate" e-headertext="Work Date" e-width="100"></div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="150"></div>
                        <div e-column e-field="DayStatus" e-headertext="Day Status" e-width="50"></div>


                        <div e-column e-field="InTime" e-headertext="In Time" e-width="90"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="170"></div>
                        <div e-column e-field="INLocationDesc" e-headertext="Location" e-width="170"></div>
                        <div e-column e-template="#ApprovalINPending" e-headertext="" e-width="40"></div>
                        <div e-column e-field="OutTime" e-headertext="Out Time" e-width="90"></div>
                        <div e-column e-field="RemarksOUT" e-headertext="Remarks" e-width="170"></div>
                        <div e-column e-field="OutLocationDesc" e-headertext="Location" e-width="170"></div>
                        <div e-column e-template="#ApprovalOUTPending" e-headertext="" e-width="40"></div>



                        <div e-column e-field="ProcessedInTime" e-headertext="In Time" e-width="130"></div>
                        <div e-column e-field="ProcessedOutTime" e-headertext="Out Time" e-width="130"></div>

                        <div e-column e-field="PunchInTime" e-headertext="Punch In Time" e-width="150"></div>
                        <div e-column e-field="PunchOutTime" e-headertext="Punch Out Time" e-width="150"></div>

                        <div e-column e-field="Id" e-headertext="System Id" e-width="80" e-primarykey="true"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-width="150"></div>
                        <div e-column e-field="Designation" e-headertext="Designation" e-width="150"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-width="150"></div>
                        <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="150"></div>


                    </div>
                </div>


                <script type="text/template" id="ApprovalINPending">
                    <button ng-click="$parent.SaveSingleDayPending(this,'IN')" ng-disabled="data.isApprovedIN==true||data.InTime==''" class="btn" style="height: 30px;width: 30px; padding: 0px; margin: 0px;">
                        <i style="color:{{data.isApprovedIN==true||data.InTime==''?'inherit':'blue'}}" class="glyphicon glyphicon glyphicon-ok"></i>
                    </button>
                </script>
                <script type="text/template" id="ApprovalOUTPending">
                    <button ng-click="$parent.SaveSingleDayPending(this,'OUT')" ng-disabled="data.isApprovedOUT==true||data.OutTime==''" class="btn" style="height: 30px;width: 30px; padding: 0px; margin: 0px;">
                        <i style="color:{{data.isApprovedOUT==true||data.OutTime==''?'inherit':'blue'}}"  class="glyphicon glyphicon glyphicon-ok"></i>
                    </button>

                </script>

            </div>
        </div>

        <div id="TabDateRange">
            <div class="row">
                <div class="col-sm-12">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input e-dateformat="dd-MMM-yyyy" e-change="selectSigleDate" ej-datepicker e-value="FromDateSingleDate" e-width="100%" />
                            </div>
                        </div>

                    </div>
                </div>
            
                <div class="col-sm-12">
                    <div id="GridChangeAttendanceBySingleDate" ng-init="chkinit()" ej-grid e-datasource="employeeAttendanceBySingleDate"
                         e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-showstackedheader="true"
                         e-allowscrolling="true" e-minheight="400" e-gridlines="both" e-querycellinfo="queryCellInfo"
                         e-actioncomplete="actionCompleteSingleDay" e-height="400px" e-rowdatabound="rowDataBoundSingleEmployee"
                         e-filtersettings-filterType="excel">
                        <div e-stackedheaderrows>
                            <div e-stackedheaderrow>
                                <div e-stackedheadercolumns>
                                    <div e-stackedheadercolumn e-headertext="Employee Additional Info" e-column="Id,Department,Designation,Section,SubSection"></div>
                                    <div e-stackedheadercolumn e-headertext="Attendance Process Data" e-column="ProcessedInTime,ProcessedOutTime,DayStatus"></div>
                                    <div e-stackedheadercolumn e-headertext="Original Punch Info" e-column="PunchInTime,PunchOutTime"></div>
                                    <div e-stackedheadercolumn e-headertext="In Time Approval" e-column="InTime,Remarks,INLocationDesc"></div>
                                    <div e-stackedheadercolumn e-headertext="Out Time Approval" e-column="OutTime,RemarksOUT,OutLocationDesc"></div>
                                </div>
                            </div>
                        </div>
                        <div e-columns>

                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="150"></div>
                            <div e-column e-field="DayStatus" e-headertext="Day Status" e-width="50"></div>


                            <div e-column e-field="InTime" e-headertext="In Time" e-width="90"></div>
                            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="170"></div>
                            <div e-column e-field="INLocationDesc" e-headertext="Location" e-width="170"></div>
                            <div e-column e-template="#ApprovalIN" e-headertext="" e-width="40"></div>
                            <div e-column e-field="OutTime" e-headertext="Out Time" e-width="90"></div>
                            <div e-column e-field="RemarksOUT" e-headertext="Remarks" e-width="170"></div>
                            <div e-column e-field="OutLocationDesc" e-headertext="Location" e-width="170"></div>
                            <div e-column e-template="#ApprovalOUT" e-headertext="" e-width="40"></div>



                            <div e-column e-field="ProcessedInTime" e-headertext="In Time" e-width="130"></div>
                            <div e-column e-field="ProcessedOutTime" e-headertext="Out Time" e-width="130"></div>

                            <div e-column e-field="PunchInTime" e-headertext="Punch In Time" e-width="150"></div>
                            <div e-column e-field="PunchOutTime" e-headertext="Punch Out Time" e-width="150"></div>

                            <div e-column e-field="Id" e-headertext="System Id" e-width="80" e-primarykey="true"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="150"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-width="150"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="150"></div>
                            <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="150"></div>


                        </div>
                    </div>

                </div>


                <style type="text/css">
                    .e-grid .e-templatecell {
                        padding: 0px 0px 0px 0px;
                    }
                </style>


                <script type="text/template" id="ApprovalIN">
                    <button ng-click="$parent.SaveSingleDay(this,'IN')" ng-disabled="data.isApprovedIN==true||data.InTime==''" class="btn" style="height: 30px;width: 30px; padding: 0px; margin: 0px;">
                        <i style="color:{{data.isApprovedIN==true||data.InTime==''?'inherit':'blue'}}" class="glyphicon glyphicon glyphicon-ok"></i>
                    </button>
                </script>
                <script type="text/template" id="ApprovalOUT">
                    <button ng-click="$parent.SaveSingleDay(this,'OUT')" ng-disabled="data.isApprovedOUT==true||data.OutTime==''" class="btn" style="height: 30px;width: 30px; padding: 0px; margin: 0px;">
                        <i  style="color:{{data.isApprovedOUT==true||data.OutTime==''?'inherit':'blue'}}" class="glyphicon glyphicon glyphicon-ok"></i>
                    </button>

                </script>

            </div>

        </div>
    </div>
</div>

