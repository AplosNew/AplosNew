<togglable name="Disciplinary Action Category"></togglable>
<div class="form-elements form-horizontal" ng-form name="disciplinaryActionCategoryNewForm" id="MainDivId">
    <input type="hidden" ng-model="disciplinaryActionCategoryNew.Id">

    <div class="row">

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="disciplinaryActionCategoryNew.Sequence" e-width="100" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="disciplinaryActionCategoryNew.ShortName" class="form-control" maxlength="15" tabindex="3">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="disciplinaryActionCategoryNew.UserName" class="form-control" tabindex="5" maxlength="50">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="disciplinaryActionCategoryNew.Description" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="disciplinaryActionCategoryNew.Code" class="form-control" tabindex="10" maxlength="10">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="disciplinaryActionCategoryNew.StandardName" class="form-control" tabindex="4" maxlength="50">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="disciplinaryActionCategoryNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="disciplinaryActionCategoryNew.Active" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="SaveMaster();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="ClearM();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

        <div class="col-sm-12">
            <div class="form-group">
                <label class="col-sm-2 control-label">Show Cause Letter Applicable</label>
                <div class="col-sm-2">
                    <div class="checkbox-site" style="margin-top: 6px;">
                        <label>
                            <input type="checkbox" ng-model="disciplinaryActionCategoryNew.IsShowCaseLetter" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-12">
            <div class="common-btn" ng-show="disciplinaryActionCategoryNew.IsShowCaseLetter == true">
                <ul class="list-inline text-left">
                    <li> <button ng-click="AddNew();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus"></i>Add</button></li>
                </ul>

            </div>
        </div>

        <div class="row">
            <div class="col-sm-12 table-responsive modal-table" id="GridDettails" ng-show="disciplinaryActionCategoryNew.IsShowCaseLetter == true">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Sequence<sup>*</sup></th>
                            <th>Letter Issue Day<sup>*</sup></th>
                            <th>Is Separable<sup>*</sup></th>
                            <th>Is Active<sup>*</sup></th>
                            <th>Description<sup>*</sup></th>
                            <th>Add Letter Details<sup>*</sup></th>
                            <th class="col-sm-1 text-right">Edit</th>
                            <th class="col-sm-1 text-right">Remove</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in ShowCauseLetterList">
                            <td>{{x.Sequence}}</td>
                            <td>{{x.LetterIssueDay}}</td>
                            <td>{{x.Separable}}</td>
                            <td>{{x.Active}}</td>
                            <td>{{x.Description}}</td>

                            <td>
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="AddDetails(x, $index);" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus"></i>Add Details</button></li>
                                </ul>
                            </td>

                            <td class="text-right">
                                <ul class="list-inline">
                                    <li><button ng-click="Edit(x, $index);" class="btn btn-action tooltip-here"><i class="icon-edit"></i></button></li>
                                </ul>
                            </td>

                            <td class="text-right">
                                <ul class="list-inline">
                                    <li><button ng-click="removePopup(x, $index);" class="btn btn-action tooltip-here"><i class="glyphicon glyphicon-remove"></i></button></li>
                                </ul>
                            </td>

                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <confirm-archive-generic modalid="removerPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="removeRow();"></confirm-archive-generic>

    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div style="color:black;" id="GridDiciplinaryActionCategory" ej-grid e-datasource="ModelList"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
             e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="60"></div>
                <div e-column e-field="Code" e-headertext="Code" e-width="60"></div>
                <div e-column e-field="ShortName" e-headertext="ShortName" e-width="60"></div>
                <div e-column e-field="StandardName" e-headertext="StandardName" e-width="60"></div>
                <div e-column e-field="UserName" e-headertext="UserName" e-width="60"></div>
                <div e-column e-field="Description" e-headertext="Description" e-width="60"></div>
                <div e-column e-field="Active" e-headertext="Active" e-width="60"></div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteMaster();"></confirm-archive-generic>

<ej-dialog id="DisciplinaryActionInfo" title="Shaw Case Letter" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#MainDivId" e-close="onDialogClose" e-minwidth="700" e-maxheight="600" e-open="enableBtn">
    <div class="row form-horizontal form-elements" ng-form>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ShowCauseLetterDetailsModel.Sequence" e-width="100" />
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" name="Short Name" ng-model="ShowCauseLetterDetailsModel.Description" class="form-control" maxlength="50" tabindex="3">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Is Active</label>
                <div class="col-sm-8" style="margin-top: 6px;">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ShowCauseLetterDetailsModel.IsActive" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Letter Issue Day<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" name="Short Name" only-numbers ng-model="ShowCauseLetterDetailsModel.LetterIssueDay" class="form-control" maxlength="15" tabindex="3">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Is Separable</label>
                <div class="col-sm-8" style="margin-top: 6px;">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ShowCauseLetterDetailsModel.IsSeparable" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="saveDetails();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                </ul>
            </div>
        </div>

    </div>

</ej-dialog>


<ej-dialog id="DisciplinaryActionChildInfo" title="Letter Information" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#MainDivId" e-close="onDialogClose" e-minwidth="800" e-maxheight="800" e-open="enableBtn">
    <div class="row form-horizontal form-elements" ng-form>

        <div class="col-sm-12">
            <div class="form-group">
                <label class="col-sm-2 control-label">Letter Description: </label>
                <label class="col-sm-4 control-label" style="padding-left:10px;">{{Description}} </label>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Letter Language<sup>*</sup></label>
                    <div class="col-sm-6">
                        <div class="select-style">
                            <select id="SalaryHeadID" class="form-control" ng-model="ShowCauseLetterChildModel.LetterLanguage" name="Leave Type" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in LanguageList" value="{{option.Id}}">{{option.UserName}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="form-group" show-errors>
                    <label class="col-sm-6 control-label">Letter Format <sup>*</sup></label>
                    <div class="col-sm-6">
                        <input type="text" name="Short Name" ng-model="ShowCauseLetterChildModel.LetterFormat" class="form-control" maxlength="100" required tabindex="3">
                    </div>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">IsActive</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input type="checkbox" ng-model="ShowCauseLetterChildModel.IsActive" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

        </div>


        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="col-sm-12">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Letter Name <sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" name="Short Name" ng-model="ShowCauseLetterChildModel.LetterName" class="form-control" maxlength="100" required tabindex="3">
                    </div>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">IsDefault</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site" style="margin-top: 6px;">
                            <label>
                                <input type="checkbox" ng-model="ShowCauseLetterChildModel.IsDefault" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="saveChild();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUpChild" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="ClearC();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;" id="GridDiciplinaryActionCategoryChild" ej-grid e-datasource="ModelChildList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclickChild" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="LetterFormat" e-headertext="Letter Format" e-width="60"></div>
                    <div e-column e-field="LetterName" e-headertext="LetterName" e-width="60"></div>
                    <div e-column e-field="IsDefault" e-headertext="Default" e-width="60"></div>
                    <div e-column e-field="IsActive" e-headertext="Active" e-width="60"></div>
                </div>
            </div>
        </div>

        <confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteChild();"></confirm-archive-generic>

    </div>

</ej-dialog>