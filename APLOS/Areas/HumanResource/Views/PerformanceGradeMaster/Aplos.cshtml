<togglable name="Performance Attribute Master"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">

    <div class="row">
        <input type="hidden" name="Id" ng-model="ModelNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Attribute Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Attribute Category" ng-model="ModelNew.AttributeCategory" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Defination</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Defination" maxlength="50" tabindex="6"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Attribute<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Attribute" ng-model="ModelNew.Attribute" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="50" tabindex="6"></textarea>
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="table-responsive aplos-grid-toggle">
            <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-field="AttributeCategory" e-headertext="Attribute Category" e-width="2"></div>
                    <div e-column e-field="Attribute" e-headertext="Category" e-width="3"></div>
                    <div e-column e-field="Defination" e-headertext="Defination" e-width="3"></div>

                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="3"></div>

                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
