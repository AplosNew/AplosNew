<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Designation</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Service" role="tab" data-toggle="tab">Furniture master</a></li>

        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="form-elements form-horizontal" ng-form name="Designation" id="DesignationForm">
                <input type="hidden" ng-model="Designation.Id">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">

                    </div>
                    @* COLUMN 2 *@
                    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">

                    </div>
                </div>
            </div>
            <div class="row">
                <div id="TabEmployee">
                    <br />
                    <div class="col-xs-12">
                        <div id="GridOTCompensation" ej-grid style="z-index:3;"
                             e-templaterefresh="ActiveEmpcbx"
                             e-datasource="ModelList"
                             e-rowdatabound="onactivedatabound"
                             e-allowfiltering="true"
                             e-allowpaging="true"
                             e-allowsorting="true"
                             e-enabletouch="false"
                             e-responsive="true"
                             e-allowselection="true"
                             e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateNewlyJoined" e-template="#checkboxTemplateNewlyJoined" e-textalign="center" e-width="30"></div>

                                <div e-column e-field="SystemId" e-headertext="Employee Id" e-width="70"></div>

                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                                <div e-column e-field="Duration" e-headertext="Duration" e-width="80"></div>
                                <div e-column e-field="Remarks" e-headertext="Remark" e-width="100"></div>


                            </div>
                        </div>
                        <div class="common-btn">

                            <div class="col-xs-12 col-lg-12 col-md-12">
                                <ul class="list-inline text-right">
                                    <li> <button class="btn" ng-click="viewOTCompensatory()" tabindex="9"><i class="glyphicon glyphicon-save"></i> Save</button></li>

                                </ul>
                            </div>

                        </div>
                    </div>

                    <script type="text/template" id="checkboxTemplateNewlyJoined">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelectSlrProc" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplateNewlyJoined">
                        <input type="checkbox" id="cbxhead" />
                    </script>
                </div>
            </div>
        </div>
        <!--
         / ---------------------------------------------------------------------------------------\
         \ ---------------------------------------------------------------------------------------/
        -->
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="form-elements form-horizontal" ng-form name="FurnitureMasterForm" id="FurnitureMasterForm">
                <input type="hidden" ng-model="FurnitureMaster.Id">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">


                    </div>
                    @* COLUMN 2 *@
                    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">


                    </div>
                </div>
            </div>
            <div class="row">
                <div id="TabEmployee">
                    <br />
                    <div class="col-xs-12">
                        <div id="GridOTCompensation" ej-grid style="z-index:3;"
                             e-templaterefresh="ActiveEmpcbx"
                             e-datasource="ModelList"
                             e-rowdatabound="onactivedatabound"
                             e-allowfiltering="true"
                             e-allowpaging="true"
                             e-allowsorting="true"
                             e-enabletouch="false"
                             e-responsive="true"
                             e-allowselection="true"
                             e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateNewlyJoined" e-template="#checkboxTemplateNewlyJoined" e-textalign="center" e-width="30"></div>

                                <div e-column e-field="SystemId" e-headertext="Employee Id" e-width="70"></div>

                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                                <div e-column e-field="Duration" e-headertext="Duration" e-width="80"></div>
                                <div e-column e-field="Remarks" e-headertext="Remark" e-width="100"></div>


                            </div>
                        </div>
                        <div class="common-btn">

                            <div class="col-xs-12 col-lg-12 col-md-12">
                                <ul class="list-inline text-right">
                                    <li> <button class="btn" ng-click="viewOTCompensatory()" tabindex="9"><i class="glyphicon glyphicon-save"></i> Save</button></li>

                                </ul>
                            </div>

                        </div>
                    </div>

                    <script type="text/template" id="checkboxTemplateNewlyJoined">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelectSlrProc" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplateNewlyJoined">
                        <input type="checkbox" id="cbxhead" />
                    </script>
                </div>
            </div>
        </div>



    </div>
</div>