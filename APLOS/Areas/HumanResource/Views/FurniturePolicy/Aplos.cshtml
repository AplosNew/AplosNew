<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name</label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="ModelNew.EffectiveDate" datepicker class="form-control" required>
                </div>
            </div>
            

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">

                        <input type="text" name="Responsible Person" ng-model="Employee" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="OpeEmployeePopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Category</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.EmployeeCategory" required name="Type" tabindex="2">
                         <option value="">--Select--</option>
                         <option ng-repeat="option in EmployeeCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ModelNew.ActiveInactive" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="viewFurniturePolicyGrids()" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i>View</button></li>

            </ul>
        </div>
    </div>

    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Designation Master</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Service" role="tab" data-toggle="tab">Furniture Master</a></li>

            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

                <div class="row">
                    <div id="TabEmployee">
                        <br />
                        <div class="col-xs-12">
                            <div id="designationTab" ej-grid style="z-index:3;"
                                 e-templaterefresh="ActiveEmpcbxD"
                                 e-datasource="DesignationGridList"
                                 e-rowdatabound="onactivedatabound"
                                 e-allowfiltering="true"
                                 e-allowpaging="true"
                                 e-allowsorting="true"
                                 e-enabletouch="false"
                                 e-responsive="true"
                                 e-allowselection="true"
                                 e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="All" e-headertemplateid="#headerTemplateDesignation" e-template="#checkboxTemplateDesignation" e-textalign="center" e-width="30"></div>
                                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-isprimarykey="true" e-visible="true"></div>
                                    <div e-column e-field="UserName" e-headertext="User Name" e-width="100"></div>
                                    <div e-column e-field="DesignationGroup" e-headertext="Designation Group" e-width="100"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-width="100"></div>


                                </div>
                            </div>
                            <script type="text/template" id="checkboxTemplateDesignation">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelectSlrProc" />
                            </script>
                            <script type="text/x-jsrender" id="headerTemplateDesignation">
                                <input type="checkbox" id="Desigcbxhead" />
                            </script>
                        </div>

                        
                    </div>
                </div>
            </div>

            <!--
     / ---------------------------------------------------------------------------------------\
     \ ---------------------------------------------------------------------------------------/
    -->
          
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div id="TabEmployee">
                        <br />
                       
                        <div class="col-xs-12">
                            <div id="GridOTCompensation" ej-grid style="z-index:3;"
                                 e-datasource="FurnitureGridList"
                                 e-templaterefresh="ActiveFurniturecbx"
                                 e-rowdatabound="onactivedatabound"
                                 e-allowfiltering="true"
                                 e-allowpaging="true"
                                 e-allowsorting="true"
                                 e-enabletouch="false"
                                 e-responsive="true"
                                 e-allowselection="true"
                                 e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-headertext="All" e-headertemplateid="#headerTemplateNewlyJoined" e-template="#checkboxTemplateNewlyJoined" e-textalign="center" e-width="30"></div>

                                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-isprimarykey="true" e-visible="false"></div>
                                    <div e-column e-field="Sequence" e-headertext="Sequence" e-width="40"></div>
                                    <div e-column e-field="Code" e-headertext="Code" e-width="60"></div>
                                    <div e-column e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
                                    <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="100"></div>
                                    <div e-column e-field="UserName" e-headertext="User Name" e-width="100"></div>
                                    <div e-column e-field="Category" e-headertext="Category" e-width="100"></div>
                                    <div e-column e-field="SubCategory" e-headertext="SubCategory" e-width="100"></div>
                                    <div e-column e-field="Type" e-headertext="Grade" e-width="50"></div>
                                    <div e-column e-field="Budget" e-headertext="Budget" e-width="70"></div>
                                    <div e-column e-headertext="Quantity" e-template="#Quantity" e-textalign="center" e-width="100"></div>
                                </div>
                            </div>
                            <script type="text/template" id="checkboxTemplateNewlyJoined">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelectSlrProc" />
                            </script>
                            <script type="text/x-jsrender" id="headerTemplateNewlyJoined">
                                <input type="checkbox" id="cbxhead" />
                            </script>
                            <script type="text/template" id="Quantity">
                                <input type="number" name="Quantity" ng-model="data.Quantity" class="form-control" style="color:black; text-align:center">
                            </script>
                        </div>

                        
                    </div>
                </div>
            </div>


            <div class="common-btn" style="margin-top:10px; margin-bottom:30px">

                <div class="col-xs-12 col-lg-12 col-md-12">
                    <ul class="list-inline text-right">
                        <li> <button class="btn" ng-click="Save()" tabindex="9"><i class="glyphicon glyphicon-save"></i> Save</button></li>

                    </ul>
                </div>

            </div>

        </div>
    </div>
</div>

<!--
            / -------------------------------------EMPLOYEE POP UP--------------------------------------------------\
            \ ---------------------------------------------------------------------------------------/
           -->
<div class="modal fade site-modal in" id="EmployeePop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Employee List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Employee</p>
                        <div style="color:black;" id="GridEntity" ej-grid e-datasource="EmployeeList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="true" e-responsive="true"
                             e-recorddoubleclick="doubleEmploye">
                            <div e-columns>
                                <div e-column e-field="Entity" e-headertext="Entity" e-width="50"></div>
                                
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="100"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="50"></div>

                                <div e-column e-field="Designation" e-headertext="Designation" e-width="50"></div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>