<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Furniture master</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Service" role="tab" data-toggle="tab"> Designation </a></li>

        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="form-elements form-horizontal" ng-form name="FurnitureMasterNew" id="FurnitureMasterForm">
                <input type="hidden" ng-model="Designation.Id">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
                        <div class="form-group">
                            <label class="col-sm-2 control-label">Furniture Master</label>
                            <div class="col-sm-6 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="FurnitureMasterNew.FurnitureMaster" required name="Type"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in FurnitureMasterList" value="{{option.Text}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="common-btn">

                            <div class="col-xs-12 col-lg-12 col-md-12">
                                <ul class="list-inline text-right">
                                    <li> <button class="btn" ng-click="getFurnitureGridView()" tabindex="9"><i class="glyphicon glyphicon-save"></i> View</button></li>

                                </ul>
                            </div>

                        </div>
                    </div>
                    @* COLUMN 2 *@
                <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
                   
                </div>
                </div>
            </div>
            <div class="row">
                <div id="TabEmployee">
                    <br />
                    <div class="col-xs-12">
                        <div id="GridOTCompensation" ej-grid style="z-index:3;"
                             e-templaterefresh="ActiveEmpcbx"
                             e-datasource="FurnitureGridList"
                             e-rowdatabound="onactivedatabound"
                             e-allowfiltering="true"
                             e-allowpaging="true"
                             e-allowsorting="true"
                             e-enabletouch="false"
                             e-responsive="true"
                             e-allowselection="true"
                             e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateNewlyJoined" e-template="#checkboxTemplateNewlyJoined" e-textalign="center" e-width="30"></div>

                                <div e-column e-field="Id" e-headertext="Id" e-width="50" e-isprimarykey="true" e-visible="true"></div>
                                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="80"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="60"></div>
                                <div e-column e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
                                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="100"></div>
                                <div e-column e-field="UserName" e-headertext="User Name" e-width="100"></div>
                                <div e-column e-field="Category" e-headertext="Category" e-width="100"></div>
                                <div e-column e-field="SubCategory" e-headertext="SubCategory" e-width="100"></div>
                                <div e-column e-field="Type" e-headertext="Type" e-width="100"></div>
                                <div e-column e-field="Budget" e-headertext="Budget" e-width="80"></div>
                            </div>
                        </div>
                        <div class="common-btn">

                            <div class="col-xs-12 col-lg-12 col-md-12">
                                <ul class="list-inline text-right">
                                    <li> <button class="btn" tabindex="9"><i class="glyphicon glyphicon-save"></i> Save</button></li>

                                </ul>
                            </div>

                        </div>
                    </div>

                    <script type="text/template" id="checkboxTemplateNewlyJoined">
                        <input type="checkbox"  ej-checkbox class="rowCheckbox" e-checked="data.IsSelectSlrProc" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplateNewlyJoined">
                        <input type="checkbox" id="cbxhead" />
                    </script>
                </div>
            </div>
        </div>
        <!--
         / ---------------------------------------------------------------------------------------\
         \ ---------------------------------------------------------------------------------------/
        -->
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="form-elements form-horizontal" ng-form name="DesignationMasterNewForm" id="DesignationMasterForm">
                <input type="hidden" ng-model="FurnitureMaster.Id">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
                        <div class="form-group">
                            <label class="col-sm-2 control-label">Furniture Master</label>
                            <div class="col-sm-6 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="DesignationMasterNew.DesignationMaster" required name="Type"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in DesignationMasterList" value="{{option.Text}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="common-btn">

                            <div class="col-xs-12 col-lg-12 col-md-12">
                                <ul class="list-inline text-right">
                                    <li> <button class="btn" ng-click="getDesignationGridView()" tabindex="9"><i class="glyphicon glyphicon-save"></i> View</button></li>

                                </ul>
                            </div>

                        </div>

                    </div>
                    @* COLUMN 2 *@
                    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">


                    </div>
                </div>
            </div>
            <div class="row">
                <div id="TabEmployee">
                    <br />
                    <div class="col-xs-12">
                        <div  ej-grid style="z-index:3;"
                             
                             e-datasource="DesignationGridList"
                             e-rowdatabound="onactivedatabound"
                             e-allowfiltering="true"
                             e-allowpaging="true"
                             e-allowsorting="true"
                             e-enabletouch="false"
                             e-responsive="true"
                             e-allowselection="true"
                             e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateNewlyJoined" e-template="#checkboxTemplateDesignation" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="Id" e-headertext="Id" e-width="50" e-isprimarykey="true" e-visible="true"></div>                               
                                <div e-column e-field="UserName" e-headertext="User Name" e-width="100"></div>
                                <div e-column e-field="DesignationGroup" e-headertext="Designation Group" e-width="100"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                                <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-width="100"></div>
                                

                            </div>
                        </div>
                        <div class="common-btn">

                            <div class="col-xs-12 col-lg-12 col-md-12">
                                <ul class="list-inline text-right">
                                    <li> <button class="btn"  tabindex="9"><i class="glyphicon glyphicon-save"></i> Save</button></li>

                                </ul>
                            </div>

                        </div>
                    </div>

                    <script type="text/template" id="checkboxTemplateDesignation">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelectSlrProc" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplateDesignation">
                        <input type="checkbox" id="Desigcbxhead" />
                    </script>
                </div>
            </div>
        </div>



    </div>
</div>