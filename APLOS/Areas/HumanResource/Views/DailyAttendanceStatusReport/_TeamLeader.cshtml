<div class="modal fade site-modal in" id="TeamPopupId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Team Leader List <button type="button" class="close" ng-click="closeTeamLeaderPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">

                <div class="col-md-12">
                    <div class="content-container-fluid">

                        <div style="color:black;" ej-grid e-datasource="TeamLeaderList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-recorddoubleclick="doubleTeamLeader">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="100"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="50"></div>
                                <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-width="50"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="50"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="50"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="50"></div>
                                <div e-column e-field="Entity" e-headertext="Entity" e-width="50"></div>

                            </div>
                        </div>

                        <script type="text/template" id="EntitycheckboxTemplate">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="CreateEntityWithParameterSetup();" class="btn"> Add</button></li>
                    <li><button ng-click="closeTeamLeaderPopUp();" class="btn"> Close</button></li>
                </ul>

            </div>
        </div>
    </div>
</div>

