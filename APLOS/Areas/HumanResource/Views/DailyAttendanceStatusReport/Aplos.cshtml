<togglable name=" {{title}}"></togglable>
<div class="form-elements form-horizontal">
    <div class="row" ng-form name="ModelNewForm">
        @*COLUMN 1*@
        <div class="col-xs-12 col-sm-8 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="ModelNew.FromDate" name="From Date" datepicker class="form-control" maxlength="50" tabindex="0" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">In Status<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.InStatus" required name="In Status"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in InStatusList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Category</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.EmployeecategoryId" name="Employee Category Id"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in EmpCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsible Person</label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">

                        <input type="text" name="Responsible Person" ng-model="ModelNew.EmployeeName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="OpeEmployeePopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="ClearEmployeePopup()" class="btn single-small-btn" tabindex="2"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>


        </div>

        @*COLUMN 2*@
        <div class="col-xs-12 col-sm-8 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="ModelNew.ToDate" name="To Date" datepicker class="form-control" maxlength="50" tabindex="0" required>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Team Leader</label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">

                        <input type="text" name="Responsible Person" ng-model="ModelNew.TeamLeader" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="OpenTeamLeaderPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="ClearTeamLeaderPopUp()" class="btn single-small-btn" tabindex="2"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Shift</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.ShiftId" name="Process"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in ShiftList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Status</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.EmployeeStatus" name="Process"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in EmpStatusList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @Html.Partial("~/Areas/HumanResource/Views/DailyAttendanceStatusReport/_FavoritePopup.cshtml")


        <div class="common-btn">
            <ul class="list-inline text-right">
                @* <li> <button ng-click="XlsSalaryUnDisburseReport();" class="btn" tabindex="9"><i class="glyphicon glyphicon-download-alt"></i> Download</button></li>*@
                <li> <button class="btn" ng-click="OpenFavoritePopUp();" tabindex="9"><i class="glyphicon glyphicon-flag"></i> Add Favourite</button></li>
                <li> <button class="btn" ng-click="GetDailyAttendanceStatus();" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>
                <li> <button class="btn" ng-click="Clear();" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>

            </ul>
        </div>

    </div>
    <div class="">
        <div style="color:black;" id="Grid" ej-grid e-datasource="DailyAttendanceStatusList"
             e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick="recorddoubleclick" e-allowfiltering="true" e-allowpaging="true"
             e-allowsorting="true" e-allowscrolling="true" e-filtersettings-filterType="excel" e-enabletouch="true"
             e-allowselection="true" e-detailsdatabound="detailgrid">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Medicine Receipt Id" e-visible="false" e-width="50"></div>
                <div e-column e-field="SrlNo" e-headertext="SrlNo" e-width="80"></div>
                <div e-column e-type="date" e-field="WorkDate" e-headertext="Work Date" e-width="80"></div>
                <div e-column e-field="Entity" e-headertext="Entity" e-width="80"></div>
                <div e-column e-field="Division" e-headertext="Division" e-width="100"></div>
                <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>

                <div e-column e-field="Section" e-headertext="Section" e-width="150"></div>

                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="150"></div>
                <div e-column e-field="Activity" e-headertext="Activity" e-width="150"></div>
                <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                <div e-column e-field="GivenDesignation" e-headertext="Given Designation" e-width="100"></div>
                <div e-column e-field="Shift" e-headertext="Shift" e-width="100"></div>
                <div e-column e-field="BudgetCode" e-headertext="Budget Code" e-width="100"></div>
                <div e-column e-field="EmployeeCode" e-headertext="EmployeeCode" e-width="100"></div>
                <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="100"></div>
                <div e-column e-field="State" e-headertext="State" e-width="100"></div>
                <div e-column e-field="MobileNo" e-headertext="Mobile No" e-width="100"></div>
                <div e-column e-type="date" e-field="DOJ" e-headertext="DOJ" e-width="100"></div>
                <div e-column e-field="DayStatus" e-headertext="DayStatus" e-width="100"></div>
                <div e-column e-field="InTime" e-headertext="InTime" e-width="100"></div>
                <div e-column e-field="InStatus" e-headertext="InStatus" e-width="100"></div>
                <div e-column e-type="number" e-field="LateIn" e-headertext="LateIn" e-width="100"></div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="XlsSalaryUnDisburseReport();" class="btn" tabindex="9"><i class="glyphicon glyphicon-download-alt"></i> Download</button></li>

            </ul>
        </div>
    </div>
</div>


<div class="aplos-grid-toggle">
    <div class="row">
           
            <div style="color:black;" id="Grid" ej-grid e-datasource="FavoriteList"
                 e-templaterefresh="refreshTemplateMasterOrderOperation" e-recorddoubleclick="Get"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                 e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true"
                 e-detailsdatabound="detailgrid">
                <div e-columns>                    
                    <div e-column e-field="Id" e-headertext="Medicine Receipt Id" e-visible="false" e-width="150"></div>
                    <div e-column e-field="UserId" e-headertext="User Code" e-width="50"></div>
                    <div e-column e-field="User" e-headertext="User" e-width="50"></div>
                    <div e-column e-field="FavoriteName" e-headertext="Favorite Filter Name" e-width="50"></div>
                    <div e-column e-field="FromDate" e-headertext="From Date" e-width="50"></div>
                    <div e-column e-field="ToDate" e-headertext="To Date" e-width="50"></div>
                    <div e-column e-field="InStatus" e-headertext="InStatus" e-width="50"></div>
                    
                </div>
            </div>      
       
    </div>
    
</div>

@Html.Partial("~/Areas/Productions/Views/Parameter/_ResponsiblePerson.cshtml")
@Html.Partial("~/Areas/HumanResource/Views/DailyAttendanceStatusReport/_TeamLeader.cshtml")
