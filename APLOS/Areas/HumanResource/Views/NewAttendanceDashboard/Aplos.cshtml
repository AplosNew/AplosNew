
<style type="text/css">
    #myDIV {
        width: 100%;
        text-align: center;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background: #a2f1ff;
        color: #080076;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .modal-table {
        position: relative;
        height: 300px;
        overflow: auto;
    }
    .modal {
        overflow-y: auto;
    }
    .table-responsive {
        display: block;
    }

    td, th {
        padding: 10px;
    }
</style>
<div id="MainDiv">
    <div>
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-4">
                        <div class="col-md-4"><span style="font-size: 19px;margin-left: -15%;margin-bottom:10px;"><span class="glyphicon glyphicon-stats"></span>&nbsp;{{title}}</span></div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Date" ng-model="Date" datepicker class="form-control" tabindex="4" style="max-height:50px;">

                            </div>
                        </div>
                    </div>
                   
                </div>
                <div class="row">

                    <div id="filters">

                    </div>


                    <div class="col-md-1 text-right">
                        <button type="button" class="btn single-btn" ng-click="filterComplete()" style="margin-top:10px;"><i class="glyphicon glyphicon-arrow-down"></i> Generate </button>
                    </div>
                    <div class="col-md-1  text-right" style="margin-left:20px;margin-top:10px;">
                        <button type="button" class="btn single-btn" ng-click="clearFilters()"><i class="glyphicon glyphicon-repeat"></i> Clear Filters </button>
                    </div>
                   
                </div>

                <div class="row">

                    <div id="getGridData" ej-grid e-datasource="GridData"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true" style="margin-top:30px;">
                        <div e-columns>
                            <div e-column e-field="BudgetId" e-type="number" e-headertext="Budget" e-width="50"></div>
                            <div e-column e-field="OnRoll" e-type="number" e-headertext="On Roll" e-width="50"></div>
                            <div e-column e-field="InStat" e-type="number" e-headertext="In" e-width="50"></div>
                            <div e-column e-field="EarlyIn" e-type="number" e-headertext="Early In" e-width="50"></div>
                            <div e-column e-field="LateIn" e-type="number" e-headertext="Late In" e-width="50"></div>
                            <div e-column e-field="InMissing" e-type="number" e-headertext="In Missing" e-width="50"></div>
                            <div e-column e-field="OD" e-type="number" e-headertext="OD" e-width="50"></div>
                            <div e-column e-field="DayStatus" e-type="number" e-headertext="WO/H/CO" e-width="50"></div>
                            <div e-column e-field="Leave" e-type="number" e-headertext="Leave" e-width="50"></div>
                            <div e-column e-field="Other" e-type="number" e-headertext="Other" e-width="50"></div>
                           
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>


</div>
