<togglable name="Legal Salary Grade"></togglable>
<div class="form-horizontal" ng-form name="legalSalaryGradeNewForm">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="legalSalaryGradeNew.CompanyId"
                            ng-change="getPlant();" ng-options="item.Value as item.Text for item in companyList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>

    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="legalSalaryGradeNew.PlantId" name="Plant" ng-change="getData();GetSequence();getCurrencyRuleList();" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>

    <div class="form-elements">

        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General Info</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="salaryHead" role="tab" data-toggle="tab">Salary Head</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form name="legalSalaryFormTab1">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" name="Sequence" ng-model="legalSalaryGradeNew.Sequence" class="form-control" required tabindex="1">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="ShortName" ng-model="legalSalaryGradeNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="UserName" ng-model="legalSalaryGradeNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="legalSalaryGradeNew.Description" tabindex="7" maxlength="250"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Active</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="legalSalaryGradeNew.Active">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Code" ng-model="legalSalaryGradeNew.Code" class="form-control" required tabindex="2" maxlength="10">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="StandardName" ng-model="legalSalaryGradeNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Currency Rule<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select submit-="true" ng-model="legalSalaryGradeNew.CurrencyRuleMasterId" class="form-control" name="Currency rule" ng-disabled="legalSalaryGradeHeadList.length>0"
                                                ng-options="item.Value as item.Text for item in currencyRuleList" required tabindex="6">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="legalSalaryGradeNew.Remarks" maxlength="250" tabindex="8"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row" ng-form name="legalSalaryFormTab2">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <ul class="common-btn list-inline text-left">
                                <li><button ng-click="popUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Add Salary Head</button></li>
                            </ul>
                        </div>
                        <div class="clearfix"></div>
                        <div class="table-responsive modal-table col-md-12" ng-show="legalSalaryGradeHeadList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th ng-show="legalSalaryGradeHeadList.length>1">Sort</th>
                                        <th>Sequence</th>
                                        <th>Salary Head</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in legalSalaryGradeHeadList" ng-class="{selected : x.Id==null}">
                                        <td ng-show="legalSalaryGradeHeadList.length>1" style="width:2px;">
                                            <span ng-show="!$first" ng-click="moveUp($index,legalSalaryGradeHeadList,'Sequence')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                            <br />
                                            <span ng-show="!$last" ng-click="moveDown($index,legalSalaryGradeHeadList,'Sequence')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                        </td>
                                        <td>{{x.Sequence}}</td>
                                        <td>{{x.SalaryHead}}</td>
                                        <td style="width:2px;">
                                            <ul class="list-inline action-list">
                                                <li><button ng-click="valuePassInDelModal($index,x)" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                            </ul>
                                        </td>
                                        @*<td>{{x.HeadCategory}}</td>
                                            <td>{{x.EntryCurrency}}</td>
                                            <td>{{x.DefinitionCurrency}}</td>
                                            <td>{{x.DisbusmentCurrency}}</td>*@
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in legalSalaryGrades |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get($index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">Salary Head <button type="button" class="close" ng-click="closePopUp()">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in searchPopUpByList|orderBy :'name'" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Salary Head</th>
                                @*<th>Head Category</th>
                                    <th>Entry Currency</th>
                                    <th>Definition Currency</th>
                                    <th>Disbusment Currency</th>*@
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize"
                                total-items="popUpParameters.total_count" pagination-id="metaData.name + 'popUpDataList'">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectSalaryHead(x, $event)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.SalaryHead}}</td>
                                @*<td>{{x.HeadCategory}}</td>
                                    <td>{{x.EntryCurrency}}</td>
                                    <td>{{x.DefinitionCurrency}}</td>
                                    <td>{{x.DisbusmentCurrency}}</td>*@
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'popUpDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getPopUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="selectByButton()" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirm_PopUp" title="Confirmation" message={{confirmationMessage}} data-ng-click-right-button="removeFromHeadList()"></confirm-archive-generic>