<h3 class="site-heading"><span class="glyphicon glyphicon-file"></span>Final Deduction</h3>
<div class="row">
    <div class="form-elements form-horizontal">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-3 control-label">Year</label>
                <div class="col-sm-6">
                    <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-enablefiltersearch="true" e-value="year" e-databound="SelectDefaultValue" e-fields-value="Text" e-fields-text="Text" e-width="100%" e-change="empGridShow" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label"></label>
                <div class="col-sm-9 radio">
                    <label>
                        <input type="radio" name="IsBeforeSalaryProcess" ng-model="report.ReportFormat" value="1">
                        <span class="cr"><i class="cr-icon"></i></span>Before salary process
                    </label>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Month</label>
                <div class="col-sm-8">
                    <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-value="month" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-change="empGridShow" />
                </div>
            </div>
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsAfterSalaryProcess" ng-disabled="EmployeeListTemp.length>0" ng-model="report.ReportFormat" value="0">
                        <span class="cr"><i class="cr-icon"></i></span>After salary process
                    </label>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-2 control-label">Plant</label>
                <div class="col-sm-10">
                    <input id="CWPlant" />
                </div>
            </div>
            <div class="col-sm-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="GetEmployeeInformation();"  class="btn"> <i class="glyphicon glyphicon-download"></i>Go</button></li>
                    </ul>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="row" ng-show="empGrid"  ng-hide="EmployeeListTemp.length==0">
    <div class="col-md-1">

    </div>
    <div class="col-xs-10 col-sm-10 col-md-10" ng-show="empGrid">
        <div class="form-group" style="padding-left: 10px;">
            <div class="common-btn" >
                <button ng-click="GetEmployeeSalaryProcessedReportSalaryLogWise();" class="btn"> <i class="glyphicon glyphicon-file"></i>Download</button>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 col-sm-12">
                <div class="col-md-4 col-sm-4">
                </div>
                <div class="col-md-4 col-sm-4">
                </div>
                <div class="col-md-4 col-sm-4">
                    <div class="common-btn">
                        <ul class="common-btn list-inline text-right">
                            <li><button ng-click="showEmployeeFilterScreen()" class="btn" tabindex="10"><i class="glyphicon glyphicon-filter"></i></button></li>
                            <li><button ng-click="clearManualFilter()" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i></button></li>

                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div id="empInfoGrid" ej-grid e-datasource="EmployeeListTemp" e-recorddoubleclick="Get" e-allowscrolling="true" e-pageSettings-pageSize="20"
             e-actioncomplete="actionCompleteSelected" e-templaterefresh="refreshTemplateemployee"
             e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" style="margin-left:1%">

            <div e-columns>
                <!--<div e-column e-headertext=""--> @*e-headertemplateid="#headerTemplate"*@ <!--e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>-->
                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="EmpCategoryName" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="DesignationName" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="DepartmentName" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="DivisionName" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="SectionName" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="SubSectionName" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="UnitName" e-headertext="Unit" e-allowediting="false" e-width="80"></div>

                <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>

                <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
            </div>
        </div>
    </div>
    <div class="col-md-1">
    </div>
</div>

<div class="modal site-modal in" id="empfilterPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Select Employees<button type="button" class="close" data-dismiss="modal">&times;</button></div>

            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="content-container-fluid">
                    <div id="Gridemployee" ng-init="chkinit()" ej-grid e-datasource="EmployeeList" @*e-actioncomplete="actionCompleteSelected"*@
                         @*e-templaterefresh="refreshTemplateemployee"*@
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowscrolling="true">
                        <div e-columns>
                            <div e-column e-headertext="" @*e-headertemplateid="#headerTemplate"*@ e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="EmpCategoryName" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="DesignationName" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="DepartmentName" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="DivisionName" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="SectionName" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="SubSectionName" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="UnitName" e-headertext="Unit" e-allowediting="false" e-width="80"></div>
                            <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>

                            <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                        </div>
                    </div>


                </div>

                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="nodetext" e-value="data.isToBeSelect" e-checked="data.isToBeSelect" />
                </script>
                <script type="text/x-jsrender" id="headerTemplate">
                    <input type="checkbox" id="headchk" />
                </script>
            </div>
            <ul class="common-btn list-inline text-right" style="padding: 20px;">
                <li><button ng-click="saveemployeedata();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button></li>
                <li><button ng-click="Back();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Back</button></li>
            </ul>

        </div>
    </div>
</div>
<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
    <div class="bounce3"></div>
</div>

