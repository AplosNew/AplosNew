<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Leave With Wages Registers</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="col-md-4">
                <div class="form-group" show-errors id="div_Year">
                    <div class="col-md-12">
                        <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-model="year" e-enablefiltersearch="true" e-fields-value="Text" e-fields-text="Text" e-width="100%" />
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="col-sm-6 radio">
                    <input type="radio" name="baselinedate" ng-model="criteria" value="Active">
                    <span></span><span>Active Employee</span><br />

                </div>
                <div class="col-sm-6 radio">
                    <input type="radio" name="baselinedate" ng-model="criteria" value="Separated" ng-checked="Separated">
                    <span></span><span>InActive Employee</span><br />

                </div>
            </div>
            <div class="col-md-4">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="GetEmployeeInformation();" class="btn"><i class="glyphicon glyphicon-search"></i> Load Employee </button></li>
                    </ul>
                </div>
            </div>

        </div>

        @*<div class="form-group">
                <label class="col-sm-4 control-label">Year<sup>*</sup></label>
                <div class="col-sm-6">
                    <div class="select-style">
                        <select id="Year" class="form-control" ng-model="salaryProcessModel.YearId" name="Year" required tabindex="1" ng-change="getData();">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in yearList" value="{{option.Text}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>*@


        <div class="col-xs-12">
            <div id="Grid" ej-grid
                 e-datasource="EmployeeList"
                 e-allowscrolling="true"
                 e-pageSettings-pageSize="8"
                 e-actioncomplete="actionCompleteSelected"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-enabletouch="false"
                 e-responsive="true"
                 e-allowselection="true"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeStatus" e-type="string" e-headertext="Employee Status" e-allowediting="false" e-width="100"></div>
                    <div e-column e-headertext="Actions" e-width="40" e-template="#reportButton"></div>
                </div>
            </div>
            <script type="text/template" id="reportButton">
                @*<a style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="fa fa-file-pdf-o" ng-click="$parent.report(this);" style="margin: -6px;">View</i></a>*@
                <a class="btn" style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" href="HumanResource/LeaveWithWeagesRegisters/GetLeaveWithWeagesRegisters?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&year={{$parent.year}}&empId={{data.EmpSystemId}}" target="_blank"><i class="fa fa-eye" style="margin: -6px;"></i></a>
                @*<button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="fa fa-file-pdf-o" ng-click="$parent.report(this);" style="margin: -6px;"></i></button>*@

            </script>
        </div>



    </div>
</div>

