<togglable name="Maternity Leave Policy"></togglable>
<div ng-form name="maternityLeavePolicyNewForm">
    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company <sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select id="CompanyId" class="form-control" ng-model="maternityLeavePolicyNew.CompanyId" ng-change="getPlantList();" name="Company" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in companyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant <sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="maternityLeavePolicyNew.PlantId" ng-change="getListData();" name="Plant" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in plantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="form-elements form-horizontal" ng-form name="maternityLeavePolicyNewForm1">
    <div class="clearfix"></div>
    <input type="hidden" ng-model="maternityLeavePolicyNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Child No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="maternityLeavePolicyNew.ChildNo" name="Child No" required>
                        <option value="">--Select--</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                    </select>
                </div>
            </div>
        </div>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Salary</legend>
            <div class="form-group">
                <label class="col-sm-4 control-label">IsMonthly</label>
                <div class="col-sm-8">
                    <div class="col-sm-2 checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="maternityLeavePolicyNew.IsMonthly">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                    <div class="col-sm-5" ng-show="maternityLeavePolicyNew.IsMonthly===true">
                        <input class="form-control" ng-model="maternityLeavePolicyNew.MonthlyPercentage" oninput="validity.valid||(value='');" id="Percentage" name="monthly" type="number" />
                    </div>
                    <div class="col-sm-1" ng-show="maternityLeavePolicyNew.IsMonthly===true">
                        <label class="control-label">%</label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">IsBefore</label>
                <div class="col-sm-8">
                    <div class="col-sm-2 checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="maternityLeavePolicyNew.IsBefore">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                    <div class="col-sm-5" ng-show="maternityLeavePolicyNew.IsBefore===true">
                        <input class="form-control" ng-model="maternityLeavePolicyNew.BeforePercentage" name="before" oninput="validity.valid || (value = '');" type="number" />
                    </div>
                    <div class="col-sm-1" ng-show="maternityLeavePolicyNew.IsBefore===true">
                        <label class="control-label">%</label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">IsAfter</label>
                <div class="col-sm-8">
                    <div class="col-sm-2 checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="maternityLeavePolicyNew.IsAfter">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                    <div class="col-sm-5" ng-show="maternityLeavePolicyNew.IsAfter===true">
                        <input class="form-control" ng-model="maternityLeavePolicyNew.AfterPercentage" name="after" oninput="validity.valid || (value = '');" type="number" />
                    </div>
                    <div class="col-sm-1" ng-show="maternityLeavePolicyNew.IsAfter===true">
                        <label class="control-label">%</label>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Duration Type<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="maternityLeavePolicyNew.DurationType" required name="DurationType" id="DurationType">
                        <option value="">--Select--</option>
                        <option value="Day">Day</option>
                        <option value="Week">Week</option>
                        <option value="Month">Month</option>
                    </select>
                </div>
            </div>
            <label class="col-sm-1 control-label">Value</label>
            <div class="col-sm-3 show-message">
                <input type="number" name="Value" ng-model="maternityLeavePolicyNew.DurationValue" class="form-control" oninput="validity.valid || (value = '');" required tabindex="4">
            </div>
        </div>
    </div>
   
    
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Child No</th>
                <th>Duration Type</th>
                <th>Duration Value</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in maternityLeavePolicys |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.ChildNumber}}</td>
                <td>{{x.DurationType}}</td>
                <td>{{x.DurationValue}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>