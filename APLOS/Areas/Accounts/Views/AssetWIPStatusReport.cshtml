<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Asset WIP Status</h3>
<div class="form-elements form-horizontal" ng-form="form0">

      <div class="row">
        @*<div class="clearfix"></div>*@
        <div class="table-responsive modal-table aplos-grid-toggle">
            <div class="content-container-fluid" style="color:black;overflow:scroll">
                <div style="color:black;" id="GridFixedAssetRegisterReportElasticSearch" ej-grid e-datasource="FixedAssetRegisterElasticSearchList" e-recorddoubleclick="getdata" e-templaterefresh="refreshTemplateEntityandDepartment"
                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true" e-summaryrows="TotalFARegisterSummaryAmount"
                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowresizing="true" e-allowselection="false" e-allowsorting="true">
                    <div e-columns>
                        <div e-column e-field="MaterialMaster" e-headertext="Material Master" e-width="90"></div>
                        <div e-column e-type="text" e-field="Article" e-headertext="Article" e-width="90" style="height: 20px;"></div>

                        <div e-column e-type="text" e-field="AssetMaster" e-headertext="Asset Master" e-width="90" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="Party" e-headertext="Party" e-width="90" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="IsAsset" e-headertext="Asset" e-width="20" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="Machine" e-headertext="Machine" e-width="20" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="FACount" e-headertext="FA Count" e-width="30" e-textalign="right" style="height: 20px;"></div>
                      
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="FABaseAmount" e-headertext="FA Base Amount" e-width="65" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="SubAssetAmount" e-headertext="Sub Asset Amount" e-width="65" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="TotalBaseAmount" e-headertext="Total Base Amount" e-width="65" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="ADBaseAmount" e-headertext="AD Base Amount" e-width="65" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="NetFixedAssetsAmount" e-headertext="Net Base Amount" e-width="65" e-textalign="right" style="height: 20px;"></div>
                    </div>
                </div>


            </div>
        </div>



        @*<div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="InvoiceSummaryReport();" title="All active summary with corresponding values" class="btn"><i class="glyphicon glyphicon-file"></i> Summary</button></li>
                </ul>
            </div>*@

    </div>

</div>

