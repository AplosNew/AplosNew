<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Asset WIP Status</h3>
<div class="form-elements form-horizontal" ng-form="form0">

      <div class="row">
        @*<div class="clearfix"></div>*@
        <div class="table-responsive modal-table aplos-grid-toggle">
            <div class="content-container-fluid" style="color:black;overflow:scroll">
                <div style="color:black;" id="GridAssetWIPstatus" ej-grid e-datasource="AssetWIPstatusList" e-recorddoubleclick="getdata" e-templaterefresh="refreshTemplateEntityandDepartment"
                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true" e-summaryrows="TotalAssetWIPstatus"
                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowresizing="true" e-allowselection="false" e-allowsorting="true">
                    <div e-columns>
                        <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="150"></div>
                        <div e-column e-type="text" e-field="ArticleName" e-headertext="Article" e-width="420" style="height: 20px;"></div>

                        <div e-column e-type="text" e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="90" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="90" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="ThirdCharacteristicsValue" e-headertext="SKU3" e-width="90" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="MaterialStorageLocation" e-headertext="Storage Location" e-width="150" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="GL" e-headertext="GL" e-width="100" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="Activity" e-headertext="Activity" e-width="100" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="GRNNo" e-headertext="GRN No." e-width="100" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="GRNDate" e-headertext="GRN Date" e-width="120" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="VoucherNo" e-headertext="Voucher No." e-width="130" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="text" e-field="Currency" e-headertext="Currency" e-width="100" e-textalign="right" style="height: 20px;"></div>
                                              
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Amount" e-headertext="Amount" e-width="100" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BaseQty" e-headertext="Base Qty" e-width="100" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="IssueQty" e-headertext="Issue Qty" e-width="120" e-textalign="right" style="height: 20px;"></div>
                        
                    </div>
                </div>


            </div>
        </div>



        @*<div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="InvoiceSummaryReport();" title="All active summary with corresponding values" class="btn"><i class="glyphicon glyphicon-file"></i> Summary</button></li>
                </ul>
            </div>*@

    </div>

</div>

<div class="common-btn">
    <ul class="list-inline text-left">
        @*<li><button ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>*@
        <li><button ng-click="AssetWIPstatusReportExcel();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
    </ul>
</div>

