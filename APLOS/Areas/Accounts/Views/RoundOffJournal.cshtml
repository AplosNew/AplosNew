<togglable name="Round Off Journal"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Entry Date" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" name="currency" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" id="Rate" name="rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" autocomplete="off" ng-disabled="baseCurrencyId==voucher.CurrencyId">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate()" id="postingDate" type="text" name="Posting Date" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Doc Date" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-change="entityChange(voucher.EntityId)" id="entityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-8 col-md-8">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea rows="1" type="text" maxlength="250" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group">
            <label class="col-sm-4 control-label">Select<sup>*</sup></label>
            <div class="radio col-sm-6 col-xs-6">
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('Dr')" ng-model="voucher.TransactionType" value="Dr">
                    <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Dr
                </label>
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('Cr')" ng-model="voucher.TransactionType" value="Cr">
                    <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Cr
                </label>

            </div>
            <div class="col-sm-2 input-group">
                <span class="input-group-btn">
                    <button ng-click="GetTrailBalanceRoundOff();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Rounding Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Budget" class="form-control searchableDDL1" ng-model="voucher.FinancingTypeId" ng-change="getTransactionTypeGL(voucher.FinancingTypeId)">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.AssetUserName}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="clearfix"></div>
    <div class="table-responsive modal-table " ng-show="voucherDetailList.length">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>GL </th>
                    <th>Budget</th>
                    <th>Activity</th>
                    <th>Particular</th>
                    <th class="text-center">Dr</th>
                    <th class="text-center">Cr</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in voucherDetailList">
                    <td>{{x.GL}}</td>
                    <td>{{x.Budget}}</td>
                    <td>{{x.Activity}}</td>
                    <td>{{x.Particulars}}</td>
                    <td><input type="text" class="form-control text-right" id="vdDrAmount" ng-model="x.DrAmount " ng-disabled="x.Particulars!='GL'" n-decimals="6" tabindex="11" ng-change="calculateTotalAmount()" autocomplete="off"></td>
                    <td><input type="text" class="form-control text-right" id="vdCrAmount" ng-model="x.CrAmount " ng-disabled="x.Particulars!='GL'" n-decimals="6" tabindex="12" ng-change="calculateTotalAmount()" autocomplete="off"></td>
                    <td class="text-right">
                        <button ng-click="removeDetaillRow(x.Id,x.VoucherId,$index)" data-toggle="modal" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-right">Total</td>
                    <td class="text-right"><b><input type="text" class="form-control text-right" ng-model="totalDrAmount " disabled n-decimals="6"></b></td>
                    <td class="text-right"><b><input type="text" class="form-control text-right" ng-model="totalCrAmount " disabled n-decimals="6"></b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right ">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>Posting Date</th>
                    <th>Doc Ref No</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Clear();Get(x);getAllPartyPlantJournalCbo(x.Id);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.DrAmount | number:6}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Accounts/Voucher/GetAdvanceJournalVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.Id}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Voucher/GetAdvanceJournalVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.Id}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLBudgetPopUp.cshtml")
<div class="modal fade site-modal in" id="trailBalanceRoundOffListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Round Off TB List<button type="button" class="close" ng-click="closeItemPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-lg-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="itemPopUp" ej-grid e-datasource="trailBalanceRoundOffList"
                             e-templaterefresh="refreshTemplateMasterOrderOperation"
                             e-recorddoubleclick=""
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-template="#checkboxList" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="Particulars" e-headertext="Particulars" e-width="200"></div>
                                <div e-column e-field="GL" e-headertext="GL" e-width="200"></div>
                                <div e-column e-field="Budget" e-headertext="Budget" e-width="150"></div>
                                <div e-column e-field="Activity" e-headertext="Activity" e-width="100"></div>
                                <div e-column e-field="TrnType" e-headertext="TrnType" e-width="80"></div>
                                <div e-column e-field="DrAmount" e-headertext="DrAmount" e-width="80"></div>
                                <div e-column e-field="CrAmount" e-headertext="CrAmount" e-width="80"></div>
                            </div>

                        </div>
                        <script type="text/template" id="checkboxList">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                        </script>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="clickCheckedTBItem();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Add</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(voucherId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(voucherId)"></confirm-archive-generic>
