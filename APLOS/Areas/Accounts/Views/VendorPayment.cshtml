<togglable name="Payment"></togglable>
<div class="form-elements form-horizontal" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Party Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="radio">
                    <label>
                        <input type="radio" name="PType" ng-model="partyType" value="Vendor">
                        <span class="cr"><i class="cr-icon"></i></span>Vendor
                    </label>
                    <label>
                        <input type="radio" name="PType" ng-model="partyType" value="Director">
                        <span class="cr"><i class="cr-icon"></i></span>Director
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Party Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="PartyName" ng-model="voucher.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoicing @Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="4" class="form-control" name="Invoicing @Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(voucher.InvoicingPartyPlantId,'billTo')" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyAdvanceAmount();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        @*<div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="entityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="6" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>*@
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Total Advance<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right " readonly name="TotalAdvanceAmount" ng-model="TotalAdvanceAmount" style="color:red">
                    <span class="input-group-btn">
                        <button ng-click="showPartyAdvanceAmount();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Debit Notes<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right " readonly name="TotalDebitNoteAmount" ng-model="TotalDebitNoteAmount" style="color:red">
                    <span class="input-group-btn">
                        <button ng-click="showPartyDebitNoteAmount();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea rows="2" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input ng-click="clearBankPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
                <label>
                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
                <label>
                    <input ng-click="clearTaxPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Tax.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Tax.ToString()
                </label>
                <label>
                    <input ng-click="clearTaxPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Discount.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Discount.ToString()
                </label>
                <label>
                    <input ng-click="clearTaxPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Vendor.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Vendor.ToString()
                </label>
                <label>
                    <input ng-click="clearTaxPopUp();c" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.GL.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>GL
                </label>
                <label>
                    <input ng-click="clearTaxPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Employee.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Employee.ToString()
                </label>
                <label>
                    <input ng-click="clearTaxPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Loan.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Loan.ToString()
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="voucher.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{voucher.BankName}}" tooltip>
                    <span class="input-group-btn">
                        <button ng-click="showBankPopUp(voucher.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankMasterId">
            <label class="col-sm-4 control-label">Bank Ref No</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Bank Reference No" name="Bank Reference No" ng-model="voucher.BankReferenceNo" class="form-control" tabindex="5" autocomplete="off">
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankMasterId">
            <label class="col-sm-4 control-label">Bank Trn Date</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="BankTransactionDate" ng-model="voucher.BankTransactionDate" datepicker class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="voucher.CashName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showCashPopUp(null, voucher.EntityId);" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='Vendor'">
            <label class="col-sm-4 control-label">Credit Note Vendor<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="CreditNoteVendor" ng-model="voucher.OtherPartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showNotePartyPopUpNew();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='Vendor'">
            <label class="col-sm-4 control-label">Credit Note Invoicing  Vendor<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select tabindex="4" class="form-control" name="CreditNoteInvoicingVendor" ng-model="voucher.OtherPartyPlantId"
                            ng-options="item.Value as item.Text for item in notepartyPlantList| filter:{ PartyId: x.PartyId }" ng-change="notebillShippAddress(voucher.OtherInvoicingPartyPlantId,'billTo')">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='Vendor'">
            <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-change="getTransactionTypeGL(voucher.FinancingTypeId)" name="Transaction Type" class="form-control" ng-model="voucher.FinancingTypeId" tabindex="7">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.FinancingTypeId}}">{{option.LiabilityUserName}}</option>
                    </select>
                </div>
            </div>
        </div>



        <div class="form-group" ng-show="voucher.CurrencyId!=voucher.BaseCurrencyId && voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-4 control-label">Bank Amount<sup>*</sup></label>
            <div class="col-sm-2 show-message" style="padding-right:0px;">
                <input type="text" readonly class="form-control text-right" name="BankCurrencyCode" ng-model="voucher.BankCurrencyCode">
            </div>
            <div class="col-sm-6 show-message" style="padding-left:0px;">
                <input type="text" n-decimals="2" ng-disabled="true" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="BankAmount" ng-model="voucher.BankAmount" ng-keyup="recalBankAmount()" autocomplete="off">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="5" name="Currency" required ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();calBaseAmount();" ng-disabled="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Employee.ToString()'">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" n-decimals="4" name="Rate" ng-keyup="exchangeGainLossCal(voucher.CompanyCurrencyRate);rateChangeBankCharge(voucher.CompanyCurrencyRate);calBankAmount()" id="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off" ng-disabled="voucher.CurrencyId==companyCurrencyId || voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Employee.ToString()'">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>


        @*<div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Discount.ToString()'">
                <label class="col-sm-4 control-label">Discount Amount<sup>*</sup></label>
                <div class="col-sm-8 ">
                    <input type="text" n-decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="DiscountAmount" ng-model="voucher.DiscountAmount">
                </div>
            </div>*@
        <div class="form-group">
            <label class="col-sm-4 control-label">Rounding<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="RoundingType" ng-model="voucher.RoundingType" tabindex="3">
                        <option ng-repeat="option in roundingTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Rounding Amount<sup>*</sup></label>
            <div class="col-sm-8 ">
                <input type="text" ng-disabled="voucher.RoundingType=='None'" n-decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="RoundingAmount" ng-model="voucher.RoundingAmount">
            </div>
        </div>
        <div class="form-group" ng-show="voucher.CurrencyId!=voucher.BaseCurrencyId && voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-4 control-label">Bank Books Amount<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" n-decimals="3" title="Text, Comma, +, -, Two Dot is not allow" @*ng-disabled="voucher.CurrencyId==voucher.BankCurrencyId"*@ class="form-control text-right" name="BankBookAmount" ng-model="voucher.BankBookAmount" ng-keyup="reCalBankBaseAmount()">
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="col-xs-12 col-sm-2 col-md-2">
            <button class="btn single-btn" ng-click="getPopupCustomerReceivableList()" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Select Payable</button>
        </div>
        <div class="clearfix"></div>
        <div class="table-responsive modal-table" ng-show="voucherDetailList.length">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Voucher No</th>
                        <th>DocDate</th>
                        <th>Posting Date</th>
                        <th>Doc Ref No</th>
                        <th>Currency</th>
                        <th>Rate</th>
                        <th class="text-right">Payable</th>
                        <th class="text-right">Additional</th>
                        <th class="text-right">Payment</th>
                        <th class="text-right">Balance</th>
                        <th class="text-right">Amount</th>
                        <th>Exchange Type</th>
                        <th>Exchange Amount</th>
                        <th>Books Amount</th>
                        <th>File Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in voucherDetailList">
                        <td>{{x.VoucherNo}}</td>
                        <td>{{x.DocDate |dateFiltering}}</td>
                        <td>{{x.PostingDate}}</td>
                        <td>{{x.DocRefNo}}</td>
                        <td>{{x.CurrencyCode}}</td>
                        <td>{{x.CompanyCurrencyRate}}</td>
                        <td class="text-right">{{x.Receivable | number:3}}</td>
                        <td class="text-right">{{x.AdditionalAmount | number:3}}</td>
                        <td class="text-right">{{x.Received | number:3}}</td>
                        <td class="text-right">{{x.Balance | number:3}}</td>
                        <td>
                            <input ng-keyup="exchangeGainLossAmount(x)" type="text" n-decimals="3" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="x.Amount">
                        </td>
                        <td>
                            <input readonly type="text" n-decimals="3" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeType" ng-model="x.ExchangeType">
                        </td>
                        <td>
                            <input type="text" n-decimals="3" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-disabled="x.ExchangeType==null" name="ExchangeAmount" ng-model="x.ExchangeAmount" ng-keyup="calBaseAmount()">
                        </td>
                        <td>
                            <input type="text" n-decimals="3" readonly title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="BaseDrAmount" ng-model="x.BaseDrAmount" ng-keyup="calBaseAmount()">
                        </td>
                        <td>
                            <div class="col-md-12">
                                <div class="col-md-7">
                                    <label class="col-sm-4 control-label" ng-click="FileDownload(x)"><a href="{{dwonloadUrl}}" style="text-decoration:underline" download="{{x.FileName}}" target="_self">{{x.FileName}}</a></label>
                                </div>
                                <div class="col-md-5">
                                    <div id="UploadDefault" e-id="{{x.InvoiceId}}" e-data="x.InvoiceId" e-dialogPosition-x="0" e-multiplefilesselection="false" e-width="50" e-buttontext-browse="+File" e-success="$parent.getFileList" e-showroundedcorner="false" @*e-height="30"*@ e-autoupload="true" e-begin="onBeginUpload" e-filesize="2097152" ej-uploadbox e-saveurl="uploadUrl" e-extensionsallow=".jpg,.bmp,.png,.jpeg,.pdf,.xls,.xlsx,.doc,.docx,.ppt,.pptx,.txt" @*e-error="errorUpload"*@></div>
                                </div>
                            </div>
                        </td>
                        <td class="text-right">
                            <button ng-click="removeRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="6" class="text-right">Total</td>
                        <td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'Receivable' | number:2}}</b></td>
                        <td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'AdditionalAmount' | number:2}}</b></td>
                        <td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'Received' | number:2}}</b></td>
                        <td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'Balance'| number:2 }}</b></td>
                        <td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'Amount' | number:3}}</b></td>
                        <td></td>
                        <td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'ExchangeAmount'| number:3 }}</b></td>
                        <td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'BaseDrAmount'| number:3 }}</b></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="clearfix"></div>
        <div ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.GL.ToString()'">
            <ul class="list-inline">
                <li><button class="btn single-btn" ng-click="popUp()" tabindex=""><i class="glyphicon glyphicon-plus"></i> GL</button></li>
            </ul>
        </div>
        <div class="row form-elements">
            <div class="col-xs-12 col-sm-12 col-md-12 modal-table" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.GL.ToString()'">
                <table class="table table-responsive table-striped">
                    <thead>
                        <tr>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>Amount</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in glList">
                            <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                            <td>{{x.BudgetName}}</td>
                            <td>{{x.ActivityName}}</td>
                            <td id="td_Amount">
                                <div class="show-message">
                                    <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Amount" ng-keyup="calBaseAmount()">
                                </div>
                            </td>
                            <td class="text-right">
                                <button ng-click="removeglRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot ng-show="glList.length">
                        <tr>
                            <td></td>
                            <td></td>
                            <td><b>Sub Total</b></td>
                            <td class="text-right"><b>{{ glList | sumByKey : 'Amount' }}</b></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="clearfix"></div>
        <div ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Employee.ToString()'">
            <ul class="list-inline">
                <li><button class="btn single-btn" ng-click="showEmployeeAdvancePopUpList()" tabindex=""><i class="glyphicon glyphicon-plus"></i> Add Employee Advance</button></li>
