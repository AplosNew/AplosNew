<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        /*background-color: #1c1f32;*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>


<togglable name="{{title}}"></togglable>
<div class="form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">COA<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="ModelNew.COAId" ng-options="item.Value as item.Text for item in COAList" id="COAId" name="COA"  ng-change="getData();" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" title="GL">GL</label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">

                    <input type="text" class="form-control" ng-model="GLGeneralInfo" readonly>
                    @*<input type="text" class="form-control" hidden ng-model="ModelNew.GLGeneralInfoId" readonly>*@
                    <span class="input-group-btn">
                        <button ng-click="getGLList();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="refreshGL()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
           
            <div class="form-group">
                <label class="col-sm-4 control-label">Budget</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.BudgetMasterId" ng-options="item.BudgetMasterId as item.BudgetName for item in BudgetList" id="BudgetId"
                                name="Budget" tabindex="1" ng-change="getActivity()">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">General Account Determinate <sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.Id" name="Type" ng-options="item.Value as item.Text for item in AccountDeterminateList" tabindex="6" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Activity</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.ActivityId" ng-options="item.ActivityId as item.ActivityName for item in ActivityList" id="ActivityId" name="Activity" tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>



        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="COA" e-headertext="COA" e-width="2"></div>
            <div e-column e-field="Id" e-headertext="General Account Determinate" e-width="5" e-isprimarykey="true"></div>
            <div e-column e-field="GLGeneralInfo" e-headertext="GLGeneralInfo" e-width="5"></div>
            <div e-column e-field="Budget" e-headertext="Budget" e-width="3"></div>
            <div e-column e-field="Activity" e-headertext="Activity" e-width="5"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_ExpensesPayableTypeGL.cshtml")