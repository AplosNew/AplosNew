<h4>Company GL Info</h4>
<div class="form-elements" ng-form name="glinfoNewForm1">
    <div class="col-xs-12 col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">COA<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="COA" submit-required="true" ng-model="glcominfo.COAId"
                            ng-change="onCOAChange(glcominfo.COAId)"
                            ng-options="item.Value as item.Text for item in cOAList">
                        <option></option>
                    </select>
                </div>
                <p ng-show="selectMessage" style="color:red" class="show-message">{{selectMessage}}</p>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="CompanyId" submit-required="true" ng-model="glcominfo.CompanyId"
                            ng-change="onCompanyChange(glcominfo.CompanyId);"
                            ng-options="item.Value as item.Text for item in companyList">
                        <option></option>
                    </select>
                </div>
                <p ng-show="selectMessage" style="color:red" class="show-message">{{selectMessage}}</p>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            </ul>
        </div>
    </div>
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12 form-horizontal">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByGlList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive modal-table">
        <table class="table table-striped ">
            <thead>
                <tr>
                    <th>Apply</th>
                    <th>GL</th>
                    <th>Account Group</th>
                    <th>Alternative GL</th>
                    <th>Tax Category</th>
                    <th>Posting Without Tax Allow</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in glcominfoList ">
                    <td>
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" id="active" ng-model="x.Active" ng-checked="x.Active">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </td>
                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                    <td>{{x.AccountGroupName}}</td>
                    <td>{{x.AlternativeGLId}}</td>
                    <td>
                        <div class="select-style">
                            <select name="TaxCategory" ng-model="x.TaxCategory" class="form-control">
                                <option value=""></option>
                                <option value="All">All</option>
                                <option value="Input">Input</option>
                                <option value="Output">Output</option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" id="PostingWithoutTaxAllow" ng-model="x.PostingWithoutTaxAllow" ng-checked="x.PostingWithoutTaxAllow">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>