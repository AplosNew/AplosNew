<togglable name="GL"></togglable>
<div class="form-horizontal">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl" ng-form name="glinfoNewForm1">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">COA<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select class="form-control" name="COA" submit-required="true" ng-model="glinfoNew.COAId" ng-change="onCOAChange(glinfoNew.COAId);onCOAChangeSequence(glinfoNew.COAId);onAGroupCOAChange(glinfoNew.COAId)"
                            ng-options="item.Value as item.Text for item in cOAList">
                        <option></option>
                    </select>
                </div>
                <p ng-show="selectMessage" style="color:red" class="show-message">{{selectMessage}}</p>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="glinfo" role="tab" data-toggle="tab">GL General Info</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="glcominfo" role="tab" data-toggle="tab" ng-show="checkLevelIsMandatory">GL Level</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form name="glinfoNewForm2">
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Sequence" ng-model="glinfoNew.Sequence" class="form-control" tabindex="1" placeholder="0.00" required>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">GL<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" maxlength="50" name="GLUserName" ng-model="glinfoNew.UserName" class="form-control" tabindex="3" placeholder="GL" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label"> Reconcile Account Type<sup></sup></label>
                                <div class="col-sm-8">
                                    <button class="btn single-btn" ng-click="GetAccountTypeList()" tabindex="5">Account Type</button>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Manufacturing</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input tabindex="7" type="checkbox" ng-model="glinfoNew.IsManufacturing">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Trading</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input tabindex="9" type="checkbox" ng-model="glinfoNew.IsTreding">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Active</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input tabindex="8" type="checkbox" ng-model="glinfoNew.Active">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="glinfoNew.Description" name="Description" maxlength="250" tabindex="6"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                            <div class="form-group" show-errors>
                                <label class="col-sm-5 control-label">Account Group<sup>*</sup></label>
                                <div class="col-sm-7 show-message">
                                    <div class="select-style">
                                        <select name="Account Group" ng-model="glinfoNew.AccountGroupId" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in AccountGroupList" tabindex="2" required ng-change="GetAccountGroupNumberChange(glinfoNew.AccountGroupId)"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-5 control-label">Account Code<sup>*</sup></label>
                                <div class="col-sm-7 show-message">
                                    <input id="accountCode" type="text" maxlength="{{maxLength.LengthOfGL}}"
                                           name="Account Code" ng-model="glinfoNew.AccountCode" class="form-control" required
                                           tabindex="4" ng-disabled="{{CheckAccountCode}}" ng-change="checkAccountCode(glinfoNew.AccountCode)">
                                    <span ng-if="accCodeValid">{{showMsg}}</span>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-5 control-label">Ref No</label>
                                <div class="col-sm-7 show-message">
                                    <input id="RefNo" type="text" name="RefNo" ng-model="glinfoNew.RefNo" class="form-control" required tabindex="6">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-5 control-label">Voucher Type</label>
                                <div class="col-sm-7 show-message">
                                    <div class="select-style">
                                        <select name="voucherType" ng-model="glinfoNew.VoucherType" class="col-sm-3 form-control">
                                            <option value="Bank & Cash">Bank & Cash</option>
                                            <option value="General-Journal">General-Journal</option>
                                            <option value="Expenses">Expenses</option>
                                            <option value="Purchase">Purchase</option>
                                            <option value="Sales">Sales</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-5 control-label">Service</label>
                                <div class="col-sm-7">
                                    <div class="checkbox-site">
                                        <label>
                                            <input tabindex="8" type="checkbox" ng-model="glinfoNew.IsService">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-5 control-label">Posting Automatic Only</label>
                                <div class="col-sm-7">
                                    <div class="checkbox-site">
                                        <label>
                                            <input tabindex="10" type="checkbox" ng-model="glinfoNew.IsPostingAutomaticOnly">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-5 control-label">Clearing Account</label>
                                <div class="col-sm-7">
                                    <div class="checkbox-site">
                                        <label>
                                            <input tabindex="12" type="checkbox" ng-model="glinfoNew.IsClearingAccount">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div ng-show="checkLevelIsMandatory" role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row" ng-form name="glinfoNewForm4">
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal" compile="left">
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal" compile="right">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button ng-click="Delete()" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByGlList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped ">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Account Code</th>
                <th>GL</th>
                <th>Account Group</th>
                <th>Ref No</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in glItems |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'test'" ng-dblclick="Get(x.Id, $index,COAId);GetGLLevelByLevel(x.Level)">
                <td>{{x.Sequence}}</td>
                <td>{{x.AccountCode}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.AccountGroupName}}</td>
                <td>{{x.RefNo}}</td>
                <td>{{x.Active? 'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <div>
        <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'test'" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
<toaster-container toaster-options="{'close-button':true, 'animation-class': 'toast-top-center'}"></toaster-container>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="accountTypePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeAccountTypePopUp()">&times;</button>
                <h4 class="modal-title"> Account Type</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Apply</th>
                                <th>Account Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="a in AccountTypeList">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="a.Active" ng-checked="a.Id">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{a.AccountType}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeAccountTypePopUp()">OK</button>
            </div>
        </div>
    </div>
</div>