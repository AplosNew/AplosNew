<div class="modal fade site-modal in" id="CustomerReconTypeListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" name="CustomerReconAssetTypeListForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Recon Asset GL List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="customerReconTypeListParameters.searchBy">
                                            <option ng-repeat="option in searchCustomerReconTypeByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="customerReconTypeListParameters.search" ng-enter="GetCustomerReconTypeListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetCustomerReconTypeListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Account Group</th>
                                <th>GL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in CustomerReconTypeGLList |itemsPerPage:customerReconTypeListParameters.pageSize" pagination-id="metaData.name + 'CustomerReconTypeGLList'" total-items="customerReconTypeListParameters.total_count"
                                ng-click="setCustomerReconTypeGLSelected(x)" ng-dblclick="closeCustomerReconTypeListPopUpSelected(x)" ng-class="{selected : x.GLGeneralInfoCode === rowSelected}">
                                <td>{{x.AccountGroupName}}</td>
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'CustomerReconTypeGLList'" direction-links="true" boundary-links="true" on-page-change="GetCustomerReconTypeListData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closeCustomerReconTypeListPopUpSelected()">Select</button>
            </div>
        </div>
    </div>
</div>