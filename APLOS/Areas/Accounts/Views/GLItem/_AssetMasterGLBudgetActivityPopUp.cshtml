<style>
    .modellgModify {
        width: 1200px;
    }
</style>
<div class="modal fade site-modal in" id="assetGLBudgetActivityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content" ng-form name="glPopUpForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Fixed Asset Master List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="issueAUCglListParameters.searchBy">
                                            <option ng-repeat="option in searchissueAUCglByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="issueAUCglListParameters.search" ng-enter="GetIssueAUCGLData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetIssueAUCGLData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Asset Master</th>
                                <th>Account Group</th>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in issueAUCglList |itemsPerPage:issueAUCglListParameters.pageSize" pagination-id="metaData.name + 'issueAUCglList'" total-items="issueAUCglListParameters.total_count"
                                ng-click="setissueAUCglSelected(x,$index)" ng-class="{selected : x.GLGeneralInfoCode === rowSelected}" ng-dblclick="closeIssueAUCglListPopUp(x)">
                                <td>{{x.FixedAssetName}}</td>
                                <td>{{x.AccountGroupName}}</td>
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'issueAUCglList'" direction-links="true" boundary-links="true" on-page-change="GetIssueAUCGLData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeIssueAUCglListPopUp()">OK</button>
            </div>
        </div>
    </div>
</div>