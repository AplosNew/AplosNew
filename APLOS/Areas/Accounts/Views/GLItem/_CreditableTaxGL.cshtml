<div class="modal fade site-modal in" id="CreditableListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="expensesTypeListForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Creditable GL List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="creditableTypeListParameters.searchBy">
                                            <option ng-repeat="option in searchCreditableTypeByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="creditableTypeListParameters.search" ng-enter="getCreditableTypeListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getCreditableTypeListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Account Group</th>
                                <th>GL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in creditableGlList |itemsPerPage:creditableTypeListParameters.pageSize" pagination-id="metaData.name + 'creditableGlList'" total-items="creditableTypeListParameters.total_count"
                                ng-click="setCreditGLSelected(x)" ng-dblclick="closeCreditTypeListPopUpSelected()">
                                <td>{{x.AccountGroupName}}</td>
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'creditableGlList'" direction-links="true" boundary-links="true" on-page-change="getCreditableTypeListData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeExpensesTypeListPopUpSelected()">Select</button>
            </div>
        </div>
    </div>
</div>