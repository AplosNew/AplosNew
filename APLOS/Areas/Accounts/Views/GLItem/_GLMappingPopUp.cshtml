<div class="modal fade site-modal in" id="CustomerInvoiceGLPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:1000px">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header"> GL<button type="button" class="close" ng-click="closeGLPopUp()">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="customerInvoiceGLParameters.searchBy">
                                            <option ng-repeat="option in customerInvoiceGLSearchList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="customerInvoiceGLParameters.search" ng-enter="customerInvoiceGLGLData();">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="customerInvoiceGLGLData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Account Group</th>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>Ref No</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in customerInvoiceGLList |itemsPerPage:customerInvoiceGLParameters.pageSize" pagination-id="metaData.name + 'customerInvoiceGLList'"
                                total-items="customerInvoiceGLParameters.total_count" ng-dblclick="glSelect(x)">
                                <td>{{x.AccountGroupName}}</td>
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td>{{x.RefNo}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'customerInvoiceGLList'" direction-links="true" boundary-links="true" on-page-change="customerInvoiceGLGLData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeGLPopUp()">Close</button>
            </div>
        </div>
    </div>
</div>