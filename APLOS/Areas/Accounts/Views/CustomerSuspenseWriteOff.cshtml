<togglable name="{{title}}"></togglable>
<div class="form-horizontal form-elements" ng-form="form0" id="form0">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">@Library.Model.Parties.PartyType.Customer.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Customer.ToString()" ng-model="advance.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearPartyPopUp()" class="btn single-small-btn" tabindex="3"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Ordering @Library.Model.Parties.PartyType.Customer.ToString() ({{partyPlantList.length}})<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="1" class="form-control" name="Ordering @Library.Model.Parties.PartyType.Customer.ToString()" ng-model="advance.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(advance.PartyPlantId,'billTo'); updateCrAmount();" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(advance.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Transaction</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Journal</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form name="tabForm1">
                <div class="row">
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="VoucherDate" ng-model="advance.VoucherDate" datepicker class="form-control" disabled required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="advance.VoucherTypeId" tabindex="2" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="currencyTransactionId" class="form-control" ng-disabled="voucherDetailList.length" tabindex="5" name="CurrencyTransaction" ng-model="advance.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div id="div_PostingDate" class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input required datepicker="checkPostingDate(); getFiscalYearPeriod(advance.PostingDate);" id="postingDate" type="text" name="PostingDate" ng-model="advance.PostingDate" class="form-control" tabindex="1">
                            </div>
                        </div>
                        <div id="div_DocDate" class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="DocDate" ng-model="advance.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
                            </div>
                        </div>
                        <div id="div_entity" class="form-group">
                            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select ng-change="entityValidation()" id="entityId" class="form-control" name="entity" ng-model="advance.EntityId" tabindex="7">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-3 control-label">Fiscal Year</label>
                            <div class="col-sm-4 show-message">
                                <input id="fiscalYearId" type="text" name="Fiscal Year" disabled ng-model="advance.FiscalYearName" class="form-control">
                                <input type="hidden" name="Period" ng-model="advance.FiscalYearId" class="form-control">
                            </div>
                            <label class="col-sm-2 control-label">Period</label>
                            <div class="col-sm-3 show-message">
                                <input id="fiscalYearPeriod" type="text" name="Period" disabled ng-model="advance.FiscalYearPeriodName" class="form-control">
                                <input type="hidden" name="Period" ng-model="advance.FiscalYearPeriodId" class="form-control">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
                            <div class="col-sm-9 show-message">
                                <input type="text" maxlength="50" name="Doc Ref" ng-model="advance.DocRefNo" class="form-control" tabindex="4" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-3 control-label">Narration<sup>*</sup></label>
                            <div class="col-sm-9 show-message">
                                <textarea rows="1" type="text" name="Narration" tabindex="8" class="form-control" ng-model="advance.Narration" required capitalize></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li ng-disabled="advance.PartyId==null&&advance.PartyPlantId==null"><button ng-click="showCustomerAdvancePopUp(advance.PartyId, advance.PartyPlantId);" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Suspense</button></li>
                                <li ng-disabled="voucherDetailList.length==0"><button ng-click="showCustomerInvoicePopUp(advance.PartyId);" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Invoice</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="table-responsive modal-table" ng-hide="voucherDetailList.length==0">
                        <table class="table table-responsive table-striped">
                            <thead>
                                <tr>
                                    <th>#No</th>
                                    <th>Ordering @Library.Model.Parties.PartyType.Customer.ToString()</th>
                                    <th>Doc Date</th>
                                    <th>Doc Ref</th>
                                    <th>Currency</th>
                                    <th>Amount</th>
                                    <th>Set-off Amount</th>
                                    <th>Balance</th>
                                    <th>Advance Amount</th>
                                    <th>Invoice Amount</th>
                                    <th>Convert Amount</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in voucherDetailList">
                                    <td>{{x.VoucherNo}}</td>
                                    <td>{{x.PartyPlantName}}</td>
                                    <td>{{x.DocDate | dateFiltering}}</td>
                                    <td>{{x.DocRefNo}}</td>
                                    <td>{{x.CurrencyCode}}</td>
                                    <td class="text-right">{{x.Amount | number:2}}</td>
                                    <td class="text-right">{{x.WriteOff | number:2}}</td>
                                    <td class="text-right">{{x.Advilable | number:2}}</td>
                                    <td><input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-disabled="x.TrnType=='Cr'" ng-model="x.DrAmount" ng-keyup="convertAmountDr(x)"></td>
                                    <td><input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-disabled="x.TrnType=='Dr'" ng-model="x.CrAmount" ng-keyup="convertAmountCr(x)"></td>
                                    <td><input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" readonly name="Amount" ng-model="x.ConvertedAmount"></td>
                                    <td class="text-right">
                                        <button ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                            <i class="glyphicon glyphicon-remove"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot ng-show="voucherDetailList.length">
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td><b>Sub Total</b></td>
                                    <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'DrAmount' }}</b></td>
                                    <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'CrAmount'  }}</b></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form name="tabForm2">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12 modal-table">
                        <table class="table table-responsive table-striped">
                            <thead compile="parallelCurrencyTableHead">
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in voucherDetailCurrencyList">
                                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget">{{x.BudgetName}}</td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget">{{x.ActivityName}}</td>
                                    <td ng-repeat="y in parallelCurrencyTypeList"><input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-disabled="x[y.CurrencyType]==null" ng-model="x[y.CurrencyType]" /></td>
                                </tr>
                            </tbody>
                            <tfoot ng-show="voucherDetailCurrencyList.length">
                                <tr>
                                    <td><b>Sub Total</b></td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                    <td class="text-right" ng-repeat="y in parallelCurrencyTypeList"><b>{{ voucherDetailCurrencyList | sumByKey : y.CurrencyType  }}</b></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="advance.Id==null"><button ng-click="confirmPost(advance.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>@Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Ordering @Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Posting Date</th>
                    <th>Doc Date</th>
                    <th>Doc Ref</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>{{x.PartyPlantName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.DocDate | dateFiltering}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                    <td>{{x.IsPark?'Park':'Post'}}</td>
                    <td>
                        <div class="dropdown">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="">Action<i class="glyphicon glyphicon-menu-down"></i></a>
                            <ul class="dropdown-menu dropdown-menu-right" role="menu" aria-labelledby="dLabel">
                                <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                                <li><a ng-click="report(x.VoucherId)" class="btn btn-action" href=""><i class="glyphicon glyphicon-print"></i> Download</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/_CustomerInvoicePopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_CustomerAdvancePopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(advanceWriteOffId)"></confirm-archive-generic>