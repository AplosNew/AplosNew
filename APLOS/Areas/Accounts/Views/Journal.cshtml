<togglable name="Journal Voucher"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Entry Date" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" name="CurrencyTransaction" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" autocomplete="off" required ng-disabled="baseCurrencyId==voucher.CurrencyId">
            </div>
        </div>
        <div class="form-group" ng-show="approvedByList.length">
            <label class="col-sm-4 control-label">Approved By<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style" style="font-size:smaller">
                    <select name="ApprovedById" id="ApprovedById" ng-model="voucher.ApprovedById" class="form-control"
                            ng-options="item.Id as item.Value for item in approvedByList" tabindex="6"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="Posting Date" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Doc Date" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-change="entityChange(voucher.EntityId)" id="entityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-8 col-md-8">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea rows="1" type="text" maxlength="250" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <ul class="list-inline">
        <li><button class="btn single-btn" ng-disabled="glDisabled" ng-click="GetCOAICodeList()" tabindex=""><i class="glyphicon glyphicon-plus"></i> Select GL</button></li>
    </ul>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table ">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>GL </th>
                    <th>Budget</th>
                    <th>Activity</th>
                    <th>Entity</th>
                    <th class="text-center">Dr</th>
                    <th class="text-center">Cr</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in voucherDetailList">
                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                    <td>{{x.BudgetName}}</td>
                    <td>{{x.ActivityName}}</td>
                    <td>
                        <div class="select-style">
                            <select id="entityId" class="form-control" tabindex="21" name="entity" ng-model="x.EntityId">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </td>

                    <td><input type="text" class="form-control text-right" id="vdDrAmount" ng-model="x.DrAmount " n-decimals="2" tabindex="11" ng-change="checkDrAmount($index)" autocomplete="off"></td>
                    <td><input type="text" class="form-control text-right" id="vdCrAmount" ng-model="x.CrAmount " n-decimals="2" tabindex="12" ng-change="checkCrAmount($index)" autocomplete="off"></td>
                    <td class="text-right">
                        <button ng-click="removeRow($index)" data-toggle="modal" ng-disabled="currencyDisable" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td></td>
                    <td colspan="3" class="text-right">Total</td>
                    <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'DrAmount' }}</b></td>
                    <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'CrAmount' }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right ">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchvoucherList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>Posting Date</th>
                    <th>Doc Ref No</th>
                    <th>Doc Date</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Clear();Get(x);">

                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.DocDate | dateFiltering}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.DrAmount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="ShowJournalPopUp(x.Id,x);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Accounts/Voucher/GetJournalVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.Id}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Voucher/GetJournalVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.Id}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>

    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLBudgetPopUp.cshtml")
<div class="modal fade site-modal in" id="JournalPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Journal</div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label" data-placement="top" title="Cost and Manufacture">Voucher No<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input id="InvoiceNo" type="text" name="InvoiceNo" ng-disabled="true" ng-model="voucherdb.VoucherNo" class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Posting Date<sup>*</sup></label>
                    <div class="col-sm-6 show-message">
                        <input id="postingDate" type="text" datepicker name="Posting Date" ng-model="voucherdb.PostingDate" ng-disabled="true" class="form-control" tabindex="1">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">Doc Date<sup>*</sup></label>
                    <div class="col-sm-6 show-message">
                        <input type="text" name="DocDate" datepicker ng-model="voucherdb.DocDate" ng-disabled="true" class="form-control" tabindex="3">
                    </div>
                </div>


            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Doc Ref<sup>*</sup></label>
                    <div class="col-sm-6 show-message">
                        <input type="text" maxlength="50" name="Doc Ref" ng-model="voucherdb.DocRefNo" class="form-control" tabindex="4" ng-disabled="true">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">Currency<sup>*</sup></label>
                    <div class="col-sm-6 show-message" style="padding-right:0px;">
                        <input type="text" name="DocDate" ng-model="voucherdb.CurrencyCode" ng-disabled="true" class="form-control" tabindex="3">
                    </div>
                </div>
            </div>
            <div class="modal-body">
                <div class="form-horizontal col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
                        <div class="col-sm-10 show-message">
                            <textarea rows="1" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucherdb.Narration" maxlength="500" required capitalize></textarea>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>Dr</th>
                                <th>Cr</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in newJVList">
                                <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td class="text-right">{{x.DrAmount | number| setDecimal:4}}</td>
                                <td class="text-right">{{x.CrAmount | number| setDecimal:4}}</td>
                                <td class="text-right">
                                    <button ng-click="popUpGL($index)" data-toggle="modal" class="btn btn-action tooltip-here" data-placement="top" title="popUp">
                                        <i class="glyphicon glyphicon-info-sign"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3"></td>
                                <td class="text-right"><strong>{{newJVList | sumByKey : 'DrAmount' | number| setDecimal:4}}</strong></td>
                                <td class="text-right"><strong>{{newJVList | sumByKey : 'CrAmount' | number| setDecimal:4}}</strong></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="postVoucher()" title="Post" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
                        <li><button ng-click="CloseJournalPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="GLNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="glPopUpForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">GL List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="glListParameters.searchBy">
                                            <option ng-repeat="option in searchglByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="glListParameters.search" ng-enter="GetCOAICodeListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetCOAICodeListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in cOAICodeList |itemsPerPage:glListParameters.pageSize" pagination-id="metaData.name + 'cOAICodeList'" total-items="glListParameters.total_count"
                                ng-dblclick="setNewSelected(x,$index)" ng-class="{selected : x.BudgetMasterId === rowSelected}">
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'cOAICodeList'" direction-links="true" boundary-links="true" on-page-change="GetCOAICodeListData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeNewGLListPopUp()">OK</button>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(voucherId)"></confirm-archive-generic>

<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(voucherId)"></confirm-archive-generic>