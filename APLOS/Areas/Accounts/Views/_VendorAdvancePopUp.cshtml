<div class="modal fade site-modal in" id="vendorAdvancePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" ng-click="closeAdvancePopUp()" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Vendor Advance</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="advanceParameters.searchBy">
                                            <option ng-repeat="option in advanceSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="advanceParameters.search" ng-enter="getAdvanceData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getAdvanceData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Voucher No</th>
                                <th>Vendor</th>
                                <th>Location</th>
                                <th>Posting Date</th>
                                <th>Currency</th>
                                <th>Advanced</th>
                                <th>Additional Amount</th>
                                <th>Write-off</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in advanceDataList |itemsPerPage:advanceParameters.pageSize" pagination-id="metaData.name + 'advanceDataList'" total-items="advanceParameters.total_count"
                                ng-class="{selected : x.VoucherDetailId == selectedAdvanceId}" ng-dblclick="closeAdvancePopUpSelected(x)">
                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.PartyName}}</td>
                                <td>{{x.PartyPlantName}}</td>
                                <td>{{x.PostingDate |dateFiltering}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td class="text-right">{{x.Receivable | number:2}}</td>
                                <td class="text-right">{{x.AdditionalAmount | number:2}}</td>
                                <td class="text-right">{{x.Received | number:2}}</td>
                                <td class="text-right">{{x.Balance | number:2}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'advanceDataList'" direction-links="true" boundary-links="true" on-page-change="getAdvanceData(newPageNumber)"></dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <ul>
                    <li>
                            <button type="button" class="btn btn-default text-left" ng-click="closeAdvancePopUp();">Select</button>

                        <div class="list-inline text-left" ej-tooltip e-showshadow="true" ng-click="VendorAdvanceReportExcel();" e-width="width">
                            <button class="btn"><i class="glyphicon glyphicon-download"></i>Download</button>
                        </div>
                       
                    </li>
                    @*<li>
                        <div class="list-inline text-right">
                            <button type="button" class="btn btn-default" ng-click="closeAdvancePopUp();">Select</button>
                        </div>
                    </li>*@
                </ul>
                
            </div>
        </div>
    </div>
</div>