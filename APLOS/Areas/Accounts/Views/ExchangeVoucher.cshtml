<togglable name="Exchange Voucher"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Entry Date" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Exchange Type<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input ng-click="changeExhangeType(voucher.ExchangeType)" type="radio" name="source" ng-model="voucher.ExchangeType" value="Loss" ng-disabled="voucherDetailList.length">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>Loss
                </label>
                <label>
                    <input ng-click="changeExhangeType(voucher.ExchangeType)" type="radio" name="source" ng-model="voucher.ExchangeType" value="Gain" ng-disabled="voucherDetailList.length">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>Gain
                </label>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Party Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Party Type" tabindex="1" class="form-control" submit-required="true" ng-disabled="voucherDetailList.length" ng-model="partyType" required>
                        <option label="Customer" value="Customer" selected="selected">Customer</option>
                        <option label="Vendor" value="Vendor">Vendor</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required autocomplete="off" capitalize>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-change="entityChange(voucher.EntityId)" id="entityId" class="form-control" name="entity" ng-model="voucher.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-8 col-md-8">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea rows="1" type="text" ng-maxlength="250" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-2 col-md-2">
        <button class="btn single-btn" ng-disabled="glDisabled" ng-click="showPartyPopUp()" tabindex=""><i class="glyphicon glyphicon-plus-sign"></i> Select Party</button>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table ">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Party </th>
                    <th>Party Plant</th>
                    <th class="text-center">Amount</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in voucherDetailList">
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>
                        <div class="select-style">
                            <select class="form-control" ng-model="x.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }:true"></select>
                        </div>
                    </td>
                    <td><input type="text" class="form-control text-right" id="vdDrAmount" ng-model="x.Amount " n-decimals="4" tabindex="11" ng-change="checkDrAmount($index)" autocomplete="off"></td>
                    <td class="text-right">
                        <button ng-click="removeRow($index)" data-toggle="modal" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right ">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="voucherListParameters.searchBy">
                                <option ng-repeat="option in searchvoucherList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="voucherListParameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>Posting Date</th>
                    <th>Doc No</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:voucherListParameters.pageSize" total-items="voucherListParameters.total_count" ng-dblclick="Get(x);">
                    @*Clear();*@
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.DrAmount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li><a class="btn btn-action" href="Accounts/Voucher/GetExchangeVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.Id}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Voucher/GetExchangeVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.Id}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(voucherId)"></confirm-archive-generic>