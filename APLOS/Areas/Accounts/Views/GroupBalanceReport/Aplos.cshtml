<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Group Balance Report</h3>
<div class="form-elements form-horizontal" ng-form="from0">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors id="div_GL">
                <label class="col-sm-3 control-label">GL<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <div class="input-group">
                        <div class="select-style">
                            <select name="Fiscal Year" class="form-control searchableDDL" ng-change="getBudgetMasterCboList(report.GLGeneralInfoId);" ng-model="report.GLGeneralInfoId" required>
                                <option ng-repeat="option in glList" value="{{option.GLGeneralInfoId}}">{{option.GLGeneralInfoCode}} - {{option.GLGeneralInfoName}}</option>
                            </select>
                        </div>
                        <span class="input-group-btn">
                            <button ng-click="GetCOAICodeList();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Budget</label>
                <div class="col-sm-9">
                    <div class="select-style">
                        <select name="Budget" class="form-control searchableDDL" ng-model="report.BudgetMasterId" ng-change="getBudgetMasterActivityCbo(report.BudgetMasterId)">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in budgetList" value="{{option.BudgetMasterId}}">{{option.BudgetName}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-3 control-label">Format<sup>*</sup></label>
                <div class="col-sm-9 radio">
                    <label>
                        <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                        <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                    </label>
                    <label>
                        <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                        <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                    </label>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors id="div_FromDate">
                <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <input type="text" name="Form Date" ng-model="report.FromDate" datepicker tabindex="2" class="form-control">
                </div>
            </div>
            <div class="form-group" show-errors id="div_ToDate">
                <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-9  show-message">
                    <input type="text" name="To Date" ng-model="report.ToDate" datepicker tabindex="3" class="form-control">
                </div>
            </div>

        </div>
        <div class="common-btn" style="margin-right: 15px;                                                                                        ">
            <ul class="list-inline text-right">
                <li><button ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                @*<li><button ng-click="getReportWithDocRef();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Doc</button></li>*@
            </ul>
        </div>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLBudgetPopUp.cshtml")