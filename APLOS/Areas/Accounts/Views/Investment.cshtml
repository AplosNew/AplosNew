<togglable name="Investment"></togglable>
<div class="form-elements form-horizontal" id="form0" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type" tooltip>Transaction Type<sup>*</sup></label>
            <div class="radio col-sm-8 col-xs-8">
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('InvestmentGiven')" ng-model="voucher.TransactionType" value="@Library.Model.Enums.TransactionType.InvestmentGiven.ToString()">
                    <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Given
                </label>
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('InvestmentTaken')" ng-model="voucher.TransactionType" value="@Library.Model.Enums.TransactionType.InvestmentTaken.ToString()">
                    <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Taken
                </label>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" ng-disabled="voucherDetailList.length" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" autocomplete="off" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" autocomplete="off" tabindex="3">
            </div>
        </div>
        <div id="div_TransactionType" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Investment Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style" ng-show="voucher.TransactionType=='InvestmentGiven'">
                    <select ng-change="getTransactionTypeGL(voucher.FinancingTypeId)" name="Investment Type" class="form-control" ng-model="voucher.FinancingTypeId" tabindex="4" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.AssetUserName}}</option>
                    </select>
                </div>
                <div class="select-style" ng-show="voucher.TransactionType=='InvestmentTaken'">
                    <select ng-change="getTransactionTypeGL(voucher.FinancingTypeId)" name="Transaction Type" class="form-control" ng-model="voucher.FinancingTypeId" tabindex="4" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.LiabilityUserName}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required autocomplete="off" capitalize>
            </div>
        </div>
        <div class="form-group" id="div_qty" show-errors>
            <label class="col-sm-3 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-6 show-message" style="padding-right:0px;">
                <input name="Amount" tabindex="19" ng-model="voucher.Amount" ng-change="exchangeAmount();" n-decimals="2" class="form-control text-right" required autocomplete="off">
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <div class="select-style">
                    <select id="currencyId" class="form-control" tabindex="7" name="Currency" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Rate<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="6" required autocomplete="off" n-decimals="4" ng-disabled="voucher.CurrencyId==companyCurrencyId">
            </div>
        </div>
    </div>
    <div class="col-xs-8 col-sm-8 col-md-8">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea rows="1" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" capitalize required></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-md-6 col-sm-6 col-xs-6">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.InvestmentGiven.ToString()'">From</legend>
            <legend class="scheduler-border" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.InvestmentTaken.ToString()'">To</legend>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <div class="radio">
                        <label>
                            <input ng-click="changeSourceFrom('Bank')" type="radio" name="source" ng-model="voucher.PaymentSource" value="Bank">
                            <span class="cr" tabindex="12"><i class="cr-icon"></i></span>Bank
                        </label>
                        <label>
                            <input ng-click="changeSourceFrom('Cash')" type="radio" name="source" ng-model="voucher.PaymentSource" value="Cash">
                            <span class="cr" tabindex="11"><i class="cr-icon"></i></span>Cash
                        </label>
                    </div>
                </div>
            </div>
            <div class="col-xs-8 col-sm-8 col-md-8">
                <div ng-show="voucher.PaymentSource=='Bank'" class="form-group">
                    <div class="col-sm-12 ">
                        <div class="select-style">
                            <select name="Bank" class="form-control" submit-required="true" ng-model="voucher.BankMasterId" ng-options="item.Id as item.AccountTitle for item in bankMasterList">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div ng-show="voucher.PaymentSource=='Cash'" class="form-group">
                    <div class="col-sm-12 ">
                        <div class="select-style">
                            <select name="Cash" class="form-control" submit-required="true" ng-model="voucher.CashMasterId" ng-options="item.Id as item.UserName for item in cashMasterList">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.InvestmentGiven.ToString()'">To</legend>
            <legend class="scheduler-border" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.InvestmentTaken.ToString()'">From</legend>
            <div class="col-xs-5 col-sm-5 col-md-5">
                <div class="form-group">
                    <div class="radio">
                        <label>
                            <input ng-click="changeSourceTo('Bank')" type="radio" name="sourceParty" ng-model="voucher.PartyType" value="@Library.Model.Parties.PartyType.Bank.ToString()">
                            <span class="cr" tabindex="12"><i class="cr-icon"></i></span>@Library.Model.Parties.PartyType.Bank.ToString()
                        </label>
                        <label>
                            <input ng-click="changeSourceTo('Customer')" type="radio" name="sourceParty" ng-model="voucher.PartyType" value="@Library.Model.Parties.PartyType.Customer.ToString()">
                            <span class="cr" tabindex="11"><i class="cr-icon"></i></span>@Library.Model.Parties.PartyType.Customer.ToString()
                        </label>
                        <label>
                            <input ng-click="changeSourceTo('Vendor')" type="radio" name="sourceParty" ng-model="voucher.PartyType" value="@Library.Model.Parties.PartyType.Vendor.ToString()">
                            <span class="cr" tabindex="11"><i class="cr-icon"></i></span>@Library.Model.Parties.PartyType.Vendor.ToString()
                        </label>
                        <label>
                            <input ng-click="changeSourceTo('Director')" type="radio" name="sourceParty" ng-model="voucher.PartyType" value="@Library.Model.Parties.PartyType.Director.ToString()">
                            <span class="cr" tabindex="12"><i class="cr-icon"></i></span>@Library.Model.Parties.PartyType.Director.ToString()
                        </label>
                    </div>
                </div>
                <div class="form-group" ng-show="voucher.PartyType=='Customer'|| voucher.PartyType=='Vendor'">
                    <label class="col-sm-3 control-label">Location</label>
                </div>
            </div>
            <div class="col-xs-7 col-sm-7 col-md-7">
                <div ng-show="voucher.PartyType=='Customer'|| voucher.PartyType=='Vendor'" class="form-group">
                    <div class="col-sm-12 show-message">
                        <div class="input-group">
                            <input type="text" name="Code" ng-model="voucher.PartyName" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="getCustomerGL();" class="btn single-small-btn" tabindex="10"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div ng-show="voucher.PartyType=='Bank'" class="form-group">
                    <div class="col-sm-12">
                        <div class="select-style">
                            <select name="Bank" class="form-control" submit-required="true" ng-model="voucher.OtherBankMasterId" ng-options="item.Id as item.AccountTitle for item in investmentbankMasterList">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div ng-show="voucher.PartyType=='Director'" class="form-group">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <div class="select-style">
                                <select name="Director" class="form-control" ng-change="changeDirector();" ng-model="voucher.PartyId" tabindex="4">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in directorList" value="{{option.Id}}">{{option.UserName}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group" ng-show="voucher.PartyType=='Customer'|| voucher.PartyType=='Vendor'">
                    <div class="col-sm-12 show-message">
                        <div class="input-group">
                            <div class="select-style">
                                <select tabindex="1" class="form-control" name="location" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }">
                                    <option value=""></option>
                                </select>
                            </div>
                            <span class="input-group-btn">
                                <button ng-click="showPartyPlantPopUp(voucher.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(financingId.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in investmentGivenList |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PostingDate| dateFiltering}}</td>
                <td>{{x.DocDate| dateFiltering}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td>{{x.IsPark?'Parked':'Posted'}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                        <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                        <li><a class="btn btn-action" href="Accounts/Investment/InvestmentReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Accounts/Investment/InvestmentReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("~/Areas/Parties/Views/Party/_PartyPopUp.cshtml")
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(financingId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(financingId,voucherId)"></confirm-archive-generic>
