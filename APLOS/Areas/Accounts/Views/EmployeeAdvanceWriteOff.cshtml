<togglable name="{{title}}"></togglable>
<div class="form-horizontal form-elements" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Advance<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Employee.ToString()" ng-model="advance.VoucherNo" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeAdvancePopUpList();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Employee.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Employee.ToString()" ng-model="advance.EmployeeName" class="form-control" readonly>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Advance Amount</label>
            <div class="col-sm-8 show-message">
                <input tabindex="1" type="text" name="Advance Amount" ng-model="advance.AdvanceAmount" class="form-control text-right" readonly>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Settlement Type<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="SetOff">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>Set-Off via Payable
                </label>
                <label>
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.Return.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>Returned by Employee
                </label>
                <label>
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.Others.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>GL
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.Return.ToString()'">
            <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input ng-click="clearBankPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="Bank">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
                <label>
                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="advance.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" datepicker="checkPostingDate(); getFiscalYearPeriod(advance.PostingDate);" name="PostingDate" ng-model="advance.PostingDate" class="form-control" tabindex="1" autocomplete="off" required>
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="advance.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="5" name="CurrencyTransaction" ng-model="advance.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.Return.ToString()'&&advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Bank" class="form-control" submit-required="true" ng-model="advance.BankMasterId" ng-options="item.Id as item.AccountTitle for item in bankMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.BankMasterId">
            <label class="col-sm-4 control-label">Bank Ref No</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Bank Reference No" name="Bank Reference No" ng-model="advance.BankReferenceNo" class="form-control" tabindex="5" autocomplete="off">
            </div>
        </div>
        <div class="form-group" ng-show="advance.BankMasterId">
            <label class="col-sm-4 control-label">Bank Trn Date</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="BankTransactionDate" ng-model="advance.BankTransactionDate" datepicker class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.Return.ToString()'&&advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Cash" class="form-control" submit-required="true" ng-model="advance.CashMasterId" ng-options="item.Id as item.UserName for item in cashMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.SetOff.ToString()'">
            <label class="col-sm-4 control-label">Invoice<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="common-btn">
                        <button ng-click="showEmployeePayablePopUp(advance.EmployeeId);" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Payable</button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.Others.ToString()'">
            <label class="col-sm-4 control-label">GL<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="common-btn">
                        <button ng-click="popUp();" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> Add GL</button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="advance.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(advance.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="25" name="Doc Ref" ng-model="advance.DocRefNo" class="form-control" tabindex="4" required autocomplete="off">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <textarea rows="3" type="text" name="Narration" tabindex="8" class="form-control" ng-model="advance.Narration" required capitalize></textarea>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.Return.ToString()'">
            <label class="col-sm-3 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" name="Amount" ng-model="advance.Amount" class="form-control text-right" tabindex="4" autocomplete="off" n-decimals="2">
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-hide="voucherDetailList.length==0">
        <table class="table table-responsive table-striped">
            <thead>
                <tr>
                    <th>Voucher No</th>
                    <th>Currency</th>
                    <th>Payable</th>
                    <th>Set-off Amount</th>
                    <th>Balance</th>
                    <th>Payment Amount</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in voucherDetailList">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Receivable | number:2}}</td>
                    <td class="text-right">{{x.Received | number:2}}</td>
                    <td class="text-right">{{x.Balance | number:2}}</td>
                    <td><input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.Amount" ng-keyup="checkAmount()"></td>
                    <td class="text-right">
                        <button ng-click="removeRow($index)" data-toggle="modal" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="voucherDetailList.length">
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'Amount' }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="voucherDetailGLList.length" style="padding-top:10px;">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th style="width:200px;">GL</th>
                    <th>Budget</th>
                    <th>Activity</th>
                    <th> Amount</th>
                    <th style="width:130px;">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in voucherDetailGLList | filter:{TrnType:'Dr'}">
                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                    <td>{{x.BudgetName}}</td>
                    <td>{{x.ActivityName}}</td>
                    <td>
                        <div class="show-message">
                            <input type="text" n-decimals="3" class="form-control text-right" ng-model="x.DrAmount">
                        </div>
                    </td>
                    <td class="text-right">
                        <button ng-click="removeGLRow($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td></td>
                    <td colspan="2" class="text-right">Total</td>
                    <td class="text-right"><b>{{ (voucherDetailGLList | filter:{TrnType:'Dr'}) | sumByKey:'DrAmount'| number:3 }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="advance.Id==null"><button ng-click="confirmPost(advance.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>@Library.Model.Parties.PartyType.Employee.ToString()</th>
                    <th>Posting Date</th>
                    <th>Doc Date</th>
                    <th>Doc Ref</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in advanceList |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.EmployeeCode}} - {{x.EmployeeName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.DocDate | dateFiltering}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/GetEmployeeAdvanceWriteOffReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/GetEmployeeAdvanceWriteOffReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/_EmployeeAdvancePopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_EmployeePayablePopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_CashPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLMappingPopUp.cshtml")
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(advanceWriteOffId,voucherId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(advanceWriteOffId)"></confirm-archive-generic>