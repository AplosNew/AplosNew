@Html.Partial("~/Areas/Banks/Views/_CashPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
