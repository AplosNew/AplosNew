<togglable name="Employee Payment"></togglable>
<div class="form-elements form-horizontal" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Employee</label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input type="text" name="Code" ng-model="voucher.EmployeeName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button class="single-btn tooltip-here" data-placement="top" title="Select Vendor" ng-click="showEmployeeListPopUp();"><i class="fa fa-search" tabindex="9"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Total Advance<sup>*</sup></label>
            <div class="col-sm-9 show-message" show-errors>
                <div class="input-group">
                    <input type="text" n-decimals="2" class="form-control text-right" readonly name="TotalAdvanceAmount" ng-model="TotalAdvanceAmount" style="color:red">
                    <span class="input-group-btn">
                        <button class="single-btn tooltip-here" data-placement="top" title="Select Vendor" ng-click="showEmployeeOutStanding();"><i class="glyphicon glyphicon-list" tabindex="9"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input ng-click="clearBankCash()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
                <label>
                    <input ng-click="clearBankCash()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-3 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input tabindex="22" type="text" name="CashName" ng-model="voucher.BankName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showBankPopUp(voucher.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankMasterId">
            <label class="col-sm-4 control-label">Bank Ref No</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Bank Reference No" name="Bank Reference No" ng-model="voucher.BankReferenceNo" class="form-control" tabindex="5" autocomplete="off">
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BankMasterId">
            <label class="col-sm-4 control-label">Bank Trn Date</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="BankTransactionDate" ng-model="voucher.BankTransactionDate" datepicker class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-3 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="voucher.CashName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showCashPopUp(null, voucher.EntityId);" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();getFiscalYearPeriod(voucher.PostingDate);checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Rounding</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="RoundingType" ng-model="voucher.RoundingType" tabindex="3">
                        <option ng-repeat="option in roundingTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="20" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" ng-disabled="true" tabindex="5"
                            name="CurrencyTransaction" ng-model="voucher.CurrencyId">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Rounding Amount</label>
            <div class="col-sm-9">
                <input type="text" ng-disabled="voucher.RoundingType=='None'" n-decimals="4"
                       title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="RoundingAmount" ng-model="voucher.RoundingAmount">
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-8 col-md-8">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea rows="1" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="input-group">
            <span class="common-btn">
                <button ng-click="getPopupEmployeePayableList();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Payable</button>
            </span>
        </div>
    </div>
    <div class="clearfix"></div>
    <br />
    <div class="table-responsive modal-table" ng-show="voucherDetailList.length">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Voucher No</th>
                    <th>DocDate</th>
                    <th>Doc Ref No</th>
                    <th>Posting Date</th>
                    <th>Currency</th>
                    <th>Payable</th>
                    <th>Payment</th>
                    <th>Balance</th>
                    <th>Amount</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in voucherDetailList">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.DocDate |dateFiltering}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.PostingDate |dateFiltering}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Receivable | number:2}}</td>
                    <td class="text-right">{{x.Received | number:2}}</td>
                    <td class="text-right">{{x.Balance | number:2}}</td>
                    <td><input ng-keyup="convertAmount(x)" type="text" n-decimals="2" class="form-control text-right" name="Amount" ng-model="x.Amount"></td>
                    <td class="text-right">
                        <button ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="voucherDetailList.length">
                <tr>
                    <td colspan="7"></td>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'Amount' }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="confirmSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="advance.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchEmployeePaymentList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Employee</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Doc Ref</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in paymentList |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.EmployeeCode}} - {{x.EmployeeName}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.DocDate | dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td>{{x.RowState}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.RowState=='@Library.Model.Enums.RowState.Parked.ToString()'"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                        <li ng-show="x.RowState=='@Library.Model.Enums.RowState.Parked.ToString()'"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>

                        @*<li><a class="btn btn-action" href="Employees/EmployeeReport/GetEmployeePaymentRdlcReport?voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o">></i></a></li>*@
                        <li><a class="btn btn-action" href="Employees/EmployeeReport/GetEmployeePaymentReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Employees/EmployeeReport/GetEmployeePaymentReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>

                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-archive-generic modalid="confirmSavePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Save()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(payableId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(employeePayableWriteOffId,voucherId)"></confirm-archive-generic>

