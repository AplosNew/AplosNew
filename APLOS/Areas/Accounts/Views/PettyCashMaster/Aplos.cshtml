<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Petty Group</h3>
<div class="form-elements form-horizontal">
    <div class="row" id="mainDiv">
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Service" role="tab" data-toggle="tab">Petty Cash Master</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="AddInfo" role="tab" data-toggle="tab">Petty Cash Group</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="ModelNewForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100" required />
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Category" ng-model="ModelNew.Category" class="form-control" maxlength="15" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sub Category<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Sub Category" ng-model="ModelNew.SubCategory" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Item<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Item" ng-model="ModelNew.Item" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">UOM<sup>*</sup></label>
                            <div class="col-sm-2">
                                <div class="select-style">
                                    <select name="UOM" class="form-control" ng-model="ModelNew.UOMId" ng-options="item.Value as item.Text for item in uOMList" tabindex="13">
                                        @*<option value=""></option>*@
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Rate<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Standard Rate" ng-model="ModelNew.StandardRate" class="form-control" required tabindex="4" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Rate Book Currency<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Standard Rate Book Currency" ng-model="ModelNew.StandardRateBookCurrency" class="form-control" required tabindex="4" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                            @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>
                <div class="row text-right aplos-grid-toggle">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchBy">
                                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive aplos-grid-toggle">
                    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                            @*<div e-column e-field="AddedDate" e-format="{0:dd-MMM-yyyy}"  e-type="date" e-headertext="Date Added" e-width="2"></div>*@
                            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
                            <div e-column e-field="Category" e-headertext="Category" e-width="5"></div>
                            <div e-column e-field="SubCategory" e-headertext="Sub Category" e-width="5"></div>
                            <div e-column e-field="Item" e-headertext="Item" e-width="5"></div>
                            <div e-column e-field="StandardRate" e-headertext="Standard Rate" e-width="5"></div>
                            <div e-column e-field="StandardRateBookCurrency" e-headertext="Standard Rate Book Currency" e-width="5"></div>
                            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
                        </div>
                    </div>
                </div>
                <confirm-modal></confirm-modal>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="PettyGroupForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="SequenceGroup" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNewGroup.Sequence" e-width="100" required />
                        </div>
                    </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Short Name" ng-model="ModelNewGroup.ShortName" class="form-control" maxlength="15" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" ng-model="ModelNewGroup.UserName" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <input type="text" name="Description" ng-model="ModelNewGroup.Description" class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Code" ng-model="ModelNewGroup.Code" class="form-control" required tabindex="2" maxlength="10">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Standard Name" ng-model="ModelNewGroup.StandardName" class="form-control" required tabindex="4" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="ModelNewGroup.Remarks" maxlength="250" tabindex="6"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ModelNewGroup.Active" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveGroup();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActionGroup}}</button></li>
                            @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                            <li> <button ng-click="ClearGroup();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>
                <div class="row text-right aplos-grid-toggle">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByGroup">
                                            <option ng-repeat="option in searchByListGroup" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchgroup" ng-enter="getDataGroup()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getDataGroup()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive aplos-grid-toggle">
                    <div id="GridEdit" ej-grid e-datasource="ModelListGroup" e-recorddoubleclick="GetGroup" e-load="loadGridEdit"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                            @*<div e-column e-field="AddedDate" e-format="{0:dd-MMM-yyyy}"  e-type="date" e-headertext="Date Added" e-width="2"></div>*@
                            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
                            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
                            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
                            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
                            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
                        </div>
                    </div>
                </div>
                <confirm-modal></confirm-modal>
            </div>
        </div>
        </div>
    </div>

