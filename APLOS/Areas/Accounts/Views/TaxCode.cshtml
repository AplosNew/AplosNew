<togglable name="Tax Code"></togglable>
<div class="form-horizontal" ng-form name="taxCodeForm">
    <div class="col-xs-12 col-sm-12 col-md-6 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Country<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Country" submit-required="true" ng-model="taxCode.CountryId" required
                            ng-change="GetTaxCategory(taxCode.CountryId);" ng-options="item.Value as item.Text for item in countryList">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
<div ng-form id="taxcode" name="taxCodeForm" class="form-elements  form-horizontal">
    <input type="hidden" maxlength="10" name="Id" ng-model="taxCode.Id" class="form-control">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="10" name="Code" ng-model="taxCode.Code" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" maxlength="50" name="UserName" ng-model="taxCode.UserName" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Manually Editable</label>
            <div class="checkbox-site ">
                <label class="col-sm-2">
                    <input type="checkbox" id="ManuallyEditable" ng-model="taxCode.ManuallyEditable" tabindex="5">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
            <label class="col-sm-1 control-label">RCM</label>
            <div class="checkbox-site ">
                <label class="col-sm-2">
                    <input type="checkbox" id="IsRCM" ng-model="taxCode.IsRCM" tabindex="7">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoice Triggering Instance</label>
            <div class="col-sm-8 control-label">
                <input type="radio" name="InvoiceOrPayment" ng-model="taxCode.InvoiceOrPayment" value="Invoice" tabindex="7">&nbsp;
                <span>Invoice</span>&nbsp;&nbsp;&nbsp;
                <input type="radio" name="InvoiceOrPayment" ng-model="taxCode.InvoiceOrPayment" value="Payment" tabindex="8">&nbsp;
                <span>Payment</span>&nbsp;&nbsp;&nbsp;
                <input type="radio" name="InvoiceOrPayment" ng-model="taxCode.InvoiceOrPayment" value="Others" tabindex="9">&nbsp;
                <span>Others</span>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Tax Category</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Tax Category" id="taxCategoryId" ng-model="taxCode.TaxCategoryId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in TaxCategoryList" tabindex="2" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="StandardName" ng-model="taxCode.StandardName" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea maxlength="250" class="form-control" rows="1" ng-model="taxCode.Description" tabindex="6"></textarea>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Type</label>
            <div class="col-sm-7">
                <input type="radio" name="InputOrOutput" ng-model="taxCode.InputOrOutput" value="Input" tabindex="9">&nbsp;
                <span>Input</span>&nbsp;&nbsp;&nbsp;&nbsp;
                <input type="radio" name="InputOrOutput" ng-model="taxCode.InputOrOutput" value="Output" tabindex="10">&nbsp;
                <span>Output</span>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Applicable Tax</legend>
            <div class="col-xs-12 col-sm-12 ">
                <label class="col-sm-4 control-label">Withhold</label>
                <div class="checkbox-site ">
                    <label class="col-sm-1 control-label">
                        <input type="checkbox" ng-model="taxCode.IsWithhold" tabindex="11">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
                <div class="col-sm-7"></div>
            </div>
            <div class="col-xs-12 col-sm-12">
                <div class="col-sm-4"></div>
                <div class="col-sm-8 control-label">
                    <input type="radio" name="IsCreditable" ng-model="taxCode.IsCreditable" value="Creditable"  tabindex="12">&nbsp;
                    <span>Creditable</span>
                    <input type="radio" name="IsCreditable" ng-model="taxCode.IsCreditable" value="NonCreditable" tabindex="13">
                    <span>Non Creditable</span>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12">
                <div ng-show="taxCode.IsCreditable=='NonCreditable'">
                    <label class="col-sm-4 control-label">Merge</label>
                    <div class="checkbox-site">
                        <label class="col-sm-1 control-label">
                            <input type="checkbox" ng-model="taxCode.IsMerge">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
                <div class="col-sm-7"></div>
            </div>
        </fieldset>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Tax Base</legend>
            <div class="col-sm-12">
                <input type="radio" name="BaseGrossOrNet" ng-model="taxCode.BaseGrossOrNet" value="Gross" tabindex="14">
                <span>Gross</span>
            </div>
            <div class="col-sm-12">
                <input type="radio" name="BaseGrossOrNet" ng-model="taxCode.BaseGrossOrNet" value="Net" tabindex="15">
                <span>Net</span>
            </div>
            <div class="col-sm-12">
                <input type="radio" name="BaseGrossOrNet" ng-model="taxCode.BaseGrossOrNet" value="BaseOnSequence" tabindex="16">&nbsp;
                <span>Base on Sequence</span>
            </div>
        </fieldset>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="6"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchtaxcodeByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th style="vertical-align: middle; text-align:center" rowspan="2">Code</th>
                <th style="vertical-align: middle; text-align:center" rowspan="2">Tax Code</th>
                <th style="text-align:center" colspan="3">Applicable Tax</th>
                <th style="text-align:center" rowspan="2">Tax Base</th>
                <th style="vertical-align: middle; text-align:center" rowspan="2"> Type</th>
                <th style="vertical-align: middle; text-align:center" rowspan="2"> RCM</th>
                <th style="vertical-align: middle; text-align:center" rowspan="2"> Active</th>
            </tr>
            <tr>
                <th style="vertical-align: middle; text-align:center">Withhold</th>
                <th style="vertical-align: middle; text-align:center">Creditable</th>
                <th style="vertical-align: middle; text-align:center">Merge</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="p in taxcodes |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'test'"
                ng-dblclick="Get(p.Id, $index,COAId);">
                <td>{{p.Code}}</td>
                <td>{{p.UserName}}</td>
                <td style="vertical-align: middle; text-align:center">{{p.IsWithhold?'Yes':'No'}}</td>
                <td style="vertical-align: middle; text-align:center">{{p.IsCreditable?'Yes':'No'}}</td>
                <td style="vertical-align: middle; text-align:center">{{p.IsMerge?'Yes':'No'}}</td>
                <td style="vertical-align: middle; text-align:center">{{p.BaseGrossOrNet}}</td>
                <td style="vertical-align: middle; text-align:center">{{p.InputOrOutput}}</td>
                <td style="vertical-align: middle; text-align:center">{{p.IsRCM?'Yes':'No'}}</td>
                <td style="vertical-align: middle; text-align:center">{{p.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'test'" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-archive-generic modalid="confirmgenericPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeTaxCodeRow()"></confirm-archive-generic>
<confirm-modal></confirm-modal>