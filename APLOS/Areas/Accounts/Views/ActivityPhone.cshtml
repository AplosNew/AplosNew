<togglable name="Activity Phone"></togglable>
<div ng-form id="activityPhone" name="activityPhoneForm" class="form-elements form-horizontal">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="activityPhone.ActivityId"
                            ng-options="item.Value as item.Text for item in activityList" name="Activity" tabindex="1" required></select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Cell Number<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Cell Number" ng-model="activityPhone.CellNumber" class="form-control" tabindex="4" required>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="activityPhone.Active" tabindex="6">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-3 control-label">Vendor<sup>*</sup></label>
            <div class="col-sm-6">
                <input type="hidden" ng-model="activityPhone.PartyId">
                <input tabindex="2" type="text" name="Code" ng-model="activityPhone.PartyName" class="form-control">
            </div>
            <button tabindex="3" class="single-btn tooltip-here" data-placement="top" title="Select Customer" ng-click="showPartyPopUp();"><i class="fa fa-search"></i></button>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Land Phone</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="activityPhone.IsLandPhone" tabindex="5">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByActivityList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Cell Number</th>
                <th>Vendor</th>
                <th>Land Phone</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in activityPhones |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'activityPhones'" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.CellNumber}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.IsLandPhone?'Yes':'No'}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true"
                             pagination-id="metaData.name + 'activityPhones'"
                             boundary-links="true" on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")