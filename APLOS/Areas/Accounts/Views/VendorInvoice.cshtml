                <td>{{x.CheckStatus}}</td>
                <td>{{x.IsPark?'Parked':'Posted'}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.IsPark"><a ng-click="ShowJournalPopUp(x.Id,x.BeneficiaryType,x.AdditionalTaxId,x);" ng-disabled="x.ApprovedByStatus=='ToBeApproved'" href="" class="btn btn-action tooltip-here">Post</a></li>
                        <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId,x.BeneficiaryType,x.TDSVoucherId,x.TDSVoucherNo);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                        <li ng-show="x.IsTDSTaxPost=='TDSParked'"><a ng-disabled="x.IsPark" ng-click="onClickadditionalTaxPop(x);" href="" class="btn btn-action tooltip-here">Post TDS</a></li>
                        <li><a class="btn btn-action" ng-click="VendorInvoiceReport('Pdf',x.VoucherId,x.BeneficiaryType)"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" ng-click="VendorInvoiceReport('Excel',x.VoucherId,x.BeneficiaryType)"><i class="fa fa-file-excel-o"></i></a></li>
                        <li ng-show="x.IsTDSTaxPost=='TDSPosted'"><a ng-click="TDSVouchereReport('Pdf',x.TDSVoucherId);" href="" class="btn btn-action tooltip-here">TDS Report</a></li>
                        <li ng-show="x.IsExpenseDistribution"><a ng-click="ExpenseDistributionReport('Excel',x.VoucherId);" class="btn btn-action" title="Expense Distribution Report"><i class="fa fa-file-excel-o"></i></a></li>
                        <li ng-show="x.IsAssetDistribution"><a ng-click="AssetDistributionReport('Excel',x.VoucherId);" class="btn btn-action" title="Asset Distribution Report"><i class="fa fa-file-excel-o"></i></a></li>

                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
