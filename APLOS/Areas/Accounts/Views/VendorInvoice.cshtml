<togglable name="Inbound Invoice"></togglable>
<div class="form-horizontal form-elements" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group">
            <label class="col-sm-3 control-label">Type<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input ng-disabled="voucher.Id" type="radio" name="InvoiceType" ng-model="voucher.InvoiceType" value="Vendor">
                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>Vendor
                </label>
                <label>
                    <input ng-disabled="voucher.Id" type="radio" name="InvoiceType" ng-model="voucher.InvoiceType" value="LC">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>LC
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.InvoiceType=='LC'">
            <label class="col-sm-3 control-label">LC No<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="LCRef" ng-model="voucher.LCRef" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getPurchaseLCData();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">@Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="voucher.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        @*<button ng-click="showPartyPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>*@
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Invoicing @Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="1" class="form-control" name="Location" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(advance.PartyPlantId,'billTo'); updateCrAmount();" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(voucher.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Payment Term<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <div class="select-style">
                    <select tabindex="10" required id="paymentTermId" class="form-control" name="Payment Term" ng-model="voucher.PaymentTermId" ng-change="changePaymentTerm(voucher.PaymentTermId);">
                        <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <label class="col-sm-3 control-label">Due Date BaseOn<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <input type="text" name="BaseOnDueDate" ng-model="voucher.BaseOnDueDate" ng-change="getMatureDate(voucher.BaseOnDueDate,voucher.BaseNoOfDays)" datepicker class="form-control datepicker" tabindex="11" required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">No Of Days</label>
            <div class="col-sm-3 show-message">
                <input id="baseNoOfday" type="number" name="No Of Days" ng-model="voucher.BaseNoOfDays" ng-change="getMatureDate(voucher.BaseOnDueDate, voucher.BaseNoOfDays)" class="form-control" tabindex="12" required>
            </div>
            <label class="col-sm-3 control-label">Mature Date</label>
            <div class="col-sm-3 show-message">
                <input type="text" name="Mature Date" ng-model="voucher.MatureDate" class="form-control" readonly required>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Source<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input ng-click="clearSourceInfo()" ng-disabled="voucher.InvoiceType=='LC'" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.GL.ToString()">
                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.GL.ToString()
                </label>
                <label>
                    <input ng-click="clearSourceInfo()" ng-disabled="voucher.Id" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
                <label ng-show="voucher.InvoiceType=='LC'">
                    <input ng-disabled="voucher.Id" ng-click="clearSourceInfo()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Loan.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Loan.ToString()
                </label>
                <label ng-show="voucher.InvoiceType=='LC'">
                    <input ng-disabled="voucher.Id" ng-click="clearSourceInfo()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();changePostingGetTaxCode();" id="postingDate" type="text" name="Posting Date" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyId" class="form-control" ng-disabled="currencyDisable" tabindex="5" name="Currency" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off" ng-disabled="voucher.CurrencyId==companyCurrencyId">
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Cash" class="form-control" ng-disabled="voucher.Id" ng-model="voucher.CashMasterId" ng-options="item.Id as item.UserName for item in cashMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="voucher.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{voucher.BankName}}" tooltip>
                    <span class="input-group-btn">
                        <button ng-click="showBankPopUp(voucher.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.CurrencyId!=voucher.BankCurrencyId && voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()' && voucher.BankMasterId!=null">
            <label class="col-sm-4 control-label">Bank Amount<sup>*</sup></label>
            <div class="col-sm-2 show-message" style="padding-right:0px;">
                <input type="text" readonly class="form-control text-right" name="BankCurrencyCode" ng-model="voucher.BankCurrencyCode">
            </div>
            <div class="col-sm-6 show-message" style="padding-left:0px;" ng-disabled="voucher.CurrencyId==voucher.BankCurrencyId">
                <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="BankAmount" ng-model="voucher.BankAmount" ng-keyup="recalBankAmount()" autocomplete="off">
            </div>
        </div>
        <div class="form-group" ng-show="approvedByList.length">
            <label class="col-sm-4 control-label">Approved By<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style" style="font-size:smaller">
                    <select name="ApprovedById" id="ApprovedById" ng-model="voucher.ApprovedById" class="form-control"
                            ng-options="item.Id as item.Value for item in approvedByList" tabindex="6"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="Entity" ng-change="GetCboCostCenterIdByEntity(voucher.EntityId)" ng-model="voucher.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" ng-keyup="CheckSpecialCharecter();" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoice Amount <sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input tabindex="6" ng-model="voucher.Amount" name="Amount" type="text" n-decimals="3" class="form-control text-right" required autocomplete="off">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Tax Excluding</label>
            <div class="checkbox-site">
                <label class="col-sm-8">
                    <input type="checkbox" id="IsExcludingTax" ng-disabled="voucher.Id" ng-checked="excludeTaxCalculate()" ng-model="voucher.IsExcludingTax" tabindex="9">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group">
            <label class="col-sm-3 control-label">Beneficiary<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" ng-change="changeBefeficiary()" name="CurrencyTransaction" ng-model="voucher.BeneficiaryType" required tabindex="3">
                        <option ng-repeat="option in beneficiaryTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors ng-show="voucher.BeneficiaryType=='Employee'">
            <label class="col-sm-3 control-label">Employee<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="EmployeeName" ng-model="voucher.EmployeeName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearEmployee()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.BeneficiaryType=='Employee'">
            <label class="col-sm-3 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Transaction Type" class="form-control"
                            ng-model="voucher.EmployeeTransactionTypeId" ng-change="selectTransactionTye(voucher.EmployeeTransactionTypeId)" tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in employeeTransactionTypeList" value="{{option.EmployeeTransactionTypeId}}">{{option.EmployeeTransactionTypeName}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-7 col-md-7">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea rows="1" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" maxlength="500" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-2 col-md-2" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.GL.ToString()'">
        <button ng-click="popUp();" class="btn single-btn" ng-hide="companyConfig.IsInboundInvoiceServiceApplicable" ng-disabled="voucher.InvoiceType=='LC'"><i class="glyphicon glyphicon-plus"></i> Add GL</button>
        <button ng-click="getServiceDataList();" class="btn" ng-hide="companyConfig.IsInboundInvoiceServiceApplicable==0"><i class="glyphicon glyphicon-plus"></i> Add  Charges</button>
        <button ng-click="getServiceDataPartyWiseList();" class="btn" ng-hide="voucher.PartyId==null || companyConfig.IsInboundInvoiceServiceApplicable==0"><i class="glyphicon glyphicon-plus"></i> Add Party Wise Charges</button>

    </div>
    <div class="col-xs-12 col-sm-2 col-md-2" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Loan.ToString()'">
        <button class="btn single-btn" ng-click="showloanPopUp()" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Select Loan</button>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="voucherDetailList.length" style="padding-top:10px;">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th style="width:200px;">GL</th>
                    <th>Budget</th>
                    <th>Activity</th>
                    <th>Service Name</th>
                    <th>Cost Center</th>
                    <th>Taxable Amount</th>
                    <th>Total Tax</th>
                    <th>Total Amount</th>
                    <th style="width:130px;">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in voucherDetailList | filter:{TrnType:'Dr'}">
                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                    <td>{{x.BudgetName}}</td>
                    <td>{{x.ActivityName}}</td>
                    <td>{{x.ServiceName}}</td>
                    <td>
                        <select class="form-control" ng-disabled="x.AccountType!='Expense'" ng-model="x.CostCenterId" ng-options="item.Value as item.Text for item in costCenterCboList| filter:{ Value: x.CostCenterId }:true"></select>
                    </td>
                    <td id="td_CrAmount_{{$index}}">
                        <div class="show-message">
                            <input type="text" n-decimals="3" class="form-control text-right" ng-model="x.Amount" ng-keyup="calculatebackTax($index);calculateTax(x.Id,$index);checkRowValidation(x, $index);calReDistributedAmount($index,x);">
                        </div>
                    </td>
                    <td>
                        <div class="show-message">
                            <input type="text" n-decimals="3" class="form-control text-right" ng-model="x.TotalTax" readonly>
                        </div>
                    </td>

                    <td>
                        <div class="show-message">
                            <input type="text" n-decimals="3" class="form-control text-right" ng-model="x.TotalAmount" readonly>
                        </div>
                    </td>
                    <td class="text-right">
                        <button ng-click="getExpenseDistribute($index,x)" ng-show="x.IsOrderSpecific" ng-disabled="x.TotalAmount == 0 || TotalChargesAmount == 0 " class="btn btn-action tooltip-here" data-placement="top" title="Expense Distribute">
                            <i>Distribute</i>
                        </button>
                        <button ng-click="getAssetDistribute($index,x)" ng-show="x.IsAssetApplicable" ng-disabled="x.TotalAmount == 0 || TotalChargesAmount == 0 " class="btn btn-action tooltip-here" data-placement="top" title="Asset Distribute">
                            <i>Distribute</i>
                        </button>
                        <button ng-click="getTaxCode($index,x.Id)" class="btn btn-action tooltip-here" data-placement="top" title="Tax">
                            <i>Tax</i>
                        </button>
                        <button ng-click="ChangeGLpopUp(x,$index)" ng-show="voucher.Id" class="btn btn-action tooltip-here" data-placement="top" title="Tax">
                            <i>GL Change</i>
                        </button>
                        <button ng-click="removeRow($index)" ng-hide="voucher.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td></td>
                    <td colspan="3" class="text-right">Total</td>
                    <td class="text-right"><b>{{ (voucherDetailList | filter:{TrnType:'Dr'}) | sumByKey:'Amount'| number:3 }}</b></td>
                    <td class="text-right"><b>{{ (voucherDetailList | filter:{TrnType:'Dr'}) | sumByKey:'TotalTax'| number:3 }}</b></td>
                    <td class="text-right"><b>{{ (voucherDetailList | filter:{TrnType:'Dr'}) | sumByKey:'TotalAmount'| number:3 }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="clearfix"></div>
    <div class="col-md-12 col-sm-12 col-xs-12" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Loan.ToString()'">
        <fieldset class="scheduler-border" ng-show="ExistingLoanList.length">
            <legend class="scheduler-border">Loan Detail</legend>
            <div class="table-responsive modal-table">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>VoucherNo</th>
                            <th>Particulars</th>
                            <th>Posting Date</th>
                            <th>Doc Date</th>
                            <th>Doc Ref</th>
                            <th>Currency</th>
                            <th>Amount</th>
                            <th>Subsequent Sanction</th>
                            <th>Interest</th>
                            <th>Charges</th>
                            <th>Total Loan</th>
                            <th>Total SetOff</th>
                            <th>Balance</th>
                            <th>SetOff Amount</th>
                            <th>To Currency Rate</th>
                            <th>Conversion Amount</th>
                            <th>Exchange Type</th>
                            <th>Exchange Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in ExistingLoanList">
                            <td>{{x.VoucherNo}}</td>
                            <td>{{x.PartyName}}</td>
                            <td>{{x.LoanPostingDate| dateFiltering}}</td>
                            <td>{{x.LoanDocDate| dateFiltering}}</td>
                            <td>{{x.LoanDocRefNo}}</td>
                            <td>{{x.CurrencyCode}}</td>
                            <td class="text-right">{{x.LoanAmount | number:2}}</td>
                            <td class="text-right">{{x.AdditionalLoanAmount | number:2}}</td>
                            <td class="text-right">{{x.InterestAmount | number:2}}</td>
                            <td class="text-right">{{x.OtherExpensesPayable | number:2}}</td>
                            <td class="text-right">{{x.TotalLoanLiability | number:2}}</td>
                            <td class="text-right">{{x.LoanSetOff | number:2}}</td>
                            <td class="text-right">{{x.Balance | number:2}}</td>
                            <td>
                                <input type="text" ng-keyup="exchangeGainLossAmountExistingLoan(x)" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="x.LoanSetOffAmount">
                            </td>
                            <td>
                                <input type="text" ng-keyup="exchangeGainLossAmountExistingLoan(x)" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ToCurrencyRate" autocomplete="off" ng-model="x.ToCurrencyRate">
                            </td>
                            <td>
                                <input type="text" readonly n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ConversionAmount" ng-model="x.ConversionAmount">
                            </td>
                            <td>
                                <input type="text" readonly n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeType" ng-model="x.ExchangeType">
                            </td>
                            <td>
                                <input type="text" readonly n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeAmount" ng-model="x.ExchangeAmount">
                            </td>

                            <td class="text-right">
                                <button ng-click="removeRowLoan($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="13" class="text-right">Total</td>
