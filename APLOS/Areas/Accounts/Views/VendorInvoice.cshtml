<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Particulars</th>
                <th>Invoicing @Library.Model.Parties.PartyType.Vendor.ToString()</th>
                <th>Posting Date</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Written-off Amount</th>
                <th>Balance</th>
                <th>Beneficiary</th>
