                    </td>
                    <td>
                        <div>
                            <input type="text" n-decimals="3" class="form-control text-right" ng-disabled="advanceTax.Type =='FixedPercentage' && advanceTax.ValueOfFixed!=null" ng-model="advanceTax.ValueOfFixed">
                        </div>
                    </td>
                    <td id="td_TaxCodeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="3" class="form-control text-right" ng-model="advanceTax.TaxAmount" ng-keyup="copyTaxesAmount();">
