<togglable name="Invoice Overhead Post"></togglable>
<div class="table-responsive modal-table aplos-grid-toggle">
    <div class="aplos-grid-toggle">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);" href="" aria-controls="general" role="tab" data-toggle="tab">Non Posted</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="Service" role="tab" data-toggle="tab">Posted</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row">
                        <div class="content-container-fluid" style="color:black;">
                                <div style="color:black;" id="popUpData" ej-grid e-datasource="invoiceList"
                                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                                     e-filtersettings-filterType="excel" e-recorddoubleclick="Get"
                                     e-enabletouch="true" e-allowselection="true" e-templaterefresh="refreshTemplate"
                                     e-rowdatabound="rowDataBound" e-scrollsettings="scroll">
                                    <div e-columns>
                                        <div e-column e-field="Id" e-headertext="ChargesNo" e-width="50"></div>
                                        <div e-column e-field="PartyName" e-headertext="Party" e-width="100"></div>
                                        <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                        <div e-column e-field="DocRefNo" e-headertext="DocRefNo" e-width="60"></div>
                                        <div e-column e-field="DocDate" e-headertext="Doc Date" e-width="60"></div>
                                        <div e-column e-field="TransactionAmount" e-headertext="Amount" e-width="100"></div>
                                        <div e-column e-field="TotalTaxAmount" e-headertext="Tax" e-width="100"></div>
                                    </div>
                                </div>
                            </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row">
                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="GridPrint" ej-grid e-datasource="invoicePostedList"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                                 e-filtersettings-filterType="excel" 
                                 e-enabletouch="true" e-allowselection="true" e-templaterefresh="refreshTemplate"
                                 e-rowdatabound="rowDataBound" e-scrollsettings="scroll">
                                <div e-columns>
                                    <div e-column e-field="InvoiceNo" e-headertext="Invoice No" e-width="50"></div>
                                    <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="50"></div>
                                    <div e-column e-field="Id" e-headertext="ChargesNo" e-width="50"></div>
                                    <div e-column e-field="PartyName" e-headertext="Party" e-width="100"></div>
                                    <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                    <div e-column e-field="DocRefNo" e-headertext="DocRefNo" e-width="60"></div>
                                    <div e-column e-field="DocDate" e-headertext="Doc Date" e-width="60"></div>
                                    <div e-column e-field="TransactionAmount" e-headertext="Amount" e-width="100"></div>
                                    <div e-column e-field="TotalTaxAmount" e-headertext="Tax" e-width="100"></div>
                                    <div e-column e-headertext="PDF" e-commands="commandPDF" e-isunbound=true e-textalign="center" e-width="60"></div>
                                    <div e-column e-headertext="Excel" e-commands="commandExcel" e-isunbound=true e-textalign="left" e-width="60"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="form-horizontal form-elements" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">@Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="voucher.PartyName" class="form-control" readonly required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Invoicing @Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="voucher.PartyName" class="form-control" readonly required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Payment Term<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <div class="select-style">
                    <select tabindex="10" required id="paymentTermId" ng-readonly class="form-control" name="Payment Term" ng-model="voucher.PaymentTermId" ng-change="changePaymentTerm(voucher.PaymentTermId);">
                        <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <label class="col-sm-3 control-label">Due Date BaseOn<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <input type="text" name="BaseOnDueDate" ng-model="voucher.BaseOnDueDate" ng-change="getMatureDate(voucher.BaseOnDueDate,voucher.BaseNoOfDays)" datepicker class="form-control datepicker" tabindex="11" required>
            </div>
        </div>


    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyId" class="form-control" ng-disabled="voucher.Id" tabindex="5" name="Currency" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off" ng-disabled="voucher.CurrencyId==companyCurrencyId">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">No Of Days</label>
            <div class="col-sm-2 show-message">
                <input id="baseNoOfday" type="number" name="No Of Days" ng-model="voucher.BaseNoOfDays" ng-change="getMatureDate(voucher.BaseOnDueDate, voucher.BaseNoOfDays)" class="form-control" tabindex="12" required>
            </div>
            <label class="col-sm-3 control-label">Mature Date</label>
            <div class="col-sm-3 show-message">
                <input type="text" name="Mature Date" ng-model="voucher.MatureDate" class="form-control" readonly required>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-disabled="voucher.Id" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Non Creditable</label>
            <div class="checkbox-site">
                <label class="col-sm-8">
                    <input type="checkbox" id="IsExcludingTax" ng-disabled="voucher.Id" ng-model="voucher.IsNonCreditable" ng-change="CheckIsNonCreditable()" tabindex="9">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea rows="2" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    
    <div class="col-xs-12 col-sm-12 col-md-12" style="padding: 10px;">
                <div class="table-responsive">
                    <div class="col-xs-12 col-sm-12 col-md-12">

                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Charges</th>
                                        <th>Amount (TRN)</th>
                                        <th>Total Tax Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in chargesList">
                                        <td>{{x.ServiceMasterCharges}}</td>
                                        <td class="text-right">{{x.TransactionAmount|number}}</td>
                                        <td class="text-right">{{x.TotalTaxAmount|number}}</td>
                                    </tr>
                                    <tr>
                                        <td colspan="1" class="text-right"><strong>Total : </strong></td>
                                        <td class="text-right"><strong>{{chargesList | sumByKey : 'TransactionAmount'| setDecimal:currencyPrecision| number }}</strong></td>
                                        <td class="text-right"><strong>{{chargesList | sumByKey : 'TotalTaxAmount'| setDecimal:currencyPrecision| number }}</strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="InsertInvoiceOverhead();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>




@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")

<div class="modal fade site-modal in" id="serviceChargesPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> service Charges<button type="button" class="close" ng-click="closeServiceChargesInfoPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="clearfix"></div>
                <div>
                    <p class="col-md-11"></p>
                    <button type="button" class="btn btn-action" ng-click="AddTaxRow();">Add Tax</button>
                </div>
                <div class="col-md-12 modal-table table-responsive" style="padding-top: 13px;">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Tax Category</th>
                                <th>HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in TaxCopyLisForDisplay">
                                <td>
                                    @*{{x.UserName}}*@
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList" @*ng-change="onchangeFunction1(x.TaxCategoryId)"*@></select>
                                    </div>
                                </td>
                                <td>{{x.HSNCode}}</td>
                                <td class="text-right">{{x.Percentage}}</td>
                                <td class="text-right">
                                    <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.TaxAmount" ng-keyup="sumSvcTaxAmount();" class="form-control text-right" />
                                </td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="RemoveTaxRow(x)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            @*<tr>
                                    <td colspan="3" class="text-right">Total Tax (BC)</td>
                                    <td class="text-right">{{serviceModel.TotalTaxAmount| setDecimal:currencyPrecision}}</td>
                                </tr>*@
                        </tbody>
                    </table>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeServiceChargesInfoPopUp();" class="btn"> Done</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="ServiceMasterPopUp" role="dialog" data-backdrop="static">
