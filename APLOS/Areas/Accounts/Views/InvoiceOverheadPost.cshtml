                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Service Master Charges</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="table-responsive">
                        <div id="GridEdit1" ng-init="chkinit()" ej-grid e-datasource="ServiceMasterChargesList" e-recorddoubleclick="selectServiceMasterCharges" e-load="loadGridEdit"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="3"></div>
                                <div e-column e-field="UserName" e-headertext="Chages" e-width="3"></div>
