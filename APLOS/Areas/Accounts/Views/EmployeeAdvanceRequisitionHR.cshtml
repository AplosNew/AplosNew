<togglable name="HR Employee Advance Requisition"></togglable>
<div class="form-horizontal form-elements" ng-form="modelNewForm">
    <div class="row">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Employee.ToString()<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Employee.ToString()" ng-model="model.EmployeeName" class="form-control" readonly required>
                        <span class="input-group-btn">
                            <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker class="form-control" e-dataBound="model.RequisitionAddedDate" e-value="model.RequisitionAddedDate" disabled e-width="100%" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Amount<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" class="form-control" ej-numerictextbox e-decimalplaces="0" e-enablertl="false" e-value="model.Amount" e-width="100%" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Advance Type<sup>*</sup></label>
                <div class="col-sm-8 radio">

                    <label>
                        <input ng-click="setVisible('Salary')" type="radio" name="source" ng-model="model.AdvanceType" value="Salary">
                        <span class="cr" tabindex="18"><i class="cr-icon"></i></span>Salary
                    </label>
                    <label>
                        <input ng-click="setVisible('General');ClearAdvanceReqSchedule()" type="radio" name="source" ng-model="model.AdvanceType" value="General">
                        <span class="cr" tabindex="17"><i class="cr-icon"></i></span>General
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Checked By<sup>*</sup></label>
                <div class="col-sm-8">
                    <input e-required id="ddlcheckedByList" ej-dropdownlist e-datasource="checkedByList" e-fields-value="Id" e-fields-text="Value" e-value="model.CheckedBy" e-width="100%" />
                </div>
            </div>

        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Required Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input id="RequisitionRequiredDate" e-dateformat="dd-MMM-yyyy" ej-datepicker class="form-control" e-dataBound="model.RequisitionRequiredDate" e-value="model.RequisitionRequiredDate" e-width="100%" />

                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="CurrencyId" class="form-control" ng-disabled="currencyList.length == 1" name="CurrencyTransaction" ng-model="model.CurrencyId" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in currencyList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks<sup>*</sup></label>
                <div class="col-sm-8">
                    <textarea class="form-control rounded-0" id="exampleFormControlTextarea1" ng-model="model.Remarks" maxlength="250"></textarea>
                </div>
            </div>
        </div>

    </div>

    @*HR*@
    <div class="col-md-12 col-sm-12 col-xs-12">
        <fieldset class="scheduler-border" ng-show="isVisibleInstallment">
            <legend class="scheduler-border">Advance Schedule</legend>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div id="div_DocDate" class="form-group" show-errors>
                    <label class="col-sm-4 control-label" title="Repayment Start Date" tooltip>First Installment Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Repayment Start Date" ng-model="model.RepaymentStartDate" datepicker="LoadRepamentDetail()" class="form-control" tabindex="8">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Total Payments </label>
                    <div class="col-sm-8 show-message">
                        {{TotalPayments}}
                    </div>
                    <input type="text" maxlength="4" ng-show="false" name="Life Of Year" ng-keyup="totalInstallment();LoadRepamentDetail()" ng-model="model.LifeOfYear" class="form-control text-right" tabindex="10" autocomplete="off">
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Interest Rate<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="number" ng-keyup="LoadRepamentDetail()" maxlength="5" name="Interest Rate" ng-model="model.ProfitRate" class="form-control" tabindex="12" autocomplete="off">
                    </div>
                </div>
                <div class="form-group" show-errors>

                    <label class="col-sm-4 control-label">Total Interest Paid</label>
                    <div class="col-sm-8 show-message">
                        {{TotalInterestPaid}}
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label" title="No. Of Installment Per Year" tooltip>Advance Loan Term (monthly)<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" maxlength="4" name="No. Of Installment Per Year" ng-keyup="totalInstallment();LoadRepamentDetail()" ng-model="model.NoOfInstallmentPerYear" class="form-control text-right" tabindex="11" autocomplete="off">
                        <input type="text" maxlength="10" ng-show="false" name="Total No Of Installment" ng-model="model.TotalNoOfInstallment" class="form-control text-right" tabindex="9" disabled autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                </div>
            </div>
        </fieldset>

    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 modal-table" id="loanDetails" ng-show="isVisibleInstallment">
    </div>
    <br />
    <br />
    @*HR*@

    <div class="common-btn" style="padding-top: 10px;">
        <ul class="common-btn list-inline text-right" style="padding: 20px;">
            <li><button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk right"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Cancel();" class="btn" tabindex="10"><i class="glyphicon glyphicon-repeat"></i> Cancel</button></li>
        </ul>
    </div>
</div>

