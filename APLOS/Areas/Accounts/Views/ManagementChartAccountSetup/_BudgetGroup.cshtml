<togglable name="Budget Group"></togglable>
<div class="form-elements form-horizontal" ng-form id="budgetGroup" name="budgetGroupForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" maxlength="20" name="Sequence" ng-model="budgetGroup.Sequence" class="form-control" required placeholder="0" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ShortName" maxlength="15" ng-model="budgetGroup.ShortName" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" ng-model="budgetGroup.UserName" name="UserName" maxlength="50" class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" name="Remarks" maxlength="250" rows="3" ng-model="budgetGroup.Remarks" tabindex="7"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" maxlength="10" ng-model="budgetGroup.Code" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="StandardName" maxlength="50" ng-model="budgetGroup.StandardName" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" name="Description" maxlength="250" ng-model="budgetGroup.Description" tabindex="6"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input tabindex="8" type="checkbox" ng-model="budgetGroup.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="SaveBG();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActionBG}}</button></li>
            <li> <button ng-click="RemoveBudgetGroup();" data-target="#confirmPopUp" ng-disabled="CheckIdUseBudgetGroup" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="ClearBG();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="BGparameters.searchBy">
                            <option ng-repeat="option in searchByBGList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="BGparameters.search" ng-enter="getDataBG()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getDataBG()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in budgetGroups |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="GetBG(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getDataBG(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-archive-generic modalid="confirmDetailPopUpBudgetGroup" title="Confirmation" message={{message_Detailconfirmation}} data-ng-click-right-button="DeleteBG();"></confirm-archive-generic>