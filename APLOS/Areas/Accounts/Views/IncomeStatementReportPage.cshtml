<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Income Statement Report
</h3>
<div class="row">
    <div class="form-elements form-horizontal" ng-form id="form" name="form">

        <div class="col-xs-12 col-sm-4 col-md-4">
            <fieldset class="scheduler-border">
                <div class="form-group" show-errors>

                    <div class="col-sm-12 radio">
                        <label>
                            <input type="radio" name="source2" ng-model="incomeStatementReport.Type" value="AsOnDate">
                            <span class="cr" tabindex="1"><i class="cr-icon"></i></span>As On Date
                        </label>
                        <label>
                            <input type="radio" name="source2" ng-model="incomeStatementReport.Type" value="ForThePeriod">
                            <span class="cr" tabindex="2"><i class="cr-icon"></i></span>For the Period
                        </label>
                    </div>
                </div>
                <legend class="scheduler-border">Income Statement</legend>
                <div class="col-xs-12 col-sm-6 col-md-6" hidden>

                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">Currency<sup>*</sup></label>
                        <div class="col-sm-7" ng-dropdown-multiselect="" options="parallelCurrencyList" selected-model="currencyIds"
                             extra-settings="multiSelectSettings" events="multi1events">
                        </div>
                    </div>
                </div>
                <div class="form-group" ng-show="incomeStatementReport.Type=='AsOnDate'">
                    <label class="col-sm-3 control-label">As on Date<sup>*</sup></label>
                    <div class="col-sm-7  show-message">
                        <input type="text" name="Date" ng-model="incomeStatementReport.Date" ng-change="checkYearClosedByDate(incomeStatementReport.Date);" datepicker class="form-control datepicker" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" id="div_FromDate" ng-show="incomeStatementReport.Type=='ForThePeriod'">
                    <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Date" ng-model="incomeStatementReport.FromDate" ng-change="checkYearClosedByDate(incomeStatementReport.FromDate);" datepicker class="form-control" tabindex="3">
                    </div>
                </div>
                <div ng-show="incomeStatementReport.Type=='ForThePeriod'" class="form-group" id="div_WDToDate">
                    <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Date" ng-model="incomeStatementReport.ToDate" ng-change="checkYearClosedByDate(incomeStatementReport.ToDate);" datepicker class="form-control" tabindex="4">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Up To<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <div class="select-style">
                            <select id="upToLevel" class="form-control" name="upToLevel" ng-model="incomeStatementReport.IsUpToLevel" ng-change="LevelAssaign(incomeStatementReport.IsUpToLevel)" required tabindex="3">
                                <option ng-repeat="option in upToLevelList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="incomeStatementReportDownLoad();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                    </ul>
                </div>
            </fieldset>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4" ng-show="masterList.length">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Year Closed Income Statement</legend>
                <div class="form-group" id="div_FiscalYearName">
                    <label class="col-sm-3 control-label">Fiscal Year<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <div class="input-group">
                            <input type="text" ng-model="yearClosedIncomeStatementReport.FiscalYearName" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="getMasterData();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Up To<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <div class="select-style">
                            <select id="upToLevel" class="form-control" name="upToLevel" ng-model="yearClosedIncomeStatementReport.IsUpToLevel" ng-change="yearClosedLevelAssaign(yearClosedIncomeStatementReport.IsUpToLevel)" required tabindex="3">
                                <option ng-repeat="option in upToLevelList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="getYearClosedReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                    </ul>
                </div>
            </fieldset>
        </div>


    </div>
</div>

<div class="modal fade site-modal in" id="FiscalYearClosepopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify1">
        <div class="modal-content">
            <div class="modal-header"> Fiscal Year Close <button type="button" class="close" ng-click="closePopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div style="color:black;" id="GridMaster" ej-grid e-datasource="masterList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectMaster" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Master Id" e-width="40"></div>
                            <div e-column e-field="FiscalYearName" e-headertext="Fiscal Year" e-width="80"></div>
                            <div e-column e-field="CompanyName" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="PlantName" e-headertext="Plant" e-width="80"></div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closePopUp();" class="btn"> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>