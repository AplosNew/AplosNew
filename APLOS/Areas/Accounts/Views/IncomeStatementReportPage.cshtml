<div class="row">
    <div class="form-elements form-horizontal" ng-form id="form" name="form">

        <div class="col-xs-12 col-sm-4 col-md-4">
            <fieldset class="scheduler-border">
                <div class="form-group" show-errors>

                    <div class="col-sm-12 radio">
                        <label>
                            <input type="radio" name="source2" ng-model="incomeStatementReport.Type" value="AsOnDate" @*ng-change="typeChange('AsOnDate')"*@>
                            <span class="cr" tabindex="1"><i class="cr-icon"></i></span>As On Date
                        </label>
                        <label>
                            <input type="radio" name="source2" ng-model="incomeStatementReport.Type" value=ForThePeriod @*ng-change="viewChange('ForThePeriod')"*@>
                            <span class="cr" tabindex="2"><i class="cr-icon"></i></span>For the Period
                        </label>
                    </div>
                </div>
                <legend class="scheduler-border">{{legendTitle}}</legend>
                <div class="col-xs-12 col-sm-6 col-md-6" hidden>

                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">Currency<sup>*</sup></label>
                        <div class="col-sm-7" ng-dropdown-multiselect="" options="parallelCurrencyList" selected-model="currencyIds"
                             extra-settings="multiSelectSettings" events="multi1events">
                        </div>
                    </div>
                </div>
                <div class="form-group"  ng-show="incomeStatementReport.Type=='AsOnDate'">
                    <label class="col-sm-3 control-label">As on Date<sup>*</sup></label>
                    <div class="col-sm-7  show-message">
                        <input type="text" name="Date" ng-model="incomeStatementReport.Date" @*ng-change="checkCutOffDate();"*@  datepicker class="form-control datepicker" required tabindex="3">
                        @*<p ng-show="dateMessageFrom" style="color:red" class="show-message">{{dateMessageFrom}}</p>*@
                    </div>
                </div>
                <div class="form-group"  id="div_FromDate" ng-show="incomeStatementReport.Type=='ForThePeriod'">
                    <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Date" ng-model="incomeStatementReport.FromDate" datepicker class="form-control"  tabindex="3">
                    </div>
                </div>
                <div ng-show="incomeStatementReport.Type=='ForThePeriod'" class="form-group"  id="div_WDToDate">
                    <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Date" ng-model="incomeStatementReport.ToDate" datepicker class="form-control"  tabindex="4">
                    </div>
                </div>

                @*<div class="form-group">
            <label class="col-sm-3 control-label">Up To<sup>*</sup></label>
            <div class="col-sm-7 show-message">
                <div class="select-style">
                    <select class="form-control" name="CurrencyTransaction" ng-model="report.IsUpToLevel" ng-change="LevelAssaign(report.IsUpToLevel)" required tabindex="3">
                        <option ng-repeat="option in upToLevelList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>*@

                @*<div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">Format<sup>*</sup></label>
                    <div class="col-sm-9 radio">
                        <label>
                            <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                            <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                        </label>
                        <label>
                            <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                            <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                        </label>
                    </div>
                </div>*@

                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button @*ng-click="getReport();"*@ ng-click="incomeStatementReportDownLoad();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                    </ul>
                </div>
            </fieldset>

        </div>
     

    </div>
</div>

<confirm-modal></confirm-modal>