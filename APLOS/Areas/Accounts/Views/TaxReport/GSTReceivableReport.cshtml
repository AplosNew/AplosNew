                </label>
            </div>
        </div>-->
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Format 1</button></li>
            <li><button ng-click="getReport2();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Format 2</button></li>
            <li><button ng-click="getReport3();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Format 3</button></li>
            <li><button ng-click="getReport4();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Format 4</button></li>
            <li><button ng-click="getReportDetail();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Detail</button></li>
