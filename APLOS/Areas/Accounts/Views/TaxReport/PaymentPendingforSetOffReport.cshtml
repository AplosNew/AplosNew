<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Payment Pending for Set Off Report</h3>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Report Type<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input type="radio" name="ReportType" ng-model="report.ReportType" value="Advance">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>Advance
                </label>
                <label>
                    <input type="radio" name="ReportType" ng-model="report.ReportType" value="DebitNote">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>DebitNote
                </label>
                <label>
                    <input type="radio" name="ReportType" ng-model="report.ReportType" value="CreditNote">
                    <span class="cr" tabindex="3"><i class="cr-icon"></i></span>CreditNote
                </label>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
        </ul>
    </div>
</div>