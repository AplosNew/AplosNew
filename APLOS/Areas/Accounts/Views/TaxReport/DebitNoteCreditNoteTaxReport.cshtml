<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Debit Note and Credit Note Status Report</h3>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors id="div_FromDate">
            <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="From Date" ng-model="report.FromDate" datepicker class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors id="div_ToDate">
            <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="To Date" ng-model="report.ToDate" datepicker class="form-control" required tabindex="6">
            </div>
        </div>
        <div class="form-group" show-errors id="div_PartyType">
            <label class="col-sm-3 control-label">Party Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Party Type" class="form-control" submit-required="true" ng-model="report.PartyType" required>
                        <option label="Both" value="Party" selected="selected">Both</option>
                        <option label="Customer" value="Customer">Customer</option>
                        <option label="Vendor" value="Vendor">Vendor</option>

                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors id="div_NoteType">
            <label class="col-sm-3 control-label">Note Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Note Type" class="form-control" submit-required="true" ng-model="report.NoteType" required>
                        <option label="Both" value="Both" selected="selected">Both</option>
                        <option label="DebitNote" value="DebitNote">DebitNote</option>
                        <option label="CreditNote" value="CreditNote">CreditNote</option>

                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
        </ul>
    </div>
</div>