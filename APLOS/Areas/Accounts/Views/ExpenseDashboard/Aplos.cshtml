<style>
    html {
        overflow: scroll;
    }
    .vl {
        border-left: 6px solid green;
        height: 100%;
    }
    .filled {
        background-color: #0dbe67 !important;
    }

    #myDIV {
        width: 100%;
        text-align: center;
    }

    .options {
        height: 150px;
        overflow-y: scroll;
    }

    .changeType {
        background: #eee;
        border-radius: 2px;
        border: 1px solid #bbb;
        color: #bbb;
        font-size: 10px;
        padding: 4px;
        float: right;
    }

        .changeType:before {
            content: "\25BC ";
        }

    .options {
        height: 150px;
        overflow-y: scroll;
        color: black;
        font-weight: 100;
    }

    a.filterlink {
        font-size: 12px;
    }

    .e-grid .e-headercelldiv {
        font-weight: bold;
        font-size: 13px;
        display: block;
        border: 0 none;
        height: 29px;
        line-height: 29px;
        margin: -7px;
        padding: 0 .7em;
        text-align: left;
        white-space: nowrap;
        text-overflow: ellipsis;
        font-family: "Arial Narrow";
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background: #a2f1ff;
        color: #080076;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }
</style>
<div class="row">
    <div class="col-lg-12">
        <div class="col-lg-2"><h4 style="/*margin-top:-10px;margin-bottom:25px;*/margin-left: -14%" class="ng-scope"><span class="glyphicon glyphicon-stats"></span> Expense Dashboard</h4></div>
        <div class="col-lg-10">
            <div class="row" id="date" style="border-bottom:1px solid #d8d7d7; margin:-2px;">
                <div class="col-md-3">
                    <div class="radio">
                        <label>
                            Posting Date<input type="radio" name="status" ng-model="expFactDate.factDate" value="postingDate" checked="checked" ng-change="factDateChange();">
                            <span class="cr"><i class="cr-icon"></i></span>
                        </label>
                        <label>
                            Entry Date
                            <input type="radio" name="status" ng-model="expFactDate.factDate" value="AddedDate" ng-change="factDateChange()"><span class="cr"><i class="cr-icon"></i></span>
                        </label>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-6">
                                <div class="form-group form-element-ctrl">
                                    <div class="show-message">
                                        <div class="col-md-3" style="padding:3%;">From</div>
                                        <div class="col-md-9">
                                            <input type="text" name="Date" ng-model="dateRange.fromDate" datepicker class="form-control datepicker" required tabindex="1" style="margin-top: 7px;margin-bottom: -4px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="form-group form-element-ctrl">
                                    <div class="show-message">
                                        <div class="col-md-3" style="padding:4%; margin-left:-12%">To</div>
                                        <div class="col-md-9">
                                            <input type="text" name="Date" ng-model="dateRange.toDate" datepicker class="form-control datepicker" required tabindex="1" style="margin-top: 7px;margin-bottom: -4px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-1">
                                <button style="margin-top: 17%;margin-left: -172%;" type="button" ng-click="dFunction(dateRange.fromDate,dateRange.toDate)" class="btn single-btn"><i class="glyphicon glyphicon-arrow-down"></i> Generate </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
@*<h4 style="margin-top:-10px;margin-bottom:25px;"><span class="glyphicon glyphicon-stats"></span> Expense Dashboard</h4>*@
<div class="container" id="headerNav" style="margin-left: -1.1%; margin-top:.5%;">
    <div id="wizard-container">
        <ul style="cursor:pointer; margin-bottom:-22px;">
            <li hidden ng-repeat="x in ColList" ng-click="headerNav(x)" ng-show="x.Sequence < index">
                <a>
                    <b>{{x.ColumnName}}</b><br />{{x.Name}}
                </a>
            </li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div id="Detail" class="col-md-10" style="padding-left:0%">
            <div class="modal-body table-responsive modal-table" style="margin-left:0%;  max-height:375px; max-width:100%;">
                <table class="table table-hover table-striped" style="overflow-y:scroll;border:1px solid black; box-shadow:1px 1px 1px 1px grey;">
                    <thead style="background: linear-gradient(to right, #25c481, #25b7c4);">
                        <tr>
                            <th>{{ColList[index+2].ColumnName}}</th>

                            <th style="text-align:center;">Expense for the Day</th>
                            <th style="text-align:center;">Expense for  {{dateRange.toDate.substring(3, 11)}}</th>
                            <th style="text-align:center;">Expense for Period</th>
                            <th style="text-align:center;">Expense Delay Posting </th>
                            <th style="text-align:center;">Revenue for the Day</th>
                            <th style="text-align:center;">Revenue for  {{dateRange.toDate.substring(3, 11)}}</th>
                            <th style="text-align:center;">Revenue for the Period</th>
                            <th style="text-align:center;">Revenue Delay Posting </th>
                       </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in ExpenseList">
                            <td style="padding:2px; cursor:pointer;" class="hoverItem" ng-click="setIndex(x);GetDetailDrillDownTableJS(x);">{{x.ColumnName}}</td>
                            <td style="padding:2px;  text-align:right; cursor:pointer; color:blue;" ng-click="GetBudgetWiseExpenseDetailJS(x,'Expense','FORTHEDAY')" class="hoverItem">
                                {{x.ForTheDayExpenseAmount|number}}
                            </td>
                            <td style="padding:2px;  text-align:right; cursor:pointer; color:blue;" ng-click="GetBudgetWiseExpenseDetailJS(x,'Expense','FORTHEPERIOD')" class="hoverItem">
                                {{x.ForThePeriodExpenseAmount|number}}
                            </td>
                            <td style="padding:2px;  text-align:right; cursor:pointer; color:blue;" ng-click="GetBudgetWiseExpenseDetailJS(x,'Expense','ALL')" class="hoverItem">
                                {{x.ExpenseAmount|number}}
                            </td>
                            <td style="padding:2px;  text-align:right; cursor:pointer; color:maroon" ng-click="GetBudgetWiseExpenseDetailJS(x,'Expense','DELAY')" class="hoverItem">
                                {{x.ForTheDelayExpenseAmount|number}}
                            </td>
                            <td style="padding:2px;  text-align:right; cursor:pointer; color:forestgreen;" ng-click="GetBudgetWiseExpenseDetailJS(x,'Revenue','FORTHEDAY')" class="hoverItem">
                                {{x.ForTheDayRevenueAmount|number}}
                            </td>
                            <td style="padding:2px;  text-align:right; cursor:pointer; color:forestgreen;" ng-click="GetBudgetWiseExpenseDetailJS(x,'Revenue','FORTHEPERIOD')" class="hoverItem">
                                {{x.ForThePeriodRevenueAmount|number}}
                            </td>
                            <td style="padding:2px;  text-align:right; cursor:pointer; color:forestgreen;" ng-click="GetBudgetWiseExpenseDetailJS(x,'Revenue','ALL')" class="hoverItem">
                                {{x.RevenueAmount|number}}
                            </td>
                            <td style="padding:2px;  text-align:right; cursor:pointer; color:forestgreen" ng-click="GetBudgetWiseExpenseDetailJS(x,'Revenue','DELAY')" class="hoverItem">
                                {{x.ForTheDelayRevenueAmount|number}}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-md-2"></div>
    </div>
</div>
<br />
<div class="row">

    <div class="col-md-4"> <canvas id="expenseBarChart" width="200" height="300"></canvas></div>
    <div class="col-md-4"> <canvas id="periodExpenseBarChart" width="200" height="300"></canvas></div>
    <div class="col-md-4">
        <table>
            <thead>
                <tr style="border-bottom:1px solid black; font-size:83%; color: rgb(54, 162, 235)">
                    <th>Posting Period</th>
                    <th>Entry Period</th>
                    <th style="text-align:right;">Expense Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom:1px solid black; font-size:83%;" ng-repeat="item in expensePeriodList" ng-class="{compareExpense: item.EntryPeriod != item.PostingPeriod}">
                    <td>{{item.PostingPeriod}}</td>
                    <td>{{item.EntryPeriod}}</td>
                    <td style="text-align:right;" class="hoverItem" ng-click="GetBudgetWiseExpenseDetailJS(item,'Expense','');">{{item.Amount|number}}</td>
                </tr>
                <tr style="border-bottom:1px solid black; font-size:83%; font-weight:bold" ng-show="ExpenseListTotal >= 0|| ExpenseListTotal <= 0">
                    <td colspan="2"> Total</td>
                    <td style="text-align:right;">{{ExpenseListTotal|number}}</td>
                </tr>
            </tbody>
        </table>
        <hr />
        <table>
            <thead>
                <tr style="border-bottom:1px solid black; font-size:83%; color: rgba(46, 204, 113,.6)">
                    <th>Posting Period</th>
                    <th>Entry Period</th>
                    <th style="text-align:right;">Revenue Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom:1px solid black; font-size:83%;" ng-repeat="item in revenuePeriodList" ng-class="{compareRevenue: item.EntryPeriod != item.PostingPeriod}">
                    <td>{{item.PostingPeriod}}</td>
                    <td>{{item.EntryPeriod}}</td>
                    <td style="text-align:right;" class="hoverItem" ng-click="GetBudgetWiseExpenseDetailJS(item,'Revenue','');">{{item.Amount|number}}</td>
                </tr>
                <tr style="border-bottom:1px solid black; font-size:83%; font-weight:bold" ng-show="RevenueListTotal >= 0 || RevenueListTotal <= 0">
                    <td colspan="2"> Total</td>
                    <td style="text-align:right;">{{RevenueListTotal|number}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    @*<div class="col-md-6"> <canvas id="budgetWiseExpenseChart" width="200" height="85"></canvas></div>*@
</div>

<br />
<div class="row">
    <div class="col-md-12"> <canvas id="periodicBudgetedAountChart" width="200" height="50"></canvas> </div>
</div>

