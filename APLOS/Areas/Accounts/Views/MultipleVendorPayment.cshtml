<togglable name="Vendor Payment Plan"></togglable>
<div class="form-elements form-horizontal">
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet2(1) }"><a ng-click="setTab2(1)" href="" aria-controls="general" role="tab" data-toggle="tab2">Select Invoice</a></li>
                <li role="presentation" ng-class="{ active: isSet2(2) }"><a ng-click="setTab2(2)" href="" aria-controls="Service" role="tab" data-toggle="tab2">Post Payment</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(1), active: isSet2(1) }" ng-form="form1">
                <div class="row">

                    <div class="form-elements form-horizontal">
                        <div class="col-xs-12 col-sm-5 col-md-5">
                            <div class="form-group" show-errors>
                                <div class="radio col-sm-5 col-xs-5">
                                    <label>
                                        <input type="radio" name="Date Type" ng-click="changeDateType('DueUpToDate')" ng-model="multiplePayment.DateType" value="DueUpToDate">
                                        <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Due UpTo PostingDate
                                    </label>
                                    <label>
                                        <input type="radio" name="Date Type" ng-click="changeDateType('DocDate')" ng-model="multiplePayment.DateType" value="DocDate">
                                        <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Due UpTo Doc Date
                                    </label>
                                </div>
                                <div class="col-sm-6 show-message">
                                    <input type="text" name="UpToDate" ng-model="multiplePayment.DueUpToDate" datepicker class="form-control" required>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select id="entityId" class="form-control" name="Entity" ng-model="multiplePayment.EntityId" tabindex="7" required>
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 ">
                            <button class="btn single-btn" ng-click="getPopupVendorList()" tabindex="10">Select Vendor</button>

                            @*<button class="btn single-btn" ng-click="getPopupVendorPayableList()" tabindex="10">Select Payable</button>*@
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 ">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="table-responsive modal-table ">
                                    <table class="table table-striped" ng-show="partyList.length">
                                        <thead>
                                            <tr>
                                                <th>Code</th>
                                                <th>{{partyType}}</th>
                                                <th>No of Invoice</th>
                                                <th>Payment Pending Amount</th>
                                                <th>Is Customer</th>
                                                <th>Receivable Pending Amount</th>
                                                <th>Advance</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in partyDataListNew">
                                                <td>{{x.Code}}</td>
                                                <td>{{x.UserName}}</td>
                                                <td>{{x.NoOfPendingInvoice}}</td>
                                                <td>{{x.Balance}}</td>
                                                <td>{{x.IsCustomer}}</td>
                                                <td>{{x.PendingReceivable}}</td>
                                                <td>{{x.Advance}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="col-xs-6 col-sm-6 col-md-6 ">
                                    <button class="btn single-btn" ng-click="getPopupVendorPayableList()" tabindex="10">Select Payable</button>
                                    @*<button class="btn single-btn" ng-click="getPopupVendorList()" tabindex="10">Select Vendor</button>*@
                                </div>
                                <div class="col-xs-6 col-sm-6 col-md-6 ">
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-5 control-label">Tentative Date</label>
                                        <div class="col-sm-7 show-message">
                                            <input type="text" name="TentativeDate" ng-model="multiplePayment.TentativeDate" datepicker class="form-control" required>
                                        </div>
                                    </div>
                                </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-3 control-label" title="CheckBy">Approved By<sup>*</sup></label>
                                <div class="col-sm-4  show-message">
                                    <div class="select-style" ng-show="approvedByList.length">
                                        <select id="ApprovedBy" class="form-control" name="Approved By" ng-model="multiplePayment.ApprovedBy" tabindex="8" required>
                                            <option ng-repeat="option in approvedByList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            </div>
                        </div>
                            <br />
                            <br />
                            <div class="clearfix"></div>
                            <div class="col-xs-12 col-sm-12 col-md-12 ">
                                <div class="table-responsive modal-table ">
                                    <table class="table table-striped" ng-show="paymentSelectedList.length">
                                        <thead>
                                            <tr>
                                                <th>Action</th>
                                                <th>{{partyType}}</th>
                                                <th>Voucher No</th>
                                                <th>Posting Date</th>
                                                <th>Doc Date</th>
                                                <th>Base On Due Date</th>
                                                <th>Doc Ref</th>
                                                <th>Currency</th>
                                                <th>Payable</th>
                                                <th>Payment</th>
                                                <th>Balance</th>
                                                <th>
                                                    Amount
                                                    <div class="common-btn">
                                                        <button ng-click="copyPayableBalanceAmount();" class="btn" tabindex="5"><i class="glyphicon"></i> Copy</button>
                                                    </div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in paymentSelectedList">
                                                <td class="text-right">
                                                    <button ng-click="removeRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </td>
                                                <td ng-show="partyType=='Vendor'">{{x.PartyName}}</td>
                                                <td>{{x.VoucherNo}}</td>
                                                <td>{{x.PostingDate | dateFiltering}}</td>
                                                <td>{{x.DocDate | dateFiltering}}</td>
                                                <td>{{x.BaseOnDueDate | dateFiltering}}</td>
                                                <td>{{x.DocRefNo}}</td>
                                                <td>{{x.CurrencyCode}}</td>
                                                <td class="text-right">{{x.Receivable | number:4}}</td>
                                                <td class="text-right">{{x.Received | number:4}}</td>
                                                <td class="text-right">{{x.Balance | number:4}}</td>
                                                <td>
                                                    <input ng-keyup="" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" autocomplete="off" name="Amount" ng-model="x.Amount">
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="11" class="text-right">Total</td>
                                                <td class="text-right"><b>{{ (paymentSelectedList) | sumByKey:'Amount' }}</b></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <div class="col-xs-12 col-sm-6 col-md-6  " ng-show="paymentSelectedList.length">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Bank Detail</legend>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <div class="input-group">
                                                <input type="text" name="CashName" ng-model="multiplePayment.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{voucher.BankName}}" tooltip>
                                                <span class="input-group-btn">
                                                    <button ng-click="showBankPopUp(multiplePayment.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                    <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                </ul>
                            </div>
                        </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(2), active: isSet2(2) }" ng-form="formPost">
                <div class="row">
                    <div class="form-elements form-horizontal">
                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
                                <div class="col-sm-8 radio">
                                    <label>
                                        <input ng-click="clearBankPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                                        <span class="cr" tabindex="17"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                                    </label>
                                </div>
                            </div>

                        </div>

                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                                <div class="col-sm-5 show-message" style="padding-right:0px;">
                                    <div class="select-style">
                                        <select id="currencyTransactionId" class="form-control" tabindex="5" name="Currency" required ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-3 show-message" style="padding-left:0px;">
                                    <input type="text" maxlength="50" n-decimals="4" name="Rate" ng-keyup="exchangeGainLossCal(voucher.CompanyCurrencyRate);rateChangeBankCharge(voucher.CompanyCurrencyRate)" id="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off" ng-disabled="voucher.CurrencyId==companyCurrencyId">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <textarea rows="2" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
                                </div>
                            </div>

                        </div>
                        <div class="clearfix"></div>
                        <div class="content-container-fluid" style="color:black;">
                            <div style="color:black;" id="gridTab" ej-grid e-datasource="multipleVendorpaymentList"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                                 e-filtersettings-filterType="excel" e-recorddoubleclick="Done"
                                 e-enabletouch="true" e-allowselection="true" e-templaterefresh="refreshTemplate"
                                 e-rowdatabound="rowDataBound" e-scrollsettings="scroll" e-detailstemplate="detailTemp"
                                 e-detailsdatabound="detailgrid">

                                <div e-columns>
                                    <div e-column e-template="#bootstrapToggle2" e-headertext="Check" e-width="40" textAlign='center'></div>
                                    <div e-column e-field="Id" e-headertext="Payment No" e-width="60"></div>
                                    <div e-column e-field="DueUpToDate" e-headertext="DueUpToDate" e-width="60"></div>
                                    @*<div e-column e-field="TentativeDate" e-headertext="TentativeDate" e-width="60"></div>*@
                                    <div e-column e-template="#TentativeDate" e-headertext="Tentative Date" e-width="60" style="height: 20px;"></div>
                                    <div e-column e-field="PartyName" e-headertext="Party" e-width="120"></div>
                                    <div e-column e-field="AccountTitle" e-headertext="Bank" e-width="120"></div>
                                    <div e-column e-field="Amount" e-headertext="Amount (TRN)" textAlign='Right' e-width="80"></div>
                                </div>
                            </div>
                        </div>
                        <script type="text/template" id="TentativeDate">
                            <input type="text" ng-model="data.TentativeDate" style="color:black;" class="form-control" />
                        </script>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="Post();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
                                <li><button ng-click="confirmDelete();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Delete</button></li>
                                <li><button ng-click="postClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                        <script type="text/template" id="bootstrapToggle2">
                            <input type="checkbox" e-change="$parent.selectPaymentList" e-value="data.flag" ej-checkbox class="rowCheckbox" e-checked="data.flag" />
                        </script>
                        <script id="tabGridContents" type="text/x-jsrender">
                            <div class="tabcontrol" id="Test">
                                <ul>
                                    <li><a href="#gridTab{{:Id}}">Detail</a></li>
                                </ul>
                                <div id="gridTab{{:Id}}">
                                    <div id="detailGrid"></div>
                                </div>

                            </div>
                        </script>
                        <div class="col-md-1 text-right" style="margin-top:20px;">
                            <button type="button" class="btn single-btn" ng-click="Report()" style="margin-top:10px;"><i class="glyphicon glyphicon-arrow-down"></i>Download</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<div class="aplos-grid-toggle">
    @*<div class="row text-right">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="search-form">
                    <div class="row">
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="select-style">
                                <select ng-model="searchByPostedGRN">
                                    <option ng-repeat="option in searchByPostedGRNList" value="{{option.value}}">{{option.name}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-7 col-md-7">
                            <input type="text" class="form-control" placeholder="Search" ng-model="searchGRN" ng-enter="getDataList();">
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2">
                            <button type="button" ng-click="getDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
