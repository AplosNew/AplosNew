    <div class="content-container-fluid" style="color:black;">
        <div style="color:black;" id="MultiplePaymentGrid" ej-grid e-datasource="multiplePaymentDataList" e-allowfiltering="true" e-allowpaging="true"
             e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
             e-actioncomplete="actionCompleteSelected" e-recorddoubleclick="Get" e-allowscrolling="true" e-showstackedheader="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Payment No" e-width="120" e-filter="false"></div>
                <div e-column e-field="PartyName" e-headertext="Party" e-width="120" e-filter="false"></div>
                <div e-column e-field="AccountTitle" e-headertext="Bank" e-width="100"></div>
                <div e-column e-field="DueUpToDate" e-headertext="DueUpToDate" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="TentativeDate" e-headertext="TentativeDate" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="Amount" e-headertext="Amount" e-width="100"></div>
                <div e-column e-field="ParkStatus" e-headertext="ParkStatus" e-width="80" textAlign='Center'></div>
            </div>
        </div>

    </div>
    <i>**Showing top 300  List</i>
</div>

<div class="modal fade site-modal in" id="partyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> {{partyType}} List <button type="button" class="close" ng-click="closePartyPopUpNew();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByParty">
                                            <option ng-repeat="option in searchByPartyList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchParty" ng-enter="showPartyPopUpNew()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="showPartyPopUpNew()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        <div style="color:black;" id="partyPopUpGrid" ej-grid e-datasource="partyList" e-recorddoubleclick="closePartyPopUp"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="50" e-filter="false"></div>
                                <div e-column e-field="UserName" e-headertext="Party" e-width="130"></div>
                                <div e-column e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="130"></div>
                                <div e-column e-field="PartyNature" e-headertext="Party Nature" e-width="50"></div>
                                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                <div e-column e-field="PartyCategory" e-headertext="Party Category" e-width="50"></div>
                                <div e-column e-field="PartySubCategory" e-headertext="Party SubCategory" e-width="50"></div>
                                <div e-column e-field="CountryName" e-headertext="Country" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="StateName" e-headertext="State" e-width="80" textAlign='Right'></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                        </script>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="common-btn">
                        <ul class="list-inline text-right" ng-show="true">
                            <li><button ng-click="ViewParty();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> View </button></li>
                            <li><button ng-click="closePartyPopUpNew();" class="btn"> Close</button></li>
                        </ul>
                    </div>
                </div>
                <i>**Showing top 100 {{partyType}} order by Code</i>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Accounts/Views/_MultipleVendorInvoicePopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete()"></confirm-archive-generic>

