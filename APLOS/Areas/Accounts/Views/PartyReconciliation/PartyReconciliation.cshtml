            </script>*@

        <script type="text/template" id="Actions">
            <ul class="common-btn list-inline text-right">
                <li> <button type="button" class="btn" ng-show="data.IsPark=='Parked'" ng-click="$parent.confirmPost(data);"><i class="glyphicon glyphicon-floppy-disk"></i>Post</button></li>
                <li> <button style="color: #f3f3ec;background-color: #1c1f32;" title="Pdf" class="btn"><i class="fa fa-file-pdf-o" ng-click="$parent.pdfReport(this);" style="margin: -6px;"></i></button></li>
                <li><button style="color: #f3f3ec;background-color: #1c1f32;" title="Excel" class="btn"><i class="fa fa-file-excel-o" ng-click="$parent.excelReport(this);" style="margin: -6px;"></i></button></li>
            </ul>
