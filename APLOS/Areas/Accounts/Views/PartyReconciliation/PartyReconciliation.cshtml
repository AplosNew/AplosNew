<togglable name="Party Reconciliation"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">

    <div class="col-xs-12 col-sm-5 col-md-5 ">
        <div class="form-group">
            <label class="col-sm-3 control-label">party<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="PartyName" ng-model="voucher.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" ng-disabled="voucher.IsSplit==true" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearPartyData()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Entry Date" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="Posting Date" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Doc Date" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
    </div>

    <div class="clearfix"></div>
    <div ng-show="FirstDivShow">
        <div class="col-md-6 col-sm-6 col-xs-6">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Asset</legend>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div style="color:black;" id="GridSelectedPartyDr" ej-grid e-datasource="partyWiseAssetList"
                         e-actioncomplete="actionCompleteSelected" e-gridlines="vertical" e-allowfiltering="true" e-rowdatabound="preparedByrowcolor" e-allowpaging="true" e-allowsorting="true"
                         e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-type="string" e-field="DocRefNo" e-headertext="DocRefNo " e-width="40"></div>
                            <div e-column e-type="string" e-field="ActivityName" e-headertext="GL" e-width="40"></div>
                            <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Balance" e-headertext="Amount" e-width="40"></div>
                            <div e-column e-headertext="Actions" e-template="#ShowActionAsset" e-width="30"></div>

                        </div>
                    </div>
                    <script type="text/template" id="ShowActionAsset">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Detail" class="btn"><i class="glyphicon glyphicon-eye-open" ng-click="$parent.showAssetDetail(this);" style="margin: -6px;"></i></button>
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Next" class="btn"><i class="glyphicon glyphicon-forward" ng-click="$parent.ShowThirdDiv(this);" style="margin: -6px;"></i></button>
                    </script>
                </div>

            </fieldset>
        </div>

        <div class="col-md-6 col-sm-6 col-xs-6">
