                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchByPosted">
                                <option ng-repeat="option in searchByPostedList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
