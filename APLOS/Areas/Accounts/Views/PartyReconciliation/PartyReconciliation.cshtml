                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Next" class="btn"><i class="glyphicon glyphicon-forward" ng-click="$parent.ShowDiv(this);" style="margin: -6px;"></i></button>
                    </script>
                </div>
            </fieldset>
        </div>
    </div>
