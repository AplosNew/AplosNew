             e-actioncomplete="actionCompleteSelected" e-allowscrolling="true" e-showstackedheader="true">
            <div e-columns>
                <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-width="60"></div>
                <div e-column e-field="PostingDate" e-headertext="PostingDate" e-width="60" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="60"></div>
                <div e-column e-field="DocDate" e-headertext="Doc Ref Date" e-width="60" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
