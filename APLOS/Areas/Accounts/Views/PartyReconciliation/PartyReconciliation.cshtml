                                <td class="text-right"><b>{{ (selectedDrRow) | sumByKey:'Received' | number:2}}</b></td>
                                <td class="text-right"><b>{{ (selectedDrRow) | sumByKey:'Balance'| number:2 }}</b></td>
                                <td class="text-right"><b>{{ (selectedDrRow) | sumByKey:'Amount' | number:2}}</b></td>
                                @*<td></td>
                                    <td class="text-right"><b>{{ (selectedDrRow) | sumByKey:'ExchangeAmount'| number:2 }}</b></td>
                                    <td class="text-right"><b>{{ (selectedDrRow) | sumByKey:'BaseDrAmount'| number:2 }}</b></td>
                                    <td></td>*@
