                            <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Balance" e-headertext="Amount" e-width="50"></div>
                            <div e-column e-headertext="Actions" e-template="#ShowActionLiability" e-width="30"></div>
                        </div>
                    </div>
                    <script type="text/template" id="ShowActionLiability">
