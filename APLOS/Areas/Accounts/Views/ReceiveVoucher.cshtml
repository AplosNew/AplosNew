<style>
    .angucomplete-dropdown {
        position: relative !important;
    }
</style>
<togglable name="Customer Invoice Receive"></togglable>
<div class="form-elements form-horizontal" ng-form id="voucher" name="receivevoucherForm">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Basic Data</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="address" role="tab" data-toggle="tab">Parallel Currency</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form name="invoiceReceivedForm1">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">General Information</legend>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-5 control-label">Voucher Date<sup>*</sup></label>
                            <div class="col-sm-7 show-message">
                                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control datepicker" tabindex="1" ng-change="checkVoucherDate()" disabled required>
                                <p ng-show="VoucherDateMessage" class="show-message">{{VoucherDateMessage}}</p>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-5 control-label">Voucher Type<sup>*</sup></label>
                            <div class="col-sm-7 show-message">
                                <div class="select-style">
                                    <select id="vouchertypeId" class="form-control" name="vouchertype" ng-model="voucher.VoucherTypeId" tabindex="4" ng-change="onVoucherTypeChange(voucher.VoucherTypeId);getVoucherTypeValueText()" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-5 control-label">Narration</label>
                            <div class="col-sm-7 show-message">
                                <textarea type="text" name="Narration" class="form-control" rows="3" ng-model="voucher.Narration" ng-blur="passNarration(voucher.Narration)" required capitalize></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-5 control-label">Posting Date<sup>*</sup></label>
                            <div class="col-sm-7">
                                <input id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" ng-disabled="currencyDisable" datepicker class="form-control datepicker" tabindex="3">
                                <p ng-show="postingDateMessage" class="show-message">{{postingDateMessage}}</p>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">FiscalYear</label>
                            <div class="col-sm-4">
                                <input id="fiscalYearId" type="text" name="Fiscal Year" readonly ng-model="fiscalYearInfo.FiscalYearName" class="form-control">
                                <input type="hidden" name="Period" readonly ng-model="fiscalYearInfo.FiscalYearId" class="form-control">
                            </div>
                            <label class="col-sm-2 control-label">Period</label>
                            <div class="col-sm-3">
                                <input id="fiscalYearPeriod" type="text" name="Period" readonly ng-model="fiscalYearInfo.PeriodName" class="form-control">
                                <input type="hidden" name="Period" readonly ng-model="fiscalYearInfo.FiscalYearPeriodId" class="form-control">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-5 control-label">Doc Date<sup>*</sup></label>
                            <div class="col-sm-7 show-message">
                                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker class="form-control datepicker" tabindex="2" ng-change="checkDate();getDocDate(voucher.DocDate)" required>
                                <p ng-show="dateMessage" class="show-message">{{dateMessage}}</p>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-5 control-label">Doc Ref<sup>*</sup></label>
                            <div class="col-sm-7 show-message">
                                <input type="text" maxlength="50" name="DocRefNo" ng-model="voucher.DocRefNo" class="form-control" tabindex="5" ng-blur="getRefCode(voucher.DocRefNo)" required>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-5 control-label">Transaction Currency<sup>*</sup></label>
                            <div class="col-sm-7">
                                <div class="select-style">
                                    <select id="currencyTransactionId" class="form-control" tabindex="9"
                                            name="CurrencyTransaction" ng-model="voucher.CurrencyId" ng-disabled="currencyDisable"
                                            ng-change="GetCurrencyExchangeRateList();CurrencyHideShow();showCrlOnCurrency(voucher.CurrencyId)">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive modal-table" ng-hide="showCtrl">
                            <table class="table table-striped">
                                <thead>
                                    <tr ng-show="IscurrencyheaderHideShow">
                                        <th>Unit</th>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Rate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in voucherDetailCurrency" ng-hide="x.ParallelCurrencyId==voucher.CurrencyId">
                                        <td>{{x.FromCurrencyUnit}}</td>
                                        <td>{{x.FromCurrencyCode}}</td>
                                        <td>{{x.ToCurrencyCode}}</td>
                                        <td>
                                            <input type="number" class="form-control" ng-disabled="updateDiable" ng-model="x.ToCurrencyRate" ng-change="excurrencyRateMethod(voucherDetailCurrency);" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </fieldset>
                <div>
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Bank Information</legend>
                        <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                            <div class="form-group" show-errors>
                                <div class="col-sm-4">
                                    <button class="btn single-btn" ng-click="getBankMasterVoucher()" tabindex="5">Bank</button>
                                </div>
                                <div class="col-sm-8">
                                    <input id="BankCharge" type="text" name="BankName" ng-model="getBankName" class="form-control " tabindex="2" readonly>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Account Type</label>
                                <div class="col-sm-8">
                                    <input id="BankCharge" type="text" name="BankName" ng-model="getBankAccountType" class="form-control " tabindex="2" readonly>
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Amount</label>
                                <div class="col-sm-8 show-message">
                                    <input id="CrAmount" type="text" name="DrAmount" n-decimals="2" ng-disabled="bankAmountDisable" ng-model="voucherDetail.DrAmount" ng-keyup="receivecashbank();addReceivedDetailRow();" class="form-control text-right" tabindex="2">
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Bank Branch</label>
                                <div class="col-sm-8">
                                    <input id="BankCharge" type="text" name="BankName" ng-model="getBankBranchName" class="form-control " tabindex="2" readonly>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">GL</label>
                                <div class="col-sm-8 show-message">
                                    <input id="BankCharge" type="text" name="GLItem" ng-model="getBankGlItem" class="form-control " tabindex="2" readonly>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label"> Currency </label>
                                <div class="col-sm-8 show-message">
                                    <input id="Bankcurrency" type="text" name="GLItem" ng-model="getBankCurrency" class="form-control " tabindex="2" readonly>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Account No</label>
                                <div class="col-sm-8">
                                    <input id="BankCharge" type="text" name="BankCode" ng-model="getAccountNumber" class="form-control " tabindex="2" readonly>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Narration</label>
                                <div class="col-sm-8 show-message">
                                    <textarea type="text" name="Narration" class="form-control" rows="1" ng-model="voucherDetail.Narration" required capitalize></textarea>
                                </div>
                            </div>
                            <div ng-hide="gLTransactionDetail.IsParaCurrency">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Bank Currency Amount</label>
                                    <div class="col-sm-8 show-message">
                                        <input id="gltransactionDrAmount" type="number" name="GLItem" ng-model="gLTransactionDetail.DrAmount" class="form-control " tabindex="2">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Customer Information</legend>
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">

                            <div class="form-group" show-errors>
                                <div class="col-sm-4">
                                    <button class="btn single-btn" ng-disabled="showCtrl;currencyDisable" ng-click="getCustomerParty()" tabindex="5">Customer</button>
                                </div>
                                <div class="col-sm-8 show-message">
                                    <input id="BankCharge" type="text" name="Customer Name" ng-model="getCustomerName" class="form-control " tabindex="2" readonly>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    <div>
                        <div class="col-xs-12">
                            <div class="form-group">
                                <div class="col-sm-8">
                                    <button class="btn single-btn" ng-hide="showReceivable" ng-click="getPopupCustomerReceivableList()" tabindex="5">Select Customer Receivable</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div ng-show="selectedPayableTblShow" class="table-responsive modal-table col-xs-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>GL</th>
                                    <th>DocDate</th>
                                    <th style="width:150px">Narration</th>
                                    <th>Currency</th>
                                    <th>Receivable</th>
                                    <th>Received</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in CustomerReceivableReceivedList">
                                    <td>
                                        @*<ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="getvendorpayableEdit(x,$index)" class="btn-action tooltip-here" data-placement="top" title="Edit" tooltip>
                                                        <i class="glyphicon glyphicon-edit"></i>
                                                    </button>
                                                </li>
                                            </ul>*@
                                        <ul class="list-inline action-list">
                                            <li>
                                                <button ng-click="VendorPayablePaymentDel(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                    <i class="glyphicon glyphicon-remove"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </td>
                                    <td>{{x.GL}}</td>
                                    @*<td>{{x.VoucherDate|dateFiltering}}</td>*@
                                    <td>{{x.DocDate|dateFiltering}}</td>
                                    <td>
                                        <input id="Narration" type="text" name="Narration" ng-model="x.Narration" class="form-control" capitalize>
                                    </td>
                                    <td>{{x.Currency}}</td>
                                    <td>{{x.Receivable}}</td>
                                    <td>{{x.Received}}</td>
                                    <td>{{x.Amount}}</td>
                                    @*<td >{{x.Balance}}</td>*@
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form name="invoiceReceivedForm2">
                <div class="tab-design" id="tab_show_detail">
                    <div class="site-tab">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" ng-class="{ active: isSetdetail(3) }"><a ng-click="setTabdetail(3)" href="" aria-controls="general" role="tab" data-toggle="tabdetail">Base Currency</a></li>
                            <li role="presentation" ng-class="{ active: isSetdetail(4) }"><a ng-click="setTabdetail(4)" href="" aria-controls="group" ng-show="ParagroupCurrencyTab" role="tab" data-toggle="tabdetail">Group Currency</a></li>
                            <li role="presentation" ng-class="{ active: isSetdetail(5) }"><a ng-click="setTabdetail(5)" href="" aria-controls="hard" ng-show="ParahardCurrencyTab" role="tab" data-toggle="tabdetail">Hard Currency</a></li>
                        </ul>
                    </div>
                    <div class="tab-content">
                        <!-- #region SubTab 1 -->
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetdetail(3), active: isSetdetail(3) }">
                            <b ng-show="CompanyCurrency.ParallelCurrencyType=='CompanyCurrency'" ng-repeat="CompanyCurrency in CurrencyParallel "><span>{{CompanyCurrency.Code }}</span></b>
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Company Currency</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-show="x.ParallelCurrencyType=='CompanyCurrency'" ng-repeat="x in CurrencyParallel ">
                                            <td>{{x.Code}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <br />
                            <div class="clearfix"></div>
                            <div class="row">
                                <div class="table-responsive modal-table voucher-table">
                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>GL</th>
                                                <th>DocRefNo</th>
                                                <th>DR</th>
                                                <th>CR</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-show="x.ParallelCurrencyType=='CompanyCurrency'" ng-repeat="x in receiveDetailCurrencyrow|filter:{Active:true}">
                                                <td>{{x.COAIText}}</td>
                                                <td></td>
                                                <td><input type="text" class="form-control text-right" title="Text,Comma,+,-,Two Dot is not allow" n-decimals="2" ng-model="x.DrAmount " ng-change="BaseCurrencytotal()" /></td>
                                                <td><input type="text" class="form-control text-right" title="Text,Comma,+,-,Two Dot is not allow" n-decimals="2" ng-model="x.CrAmount" ng-disabled="true" /></td>
                                            </tr>
                                            <tr ng-show="x.ParallelCurrencyType=='CompanyCurrency'" ng-repeat="x in voucherDetailCurrencyrow|filter:{Active:true}">
                                                <td>{{x.COAIText}}</td>
                                                <td>{{x.DocRefNo}}</td>
                                                <td><input type="text" class="form-control text-right" title="Text,Comma,+,-,Two Dot is not allow" n-decimals="2" ng-model="x.DrAmount " ng-disabled="true" /></td>
                                                <td><input type="text" class="form-control text-right" title="Text,Comma,+,-,Two Dot is not allow" n-decimals="2" ng-model="x.CrAmount" ng-change="BaseCurrencytotal()" /></td>
                                            </tr>
                                            <tr ng-show="x.ParallelCurrencyType=='CompanyCurrency'" ng-repeat="x in voucherDetailExchangeGainCurrencyrow|filter:{Active:true}">
                                                <td>{{x.COAIText}}</td>
                                                <td>{{x.DocRefNo}}</td>
                                                <td><input type="text" class="form-control text-right" title="Text,Comma,+,-,Two Dot is not allow" n-decimals="2" ng-model="x.DrAmount " ng-change="BaseCurrencytotal()" /></td>
                                                <td><input type="text" class="form-control text-right" title="Text,Comma,+,-,Two Dot is not allow" n-decimals="2" ng-model="x.CrAmount" ng-change="BaseCurrencytotal()" /></td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" class="text-right"><strong>Total Amount</strong></td>
                                                <td class="text-right" id="ToatalDrBase"><strong>{{Drtbase | number : 2}}</strong></td>
                                                <td class="text-right" id="ToatalCrBase"><strong>{{Crtbase | number : 2}}</strong></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetdetail(4), active: isSetdetail(4) }">
                            <b ng-show="a.ParallelCurrencyType=='CompanyGroupCurrency'" ng-repeat="a in currencyexchangerate "><span>{{a.Code }}</span></b>
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>From Currency Unit</th>
                                            <th>From Currency</th>
                                            <th>To Currency Rate</th>
                                            <th>To Currency</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-show="x.ParallelCurrencyType=='CompanyGroupCurrency'" ng-repeat="x in currencyexchangerate " ng-init="FromCurrency=x.Code">
                                            <td>{{x.FromCurrencyUnit}}</td>
                                            <td>{{x.Code}}</td>
                                            <td>{{x.ToCurrencyRate}}</td>
                                            <td>{{x.ToCurrency}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <br />
                            <div class="clearfix"></div>
                            <div class="row">
                                <div class="table-responsive modal-table voucher-table">
                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>GL</th>
                                                <th>DocRefNo</th>
                                                <th>DR</th>
