                                            </tr>
                                            <tr ng-show="x.ParallelCurrencyType=='CompanyGroupCurrency'" ng-repeat="x in voucherDetailCurrencyrow|filter:{Active:true}">
                                                <td>{{x.COAIText}}</td>
