                                        </thead>
                                        <tbody>
                                            <tr ng-show="x.ParallelCurrencyType=='HardCurrency'" ng-repeat="x in receiveDetailCurrencyrow|filter:{Active:true}">
                                                <td>{{x.COAIText}}</td>
