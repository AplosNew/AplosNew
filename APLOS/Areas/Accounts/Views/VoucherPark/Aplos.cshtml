
<h3 class="site-heading">Voucher Park Mode</h3>



@*<togglable name="Customer Invoice"></togglable>*@
<div class="form-horizontal form-elements" ng-form id="form1" name="form1">



    <div class="col-md-12 col-sm-4 col-md-4">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.VoucherNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>

    </div>
    <div class="col-md-12 col-sm-2 col-md-2">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li><button ng-click="getVoucherData();" title="Date Range Wise values Change" class="btn"><i class="glyphicon glyphicon-refresh"></i>Go</button></li>
            </ul>
        </div>
    </div>

    <div class="clearfix"></div>

</div>


@*<div class="col-xs-12 col-sm-2 col-md-2">
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="getTrialBalanceData();" title="Date Range Wise values Change" class="btn"><i class="glyphicon glyphicon-refresh"></i>Go</button></li>
        </ul>
    </div>
</div>*@

<div class="clearfix"></div>
<div class="aplos-grid-toggle">

    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>Source Type</th>

                    @*<th>@Library.Model.Parties.PartyType.Customer.ToString()</th>*@
                     <th>Transaction RefNo</th>
                     <th>DocRef No</th>
                     <th>Doc Date</th>
                     <th>Voucher Date</th>
                    <th>Posting Date</th>
                    <th>Narration</th>
                    <th>EntityId</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in VoucherDataList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.SourceType}}</td>
                    <td>{{x.TransactionRefNo}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.DocDate | dateFiltering}}</td>
                    <td>{{x.VoucherDate | dateFiltering}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.Narration}}</td>
                    <td>{{x.EntityId}}</td>


                 @* <td class="text-right">{{x.Amount | number:2}}</td>
                    <td class="text-right">{{x.WrittenOffAmount | number:2}}</td>
                    <td class="text-right">{{x.Amount-x.WrittenOffAmount | number:2}}</td>*@
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPosted || x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Park</a></li>

                            @*<li ng-show="x.OtherIsPark"><a ng-click="ShowJournalPopUp(x);" href="" class="btn btn-action tooltip-here">Subsidy Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>*@
                            @*<li><a class="btn btn-action" href="Accounts/Invoice/GetCustomerInvoiceVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Invoice/GetCustomerInvoiceVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>*@
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getVoucherData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>


