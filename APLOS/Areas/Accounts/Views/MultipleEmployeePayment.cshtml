<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchEmployeePaymentList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Employee</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Doc Ref</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in paymentList |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.EmployeeCode}} - {{x.EmployeeName}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.DocDate | dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td>{{x.RowState}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.RowState=='@Library.Model.Enums.RowState.Parked.ToString()'"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                        <li ng-show="x.RowState=='@Library.Model.Enums.RowState.Parked.ToString()'"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                        <li><a class="btn btn-action" href="Employees/EmployeeReport/GetEmployeePaymentReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Employees/EmployeeReport/GetEmployeePaymentReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>

                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>

<div class="modal fade site-modal in" id="partyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> {{partyType}} List <button type="button" class="close" ng-click="closePartyPopUpNew();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByParty">
                                            <option ng-repeat="option in searchByPartyList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchParty" ng-enter="showPartyPopUpNew()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="showPartyPopUpNew()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        <div style="color:black;" id="partyPopUpGrid" ej-grid e-datasource="partyList" e-recorddoubleclick="closePartyPopUp"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50" e-filter="false"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="130"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="130"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="50"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-width="50"></div>
                                <div e-column e-field="Line" e-headertext="Line" e-width="50"></div>
                                <div e-column e-field="Balance" e-headertext="Payable Amount" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="AdvanceNetBalance" e-headertext="Advance Amount" e-width="80" textAlign='Right'></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                        </script>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="common-btn">
                        <ul class="list-inline text-right" ng-show="true">
                            <li><button ng-click="ViewParty();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Select </button></li>
                            <li><button ng-click="closePartyPopUpNew();" class="btn"> Close</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

