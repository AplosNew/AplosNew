                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.PostingDate | dateFiltering}}</td>
                                <td>{{x.DocDate | dateFiltering}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td class="text-right">{{x.Receivable | number:4}}</td>
                                <td class="text-right">{{x.Received | number:4}}</td>
                                <td class="text-right">{{x.Balance | number:4}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'paymentList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="customerreceivableGLData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closePopUp()">Select</button>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmSavePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Save()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(payableId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(employeePayableWriteOffId,voucherId)"></confirm-archive-generic>

