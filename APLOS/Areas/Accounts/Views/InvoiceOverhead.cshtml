                                                <li><button ng-click="DeleteChargesonfirmation(x)" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                            </ul>
                                        </td>
                                    </tr>
