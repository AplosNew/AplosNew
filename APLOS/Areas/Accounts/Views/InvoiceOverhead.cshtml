                                        <td colspan="1" class="text-right"><strong>Total : </strong></td>
                                        <td class="text-right"><strong>{{chargesList | sumByKey : 'TransactionAmount'| number:2 }}</strong></td>
                                        <td class="text-right"><strong>{{chargesList | sumByKey : 'TotalTaxAmount'| number:2  }}</strong></td>
                                        <td class="text-right"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">

                <div class="col-xs-12 col-sm-12 col-md-12" style="padding-left:0px">
                    <div class="col-xs-12 col-sm-1 col-md-1">
                        <button ng-click="showInvoicePopUp();" ng-disabled="chargesList.length == 0" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> Select Invoice </button>
                    </div>
                </div>

                <div class="col-xs-12 col-sm-12 col-md-12">

                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Invoice NO</th>
                                    <th>Invoice Date</th>
                                    <th>Vendor</th>
                                    <th>Voucher No</th>
                                    <th>TRN Amount</th>
                                    <th>Currency</th>
                                    <th>Books Amount</th>
                                    <th>Total Distributed Amount</th>
                                    <th class="col-sm-1">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in checkedInvoiceList">
                                    <td>{{x.InvoiceId}}</td>
                                    <td>{{x.PostingDate}}</td>
                                    <td>{{x.PartyPlantName}}</td>
                                    <td>{{x.VoucherNo}}</td>
                                    <td class="text-right">{{x.Amount|number:2}}</td>
                                    <td>{{x.CurrencyCode}}</td>
                                    <td class="text-right">{{x.BooksAmount}}</td>
                                    <td class="text-right">{{x.DistributedAmount|number:2}}</td>
                                    <td class="text-right">
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="DeleteConfirmation(x.InvoiceId)" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>

                                </tr>
                                <tr>
                                    <td colspan="1" class="text-right"><strong>Total : </strong></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-right"><strong>{{checkedInvoiceList | sumByKey : 'Amount' | number:2 }}</strong></td>
                                    <td></td>
                                    <td class="text-right"><strong>{{checkedInvoiceList | sumByKey : 'BooksAmount' | number:2 }}</strong></td>
                                    <td class="text-right"><strong>{{checkedInvoiceList | sumByKey : 'DistributedAmount'|  number:2 }}</strong></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="col-xs-12 col-sm-12 col-md-12" style="padding-left:0px">
                    <div class="col-xs-12 col-sm-1 col-md-1">
                        <button ng-click="showOutBoundInvoicePopUp();" ng-disabled="chargesList.length == 0" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> Select Invoice </button>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Invoice NO</th>
                                    <th>Invoice Date</th>
                                    <th>Vendor</th>
                                    <th>Voucher No</th>
                                    <th>TRN Amount</th>
                                    <th>Currency</th>
                                    <th>Books Amount</th>
                                    <th>Total Distributed Amount</th>
                                    <th class="col-sm-1">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in checkedOutBoundInvoiceList">
                                    <td>{{x.InvoiceId}}</td>
                                    <td>{{x.PostingDate}}</td>
                                    <td>{{x.PartyPlantName}}</td>
                                    <td>{{x.VoucherNo}}</td>
                                    <td class="text-right">{{x.Amount|number:2}}</td>
                                    <td>{{x.CurrencyCode}}</td>
                                    <td class="text-right">{{x.BooksAmount}}</td>

                                    <td class="text-right">{{x.DistributedAmount|number:2}}</td>
                                    <td class="text-right">
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="DeleteOutBoutConfirmation(x.InvoiceId)" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>

                                </tr>
                                <tr>
                                    <td colspan="1" class="text-right"><strong>Total : </strong></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-right"><strong>{{checkedOutBoundInvoiceList | sumByKey : 'Amount'|  number:2 }}</strong></td>
                                    <td></td>
                                    <td class="text-right"><strong>{{checkedOutBoundInvoiceList | sumByKey : 'BooksAmount' | number:2 }}</strong></td>
                                    <td class="text-right"><strong>{{checkedOutBoundInvoiceList | sumByKey : 'DistributedAmount'|  number:2 }}</strong></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Total Books Amount:</label>
                <label class="col-sm-8 control-label">{{totalBooksAmount| number:2 }}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label"> Total Distributed Amount :</label>
                <label class="col-sm-8 control-label">{{totalDistributedAmount | number:2 }}</label>
            </div>

        </div>
    </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="InsertInvoiceOverhead();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
