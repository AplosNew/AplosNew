                                    <tr>
                                        <th>Charges</th>
                                        <th>Amount (TRN)</th>
                                        <th>Total Tax Amount</th>
                                        <th class="col-sm-1">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in chargesList">
