<div class="modal fade site-modal in" id="serviceChargesPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Tax Service Charges<button type="button" class="close" ng-click="closeServiceChargesInfoPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="clearfix"></div>
                <div>
                    <p class="col-md-11"></p>
                    <button type="button" class="btn btn-action" ng-click="AddTaxRow();">Add Tax</button>
                </div>
                <div class="col-md-12 modal-table table-responsive" style="padding-top: 13px;">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Tax Category</th>
                                <th>HSN Code</th>
                                <th>Percentage</th>
                                <th>Tax Amount</th>
                                <th>Action</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in TaxCopyLisForDisplay">
                                <td>
                                    @*{{x.UserName}}*@
                                    <div class="select-style">
                                        <select class="form-control" ng-disabled="x.Id" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in updateTaxCategoryList" ng-change="onchangeTaxCategory($index)"></select>
                                    </div>
                                </td>
                                <td>{{x.HSNCode}}</td>
                                <td class="text-right">{{x.Percentage}}</td>
                                <td class="text-right">
                                    <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.TaxAmount" ng-keyup="sumSvcTaxAmount();" class="form-control text-right" />
                                </td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="RemoveTaxRow($index)" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                            @*<tr>
                                    <td colspan="3" class="text-right">Total Tax (BC)</td>
                                    <td class="text-right">{{serviceModel.TotalTaxAmount| setDecimal:currencyPrecision}}</td>
                                </tr>*@
                        </tbody>
                    </table>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeServiceChargesInfoPopUp();" class="btn"> Done</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

