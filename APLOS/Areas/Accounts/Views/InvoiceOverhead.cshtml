<div class="table-responsive aplos-grid-toggle">
    <div class="content-container-fluid" style="color:black;">
        <div style="color:black;" id="GridPrint" ej-grid e-datasource="invoiceList" e-recorddoubleclick="Get" e-allowfiltering="true" e-allowpaging="true"
             e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
