<style>
    .modellgModify {
        width: 1100px;
    }
</style>
<div class="modal fade site-modal in" id="employeePayablePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Employee Payable List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeePayableParameters.searchBy">
                                            <option ng-repeat="option in employeePayableSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeePayableParameters.search" ng-enter="getEmployeePayableData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeePayableData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Voucher No</th>
                                <th>DocDate</th>
                                <th>Doc Ref No</th>
                                <th>GRN No</th>
                                <th>Entity</th>
                                <th>Currency</th>
                                <th>Payable</th>
                                <th>Payment</th>
                                <th>Balance</th>
                                <th>Particulars</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeePayableDataList |itemsPerPage:employeePayableParameters.pageSize" pagination-id="metaData.name + 'employeePayableDataList'" total-items="employeePayableParameters.total_count" ng-dblclick="selectEmployeePayablePopUp(x)">
                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.DocDate |dateFiltering}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.GRNNo}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td class="text-right">{{x.Receivable | number:2}}</td>
                                <td class="text-right">{{x.Received | number:2}}</td>
                                <td class="text-right">{{x.Balance | number:2}}</td>
                                <td >{{x.Particular}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="5" pagination-id="metaData.name + 'employeePayableDataList'"
                                         direction-links="true" boundary-links="true" on-page-change="getEmployeePayableData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closeEmployeePayablePopUp()">Select</button>
            </div>
        </div>
    </div>
</div>