<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Party Type<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input type="radio" name="source" ng-click="getPartyType(voucher.NoteType);" ng-model="voucher.NoteType" value="@Library.Model.Invoices.NoteType.CustomerDebitNote.ToString()">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>Customer
                </label>
                <label>
                    <input type="radio" name="source" ng-click="getPartyType(voucher.NoteType);" ng-model="voucher.NoteType" value="@Library.Model.Invoices.NoteType.VendorDebitNote.ToString()">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>Vendor
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.CustomerDebitNote.ToString()'">
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Customer.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Customer.ToString()" ng-model="voucher.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.VendorDebitNote.ToString()'">
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="voucher.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Location<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="1" class="form-control" name="location" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(voucher.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div id="div_TransactionType" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-change="getTransactionTypeGL(voucher.FinancingTypeId)" name="Transaction Type" class="form-control" ng-model="voucher.FinancingTypeId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.FinancingTypeId}}">{{option.LiabilityUserName}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Is Invoice SetOff<sup></sup></label>
            <div class="col-sm-8">
                <input type="checkbox" ng-model="voucher.IsInvoiceSetOff">
            </div>
        </div>
        @*<div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Debit Type<sup>*</sup></label>
                <div class="col-sm-8 radio">
                    <label>
                        <input type="radio" name="settlementType" ng-change="changeSettlementType()" ng-model="voucher.SettlementType" value="Invoice">
                        <span class="cr" tabindex="1"><i class="cr-icon"></i></span>Invoice
                    </label>
                    <label>
                        <input type="radio" name="settlementType" ng-change="changeSettlementType()" ng-model="voucher.SettlementType" value="Others">
                        <span class="cr" tabindex="2"><i class="cr-icon"></i></span>Others
                    </label>
                </div>
            </div>*@
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>


        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="3">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-4 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="5" name="CurrencyTransaction" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList(); checkBankAmount();" disabled>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-4 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" required autocomplete="off" ng-disabled="voucher.CurrencyId==companyCurrencyId">
            </div>
        </div>
        @*<div class="form-group" ng-show="voucher.SettlementType=='@Library.Model.Payments.SettlementType.Invoice.ToString()'">
                <label class="col-sm-3 control-label">Invoice<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <div class="input-group" ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.CustomerDebitNote.ToString()'">
                        <span class="common-btn">
                            <button ng-click="showCustomerInvoicePopUp(voucher.PartyId);" type="button" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Invoice</button>
                        </span>
                    </div>
                    <div class="input-group" ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.VendorDebitNote.ToString()'">
                        <span class="common-btn">
                            <button ng-click="showVenorInvoicePopUp(voucher.PartyId);" type="button" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Invoice</button>
                        </span>
                    </div>
                </div>
            </div>*@

    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required autocomplete="off" capitalize>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea rows="2" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>

    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group">
            @*ng-show="voucher.SettlementType=='@Library.Model.Payments.SettlementType.Others.ToString()'"*@
            <label class="col-sm-4 control-label">Add GL<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="common-btn">
                        <button ng-click="GetCOAICodeList();" type="button" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select GL</button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="invoiceSalesAvailableList.length">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>GL</th>
                    <th>Budget</th>
                    <th>Activity</th>
                    <th class="text-right" ng-show="voucher.SettlementType=='@Library.Model.Payments.SettlementType.Invoice.ToString()'">Invoice Amount</th>
                    <th class="text-right">Taxable Amount</th>
                    <th class="text-right">Tax Amount</th>
                    <th class="text-right">Total Amount</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in invoiceSalesAvailableList">
                    <td>{{x.GLGeneralInfoName}}</td>
                    <td>{{x.BudgetName}}</td>
                    <td>{{x.ActivityName}}</td>
                    <td class="text-right" ng-show="voucher.SettlementType=='@Library.Model.Payments.SettlementType.Invoice.ToString()'">{{x.InvoiceAmount| number:2}}</td>
                    <td><input type="text" class="form-control text-right" id="vdCrAmount" ng-model="x.Amount" n-decimals="2" ng-keyup="calculatebackTax($index);calculateTax($index);calReDistributedAmount($index,x);" autocomplete="off"></td>
                    <td>
                        <div class="show-message">
                            <input type="text" n-decimals="4" class="form-control text-right" ng-model="x.TotalTax" readonly>
                        </div>
                    </td>
                    <td>
                        <div class="show-message">
                            <input type="text" n-decimals="4" class="form-control text-right" ng-model="x.TotalAmount" readonly>
                        </div>
                    </td>
                    <td class="text-right">
                        <button ng-click="getExpenseDistribute($index,x)" ng-show="x.IsOrderSpecific" ng-disabled="x.TotalAmount == 0 || TotalChargesAmount == 0 " class="btn btn-action tooltip-here" data-placement="top" title="Expense Distribute">
                            <i>Distribute</i>
                        </button>
                        <button ng-click="getTaxCode($index,x.ActivityId)" class="btn btn-action tooltip-here" data-placement="top" title="Tax">
                            <i>Tax</i>
                        </button>
                        <button ng-click="removeSalaryRow($index)" data-toggle="modal" ng-disabled="currencyDisable" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-right">Total</td>
                    <td class="text-right"><b>{{ (invoiceSalesAvailableList) | sumByKey:'Amount'| number:2 }}</b></td>
                    <td class="text-right"><b>{{ (invoiceSalesAvailableList) | sumByKey:'TotalTax'| number:2 }}</b></td>
                    <td class="text-right"><b>{{ (invoiceSalesAvailableList) | sumByKey:'TotalAmount'| number:2 }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="invoiceTaxDetailList.length">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Tax Category Name</th>
                    <th class="text-center">Tax Amount</th>
                    <th class="text-center">Amount</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in invoiceTaxDetailList">
                    <td>{{x.TaxCategoryName}}</td>
                    <td><input type="text" class="form-control text-right" id="vdDrAmount" ng-model="x.TaxAmount " n-decimals="2" autocomplete="off"></td>
                    <td><input type="text" class="form-control text-right" id="vdCrAmount" ng-model="x.Amount " n-decimals="2" autocomplete="off"></td>
                    <td class="text-right">
                        <button ng-click="removeTaxRow($index)" data-toggle="modal" ng-disabled="currencyDisable" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-5 col-md-5" ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.VendorDebitNote.ToString()'">
        <div class="form-group">
            <label class="col-sm-4 control-label">TDS</label>
            <label class="switch col-sm-8">
                <input type="checkbox" ng-model="modelNew.AddtionalTax">
                <span class="slider round"></span>
            </label>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="modelNew.AddtionalTax">
        <table class="table table-responsive table-striped">
            <thead>
                <tr>
                    <th>Input Tax</th>
                    <th>Percentage</th>
                    <th>Amount</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_TDS_TaxCode">
                        <div class="select-style show-message">
                            <select name="TDSTaxCodeId" ng-model="TDS.TaxCodeId" ng-change="selectTDS(TDS.TaxCodeId)" class="col-sm-3 form-control"
                                    ng-options="item.Id as item.UserName for item in TDSCboList">
                                <option></option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <div>
                            <input type="text" n-decimals="4" class="form-control text-right" ng-disabled="TDS.Type =='FixedPercentage' && TDS.ValueOfFixed!=null" ng-model="TDS.ValueOfFixed">
                        </div>
                    </td>
                    <td id="td_TDS_TaxCodeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="4" class="form-control text-right" ng-model="TDS.TaxAmount" ng-keyup="copyTaxesAmount();">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addTDS();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in TDSList">
                    <td>{{x.TaxName}}</td>
                    <td>{{x.ValueOfFixed}}</td>
                    <td class="text-right">{{x.TaxAmount | number:2 }}</td>
                    <td class="text-right">
                        <button ng-click="removeTDSRow($index)" data-toggle="modal" ng-disabled="x.AdvanceId" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="TDSList.length">
                <tr>
                    <td colspan="2"><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ TDSList | sumByKey : 'TaxAmount' }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-12 col-md-12" ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.VendorDebitNote.ToString()' && voucher.IsInvoiceSetOff==true">
        <div class="col-xs-12 col-sm-2 col-md-2">
            <button class="btn single-btn" ng-click="showVendorInvoicePopUp(voucher.PartyId);" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Select Invoice</button>
        </div>
        <div class="clearfix"></div>
        <fieldset class="scheduler-border" ng-show="voucherInvoiceDetailList.length">
            <legend class="scheduler-border">Invoice</legend>
            <div class="table-responsive modal-table">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Voucher No</th>
                            <th>DocDate</th>
                            <th>Doc Ref No</th>
                            <th>Currency</th>
                            <th>Rate</th>
                            <th class="text-right">Payable</th>
                            <th class="text-right">Payment</th>
                            <th class="text-right">Balance</th>
                            <th class="text-right">Amount</th>
                            <th>Exchange Type</th>
                            <th>Exchange Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in voucherInvoiceDetailList">
                            <td>{{x.VoucherNo}}</td>
                            <td>{{x.DocDate |dateFiltering}}</td>
                            <td>{{x.DocRefNo}}</td>
                            <td>{{x.CurrencyCode}}</td>
                            <td>{{x.CompanyCurrencyRate}}</td>
                            <td class="text-right">{{x.Receivable | number:3}}</td>
                            <td class="text-right">{{x.Received | number:3}}</td>
                            <td class="text-right">{{x.Balance | number:3}}</td>
                            <td>
                                <input ng-keyup="exchangeGainLossAmountInvoice(x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="x.Amount">
                            </td>
                            <td>
                                <input readonly type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeType" ng-model="x.ExchangeType">
                            </td>
                            <td>
                                <input readonly type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeAmount" ng-model="x.ExchangeAmount">
                            </td>
                            <td class="text-right">
                                <button ng-click="removeInvoiceRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="8" class="text-right">Total</td>
                            <td class="text-right"><b>{{ (voucherInvoiceDetailList) | sumByKey:'Amount'| number:2 }}</b></td>
                            <td></td>
                            <td class="text-right"><b>{{ (voucherInvoiceDetailList) | sumByKey:'ExchangeAmount'| number:2 }}</b></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </fieldset>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Party</th>
                <th>Posting Date</th>
                <th>Doc Ref No</th>
                <th>Party Type</th>
                <th>Entity</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                <td>{{x.PostingDate| dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.PartyType}}</td>
                <td>{{x.EntityName}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td>{{x.IsPark?'Parked':'Posted'}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id,x);" href="" class="btn btn-action tooltip-here">Post</a></li>
                        <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                        <li><a class="btn btn-action" href="Accounts/AdjustmentNote/GetDebitNoteReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Accounts/AdjustmentNote/GetDebitNoteReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        <li ng-show="x.IsExpenseDistribution"><a ng-click="ExpenseDistributionReport('Excel',x.VoucherId);" class="btn btn-action" title="Expense Distribution Report"><i class="fa fa-file-excel-o"></i></a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
