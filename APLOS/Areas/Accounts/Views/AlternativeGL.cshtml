<togglable name="Alternative GL"></togglable>
<div class="form-horizontal" ng-form name="alternativeGLForm">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-3 col-md-2 control-label">Alternative COA<sup>*</sup></label>
            <div class="col-sm-3 col-md-4  show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="alternativeGL.AlternativeCOAId" name="AlternativeCOA"
                            ng-change="onCOAChange(alternativeGL.AlternativeCOAId); onAlternativeCOAChangeSequence(alternativeGL.AlternativeCOAId); getLength(alternativeGL.AlternativeCOAId)"
                            ng-options="item.Value as item.Text for item in alternativeCOAList" required></select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
<div class="form-elements" ng-form id="alternativeGL" name="alternativeGLForm">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Sequence" ng-model="alternativeGL.Sequence" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="StandardName" ng-model="alternativeGL.UserName" maxlength="50" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input tabindex="5" type="checkbox" ng-model="alternativeGL.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Account Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="GLGeneralInfoCode" maxlength="{{maxLength}}" ng-keypress="isNumeric(event)" ng-change="maxLengthCheck(this)" ng-model="alternativeGL.GLGeneralInfoCode" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="alternativeGL.Description" tabindex="4" maxlength="250"></textarea>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByAlternativeGLList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Account Code</th>
                <th>User Name</th>
                <th>Description</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in alternativeGLs |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.GLGeneralInfoCode}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Description}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
</div>
<dir-pagination-controls max-size="10" direction-links="true" boundary-links="true"
                         on-page-change="getData(newPageNumber)">
</dir-pagination-controls>
<confirm-modal></confirm-modal>