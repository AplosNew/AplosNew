            <div class="common-btn">
                <ul class="list-inline ">
                    <li>
                        <button ng-click="$parent.GLControlReport(data);" title="GL Control" class="btn small">
                            <i class="glyphicon glyphicon-cloud-download"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>
    </div>
</div>
