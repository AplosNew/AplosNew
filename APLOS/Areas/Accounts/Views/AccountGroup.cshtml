<togglable name="Account Group"></togglable>
<div class="form-horizontal" ng-form name="accountgroupForm">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-3 col-md-2 control-label">COA<sup>*</sup></label>
            <div class="col-sm-3 col-md-4 show-message">
                <div class="select-style">
                    <select class="form-control" submit-required="true" ng-model="accountgroup.COAId" ng-change="getData(); onCOAChangeSequence(accountgroup.COAId); getLength(accountgroup.COAId)"
                            ng-options="item.Value as item.Text for item in cOAList"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
<div class="form-elements" ng-form id="accountgroup" name="accountgroupForm">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Sequence" ng-model="accountgroup.Sequence" class="form-control" required placeholder="0.00" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="StandardName" maxlength="50" ng-model="accountgroup.StandardName" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Number Range<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="{{maxLength}}" onkeypress="return isNumeric(event)" oninput="maxLengthCheck(this)" type="number" name="From Number Range" placeholder="0.00" ng-model="accountgroup.FromNumberRange" class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="accountgroup.Description" name="Description" maxlength="250" tabindex="9" ng-trim="false"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" maxlength="10" ng-model="accountgroup.Code" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="UserName" maxlength="50" ng-model="accountgroup.UserName" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Number Range<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="{{maxLength}}" type="number" name="ToNumberRange" ng-model="accountgroup.ToNumberRange" class="form-control" required tabindex="6" onkeypress="return isNumeric(event)" oninput="maxLengthCheck(this)" ng-change="checkBig()">
                <span ng-if="checkBigErrorc">{{checkBigError}}</span>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Account Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" submit-required="true" ng-model="accountgroup.AccountTypeId" ng-options="item.Value as item.Text for item in coaaccounttypeList"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input tabindex="10" type="checkbox" ng-model="accountgroup.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchaccountgroupByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>User Name</th>
                <th>From Number Range</th>
                <th>To Number Range</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in accountgroups |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.UserName}}</td>
                <td class="text-right">{{x.FromNumberRange}}</td>
                <td class="text-right">{{x.ToNumberRange}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>