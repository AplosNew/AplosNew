<togglable name="Employee Advance Requisition"></togglable>
<div class="form-horizontal form-elements" ng-form="modelNewForm">
    <div class="row">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" class="form-control" ng-model="model.EmployeeName" disabled e-width="100%" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker class="form-control" e-dataBound="model.RequisitionAddedDate" e-value="model.RequisitionAddedDate" disabled e-width="100%" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Amount<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" class="form-control" ej-numerictextbox e-decimalplaces="0" e-enablertl="false" e-value="model.Amount" e-width="100%" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Advance Type<sup>*</sup></label>
                <div class="col-sm-8 radio">
                    <label>
                        <input type="radio" name="source" ng-disabled="true" ng-model="model.AdvanceType" value="General">
                        <span class="cr" tabindex="17"><i class="cr-icon"></i></span>General
                    </label>
                    <label>
                        <input type="radio" name="source" ng-disabled="true" ng-model="model.AdvanceType" value="Salary">
                        <span class="cr" tabindex="18"><i class="cr-icon"></i></span>Salary
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Checked By<sup>*</sup></label>
                <div class="col-sm-8">
                    <input e-required id="ddlcheckedByList" ej-dropdownlist e-datasource="checkedByList" e-fields-value="Id" disabled e-fields-text="Value" e-value="model.CheckedBy" e-width="100%" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Approved By<sup>*</sup></label>
                <div class="col-sm-8">
                    <input e-required id="ddlApprovedByList" ej-dropdownlist e-datasource="approvedByList" e-fields-value="Id" e-fields-text="Value" e-value="model.ApprovedBy" e-width="100%" />
                </div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Department<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" class="form-control"  ng-model="model.Department" disabled e-width="100%" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Required Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input id="RequisitionRequiredDate" e-dateformat="dd-MMM-yyyy" ej-datepicker class="form-control" e-dataBound="model.RequisitionRequiredDate" e-value="model.RequisitionRequiredDate" disabled e-width="100%" />

                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-8">
                    <input e-required id="ddlCurrencyList" ej-dropdownlist e-datasource="currencyList" e-fields-value="Value" e-fields-text="Text" e-value="model.CurrencyId" disabled e-width="100%" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks<sup>*</sup></label>
                <div class="col-sm-8">
                    <textarea class="form-control rounded-0" id="exampleFormControlTextarea1" ng-model="model.Remarks" disabled maxlength="100"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Reason<sup>*</sup></label>
                <div class="col-sm-8">
                    <textarea class="form-control rounded-0" id="exampleFormControlTextarea1" ng-model="model.Reason" maxlength="100"></textarea>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <fieldset class="scheduler-border" >
            <legend class="scheduler-border">Advance Schedule</legend>
            <div class="table-responsive modal-table" ng-show="getAdvanceReqScheduleList.length" style="padding-top:10px;">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Installment Date</th>
                            <th>Installment No</th>
                            <th>Principal Amount</th>
                            <th>Interest Amount</th>
                            <th>Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in getAdvanceReqScheduleList">
                            <td>{{x.InstallmentDate}}</td>
                            <td>{{x.InstallmentNo}}</td>
                            <td>{{x.PrincipalAmount}}</td>
                            <td>{{x.ProfitAmount}}</td>
                            <td>{{x.Balance}}</td>
                        </tr>
                    </tbody>

                </table>
            </div>
        </fieldset>
    </div>
    <div class="common-btn">
        <ul class="common-btn list-inline text-right" style="padding: 20px;">
            <li><button ng-click="Save();" ng-disabled="model.SystemId===null" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk right"></i> Approved</button></li>
            <li> <button ng-click="Hold();" ng-disabled="model.SystemId===null" class="btn" tabindex="10"><i class="glyphicon glyphicon-pause"></i> Hold</button></li>
            <li> <button ng-click="Reject();" ng-disabled="model.SystemId===null" class="btn" tabindex="10"><i class="glyphicon glyphicon-ban-circle"></i> Reject</button></li>
            <li><button ng-click="Cancel();" class="btn" tabindex="10"><i class="glyphicon glyphicon-repeat"></i> Cancel</button></li>
        </ul>
    </div>
</div>

<div class="aplos-grid-toggle">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Approval List</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);getApprovedHoldData();" href="" aria-controls="address" role="tab" data-toggle="tab">Approved Hold</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4);getApprovedRejectData();" href="" aria-controls="address" role="tab" data-toggle="tab">Approved Reject</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);getApprovedData();" href="" aria-controls="address" role="tab" data-toggle="tab">Approved</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
                    <div class="content-container-fluid" style="color:black;">
                        <div id="gridEmpAdvanceReqCheckList" ej-grid e-datasource="CheckEmpAdvanceReqList" e-recorddoubleclick="Get"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="EmployeeName" e-headertext="Employee"></div>
                                <div e-column e-field="RequisitionAddedDate" e-headertext="Added Date"></div>
                                <div e-column e-field="RequisitionRequiredDate" e-headertext="Required Date"></div>
                                <div e-column e-field="Amount" e-headertext="Amount"></div>
                                <div e-column e-field="AdvanceType" e-headertext="Advance Type"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks"></div>
                                <div e-column e-field="CheckedBy" e-headertext="Checked By"></div>
                                <div e-column e-field="ApprovedBy" e-headertext="Approved By"></div>
                                <div e-column e-field="ApprovalStatus" e-headertext="Status"></div>
                                <div e-column e-headertext="PDF" e-commands="PdfPrint" e-isunbound=true e-textalign="center" e-width="50"></div>
                                <div e-column e-headertext="Excel" e-commands="ExcelPrint" e-isunbound=true e-textalign="center" e-width="50"></div>
                            </div>
                        </div>

                    </div>
                </fieldset>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Approved Data</span></legend>
                    <div class="content-container-fluid" style="color:black;">
                        <div id="gridApprovedList" ej-grid e-datasource="EmpAdvanceReqApprovedList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="EmployeeName" e-headertext="Employee"></div>
                                <div e-column e-field="RequisitionAddedDate" e-headertext="Added Date"></div>
                                <div e-column e-field="RequisitionRequiredDate" e-headertext="Required Date"></div>
                                <div e-column e-field="Amount" e-headertext="Amount"></div>
                                <div e-column e-field="AdvanceType" e-headertext="Advance Type"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks"></div>
                                <div e-column e-field="CheckedBy" e-headertext="Checked By"></div>
                                <div e-column e-field="ApprovedBy" e-headertext="Approved By"></div>
                                <div e-column e-field="ApprovalStatus" e-headertext="Status"></div>
                                <div e-column e-headertext="Report" e-template="#ReportTemplate" e-width="100"></div>
                            </div>
                        </div>

                    </div>
                    <script id="ReportTemplate" type="text/template">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-center">
                                <li>
                                    <button ng-click="$parent.onClickReportDownloadWord(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Pdf">
                                        <i class="fa fa-file-pdf-o"></i>
                                    </button>
                                    <button ng-click="$parent.onClickReportDownloadExcel(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Excel">
                                        <i class="fa fa-file-excel-o"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </script>
                </fieldset>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Approved Hold Data</span></legend>
                    <div class="content-container-fluid" style="color:black;">
                        <div id="grid1" ej-grid e-datasource="ApprovedHoldDataList" e-recorddoubleclick="Get"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="EmployeeName" e-headertext="Employee"></div>
                                <div e-column e-field="RequisitionAddedDate" e-headertext="Added Date"></div>
                                <div e-column e-field="RequisitionRequiredDate" e-headertext="Required Date"></div>
                                <div e-column e-field="Amount" e-headertext="Amount"></div>
                                <div e-column e-field="AdvanceType" e-headertext="Advance Type"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks"></div>
                                <div e-column e-field="CheckedBy" e-headertext="Checked By"></div>
                                <div e-column e-field="ApprovedBy" e-headertext="Approved By"></div>
                                <div e-column e-field="ApprovalStatus" e-headertext="Status"></div>
                                <div e-column e-headertext="PDF" e-commands="PdfPrint" e-isunbound=true e-textalign="center" e-width="50"></div>
                                <div e-column e-headertext="Excel" e-commands="ExcelPrint" e-isunbound=true e-textalign="center" e-width="50"></div>
                            </div>
                        </div>

                    </div>
                </fieldset>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Approved Reject Data</span></legend>
                    <div class="content-container-fluid" style="color:black;">
                        <div id="grid2" ej-grid e-datasource="ApprovedrejectDataList" e-recorddoubleclick="Get"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="EmployeeName" e-headertext="Employee"></div>
                                <div e-column e-field="RequisitionAddedDate" e-headertext="Added Date"></div>
                                <div e-column e-field="RequisitionRequiredDate" e-headertext="Required Date"></div>
                                <div e-column e-field="Amount" e-headertext="Amount"></div>
                                <div e-column e-field="AdvanceType" e-headertext="Advance Type"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks"></div>
                                <div e-column e-field="CheckedBy" e-headertext="Checked By"></div>
                                <div e-column e-field="ApprovedBy" e-headertext="Approved By"></div>
                                <div e-column e-field="ApprovalStatus" e-headertext="Status"></div>
                                <div e-column e-headertext="PDF" e-commands="PdfPrint" e-isunbound=true e-textalign="center" e-width="50"></div>
                                <div e-column e-headertext="Excel" e-commands="ExcelPrint" e-isunbound=true e-textalign="center" e-width="50"></div>
                            </div>
                        </div>

                    </div>
                </fieldset>
            </div>
        </div>
    </div>
</div>


<style>
    .loaderr {
        width: 300px;
        height: 200px;
        background-color: #0780BA;
        color: #fff;
        padding: 100px;
        font-size: 25px;
    }

    .e-grid .e-headercelldiv {
        font-weight: bold;
        font-size: 10px;
        display: block;
        border: 0 none;
        height: 29px;
        line-height: 29px;
        margin: -7px;
        padding: 0 .7em;
        text-align: left;
        white-space: nowrap;
        text-overflow: ellipsis;
        font-family: "Arial Narrow";
    }

    .e-grid .e-rowcell {
        border-width: 1px 0 0 1px;
        padding: .7em;
        line-height: 10px;
        white-space: nowrap;
        width: auto;
        vertical-align: middle;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .e-grid.e-wrap .e-columnheader .e-headercelldiv {
