<togglable name="Tax Year Period"></togglable>
<div class="form-horizontal" ng-form name="pDPFunctionForm">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-3 col-md-2 control-label">Tax Year<sup>*</sup></label>
            <div class="col-sm-3 col-md-4  show-message">
                <div class="select-style">
                    <select name="Tax Year" ng-model="taxYearperiod.TaxYearId" class="col-sm-3 form-control"
                            ng-change="getData()" ng-options="item.Value as item.Text for item in TaxYearList" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
<div class="form-elements  form-horizontal" ng-form id="taxYearPeriod" name="taxYearPeriodForm">
    <input type="hidden" ng-model="taxYearperiod.Id">
    <div class="col-xs-4 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Start Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Start Date" ng-model="taxYearperiod.StartDate" datepicker class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Period No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Period No" ng-model="taxYearperiod.PeriodNo" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="taxYearperiod.Active" tabindex="6">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-4 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">End Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="End Date" ng-model="taxYearperiod.EndDate" datepicker class="form-control datepicker" required tabindex="3">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="taxYearperiod.Description" tabindex="5"></textarea>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="6"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="7"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search"  ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Period No</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="y in taxYearPeriods |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(y.Id, $index);">
                <td>{{y.StartDate}}</td>
                <td>{{y.EndDate}}</td>
                <td>{{y.PeriodNo}}</td>
                <td>{{y.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="12" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>