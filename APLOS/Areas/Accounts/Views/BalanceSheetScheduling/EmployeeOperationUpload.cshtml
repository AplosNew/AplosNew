

<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Upload & Download Sample File</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);getSavedOperationData();" href="" data-toggle="tab">Employee Skill Master</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <togglable name="Skill Master To be Uploaded & Downloaded"></togglable>
        <div class="form-elements form-horizontal row" ng-form name="ModelNewForm">
            <div class="col-md-12">
                <div class="col-md-8">
                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-4 ">
                            <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                        </label>
                        <input type="button" value="Import Data" class="btn btn-success"
                               ng-click="ImportData()" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="GetSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File Download</button></li>
                            <li ng-show="ShowSaveBtn"> <button ng-click="SaveEmployeeOperationUploadedData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                        </ul>
                    </div>
                </div>
            </div>
           
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div id="GridEmployeeSkill"
                     ng-init="chkinit()"
                     ej-grid e-datasource="EmployeeOperationUploadedData"
                     e-allowfiltering="true"
                     e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowscrolling="true"
                     e-pagesettings-pagesize="25"
                     e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="OperationMasterId" e-headertext="OperationMasterId" e-width="60"></div>
                        <div e-column e-field="OperationMaster" e-headertext="OperationMaster" e-width="100"></div>
                        <div e-column e-field="Skill" e-headertext="Skill" e-width="100"></div>
                        <div e-column e-field="SkillGroup" e-headertext="SkillGroup" e-width="100"></div>
                        <div e-column e-field="DesignationGroup" e-headertext="DesignationGroup" e-width="100"></div>
                        <div e-column e-field="LegalDesignation" e-headertext="LegalDesignation" e-width="100"></div>
                        <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                        <div e-column e-field="EmpSystemId" e-headertext="EmpSystemId" e-width="60"></div>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-width="50"></div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12 ">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li ng-show="ShowSaveBtn"> <button ng-click="SaveEmployeeOperationUploadedData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li> <button ng-click="XlsReport();" class="btn"><i class="glyphicon glyphicon-download-alt"></i> Export to Excel</button></li>
            </ul>
        </div>
        <div style="color:black;" id="GridEmpMultiop" ej-grid e-datasource="EmployeeOperationList" e-gridlines="vertical"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="EmpSystemId" e-headertext="EmpSystemId" e-width="50" style="height: 20px;"></div>
                <div e-column e-field="EmployeeCode" e-headertext="EmployeeCode" e-width="50" style="height: 20px;"></div>
                <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="100" style="height: 20px;"></div>
                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="50" style="height: 20px;"></div>
                <div e-column e-field="Code" e-headertext="Code" e-width="50"></div>
                <div e-column e-field="ShortName" e-headertext="Short Name" e-width="50"></div>
                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="100"></div>
                <div e-column e-field="UserName" e-headertext="User Name" e-width="100"></div>
                <div e-column e-field="Skill" e-headertext="Skill" e-width="100"></div>
                <div e-column e-field="CycleTime" e-headertext="Cycle Time" e-width="50"></div>
            </div>
        </div>
    </div>
</div>


