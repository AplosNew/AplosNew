<togglable name="Balance Sheet Scheduling"></togglable>
<div class="form-elements" ng-form id="balanceSheetScheduling" name="balanceSheetSchedulingForm">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Id</label>
            <div class="col-sm-8">
                <input type="text" name="Id" ng-model="balanceSheetScheduling.Id" readonly class="form-control" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="TypeId" class="form-control" name="Type" ng-model="balanceSheetScheduling.Type" tabindex="7" required>
                        <option value="BS">BS</option>
                        <option value="PL">PL</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">DetailApplicable</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="DetailApplicable" class="form-control" name="DetailApplicable" ng-model="balanceSheetScheduling.DetailApplicable" tabindex="7">
                        <option value="Budget Level">Budget Level</option>
                        <option value="Activity Level">Activity Level</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Option No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="25" name="OptionNo" ng-model="balanceSheetScheduling.OptionNo" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Group Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="GroupSequence" ng-model="balanceSheetScheduling.GroupSequence" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Group<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="Group" ng-model="balanceSheetScheduling.Group" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sub Group Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="SubGroupSequence" ng-model="balanceSheetScheduling.SubGroupSequence" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sub Group<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="SubGroup" ng-model="balanceSheetScheduling.SubGroup" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Group</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="UserGroup" ng-model="balanceSheetScheduling.UserGroup" class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Sub Group</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="SubGroup" ng-model="balanceSheetScheduling.UserSubGroup" class="form-control" tabindex="2">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">IsCalculate</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="balanceSheetScheduling.IsCalculate" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="ItemSequence" ng-model="balanceSheetScheduling.ItemSequence" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="ItemNo" ng-model="balanceSheetScheduling.ItemNo" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="Item" ng-model="balanceSheetScheduling.Item" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sub Item No<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="SubItemNo" ng-model="balanceSheetScheduling.SubItemNo" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sub Item<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="SubItem" ng-model="balanceSheetScheduling.SubItem" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Schedule No</label>
            <div class="col-sm-8">
                <input maxlength="50" type="text" name="ScheduleNo" ng-model="balanceSheetScheduling.ScheduleNo" class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Schedule Name</label>
            <div class="col-sm-8">
                <input maxlength="50" type="text" name="ScheduleName" ng-model="balanceSheetScheduling.ScheduleName" class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">User Item</label>
            <div class="col-sm-8">
                <input maxlength="50" type="text" name="UserItem" ng-model="balanceSheetScheduling.UserItem" class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">User Schedule Name</label>
            <div class="col-sm-8">
                <input maxlength="50" type="text" name="UserScheduleName" ng-model="balanceSheetScheduling.UserScheduleName" class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="balanceSheetScheduling.IsActive" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-12" ng-show="balanceSheetScheduling.IsCalculate">
        <fieldset class="scheduler-border" style="width:1076px">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Head</label>
                    <div class="col-sm-6">
                        @*<div class="select-style">
                            <select ng-model="balanceSheetScheduling.HeadIdFormula" id="QHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in QualityProcessParameterHeaderList">
                                <option value=""></option>
                            </select>
                        </div>*@
                        <div class="input-group">
                            <input type="text" name="BalanceSheetScheduling" ng-model="balanceSheetScheduling.HeadIdFormula" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="ShowBalanceSheetSchedulingPopUp();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li>
                                    <button ng-click="SetFormula('SHead');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Value</label>
                    <div class="col-sm-6">
                        <input type="text" name="Value" ng-model="balanceSheetScheduling.Value" class="form-control" maxlength="50">
                    </div>
                    <div class="col-sm-2">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li>
                                    <button ng-click="SetFormula('Value');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Operator</label>
                    <div class="col-sm-6">
                        <div class="select-style">
                            <select ng-model="balanceSheetScheduling.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList">
                                <option value=""></option>
                            </select>
                        </div>

                    </div>
                    <div class="col-sm-2">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li>
                                    <button ng-click="SetFormula('Operator');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Precedence</label>
                    <div class="col-sm-6">
                        <div class="select-style">
                            <select ng-model="balanceSheetScheduling.Precedence" class="form-control" name="Precedence">
                                <option value=""></option>
                                <option value="(">(</option>
                                <option value=")">)</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li>
                                    <button ng-click="SetFormula('Precedence');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li>
                            <button ng-click="RemoveFormula();" class="btn"><i class="glyphicon glyphicon-backward"></i></button>
                        </li>
                    </ul>
                </div>
                <div class="form-group">
                    {{balanceSheetScheduling.FormulaDescription}}
                </div>
            </div>
        </fieldset>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="SaveBalanceSheetScheduling();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{ActionBalanceSheetScheduling}}</button></li>
            <li> <button ng-click="RemoveBalanceSheetScheduling();" data-target="#confirmPopUp" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="ClearFieldsBalanceSheetScheduling();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getDataBalanceSheetScheduling()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getDataBalanceSheetScheduling()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="balanceSheetSchedulings" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2"></div>
            <div e-column e-field="OptionNo" e-headertext="OptionNo" e-width="3"></div>
            <div e-column e-field="Type" e-headertext="Type" e-width="5"></div>
            <div e-column e-field="DetailApplicable" e-headertext="Detail Applicable" e-width="5"></div>
            <div e-column e-field="GroupSequence" e-headertext="Group Sequence" e-width="5"></div>
            <div e-column e-field="Group" e-headertext="Group" e-width="5"></div>
            <div e-column e-field="SubGroupSequence" e-headertext="Sub Group Sequence" e-width="5"></div>
            <div e-column e-field="SubGroup" e-headertext="Sub Group" e-width="5"></div>
            <div e-column e-field="UserGroup" e-headertext="User Group" e-width="2"></div>
            <div e-column e-field="UserSubGroup" e-headertext="User Sub Group" e-width="2"></div>
        </div>

    </div>
</div>
<confirm-archive-generic modalid="confirmDetailPopUpLevel1" title="Confirmation" message={{message_Detailconfirmation}} data-ng-click-right-button="DeleteBalanceSheetScheduling();"></confirm-archive-generic>

<div class="modal fade site-modal in" id="BalanceSheetSchedulingPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> Balance Sheet Scheduling List <button type="button" class="close" ng-click="closeBalanceSheetSchedulingPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid">

                        <div style="color:black;" id="BalanceSheetSchedulingPopUpGrid" ej-grid e-datasource="BalanceSheetSchedulingList" e-recorddoubleclick="SetBalanceSheetSchedulingData"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-width="2"></div>
                                <div e-column e-field="OptionNo" e-headertext="OptionNo" e-width="3"></div>
                                <div e-column e-field="Type" e-headertext="Type" e-width="5"></div>
                                <div e-column e-field="DetailApplicable" e-headertext="Detail Applicable" e-width="5"></div>
                                <div e-column e-field="GroupSequence" e-headertext="Group Sequence" e-width="5"></div>
                                <div e-column e-field="Group" e-headertext="Group" e-width="5"></div>
                                <div e-column e-field="SubGroupSequence" e-headertext="Sub Group Sequence" e-width="5"></div>
                                <div e-column e-field="SubGroup" e-headertext="Sub Group" e-width="5"></div>
                                <div e-column e-field="UserGroup" e-headertext="User Group" e-width="2"></div>
                                <div e-column e-field="UserSubGroup" e-headertext="User Sub Group" e-width="2"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeBalanceSheetSchedulingPopUp();" class="btn"> Close</button></li>
                </ul>
               
            </div>
        </div>
    </div>
</div>