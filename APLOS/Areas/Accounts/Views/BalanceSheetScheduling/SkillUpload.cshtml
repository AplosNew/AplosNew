<togglable name=" To be Uploaded & Downloaded"></togglable>
<div class="form-elements form-horizontal row" ng-form name="ModelNewForm">
    <div class="col-md-12">
        <div class="col-md-10">
            <div class="inputBtnSection common-btn">
                <label class="fileUpload col-sm-4 ">
                    <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                </label>
                <input type="button" value="Import Data" class="btn btn-success"
                       ng-click="ImportData()" />
            </div>
        </div>
        <div class="col-md-2">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="GetSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File Download</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div id="GridEmployeeSkill"
             ng-init="chkinit()"
             ej-grid e-datasource="EmployeeSkillUploadedData"
             e-allowfiltering="true"
             e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowscrolling="true"
             e-pagesettings-pagesize="25"
             e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="SkillId" e-headertext="SkillId" e-width="60"></div>
                <div e-column e-field="SkillUserName" e-headertext="SkillUserName" e-width="100"></div>
                <div e-column e-field="SkillGroup" e-headertext="SkillGroup" e-width="100"></div>
                <div e-column e-field="SkillCategory" e-headertext="SkillCategory" e-width="100"></div>
                <div e-column e-field="MachineApplicable" e-headertext="MachineApplicable" e-width="50"></div>
                <div e-column e-field="OperationApplicable" e-headertext="OperationApplicable" e-width="50"></div>
                <div e-column e-field="DashboardApllicable" e-headertext="DashboardApllicable" e-width="50"></div>
                <div e-column e-field="EmpSystemId" e-headertext="EmpSystemId" e-width="60"></div>
                <div e-column e-field="Remark" e-headertext="Remark" e-width="100"></div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 ">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li ng-show="ShowSaveBtn"> <button ng-click="SaveEmployeeSkillUploadedData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
            </ul>
        </div>
    </div>
</div>
