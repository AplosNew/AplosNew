<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Balance Sheet Scheduling</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">To be Uploaded & Downloaded</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="general" role="tab" data-toggle="tab">Checking</a></li>
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="general" role="tab" data-toggle="tab">Approving</a></li>
            @*<li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="Service" role="tab" data-toggle="tab">Chart of Account Level 5</a></li>
        <li role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" aria-controls="Service" role="tab" data-toggle="tab">Chart of Account Level 6</a></li>*@

        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            @Html.Partial("~/Areas/Accounts/Views/BalanceSheetScheduling/_BalanceSheetScheduling.cshtml")
        </div>

        @*   TAB -2  *@
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            @Html.Partial("~/Areas/Accounts/Views/BalanceSheetScheduling/_BalanceSheetSchedulingDataUploadDownload.cshtml")
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
            <div class="form-elements form-horizontal row" ng-form name="ModelNewCheckingForm">
                <div class="col-md-10">
                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-4 ">
                            <input id="uploadImageChk" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                        </label>
                        <input type="button" value="Import Data" class="btn btn-success" ng-click="ImportCheckingData()" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="GetCheckingSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File Download</button></li>
                        </ul>
                    </div>
                </div>
            </div>

            
        </div>

        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
            <div class="form-elements form-horizontal row" ng-form name="ModelNewApprovingForm">
                <div class="col-md-10">
                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-4 ">
                            <input id="uploadImageApr" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                        </label>
                        <input type="button" value="Import Data" class="btn btn-success" ng-click="ImportApprovingData()" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="GetApprovingSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File Download</button></li>
                        </ul>
                    </div>
                </div>
            </div>

            
        </div>
    </div>

</div>