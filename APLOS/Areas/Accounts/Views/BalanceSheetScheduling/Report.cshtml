<div class="form-elements form-horizontal" ng-form="from0">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Date" ng-model="FromDate" datepicker class="form-control" required tabindex="3">
                </div>
            </div>
            <div class="form-group">
                <div class="col-lg-12">
                    <div class="col-md-2 text-right">
                        <ul>
                            <li><button type="button" class="btn single-btn" ng-click="ReportDownload()" style="margin-top:10px;"><i class="glyphicon glyphicon-arrow-down"></i>Report</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Date" ng-model="ToDate" datepicker class="form-control" required tabindex="4">
                </div>
            </div>
            
        </div>

    </div>
</div>