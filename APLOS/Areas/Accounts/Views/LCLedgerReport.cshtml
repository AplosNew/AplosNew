<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> LC Ledger</h3>
<div class="form-elements form-horizontal" ng-form="from0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors id="div_LCRef">
            <label class="col-sm-3 control-label">LC No<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="LCRef" ng-model="report.LCRef" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="getPurchaseLCData();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors id="div_FromDate">
            <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="Form Date" ng-model="report.FromDate" datepicker tabindex="2" class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors id="div_ToDate">
            <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-9  show-message">
                <input type="text" name="To Date" ng-model="report.ToDate" datepicker tabindex="3" class="form-control">
            </div>
        </div>
        
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Format<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                </label>
                <label>
                    <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                </label>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
        </ul>
    </div>
</div>
<div class="modal fade site-modal in" id="PurchaseLCPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Purchase LC <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div style="color:black;" id="GridPurchaseLC" ej-grid e-datasource="purchaseLCList" e-recorddoubleclick="SetDetails"
                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="20" e-visible="false"></div>
                        <div e-column e-type="string" e-field="LCRef" e-headertext="LC No" e-width="80"></div>
                        <div e-column e-type="string" e-field="Version" e-headertext="Last Version" e-width="20"></div>
                        <div e-column e-field="LCDate" e-headertext="Opening Date" e-format="{0:dd-MMM-yyyy}" e-type="date" e-width="40"></div>
                        <div e-column e-type="number" e-field="Amount" e-headertext="Opening Value" e-width="60" e-textalign="right"></div>
                        <div e-column e-field="AmendmentDate" e-headertext="Amendment Date" e-format="{0:dd-MMM-yyyy}" e-type="date" e-width="40"></div>
                        <div e-column e-type="number" e-field="AmendmentAmount" e-headertext="Amendment Value" e-width="40" e-textalign="right"></div>
                        <div e-column e-type="string" e-field="Currency" e-headertext="Currency" e-width="30"></div>
                        <div e-column e-type="string" e-field="PartyName" e-headertext="Vendor" e-width="60"></div>
                        <div e-column e-type="string" e-field="OpeningBank" e-headertext="Opening Bank" e-width="60"></div>
                        <div e-column e-type="string" e-field="ContractNo" e-headertext="Contract No" e-width="50"></div>
                        <div e-column e-type="string" e-field="CustomerName" e-headertext="Customer" e-width="60"></div>
                        <div e-column e-type="string" e-field="MasterLCNo" e-headertext="MasterLCNo" e-width="50"></div>
                        <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="50"></div>
                        <div e-column e-type="string" e-field="ContractRemarks" e-headertext="Contract Remarks" e-width="40"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>