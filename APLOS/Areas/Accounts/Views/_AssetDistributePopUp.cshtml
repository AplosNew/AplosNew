<div class="modal fade site-modal in" id="AssetDistributePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="assetDistributeForm">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeAssetDistributePopUp()">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Asset Distribute</h4>
            </div>
            <div class="modal-body">
                <div class="col-xs-12 col-sm-12 col-md-12" style="padding: 10px;">
                    <div class="site-tab">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Update" role="tab" data-toggle="tab2">Machine Master Asset</a></li>
                        </ul>
                    </div>
                </div>
                <div class="tab-content">
                    <div  role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                        <div class="col-xs-12 col-sm-12 col-md-12" style="padding-left:0px">
                            <div class="col-xs-12 col-sm-1 col-md-1">
                                <button ng-click="showMachineMasterAssetPopUp();" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> Select Asset </button>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Machine Master Asset Id</th>
                                            <th>Machine Master Id</th>
                                            <th>Machine Master</th>
                                            <th>Asset Name</th>
                                            <th>Total Distributed Amount</th>
                                            <th class="col-sm-1">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in checkedMachineMasterAssetList">
                                            <td>{{x.MachineMasterAssetId}}</td>
                                            <td>{{x.MachineMasterId}}</td>
                                            <td>{{x.MachineMaster}}</td>
                                            <td>{{x.AssetName}}</td>
                                            <td>
                                                <input ng-keyup="checkDistributedAmount($index,x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="DistributedAmount" autocomplete="off" ng-model="x.DistributedAmount">
                                            </td>
                                            <td class="text-right">
                                                <ul class="list-inline action-list">
                                                    <li><button ng-click="DeleteMachineMasterAssetConfirmation(x.MachineMasterAssetId)" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                                </ul>
                                            </td>

                                        </tr>
                                        <tr>
                                            <td colspan="4" class="text-right"><strong>Total : </strong></td>
                                            <td class="text-right"><strong>{{checkedMachineMasterAssetList | sumByKey : 'DistributedAmount'|  number:2 }}</strong></td>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    
                    
                    
                </div>
                
            </div>
                    <div class="modal-footer  common-btn">
                        <button type="button" class="btn btn-default" ng-click="closeAssetDistributePopUp()">Done</button>
                    </div>
                </div>
            </div>
</div>

