<div class="modal fade site-modal in" id="partyfiscalInvoiceAmountPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Total Invoice Amount</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Voucher</th>
                                <th>Vendor</th>
                                <th>Invoicing Vendor</th>
                                <th>PostingDate</th>
                                <th>DocRefNo</th>
                                <th>Curency</th>
                                <th>Amount</th>
                                <th>SetOff</th>
                                <th>Balance</th>
                                <th>Books Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in fiscalinvoiceAmountByParty">
                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.PartyName}}</td>
                                <td>{{x.PartyPlantName}}</td>
                                <td>{{x.PostingDate}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td class="text-right">{{x.Amount| number:2}}</td>
                                <td class="text-right">{{x.WrittenOffAmount| number:2}}</td>
                                <td class="text-right">{{x.Balance| number:2}}</td>
                                <td class="text-right">{{x.BooksInvoiceAmount| number:2}}</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td></td>
                                <td>Total</td>
                                <td class="text-right"><b>{{ (fiscalinvoiceAmountByParty) | sumByKey:'BooksInvoiceAmount' }}</b></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeFiscalInvoiceTotalAmountByParty();">Close</button>
            </div>
        </div>
    </div>
</div>