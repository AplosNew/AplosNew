<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Employee<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="EmployeeName" ng-model="voucher.EmployeeName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearPartyPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(advance.VoucherTypeId)" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <textarea rows="3" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">

        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="getFiscalYearPeriod(voucher.PostingDate);checkPostingDate();getTaxCodeByTaxYear(voucher.PostingDate);" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="getFiscalYearPeriod(voucher.DocDate);checkDocDate();" id="docDate" type="text" name="DocDate" ng-model="voucher.DocDate" class="form-control" tabindex="1">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="5" name="CurrencyTransaction" ng-model="voucher.CurrencyId" required ng-change="GetCurrencyExchangeRateList();">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" n-decimals="4" id="Rate" name="Rate" ng-disabled="voucher.CurrencyId==companyCurrencyId" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="20" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-5 col-md-5 " ng-show="voucher.EmployeeId!==null">
        <div id="div_TransactionType" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Select Transaction Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Transaction Type" class="form-control"
                            ng-model="voucher.EmployeeTransactionTypeId" ng-change="expensesBookingTransaction(voucher.EmployeeTransactionTypeId)" tabindex="1" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in employeeTransactionTypeList" value="{{option.EmployeeTransactionTypeId}}">{{option.EmployeeTransactionTypeName}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Select GL<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <ul class="list-inline">
                    <li><button class="btn single-btn" ng-click="popUp()" tabindex=""><i class="glyphicon glyphicon-plus"></i> GL</button></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-4 col-md-4 " ng-show="voucher.EmployeeId!==null">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Select Tax<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Tax Type" class="form-control"
                            ng-model="voucher.TaxCodeId" ng-change="changeTaxCode(voucher.TaxCodeId)" tabindex="1" >
                        <option value="">--Select--</option>
                        <option ng-repeat="option in taxCodCboList" value="{{option.Id}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3 " ng-show="voucher.EmployeeId!==null">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Select Advance<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <ul class="list-inline">
                    <li><button class="btn single-btn" ng-click="showEmployeeAdvancePopUpList()" tabindex=""><i class="glyphicon glyphicon-plus"></i> Advance</button></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>

    <div class="row form-elements">
        <div class="col-xs-12 col-sm-12 col-md-12 modal-table" ng-show="voucher.EmployeeId!==null">
            <table class="table table-responsive table-striped">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>Dr Amount</th>
                        <th>Cr Amount</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in voucherDetailList">
                        <td>{{x.PartyType}}</td>
                        <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td id="td_Amount">
                            <div class="show-message">
                                <input type="text" n-decimals="2" class="form-control text-right" ng-disabled="x.DrDisable" ng-change="checkDrAmount($index)" autocomplete="off" ng-model="x.DrAmount">
                            </div>
                        </td>
                        <td id="td_CAmount">
                            <div class="show-message">
                                <input type="text" n-decimals="2" class="form-control text-right" ng-disabled="x.CrDisable" ng-change="checkCrAmount($index)" autocomplete="off" ng-model="x.CrAmount">
                            </div>
                        </td>
                        <td class="text-right">
                            <button ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" ng-disabled="x.VoucherId" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                        </td>
                    </tr>
                </tbody>
                <tfoot ng-show="voucherDetailList.length">
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td><b>Sub Total</b></td>
                        <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'DrAmount' }}</b></td>
                        <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'CrAmount' }}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" ng-disabled="voucher.VoucherId" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table ">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>Employee</th>
                    <th>Invoice Number</th>
                    <th>Invoice Date</th>
                    <th>Posting Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in employeePayables |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.EmployeeCode}}-{{x.EmployeeName}} </td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.DocDate | dateFiltering}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Employees/EmployeeReport/GetEmployeeSalaryPayableReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Employees/EmployeeReport/GetEmployeeSalaryPayableReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(payableId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(payableId,voucherId)"></confirm-archive-generic>

@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_GLBudgetActivityPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_EmployeeAdvancePopUp.cshtml")
