<togglable name="Voucher GL Update"></togglable>
<div class=" form-horizontal" ng-form="form0">
    <div class="form-elements">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher No.</label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-maxlength="100" name="Voucher Type" ng-model="voucher.Id" class="form-control" disabled capitalize autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Type</label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-maxlength="100" name="Voucher Type" ng-model="voucher.VoucherType" class="form-control" disabled capitalize autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Currency</label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Currency" ng-model="voucher.CurrencyCode" class="form-control" disabled capitalize autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div id="div_DocDate" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Date</label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Doc Date" ng-model="voucher.DocDate" disabled class="form-control">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entry Date</label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Entry Date" ng-model="voucher.VoucherDate" class="form-control" disabled capitalize autocomplete="off">
                </div>
            </div>
            <div id="div_PostingDate" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Posting Date</label>
                <div class="col-sm-8 show-message">
                    <input id="postingDate" type="text" name="Posting Date" disabled ng-model="voucher.PostingDate" class="form-control">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-3 control-label">Doc Ref</label>
                <div class="col-sm-9 show-message">
                    <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" disabled class="form-control" capitalize autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-3 control-label">Entity</label>
                <div class="col-sm-9 show-message">
                    <input type="text" name="Entity" ng-model="voucher.Entity" class="form-control" disabled capitalize autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-3 control-label">Narration</label>
                <div class="col-sm-9 show-message">
                    <input type="text" name="Narration" ng-model="voucher.Narration" class="form-control" disabled capitalize autocomplete="off">
                </div>
            </div>
        </div>
        @*<div class="col-xs-12 col-sm-8 col-md-8">
                <div class="form-group" show-errors>
                    <label class="col-sm-2 control-label">Narration</label>
                    <div class="col-sm-10 show-message">
                        <textarea rows="1" type="text" name="Narration" class="form-control" ng-model="voucher.Narration" disabled capitalize></textarea>
                    </div>
                </div>
            </div>*@
        <div class="clearfix"></div>
        @*<ul class="list-inline">
                <li><button class="btn single-btn" ng-disabled="glDisabled" ng-click="GetCOAICodeList()" tabindex=""><i class="glyphicon glyphicon-plus"></i> Select GL</button></li>
            </ul>*@
        <div class="clearfix"></div>
        <div class="table-responsive modal-table ">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>GL </th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>Entity</th>
                        <th class="text-center">Dr</th>
                        <th class="text-center">Cr</th>
                        <th class="text-right"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in voucherDetailList">
                        <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td>{{x.Entity}}</td>
                        <td>{{x.DrAmount}}</td>
                        <td>{{x.CrAmount}}</td>
                        @*<td><input type="text" class="form-control text-right" id="vdDrAmount" ng-model="x.DrAmount " n-decimals="2" tabindex="11" ng-change="checkDrAmount($index)" autocomplete="off"></td>
                            <td><input type="text" class="form-control text-right" id="vdCrAmount" ng-model="x.CrAmount " n-decimals="2" tabindex="12" ng-change="checkCrAmount($index)" autocomplete="off"></td>*@
                        <td class="text-right">
                            <button ng-click="popUpGL($index)" data-toggle="modal" ng-disabled="x.CrAmount>0" class="btn btn-action tooltip-here" data-placement="top" title="popUp">
                                <i class="glyphicon glyphicon-info-sign"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td></td>
                        <td colspan="3" class="text-right">Total</td>
                        <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'DrAmount' }}</b></td>
                        <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'CrAmount' }}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                @*<li ng-hide="voucher.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>*@
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>




    <div class="aplos-grid-toggle">

        <div class="row">
            <div class="col-md-12 col-sm-4 col-md-4">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Voucher No<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.VoucherNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-md-12 col-sm-2 col-md-2">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="getVoucherData();" ng-enter="getVoucherData();" title="Date Range Wise values Change" class="btn"><i class="glyphicon glyphicon-refresh"></i>Go</button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>VoucherNo</th>
                        <th>Posting Date</th>
                        <th>Doc Ref No</th>
                        <th>Doc Date</th>
                        <th>Source Type</th>
                        <th>Capitalize</th>
                        <th>Currency</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr dir-paginate="x in VoucherDataList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                        <td>{{x.VoucherNo}}</td>
                        <td>{{x.PostingDate | dateFiltering}}</td>
                        <td>{{x.DocRefNo}}</td>
                        <td>{{x.DocDate | dateFiltering}}</td>
                        <td>{{x.SourceType}}</td>
                        <td>{{x.Capitalize}}</td>
                        <td>{{x.CurrencyCode}}</td>
                        <td class="text-right">{{x.DrAmount | number:2}}</td>
                        <td>{{x.IsPark?'Parked':'Posted'}}</td>
                        <td class="text-right">
                            <ul class="list-inline action-list">
                                <li><a class="btn btn-action" ng-click="VendorInvoiceReport('Pdf',x.Id,x.SourceType,x.InventoryIssueId,x.InventoryReceiveId)"><i class="fa fa-file-pdf-o"></i></a></li>
                                <li><a class="btn btn-action" ng-click="VendorInvoiceReport('Excel',x.Id,x.SourceType,x.InventoryIssueId,x.InventoryReceiveId)"><i class="fa fa-file-excel-o"></i></a></li>
                            </ul>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/_GLBudgetActivityPopUp.cshtml")
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="park(voucherId,sourceType)"></confirm-archive-generic>



















