
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Customer Confirmation</h3>
<div class="form-elements form-horizontal" ng-form="from0">
    <div class="row">
        <div class="col-md-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors id="div_FromDate">
                <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <input type="text" name="Form Date" ng-model="report.FromDate" datepicker tabindex="2" class="form-control">
                </div>
            </div>
            <div class="form-group" show-errors id="div_ToDate">
                <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-9  show-message">
                    <input type="text" name="To Date" ng-model="report.ToDate" datepicker tabindex="3" class="form-control">
                </div>
            </div>

        </div>
        <div class="col-md-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-3 control-label">Payment Status</label>
                <div class="col-sm-9">
                    <div class="select-style">
                        <select name="PaymentStatus" class="form-control" ng-model="report.PaymentStatus">
                            <option value="">--ALL--</option>
                            <option ng-repeat="option in paymentStatusList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-2 col-md-2">
                <button class="btn single-btn" ng-click="getPopupCustomerList()" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Select Customer</button>
            </div>
            @*<div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="getVoucherData();" ng-enter="getVoucherData();" title="Search" class="btn"><i class="glyphicon glyphicon-refresh"></i>Go</button></li>
                    </ul>
                </div>*@
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="col-md-12">
            <div style="color:black;" id="GridCustomerInvoiceList"
                 ej-grid e-datasource="customerInvoiceList"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-gridlines="vertical" e-allowscrolling="true"
                 e-filtersettings-filterType="excel"
                 e-enabletouch="false"
                 e-allowresizing="true"
                 e-allowselection="false"
                 e-allowsorting="true">
                <div e-columns>
                    <div e-column e-headertext="Select" e-template="#checkcustomerInvoice" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="50" e-textalign="center"></div>
                    <div e-column e-field="PostingDate" e-headertext="Posting Date" e-width="50" e-textalign="center"></div>
                    <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="40" e-textalign="center"></div>
                    <div e-column e-field="PartyCode" e-headertext="Party Code" e-width="40" e-textalign="center"></div>
                    <div e-column e-field="PartyName" e-headertext="Party Name" e-width="80" e-textalign="center"></div>
                    <div e-column e-type="numeric" e-format="{0:0.00}" e-field="GrossSales" e-headertext="Receivable" e-width="50" e-textalign="right" style="height: 20px;"></div>
                    <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Receipts" e-headertext="Set-off" e-width="30" e-textalign="right" style="height: 20px;"></div>
                    <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Balance" e-headertext="Balance" e-width="50" e-textalign="right" style="height: 20px;"></div>
                    <div e-column e-headertext="Expected Payment Received Date" e-template="#customerConfimationDate" e-width="50" e-textalign="center"></div>
                    <div e-column e-headertext="Buyer Ref No" e-template="#buyerRefNo" e-width="50" e-textalign="center"></div>
                    <div e-column e-headertext="Customer Remarks" e-template="#customerRemarks" e-width="50" e-textalign="center"></div>
                    <div e-column e-headertext="Bank RefNo" e-template="#bankRefNo" e-width="50" e-textalign="center"></div>
                    <div e-column e-headertext="Bank Master Name" e-template="#bankName" e-width="100" e-textalign="center"></div>

                </div>
            </div>
            <script type="text/template" id="customerConfimationDate">
                <input type="text" ng-model="data.ExpectedPaymentReceivedDate" datepicker class="form-control">
            </script>
            <script type="text/template" id="buyerRefNo">
                <input type="text" ng-model="data.BuyerRefNo" class="form-control">
            </script>
            <script type="text/template" id="customerRemarks">
                <input type="text" ng-model="data.CustomerRemarks" class="form-control">
            </script>
            <script type="text/template" id="checkcustomerInvoice">
                <input type="checkbox" ng-model="data.Flag" ng-checked="data.Flag" ng-click="$parent.pushInTempListforConfirm($event,data);">
            </script>
            <script type="text/template" id="bankRefNo">
                <input type="text" ng-model="data.BankRefNo" class="form-control">
            </script>
            <script type="text/template" id="bankName">
                <div class="input-group" tabindex="208">
                    <input type="text" name="Shift" ng-model="data.BankMasterName" ng-disabled="true" class="form-control" maxlength="200" required readonly>
                    <span class="input-group-btn">
                        <button ng-click="$parent.showBankPopUp(null,this)" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </script>
            <br />
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Update </button></li>
                </ul>
            </div>
        </div>


    </div>
</div>

@Html.Partial("~/Areas/Accounts/Views/_MultipleCustomerInvoicePopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")





















