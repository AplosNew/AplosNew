<togglable name="Security Given Write-off"></togglable>
<div class="form-elements" ng-form id="form1" name="form1">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Transaction Data</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Parallel Currency</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form name="tabForm1">
                <div class="row">
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-5 control-label">Voucher Date<sup>*</sup></label>
                            <div class="col-sm-7 show-message">
                                <input type="text" name="VoucherDate" ng-model="advance.VoucherDate" datepicker class="form-control datepicker" tabindex="1" ng-change="checkVoucherDate()" disabled required>
                                <p ng-show="VoucherDateMessage" class="show-message">{{VoucherDateMessage}}</p>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-5 control-label">Voucher Type<sup>*</sup></label>
                            <div class="col-sm-7 show-message">
                                <div class="select-style">
                                    <select ng-disabled="true" id="vouchertypeId" class="form-control" name="vouchertype" ng-model="advance.VoucherTypeId" tabindex="4" ng-change="onVoucherTypeChange(advance.VoucherTypeId);getVoucherTypeValueText()" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-5 control-label">Transaction Currency<sup>*</sup></label>
                            <div class="col-sm-7">
                                <div class="select-style">
                                    <select ng-disabled="voucherDetailList.length" id="currencyTransactionId" class="form-control" tabindex="6" name="CurrencyTransaction" ng-model="advance.CurrencyId">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="DocDate" ng-model="advance.DocDate" datepicker class="form-control datepicker" tabindex="2" ng-change="checkDate();" required>
                                <p ng-show="dateMessage" class="show-message">{{dateMessage}}</p>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="50" name="DocRefNo" ng-model="advance.DocRefNo" class="form-control" tabindex="5" required>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-5 col-md-5 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Posting Date<sup>*</sup></label>
                            <div class="col-sm-9">
                                <input id="postingDate" type="text" name="PostingDate" ng-model="advance.PostingDate" datepicker class="form-control datepicker" tabindex="3">
                                <p ng-show="postingDateMessage" class="show-message">{{postingDateMessage}}</p>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Fiscal Year</label>
                            <div class="col-sm-4">
                                <input id="fiscalYearId" type="text" name="Fiscal Year" readonly ng-model="advance.FiscalYearName" class="form-control">
                                <input type="hidden" name="Period" readonly ng-model="advance.FiscalYearId" class="form-control">
                            </div>
                            <label class="col-sm-2 control-label">Period</label>
                            <div class="col-sm-3">
                                <input id="fiscalYearPeriod" type="text" name="Period" readonly ng-model="advance.FiscalYearPeriodName" class="form-control">
                                <input type="hidden" name="Period" readonly ng-model="advance.FiscalYearPeriodId" class="form-control">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-3 control-label">Narration<sup>*</sup></label>
                            <div class="col-sm-9 show-message">
                                <textarea type="text" name="Narration" class="form-control" ng-model="advance.Narration" tabindex="7" required capitalize></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <fieldset class="scheduler-border">
                            <legend class="scheduler-border">Party Information</legend>
                            <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Party</label>
                                    <div class="col-sm-7 pdr3">
                                        <input type="hidden" ng-model="advance.PartyId">
                                        <input type="text" name="Code" ng-model="advance.PartyName" class="form-control" readonly>
                                    </div>
                                    <button ng-disabled="advance.CurrencyId ==null || voucherDetailList.length" class="single-btn tooltip-here" data-placement="top" title="Select Customer" ng-click="getCustomerGL();" tabindex="8"><i class="fa fa-search"></i></button>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Party GL</label>
                                    <div class="col-sm-7 pdr3">
                                        <input type="hidden" name="Code" ng-model="advance.PartyGLGeneralInfoId" class="form-control" readonly>
                                        <input type="text" name="Code" ng-model="advance.PartyGL" class="form-control" readonly>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <div class="form-group">
                            <div class="col-sm-6">
                                <button class="btn single-btn" ng-disabled="advance.PartyId==null" ng-click="customerInvoicePopUp(advance.PartyId)">Select Customer Invoice</button>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-6">
                                <button class="btn single-btn" ng-disabled="voucherDetailList.length==0" ng-click="customerAdvancePopUp(advance.PartyId)">Select Customer Advance</button>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive modal-table col-xs-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>GL</th>
                                    <th>VoucherNo</th>
                                    <th>Doc Date</th>
                                    <th>Doc Ref</th>
                                    <th>Narration</th>
                                    <th>Amount</th>
                                    <th>Write-off</th>
                                    <th>Available</th>
                                    <th>Dr</th>
                                    <th>Cr</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in voucherDetailList">
                                    <td>{{x.GL}}</td>
                                    <td>{{x.VoucherNo}}</td>
                                    <td>{{x.DocDate | dateFiltering}}</td>
                                    <td>{{x.DocRefNo}}</td>
                                    <td>{{x.Narration}}</td>
                                    <td class="text-right">{{x.Amount | number:2}}</td>
                                    <td class="text-right">{{x.WriteOff | number:2}}</td>
                                    <td class="text-right">{{x.Advilable | number:2}}</td>
                                    <td><input type="number" class="form-control" ng-model="x.DrAmount" ng-keyup="setDrExchangeRate(x.GLGeneralInfoId, x.GL, x.DrAmount)"></td>
                                    <td><input type="number" class="form-control" ng-model="x.CrAmount" ng-keyup="setCrExchangeRate(x.AdvanceId, x.CrAmount)"></td>
                                    <td>
                                        <button ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                            <i class="glyphicon glyphicon-remove"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot ng-show="voucherDetailList.length">
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td><b>Sub Total</b></td>
                                    <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'DrAmount'  }}</b></td>
                                    <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'CrAmount'  }}</b></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form name="tabForm2">
                <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table">
                    <table class="table table-striped">
                        <thead compile="parallelCurrencyTableHead">
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in voucherDetailCurrencyList">
                                <td>{{x.GL}}</td>
                                <td ng-repeat="y in parallelCurrencyTypeList"><input type="text" ng-disabled="x[y.CurrencyType]==null" class="form-control text-right" ng-model="x[y.CurrencyType]" /></td>
                            </tr>
                        </tbody>
                        <tfoot ng-show="voucherDetailCurrencyList.length">
                            <tr>
                                <td><b>Sub Total</b></td>
                                <td class="text-right" ng-repeat="y in parallelCurrencyTypeList"><b>{{ voucherDetailCurrencyList | sumByKey : y.CurrencyType  }}</b></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 form-horizontal">
                    <div class="form-group">
                        <div class="col-sm-6">
                        </div>
                        <div class="col-sm-6">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li>
                                        <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button>
                                    </li>
                                    <li>
                                        <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchVendorInvoiceList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Party</th>
                <th>Posting Date</th>
                <th>Voucher Date</th>
                <th>Doc Date</th>
                <th>Doc Ref</th>
                <th>Currency</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in advanceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.CustomerInvoiceId, $index);">
                <td>{{x.PartyName}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.VoucherDate | dateFiltering}}</td>
                <td>{{x.DocDate | dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.CurrencyCode}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerVendorPopUp.cshtml")
<toaster-container toaster-options="{'close-button':true, 'animation-class': 'toast-top-center'}"></toaster-container>
<confirm-modal></confirm-modal>