<togglable name="{{title}}"></togglable>
<div class="form-horizontal form-elements" ng-form="form0">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-3 control-label">@Library.Model.Parties.PartyType.Customer.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="PartyName" ng-model="voucher.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Ordering @Library.Model.Parties.PartyType.Customer.ToString() ({{partyPlantList.length}})<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="1" class="form-control" name="Ordering Party" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(advance.PartyPlantId,'billTo'); updateCrAmount();" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(advance.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Transaction</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Journal</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form name="tabForm1">
                <div class="row">
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        @*<div id="div_entity" class="form-group">
                            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select ng-change="entityChange(voucher.EntityId)" id="entityId" class="form-control" name="entity" ng-model="voucher.EntityId" tabindex="7">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>*@
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Source<sup>*</sup></label>
                            <div class="col-sm-8 radio">
                                <label>
                                    <input ng-click="clearBankPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Parties.PartyType.Bank.ToString()">
                                    <span class="cr" tabindex="10"><i class="cr-icon"></i></span>@Library.Model.Parties.PartyType.Bank.ToString()
                                </label>
                                <label>
                                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Parties.PartyType.Cash.ToString()">
                                    <span class="cr" tabindex="10"><i class="cr-icon"></i></span>@Library.Model.Parties.PartyType.Cash.ToString()
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div id="div_PostingDate" class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input required datepicker="checkPostingDate();checkDocDate();" ng-disabled="voucherDetailList.length" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="50" id="Doc Ref" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required autocomplete="off" capitalize>
                            </div>
                        </div>
                        <div class="form-group" id="div_qty">
                            <label class="col-sm-4 control-label">Net Amount<sup>*</sup></label>
                            <div class="col-sm-5 show-message" style="padding-right:0px;">
                                <input tabindex="8" ng-model="voucher.Amount" type="text" n-decimals="2" class="form-control text-right">
                            </div>
                            <div class="col-sm-3 show-message" style="padding-left:0px;">
                                <div class="select-style">
                                    <select id="currencyTransactionId" class="form-control" tabindex="12" name="CurrencyTransaction" ng-model="voucher.CurrencyId">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
                            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="CashName" ng-model="voucher.BankName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="showBankPopUp(voucher.EntityId);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
                            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="CashName" ng-model="voucher.CashName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="showCashPopUp(null, voucher.EntityId);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="isBankAmount">
                            <label class="col-sm-3 control-label">Bank Amount<sup>*</sup></label>
                            <div class="col-sm-7 pdr3">
                                <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="voucher.BankAmount">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div id="div_DocDate" class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkPostingDate();checkDocDate();" required class="form-control" tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Received Amount <sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="6" ng-disabled="true" ng-model="voucher.InvoiceAmount" type="text" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Ex. Gain/Loss <sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="8" ng-disabled="true" ng-model="voucher.ExGainLossAmount" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-8 col-md-8 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
                            <div class="col-sm-10 show-message">
                                <textarea rows="1" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li ng-disabled="voucher.PartyId==null&&voucher.PartyPlantId==null"><button ng-click="getPopupCustomerReceivableList(advance.PartyId, advance.PartyPlantId);" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Invoice</button></li>
                                <li>
                                    <button ng-click="getDeductionPopUp($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Tax"><i>Charges</i></button>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal">
                        <div class="table-responsive modal-table" ng-show="voucherDetailList.length">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>GL</th>
                                        <th>Voucher No</th>
                                        <th>DocDate</th>
                                        <th>Doc Ref No</th>
                                        <th>Currency</th>
                                        <th>Receivable</th>
                                        <th>Received</th>
                                        <th>Balance</th>
                                        <th>Amount</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in voucherDetailList">
                                        <td>{{x.GLGeneralInfoName}}</td>
                                        <td>{{x.VoucherNo}}</td>
                                        <td>{{x.DocDate |dateFiltering}}</td>
                                        <td>{{x.DocRefNo}}</td>
                                        <td>{{x.CurrencyCode}}</td>
                                        <td>{{x.Receivable}}</td>
                                        <td>{{x.Received}}</td>
                                        <td>{{x.Balance}}</td>
                                        <td>
                                            <input ng-keyup="convertAmount(x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="x.Amount">
                                        </td>
                                        <td class="text-right">
                                            <button ng-click="removeRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form name="tabForm2">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <fieldset class="scheduler-border" ng-show="currencyExchangeRate.length">
                            <legend class="scheduler-border">Currency Exchange Rate</legend>
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Unit</th>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>Rate</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in currencyExchangeRate" ng-hide="x.ParallelCurrencyId === x.FromCurrencyId && x.ParallelCurrencyId=== x.ToCurrencyId ">
                                            <td>{{x.FromCurrencyUnit}}</td>
                                            <td>{{x.FromCurrencyCode}}</td>
                                            <td>{{x.ToCurrencyCode}}</td>
                                            <td>
                                                <input n-decimals="4" type="text" class="form-control text-right" ng-model="x.ToCurrencyRate" ng-keyup="changeCurrencyExchangeRate();" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </fieldset>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 modal-table">
                        <table class="table table-responsive table-striped">
                            <thead compile="parallelCurrencyTableHead">
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in voucherDetailCurrencyList track by $index">
                                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget">{{x.BudgetName}}</td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget">{{x.ActivityName}}</td>
                                    <td ng-repeat="y in parallelCurrencyTypeList"><input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-disabled="x[y.CurrencyType]==null" ng-model="x[y.CurrencyType]" /></td>
                                </tr>
                            </tbody>
                            <tfoot ng-show="voucherDetailCurrencyList.length">
                                <tr>
                                    <td><b>Sub Total</b></td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                    <td class="text-right" ng-repeat="y in parallelCurrencyTypeList"><b>{{ voucherDetailCurrencyList | sumByKey : y.CurrencyType  }}</b></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right ">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#No</th>
                    <th>Ordering @Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Posting Date</th>
                    <th>Doc Date</th>
                    <th>Doc Ref</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.InvoiceWriteOffNo}}</td>
                    <td>{{x.PartyPlantName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.DocDate | dateFiltering}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td>{{x.Amount}}</td>
                    <td class="text-right">
                        <button ng-click="report(x.VoucherId)" class="btn btn-action"><i class="glyphicon glyphicon-cloud-download"></i>Download</button>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_CashPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_CustomerInvoicePopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_CustomerAdvancePopUp.cshtml")
<toaster-container toaster-options="{'close-button':true, 'animation-class': 'toast-top-center'}"></toaster-container>
<div class="modal fade site-modal in" id="TotaladvancePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:400px">
        <div class="modal-content" ng-form name="AdvanceForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <label class=" control-label" ng-dblclick="closeTotaladvancePopUp()">Total Advance Amount is {{TotalAdvance}} {{companyCurrencyCode}}</label>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeTotaladvancePopUp()">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="deductionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:600px">
        <div class="modal-content" ng-form name="DeductionForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-elements form-horizontal">
                    <div class="col-xs-12 col-sm-5 col-md-5 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Deduction</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select ng-model="deductionOb.FinancingTypeId" id="deductioncbo">
                                        <option>--Select--</option>
                                        <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.ExpensesUserName}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-5 col-md-5 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Amount</label>
                            <div class="col-sm-8 show-message">
                                <input required id="amount" n-decimals="2" type="text" name="amount" ng-model="deductionOb.Amount" class="form-control">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-1 col-md-1 form-horizontal">
                        <div class="common-btn">
                            <button type="button" class="btn btn-default" ng-click="addDeduction()"><i class="glyphicon glyphicon-plus">Add</i></button>
                        </div>
                    </div>
                </div>
                <div class="clearfix">
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Deduction</th>
                                <th>Amount</th>
                                <th>Remove</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in deductionList ">
                                <td>{{x.Deduction}}</td>
                                <td>{{x.Amount}}</td>
                                <td>
                                    <button ng-click="removeRowModal($index)" class="btn-action single-small-btn tooltip-here" data-placement="right" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeDeducitonPopUp()">Close</button>
            </div>
        </div>
    </div>
</div>