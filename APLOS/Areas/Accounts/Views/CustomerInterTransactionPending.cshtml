<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> InterTransaction Pending List</h3>
<div class="form-group">
    <label class="col-sm-2 control-label">Transaction<sup>*</sup></label>
    <div class="col-sm-4 radio">
        <label>
            <input ng-click="getInterTransactionList('@Library.Model.Enums.SourceType.CustomerAdvance.ToString()')" type="radio" name="source" ng-model="sourceType" value="@Library.Model.Enums.SourceType.CustomerAdvance.ToString()">
            <span class="cr" tabindex="17"><i class="cr-icon"></i></span>Advance
        </label>
        <label>
            <input ng-click="getInterTransactionList('@Library.Model.Enums.SourceType.CustomerSuspense.ToString()')" type="radio" name="source" ng-model="sourceType" value="@Library.Model.Enums.SourceType.CustomerSuspense.ToString()">
            <span class="cr" tabindex="18"><i class="cr-icon"></i></span>Suspense
        </label>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#No</th>
                    <th>@Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Ordering @Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Posting Date</th>
                    <th>Doc Date</th>
                    <th>Doc Ref</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.AdvanceNo}}</td>
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>{{x.PartyPlantName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.DocDate | dateFiltering}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Receivable | number:2}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="sourceType=='@Library.Model.Enums.SourceType.CustomerAdvance.ToString()'"><a href="{{bootPoint}}customer-advance/{{x.AdvanceId}}" class="btn btn-action">Continue</a></li>
                            <li ng-show="sourceType=='@Library.Model.Enums.SourceType.CustomerSuspense.ToString()'"><a href="{{bootPoint}}customer-suspense/{{x.AdvanceId}}" class="btn btn-action">Continue</a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
