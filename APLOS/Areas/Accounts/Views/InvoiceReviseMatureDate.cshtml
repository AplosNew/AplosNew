<togglable name=" {{FormTitle}}"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-2">
        <div class="form-group">
            <label class="col-sm-3 control-label">Party Type<sup>*</sup></label>
            <div class="col-sm-9">
                <div class="select-style">
                    <select id="PaymentModeId" class="form-control" name="Payment Mode" ng-model="invoice.PartyType" tabindex="5">
                        <option value="">--Select--</option>
                        <option value="Customer">Customer</option>
                        <option value="Vendor">Vendor</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-2">
        <div class="form-group" id="div_FromDate">
            <label class="col-sm-4 control-label">From Date<sup></sup></label>
            <div class="col-sm-8">
                <input type="text" name="Form Date" ng-model="invoice.FromDate" datepicker tabindex="2" class="form-control">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-2">
        <div class="form-group" id="div_ToDate">
            <label class="col-sm-4 control-label">To Date<sup></sup></label>
            <div class="col-sm-8">
                <input type="text" name="To Date" ng-model="invoice.ToDate" datepicker tabindex="3" class="form-control">
            </div>
        </div>
    </div>
    <div class="col-xs-1 col-sm-1 col-md-1" style="left:-50px;">
        <div class="form-group">
            <div class="common-btn">
                <button ng-click="GetInvoiceData();" class="btn"> <i class="glyphicon glyphicon-download"></i> Go</button>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-2">
        <div class="form-group" id="div_ToDate">
            <label class="col-sm-4 control-label">Updated Revise Date<sup></sup></label>
            <div class="col-sm-8">
                <input type="text" name="UpdatedReviseDate" ng-model="invoice.UpdatedReviseDate" datepicker tabindex="3" class="form-control">
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div class="container-fluid" style="color:black;">
            <div style="color:black;" id="InvoiceGrid" ej-grid e-datasource="InvoiceDataList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true"  e-templaterefresh="refreshTemplateInvoiceList"
                 e-gridlines="vertical" e-allowresizing="true"
                 e-filtersettings-filterType="excel"
                 e-enabletouch="true">
                <div e-columns>
                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DocRefNo" e-headertext="DocRefNo" e-allowediting="false" e-width="60"></div>
                    <div e-column e-field="PostingDate" e-headertext="PostingDate" e-allowediting="false" e-width="60"></div>
                    <div e-column e-field="DocDate" e-headertext="DocDate" e-allowediting="false" e-width="60"></div>
                    <div e-column e-field="EntityName" e-headertext="EntityName" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="PartyPlantName" e-headertext="Party Name" e-allowediting="false" e-width="120"></div>
                    <div e-column e-field="BaseOnDueDate" e-headertext="BaseOnDueDate" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="BaseNoOfDays" e-headertext="BaseNoOfDays" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="ActualDueDate" e-headertext="ActualDueDate" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="RevisedDueDate" e-headertext="RevisedDueDate" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DelayDays" e-headertext="Delay Days" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SourceType" e-headertext="SourceType" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="CurrencyCode" e-headertext="CurrencyCode" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="InvoiceAmount" e-headertext="InvoiceAmount" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="WrittenOffAmount" e-headertext="SetOff" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Balance" e-headertext="Balance" e-allowediting="false" e-width="80"></div>
                </div>
            </div>

            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>

            <script type="text/x-jsrender" id="headerTemplate">

                <input type="checkbox" id="headchk" />
            </script>


        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn left">
        <ul class="list-inline text-left">
            <li> <button ng-click="UpdateInvoiceReviseDate();" class="btn" ng-disabled="saveBtnDisable==true"><i class="glyphicon glyphicon-lock"></i> {{Action}}</button></li>
        </ul>
    </div>
</div>






