            <div class="modal-header">Interest Payable List<button type="button" class="close" ng-click="closeloanTakenInterestPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">

                <div class="col-lg-12">
                    @*<label class="col-sm-2 control-label">{{Type}}</label>*@
                    <label class="col-sm-3 control-label">Loan No: {{loanNo}}</label>
                    <label class="col-sm-4 control-label">Party: {{partyName}}</label>
                    <label class="col-sm-5 control-label">Account Number: {{accountNumber}}</label>

                    <label class="chart-title"></label>
                </div>
                <div class="clearfix"></div>

                <div class="col-md-12">

                    @*style="color:black;overflow:scroll"*@
