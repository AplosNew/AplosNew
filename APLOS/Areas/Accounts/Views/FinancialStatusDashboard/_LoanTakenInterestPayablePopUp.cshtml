                         e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-summaryrows="summaryRowsLoanTakenInterest">
                        <div e-columns>

                            @*<div e-column e-type="string" e-field="LoanNo" e-headertext="Loan No" e-width="70"></div>
                            <div e-column e-type="string" e-field="Party" e-headertext="Party" e-width="70"></div>*@

                            <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="50">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="$parent.printLoanTakenInterestVoucherReport(this);" tooltip="Voucher No" class="btn" style="top: 1px;">{{data.VoucherNo}}</button></li>
                                    </ul>
                                </div>
                            </div>

                            @*<div e-column e-type="string" e-field="VoucherNo" e-headertext="VoucherNo" e-width="70"></div>*@
                            <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="PostingDate" e-headertext="Posting Date " e-width="70"></div>
                            <div e-column e-type="number" e-format="{0:N2}" e-field="Interest" e-headertext="Interest" e-width="60" e-textalign="right" style="height: 20px;"></div>

