<div class="modal fade site-modal in" id="vendorPayableAgingNoOfInvoiceDetailPopUp" role="dialog" data-backdrop="static">
    @*modellgModify1*@
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> {{AgingDueTypeNoOfInvoiceDetail}} <button type="button" class="close" ng-click="closeVendorPayableAgingNoOfInvoiceDetailPopUp();">&times;</button></div>

            <div class="col-lg-12">
                <label class="col-sm-12 control-label">Party: {{tempPartyName}}</label>
                @*<label class="col-sm-4 control-label">Party: {{partyName}}</label>
                 <label class="col-sm-5 control-label">Account Number: {{accountNumber}}</label>*@
                <label class="chart-title"></label>
            </div>
            <div class="clearfix"></div>
            <div class="content-container-fluid" style="color:black;overflow:scroll" @*ng-show="DetailDataList.length"*@>
                <div style="color:black;" id="GridAgingNoOfInvoiceDetailSetOffDetail" ej-grid e-datasource="PartyVendorPayableNoOfInvoiceDetailList" e-templaterefresh="refreshTemplateemployee"
                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                    <div e-columns>
                        @*<div e-column e-field="PartyName" e-headertext="Party" e-width="150"></div>*@
                        <div e-column e-field="InvNo" e-headertext="Invoice No" e-width="80"></div>

                        <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="80" @*e-textalign="left"*@>
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="$parent.printNoOfInvoiceDetailVoucherReport(this);" tooltip="Voucher No" class="btn" style="top: 1px;">{{data.VoucherNo}}</button></li>
                                </ul>
                            </div>
                        </div>

                        <div e-column e-field="PostingDate" e-headertext="Posting Date" e-width="60"></div>

                        @*<div e-column e-field="DocRefNo" e-headertext="Doc RefNo" e-width="90"></div>
                        <div e-column e-field="DocDate" e-headertext="Doc Date" e-width="90"></div>
                        <div e-column e-field="ActualDueDate" e-headertext="Due Date" e-width="90"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Advance" e-headertext=" Advance" e-width="60" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksGross" e-headertext="Books Gross" e-width="60" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksDebitNoteAmount" e-headertext="Books DebitNote" e-width="60" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksDiscountAmount" e-headertext="Books Discount" e-width="60" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksTaxAmount" e-headertext="Books Tax" e-width="60" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksSetOff" e-headertext=" Books Payment" e-width="60" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksBalance" e-headertext="Books Balance" e-width="60" e-textalign="right" style="height: 20px;"></div>*@

                        <div e-column e-field="TrnCurrency" e-headertext="Currency" e-width="40"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksGross" e-headertext=" Books Gross" e-width="80" e-textalign="right" style="height: 20px;"></div>

                        @*<div e-column e-type="numeric" e-format="{0:0.00}" e-field="DebitNoteAmount" e-headertext=" Debit Note" e-width="60" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksDiscountAmount" e-headertext="Discount" e-width="60" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="TaxAmount" e-headertext="Tax" e-width="60" e-textalign="right" style="height: 20px;"></div>*@

                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="DisplayBooksSetOff" e-template="#NoOfInvoiceDetailSetOffDetailTemplate" e-headertext="Books SetOff" e-width="80" e-textalign="right" style="height: 20px;"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksBalance" e-headertext="Books Balance" e-width="80" e-textalign="right" style="height: 20px;"></div>

                    </div>
                </div>

                @*<div class="common-btn">
                  <ul class="list-inline text-right">
                      <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                      <li><button ng-click="confirmDelete();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Delete</button></li>
                      <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                      <li><button ng-click="Back();" class="btn"><i class="glyphicon glyphicon-backward"></i> Back</button></li>
                  </ul>
                </div>*@

                <script type="text/template" id="NoOfInvoiceDetailSetOffDetailTemplate">
                    <a href="" ng-click="$parent.showAgingNoOfInvoiceDetailSetOffDetailPopUp(data)"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{data.DisplayBooksSetOff|number:2}}</span></a>
                </script>

                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeVendorPayableAgingNoOfInvoiceDetailPopUp();" class="btn">Close</button></li>
                </ul>

            </div>
        </div>
    </div>
</div>

