<togglable name="Incentive Receivable"></togglable>
<div class="form-horizontal form-elements" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Incentive Master<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select tabindex="10" required id="IncentiveMasterId" class="form-control" name="Payment Term" ng-model="voucher.IncentiveMasterId" ng-change="changePaymentTerm(voucher.IncentiveMasterId);">
                        <option ng-repeat="option in incentivemasterlist" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <textarea rows="4" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" maxlength="500" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();changePostingGetTaxCode();" id="postingDate" type="text" name="Posting Date" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyId" class="form-control" ng-disabled="currencyDisable" tabindex="5" name="Currency" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off" ng-disabled="voucher.CurrencyId==companyCurrencyId">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="Entity" ng-change="GetCboCostCenterIdByEntity(voucher.EntityId)" ng-model="voucher.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoice Amount <sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input tabindex="6" ng-model="voucher.Amount" name="Amount" type="text" n-decimals="3" class="form-control text-right" required autocomplete="off" readonly>
            </div>
        </div>
    </div>
    
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-1 col-md-1">
        <button ng-click="showOutBoundInvoicePopUp();" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> Add Invoice</button>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="checkedOutBoundInvoiceList.length" style="padding-top:10px;">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Invoice NO</th>
                    <th>Invoice Date</th>
                    <th>Customer</th>
                    <th>Voucher No</th>
                    <th>TRN Amount</th>
                    <th>Currency</th>
                    <th>Books Amount</th>
                    <th>Incentive Amount</th>
                    <th class="col-sm-1">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in checkedOutBoundInvoiceList">
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.PostingDate}}</td>
                    <td>{{x.PartyPlantName}}</td>
                    <td>{{x.VoucherNo}}</td>
                    <td class="text-right">{{x.Amount|number:2}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.BooksAmount|number:2}}</td>
                    <td>
                        <input ng-keyup="checkDistributedAmount($index,x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="DistributedAmount" autocomplete="off" ng-model="x.DistributedAmount">
                    </td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li><button ng-click="DeleteOutBoutConfirmation(x.InvoiceId)" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                        </ul>
                    </td>

                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-right"><strong>Total : </strong></td>
                    <td class="text-right"><strong>{{checkedOutBoundInvoiceList | sumByKey : 'Amount'|  number:2 }}</strong></td>
                    <td></td>
                    <td class="text-right"><strong>{{checkedOutBoundInvoiceList | sumByKey : 'BooksAmount' | number:2 }}</strong></td>
                    <td class="text-right"><strong>{{checkedOutBoundInvoiceList | sumByKey : 'DistributedAmount'|  number:2 }}</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
   
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchInvoiceList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Invoicing @Library.Model.Parties.PartyType.Customer.ToString()</th>
                <th>Posting Date</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Written-off Amount</th>
                <th>Balance</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in invoiceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" @*ng-dblclick="Get($index);"*@>
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PartyName}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:3}}</td>
                <td class="text-right"><ul class="list-inline action-list"><li><a ng-click="getInvoiceSetOffDetailByInvoice(x.Id)" href="">{{x.WrittenOffAmount | number:3}}</a></li></ul></td>
                <td class="text-right">{{x.Amount-x.WrittenOffAmount | number:3}}</td>
                <td>{{x.IsPark?'Parked':'Posted'}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id,x.BeneficiaryType,x.AdditionalTaxId,x);" href="" class="btn btn-action tooltip-here">Post</a></li>
                        <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                        <li><a class="btn btn-action" ng-click="IncentiveReceivableInvoiceReport('Pdf',x.VoucherId)"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" ng-click="IncentiveReceivableInvoiceReport('Excel',x.VoucherId)"><i class="fa fa-file-excel-o"></i></a></li>
                        @*<li ng-show="x.IsExpenseDistribution"><a ng-click="ExpenseDistributionReport('Excel',x.VoucherId);" class="btn btn-action" title="Expense Distribution Report"><i class="fa fa-file-excel-o"></i></a></li>*@

                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>

@Html.Partial("~/Areas/Accounts/Views/_OutBoundInvoicePopUp.cshtml")

<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(invoiceId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(invoiceId,voucherId)"></confirm-archive-generic>
<confirm-archive-generic modalid="DeleteOutBoundConfirmationPopUp" title="Confirmation" message={{message_conf}} data-ng-click-right-button="RemoveOutBoundInvoice()"></confirm-archive-generic>

