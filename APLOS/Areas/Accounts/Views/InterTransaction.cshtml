<togglable name="{{title}}"></togglable>
<div class="form-horizontal form-elements" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group">
            <div class="col-sm-8 radio">
                <label>
                    <input type="radio" name="source" ng-model="advance.JournalType" value="@Library.Model.Payments.JournalType.Receivable.ToString()" ng-change="changeJournalType()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>Receivable
                </label>
                <label>
                    <input type="radio" name="source" ng-model="advance.JournalType" value="@Library.Model.Payments.JournalType.Payable.ToString()" ng-change="changeJournalType()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>Payable
                </label>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group">
            <label class="col-sm-4 control-label">Settlement Type<sup>*</sup></label>
            <div class="col-sm-8 radio">

                <label>
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.SetOff.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>{{SetOffName}}
                </label>
                <label>
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.Payment.ToString()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>{{PaymentName}}
                </label>
                <label ng-hide="advance.JournalType=='@Library.Model.Payments.JournalType.Receivable.ToString()'">
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.AdvanceToVendor.ToString()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>Advance To Vendor
                </label>
                <label>
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.Transfer.ToString()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>{{TransferName}}
                </label>
                <label ng-hide="advance.JournalType=='@Library.Model.Payments.JournalType.Receivable.ToString()'">
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.Others.ToString()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>GL
                </label>
                <label ng-hide="advance.JournalType=='@Library.Model.Payments.JournalType.Payable.ToString()'">
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.DebitNoteSetOff.ToString()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>Debit Note SetOff
                </label><br />
                <label ng-hide="advance.JournalType=='@Library.Model.Payments.JournalType.Receivable.ToString()'">
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.CreditNoteSetOff.ToString()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>Credit Note SetOff
                </label>
                <label ng-hide="advance.JournalType=='@Library.Model.Payments.JournalType.Receivable.ToString()'">
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.EmployeePayableSetOff.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>Employee Payment By Inter Company
                </label>
                <label ng-hide="advance.JournalType=='@Library.Model.Payments.JournalType.Receivable.ToString()'">
                    <input ng-click="changeSettlementType()" type="radio" name="SettlementType" ng-model="advance.SettlementType" value="@Library.Model.Payments.SettlementType.AdvanceToEmployee.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>Employee Advance By Inter Company
                </label>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>

    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_TransactionType" class="form-group">
            <label class="col-sm-4 control-label">Transaction Type</label>

            <div class="col-sm-8 show-message" ng-show="advance.JournalType=='@Library.Model.Payments.JournalType.Receivable.ToString()'">
                <div class="select-style">
                    <select ng-change="getTransactionTypeGL(advance.FinancingTypeId)" name="Transaction Type" class="form-control" ng-model="advance.FinancingTypeId">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.AssetUserName}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-8 show-message" ng-show="advance.JournalType=='@Library.Model.Payments.JournalType.Payable.ToString()'">
                <div class="select-style">
                    <select ng-change="getTransactionTypeGL(advance.FinancingTypeId)" name="Transaction Type" class="form-control" ng-model="advance.FinancingTypeId">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.LiabilityUserName}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.SetOff.ToString()' || advance.SettlementType=='@Library.Model.Payments.SettlementType.AdvanceToVendor.ToString()'">
            <label class="col-sm-4 control-label">{{partyType}}</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="partyType" ng-model="advance.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.DebitNoteSetOff.ToString()' || advance.SettlementType=='@Library.Model.Payments.SettlementType.CreditNoteSetOff.ToString()'">
            <label class="col-sm-4 control-label">Party</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="partyType" ng-model="advance.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.EmployeePayableSetOff.ToString()' || advance.SettlementType=='@Library.Model.Payments.SettlementType.AdvanceToEmployee.ToString()'">
            <label class="col-sm-4 control-label">Employee</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="partyType" ng-model="advance.EmployeeName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="advance.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_entity" class="form-group">
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="entity" ng-model="advance.EntityId" tabindex="6">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.Payment.ToString()' || advance.SettlementType=='@Library.Model.Payments.SettlementType.Transfer.ToString()'">
            <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input ng-click="clearBankPopUp()" type="radio" name="paymentSource" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
                <label>
                    <input ng-click="clearCashPopUp()" type="radio" name="paymentSource" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='Payment'&&advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'
             || advance.SettlementType=='Transfer'&&advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Bank" class="form-control" ng-model="advance.BankMasterId" ng-options="item.Id as item.AccountTitle for item in bankMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.Payment.ToString()'&&advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'
             || advance.SettlementType=='@Library.Model.Payments.SettlementType.Transfer.ToString()' && advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Cash" class="form-control" @*submit-required="true"*@ ng-model="advance.CashMasterId" ng-options="item.Id as item.UserName for item in cashMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_Company" class="form-group">
            <label class="col-sm-4 control-label">Company</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Company Name" id="CompanyId" ng-model="advance.CompanyId" class="col-sm-3 form-control"
                            ng-change="getCompanyInfo(advance.CompanyId); companyChange(advance.CompanyId)" ng-options="item.CompanyId as item.CompanyName for item in companyList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.SetOff.ToString()' || advance.SettlementType=='@Library.Model.Payments.SettlementType.DebitNoteSetOff.ToString()'|| advance.SettlementType=='@Library.Model.Payments.SettlementType.CreditNoteSetOff.ToString()'">
            <label class="col-sm-4 control-label">Ordering {{partyType}} ({{partyPlantList.length}})</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="1" class="form-control" name="Ordering {{partyType}}" ng-model="advance.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(advance.PartyPlantId,'billTo');">
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(advance.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="advance.PostingDate" class="form-control" tabindex="2">
            </div>
        </div>
        <div class="form-group" id="div_qty">
            <label class="col-sm-4 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <input ng-disabled="advance.JournalId" tabindex="11" ng-model="advance.Amount" ng-change="setDrExchangeRate(advance.GLGeneralInfoId); updateCrAmount(null); copyAmount();" type="text" n-decimals="2" class="form-control text-right">
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="12" name="CurrencyTransaction" ng-model="advance.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Rate<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" n-decimals="4" id="Rate" name="Rate" ng-model="advance.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off" required ng-disabled="advance.CurrencyId==companyCurrencyId">
            </div>
        </div>

        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.SetOff.ToString()' && partyType=='@Library.Model.Parties.PartyType.Customer.ToString()'">
            <label class="col-sm-4 control-label">Receivable</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="common-btn">
                        <button ng-click="showCustomerInvoicePopUp(advance.PartyId);" type="button" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Invoice</button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.SetOff.ToString()' && partyType=='@Library.Model.Parties.PartyType.Vendor.ToString()'">
            <label class="col-sm-4 control-label">Payable</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="common-btn">
                        <button ng-click="showVendorInvoicePopUp(advance.PartyId);" type="button" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Invoice</button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.EmployeePayableSetOff.ToString()' && partyType=='@Library.Model.Parties.PartyType.Employee.ToString()'">
            <label class="col-sm-4 control-label">Employee Payable</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="common-btn">
                        <button ng-click="getPopupEmployeePayableList();" type="button" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Employee Payable</button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.AdvanceToEmployee.ToString()' && partyType=='@Library.Model.Parties.PartyType.Employee.ToString()'">
            <label class="col-sm-4 control-label">Employee Transaction Type</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Transaction Type" class="form-control" ng-model="advance.EmployeeTransactionTypeId" tabindex="7">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in employeeTransactionTypeList" value="{{option.EmployeeTransactionTypeId}}">{{option.EmployeeTransactionTypeName}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.DebitNoteSetOff.ToString()'">
            <label class="col-sm-4 control-label">Debit Note</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="common-btn">
                        <button ng-click="getPopupCustomerReceivableList(advance.PartyId);" type="button" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Debit Note</button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.CreditNoteSetOff.ToString()'">
            <label class="col-sm-4 control-label">Credit Note</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="common-btn">
                        <button ng-click="getPopupCustomerReceivableList(advance.PartyId);" type="button" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select Credit Note</button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.Others.ToString()' && advance.JournalType=='@Library.Model.Payments.JournalType.Payable.ToString()'">
            <label class="col-sm-4 control-label">GL</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="common-btn">
                        <button ng-click="popUp();" type="button" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Select GL</button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_Plant" class="form-group">
            <label class="col-sm-4 control-label">Plant</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-change="getPlantInfo(advance.PlantId);" name="Plant Name" id="PlantId" ng-model="advance.PlantId" class="col-sm-3 form-control" ng-options="item.PlantId as item.PlantName for item in interplantList" tabindex="10">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="advance.VoucherTypeId" tabindex="2" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="advance.DocDate" datepicker="checkPostingDate();checkDocDate();" required class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Doc Ref" name="Doc Ref" ng-model="advance.DocRefNo" class="form-control" tabindex="5" autocomplete="off" capitalize required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea ng-keyup="updateCrAmount();" rows="2" type="text" name="Narration" tabindex="13" class="form-control" ng-model="advance.Narration" required capitalize></textarea>
            </div>
        </div>
        <div class="form-group" ng-show="isBankAmount">
            <label class="col-sm-4 control-label">Bank Amount<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="advance.BankAmount">
            </div>
        </div>
    </div>
    <div class="row form-elements">
        <div class="col-xs-12 col-sm-12 col-md-12 modal-table" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.SetOff.ToString()' && advanceDetailList.length">
            <table class="table table-responsive table-striped">
                <thead>
                    <tr ng-show="partyType=='@Library.Model.Parties.PartyType.Customer.ToString()'">
                        <th>VoucherNo</th>
                        <th>Location</th>
                        <th>Currency</th>
                        @*<th>Rate</th>*@
                        <th>Amount</th>
                        <th>Set-off Amount</th>
                        <th>Balance</th>
                        <th>Received Amount</th>
                        @*<th>Exchange Type</th>
                            <th>Exchange Amount</th>*@
                        <th>Action</th>
                    </tr>
                    <tr ng-show="partyType=='@Library.Model.Parties.PartyType.Vendor.ToString()'">
                        <th>VoucherNo</th>
                        <th>Location</th>
                        <th>Currency</th>
                        @*<th>Rate</th>*@
                        <th>Amount</th>
                        <th>Set-off Amount</th>
                        <th>Balance</th>
                        <th>Payment Amount</th>
                        @*<th>Exchange Type</th>
                            <th>Exchange Amount</th>*@
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in advanceDetailList">
                        <td>{{x.VoucherNo}}</td>
                        <td>{{x.PartyPlantName}}</td>
                        <td>{{x.CurrencyCode}}</td>
                        @*<td>{{x.CompanyCurrencyRate}}</td>*@
                        <td class="text-right">{{x.Amount | number:2}}</td>
                        <td class="text-right">{{x.WriteOff | number:2}}</td>
                        <td class="text-right">{{x.Advilable | number:2}}</td>
                        <td ng-show="partyType=='@Library.Model.Parties.PartyType.Customer.ToString()'">
                            <input type="text" @*ng-keyup="exchangeGainLossAmount(x)"*@ n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.CrAmount">
                        </td>
                        <td ng-show="partyType=='@Library.Model.Parties.PartyType.Vendor.ToString()'">
                            <input type="text" @*ng-keyup="exchangeGainLossAmount(x)"*@ n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.DrAmount">
                        </td>
                        @*<td><input readonly type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeType" ng-model="x.ExchangeType"></td>
                            <td><input readonly type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeAmount" ng-model="x.ExchangeAmount"></td>*@
                        <td class="text-right">
                            <button ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove" ng-hide="x.AdvanceDetailId!=null">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
                <tfoot ng-show="advanceDetailList.length">
                    <tr>

                        <td colspan="6" class="text-right"><b>Sub Total</b></td>
