                    <tr ng-repeat="x in advanceDetailList">
                        <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td id="td_Amount">
                            <div class="show-message">
                                <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Amount">
                            </div>
                        </td>
                        <td class="text-right">
                            <button ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                        </td>
                    </tr>
                </tbody>
                <tfoot ng-show="advanceDetailList.length">
                    <tr>
                        <td colspan="3" class="text-right"><b>Sub Total</b></td>
                        <td class="text-right"><b>{{ advanceDetailList | sumByKey : 'Amount' }}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12 modal-table" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.EmployeePayableSetOff.ToString()'">
            <div class="table-responsive modal-table" ng-show="voucherDetailList.length">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Voucher No</th>
                            <th>DocDate</th>
                            <th>Doc Ref No</th>
                            <th>Posting Date</th>
                            <th>Currency</th>
                            <th>Payable</th>
                            <th>Payment</th>
                            <th>Balance</th>
                            <th>Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in voucherDetailList">
                            <td>{{x.VoucherNo}}</td>
                            <td>{{x.DocDate |dateFiltering}}</td>
                            <td>{{x.DocRefNo}}</td>
                            <td>{{x.PostingDate |dateFiltering}}</td>
                            <td>{{x.CurrencyCode}}</td>
                            <td class="text-right">{{x.Receivable | number:2}}</td>
                            <td class="text-right">{{x.Received | number:2}}</td>
                            <td class="text-right">{{x.Balance | number:2}}</td>
                            <td><input ng-keyup="convertAmount(x)" type="text" n-decimals="2" class="form-control text-right" name="Amount" ng-model="x.Amount"></td>
                            <td class="text-right">
                                <button ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot ng-show="voucherDetailList.length">
                        <tr>
                            <td colspan="7"></td>
                            <td><b>Sub Total</b></td>
                            <td class="text-right"><b>{{ voucherDetailList | sumByKey : 'Amount' }}</b></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6 modal-table" ng-show="advance.SettlementType=='@Library.Model.Payments.SettlementType.Payment.ToString()'
         ||advance.SettlementType=='@Library.Model.Payments.SettlementType.SetOff.ToString()' || advance.SettlementType=='@Library.Model.Payments.SettlementType.DebitNoteSetOff.ToString()'
         || advance.SettlementType=='@Library.Model.Payments.SettlementType.CreditNoteSetOff.ToString()'">
        <table class="table table-responsive table-striped">
            <caption>Charges</caption>
            <thead>
                <tr>
                    <th>Charges Type</th>
                    <th>Trn. Amount</th>
                    <th>{{companyCurrencyCode}}</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_FinancingType">
                        <div class="select-style show-message">
                            <select ng-model="bankCharge.FinancingTypeId">
                                <option ng-repeat="option in bankChargeTypeList" value="{{option.FinancingTypeId}}">{{option.ExpensesUserName}}</option>
                            </select>
                        </div>
                    </td>
                    <td id="td_FinancingTypeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="bankCharge.Amount" ng-keyup="copyChargesAmount();">
                        </div>
                    </td>
                    <td id="td_FinancingTypeCompanyCurrencyAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" readonly ng-model="bankCharge.CompanyCurrencyAmount">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addCharge();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in bankChargesList">
                    <td>{{x.FinancingTypeName}}</td>
                    <td class="text-right">{{x.Amount | number:2 }}</td>
                    <td class="text-right">{{x.CompanyCurrencyAmount | number:2}}</td>
                    <td class="text-right">
                        <button ng-click="removeChargesRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="bankChargesList.length">
                <tr>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ bankChargesList | sumByKey : 'Amount' }}</b></td>
                    <td class="text-right"><b>{{ bankChargesList | sumByKey : 'CompanyCurrencyAmount'  }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>


    <div class="col-xs-12 col-sm-6 col-md-6 modal-table" ng-hide="advance.SettlementType=='@Library.Model.Payments.SettlementType.Payment.ToString()'
         ||advance.SettlementType=='@Library.Model.Payments.SettlementType.SetOff.ToString()' || advance.SettlementType=='@Library.Model.Payments.SettlementType.DebitNoteSetOff.ToString()'
         || advance.SettlementType=='@Library.Model.Payments.SettlementType.CreditNoteSetOff.ToString()' || advance.SettlementType=='@Library.Model.Payments.SettlementType.EmployeePayableSetOff.ToString()'">
        <table class="table table-responsive table-striped">
            <caption>Tax</caption>
            <thead>
                <tr>
                    <th>Input Tax</th>
                    <th>Amount</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_TaxCode">
                        <div class="select-style show-message">
                            <select ng-model="advanceTax.TaxCodeId">
                                <option ng-repeat="option in taxCodCboList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </td>
                    <td id="td_TaxCodeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="advanceTax.TaxAmount" ng-keyup="copyTaxesAmount();">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addTax();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in advanceTaxesList">
                    <td>{{x.TaxName}}</td>
                    <td class="text-right">{{x.TaxAmount | number:2 }}</td>
                    <td class="text-right">
                        <button ng-click="removeTaxesRow($index)" data-toggle="modal" ng-disabled="x.AdvanceId" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="advanceTaxesList.length">
                <tr>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ advanceTaxesList | sumByKey : 'Amount' }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
