<togglable name="Company Tax Year Period"></togglable>
<div class="form-horizontal" ng-form id="CompanyTaxYearPeriod" name="companyTaxYearPeriodForm">
    <input type="hidden" ng-model="companyTaxYearPeriod.Id">
    <div class="col-xs-12 col-sm-6 col-md-6   form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Company Name" class="col-sm-3 form-control" ng-model="companyTaxYearPeriod.CompanyId" ng-options="item.Value as item.Text for item in companyList" required tabindex="2" ng-change="getTaxYear(companyTaxYearPeriod.CompanyId)"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6  form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Tax Year<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="TaxYear" class="col-sm-3 form-control" ng-model="companyTaxYearPeriod.TaxYearId" ng-options="item.Value as item.Text for item in taxYearList" required tabindex="1" ng-change="getComTaxYearPeriod(companyTaxYearPeriod.CompanyId, companyTaxYearPeriod.TaxYearId)"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Period No</th>
                <th>Period Name</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Budget Locked</th>
                <th>Transation Locked</th>
                <th>Exchange Rate Confirmed</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in companyTaxYearPeriods" ng-dblclick="Get(x.Id);">
                <td>{{x.PeriodNo}}</td>
                <td>{{x.PeriodName}}</td>
                <td>{{x.StartDate |dateFiltering}}</td>
                <td>{{x.EndDate |dateFiltering}}</td>
                <td align="center">
                    <div class="checkbox-site">
                        <label>
                            <input ng-click="UpdateBudgetLocked(x.Id);" type="checkbox" ng-model="x.IsBudgetLocked" id="IsBudgetLocked-{{x.ComFysId}}" class="css-checkbox center-block">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok center-block"></i></span>
                        </label>
                    </div>
                </td>
                <td align="center">
                    <div class="checkbox-site">
                        <label>
                            <input ng-click="UpdateTransationLocked(x.Id);" type="checkbox" ng-model="x.IsTransationLocked" id="IsTransationLocked-{{x.ComFysId}}" class="css-checkbox">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td align="center">
                    <div class="checkbox-site">
                        <label>
                            <input ng-click="UpdateExchangeRateConfirmed(x.Id);" type="checkbox" ng-model="x.IsExchangeRateConfirmed" id="IsExchangeRateConfirmed-{{x.ComFysId}}" class="css-checkbox">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
</div>