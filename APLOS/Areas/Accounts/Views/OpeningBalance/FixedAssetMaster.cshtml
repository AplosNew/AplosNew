<togglable name="FixedAsset Opening Balance"></togglable>
<div class="form-elements form-horizontal row" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Posting Date" ng-model="openingBalance.PostingDate" datepicker disabled required class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="Doc Ref" ng-model="openingBalance.DocRefNo" class="form-control" tabindex="2" required>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" id="DocDate" name="Doc Date" ng-model="openingBalance.DocDate" datepicker="checkDocDate('div_DocDate', openingBalance.DocDate)" required class="form-control datepicker" tabindex="1">
            </div>
        </div>
        <div id="div_entity" class="form-group" ng-show="isEntityLevel">
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-change="entityValidation()" name="Entity" class="form-control" ng-model="openingBalance.EntityId" tabindex="3">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea maxlength="250" type="text" name="Narration" class="form-control" rows="3" ng-model="openingBalance.Narration" tabindex="4" ng-keyup="copyNarration(openingBalance.Narration)" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li><button ng-click="showFixedAssetMasterList();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Add Line Items</button></li>
            </ul>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="clearFields();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table">
        <table class="table table-responsive table-striped">
            <thead>
                <tr>
                    <th rowspan="2">Asset Master</th>
                    <th rowspan="2">Asset GL</th>
                    <th rowspan="2">Asset Budget</th>
                    <th rowspan="2">Asset Activity</th>
                    <th rowspan="2">Accumulated Depreciation GL</th>
                    <th rowspan="2">Accumulated Depreciation Budget</th>
                    <th rowspan="2">Quantity</th>
                    <th colspan="{{parallelCurrencyTypeList.length/2}}" style="text-align:center">Historical Value</th>
                    <th colspan="{{parallelCurrencyTypeList.length/2}}" style="text-align:center">Accumulated Depreciation Value</th>
                    <th rowspan="2" style="vertical-align: middle; text-align:center">Direct/InDirect</th>
                    <th rowspan="2" style="vertical-align: middle; text-align:center">Action</th>
                </tr>
                <tr>
                    <th style="text-align:center">{{companyCurrencyName}}</th>
                    <th ng-hide="companyGroupCurrencyId==null" style="text-align:center">{{companyGroupCurrencyName}}</th>
                    <th ng-hide="hardCurrencyId==null" style="text-align:center">{{hardCurrencyName}}</th>
                    <th style="text-align:center">{{companyCurrencyName}}</th>
                    <th ng-hide="companyGroupCurrencyId==null" style="text-align:center">{{companyGroupCurrencyName}}</th>
                    <th ng-hide="hardCurrencyId==null" style="text-align:center">{{hardCurrencyName}}</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in openingBalanceDetailList">
                    <td>{{x.FixedAssetMasterName}}</td>
                    <td>{{x.AssetGLName}}</td>
                    <td>{{x.BudgetName}}</td>
                    <td>{{x.AssetActivityName}}</td>
                    <td>{{x.AccDepreciation}}</td>
                    <td>{{x.ACUBudgetName}}</td>
                    <td><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.Quantity"></td>
                    <td><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.FACompanyCurrencyAmount"></td>
                    <td ng-hide="companyGroupCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.FACompanyGroupCurrencyAmount"></td>
                    <td ng-hide="hardCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.FAHardCurrencyAmount"></td>
                    <td><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.ADCompanyCurrencyAmount"></td>
                    <td ng-hide="companyGroupCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.ADCompanyGroupCurrencyAmount"></td>
                    <td ng-hide="hardCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.ADHardCurrencyAmount"></td>
                    <td class="text-right">
                        <button ng-click="showDirectIndirectPop($index)" class="btn-action tooltip-here"
                                data-placement="top" title="Direct InDirect">
                            <i class="glyphicon glyphicon-list"></i>
                        </button>
                    </td>
                    <td class="text-right">
                        <button ng-click="valuePassInDelModal($index,x)" class="btn-action tooltip-here"
                                data-placement="top" title="Delete">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="openingBalanceDetailList.length">
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ openingBalanceDetailList | sumByKey : 'FACompanyCurrencyAmount'  }}</b></td>
                    <td class="text-right" ng-hide="companyGroupCurrencyId==null"><b>{{ openingBalanceDetailList | sumByKey : 'FACompanyGroupCurrencyAmount'  }}</b></td>
                    <td class="text-right" ng-hide="hardCurrencyId==null"><b>{{ openingBalanceDetailList | sumByKey : 'FAHardCurrencyAmount'  }}</b></td>
                    <td class="text-right"><b>{{ openingBalanceDetailList | sumByKey : 'ADCompanyCurrencyAmount'  }}</b></td>
                    <td class="text-right" ng-hide="companyGroupCurrencyId==null"><b>{{ openingBalanceDetailList | sumByKey : 'ADCompanyGroupCurrencyAmount'  }}</b></td>
                    <td class="text-right" ng-hide="hardCurrencyId==null"><b>{{ openingBalanceDetailList | sumByKey : 'ADHardCurrencyAmount'  }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Entity</th>
                <th>VoucherNo</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Doc Ref</th>
                <th>Amount</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in openingBalanceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById($index);">
                <td>{{x.EntityName}}</td>
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.DocDate | dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td class="text-right">{{x.Amount | number:4}}</td>
                <td>{{x.IsPark?'Park':'Post'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<div class="modal fade site-modal in" id="FixedAssetMasterListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Asset GL</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="fixedAssetMasterListParameters.searchBy">
                                            <option ng-repeat="option in searchFixedAssetMasterByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="fixedAssetMasterListParameters.search" ng-enter="GetFixedAssetMasterListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetFixedAssetMasterListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>Budget Category</th>
                                <th>Budget SubCategory</th>
                                <th>Asset Master</th>
                                <th>Acc Dep GL</th>
                                <th>Acc Dep Budget</th>
                                <th>Acc Dep Activity</th>
                                <th>Ref No</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in FixedAssetMasterList |itemsPerPage:fixedAssetMasterListParameters.pageSize" pagination-id="metaData.name + 'FixedAssetMasterList'" total-items="fixedAssetMasterListParameters.total_count"
                                ng-click="selectFixedAssetMasterListPopUp($index, x)" ng-class="{unsaveRow : x.Id === openingBalanceDetail.AssetItemId}" ng-dblclick="closeFixedAssetMasterListPopUp()">
                                <td>{{x.AssetGLName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.AssetActivityName}}</td>
                                <td>{{x.BudgetCategory}}</td>
                                <td>{{x.BudgetSubCategory}}</td>
                                <td>{{x.FixedAssetMasterName}}</td>
                                <td>{{x.AccDepreciation}}</td>
                                <td>{{x.ACUBudgetName}}</td>
                                <td>{{x.AccumulativeActivityName}}</td>
                                <td>{{x.RefNo}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'FixedAssetMasterList'"
                                             direction-links="true" boundary-links="true"
                                             on-page-change="GetFixedAssetMasterListData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeFixedAssetMasterListPopUp();">Select</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="opDetailDirectInDirectPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="opDetailDirectInDirectForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Direct/InDirect</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-responsive table-striped">
                        <thead>
                            <tr>
                                <th rowspan="2"></th>
                                <th rowspan="2">Quantity</th>
                                <th colspan="{{parallelCurrencyTypeList.length/2}}" style="text-align:center">Asset Historical Value</th>
                                <th colspan="{{parallelCurrencyTypeList.length/2}}" style="text-align:center">Accumulated Depreciation Value</th>
                            </tr>
                            <tr>
                                <th style="text-align:center">{{companyCurrencyName}}</th>
                                <th ng-hide="companyGroupCurrencyId==null" style="text-align:center">{{companyGroupCurrencyName}}</th>
                                <th ng-hide="hardCurrencyId==null" style="text-align:center">{{hardCurrencyName}}</th>
                                <th style="text-align:center">{{companyCurrencyName}}</th>
                                <th ng-hide="companyGroupCurrencyId==null" style="text-align:center">{{companyGroupCurrencyName}}</th>
                                <th ng-hide="hardCurrencyId==null" style="text-align:center">{{hardCurrencyName}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Direct</td>
                                <td><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].DirectQuantity"></td>
                                <td><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].FACompanyCurrencyDirectAmount"></td>
                                <td ng-hide="companyGroupCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].FACompanyGroupCurrencyDirectAmount"></td>
                                <td ng-hide="hardCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].FAHardCurrencyDirectAmount"></td>
                                <td><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].ADCompanyCurrencyDirectAmount"></td>
                                <td ng-hide="companyGroupCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].ADCompanyGroupCurrencyDirectAmount"></td>
                                <td ng-hide="hardCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].ADHardCurrencyDirectAmount"></td>
                            </tr>
                            <tr>
                                <td>InDirect</td>
                                <td><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].InDirectQuantity"></td>
                                <td><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].FACompanyCurrencyInDirectAmount"></td>
                                <td ng-hide="companyGroupCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].FACompanyGroupCurrencyInDirectAmount"></td>
                                <td ng-hide="hardCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].FAHardCurrencyDirectAmount"></td>
                                <td><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].ADCompanyCurrencyInDirectAmount"></td>
                                <td ng-hide="companyGroupCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].ADCompanyGroupCurrencyInDirectAmount"></td>
                                <td ng-hide="hardCurrencyId==null"><input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="openingBalanceDetailList[directInDirectIndex].ADHardCurrencyInDirectAmount"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="opDetailDirectInDirectPopUpClose();">Done</button>
            </div>
        </div>
    </div>
</div>
<confirm-cancel message="You didn't select any Fixed Asset. Are you sure want to exit?" title="Confirm Exit" data-ng-click-right-button="removeRow()"></confirm-cancel>
<confirm-archive-generic data-modalid="confirmDocumentdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeOpeningBalanceDetail()"></confirm-archive-generic>
<confirm-modal></confirm-modal>