<togglable name="Inter Non-Trade Given Opening Balance"></togglable>
<div class="form-elements form-horizontal row" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Posting Date" ng-model="openingBalance.PostingDate" datepicker disabled required class="form-control" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Doc Ref" ng-model="openingBalance.DocRefNo" class="form-control" tabindex="3" required>
            </div>
        </div>
        <div id="div_TransactionType" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-change="getTransactionTypeGL(openingBalance.FinancingTypeId)" name="Transaction Type" class="form-control" ng-model="openingBalance.FinancingTypeId" tabindex="5" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.AssetUserName}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Doc Date" ng-model="openingBalance.DocDate" datepicker="checkDocDate('div_DocDate', openingBalance.DocDate)" class="form-control datepicker" tabindex="2" required>
            </div>
        </div>
        <div id="div_entity" class="form-group" ng-show="isEntityLevel">
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-change="entityValidation()" class="form-control" ng-model="openingBalance.EntityId" tabindex="4">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Invest To<sup>*</sup></label>
            <div class="radio col-sm-8">
                <label>
                    <input ng-disabled="openingBalance.Id!=null" ng-click="changeSourceTo('@Library.Model.Parties.PartyType.Plant.ToString()')" type="radio" name="sourceParty" ng-model="openingBalance.PartyType" value="@Library.Model.Parties.PartyType.Plant.ToString()">
                    <span class="cr" tabindex="6"><i class="cr-icon"></i></span>Plant
                </label>
                <label>
                    <input ng-disabled="openingBalance.Id!=null" ng-click="changeSourceTo('@Library.Model.Parties.PartyType.Company.ToString()')" type="radio" name="sourceParty" ng-model="openingBalance.PartyType" value="@Library.Model.Parties.PartyType.Company.ToString()">
                    <span class="cr" tabindex="7"><i class="cr-icon"></i></span>Company
                </label>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea type="text" name="Narration" class="form-control" rows="3" ng-model="openingBalance.Narration" tabindex="8" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="clearFields();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Plant</th>
                    <th>Entity</th>
                    <th>Narration</th>
                    <th>Trn. Currency</th>
                    <th>Trn. Amount</th>
                    <th>{{companyCurrencyName}}</th>
                    <th ng-hide="companyGroupCurrencyId==null">{{companyGroupCurrencyName}}</th>
                    <th ng-hide="hardCurrencyId==null">{{hardCurrencyName}}</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in openingBalanceDetailList" ng-click="currentRow($index)">
                    <td>
                        <div class="select-style">
                            <select ng-disabled="openingBalance.PartyType=='Plant'" name="Company Name" id="CompanyId" ng-model="x.CompanyId" class="col-sm-3 form-control"
                                    ng-change="companyChange(x.CompanyId)" ng-options="item.Value as item.Text disable when item.disabled for item in companyList" tabindex="9">
                                <option></option>
                            </select>
                        </div>
                    </td>
                    <td id="td_PlantId_{{$index}}">
                        <div class="show-message">
                            <div class="select-style">
                                <select name="Plant Name" id="PlantId" ng-model="x.PlantId" class="col-sm-3 form-control"
                                        ng-change="plantChange(x.PlantId, x.CompanyId, x);checkRowValidation(x, $index)" ng-options="item.PlantId as item.PlantName for item in interplantList" tabindex="10">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </td>
                    <td id="td_EntityId_{{$index}}">
                        <div class="show-message">
                            <div class="select-style">
                                <select name="Company Name" id="EntityId" ng-model="x.EntityId" class="col-sm-3 form-control"
                                        ng-options="item.Value as item.Text for item in interEntityList|filter:{ Value : '!openingBalance.EntityId' }" ng-change="checkRowValidation(x, $index)" tabindex="11">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </td>
                    <td id="td_Narration_{{$index}}">
                        <div class="show-message">
                            <input type="text" class="form-control" ng-model="x.Narration" placeholder="Narration" ng-keyup="checkRowValidation(x, $index)" maxlength="250" tabindex="12">
                        </div>
                    </td>
                    <td id="td_CurrencyId_{{$index}}">
                        <div class="show-message">
                            <div class="select-style">
                                <select class="col-sm-3 form-control" ng-model="x.CurrencyId" ng-change="checkRowValidation(x, $index)" tabindex="13">
                                    <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </td>
                    <td id="td_Amount_{{$index}}">
                        <div class="show-message">
                            <input type="text" n-decimals="2" style="width:90px" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.Amount" ng-keyup="copyAmount($index);checkRowValidation(x, $index)" tabindex="14">
                        </div>
                    </td>
                    <td id="td_CompanyCurrencyAmount_{{$index}}">
                        <div class="show-message">
                            <input type="text" n-decimals="2" style="width:90px" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.CompanyCurrencyAmount" ng-keyup="checkRowValidation(x, $index)" tabindex="15">
                        </div>
                    </td>
                    <td ng-hide="companyGroupCurrencyId==null"><input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.CompanyGroupCurrencyAmount" tabindex="16"></td>
                    <td ng-hide="hardCurrencyId==null"><input type="text" n-decimals="2" style="width:90px" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.HardCurrencyAmount" tabindex="17"></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Entity</th>
                <th>VoucherNo</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Doc Ref</th>
                <th>Amount</th>
                <th>Posted</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in openingBalanceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById($index);changeSourceTo(x.PartyType);">
                <td>{{x.EntityName}}</td>
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.DocDate | dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td class="text-right">{{x.Amount | number:4}}</td>
                <td>{{x.IsPosted?'Yes':'No'}}</td>
                <td>{{x.IsPark?'Park':'Post'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>