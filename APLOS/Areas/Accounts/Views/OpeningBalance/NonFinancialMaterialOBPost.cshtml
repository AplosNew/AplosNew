<div class="aplos-grid-toggle">
    <div class="row text-right ">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="voucherListParameters.searchBy">
                                <option ng-repeat="option in searchvoucherList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="voucherListParameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>DocRef No</th>
                    <th>Posting Date</th>
                    <th>DrAmount</th>
                    <th>CrAmount</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:voucherListParameters.pageSize" total-items="voucherListParameters.total_count" ng-dblclick="Clear();Get(x);getAllPartyPlantList(x.Id);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td class="text-right">{{x.DrAmount | number:2}}</td>
                    <td class="text-right">{{x.CrAmount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            @*<li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>*@
                            <li><a class="btn btn-action" href="Accounts/OpeningBalance/GetJournalVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&openingBalanceId={{x.Id}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
