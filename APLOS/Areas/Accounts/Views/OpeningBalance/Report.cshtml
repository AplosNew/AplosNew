<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Opening Balance Report
</h3>
<div class="form-elements form-horizontal" ng-form id="openingBalanceReport" name="openingBalanceReportForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-7" ng-dropdown-multiselect="" options="parallelCurrencyList" selected-model="currencyIds"
                 extra-settings="multiSelectSettings" events="multi1events">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="openingBalanceReport();" class="btn"><i class="glyphicon glyphicon-print"></i> Print</button></li>
        </ul>
    </div>
</div>