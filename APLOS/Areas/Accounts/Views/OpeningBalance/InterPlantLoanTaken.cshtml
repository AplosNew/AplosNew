<togglable name="Inter Plant Loan Taken Opening Balance"></togglable>
<div class="form-elements form-horizontal row" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Posting Date" ng-model="openingBalance.PostingDate" datepicker ng-disabled="true" required class="form-control" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Doc Ref" ng-model="openingBalance.DocRefNo" class="form-control" ng-disabled="true" tabindex="3" required>
            </div>
        </div>
        <div id="div_TransactionType" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Transaction Type" class="form-control" ng-disabled="true" ng-model="openingBalance.FinancingTypeId" tabindex="5" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.LiabilityUserName}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" id="DocDate" name="Doc Date" ng-model="openingBalance.DocDate" datepicker="checkDocDate('div_DocDate', openingBalance.DocDate)" required class="form-control datepicker" tabindex="1">
            </div>
        </div>
        <div id="div_entity" class="form-group" ng-show="isEntityLevel">
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-change="changeEntity(openingBalance.EntityId);entityValidation()" class="form-control" ng-disabled="true" ng-model="openingBalance.EntityId" tabindex="4">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea type="text" name="Narration" class="form-control" rows="3" ng-model="openingBalance.Narration" tabindex="6" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            </ul>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Plant</th>
                    <th>Entity</th>
                    <th>Narration</th>
                    <th>Repay. Date</th>
                    <th>Life Of Year</th>
                    <th>No.Install/Year</th>
                    <th>Total No.Install.</th>
                    <th>No. Paid Install.</th>
                    <th>Profit Rate</th>
                    <th>Trn. Currency</th>
                    <th>Sanction Amount</th>
                    <th>Rm. Amount</th>
                    <th>{{companyCurrencyName}}</th>
                    <th ng-hide="companyGroupCurrencyId==null">{{companyGroupCurrencyName}}</th>
                    <th ng-hide="hardCurrencyId==null">{{hardCurrencyName}}</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in openingBalanceDetailList" ng-click="currentRow($index)">
                    <td><input type="text" style="width:83px;" class="form-control" ng-disabled="true" ng-model="x.PlantName" tabindex="9"></td>
                    <td><input type="text" style="width:83px;" class="form-control" ng-disabled="true" ng-model="x.EntityName" tabindex="9"></td>
                    <td><input type="text" class="form-control" style="width:110px;" ng-model="x.Narration" placeholder="Narration" tabindex="10"></td>
                    <td>
                        <input type="text" name="RepaymentStartDate" ng-model="x.RepaymentStartDate" ng-disabled="true" style="width:107px" title="Repayment Start Date" datepicker="checkDocDate();" required class="form-control" tabindex="11">
                    </td>
                    <td>
                        <input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" style="width:80px" name="LifeOfYear" ng-model="x.LifeOfYear" ng-disabled="true" class="form-control text-right" tabindex="12" required>
                    </td>
                    <td>
                        <input type="text" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" name="NoOfInstallmentPerYear" ng-model="x.NoOfInstallmentPerYear" ng-disabled="true" class="form-control text-right" tabindex="13" required>
                    </td>
                    <td>
                        <input type="text" name="NoOfInstallmentPerYear" style="width:100px" ng-model="x.NoOfInstallmentPerYear" ng-value="x.LifeOfYear*x.NoOfInstallmentPerYear" ng-disabled="true" class="form-control text-right" required>
                    </td>
                    <td>
                        <input type="text" n-Decimals="4" style="width:107px" title="Text, Comma, +, -, Two Dot is not allow" name="NoOfPaidInstallment" ng-model="x.NoOfPaidInstallment" ng-disabled="true" class="form-control text-right" tabindex="14" required>
                    </td>
                    <td>
                        <input type="text" name="ProfitRate" style="width:90px" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" ng-model="x.ProfitRate" ng-disabled="true" class="form-control text-right">
                    </td>
                    <td>
                        <div class="select-style">
                            <select class="col-sm-3 form-control" ng-model="x.CurrencyId" ng-disabled="true">
                                <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <input type="text" name="SanctionAmount" style="width:90px" n-Decimals="4" title="Text, Comma, +, -, Two Dot is not allow" ng-model="x.SanctionAmount" class="form-control text-right" ng-disabled="true">
                    </td>
                    <td><input type="text" n-decimals="2" style="width:90px" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.Amount" ng-keyup="copyAmount($index)" ng-disabled="true"></td>
                    <td><input type="text" n-decimals="2" style="width:90px" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.CompanyCurrencyAmount" ng-disabled="true"></td>
                    <td ng-hide="companyGroupCurrencyId==null"><input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.CompanyGroupCurrencyAmount" ng-disabled="true"></td>
                    <td ng-hide="hardCurrencyId==null"><input type="text" n-decimals="2" style="width:90px" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.HardCurrencyAmount" ng-disabled="true"></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Entity</th>
                <th>VoucherNo</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Doc Ref</th>
                <th>Amount</th>
                <th>Posted</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in openingBalanceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById($index);">
                <td>{{x.EntityName}}</td>
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.DocDate | dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td class="text-right">{{x.Amount | number:4}}</td>
                <td>{{x.IsPosted?'Yes':'No'}}</td>
                <td>{{x.IsPark?'Park':'Post'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>