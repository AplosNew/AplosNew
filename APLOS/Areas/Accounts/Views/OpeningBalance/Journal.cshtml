<togglable name="Opening Balance Journal"></togglable>
<div class="form-elements form-horizontal row" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Posting Date" ng-model="voucher.PostingDate" datepicker disabled required class="form-control">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" id="DocDate" name="Doc Date" ng-model="voucher.DocDate" datepicker="checkDocDate('div_DocDate', voucher.DocDate)" required class="form-control datepicker" tabindex="1">
            </div>
        </div>
        <div id="div_entity" class="form-group" ng-show="isEntityLevel">
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-change="entityChange(openingBalance.EntityId);entityValidation()" name="Entity" class="form-control" ng-model="voucher.EntityId" tabindex="3">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Fiscal Year<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <input type="text" name="Fiscal Year" disabled required ng-model="voucher.FiscalYearName" class="form-control">
                <input type="hidden" name="Period" ng-model="voucher.FiscalYearId" class="form-control">
            </div>
            <label class="col-sm-2 control-label">Period<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <input type="text" name="Period" disabled required ng-model="voucher.FiscalYearPeriodName" class="form-control">
                <input type="hidden" name="Period" ng-model="voucher.FiscalYearPeriodId" class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="2" required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="true" name="Voucher Type" class="form-control" ng-model="voucher.VoucherTypeId" tabindex="4" required>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea maxlength="250" type="text" name="Narration" class="form-control" rows="3" ng-model="voucher.Narration" tabindex="6" ng-keyup="copyNarration(voucher.Narration)" required></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li><button ng-click="GetCOAICodeList();" class="btn" tabindex="7"><i class="glyphicon glyphicon-plus-sign"></i> Add Line Items</button></li>
            </ul>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Opening Balance</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Pre Entered Data</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="address" role="tab" data-toggle="tab">Summary Data</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form name="tabForm1">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Doc Date</th>
                                <th>Doc Ref</th>
                                <th>Narration</th>
                                <th>Trn. Currency</th>
                                <th>Trn. Type</th>
                                <th>Trn. Amount</th>
                                <th>{{companyCurrencyName}}</th>
                                <th ng-hide="companyGroupCurrencyId==null">{{companyGroupCurrencyName}}</th>
                                <th ng-hide="hardCurrencyId==null">{{hardCurrencyName}}</th>
                                <th class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in openingBalanceDetailList | filter:{IsOB:false}">
                                <td>{{x.GLGeneralInfoName}}</td>
                                <td id="td_DocDate_{{$index}}">
                                    <div class="show-message">
                                        <input type="text" class="form-control" ng-model="x.DocDate" datepicker="checkDocDate('tr_DocDate', x.DocDate); checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td id="td_DocRef_{{$index}}">
                                    <div class="show-message">
                                        <input type="text" class="form-control" ng-model="x.DocRefNo" placeholder="Doc Ref" maxlength="50" ng-keyup="checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td id="td_Narration_{{$index}}">
                                    <div class="show-message">
                                        <input type="text" class="form-control" ng-model="x.Narration" placeholder="Narration" ng-keyup="copyNarration(x.Narration); checkRowValidation(x, $index)" maxlength="250">
                                    </div>
                                </td>
                                <td id="td_CurrencyId_{{$index}}">
                                    <div class="col-md-12 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="x.CurrencyId" ng-change="checkRowValidation(x, $index)">
                                                <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>
                                    </div>
                                </td>
                                <td>{{x.TrnType}}</td>
                                <td id="td_Amount_{{$index}}">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.Amount" ng-keyup="copyAmount($index); checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td id="td_CompanyCurrencyAmount_{{$index}}">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.CompanyCurrencyAmount" ng-keyup="checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td id="td_CompanyGroupCurrencyAmount_{{$index}}" ng-hide="companyGroupCurrencyId==null">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.CompanyGroupCurrencyAmount" ng-keyup="checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td id="td_HardCurrencyAmount_{{$index}}" ng-hide="hardCurrencyId==null">
                                    <div class="show-message">
                                        <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.HardCurrencyAmount" ng-keyup="checkRowValidation(x, $index)">
                                    </div>
                                </td>
                                <td class="text-right">
                                    <button ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                        <i class="glyphicon glyphicon-remove"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot ng-show="openingBalanceDetailList.length">
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td><b>Debit</b></td>
                                <td></td>
                                <td class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountDr'  }}</b></td>
                                <td ng-hide="companyGroupCurrencyId==null" class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountDr'  }}</b></td>
                                <td ng-hide="hardCurrencyId==null" class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountDr'  }}</b></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td><b>Credit</b></td>
                                <td></td>
                                <td class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountCr'  }}</b></td>
                                <td ng-hide="companyGroupCurrencyId==null" class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountCr'  }}</b></td>
                                <td ng-hide="hardCurrencyId==null" class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountCr'  }}</b></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td><b>Balance</b></td>
                                <td></td>
                                <td class="text-right"><b>{{companyCurrencyAmount}}</b></td>
                                <td ng-hide="companyGroupCurrencyId==null" class="text-right"><b>{{companyGroupCurrencyAmount}}</b></td>
                                <td ng-hide="hardCurrencyId==null" class="text-right"><b>{{hardCurrencyAmount}}</b></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form name="tabForm2">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Source</th>
                                <th>GL</th>
                                <th ng-show="companyConfig.IsVoucherFromBudget">Budget</th>
                                <th ng-show="companyConfig.IsVoucherFromBudget">Activity</th>
                                <th>Doc Date</th>
                                <th>Doc Ref</th>
                                <th>Narration</th>
                                <th>Trn. Currency</th>
                                <th>Trn. Type</th>
                                <th>Trn. Amount</th>
                                <th>{{companyCurrencyName}}</th>
                                <th ng-hide="companyGroupCurrencyId==null">{{companyGroupCurrencyName}}</th>
                                <th ng-hide="hardCurrencyId==null">{{hardCurrencyName}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in openingBalanceDetailList | filter:{IsOB:true}">
                                <td>{{x.SourceType}}</td>
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                <td ng-show="companyConfig.IsVoucherFromBudget">{{x.BudgetName}}</td>
                                <td ng-show="companyConfig.IsVoucherFromBudget">{{x.ActivityName}}</td>
                                <td>{{x.DocDate | dateFiltering}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.Narration}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td>{{x.TrnType}}</td>
                                <td class="text-right">{{x.Amount | number:2}}</td>
                                <td class="text-right">{{x.CompanyCurrencyAmount | number:2}}</td>
                                <td ng-hide="companyGroupCurrencyId==null" class="text-right">{{x.CompanyGroupCurrencyAmount | number:2}}</td>
                                <td ng-hide="hardCurrencyId==null" class="text-right">{{x.HardCurrencyAmount | number:2}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }" ng-form name="tabForm3">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead compile="parallelCurrencyTableHead">
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in openingBalanceSummaryList">
                                <td>{{x.SourceType}}</td>
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                <td ng-show="companyConfig.IsVoucherFromBudget">{{x.BudgetName}}</td>
                                <td ng-show="companyConfig.IsVoucherFromBudget">{{x.ActivityName}}</td>
                                <td class="text-right">{{x.CompanyCurrencyAmountDr | number:2}}</td>
                                <td class="text-right">{{x.CompanyCurrencyAmountCr | number:2}}</td>
                                <td ng-hide="companyGroupCurrencyId==null" class="text-right">{{x.CompanyGroupCurrencyAmountDr | number:2}}</td>
                                <td ng-hide="companyGroupCurrencyId==null" class="text-right">{{x.CompanyGroupCurrencyAmountCr | number:2}}</td>
                                <td ng-hide="hardCurrencyId==null" class="text-right">{{x.HardCurrencyAmountDr | number:2}}</td>
                                <td ng-hide="hardCurrencyId==null" class="text-right">{{x.HardCurrencyAmountCr | number:2}}</td>
                            </tr>
                        </tbody>
                        <tfoot ng-show="openingBalanceSummaryList.length">
                            <tr>
                                <td></td>
                                <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                <td><b>Sub Total</b></td>
                                <td class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountDr'  }}</b></td>
                                <td class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountCr'  }}</b></td>
                                <td ng-hide="companyGroupCurrencyId==null" class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountDr'  }}</b></td>
                                <td ng-hide="companyGroupCurrencyId==null" class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountCr'  }}</b></td>
                                <td ng-hide="hardCurrencyId==null" class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountDr'  }}</b></td>
                                <td ng-hide="hardCurrencyId==null" class="text-right"><b>{{ openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountCr'  }}</b></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                <td><b>Balance</b></td>
                                <td class="text-right"><b>{{ (openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountDr') - (openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountCr') < 0 ? (((openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountDr') - (openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountCr')) | makePositive)  : 0.00  }}</b></td>
                                <td class="text-right"><b>{{ (openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountCr') - (openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountDr') < 0 ? (((openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountCr') - (openingBalanceSummaryList | sumByKey : 'CompanyCurrencyAmountDr')) | makePositive)  : 0.00 }}</b></td>
                                <td ng-hide="companyGroupCurrencyId==null" class="text-right"><b>{{ (openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountDr') - (openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountCr') < 0 ? (((openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountDr') - (openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountCr')) | makePositive) : 0.00  }}</b></td>
                                <td ng-hide="companyGroupCurrencyId==null" class="text-right"><b>{{ (openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountCr') - (openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountDr') < 0 ? (((openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountCr') - (openingBalanceSummaryList | sumByKey : 'CompanyGroupCurrencyAmountDr')) | makePositive) : 0.00  }}</b></td>
                                <td ng-hide="hardCurrencyId==null" class="text-right"><b>{{ (openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountDr') - (openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountCr') < 0 ? (((openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountDr') - (openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountCr')) | makePositive) : 0.00  }}</b></td>
                                <td ng-hide="hardCurrencyId==null" class="text-right"><b>{{ (openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountCr') - (openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountDr') < 0 ? (((openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountCr') - (openingBalanceSummaryList | sumByKey : 'HardCurrencyAmountDr')) | makePositive) : 0.00  }}</b></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="clearFields();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Doc Ref</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in openingBalanceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById($index);">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.DocDate | dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.IsPark?'Park':'Post'}}</td>
                <td class="text-right">
                    <button ng-click="openingBalanceReport(x.Id)" class="btn btn-action"><i class="glyphicon glyphicon-print"></i></button>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLPopUp.cshtml")
<confirm-cancel message="You didn't select any Fixed Asset. Are you sure want to exit?" title="Confirm Exit" data-ng-click-right-button="removeRow()"></confirm-cancel>
<confirm-archive-generic data-modalid="confirmDocumentdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeFARowDeleteSetYes()"></confirm-archive-generic>
<confirm-modal></confirm-modal>