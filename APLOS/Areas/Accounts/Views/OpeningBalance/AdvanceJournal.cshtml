<togglable name="OpeningBalance Journal Voucher"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Entry Date" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" ng-disabled="true" name="currency" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker id="postingDate" type="text" name="Posting Date" disabled ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Doc Date" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-change="entityChange(voucher.EntityId)" id="entityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>

                </div>

            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-8 col-md-8">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea rows="1" type="text" maxlength="250" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group">
            <label class="col-sm-4 control-label">Select<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select name="partyType" ng-change="changePartyType(voucher.PartyType)" ng-model="voucher.PartyType" class="col-sm-3 form-control">
                        <option value="GL">GL</option>
                        <option value="Bank">Bank</option>
                        <option value="Cash">Cash</option>
                        <option value="Vendor">Vendor</option>
                        <option value="Customer">Customer</option>
                        <option value="Employee">Employee</option>
                        <option value="FixedAsset">Fixed Asset</option>
                        <option value="Material">Material</option>
                        <option value="LoanTaken">Loan Taken</option>
                        <option value="LoanGiven">Loan Given</option>
                        <option value="SecurityTaken">Security Taken</option>
                        <option value="SecurityGiven">Security Given</option>
                        <option value="InvestmentGiven">Investment</option>
                        <option value="Equity">Equity</option>
                        <option value="InterTransaction">Inter Transaction</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-2 input-group">
                <span class="input-group-btn">
                    <button ng-click="GetCOAICodeList();" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.GL.ToString()'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="GetmMGLList();" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.Material.ToString()'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="GetLoanTakenGLList();" ng-show="voucher.PartyType=='LoanTaken'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="GetLoanGivenGLList();" ng-show="voucher.PartyType=='LoanGiven'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="GetSecurityTakenGLList();" ng-show="voucher.PartyType=='SecurityTaken'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="GetSecurityGivenGLList();" ng-show="voucher.PartyType=='SecurityGiven'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="GetEquityGLList();" ng-show="voucher.PartyType=='Equity'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="GetInvestmentGLList();" ng-show="voucher.PartyType=='InvestmentGiven'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="showBankPopUp();" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.Bank.ToString()'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="showCashPopUp(null, voucher.EntityId);" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.Cash.ToString()'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.Customer.ToString()'">
            <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select name="partyType" ng-model="voucher.InvoiceAdvance" class="col-sm-3 form-control">
                        <option value="Invoice">Invoice</option>
                        <option value="Advance">Advance</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-2 input-group">
                <span class="input-group-btn">
                    <button ng-click="showPartyPopUpNew();" ng-disabled="voucher.InvoiceAdvance==null" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.Customer.ToString()'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.Vendor.ToString()'">
            <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select name="partyType" ng-model="voucher.InvoiceAdvance" class="col-sm-3 form-control">
                        <option value="Invoice">Invoice</option>
                        <option value="Advance">Advance</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-2 input-group">
                <span class="input-group-btn">
                    <button ng-click="showPartyPopUpNew();" ng-disabled="voucher.InvoiceAdvance==null" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.Vendor.ToString()'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.Employee.ToString()'">
            <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select name="Transaction Type" ng-change="changeTransactionType()" class="form-control" ng-model="voucher.EmployeeTransactionTypeName" tabindex="7">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in employeeTransactionTypeList" value="{{option.EmployeeTransactionTypeName}}">{{option.EmployeeTransactionTypeName}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-2 input-group">
                <span class="input-group-btn">
                    <button ng-click="showEmployeeListPopUp();" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.Employee.ToString()'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.FixedAsset.ToString()'">
            <label class="col-sm-4 control-label">FA Type<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select name="partyType" ng-change="changePartyType(voucher.FAType)" ng-model="voucher.FAType" class="col-sm-3 form-control">
                        <option value="AssetCapatalized">Asset Capatalized</option>
                        <option value="AssetNonCapitalized">Asset Non-Capitalized</option>
                        <option value="AccDept">Accumulate Depreciation</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-2 input-group">
                <span class="input-group-btn">
                    <button ng-click="GetFAFAMList();" ng-show="voucher.FAType=='AssetCapatalized'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
                <span class="input-group-btn">
                    <button ng-click="GetFAAccDepList();" ng-show="voucher.FAType=='AccDept'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
                <span class="input-group-btn">
                    <button ng-click="GetFAAUCList();" ng-show="voucher.FAType=='AssetNonCapitalized'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.InterTransaction.ToString()'">
            <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="select-style">
                    <select name="Transaction Type" ng-change="changeInterTransactionType()" class="form-control" ng-model="voucher.TransactionTypeName" tabindex="7">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.TransactionTypeName}}">{{option.TransactionTypeName}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-2 input-group">
                <span class="input-group-btn">
                    <button ng-click="showInterPartyPopUp();" ng-show="voucher.PartyType=='@Library.Model.Parties.PartyType.InterTransaction.ToString()'" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="post();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="table-responsive modal-table ">
        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Type </th>
                    <th>GL </th>
                    <th>Budget</th>
                    <th>Activity</th>
                    <th>Particular</th>
                    <th>Detail</th>
                    <th class="text-center">Dr</th>
                    <th class="text-center">Cr</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in voucherDetailList">
                    <td>{{x.PartyType}}</td>
                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                    <td>{{x.BudgetName}}</td>
                    <td>{{x.ActivityName}}</td>
                    <td>{{x.ParticularName}}</td>
                    <td>
                        <input type="text" class="form-control text-right" id="BankCashAmount" ng-model="x.BankAmount " ng-disabled="x.BankCurrencyId==voucher.CurrencyId||x.CashCurrencyId==voucher.CurrencyId" n-decimals="4" tabindex="12" ng-show="x.BankMasterId||x.CashMasterId" placeholder="Input Currency Amount" autocomplete="off">
                        <select class="form-control" ng-disabled="x.PartyId==null||x.PartyType=='SecurityTaken'||x.PartyType=='SecurityGiven'||x.PartyType=='Equity'||x.PartyType=='InvestmentGiven'"
                                ng-hide="x.BankMasterId||x.CashMasterId" ng-model="x.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }:true"></select>
                    </td>
                    <td><input type="text" class="form-control text-right" ng-disabled="x.DrDisable" id="vdDrAmount" ng-model="x.DrAmount " n-decimals="2" tabindex="11" ng-change="checkDrAmount($index)" autocomplete="off"></td>
                    <td><input type="text" class="form-control text-right" ng-disabled="x.CrDisable" id="vdCrAmount" ng-model="x.CrAmount " n-decimals="2" tabindex="12" ng-change="checkCrAmount($index)" autocomplete="off"></td>
                    <td class="text-right">
                        <button ng-click="removeRow($index)" data-toggle="modal" ng-disabled="x.Id" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" class="text-right">Total</td>
                    <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'DrAmount' }}</b></td>
                    <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'CrAmount' }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

</div>
<div class="aplos-grid-toggle">
    <div class="row text-right ">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="voucherListParameters.searchBy">
                                <option ng-repeat="option in searchvoucherList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="voucherListParameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>DocRef No</th>
                    <th>Posting Date</th>
                    <th>DrAmount</th>
                    <th>CrAmount</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:voucherListParameters.pageSize" total-items="voucherListParameters.total_count" ng-dblclick="Clear();Get(x);getAllPartyPlantList(x.Id);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td class="text-right">{{x.DrAmount | number:2}}</td>
                    <td class="text-right">{{x.CrAmount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            @*<li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>*@
                            <li><a class="btn btn-action" href="Accounts/OpeningBalance/GetJournalVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&openingBalanceId={{x.Id}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
