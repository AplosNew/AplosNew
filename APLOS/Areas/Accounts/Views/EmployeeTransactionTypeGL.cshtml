<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Transaction Type GL</h3>
<div class="form-elements" ng-form id="employeeTransactionTypeGL" name="employeeTransactionTypeGLForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">COA<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="employeeTransactionTypeGL.COAId" ng-options="item.Value as item.Text for item in COAList" id="COAId" name="COA" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        </div>
        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="showAll('assing');setActiveBtn('assing');" class="btn ng-binding"><i class="glyphicon glyphicon-search"></i> All Assign</button></li>
                    <li><button ng-click="showAll('notassing');setActiveBtn('notassing');" class="btn ng-binding"><i class="glyphicon glyphicon-search"></i> Not Assign</button></li>
                    <li><button ng-click="showAll('all');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> All</button></li>
                </ul>
            </div>
            <div class="table-responsive modal-table col-xs-12" ng-show="employeeTransactionTypeGLWithCombineList.length>0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th style="vertical-align: middle; text-align:center" rowspan="2">Apply </th>
                            <th style="vertical-align: middle; text-align:center" rowspan="2">Employee Transaction Type</th>
                            <th style="text-align:center" colspan="3">Advance</th>
                            <th style="text-align:center" colspan="3">Payable</th>
                            <th style="vertical-align: middle; text-align:center" rowspan="2"> Untag</th>
                        </tr>
                        <tr>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="x in employeeTransactionTypeGLWithCombineList|itemsPerPage:$root.pageSize" total-items="$root.total_count">
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" id="{{x.employeeTransactionTypeId}}" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectChValueId($event,x)">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>
                                {{x.EmployeeTransactionTypeName}}
                            </td>
                            <td>
                                {{x.AssetGLCode}} - {{x.AssetGLText}}
                            </td>
                            <td>{{x.AdvanceBudgetName}}</td>
                            <td>{{x.AdvanceActivityName}}</td>
                            <td>
                                {{x.LiabilityGLCode}} - {{x.LiabilityGLText}}
                            </td>
                            <td>{{x.PayableBudgetName}}</td>
                            <td>{{x.PayableActivityName}}</td>
                            <td class="text-center">
                                <ul class="list-inline action-list">
                                    <li><button ng-disabled="x.Id ===null" ng-click="valuePassInDelModal(x,$index,$event)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
            </div>
        </div>
        <div class="col-xs-12 form-element-ctrl  form-horizontal">
            <br /><br />
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Advance</legend>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL<sup>*</sup></label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control" ng-model="ReconAssetGLInof" readonly>
                        </div>
                        <button name="submit" class="single-btn" ng-click="GetReconTypeList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshAssetGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="employeeTransactionTypeGL.AdvanceBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in advanceBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getAdvanceActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="employeeTransactionTypeGL.AdvanceActivityId" ng-options="item.ActivityId as item.ActivityName for item in advanceActivityList" id="ActivityId" name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Payable</legend>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL<sup>*</sup></label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control" ng-model="PayableGLInof" readonly>
                        </div>
                        <button name="submit" class="single-btn" ng-click="GetPayableTypeList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshPayableGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="employeeTransactionTypeGL.PayableBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in payableBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getPayableActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="employeeTransactionTypeGL.PayableActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in payableActivityList" id="ActivityId" name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_ReconTypeGL.cshtml")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_ReconLiabilityTypeGL.cshtml")
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteTestingStandardSavedItem()"></confirm-archive-generic>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="glUntag" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>