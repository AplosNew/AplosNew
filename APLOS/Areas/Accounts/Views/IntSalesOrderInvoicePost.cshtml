<style>
    .selected {
        background-color: rgba(234, 97, 83, 0.42) !important;
    }

    .angucomplete-dropdown {
        position: relative !important;
    }

    .alert-site {
        z-index: 99999 !important;
    }
</style>
<h3>Sales Order Invoice Post</h3>
<div class="form-elements  form-horizontal" ng-form id="voucher" name="intSaleOrderInvoicePostForm">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Transaction Data</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="address" role="tab" data-toggle="tab">Parallel Currency</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form name="invoiceCustomerForm1">
                <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Voucher Date<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control datepicker" tabindex="1" ng-change="checkVoucherDate()" disabled required>
                            <p ng-show="VoucherDateMessage" class="show-message">{{VoucherDateMessage}}</p>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Voucher Type<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="select-style">
                                <select id="vouchertypeId" class="form-control" name="vouchertype" ng-model="voucher.VoucherTypeId" tabindex="4" ng-change="onVoucherTypeChange(voucher.VoucherTypeId);getVoucherTypeValueText()" required>
                                    <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">

                    <div class="form-group">
                        <label class="col-sm-5 control-label">Posting Date<sup>*</sup></label>
                        <div class="col-sm-7">
                            <input id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" datepicker class="form-control datepicker" tabindex="3">
                            <p ng-show="postingDateMessage" class="show-message">{{postingDateMessage}}</p>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Narration<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <textarea type="text" name="Narration" class="form-control" ng-model="voucher.Narration" ng-blur="passNarration(voucher.Narration)" required capitalize tabindex="10"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-3 control-label">FiscalYear</label>
                        <div class="col-sm-3">
                            <input id="fiscalYearId" type="text" name="Fiscal Year" readonly ng-model="fiscalYearInfo.FiscalYearName" class="form-control">
                            <input type="hidden" name="Period" readonly ng-model="fiscalYearInfo.FiscalYearId" class="form-control">
                        </div>
                        <label class="col-sm-2 control-label">Period</label>
                        <div class="col-sm-4">
                            <input id="fiscalYearPeriod" type="text" name="Period" readonly ng-model="fiscalYearInfo.PeriodName" class="form-control">
                            <input type="hidden" name="Period" readonly ng-model="fiscalYearInfo.FiscalYearPeriodId" class="form-control">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"> TaxExcluding</label>
                        <div class="checkbox-site">
                            <label class="col-sm-8">
                                <input type="checkbox" id="IsExcludingTax" ng-model="voucher.IsExcludingTax" tabindex="5">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="clearfix">
                </div>
                <div>
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Customer Information</legend>
                        <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal ">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Customer :</label>
                                <label class="col-sm-8 control-label">{{partyName}}</label>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <div>
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Material HSN Tax</legend>
                        <div class="table-responsive modal-table ">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Material</th>
                                        <th>HSNCode</th>
                                        <th>Qty</th>
                                        <th>Rate</th>
                                        <th>Total Amount</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in materialHSNCodeTaxes ">
                                        <td>{{x.MaterialName}}</td>
                                        <td>{{x.HSNCode}}</td>
                                        <td>{{x.Qty}}</td>
                                        <td>{{x.Rate}}</td>
                                        <td class="text-right">{{x.Amount}}</td>
                                        <td>
                                            <button class="btn btn-action" ng-click="getHSNTax(x)" tabindex="10">Tax Detail</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <br />
                        <h5> Tax</h5>
                        <div class="table-responsive modal-table ">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>HSNCode</th>
                                        <th>Tax Category</th>
                                        <th> Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in HSNCodeTaxes ">
                                        <td>{{x.HSNCode}}</td>
                                        <td>{{x.TaxCategoryName}}</td>
                                        <td class="text-right">{{x.TaxAmount}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </fieldset>
                </div>

                <div class="row">
                    <div class="col-xs-12 form-horizontal">
                    </div>
                </div>
                <br />
                <div class="table-responsive modal-table ">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL Code</th>
                                <th>GL</th>
                                <th>Doc No</th>
                                <th>Doc Date</th>
                                <th>Dr</th>
                                <th>Cr</th>
                                <th>Currency</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in saleOrderInvoiceEdit |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                                <td>{{x.COAICode}}</td>
                                <td>{{x.COAIText}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.DocDate| dateFiltering}}</td>
                                <td class="text-right">{{x.Amount|number:2}}</td>
                                <td></td>
                                <td>{{x.CurrencyCode}}</td>
                            </tr>
                            <tr ng-repeat="x in saleOrderInvoiceSales">
                                <td>{{x.COAICode}}</td>
                                <td>{{x.COAIText}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.DocDate| dateFiltering}}</td>
                                <td></td>
                                <td class="text-right">{{x.Amount|number:2}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td><button class="btn btn-action" ng-click="getTaxCode($index)" tabindex="10">Tax</button></td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }" ng-form name="invoiceCustomerForm4">
                <div class="tab-design" id="tab_show_detail">
                    <div class="site-tab">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" ng-class="{ active: isSetdetail(5) }"><a ng-click="setTabdetail(5)" href aria-controls="general" role="tab" data-toggle="tabdetail">Company Currency</a></li>
                            <li role="presentation" ng-class="{ active: isSetdetail(6) }"><a ng-click="setTabdetail(6)" href aria-controls="group" role="tab" data-toggle="tabdetail">Group Currency</a></li>
                            <li role="presentation" ng-class="{ active: isSetdetail(7) }"><a ng-click="setTabdetail(7)" href aria-controls="hard" role="tab" data-toggle="tabdetail">Hard Currency</a></li>
                        </ul>
                    </div>
                    <div class="tab-content">
                        <!-- #region SubTab 1 -->
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetdetail(5), active: isSetdetail(5) }">
                            <b ng-show="CompanyCurrency.ParallelCurrencyType=='CompanyCurrency'" ng-repeat="CompanyCurrency in CurrencyParallel "><span>{{CompanyCurrency.Code }}</span></b>
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Company Currency</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-show="x.ParallelCurrencyType=='CompanyCurrency'" ng-repeat="x in CurrencyParallel ">
                                            <td>{{x.Code}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <br />
                            <div class="clearfix"></div>
                            <div class="row">
                                <div class="table-responsive modal-table voucher-table">
                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>GL Code</th>
                                                <th>GL</th>
                                                <th>DR</th>
                                                <th>CR</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-show="x.ParallelCurrencyType=='CompanyCurrency'" ng-repeat="x in invoiceDetailCurrencyrow|filter:{Active:true}" ng-click="GetVoucherDetailrow(x,x.Id, $index)">
                                                <td>{{x.COAICode}}</td>
                                                <td>{{x.COAIText}}</td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.DrAmount " /></td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.CrAmount" /></td>
                                            </tr>
                                            <tr ng-show="x.ParallelCurrencyType=='CompanyCurrency'" ng-repeat="x in voucherDetailCurrencyrow|filter:{Active:true}" ng-click="GetVoucherDetailrow(x,x.Id, $index)">
                                                <td>{{x.COAICode}}</td>
                                                <td>{{x.COAIText}}</td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.DrAmount " /></td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.CrAmount" /></td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" class="text-right"><strong>Total Amount</strong></td>
                                                <td class="text-right" id="ToatalDrBase"><strong>{{Drtbase | number : 4}}</strong></td>
                                                <td class="text-right" id="ToatalCrBase"><strong>{{Crtbase | number : 4}}</strong></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- #endregion -->
                        <!-- #region SubTab 2 -->
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetdetail(6), active: isSetdetail(6) }">
                            <b ng-show="a.ParallelCurrencyType=='CompanyGroupCurrency'" ng-repeat="a in currencyexchangerate "><span>{{a.Code }}</span></b>
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>From Currency Unit</th>
                                            <th>From Currency</th>
                                            <th>To Currency Rate</th>
                                            <th>To Currency</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-show="x.ParallelCurrencyType=='CompanyGroupCurrency'" ng-repeat="x in currencyexchangerate " ng-init="FromCurrency=x.Code">
                                            <td>{{x.FromCurrencyUnit}}</td>
                                            <td>{{x.Code}}</td>
                                            <td>{{x.ToCurrencyRate}}</td>
                                            <td>{{x.ToCurrency}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <br />
                            <div class="clearfix"></div>
                            <div class="row">
                                <div class="table-responsive modal-table voucher-table">
                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>GL Code</th>
                                                <th>GL</th>
                                                <th>DR</th>
                                                <th>CR</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-show="x.ParallelCurrencyType=='CompanyGroupCurrency'" ng-repeat="x in invoiceDetailCurrencyrow|filter:{Active:true}" ng-click="GetVoucherDetailrow(x,x.Id, $index)">
                                                <td>{{x.COAICode}}</td>
                                                <td>{{x.COAIText}}</td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.DrAmount " /></td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.CrAmount" /></td>
                                            </tr>
                                            <tr ng-show="x.ParallelCurrencyType=='CompanyGroupCurrency'" ng-repeat="x in voucherDetailCurrencyrow|filter:{Active:true}" ng-click="GetVoucherDetailrow(x,x.Id, $index)">
                                                <td>{{x.COAICode}}</td>
                                                <td>{{x.COAIText}}</td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.DrAmount " /></td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.CrAmount" /></td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" class="text-right"><strong>Total Amount</strong></td>
                                                <td class="text-right" id="ToatalDr"><strong>{{Drtgroup| number : 4 }}</strong></td>
                                                <td class="text-right" id="ToatalCr"><strong>{{Crtgroup | number : 4}}</strong></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- #endregion -->
                        <!-- #region SubTab 3 -->
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetdetail(7), active: isSetdetail(7) }">
                            <b ng-show="a.ParallelCurrencyType=='HardCurrency'" ng-repeat="a in currencyexchangerate "><span>{{a.Code }}</span></b>
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>From Currency Unit</th>
                                            <th>From Currency</th>
                                            <th>To Currency Rate</th>
                                            <th>To Currency</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-show="x.ParallelCurrencyType=='HardCurrency'" ng-repeat="x in currencyexchangerate ">
                                            <td>{{x.FromCurrencyUnit}}</td>
                                            <td>{{x.Code}}</td>
                                            <td>{{x.ToCurrencyRate}}</td>
                                            <td>{{x.ToCurrency}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <br />
                            <div class="clearfix"></div>
                            <div class="row">
                                <div class="table-responsive modal-table voucher-table">
                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>GL Code</th>
                                                <th>GL</th>
                                                <th>DR</th>
                                                <th>CR</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            <tr ng-show="x.ParallelCurrencyType=='HardCurrency'" ng-repeat="x in invoiceDetailCurrencyrow|filter:{Active:true}" ng-click="GetVoucherDetailrow(x,x.Id, $index)">
                                                <td>{{x.COAICode}}</td>
                                                <td>{{x.COAIText}}</td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.DrAmount " /></td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.CrAmount" /></td>
                                            </tr>
                                            <tr ng-show="x.ParallelCurrencyType=='HardCurrency'" ng-repeat="x in voucherDetailCurrencyrow|filter:{Active:true}" ng-click="GetVoucherDetailrow(x,x.Id, $index)">
                                                <td>{{x.COAICode}}</td>
                                                <td>{{x.COAIText}}</td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.DrAmount " /></td>
                                                <td><input type="text" class="form-control text-right" ng-model="x.CrAmount" /></td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" class="text-right"><strong>Total Amount</strong></td>
                                                <td class="text-right" id="ToatalDr"><strong>{{Drthard| number : 4}}</strong></td>
                                                <td class="text-right" id="ToatalCr"><strong>{{Crthard| number : 4}}</strong></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- #endregion -->
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 form-horizontal">
                    <div class="form-group">
                        <div class="col-sm-6">
                        </div>
                        <div class="col-sm-6">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li>
                                        <button ng-click="Post();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button>
                                    </li>
                                    <li>
                                        <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="texCodePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="taxCodeForm">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeTaxCodePopUp()">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Tax Code</h4>
            </div>
            <div class="modal-body">
                <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
                    <div class="common-btn">
                        <div class="form-group" show-errors>
                            <label class="col-sm-3 col-md-2 control-label">Tax Code<sup>*</sup></label>
                            <div class="col-sm-4  show-message">
                                <div class="select-style">
                                    <select name="Buyer" ng-model="taxCode.Id" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in taxCodCboList" required ng-change="ontaxCodeChange(taxCode.Id);">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-default" ng-click="addTaxCodeonList();">Add</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>UserName</th>
                                <th>Description</th>
                                <th>Sequence</th>
                                <th>TaxAuto</th>
                                <th>Tax </th>
                                <th><i class="glyphicon glyphicon-trash"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in taxCodDataList">
                                <td>{{x.Code}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.Description}}</td>
                                <td><input type="number" class="form-control" ng-model="x.Sequence" /></td>
                                <td><input type="number" class="form-control" ng-model="x.TaxAutoAmount" ng-disabled="true" /></td>
                                <td><input type="number" class="form-control" ng-disabled="!x.ManuallyEditable" ng-model="x.TaxAmount" /></td>
                                <td class="table-td">
                                    <button ng-click="taxCodeDelModal(x.TaxCodeId,x.UserName)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                        <i class="glyphicon glyphicon-remove"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            @*<div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="culculateTax()">Calculate</button>
                </div>*@
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="vendorInvoiceTaxPush();vendorInvoiceTaxGLIncludePush();vendorInvoiceTaxGLExcludePush();closeTaxCodePopUp()">Done</button>
            </div>
        </div>
    </div>
</div>
<toaster-container toaster-options="{'close-button':true, 'animation-class': 'toast-top-center'}"></toaster-container>
<confirm-modal></confirm-modal>