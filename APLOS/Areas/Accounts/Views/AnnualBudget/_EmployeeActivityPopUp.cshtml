<style>

    .modellgModify {
        width: 1250px;
    }
</style>
<div class="modal fade site-modal in" id="employeeActivityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">
                Employee Activity List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                @*<th>Position</th>*@
                                <th>EmpType</th>
                                <th>Designation</th>
                                <th>Department</th>
                                <th>DOJ</th>
                                <th>DOB</th>
                                <th style="width:10%;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in employeeList | filter :{ActivityId: activityId }">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                @*<td>{{x.PositionName}}</td>*@
                                <td>{{x.EmpType}}</td>
                                <td>{{x.DesignationName}}</td>
                                <td>{{x.DepartmentName}}</td>
                                <td>{{x.DOJ}}</td>
                                <td>{{x.DOB}}</td>
                                <td><input type="text" only-numbers ng-model="x.Amount" class="form-control text-right"></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="6" class="text-right">Total</td>
                                <td class="text-right"><b>{{ (employeeList ) | sumByKey:'Amount' }}</b></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button class="btn" data-dismiss="modal"><i class=""></i> OK</button>
            </div>
        </div>
    </div>
</div>