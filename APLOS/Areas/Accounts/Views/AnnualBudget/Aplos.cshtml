<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Budget</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Budget Limit</th>
                <th>PaymentVoucherType</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @*<tr dir-paginate="x in routinebudgets |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">*@
            <tr ng-repeat="x in routinebudgets" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.BudgetCodeName}}</td>
                <td>{{x.CurrencyName}}</td>
                <td>{{x.Amount}}</td>
                <td>{{x.BudgetLimit}}</td>
                <td>{{x.PaymentVoucherType}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    @*<dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>*@
</div>
<div class="modal fade site-modal in" id="employeepopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Search ({{popUpTitle}}) Data
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="$root.parameters.searchBy">
                                            <option ng-repeat="option in sbEmployeeInformation" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="loadEIData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadEIData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped text-left">
                        <thead>
                            <tr>
                                <th ng-repeat="h in sbEmployeeInformation">{{h.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeinformationData  |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'employeeinformationData'" ng-dblclick="getEmployee(x);">
                                <td ng-repeat="hh in sbEmployeeInformation">{{x[hh.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls pagination-id="metaData.name + 'employeeinformationData'"
                                             max-size="2" direction-links="true"
                                             boundary-links="true" on-page-change="loadEIData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="bdgPopUpDelete" title="Confirmation" message={{bdgConfirmMessage}} data-ng-click-right-button="confirmBdgAmntRemoveRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="respPopUpDelete" title="Confirmation" message={{respConfirmMessage}} data-ng-click-right-button="removeResponsiblePersonDetail()"></confirm-archive-generic>
<confirm-archive-generic modalid="activityPopUpDelete" title="Confirmation" message={{activityConfirmMessage}} data-ng-click-right-button="confirmactivityRemoveRow()"></confirm-archive-generic>
