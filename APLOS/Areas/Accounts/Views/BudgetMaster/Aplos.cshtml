<togglable name="Budget Master"></togglable>
<div class="form-horizontal">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl" ng-form name="budgetMaster0">
        <div class="form-group" show-errors>
            <label class="col-sm-3 col-md-2 control-label">COA<sup>*</sup></label>
            <div class="col-sm-3 col-md-4  show-message">
                <div class="select-style">
                    <select class="form-control" submit-required="true" ng-model="budgetMaster.COAId"
                            ng-change="onCOAChange(budgetMaster.COAId);" ng-options="item.Value as item.Text for item in cOAList">
                        <option value=""></option>
                    </select>
                </div>
                <p ng-show="selectMessage" style="color:red" class="show-message">{{selectMessage}}</p>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements" ng-form id="budgetMaster" name="budgetMasterForm">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="budget" role="tab" data-toggle="tab">Budget</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="contact" role="tab" data-toggle="tab">Payment Method</a></li>
                    <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="activity" role="tab" data-toggle="tab">Activity</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form name="budgetMaster1">
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Budget Group <sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" name="Budget Group" ng-model="budgetMaster.BudgetGroupId" tabindex="1" required>
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in budgetGroupList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Budget Subcategory</label>
                                <div class="col-sm-8 ">
                                    <div class="select-style">
                                        <select id="BudgetSubCategoryId" class="form-control" name="BudgetSubCategory" ng-model="budgetMaster.BudgetSubCategoryId" tabindex="3">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in BudgetSubCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Register <sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" name="Register" ng-model="budgetMaster.RegisterId" tabindex="5" required>
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in registerList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Transaction Parameter</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select id="transactionParameter" class="form-control" name="Bank Master" ng-model="budgetMaster.TransactionParameter" tabindex="16">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in transactionParameterList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Is Project</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="budgetMaster.IsProject" tabindex="7">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Is Capital</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="budgetMaster.IsCapital" tabindex="7">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Is OrderSpecific</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="budgetMaster.IsOrderSpecific" tabindex="7">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Active</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="budgetMaster.Active" tabindex="9">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal form-elements">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Budget Category</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select id="BudgetCategoryId" class="form-control" name="BudgetGroup" ng-model="budgetMaster.BudgetCategoryId" tabindex="2">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in BudgetCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Budget<sup>*</sup></label>
                                <div class="col-sm-8  show-message">
                                    <div class="select-style">
                                        <select id="BudgetId" class="form-control" name="Budget" ng-model="budgetMaster.BudgetId" tabindex="4" required>
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in BudgetList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">GL<sup>*</sup></label>
                                <div class="col-sm-6 show-message">
                                    <input type="text" class="form-control" ng-model="budgetMaster.GLGeneralInfoName" readonly />
                                    <input type="hidden" class="form-control" ng-model="budgetMaster.GLGeneralInfoId">
                                </div>
                                <div class="col-sm-2 show-message">
                                    <button class="btn single-btn tooltip-here" data-placement="top" title="GL Change" name="GL" ng-click="GetCOAICodeList()" tabindex="6"><i class="fa fa-search"></i></button>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Ref No<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input id="RefNo" type="text" name="RefNo" ng-model="budgetMaster.RefNo" class="form-control" tabindex="13" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" name="Remarks" maxlength="250" rows="3" ng-model="budgetMaster.Remarks" tabindex="8"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row" ng-form name="budgetMaster2">
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Payment VoucheType</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select id="AprovalCategory" class="form-control" name="Payment VoucherType" ng-model="budgetMaster.PaymentVoucherType" tabindex="1">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in PaymentVoucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Narration Editable</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" name="Narration Editable" id="IsNarrationEditable" ng-model="budgetMaster.IsNarrationEditable" checked="{{budgetMaster.IsNarrationEditable}}" tabindex="3">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Carry forward</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="IsCarryfoward" ng-model="budgetMaster.IsCarryfoward" checked="{{budgetMaster.IsCarryfoward}}" tabindex="5">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Is Party Listing</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" name="IsParty Listing" id="IsPartyListing" ng-model="budgetMaster.IsPartyListing" checked="{{budgetMaster.IsPartyListing}}" tabindex="6">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal form-elements">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Narration</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" name="Narration" maxlength="250" rows="3" ng-model="budgetMaster.Narration" tabindex="2" capitalize></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" name="Remarks" maxlength="250" rows="3" ng-model="budgetMaster.Remarks" tabindex="4"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <h4 class="site-heading">&nbsp;&nbsp; Payment Type</h4>
                        <div class="col-xs-12 col-sm-5 col-md-5 form-element-ctrl form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-2 control-label">Up to<sup>*</sup></label>
                                <div class="col-sm-7">
                                    <input type="number" ng-model="budgetPaymentTypeNew.UpToMonth" name="Percentage" class="form-control" tabindex="7">
                                </div>
                                <label class="control-label">of the Month</label>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Payment after<sup>*</sup></label>
                                <div class="col-sm-7">
                                    <input type="number" ng-model="budgetPaymentTypeNew.PaymentAfterDays" name="Percentage" class="form-control" tabindex="8">
                                </div>
                                <label class="control-label">Days</label>
                            </div>
                        </div>
                        <button ng-click="addRowPaymentType()" class="btn single-small-btn"><i class="glyphicon glyphicon-plus-sign"></i></button>
                        <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table" ng-show="budgetPaymentTypeList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Up-to Payment</th>
                                        <th>After Days</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in budgetPaymentTypeList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.UpToMonth}}</td>
                                        <td>{{x.PaymentAfterDays}}</td>
                                        <td class="text-right">
                                            <button ng-click="getEditBdgPaymentRow($index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Edit">
                                                <i class="glyphicon glyphicon-edit"></i>
                                            </button>
                                            <button ng-click="bdgPaymentRemoveRow($index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                    <div class="row" ng-form name="budgetMaster3">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <ul class="common-btn list-inline text-left">
                                <li>
                                    <button hidden ng-click="ShowActivityList();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add Activity</button>
                                </li>
                                <li>
                                    <button ng-click="showActivityAdd();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add New Activity</button>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table" ng-show="budgetActivityList.length">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>
                                        <th>User Name</th>
                                        <th>Specific</th>
                                        <th>Default</th>
                                        <th>Active</th>
                                        <th>FA Linked</th>
                                        <th>FA Item</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in budgetActivityList track by $index " ng-class="{selected : x.Id==null}">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td>{{x.IsSpecific?'Yes':'No'}}</td>
                                        <td>{{x.IsDefault?'Yes':'No'}}</td>
                                        <td>{{x.Active?'Yes':'No'}}</td>
                                        <td>{{x.FALinked}}</td>
                                        <td>
                                            <div class="col-sm-12 input-group">
                                                <input type="text" ng-model="x.BudgetMasterActivityFixedAssetViewModel.length" class="form-control text-right" readonly>
                                                <span class="input-group-btn">
                                                    <button ng-disabled="!x.IsFABased" ng-click="faPopUpShow(x, $index)" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="text-right">
                                            <button class="btn single-btn tooltip-here" data-placement="top" title="Service Applicable" name="GL" ng-show="x.IsServiceApplicable" ng-click="GetCOAICodeList()" tabindex="6"><i class="fa fa-search"></i></button>

                                            <button ng-disabled="!x.IsSpecific||x.Id==null" ng-click="activityEdit($index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Edit">
                                                <i class="glyphicon glyphicon-edit"></i>
                                            </button>
                                            <button ng-click="activityRemoveRow($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove" ng-disabled="x.IsDefault">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>

                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk" tabindex="29"></i> {{Action}}</button></li>
                <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="30"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn" tabindex="31"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>GL</th>
                <th>Budget Group</th>
                <th>Budget Category</th>
                <th>Budget Subcategory</th>
                <th>Budget</th>
                <th>RefNo</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in budgetMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                <td>{{x.BudgetGroup}}</td>
                <td>{{x.BudgetCategory}}</td>
                <td>{{x.BudgetSubCategory}}</td>
                <td>{{x.BudgetName}}</td>
                <td>{{x.RefNo}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("_ConfirmModal")
@Html.Partial("~/Areas/Accounts/Views/BudgetMaster/_ActivityFAMasterPopUp.cshtml")
@Html.Partial("_FAMasterPopUp")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_ActivityPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_ActivityAddPopUp.cshtml")
<confirm-archive-generic modalid="activityDeletePopUp" title="Confirmation" message={{activityConfirmMessage}} data-ng-click-right-button="confirmActivityRemoveRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmgenericPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="payPopUpDelete" title="Confirmation" message={{payConfirmMessage}} data-ng-click-right-button="removePayment()"></confirm-archive-generic>
<confirm-archive-generic modalid="faMasterDeletePopUp" title="Confirmation" message={{activityConfirmMessage}} data-ng-click-right-button="removeFaMasterRow()"></confirm-archive-generic>