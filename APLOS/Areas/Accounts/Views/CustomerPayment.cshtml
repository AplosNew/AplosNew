<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">@Library.Model.Parties.PartyType.Customer.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="@Library.Model.Parties.PartyType.Customer.ToString()" ng-model="advance.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Location<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="1" class="form-control" name="Ordering @Library.Model.Parties.PartyType.Customer.ToString()" ng-model="advance.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(advance.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input ng-click="clearBankPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
                <label>
                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-3 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="BankName" ng-model="advance.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{advance.BankName}}" tooltip>
                    <span class="input-group-btn">
                        <button ng-click="showBankPopUp(advance.EntityId);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-3 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="advance.CashName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showCashPopUp(null, advance.EntityId);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <textarea rows="1" type="text" name="Narration" tabindex="13" class="form-control" ng-model="advance.Narration" required autocomplete="off" capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="VoucherDate" ng-model="advance.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-3 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="advance.PostingDate" class="form-control" tabindex="2">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="DocDate" ng-model="advance.DocDate" datepicker="checkPostingDate();checkDocDate();" required class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group" id="div_qty">
            <label class="col-sm-3 control-label">Deposit<sup>*</sup></label>
            <div class="col-sm-6 show-message" style="padding-right:0px;">
                <input ng-disabled="advance.JournalId" tabindex="11" ng-model="advance.Amount" ng-change="copyAmount();" type="text" n-decimals="2" class="form-control text-right">
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="12" name="CurrencyTransaction" ng-model="advance.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();">
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="isBankAmount">
            <label class="col-sm-3 control-label">Bank Amount<sup>*</sup></label>
            <div class="col-sm-9">
                <input type="text" n-decimals="2" class="form-control text-right" name="Amount" ng-model="advance.BankAmount">
            </div>
        </div>
        <div class="form-group" id="div_ReviewDate">
            <label class="col-sm-3 control-label">Review Date</label>
            <div class="col-sm-9 show-message">
                <input type="text" id="Review Date" name="Review Date" ng-model="advance.ReviewDate" datepicker="checkReviewDate();" class="form-control" tabindex="7">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="advance.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(advance.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="entity" ng-model="advance.EntityId" tabindex="6" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" id="Doc Ref" name="Doc Ref" ng-model="advance.DocRefNo" class="form-control" tabindex="5" required autocomplete="off" capitalize>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Rate<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" id="Rate" name="Rate" n-decimals="4" ng-model="advance.CompanyCurrencyRate" ng-keyup="copyAmount();rateChange(advance.CompanyCurrencyRate);rateChangeBankCharge(advance.CompanyCurrencyRate)" class="form-control text-right" tabindex="6" required autocomplete="off" ng-disabled="advance.CurrencyId==companyCurrencyId">
            </div>
        </div>
        <div class="form-group">
            <label title="Responsible Person" class="col-sm-3 control-label">Res.Person</label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input type="text" name="Responsible Person" ng-model="advance.ResponsiblePerson" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearEmployeePopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6 modal-table">
        <table class="table table-responsive table-striped">
            <caption>Receipt</caption>
            <thead>
                <tr>
                    <th>Payment Type</th>
                    <th>Trn. Amount</th>
                    <th>{{companyCurrencyCode}}</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_PaymentType">
                        <div class="show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="advanceDetail.PaymentType" ng-options="item.Value as item.Text for item in paymentTypeList"></select>
                            </div>
                        </div>
                    </td>
                    <td id="td_PaymentAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="advanceDetail.Amount" ng-keyup="copyDetailAmount();">
                        </div>
                    </td>
                    <td id="td_PaymentCompanyCurrencyAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" readonly ng-model="advanceDetail.CompanyCurrencyAmount">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addPayment();" class="btn"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in advanceDetailList">
                    <td>{{x.PaymentType}}</td>
                    <td class="text-right">{{x.Amount | number:2 }}</td>
                    <td class="text-right">{{x.CompanyCurrencyAmount | number:2}}</td>
                    <td class="text-right">
                        <button ng-click="removeRow($index)" ng-disabled="x.AdvanceId" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="advanceDetailList.length">
                <tr>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ advanceDetailList | sumByKey : 'Amount' }}</b></td>
                    <td class="text-right"><b>{{ advanceDetailList | sumByKey : 'CompanyCurrencyAmount'  }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 modal-table" ng-hide="true">
        <table class="table table-responsive table-striped">
            <caption>Charges</caption>
            <thead>
                <tr>
                    <th>Charges Type</th>
                    <th>Trn. Amount</th>
                    <th>{{companyCurrencyCode}}</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_FinancingType">
                        <div class="select-style show-message">
                            <select ng-model="advanceCharge.FinancingTypeId">
                                <option ng-repeat="option in bankChargeTypeList" value="{{option.FinancingTypeId}}">{{option.ExpensesUserName}}</option>
                            </select>
                        </div>
                    </td>
                    <td id="td_FinancingTypeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="advanceCharge.Amount" ng-keyup="copyChargesAmount();">
                        </div>
                    </td>
                    <td id="td_FinancingTypeCompanyCurrencyAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="advanceCharge.CompanyCurrencyAmount">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addCharge();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in advanceChargesList">
                    <td>{{x.FinancingTypeName}}</td>
                    <td class="text-right">{{x.Amount | number:2 }}</td>
                    <td class="text-right">{{x.CompanyCurrencyAmount | number:2}}</td>
                    <td class="text-right">
                        <button ng-click="removeChargesRow($index)" ng-disabled="x.AdvanceId" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="advanceChargesList.length">
                <tr>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ advanceChargesList | sumByKey : 'Amount' }}</b></td>
                    <td class="text-right"><b>{{ advanceChargesList | sumByKey : 'CompanyCurrencyAmount'  }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="advance.Id==null"><button ng-click="confirmPost(advance.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>@Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Ordering @Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Posting Date</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Set-off Amount</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>{{x.PartyPlantName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                    <td class="text-right">{{x.WrittenOffAmount | number:2}}</td>
                    <td class="text-right">{{x.Amount-x.WrittenOffAmount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/GetCustomerPaymentReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/GetCustomerPaymentReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Banks/Views/_CashPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_AdvanceJournalPopUp.cshtml")
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(advanceId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmUnPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="unPost(advanceId)"></confirm-archive-generic>