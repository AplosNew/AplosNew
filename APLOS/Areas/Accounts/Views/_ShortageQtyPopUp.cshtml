<style>
    .modellgModify {
        width: 1000px;
    }
</style>
<div class="modal fade site-modal in" id="shortagePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content" ng-form name="PopUpForm1">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="VoucherDate" ng-model="shortageQtyData.VoucherDate" datepicker class="form-control" disabled>
                            </div>
                        </div>
                        <div class="form-group" ng-show="shortageQtyData.GRNNo">
                            <label class="col-sm-4 control-label">GRN No<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="50" name="Doc Ref" ng-model="shortageQtyData.GRNNo" class="form-control" tabindex="4" readonly>
                            </div>
                        </div>
                        <div class="form-group" >
                            <label class="col-sm-4 control-label">DocRef No<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="50" name="Doc Ref" ng-model="shortageQtyData.DocRefNo" class="form-control" tabindex="4" readonly>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Status<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="50" name="Doc Ref" ng-model="shortageQtyData.IsTDSTaxPost" class="form-control" tabindex="4" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="VoucherType" class="form-control" name="VoucherType" ng-model="shortageQtyData.VoucherTypeId" ng-disabled="shortageVoucherTypeList.length==1" tabindex="7">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in shortageVoucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div id="div_PostingDate" class="form-group" ng-show="shortageQtyData.GRNNo">
                            <label class="col-sm-4 control-label">GRN Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input datepicker id="postingDate" type="text" name="Posting Date" ng-model="shortageQtyData.GRNDate" class="form-control" readonly>
                            </div>
                        </div>
                        <div id="div_TransactionType" class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select ng-change="getShortageValueJournal(shortageQtyData.Id,shortageQtyData.FinancingTypeId)" name="Transaction Type" class="form-control" ng-model="shortageQtyData.FinancingTypeId" tabindex="7" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in financingTypeList" value="{{option.FinancingTypeId}}">{{option.LiabilityUserName}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div  class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="50" name="Doc Ref" ng-model="shortageQtyData.EntityName" class="form-control" tabindex="4" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>GL</th>
                                        <th>Budget</th>
                                        <th>Activity</th>
                                        <th>Dr</th>
                                        <th>Cr</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in shortageValueJournalList| orderBy:'Dr'">
                                        <td>{{x.GLName}}</td>
                                        <td>{{x.BudgetName}}</td>
                                        <td>{{x.ActivityName}}</td>
                                        <td class="text-right">{{x.DrAmount | number| setDecimal:4}}</td>
                                        <td class="text-right">{{x.CrAmount | number| setDecimal:4}}</td>
                                    </tr>
                                    <tr>
                                        <td colspan="3"></td>
                                        <td class="text-right"><strong>{{shortageValueJournalList | sumByKey : 'DrAmount' | number| setDecimal:4}}</strong></td>
                                        <td class="text-right"><strong>{{shortageValueJournalList | sumByKey : 'CrAmount' | number| setDecimal:4}}</strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-disabled="shortageQtyData.DebitNoteVoucherId==null" ng-click="ShortageDebitNotePrint();">Print</button>
                <button type="button" class="btn btn-default" ng-disabled="shortageQtyData.DebitNoteVoucherId!=null" ng-click="postShortageDebitNote();">Post</button>
                <button type="button" class="btn btn-default" ng-show="shortageQtyData.IsShortagePost=='ShortageParked' && shortageQtyData.DebitNoteVoucherId==null" ng-click="onClickTDSDeletePopUp(shortageQtyData);">DN Delete</button>
                <button type="button" class="btn btn-default" ng-show="shortageQtyData.IsShortagePost=='ShortagePosted' && shortageQtyData.DebitNoteVoucherId!=null" ng-click="onClickTDSPostDeletePopUp(shortageQtyData);">Post Delete</button>
                <button type="button" class="btn btn-default" ng-click="closeShortageQtyPopUp();">Close</button>
            </div>
        </div>
    </div>
</div>