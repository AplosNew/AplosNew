<div class="modal fade site-modal in" id="advanceJournalPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Advance List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="advanceInterTransactionParameters.searchBy">
                                            <option ng-repeat="option in advanceInterTransactionSearchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="advanceInterTransactionParameters.search" ng-enter="getAdvanceInterTransactionList()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getAdvanceInterTransactionList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>AdvanceNo</th>
                                <th>Company</th>
                                <th>Plant</th>
                                <th>Customer</th>
                                <th>Ordering Customer</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in advanceInterTransactionList |itemsPerPage:advanceInterTransactionParameters.pageSize" pagination-id="metaData.name + 'advanceInterTransactionList'" total-items="advanceInterTransactionParameters.total_count"
                                ng-dblclick="closeAdvanceInterTransactionPopUp(x);" ng-class="{selected : x.AdvanceDetailId == selectedAdvanceId}">
                                <td>{{x.AdvanceNo}}</td>
                                <td>{{x.CompanyName}}</td>
                                <td>{{x.PlantName}}</td>
                                <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                                <td>{{x.PartyPlantName}}</td>
                                <td class="text-right">{{x.NetAmount | number:2}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'advanceInterTransactionList'" direction-links="true" boundary-links="true" on-page-change="getCustomerAdvanceData(newPageNumber)"></dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="hideAdvanceInterTransactionPopUp()">Select</button>
            </div>
        </div>
    </div>
</div>