<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Balance Sheet Opening Balance Report
</h3>
<div class="form-elements form-horizontal" ng-form id="form" name="form">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Fiscal Year<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Fiscal Year Type" class="form-control" submit-required="true" ng-model="balanceSheet.FiscalYearId"
                            ng-options="item.Value as item.Text for item in fiscalYearList" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Budget</label>
            <div class="checkbox-site">
                <label class="col-sm-9">
                    <input type="checkbox" id="IsBudgetLevel" ng-model="balanceSheet.IsBudgetLevel" ng-click="uncheck()">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Activity</label>
            <div class="checkbox-site">
                <label class="col-sm-9">
                    <input type="checkbox" id="IsActivityLevel" ng-model="balanceSheet.IsActivityLevel" ng-disabled="!balanceSheet.IsBudgetLevel" ng-checked="balanceSheet.IsActivityLevel">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="balanceSheetObReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
        </ul>
    </div>
</div>
