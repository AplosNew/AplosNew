<togglable name="{{title}}"></togglable>
<div class="form-horizontal form-elements" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group">
            <label class="col-sm-4 control-label">Party Type<sup>*</sup></label>
            <div class="radio col-sm-8">
                <label>
                    <input ng-click="changeSourceTo('Customer')" type="radio" name="sourceParty" ng-model="voucher.PartyType" value="@Library.Model.Parties.PartyType.Customer.ToString()">
                    <span class="cr" tabindex="11"><i class="cr-icon"></i></span>@Library.Model.Parties.PartyType.Customer.ToString()
                </label>
                <label>
                    <input ng-click="changeSourceTo('Vendor')" type="radio" name="sourceParty" ng-model="voucher.PartyType" value="@Library.Model.Parties.PartyType.Vendor.ToString()">
                    <span class="cr" tabindex="11"><i class="cr-icon"></i></span>@Library.Model.Parties.PartyType.Vendor.ToString()
                </label>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group">
            <div class="col-sm-12 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="PartyName" ng-model="voucher.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getCustomerGL();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Location<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="4" class="form-control" name="Ordering Party" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(voucher.InvoicingPartyPlantId,'billTo')" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(voucher.PartyPlantId);" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input tabindex="7" type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="11" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type" tooltip>Security Type<sup>*</sup></label>
            <div class="radio col-sm-8 col-xs-8">
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('SecurityGiven')" ng-model="voucher.TransactionType" value="SecurityGiven">
                    <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Given
                </label>
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('SecurityTaken')" ng-model="voucher.TransactionType" value="SecurityTaken">
                    <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Taken
                </label>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input ng-click="changeSourceFrom('Bank')" type="radio" name="source" ng-model="voucher.PaymentSource" value="Bank">
                    <span class="cr" tabindex="22"><i class="cr-icon"></i></span>Bank
                </label>
                <label>
                    <input ng-click="changeSourceFrom('Cash')" type="radio" name="source" ng-model="voucher.PaymentSource" value="Cash">
                    <span class="cr" tabindex="21"><i class="cr-icon"></i></span>Cash
                </label>
                <label>
                    <input ng-click="changeSourceFrom('GL')" type="radio" name="source" ng-model="voucher.PaymentSource" value="GL">
                    <span class="cr" tabindex="21"><i class="cr-icon"></i></span>GL
                </label>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="getFiscalYearPeriod(voucher.PostingDate);checkPostingDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" autocomplete="off" class="form-control" tabindex="8">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" autocomplete="off" tabindex="12">
            </div>
        </div>
        <div id="div_TransactionType" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style" ng-show="voucher.TransactionType=='SecurityGiven'">
                    <select ng-change="getTransactionTypeGL(voucher.FinancingTypeId)" name="FinancingTypeId" class="form-control" ng-model="voucher.FinancingTypeId" tabindex="4" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.FinancingTypeId}}">{{option.AssetUserName}}</option>
                    </select>
                </div>
                <div class="select-style" ng-show="voucher.TransactionType=='SecurityTaken'">
                    <select ng-change="getTransactionTypeGL(voucher.FinancingTypeId)" name="FinancingTypeId" class="form-control" ng-model="voucher.FinancingTypeId" tabindex="4" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in financingTypeList" value="{{option.FinancingTypeId}}">{{option.LiabilityUserName}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='Bank'">
            <div class="col-sm-12 show-message">
                <div class="select-style">
                    <select name="Bank" class="form-control" submit-required="true" ng-model="voucher.BankMasterId" ng-options="item.Id as item.AccountTitle for item in bankMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='Cash'">
            <div class="col-sm-12 show-message">
                <div class="select-style">
                    <select name="Cash" class="form-control" submit-required="true" ng-model="voucher.CashMasterId" ng-options="item.Id as item.UserName for item in cashMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='GL'">
            <div class="form-group">
                <label class="col-sm-4 control-label">Select GL<sup>*</sup></label>
                <div class="col-sm-8 input-group">
                    <span class="input-group-btn">
                        <button ng-click="GetCOAICodeList();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Journal.ToString()'">
            <label class="col-sm-4 control-label">voucher<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="voucher.AdvanceNo" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showAdvanceInterTransactionPopUp();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
        <div id="div_entity" class="form-group">
            <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="entity" ng-model="voucher.EntityId" tabindex="16">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="13" required autocomplete="off" capitalize>
            </div>
        </div>
        <div class="form-group" id="div_qty" show-errors>
            <label class="col-sm-3 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-4 show-message" style="padding-right:0px;">
                <input tabindex="19" name="Amount" ng-model="voucher.Amount" type="text" n-decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" required autocomplete="off">
            </div>
            <div class="col-sm-5 show-message" style="padding-left:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="14" name="Currency" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
           
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Currency Rate<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="6" required autocomplete="off" n-decimals="4" ng-disabled="voucher.CurrencyId==companyCurrencyId">
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-8 col-md-8">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea ng-keyup="updateCrAmount();" rows="1" type="text" name="Narration" tabindex="24" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table " ng-show="voucher.PaymentSource=='GL'">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>

                    <th>GL </th>
                    <th>Budget</th>
                    <th>Activity</th>
                    <th class="text-center">Amount</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in voucherDetailList">

                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                    <td>{{x.BudgetName}}</td>
                    <td>{{x.ActivityName}}</td>
                    <td><input type="text" class="form-control text-right" id="vdDrAmount" ng-model="x.Amount " n-decimals="2" tabindex="11" autocomplete="off"></td>
                    <td class="text-right">
                        <button ng-click="removeDetaillRow(x.Id,x.VoucherId,$index)" data-toggle="modal" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-right">Total</td>
                    <td class="text-right"><b>{{ (voucherDetailList ) | sumByKey:'Amount' }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>@Library.Model.Parties.PartyType.Party.ToString()</th>
                <th>Location</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Written-off Amount</th>
                <th>Balance</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                <td>{{x.PartyPlantName}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.DocDate | dateFiltering}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td class="text-right">{{x.WrittenOffAmount | number:2}}</td>
                <td class="text-right">{{x.Amount-x.WrittenOffAmount | number:2}}</td>
                <td>{{x.IsPark?'Parked':'Posted'}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                        <li><a class="btn btn-action" href="Accounts/SecurityDeposit/ReportSecurityDeposit?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Accounts/SecurityDeposit/ReportSecurityDeposit?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("~/Areas/Parties/Views/Party/_PartyPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLBudgetPopUp.cshtml")

<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(securityDepositId)"></confirm-archive-generic>