<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Investment Type GL</h3>
<div class="form-elements" ng-form id="investmentTypeGivenGL" name="investmentTypeGivenGLForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-3 control-label">COA<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="investmentTypeGivenGL.COAId" ng-options="item.Value as item.Text for item in COAList" id="COAId" name="COA" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        </div>
        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="showAll('assing');" class="btn ng-binding"><i class="glyphicon glyphicon-search"></i> All Assign</button></li>
                    <li>
                        <button ng-click="showAll('notassing');" class="btn ng-binding"><i class="glyphicon glyphicon-search"></i> Not Assign</button>
                    </li>
                    <li>
                        <button ng-click="showAll('all');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> All</button>
                    </li>
                </ul>
            </div>
            <div class="table-responsive modal-table col-xs-12" ng-show="investmentTypeGivenGLWithCombineList.length>0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th rowspan="2">Apply</th>
                            <th rowspan="2">Asset Type Name</th>
                            <th colspan="3">Asset</th>
                            <th colspan="3">Revenue</th>
                            <th rowspan="2">Libility Type Name</th>
                            <th colspan="3">Libility</th>
                            <th colspan="3">Expense</th>
                            <th style="vertical-align: middle; text-align:center" rowspan="2"> Untag</th>
                        </tr>
                        <tr>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="x in investmentTypeGivenGLWithCombineList|itemsPerPage:$root.pageSize" total-items="$root.total_count">
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" id="{{x.FinancingTypeId}}" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectChValueId($event,x)">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>{{x.AssetUserName}}</td>
                            <td>{{x.AssetGLCode}} - {{x.AssetGLText}}</td>
                            <td>{{x.AssetBudgetName}}</td>
                            <td>{{x.AssetActivityName}}</td>
                            <td>{{x.RevenueGLCode}} - {{x.RevenueGLText}}</td>
                            <td>{{x.RevenueBudgetName}}</td>
                            <td>{{x.RevenueActivityName}}</td>
                            <td>{{x.LiabilityUserName}}</td>
                            <td>{{x.LiabilityGLCode}} - {{x.LiabilityGLText}}</td>
                            <td>{{x.LiabilityBudgetName}}</td>
                            <td>{{x.LiabilityActivityName}}</td>
                            <td>{{x.ExpensesGLCode}} - {{x.ExpensesGLText}}</td>
                            <td>{{x.ExpensesBudgetName}}</td>
                            <td>{{x.ExpensesActivityName}}</td>
                            <td class="text-center">
                                <ul class="list-inline action-list">
                                    <li><button ng-disabled="x.Id ===null" ng-click="valuePassInDelModal(x,$index,$event)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <dir-pagination-controls max-size="10" direction-links="true"
                                         boundary-links="true" on-page-change="getData(newPageNumber)">
                </dir-pagination-controls>
            </div>
        </div>
        <div class="col-xs-12 form-element-ctrl  form-horizontal">
            <br /><br />
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Asset</legend>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL<sup>*</sup></label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control" ng-model="AssetGLInof" readonly>
                        </div>
                        <button name="submit" class="single-btn" ng-click="getAssetTypeList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshAssetGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="investmentTypeGivenGL.AssetBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in assetBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getAssetActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="investmentTypeGivenGL.AssetActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in assetActivityList" id="ActivityId" name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Revenue</legend>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL<sup>*</sup></label>
                        <div class="col-sm-6" style="padding-right:0px;">
                            <input type="text" class="form-control" ng-model="RevenueGLInof" readonly>
                        </div>
                        <button name="submit" class="single-btn" ng-click="getRevenueTypeList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshRevenueGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="investmentTypeGivenGL.RevenueBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in revenueBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getRevenueActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="investmentTypeGivenGL.RevenueActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in revenueActivityList" id="ActivityId" name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Liability</legend>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL<sup>*</sup></label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control" ng-model="LiabilityGLInof" readonly>
                        </div>
                        <button name="submit" class="single-btn" ng-click="getLiabilityTypeList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshLiabilityGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="investmentTypeGivenGL.LiabilityBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in liabilityBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getLiabilityActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="investmentTypeGivenGL.LiabilityActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in liabilityActivityList" id="ActivityId" name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Expenses</legend>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL<sup>*</sup></label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control" ng-model="ExpensesGLInof" readonly>
                        </div>
                        <button name="submit" class="single-btn" ng-click="getExpensesTypeList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshExpensesGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="investmentTypeGivenGL.ExpensesBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in expensesBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getExpensesActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="investmentTypeGivenGL.ExpensesActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in expensesActivityList" id="ActivityId" name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_AssetTypeGL.cshtml")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_RevenueTypeGL.cshtml")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_LiabilityTypeGL.cshtml")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_ExpensesTypeGL.cshtml")
@Html.Partial("_ConfirmModal")
<confirm-archive-generic modalid="glUntag" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>