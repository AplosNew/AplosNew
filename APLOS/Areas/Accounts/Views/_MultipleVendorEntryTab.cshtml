<togglable name="Multiple Vendor Post "></togglable>
<div class="form-elements form-horizontal" ng-form="form1">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <div class="radio col-sm-5 col-xs-5">
                <label>
                    <input type="radio" name="Date Type" ng-click="changeDateType('DueUpToDate')" ng-model="multiplePayment.DateType" value="DueUpToDate">
                    <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Due UpTo PostingDate
                </label>
                <label>
                    <input type="radio" name="Date Type" ng-click="changeDateType('DocDate')" ng-model="multiplePayment.DateType" value="DocDate">
                    <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Due UpTo Doc Date
                </label>
            </div>
            <div class="col-sm-6 show-message">
                <input type="text" name="UpToDate" ng-model="multiplePayment.DueUpToDate" datepicker class="form-control" required>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="Entity" ng-model="multiplePayment.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-5 control-label">Tentative Date</label>
            <div class="col-sm-7 show-message">
                <input type="text" name="TentativeDate" ng-model="multiplePayment.TentativeDate" datepicker class="form-control" required>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-4 col-md-4 ">
        <button class="btn single-btn" ng-click="getPopupVendorList()" tabindex="10">Select Vendor</button>
        <button class="btn single-btn" ng-click="getPopupVendorPayableList()" tabindex="10">Select Payable</button>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 ">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label" title="CheckBy">Approved By<sup>*</sup></label>
            <div class="col-sm-4  show-message">
                <div class="select-style" ng-show="approvedByList.length">
                    <select id="ApprovedBy" class="form-control" name="Approved By" ng-model="multiplePayment.ApprovedBy" tabindex="8" required>
                        <option ng-repeat="option in approvedByList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 ">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="table-responsive modal-table ">
                <table class="table table-striped" ng-show="partyList.length">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>{{partyType}}</th>
                            <th>No of Invoice</th>
                            <th>Payment Pending Amount</th>
                            <th>Is Customer</th>
                            <th>Receivable Pending Amount</th>
                            <th>Advance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in partyDataListNew">
                            <td>{{x.Code}}</td>
                            <td>{{x.UserName}}</td>
                            <td>{{x.NoOfPendingInvoice}}</td>
                            <td>{{x.Balance}}</td>
                            <td>{{x.IsCustomer}}</td>
                            <td>{{x.PendingReceivable}}</td>
                            <td>{{x.Advance}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
    <br />
    <br />
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-12 col-md-12 ">
        <div class="table-responsive modal-table ">
            <table class="table table-striped" ng-show="paymentSelectedList.length">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>{{partyType}}</th>
                        <th>Voucher No</th>
                        <th>Posting Date</th>
                        <th>Doc Date</th>
                        <th>Base On Due Date</th>
                        <th>Doc Ref</th>
                        <th>Currency</th>
                        <th>Payable</th>
                        <th>Payment</th>
                        <th>Balance</th>
                        <th>
                            Amount
                            <div class="common-btn">
                                <button ng-click="copyPayableBalanceAmount();" class="btn" tabindex="5"><i class="glyphicon"></i> Copy</button>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in paymentSelectedList">
                        <td class="text-right">
                            <button ng-click="removeRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </td>
                        <td ng-show="partyType=='Vendor'">{{x.PartyName}}</td>
                        <td>{{x.VoucherNo}}</td>
                        <td>{{x.PostingDate | dateFiltering}}</td>
                        <td>{{x.DocDate | dateFiltering}}</td>
                        <td>{{x.BaseOnDueDate | dateFiltering}}</td>
                        <td>{{x.DocRefNo}}</td>
                        <td>{{x.CurrencyCode}}</td>
                        <td class="text-right">{{x.Receivable | number:4}}</td>
                        <td class="text-right">{{x.Received | number:4}}</td>
                        <td class="text-right">{{x.Balance | number:4}}</td>
                        <td>
                            <input ng-keyup="" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" autocomplete="off" name="Amount" ng-model="x.Amount">
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="11" class="text-right">Total</td>
                        <td class="text-right"><b>{{ (paymentSelectedList) | sumByKey:'Amount' }}</b></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6  " ng-show="paymentSelectedList.length">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Bank Detail</legend>
            <div class="form-group">
                <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="CashName" ng-model="multiplePayment.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{voucher.BankName}}" tooltip>
                        <span class="input-group-btn">
                            <button ng-click="showBankPopUp(multiplePayment.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="content-container-fluid" style="color:black;">
        <div style="color:black;" id="MultiplePaymentGrid" ej-grid e-datasource="multiplePaymentDataList" e-allowfiltering="true" e-allowpaging="true"
             e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
             e-actioncomplete="actionCompleteSelected" e-recorddoubleclick="Get" e-allowscrolling="true" e-showstackedheader="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Payment No" e-width="120" e-filter="false"></div>
                <div e-column e-field="PartyName" e-headertext="Party" e-width="120" e-filter="false"></div>
                <div e-column e-field="AccountTitle" e-headertext="Bank" e-width="100"></div>
                <div e-column e-field="DueUpToDate" e-headertext="DueUpToDate" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="TentativeDate" e-headertext="TentativeDate" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="Amount" e-headertext="Amount" e-width="100"></div>
                <div e-column e-field="ParkStatus" e-headertext="ParkStatus" e-width="80" textAlign='Center'></div>
            </div>
        </div>

    </div>
    <i>**Showing top 300  List</i>
</div>
