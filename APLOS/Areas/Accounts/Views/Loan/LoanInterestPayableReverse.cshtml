<togglable name="Loan Interest Payable Reverse"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Entry Date" ng-model="voucher.VoucherDate" datepicker class="form-control" tabindex="1" disabled required>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type" tooltip>Transaction Type<sup>*</sup></label>
            <div class="radio col-sm-8 col-xs-8">
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('@Library.Model.Enums.TransactionType.LoanTaken.ToString()')" ng-model="voucher.TransactionType" value="@Library.Model.Enums.TransactionType.LoanTaken.ToString()">
                    <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Taken
                </label>
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('@Library.Model.Enums.TransactionType.LoanGiven.ToString()')" ng-model="voucher.TransactionType" value="@Library.Model.Enums.TransactionType.LoanGiven.ToString()">
                    <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Given
                </label>

            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type" tooltip>Loan<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Code" ng-model="voucher.LoanDocRefNo" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showloanPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearLoanData()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate()" id="postingDate" type="text" name="Posting Date" ng-model="voucher.PostingDate" class="form-control" tabindex="2">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Doc Date" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="5">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="4" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="3" required autocomplete="off" capitalize>
            </div>
        </div>
    </div>
    <div class="col-xs-8 col-sm-8 col-md-8">
        <div class="form-group" show-errors>
            <label class="col-sm-2 col-xs-2 col-md-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 col-md-10 col-xs-10 show-message">
                <textarea rows="1" type="text" name="Narration" tabindex="17" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-md-7 col-sm-7 col-xs-7">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Loan Detail</legend>
            <div class="form-group">
                <label class="col-sm-3 control-label">Initial Sanction<sup>*</sup></label>
                <div class="col-sm-3 show-message" style="padding-right:0px;">
                    <input name="Amount" tabindex="19" ng-model="voucher.InitialSactionAmount" n-decimals="2" class="form-control text-right" readonly>
                </div>
                <label class="col-sm-2 control-label">{{voucher.PartyType}}<sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.PartyName" class="form-control" readonly>
                </div>

            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Subsequent Sanction<sup>*</sup></label>
                <div class="col-sm-3 show-message" style="padding-right:0px;">
                    <input name="Amount" tabindex="19" ng-model="voucher.AdditionalLoanAmount" n-decimals="2" class="form-control text-right" readonly>
                </div>
                <label class="col-sm-2 control-label" ng-hide="voucher.PartyType=='Director'||voucher.PartyType=='Bank'">Location<sup>*</sup></label>
                <div class="col-sm-4 show-message" ng-hide="voucher.PartyType=='Director'||voucher.PartyType=='Bank'">
                    <div class="input-group">
                        <div class="select-style">
                            <select tabindex="1" class="form-control" name="location" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }">
                                <option value=""></option>
                            </select>
                        </div>
                        <span class="input-group-btn">
                            <button ng-click="showPartyPlantPopUp(voucher.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Total Sanction<sup>*</sup></label>
                <div class="col-sm-3 show-message" style="padding-right:0px;">
                    <input name="Amount" tabindex="19" ng-model="voucher.LoanAmount" n-decimals="2" class="form-control text-right" readonly>
                </div>

                <label class="col-sm-2 control-label">Posting Date<sup>*</sup></label>
                <div class="col-sm-4">
                    <input type="text" id="LoanPostingDate" name="LoanPostingDate" ng-model="voucher.LoanPostingDate" class="form-control text-right" tabindex="6" autocomplete="off" readonly>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Interest Amount<sup>*</sup></label>
                <div class="col-sm-3 show-message" style="padding-right:0px;">
                    <input name="InterestAmount" tabindex="19" ng-model="voucher.InterestAmount" n-decimals="2" class="form-control text-right" readonly>
                </div>
                <label class="col-sm-2 control-label">Currency<sup>*</sup></label>
                <div class="col-sm-2" style="padding-right:0px;">
                    <div class="select-style">
                        <select id="currencyId" class="form-control" tabindex="7" name="Currency" ng-model="voucher.CurrencyId" readonly>
                            <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-2">
                    <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="voucher.ToCurrencyRate" class="form-control text-right" tabindex="6" autocomplete="off" n-decimals="4" readonly>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Charges<sup>*</sup></label>
                <div class="col-sm-3 show-message" style="padding-right:0px;">
                    <input name="InterestAmount" tabindex="19" ng-model="voucher.OtherExpensesPayable" n-decimals="2" class="form-control text-right" readonly>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">SetOff Amount<sup>*</sup></label>
                <div class="col-sm-3 show-message" style="padding-right:0px;">
                    <input name="Amount" tabindex="19" ng-model="voucher.LoanSetOff" n-decimals="2" class="form-control text-right" readonly>
                </div>
                <label class="col-sm-2 control-label">Doc Date<sup>*</sup></label>
                <div class="col-sm-4">
                    <input type="text" id="LoanDocDate" name="LoanDocDate" ng-model="voucher.LoanDocDate" class="form-control text-right" tabindex="6" autocomplete="off" readonly>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Balance<sup>*</sup></label>
                <div class="col-sm-3 show-message" style="padding-right:0px;">
                    <input name="Amount" tabindex="19" ng-model="voucher.Balance" n-decimals="2" class="form-control text-right" readonly>
                </div>

                <label class="col-sm-2 control-label">Voucher No<sup>*</sup></label>
                <div class="col-sm-4" show-errors>
                    <input type="text" maxlength="50" id="Balance" name="Balance" ng-model="voucher.VoucherNo" class="form-control text-right" tabindex="6" autocomplete="off" n-decimals="4" readonly>
                </div>
            </div>
        </fieldset>

    </div>
    <div class="col-md-5 col-sm-5 col-xs-5">
        <div class="form-group">
            <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type" tooltip>Reverse Type<sup>*</sup></label>
            <div class="radio col-sm-8 col-xs-8">
                <label>
                    <input type="radio" name="Reverse Type" ng-click="changeReverseType('@Library.Service.Enums.LoanTransactionType.InterestPayableReverse.ToString()')" ng-model="voucher.SettlementType" value="@Library.Service.Enums.LoanTransactionType.InterestPayableReverse.ToString()">
                    <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Interest Payable Reverse
                </label>
                <label>
                    <input type="radio" name="Reverse Type" ng-click="changeReverseType('@Library.Service.Enums.LoanTransactionType.ChargesPayableReverse.ToString()')" ng-model="voucher.SettlementType" value="@Library.Service.Enums.LoanTransactionType.ChargesPayableReverse.ToString()">
                    <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Charges Payable Reverse
                </label>
            </div>
        </div>
    </div>
    
    <div class="col-md-5 col-sm-5 col-xs-5" ng-show="voucher.SettlementType=='InterestPayableReverse'">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Interest Payable </legend>
            <div class="form-group" id="div_qty" show-errors>
                <label class="col-sm-3 control-label">Interest Payable <sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <input name="InterestBalance" tabindex="19" ng-model="voucher.InterestAmount" n-decimals="2" class="form-control text-right" readonly>
                </div>
            </div>
            <div class="form-group" id="div_qty" show-errors>
                <label class="col-sm-3 control-label" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.LoanTaken.ToString()'">Payable Amount<sup>*</sup></label>
                <label class="col-sm-3 control-label" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.LoanGiven.ToString()'">Reverse Amount<sup>*</sup></label>
                <div class="col-sm-4 show-message" style="padding-right:0px;">
                    <input name="Amount" tabindex="19" ng-model="voucher.Amount" ng-keyup="exchangeGainLossAmount(voucher.Amount)" n-decimals="2" class="form-control text-right" autocomplete="off" required>
                </div>
            </div>
            <div class="form-group" id="div_qty" ng-show="voucher.ExchangeType">
                <label class="col-sm-3 control-label">ExchangeType</label>
                <div class="col-sm-4 show-message" style="padding-right:0px;">
                    <input readonly type="text" tabindex="19" ng-model="voucher.ExchangeType" n-decimals="2" class="form-control text-right">
                </div>
                <label class="col-sm-3 control-label">Exchange Amount</label>
                <div class="col-sm-2 show-message">
                    <input type="text" maxlength="50" readonly ng-model="voucher.ExchangeAmount" class="form-control text-right" tabindex="6" n-decimals="4">
                </div>
            </div>
        </fieldset>
    </div>

    <div class="col-md-5 col-sm-5 col-xs-5" ng-show="voucher.SettlementType=='ChargesPayableReverse'">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Interest Payable Reverse</legend>

            <div class="form-group" id="div_qty" show-errors>
                <label class="col-sm-3 control-label">Charges Payable <sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <input name="InterestBalance" tabindex="19" ng-model="voucher.OtherExpensesPayable" n-decimals="2" class="form-control text-right" readonly>
                </div>

            </div>
            <div class="form-group" id="div_qty" show-errors>
                <label class="col-sm-3 control-label" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.LoanTaken.ToString()'">Payable Amount<sup>*</sup></label>
                <label class="col-sm-3 control-label" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.LoanGiven.ToString()'">Reverse Amount<sup>*</sup></label>
                <div class="col-sm-4 show-message" style="padding-right:0px;">
                    <input name="Amount" tabindex="19" ng-model="voucher.Amount" ng-keyup="exchangeGainLossAmount(voucher.Amount)" n-decimals="2" class="form-control text-right" autocomplete="off" required>
                </div>

            </div>
            <div class="form-group" id="div_qty" ng-show="voucher.ExchangeType">
                <label class="col-sm-3 control-label">ExchangeType</label>
                <div class="col-sm-4 show-message" style="padding-right:0px;">
                    <input readonly type="text" tabindex="19" ng-model="voucher.ExchangeType" n-decimals="2" class="form-control text-right">
                </div>
                <label class="col-sm-3 control-label">Exchange Amount</label>
                <div class="col-sm-2 show-message">
                    <input type="text" maxlength="50" readonly ng-model="voucher.ExchangeAmount" class="form-control text-right" tabindex="6" n-decimals="4">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.LoanTaken.ToString()'">Expenses (If Any)</label>
                <label class="col-sm-3 control-label" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.LoanGiven.ToString()'">Profit (If Any)</label>
                <div class="col-sm-9 show-message">
                    <div class="input-group">
                        <input type="text" name="Code" ng-model="voucher.GLName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="GetCOAICodeList();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearGLData()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            
        </fieldset>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="23"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(financingId.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="24"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
    <div class="row text-right aplos-grid-toggle">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table aplos-grid-toggle">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>Financing No</th>
                    <th>Loan No</th>
                    <th>Posting Date</th>
                    <th>Doc Date</th>
                    <th>Doc Ref</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in investmentGivenList |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.FinancingNo}}</td>
                    <td>{{x.LoanNo}}</td>
                    <td>{{x.PostingDate| dateFiltering}}</td>
                    <td>{{x.DocDate| dateFiltering}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.VoucherId);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>

                            @*<li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>*@
                            <li><a class="btn btn-action" href="Accounts/Loan/LoanIntersetPayableReverseReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Loan/LoanIntersetPayableReverseReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
    @Html.Partial("~/Areas/Parties/Views/Party/_PartyPopUp.cshtml")
    @Html.Partial("~/Areas/Accounts/Views/Loan/_LoanListPopUp.cshtml")
    @Html.Partial("~/Areas/Accounts/Views/GLItem/_GLBudgetPopUp.cshtml")

    <confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(loanIntPayableId,voucherId)"></confirm-archive-generic>
    <confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(voucherId)"></confirm-archive-generic>
    @*<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(employeePayableWriteOffId,voucherId)"></confirm-archive-generic>*@
