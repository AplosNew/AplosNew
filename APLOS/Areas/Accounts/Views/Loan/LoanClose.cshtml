<togglable name="Loan Close"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group">
            <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type" tooltip>Transaction Type<sup>*</sup></label>
            <div class="radio col-sm-8 col-xs-8">
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('@Library.Model.Enums.TransactionType.LoanTaken.ToString()')" ng-model="voucher.TransactionType" value="@Library.Model.Enums.TransactionType.LoanTaken.ToString()">
                    <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Taken
                </label>
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('@Library.Model.Enums.TransactionType.LoanGiven.ToString()')" ng-model="voucher.TransactionType" value="@Library.Model.Enums.TransactionType.LoanGiven.ToString()">
                    <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Given
                </label>

            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type" tooltip>Select Loan<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-btn">
                        <button ng-click="showloanPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12 col-sm-12 col-xs-12" >
        <fieldset class="scheduler-border" ng-show="ExistingLoanList.length">
            <legend class="scheduler-border">Loan Detail</legend>
            <div class="table-responsive modal-table">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>VoucherNo</th>
                            <th>Particulars</th>
                            <th>Posting Date</th>
                            <th>Doc Date</th>
                            <th>Doc Ref</th>
                            <th>Currency</th>
                            <th>Amount</th>
                            <th>Subsequent Sanction</th>
                            <th>Interest</th>
                            <th>Charges</th>
                            <th>Total Loan</th>
                            <th>Total SetOff</th>
                            <th>Balance</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in ExistingLoanList">
                            <td>{{x.VoucherNo}}</td>
                            <td>{{x.PartyName}}</td>
                            <td>{{x.LoanPostingDate| dateFiltering}}</td>
                            <td>{{x.LoanDocDate| dateFiltering}}</td>
                            <td>{{x.LoanDocRefNo}}</td>
                            <td>{{x.CurrencyCode}}</td>
                            <td class="text-right">{{x.LoanAmount | number:2}}</td>
                            <td class="text-right">{{x.AdditionalLoanAmount | number:2}}</td>
                            <td class="text-right">{{x.InterestAmount | number:2}}</td>
                            <td class="text-right">{{x.OtherExpensesPayable | number:2}}</td>
                            <td class="text-right">{{x.TotalLoanLiability | number:2}}</td>
                            <td class="text-right">{{x.LoanSetOff | number:2}}</td>
                            <td class="text-right">{{x.Balance | number:2}}</td>
                            <td class="text-right">
                                <button ng-click="removeRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </fieldset>
    </div>



    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="23"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(financingId.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="24"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Voucher No</th>
                <th>Loan No</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in investmentGivenList |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.PostingDate| dateFiltering}}</td>
                <td>{{x.DocDate| dateFiltering}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.LoanAmount | number:2}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li><a class="btn btn-action" href="Accounts/Loan/GetLoanRegisterLedgerReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&transactionType={{x.TransactionType}}&voucherId={{x.VoucherId}}&financingId={{x.FinancingId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Accounts/Loan/GetLoanRegisterLedgerReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&transactionType={{x.TransactionType}}&voucherId={{x.VoucherId}}&financingId={{x.FinancingId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("~/Areas/Parties/Views/Party/_PartyPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/Loan/_LoanListPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLBudgetPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")

<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(financingId,voucherId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(voucherId)"></confirm-archive-generic>