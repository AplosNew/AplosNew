<togglable name="Loan WriteOff"></togglable>
<div class="form-horizontal form-elements">

    <div class="tab-design " id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);getCboVoucherTypeLoanListML();GetCurrencyParallel()" href="" aria-controls="general" role="tab" data-toggle="tab">Multiple SetOff</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div>
                    <div class="form-elements form-horizontal" ng-form="form0">
                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Entry Date" ng-model="voucher.VoucherDate" datepicker class="form-control" tabindex="1" disabled required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type" tooltip>Transaction Type<sup>*</sup></label>
                                <div class="radio col-sm-8 col-xs-8">
                                    <label>
                                        <input type="radio" name="Transaction Type" ng-click="changeTransactionType('@Library.Model.Enums.TransactionType.LoanTaken.ToString()')" ng-model="voucher.TransactionType" value="@Library.Model.Enums.TransactionType.LoanTaken.ToString()">
                                        <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Taken
                                    </label>
                                    <label>
                                        <input type="radio" name="Transaction Type" ng-click="changeTransactionType('@Library.Model.Enums.TransactionType.LoanGiven.ToString()')" ng-model="voucher.TransactionType" value="@Library.Model.Enums.TransactionType.LoanGiven.ToString()">
                                        <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Given
                                    </label>

                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type" tooltip>Loan<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="input-group">
                                        <input type="text" name="Code" ng-model="voucher.LoanDocRefNo" class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button ng-click="showloanPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                            <button ng-click="clearLoanData()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div id="div_PostingDate" class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input required datepicker="checkPostingDate()" id="postingDate" type="text" name="Posting Date" ng-model="voucher.PostingDate" class="form-control" tabindex="2">
                                </div>
                            </div>
                            <div id="div_DocDate" class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Doc Date" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="5">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
                                <div class="radio">
                                    <label>
                                        <input ng-click="changeSourceFrom('Bank')" type="radio" name="source" ng-model="voucher.PaymentSource" value="Bank">
                                        <span class="cr" tabindex="22"><i class="cr-icon"></i></span>Bank
                                    </label>
                                    <label>
                                        <input ng-click="changeSourceFrom('Cash')" type="radio" name="source" ng-model="voucher.PaymentSource" value="Cash">
                                        <span class="cr" tabindex="21"><i class="cr-icon"></i></span>Cash
                                    </label>
                                    <label>
                                        <input ng-click="changeSourceFrom('Tax')" type="radio" name="source" ng-model="voucher.PaymentSource" value="Tax">
                                        <span class="cr" tabindex="21"><i class="cr-icon"></i></span>Tax
                                    </label>
                                    <label>
                                        <input ng-click="changeSourceFrom('Loan')" type="radio" name="source" ng-model="voucher.PaymentSource" value="Loan">
                                        <span class="cr" tabindex="21"><i class="cr-icon"></i></span>Loan
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div class="form-group" show-errors>
                                <label class="col-sm-3 control-label">Voucher Type<sup>*</sup></label>
                                <div class="col-sm-9 show-message">
                                    <div class="select-style">
                                        <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="4" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
                                <div class="col-sm-9 show-message">
                                    <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="3" required autocomplete="off" capitalize>
                                </div>
                            </div>
                            <div class="form-group" ng-show="voucher.PaymentSource=='Bank'">
                                <label class="col-sm-3 control-label">Bank<sup>*</sup></label>
                                <div class="col-sm-9 show-message">
                                    <div class="input-group">
                                        <input type="text" name="AccountTitle" ng-model="voucher.SourceBankAccountTitle" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{voucher.SourceBankAccountTitle}}" tooltip>
                                        <span class="input-group-btn">
                                            <button ng-click="showBankPopUp(voucher.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group" ng-show="voucher.PaymentSource=='Cash'">
                                <label class="col-sm-3 control-label">Cash<sup>*</sup></label>
                                <div class="col-sm-9 show-message">
                                    <div class="select-style">
                                        <select name="Cash" class="form-control" submit-required="true" ng-model="voucher.CashMasterId" ng-options="item.Id as item.UserName for item in cashMasterList">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" ng-show="voucher.PaymentSource=='Loan'">
                                <label class="col-sm-3 col-xs-3 control-label" title="Transaction Type" tooltip>Loan<sup>*</sup></label>
                                <div class="col-sm-9 show-message">
                                    <div class="input-group">
                                        <input type="text" name="Code" ng-model="loanAddition.LoanDocRefNo" class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button ng-click="showAdditionloanPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                            <button ng-click="clearLoanData()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-2 col-xs-2 col-md-2 control-label">Narration<sup>*</sup></label>
                                    <div class="col-sm-10 col-md-10 col-xs-10 show-message">
                                        <textarea rows="1" type="text" name="Narration" tabindex="17" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Is Change</label>
                                    <div class="col-sm-9">
                                        <div class="checkbox-site">
                                            <label>
                                                <input tabindex="3" type="checkbox" ng-model="voucher.IsSplit">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="clearfix"></div>
                        <div class="col-md-7 col-sm-7 col-xs-7">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">Loan Detail</legend>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Initial Sanction<sup>*</sup></label>
                                    <div class="col-sm-3 show-message" style="padding-right:0px;">
                                        <input name="Amount" tabindex="19" ng-model="voucher.InitialSactionAmount" n-decimals="2" class="form-control text-right" readonly>
                                    </div>
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-2 control-label">{{voucher.PartyType}}<sup>*</sup></label>
                                        <div class="col-sm-4 show-message">
                                            <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.PartyName" class="form-control" readonly>
                                        </div>
                                    </div>

                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Subsequent Sanction<sup>*</sup></label>
                                    <div class="col-sm-3 show-message" style="padding-right:0px;">
                                        <input name="Amount" tabindex="19" ng-model="voucher.AdditionalLoanAmount" n-decimals="2" class="form-control text-right" readonly>
                                    </div>
                                    <label class="col-sm-2 control-label">Location<sup>*</sup></label>
                                    <div class="col-sm-4 show-message">
                                        <div class="input-group">
                                            <div class="select-style">
                                                <select tabindex="1" class="form-control" name="location" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }">
                                                    <option value=""></option>
                                                </select>
                                            </div>
                                            <span class="input-group-btn">
                                                <button ng-click="showPartyPlantPopUp(voucher.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Total Sanction<sup>*</sup></label>
                                    <div class="col-sm-3 show-message" style="padding-right:0px;">
                                        <input name="Amount" tabindex="19" ng-model="voucher.LoanAmount" n-decimals="2" class="form-control text-right" readonly>
                                    </div>

                                    <label class="col-sm-2 control-label">Posting Date<sup>*</sup></label>
                                    <div class="col-sm-4">
                                        <input type="text" id="LoanPostingDate" name="LoanPostingDate" ng-model="voucher.LoanPostingDate" class="form-control text-right" tabindex="6" autocomplete="off" readonly>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">(Interest+Tax) Amount<sup>*</sup></label>
                                    <div class="col-sm-3 show-message" style="padding-right:0px;">
                                        <input name="InterestAmount" tabindex="19" ng-model="voucher.InterestAmount" n-decimals="2" class="form-control text-right" readonly>
                                    </div>
                                    <label class="col-sm-2 control-label">Currency<sup>*</sup></label>
                                    <div class="col-sm-2" style="padding-right:0px;">
                                        <div class="select-style">
                                            <select id="currencyId" class="form-control" tabindex="7" name="Currency" ng-model="voucher.CurrencyId" readonly>
                                                <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="voucher.ToCurrencyRate" class="form-control text-right" tabindex="6" autocomplete="off" n-decimals="4" readonly>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Charges<sup>*</sup></label>
                                    <div class="col-sm-3 show-message" style="padding-right:0px;">
                                        <input name="InterestAmount" tabindex="19" ng-model="voucher.OtherExpensesPayable" n-decimals="2" class="form-control text-right" readonly>
                                    </div>
                                    <label class="col-sm-2 control-label">Doc Date<sup>*</sup></label>
                                    <div class="col-sm-4">
                                        <input type="text" id="LoanDocDate" name="LoanDocDate" ng-model="voucher.LoanDocDate" class="form-control text-right" tabindex="6" autocomplete="off" readonly>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">SetOff Amount<sup>*</sup></label>
                                    <div class="col-sm-3 show-message" style="padding-right:0px;">
                                        <input name="Amount" tabindex="19" ng-model="voucher.LoanSetOff" n-decimals="2" class="form-control text-right" readonly>
                                    </div>

                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Balance<sup>*</sup></label>
                                    <div class="col-sm-3 show-message" style="padding-right:0px;">
                                        <input name="Amount" tabindex="19" ng-model="voucher.Balance" n-decimals="2" class="form-control text-right" readonly>
                                    </div>

                                    <label class="col-sm-2 control-label">Voucher No<sup>*</sup></label>
                                    <div class="col-sm-4" show-errors>
                                        <input type="text" maxlength="50" id="Balance" name="Balance" ng-model="voucher.VoucherNo" class="form-control text-right" tabindex="6" autocomplete="off" n-decimals="4" readonly>
                                    </div>
                                </div>
                            </fieldset>
                        </div>

                        <div class="col-md-5 col-sm-5 col-xs-5">
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">Payment</legend>
                                <div class="form-group" id="div_qty" show-errors>
                                    <label class="col-sm-3 control-label" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.LoanTaken.ToString()'">Payment Amount<sup>*</sup></label>
                                    <label class="col-sm-3 control-label" ng-show="voucher.TransactionType=='@Library.Model.Enums.TransactionType.LoanGiven.ToString()'">Receipt Amount<sup>*</sup></label>
                                    <div class="col-sm-4 show-message" style="padding-right:0px;">
                                        <input name="Amount" tabindex="19" ng-model="voucher.Amount" ng-disabled="voucher.TotalAmount==null" ng-keyup="exchangeGainLossAmount(voucher.Amount)" n-decimals="2" class="form-control text-right" autocomplete="off">
                                    </div>
                                    <label class="col-sm-3 control-label">Rate<sup>*</sup></label>
                                    <div class="col-sm-2 show-message">
                                        <input type="text" maxlength="50" id="Rate" name="Rate" ng-keyup="exchangeGainLossCal(voucher.CompanyCurrencyRate)" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="6" autocomplete="off" n-decimals="4" ng-readonly="voucher.PaymentSource=='Loan'">
                                    </div>
                                </div>
                                <div class="form-group" id="div_qty" ng-show="voucher.ExchangeType">
                                    <label class="col-sm-3 control-label">ExchangeType</label>
                                    <div class="col-sm-4 show-message" style="padding-right:0px;">
                                        <input readonly type="text" tabindex="19" ng-model="voucher.ExchangeType" n-decimals="2" class="form-control text-right">
                                    </div>
                                    <label class="col-sm-3 control-label">Exchange Amount</label>
                                    <div class="col-sm-2 show-message">
                                        <input type="text" maxlength="50" readonly ng-model="voucher.ExchangeAmount" class="form-control text-right" tabindex="6" n-decimals="4">
                                    </div>
                                </div>
                                <div class="form-group" id="div_Additional_BooksAmount" ng-show="voucher.PaymentSource=='Loan'">
                                    <label class="col-sm-6 control-label">Additional Books Amount<sup>*</sup></label>
                                    <div class="col-sm-5 show-message">
                                        <input type="text" tabindex="19" ng-model="loanAddition.Amount" ng-keyup="exchangeGainLossAmountloanAddition()" n-decimals="2" class="form-control text-right">
                                    </div>
                                </div>
                                <div class="form-group" id="div_Setoff_BooksAmount" ng-show="voucher.PaymentSource=='Loan'">
                                    <label class="col-sm-6 control-label">Setoff Books Amount<sup>*</sup></label>
                                    <div class="col-sm-5 show-message">
                                        <input type="text" maxlength="50" ng-model="loanAddition.LoanSetOffAmount" ng-keyup="exchangeGainLossAmountloanAddition()" class="form-control text-right" tabindex="19" n-decimals="2">
                                    </div>
                                </div>
                                <div class="form-group" id="div_Setoff_BankBooksAmount" ng-show="voucher.IsSplit==true">
                                    <label class="col-sm-6 control-label">Setoff Books Amount<sup>*</sup></label>
                                    <div class="col-sm-5 show-message">
                                        <input type="text" maxlength="50" ng-model="voucher.LoanSetOffAmount" ng-keyup="exchangeGainLossAmountChangeBooksAmount()" class="form-control text-right" tabindex="19" n-decimals="2">
                                    </div>
                                </div>


                            </fieldset>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6 modal-table" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Tax.ToString()'">
                            <table class="table table-responsive table-striped">
                                <caption>TDS </caption>
                                <thead>
                                    <tr>
                                        <th>Input Tax</th>
                                        <th>Percentage</th>
                                        @*<th>Amount</th>*@
                                        <th class="text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td id="td_TDS_TaxCode">
                                            <div class="select-style show-message">
                                                <select name="TDSTaxCodeId" ng-model="TDS.TaxCodeId" ng-change="selectTDS(TDS.TaxCodeId)" class="col-sm-3 form-control"
                                                        ng-options="item.Id as item.UserName for item in TDSCboList">
                                                    <option></option>
                                                </select>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                <input type="text" n-decimals="4" class="form-control text-right" ng-disabled="TDS.Type =='FixedPercentage' && TDS.ValueOfFixed!=null" ng-model="TDS.ValueOfFixed">
                                            </div>
                                        </td>
                                        @*<td id="td_TDS_TaxCodeAmount">
                            <div class="show-message">
                                <input type="text" n-decimals="4" class="form-control text-right" ng-model="TDS.TaxAmount" ng-keyup="copyTaxesAmount();">
                            </div>
                        </td>*@
                                        <td class="text-right">
                                            <a ng-click="addTDS();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                                        </td>
                                    </tr>
                                    <tr ng-repeat="x in TDSList">
                                        <td>{{x.TaxName}}</td>
                                        <td>{{x.ValueOfFixed}}</td>
                                        @*<td class="text-right">{{x.TaxAmount | number:2 }}</td>*@
                                        <td class="text-right">
                                            <button ng-click="removeTDSRow($index)" data-toggle="modal" ng-disabled="x.AdvanceId" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                        </td>
                                    </tr>
                                </tbody>
                                @*<tfoot ng-show="TDSList.length">
                    <tr>
                        <td colspan="2"><b>Sub Total</b></td>
                        <td class="text-right"><b>{{ TDSList | sumByKey : 'TaxAmount' | number:2}}</b></td>
                        <td></td>
                    </tr>
                </tfoot>*@
                            </table>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="Save();" class="btn" tabindex="23"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(financingId.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
                                <li><button ng-click="Clear();" class="btn" tabindex="24"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                    </div>
                </div>


            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div>
                    <div class="form-elements form-horizontal" ng-form="form1">
                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Entry Date" ng-model="voucherML.VoucherDate" datepicker class="form-control" tabindex="1" disabled required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type ML" tooltip>Transaction Type<sup>*</sup></label>
                                <div class="radio col-sm-8 col-xs-8">
                                    <label>
                                        <input type="radio" name="Transaction Type ML" ng-click="changeTransactionType('@Library.Model.Enums.TransactionType.LoanTaken.ToString()')" ng-model="voucherML.TransactionType" value="@Library.Model.Enums.TransactionType.LoanTaken.ToString()">
                                        <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Taken
                                    </label>
                                    @*<label>
                                            <input type="radio" name="Transaction Type ML" ng-click="changeTransactionType('@Library.Model.Enums.TransactionType.LoanGiven.ToString()')" ng-model="voucherML.TransactionType" value="@Library.Model.Enums.TransactionType.LoanGiven.ToString()">
                                            <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Given
                                        </label>*@

                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                                <div class="col-sm-5 show-message" style="padding-right:0px;">
                                    <div class="select-style">
                                        <select id="currencyTransactionId" class="form-control" name="CurrencyTransaction" ng-model="voucherML.CurrencyId" ng-change="GetCurrencyExchangeRateListML();" required>
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-3 show-message" style="padding-left:0px;">
                                    <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="voucherML.CompanyCurrencyRate" class="form-control text-right" autocomplete="off" required ng-disabled="voucherML.BaseCurrencyId==voucherML.CurrencyId">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Party Type<sup>*</sup></label>
                                <div class="radio">
                                    <label>
