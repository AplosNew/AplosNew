                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">Profit Rate<sup>*</sup></label>
                    <div class="col-sm-9 show-message">
                        <input type="number" ng-keyup="LoadRepamentDetail()" maxlength="5" name="Profit Rate" ng-model="voucher.ProfitRate" class="form-control" tabindex="12" autocomplete="off">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label" title="No. Of Installment Per Year" tooltip>No.Install./Year<sup>*</sup></label>
                    <div class="col-sm-9 show-message">
                        <input type="text" maxlength="4" name="No. Of Installment Per Year" ng-keyup="totalInstallment();LoadRepamentDetail()" ng-model="voucher.NoOfInstallmentPerYear" class="form-control text-right" tabindex="11" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group col-sm-12">
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label" title="Total No. Of Installment " tooltip>Total No.Install<sup>*</sup></label>
                    <div class="col-sm-9 show-message">
                        <input type="text" maxlength="10" name="Total No Of Installment" ng-model="voucher.TotalNoOfInstallment" class="form-control text-right" tabindex="9" disabled autocomplete="off">
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="clearfix"></div>
    <div class="col-md-12 col-sm-12 col-xs-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Order Specific(Yes/No)</legend>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Order Specific</label>
                    <div class="col-sm-6">
                        <div class="radio">
                            <label>
                                <input type="radio" name="OrderSpecific" ng-model="voucher.OrderSpecific" value="No">
                                <span class="cr"><i class="cr-icon"></i></span>No
                            </label>
                            <label>
                                <input type="radio" name="OrderSpecific" ng-model="voucher.OrderSpecific" value="Yes" ng-click="changeOrderSpecific('Customer')">
                                <span class="cr"><i class="cr-icon"></i></span>Yes
                            </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4" ng-hide="voucher.OrderSpecific==='No'">
                <div class="form-group">
                    <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Customer.ToString()</label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <input type="text" name="@Library.Model.Parties.PartyType.Customer.ToString()" ng-model="voucher.OrderSpecificPartyName" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4" ng-hide="voucher.OrderSpecific==='No'">
                <div class="form-group">
                    <label class="col-sm-3 control-label" title="Contract">Master Order</label>
                    <span class="input-group-btn">
                        <button ng-click="ShowResultMasterOrderPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>

            <div class="clearfix"></div>
            <div class="table-responsive modal-table" ng-show="selectedMasterOrderList.length">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Master OrderNo</th>
                            <th>Customer</th>
                            <th>Invoicing Party Plant</th>
                            <th>Delivery Party Plant</th>
                            <th>Type</th>
                            <th>Currency</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in selectedMasterOrderList ">
                            <td>{{x.MasterOrderId}}</td>
                            <td>{{x.CustomerName}}</td>
                            <td>{{x.InvoicingPartyPlant}}</td>
                            <td>{{x.DeliveryPartyPlant}}</td>
                            <td>{{x.Type}}</td>
                            <td>{{x.Currency}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </fieldset>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-12 col-md-12 modal-table" id="loanDetails">
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6 modal-table">
        <table class="table table-responsive table-striped">
            <caption>Charges</caption>
            <thead>
                <tr>
                    <th>Charges Type</th>
                    <th>Trn. Amount</th>
                    <th>{{companyCurrencyCode}}</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_FinancingType">
                        <div class="select-style show-message">
                            <select ng-model="bankCharge.FinancingTypeId">
                                <option ng-repeat="option in bankChargeTypeList" value="{{option.FinancingTypeId}}">{{option.ExpensesUserName}}</option>
                            </select>
                        </div>
                    </td>
                    <td id="td_FinancingTypeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="3" class="form-control text-right" ng-model="bankCharge.Amount" ng-keyup="copyChargesAmount();">
                        </div>
                    </td>
                    <td id="td_FinancingTypeCompanyCurrencyAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="3" class="form-control text-right" ng-model="bankCharge.CompanyCurrencyAmount">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addCharge();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in bankChargesList">
                    <td>{{x.FinancingTypeName}}</td>
                    <td class="text-right">{{x.Amount | number:3 }}</td>
                    <td class="text-right">{{x.CompanyCurrencyAmount | number:3}}</td>
                    <td class="text-right">
                        <button ng-click="removeChargesRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="bankChargesList.length">
                <tr>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ bankChargesList | sumByKey : 'Amount' | number:3}}</b></td>
                    <td class="text-right"><b>{{ bankChargesList | sumByKey : 'CompanyCurrencyAmount' | number:3 }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="clearfix"></div>
    <br />
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="23"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(financingId.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="24"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Loan Type</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Doc Ref</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Written Off Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in investmentGivenList |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.TransactionType}}</td>
                <td>{{x.PostingDate| dateFiltering}}</td>
                <td>{{x.DocDate| dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td class="text-right">{{x.WrittenOffAmount | number:2}}</td>
                <td>{{x.IsPark?'Parked':'Posted'}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                        <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                        <li><a class="btn btn-action" href="Accounts/Loan/LoanReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Accounts/Loan/LoanReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew_Loan.cshtml")
@Html.Partial("~/Areas/Accounts/Views/Loan/_LoanListPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLBudgetPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_MultipleMasterOrderPopUp.cshtml")


<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(financingId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(financingId,voucherId)"></confirm-archive-generic>
