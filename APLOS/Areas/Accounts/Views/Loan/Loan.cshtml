    <div class="col-md-12 col-sm-12 col-xs-12" ng-show="voucher.IsLoanSetOff">
        <fieldset class="scheduler-border" ng-show="ExistingLoanList.length">
            <legend class="scheduler-border">Loan Detail</legend>
            <div class="table-responsive modal-table">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>VoucherNo</th>
                            <th>Particulars</th>
                            <th>Posting Date</th>
                            <th>Doc Date</th>
                            <th>Doc Ref</th>
                            <th>Currency</th>
                            <th>Amount</th>
                            <th>Subsequent Sanction</th>
                            <th>Interest</th>
                            <th>Charges</th>
                            <th>Total Loan</th>
                            <th>Total SetOff</th>
                            <th>Balance</th>
                            <th>SetOff Amount</th>
                            <th>To Currency Rate</th>
                            <th>Conversion Amount</th>
                            <th>Exchange Type</th>
                            <th>Exchange Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in ExistingLoanList">
                            <td>{{x.VoucherNo}}</td>
                            <td>{{x.PartyName}}</td>
                            <td>{{x.LoanPostingDate| dateFiltering}}</td>
                            <td>{{x.LoanDocDate| dateFiltering}}</td>
                            <td>{{x.LoanDocRefNo}}</td>
                            <td>{{x.CurrencyCode}}</td>
                            <td class="text-right">{{x.LoanAmount | number:2}}</td>
                            <td class="text-right">{{x.AdditionalLoanAmount | number:2}}</td>
                            <td class="text-right">{{x.InterestAmount | number:2}}</td>
                            <td class="text-right">{{x.OtherExpensesPayable | number:2}}</td>
                            <td class="text-right">{{x.TotalLoanLiability | number:2}}</td>
                            <td class="text-right">{{x.LoanSetOff | number:2}}</td>
                            <td class="text-right">{{x.Balance | number:2}}</td>
                            <td>
                                <input type="text" ng-keyup="exchangeGainLossAmountExistingLoan(x)" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="x.LoanSetOffAmount">
                            </td>
                            <td>
                                <input type="text" ng-keyup="exchangeGainLossAmountExistingLoan(x)" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ToCurrencyRate" autocomplete="off" ng-model="x.ToCurrencyRate">
                            </td>
                            <td>
                                <input type="text" readonly n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ConversionAmount" ng-model="x.ConversionAmount">
                            </td>
                            <td>
                                <input type="text" readonly n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeType" ng-model="x.ExchangeType">
                            </td>
                            <td>
                                <input type="text" readonly n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeAmount" ng-model="x.ExchangeAmount">
                            </td>

                            <td class="text-right">
                                <button ng-click="removeRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="13" class="text-right">Total</td>
                            <td class="text-right"><b>{{ (ExistingLoanList) | sumByKey:'LoanSetOffAmount' | number:2}}</b></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </fieldset>
    </div>
