    <h3 class="site-heading"><span class="glyphicon glyphicon-file"></span>Payment Advise Report</h3>


<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Year<sup>*</sup></label>
                <div class="col-sm-8">
                    <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-enablefiltersearch="true" e-value="year" e-databound="SelectDefaultValue" e-fields-value="Text" e-fields-text="Text" e-width="100%" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Month<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-enablefiltersearch="true" e-value="month" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Employee Category<sup></sup></label>
                <div class="col-sm-8">
                    <input id="ddlEmpCatgList" ej-dropdownlist e-create="create" e-multiselectmode="visualmode" e-datasource="employeeCategoryList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Payment Mode<sup>*</sup></label>
                <div class="col-sm-8">
                    <input id="ddlPMList" ej-dropdownlist e-create="create" e-multiselectmode="visualmode" e-datasource="PaymentModeList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true" />
                </div>
            </div>

        </div>
        <div class="common-btn right">
            <button ng-click="GetEmployeeInformation();" class="btn"> <i class="glyphicon glyphicon-download"></i> Go</button>
        </div>
        <div class="clearfix"></div>
        <div class="col-md-12">
            <div id="empInfoGrid" ng-init="chkinit()" ej-grid e-datasource="EmployeeListTemp" e-recorddoubleclick="Get" e-allowscrolling="true" e-pageSettings-pageSize="15"
                 e-actioncomplete="actionCompleteSelected" e-templaterefresh="refreshTemplateemployee"
                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" style="margin-left:1%">

                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="120"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="PaymentMode" e-headertext="Payment Mode" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="BankName" e-headertext="Bank Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="BankAccNo" e-headertext="BankAccNo" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="IFSCCode" e-headertext="IFSCCode" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DisbursmentDate" e-headertext="DisbursmentDate" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="NetPayment" e-headertext="Net Payment" e-allowediting="false" e-width="80"></div>
                </div>
            </div>

        </div>
        <div class="common-btn left">
            <ul class="list-inline text-left">
                <li> <button ng-click="XlsSalaryDisbursement();" class="btn"><i class="glyphicon glyphicon-download-alt"></i> Download</button></li>
            </ul>
        </div>
    </div>
</div>

