<div class="modal fade site-modal in" id="cashPopUpBonus" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="cashForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Cash List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="cashParameters.searchBy">
                                            <option ng-repeat="option in cashSearchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="cashParameters.search" ng-enter="getCashList()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getCashList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>UserName</th>
                                <th>GL</th>
                                <th ng-show="companyConfig.IsVoucherFromBudget">Budget</th>
                                <th ng-show="companyConfig.IsVoucherFromBudget">Activity</th>
                                <th>Plant</th>
                                <th>Entity</th>
                                <th>Currency</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in cashList |itemsPerPage:cashParameters.pageSize" pagination-id="metaData.name + 'cashList'" total-items="cashParameters.total_count"
                                ng-click="selectCashPopUp($index, x.Id)"  ng-dblclick="closeCashPopUpBonus()">
                                <td>{{x.UserName}}</td>
                                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                <td ng-show="companyConfig.IsVoucherFromBudget">{{x.BudgetName}}</td>
                                <td ng-show="companyConfig.IsVoucherFromBudget">{{x.ActivityName}}</td>
                                <td>{{x.PlantName}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.CurrencyCode}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'cashList'"
                                             direction-links="true" boundary-links="true" on-page-change="getBankList(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeCashPopUpBonus()">Selected</button>
            </div>
        </div>
    </div>
</div>