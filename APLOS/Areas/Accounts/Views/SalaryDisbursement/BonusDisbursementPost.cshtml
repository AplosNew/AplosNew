
<div class="form-elements form-horizontal" ng-form="form0">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Info</legend>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Master Id<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" ng-model="voucherBonus.BonusDisbursementAdviceId" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="getBonusMasterData();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From</label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-maxlength="50" name="Year" ng-model="voucherBonus.FromDate" class="form-control" tabindex="7" readonly autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To</label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-maxlength="50" name="Month" ng-model="voucherBonus.ToDate" class="form-control" tabindex="7" readonly autocomplete="off">
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-8 col-md-8">
            <div class="form-group">

                <label class="col-sm-2 control-label">Payment Mode</label>
                <div class="col-sm-4">
                    <div class="select-style">
                        <select id="PaymentModeId" class="form-control" name="Payment Mode" ng-change="changePaymentMode()" ng-model="voucherBonus.PaymentMode" tabindex="5" disabled>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in paymentModeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <label class="col-sm-2 control-label" ng-show="voucherBonus.PaymentMode=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">Payment Bank<sup>*</sup></label>
                <div class="col-sm-4 show-message" ng-show="voucherBonus.PaymentMode=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
                    <div class="input-group">
                        <input type="text" name="BankNameBonus" ng-model="voucherBonus.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{voucherBonus.BankName}}" tooltip>
                        <span class="input-group-btn">
                            <button ng-click="showBankPopUp();" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
                <label class="col-sm-2 control-label" ng-show="voucherBonus.PaymentMode=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">Payment Cash<sup>*</sup></label>
                <div class="col-sm-4 show-message" ng-show="voucherBonus.PaymentMode=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
                    <div class="input-group">
                        <input type="text" name="CashName" ng-model="voucherBonus.CashName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="showCashPopUp(null, voucherBonus.EntityId);" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div id="div_PostingDate" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input required datepicker="getFiscalYearPeriod(voucherBonus.PostingDate);getTaxCodeByTaxYear(voucherBonus.PostingDate);" id="postingDateBonus" type="text" name="PostingDateBonus" ng-model="voucherBonus.PostingDate" class="form-control" tabindex="1">
                </div>
            </div>
        </div>
    </fieldset>

    <div class="clearfix"></div>



    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Service" role="tab" data-toggle="tab">Employee Info</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Payable Info</a></li>

            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div ng-form="tabForm1">

                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Bonus Disbursement</legend>
                        <div class="col-xs-10  col-sm-6 col-md-12" ng-show="empGrid">
                            <div id="empInfoGrid" ng-init="chkinit()" ej-grid e-datasource="employeeDisbursementDataList" e-allowscrolling="true" e-pageSettings-pageSize="15"
                                 e-actioncomplete="actionCompleteSelected" e-templaterefresh="refreshTemplateEmployee"
                                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowsorting="true" style="margin-left:1%">

                                <div e-columns>
                                    <div e-column e-headertext="All" e-headertemplateid="#headerTemplate" e-template="#checkDisbursementProcess" e-textalign="center" e-width="30"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="PayableVoucherNo" e-headertext="Payable Voucher No" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="IsLock" e-headertext="Lock" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="PaymentMode" e-headertext="PaymentMode" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="DisbursementVoucherNo" e-headertext="Disbursement Voucher No" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="IsDisburse" e-headertext="Disbursed" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="Bank" e-headertext="Bank Name" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="BankAccNo" e-headertext="BankAccNo" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="DirectManpowerCost" e-headertext="DirectManpowerCost" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Amount" e-headertext="Amount" e-width="80" e-textalign="right" style="height: 20px;"></div>
                                    <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="PayRollGroup" e-headertext="PayRoll Gruop" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="JobLocation" e-headertext="Job Location" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                                    <div e-column e-field="SalaryProcFlag" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>

                                </div>
                            </div>
                            <script type="text/template" id="checkDisbursementProcess">
                                <input type="checkbox" ng-model="data.isSelected" ng-checked="data.isSelected" ng-click="$parent.pushInTempListforProcess($event,data);">
                            </script>
                            <script type="text/x-jsrender" id="headerTemplate">
                                <input type="checkbox" id="headchk" />
                            </script>
                        </div>
                        <div class="col-sm-12" ng-show="empGrid">
                            <div class="col-sm-6">
                                <div class="common-btn">
                                    <ul style="display:flex; justify-content:space-between">
                                        <li> <button ng-click="XlsSalaryDisbursement();" class="btn"><i class="glyphicon glyphicon-download-alt"></i> Export to Excel</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form="tabForm2">
                <div class="clearfix"></div>
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Payable</legend>
                    <div class="table-responsive modal-table">
                        <table class="table table-responsive table-striped">
                            <thead>
                                <tr>
                                    <th>GL</th>
                                    <th>Budget</th>
                                    <th>Activity</th>
                                    <th class="text-right">Cr</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in salaryLockPayableGLData">
                                    <td>{{x.GLName}}</td>
                                    <td>{{x.BudgetName}}</td>
                                    <td>{{x.ActivityName}}</td>
                                    <td class="text-right">{{x.CrAmount}}</td>
                                </tr>
                            </tbody>
                            <tfoot ng-show="salaryLockPayableGLData.length">
                                <tr>
                                    <td colspan="3" class="text-right"><b> Total</b></td>
                                    <td class="text-right"><b>{{ salaryLockPayableGLData | sumByKey : 'CrAmount' }}</b></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </fieldset>
            </div>

        </div>
    </div>


    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" ng-disabled="saveBtnDisable==true"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="bonusParameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="bonusParameters.search" ng-enter="getBonusData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getBonusData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table ">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>Doc Ref</th>
                    <th>Doc Date</th>
                    <th>Posting Date</th>
                    <th>Month</th>
                    <th>Year</th>
                    <th>Payment Bank/Cash</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in bonusPayables |itemsPerPage:bonusParameters.pageSize" total-items="bonusParameters.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.DocDate | dateFiltering}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.Month}}</td>
                    <td>{{x.YearNo}}</td>
                    <td>{{x.PaymentBank}}</td>
                    <td class="text-right">{{x.DrAmount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.PayableVoucherId);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Accounts/SalaryDisbursement/GetSalaryDisbursementVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.PayableVoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/SalaryDisbursement/GetSalaryDisbursementVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.PayableVoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getBonusData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="BonusDisbursementAdvicepopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify1">
        <div class="modal-content">
            <div class="modal-header">Bonus Disbursement Advice <button type="button" class="close" ng-click="closeBonusPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div style="color:black;" id="GridBonusMaster" ej-grid e-datasource="bonusmasterList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectBonusMaster" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Master Id" e-width="80"></div>
                            <div e-column e-field="FromDate" e-headertext="From" e-width="80"></div>
                            <div e-column e-field="ToDate" e-headertext="To" e-width="80"></div>
                            <div e-column e-field="Status" e-headertext="Status" e-width="80"></div>
                            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                            <div e-column e-field="PaymentMode" e-headertext="Payment Mode" e-width="80"></div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeBonusPopUp();" class="btn"> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(voucherId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="deleteSalaryDisbursement(voucherId,DelMonthNo,DelYearNo)"></confirm-archive-generic>

