<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Info</legend>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="col-md-3 ">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Year <sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select ng-disabled="yearList.length==1" class="form-control" name="Year" ng-model="voucher.YearNo" tabindex="2" ng-change="changeVoucherType(advance.VoucherTypeId)" required>
                                <option value="">--Select--</option>
                                <option ng-repeat="option in yearList" value="{{option.Text}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div id="div_PostingDate" class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input required datepicker="getFiscalYearPeriod(voucher.PostingDate);getTaxCodeByTaxYear(voucher.PostingDate);" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
                    </div>
                </div>
            </div>
            <div class="col-md-3 ">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Month <sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select ng-disabled="monthList.length==1" class="form-control" name="Month" ng-model="voucher.MonthNo" tabindex="2" ng-change="changeMonth()" required>
                                <option value="">--Select--</option>
                                <option ng-repeat="option in monthList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div id="div_DocDate" class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="form-group">
                    <label class="col-sm-2 " style="font-weight:normal;">Regular<sup></sup></label>
                    <div class="col-sm-2" style="padding-left:0px;">
                        <div class="checkbox-site">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="voucher.IsActive">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>

                    <label class="col-sm-3" style="font-weight:normal; ">Seperated<sup></sup></label>
                    <div class="col-sm-1" style="padding-left:0px;">
                        <div class="checkbox-site">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="voucher.IsSeperated">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>

                    <label class="col-sm-3" style="font-weight:normal; ">Going Maternity<sup></sup></label>
                    <div class="col-sm-1" style="padding-left:0px;">
                        <div class="checkbox-site">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="voucher.IsMaternity">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
                    <div class="col-sm-5 show-message">
                        <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
                    </div>
                    <div class="col-sm-4">

                    </div>
                </div>
            </div>
            <div class="col-sm-1 show-message" style="padding-left:0px;">
                <div class="common-btn">
                    <button ng-click="getSalaryLockPayable();" class="btn"><i class="glyphicon glyphicon-circle-arrow-down"></i>Go</button>
                </div>
            </div>
        </div>





