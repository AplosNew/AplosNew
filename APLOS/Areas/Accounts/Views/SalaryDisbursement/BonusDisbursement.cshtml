<div class="row">

    <div class="col-xs-12">
        <div class="col-xs-2"><h3 class="site-heading"><span class="glyphicon glyphicon-file"></span>Bonus Disbursement</h3></div>
        <div class="col-md-10">
            <div class="col-md-12">
                <div class="col-sm-3">
                    <div class="form-group" id="div_FromDate">
                        <label class="col-sm-2" style="font-weight:normal; left:-55px;">From:<sup></sup></label>
                        <div class="col-sm-10" style="left:-45px;">
                            <input type="text" name="Form Date" ng-model="disbursementAdvice.FromDate" datepicker tabindex="2" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group" id="div_ToDate">
                        <label class="col-sm-2" style="font-weight:normal; left:-45px;">To:<sup></sup></label>
                        <div class="col-sm-10"  style="left:-55px;">
                            <input type="text" name="To Date" ng-model="disbursementAdvice.ToDate" datepicker tabindex="3" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="col-sm-5">
                    <div class="col-md-12">
                        <div class="col-md-4 ">
                            <div class="form-group">
                                <label class="col-sm-6 " style="font-weight:normal; left:-85px;">Regular<sup></sup></label>
                                <div class="col-sm-6" style="left:-75px;">
                                    <input type="checkbox" ej-checkbox class="nodetext" e-value="isActive" e-checked="isActive" e-model="isActive" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-sm-8" style="font-weight:normal; left:-100px;">Separated<sup></sup></label>
                                <div class="col-sm-4" style="left:-50px;">
                                    <input type="checkbox" ej-checkbox class="nodetext" e-value="isSeperated" e-checked="isSeperated" e-model="isSeperated" />
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-4 col-sm-4 col-md-4">
                            <div class="form-group">
                                <label class="col-sm-10" style="font-weight:normal; left:-100px;">Maternity<sup></sup></label>
                                <div class="col-sm-2" style="left:-50px;">
                                    <input type="checkbox" ej-checkbox class="nodetext" e-value="isMaternity" e-checked="isMaternity" e-model="isMaternity" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-xs-1 col-sm-1 col-md-1" style="left:-50px;">
                    <div class="form-group">
                        <div class="common-btn">
                            <button ng-click="GetEmployeeInformation();" class="btn"> <i class="glyphicon glyphicon-download"></i> Go</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>


    </div>
    <div class="clearfix"></div>
    <div class="">
        <div class="col-md-12">
            <div class="col-md-6">
                <div class="form-group" style="margin-top:10px;">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <textarea rows="2" maxlength="500" type="text" name="Remarks" tabindex="8" class="form-control" ng-model="disbursementAdvice.Remarks" autocomplete="off"></textarea>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group" style="margin-top:10px;">
                    <label class="col-sm-3 control-label">Payment Mode<sup>*</sup></label>
                    <div class="col-sm-4">
                        <div class="select-style">
                            <select id="PaymentModeId" class="form-control" name="Payment Mode" ng-model="disbursementAdvice.PaymentMode" tabindex="5">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in paymentModeList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
   

    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Service" role="tab" data-toggle="tab">UnDisbursed</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Disbursed</a></li>

            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-show="empGrid">
                    <div class="col-sm-12">
                        <div class="inputBtnSection common-btn">
                            <label class="fileUpload col-sm-4 ">
                                <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                            </label>
                            <input type="button" value="Import Data" class="btn btn-success" ng-click="ImportData()" />
                        </div>
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12">
                        <div id="empInfoGridSalaryUnDisbursed" ng-init="chkinit()" ej-grid e-datasource="BonusUnDisburseList" e-recorddoubleclick="Get" e-allowscrolling="true" e-pageSettings-pageSize="15"
                             e-actioncomplete="actionCompleteSelected" e-templaterefresh="refreshTemplateSalaryUnDisbursed"
                             e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" style="margin-left:1%">

                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="SalaryProcId" e-headertext="SalaryProcId" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="YearNo" e-headertext="Year" e-allowediting="false" e-width="60"></div>
                                <div e-column e-field="MonthName" e-headertext="Month" e-allowediting="false" e-width="60"></div>
                                <div e-column e-field="TotalPayDay" e-headertext="TotalPayDay" e-allowediting="false" e-width="60"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="120"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="CurrentMonthEmployeeStatus" e-headertext="CurrentMonthEmployeeStatus" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="AccountsGroup" e-headertext="AccountsGroup" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="PayableVoucherNo" e-headertext="Payable Voucher No" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="IsLock" e-headertext="Lock" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="DisbursementVoucherNo" e-headertext="Disbursement Voucher No" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="IsDisburse" e-headertext="Disbursed" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="DisbursementDate" e-headertext="Disbursement Date" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="PayRollGroup" e-headertext="PayRoll Gruop" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="JobLocation" e-headertext="Job Location" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="PaymentMode" e-headertext="Payment Mode" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="BankName" e-headertext="Bank Name" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="SalaryProcFlag" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="AddedBy" e-headertext="Created By" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="NetPayment" e-headertext="Bonus Payment" e-allowediting="false" e-width="80"></div>
                            </div>
                        </div>

                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect"/>
                        </script>

                        <script type="text/x-jsrender" id="headerTemplate">

                            <input type="checkbox" id="headchk" />
                        </script>


                    </div>
                    <div class="clearfix"></div>
                    <br />
                    <div class="col-sm-12">
                        <div class="common-btn left">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="SalaryDisbursement();" class="btn" ng-disabled="saveBtnDisable==true"><i class="glyphicon glyphicon-lock"></i> {{Action}}</button></li>
                                <li> <button ng-click="BonusUnDisbursedReportExcel();" class="btn"><i class="glyphicon glyphicon-download-alt"></i> Export to Excel Details</button></li>
                                <li> <button ng-click="BonusUnDisbursementSummaryReportExcel();" class="btn"><i class="glyphicon glyphicon-download-alt"></i> Export to Excel Summary</button></li>

                            </ul>
                        </div>

                    </div>
                </div>

            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-md-12">
                        <div id="empInfoGrid" ej-grid e-datasource="EmployeeListTemp" e-recorddoubleclick="Get" e-allowscrolling="true" e-pageSettings-pageSize="15"
                             e-actioncomplete="actionCompleteSelected" e-templaterefresh="refreshTemplateemployee"
                             e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" style="margin-left:1%">

                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplateB" e-template="#checkboxTemplateB" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="YearNo" e-headertext="Year" e-allowediting="false" e-width="60"></div>
                                <div e-column e-field="MonthName" e-headertext="Month" e-allowediting="false" e-width="60"></div>
                                <div e-column e-field="BonusDisbursementAdviceId" e-headertext="BonusDisbursementAdviceId" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks" e-allowediting="false" e-width="150"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="PayableVoucherNo" e-headertext="Payable Voucher No" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="IsLock" e-headertext="Lock" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="DisbursementVoucherNo" e-headertext="Disbursement Voucher No" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="IsDisburse" e-headertext="Disbursed" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="DisbursementDate" e-headertext="Disbursement Date" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="PayRollGroup" e-headertext="PayRoll Gruop" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="JobLocation" e-headertext="Job Location" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="PaymentMode" e-headertext="Payment Mode" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="BankName" e-headertext="Bank Name" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="SalaryProcFlag" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                                <div e-column e-field="NetPayment" e-headertext="Bonus Payment" e-allowediting="false" e-width="80"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplateB">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" e-enabled="{{data.DisbursementVoucherId != '' ?'false':'true'}}" />
                        </script>
                    </div>
                    <div class="clearfix"></div>
                    <br />
                    <div class="col-sm-12">
                        <div class="common-btn left">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="BonusUnDisbursement();" class="btn" ng-disabled="saveBtnDisable==true"><i class="glyphicon glyphicon-lock"></i>Bonus UnDisbursement</button></li>
                                <li> <button ng-click="BonusDisbursementReportExcel();" class="btn"><i class="glyphicon glyphicon-download-alt"></i> Export to Excel Details</button></li>
                                <li> <button ng-click="BonusDisbursementSummaryReportExcel();" class="btn"><i class="glyphicon glyphicon-download-alt"></i> Export to Excel Summary</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>



