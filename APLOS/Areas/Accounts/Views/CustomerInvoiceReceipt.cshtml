<togglable name="Receipt"></togglable>
<div class="form-elements form-horizontal" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Customer.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Customer.ToString()" ng-model="voucher.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoicing @Library.Model.Parties.PartyType.Customer.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="4" class="form-control" name="Invoicing @Library.Model.Parties.PartyType.Customer.ToString()" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(voucher.InvoicingPartyPlantId,'billTo')" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyAdvanceAmount();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="Entity" ng-model="voucher.EntityId" tabindex="6" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Total Advance<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right " readonly name="TotalAdvanceAmount" ng-model="TotalAdvanceAmount" style="color:red">
                        <span class="input-group-btn">
                            <button ng-click="showPartyAdvanceAmount();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea rows="2" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input ng-click="clearBankPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
                <label>
                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
                <label>
                    <input ng-click="clearTaxPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Tax.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Tax.ToString()
                </label>
                <label>
                    <input ng-click="clearTaxPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Discount.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Discount.ToString()
                </label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Rounding<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="RoundingType" ng-model="voucher.RoundingType" tabindex="3">
                        <option ng-repeat="option in roundingTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div id="div_DocDate" class="form-group" ng-show="voucher.BankMasterId">
            <label class="col-sm-4 control-label">Bank Trn Date</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="BankTransactionDate" ng-model="voucher.BankTransactionDate" datepicker class="form-control" tabindex="4">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="5" name="Currency" required ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" n-decimals="4" name="Rate" ng-keyup="exchangeGainLossCal(voucher.CompanyCurrencyRate);rateChangeBankCharge(voucher.CompanyCurrencyRate)" id="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off" ng-disabled="voucher.CurrencyId==companyCurrencyId">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="voucher.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{voucher.BankName}}" tooltip>
                    <span class="input-group-btn">
                        <button ng-click="showBankPopUp(voucher.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="voucher.CashName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showCashPopUp(null, voucher.EntityId);" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Rounding Amount<sup>*</sup></label>
            <div class="col-sm-8 ">
                <input type="text" ng-disabled="voucher.RoundingType=='None'" n-decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="RoundingAmount" ng-model="voucher.RoundingAmount">
            </div>
        </div>

        <div class="form-group" ng-show="voucher.BankMasterId">
            <label class="col-sm-4 control-label">Bank Ref No</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Bank Reference No" name="Bank Reference No" ng-model="voucher.BankReferenceNo" class="form-control" tabindex="5" autocomplete="off">
            </div>
        </div>
    </div>
    @*<div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" ng-show="isBankAmount">
                <label class="col-sm-4 control-label">Bank Amount<sup>*</sup></label>
                <div class="col-sm-8 ">
                    <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="voucher.BankAmount">
                </div>
            </div>
        </div>*@
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="col-xs-12 col-sm-2 col-md-2">
            <button class="btn single-btn" ng-click="getPopupCustomerReceivableList()" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Select Receivable</button>
        </div>
        <div class="clearfix"></div>
        <div class="table-responsive modal-table" ng-show="voucherDetailList.length">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Voucher No</th>
                        <th>DocDate</th>
                        <th>Doc Ref No</th>
                        <th>Activity</th>
                        <th>Currency</th>
                        <th>Rate</th>
                        <th class="text-right">Receivable</th>
                        <th class="text-right">Received</th>
                        <th class="text-right">Balance</th>
                        <th class="text-right">Amount</th>
                        <th>Exchange Type</th>
                        <th>Exchange Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in voucherDetailList">
                        <td>{{x.VoucherNo}}</td>
                        <td>{{x.DocDate |dateFiltering}}</td>
                        <td>{{x.DocRefNo}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td>{{x.CurrencyCode}}</td>
                        <td>{{x.CompanyCurrencyRate}}</td>
                        <td class="text-right">{{x.Receivable | number:3}}</td>
                        <td class="text-right">{{x.Received | number:3}}</td>
                        <td class="text-right">{{x.Balance | number:3}}</td>
                        <td>
                            <input ng-keyup="exchangeGainLossAmount(x)" type="text" n-decimals="3" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="x.Amount">
                        </td>
                        <td>
                            <input readonly type="text" n-decimals="3" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeType" ng-model="x.ExchangeType">
                        </td>
                        <td>
                            <input readonly type="text" n-decimals="3" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeAmount" ng-model="x.ExchangeAmount">
                        </td>
                        <td class="text-right">
                            <button ng-click="removeRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="9" class="text-right">Total</td>
                        <td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'Amount' | number:3}}</b></td>
                        <td></td>
                        <td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'ExchangeAmount' | number:3}}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 modal-table" ng-hide="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Tax.ToString()' ||voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Discount.ToString()'">
        <table class="table table-responsive table-striped">
            <caption>Charges</caption>
            <thead>
                <tr>
                    <th>Charges Type</th>
                    <th>Trn. Amount</th>
                    <th>{{companyCurrencyCode}}</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_FinancingType">
                        <div class="select-style show-message">
                            <select ng-model="bankCharge.FinancingTypeId">
                                <option ng-repeat="option in bankChargeTypeList" value="{{option.FinancingTypeId}}">{{option.ExpensesUserName}}</option>
                            </select>
                        </div>
                    </td>
                    <td id="td_FinancingTypeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="bankCharge.Amount" ng-keyup="copyChargesAmount();">
                        </div>
                    </td>
                    <td id="td_FinancingTypeCompanyCurrencyAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" readonly ng-model="bankCharge.CompanyCurrencyAmount">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addCharge();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in bankChargesList">
                    <td>{{x.FinancingTypeName}}</td>
                    <td class="text-right">{{x.Amount | number:2 }}</td>
                    <td class="text-right">{{x.CompanyCurrencyAmount | number:2}}</td>
                    <td class="text-right">
                        <button ng-click="removeChargesRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="bankChargesList.length">
                <tr>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ bankChargesList | sumByKey : 'Amount' }}</b></td>
                    <td class="text-right"><b>{{ bankChargesList | sumByKey : 'CompanyCurrencyAmount'  }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 modal-table" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Tax.ToString()'">
        <table class="table table-responsive table-striped">
            <caption>Tax<sup>TDS and Creditable Taxcode</sup></caption>
            <thead>
                <tr>
                    <th>Input Tax</th>
                    <th>Percentage</th>
                    <th>Amount</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_TaxCode">
                        <div class="select-style show-message">
                            <select ng-model="advanceTax.TaxCodeId" name="TDSTaxCodeId"  ng-change="selectTDS(advanceTax.TaxCodeId)" class="col-sm-3 form-control">
                                <option ng-repeat="option in taxCodCboList" value="{{option.Id}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <div>
                            <input type="text" n-decimals="2" class="form-control text-right" ng-disabled="advanceTax.Type =='FixedPercentage' && advanceTax.ValueOfFixed!=null" ng-model="advanceTax.ValueOfFixed">
                        </div>
                    </td>
                    <td id="td_TaxCodeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="3" class="form-control text-right" ng-model="advanceTax.TaxAmount" ng-keyup="copyTaxesAmount();">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addTax();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in advanceTaxesList">
                    <td>{{x.TaxName}}</td>
                    <td>{{x.ValueOfFixed}}</td>
                    <td class="text-right">{{x.TaxAmount | number:3 }}</td>
                    <td class="text-right">
                        <button ng-click="removeTaxesRow($index)" data-toggle="modal" ng-disabled="x.AdvanceId" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="advanceTaxesList.length">
                <tr>
                    <td colspan="2"><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ advanceTaxesList | sumByKey : 'TaxAmount' | number:3}}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="confirmSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchVendorInvoiceList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Customer</th>
                <th>Posting Date</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in paymentList |itemsPerPage:$root.pageSize" total-items="$root.total_count" @*ng-dblclick="getById(x.Id);"*@>
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td>{{x.IsPark?'Parked':'Posted'}}</td>
                <td align="right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>

                        <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>

                        <li><a class="btn btn-action" href="Accounts/invoice/CustomerInvoiceReceiptReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Accounts/invoice/CustomerInvoiceReceiptReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<div class="modal fade site-modal in" id="confirmDeletePopUp_Remarks" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:600px">
        <div class="modal-content" ng-form name="confirmDeletePopUp_RemarksForm">
            <div class="modal-header">Are you sure to Delete?</div>
            <div class="modal-body">
                <div class="form-group" show-errors>
                    <label class="col-sm-2 control-label">Remarks<sup>*</sup></label>
                    <div class="col-sm-10 show-message">
                        <textarea rows="4" type="text" maxlength="500" name="DeletedRemarks" tabindex="8" class="form-control" ng-model="deletedRemarks" required></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeconfirmDeletePopUp_Remarks()">No</button>
                <button type="button" class="btn btn-default" ng-click="delete(invoiceWriteOffId,voucherId,deletedRemarks)">Yes</button>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmSavePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Save()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(invoiceWriteOffId)"></confirm-archive-generic>
@*<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(invoicewriteOffId,voucherId)"></confirm-archive-generic>*@


