<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> General Ledger</h3>
<div class="form-elements form-horizontal" ng-form="from0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors id="div_GL">
            <label class="col-sm-3 control-label">GL<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select name="Fiscal Year" class="form-control searchableDDL" ng-change="getBudgetMasterCboList(report.GLGeneralInfoId);" ng-model="report.GLGeneralInfoId" required>
                            <option ng-repeat="option in glList" value="{{option.GLGeneralInfoId}}">{{option.GLGeneralInfoCode}} - {{option.GLGeneralInfoName}}</option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="GetCOAICodeList();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Budget</label>
            <div class="col-sm-9">
                <div class="select-style">
                    <select name="Budget" class="form-control searchableDDL" ng-model="report.BudgetMasterId" ng-change="getBudgetMasterActivityCbo(report.BudgetMasterId)">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in budgetList" value="{{option.BudgetMasterId}}">{{option.BudgetName}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Activity</label>
            <div class="col-sm-9">
                <div class="select-style">
                    <select name="Activity" class="form-control searchableDDL" ng-model="report.ActivityId">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in activityList" value="{{option.ActivityId}}">{{option.ActivityName}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors id="div_FromDate">
            <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="Form Date" ng-model="report.FromDate" datepicker tabindex="2" class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors id="div_ToDate">
            <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-9  show-message">
                <input type="text" name="To Date" ng-model="report.ToDate" datepicker tabindex="3" class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors id="div_Cash">
            <label class="col-sm-3 control-label">Bank Cash Party</label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="BankCashParty" class="form-control" ng-model="report.BankCashParty" ng-options="item.value as item.name for item in BankCashPartyByList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors id="div_Bank" ng-show="report.BankCashParty=='Bank'">
            <label class="col-sm-3 control-label">Bank</label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="BankName" ng-model="report.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{report.BankName}}" tooltip>
                    <span class="input-group-btn">
                        <button ng-click="showALLBankPopUp();" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors id="div_Cash" ng-show="report.BankCashParty=='Cash'">
            <label class="col-sm-3 control-label">Cash</label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Cash" class="form-control" ng-model="report.CashMasterId" ng-options="item.Id as item.UserName for item in cashkMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors id="div_PartyType" ng-show="report.BankCashParty=='Party'">
            <label class="col-sm-3 control-label">Party Type</label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Party Type" class="form-control" ng-change="changePartyType();" ng-model="report.PartyType">
                        <option label="Customer" value="Customer" selected="selected">Customer</option>
                        <option label="Vendor" value="Vendor">Vendor</option>
                        <option label="Director" value="Director">Director</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors id="div_Party" ng-show="report.BankCashParty=='Party'">
            <label class="col-sm-3 control-label">Party</label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="Party" ng-model="customerNameCode" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">DocRef.</label>
            <div class="col-sm-9">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="report.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-3 control-label">Is Group By.</label>
            <div class="col-sm-9">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="report.IsGroupBy">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Format<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                </label>
                <label>
                    <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                </label>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
            <li><button ng-click="clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            @*<li><button ng-click="getReportWithDocRef();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Doc</button></li>*@
        </ul>
    </div>
</div>
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLBudgetPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_ALLBankPopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")