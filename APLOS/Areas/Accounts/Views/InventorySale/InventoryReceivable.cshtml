<div class="modal fade site-modal in" id="JournalPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="PopUpForm1">
            <div class="modal-content">
                <div class="modal-header"> Journal</div>
                <div class="modal-body">
                    <div class="form-horizontal">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="VoucherDate" ng-model="otherVoucher.VoucherDate" datepicker class="form-control" disabled>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input datepicker id="DocDate" type="text" name="Doc Date" ng-model="otherVoucher.PostingDate" class="form-control" readonly>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" maxlength="50" name="Doc Ref No" ng-model="otherVoucher.DocRefNo" class="form-control" tabindex="4" readonly>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select id="VoucherType" class="form-control" name="VoucherType" ng-model="otherVoucher.VoucherTypeId" ng-disabled="voucherTypeListnew.length==1" tabindex="7">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in voucherTypeListnew" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div id="div_PostingDate" class="form-group" >
                                <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input datepicker id="DocDate" type="text" name="Doc Date" ng-model="otherVoucher.DocDate" class="form-control" readonly>
                                </div>
                            </div>
                            <div class="form-group" >
                                <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <textarea rows="1" type="text" ng-maxlength="250" name="Narration"  class="form-control" ng-model="otherVoucher.Narration"  capitalize></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Particulars</th>
                                        <th>GL</th>
                                        <th>Budget</th>
                                        <th>Activity</th>
                                        <th>Dr</th>
                                        <th>Cr</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in otherInvoiceDetailList| orderBy:'Dr'">
                                        <td>{{x.Customer}}</td>
                                        <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                        <td>{{x.BudgetName}}</td>
                                        <td>{{x.ActivityName}}</td>
                                        <td class="text-right">{{x.Dr | number| setDecimal:4}}</td>
                                        <td class="text-right">{{x.Cr | number| setDecimal:4}}</td>
                                    </tr>
                                    <tr>
                                        <td colspan="4"></td>
                                        <td class="text-right"><strong>{{otherInvoiceDetailList | sumByKey : 'Dr' | number| setDecimal:4}}</strong></td>
                                        <td class="text-right"><strong>{{otherInvoiceDetailList | sumByKey : 'Cr' | number| setDecimal:4}}</strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button type="button" class="btn btn-default" ng-disabled="otherVoucher.OtherIsPark=='OtherInvoiceParked'" ng-click="OtherInvoiceVouchereReport();">Print</button></li>

                                <li><button ng-click="confirmotherInvoicePost(OtherInvoiceJournalId,otherVoucher,otherInvoiceDetailList)" title="Post" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
                                <li><button ng-click="closeJournalPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
