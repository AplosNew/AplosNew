                            <div e-column e-field="EmployeeName" e-headertext="Employee" e-width="150"></div>
                            <div e-column e-field="Id" e-headertext="Sales No" e-width="50" textAlign='Center'></div>
                            <div e-column e-field="SalesDate" e-headertext="Sales Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-width="100"></div>
                            <div e-column e-field="PostingDate" e-headertext="PostingDate" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                            <div e-column e-field="DocDate" e-headertext="Doc Ref Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="TransactionQty" e-headertext="Tran.Qty" e-width="100" textAlign='Right'></div>
                            <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="60" textAlign='Right'></div>
                            <div e-column e-field="TransactionAmount" e-headertext="Tran Amount" e-width="100" textAlign='Right'></div>
                            <div e-column e-field="MaterialStorageName" e-headertext="Storage Location" e-width="130"></div>
                            <div e-column e-headertext="PDF" e-commands="commandPDF" e-isunbound=true e-textalign="center" e-width="60"></div>
                            <div e-column e-headertext="Excel" e-commands="commandExcel" e-isunbound=true e-textalign="left" e-width="60"></div>
                            <div e-column e-headertext="Sales" e-commands="commandSales" e-isunbound=true e-textalign="left" e-width="60"></div>
                        </div>
                    </div>
                    <i>**Showing top 300 Posted Sales  order by PostingDate</i>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetSalesList(2), active: isSetSalesList(2) }">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByPostedSales2">
                                            <option ng-repeat="option in searchByPostedSaleList2" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchSales2" ng-enter="getInventorySalesDataList();">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getInventorySalesDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridInventory" ej-grid e-datasource="inventorySales" e-allowfiltering="true" e-allowpaging="true"
                         e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
                         e-actioncomplete="actionCompleteSelected" e-allowscrolling="true" e-showstackedheader="true">
                        <div e-columns>
                            <div e-column e-field="GRNType" e-headertext="Type" e-width="60" e-filter="false"></div>
                            <div e-column e-field="PartyName" e-headertext="Party" e-width="150"></div>
                            <div e-column e-field="Id" e-headertext="Sales No" e-width="50" textAlign='Center'></div>
                            <div e-column e-field="SalesDate" e-headertext="Sales Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-width="100"></div>
                            <div e-column e-field="PostingDate" e-headertext="PostingDate" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                            <div e-column e-field="DocDate" e-headertext="Doc Ref Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="TransactionQty" e-headertext="Tran.Qty" e-width="100" textAlign='Right'></div>
                            <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="60" textAlign='Right'></div>
                            <div e-column e-field="TransactionAmount" e-headertext="Tran Amount" e-width="100" textAlign='Right'></div>
                            <div e-column e-field="MaterialStorageName" e-headertext="Storage Location" e-width="130"></div>
                            <div e-column e-headertext="PDF" e-commands="commandInventoryPDF" e-isunbound=true e-textalign="center" e-width="60"></div>
                            <div e-column e-headertext="Excel" e-commands="commandInventoryExcel" e-isunbound=true e-textalign="left" e-width="60"></div>
                            <div e-column e-headertext="Sales" e-commands="commandInventorySales" e-isunbound=true e-textalign="left" e-width="60"></div>
                        </div>
                    </div>
                    <i>**Showing top 300 Posted Sales  order by PostingDate</i>
                </div>
            </div>
        </div>
    </div>
</div>
