<div class="modal fade site-modal in" id="employeeAdvancePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Employee Advance List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeAdvanceParameters.searchBy">
                                            <option ng-repeat="option in employeeAdvanceSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeAdvanceParameters.search" ng-enter="getEmployeeAdvanceData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeAdvanceData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Voucher No</th>
                                <th>Employee</th>
                                <th>DocDate</th>
                                <th>Doc Ref No</th>
                                <th>Entity</th>
                                <th>Transaction Type</th>
                                <th>Currency</th>
                                <th>Advanced</th>
                                <th>Write-off</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeAdvanceDataList |itemsPerPage:employeeAdvanceParameters.pageSize" pagination-id="metaData.name + 'employeeAdvanceDataList'" total-items="employeeAdvanceParameters.total_count"
                                ng-class="{selected : x.AdvanceId == rowSelected}" ng-dblclick="closeEmployeeSalaryAdvancePopUp(x)">
                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.EmployeeCode}} - {{x.EmployeeName}}</td>
                                <td>{{x.DocDate |dateFiltering}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.EmployeeTransactionTypeName}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td class="text-right">{{x.Receivable | number:2}}</td>
                                <td class="text-right">{{x.Received | number:2}}</td>
                                <td class="text-right">{{x.Balance | number:2}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'employeeAdvanceDataList'"
                                             direction-links="true" boundary-links="true" on-page-change="getEmployeeAdvanceData(newPageNumber)"></dir-pagination-controls>
                </div>
            </div>



            <div class="modal-footer common-btn">
                @*TODO:*@
                <button type="button" class="btn btn-default" ng-click="EmployeeAdvanceDueList();">Report</button>
                <button type="button" class="btn btn-default" ng-click="closeEmployeeSalaryPopUp();">Close</button>
            </div>


        </div>
    </div>
</div>