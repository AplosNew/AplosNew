<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Day Books</h3>
<div class="form-elements form-horizontal" ng-form id="from" name="from">
   
    <div class="col-xs-12 col-sm-5 col-md-5">

        <div class="form-group">
            <label class="col-sm-3 control-label">Date Type<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input type="radio" name="DateType" ng-model="report.DateType" value='PostingDate'>
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>Posting Date
                </label>

                <label>
                    <input ng-click="clearBankPopUp()" type="radio" name="DateType" ng-model="report.DateType"  value='EntryDate'>
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>Entry Date
                </label>
               
            </div>
        </div>


        <div class="form-group" show-errors id="div_FromDate">
            <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="From Date" ng-model="report.FromDate" datepicker class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors id="div_ToDate">
            <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="To Date" ng-model="report.ToDate" datepicker class="form-control" required tabindex="6">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Format<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input type="radio" name="ReportFormat" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                </label>
                <label>
                    <input type="radio" name="ReportFormat" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                </label>
            </div>
        </div>
    </div>

        <div class="common-btn">
            <ul class="list-inline text-left">

                <li><button ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
            </ul>
        </div>
    </div>

