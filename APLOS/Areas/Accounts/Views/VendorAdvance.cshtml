<togglable name="{{title}}"></togglable>
<div class="form-horizontal form-elements" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="advance.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoicing @Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="4" class="form-control" name="Invoicing @Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="advance.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }"
                                ng-change="changePartyPlantList(advance.PartyPlantId)" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(advance.PartyPlantId);" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input ng-click="clearBankPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
                <label>
                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="advance.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{advance.BankName}}" tooltip>
                    <span class="input-group-btn">
                        <button ng-click="showBankPopUp(advance.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="advance.CashName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showCashPopUp(null, advance.EntityId);" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea ng-keyup="updatePartyAmount();" rows="3" type="text" name="Narration" tabindex="24" maxlength="250" class="form-control" ng-model="advance.Narration" required capitalize></textarea>
            </div>
        </div>
        <div class="form-group" ng-show="advance.BankMasterId">
            <label class="col-sm-4 control-label">Bank Ref No</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Bank Reference No" name="Bank Reference No" ng-model="advance.BankReferenceNo" class="form-control" tabindex="5" autocomplete="off">
            </div>
        </div>
        <div class="form-group" ng-show="advance.BankMasterId">
            <label class="col-sm-4 control-label">Bank Trn Date</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="BankTransactionDate" ng-model="advance.BankTransactionDate" datepicker class="form-control" tabindex="4">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input tabindex="7" type="text" name="VoucherDate" ng-model="advance.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();changePostingGetTaxCode();" id="postingDate" type="text" name="PostingDate" ng-model="advance.PostingDate" class="form-control" tabindex="8">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" id="DocDate" name="Doc Date" ng-model="advance.DocDate" datepicker="checkPostingDate();checkDocDate();" required class="form-control" tabindex="12">
            </div>
        </div>
        <div class="form-group" id="div_qty" show-errors>
            <label class="col-sm-4 control-label"> Advance Amount<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <input name="Amount" tabindex="19" ng-model="advance.Amount" ng-change="setCrExchangeRate(advance.GLGeneralInfoId); updatePartyAmount(); copyAmount();" type="text" n-decimals="2" class="form-control text-right" autocomplete="off" required>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <div class="select-style">
                    <select id="currencyId" class="form-control" tabindex="14" name="Currency" ng-model="advance.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" required>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="isBankAmount">
            <label class="col-sm-4 control-label">Bank Amount<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="BankAmount" ng-model="advance.BankAmount">
            </div>
        </div>
        <div class="form-group" id="div_ReviewDate" show-errors>
            <label class="col-sm-4 control-label">Review Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" id="Review Date" name="Review Date" ng-model="advance.ReviewDate" datepicker="checkReviewDate();" class="form-control" tabindex="15" required>
            </div>
        </div>
        <div class="form-group" ng-show="advance.PartyId">
            <label class="col-sm-4 control-label">PO </label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="POId" ng-model="advance.POId" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{advance.POId}}" tooltip>
                    <span class="input-group-btn">
                        <button ng-click="getPOList(advance.PartyId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="advance.VoucherTypeId" tabindex="11" required ng-change="changeVoucherType(advance.VoucherTypeId);GetCurrencyExchangeRateList()">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="Entity" ng-model="advance.EntityId" tabindex="16" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="advance.DocRefNo" class="form-control" tabindex="13" required autocomplete="off" capitalize>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Rate<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="advance.CompanyCurrencyRate" ng-keyup="rateChangeBankCharge(advance.CompanyCurrencyRate)" class="form-control text-right" tabindex="6" required autocomplete="off" n-decimals="4" ng-disabled="advance.CurrencyId==companyCurrencyId">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label title="Responsible Person" class="col-sm-4 control-label">Res.Person<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="input-group" show-message>
                    <input type="text" name="Responsible Person" ng-model="advance.ResponsiblePerson" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp()" class="btn single-small-btn" tabindex="20"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearEmployeePopUp()" class="btn single-small-btn" tabindex="21"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6 modal-table">
        <table class="table table-responsive table-striped">
            <caption>Charges</caption>
            <thead>
                <tr>
                    <th>Charges Type</th>
                    <th>Trn. Amount</th>
                    <th>{{companyCurrencyCode}}</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_FinancingType">
                        <div class="select-style show-message">
                            <select ng-model="advanceCharge.FinancingTypeId">
                                <option ng-repeat="option in bankChargeTypeList" value="{{option.FinancingTypeId}}">{{option.ExpensesUserName}}</option>
                            </select>
                        </div>
                    </td>
                    <td id="td_FinancingTypeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="advanceCharge.Amount" ng-keyup="copyChargesAmount();">
                        </div>
                    </td>
                    <td id="td_FinancingTypeCompanyCurrencyAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" readonly ng-model="advanceCharge.CompanyCurrencyAmount">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addCharge();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in advanceChargesList">
                    <td>{{x.FinancingTypeName}}</td>
                    <td class="text-right">{{x.Amount | number:2 }}</td>
                    <td class="text-right">{{x.CompanyCurrencyAmount | number:2}}</td>
                    <td class="text-right">
                        <button ng-click="removeChargesRow($index)" data-toggle="modal" ng-disabled="x.AdvanceId" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="advanceChargesList.length">
                <tr>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ advanceChargesList | sumByKey : 'Amount' }}</b></td>
                    <td class="text-right"><b>{{ advanceChargesList | sumByKey : 'CompanyCurrencyAmount'  }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 modal-table">
        <table class="table table-responsive table-striped">
            <caption>Tax</caption>
            <thead>
                <tr>
                    <th>Input Tax</th>
                    <th>Amount</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_TaxCode">
                        <div class="select-style show-message">
                            <select ng-model="advanceTax.TaxCodeId">
                                <option ng-repeat="option in taxCodCboList" value="{{option.Id}}">{{option.UserName}}</option>
                            </select>
                        </div>
                    </td>
                    <td id="td_TaxCodeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="advanceTax.TaxAmount" ng-keyup="copyTaxesAmount();">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addTax();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in advanceTaxesList">
                    <td>{{x.TaxName}}</td>
                    <td class="text-right">{{x.TaxAmount | number:2 }}</td>
                    <td class="text-right">
                        <button ng-click="removeTaxesRow($index)" data-toggle="modal" ng-disabled="x.AdvanceId" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="advanceTaxesList.length">
                <tr>
                    <td><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ advanceTaxesList | sumByKey : 'Amount' }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="clearfix"></div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="advance.Id==null"><button ng-click="confirmPost(advance.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>@Library.Model.Parties.PartyType.Vendor.ToString()</th>
                    <th>Invoicing @Library.Model.Parties.PartyType.Vendor.ToString()</th>
                    <th>Posting Date</th>
                    <th>Entity</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Set-off Amount</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>{{x.PartyPlantName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.EntityName}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                    <td class="text-right">{{x.WrittenOffAmount | number:2}}</td>
                    <td class="text-right">{{x.Amount-x.WrittenOffAmount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id,x);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/ReportVendorAdvance?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/ReportVendorAdvance?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("~/Areas/Banks/Views/_CashPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_PostPopUp.cshtml")
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(advanceId,voucherId)"></confirm-archive-generic>
@*<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(advanceId)"></confirm-archive-generic>*@

<div class="modal fade site-modal in" id="POPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Approved PO List<button type="button" class="close" ng-click="POPopUpClose();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-lg-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="POMaster" ej-grid e-datasource="POList"
                             e-templaterefresh="refreshTemplateMasterOrderOperation"
                             e-recorddoubleclick="SelectPO"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="PartyName" e-headertext="Vendor" e-width="200"></div>
                                <div e-column e-field="InvoicingBy" e-headertext="Invoicing Party Name" e-width="200"></div>
                                <div e-column e-field="POType" e-headertext="POType" e-width="100"></div>
                                <div e-column e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="150"></div>
                                <div e-column e-field="Id" e-headertext="PO No" e-width="80"></div>
                                <div e-column e-field="PODate" e-headertext="PO Date" e-width="100"></div>
                                <div e-column e-field="DocRefNo" e-headertext="DocRefNo" e-width="200"></div>

                                <div e-column e-field="ContractNo" e-headertext="Contract No" e-width="80"></div>
                                <div e-column e-field="LCNo" e-headertext="LC Ref No" e-width="150"></div>
                                <div e-column e-field="CustomerName" e-headertext="Customer Name" e-width="80"></div>
                                <div e-column e-field="UDNo" e-headertext="UD" e-width="80"></div>
                                <div e-column e-field="OpeningBank" e-headertext="OpeningBank" e-width="80"></div>
                                <div e-column e-field="AcceptanceId" e-headertext="Acceptance No" e-width="150"></div>
                                <div e-column e-field="TransactionQty" e-headertext="Qty" e-width="100"></div>
                                <div e-column e-field="Currency" e-headertext="Currency" e-width="100"></div>
                                <div e-column e-field="TransactionAmount" e-headertext="Amount" e-width="100" format="{0:N2}"></div>
                                <div e-column e-field="BaseAmount" e-headertext="T.Amount" e-width="100" format="{0:N2}"></div>
                                <div e-column e-field="CtnId" e-headertext="App.No" e-width="100"></div>
                            </div>

                        </div>
                    </div>

                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="ClsoePOPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>