<div class="modal fade site-modal in" id="VendorPaymentPlanListPopUP" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:1000px">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closePopUp()">&times;</button>
                <h4 class="modal-title">Payable</h4>
            </div>
            <div class="modal-body">
                <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>
                                        @*<button type="button" ng-click="expandAll(allExpanded = !allExpanded)">
                                                <span ng-bind="allExpanded ? '-' : '+'"></span>
                                            </button>*@
                                    </th>
                                    <th>Vendor</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat-start="ven in vendorPaymentDetailList">
                                    <td>
                                        <button ng-click="expanded = !expanded;getDetailData(ven)" expand>
                                            <span ng-bind="expanded ? '-' : '+'"></span>
                                        </button>
                                    </td>
                                    <td>{{ven.PartyName}}</td>
                                    <td>{{ven.Amount | number:4}}</td>
                                </tr>
                                <tr ng-repeat-end ng-show="expanded">
                                    <td></td>
                                    <td colspan="6">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr ng-show="ven.PartyId">
                                                    <th style="width:15%;">Doc Ref</th>
                                                    <th style="width:15%;">Doc Date</th>
                                                    <th style="width:15%;">Invoice Amount</th>
                                                    <th style="width:15%;">Payment Made</th>
                                                    <th style="width:15%;">Current Payment</th>
                                                    <th style="width:15%;">Balance</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat="pd in paymentDetailList|filter:{PartyId:ven.PartyId}">
                                                    <td style="width:15%;">{{pd.DocRefNo}}</td>
                                                    <td style="width:15%;">{{pd.DocDate | dateFiltering}}</td>
                                                    <td style="width:15%;">{{pd.Payable | number:4}}</td>
                                                    <td class="text-right" style="width:15%;">{{pd.PaymentMade | number:4}}</td>
                                                    <td class="text-right" style="width:15%;">{{pd.Amount | number:4}}</td>
                                                    <td class="text-right" style="width:15%;">{{pd.Balance | number:4}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closePopUp()">Select</button>
            </div>
        </div>
    </div>
</div>