<togglable name="{{title}}"></togglable>
<div class="form-horizontal form-elements" ng-form="form0" id="form0">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">@Library.Model.Parties.PartyType.Customer.ToString()<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Customer.ToString()" ng-model="advance.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Ordering @Library.Model.Parties.PartyType.Customer.ToString() ({{partyPlantList.length}})<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="4" class="form-control" name="Ordering @Library.Model.Parties.PartyType.Customer.ToString()" ng-model="advance.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(advance.InvoicingPartyPlantId,'billTo')" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(advance.PartyPlantId);" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Transaction</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Journal</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form="tabForm1">
                <div class="row">
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="7" type="text" name="VoucherDate" ng-model="advance.VoucherDate" datepicker class="form-control" disabled required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="advance.VoucherTypeId" tabindex="11" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div id="div_entity" class="form-group">
                            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="entityId" class="form-control" name="entity" ng-model="advance.EntityId" tabindex="16">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
                            <div class="col-sm-8 radio">
                                <label>
                                    <input ng-click="clearBankPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                                </label>
                                <label>
                                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                                </label>
                                <label>
                                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Journal.ToString()">
                                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Journal.ToString()
                                </label>
                            </div>
                        </div>
                        <div class="form-group" ng-show="isBankAmount">
                            <label class="col-sm-4 control-label">Bank Amount<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="advance.BankAmount">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div id="div_PostingDate" class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="advance.PostingDate" class="form-control" tabindex="8">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="50" id="Doc Ref" name="Doc Ref" ng-model="advance.DocRefNo" class="form-control" tabindex="13" required>
                            </div>
                        </div>
                        <div class="form-group" id="div_qty">
                            <label class="col-sm-4 control-label">Amount<sup>*</sup></label>
                            <div class="col-sm-5 show-message" style="padding-right:0px;">
                                <input ng-disabled="advance.JournalId" tabindex="19" ng-model="advance.Amount" ng-change="setDrExchangeRate(advance.GLGeneralInfoId); updateCrAmount(); copyAmount();" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right">
                            </div>
                            <div class="col-sm-3 show-message" style="padding-left:0px;">
                                <div class="select-style">
                                    <select id="currencyTransactionId" class="form-control" tabindex="14" name="CurrencyTransaction" ng-model="advance.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
                            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input tabindex="22" type="text" name="CashName" ng-model="advance.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{advance.BankName}}" tooltip>
                                    <span class="input-group-btn">
                                        <button ng-click="showBankPopUp(advance.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
                            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="CashName" ng-model="advance.CashName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="showCashPopUp(null, advance.EntityId);" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Journal.ToString()'">
                            <label class="col-sm-4 control-label">Advance<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="CashName" ng-model="advance.AdvanceNo" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="showAdvanceInterTransactionPopUp();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div id="div_DocDate" class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" id="DocDate" name="DocDate" ng-model="advance.DocDate" datepicker="checkPostingDate(); checkDocDate();" required class="form-control" tabindex="12">
                            </div>
                        </div>
                        <div class="form-group" id="div_ReviewDate">
                            <label class="col-sm-4 control-label">Review Date</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" id="Review Date" name="Review Date" ng-model="advance.ReviewDate" datepicker="checkReviewDate();" class="form-control" tabindex="15">
                            </div>
                        </div>
                        <div class="form-group">
                            <label title="Responsible Person" class="col-sm-4 control-label">Res.Person</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" name="Responsible Person" ng-model="advance.ResponsiblePerson" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="showEmployeeListPopUp()" class="btn single-small-btn" tabindex="20"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="clearEmployeePopUp()" class="btn single-small-btn" tabindex="21"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">InterTransaction</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input ng-disabled="advance.JournalId" type="checkbox" ng-model="advance.IsInterTransaction">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-8 col-md-8">
                        <div class="form-group" show-errors>
                            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
                            <div class="col-sm-10 show-message">
                                <textarea ng-keyup="updateCrAmount();" rows="1" type="text" name="Narration" tabindex="24" class="form-control" ng-model="advance.Narration" required capitalize></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <fieldset class="scheduler-border" ng-show="advance.IsInterTransaction">
                        <legend class="scheduler-border">Inter Transaction</legend>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div id="div_TransactionType" class="form-group">
                                <label class="col-sm-4 control-label">Transaction Type</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select ng-change="getTransactionTypeGL(advance.FinancingTypeId)" name="Transaction Type" class="form-control" ng-model="advance.FinancingTypeId" tabindex="5">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.LiabilityUserName}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div id="div_Company" class="form-group">
                                <label class="col-sm-4 control-label">Company</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Company Name" id="CompanyId" ng-model="advance.CompanyId" class="col-sm-3 form-control"
                                                ng-change="companyChange(advance.CompanyId)" ng-options="item.CompanyId as item.CompanyName for item in companyList" tabindex="9">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-5 col-md-5">
                            <div id="div_Plant" class="form-group">
                                <label class="col-sm-4 control-label">Plant</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Plant Name" id="PlantId" ng-model="advance.PlantId" class="col-sm-3 form-control" ng-options="item.PlantId as item.PlantName for item in interplantList" tabindex="10">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-4 col-sm-1 col-md-1">
                            <div class="common-btn">
                                <button ng-click="getCompanyInfo(advance.CompanyId); getPlantInfo(advance.PlantId);addRow();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> Add</button>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="col-xs-12 col-sm-12 col-md-12 modal-table">
                            <table class="table table-responsive table-striped">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Plant</th>
                                        <th>Narration</th>
                                        <th>Amount</th>
                                        <th class="text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in advanceDetailList">
                                        <td>{{x.PartyName}}</td>
                                        <td>{{x.PartyPlantName}}</td>
                                        <td id="td_Narration_{{$index}}">
                                            <div class="show-message">
                                                <input ng-disabled="'@Library.Model.Parties.PartyType.Customer.ToString()'==x.PartyType" type="text" class="form-control" ng-model="x.Narration" placeholder="Narration" maxlength="250" ng-keyup="checkRowValidation(x, $index)">
                                            </div>
                                        </td>
                                        <td id="td_Amount_{{$index}}">
                                            <div class="show-message">
                                                <input ng-disabled="'@Library.Model.Parties.PartyType.Customer.ToString()'==x.PartyType&&!advance.IsInterTransaction" ng-keyup="updateCrAmount();checkRowValidation(x, $index);" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.Amount">
                                            </div>
                                        </td>
                                        <td class="text-right">
                                            <button ng-hide="'@Library.Model.Parties.PartyType.Customer.ToString()'==x.PartyType" ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot ng-show="advanceDetailList.length">
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td><b>Sub Total</b></td>
                                        <td class="text-right"><b>{{ advanceDetailList | sumByKey : 'Amount' }}</b></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form="tabForm2">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <fieldset ng-hide="advance.CurrencyId==null||advance.CurrencyId==''||(currencyExchangeRate.length==1 &&companyCurrencyId==advance.CurrencyId)" class="scheduler-border">
                            <legend class="scheduler-border">Currency Exchange Rate</legend>
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Unit</th>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>Rate</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in currencyExchangeRate" ng-hide="x.ParallelCurrencyId==advance.CurrencyId">
                                            <td>{{x.FromCurrencyUnit}}</td>
                                            <td>{{x.FromCurrencyCode}}</td>
                                            <td>{{x.ToCurrencyCode}}</td>
                                            <td><input n-decimals="4" type="text" class="form-control text-right" ng-model="x.ToCurrencyRate" ng-keyup="setDrExchangeRate(advance.GLGeneralInfoId); updateCrAmount(); copyAmount();" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </fieldset>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 modal-table">
                        <table class="table table-responsive table-striped">
                            <thead compile="parallelCurrencyTableHead">
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in voucherDetailCurrencyList | orderBy: 'TrnType':true">
                                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget">{{x.BudgetName}}</td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget">{{x.ActivityName}}</td>
                                    <td ng-repeat="y in parallelCurrencyTypeList"><input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow." class="form-control text-right" ng-disabled="x[y.CurrencyType]==null" ng-model="x[y.CurrencyType]" /></td>
                                </tr>
                            </tbody>
                            <tfoot ng-show="voucherDetailCurrencyList.length">
                                <tr>
                                    <td><b>Sub Total</b></td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                    <td class="text-right" ng-repeat="y in parallelCurrencyTypeList"><b>{{ voucherDetailCurrencyList | sumByKey : y.CurrencyType  }}</b></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="advance.Id==null"><button ng-click="confirmPost(advance.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#No</th>
                    <th>@Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Ordering @Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Posting Date</th>
                    <th>Entity</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Inter Amount</th>
                    <th>Set-off Amount</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.AdvanceNo}}</td>
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>{{x.PartyPlantName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.EntityName}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                    <td class="text-right">{{x.Amount-x.NetAmount | number:2}}</td>
                    <td class="text-right">{{x.WrittenOffAmount | number:2}}</td>
                    <td class="text-right">{{x.NetAmount-x.WrittenOffAmount | number:2}}</td>
                    <td>{{x.IsPark?'Park': x.IsPosted?'Post':'Pending'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPoste || x.IsPark"><a ng-click="confirmPost(x.Id,x);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-hide="x.IsWrittenOff || !x.IsPosted"><a href="{{bootPoint}}customer-suspense-write-off/{{x.Id}}" class="btn btn-action tooltip-here">Set-off</a></li>
                            <li ng-hide="x.IsWrittenOff || !x.IsPosted"><a ng-click="confirmUnPost(x.Id);" href="" class="btn btn-action tooltip-here">UnPost</a></li>
                            <li><a ng-click="report(x.VoucherId)" class="btn btn-action" href=""><i class="glyphicon glyphicon-cloud-download"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Banks/Views/_CashPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_AdvanceJournalPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_PostPopUp.cshtml")

@*<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(advanceId)"></confirm-archive-generic>*@
<confirm-archive-generic modalid="confirmUnPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="unPost(advanceId)"></confirm-archive-generic>