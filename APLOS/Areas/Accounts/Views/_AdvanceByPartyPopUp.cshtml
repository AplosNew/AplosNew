<div class="modal fade site-modal in" id="advancePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> Advance List <button type="button" class="close" ng-click="CloseAdvancePopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        <div style="color:black;" id="advancePopUpGrid" ej-grid e-datasource="advancList" e-recorddoubleclick="selectAndCloseadvancePopUp"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-width="100" e-filter="false"></div>
                                <div e-column e-field="PartyName" e-headertext="Party" e-width="130"></div>
                                <div e-column e-field="PostingDate" e-headertext="PostingDate" e-width="80"></div>
                                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                <div e-column e-field="Receivable" e-headertext="Receivable" e-width="100" textAlign='Right'></div>
                                <div e-column e-field="Received" e-headertext="Received" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="Balance" e-headertext="Balance" e-width="100" textAlign='Right'></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="CloseAdvancePopUp();" class="btn"> Close</button></li>
                </ul>
               
            </div>
        </div>
    </div>
</div>

