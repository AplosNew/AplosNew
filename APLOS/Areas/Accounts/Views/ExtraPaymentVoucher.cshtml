<!-- #region ***********Vendor Payable*********-->
<div class="modal fade site-modal in" id="VendorPayableListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:1200px">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeVendorPayableListPopUp()">&times;</button>
                <h4 class="modal-title">{{getVendorName}}</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="vendorPayableGLParameters.searchBy">
                                            <option ng-repeat="option in searchVendorPayableByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="vendorPayableGLParameters.search" ng-enter="vendorpayableGLData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="vendorpayableGLData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table col-xs-12">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL Code</th>
                                <th>GL</th>
                                <th>Voucher No</th>
                                <th>DocDate</th>
                                <th>Doc Ref No</th>
                                <th>Currency</th>
                                <th>Payable</th>
                                <th>Payment</th>
                                <th>Balance</th>
                                <th>Amount</th>
                                <th>Apply</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in vendorpayableList |itemsPerPage:vendorPayableGLParameters.pageSize" pagination-id="metaData.name + 'vendorpayableList'"
                                total-items="vendorPayableGLParameters.total_count">
                                <td>{{x.COAICode}}</td>
                                <td>{{x.GL}}</td>
                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.DocDate}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.Currency}}</td>
                                <td>{{x.Payable}}</td>
                                <td>{{x.Payment}}</td>
                                <td>{{x.Balance}}</td>
                                <td><input type="number" class="form-control" ng-model="x.DrAmount" /></td>
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-checked="x.Active" ng-model="x.Active">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="6"
                                         pagination-id="metaData.name + 'vendorpayableList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="vendorpayableGLData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closeVendorPayableListPopUpSelected();total();">Selected</button>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
<!-- #region ***********Customer Receivable Edit*********-->
<div class="modal fade site-modal in" id="VendorPayableEditListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:1200px">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeVendorPayableEditListPopUp()">&times;</button>
                <h4 class="modal-title">{{getVendorName}}</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table col-xs-12">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL Code</th>
                                <th>GL</th>
                                <th>Voucher No</th>
                                <th>DocDate</th>
                                <th>Doc Ref No</th>
                                <th>Currency</th>
                                <th>Payable</th>
                                <th>Payment</th>
                                <th>Balance</th>
                                <th>Amount</th>
                                <th>Apply</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>{{VendorPayablePaymentEditableList.COAICode}}</td>
                                <td>{{VendorPayablePaymentEditableList.GL}}</td>
                                <td>{{VendorPayablePaymentEditableList.VoucherNo}}</td>
                                <td>{{VendorPayablePaymentEditableList.DocDate}}</td>
                                <td>{{VendorPayablePaymentEditableList.DocRefNo}}</td>
                                <td>{{VendorPayablePaymentEditableList.Currency}}</td>
                                <td>{{VendorPayablePaymentEditableList.Payable}}</td>
                                <td>{{VendorPayablePaymentEditableList.Payment}}</td>
                                <td>{{VendorPayablePaymentEditableList.Balance}}</td>
                                <td><input type="number" class="form-control" ng-model="VendorPayablePaymentEditableList.DrAmount" /></td>
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-checked="VendorPayablePaymentEditableList.Active" ng-model="VendorPayablePaymentEditableList.Active">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closeVendorPayableEditListPopUpSelected();total();">Selected</button>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->

<confirm-cancel message="You didn't select any row. Are you sure want to exit?" title="Confirm Exit" data-ng-click-right-button="removeRow()"></confirm-cancel>
<toaster-container toaster-options="{'close-button':true, 'animation-class': 'toast-top-center'}"></toaster-container>
<confirm-archive message="Are you sure want to delete this" data-ng-click-right-button="removeRow()"></confirm-archive>