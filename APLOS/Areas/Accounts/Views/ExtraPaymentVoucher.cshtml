<style>
    .selected {
        background-color: rgba(234, 97, 83, 0.42) !important;
    }

    .angucomplete-dropdown {
        position: relative !important;
    }
</style>
<togglable name="Vendor Invoice Payment"></togglable>
<div class="form-elements  form-horizontal" ng-form id="voucher" name="paymentvoucherForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Type</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="vouchertypeId" class="form-control" name="vouchertype" ng-model="voucher.VoucherTypeId" ng-change="onVoucherTypeChange(voucher.VoucherTypeId)">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control datepicker" tabindex="1" ng-change="checkVoucherDate()" required>
                    <p ng-show="VoucherDateMessage" class="show-message">{{VoucherDateMessage}}</p>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Posting Date</label>
                <div class="col-sm-8 show-message">
                    <input id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" datepicker class="form-control datepicker" tabindex="3" ng-change="getFiscalYear(voucher.PostingDate);checkPostingDate()">
                    <p ng-show="postingDateMessage" class="show-message">{{postingDateMessage}}</p>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Ref</label>
                <div class="col-sm-8 show-message">
                    <input type="text" maxlength="50" name="DocRefNo" ng-model="voucher.DocRefNo" class="form-control" tabindex="5" ng-blur="getRefCode(voucher.DocRefNo)">
                </div>
            </div>
            @*<div class="form-group">
                    <label class="col-sm-4 control-label">Voucher No</label>
                    <div class="col-sm-8">
                        <input id="VoucherNo" type="text" name="VoucherNo" ng-model="voucher.VoucherNo" class="form-control " tabindex="2" readonly>
                    </div>
                </div>*@
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Doc Date</label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker class="form-control datepicker" tabindex="2" ng-change="checkDate();getDocDate(voucher.DocDate)" required>
                    <p ng-show="dateMessage" class="show-message">{{dateMessage}}</p>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Currency</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="currencyId" class="form-control" name="CurrencyId" ng-model="voucher.CurrencyId">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xs-12 form-horizontal">

            <div class="form-group" show-errors>
                <label class="col-sm-2 control-label">Narration</label>
                <div class="col-sm-10 show-message">
                    <textarea type="text" name="Narration" class="form-control" rows="2" ng-model="voucher.Narration" ng-blur="passNarration(voucher.Narration)" required capitalize></textarea>
                </div>
            </div>
        </div>
        <div>
            <div class="col-xs-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Bank</label>
                    <div class="col-sm-8">
                        <button class="btn single-btn" ng-click="getBankMasterVoucher()" tabindex="5">Bank</button>
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Bank Name</label>
                    <div class="col-sm-8">
                        <input id="BankCharge" type="text" name="BankName" ng-model="getBankName" class="form-control " tabindex="2" readonly>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Account Type</label>
                    <div class="col-sm-8">
                        <input id="BankCharge" type="text" name="BankName" ng-model="getBankAccountType" class="form-control " tabindex="2" readonly>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Amount</label>
                    <div class="col-sm-8 show-message">
                        <input id="CrAmount" type="number" name="CrAmount" ng-model="voucherDetail.CrAmount" class="form-control " tabindex="2">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Bank Branch</label>
                    <div class="col-sm-8">
                        <input id="BankCharge" type="text" name="BankName" ng-model="getBankBranchName" class="form-control " tabindex="2" readonly>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">GL Code</label>
                    <div class="col-sm-8 show-message">
                        <input id="BankCharge" type="text" name="GLItem" ng-model="getBankGlCode" class="form-control " tabindex="2" readonly>
                        <input type="hidden" name="GLGeneralInfoId" ng-model="getBankGlIId" />
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">GL</label>
                    <div class="col-sm-8 show-message">
                        <input id="BankCharge" type="text" name="GLItem" ng-model="getBankGlItem" class="form-control " tabindex="2" readonly>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Account No</label>
                    <div class="col-sm-8">
                        <input id="BankCharge" type="text" name="BankCode" ng-model="getAccountNumber" class="form-control " tabindex="2" readonly>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Narration</label>
                    <div class="col-sm-8 show-message">
                        <textarea type="text" name="Narration" class="form-control" rows="2" ng-model="voucherDetail.Narration" required capitalize></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xs-12">
            <div class="col-xs-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Vendor</label>
                    <div class="col-sm-8">
                        <button class="btn single-btn" ng-click="getVendorParty()" tabindex="5">Vendor</button>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Vendor Name</label>
                    <div class="col-sm-8 show-message">
                        <input id="BankCharge" type="text" name="Vendor Name" ng-model="getVendorName" class="form-control " tabindex="2" readonly>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">GL Item</label>
                    <div class="col-sm-8 show-message">
                        <input id="BankCharge" type="text" name="GLItem" ng-model="getVendorGLItem" class="form-control " tabindex="2" readonly>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Vendor Code</label>
                    <div class="col-sm-8 show-message">
                        <input id="VendorCode" type="text" name="Vendor Code" ng-model="getVendorCode" class="form-control " tabindex="2" readonly>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">GL Code</label>
                    <div class="col-sm-4 show-message">
                        <input id="BankCharge" type="text" name="GLItem" ng-model="getGlCode" class="form-control " tabindex="2" readonly>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <div class="col-xs-12">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Select Vendor Payable</label>
                    <div class="col-sm-8">
                        <button class="btn single-btn" ng-click="getPopenItemList()" tabindex="5">Select Vendor Payable</button>
                    </div>
                </div>
            </div>
        </div>
        <div ng-show="selectedPayableTblShow" class="table-responsive modal-table col-xs-12">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>GL</th>
                        <th>VoucherDate</th>
                        <th>DocDate</th>
                        <th>Currency</th>
                        <th>Payable</th>
                        <th>Payment</th>
                        <th>Dr Amount</th>
                        <th ng-show="editBtnShow">Balance</th>
                        <th ng-show="editBtnShow">Apply</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in VendorPayablePaymentList">
                        <td>{{x.GL}}</td>
                        <td>{{x.VoucherDate}}</td>
                        <td>{{x.DocDate}}</td>
                        <td>{{x.Currency}}</td>
                        <td>{{x.Payable}}</td>
                        <td>{{x.Payment}}</td>
                        <td>{{x.DrAmount}}</td>
                        <td ng-show="editBtnShow">{{x.Balance}}</td>
                        <td class="table-td" ng-show="editBtnShow">
                            <ul class="list-inline action-list">
                                <li>
                                    <button ng-click="getvendorpayableEdit(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                        <i class="glyphicon glyphicon-pencil"></i>
                                    </button>
                                </li>
                            </ul>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li>
                <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button>
            </li>
        </ul>
    </div>
</div>
<div class="modal fade site-modal in" id="GLPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeCOAICodeListPopUp()">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-trash"></i>GL Item</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="$root.parameters.searchBy">
                                            <option ng-repeat="option in searchByGLList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getAlternativeCoaListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getAlternativeCoaListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closeCOAICodeListPopUpSelected()">Selected</button>
            </div>
        </div>
    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByGLList   " value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped ">
        <thead>
            <tr>
                <th>Voucher No</th>
                <th>Voucher Date</th>
                <th>Doc Ref No</th>
                <th>DocDate</th>
                <th>Vendor</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in vendorpayments |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.VoucherDate}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.DocDate}}</td>
                <td>{{x.Vendor}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>

