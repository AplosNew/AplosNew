<div class="modal fade site-modal in" id="baknListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="bankForm">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closebankListPopUp()">&times;</button>
                <h4 class="modal-title">Bank List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="bankGLParameters.searchBy">
                                            <option ng-repeat="option in searchBankByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="bankGLParameters.search" ng-enter="bankListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="bankListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Bank</th>
                                <th>Bank Branch</th>
                                <th>Account Type</th>
                                <th>Account Number</th>
                                <th>GL Code</th>
                                <th>GL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in getBankList |itemsPerPage:bankGLParameters.pageSize" pagination-id="metaData.name + 'getBankList'" total-items="bankGLParameters.total_count"
                                ng-click="setBankCodeSelected(x)" ng-class="{selected : x.Id === bankidSelected}" ng-dblclick="closebankListPopUp()">
                                <td>{{x.Bank}}</td>
                                <td>{{x.BankBranch}}</td>
                                <td>{{x.BankAccountType}}</td>
                                <td>{{x.AccountNumber}}</td>
                                <td>{{x.COAItemCode}}</td>
                                <td>{{x.GLItem}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="4"
                                         pagination-id="metaData.name + 'getBankList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="bankListData(newPageNumber)">
                </dir-pagination-controls>

                <div class="common-btn">
                </div>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closeBankListPopUpSelected()">Selected</button>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
