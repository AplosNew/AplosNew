                <div class="form-group" id="div_FromDate" @*ng-show="incomeStatementReport.Type=='ForThePeriod'"*@>
                    <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Date" ng-model="incomeStatementReport.FromDate" datepicker class="form-control" tabindex="3">
                    </div>
                </div>
                <div @*ng-show="incomeStatementReport.Type=='ForThePeriod'"*@ class="form-group" id="div_WDToDate">
