                    <div e-column e-field="MaterialMaster" e-headertext="Material Master" e-width="80"></div>
                    <div e-column e-field="Article" e-headertext="Article" e-width="80"></div>
                    <div e-column e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="50"></div>
                    <div e-column e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="50"></div>
                    <div e-column e-field="ThirdCharacteristicsValue" e-headertext="SKU3" e-width="50"></div>
