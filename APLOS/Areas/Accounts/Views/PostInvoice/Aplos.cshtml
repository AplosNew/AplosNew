                    <div e-column e-template="#Qty" e-headertext="Qty" e-width="70" style="height: 20px;" e-textalign="right"></div>
                    <div e-column e-field="TransactionRate" e-headertext="Rate" e-width="50" textAlign='Right'></div>
                    <div e-column e-field="TransactionAmount" e-headertext="Amount" e-width="50" textAlign='Right'></div>
