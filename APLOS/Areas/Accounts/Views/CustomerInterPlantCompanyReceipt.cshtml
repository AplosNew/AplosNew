<togglable name="Customer Receipt"></togglable>
<div class="form-elements" ng-form id="form1" ng-show="showform" name="form1">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Transaction Data</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Parallel Currency</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form name="tabForm1">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">General Information</legend>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Voucher Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="currencyTransactionId" class="form-control" ng-disabled="true" tabindex="5" name="CurrencyTransaction" ng-model="voucher.CurrencyId">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div id="div_PostingDate" class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input required datepicker="checkPostingDate();getFiscalYearPeriod(voucher.PostingDate);" ng-disabled="voucherDetailList.length" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
                            </div>
                        </div>
                        <div id="div_DocDate" class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-3 control-label">Fiscal Year</label>
                            <div class="col-sm-4 show-message">
                                <input id="fiscalYearId" type="text" name="Fiscal Year" disabled ng-model="voucher.FiscalYearName" class="form-control">
                                <input type="hidden" name="Period" ng-model="voucher.FiscalYearId" class="form-control">
                            </div>
                            <label class="col-sm-2 control-label">Period</label>
                            <div class="col-sm-3 show-message">
                                <input id="fiscalYearPeriod" type="text" name="Period" disabled ng-model="voucher.FiscalYearPeriodName" class="form-control">
                                <input type="hidden" name="Period" ng-model="voucher.FiscalYearPeriodId" class="form-control">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
                            <div class="col-sm-9 show-message">
                                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-8 col-md-8 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
                            <div class="col-sm-10 show-message">
                                <textarea rows="1" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Received Amount <sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="6" ng-disabled="true" ng-model="voucher.InvoiceAmount" type="text" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Ex. Gain/Loss <sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="6" ng-disabled="true" ng-model="voucher.ExGainLossAmount" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Net Amount<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input tabindex="6" ng-disabled="true" ng-model="voucher.Amount" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right">
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </fieldset>
                <div class="clearfix"></div>
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">{{partyFromTo}}</legend>
                    <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal">
                        <div class="col-xs-12 col-sm-5 col-md-5 form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">{{partyType}}</label>
                                <div class="col-sm-7 pdr3">
                                    <input type="hidden" ng-model="voucher.PartyId">
                                    <input type="text" name="Code" ng-model="voucher.PartyName" class="form-control" readonly>
                                </div>
                                <button class="single-btn tooltip-here" data-placement="top" title="Select Customer" tabindex="9" ng-disabled="isReadOnly" ng-click="showPartyPopUp();"><i class="fa fa-search"></i></button>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 form-horizontal">
                            <button class="btn single-btn" ng-click="getPopupCustomerReceivableList()" tabindex="10">Select  Receivable</button>
                        </div>

                        <div class="clearfix"></div>
                        <div class="table-responsive modal-table" ng-show="voucherDetailList.length">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>GL</th>
                                        <th>Voucher No</th>
                                        <th>DocDate</th>
                                        <th>Doc Ref No</th>
                                        <th>Currency</th>
                                        <th>Receivable</th>
                                        <th>Received</th>
                                        <th>Balance</th>
                                        <th>Amount</th>
                                        @*<th>Converted Amount</th>*@
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in voucherDetailList">
                                        <td>{{x.GLGeneralInfoName}}</td>
                                        <td>{{x.VoucherNo}}</td>
                                        <td>{{x.DocDate |dateFiltering}}</td>
                                        <td>{{x.DocRefNo}}</td>
                                        <td>{{x.CurrencyCode}}</td>
                                        <td>{{x.Receivable}}</td>
                                        <td>{{x.Received}}</td>
                                        <td>{{x.Balance}}</td>
                                        <td>
                                            <input ng-keyup="convertAmount(x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="x.Amount">
                                        </td>
                                        @*<td>
                                                <input readonly type="text" n-decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="x.ConvertedAmount">
                                            </td>*@
                                        <td class="text-right">
                                            <button ng-click="getDeductionPopUp($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Tax">
                                                <i>Deduction</i>
                                            </button>
                                            <button ng-click="removeRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                                @*<tfoot>
                                        <tr>
                                            <td colspan="8" class="text-right">Total ConvertedAmount</td>
                                            <td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'ConvertedAmount' }}</b></td>
                                            <td></td>
                                        </tr>
                                    </tfoot>*@
                            </table>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <div class="col-sm-3 col-md-3">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Inter<sup>*</sup></label>
                                    <div class="radio col-sm-9">
                                        <label>
                                            <input ng-click="changeSourceTo('Plant')" type="radio" name="sourceParty" ng-model="voucher.PartyType" value="Plant">
                                            <span class="cr" tabindex="12"><i class="cr-icon"></i></span>Plant
                                        </label>
                                        <label>
                                            <input ng-click="changeSourceTo('Company')" type="radio" name="sourceParty" ng-model="voucher.PartyType" value="Company">
                                            <span class="cr" tabindex="11"><i class="cr-icon"></i></span>Company
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-3 col-md-3">
                                <div ng-show="voucher.PartyType=='Plant'">
                                    <div class="select-style">
                                        <select name="Company Name" id="EntityId" ng-model="voucher.PlantId" class="col-sm-3 form-control"
                                                ng-change="plantChange(x.PlantId);" ng-options="item.Value as item.Text for item in interplantList|filter:{ Value : '!openingBalance.EntityId' }" tabindex="7">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                                <div ng-show="voucher.PartyType=='Company'">
                                    <div class="select-style">
                                        <select name="Company Name" id="CompanyId" ng-model="voucher.CompanyId" class="col-sm-3 form-control"
                                                ng-change="companyChange(x.CompanyId)" ng-options="item.Value as item.Text for item in companyList" tabindex="7">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4 col-md-4">
                                <div id="div_TransactionType" class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Transaction Type<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select ng-change="getTransactionTypeGL(openingBalance.FinancingTypeId)" name="Transaction Type" class="form-control" ng-model="openingBalance.FinancingTypeId" tabindex="5" required>
                                                <option value="">--Select--</option>
                                                <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.AssetUserName}}</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">To</legend>
                    <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal">
                        <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Source</label>
                                <div class="radio">
                                    <label>
                                        <input ng-click="changeSourceTo('Cash')" type="radio" name="source" ng-model="voucher.SourceTo" value="Cash">
                                        <span class="cr" tabindex="11"><i class="cr-icon"></i></span>Cash
                                    </label>
                                    <label>
                                        <input ng-click="changeSourceTo('Bank')" type="radio" name="source" ng-model="voucher.SourceTo" value="Bank">
                                        <span class="cr" tabindex="12"><i class="cr-icon"></i></span>Bank
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-8 col-md-8 form-horizontal">
                            <div ng-show="voucher.SourceTo=='Cash'" class="form-group">
                                <label class="col-sm-2 control-label">Cash</label>
                                <div class="col-sm-5 pdr3">
                                    <input type="text" name="Code" ng-model="voucher.CashName" class="form-control" readonly>
                                </div>
                                <button class="single-btn tooltip-here" data-placement="top" title="Select Bank" ng-click="showCashPaymentPopUp();"><i class="fa fa-search"></i></button>
                            </div>
                            <div ng-show="voucher.SourceTo=='Bank'" class="form-group">
                                <label class="col-sm-2 control-label">Bank</label>
                                <div class="col-sm-5 pdr3">
                                    <input type="text" name="Code" ng-model="voucher.BankName" class="form-control" readonly>
                                </div>
                                <button class="single-btn tooltip-here" data-placement="top" title="Select Bank" ng-click="showBankPaymentPopUp();"><i class="fa fa-search"></i></button>
                            </div>
                            <div id="div_entity" class="form-group" ng-hide="true">
                                <label class="col-sm-2 control-label">Entity<sup>*</sup></label>
                                <div class="col-sm-5 show-message">
                                    <div class="select-style">
                                        <select ng-change="entityChange(voucher.EntityId)" id="entityId" class="form-control" name="entity" ng-model="voucher.EntityId" tabindex="7">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form name="tabForm2">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <fieldset class="scheduler-border" ng-show="currencyExchangeRate.length">
                            <legend class="scheduler-border">Currency Exchange Rate</legend>
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Unit</th>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>Rate</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in currencyExchangeRate" ng-hide="x.ParallelCurrencyId === x.FromCurrencyId && x.ParallelCurrencyId=== x.ToCurrencyId ">
                                            <td>{{x.FromCurrencyUnit}}</td>
                                            <td>{{x.FromCurrencyCode}}</td>
                                            <td>{{x.ToCurrencyCode}}</td>
                                            <td>
                                                <input n-decimals="4" ng-maxlength="3" type="text" class="form-control text-right" ng-model="x.ToCurrencyRate" ng-keyup="changeCurrencyExchangeRate();" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </fieldset>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 modal-table">
                        <table class="table table-responsive table-striped">
                            <thead compile="parallelCurrencyTableHead">
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in voucherDetailCurrencyList track by $index">
                                    <td>{{x.GLGeneralInfoName}}</td>
                                    <td>{{x.DocRefNo}}</td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget">{{x.BudgetName}}</td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget">{{x.ActivityName}}</td>
                                    <td ng-repeat="y in parallelCurrencyTypeList"><input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-disabled="x[y.CurrencyType]==null" ng-model="x[y.CurrencyType]" /></td>
                                </tr>
                            </tbody>
                            <tfoot ng-show="voucherDetailCurrencyList.length">
                                <tr>
                                    <td></td>
                                    <td><b>Sub Total</b></td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                    <td ng-show="companyConfig.IsVoucherFromBudget"></td>
                                    <td class="text-right" ng-repeat="y in parallelCurrencyTypeList"><b>{{ voucherDetailCurrencyList | sumByKey : y.CurrencyType  }}</b></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchVendorInvoiceList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Customer</th>
                <th>VoucherNo</th>
                <th>Posting Date</th>
                <th>Doc Date</th>
                <th>Doc Ref</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                <td>{{x.PartyCodeName}}</td>
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PostingDate| dateFiltering}}</td>
                <td>{{x.DocDate| dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:4}}</td>
                <td class="text-right">
                    <button ng-click="customerInvoiceReceiptReport(x.VoucherNo)" class="btn"><i class="glyphicon glyphicon-print"></i></button>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Banks/Views/_CashPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_CustomerInvoicePopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_CustomerAdvancePopUp.cshtml")
<toaster-container toaster-options="{'close-button':true, 'animation-class': 'toast-top-center'}"></toaster-container>
<div class="modal fade site-modal in" id="TotaladvancePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:400px">
        <div class="modal-content" ng-form name="AdvanceForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <label class=" control-label" ng-dblclick="closeTotaladvancePopUp()">{{voucher.PartyName}}   Total Advance Amount is BDT  {{TotalAdvance}}</label>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeTotaladvancePopUp()">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="deductionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:600px">
        <div class="modal-content" ng-form name="DeductionForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-elements form-horizontal">
                    <div class="col-xs-12 col-sm-5 col-md-5 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Deduction</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select ng-model="deductionOb.FinancingTypeId" id="deductioncbo">
                                        <option>--Select--</option>
                                        <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.ExpensesUserName}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-5 col-md-5 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Amount</label>
                            <div class="col-sm-8 show-message">
                                <input required id="amount" n-decimals="2" type="text" name="amount" ng-model="deductionOb.Amount" class="form-control">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-1 col-md-1 form-horizontal">
                        <div class="common-btn">
                            <button type="button" class="btn btn-default" ng-click="addDeduction()"><i class="glyphicon glyphicon-plus"></i></button>
                        </div>
                    </div>
                </div>
                <div class="clearfix">
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Deduction</th>
                                <th>Amount</th>
                                <th>Remove</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in deductionList ">
                                <td>{{x.Deduction}}</td>
                                <td>{{x.Amount}}</td>
                                <td>
                                    <button ng-click="removeRowModal($index)" class="btn-action single-small-btn tooltip-here" data-placement="right" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
