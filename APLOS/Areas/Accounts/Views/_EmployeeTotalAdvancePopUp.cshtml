<div class="modal fade site-modal in" id="employeeTotalAdvancePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Employee Advance List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeAdvanceParameters.searchBy">
                                            <option ng-repeat="option in employeeAdvanceSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeAdvanceParameters.search" ng-enter="getEmployeeTotalAdvanceData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeTotalAdvanceData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
               

                <div class="modal-body">
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="GridEmp" ej-grid e-datasource="employeeAdvanceDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-recorddoubleclick="closeEmployeeAdvancePopUp" e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-field="EmployeeName" e-headertext="Employee" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                <div e-type="string" e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                                <div e-type="string" e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                <div e-type="string" e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                <div e-type="string" e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                <div e-type="string" e-column e-field="CurrencyCode" e-headertext="Currency" e-width="60"></div>
                                <div e-column e-field="Receivable" e-headertext="Advanced" e-width="60"></div>
                                <div e-column e-field="Received" e-headertext="Write-off" e-width="60"></div>
                                <div e-column e-field="Balance" e-headertext="Balance" e-width="60"></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer common-btn">
                @*TODO:*@
                <button type="button" class="btn btn-default" ng-click="EmployeeAdvanceTotalList();">Report</button>
                <button type="button" class="btn btn-default" ng-click="closeEmployeePopUp();">Close</button>
            </div>
        </div>
    </div>
</div>