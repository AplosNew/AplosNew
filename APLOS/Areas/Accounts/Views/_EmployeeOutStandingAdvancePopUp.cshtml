<div class="modal fade site-modal in" id="employeeOutStandingAdvancePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Employee Advance</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Name</th>
                                <th>Currency</th>
                                <th>Advanced</th>
                                <th>Write-off</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeOutStandingAdvanceDataList |itemsPerPage:employeeAdvanceParameters.pageSize" pagination-id="metaData.name + 'employeeOutStandingAdvanceDataList'">
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td class="text-right">{{x.Receivable | number:2}}</td>
                                <td class="text-right">{{x.Received | number:2}}</td>
                                <td class="text-right">{{x.Balance | number:2}}</td>
                            </tr>
                        </tbody>
                        <tfoot ng-show="employeeOutStandingAdvanceDataList.length">
                            <tr>
                                <td colspan="3"></td>
                                <td><b>Sub Total</b></td>
                                <td class="text-right"><b>{{ employeeOutStandingAdvanceDataList | sumByKey : 'Balance' }}</b></td>
                            </tr>
                        </tfoot>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'employeeOutStandingAdvanceDataList'"
                                             direction-links="true" boundary-links="true" on-page-change="getCustomerAdvanceData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeEmployeeOutStandingAdvancePopUp();">Close</button>
            </div>
        </div>
    </div>
</div>