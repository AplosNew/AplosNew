<togglable name="Chart of Account Relationship"></togglable>
<div class="col-sm-6 col-md-6 form-element-ctrl form-horizontal">
    <div class="form-group">
        <label class="col-sm-4 col-md-4 control-label">Company Group</label>
        <div class="col-sm-8 col-md-8 show-message">
            <div class="select-style">
                <select class="form-control" ng-model="chartOfAccountRelationship.CompanyGroupId" ng-options="item.Value as item.Text for item in companyGroupList" ng-change="getCboChartOfAccount(chartOfAccountRelationship.CompanyGroupId)" required>
                    <option value=""></option>
                </select>
            </div>
        </div>
    </div>
</div>
<div class="col-sm-6 col-md-6 form-element-ctrl form-horizontal">
    <div class="form-group">
        <label class="col-sm-4 control-label">COA<sup>*</sup></label>
        <div class="col-sm-8 show-message">
            <div class="select-style">
                <select class="form-control" ng-model="chartOfAccountRelationship.COAId" name="COA" ng-options="item.Value as item.Text for item in coaList" ng-change="onCOAChange(chartOfAccountRelationship.COAId);getData()" tabindex="1" required></select>
            </div>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<div class="form-elements form-horizontal" ng-form name="chartOfAccountRelationshipForm">
    <input type="hidden" ng-model="chartOfAccountRelationship.Id">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input min="1" max="10" type="number" name="Sequence" ng-model="chartOfAccountRelationship.Sequence" class="form-control" required placeholder="1" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Standard Name" ng-model="chartOfAccountRelationship.StandardName" tabindex="3" required class="form-control">
                        <option value="COALevel1">Chart of Account Level1</option>
                        <option value="COALevel2">Chart of Account Level2</option>
                        <option value="COALevel3">Chart of Account Level3</option>
                        <option value="COALevel4">Chart of Account Level4</option>
                        <option value="COALevel5">Chart of Account Level5</option>
                        <option value="COALevel6">Chart of Account Level6</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="User Name" ng-model="chartOfAccountRelationship.UserName" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="chartOfAccountRelationship.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea maxlength="250" class="form-control" rows="3" ng-model="chartOfAccountRelationship.Description" tabindex="5"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea maxlength="250" class="form-control" rows="3" ng-model="chartOfAccountRelationship.Remarks" tabindex="6"></textarea>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="8"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="12"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3"><div class="select-style"><select ng-model="$root.parameters.searchBy"><option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option></select></div></div>
                    <div class="col-xs-12 col-sm-7 col-md-7"><input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()"></div>
                    <div class="col-xs-12 col-sm-2 col-md-2"><button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button></div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sequence</th>
                    <th>Standard Name</th>
                    <th>User Name</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in chartOfAccountRelationshipes|itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.Sequence}}</td>
                    <td>{{x.StandardName}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
<confirm-modal></confirm-modal>