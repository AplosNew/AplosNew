<div class="modal fade site-modal in" id="customerAdvancePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Payment List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="customerAdvanceParameters.searchBy">
                                            <option ng-repeat="option in customerAdvanceSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="customerAdvanceParameters.search" ng-enter="getCustomerAdvanceData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getCustomerAdvanceData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Voucher No</th>
                                <th>Customer</th>
                                <th>Customer Plant</th>
                                <th>Payment Type</th>
                                <th>PostingDate</th>
                                <th>DocDate</th>
                                <th>Currency</th>
                                <th>Received</th>
                                <th>Set-off</th>
                                <th>Balance</th>
                                <th>Contract No</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in customerAdvanceDataList |itemsPerPage:customerAdvanceParameters.pageSize" pagination-id="metaData.name + 'customerAdvanceDataList'"
                                total-items="customerAdvanceParameters.total_count" ng-class="{selected : x.AdvanceId == selectedAdvanceId}" ng-dblclick="closeCustomerAdvancePopUpSelected(x)">
                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                                <td>{{x.PartyPlantName}}</td>
                                <td>{{x.PaymentType}}</td>
                                <td>{{x.PostingDate |dateFiltering}}</td>
                                <td>{{x.DocDate |dateFiltering}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td class="text-right">{{x.Receivable | number:2}}</td>
                                <td class="text-right">{{x.Received | number:2}}</td>
                                <td class="text-right">{{x.Balance | number:2}}</td>
                                <td>{{x.ContractNo}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'customerAdvanceDataList'" direction-links="true" boundary-links="true" on-page-change="getCustomerAdvanceData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeCustomerAdvancePopUpSelected();">Select</button>
            </div>
        </div>
    </div>
</div>