<togglable name="{{title}}"></togglable>
<div class="form-horizontal form-elements" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Customer.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="@Library.Model.Parties.PartyType.Customer.ToString()" ng-model="advance.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Ordering @Library.Model.Parties.PartyType.Customer.ToString() ({{partyPlantList.length}})<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="1" class="form-control" name="Ordering @Library.Model.Parties.PartyType.Customer.ToString()" ng-model="advance.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(advance.PartyPlantId,'billTo'); updateCrAmount();" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(advance.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input ng-click="clearBankPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                    <span class="cr" tabindex="8"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
                <label>
                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
                <label>
                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="MultiBank">
                    <span class="cr" tabindex="9"><i class="cr-icon"></i></span>MultiBank
                </label>
                @*<label>
                        <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Journal.ToString()">
                        <span class="cr" tabindex="10"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Journal.ToString()
                    </label>*@
            </div>
        </div>
        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="BankName" ng-model="advance.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{advance.BankName}}" tooltip>
                    <span class="input-group-btn">
                        <button ng-click="showBankPopUp(advance.EntityId);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="advance.CashName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showCashPopUp(null, advance.EntityId);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.PaymentSource=='MultiBank'">
            <label class="col-sm-4 control-label">Select Bank<sup>*</sup></label>
            <div class="col-sm-2 show-message">
                <div class="input-group">
                    <span class="input-group-btn">
                        <button ng-click="showMultiBankPopUp(advance.EntityId);" class="btn single-small-btn"><i class="glyphicon glyphicon-plus"></i></button>
                    </span>
                </div>
            </div>
            <div class="col-sm-4">
                <button class="btn single-btn" ng-click="showloanPopUp()" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Select Loan</button>
            </div>
        </div>
        <div class="form-group" ng-show="isBankAmount">
            <label class="col-sm-4 control-label">Bank Amount<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="advance.BankAmount">
            </div>
        </div>
        <div class="form-group" ng-show="advance.BankMasterId">
            <label class="col-sm-4 control-label">Bank Ref No</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Bank Reference No" name="Bank Reference No" ng-model="advance.BankReferenceNo" class="form-control" tabindex="5" autocomplete="off">
            </div>
        </div>
        <div class="form-group" ng-show="advance.BankMasterId">
            <label class="col-sm-4 control-label">Bank Trn Date</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="BankTransactionDate" ng-model="advance.BankTransactionDate" datepicker class="form-control" tabindex="4">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea ng-keyup="updateCrAmount();" rows="2" type="text" name="Narration" tabindex="13" class="form-control" ng-model="advance.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="advance.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="advance.PostingDate" class="form-control" tabindex="2">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="advance.DocDate" datepicker="checkPostingDate();checkDocDate();" required class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group" id="div_qty">
            <label class="col-sm-4 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <input ng-disabled="advance.JournalId ||advance.PaymentSource=='MultiBank'" tabindex="11" ng-model="advance.Amount" type="text" n-decimals="2" class="form-control text-right">
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" tabindex="12" name="CurrencyTransaction" ng-model="advance.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" id="div_ReviewDate" show-errors>
            <label class="col-sm-4 control-label">Review Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" id="Review Date" name="Review Date" ng-model="advance.ReviewDate" datepicker="checkReviewDate();" class="form-control" tabindex="7" required>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label" title="Contract">Contract</label>
            <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                <input type="text" name="ContractId" ng-model="advance.ContractId" class="form-control" maxlength="100" ng-hide="true">
                <input type="text" name="ContractNo" ng-model="advance.ContractNo" ng-disabled="true" class="form-control" maxlength="100">
                <span class="input-group-btn">
                    <button ng-click="GetPopUpContract()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
        @*<div class="form-group">
                <label class="col-sm-4 control-label">InterTransaction</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input ng-disabled="advance.JournalId" tabindex="14" type="checkbox" ng-model="advance.IsInterTransaction">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>*@
        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Journal.ToString()'">
            <label class="col-sm-4 control-label">Advance<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="advance.AdvanceNo" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showAdvanceInterTransactionPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="advance.VoucherTypeId" tabindex="2" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div id="div_entity" class="form-group">
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="entity" ng-model="advance.EntityId" tabindex="6">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Doc Ref" name="Doc Ref" ng-model="advance.DocRefNo" class="form-control" tabindex="5" required autocomplete="off" capitalize>
            </div>
        </div>


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Rate<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-model="advance.CompanyCurrencyRate" ng-keyup="rateChangeBankCharge(advance.CompanyCurrencyRate)" class="form-control text-right" tabindex="6" required autocomplete="off" n-decimals="4" ng-disabled="advance.CurrencyId==companyCurrencyId">
            </div>
        </div>
        <div class="form-group">
            <label title="Responsible Person" class="col-sm-4 control-label">Res.Person<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" name="Responsible Person" ng-model="advance.ResponsiblePerson" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearEmployeePopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label" title="Contract">Master Order</label>
            <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                <input type="text" name="MasterOrderId" ng-model="advance.MasterOrderId" ng-disabled="true" class="form-control" maxlength="100">
                <span class="input-group-btn">
                    <button ng-click="ShowResultMasterOrderPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">

        <div class="table-responsive modal-table" ng-show="bankDetailList.length">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Account Title</th>
                        <th>Bank Name</th>
                        <th class="text-right">Amount</th>
                        <th>Bank Currency</th>
                        <th>Rate</th>
                        <th>Bank Amount</th>
                        <th>Books Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in bankDetailList">
                        <td>{{x.AccountTitle}}</td>
                        <td>{{x.BankName}}</td>
                        <td>
                            <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="x.Amount" ng-keyup="calbankAmount(x)">
                        </td>
                        <td>{{x.BankCurrencyCode}}</td>
                        <td>{{x.CompanyCurrencyRate}}</td>
                        <td>
                            <input type="text" n-decimals="2" ng-disabled="x.BankCurrencyId==voucher.CurrencyId" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="BankAmount" autocomplete="off" ng-model="x.BankAmount" ng-keyup="calbankCurrecyAmount(x)">
                        </td>
                        <td>
                            <input type="text" n-decimals="2"  title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="BaseDrAmount" autocomplete="off" ng-model="x.BaseDrAmount" ng-keyup="calBaseAmount()">
                        </td>
                        <td class="text-right">
                            <button ng-click="removeBankRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" class="text-right">Total</td>
                        <td class="text-right"><b>{{ (bankDetailList) | sumByKey:'Amount' }}</b></td>
                        <td colspan="2"></td>
                        <td class="text-right"><b>{{ (bankDetailList) | sumByKey:'BankAmount' }}</b></td>
                        <td class="text-right"><b>{{ (bankDetailList) | sumByKey:'BaseDrAmount' }}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 modal-table" ng-show="advance.PaymentSource=='MultiBank'">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Charges</legend>
            <table class="table table-responsive table-striped">
                <thead>
                    <tr>
                        <th>Charges Type</th>
                        <th>Trn. Amount</th>
                        <th>{{companyCurrencyCode}}</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td id="td_FinancingType">
                            <div class="select-style show-message">
                                <select ng-model="bankCharge.FinancingTypeId">
                                    <option ng-repeat="option in bankChargeTypeList" value="{{option.FinancingTypeId}}">{{option.ExpensesUserName}}</option>
                                </select>
                            </div>
                        </td>
                        <td id="td_FinancingTypeAmount">
                            <div class="show-message">
                                <input type="text" class="form-control text-right" ng-model="bankCharge.Amount" ng-keyup="copyChargesAmount();">
                            </div>
                        </td>
                        <td id="td_FinancingTypeCompanyCurrencyAmount">
                            <div class="show-message">
                                <input type="text" n-decimals="2" class="form-control text-right" ng-model="bankCharge.CompanyCurrencyAmount">
                            </div>
                        </td>
                        <td class="text-right">
                            <a ng-click="addCharge();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                        </td>
                    </tr>
                    <tr ng-repeat="x in bankChargesList">
                        <td>{{x.FinancingTypeName}}</td>
                        <td class="text-right">{{x.Amount | number:2 }}</td>
                        <td class="text-right">{{x.CompanyCurrencyAmount | number:2}}</td>
                        <td class="text-right">
                            <button ng-click="removeChargesRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                        </td>
                    </tr>
                </tbody>
                <tfoot ng-show="bankChargesList.length">
                    <tr>
                        <td><b>Sub Total</b></td>
                        <td class="text-right"><b>{{ bankChargesList | sumByKey : 'Amount' }}</b></td>
                        <td class="text-right"><b>{{ bankChargesList | sumByKey : 'CompanyCurrencyAmount'  }}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </fieldset>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">

    </div>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border" ng-show="advance.IsInterTransaction">
        <legend class="scheduler-border">Inter Transaction</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div id="div_TransactionType" class="form-group">
                <label class="col-sm-4 control-label">Transaction Type</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select ng-change="getTransactionTypeGL(advance.FinancingTypeId)" name="Transaction Type" class="form-control" ng-model="advance.FinancingTypeId">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in financingTypeList" value="{{option.Value}}">{{option.LiabilityUserName}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div id="div_Company" class="form-group">
                <label class="col-sm-4 control-label">Company</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Company Name" id="CompanyId" ng-model="advance.CompanyId" class="col-sm-3 form-control"
                                ng-change="getCompanyInfo(advance.CompanyId); companyChange(advance.CompanyId)" ng-options="item.CompanyId as item.CompanyName for item in companyList">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-5 col-md-5">
            <div id="div_Plant" class="form-group">
                <label class="col-sm-4 control-label">Plant</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select ng-change="getPlantInfo(advance.PlantId);" name="Plant Name" id="PlantId" ng-model="advance.PlantId" class="col-sm-3 form-control" ng-options="item.PlantId as item.PlantName for item in interplantList" tabindex="10">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-4 col-sm-1 col-md-1">
            <div class="common-btn">
                <button ng-click="getTransactionTypeGL(advance.FinancingTypeId); getCompanyInfo(advance.CompanyId); getPlantInfo(advance.PlantId); addRow();" class="btn"><i class="glyphicon glyphicon-plus-sign"></i> Add</button>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-12 col-md-12 modal-table">
            <table class="table table-responsive table-striped">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Plant</th>
                        <th>Narration</th>
                        <th>Amount</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in advanceDetailList">
                        <td>{{x.PartyName}}</td>
                        <td>{{x.PartyPlantName}}</td>
                        <td id="td_Narration_{{$index}}">
                            <div class="show-message">
                                <input ng-disabled="'@Library.Model.Parties.PartyType.Customer.ToString()'==x.PartyType" type="text" class="form-control" ng-model="x.Narration" placeholder="Narration" maxlength="250" ng-keyup="checkRowValidation(x, $index)">
                            </div>
                        </td>
                        <td id="td_Amount_{{$index}}">
                            <div class="show-message">
                                <input ng-disabled="'@Library.Model.Parties.PartyType.Customer.ToString()'==x.PartyType&&!advance.IsInterTransaction" ng-keyup="updateCrAmount(x);checkRowValidation(x, $index);" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.Amount">
                            </div>
                        </td>
                        <td class="text-right">
                            <button ng-hide="'@Library.Model.Parties.PartyType.Customer.ToString()'==x.PartyType" ng-click="removeRow($index)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
                <tfoot ng-show="advanceDetailList.length">
                    <tr>
                        <td></td>
                        <td></td>
                        <td><b>Sub Total</b></td>
                        <td class="text-right"><b>{{ advanceDetailList | sumByKey : 'Amount' }}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </fieldset>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="advance.Id==null"><button ng-click="confirmPost(advance.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>@Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Ordering @Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Posting Date</th>
                    <th>Doc Ref</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Inter Amount</th>
                    <th>Set-off Amount</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>{{x.PartyPlantName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                    <td class="text-right">{{x.Amount-x.NetAmount | number:2}}</td>
                    <td class="text-right">{{x.WrittenOffAmount | number:2}}</td>
                    <td class="text-right">{{x.NetAmount-x.WrittenOffAmount | number:2}}</td>
                    <td>{{x.IsPark?'Parked': x.IsPosted?'Post':'Pending'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPoste || x.IsPark"><a ng-click="confirmPost(x.Id,x.AdvanceGroupNo);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId,x.AdvanceGroupNo);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/ReportCustomerAdvance?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}&advanceGroupNo={{x.AdvanceGroupNo}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/ReportCustomerAdvance?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}&advanceGroupNo={{x.AdvanceGroupNo}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
<div class="modal fade site-modal in" id="ContractPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Contract <button type="button" class="close" ng-click="CloseContractPopUp();">&times;</button></div>
