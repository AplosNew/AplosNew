<div class="modal fade site-modal in" id="multibankPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="bankForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bank List</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="bankParameters.searchBy">
                                            <option ng-repeat="option in bankSearchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="bankParameters.search" ng-enter="getBankList()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getBankList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Bank</th>
                                <th>Bank Branch</th>
                                <th>Account Title</th>
                                <th>Account Number</th>
                                <th ng-show="bankACType=='HouseBank'">GL</th>
                                <th>Currency</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in bankList |itemsPerPage:bankParameters.pageSize" pagination-id="metaData.name + 'bankList'" total-items="bankParameters.total_count" ng-click="selectBankPopUp($index, x.Id)" ng-dblclick="closeMultiBankPopUp()">
                                <td>{{x.BankName}}</td>
                                <td>{{x.BankBranchName}}</td>
                                <td>{{x.AccountTitle}}</td>
                                <td>{{x.AccountNumber}}</td>
                                <td ng-show="bankACType=='HouseBank'">{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                                <td>{{x.CurrencyCode}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'bankList'" direction-links="true" boundary-links="true" on-page-change="getBankList(newPageNumber)"></dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closemultiBankPopUp()">Close</button>
            </div>
        </div>
    </div>
</div>

