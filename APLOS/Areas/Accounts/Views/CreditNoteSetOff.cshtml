<togglable name="Credit Note SetOff"></togglable>
<div class="form-elements form-horizontal" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Party Type<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input type="radio" name="noteType" ng-click="getPartyType(voucher.NoteType);" ng-model="voucher.NoteType" value="@Library.Model.Invoices.NoteType.CustomerCreditNote.ToString()">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>Customer
                </label>
                <label>
                    <input type="radio" name="noteType" ng-click="getPartyType(voucher.NoteType);" ng-model="voucher.NoteType" value="@Library.Model.Invoices.NoteType.VendorCreditNote.ToString()">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>Vendor
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.CustomerCreditNote.ToString()'">
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Customer.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Customer.ToString()" ng-model="voucher.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.VendorCreditNote.ToString()'">
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Vendor.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="voucher.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoicing @Library.Model.Parties.PartyType.Customer.ToString()<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="4" class="form-control" name="Invoicing @Library.Model.Parties.PartyType.Customer.ToString()" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(voucher.InvoicingPartyPlantId,'billTo')" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyAdvanceAmount();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea rows="2" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input ng-click="clearBankPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
                <label>
                    <input ng-click="clearCashPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
                <label ng-hide="voucher.NoteType=='@Library.Model.Invoices.NoteType.VendorCreditNote.ToString()'">
                    <input ng-click="clearInvoicePopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.SettlementType.SetOff.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>Invoice
                </label>
                <label>
                    <input ng-click="clearTaxPopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Tax.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Tax.ToString()
                </label>
                <label>
                    <input ng-click="clearReversePopUp()" type="radio" name="source" ng-model="voucher.PaymentSource" value="@Library.Model.Payments.PaymentSource.Reverse.ToString()">
                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Reverse.ToString()
                </label>
            </div>
        </div>
       
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" ng-disabled="true" tabindex="5" name="Currency" required ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" n-decimals="4" name="Rate" ng-keyup="exchangeGainLossCal(voucher.CompanyCurrencyRate);rateChangeBankCharge(voucher.CompanyCurrencyRate)" id="Rate" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" autocomplete="off" ng-disabled="voucher.CurrencyId==companyCurrencyId||voucher.PaymentSource=='SetOff'">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="voucher.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{voucher.BankName}}" tooltip>
                    <span class="input-group-btn">
                        <button ng-click="showBankPopUp(voucher.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-4 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="voucher.CashName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showCashPopUp(null, voucher.EntityId);" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="voucher.PaymentSource=='@Library.Model.Payments.SettlementType.SetOff.ToString()'">
            <label class="col-sm-4 control-label">Invoice<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="CashName" ng-model="voucher.InvoiceVoucherNo" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.CustomerCreditNote.ToString()'" ng-click="showCustomerInvoicePopUp(voucher.PartyId);" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.VendorCreditNote.ToString()'" ng-click="showVendorInvoicePopUp(voucher.PartyId);" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        @*<div class="form-group">
                <label class="col-sm-4 control-label">Rounding Amount<sup>*</sup></label>
                <div class="col-sm-8 ">
                    <input type="text" ng-disabled="voucher.RoundingType=='None'" n-decimals="4" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="RoundingAmount" ng-model="voucher.RoundingAmount">
                </div>
            </div>*@
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" ng-show="isBankAmount">
            <label class="col-sm-4 control-label">Bank Amount<sup>*</sup></label>
            <div class="col-sm-8 ">
                <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="voucher.BankAmount" >
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="col-xs-12 col-sm-2 col-md-2">
            <button class="btn single-btn" ng-click="getPopupCustomerReceivableList()" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Select Credit Note</button>
        </div>
        <div class="clearfix"></div>
        <fieldset class="scheduler-border" ng-show="voucherDetailList.length">
            <legend class="scheduler-border">Credit Note</legend>
            <div class="table-responsive modal-table">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Voucher No</th>
                            <th>DocDate</th>
                            <th>Doc Ref No</th>
                            <th>Currency</th>
                            <th>Rate</th>
                            <th class="text-right">Payable</th>
                            <th class="text-right">Payment</th>
                            <th class="text-right">Balance</th>
                            <th class="text-right" ng-hide="voucher.PaymentSource=='@Library.Model.Payments.SettlementType.SetOff.ToString()'">Amount</th>
                            <th class="text-right" ng-hide="invoiceCurrencyId==voucher.CurrencyId">Tr. Amount</th>
                            <th>Exchange Type</th>
                            <th>Exchange Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in voucherDetailList">
                            <td>{{x.VoucherNo}}</td>
                            <td>{{x.DocDate |dateFiltering}}</td>
                            <td>{{x.DocRefNo}}</td>
                            <td>{{x.CurrencyCode}}</td>
                            <td>{{x.CompanyCurrencyRate}}</td>
                            <td class="text-right">{{x.Receivable | number:3}}</td>
                            <td class="text-right">{{x.Received | number:3}}</td>
                            <td class="text-right">{{x.Balance | number:3}}</td>
                            <td ng-hide="voucher.PaymentSource=='@Library.Model.Payments.SettlementType.SetOff.ToString()'">
                                <input ng-keyup="exchangeGainLossAmount(x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="x.Amount">
                            </td>
                            <td ng-hide="x.CurrencyId==voucher.CurrencyId">
                                <input ng-keyup="exchangeGainLossAmount(x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ConvertedAmount" autocomplete="off" ng-model="x.ConvertedAmount">
                            </td>
                            <td>
                                <input readonly type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeType" ng-model="x.ExchangeType">
                            </td>
                            <td>
                                <input ng-readonly="x.CurrencyId==voucher.CurrencyId" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeAmount" ng-model="x.ExchangeAmount">
                            </td>
                            <td class="text-right">
                                <button ng-click="removeRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="10"></td>
                            @*<td class="text-right"><b>{{ (voucherDetailList) | sumByKey:'ConvertedAmount' }}</b></td>*@
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </fieldset>

        <fieldset class="scheduler-border" ng-show="voucherInvoiceDetailList.length">
            <legend class="scheduler-border">Invoice</legend>
            <div class="table-responsive modal-table">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Voucher No</th>
                            <th>DocDate</th>
                            <th>Doc Ref No</th>
                            <th>Currency</th>
                            <th>Rate</th>
                            <th class="text-right" ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.CustomerCreditNote.ToString()'">Receivable</th>
                            <th class="text-right" ng-show="voucher.NoteType=='@Library.Model.Invoices.NoteType.VendorCreditNote.ToString()'">Payable</th>
                            <th class="text-right">Additional</th>
                            <th class="text-right">Receipt</th>
                            <th class="text-right">Balance</th>
                            <th class="text-right">Amount</th>
                            <th>Exchange Type</th>
                            <th>Exchange Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in voucherInvoiceDetailList">
                            <td>{{x.VoucherNo}}</td>
                            <td>{{x.DocDate |dateFiltering}}</td>
                            <td>{{x.DocRefNo}}</td>
                            <td>{{x.CurrencyCode}}</td>
                            <td>{{x.CompanyCurrencyRate}}</td>
                            <td class="text-right">{{x.Receivable | number:3}}</td>
                            <td class="text-right">{{x.AdditionalAmount | number:3}}</td>
                            <td class="text-right">{{x.Received | number:3}}</td>
                            <td class="text-right">{{x.Balance | number:3}}</td>
                            <td>
                                <input ng-keyup="exchangeGainLossAmountInvoice(x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" autocomplete="off" ng-model="x.Amount">
                            </td>
                            <td>
                                <input readonly type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeType" ng-model="x.ExchangeType">
                            </td>
                            <td>
                                <input readonly type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="ExchangeAmount" ng-model="x.ExchangeAmount">
                            </td>
                            <td class="text-right">
                                <button ng-click="removeInvoiceRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="10"></td>
                            @*<td class="text-right"><b>{{ (voucherInvoiceDetailList) | sumByKey:'ConvertedAmount' }}</b></td>*@
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </fieldset>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 modal-table" ng-show="voucher.PaymentSource=='@Library.Model.Payments.PaymentSource.Tax.ToString()'">
        <table class="table table-responsive table-striped">
            <caption>TDS </caption>
            <thead>
                <tr>
                    <th>Input Tax</th>
                    <th>Percentage</th>
                    @*<th>Amount</th>*@
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_TDS_TaxCode">
                        <div class="select-style show-message">
                            <select name="TDSTaxCodeId" ng-model="TDS.TaxCodeId" ng-change="selectTDS(TDS.TaxCodeId)" class="col-sm-3 form-control"
                                    ng-options="item.Id as item.UserName for item in TDSCboList">
                                <option></option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <div>
                            <input type="text" n-decimals="4" class="form-control text-right" ng-disabled="TDS.Type =='FixedPercentage' && TDS.ValueOfFixed!=null" ng-model="TDS.ValueOfFixed">
                        </div>
                    </td>
                    @*<td id="td_TDS_TaxCodeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="4" class="form-control text-right" ng-model="TDS.TaxAmount" ng-keyup="copyTaxesAmount();">
                        </div>
                    </td>*@
                    <td class="text-right">
                        <a ng-click="addTDS();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in TDSList">
                    <td>{{x.TaxName}}</td>
                    <td>{{x.ValueOfFixed}}</td>
                    @*<td class="text-right">{{x.TaxAmount | number:2 }}</td>*@
                    <td class="text-right">
                        <button ng-click="removeTDSRow($index)" data-toggle="modal" ng-disabled="x.AdvanceId" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            @*<tfoot ng-show="TDSList.length">
                <tr>
                    <td colspan="2"><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ TDSList | sumByKey : 'TaxAmount' | number:2}}</b></td>
                    <td></td>
                </tr>
            </tfoot>*@
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="confirmSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="voucher.Id==null"><button ng-click="confirmPost(voucher.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchVendorInvoiceList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Vendor</th>
                <th>Posting Date</th>
                <th>Doc Ref No</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in paymentList |itemsPerPage:$root.pageSize" total-items="$root.total_count" @*ng-dblclick="getById(x.Id);"*@>
                <td>{{x.VoucherNo}}</td>
                <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td>{{x.IsPark?'Parked':'Posted'}}</td>
                <td align="right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                        <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>

                        <li><a class="btn btn-action" href="Accounts/AdjustmentNote/CreditNoteSetOffReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Accounts/AdjustmentNote/CreditNoteSetOffReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
