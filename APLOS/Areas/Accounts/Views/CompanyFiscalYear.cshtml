<togglable name="Company Fiscal Year"></togglable>
<div class="form-elements form-horizontal" ng-form id="fiscalYear" name="companyFiscalYearForm">
    <input type="hidden" ng-model="companyFiscalYear.Id">
    <div class="col-xs-42 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4  control-label">Fiscal Year<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Fiscal Year" ng-model="companyFiscalYear.FiscalYearId" class="col-sm-3 form-control"
                            ng-change="getData()" ng-options="item.Value as item.Text for item in fiscalYearList" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="companyFiscalYear.Active" tabindex="3">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-42 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select name="Company Name" ng-model="companyFiscalYear.CompanyId" class="col-sm-3 form-control"
                            ng-change="getData()" ng-options="item.Value as item.Text for item in companyList" required tabindex="2">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="4"><i class="glyphicon glyphicon-floppy-disk" tabindex="6"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="5"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="6"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Fiscal Year</th>
                <th>Company</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in companyFiscalYears |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.FiscalYearName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>