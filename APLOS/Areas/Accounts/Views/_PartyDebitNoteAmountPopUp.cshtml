<div class="modal fade site-modal in" id="partyDebitNotePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Debit Note Balance </h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Vendor</th>
                                <th>Invoicing Vendor</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @*partyWiseOutstandingAdvanceList*@
                            
                            <tr ng-repeat="x in partyWiseOutstandingDebitNoteList">
                                <td>{{x.PartyName}}</td>
                                <td>{{x.PartyPlantName}}</td>
                                <td class="text-right">{{x.Balance | number:2}}</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td></td>
                                <td>Total</td>
                                <td class="text-right"><b>{{ (partyWiseOutstandingDebitNoteList) | sumByKey:'Balance' }}</b></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closePartyDebitNoteAmount();">Close</button>
            </div>
        </div>
    </div>
</div>