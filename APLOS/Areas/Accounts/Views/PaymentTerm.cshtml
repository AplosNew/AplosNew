<togglable name="Payment Term"></togglable>
<div class="form-elements" ng-form id="paymentTerm" name="paymentTermForm">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" maxlength="10" ng-model="paymentTerm.Code" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Payment Mode</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="PaymentModeId" class="form-control" name="Payment Mode" ng-model="paymentTerm.PaymentMode" tabindex="5">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in paymentModeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea class="form-control" name="UserName" maxlength="200" rows="2" ng-model="paymentTerm.UserName" tabindex="2" required></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox">
                    <input type="checkbox" class="css-checkbox" id="active" ng-model="paymentTerm.Active">
                    <label class="css-label" for="active" tabindex="9"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">

        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Base Line Date</legend>
            <div class="col-sm-3 radio">
                <input type="radio" name="baselinedate" ng-model="paymentTerm.BaseLineDate" value="postingdate">
                <span></span><span>Posting Date</span><br />

            </div>
            <div class="col-sm-3 radio">
                <input type="radio" name="baselinedate" ng-model="paymentTerm.BaseLineDate" value="documentdate" ng-checked="paymentTerm.BaseLineDate">
                <span></span><span>Document Date</span><br />

            </div>
            <div class="col-sm-3 radio">
                <input type="radio" name="baselinedate" ng-model="paymentTerm.BaseLineDate" value="deliverydate" ng-checked="paymentTerm.BaseLineDate">
                <span></span><span>Delivery Date</span><br />

            </div>
            <div class="col-sm-3 radio">
                <input type="radio" name="baselinedate" ng-model="paymentTerm.BaseLineDate" value="default">
                <span></span><span>No Default</span><br />
            </div>
        </fieldset>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Account Type</legend>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Customer</label>
                    <div class="col-sm-6">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="paymentTerm.IsCustomer">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Vendor</label>
                    <div class="col-sm-6">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="paymentTerm.IsVendor">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Employee</label>
                    <div class="col-sm-6">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="paymentTerm.IsEmployee">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="col-xs-12">
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <caption><b>Rules</b></caption>
                <thead>
                    <tr>
                        <th>Term</th>
                        <th>Percentage</th>
                        <th>No. of Days</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in paymentTermDetails">
                        <td><input type="hidden" ng-model="x.Id" />{{x.Sequence}}</td>
                        <td><input type="number" max="18" ng-hide="x.Sequence==3" name="Percentage" ng-model="x.Percentage" class="col-sm-2 form-control" style="width:300px"></td>
                        <td><input type="number" name="NoOfDay" ng-model="x.NoOfDay" class="col-sm-2 form-control"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="6"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="8"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>User Name</th>
                <th>Base Line Date</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="p in paymentTerms |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{p.Code}}</td>
                <td>{{p.UserName}}</td>
                <td>{{p.BaseLineDate}}</td>
                <td>{{p.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<toaster-container toaster-options="{'close-button':true, 'animation-class': 'toast-top-center'}"></toaster-container>