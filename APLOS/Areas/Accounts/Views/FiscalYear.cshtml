<togglable name="Fiscal Year"></togglable>
<div class="form-elements form-horizontal" ng-form id="fiscalYear" name="fiscalYearForm">
    <input type="hidden" ng-model="fiscalYear.Id">
    <div class="col-xs-42 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="fiscalYear.FiscalYearCode" class="form-control" required tabindex="1">
            </div>
        </div>
        <div id="div_StartDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Start Date<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="Start Date" ng-model="fiscalYear.StartDate" datepicker class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Year Prefix<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="YearPrefix" ng-model="fiscalYear.YearPrefix" class="form-control" required tabindex="7">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="fiscalYear.Active" tabindex="7">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-42 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Name<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="Fiscal YearName" ng-model="fiscalYear.FiscalYearName" class="form-control" required tabindex="2">
            </div>
        </div>
        <div id="div_EndDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">End Date<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="End Date" ng-model="fiscalYear.EndDate" ng-change="checkDate()" datepicker class="form-control datepicker" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">System Generated Period</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="fiscalYear.IsSysGeneratedPeriod" tabindex="5">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Calendar Wise Period</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="fiscalYear.IsPeriodCalendarWise" tabindex="6">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="7"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="8" ng-disabled="checkValue"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="9"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right  aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchfiscalyearByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>System Generated Period</th>
                <th>Calendar Wise Period</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in fiscalYears |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.FiscalYearCode}}</td>
                <td>{{x.FiscalYearName}}</td>
                <td>{{x.StartDate | dateFiltering}}</td>
                <td>{{x.EndDate | dateFiltering}}</td>
                <td>{{x.IsSysGeneratedPeriod?'Yes':'No'}}</td>
                <td>{{x.IsPeriodCalendarWise?'Yes':'No'}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>