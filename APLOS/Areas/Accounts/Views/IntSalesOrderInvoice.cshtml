<style>
    .selected {
        background-color: rgba(234, 97, 83, 0.42) !important;
    }

    .angucomplete-dropdown {
        position: relative !important;
    }

    .alert-site {
        z-index: 99999 !important;
    }
</style>
<h3>Sales Order Invoice Intregation</h3>
<div class="form-elements  form-horizontal" ng-form id="voucher" name="intSaleOrderInvoiceForm">
    <div class="row text-right ">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchVendorInvoiceList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive modal-table aplos-grid-toggle">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Customer</th>
                    @*<th>GL Code</th>
                    <th>GL</th>*@
                    <th>Invoice NO</th>
                    <th>Doc Date</th>
                    <th>Amount</th>
                    <th>Currency</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in saleOrderInvoices |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                    <td>{{x.PartyName}}</td>
                    @*<td>{{x.GLCode}}</td>
                    <td>{{x.PartyGLName}}</td>*@
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.DocDate}}</td>
                    <td>{{x.Amount}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td>
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-checked="x.Active" ng-model="x.Active">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="getData(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>
<div class="row">
    <div class="col-xs-12 form-horizontal">
        <div class="form-group">
            <div class="col-sm-6">
            </div>
            <div class="col-sm-6">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button  ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button>
                        </li>
                        <li>
                        <a href="upanel/sales-order-edit-invoice" class="btn btn-action tooltip-here" data-toggle="tooltip" data-placement="top" title="Edit" tooltip><i class="glyphicon glyphicon-search"></i></a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->