<style>
    .modellgModify {
        width: 1000px;
    }
</style>
<div class="modal fade site-modal in" id="additionalTaxPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content" ng-form name="PopUpForm1">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="VoucherDate" ng-model="additionalTaxData.VoucherDate" datepicker class="form-control" disabled>
                            </div>
                        </div>
                        <div class="form-group" ng-show="additionalTaxData.GRNNo">
                            <label class="col-sm-4 control-label">GRN No<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="50" name="Doc Ref" ng-model="additionalTaxData.GRNNo" class="form-control" tabindex="4" readonly>
                            </div>
                        </div>
                        <div class="form-group" >
                            <label class="col-sm-4 control-label">Status<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="50" name="Doc Ref" ng-model="additionalTaxData.IsTDSTaxPost" class="form-control" tabindex="4" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select id="VoucherType" class="form-control" name="VoucherType" ng-model="additionalTaxVoucherTypeId" ng-disabled="voucherTypeListnew.length==1" tabindex="7">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in voucherTypeListnew" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        <div id="div_PostingDate" class="form-group" ng-show="additionalTaxData.GRNNo">
                            <label class="col-sm-4 control-label">GRN Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input  datepicker id="postingDate" type="text" name="Posting Date" ng-model="additionalTaxData.GRNDate" class="form-control" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>GL</th>
                                        <th>Budget</th>
                                        <th>Activity</th>
                                        <th>Particulars</th>
                                        <th>Dr</th>
                                        <th>Cr</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in additionalTaxDetailList| orderBy:'Dr'">
                                        <td>{{x.GLName}}</td>
                                        <td>{{x.BudgetName}}</td>
                                        <td>{{x.ActivityName}}</td>
                                        <td>{{x.Particulars}}</td>
                                        <td class="text-right">{{x.DrAmount | number| setDecimal:4}}</td>
                                        <td class="text-right">{{x.CrAmount | number| setDecimal:4}}</td>
                                    </tr>
                                    <tr>
                                        <td colspan="4"></td>
                                        <td class="text-right"><strong>{{additionalTaxDetailList | sumByKey : 'DrAmount' | number| setDecimal:4}}</strong></td>
                                        <td class="text-right"><strong>{{additionalTaxDetailList | sumByKey : 'CrAmount' | number| setDecimal:4}}</strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-disabled="additionalTaxData.TDSTaxVoucherId==null" ng-click="additionalTaxPrint();">Print</button>
                <button type="button" class="btn btn-default" ng-disabled="additionalTaxData.TDSTaxVoucherId!=null" ng-click="postAdditionalTax();">Post</button>
                <button type="button" class="btn btn-default" ng-show="additionalTaxData.IsTDSTaxPost=='TDSParked' && additionalTaxData.TDSTaxVoucherId==null" ng-click="onClickTDSDeletePopUp(additionalTaxData);">TDS Delete</button>
                <button type="button" class="btn btn-default" ng-show="additionalTaxData.IsTDSTaxPost=='TDSPosted' && additionalTaxData.TDSTaxVoucherId!=null" ng-click="onClickTDSPostDeletePopUp(additionalTaxData);">Post Delete</button>
                <button type="button" class="btn btn-default" ng-click="closeAdditionalTax();">Close</button>
            </div>
        </div>
    </div>
</div>