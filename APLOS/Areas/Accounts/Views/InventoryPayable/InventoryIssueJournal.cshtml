    <div class="content-container-fluid" style="color:black;">
        <div style="color:black;" id="GridPrint" ej-grid e-datasource="GridInventoryIssuedata" e-allowfiltering="true" e-allowpaging="true"
             e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
             e-actioncomplete="actionCompleteSelected" e-allowscrolling="true" e-showstackedheader="true">
            <div e-columns>
                <div e-column e-field="IssueNo" e-headertext="IssueNo" e-width="60" e-filter="false"></div>
                <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-width="180"></div>
                <div e-column e-field="VoucherDate" e-headertext="VoucherDate" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="MaterialStorageName" e-headertext="MaterialStorageName" e-width="80"></div>
                <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>
                <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                <div e-column e-field="IssueDate" e-headertext="IssueDate" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="130"></div>
                <div e-column e-field="Types" e-headertext="Types" e-width="100" textAlign='Right'></div>
                <div e-column e-field="SourceNo" e-headertext="SourceNo" e-width="60" textAlign='Right'></div>
                <div e-column e-field="ContractId" e-headertext="ContractId" e-width="100" textAlign='Right'></div>
                <div e-column e-field="TransactionQty" e-headertext=" TransactionQty " e-width="100" textAlign='Right'></div>
                <div e-column e-field="PolicyAmount" e-headertext="PolicyAmount" e-width="100" textAlign='Right'></div>
                <div e-column e-field="IsPark" e-headertext="Park/Post" e-width="100" textAlign='Right'></div>
                <div e-column e-headertext="Report" e-template="#ReportTemplate" e-width="100"></div>
            </div>


        </div>
        <script id="ReportTemplate" type="text/template">
            <div class="common-btn">
                <ul class="common-btn list-inline text-center">
                    <li>
                        <button ng-click="$parent.onClickReportDownloadWord(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Pdf">
                            <i class="fa fa-file-pdf-o"></i>
                        </button>
                        <button ng-click="$parent.onClickReportDownloadExcel(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Excel">
                            <i class="fa fa-file-excel-o"></i>
                        </button>
                        <button ng-click="$parent.issueReportDownload(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="GRN">
                            <i class="glyphicon glyphicon-file" style="color:orangered;"></i>
                        </button>
                        <button ng-click="$parent.downloadIssueExcel(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="GRN">
                            <i class="glyphicon glyphicon-file" style="color:orangered;"></i>
                        </button>
                        <button ng-click="$parent.confirmDelete(data.IssueNo,data.VoucherId);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Delete">
                            <i class="glyphicon glyphicon-file" style="color:orangered;"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>

         
    </div>
    <i>**Showing top 100 Posted Issue  order by PostingDate</i>
</div>

