<togglable name="Inventory Issue Posting"></togglable>
<div class="form-elements form-horizontal" ng-form="modelNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Information</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Issue Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="DocRef" ng-model="modelNew.IssueDate" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="popUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" name="Voucher Type" ng-disabled="voucherTypeList.length==1" ng-model="modelNew.VoucherTypeId"
                                ng-options="item.Value as item.Text for item in voucherTypeList" tabindex="2">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-4 control-label"><b>Issue No :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.Id}}</b></label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label"><b>Employee :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.EmployeeName}}</b></label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label"><b>Entity :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.EntityName}}</b></label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label"><b>Order Ref No :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.OrderRefNo}}</b></label>
            </div>
            <div class="form-group" ng-show="modelNew.IsOrderSpecificy">
                <label class="col-sm-4 control-label"><b>Source No :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.SourceNo}}</b></label>
            </div>
            <div class="form-group" ng-show="modelNew.IsOrderSpecificy">
                <label class="col-sm-4 control-label"><b>Contract :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.ContractId}}</b></label>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-4 control-label"><b>Material Storage :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.MaterialStorage}}</b></label>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label"><b>Issue Type :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.IssueType}}</b></label>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label"><b>Remarks :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.Remarks}}</b></label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label"><b> Type :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.Types}}</b></label>
            </div>

            <div class="form-group" ng-show="modelNew.IsOrderSpecificy">
                <label class="col-sm-4 control-label"><b> LC No :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.LCRef}}</b></label>
            </div>
            <div class="form-group" ng-show="modelNew.IsOrderSpecificy">
                <label class="col-sm-4 control-label"><b>Customer :</b></label>
                <label class="col-sm-8 control-label"><b>{{modelNew.Customer}}</b></label>
            </div>
        </div>

        <div class="clearfix"></div>


    </fieldset>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Issue Material</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Service" role="tab" data-toggle="tab">Journal</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form="tabForm1">
                <div class="col-xs-12 col-sm-4 col-md-4" ng-show="modelNew.Id">
                    <div class="form-group">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-left">
                                <li> <button ng-click="downloadIssue();" class="btn"> Issue Report</button></li>
                                <li> <button ng-click="downloadIssueExcel();" class="btn"> Issue Detail Report</button></li>
                            </ul>

                        </div>
                    </div>
                </div>

                <div class="clearfix"></div>
                <fieldset class="scheduler-border" ng-show="inventoryIssueList.length>0">
                    <legend class="scheduler-border">Issued Material</legend>
                    <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Material Group</th>
                                        <th>Material Master</th>
                                        <th>Article</th>
                                        <th>SKU1</th>
                                        <th>SKU2</th>
                                        <th>SKU3</th>
                                        <th>HSN</th>
                                        <th>Asset</th>
                                        <th>Qty</th>
                                        <th>Rate</th>
                                        <th>Amount (TRN)</th>
                                        <th>Budget</th>
                                        <th>Activity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in inventoryIssueList">
                                        <td>{{x.MaterialGroupMasterName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.FirstCharacteristicsValue}}</td>
                                        <td>{{x.SecondCharacteristicsValue}}</td>
                                        <td>{{x.ThirdCharacteristicsValue}}</td>
                                        <td>{{x.HSNCode}}</td>
                                        <td>{{x.IsAsset?'Yes':'No'}}</td>
                                        <td class="text-right">{{x.TransactionQty}}  {{x.TransactionUoM}}</td>
                                        <td class="text-right">{{x.TransactionRate | number| setDecimal:2}}  {{x.CurrencyName}}</td>
                                        <td class="text-right">{{x.TrnAmount | number| setDecimal:2}}</td>
                                        <td>
                                            <div class="input-group" style="margin-top: -7px;margin-bottom: -7px;">
                                                <input type="text" ng-model="x.BudgetName" class="form-control" readonly>
                                                <span class="input-group-btn">
                                                    <button class="btn single-small-btn" ng-hide="modelNew.IssueType=='Capital'" ng-click="GetCOAICodeListMB($index,x);"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                                    <button tabindex="1" ng-click="GetIssueAUCList($index,x);" ng-hide="modelNew.IssueType=='Revenue'" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                                    <button class="btn single-small-btn" ng-click="refreshGLMB($index);"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                                </span>
                                            </div>
                                        </td>
                                        <td>{{x.ActivityName}}</td>
                                    </tr>
                                    <tr>
                                        <td colspan="8" class="text-right"><strong>Total : </strong></td>
                                        <td class="text-right" ng-hide="sumORnot"></td>
                                        <td class="text-right" ng-show="sumORnot"><strong>{{inventoryReceivedList | sumByKey : 'TransactionQty' }}</strong></td>
                                        <td></td>
                                        <td class="text-right"><strong>{{inventoryIssueList | sumByKey : 'TrnAmount'| number| setDecimal:2 }}</strong></td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <fieldset class="scheduler-border" ng-show="inventoryMaterialList.length>0">
                    <legend class="scheduler-border">Issued Journal</legend>
                    <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>GL</th>
                                    <th>Budget</th>
                                    <th>Activity</th>
                                    <th>Dr</th>
                                    <th>Cr</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in inventoryMaterialList">
                                    <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                    <td>{{x.BudgetName}}</td>
                                    <td>{{x.ActivityName}}</td>
                                    <td class="text-right">{{x.Dr | number| setDecimal:2}}</td>
                                    <td class="text-right">{{x.Cr | number| setDecimal:2}}</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-right"><strong>Total : </strong></td>
                                    <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'Dr'| number| setDecimal:2 }}</strong></td>
                                    <td class="text-right"><strong>{{inventoryMaterialList | sumByKey : 'Cr'| number| setDecimal:2 }}</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </fieldset>
            </div>

        </div>
        <div class="clearfix"></div>
        <div class="common-btn">
            <ul class="common-btn list-inline text-right">
                <li> <button ng-click="Post();" ng-disabled="ispostDisable" class="btn"> Post</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchByIssue">
                                <option ng-repeat="option in searchByIssueList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="searchIssue" ng-enter="getdataInventoryIssue();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getdataInventoryIssue()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
