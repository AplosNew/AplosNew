                                    <button ng-click="removeTDSRow($index)" data-toggle="modal" ng-disabled="x.AdvanceId" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot ng-show="TDSList.length">
                            <tr>
                                <td colspan="2"><b>Sub Total</b></td>
                                <td class="text-right"><b>{{ TDSList | sumByKey : 'TaxAmount' }}</b></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }" ng-form="tabForm4" ng-show="OtherVendorChargesPayableList.length">

                <div class="col-xs-12 col-sm-4 col-md-4" ng-show="OtherVendorChargesPayableList.length">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Other Party</label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="OtherPartyName" ng-model="modelNew.OtherPartyName" readonly>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4" ng-show="OtherVendorChargesPayableList.length">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Doc Ref No</label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="OtherPartyDocRefNo" ng-model="modelNew.OtherPartyDocRefNo" readonly>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4" ng-show="OtherVendorChargesPayableList.length">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">RCM Applicable</label>
                        <div class="col-sm-8 pdr3">
                            <div class="checkbox-site" style="margin-left:45px">
                                <label>
                                    <input type="checkbox" ng-model="modelNew.OtherPartyRCMApplicable">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="clearfix"></div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>Dr</th>
                                <th>Cr</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in OtherVendorChargesPayableList| orderBy:'Dr'| groupBy: 'MaterialGroupMasterId'">
                                <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td class="text-right">{{x.Dr | number| setDecimal:4}}</td>
                                <td class="text-right">{{x.Cr | number| setDecimal:4}}</td>
                            </tr>
                            <tr>
                                <td colspan="3"></td>
                                <td class="text-right"><strong>{{OtherVendorChargesPayableList | sumByKey : 'Dr' | number| setDecimal:4}}</strong></td>
                                <td class="text-right"><strong>{{OtherVendorChargesPayableList | sumByKey : 'Cr' | number| setDecimal:4}}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
            </div>
           
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-4 col-md-4" ng-show="modelNew.PartyId">
        <div class="form-group" show-errors>
            <label class="col-sm-6 control-label">Total Invoice Amount(Fiscal Year)<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <div class="input-group">
                    <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right " readonly name="TotalAdvanceAmount" ng-model="TotalfiscalinvoiceAmountByParty" style="color:red">
                    <span class="input-group-btn">
                        <button ng-click="showFiscalInvoiceAmountByParty();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="common-btn list-inline text-right">
            <li> <button ng-click="Post();" ng-disabled="ispostDisable" class="btn"> Post</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchByPostedGRN">
                                <option ng-repeat="option in searchByPostedGRNList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="searchGRN" ng-enter="getDataList();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content-container-fluid" style="color:black;">
        <div style="color:black;" id="GridPrint" ej-grid e-datasource="products" e-allowfiltering="true" e-allowpaging="true"
             e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
             e-actioncomplete="actionCompleteSelected" e-allowscrolling="true" e-showstackedheader="true">
            <div e-columns>
                <div e-column e-field="GRNType" e-headertext="Type" e-width="60" e-filter="false"></div>
                <div e-column e-field="Particular" e-headertext="Particular" e-width="180"></div>
                <div e-column e-field="Id" e-headertext="GRN No" e-width="80" textAlign='Center'></div>
                <div e-column e-field="GRNDate" e-headertext="GRN Date" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="GateEntryNo" e-headertext="Gate EntryNo" e-width="80"></div>
                <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-width="100"></div>
                <div e-column e-field="PostingDate" e-headertext="PostingDate" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="POId" e-headertext="PO Id" e-width="60"></div>
                <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                <div e-column e-field="DocDate" e-headertext="Doc Ref Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="MaterialStorageName" e-headertext="Storage Location" e-width="130"></div>
                <div e-column e-field="TransactionQty" e-headertext="Tran.Qty" e-width="100" textAlign='Right'></div>
                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="60" textAlign='Right'></div>
                <div e-column e-field="TransactionAmount" e-headertext="Tran Amount" e-width="100" textAlign='Right'></div>
                <div e-column e-field="TDSTax" e-headertext=" TDS " e-width="100" textAlign='Right'></div>
                <div e-column e-field="TDSVoucherNo" e-headertext="TDS VoucherNo" e-width="100" textAlign='Right'></div>
                <div e-column e-field="IsTDSTaxPost" e-headertext="Tax Status" e-width="100" textAlign='Right'></div>
                <div e-column e-headertext="Report" e-template="#ReportTemplate" e-width="100"></div>
                <div e-column e-headertext=" Action " e-template="#DeleteTemplate" e-width="120"></div>

            </div>


        </div>
        <script id="ReportTemplate" type="text/template">
            <div class="common-btn">
                <ul class="common-btn list-inline text-center">
                    <li>
                        <button ng-click="$parent.onClickReportDownloadWord(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Pdf">
                            <i class="fa fa-file-pdf-o"></i>
                        </button>
                        <button ng-click="$parent.onClickReportDownloadExcel(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Excel">
                            <i class="fa fa-file-excel-o"></i>
                        </button>
                        <button ng-click="$parent.onClickGRNID(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="GRN">
                            <i class="glyphicon glyphicon-file" style="color:orangered;"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>

        <script id="DeleteTemplate" type="text/template">
            <div class="common-btn">
                <ul class="common-btn list-inline text-center">
                    <li>
                        <button ng-disabled="data.AdditionalTaxId==null" ng-click="$parent.onClickadditionalTaxPop(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="TDS">
                            TDS
                        </button>
                        <button ng-disabled="data.ShortageQty==0" ng-click="$parent.onClickshortageQtyPop(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Shortage">
                            Shortage
                        </button>
                        <button ng-disabled="data.IsPark==false" ng-click="$parent.onClickDeletePopUp(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Delete">
                            <i class="glyphicon glyphicon-trash" style="color:orangered;"></i>
                        </button>
                        <button ng-show="data.WrittenOffAmount" ng-click="$parent.getInvoiceSetOffDetailByInvoice(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="SetOff">
                            <i class="glyphicon glyphicon-eye-open" style="color:orangered;"></i>
                        </button>
                        <button ng-show="data.IsPark==true" ng-click="$parent.confirmPost(data.InvoiceId,data.BeneficiaryType,data.AdditionalTaxId,data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Post">
                            Post
                        </button>
                    </li>
                </ul>
            </div>
        </script>
    </div>
    <i>**Showing top 100 Posted GRN  order by PostingDate</i>
</div>
<div class="modal fade site-modal in" id="confirmDeletePopUp_Remarks" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:600px">
        <div class="modal-content" ng-form name="confirmDeletePopUp_RemarksForm">
            <div class="modal-header">Are you sure to Delete?</div>
            <div class="modal-body">
                <div class="form-group" show-errors>
                    <label class="col-sm-2 control-label">Remarks<sup>*</sup></label>
                    <div class="col-sm-10 show-message">
                        <textarea rows="4" type="text" maxlength="500" name="DeletedRemarks" tabindex="8" class="form-control" ng-model="deletedRemarks" required></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeconfirmDeletePopUp_Remarks()">No</button>
                <button type="button" class="btn btn-default" ng-click="delete(GRNId,VoucherId,InvoiceId,OtherVendorId,Type,TDSTaxVoucherId,TDSVoucherNo,deletedRemarks)">Yes</button>
