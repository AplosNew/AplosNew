<style>
    .modellgModify1 {
        width: 1300px;
    }
</style>

<div class="modal fade site-modal in" id="GRNpopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify1">
        <div class="modal-content">
            <div class="modal-header"> Goods Receive Notes <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        <div style="color:black;overflow:scroll" id="GRNGrid" ej-grid e-datasource="approvedGRNList" e-templaterefresh="refreshTemplate"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-allowscrolling="true">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="Type" e-headertext="Type" e-width="70" e-filter="false"></div>
                                <div e-column e-field="Particular" e-headertext="Vendor" e-width="180"></div>
                                <div e-column e-field="Id" e-headertext="GRN No" e-width="80"></div>
                                <div e-column e-field="GRNDate" e-headertext="GRN Date" e-width="70" e-format="{0:dd-MMM-yyyy}" type="date"></div>
                                <div e-column e-field="DocRefNo" e-headertext="GRN Ref No" e-width="80"></div>
                                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                <div e-column e-field="TransactionQty" e-headertext="Qty" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="TransactionAmount" e-headertext="Amount (TRN)" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="BaseAmount" e-headertext="Amount (BC)" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="PaymentMode" e-headertext="PaymentMode" e-width="100" e-type='string'></div>
                                <div e-column e-field="IsFOC" e-headertext="FOC" e-width="60" e-type='string'></div>
                                <div e-column e-field="POId" e-headertext="PO No" e-width="90"></div>
                                <div e-column e-field="PODate" e-headertext="PO Date" e-width="70" e-format="{0:dd-MMM-yyyy}" type="date"></div>
                                <div e-column e-field="POVendorRefNo" e-headertext="PO Ref No" e-width="80"></div>
                                <div e-column e-field="AcceptanceNo" e-headertext="Acceptance No" e-width="80" e-type='string'></div>
                                <div e-column e-field="AcceptanceDate" e-headertext="AcceptanceDate No" e-width="80" e-type='string'></div>
                                <div e-column e-field="LCNo" e-headertext="LC No" e-width="80" e-type='string'></div>
                                <div e-column e-field="GateEntryNo" e-headertext="GateEntry No" e-width="60"></div>
                                <div e-column e-field="GateEntryName" e-headertext="GateEntry" e-width="60"></div>
                                <div e-column e-field="ContractNo" e-headertext="Contract No" e-width="80" e-type='string'></div>
                                <div e-column e-field="CustomerName" e-headertext="Customer" e-width="120" e-type='string'></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Active" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeGRNPopUp();" class="btn"> Apply</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>