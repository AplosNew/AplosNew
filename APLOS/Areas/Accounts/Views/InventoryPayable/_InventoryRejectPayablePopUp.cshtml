<style>
    .modellgModify {
        width: 1400px;
    }
</style>
<div class="modal fade site-modal in" id="rejectpopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Inventory Receive Reject <button type="button" class="close" ng-click="closePopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="Grid" ej-grid e-datasource="rejectList" e-recorddoubleclick="selectDoubleClick"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="PartyCode" e-headertext="Party Code" e-width="50" e-filter="false"></div>
                                <div e-column e-field="PartyName" e-headertext="Vendor" e-width="180"></div>
                                <div e-column e-field="EntryDate" e-headertext="Entry Date" e-width="100"></div>
                                <div e-column e-field="GRNDate" e-headertext="GRN Date" e-width="100"></div>
                                <div e-column e-field="Id" e-headertext="GRN No" e-width="100"></div>
                                <div e-column e-field="ShortageQty" e-headertext="Shortage Qty" e-width="80"></div>
                                <div e-column e-field="ShortageAmount" e-headertext="Shortage Amount" e-width="80"></div>
                                <div e-column e-field="ShortageBaseAmount" e-headertext="Shortage BaseAmount" e-width="80"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closePopUp();" class="btn"> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>