<togglable name="Shortage Payable"></togglable>
<div class="form-elements form-horizontal" ng-form="modelNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Infromation</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-3 control-label">Doc Ref & Date<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{modelNew.DocRefNo}}</span>
                        <input type="text" ng-model="modelNew.DocDate" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="shortageData();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" name="Voucher Type" ng-disabled="voucherTypeList.length==1" ng-model="modelNew.VoucherTypeId"
                                ng-options="item.Value as item.Text for item in voucherTypeList" tabindex="2">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" style="margin-bottom: 0px;" ng-hide="modelNew.EmployeeId==null">
                <label class="col-sm-3 control-label"><b>EmployeeCode :</b></label>
                <label class="col-sm-9 control-label"><b>{{modelNew.EmployeeCode}}</b></label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Vendor :</label>
                <label class="col-sm-9 control-label">{{modelNew.PartyCode}} - {{modelNew.PartyName}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Invoicing By :</label>
                <label class="col-sm-9 control-label">{{modelNew.InvoicingBy}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Invoicing Address :</label>
                <label class="col-sm-9 control-label" style="white-space: pre-line;">{{modelNew.InvoicingByAddress}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Gate Entry No :</label>
                <label class="col-sm-9 control-label">{{modelNew.GateEntryNo}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">GRN No :</label>
                <label class="col-sm-9 control-label">{{modelNew.Id}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Payment Term :</label>
                <label class="col-sm-9 control-label">{{modelNew.PaymentTermName}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Base on due date :</label>
                <label class="col-sm-9 control-label">{{modelNew.BaseOnDueDate}}</label>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" style="margin-bottom: 0px;" ng-hide="modelNew.EmployeeId==null">
                <label class="col-sm-3 control-label"><b>Employee Name :</b></label>
                <label class="col-sm-9 control-label"><b>{{modelNew.EmployeeName}}</b></label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Party Account Group :</label>
                <label class="col-sm-9 control-label">{{modelNew.PartyAccountGroupName}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Delivery By :</label>
                <label class="col-sm-9 control-label">{{modelNew.DeliveryBy}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Delivery Address :</label>
                <label class="col-sm-9 control-label" style="white-space: pre-line;">{{modelNew.DeliveryByAddress}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Gate Entry Date :</label>
                <label class="col-sm-9 control-label">{{modelNew.EntryDate}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">GRN Date :</label>
                <label class="col-sm-9 control-label">{{modelNew.GRNDate}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Currency :</label>
                <label class="col-sm-9 control-label">{{modelNew.CurrencyCode}}</label>
            </div>
            <div class="form-group" style="margin-bottom: 0px;">
                <label class="col-sm-3 control-label">Due Date :</label>
                <label class="col-sm-9 control-label">{{modelNew.MatureDate}}</label>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-6 col-md-6" ng-show="modelNew.EmployeeId">
            <div id="div_TransactionType" class="form-group">
                <label class="col-sm-3 control-label">Transaction Type<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <div class="select-style">
                        <select ng-change="glPushInList();" name="Transaction Type" class="form-control" ng-model="modelNew.EmployeeTransactionTypeId">
                            <option value=""></option>
                            <option ng-repeat="option in employeeTransactionTypeList" value="{{option.EmployeeTransactionTypeId}}">{{option.EmployeeTransactionTypeName}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border" ng-show="inventoryReceivedList.length">
        <legend class="scheduler-border">GRN Info</legend>
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Material Group</th>
                        <th>Material Master</th>
                        <th>Article</th>
                        <th>Char1</th>
                        <th>Char2</th>
                        <th>Char3</th>
                        <th>Qty</th>
                        <th>Rate</th>
                        <th>Amount (TRN)</th>
                        <th>Tax</th>
                        @*<th>Service Charge</th>*@
                        @*<th>Service Tax</th>*@
                        <th>Amount (BC)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in inventoryReceivedList">
                        <td>{{x.MaterialGroupMasterName}}</td>
                        <td>{{x.UserName}}</td>
                        <td>{{x.StandardName}}</td>
                        <td>{{x.FirstCharacteristicsValue}}</td>
                        <td>{{x.SecondCharacteristicsValue}}</td>
                        <td>{{x.ThirdCharacteristicsValue}}</td>
                        <td class="text-right">{{x.ShortageQty}}  {{x.TransactionUoM}}</td>
                        <td class="text-right">{{x.TransactionRate| setDecimal:currencyPrecision| number}}  {{x.CurrencyName}}</td>
                        <td class="text-right">{{x.TrnAmount| setDecimal:currencyPrecision| number}}</td>
                        <td class="text-right">{{x.TaxAmount| setDecimal:currencyPrecision| number}}</td>
                        @*<td class="text-right">{{x.ServiceCharge| setDecimal:currencyPrecision| number}}</td>*@
                        @*<td class="text-right">{{x.ServiceTax| setDecimal:currencyPrecision| number}}</td>*@
                        <td class="text-right">{{x.BaseAmount| setDecimal:currencyPrecision| number}}</td>
                    </tr>
                    <tr>
                        <td colspan="6" class="text-right"><strong>Total : </strong></td>
                        <td class="text-right" ng-hide="sumORnot"></td>
                        <td class="text-right" ng-show="sumORnot"><strong>{{inventoryReceivedList | sumByKey : 'TransactionQty' }}</strong></td>
                        <td class="text-right"><strong>{{inventoryReceivedList | sumByKey : 'TransactionRate'| setDecimal:currencyPrecision| number }}</strong></td>
                        <td class="text-right"><strong>{{inventoryReceivedList | sumByKey : 'TrnAmount'| setDecimal:currencyPrecision| number }}</strong></td>
                        <td class="text-right"><strong>{{inventoryReceivedList | sumByKey : 'TaxAmount'| setDecimal:currencyPrecision | number}}</strong></td>
                        @*<td class="text-right"><strong>{{inventoryReceivedList | sumByKey : 'ServiceCharge'| setDecimal:currencyPrecision | number}}</strong></td>*@
                        @*<td class="text-right"><strong>{{inventoryReceivedList | sumByKey : 'ServiceTax'| setDecimal:currencyPrecision | number}}</strong></td>*@
                        <td class="text-right"><strong>{{inventoryReceivedList | sumByKey : 'BaseAmount'| setDecimal:currencyPrecision | number}}</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </fieldset>
    <div class="clearfix"></div>
    <fieldset class="scheduler-border" ng-show="newList.length">
        <legend class="scheduler-border">Journal</legend>
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>Dr</th>
                        <th>Cr</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in newList| orderBy:'MaterialGroupMasterId'| groupBy: 'MaterialGroupMasterId'" ng-hide="modelNew.IsWrittenOff">
                        <td>
                            <span ng-hide="newList[$index].TrnType=='Dr'">{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</span>
                            <div class="input-group" style="margin-top: -7px;margin-bottom: -7px;" ng-hide="newList[$index].TrnType=='Cr'">
                                <input type="text" ng-model="x.GLName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button class="btn single-small-btn" ng-click="getGLPopUP($index);"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    <button class="btn single-small-btn" ng-click="refreshGL($index);"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </td>
                        <td>
                            <span ng-hide="newList[$index].TrnType=='Dr'">{{x.BudgetName}}</span>
                            <div class="select-style" ng-hide="newList[$index].TrnType=='Cr'">
                                <select class="form-control" ng-model="x.BudgetMasterId" ng-options="item.BudgetMasterId as item.BudgetName for item in x.budgetList" ng-change="getActivity($index);"></select>
                            </div>
                        </td>
                        <td>
                            <span ng-hide="newList[$index].TrnType=='Dr'">{{x.ActivityName}}</span>
                            <div class="select-style" ng-hide="newList[$index].TrnType=='Cr'">
                                <select class="form-control" ng-model="x.ActivityId" ng-options="item.ActivityId as item.ActivityName for item in x.activityList">
                                    <option></option>
                                </select>
                            </div>
                        </td>
                        <td>{{x.Dr}}</td>
                        <td>{{x.Cr}}</td>
                    </tr>
                    <tr ng-repeat="x in newList| orderBy:'MaterialGroupMasterId'| groupBy: 'MaterialGroupMasterId'" ng-show="modelNew.IsWrittenOff">
                        <td>{{X.GLGeneralInfoCode}} - {{X.GLGeneralInfoName}}</td>
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td>{{x.Dr}}</td>
                        <td>{{x.Cr}}</td>
                    </tr>
                </tbody>
            </table>
            @*<table class="table table-striped">
                    <thead>
                        <tr>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>Dr</th>
                            <th>Cr</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in newList| orderBy:'MaterialGroupMasterId'| groupBy: 'MaterialGroupMasterId'">
                            <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
