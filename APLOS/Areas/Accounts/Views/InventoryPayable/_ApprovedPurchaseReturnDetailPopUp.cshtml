<style>
    .modellgModify1 {
        width: 1300px;
    }
</style>

<div class="modal fade site-modal in" id="PurchaseReturnpopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify1">
        <div class="modal-content">
            <div class="modal-header"> Purchase Return <button type="button" class="close" ng-click="closePurchaseReturnPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        @*style="color:black;overflow:scroll"*@
                        <div style="color:black;overflow:scroll" id="GRNGrid" ej-grid e-datasource="approvedPurchaseReturnList" e-recorddoubleclick="selectDoubleClick"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true"  e-allowselection="true" e-allowscrolling="true">
                            <div e-columns>
                                <div e-column e-field="Type" e-headertext="Type" e-width="70" e-filter="false"></div>
                                <div e-column e-field="Particular" e-headertext="Particular" e-width="180"></div>
                                <div e-column e-field="Id" e-headertext="PR No" e-width="80"></div>
                                <div e-column e-field="GRNDate" e-headertext="GRN Date" e-width="70" e-format="{0:dd-MMM-yyyy}" type="date"></div>
                                <div e-column e-field="DocRefNo" e-headertext="GRN Ref No" e-width="80"></div>
                                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                <div e-column e-field="TransactionQty" e-headertext="Qty" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="TransactionAmount" e-headertext="Amount (TRN)" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="BaseAmount" e-headertext="Amount (BC)" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="GateEntryNo" e-headertext="GateEntry No" e-width="60"></div>
                                <div e-column e-field="GateEntryName" e-headertext="GateEntry" e-width="60"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closePurchaseReturnPopUp();" class="btn"> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>