<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Expenses Booking
</h3>
<div class="form-elements" ng-form id="employeeTransactionTypeGL" name="employeeTransactionTypeGLForm">
        <input type="hidden" ng-model="employeeTransactionTypeGL.Id">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-2 control-label">COA<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="employeeTransactionTypeGL.COAId" ng-change="showAll('all');"
                                ng-options="item.Value as item.Text for item in COAList" id="COAId" name="COA" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        </div>
        <div class="col-sm-12 form-horizontal">
            <div class="table-responsive modal-table col-xs-12" ng-show="employeeTransactionTypeGLWithCombineList.length>0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th style="vertical-align: middle; text-align:center" rowspan="2">Is Expenses Booking </th>
                            <th style="vertical-align: middle; text-align:center" rowspan="2">Employee Transaction Type</th>
                            <th style="text-align:center" colspan="3">Advance</th>
                            <th style="text-align:center" colspan="3">Payable</th>
                        </tr>
                        <tr>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="x in employeeTransactionTypeGLWithCombineList|itemsPerPage:$root.pageSize" total-items="$root.total_count">
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" id="{{x.employeeTransactionTypeId}}" ng-model="x.IsExpensesBooking" ng-checked="x.IsExpensesBooking" ng-click="selectChValueId($event,x)">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>
                                {{x.EmployeeTransactionTypeName}}
                            </td>
                            <td>
                                {{x.AssetGLCode}} - {{x.AssetGLText}}
                            </td>
                            <td>{{x.AdvanceBudgetName}}</td>
                            <td>{{x.AdvanceActivityName}}</td>
                            <td>
                                {{x.LiabilityGLCode}} - {{x.LiabilityGLText}}
                            </td>
                            <td>{{x.PayableBudgetName}}</td>
                            <td>{{x.PayableActivityName}}</td>
                        </tr>
                    </tbody>
                </table>
                <dir-pagination-controls max-size="10"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getData(newPageNumber)">
                </dir-pagination-controls>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            </ul>
        </div>
</div>
<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteTestingStandardSavedItem()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="glUntag" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>