<style>
    .modellgModify {
        width: 1200px;
    }
</style>
<div class="modal fade site-modal in" id="invoiceetOffByInvoicePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content" ng-form name="partyForm">
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>VoucherNo</th>
                                <th>Source Type</th>
                                <th>Ordering @Library.Model.Parties.PartyType.Vendor.ToString()</th>
                                <th>PostingDate</th>
                                <th>DocDate</th>
                                <th>Doc Ref</th>
                                <th>Currency</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in invoiceSetOffDetailList">
                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.SourceType}}</td>
                                <td>{{x.PartyPlantName}}</td>
                                <td>{{x.PostingDate |dateFiltering}}</td>
                                <td>{{x.DocDate |dateFiltering}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td class="text-right">{{x.Amount | number:2}}</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7" class="text-right">Total</td>
                                <td class="text-right"><b>{{ (invoiceSetOffDetailList) | sumByKey:'Amount' }}</b></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeInvoiceSetOffDetailByInvoice();">close</button>
            </div>
        </div>
    </div>
</div>