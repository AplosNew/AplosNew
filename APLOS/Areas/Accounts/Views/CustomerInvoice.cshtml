<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(invoiceId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmotherInvoicePostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="otherInvoicepost(otherinvoiceId,data,otherInvoiceJVlist)"></confirm-archive-generic>