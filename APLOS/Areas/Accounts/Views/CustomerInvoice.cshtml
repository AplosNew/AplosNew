<togglable name="Customer Invoice"></togglable>
<div class="form-horizontal form-elements" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group">
            <label class="col-sm-3 control-label">{{partyType}}<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="PartyName" ng-model="voucher.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" ng-disabled="voucher.IsSplit==true" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearPartyData()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Bill To<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select class="form-control" name="Bill To" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(voucher.PartyPlantId,'billTo')" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(voucher.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Payment Term<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <div class="select-style">
                    <select tabindex="10" required id="paymentTermId" class="form-control" name="Payment Term" ng-model="voucher.PaymentTermId" ng-change="changePaymentTerm(voucher.PaymentTermId);">
                        <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <label class="col-sm-3 control-label">Due Date BaseOn<sup>*</sup></label>
            <div class="col-sm-3 show-message">
                <input type="text" name="BaseOnDueDate" ng-model="voucher.BaseOnDueDate" ng-change="getMatureDate(voucher.BaseOnDueDate,voucher.BaseNoOfDays)" datepicker class="form-control datepicker" tabindex="11" required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">No Of Days</label>
            <div class="col-sm-3 show-message">
                <input id="baseNoOfday" type="number" name="No Of Days" ng-model="voucher.BaseNoOfDays" ng-change="getMatureDate(voucher.BaseOnDueDate, voucher.BaseNoOfDays)" class="form-control" tabindex="12" required>
            </div>
            <label class="col-sm-3 control-label">Mature Date</label>
            <div class="col-sm-3 show-message">
                <input type="text" name="Mature Date" ng-model="voucher.MatureDate" class="form-control" readonly required>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="getFiscalYearPeriod(voucher.PostingDate);checkPostingDate();" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-5 show-message" style="padding-right:0px;">
                <div class="select-style">
                    <select id="currencyId" class="form-control" tabindex="5" name="Currency" ng-model="voucher.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-3 show-message" style="padding-left:0px;">
                <input type="text" maxlength="50" id="Rate" name="Rate" ng-disabled="voucher.CurrencyId==companyCurrencyId" ng-model="voucher.CompanyCurrencyRate" class="form-control text-right" tabindex="5" required autocomplete="off">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" ng-change="changeVoucherType(voucher.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="entity" ng-model="voucher.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" ng-maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoice Amount<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input tabindex="6" ng-model="voucher.Amount" name="Amount"
                       autocomplete="off" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-8 col-md-8">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-10 show-message">
                <textarea rows="1" type="text" ng-maxlength="250" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group">
            <label class="col-sm-4 control-label">Tax Excluding</label>
            <div class="checkbox-site">
                <label class="col-sm-8">
                    <input type="checkbox" id="IsExcludingTax" ng-model="voucher.IsExcludingTax" ng-checked="excludeTaxCalculate()" tabindex="9">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-1 col-md-1">
        <button ng-click="popUp();" class="btn single-btn"><i class="glyphicon glyphicon-plus"></i> Add GL</button>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table" ng-show="voucherDetailList.length" style="padding-top:10px;">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>GL</th>
                    <th>Budget</th>
                    <th>Activity</th>
                    <th>TaxableAmount</th>
                    <th>Total Tax</th>
                    <th>Total Amount</th>
                    <th style="width:130px;">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in voucherDetailList | filter:{TrnType:'Cr'}">
                    <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                    <td>{{x.BudgetCode}} - {{x.BudgetName}}</td>
                    <td>{{x.ActivityCode}} - {{x.ActivityName}}</td>
                    <td id="td_CrAmount_{{$index}}">
                        <div class="show-message">
                            <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" ng-model="x.Amount" tabindex="20"
                                   ng-keyup="calculatebackTax($index);calculateTax(x.Id,$index);checkRowValidation(x, $index)">
                        </div>
                    </td>
                    <td>
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TotalTax" readonly>
                        </div>
                    </td>
                    <td>
                        <div class="show-message">
                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TotalAmount" readonly>
                        </div>
                    </td>
                    <td class="text-right">
                        <button ng-click="getTaxCode($index,x.Id)" class="btn btn-action tooltip-here" data-placement="top" title="Tax">
                            <i>Tax</i>
                        </button>
                        <button ng-click="removeRow($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-right">Total</td>
                    <td class="text-right"><b>{{ (voucherDetailList | filter:{TrnType:'Cr'}) | sumByKey:'Amount'| number:2 }}</b></td>
                    <td class="text-right"><b>{{ (voucherDetailList | filter:{TrnType:'Cr'}) | sumByKey:'TotalTax'| number:2 }}</b></td>
                    <td class="text-right"><b>{{ (voucherDetailList | filter:{TrnType:'Cr'}) | sumByKey:'TotalAmount'| number:2 }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 modal-table">
        <table class="table table-responsive table-striped">
            <caption>Additional Tax</caption>
            <thead>
                <tr>
                    <th>Input Tax</th>
                    <th>Percentage</th>
                    <th>Amount</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td id="td_TaxCode">
                        <div class="select-style show-message">
                            <select name="TaxCodeId" ng-model="advanceTax.TaxCodeId" ng-change="selectadditionalTax(advanceTax.TaxCodeId)" class="col-sm-3 form-control"
                                    ng-options="item.Id as item.UserName for item in taxCodCboListWithhold">
                                <option></option>
                            </select>
                            @*<select ng-model="advanceTax.TaxCodeId" >
                                    <option ng-repeat="option in taxCodCboListWithhold" value="{{option.Id}}">{{option.Text}}</option>
                                </select>*@
                        </div>
                    </td>
                    <td>
                        <div>
                            <input type="text" n-decimals="4" class="form-control text-right" ng-disabled="advanceTax.Type =='FixedPercentage' && advanceTax.ValueOfFixed!=null" ng-model="advanceTax.ValueOfFixed">
                        </div>
                    </td>
                    <td id="td_TaxCodeAmount">
                        <div class="show-message">
                            <input type="text" n-decimals="4" class="form-control text-right" ng-model="advanceTax.TaxAmount" ng-keyup="copyTaxesAmount();">
                        </div>
                    </td>
                    <td class="text-right">
                        <a ng-click="addTax();" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                    </td>
                </tr>
                <tr ng-repeat="x in advanceTaxesList">
                    <td>{{x.TaxName}}</td>
                    <td>{{x.ValueOfFixed}}</td>
                    <td class="text-right">{{x.TaxAmount | number:2 }}</td>
                    <td class="text-right">
                        <button ng-click="removeTaxesRow($index)" data-toggle="modal" ng-disabled="x.AdvanceId" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                    </td>
                </tr>
            </tbody>
            <tfoot ng-show="advanceTaxesList.length">
                <tr>
                    <td colspan="2"><b>Sub Total</b></td>
                    <td class="text-right"><b>{{ advanceTaxesList | sumByKey : 'TaxAmount'| number:2 }}</b></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        <div class="clearfix"></div>
        <div class="form-group" show-errors>
            <label class="col-sm-6 control-label">Total Invoice Amount (Taxable Amount+Tax+Additional Tax)<sup>*</sup></label>
            <div class="col-sm-2 show-message">
                <input type="text" n-decimals="4" name="Total Amount" ng-model="TotalInvoiceAmount" class="form-control" tabindex="4" readonly>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-2 col-md-2">
        <div class="form-group">
            <label class="col-sm-8 control-label">Other Vendor</label>
            <div class="checkbox-site">
                <label class="col-sm-4">
                    <input type="checkbox" id="IsGovtSubsidy" ng-model="otherVoucher.IsGovtSubsidy" tabindex="14">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4" ng-show="otherVoucher.IsGovtSubsidy">
        <div class="form-group">
            <label class="col-sm-3 control-label">Other Vendor</label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="PartyName" ng-model="otherVoucher.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyOtherPopUpNew();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearOtherPartyData()" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Other Bill To<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select class="form-control" name="Other Bill To" ng-model="otherVoucher.PartyPlantId" ng-options="item.Value as item.Text for item in otherPartyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(otherVoucher.PartyPlantId,'billTo')">
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(otherVoucher.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Amount</label>
            <div class="col-sm-8 show-message">
                <input tabindex="6" ng-model="otherVoucher.Amount" name="Amount"
                       autocomplete="off" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right">
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchInvoiceList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>PI No</th>
                    <th>@Library.Model.Parties.PartyType.Customer.ToString()</th>
                    <th>Bill To Address</th>
                    <th>Posting Date</th>
                    <th>Entity</th>
                    <th>Currency</th>
                    <th>Amount</th>
                    <th>Set-off Amount</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in invoiceList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.SalesOrderNo}}</td>
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>{{x.PartyPlantName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.EntityName}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>

                    @*<td class="text-right">{{x.WrittenOffAmount | number:2}}</td>*@
                    <td class="text-right"><ul class="list-inline action-list"><li><a ng-click="getInvoiceSetOffDetailByInvoice(x.Id)" href="">{{x.WrittenOffAmount | number:3}}</a></li></ul></td>

                    <td class="text-right">{{x.Amount-x.WrittenOffAmount | number:2}}</td>
                    <td>{{x.Status}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPosted || x.IsPark"><a ng-click="confirmPost(x.Id);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.OtherIsPark=='OtherInvoiceParked'"><a ng-click="ShowJournalPopUp(x);" href="" class="btn btn-action tooltip-here">Subsidy Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Accounts/Invoice/GetCustomerInvoiceVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Invoice/GetCustomerInvoiceVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                            <li ng-show="x.OtherIsPark=='OtherInvoicePosted'"><a ng-click="OtherInvoiceVouchereReport('Pdf',x.OtherInvoiceVoucherId);" href="" class="btn btn-action tooltip-here">Subsidy Report</a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_TaxCodePopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_PartyOtherPopUpNew.cshtml")
@Html.Partial("~/Areas/Accounts/Views/GLItem/_GLMappingPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_InvoiceSetOffDetailByInvoicePopUp.cshtml")

<div class="modal fade site-modal in" id="JournalPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Journal</div>
            <div class="modal-body">
                <div class="clearfix"></div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Particulars</th>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>Dr</th>
                                <th>Cr</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in newList| orderBy:'Dr'">
                                <td>{{x.Customer}}</td>
                                <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td class="text-right">{{x.Dr | number| setDecimal:4}}</td>
                                <td class="text-right">{{x.Cr | number| setDecimal:4}}</td>
                            </tr>
                            <tr>
                                <td colspan="4"></td>
                                <td class="text-right"><strong>{{newList | sumByKey : 'Dr' | number| setDecimal:4}}</strong></td>
                                <td class="text-right"><strong>{{newList | sumByKey : 'Cr' | number| setDecimal:4}}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="confirmotherInvoicePost(OtherInvoiceJournalId,OtherInvoiceJournal,newList)" title="Post" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Post</button></li>
                        <li><button ng-click="closeJournalPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="confirmDeletePopUp_Remarks" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:600px">
        <div class="modal-content" ng-form name="confirmDeletePopUp_RemarksForm">
            <div class="modal-header">Are you sure to Delete?</div>
            <div class="modal-body">
                <div class="form-group" show-errors>
                    <label class="col-sm-2 control-label">Remarks<sup>*</sup></label>
                    <div class="col-sm-10 show-message">
                        <textarea rows="4" type="text" maxlength="500" name="DeletedRemarks" tabindex="8" class="form-control" ng-model="deletedRemarks" required></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeconfirmDeletePopUp_Remarks()">No</button>
                <button type="button" class="btn btn-default" ng-click="delete(invoiceId,voucherId,deletedRemarks)">Yes</button>
            </div>
        </div>
    </div>
</div>

