<div class="modal fade site-modal in" id="ConvenyenceExpPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="ConvenyenceExpForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Conveyence</h4>
            </div>
            <div class="modal-body ">
                <div class="form-elements form-horizontal">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">From<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" min="1" name="Kilometer" ng-model="convenyenceModel.From" class="form-control" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">To<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Code" maxlength="10" ng-model="convenyenceModel.To" class="form-control" tabindex="2">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label"> Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Invoice Date" ng-model="convenyenceModel.ConvenyenceDate" datepicker class="form-control" tabindex="2">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Transport Type</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="convenyenceModel.TransportType"
                                            ng-options="item.Value as item.Text for item in transportTypeList" name="Fuel Type" tabindex="6">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea type="text" name="remarks" class="form-control" maxlength="250" rows="2" ng-model="convenyenceModel.Remarks" tabindex="4" capitalize></textarea>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeConvenyenceExpPopUp(convenyenceModel)">Done</button>
            </div>
        </div>
    </div>
</div>