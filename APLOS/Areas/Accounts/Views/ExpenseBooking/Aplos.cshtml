<togglable name="Expense Booking"></togglable>
<div class="form-elements form-horizontal" ng-form id="budgetTransactionMaster" name="budgetTransactionMasterForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="EmployeeName" ng-model="budgetTransactionMaster.EmployeeName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="confirmBudget()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearEmployee()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Vendor.ToString()</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="budgetTransactionMaster.PartyName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearPartyPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoicing @Library.Model.Parties.PartyType.Vendor.ToString()</label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <div class="select-style">
                        <select tabindex="1" class="form-control" name="Location" ng-model="budgetTransactionMaster.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }">
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPlantPopUp(budgetTransactionMaster.PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                    </span>
                </div>
            </div>
        </div>
        @*<div class="form-group">
                <label class="col-sm-4 control-label">Approving Authority (additional)</label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="EmployeeName" ng-model="budgetTransactionMaster.ResponsiblePersonName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="showResponsiblePersonListPopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearResponsiblePerson()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>*@
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="entity" ng-model="budgetTransactionMaster.EntityId" tabindex="7" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea type="text" name="remarks" class="form-control" maxlength="250" rows="2" ng-model="budgetTransactionMaster.Remarks" tabindex="4" capitalize></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">CheckedBy<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style" style="font-size:smaller">
                    <select name="activity" id="ResponsiblePersonId" ng-model="budgetTransactionMaster.ResponsiblePersonId" class="form-control"
                            ng-options="item.Id as item.Value for item in checkedByList" tabindex="6"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Transaction Id<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Invoice Number" ng-model="budgetTransactionMaster.InvoiceNumber" class="form-control" maxlength="25" required placeholder="0" tabindex="1">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Beneficiary<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" name="CurrencyTransaction" ng-model="budgetTransactionMaster.BeneficiaryType" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" required tabindex="3">
                        <option ng-repeat="option in beneficiaryTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Invoice Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Invoice Date" ng-model="budgetTransactionMaster.InvoiceDate" datepicker="checkDocDate();" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="CurrencyId" class="form-control" name="Currency" ng-disabled="tranCurrencyList.length == 1" ng-model="budgetTransactionMaster.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" required tabindex="3">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="inputBtnSection common-btn">
                <label class="fileUpload col-sm-4 ">
                    <input id="uploadBtn" type="file" name="file[]" class="upload" />
                    <span class="uploadBtn"><i class="fa fa-paperclip" aria-hidden="true"> Attach</i></span>
                </label>
                <div class="col-sm-8">
                    <input type="text" id="uploadFile" ng-model="budgetTransactionMaster.FileName" name="uploadFile" class="disableInputField form-control" disabled="disabled" style="width: 183px;" />
                </div>
                @*<div class="col-sm-2" style="padding-left:0px;">
                        <button ng-click="DocumentRemove(budgetTransactionMaster.Id);" class="btn" ng-disabled="disableBtn();savedisable" style="height: 31px;width: 88px;padding-left: 8px;background: #242841;"><i class="fa fa-chain-broken" aria-hidden="true"></i> Detach</button>
                    </div>*@
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Expense Head</legend>
            <div class="col-xs-12 col-sm-2 col-md-2">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="GetBudgetMasterList();" class="btn" tabindex="5" ng-hide="companyConfig.IsInboundInvoiceServiceApplicable"><i class="glyphicon glyphicon-plus-sign"></i> Select Budget</button></li>
                        <li><button ng-click="GetBudgetMasterWithServiceMasterList();" class="btn" tabindex="5" ng-hide="companyConfig.IsInboundInvoiceServiceApplicable==false"><i class="glyphicon glyphicon-plus-sign"></i> Select Budget</button></li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Budget Category</label>
                    <div class="col-sm-8">
                        <input type="text" name="BudgetCategory" ng-disabled="true" ng-model="budgetTransactionDetail.BudgetCategory" class="form-control" tabindex="1">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Activity</label>
                    <div class="col-sm-8">
                        <div class="select-style" style="font-size:smaller">
                            <select ng-change="getCboFALinkedList(budgetTransactionDetail.ActivityId)" name="activity" id="activity" ng-model="budgetTransactionDetail.ActivityId" class="form-control"
                                    ng-options="item.ActivityId as item.ActivityName for item in activityList" tabindex="6"></select>
                        </div>
                    </div>
                </div>
                <div class="form-group" ng-show="ActivityType=='FuleExpenses'">
                    <label class="col-sm-4 control-label">Activity Type</label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <input type="text" name="Register" ng-model="ActivityType" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="showFuleExpPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group" ng-show="ActivityType=='Conveyance'">
                    <label class="col-sm-4 control-label">Activity Type</label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <input type="text" name="Register" ng-model="ActivityType" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="showConveyancePopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group">
                    <label class="col-sm-5 control-label">Budget SubCategory</label>
                    <div class="col-sm-7">
                        <input type="text" name="BudgetCategory" ng-disabled="true" ng-model="budgetTransactionDetail.BudgetSubCategory" class="form-control" tabindex="1">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-5 control-label">Service Master</label>
                    <div class="col-sm-7">
                        <input type="text" name="ServiceMaster" ng-disabled="true" ng-model="budgetTransactionDetail.ServiceMaster" class="form-control" tabindex="1">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-5 control-label" ng-show="FALinked=='Item'|| FALinked=='Register'">FA Item</label>
                    <div class="col-sm-7" ng-show="FALinked=='Item'|| FALinked=='Register'">
                        <div class="select-style" style="font-size:smaller">
                            <select name="Phone" id="FixedAssetMaster" ng-model="budgetTransactionDetail.MaterialMasterId" ng-change="changeFAItem();" class="form-control"
                                    ng-options="item.MaterialMasterId as item.StandardName for item in faMasterList" tabindex="7"></select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-3 control-label">Budget</label>
                    <div class="col-sm-9">
                        <input type="text" name="BudgetCategory" ng-disabled="true" ng-model="budgetTransactionDetail.BudgetName" class="form-control" tabindex="1">
                    </div>
                </div>
                <div class="form-group" ng-show="FALinked=='Register'">
                    <label class="col-sm-3 control-label">Register</label>
                    <div class="col-sm-9 show-message">
                        <div class="input-group">
                            <input type="text" name="Register" ng-model="budgetTransactionDetail.SerialNo" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="showRegisterPopUp();" ng-disabled="budgetTransactionDetail.MaterialMasterId==null" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-9 control-label"></label>
                    <div class="col-sm-3">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="addRow();" class="form-control btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i> {{CAction}}</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="table-responsive modal-table voucher-table" ng-show="budgetTransactionDetailList.length">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>FA Item</th>
                        <th>FA Register</th>
                        <th>Type</th>
                        <th>Invoice No</th>
                        <th>Invoice Date</th>
                        <th>Cost Center</th>
                        <th>Amount</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in budgetTransactionDetailList">
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td>{{x.FixedAsset}}</td>
                        <td>{{x.SerialNo}}</td>
                        <td>{{x.ActivityType}}</td>
                        <td id="td_DocRefNo_{{$index}}">
                            <div class="show-message">
                                <input type="text" ng-model="x.DocRefNo" class="form-control" ng-keyup="checkRowValidation(x, $index)">
                            </div>
                        </td>
                        <td id="td_DocDate_{{$index}}">
                            <div class="show-message">
                                <input type="text" ng-model="x.DocDate" class="form-control" datepicker="checkRowValidation(x, $index)">
                            </div>
                        </td>
                        <td>
                            <select class="form-control" ng-model="x.CostCenterId" ng-options="item.Value as item.Text for item in costCenterCboList| filter:{ Value: x.CostCenterId }:true"></select>
                        </td>
                        <td id="td_Amount_{{$index}}">
                            <div class="show-message">
                                <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" ng-model="x.Amount" class="form-control text-right" ng-keyup="checkRowValidation(x, $index);calReDistributedAmount($index,x);">
                            </div>
                        </td>
                        <td class="text-right">
                            <button ng-click="getExpenseDistribute($index,x)" ng-show="x.IsOrderSpecific" ng-disabled="x.Amount == 0 || TotalChargesAmount == 0 " class="btn btn-action tooltip-here" data-placement="top" title="Expense Distribute">
                                <i>Distribute</i>
                            </button>
                            <button ng-click="confirmRemoveRow($index,x)" ng-disabled="x.Id" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
                <tfoot ng-show="budgetTransactionDetailList.length">
                    <tr>
                        <td class="text-right" colspan="8"><b>Sub Total</b></td>
                        <td class="text-right"><b>{{ budgetTransactionDetailList | sumByKey : 'Amount' }}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk" tabindex="29"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="31"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-6 col-sm-6 ">
        <div class="form-group">
            <label class="col-sm-4 control-label">Expense Booking Status</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" submit-required="true" ng-change="getExpensesBooking(budgetTransactionMaster.Status)" ng-model="budgetTransactionMaster.Status" ng-options="item.Value as item.Text for item in approvalStatusList"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Employee</th>
                <th>Beneficiary</th>
                <th>Transaction Id#</th>
                <th>Invoice Date</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in budgetTransactionMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                <td>{{x.EmployeeCode}} - {{x.EmployeeName}}</td>
                <td>{{x.BeneficiaryType}}</td>
                <td>{{x.InvoiceNumber}}</td>
                <td>{{x.InvoiceDate | dateFiltering}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td>{{x.ApprovalStatus}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li><a class="btn btn-action" href="Employees/EmployeeReport/GetExpensesBookingReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&expensesBookingId={{x.Id}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Employees/EmployeeReport/GetExpensesBookingReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&expensesBookingId={{x.Id}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        <li ng-show="x.FileName"><a class="btn btn-action" ng-click="DocDownload(x)" title="Attach File Download" href="{{dwonloadUrl}}" target="_blank"><i class="fa fa-download"></i></a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-archive-generic modalid="confirmSavePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="clearDataOnEmployeeChange()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmgenericPopUp" title="Confirmation" message="Are you sure to delete?" data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="DeleteConfirmationPopUp" title="Confirmation" message={{message_conf}} data-ng-click-right-button="RemoveInvoice()"></confirm-archive-generic>
<confirm-archive-generic modalid="DeleteOutBoundConfirmationPopUp" title="Confirmation" message={{message_conf}} data-ng-click-right-button="RemoveOutBoundInvoice()"></confirm-archive-generic>
<confirm-archive-generic modalid="DeleteMasterOrderConfirmationPopUp" title="Confirmation" message={{message_conf}} data-ng-click-right-button="RemoveMasterOrderInvoice()"></confirm-archive-generic>
<confirm-archive-generic modalid="DeleteContractConfirmationPopUp" title="Confirmation" message={{message_conf}} data-ng-click-right-button="RemoveContractInvoice()"></confirm-archive-generic>
<confirm-modal></confirm-modal>
