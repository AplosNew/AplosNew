<togglable name="Expense Booking Approval"></togglable>
<div class="form-elements form-horizontal" ng-form id="budgetTransactionMaster" name="budgetTransactionMasterForm">
	<div class="col-xs-12 col-sm-6 col-md-6">
		<div class="form-group" show-errors>
			<label class="col-sm-4 control-label">Employee<sup>*</sup></label>
			<div class="col-sm-8 show-message">
				<input type="text" name="EmployeeName" ng-model="budgetTransactionMaster.EmployeeName" class="form-control" readonly required>
			</div>
		</div>
		<div class="form-group" show-errors>
			<label class="col-sm-4 control-label">Transaction Id<sup>*</sup></label>
			<div class="col-sm-8 show-message">
				<input type="text" name="Invoice Number" ng-model="budgetTransactionMaster.InvoiceNumber" class="form-control" required placeholder="0" readonly tabindex="1">
			</div>
		</div>
		<div class="form-group">
			<label class="col-sm-4 control-label">Remarks</label>
			<div class="col-sm-8">
				<textarea class="form-control" rows="2" ng-model="budgetTransactionMaster.Remarks" readonly tabindex="4"></textarea>
			</div>
		</div>
		<div class="form-group" show-errors>
			<label class="col-sm-4 control-label">Beneficiary</label>
			<div class="col-sm-8 show-message">
				<input type="text" name="BeneficiaryType" ng-model="budgetTransactionMaster.BeneficiaryType" class="form-control" readonly>
			</div>
		</div>
		<div class="form-group" ng-show="budgetTransactionMaster.PartyId">
			<label class="col-sm-4 control-label">Vendor</label>
			<div class="col-sm-8">
				<input type="text" name="Invoice Number" ng-model="budgetTransactionMaster.PartyName" readonly class="form-control">
			</div>
		</div>
	</div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Expenses Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="InvoiceDate" ng-model="budgetTransactionMaster.InvoiceDate" datepicker class="form-control" required readonly tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" name="CurrencyTransaction" ng-model="budgetTransactionMaster.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" disabled tabindex="3">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Approval Status</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ApprovalStatus" ng-model="budgetTransactionMaster.ApprovalStatus" class="form-control" readonly required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Checked By</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ResponsiblePersonName" ng-model="budgetTransactionMaster.ResponsiblePersonName" class="form-control" readonly>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">File Name</label>
            <div class="col-sm-8">
                <a href="" target="_blank">
                    <span style="color:red;padding:4px;">  </span>
                    <span style="height:20px;width:20px;color:blue;" ng-click="FileDownload(budgetTransactionMaster)">
                        {{budgetTransactionMaster.FileName}}
                    </span>
                </a>
            </div>
        </div>
    </div>
	<div class="clearfix"></div>
	<div class="col-xs-12">
		<div class="table-responsive modal-table voucher-table" ng-show="budgetTransactionDetailList.length">
			<table class="table table-striped table-bordered">
				<thead>
					<tr>
						<th>Budget</th>
						<th>Activity</th>
						<th>Invoice No</th>
						<th>Invoice Date</th>
                        <th>Cost Center</th>
						<th>Amount</th>
					</tr>
				</thead>
				<tbody>
                    <tr ng-repeat="x in budgetTransactionDetailList">
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td>
                            <input type="text" ng-model="x.DocRefNo" class="form-control">
                        </td>
                        <td>
                            <input type="text" ng-model="x.DocDate" datepicker class="form-control">
                        </td>
                        <td>
                            <select class="form-control" ng-model="x.CostCenterId" ng-options="item.Value as item.Text for item in costCenterCboList| filter:{ Value: x.CostCenterId }:true"></select>
                        </td>
                        <td>
                            <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" ng-model="x.Amount" class="form-control text-right">
                        </td>
                    </tr>
				</tbody>
				<tfoot ng-show="budgetTransactionDetailList.length">
					<tr>
						<td class="text-right" colspan="4"><b>Sub Total</b></td>
						<td class="text-right"><b>{{ budgetTransactionDetailList | sumByKey : 'Amount' }}</b></td>
					</tr>
				</tfoot>
			</table>
		</div>
	</div>
	<div class="common-btn">
		<ul class="list-inline text-right">
			<li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk" tabindex="29"></i> {{Action}}</button></li>
			<li><button ng-click="Hold();" ng-disabled="HActionDisable" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk" tabindex="29"></i> {{HAction}}</button></li>
			<li><button ng-click="Reject();" ng-disabled="RActionDisable" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk" tabindex="29"></i> {{RAction}}</button></li>
			<li><button ng-click="Clear();" class="btn" tabindex="31"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
		</ul>
	</div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
	<div class="aplos-grid-toggle">
		<div class="tab-design" id="tab_show">
			<div class="site-tab">
				<ul class="nav nav-tabs" role="tablist">
					<li role="presentation" ng-class="{ active: isSetApprovalList(1) }"><a ng-click="setTabApprovalList(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Approval List</a></li>
					<li role="presentation" ng-class="{ active: isSetApproved(2) }"><a ng-click="setTabApproved(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Approved</a></li>
					<li role="presentation" ng-class="{ active: isSetApprovedHold(3) }"><a ng-click="setTabApprovedHold(3)" href="" aria-controls="address" role="tab" data-toggle="tab">Approved Hold/Reject</a></li>
				</ul>
			</div>


			<div class="tab-content">
				<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetApprovalList(1), active: isSetApprovalList(1) }">
					<fieldset class="scheduler-border">
						<legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
						<div>
                            <div class="content-container-fluid" style="color:black;">
                                <div style="color:black;" id="BookingGridId1" ej-grid e-datasource="bookingApprovalList"
                                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                                     e-recorddoubleclick="Get" e-filtersettings-filterType="excel"
                                     e-enabletouch="true" e-allowselection="true"
                                     e-scrollsettings="scroll">
                                    <div e-columns>
                                        <div e-column e-field="InvoiceNumber" e-headertext="Transaction Id" e-width="100"></div>
                                        <div e-column e-field="BeneficiaryType" e-headertext="Beneficiary" e-width="80"></div>
                                        <div e-column e-field="InvoiceDate" e-headertext="Invoice Date" e-width="80"></div>
                                        <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="80"></div>
                                        <div e-column e-field="Amount" e-headertext="Amount" textAlign='Right' e-width="80"></div>
                                        <div e-column e-field="ApprovalStatus" e-headertext="Status" e-width="60"></div>
                                        <div e-column e-type="text" e-template="#file" e-headertext="File" e-width="80"></div>
                                        <div e-column e-field="AddedByName" e-headertext="Prepared By" e-width="80"></div>
                                        <div e-column e-field="ResponsiblePersonName" e-headertext="Checked By" e-width="80"></div>
                                        @*<div e-column e-headertext="PDF" e-commands="PdfPrint" e-isunbound=true e-textalign="center" e-width="50"></div>
                <div e-column e-headertext="Excel" e-commands="ExcelPrint" e-isunbound=true e-textalign="center" e-width="50"></div>*@
                                    </div>

                                </div>
                                <script type="text/template" id="file">
                                    <div class="text-right" style="width:100%">
                                        <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.FileDownload(data);">{{data.FileName}}</a>
                                    </div>
                                </script>
                            </div>
						</div>
					</fieldset>
				</div>


				<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetApproved(2), active: isSetApproved(2) }">
					<fieldset class="scheduler-border">
						<legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Approved Data</span></legend>
                        <div>
                            <div class="content-container-fluid" style="color:black;">
                                <div style="color:black;" id="BookingGridId2" ej-grid e-datasource="bookingApprovedList"
                                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                                     e-recorddoubleclick="Get" e-filtersettings-filterType="excel"
                                     e-enabletouch="true" e-allowselection="true"
                                     e-scrollsettings="scroll">
                                        <div e-columns>
                                            <div e-column e-field="InvoiceNumber" e-headertext="Transaction Id" e-width="120"></div>
                                            <div e-column e-field="BeneficiaryType" e-headertext="Beneficiary" e-width="50"></div>
                                            <div e-column e-field="InvoiceDate" e-headertext="Invoice Date" e-width="60"></div>
                                            <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                            <div e-column e-field="Amount" e-headertext="Amount" textAlign='Right' e-width="80"></div>
                                            <div e-column e-field="ApprovalStatus" e-headertext="Status" e-width="60"></div>
                                            <div e-column e-field="AddedByName" e-headertext="Prepared By" e-width="90"></div>
                                            <div e-column e-field="ResponsiblePersonName" e-headertext="Checked By" e-width="90"></div>
                                            <div e-column e-field="ParkedPosted" e-headertext="Parked/Posted" e-width="90"></div>
                                            <div e-column e-type="text" e-template="#file" e-headertext="File" e-width="80"></div>
                                            <div e-column e-headertext="PDF" e-commands="PdfPrintChecked" e-isunbound=true e-textalign="center" e-width="50"></div>
                                            <div e-column e-headertext="Excel" e-commands="ExcelPrintChecked" e-isunbound=true e-textalign="center" e-width="50"></div>
                                        </div>

                                    </div>
                                    <script type="text/template" id="file">
                                        <div class="text-right" style="width:100%">
                                            <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.FileDownload(data);">{{data.FileName}}</a>
                                        </div>
                                    </script>
                                </div>
                            <i>**Showing top 300   order by Entry Date Desc</i>
                        </div>
					</fieldset>
				</div>
				<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetApprovedHold(3), active: isSetApprovedHold(3) }">
					<fieldset class="scheduler-border">
						<legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Approved Hold Data</span></legend>
						<div>
							<div class="content-container-fluid" style="color:black;">
								<div style="color:black;" id="GridApprovedHoldId" ej-grid e-datasource="bookingApprovedHoldRejectList"
									 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
									 e-recorddoubleclick="Get" e-filtersettings-filterType="excel"
									 e-enabletouch="true" e-allowselection="true"
									 e-scrollsettings="scroll">
									<div e-columns>
										<div e-column e-field="InvoiceNumber" e-headertext="Transaction Id" e-width="100"></div>
										<div e-column e-field="BeneficiaryType" e-headertext="Beneficiary" e-width="80"></div>
										<div e-column e-field="InvoiceDate" e-headertext="Invoice Date" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
										<div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="80"></div>
										<div e-column e-field="Amount" e-headertext="Amount" textAlign='Right' e-width="80"></div>
										<div e-column e-field="ApprovalStatus" e-headertext="Status" e-width="60"></div>
										<div e-column e-field="AddedByName" e-headertext="Prepared By" e-width="80"></div>
										<div e-column e-field="ResponsiblePersonName" e-headertext="Checked By" e-width="80"></div>
										@*<div e-column e-headertext="PDF" e-commands="PdfPrintApprovedHold" e-isunbound=true e-textalign="center" e-width="50"></div>
											<div e-column e-headertext="Excel" e-commands="ExcelPrintApprovedHold" e-isunbound=true e-textalign="center" e-width="50"></div>*@
									</div>

								</div>

							</div>
						</div>
					</fieldset>
				</div>
			</div>
		</div>
	</div>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/ExpenseBooking/_BudgetMasterPopUp.cshtml")