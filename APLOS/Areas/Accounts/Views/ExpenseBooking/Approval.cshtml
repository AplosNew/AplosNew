<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Expense Booking Posting</h3>
<div class="row text-right">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Employee</th>
                <th>Beneficiary</th>
                <th>Invoice Number</th>
                <th>Invoice Date</th>
                <th>Checked By</th>
                <th>Approved By</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in budgetTransactionMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                <td>{{x.EmployeeCode}} - {{x.EmployeeName}} </td>
                <td>{{x.BeneficiaryType}}</td>
                <td>{{x.InvoiceNumber}}</td>
                <td>{{x.InvoiceDate | dateFiltering}}</td>
                <td>{{x.CheckedBy}}</td>
                <td>{{x.ApproverCode}} - {{x.ApprovedBy}}</td>
                <td>{{x.CurrencyName}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td>{{x.ApprovalStatus}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.FileName"><a class="btn btn-action" ng-click="DocDownload(x)" title="Attach File Download" href="{{dwonloadUrl}}" target="_blank"><i class="fa fa-download"></i></a></li>
                        <li><a href="{{bootPoint}}expense-booking-approved/{{x.Id}}" class="btn btn-action">View & Post</a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>

    @*Expense Booking Report*@
    <div class="modal-footer common-btn">
        @*TODO:*@
        <button type="button" class="btn btn-default" ng-click="ExpenseBookingApprovalList();">Report</button>

    </div>

</div>