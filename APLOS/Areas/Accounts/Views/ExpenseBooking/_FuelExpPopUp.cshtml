<div class="modal fade site-modal in" id="fuelExpPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="fuelExpForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Fuel Expenses</h4>
            </div>
            <div class="modal-body ">
                <div class="form-elements form-horizontal">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Kilometer<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" min="1" name="Kilometer" ng-model="fuelModel.Kilometer" class="form-control" placeholder="0" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Fuel Type</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="fuelModel.FuelType"
                                            ng-options="item.Value as item.Text for item in fuleTypeList" name="Fuel Type" tabindex="6">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Qty in Liter<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Code" maxlength="10" ng-model="fuelModel.QtyinLiter" class="form-control" tabindex="2">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Bill No<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Code" maxlength="20" ng-model="fuelModel.BillNo" class="form-control" tabindex="2">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea type="text" name="remarks" class="form-control" maxlength="250" rows="2" ng-model="fuelModel.Remarks" tabindex="4" capitalize></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closefuelExpPopUp()">Done</button>
            </div>
        </div>
    </div>
</div>