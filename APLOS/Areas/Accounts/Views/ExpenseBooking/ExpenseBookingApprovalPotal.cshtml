<togglable name="Expense Booking Approval"></togglable>
<div class="form-elements form-horizontal" ng-form id="budgetTransactionMaster" name="budgetTransactionMasterForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="EmployeeName" ng-model="budgetTransactionMaster.EmployeeName" class="form-control" readonly required>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Transaction Id<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Invoice Number" ng-model="budgetTransactionMaster.InvoiceNumber" class="form-control" required placeholder="0" readonly tabindex="1">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="2" ng-model="budgetTransactionMaster.Remarks" readonly tabindex="4" capitalize></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Expenses Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="InvoiceDate" ng-model="budgetTransactionMaster.InvoiceDate" datepicker class="form-control" required readonly tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="currencyTransactionId" class="form-control" name="CurrencyTransaction" ng-model="budgetTransactionMaster.CurrencyId" ng-change="GetCurrencyExchangeRateList();checkBankAmount();" tabindex="3">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12">
        <div class="table-responsive modal-table voucher-table" ng-show="budgetTransactionDetailList.length">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>Invoice No</th>
                        <th>Invoice Date</th>
                        <th>Amount</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in budgetTransactionDetailList">
                        <td>{{x.BudgetName}}</td>
                        <td>{{x.ActivityName}}</td>
                        <td>
                            <input type="text" ng-model="x.DocRefNo" class="form-control">
                        </td>
                        <td>
                            <input type="text" ng-model="x.DocDate" datepicker class="form-control">
                        </td>
                        <td>
                            <input type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" ng-model="x.Amount" class="form-control text-right">
                        </td>
                        <td class="text-right">
                            <button ng-click="passValue(x.Id, $index)" data-toggle="modal" data-target="#confirmgenericPopUp" class="btn-action tooltip-here"
                                    data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
                <tfoot ng-show="budgetTransactionDetailList.length">
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td><b>Sub Total</b></td>
                        <td class="text-right"><b>{{ budgetTransactionDetailList | sumByKey : 'Amount' }}</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk" tabindex="29"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="30"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="31"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Employee</th>
                <th>Beneficiary</th>
                <th>Transaction Id#</th>
                <th>Invoice Date</th>
                <th>Currency</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in budgetTransactionMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                <td>{{x.EmployeeName}}</td>
                <td>{{x.BeneficiaryType}}</td>
                <td>{{x.InvoiceNumber}}</td>
                <td>{{x.InvoiceDate | dateFiltering}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td>{{x.ApprovalStatus}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-archive-generic modalid="confirmgenericPopUp" title="Confirmation" message="Are you sure to delete?" data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/ExpenseBooking/_BudgetMasterPopUp.cshtml")