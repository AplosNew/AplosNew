<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Expenses Booking Posted List</h3>
<div class="row text-right">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Employee</th>
                <th>Beneficiary</th>
                <th>Invoice Number</th>
                <th>Posting Date</th>
                <th>Invoice Date</th>
                <th>Checked By</th>
                <th>Approved By</th>
                <th>Currency</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in budgetTransactionMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x);">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.EmployeeCode}} - {{x.EmployeeName}}</td>
                <td>{{x.BeneficiaryType}}</td>
                <td>{{x.InvoiceNumber}}</td>
                <td>{{x.PostingDate | dateFiltering}}</td>
                <td>{{x.InvoiceDate | dateFiltering}}</td>
                <td>{{x.CheckedBy}}</td>
                <td>{{x.ApproverCode}} - {{x.ApprovedBy}}</td>
                <td>{{x.CurrencyCode}}</td>
                <td class="text-right">{{x.Amount | number:2}}</td>
                <td>{{x.Post}}</td>
                <td class="text-right">
                    <ul class="list-inline action-list">
                        <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                        <li><a class="btn btn-action" href="Employees/EmployeeReport/GetEmployeePayableExpenseReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                        <li><a class="btn btn-action" href="Employees/EmployeeReport/GetEmployeePayableExpenseReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="delete(employeeBookingId,voucherId)"></confirm-archive-generic>
