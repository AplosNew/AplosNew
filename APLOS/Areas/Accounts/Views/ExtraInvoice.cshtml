<togglable name="Inbound Invoice Interface"></togglable>
<div class="form-elements" ng-form id="voucher" name="invoiceForm">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Basic Data</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Payment Term</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="address" role="tab" data-toggle="tab">Split Invoice</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Voucher Type</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="vouchertypeId" class="form-control" name="vouchertype" ng-model="voucher.VoucherTypeId" ng-change="onVoucherTypeChange(voucher.VoucherTypeId);getVoucherTypeValueText()" required>
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Voucher Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control datepicker" tabindex="1" ng-change="checkVoucherDate()" required>
                            <p ng-show="VoucherDateMessage" class="show-message">{{VoucherDateMessage}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Posting Date</label>
                        <div class="col-sm-8">
                            <input id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" datepicker class="form-control datepicker" tabindex="3" ng-change="getFiscalYear(voucher.PostingDate);checkPostingDate()">
                            <p ng-show="postingDateMessage" class="show-message">{{postingDateMessage}}</p>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Doc Ref</label>
                        <div class="col-sm-8 show-message">
                            <input type="text" maxlength="50" name="DocRefNo" ng-model="voucher.DocRefNo" class="form-control" tabindex="5" ng-blur="getRefCode(voucher.DocRefNo)" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Vendor</label>
                        <div class="col-sm-8">
                            <button class="btn single-btn" ng-click="getVendorGL()" tabindex="5">Vendor</button>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Amount</label>
                        <div class="col-sm-8 show-message">
                            <input id="CrAmount" type="number" name="Amount" ng-model="voucherInvoice.Amount" class="form-control " tabindex="2">
                            <span class="msg-error" ng-show="invoiceForm.Amount.$error.number">
                                Not valid number!
                            </span>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Narration</label>
                        <div class="col-sm-8 show-message">
                            <textarea type="text" name="Narration" class="form-control" ng-model="voucher.Narration" ng-blur="passNarration(voucher.Narration)" required capitalize></textarea>
                        </div>
                    </div>
                    @*<div class="form-group">
                            <label class="col-sm-4 control-label">Tax</label>

                            <div class="col-sm-8">
                                <button class="btn single-btn" ng-disabled="enabletax()" ng-click="getTaxCode($index)" title="Add Tex">Tax</button>
                            </div>
                        </div>*@
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Currency</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="currencyTransactionId" class="form-control" name="Currency" ng-model="voucher.CurrencyId" ng-change="getCurrencyText()" required>
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Doc Date</label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker class="form-control datepicker" tabindex="2" ng-change="checkDate();getDocDate(voucher.DocDate)" required>
                            <p ng-show="dateMessage" class="show-message">{{dateMessage}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Fiscal Year</label>
                        <div class="col-sm-3">
                            <input id="fiscalYearId" type="text" name="Fiscal Year" readonly ng-model="voucher.FiscalYear" class="form-control">
                        </div>
                        <label class="col-sm-2 control-label">Period</label>
                        <div class="col-sm-3">
                            <input id="fiscalYearPeriod" type="text" name="Period" readonly ng-model="voucher.FiscalYearPeriod" class="form-control">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"> InvoiceIsExcludingTax</label>
                        <div class="checkbox-site">
                            <label class="col-sm-8">
                                <input type="checkbox" id="IsExcludingTax" ng-model="voucher.IsExcludingTax" tabindex="5">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group" show-errors style="border:1px solid #ddd; padding:5px">
                        <p>Vendor Name : {{ getGLCrCodeByPartyCode.Party}}</p>
                        <p>Vendor Code : {{ getGLCrCodeByPartyCode.Code}}</p>
                        <p>GLItem : {{ getGLCrCodeByPartyCode.GLItem}}</p>
                        <p>GLItem Code : {{ getGLCrCodeByPartyCode.COAICode}} <button class="btn single-btn" ng-click="getGlByParty(getGLCrCodeByPartyCode.PartyId)" tabindex="5">GL</button></p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-12 form-horizontal">
                    </div>
                </div>
                <br />
                <div class="table-responsive modal-table relation-table search-table">
                    <table class="table table-striped">
                        <tbody>
                            <tr>
                                <td>
                                    <button class="btn single-btn" ng-click="GetCOAICodeList()" tabindex="5">GL</button>
                                </td>
                                <td><input type="text" class="form-control" placeholder="Budget"></td>
                                <td><input type="text" class="form-control" placeholder="BudgetActivity"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="table-responsive modal-table voucher-table">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Edit</th>
                                <th>Delete</th>
                                <th>GL Code</th>
                                <th>GL</th>
                                <th>Doc Ref</th>
                                <th>Doc Date</th>
                                <th>Budget  Year</th>
                                <th>Budget Period</th>
                                <th>Amount</th>
                                <th class="text-right"><i class="glyphicon glyphicon-trash"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><i class="glyphicon glyphicon-pencil"></i></td>
                                <td><i class="glyphicon glyphicon-remove"></i></td>
                                <td>
                                    <input type="text" class="form-control" ng-model="voucherDetail.COAICode" ng-keypress="getAccountCodeby($event,voucherDetail.COAICode)" />
                                </td>
                                <td><input type="text" class="form-control" ng-model="voucherDetail.COAIText" readonly> </td>
                                <td><input type="text" class="form-control" ng-model="voucherDetail.DocRefNo" placeholder="Doc Ref"></td>
                                <td>

                                    <input type="text" name="DocDate" ng-model="voucherDetail.DocDate" datepicker class="form-control datepicker" tabindex="3" ng-change="checkVDockDate()">
                                </td>
                                <td>
                                    <div class="select-style" style="font-size:smaller">
                                        <select name="FiscalYear" id="FiscalYear" ng-model="voucherDetail.FiscalYear" class="col-sm-3 form-control" style="width: 100px"
                                                ng-options="item.Value as item.Text for item in fiscalYearList" ng-change="onFiscalYearChange(voucherDetail.FiscalYear)"></select>
                                    </div>
                                </td>
                                <td>
                                    <div class="select-style" style="font-size:smaller">
                                        <select name="FiscalYearPeriod" id="FiscalYearPeriod" ng-model="voucherDetail.FiscalYearPeriod" class="col-sm-3 form-control" style="width: 105px"
                                                ng-options="item.Value as item.Text for item in fiscalyearperiodbyidlist"></select>
                                    </div>
                                </td>

                                <td>
                                    <input type="number" class="form-control" ng-model="voucherDetail.DrAmount">
                                    <span class="msg-error" ng-show="invoiceForm.DrAmount.$error.number">
                                        Not valid number!
                                    </span>
                                </td>
                                <td class="text-right">
                                    <button class="btn single-btn" ng-click="addRow()" tabindex="10">{{CAction}}</button>
                                </td>
                            </tr>
                            <tr ng-repeat="x in voucherDetailrow">
                                <td class="table-td">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="GetVoucherDetailrow(x,x.Id, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                <i class="glyphicon glyphicon-pencil"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                                <td class="table-td">
                                    <button ng-click="valuePassInDelModal(x.Id, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                        <i class="glyphicon glyphicon-remove"></i>
                                    </button>
                                </td>
                                <td>{{x.COAICode}}</td>
                                <td>{{x.COAIText}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>
                                    {{x.DocDate}}
                                </td>
                                <td>
                                    {{x.FiscalYearText}}
                                </td>
                                <td>
                                    {{x.FiscalYearPeriodText}}
                                </td>
                                <td class="text-right">{{x.DrAmount}}</td>
                                <td class="text-right table-td">
                                    <button class="btn single-btn" ng-click="getTaxCode(x.Id)" tabindex="10" ng-disabled="x.PostingWithoutTaxAllow">Tax</button>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="8" class="text-right"><strong>Total Amount</strong></td>
                                <td class="text-right" id="ToatalDr">{{Drtotal}}</td>
                                <td class="text-right">Balance {{balanceText}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Payment Term</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="paymentTermId" class="form-control" name="Payment Term" ng-model="paymentTerms.PaymentTermId"
                                            ng-change="onPaymnetChange(paymentTerms.PaymentTermId);" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Base On Due Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="BaseOnDueDate" ng-model="paymentTerms.BaseOnDueDate" datepicker class="form-control datepicker" tabindex="1" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">No Of Days</label>
                            <div class="col-sm-8 show-message">
                                <input id="baseNoOfday" type="number" name="baseNoOfday" ng-model="paymentTerms.BaseNoOfDays" ng-blur="getMatureDate(paymentTerms.BaseOnDueDate,paymentTerms.BaseNoOfDays)" class="form-control " tabindex="2">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Due Date</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="BaseOnDueDate" ng-model="getM" class="form-control" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Payment Term  Code</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="BaseOnDueDate" ng-model="paymentTerms.PaymentTermCode" class="form-control" readonly>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Voucher Type</label>
                            <div class="col-sm-8">
                                <input type="text" value="{{VoucherTypeValueText}}" class="form-control" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Amount</label>
                            <div class="col-sm-8">
                                <input id="CrAmount" type="number" name="CrAmount" ng-model="voucherInvoice.Amount" class="form-control " tabindex="2" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Currency</label>
                            <div class="col-sm-8">
                                <input type="text" value="{{CurrencyText}}" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="col-xs-12  form-horizontal">
                        <div class="table-responsive modal-table relation-table search-table">
                            <table class="table table-striped">
                                <tbody>
                                    <tr>
                                        <td>
                                            <button class="btn single-btn" ng-click="getGlByPartyForSplit(getGLCrCodeByPartyCode.PartyId)" tabindex="5" ng-disabled="getGLCrCodeByPartyCode.COAICode==null||getGLCrCodeByPartyCode.COAICode==''">GL</button>
                                        </td>
                                        <td><input type="text" class="form-control" placeholder="Budget"></td>
                                        <td><input type="text" class="form-control" placeholder="BudgetActivity"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="table-responsive modal-table voucher-table">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>GL Code</th>
                                        <th>GL</th>
                                        <th>Doc Ref</th>
                                        <th>Doc Date</th>
                                        <th>Budget  Year</th>
                                        <th>Budget Period</th>
                                        <th>Amount</th>
                                        <th class="text-right"><i class="glyphicon glyphicon-trash"></i></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <input type="text" class="form-control" ng-model="voucherInvoiceSplit.COAICode" ng-keypress="getAccountCodeby($event,voucherDetail.COAICode)" />
                                        </td>
                                        <td><input type="text" class="form-control" ng-model="voucherInvoiceSplit.COAIText" readonly> </td>
                                        <td><input type="text" class="form-control" ng-model="voucherInvoiceSplit.DocRefNo" placeholder="Doc Ref"></td>
                                        <td>
                                            <input type="text" name="DocDate" ng-model="voucherInvoiceSplit.DocDate" datepicker class="form-control datepicker" tabindex="3" ng-change="checkVDockDate()">
                                        </td>
                                        <td>
                                            <div class="select-style" style="font-size:smaller">
                                                <select name="FiscalYear" id="FiscalYear" ng-model="voucherInvoiceSplit.FiscalYear" class="col-sm-3 form-control" style="width: 100px"
                                                        ng-options="item.Value as item.Text for item in fiscalYearList" ng-change="onFiscalYearChange(voucherDetail.FiscalYear)"></select>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="select-style" style="font-size:smaller">
                                                <select name="FiscalYearPeriod" id="FiscalYearPeriod" ng-model="voucherInvoiceSplit.FiscalYearPeriod" class="col-sm-3 form-control" style="width: 105px"
                                                        ng-options="item.Value as item.Text for item in fiscalyearperiodbyidlist"></select>
                                            </div>
                                        </td>
                                        <td><input type="number" class="form-control" ng-model="voucherInvoiceSplit.Amount"></td>
                                        <td class="text-right">
                                            <button class="btn single-btn" ng-click="addCrRow()" tabindex="10">{{CAIction}}</button>
                                        </td>
                                    </tr>
                                    <tr ng-repeat="x in voucherDetailInvoiceSplitRow" ng-click="GetVoucherDetailInvoiceRow(x,x.Id, $index)">
                                        <td>{{x.COAICode}}</td>
                                        <td>{{x.COAIText}}</td>
                                        <td>{{x.DocRefNo}}</td>
                                        <td>
                                            {{x.DocDate}}
                                        </td>
                                        <td>{{x.FiscalYear}}</td>
                                        <td>{{x.FiscalYearPeriod}}</td>
                                        <td class="text-right">{{x.Amount}}</td>
                                        <td class="text-right">
                                            <button ng-click="passValue(x.Id, $index)" data-toggle="modal" data-target="#archivePopUp" class="btn-action tooltip-here"
                                                    data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="text-right"><strong>Total Amount</strong></td>
                                        <td class="text-right" id="ToatalDr">{{SplitAmount}}</td>
                                        <td class="text-right">Balance {{balanceText}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 form-horizontal">
                    <div class="form-group">
                        <div class="col-sm-10">
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                    @*<li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-trash"></i> Clear</button></li>*@
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #region ****************Grid************** -->
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchVendorInvoiceList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>VoucherNo</th>
                <th>Voucher Type</th>
                <th>Doc Date</th>
                <th>Doc Ref No</th>
                <th>Posting Date</th>
                <th>Vendor</th>
                <th>Currency</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in vendorinvoices |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.VendorInvoiceId, $index);">
                <td>{{x.VoucherNo}}</td>
                <td>{{x.VoucherType}}</td>
                <td>{{x.DocDate}}</td>
                <td>{{x.DocRefNo}}</td>
                <td>{{x.PostingDate}}</td>
                <td>{{x.Party}}</td>
                <td>{{x.Currency}}</td>
                <td>{{x.Amount}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<div class="modal fade site-modal in" id="GLPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeCOAICodeListPopUp()">&times;</button>
                <h4 class="modal-title">GL</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="glListParameters.searchBy">
                                            <option ng-repeat="option in searchglByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="glListParameters.search" ng-enter="GetCOAICodeListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetCOAICodeListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Account Group</th>
                                <th>GL Code</th>
                                <th>GL</th>
                                <th>TaxAllow</th>
                            </tr>
