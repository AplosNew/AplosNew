<togglable name="Tax Payment"></togglable>
<div class="form-elements form-horizontal" ng-form id="form1" name="form1">
    <div class="col-xs-12 col-sm-4 col-md-4 ">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Country<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Country" submit-required="true" ng-model="voucher.CountryId" required
                            ng-change="GetTaxCategory(voucher.CountryId);" ng-options="item.Value as item.Text for item in countryList">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Party Type<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input type="radio" ng-change="changePartyType()" name="source" ng-model="voucher.PartyType" value="Vendor">
                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>Vendor
                </label>
                <label>
                    <input type="radio" ng-change="changePartyType()" name="source" ng-model="voucher.PartyType" value="Customer">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>Customer
                </label>

            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Tax Category</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Tax Category" id="taxCategoryId" ng-model="voucher.TaxCategoryId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in TaxCategoryList" tabindex="2" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors id="div_FromDate">
            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="From Date" ng-model="voucher.FromDate" datepicker class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors id="div_ToDate">
            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="To Date" ng-model="voucher.ToDate" datepicker class="form-control" required tabindex="6">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 ">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="VoucherDate" ng-model="voucher.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">{{voucher.PartyType}}<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="voucher.PartyName" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="showPartyPop();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">{{voucher.PartyType}}<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select tabindex="4" class="form-control" name="Invoicing @Library.Model.Parties.PartyType.Vendor.ToString()" ng-model="voucher.PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(voucher.InvoicingPartyPlantId,'billTo')" required>
                            <option value=""></option>
                        </select>
                    </div>
            </div>
        </div>*@
        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input required datepicker="checkPostingDate();getFiscalYearPeriod(voucher.PostingDate);" ng-disabled="voucherDetailList.length" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="DocDate" ng-model="voucher.DocDate" datepicker="checkDocDate();" required class="form-control" tabindex="3">
            </div>
        </div>
        @*<div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Bank" class="form-control" ng-model="voucher.BankMasterId" ng-options="item.Id as item.AccountTitle for item in bankMasterList" required ng-change="onBankChange(voucher.BankMasterId)">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>*@
        <div class="form-group" show-errors id="div_Bank">
            <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="AccountTitle" ng-model="voucher.AccountTitle" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{report.AccountTitle}}" tooltip>
                    <span class="input-group-btn">
                        <button ng-click="showBankPopUp(voucher.EntityId);" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 ">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="voucher.VoucherTypeId" tabindex="2" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher.DocRefNo" class="form-control" tabindex="4" autocomplete="off" capitalize required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea rows="3" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="col-xs-12 col-sm-2 col-md-2">
            <button class="btn single-btn " ng-click="getTaxPayable()" tabindex="10">Get Tax Payable</button>
            <br />
        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal">
            <div class="table-responsive modal-table" ng-show="voucherDetailList.length">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>GL</th>
                            <th>Voucher No</th>
                            <th>DocDate</th>
                            <th>Doc Ref No</th>
                            <th>Currency</th>
                            <th>Payable</th>
                            <th>Payment</th>
                            <th>Balance</th>
                            <th>Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in voucherDetailList">
                            <td>{{x.GLGeneralInfoName}} - {{x.ActivityName}}</td>
                            <td>{{x.VoucherNo}}</td>
                            <td>{{x.DocDate |dateFiltering}}</td>
                            <td>{{x.DocRefNo}}</td>
                            <td>{{x.CurrencyCode}}</td>
                            <td>{{x.Payable}}</td>
                            <td>{{x.Payment}}</td>
                            <td>{{x.Balance}}</td>
                            <td>
                                <input ng-keyup="convertAmount(x)" type="text" n-decimals="2" title="Text, Comma, +, -, Two Dot is not allow" class="form-control text-right" name="Amount" ng-model="x.Amount">
                            </td>
                            <td class="text-right">
                                <button ng-click="removeRow($index,x)" data-toggle="modal" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="8"></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchByPostedTaxPayment">
                                <option ng-repeat="option in searchByPostedTaxPaymentList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="searchTaxPayment" ng-enter="getDataList();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content-container-fluid" style="color:black;">
        <div style="color:black;" id="GridPrint" ej-grid e-datasource="taxpayments" e-allowfiltering="true" e-allowpaging="true"
             e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
             e-actioncomplete="actionCompleteSelected" e-allowscrolling="true" e-showstackedheader="true">
            <div e-columns>
                <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-width="100"></div>
                <div e-column e-field="PostingDate" e-headertext="PostingDate" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="DocDate" e-headertext="Doc Ref Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                <div e-column e-field="Amount" e-headertext=" Amount" e-width="100" textAlign='Right'></div>
                @*<div e-column e-headertext="AdditionalTax" e-template="#AdditionalTaxTemplate" e-width="100"></div>


                <div e-column e-headertext="PDF" e-commands="commandPDF" e-isunbound=true e-textalign="center" e-width="60"></div>
                <div e-column e-headertext="Excel" e-commands="commandExcel" e-isunbound=true e-textalign="left" e-width="60"></div>
                <div e-column e-headertext="GRN" e-commands="commandGRN" e-isunbound=true e-textalign="left" e-width="60"></div>*@

            </div>


        </div>

        @*<script id="AdditionalTaxTemplate" type="text/template">
            <ul class="common-btn list-inline text-right">
                <li> <button type="button" class="btn" ng-disabled="data.AdditionalTaxId==null" ng-click="$parent.onClickadditionalTaxPop(data);">TDS Post</button></li>
            </ul>

        </script>*@
    </div>
    <i>**Showing top 300 Posted GRN  order by PostingDate</i>
</div>
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")
@Html.Partial("~/Areas/Banks/Views/_BankPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/InvoiceTax/_InvoiceTaxPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/_VendorAdvancePopUp.cshtml")
@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")