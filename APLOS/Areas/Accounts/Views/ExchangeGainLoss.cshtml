<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Exchange Gain Loss GL</h3>
<div class="clearfix"></div>
<div class="form-elements form-horizontal" ng-form id="exchangegainloss" name="exchangeGainLossForm">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group">
            <label class="col-sm-3 col-md-2 control-label">COA<sup>*</sup></label>
            <div class="col-sm-3 col-md-4 show-message">
                <div class="select-style">
                    <select ng-model="COAId" class="col-sm-3 form-control" id="COAId" name="COA" ng-options="item.Value as item.Text for item in COAList" ng-change="OnChangeCompany();" tabindex="1" required></select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group">
            <label class="col-sm-3 col-md-2 control-label">Type<sup>*</sup></label>
            <div class="col-sm-3 col-md-4 show-message">
                <div class="select-style">
                    <select ng-change="OnChangeCompany();" ng-model="SourceType" class="col-sm-3 form-control" id="SourceType" name="SourceType" required>
                        <option value="Receivable">Receivable</option>
                        <option value="Payable">Payable</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12">
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Exchange Status</th>
                        <th>Company Currency GL</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Exchange Gain</td>
                        <td>
                            <input type="text" ng-model="CompanyCurrencyGLGain" class="form-control" readonly>
                            <input type="text" ng-model="CompanyCurrencyBudgetGain" class="form-control" readonly>
                            <input type="text" ng-model="CompanyCurrencyActivityNameGain" class="form-control" readonly>
                            <button name="submit" class="btn" data-toggle="modal" ng-click="GetCompanyCurrencyGLList();"><i class="fa fa-search"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td>Exchange Loss</td>
                        <td>
                            <input type="text" ng-model="CompanyCurrencyGLLoss" class="form-control" readonly>
                            <input type="text" ng-model="CompanyCurrencyBudgetLoss" class="form-control" readonly>
                            <input type="text" ng-model="CompanyCurrencyActivityNameLoss" class="form-control" readonly>
                            <button name="submit" class="btn" data-toggle="modal" ng-click="GetCompanyCurrencyGLLossList();"><i class="fa fa-search"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" ng-show="deletebutton" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
