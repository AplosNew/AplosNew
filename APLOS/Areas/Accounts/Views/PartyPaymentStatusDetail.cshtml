
<h3>Vendor Payable Invoice Detail</h3>
<div class="row">
    <div class="col-lg-12">
        <label class="col-sm-12 control-label">Party: {{partyName}}</label>
        @*<label class="col-sm-4 control-label">Party: {{partyName}}</label>
            <label class="col-sm-5 control-label">Account Number: {{accountNumber}}</label>
        <label class="chart-title"></label>*@
    </div>
    <div class="clearfix"></div>


    <div class="content-container-fluid" style="color:black;overflow:scroll" @*ng-show="DetailDataList.length"*@>
        <div style="color:black;" id="GridPartyPayment" ej-grid e-datasource="DetailDataList" e-templaterefresh="refreshTemplateemployee"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                @*<div e-column e-field="NoOfInvoice" e-headertext="No Of Invoice" e-width="80"></div>
                <div e-column e-field="PartyName" e-headertext="Party" e-width="130"></div>
                <div e-column e-field="PartyPlantName" e-headertext="Party Plant" e-width="150"></div>*@

                <div e-column e-field="PartyCode" e-headertext="Party Code" e-width="60" e-textalign="right"></div>
                <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="130">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="$parent.printVoucherReport(this);" tooltip="Voucher No" class="btn" style="top: 1px;">{{data.VoucherNo}}</button></li>
                        </ul>
                    </div>
                </div>

                @*<div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="150"></div>*@
                <div e-column e-field="PostingDate" e-headertext="Posting Date" e-width="70"></div>
                <div e-column e-field="InvoiceNo" e-headertext="Doc RefNo" e-width="70"></div>
                <div e-column e-field="DocDate" e-headertext="Doc Date" e-width="70"></div>
                <div e-column e-field="ActualDueDate" e-headertext="Due Date" e-width="70"></div>

                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Advance" e-headertext=" Advance" e-width="40" e-textalign="right" style="height: 20px;"></div>

                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksGross" e-headertext="Books Gross" e-width="70" e-textalign="right" style="height: 20px;"></div>
                @*<div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksDebitNoteAmount" e-headertext="Books DebitNote" e-width="70" e-textalign="right" style="height: 20px;"></div>
                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksDiscountAmount" e-headertext="Books Discount" e-width="70" e-textalign="right" style="height: 20px;"></div>
                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksTaxAmount" e-headertext="Books Tax" e-width="40" e-textalign="right" style="height: 20px;"></div>*@

                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksSetOff" e-headertext=" Books SetOff" e-width="70" e-textalign="right" style="height: 20px;"></div>
                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="BooksBalance" e-headertext="Books Balance" e-width="70" e-textalign="right" style="height: 20px;"></div>

                <div e-column e-field="TrnCurrency" e-headertext="Trn Currency" e-width="40"></div>
                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Advance" e-headertext=" Advance" e-width="40" e-textalign="right" style="height: 20px;"></div>
                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Gross" e-headertext=" Gross" e-width="70" e-textalign="right" style="height: 20px;"></div>
                @*<div e-column e-type="numeric" e-format="{0:0.00}" e-field="DebitNoteAmount" e-headertext=" Debit Note" e-width="70" e-textalign="right" style="height: 20px;"></div>
                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="TranDiscountAmount" e-headertext="Discount" e-width="70" e-textalign="right" style="height: 20px;"></div>
                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="TaxAmount" e-headertext="Tax" e-width="70" e-textalign="right" style="height: 20px;"></div>*@
                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="SetOff" e-headertext=" SetOff" e-width="70" e-textalign="right" style="height: 20px;"></div>
                <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Balance" e-headertext=" Balance" e-width="70" e-textalign="right" style="height: 20px;"></div>


            </div>
        </div>


        <div class="common-btn">
            <ul class="list-inline text-right">
                @*<li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li><button ng-click="confirmDelete();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Delete</button></li>
                    <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>*@
                <li><button ng-click="Back();" class="btn"><i class="glyphicon glyphicon-backward"></i> Back</button></li>
            </ul>
        </div>

    </div>

</div>

