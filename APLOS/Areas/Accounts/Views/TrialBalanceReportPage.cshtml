                        </label>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="getDateWiseTrialBalanceReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                    </ul>
                </div>
            </fieldset>*@
        </div>

    </div>
</div>

