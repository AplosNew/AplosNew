<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Trial Balance</h3>
<div class="row">
    <div class="form-elements form-horizontal" ng-form id="from" name="from">

        <div class="col-xs-12 col-sm-4 col-md-4">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">{{legendTitle}}</legend>
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">Level<sup>*</sup></label>
                    <div class="col-sm-9 radio">
                        <label>
                            <input type="radio" name="OrganizationType" ng-model="report.OrganizationType" value="Plant">
                            <span class="cr" tabindex="1"><i class="cr-icon"></i></span>Plant
                        </label>
                        <label>
                            <input type="radio" name="OrganizationType" ng-model="report.OrganizationType" value="Company">
                            <span class="cr" tabindex="2"><i class="cr-icon"></i></span>Company
                        </label>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <div class="col-sm-12 radio">
                        <label>
                            <input type="radio" name="source2" ng-model="dateRange" value=false ng-change="viewChange()">
                            <span class="cr" tabindex="1"><i class="cr-icon"></i></span>As On Date
                        </label>
                        <label>
                            <input type="radio" name="source2" ng-model="dateRange" value=true ng-change="viewChange()">
                            <span class="cr" tabindex="2"><i class="cr-icon"></i></span>For the Period
                        </label>
                    </div>
                </div>
                <div class="form-group" show-errors id="div_FromDate">
                    <label class="col-sm-3 control-label">{{fromDateTitle}}<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Date" ng-model="report.FromDate" ng-change="checkYearClosedByDate(report.FromDate);" datepicker class="form-control" required tabindex="3">
                    </div>
                </div>
                <div ng-show="toDateShow" class="form-group" show-errors id="div_WDToDate">
                    <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Date" ng-model="report.ToDate" ng-change="checkYearClosedByDate(report.ToDate);" datepicker class="form-control" required tabindex="4">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Up To<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <div class="select-style">
                            <select class="form-control" name="CurrencyTransaction" ng-model="report.IsUpToLevel" ng-change="LevelAssaign(report.IsUpToLevel);partyRefresh()" required tabindex="3">
                                <option ng-repeat="option in upToLevelList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">Format<sup>*</sup></label>
                    <div class="col-sm-9 radio">
                        <label>
                            <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                            <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                        </label>
                        <label>
                            <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                            <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                        </label>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button @*ng-click="getReport();"*@ ng-click="reportFunctionCaller();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                    </ul>
                </div>
            </fieldset>

        </div>
        <div class="col-xs-12 col-sm-4 col-md-4" ng-show="report.IsUpToLevel=='Detail'">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Party Trail Balance</legend>
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">Party</label>
                    <div class="col-sm-9 show-message">
                        <div class="input-group">
                            <input type="text" name="Party" ng-model="PartyName" class="form-control" readonly required>
                            <span class="input-group-btn">
                                <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                <button ng-click="partyRefresh();" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">Party Plant</label>
                    <div class="col-sm-9 show-message">
                        <div class="input-group">
                            <div class="select-style">
                                <select tabindex="1" class="form-control" name="Location" ng-model="PartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(advance.PartyPlantId,'billTo'); updateCrAmount();" required>
                                    <option value=""></option>
                                </select>
                            </div>
                            <span class="input-group-btn">
                                <button ng-click="showPartyPlantPopUp(PartyPlantId);" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="getPartyLedgerReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i>Details Download</button></li>
                    </ul>
                </div>
            </fieldset>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4" ng-show="masterList.length">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Year Closed Trial Balance</legend>
                <div class="form-group" id="div_FiscalYearName">
                    <label class="col-sm-3 control-label">Fiscal Year<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <div class="input-group">
                            <input type="text" ng-model="yearClosedTBReport.FiscalYearName" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="getMasterData();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Up To<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <div class="select-style">
                            <select id="upToLevel" class="form-control" name="upToLevel" ng-model="yearClosedTBReport.IsUpToLevel" ng-change="yearClosedLevelAssaignTB(yearClosedTBReport.IsUpToLevel)" required tabindex="3">
                                <option ng-repeat="option in upToLevelList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="getYearClosedTBReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                    </ul>
                </div>
            </fieldset>
        </div>
    </div>

    <div class="modal fade site-modal in" id="FiscalYearClosepopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg modellgModify1">
            <div class="modal-content">
                <div class="modal-header"> Fiscal Year Close <button type="button" class="close" ng-click="closePopUp();">&times;</button></div>
                <div class="modal-body form-elements form-horizontal">
                    <div class="col-md-12">
                        <div style="color:black;" id="GridMaster" ej-grid e-datasource="masterList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-recorddoubleclick="SelectMaster" e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Master Id" e-width="40"></div>
                                <div e-column e-field="FiscalYearName" e-headertext="Fiscal Year" e-width="80"></div>
                                <div e-column e-field="CompanyName" e-headertext="Company" e-width="80"></div>
                                <div e-column e-field="PlantName" e-headertext="Plant" e-width="80"></div>
                            </div>
                        </div>
                    </div>
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-click="closePopUp();" class="btn"> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

    @Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")


