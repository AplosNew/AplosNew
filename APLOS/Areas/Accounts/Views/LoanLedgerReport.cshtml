<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Loan Register</h3>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group">
            <label class="col-sm-4 col-xs-4 control-label" title="Transaction Type" tooltip>Transaction Type<sup>*</sup></label>
            <div class="radio col-sm-8 col-xs-8">
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('@Library.Model.Enums.TransactionType.LoanTaken.ToString()')" ng-model="report.TransactionType" value="@Library.Model.Enums.TransactionType.LoanTaken.ToString()">
                    <span class="cr" tabindex="15"><i class="cr-icon"></i></span>Taken
                </label>
                <label>
                    <input type="radio" name="Transaction Type" ng-click="changeTransactionType('@Library.Model.Enums.TransactionType.LoanGiven.ToString()')" ng-model="report.TransactionType" value="@Library.Model.Enums.TransactionType.LoanGiven.ToString()">
                    <span class="cr" tabindex="14"><i class="cr-icon"></i></span>Given
                </label>

            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Format<sup>*</sup></label>
            <div class="col-sm-8 radio">
                <label>
                    <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                </label>
                <label>
                    <input type="radio" name="source" ng-model="report.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                </label>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group">
            <label class="col-sm-3 control-label">Loan No<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input type="text" name="LoanNo" ng-model="report.LoanNo" readonly class="form-control">
                    <span class="input-group-btn">
                        <button ng-click="showloanPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Loan Amount<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="LoanAmount" ng-model="report.LoanAmount" readonly class="form-control">
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group">
            <label class="col-sm-4 control-label">Loan<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Particulars" ng-model="report.Particulars" class="form-control" readonly>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Setoff<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="LoanAmount" ng-model="report.LoanSetOff" readonly class="form-control">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group">
            <label class="col-sm-3 control-label">VoucherNo<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="LoanAmount" ng-model="report.VoucherNo" readonly class="form-control">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label">Balance<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="LoanAmount" ng-model="report.Balance" readonly class="form-control">
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="col-md-6">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li>@*<button ng-click="getReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button>*@</li>
                    <li><button ng-click="getLoanRegisterReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="GetAllRegisterReportExcel();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> AllRegister</button></li>
                    <li><button ng-click="GetAllRegisterSummaryReportExcel();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> AllRegister Summary</button></li>
                </ul>
            </div>
        </div>


    </div>

    <div class="clearfix"></div>
</div>








@Html.Partial("~/Areas/Parties/Views/Party/_CustomerReconciliationGLPopUp.cshtml")
@Html.Partial("~/Areas/Accounts/Views/Loan/_LoanListPopUp.cshtml")
