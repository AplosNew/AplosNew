
<div class="modal fade site-modal in" id="InboundInvoicePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">In Bound Invoice</h4>
            </div>
            <div class="row text-right">
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="searchByVendor">
                                        <option ng-repeat="option in searchByVendorList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="searchVendor" ng-enter="showInvoicePopUp()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="showInvoicePopUp()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <div id="InvoiceGridPopUp" ng-init="chkinit()" ej-grid e-datasource="VendorAvailableInvoiceList" e-load="loadGridEdit"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-template="#checkboxTemplateMaster" e-headertext="Check" e-textalign="center" e-width="3"></div>
                            <div e-column e-field="DocRefNo" e-headertext="Invoice No" e-width="3"></div>
                            <div e-column e-field="PostingDate" e-headertext="Invoice Date" e-width="3"></div>
                            <div e-column e-field="PartyPlantName" e-headertext="Vendor" e-width="7"></div>
                            <div e-column e-field="TrnQty" e-headertext="Qty" e-width="2"></div>
                            <div e-column e-field="Receivable" e-headertext="Amount" e-width="2"></div>
                            <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="2"></div>
                            <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="4"></div>
                            <div e-column e-field="AcceptanceNo" e-headertext="AcceptanceNo" e-type='string' e-width="3"></div>
                            <div e-column e-field="ContractId" e-headertext="Contract No" e-type='string' e-width="3"></div>
                            <div e-column e-field="PurchaseLCId" e-headertext="LC No" e-type='string' e-width="3"></div>
                            <div e-column e-field="AdjustmentNoteId" e-headertext="AdjustmentNote Id" e-type='string' e-width="3"></div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxTemplateMaster">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                    </script>
                </div>
                @*</div>*@
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="AddInvoice();" class="btn"><i></i> Apply</button></li>
                        <li> <button ng-click="hideInvoicePopUp();" class="btn"><i class="glyphicon glyphicon-remove"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>