<style>
    .modellgModify1 {
        width: 1100px;
    }
</style>
<div class="modal fade site-modal in" id="PostPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify1">
        <div class="modal-content">
            <div class="modal-header"> Are you sure to Post? <button type="button" class="close" ng-click="closePostPopUp();">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Voucher No</label>
                                <div class="col-sm-9 show-message">
                                    <input type="text" id="VoucherNo_Post" name="VoucherNo_Post" ng-model="voucher_Post.VoucherNo" class="form-control" tabindex="5" autocomplete="off" readonly>
                                </div>
                            </div>
                            <div id="div_PostingDate_Edit" class="form-group" style="margin-top: 40px;">
                                <label class="col-sm-3 control-label">Posting Date<sup>*</sup></label>
                                <div class="col-sm-9 show-message">
                                    <input required datepicker="checkPostingDate_Edit();checkDocDate_Edit();" id="postingDate_db" type="text" name="Posting Date" ng-model="voucher_Post.PostingDate" class="form-control" tabindex="1">
                                </div>
                            </div>
                            <div id="div_DocDate_Edit" class="form-group" style="margin-top: 80px;">
                                <label class="col-sm-3 control-label">Doc Date<sup>*</sup></label>
                                <div class="col-sm-9 show-message">
                                    <input type="text" name="DocDate" ng-model="voucher_Post.DocDate" datepicker="checkDocDate_Edit();" required class="form-control" tabindex="3">
                                </div>
                            </div>
                            <div class="form-group" style="margin-top: 120px;">
                                <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
                                <div class="col-sm-9 show-message">
                                    <input type="text" maxlength="50" name="Doc Ref" ng-model="voucher_Post.DocRefNo" class="form-control" ng-keyup="CheckSpecialCharecter_Edit();" tabindex="4" required capitalize autocomplete="off">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Amount</label>
                                <div class="col-sm-9 show-message">
                                    <input type="text" n-decimals="2" id="Amount_Post" name="Amount_Post" ng-model="voucher_Post.Amount" class="form-control" tabindex="5" autocomplete="off" readonly>
                                </div>
                            </div>
                            <div class="form-group" style="margin-top:40px;">
                                <label class="col-sm-3 control-label">Currency</label>
                                <div class="col-sm-9 show-message">
                                    <input type="text" id="CurrencyCode_Post" name="CurrencyCode_Post" ng-model="voucher_Post.CurrencyCode" class="form-control" tabindex="5" autocomplete="off" readonly>
                                </div>
                            </div>
                            <div id="div_entity_Post" class="form-group" style="margin-top:80px;">
                                <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
                                <div class="col-sm-9 show-message">
                                    <div class="select-style">
                                        <select id="entityId_Post" class="form-control" name="entity_Post" ng-model="voucher_Post.EntityId" tabindex="6" required>
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="form-horizontal col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group" style="margin-top: 10px;">
                        <label class="col-sm-2 control-label">Narration<sup>*</sup></label>
                        <div class="col-sm-10 show-message">
                            <textarea rows="2" type="text" name="Narration" tabindex="8" class="form-control" ng-model="voucher_Post.Narration" maxlength="500" required capitalize></textarea>
                        </div>
                    </div>
                </div>
                <br />
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closePostPopUp();" class="btn"> Close</button></li>
                    <li><button ng-click="post();" class="btn"> Post</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
