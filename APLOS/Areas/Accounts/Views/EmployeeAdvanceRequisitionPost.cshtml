<togglable name="{{title}}"></togglable>
<div class="form-horizontal form-elements" ng-form="form0">
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Select Requisition</label>
            <div class="col-sm-9 show-message">
                <div class="input-group">
                    <input tabindex="1" type="text" name="RequisitionId" ng-model="advance.RequisitionId" class="form-control" readonly required>
                    <span class="input-group-btn">
                        <button ng-click="popUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Requisition</legend>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">@Library.Model.Parties.PartyType.Employee.ToString()<sup>*</sup></label>
                    <div class="col-sm-9 show-message">
                        <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Employee.ToString()" ng-model="advance.EmployeeName" required class="form-control" readonly>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">Amount<sup>*</sup></label>
                    <div class="col-sm-6 show-message" style="padding-right:0px;">
                        <input tabindex="19" name="Amount" ng-model="advance.Amount" type="text" n-decimals="2" class="form-control text-right" disabled required autocomplete="off">
                    </div>
                    <div class="col-sm-3 show-message" style="padding-left:0px;">
                        <div class="select-style">
                            <select id="CurrencyId" class="form-control" tabindex="14" name="Currency" ng-model="advance.CurrencyId" disabled ng-change="; checkBankAmount();" required>
                                <option ng-repeat="option in tranCurrencyList" value="{{option.CurrencyId}}">{{option.Code}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-3 control-label">Checked By</label>
                    <div class="col-sm-9 show-message">
                        <input tabindex="1" type="text" name="CheckedBy" ng-model="advance.CheckedBy" class="form-control" readonly>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label">Rate<sup>*</sup></label>
                    <div class="col-sm-2 show-message">
                        <input type="number" maxlength="50" n-decimals="4" id="Rate" name="Rate" ng-disabled="advance.CurrencyId==companyCurrencyId" ng-model="advance.CompanyCurrencyRate" class="form-control" tabindex="5" required autocomplete="off">
                    </div>
                    <label class="col-sm-3 control-label">Advance Type<sup>*</sup></label>
                    <div class="col-sm-4 show-message">
                        <input type="text" maxlength="50" id="AdvanceType" name="AdvanceType" readonly ng-model="advance.AdvanceType" class="form-control" tabindex="5" required autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-3 control-label">Approved By</label>
                    <div class="col-sm-9 show-message">
                        <input tabindex="1" type="text" name="ApprovedBy" ng-model="advance.ApprovedBy" class="form-control" readonly>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-3 control-label"> Required Date<sup>*</sup></label>
                    <div class="col-sm-9 show-message">
                        <input tabindex="7" type="text" name="Entry Date" ng-model="advance.RequisitionRequiredDate" datepicker class="form-control" disabled>
                    </div>
                </div>
            </div>

            <div class="clearfix"></div>
            <fieldset class="scheduler-border" ng-show="getAdvanceReqScheduleList.length">
                <legend class="scheduler-border">Advance Schedule</legend>
                <div class="table-responsive modal-table" ng-show="getAdvanceReqScheduleList.length" style="padding-top:10px;">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Installment Date</th>
                                <th>Installment No</th>
                                <th>Principal Amount</th>
                                <th>Interest Amount</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in getAdvanceReqScheduleList">
                                <td>{{x.InstallmentDate}}</td>
                                <td>{{x.InstallmentNo}}</td>
                                <td>{{x.PrincipalAmount}}</td>
                                <td>{{x.ProfitAmount}}</td>
                                <td>{{x.Balance}}</td>
                            </tr>
                        </tbody>

                    </table>
                </div>
            </fieldset>
        </fieldset>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entry Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input tabindex="7" type="text" name="Entry Date" ng-model="advance.VoucherDate" datepicker class="form-control" disabled required>
            </div>
        </div>
        <div id="div_TransactionType" class="form-group" >
            <label class="col-sm-3 control-label">Transaction Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-change="getTransactionTypeGL(advance.EmployeeTransactionTypeId)" name="Transaction Type" class="form-control" ng-model="advance.EmployeeTransactionTypeId"  tabindex="7">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in employeeTransactionTypeList" value="{{option.EmployeeTransactionTypeId}}">{{option.EmployeeTransactionTypeName}}</option>
                    </select>
                </div>
            </div>
        </div>
        @*<div class="form-group" ng-show="advance.AdvanceType=='Salary'">
            <label class="col-sm-3 control-label">Select GL<sup>*</sup></label>
            <div class="col-sm-7 show-message">
                <input type="text" ng-maxlength="50" name="ActivityName" ng-disabled="true" ng-model="advance.ActivityName" class="form-control">
            </div>
            <div class="col-sm-2 input-group">
                <span class="input-group-btn">
                    <button ng-click="GetemployeeReconGLList();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>*@


        <div class="form-group">
            <label class="col-sm-3 control-label">Payment Source<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input ng-click="clearBankPopUp()" type="radio" ng-disabled="advance.Id" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Bank.ToString()">
                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Bank.ToString()
                </label>
                <label>
                    <input ng-click="clearCashPopUp()" type="radio" ng-disabled="advance.Id" name="source" ng-model="advance.PaymentSource" value="@Library.Model.Payments.PaymentSource.Cash.ToString()">
                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Payments.PaymentSource.Cash.ToString()
                </label>
            </div>
        </div>
        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
            <label class="col-sm-3 control-label">Bank<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Bank" class="form-control" ng-model="advance.BankMasterId" ng-options="item.Id as item.AccountTitle for item in bankMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" ng-show="advance.BankMasterId">
            <label class="col-sm-4 control-label">Bank Ref No</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="50" id="Bank Reference No" name="Bank Reference No" ng-model="advance.BankReferenceNo" class="form-control" tabindex="5" autocomplete="off">
            </div>
        </div>
        <div class="form-group" ng-show="advance.BankMasterId">
            <label class="col-sm-4 control-label">Bank Trn Date</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="BankTransactionDate" ng-model="advance.BankTransactionDate" datepicker class="form-control" tabindex="4">
            </div>
        </div>
        <div class="form-group" ng-show="advance.PaymentSource=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
            <label class="col-sm-3 control-label">Cash<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select name="Cash" class="form-control" ng-model="advance.CashMasterId" ng-options="item.Id as item.UserName for item in cashMasterList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">

        <div id="div_PostingDate" class="form-group" show-errors>
            <label class="col-sm-3 control-label">Posting Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="advance.PostingDate" class="form-control">
            </div>
        </div>
        <div id="div_DocDate" class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Date<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" name="DocDate" ng-model="advance.DocDate" datepicker="checkPostingDate();checkDocDate();" required class="form-control">
            </div>
        </div>
        <div class="form-group" id="div_ReviewDate">
            <label class="col-sm-3 control-label">Review Date</label>
            <div class="col-sm-9 show-message">
                <input type="text" name="DocDate" ng-model="advance.ReviewDate" datepicker="checkReviewDate();" class="form-control">
            </div>
        </div>
        <div class="form-group">
            <label title="Responsible Person" class="col-sm-3 control-label">Res.Person</label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input type="text" name="Responsible Person" ng-model="advance.ResponsiblePersonName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="showResponsiblePersonListPopUp()" class="btn single-small-btn" tabindex="20"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearResponsiblePersonPopUp()" class="btn single-small-btn" tabindex="21"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Voucher Type<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select ng-disabled="voucherTypeList.length==1" class="form-control" name="Voucher Type" ng-model="advance.VoucherTypeId" tabindex="11" ng-change="changeVoucherType(advance.VoucherTypeId);GetCurrencyExchangeRateList()" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in voucherTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div id="div_entity" class="form-group" show-errors>
            <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <div class="select-style">
                    <select id="entityId" class="form-control" name="Entity" ng-model="advance.EntityId" tabindex="16" required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in entityList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Doc Ref<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <input type="text" maxlength="20" id="Doc Ref" name="Doc Ref" ng-model="advance.DocRefNo" class="form-control" autocomplete="off" required>
            </div>
        </div>

        <div class=" row form-group" show-errors>
            <label class="col-sm-3 control-label">Narration<sup>*</sup></label>
            <div class="col-sm-9 show-message">
                <textarea rows="2" type="text" name="Narration" tabindex="24" class="form-control" ng-model="advance.Narration" required capitalize></textarea>
            </div>
        </div>
    </div>


    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li ng-hide="advance.Id==null"><button ng-click="confirmPost(advance.Id);" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>Post</button></li>
            <li><button ng-click="clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>@Library.Model.Parties.PartyType.Employee.ToString()</th>
                    <th>Posting Date</th>
                    <th>Currency</th>
                    <th>Advance Type</th>
                    <th>Amount</th>
                    <th>Set-off Amount</th>
                    <th>Balance</th>
                    <th>Checked By</th>
                    <th>Approved By</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in voucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id,x.EmployeeCode,x.EmployeeName,x.ResponsibleCode,x.ResponsibleName);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.EmployeeCode}} - {{x.EmployeeName}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.CurrencyCode}}</td>
                    <td>{{x.AdvanceType}}</td>
                    <td class="text-right">{{x.Amount | number:2}}</td>
                    <td class="text-right">{{x.WrittenOffAmount | number:2}}</td>
                    <td class="text-right">{{x.Amount-x.WrittenOffAmount | number:2}}</td>
                    <td class="text-right">{{x.CheckedBy}}</td>
                    <td class="text-right">{{x.ApprovedBy}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x.Id,x.VoucherId);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/GetEmployeeAdvanceReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/Advance/GetEmployeeAdvanceReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.VoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>
