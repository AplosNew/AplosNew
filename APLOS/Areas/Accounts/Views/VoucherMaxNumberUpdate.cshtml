@*<togglable name="VoucherType Config"></togglable>*@
 
<div class="form-elements form-horizontal" ng-form name="voucherTypeConfigForm">
    <div class="clearfix"></div>
    <fieldset class="scheduler-border ">
        <legend class="scheduler-border">Voucher Max Number</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <div class="select-style">
                        <select name="VoucherType" ng-model="voucherTypeConfig.VoucherTypeId" class="col-sm-3 form-control"
                                ng-options="item.Value as item.Text for item in voucherTypeList" required tabindex="3"></select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Period<sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <div class="select-style">
                        <select name="Period" ng-model="voucherTypeConfig.Period" ng-change="onchangePeriod()" class="col-sm-3 form-control"
                                ng-options="item.Value as item.Text for item in periodEnumList" required></select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max Number<sup>*</sup></label>
                <div class="col-sm-2  show-message">
                    <input type="text" id="MaxNumber1" name="VMaxNumber" ng-model="voucherTypeConfig.MaxNumber" ng-disabled="true" class="form-control" tabindex="5" required>
                </div>
                <label class="col-sm-4 control-label">New Max Number<sup>*</sup></label>
                <div class="col-sm-2  show-message">
                    <input type="number" id="MaxNumber2" name="VMaxNumber2" ng-model="voucherTypeConfig.NewMaxNumber" class="form-control" tabindex="5" required>
                </div>
            </div>

        </div>
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li><button ng-click="Save();" class="btn" tabindex="7"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li><button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </fieldset>
    <fieldset class="scheduler-border ">
        <legend class="scheduler-border">VoucherNo Update</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Existing VoucherNo<sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <input type="text" id="MaxNumber1" name="VMaxNumber" ng-model="voucherNoUpdate.ExistingVoucherNo"  class="form-control" tabindex="5" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">New VoucherNO<sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <input type="text" id="NewVoucherNo" name="NewVoucherNo" ng-model="voucherNoUpdate.NewVoucherNo" class="form-control" tabindex="5" required>
                </div>
            </div>

        </div>
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li><button ng-click="VoucherNoUpdate();" class="btn" tabindex="7"><i class="glyphicon glyphicon-floppy-disk"></i> VoucherNo Update</button></li>
                <li><button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </fieldset>
</div>
<div class="form-elements form-horizontal" ng-form name="voucherTypeConfigForm">
    <confirm-modal></confirm-modal>
