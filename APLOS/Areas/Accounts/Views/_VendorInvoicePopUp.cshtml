<style>
    .modellgModify {
        width: 1200px;
    }
</style>
<div class="modal fade site-modal in" id="vendorInvoicePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content" ng-form name="partyForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">{{partyName}}</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="invoiceParameters.searchBy">
                                            <option ng-repeat="option in invoiceSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="invoiceParameters.search" ng-enter="getInvoiceData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getInvoiceData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>VoucherNo</th>
                                <th>Entity</th>
                                <th>Ordering @Library.Model.Parties.PartyType.Vendor.ToString()</th>
                                <th>PostingDate</th>
                                <th>DocDate</th>
                                <th>Doc Ref</th>
                                <th>Currency</th>
                                <th>Payable</th>
                                <th>Add.Payable</th>
                                <th>LCTagged Amount</th>
                                <th>Write-off</th>
                                <th>Balance</th>
                                <th>Particular</th>
                                <th>LC No</th>
                                <th>Acceptance No</th>
                                <th>Contract No</th>
                                <th>Customer</th>
                                <th>Master LCNo</th>
                                <th>File Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in invoiceList |itemsPerPage:invoiceParameters.pageSize" pagination-id="metaData.name + 'invoiceList'"
                                total-items="invoiceParameters.total_count" ng-class="{selected : x.VoucherDetailId == selectedInvoiceId}">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Active">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.VoucherNo}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.PartyPlantName}}</td>
                                <td>{{x.PostingDate |dateFiltering}}</td>
                                <td>{{x.DocDate |dateFiltering}}</td>
                                <td>{{x.DocRefNo}}</td>
                                <td>{{x.CurrencyCode}}</td>
                                <td class="text-right">{{x.Receivable | number:2}}</td>
                                <td class="text-right">{{x.AdditionalAmount | number:2}}</td>
                                <td class="text-right">{{x.LCTaggedAmount | number:2}}</td>
                                <td class="text-right">{{x.Received | number:2}}</td>
                                <td class="text-right">{{x.Balance | number:2}}</td>
                                <td>{{x.Particular}}</td>
                                <td>{{x.LCRef}}</td>
                                <td>{{x.AcceptanceNo}}</td>
                                <td>{{x.ContractNo}}</td>
                                <td>{{x.Customer}}</td>
                                <td>{{x.MasterLCNo}}</td>
                                <td><label class="col-sm-4 control-label" ng-click="FileDownload(x)"><a href="{{dwonloadUrl}}" style="text-decoration:underline" download="{{x.FileName}}" target="_self">{{x.FileName}}</a></label></td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'invoiceList'" direction-links="true" boundary-links="true" on-page-change="getInvoiceData(newPageNumber)"></dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeInvoicePopUpselected();">Select</button>
            </div>
        </div>
    </div>
</div>