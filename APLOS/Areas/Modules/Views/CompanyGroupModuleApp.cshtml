<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Company Group Module App</h3>
<div class="form-horizontal form-element-ctrl" ng-form="companyGroupModuleAppForm">
    <div class="form-group">
        <label class="col-sm-3 col-md-2 control-label">Company Group</label>
        <div class="col-sm-3 col-md-4">
            <div class="select-style">
                <select class="form-control" ng-model="CompanyGroupId" ng-change="onChange()" ng-options="item.Value as item.Text for item in companyGroupList">
                    <option value="">--Select--</option>
                </select>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="companyGroupModuleApps.length>0">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Apply</th>
                <th>Module App Name</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in companyGroupModuleApps | orderBy:'ModuleAppName'">
                <td>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td>{{x.ModuleAppName}}</td>
            </tr>
        </tbody>
    </table>
</div>
<div class="common-btn" ng-show="companyGroupModuleApps.length>0">
    <ul class="list-inline text-right">
        <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> Save</button></li>
    </ul>
</div>