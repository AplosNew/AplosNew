<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Prerecruitment Url</h3>
<div class="form-horizontal form-elements">
    <div class="form-group">
        <label class="col-sm-3 control-label">Company Group</label>
        <div class="col-sm-6">
            <div class="select-style">
                <select ng-change="getCboCompanyByCompanyGroup(prerecruitmentUrl.CompanyGroupId); LoadModule()" id="PlantId" class="form-control" name="Plant" ng-model="prerecruitmentUrl.CompanyGroupId" tabindex="1">
                    <option value="">--Select--</option>
                    <option ng-repeat="option in companyGroupList" value="{{option.Value}}">{{option.Text}}</option>
                </select>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-3 control-label">Company</label>
        <div class="col-sm-6">
            <div class="select-style">
                <select id="PlantId" class="form-control" name="Plant" ng-model="prerecruitmentUrl.CompanyId" ng-change="getList()" tabindex="2">
                    <option value="">--Select--</option>
                    <option ng-repeat="option in companyList" value="{{option.Value}}">{{option.Text}}</option>
                </select>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table form-horizontal form-elements">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Apply</th>
                <th>Plant Code</th>
                <th>Plant Name</th>
                <th>Url</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in filtered = (prerecruitmentUrls | orderBy:'PlantCode')">
                <td>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" id="IsJournalVoucher" ng-model="x.Active" ng-checked="x.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td>{{x.PlantCode}}</td>
                <td>{{x.PlantName}}</td>
                <td><input type="text" class="col-md-5 form-control" ng-model="x.Url"></td>
            </tr>
        </tbody>
    </table>
</div>
<div class="common-btn">
    <ul class="list-inline text-right">
        <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> {{Action}}</button></li>
    </ul>
</div>