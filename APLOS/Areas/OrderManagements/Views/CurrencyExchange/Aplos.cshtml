<div class="row">
    <div class="col-xs-12">
        <table>


            <tr ng-repeat="cur in ExchangeDisplayCurrency">
                <td>
                    1
                </td>
                <td>
                    {{cur.FromCurrencyCode}} is equivalent to
                </td>
                <td style="width:110px;">
                    <input type="text" e-enabled="{{cur.FromCurrencyId==cur.ToCurrencyId?'false':'true'}}" ej-numerictextbox e-minvalue="0" e-decimalplaces="6" e-change="ExchangeUpdateCurrencyList(cur.FromCurrencyId,cur.ToUnit);" e-value="cur.ToUnit" e-width="100" />
                </td>
                <td>
                    {{cur.ToCurrencyCode}}
                </td>
            </tr>
        </table>

    </div>

    <div class="col-xs-12 small">
        <i style="color:#0026ff;">**Please provide the exchange rate if your transaction currency is other than {{ExchangeDisplayCurrency[0].ToCurrencyCode}}</i>
        <br /> <i style="color:#0026ff;">**update/save your data after providing exchange rate</i>
    </div>
    <div class="col-xs-12 text-right">
        <span class="input-group-btn">
            <button ng-click="closePopup('dialogExchangeCurrency');" class="btn single-small-btn"><i class="glyphicon glyphicon-ok-circle"></i></button>
        </span>
    </div>
</div>

