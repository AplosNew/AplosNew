                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div ng-form="modelWEOForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Company" class="form-control" ng-model="fileNew.CompanyId" ng-change="getPlantCbo();" ng-options="item.Value as item.Text for item in companyList" required>
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Week Off</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="PlanningType2WeekOff" class="form-control" ng-model="fileNew.PlanningType2WeekOff" name="PlanningType2WeekOff" tabindex="1">
                                        <option value=""></option>
                                        <option Value="Saturday">Saturday</option>
                                        <option Value="Sunday">Sunday</option>
                                        <option Value="Monday">Monday</option>
                                        <option Value="Tuesday">Tuesday</option>
                                        <option Value="Wednesday">Wednesday</option>
                                        <option Value="Thursday">Thursday</option>
                                        <option Value="Friday">Friday</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Plant" class="form-control" ng-model="fileNew.PlantID" ng-change="getPlantData();" ng-options="item.Value as item.Text for item in plantList" required>
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="SaveWeekOff();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




<ej-dialog id="setholiday" title=" Assign Holiday" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-width="500" e-target="#mainContainer" e-open="enableBtn">

    <div class="form-group">
        <label class="col-sm-4 control-label">Holiday Category<sup>*</sup></label>
        <div class="col-sm-8">
            <div class="select-style">

                <select ng-model="HolidayCategoryId">
                    <option ng-repeat="option in HolidayCategorycbo" value="{{option.Id}}">{{option.UserName}}</option>
                </select>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <ul class="common-btn list-inline text-left">
            <li><button ng-click="HolidayAssign();" class="btn"><i class="glyphicon glyphicon-save"></i> Save</button></li>
        </ul>
    </div>
</ej-dialog>

<ej-dialog id="setworkingday" title=" Work Day Configuration" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-width="500" e-target="#mainContainer" e-open="enableBtn">

    <div class="form-group">
        <label class="col-sm-4 control-label">Working Hours<sup>*</sup></label>
        <div class="col-sm-8">
            <input type="number" class="form-control" placeholder="Search" ng-model="workigHours">
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-4 control-label">OT Hours<sup>*</sup></label>
        <div class="col-sm-8">
            <input type="number" class="form-control" placeholder="Search" ng-model="OTHours">
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <ul class="common-btn list-inline text-left">
            <li><button ng-click="WorkDayAssign();" class="btn"><i class="glyphicon glyphicon-save"></i> Save</button></li>
        </ul>
    </div>
</ej-dialog>

<ej-dialog id="show" title=" Work Day (View)" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-width="500" e-target="#mainContainer" e-open="enableBtn">
    <div class="row">
        <div class="form-group">
            <label class="col-sm-4 control-label">Day Status</label>
            <label class="col-sm-8 control-label">{{selectedDayStatus.DayStatus}}</label>

        </div>
    </div>
    <div class="row">
        <div class="form-group">
            <label class="col-sm-4 control-label">Holiday</label>
            <label class="col-sm-8 control-label">{{selectedDayStatus.HolidayName}}</label>
        </div>
    </div>
    <div class="row">
        <div class="form-group">
            <label class="col-sm-4 control-label">Working Hours<sup>*</sup></label>
            <label class="col-sm-8 control-label">{{selectedDayStatus.WorkingHours}}</label>
        </div>
    </div>
    <div class="row">
        <div class="form-group">
            <label class="col-sm-4 control-label">OT Hours<sup>*</sup></label>
            <label class="col-sm-8 control-label">{{selectedDayStatus.OTHours}}</label>

        </div>
    </div>
</ej-dialog>




