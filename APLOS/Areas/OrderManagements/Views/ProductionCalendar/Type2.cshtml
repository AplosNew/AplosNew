
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Production Calendar Type2</h3>
<div class="form-horizontal form-elements" ng-form="modelForm">
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Calendar</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Config</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="form-group">
                        <label class="col-sm-2 control-label">Entity<sup class="redFont"> *</sup></label>
                        <div class="col-sm-4 text-left">
                            <div class="select-style">
                                <select name="EntityId" ng-model="EntityId" ng-change="getProcessData();Create()" class="col-sm-3 form-control"
                                        ng-options="item.Id as item.UserName for item in entityList" tabindex="1">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <label class="col-sm-2 control-label">Process<sup class="redFont"> *</sup></label>
                        <div class="col-sm-4 text-left">
                            <div class="select-style">
                                <select name="ProcessID" ng-model="ProcessID" ng-change="Create()" class="col-sm-3 form-control"
                                        ng-options="item.Id as item.UserName for item in prdProcessSetList" tabindex="1">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-element-ctrl form-horizontal">

                        @*<div class="col-xs-12 col-sm-12 col-md-12">
