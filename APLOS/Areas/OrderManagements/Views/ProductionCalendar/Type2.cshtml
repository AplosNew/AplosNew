        <div class="form-group">
            <label class="col-sm-2 control-label">Entity<sup class="redFont"> *</sup></label>
            <div class="col-sm-4 text-left">
                <div class="select-style">
                    <select name="EntityId" ng-model="EntityId" ng-change="getProcessData();Create()" class="col-sm-3 form-control"
                            ng-options="item.Id as item.UserName for item in entityList" tabindex="1">
                        @*<option value=""></option>*@
                    </select>
                </div>
            </div>
            <label class="col-sm-2 control-label">Process<sup class="redFont"> *</sup></label>
            <div class="col-sm-4 text-left">
                <div class="select-style">
                    <select name="EntityId" ng-model="ProcessID" ng-change="Create()" class="col-sm-3 form-control"
                            ng-options="item.Id as item.UserName for item in prdProcessSetList" tabindex="1">
                        @*<option value=""></option>*@
                    </select>
                </div>
            </div>
        </div>

        <div class="form-element-ctrl form-horizontal">

            @*<div class="col-xs-12 col-sm-12 col-md-12">
