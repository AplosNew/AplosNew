<togglable name="{{FormTitle}}"></togglable>
<div class="form-horizontal form-elements" ng-form name="PackingConfirmationForm" id="mainDiv">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="IsGo" ng-model="packingContenNew.EntityId" ng-change="GetPackingProcessCbo(packingContenNew.EntityId)" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-disabled="IsGo" ng-model="packingContenNew.ProductionDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                </div>

            </div>
            <div class="form-group" show-errors ng-show="IsGo===true">
                <label class="col-sm-4 control-label">To<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="IsGo" ng-model="packingContenNew.ToProcessId" name="To" ng-options="item.ToId as item.UserName for item in listToProcessOrSFGInventory">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" ng-show="IsGo===true">
                <label class="col-sm-4 control-label">Production Order<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="ProductionOrder" ng-model="packingContenNew.ProductionOrderId" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="getProductionOrderPopUp();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="IsGo" ng-model="packingContenNew.ProcessId" name="Process" ng-options="item.Id as item.UserName for item in processList" ng-change="GetSFGMovementToCbo();" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="IsGo" ng-model="packingContenNew.ProductionShiftId" name="Shift" ng-options="item.Value as item.Text for item in shiftList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" style="margin-bottom: 25px;">
                <label class="col-sm-4 control-label"></label>

                <div class="col-sm-2" style="padding-right:0;">
                    <button ng-click="masterGo(true);" ng-disabled="disGo" class="btn" tabindex="9"><i class="glyphicon glyphicon-send"></i> GO</button>
                </div>
                <div class="col-sm-2" style="padding-left:0;">
                    <button ng-click="SetBack(false);" class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-left"></i> Back</button>
                </div>
            </div>
        </div>
        <div class="col-xs-12" ng-show="packingContenNew.ProductionOrderId!==null">
            <div id="GridSOItemSelected" ej-grid e-datasource="PackingContentDataListByPR"
                 e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                 e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true">
                <div e-columns>
                    <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="40"></div>
                    <div e-column e-field="Description" e-headertext="Description" e-width="150" e-textalign="left"></div>
                    <div e-column e-field="NoOfQty" e-headertext="packingContenNew.QtyPackingForm" e-width="50" e-textalign="right"></div>
                    <div e-column e-field="NoOfLine" e-headertext="packingContenNew.PackingForm" e-width="50" e-textalign="right"></div>
                    <div e-column e-field="Confirmed" e-headertext="packingContenNew.ConPackingForm" e-width="50" e-textalign="right"></div>
                    <div e-column e-template="#CurrentAccept" e-headertext="packingContenNew.ColumnName" e-width="50" e-textalign="right"></div>
                    <div e-column e-field="Balance" e-headertext="packingContenNew.BalancePackingForm" e-width="50" e-textalign="right"></div>
                    <div e-column e-field="NetWeight" e-headertext="Net Weight" e-width="50" e-textalign="right"></div>
                    <div e-column e-field="GrossWeight" e-headertext="Gross Weight" e-width="50" e-textalign="right"></div>

                </div>
            </div>
            <script type="text/template" id="ShowActionButtons">
                <button style="color: #f3f3ec;background-color: #1c1f32;" title="Content Detail" class="btn"><i class="fa fa-th-large" ng-click="$parent.getDetailData(this);" style="margin: -6px;"></i></button>
                <button style="color: #f3f3ec;background-color: #1c1f32;" title="Individual Pack" class="btn"><i class="fa fa-cubes" ng-click="$parent.getPackingChildData(this);" style="margin: -6px;"></i></button>
            </script>
            <script type="text/template" id="CurrentAccept">
                <div class="col-sm-10" style="padding: 0px;width: 70px;margin-left: 24px;">
                    <input type="text" class="input ejinputtext form-control" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-disabled="data.NoOfLine==data.Confirmed" ng-model="data.RecvQty" ng-change="$parent.MakeData(this);" width="80" />
                </div>
            </script>
        </div>

        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <div class="content-container-fluid" style="color:black;overflow:scroll">
        <div style="color:black;" id="GridMain" ej-grid e-datasource="PackingConfirmationList" @*e-recorddoubleclick="Get"*@
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                @*<div e-column e-headertext="Actions" e-template="#ShowActionButtonsBOM" e-width="10"></div>*@
                <div e-column e-field="Id" e-headertext="Id" e-width="20" e-visible="false"></div>
                <div e-column e-field="Plant" e-headertext="Plant" e-width="20"></div>
                <div e-column e-field="Entity" e-headertext="Entity" e-width="30"></div>
                <div e-column e-field="ProductionOrderId" e-headertext="ProductionOrderId" e-width="40"></div>
                <div e-column e-field="ProdDate" e-headertext="Production Date" e-width="0" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="MaterialMaster" e-headertext="Material" e-width="30"></div>
                <div e-column e-field="Article" e-headertext="Article" e-width="30"></div>
                <div e-column e-field="Quantity" e-headertext="Produced Qty" e-width="30"></div>
                <div e-column e-field="From" e-headertext="From" e-width="30"></div>
                <div e-column e-field="To" e-headertext="To" e-width="50"></div>

            </div>
        </div>
        @*<script type="text/template" id="ShowActionButtonsBOM">
                <button style="color: #f3f3ec;background-color: #1c1f32;" title="Edit" ng-disabled="data.Version!=1" class="btn"><i class="glyphicon glyphicon-pencil" ng-click="$parent.Get(this);" style="margin: -6px;"></i></button>
            </script>*@
    </div>
</div>



<div class="modal site-modal in" id="POItemPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Production Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body text-center">
                <div style="color:black;" id="Grid" ej-grid e-datasource="ProductionOrderList" e-allowscrolling="true"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-recorddoubleclick="GetPackingContentDataByPRId"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-template="#showSOList" e-headertext="" e-width="30"></div>
                        <div e-column e-field="POId" e-headertext="Production OrderNo" e-width="80"></div>
                        <div e-column e-field="BuyerOrder" e-headertext="Buyer Ord#" e-width="80"></div>
                        <div e-column e-field="OwnOrder" e-headertext="Own Ord#" e-width="80"></div>
                        <div e-column e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
                        <div e-column e-field="Qty" e-headertext="Qty" e-width="80"></div>
                        <div e-column e-field="LSD" e-headertext="LSD" e-width="80"></div>
                        <div e-column e-field="CommitmentDate" e-headertext="Commitment Date" e-width="80"></div>
                        <div e-column e-field="ProductionStatus" e-headertext="Production Status" e-width="80"></div>
                        <div e-column e-field="BuyerItem" e-headertext="Buyer Item#" e-width="80"></div>
                        <div e-column e-field="OwnItem" e-headertext="Own Item#" e-width="80"></div>
                        <div e-column e-field="ProductCategory" e-headertext="Product Category" e-width="80"></div>
                        <div e-column e-field="Product" e-headertext="Product" e-width="80"></div>
                        <div e-column e-field="Customer" e-headertext="Customer" e-width="80"></div>
                        <div e-column e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                        <div e-column e-field="PONumber" e-headertext="PO Number" e-width="80"></div>
                        <div e-column e-field="RequiredTimeUnit" e-headertext="Required Time Unit" e-width="80"></div>

                    </div>
                </div>
                <script type="text/template" id="showSOList">
                    <div class="common-btn">
                        <ul class="list-inline text-right small">

                            <li>
                                <button ng-click="$parent.getSalesOrderOfProdOrderList(data.ProductionOrderId);" class="btn small" style="height: 20px;width: 20px;padding: 0px;margin: 0px;">
                                    <i class="glyphicon glyphicon-th-list"></i>
                                </button>
                            </li>
                        </ul>
                    </div>
                </script>
            </div>
        </div>
    </div>
</div>
<div class="modal site-modal in" id="PackingContentPopUp" role="dialog" data-backdrop="static">
    <div class="row">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">Packing Content Info<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body text-center">
                    <div style="color:black;" id="GridP" ej-grid e-datasource="PackingContentDataList" e-allowscrolling="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="150" e></div>
                            <div e-column e-field="ArticleName" e-headertext="Article" e-width="150"></div>
                            <div e-column e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="60"></div>
                            <div e-column e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="60"></div>
                            <div e-column e-field="ThirdCharacteristicsValue" e-headertext="SKU3" e-width="60"></div>
                            <div e-column e-field="Qty" e-headertext="Qty" e-width="80" e-textalign="right"></div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="ClosePackingContentPopUp()" class="btn"><i> Close</i></button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal site-modal in" id="IPPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="row">
            <div class="modal-content">
                <div class="modal-header">Individual Packing<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Pack Id</th>
                                    <th>Individual Pack</th>
                                    <th>Is Confirmed</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in lineItemNo">
                                    <td>
                                        {{x.Id}}
                                    </td>
                                    <td>
                                        @*<input type="text" n-decimals="2" ng-model="x.Sequence" ng-disabled="true" class="form-control text-left">*@
                                        {{x.Sequence}}
                                    </td>
                                    <td>
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="x.IsConfirmed" ng-checked="x.IsConfirmed" ng-disabled="x.State==true">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="CloseIPPopup()" class="btn"><i> Close</i></button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
