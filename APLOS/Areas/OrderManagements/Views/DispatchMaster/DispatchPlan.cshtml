                                <div class="select-style">
                                    <select class="form-control" ng-model="dispatchPlanNew.ApproveBy"
                                            ng-options="item.Id as item.Value for item in ApproveByList" id="ApproveBy"
                                            name="ApproveBy"   tabindex="7">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>



