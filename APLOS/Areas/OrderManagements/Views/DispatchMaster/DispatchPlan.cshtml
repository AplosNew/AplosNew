                                <input type="text" name="FromDate" ng-model="dispatchPlanNew.FromDate" datepicker class="form-control" tabindex="4" maxlength="50">
                            </div>
                        </div>
                        
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Check By<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="dispatchPlanNew.CheckBy"
                                            ng-options="item.Id as item.Value for item in CheckByList" id="CheckById"
                                            name="CheckBy" tabindex="7">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>




                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
