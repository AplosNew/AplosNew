 
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="DispatchPlan" role="tab" data-toggle="tab">DispatchPlan</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="GLpload" role="tab" data-toggle="tab">Plant</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);" href="" aria-controls="DispatchUpdate" role="tab" data-toggle="tab">DispatchUpdate</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <togglable></togglable>
                <div class="form-elements" ng-form id="dispatchPlanNew1" name="dispatchPlanNewForm">
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label">Plant</label>
                            <div class="col-sm-3 col-md-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="dispatchPlanNew.PlantId"
                                            ng-options="item.Value as item.Text for item in companyList">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">From Date</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="FromDate" ng-model="dispatchPlanNew.FromDate" datepicker class="form-control" tabindex="4" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Plan No</label>
                            <div class="col-sm-8 show-message">
                                <input type="text"   name="RevisionNo" ng-model="dispatchPlanNew.PlanNo" class="form-control" tabindex="3" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Checked By<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="dispatchPlanNew.CheckedBy"
                                            ng-options="item.Value as item.Text for item in serviceGroupList" id="serviceGroupId" ng-change="GetHSNCodeByServiceGroupId();"
                                            name="Cost Center SubCategory"  tabindex="7">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>


                        

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="dispatchPlanNew.Active" tabindex="13">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Year No<sup>*</sup></label>
                            <div class="col-sm-3 show-message">
                                <input type="text" name="Code" ng-model="dispatchPlanNew.YearNo" class="form-control" required tabindex="2" maxlength="10">
                            </div>
                            <label class="col-sm-2 control-label">Month No<sup>*</sup></label>
                            <div class="col-sm-3 show-message">
                                    <div class="select-style">
                                        <select name="MonthNo" ng-model="dispatchPlanNew.MonthNo" class="col-sm-3 form-control">
                                            <option value="1">January</option>
                                            <option value="2">February</option>
                                            <option value="3">March</option>
                                            <option value="4">April</option>
                                            <option value="5">May</option>
                                            <option value="6">June</option>
                                            <option value="7">July</option>
                                            <option value="8">August</option>
                                            <option value="9">September</option>
                                            <option value="10">October</option>
                                            <option value="11">November</option>
                                            <option value="12">December</option>
                                        </select>
                                    </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">To Date</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="ServiceSubCategory" ng-model="dispatchPlanNew.ToDate" datepicker class="form-control" tabindex="4" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Close Date</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="FromDate" ng-model="dispatchPlanNew.CloseDate" datepicker class="form-control" tabindex="4" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Approved By<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="dispatchPlanNew.ApprovedBy"
                                            ng-options="item.Value as item.Text for item in serviceGroupList" id="serviceGroupId" ng-change="GetHSNCodeByServiceGroupId();"
                                            name="Cost Center SubCategory"   tabindex="7">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>



                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">By Whom</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" readonly name="ServiceCategory" ng-model="dispatchPlanNew.ServiceCategory" class="form-control" tabindex="3" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Revision No</label>
                            <div class="col-sm-8 show-message">
                                <input type="text"  name="RevisionNo" ng-model="dispatchPlanNew.RevisionNo" class="form-control" tabindex="3" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="ResponsiblePerson" ng-model="responsiblePerson" required style="width:200px;" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="getPopUpData()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" name="Description" ng-model="dispatchPlanNew.Remarks" tabindex="9" maxlength="250"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>
                <div class="aplos-grid-toggle">

                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form="tabForm2" id="Upload">
                <togglable name=" To be Uploaded & Downloaded"></togglable>
                <div class="form-elements form-horizontal row" ng-form name="ModelNewForm">

                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }" ng-form="tabForm3" id="TDSUpload">
                <togglable name=" To be Uploaded & Downloaded"></togglable>
                <div class="form-elements form-horizontal row" ng-form name="ModelNewTDSForm">

                </div>

            </div>
        </div>
    </div>
 
<confirm-modal></confirm-modal>
<div class="modal site-modal" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closePopup('employeeNewPopUp');">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color: black;" id="Grid" ej-grid e-actioncomplete="syncfusiongriddatabound" e-datasource="employee" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-type="string" e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-type="string" e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-type="string" e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-type="string" e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>