                                <input type="text" name="RevisionNo" ng-readonly="dispatchPlanNew.YearNo == null || dispatchPlanNew.MonthNo == null " ng-keyup="getPlanNo()" ng-model="dispatchPlanNew.RevisionNo" class="form-control" tabindex="3" maxlength="50">
