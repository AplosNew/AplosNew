                            <th>SO No</th>
                            <th>PONumber</th>
                            <th>Delivery Date</th>
                            <th>Commitment Date</th>
                            <th>Destination</th>
                            <th>Ship Mode</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in selectedSalesOrderDataList">
                           

                            <td>{{x.SalesOrderId}}</td>
                            <td>{{x.PONumber}}</td>
                            <td>{{x.DeliveryDate}}</td>
                            <td>{{x.CommitmentDate}}</td>
                            <td>{{x.Destination}}</td>
                            <td>{{x.ShipMode}}</td>


                        </tr>

                    </tbody>
                </table>


            </div>
            <ul class="common-btn list-inline text-left" ng-show="selectedSalesOrderDataList.length>0">
                <li>
                    <button ng-click="Save();" ng-disabled="salesVM.PartyId==null" class="btn"><i class="glyphicon glyphicon-step-forward"></i> Next</button>
                </li>
            </ul>
            @*<div class="form-group">
            <label class="col-sm-4 control-label">Production Order<sup>*</sup></label>
            <div class="col-sm-8">
