                        <div e-column e-field="CommitmentDate" e-headertext="Commitment Date" e-width="50" e-textalign="left"></div>
                        <div e-column e-field="Destination" e-headertext="Destination" e-width="50" e-textalign="left"></div>
                        <div e-column e-field="ShipMode" e-headertext="ShipMode" e-width="50" e-textalign="left"></div>

                    </div>
                </div>
