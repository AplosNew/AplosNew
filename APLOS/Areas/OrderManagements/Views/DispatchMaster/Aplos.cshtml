                        </span>
                    </div>
                </div>
            </div>

        </div>


        <div class="clearfix"></div>
        <div class="col-xs-12">
            <ul class="common-btn list-inline text-left">
                <li>
                    <button ng-click="GetSalesOrderDataList();" ng-disabled="salesVM.PartyId==null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Item</button>
                </li>
            </ul>
            <div class="clearfix"></div>
            @*<div ng-show="selectedSalesOrderDataList.length>0">
                <div id="GridSelectedSalesOrder" ej-grid e-datasource="selectedSalesOrderDataList"
                     e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                     e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true">
                    <div e-columns>

                        <div e-column e-field="SO No" e-headertext="SalesOrderId" e-width="50" e-textalign="left"></div>
                        <div e-column e-field="PONumber" e-headertext="PONumber" e-width="150" e-textalign="left"></div>
