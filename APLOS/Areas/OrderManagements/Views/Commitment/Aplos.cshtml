                            <tr dir-paginate="x in buyerList | itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="buyerCloseListPopUp(x)">
                                <td>{{x.BuyerName}}</td>
                                <td>{{x.DepartmentName}}</td>
                                <td>{{x.DivisionName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getBuyerData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmRemovePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteData()"></confirm-archive-generic>