<togglable name="Commitment"></togglable>
<p class="msg-error" ng-show="@ViewBag.flag">*You are not an employee.</p>
<div class="form-horizontal" ng-form="commitmentNewForm">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-element-ctrl form-group" show-errors>
            <label class="col-sm-2 control-label">Production Entity<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="commitmentNew.EntityId" name="Entity" ng-change="onChangeEntity();"
                            ng-options="item.Id as item.UserName for item in entityList" required tabindex="1">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class=" form-elements">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Commitment</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Value Added Process</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Monthly Qty</a></li>
            </ul>
        </div>
