                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Buyer Brand<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="commitmentNew.BuyerBrandId" name="Buyer Brand"
                                            ng-options="item.Value as item.Text for item in buyerBrandList" tabindex="2" required>
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" @*show-errors*@>
                            <label class="col-sm-4 control-label">Buyer @*Style<sup>*</sup>*@</label>
                            <div class="col-sm-8">
                                @*<div class="select-style">
            <select class="form-control" ng-model="commitmentNew.Buyer" name="Buyer"
                    ng-options="item.Value as item.Text for item in ourStyleList" tabindex="4">
                <option value=""></option>
            </select>
        </div>*@
                         <input type="text" name="Buyer" ng-model="commitmentNew.Buyer" class="form-control text-right" tabindex="16">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Season<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="commitmentNew.SeasonId" name="Season"
                                            ng-options="item.Value as item.Text for item in seasonList" required tabindex="6">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Efficiency(in %)<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" only-numbers name="Efficiency" ng-model="commitmentNew.Efficiency" class="form-control text-right" tabindex="8" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Closing Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="LSD" ng-model="commitmentNew.ClosingDate" class="form-control" datepicker tabindex="10" required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">CM<sup>*</sup></label>
                            <div class="col-sm-4 show-message pdr3">
                                <input type="text" n-decimals="2" name="CM" ng-model="commitmentNew.CM" class="form-control text-right" tabindex="12" required style="width: 169px;">
                            </div>
                            <div class="col-sm-4 show-message pdl3">
                                <div class="select-style">
                                    <select name="Currency" class="form-control" ng-model="commitmentNew.CurrencyId"
                                            ng-options="item.Value as item.Text for item in cmcurrencyList" tabindex="14" required>
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">FOB<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text"  n-decimals="2" name="FOB" ng-model="commitmentNew.FOB" class="form-control text-right" tabindex="16" required>
                            </div>
                        </div>
                    </div>
                   
                    
