<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
                @*<tr><th ng-repeat="x in searchList">{{x.Text}}</th></tr>*@
            <thead>
                <tr>
                    <th>CommitmentId</th>
                    <th>FOB</th>
                    <th>SPT</th>
                    <th>Efficiency</th>
                    <th>Target</th>
                    <th>LSD</th>
                    <th>Closing Date</th>
                    <th>Buyer Master</th>
                    <th>Department Name</th>
                    <th>Division Name</th>
                    <th>Buyer Brand</th>
                    <th>Currency</th>
                    <th>Season</th>
                    <th>Buyer Program</th>
                    <th>Buyer</th>
                    <th>Buyer Name</th>
                    <th>Year</th>
                    <th>Remarks</th>
                    <th>ProductMaster</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in commitments |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'commitments'" ng-dblclick="Get(x.Id, $index);">
                    @*<td ng-repeat="hh in searchList">{{x[hh.Value]}}</td>*@
                    <td>{{x.Id}}</td>
                    <td>{{x.FOB}}</td>
                    <td>{{x.SPT}}</td>
                    <td>{{x.Efficiency}}</td>
                    <td>{{x.Target}}</td>
                    <td>{{x.LSD}}</td>
                    <td>{{x.ClosingDate}}</td>
                    <td>{{x.BuyerMaster}}</td>
                    <td>{{x.DepartmentName}}</td>
                    <td>{{x.DivisionName}}</td>
                    <td>{{x.BuyerBrand}}</td>
                    <td>{{x.Currency}}</td>
                    <td>{{x.Season}}</td>
                    <td>{{x.BuyerProgram}}</td>
                    <td>{{x.Buyer}}</td>
                    <td>{{x.BuyerName}}</td>
                    <td>{{x.Year}}</td>
                    <td>{{x.Remarks}}</td>
                    <td>{{x.ProductMaster}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10"
                             pagination-id="metaData.name + 'commitments'"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<modal-table modalid="search_popup"
             data-title="Search (Product Master) Data"
             data-search-parameters="popUpParameters"
             data-exclued-column-list=""
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click=""
             data-double-click="getFinishedGoods(data)"
             data-right-button="false"
             data-left-button="false"
             data-ng-click-left-button=""
             data-ng-click-cancel="">
</modal-table>
<div class="modal fade site-modal in" id="valueAddedProcessSearchModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="glyphicon glyphicon-info-sign"></i> Value Added Process
                </h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="$root.parameters.searchBy">
                                            <option ng-repeat="option in searchByValueAddedProcessList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getValuAddedProcessData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getValuAddedProcessData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Process</th>
                                <th>SubProcess</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in valueAddedProcessList | itemsPerPage:$root.pageSize" total-items="$root.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="{{x.Id}}" ng-model="x.Flag" ng-checked="x.Flag">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.ProcessName}}</td>
                                <td>{{x.SubProcessName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getValuAddedProcessData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="valueAddedProcessCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
