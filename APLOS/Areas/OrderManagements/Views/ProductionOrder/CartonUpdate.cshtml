<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{title}}</h3>
<div class="form-elements form-horizontal">
    <div class="row">
        <div class="col-xs-12">
            <div class="col-md-10">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Carton No</label>
                    <div class="col-sm-8">
                        <input type="text" name="Carton No" ng-enter="GetCartonList();" ng-model="CartId" class="form-control" autocomplete="off" tabindex="5" maxlength="50">
                    </div>

                </div>
            </div>
            <div class="col-md-2">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="GetCartonList();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> Go</button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-xs-12">
            <div style="color:black;" id="GridCart" ej-grid e-datasource="CartonList" e-allowscrolling="true"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-type="string" e-field="CartonId" e-headertext="CartonId" e-width="80"></div>
                    <div e-column e-type="string" e-field="CartonNo" e-headertext="CartonNo" e-width="80"></div>
                    <div e-column e-type="string" e-field="ComboRefNo" e-headertext="ComboRefNo" e-width="80"></div>
                    <div e-column e-type="string" e-field="SKUColor" e-headertext="Color" e-width="80"></div>
                    <div e-column e-type="string" e-field="SKUSize" e-headertext="Size" e-width="80"></div>
                    <div e-column e-type="string" e-field="PlanQty" e-headertext="PlanQty" e-width="80"></div>
                    <div e-column e-type="string" e-template="#ActualQty" e-headertext="ActualQty" e-width="80"></div>
                    <div e-column e-type="string" e-template="#Remarks" e-headertext="Remarks" e-width="80"></div>
                </div>

                <script type="text/template" id="ActualQty">
                    <div class="col-sm-10" style="padding:0px; width:70px;">
                        <input type="text" ng-model="data.ActualQty" n-decimals="2" style="color:black;" class="form-control" />
                    </div>
                </script>
                <script type="text/template" id="Remarks">
                    <div class="col-sm-10" style="padding:0px; width:70px;">
                        <input type="text" ng-model="data.Remarks"  style="color:black;" class="form-control" />
                    </div>
                </script>
            </div>
        </div>
        <div class="common-btn" style="padding-right: 15px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            </ul>
        </div>
    </div>
</div>