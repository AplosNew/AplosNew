<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal">
    <input type="hidden" ng-model="ModelNew.Id">
    <div ng-form name="ModelNewForm">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Packing Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Packing Name" class="form-control" ng-model="ModelNew.PackingId" required
                                ng-options="item.Id as item.UserName for item in PRMCboList" tabindex="1">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Parent PO<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Parent PO" ng-model="ModelNew.ParentPO" class="form-control" maxlength="100" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Gender<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Gender" ng-model="ModelNew.Gender" class="form-control" required tabindex="5" maxlength="30">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Dispatch SO<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Dispatch SO" ng-model="ModelNew.DispatchSO" class="form-control" required tabindex="5" maxlength="100">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Invoice NO</label>
                <div class="col-sm-8">
                    <input type="text" name="Invoice NO" ng-model="ModelNew.InvoiceNO" class="form-control" tabindex="5" maxlength="30">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Billing/Invoicing<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Billing/Invoicing" ng-model="ModelNew.BillingInvoicing" class="form-control" required tabindex="2" maxlength="250">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Destination PO<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Destination PO" ng-model="ModelNew.DestinationPO" class="form-control" required tabindex="2" maxlength="100">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Style Number<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Style Number" ng-model="ModelNew.StyleNumber" class="form-control" required tabindex="4" maxlength="100">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>

        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);GetSKUDetailList();" href="" aria-controls="general" role="tab" data-toggle="tab">SKU Detail</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form="tabFrom1">
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridSKUD" ej-grid e-datasource="SKUDetailList" e-allowscrolling="true"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-visible="false" e-width="80"></div>
                                <div e-column e-type="string" e-field="SalesOrderId" e-headertext="SOId" e-width="80"></div>
                                <div e-column e-type="string" e-field="SKUColor" e-headertext="Color" e-width="80"></div>
                                <div e-column e-type="string" e-field="SKUSize" e-headertext="Size" e-width="80"></div>
                                <div e-column e-template="#OrderQty" e-headertext="Order Qty" e-width="80" style="height: 20px;"></div>
                                <div e-column e-type="string" e-template="#Qty" e-headertext="Qty" e-width="80"></div>
                            </div>

                            <script type="text/template" id="OrderQty">
                                <div class="col-sm-10" style="padding:0px; width:70px;">
                                    <input type="text" ng-model="data.OrderQty" disabled n-decimals="2" style="color:black;" class="form-control" />
                                </div>
                            </script>
                            <script type="text/template" id="Qty">
                                <div class="col-sm-10" style="padding:0px; width:70px;">
                                    <input type="text" ng-model="data.Qty" n-decimals="2" style="color:black;" class="form-control" />
                                </div>
                            </script>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveDispatchChild();" ng-disabled="ModelNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" 
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="ParentPO" e-headertext="ParentPO" e-width="2"></div>
            <div e-column e-field="DestinationPO" e-headertext="DestinationPO" e-width="3"></div>
            <div e-column e-field="BillingInvoicing" e-headertext="BillingInvoicing" e-width="5"></div>
            <div e-column e-field="StyleNumber" e-headertext="StyleNumber" e-width="5"></div>
            <div e-column e-field="Gender" e-headertext="Gender" e-width="5"></div>
            <div e-column e-field="DispatchSO" e-headertext="DispatchSO" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>