
<togglable name="Sub Production Order"></togglable>
<div class="form-horizontal form-elements" ng-form="modelNewSPOForm">
    <div class="row">

        @*<div class="form-group">
                <label class="col-sm-4 control-label">Production Order</label>
                <div class="input-group">
                    <div class="input-group col-sm-8">
                        <input type="text" name="EmployeeName" ng-model="leaveApplicationNew.EmployeeName" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="getPopUpData()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>

                </div>
            </div>*@
        <div class="col-xs-12">
            <div style="color:black;" id="GridSPO" ej-grid e-datasource="ProductionOrderList" e-allowscrolling="true"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" @*e-recorddoubleclick="SetPrOData"*@
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                    <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="80"></div>
                    <div e-column e-type="string" e-field="StyleNo" e-headertext="BuyerRef#" e-width="50"></div>
                    <div e-column e-type="string" e-field="OwnStyleNo" e-headertext="Own Ref#" e-width="50"></div>
                    <div e-column e-type="string" e-field="Product" e-headertext="Product" e-width="80"></div>
                    <div e-column e-type="string" e-field="POId" e-headertext="PO No" e-width="80"></div>
                    <div e-column e-type="string" e-field="POStatus" e-headertext="PO Status" e-width="80"></div>
                    <div e-column e-type="string" e-field="SONos" e-headertext="SOId" e-width="80"></div>
                    <div e-column e-type="string" e-field="SOStatus" e-headertext="SO Status" e-width="80"></div>
                    <div e-column e-type="number" e-format="{0:0.00}" e-field="SOQty" e-headertext="SOQty" e-width="80" e-textalign="right"></div>
                    <div e-column e-type="string" e-field="LineItemId" e-headertext="LineItemId" e-width="80"></div>

                </div>
            </div>
        </div>
        <div class="col-xs-12" ng-form="SPONewForm">

            <div class="col-sm-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">SKU1</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="ModelNewSPO.SKU1" ng-change="SetCheckbox('sku1');">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">SPT<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="SPT" n-decimals="2" ng-model="ModelNewSPO.SPT" required class="form-control" tabindex="4" maxlength="50">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Plan Hour<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="PlanHour" n-decimals="2" ng-model="ModelNewSPO.PlanHour" required class="form-control" tabindex="4" maxlength="50">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Commitment Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="CommitmentDate" ng-model="ModelNewSPO.CommitmentDate" datepicker class="form-control" required>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">SKU2</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="ModelNewSPO.SKU2" ng-change="SetCheckbox('sku2');">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Plan Percentage<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="SPT" n-decimals="2" ng-model="ModelNewSPO.PlanPercentage" class="form-control" required tabindex="4" maxlength="50">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Net Utilization Percentage<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" title="Net Utilization Percentage" name="Net Utilization Percentage" n-decimals="2" ng-model="ModelNewSPO.NetUtilizationPercentage" required class="form-control" tabindex="4" maxlength="50">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Main RM Inhouse Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="MainRawMaterialInhouseDate" ng-model="ModelNewSPO.MainRawMaterialInhouseDate" datepicker class="form-control" required>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Both</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="ModelNewSPO.Both" ng-change="SetCheckbox('both');">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Min Qty<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="MinQty" n-decimals="2" ng-model="ModelNewSPO.MinQty" class="form-control" required tabindex="4" maxlength="50">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">LSD<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="LSD" ng-model="ModelNewSPO.LSD" datepicker class="form-control" required>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Other RM Inhouse Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="OtherRawMaterialInhouseDate" ng-model="ModelNewSPO.OtherRawMaterialInhouseDate" datepicker class="form-control" required>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Workstations<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Workstations" n-decimals="2" ng-model="ModelNewSPO.NoOfWorkStation" class="form-control" required tabindex="4" maxlength="50">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">First Day Output/Hour<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="number" ng-disabled="SPTEfficiencySlab.length>0" ng-change="calculations()" inputmode="numeric" class="form-control" rows="2" ng-model="ModelNewSPO.FirstDayOutPut" maxlength="250" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Priority<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="number" inputmode="numeric" class="form-control" rows="2" ng-model="ModelNewSPO.ProductionPriority" maxlength="250" />
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="GetSKUData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-ok-circle"></i> Go </button></li>
                        <li> <button ng-click="SaveSPO();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-save"></i> Save </button></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-xs-12">
            <div style="color:black;" id="GridSKU12" ej-grid e-datasource="sku1sku2List" e-allowscrolling="true"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-type="string" e-field="SKUColor" e-headertext="Color" e-width="80"></div>
                    <div e-column e-type="string" e-field="SKUSize" e-headertext="Size" e-width="80"></div>
                    <div e-column e-type="string" e-field="Qty" e-headertext="Qty" e-width="80"></div>
                    <div e-column e-template="#AdjustableQty" e-headertext="AdjustableQty" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-field="Qty" e-width="80" style="height: 20px;"></div>
                    <div e-column e-template="#SPT" e-headertext="SPT" e-width="80" style="height: 20px;"></div>
                    <div e-column e-headertext="WCGroup" e-template="#ShowWCGroupButtons" e-width="120"></div>
                    <div e-column e-template="#PlanHour" e-headertext="PlanHour" e-width="80" style="height: 20px;"></div>
                    <div e-column e-template="#NetUtilizationPercentage" e-headertext="NetUtilizationPercentage" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-template="#RequiredMachineDays" e-headertext="RequiredMachineDays" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-template="#MinWorkCenterDays" e-headertext="MinWorkCenterDays" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-template="#Workstations" e-headertext="Workstations" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-template="#MaximumAllowedWorkCenter" e-headertext="MaximumAllowedWorkCenter" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-template="#AllotedWorkCenter" e-headertext="AllotedWorkCenter" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-template="#DayToReachTheTarget" e-headertext="DayToReachTheTarget" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-template="#IncrementValue" e-headertext="IncrementValue" e-width="80" style="height: 20px;"></div>

                    <div e-column e-type="string" e-field="LSD" e-headertext="LSD" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-field="CommitmentDate" e-headertext="CommitmentDate" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-field="MainRawMaterialInhouseDate" e-headertext="MainRawMaterialInhouseDate" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-field="OtherRawMaterialInhouseDate" e-headertext="OtherRawMaterialInhouseDate" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-template="#TargetPerHour" e-headertext="TargetPerHour" e-width="80" style="height: 20px;"></div>
                    <div e-column e-type="string" e-template="#TargetPerDay" e-headertext="TargetPerDay" e-width="80" style="height: 20px;"></div>

                    @*<div e-column e-type="string" e-template="#PrefenceWorkCenter" e-headertext="PrefenceWorkCenter" e-width="80" style="height: 20px;"></div>
                <div e-column e-type="string" e-template="#RunningWorkCenter" e-headertext="RunningWorkCenter" e-width="80" style="height: 20px;"></div>*@
                </div>
            </div>
            <script type="text/template" id="SPT">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="data.SPT" @*e-change="data.TotalSPT=data.AdditionalSPT+data.OperationSPT"*@ e-width="80" />
                </div>
            </script>
            <script type="text/template" id="PlanHour">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="data.PlanWorkingHoursPerDay" e-width="80" />
                </div>
            </script>
            <script type="text/template" id="AdjustableQty">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="data.AdjustableQty" e-change="$parent.calculate" e-width="80" />
                </div>
            </script>
            <script type="text/template" id="NetUtilizationPercentage">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="data.Efficiency" e-width="80" />
                </div>
            </script>
            <script type="text/template" id="RequiredMachineDays">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" name="RequiredLineDays" ng-disabled="true" ng-model="data.RequiredLineDays" class="form-control">
                </div>
            </script>
            <script type="text/template" id="MinWorkCenterDays">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" name="MinimumLineDays" ng-disabled="true" ng-model="data.MinimumLineDays" class="form-control">
                </div>
            </script>
            <script type="text/template" id="MaximumAllowedWorkCenter">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" name="MaximumAllowedWorkCenter" ng-disabled="true" ng-model="data.MaximumAllowedWorkCenter" class="form-control">
                </div>
            </script>
            <script type="text/template" id="Workstations">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" name="NoOfWorkStation" ng-model="data.NoOfWorkStation" class="form-control">
                </div>
            </script>
            <script type="text/template" id="AllotedWorkCenter">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" name="AllocatedLines" ng-keydown="$parent.CheckMaxWCValue(this);" ng-model="data.AllocatedLines" class="form-control">
                </div>
            </script>
            <script type="text/template" id="DayToReachTheTarget">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" name="DayToReachTheTarget" ng-disabled="true" ng-model="data.DayToReachTheTarget" class="form-control">
                </div>
            </script>
            <script type="text/template" id="TargetPerHour">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" name="TargetPerHour" ng-disabled="true" ng-model="data.TargetPerHour" class="form-control">
                </div>
            </script>
            <script type="text/template" id="TargetPerDay">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" name="TargetPerDay" ng-disabled="true" ng-model="data.TargetPerDay" class="form-control">
                </div>
            </script>
            <script type="text/template" id="IncrementValue">
                <div class="col-sm-10" style="padding:0px; width:70px;">
                    <input type="text" name="IncrementValue" ng-disabled="true" ng-model="data.IncrementValue" class="form-control">
                </div>
            </script>
            <script type="text/template" id="ShowWCGroupButtons">
                <div class="col-sm-8" style="padding: 0px; width: 70px;">
                    <input type="text" name="WorkCenterGroupId" ng-model="data.WorkCenterGroup" ng-disabled="true" ng-click="" class="form-control" maxlength="200">
                </div>
                <div class="col-sm-2 text-left" style="padding: 0px; padding-left: 2px; width: 20px;">
                    <button ng-click="$parent.GetWorkCenterGroup(this);" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                </div>
            </script>
            @*<script type="text/template" id="ShowWCMButtons">
            <div class="col-sm-2 text-left" style="padding: 0px; padding-left: 2px; width: 20px;">
                <button ng-click="$parent.GetWorkCenterGroup(this);" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
            </div>
        </script>*@
        </div>
    </div>


</div>

<div class="modal fade site-modal in" id="WCGPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Work Center Group<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div id="GridWCG" ej-grid e-datasource="wcgList"
                     e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="false" e-recorddoubleclick="selectWCG"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true" e-allowResizing="true">
                    <div e-columns>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false"></div>
                        <div e-column e-field="Code" e-headertext="Code" e-width="40"></div>
                        <div e-column e-field="ShortName" e-headertext="ShortName" e-width="100"></div>
                        <div e-column e-field="UserName" e-headertext="UserName" e-width="80"></div>
                        <div e-column e-field="StandardName" e-headertext="StandardName" e-width="80"></div>
                        <div e-column e-field="WorkCenterMaster" e-headertext="WorkCenterMaster" e-width="80"></div>>
                    </div>
                </div>
                <div class="common-btn" style="padding-right: 15px;">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="CloseWCG();" class="btn">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<ej-dialog id="workCenterPopUp" title=" Work Center" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-width="550" e-target="#tarekcontainer" e-open="enableBtn">
    <div class="row" style="width:540px">
        <div class="col-xs-12 col-sm-12">
            <div id="GridSelectWC" ej-grid e-datasource="workCenterList"
                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="true" e-responsive="true"
                 e-allowscrolling="true"
                 e-allowselection="false" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-template="#workcenterselect" e-headertext="" e-width="1"></div>
                    <div e-column e-field="Plant" e-headertext="Plant" e-width="3"></div>
                    <div e-column e-field="Entity" e-headertext="Entity" e-width="3"></div>
                    <div e-column e-field="Code" e-headertext="Code" e-width="2"></div>
                    <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
                </div>

            </div>
            <script type="text/template" id="workcenterselect">
                @*<input type="checkbox" ej-checkbox class="nodetext" e-value="data.Flag" e-checked="data.Flag" />*@
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="data.Flag" ng-checked="data.Flag" ng-click="$parent.workcenterfor=='RUNNING'?$parent.genericPushInTempList(data,$event, $parent.runningWorkCenterList, 'WorkCenterMasterId', 'WorkCenterMasterId'):$parent.genericPushInTempList(data,$event, $parent.productionWorkCenterList, 'WorkCenterMasterId', 'WorkCenterMasterId')">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </script>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="AddNewWorkCenter();" class="btn">Done</button></li>
            </ul>
        </div>
    </div>
</ej-dialog>
