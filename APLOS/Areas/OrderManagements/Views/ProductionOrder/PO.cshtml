<togglable name="Production Order Type2"></togglable>
<div class="form-horizontal form-elements" ng-form="modelNewForm" id="mainPOContainer">
    <div class="col-xs-6 col-sm-6 col-md-6" id="ProductionEntity">
        <br />
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Planning Type Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Planning Type Process" ng-model="model.PlanningTypeProcessId" class="col-sm-3 form-control"
                            ng-options="item.Id as item.UserName for item in planningTypeProcessList" ng-change="GetPlanningTypeEntiy();" tabindex="2" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Required Time Unit<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Required time unit" ng-model="model.RequiredTimeUnit" class="col-sm-3 form-control" ng-disabled="prdProcessSetList.length>0"
                            ng-options="item.Value as item.Text for item in requiredTimeUnitList" required tabindex="3">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Production Order ID</label>
            <label class="col-sm-8 control-label">{{model.Id}}</label>

        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Upload Picture</label>
            <div class="col-sm-8">
                <div id="UploadDefault" e-dialogtext-title="Product Picture" e-autoupload="true" e-begin="onBeginUpload" e-filesize="2097152" ej-uploadbox e-saveurl="uploadUrl" e-multiplefilesselection=false e-extensionsallow=".jpg,.bmp,.png,.jpeg" e-error="errorPicUpload"></div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Order Qty</label>
            <label class="col-sm-3 control-label"> <input type="text" name="Qty" ng-model="model.Qty" class="form-control" tabindex="5" n-decimals="2"></label>
            <label class="col-sm-2 control-label">Planned Qty</label>
            <label class="col-sm-3 control-label"> <input type="text" name="Qty" ng-model="model.PlannedQty" class="form-control" tabindex="5" n-decimals="2"></label>
        </div>

    </div>
    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">MO Entity</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <input id="moentityDropdown" ej-dropdownlist e-multiselectmode="visualmode" e-watermarktext="All" e-datasource="moentityList" e-fields-value="Id" e-fields-text="UserName" e-width="100%" e-showcheckbox="true" />
                </div>

            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Entity" ng-model="model.EntityId" class="col-sm-3 form-control"
                            ng-options="item.Id as item.UserName for item in entityList" tabindex="1" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Production Status</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select name="Production Status" class="form-control" ng-model="model.ProductionStatusId"
                            ng-options="item.Value as item.Text for item in productionStatusList" tabindex="2">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" name="Remarks" rows="2" ng-model="model.Remarks" maxlength="250" tabindex="4"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Is Pre-Define Lot Applicable</label>
            <div class="col-sm-8" style="padding-top: 8px;">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="model.IsPreDefineLotApplicable" ng-disabled="lotControlList.length>0 || model.UsedInPB==true" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Is WorkCenter Validate Applicable</label>
            <div class="col-sm-8" style="padding-top: 8px;">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="model.IsWorkCenterValidateApplicable" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-disabled="btndisable" ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
            <li><button ng-disabled="DisableActionButtons" ng-click="Confirm();" class="btn"><i class="glyphicon glyphicon-floppy-remove" tabindex="9"></i> Delete</button></li>
            <li><button ng-disabled="DisableActionButtons" ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
        </ul>
    </div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Material</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Process Set</a></li>
            @*<li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Work Center</a></li>
            <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" data-toggle="tab">First Process Work Center</a></li>
            <li ng-show="model.IsPreDefineLotApplicable==true" role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" data-toggle="tab">Lot Control</a></li>*@
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row" ng-form="tabFrom1">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <ul class="common-btn list-inline text-left">
                        <li><button ng-click="recipeMaterialPopUp();" ng-disabled="model.EntityId==null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Sales Order</button></li>
                    </ul>
                </div>
            </div>
            @*e-create="create"*@@*e-minwidth="350px" e-minheight="300px"*@
            <div id="GridSOItemSelected" ng-init="chkinit()" ej-grid e-datasource="recipeMaterialListSelected"
                 e-allowscrolling="true" e-actioncomplete="actionCompleteSelected"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-showsummary="true" e-summaryrows="summaryRows" @*e-editsettings-allowediting="true" e-editsettings-editmode="batch"*@
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="ProductName" e-headertext="Product" e-width="180" e></div>
                    <div e-column e-field="ArticleName" e-headertext="Article" e-width="180"></div>
                    <div e-column e-field="SalesOrderId" e-headertext="SO. ID" e-width="120"></div>

                    <div e-column e-field="DestinationName" e-headertext="Dest." e-width="80"></div>
                    <div e-column e-field="DestinationDescription" e-headertext="Dest. Description" e-width="80"></div>
                    <div e-column e-field="BuyerOrderNo" e-headertext="Customer Order#" e-width="100"></div>
                    <div e-column e-field="BuyerReferenceNo" e-headertext="Customer Item#" e-width="100"></div>
                    <div e-column e-field="DeliveryWeek" e-headertext="Del. Week" e-width="80"></div>
                    <div e-column e-field="DeliveryDate" e-headertext="Del. Date" e-width="80"></div>
                    <div e-column e-field="CommitmentDate" e-headertext="Commi.Date" e-width="80"></div>
                    <div e-column e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
                    <div e-column e-field="MasterOrderNo" e-headertext="M. Order No" e-width="120"></div>
                    <div e-column e-field="Qty" e-headertext="Qty" e-width="80" e-textalign="right"></div>
                    <div e-column e-field="Customer" e-headertext="Customer" e-width="180"></div>
                    <div e-column e-field="Buyer" e-headertext="Buyer" e-width="180"></div>
                    <div e-column e-field="OwnOrderNo" e-headertext="Own Order#" e-width="100"></div>

                    <div e-column e-field="OwnReferenceNo" e-headertext="Own Item#" e-width="100"></div>
                    <div e-column e-field="ProductionGrouping" e-headertext="Product Grouping" e-width="120" e></div>
                    <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="180" e></div>
                    <div e-column e-field="ShipmentModeName" e-headertext="Ship.Mode" e-width="80"></div>
                    <div e-column e-field="ProductionOrderId" e-headertext="PO No" e-width="80"></div>
                    <div e-column e-field="OrderStatusName" e-headertext="Ord. Status" e-width="80"></div>
                    <div e-column e-field="OrderCategoryName" e-headertext="Ord. Cat." e-width="80"></div>
                    <div e-column e-field="LSD" e-headertext="LSD" e-width="80"></div>

                    <div e-column e-type="boolean" e-field="Consignment" e-headertext="Consignment" e-width="60"></div>
                    <div e-column e-type="string" e-field="OrderOwner" e-headertext="Order Owner" e-width="180"></div>
                    <div e-column e-type="string" e-field="Type" e-headertext="Type" e-width="80"></div>

                </div>
            </div>


        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row" ng-form="tabFrom2">
                <div class="col-xs-12">
                    <ul class="common-btn list-inline text-left">
                        <li><button ng-click="processSetPopUp();" ng-disabled="model.EntityId==null" class="btn"><i class="glyphicon glyphicon-plus"></i> Process Set</button></li>
                        <li><button ng-click="processPopUp();" ng-disabled="model.EntityId==null" class="btn"><i class="glyphicon glyphicon-plus"></i> Production Process</button></li>
                    </ul>
                </div>
                <div class="col-xs-12 table-responsive modal-table" ng-show="prdProcessSetList.length>0">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th ng-show="prdProcessSetList.length>1">Sort</th>
                                <th>Relay Sequence</th>
                                <th>Process</th>
                                <th style="width: 74px;">Base Process</th>
                                <th style="width: 74px;">IsInventory</th>
                                <th>+/-</th>
                                <th style="width: 130px;">Lead/Lag Days</th>
                                <th style="width: 130px;">Production Cycle Time({{model.RequiredTimeUnit}})/Per unit</th>
                                <th>Material</th>
                                <th>Article</th>
                                <th>(%)Actual Plan Qty</th>
                                <th>UoM</th>
                                <th>Production Booking Level</th>
                                <th style="width: 10px">Job Work Applicable</th>
                                <th style="width: 170px;">Job Work Type</th>
                                <th>Entity/Vendor</th>
                                <th style="width: 74px;">Production Verification</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in prdProcessSetList" ng-class="{selected : x.class=='new'}">
                                <td ng-show="prdProcessSetList.length>1">
                                    <span ng-show="!$first" ng-click="moveUp($index, prdProcessSetList, x.Sequence)"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                    <br />
                                    <span ng-show="!$last" ng-click="moveDown($index, prdProcessSetList, x.Sequence)"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                </td>
                                <td><input type="text" name="Relay Sequence" ng-model="x.RelaySequence" class="form-control" style="width: 80px;"></td>
                                <td>{{x.ProcessName}}</td>
                                <td class="text-center">
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="optradio" ng-checked="x.IsBaseProcess" ng-click="setPlusOrMinus($event,$index)" value="" />
                                            <span class="cr"><i class="cr-icon"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="IsInventory" ng-checked="x.IsInventory" ng-click="setIsInventory($event,$index)" value="" />
                                            <span class="cr"><i class="cr-icon"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Symbol}}</td>
                                <td><input type="text" ng-model="x.Days" class="form-control" only-numbers ng-disabled="x.IsBaseProcess"></td>
                                <td><input type="text" ng-model="x.ProductionCycleTime" class="form-control" only-numbers></td>
                                <td>
                                    <div class="input-group">
                                        <input type="text" name="Customer" ng-model="x.MaterialMasterName" class="form-control" readonly style="width: 80px;">
                                        <span class="input-group-btn">
                                            <button ng-click="getMaterial($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-group">
                                        <input type="text" name="Customer" ng-model="x.ArticleName" class="form-control" readonly style="width: 80px;">
                                        <span class="input-group-btn">
                                            <button ng-click="getArticle($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                            <button ng-click="clearArticle($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" n-decimals="2" ng-model=" x.Qty" style="width: 50px;" class="form-control text-right" />
                                </td>
                                <td>
                                    <div class="select-style">
                                        @*<select name="UOM" style="width: 60px; padding-top:8px;" class="form-control" ng-model="x.UOMId" ng-options="item.Value as item.Text for item in uOMList"></select>*@
                                        <select style="width: 60px;" class="form-control" ng-model="x.UOMId" ng-options="item.Value as item.Text for item in uOMList| filter:{ MaterialMasterId: x.MaterialMasterId }:true"></select>
                                    </div>
                                </td>
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.ProductionBookingLevel" ng-options="item.Value as item.Text for item in productionBookingLevelList" style="width: 130px;">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.JobWorkApplicable" ng-checked="x.JobWorkApplicable" ng-click="clearJobType(prdProcessSetList, $index);clearEntityOrVendor(prdProcessSetList, $index);" />
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.JobWorkType" ng-disabled="!x.JobWorkApplicable" ng-change="clearEntityOrVendor(prdProcessSetList, $index);"
                                                style="width: 135px;" ng-options="item.Value as item.Text for item in jobWorkTypeList">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </td>
                                <td>
                                    <input type="hidden" ng-model="x.EntityIdWithinCompany">
                                    <input type="hidden" ng-model="x.EntityIdWithinGroup">
                                    <input type="hidden" ng-model="x.PartyId">

                                    <div class="input-group">
                                        <input type="text" name="EntityOrVendorName" ng-model="x.EntityOrVendorName" class="form-control" readonly style="width: 80px;">
                                        <span class="input-group-btn">
                                            <button style="height: 27px;margin-top: 2px;margin-left: 0px" class="btn" ng-click="popUp($index)" ng-disabled="!x.JobWorkApplicable"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                            <button style="height: 27px;margin-top: 2px;margin-left: 0px" class="btn" ng-click="clearEntityOrVendor(prdProcessSetList, $index);" ng-disabled="!x.JobWorkApplicable"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="IsProductionVerification" ng-checked="x.IsProductionVerification" ng-click="setIsProductionVerification($event,$index)" value="" />
                                            <span class="cr"><i class="cr-icon"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="valuePassInDelModal(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-remove"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>

                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
            <div class="row" ng-form="tabFrom4">
                <div class="col-xs-12 col-sm-6 col-md-6" style="height:48px;">
                    <ul class="common-btn list-inline text-left">
                        <li><button ng-click="workCenterPopUp('PREFERENCE');" ng-disabled="model.EntityId==null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Work Center</button></li>
                    </ul>
                </div>
                <div class="col-md-12">
                    <div id="GridWorkCenter" ng-init="chkinit()" ej-grid e-datasource="productionWorkCenterList" e-rowdatabound="rowDataBoundWorkCenter"
