                            <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                            <div e-column e-field="UserName" e-headertext="Work Center" e-width="180"></div>

                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
            <div class="row" ng-form="tabFrom5">
                <div class="col-xs-12 col-sm-6 col-md-6" style="height:48px;">
                    <ul class="common-btn list-inline text-left">
                        <li><button ng-click="GetWorkCenterListByEntityandFirstProcess();" ng-disabled="model.EntityId==null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Work Center</button></li>
                    </ul>
                </div>
                <div class="col-md-12">
                    <div id="GridFPWorkCenter" ej-grid e-datasource="productionFPWorkCenterList"
                         e-allowpaging="true" e-enabletouch="false" e-responsive="true">
                        <div e-columns>
                            <div e-column e-headertext="Actions" e-template="#ShowActionButtonsBOM" e-width="60"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="150"></div>
                            <div e-column e-field="Entity" e-headertext="Entity" e-width="120"></div>
                            <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                            <div e-column e-field="UserName" e-headertext="Work Center" e-width="180"></div>
                            <div e-column e-field="Remark" e-headertext="Remark" e-width="180"></div>
                        </div>
                    </div>
                    <script type="text/template" id="ShowActionButtonsBOM">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeFPWCDetail(this);" style="margin: -6px;"></i></button>
                    </script>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(6), active: isSet(6) }">
            <div class="row" ng-form="tablcFrom" ng-show="model.IsPreDefineLotApplicable==true">
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">User LotNo</label>
                        <div class="col-sm-3">
                            <input type="text" name="UserDefineLotNo" ng-model="model.UserDefineLotNo" ng-disabled="model.UsedInPB==true" class="form-control" tabindex="5" maxlength="50">
                        </div>
                    </div>

                </div>
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="GetPOLotControlData();" ng-disabled="model.UsedInPB==true" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Go</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <label class="col-sm-12 control-label">{{pbookingmessage}}</label>
                <div class="col-xs-12">
                    <div id="GridLC" ej-grid e-datasource="lotControlList" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-allowselection="true" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
