@{
    ViewBag.Title = "OrderControlStage";
}
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Order Control Stage<a href="javascript:void(0)" class="form-collapse pull-right"></a></h3>
<div class="" ng-controller="orderControlStageController">
    <div class="form-elements">
        <input type="hidden" ng-model="orderConSt.Id">
        <input type="hidden" ng-model="orderConSt.AddedBy">
        <input type="hidden" ng-model="orderConSt.AddedDate">
        <input type="hidden" ng-model="orderConSt.AddedFromIP">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group">
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ng-model="orderConSt.Sequence" class="form-control" required placeholder="0">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ng-model="orderConSt.Code" class="form-control" required>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ng-model="orderConSt.ShortName" class="form-control" required>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ng-model="orderConSt.StandardName" class="form-control" required>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ng-model="orderConSt.UserName" class="form-control" required>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="orderConSt.Description"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="orderConSt.Remarks"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox">
                        <input type="checkbox" class="css-checkbox" id="active" ng-model="orderConSt.IsActive">
                        <label class="css-label" for="active"></label>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Show();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button></li>
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button ng-click="Delete()" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sequence</th>
                    <th>Code</th>
                    <th>Short Name</th>
                    <th>Standard Name</th>
                    <th>User Name</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in orderConSts" ng-click="Get(x.Id);">
                    <td>{{x.Sequence}}</td>
                    <td>{{x.Code}}</td>
                    <td>{{x.ShortName}}</td>
                    <td>{{x.StandardName}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.IsActive?'Yes':'False'}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <nav class="table-pagination">
        <ul compile="myHTML" class="list-inline text-center"></ul>
    </nav>
</div>
