<togglable name="Order Date Setting"></togglable>
<div class="form-horizontal" ng-form name="lsdNewForm">
    <input type="hidden" ng-model="lsdNew.Id">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-element-ctrl form-group" show-errors>
            <label class="col-sm-2 control-label">Buyer<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="lsdNew.BuyerId" name="Buyer" ng-change="getData();"
                            ng-options="item.Value as item.Text for item in buyerList" required tabindex="1">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Ship Mode<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="lsdNew.ShipModeId" name="Ship mode" id="shipModeId"
                                ng-options="item.Value as item.Text for item in shipModeList" required tabindex="1">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Order Lead Time<sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <input type="number" name="Order lead time" ng-model="lsdNew.OrderLeadTime" class="form-control" required tabindex="3">
                </div>
                <label class="col-sm-4 control-label">Days</label>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Ex-Factory Lead Time<sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <input type="number" name="Ex-Factory lead time" ng-model="lsdNew.ExFactoryLeadTime" class="form-control" required tabindex="5">
                </div>
                <label class="col-sm-4 control-label">Days Before Delivary Date</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Main RM Inhouse Lead Time<sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <input type="number" name="Main Raw Material Inhouse Lead Time" ng-model="lsdNew.MainRawMaterialInhouseLeadTime" class="form-control" required tabindex="7">
                </div>
                <label class="col-sm-4 control-label">Days Before LSD</label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Weekend</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select name="Weekend" class="form-control" ng-model="lsdNew.Weekend" ng-options="item.Value as item.Text for item in dayList">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group"></div>
            <br /><br />
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Lead Time<sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <input type="number" name="Production lead time" ng-model="lsdNew.ProductionLeadTime" class="form-control" required tabindex="4">
                </div>
                <label class="col-sm-4 control-label">Days required for Production</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Finishing Lead Time<sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <input type="number" name="Finishing lead time" ng-model="lsdNew.FinishingLeadTime" class="form-control" required tabindex="6">
                </div>
                <label class="col-sm-4 control-label">Days required for Finishing</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Other RM Inhouse Lead Time<sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <input type="number" name="Other Raw Material Inhouse Lead Time" ng-model="lsdNew.OtherRawMaterialInhouseLeadTime" class="form-control" required tabindex="8">
                </div>
                <label class="col-sm-4 control-label">Days Before LSD</label>
            </div>
            
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ship ModeName</th>
                <th>Order Lead Time</th>
                <th>Production Lead Time</th>
                <th>Finishing Lead Time</th>
                <th>ExFactory Lead Time</th>
                <th>Weekend</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in lsds |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.ShipModeName}}</td>
                <td>{{x.OrderLeadTime}}</td>
                <td>{{x.ProductionLeadTime}}</td>
                <td>{{x.FinishingLeadTime}}</td>
                <td>{{x.ExFactoryLeadTime}}</td>
                <td>{{x.Weekend}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>