<togglable name="Product Integrity Analysis Master"></togglable>
<div class="form-elements form-horizontal">
    <div class="row" ng-form="ProductIntegrityAnalysisMasterForm">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="PIAMNew.Code " class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="PIAMNew.StandardName" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="PIAMNew.ShortName" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 contro-label">Responsible Person<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Responsible Person" ng-disabled="true" ng-model="PIAMNew.ResponsiblePerson" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectResponsiblePerson();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="PIAMNew.UserName" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <input type="text" name="Description" ng-model="PIAMNew.Description" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <input type="text" name="Remarks" ng-model="PIAMNew.Remarks" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">IsActive</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="PIAMNew.Active" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-12 control-label"></label>
        <label class="col-sm-12 control-label"></label>
    </div>
    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(0) }"><a ng-click="setTab(0)" href="" aria-controls="doc" role="tab" data-toggle="tab">Item</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" ng-form="PIAMItemForm" class="tab-pane fade" ng-class="{ 'in':isSet(0), active: isSet(0) }">
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">SNO<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="SNO" ng-disabled="true" ng-model="ItemNew.SNO" class="form-control" required maxlength="100" autocomplete="off">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Name" ng-model="ItemNew.Category" class="form-control" required maxlength="100" autocomplete="off">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Item Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Name" ng-model="ItemNew.ItemName" class="form-control" required maxlength="100" autocomplete="off">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 contro-label">UOM<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="UOM" ng-disabled="true" ng-model="ItemNew.UOM" class="form-control" maxlength="100" required autocomplete="off">
                        </div>
                <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectUOM();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Production Process<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ItemNew.ProcessId" name="Process"  required
                                    ng-options="item.Value as item.Text for item in ProcessList">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Critical Level<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ItemNew.CriticalLevel" name="Critical Level" required
                                    ng-options="item.Value as item.Text for item in CriticalLevelLists">
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <input type="text" name="Remarks" ng-model="ItemNew.Remarks" class="form-control" maxlength="100" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-disabled="PIAMNew.Id===null" ng-click="ItemSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                    <li> <button ng-click="removeRowModal($index,ItemNew.Id);" ng-disabled="ItemNew.Id===null" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete </button></li>
                    <li> <button ng-click="ItemClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
            @*<div class="col-xs-12 col-sm-12 col-md-12">*@
            <div id="GridItem" ej-grid e-datasource="ProductAnalysisItemList" e-recorddoubleclick="GetItemDetails"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Item Id" e-visible="false" e-width="3"></div>
                    <div e-column e-field="SNO" e-headertext="SNO" e-width="3"></div>
                    <div e-column e-field="Process" e-headertext="Process" e-width="3"></div>
                    <div e-column e-field="ItemName" e-headertext="Item Name" e-width="3"></div>
                    <div e-column e-field="Category" e-headertext="Category" e-width="3"></div>
                    <div e-column e-field="CriticalLevel" e-headertext="Critical Level" e-width="3"></div>
                    <div e-column e-field="UOM" e-headertext="UOM" e-width="3"></div>
                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                    <div e-column e-template="#Parameter" e-headertext="Validation" e-width="2"></div>
                </div>
            </div>
            <script type="text/template" id="Parameter">
                <div class="form-group">
                    <div class="col-sm-5 text-left" style="padding:0px;padding-left:2px">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click=";$parent.GetItemDetails(this);$parent.getParameterPopup(this);" class="btn"><i class="glyphicon glyphicon-list"></i></button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </script>
            @*</div>*@
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridProductIntegrityAnalysisMaster" ej-grid e-datasource="ProductIntegrityAnalysisMasterList" e-recorddoubleclick="GetDetails"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="50"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="100"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="100"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
            <div e-column e-field="Description" e-headertext="Description" e-width="150"></div>
            <div e-column e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="100"></div>
            <div e-column e-field="Active" e-headertext="Is Active" e-width="100"></div>
        </div>
    </div>   
</div>
<confirm-modal></confirm-modal>

<div class="modal fade site-modal in" id="ResponsiblePersonPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Employee List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Employee</p>
                        <div style="color:black;" id="GridResponsiblePersonPopUp" ej-grid e-datasource="EmployeeList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleEmployee">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="Id" e-visible="false" e-width="120"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="120"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="120"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="120"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="120"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeResponsiblePersonPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="UOMPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">UOM<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an UOM</p>
                        <div style="color:black;" id="GridUOM" ej-grid e-datasource="UOMList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleUOM">
                            <div e-columns>
                                <div e-column e-field="UOMId" e-headertext="Id" e-width="30"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="30"></div>
                                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="30"></div>
                                <div e-column e-field="UOM" e-headertext="User Name" e-width="30"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeUOMPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="ParameterPoUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Parameter<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-element-ctrl form-horizontal">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal" style="padding-left:0px;">
                        <div class="form-group" style="margin-bottom: 0px;">
                            <label class="col-sm-3 control-label">Predefine Value</label>
                            <label class="col-sm-3 control-label">Remarks</label>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal" style="padding-left:0px;">
                        <div class="form-group">
                            <div class="col-sm-3">
                                <input type="number" ng-model="ParameterNew.PredefineValue" class="form-control" maxlength="200">
                            </div>
                            <div class="col-sm-3">
                                <input type="text" ng-model="ParameterNew.Remarks" class="form-control" maxlength="200">
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="col-xs-12">
                        <div id="GridParameter" ej-grid e-datasource="ParameterLists" e-recorddoubleclick="GetParameterDetails"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Item Id" e-visible="false" e-width="3"></div>
                                <div e-column e-field="ItemId" e-headertext="Item Id" e-visible="false" e-width="3"></div>
                                <div e-column e-type="number" e-field="PredefineValue" e-headertext="Predefine Value" e-width="3"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li><button ng-click="SaveParameterData();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                            <li><button ng-click="SaveParameterClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmRemoveItem" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeItemRow();"></confirm-archive-generic>


