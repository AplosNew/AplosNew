<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Sales Order Pending</h3>
<div class="form-elements form-horizontal" ng-form="SalesOrderInvoiceForm">
    <fieldset style="border:1px solid;padding-left: 1.4em;margin-bottom:10px;">
        <legend style="width: auto;font-size: 12px;margin-bottom: 6px;"> Select sales order pending</legend>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-3 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-9 input-group">
                    <div class="select-style">
                        <select name="Entity" ng-disabled="pendingList.length>0" ng-model="master.EntityId" class="form-control"
                                ng-options="item.Value as item.Text for item in entityList" tabindex="2" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <span class="input-group-btn">
                        <button ng-click="getSOPendingList();" class="btn single-small-btn">Go</button>
                        <button ng-click="soClear();" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </fieldset>
    <div class="clearfix"></div>
    <!--Detail Grid-->
    <div class="table-responsive modal-table" ng-show="pendingList.length>0">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Confirmed</th>
                    <th>Sales Order No</th>
                    <th>Master Order No</th>
                    <th>PO</th>
                    <th>MaterialGroup (Mst)</th>
                    <th>Material Master</th>
                    <th>Article</th>
                    <th>Name</th>
                    <th>Qty</th>
                    <th>UoM</th>
                    <th>Rate</th>
                    <th>Currency</th>
                    <th>Delivery End Date</th>
                    <th>Own Shipment Date</th>
                    <th>Id</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in pendingList">
                    <td>
                        <ul class="list-inline action-list">
                            <li style="margin-left: -6px;"><button ng-click="materialAttachPop(x,x.Id,x.MaterialGroupMasterId,x.UoMId,$index)" class="btn-action single-small-btn tooltip-here" data-placement="right" title="Material Attach" tooltip><i class="glyphicon glyphicon-paperclip"></i></button></li>
                            <li style="margin-left: -6px;"><button ng-click="materialDetached($index);" class="btn-action single-small-btn tooltip-here" data-placement="top" title="Material Detached" tooltip><i class="fa fa-chain-broken"></i></button></li>
                            <li><button ng-click="removeRowModal(x,$index);" class="btn-action tooltip-here" data-placement="top" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i></button></li>
                        </ul>
                    </td>
                    <td>
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" class="css-checkbox" ng-model="x.IsConfirmedFG" ng-checked="x.IsConfirmedFG" ng-click="confirmation(x.Id,$event)">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </td>
                    <td>{{x.CustomerPo}}</td>
                    <td>{{x.MaterialGroupMasterName}}</td>
                    <td>{{x.MaterialMasterName}}</td>
                    <td>{{x.ArticleName}}</td>
                    <td>{{x.Name}}</td>
                    <td>{{x.Qty}}</td>
                    <td>{{x.UoM}}</td>
                    <td>{{x.Rate}}</td>
                    <td>{{x.CurrencyName}}</td>
                    <td style="padding:0px;">
                        <input type="text" ng-model="x.DeliveryEndDate" datepicker class="form-control">
                    </td>
                    <td>{{x.OwnShipmentDate}}</td>
                    <td>{{x.Id}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="common-btn" ng-show="pendingList.length>0">
        <ul class="list-inline text-right">
            <li> <button ng-click="saveChange();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save Change</button></li>
        </ul>
    </div>
</div>
<!-- #region Sales Ordder -->
<div class="modal fade site-modal in" id="soppopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Material Master (Pending Order)<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="$root.parameters.searchBy">
                                            <option ng-repeat="option in sbsoPendingList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="loadSOPData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadSOPData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped text-left">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>PO</th>
                                <th>Confirmed</th>
                                <th>MaterialGroup (Mst)</th>
                                <th>Material Master</th>
                                <th>Article</th>
                                <th>Name</th>
                                <th>Qty</th>
                                <th>UoM</th>
                                <th>Rate</th>
                                <th>Currency</th>
                                <th>Delivery End Date</th>
                                <th>Own Shipmen tDate</th>
                                <th>Id</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in soPendingList  |itemsPerPage:$root.pageSize" pagination-id="metaData.name + 'soPendingList'" total-items="$root.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label class=" control-label">
                                            <input type="checkbox" ng-model="x.IsSelectedID" ng-click="pushTempList(x,$event)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.CustomerPo}}</td>
                                <td>{{x.IsConfirmedFG?'Yes':'No'}}</td>
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.MaterialMasterName}}</td>
                                <td>{{x.ArticleName}}</td>
                                <td>{{x.Name}}</td>
                                <td>{{x.Qty}}</td>
                                <td>{{x.UoM}}</td>
                                <td>{{x.Rate}}</td>
                                <td>{{x.CurrencyName}}</td>
                                <td>{{x.DeliveryEndDate|dateFiltering}}</td>
                                <td>{{x.OwnShipmentDate}}</td>
                                <td>{{x.Id}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls pagination-id="metaData.name + 'soPendingList'"
                                             max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadSOPData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="selectPendingByButton();" class="btn"><i class=""></i> Select</button></li>
                        <li> <button type="button" class="btn btn-default" ng-click="closePendingPopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
