        <div class="form-horizontal form-elements">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="number" name="Sequence" ng-model="ModelNew.Sequence" class="form-control" required tabindex="1">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Sandard Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Sandard Name" ng-model="ModelNew.LineItemCostingSandardName" class="form-control" required tabindex="5" maxlength="50">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">SOItem Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="SOItem Name" ng-model="ModelNew.SOItemName" class="form-control" required tabindex="5" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">IsFixedValue</label>
                    <div class="col-sm-2">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="ModelNew.IsFixedValue" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group" ng-hide="ModelNew.IsFixedValue==false">
                    <label class="col-sm-4 control-label">ValueInPercentage<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" name="ValueInPercentage" n-decimals="2" ng-model="ModelNew.ValueInPercentage" class="form-control" tabindex="5">
                    </div>
                </div>
                <div class="form-group" ng-show="ModelNew.IsFixedValue==true">
                    <label class="col-sm-4 control-label">Fixed Value<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" name="Fixed Value" n-decimals="2" ng-model="ModelNew.FixedValue" class="form-control" tabindex="5">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Costing Segment<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Costing Segment" ng-model="ModelNew.CostingSegment" class="form-control" required tabindex="5" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Active</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                
            </div>
            <div class="col-sm-12">
                <fieldset class="scheduler-border" style="width:1076px">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        @*<div class="form-group">
                        <label class="col-sm-4 control-label">Salary Head</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="ModelNew.SalaryHeadIdFormula" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('SHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>*@
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Value</label>
                            <div class="col-sm-6">
                                <input type="text" name="Value" ng-model="ModelNew.Value" class="form-control" required tabindex="2" maxlength="50">
                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('Value');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Operator</label>
                            <div class="col-sm-6">
                                <div class="select-style">
                                    <select ng-model="ModelNew.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="5">
                                        <option value=""></option>
                                    </select>
                                </div>

                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('Operator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Precedence</label>
                            <div class="col-sm-6">
                                <div class="select-style">
                                    <select ng-model="ModelNew.Precedence" class="form-control" name="Precedence" tabindex="5">
                                        <option value=""></option>
                                        <option value="(">(</option>
                                        <option value=")">)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('Precedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="RemoveFormula();" class="btn" tabindex="9"><i class="glyphicon glyphicon-backward"></i></button></li>
                            </ul>
                        </div>
                        <div class="form-group">
                            {{ModelNew.FormulaDescription}}
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="clearfix"></div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

    </div>
</div>
<div class="aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="LineItemCostingSandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="CostingSegment" e-headertext="CostingSegment" e-width="5"></div>
            <div e-column e-field="SOItemName" e-headertext="SOItemName" e-width="5"></div>
            <div e-column e-field="Formula" e-headertext="Formula" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>