                            </thead>
                            <tbody>
                                <tr ng-repeat="x in itemList">
                                    <td>{{x.Id}}</td>


                                    <td>
                                        <div class="input-group">
                                            <input type="text" name="Customer" ng-model="x.MaterialMasterName" class="form-control" readonly style="width: 80px;">
                                            <span class="input-group-btn">
                                                <button ng-click="getMaterial($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                            </span>
                                        </div>
                                    </td>
                                    <td>

                                        <div class="input-group">
                                            <input type="text" name="Customer" ng-model="x.ArticleName" class="form-control" readonly style="width: 80px;">
                                            <span class="input-group-btn">
                                                <button ng-click="getArticle($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                                <button ng-click="clearArticle($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                                <button ng-click="getArticleValue(x.ArticleId, x.MaterialMasterName, x.ArticleName);" class="btn single-small-btn" ng-disabled="x.ArticleId==null"><i class="glyphicon glyphicon-list-alt"></i></button>
                                                <button ng-click="getAttribute(x.Id, x.MaterialMasterId, x.MaterialMasterName);" class="btn single-small-btn tooltip-here" tooltip data-placement="top" title="Attribute" ng-disabled="x.Id==null || x.MaterialMasterId==null"><i class="glyphicon glyphicon-plus-sign"></i></button>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="select-style">
                                            <select name="Type" class="form-control" ng-model="x.Type"
                                                    ng-options="item.Value as item.Text for item in linetypeList" style="width: 80px;">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </td>
                                    <td><input type="text" ng-model=" x.Particulars" class="form-control"></td>

                                    <td><input type="text" ng-model=" x.BuyerReferenceNo" class="form-control"></td>
                                    <td><input type="text" ng-model=" x.OwnReferenceNo" class="form-control"></td>
                                    <td><input type="text" n-decimals="2" ng-model=" x.ProjectedQty" class="form-control text-right" /></td>
                                    <td class="text-right"></td>
                                    <td>
                                        <input type="text" n-decimals="2" ng-model=" x.NoOfSample" class="form-control  text-right">
                                    </td>
                                    <td>
                                        <input type="checkbox" ej-checkbox class="nodetext" e-value="x.CostingRequired" e-checked="x.CostingRequired" e-model="x.CostingRequired" />
                                    </td>
                                    <td class="text-center"><button ng-click="GetInquiryProcessList(x.InquiryMasterId,x.Id,x);"  class="btn btn-action tooltip-here"><i class="glyphicon glyphicon-plus"></i></button></td>


                                 
                                    <td>
                                        <input type="text" ng-model=" x.Remarks" class="form-control">
                                    </td>
                                    <td class="text-right table-td">
                                        <ul class="list-inline action-list">
                                            @*<li><button ng-click="getAttribute(x.Id, x.MaterialMasterId, x.MaterialMasterName);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Attribute" ng-disabled="x.Id==null || x.MaterialMasterId==null">Attribute</button></li>*@
                                            <li><button ng-click="removeLineItem($index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="7"></td>
                                    <td class="text-right">
                                        <label>
                                            {{itemList | sumByKey : 'ProjectedQty'}}
