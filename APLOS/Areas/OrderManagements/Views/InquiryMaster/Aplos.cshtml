                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchBy">
                                <option ng-repeat="option in searchMasterFilterList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="GetList()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="GetList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Plant</th>
                    <th>Inquiry Type</th>
                    <th>Customer</th>
                    @*<th>Product Master</th>*@
                    <th>inquiry Year</th>
                    <th>Projected Quantity</th>
                    <th>Line Item No</th>
                    <th>Responsible Person</th>
                    <th>Bill To</th>
                    <th>Ship To</th>
                    <th>Buyer Reference No</th>
                    <th>Own Reference No</th>
                    <th>Master Order No</th>
                    <th>Print</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in ModelList" ng-dblclick="Get($index);">
                    <td>{{x.UserName}}</td>
                    <td>{{x.OrderType}}</td>
                    <td>{{x.CustomerName}}</td>
                    @*<td>{{x.ProductMaster}}</td>*@
                    <td>{{x.OrderYear}}</td>
                    <td>{{x.TotalQty}}</td>
                    <td>{{x.NoOfLineItem}}</td>
                    <td>{{x.ResponsiblePersonName}}</td>
                    <td>{{x.InvoicingPartyPlant}}</td>
                    <td>{{x.DeliveryPartyPlant}}</td>
                    <td>{{x.BuyerReferenceNo}}</td>
                    <td>{{x.OwnReferenceNo}}</td>
                    <td>{{x.MasterOrderNo}}</td>
                    <td>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><a class="btn btn-action" href="OrderManagements/MasterOrder/GetMasterOrderReport?masterOrderId={{x.Id}}" target="_blank"><i class="glyphicon glyphicon-print"></i></a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10"
                             pagination-id="metaData.name + 'files'"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="loadMasterData(newPageNumber)">
