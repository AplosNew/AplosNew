            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form="tab2">
                    <div class="col-md-12 table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Material</th>
                                    <th>Article</th>
                                    <th>Type</th>
                                    <th>Particulars</th>
                                    <th>Buyer Ref.No</th>
                                    <th>Own Ref.No</th>
                                    <th>Projected Quantity</th>
