<togglable name="Inquiry Master"></togglable>
<div ng-form="ModelNewForm" id="ganttContainer">
    <div class="form-element-ctrl form-horizontal">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Company" class="form-control" ng-model="ModelNew.CompanyId" ng-change="getPlantCbo();getData();" ng-options="item.Value as item.Text for item in companyList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Commitment</label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="Commitment" ng-model="ModelNew.CommitmentId" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="showCommitmentPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-horizontal form-elements">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Plant" class="form-control" ng-model="ModelNew.PlantId" ng-change="getSpecialTaxByPlantCbo();" ng-options="item.Value as item.Text for item in plantList" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Inquiry Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input e-watermarktext="Inuiry Date" required e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="ModelNew.InquiryDate" e-width="100%" />
                        </div>
                    </div>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Inquiry Source<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Buyer Ref No" ng-model="ModelNew.InquirySource" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6" ng-show="specialTaxList.length > 0">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Special Tax</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select name="Irregular Tax" class="form-control" ng-model="ModelNew.SpecialTaxId" ng-options="item.Value as item.Text for item in specialTaxList" ng-disabled="SpecialTax">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <label class="col-sm-2 control-label">If applicable</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">General</a></li>
                @*<li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Responsible Person</a></li>*@
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Item</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
