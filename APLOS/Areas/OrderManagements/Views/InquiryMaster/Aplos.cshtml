                                    <select name="Order Category" class="form-control" ng-model="soSplitModel.OrderCategoryId" ng-options="item.Value as item.Text for item in orderCategoryList" required tabindex="104">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
