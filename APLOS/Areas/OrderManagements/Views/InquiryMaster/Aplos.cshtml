                            <label class="col-sm-4 control-label">Discount</label>
                            <div class="col-sm-8">
                                <input type="text" n-decimals="2" name="Discount" ng-model="soSplitModel.Discount" class="form-control text-right" tabindex="112">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">LSD<sup>*</sup></label>
