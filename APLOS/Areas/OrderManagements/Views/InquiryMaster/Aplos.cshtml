                            <label class="col-sm-4 control-label">Buyer Department<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" name="Department" id="Department" ng-model="ModelNew.BuyerDepartmentId">
                                        @*<option value="ALL">ALL</option>*@
                                        <option ng-repeat="option in departmentList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="isBuyerApplicable">
                            <label class="col-sm-4 control-label">Testing Std</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Testing Std" class="form-control" ng-model="ModelNew.TestingStandardId"
                                            ng-options="item.Value as item.Text for item in testingStandardList | filter:{ BuyerId: ModelNew.BuyerId }:true" tabindex="13">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Critical lavel<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" name="Critical Level" ng-model="ModelNew.CriticalLevelId" required tabindex="6">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="row in CriticalLevelData" value="{{row.Id}}">{{row.UserName}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Year<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                @*<input type="text" ng-model="ModelNew.OrderYear" class="form-control" tabindex="3">*@
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.OrderYear" name="OrderYear" ng-options="item.Value as item.Text for item in yearList" required tabindex="3">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Inquiry Closing Date<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input e-watermarktext="Inquiry Closing Date" required e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="ModelNew.InquiryClosingDate" e-width="100%" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">No. of Line Item<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" only-numbers name="No of Line Item" ng-model="ModelNew.NoOfLineItem" class="form-control text-right">
                            </div>
                        </div>
                    </div>

                </div>
            </div>
