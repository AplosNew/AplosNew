<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Group Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Group Name" ng-model="ModelNew.GroupName" class="form-control" maxlength="15" required tabindex="3">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Departmental Head<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" name="DepartmentalHead" ng-model="ModelNew.DepartmentalHead" class="form-control" readonly tabindex="115">
                    <span class="input-group-btn">
                        <button ng-click="showEmployeeListPopUp('DH');" class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Group Incharge Name<sup>*</sup></label>
            <div class="input-group">
                <input type="text" name="DepartmentalHead" ng-model="ModelNew.GroupInchargeName" class="form-control" readonly tabindex="115">
                <span class="input-group-btn">
                    <button ng-click="showEmployeeListPopUp('GI');" class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Remark</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remark" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Plant</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Customer</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Check by </a></li>
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Approve By</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row">
                <div class="form-horizontal form-elements">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Company" class="form-control" ng-model="modelPlant.CompanyId" ng-options="item.Value as item.Text for item in companyList" required>
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="ShowPlantpopUp();" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Plant</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div style="color:black;" id="GridP" ej-grid e-datasource="SelectedPlantList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-width="80"></div>
                        <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                        <div e-column e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                        <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
                        <div e-column e-field="UserName" e-headertext="UserName" e-width="80"></div>
                        <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="40"></div>
                    </div>
                </div>
                <script type="text/template" id="ShowActionButtons">
                    <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.valuePassInModal(this);" style="margin: -6px;"></i></button>
                </script>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="form-horizontal form-elements">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <span class="input-group-addon">{{ModelC.PartyCode}}</span>
                                    <input type="text" name="Vendor" ng-model="ModelC.PartyName" class="form-control" required readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="showPartyPopUpNew()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>

                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remark</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="ModelC.Remark" maxlength="250" tabindex="6"></textarea>
                            </div>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Account Incharge<sup>*</sup></label>
                            <div class="input-group">
                                <input type="text" name="DepartmentalHead" ng-model="ModelC.AccountInchargeName" class="form-control" readonly tabindex="115">
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp('AI');" class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveCustomer();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                            <li> <button ng-click="ClearCustomer();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridC" ej-grid e-datasource="SelectedCustomerList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                <div e-column e-field="PartyCode" e-headertext="Code" e-width="80"></div>
                                <div e-column e-field="PartyName" e-headertext="Customer" e-width="80"></div>
                                <div e-column e-field="AccountInchargeName" e-headertext="Account Incharge Name" e-width="80"></div>
                                <div e-column e-field="Remark" e-headertext="Remark" e-width="80"></div>
                                <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="40"></div>
                            </div>
                        </div>
                        <script type="text/template" id="ShowActionButtons">
                            <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.valuePassInModal(this);" style="margin: -6px;"></i></button>
                        </script>
                    </div>

                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="showEmployeeListPopUp('CheckBy');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                </ul>
            </div>
            <div style="color:black;" id="Grid" ej-grid e-datasource="SelectedCheckByEmpList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-rowdatabound="onrowdatabound" e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                    <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                    <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="40" e-visible="false"></div>
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="40"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                    <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                    <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                    <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                    <div e-column e-field="EmployeeStatus" e-headertext="Employee Status" e-width="60"></div>
                    <div e-column e-headertext="Actions" e-width="50">
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.valuePassInRPModal(this);" style="margin: -6px;"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="showEmployeeListPopUp('ApproveBy');" class="btn"><i class="glyphicon glyphicon-plus" tabindex="3"></i>Add Employees</button></li>
                </ul>
            </div>
            <div style="color:black;" id="Grid" ej-grid e-datasource="SelectedApproveByEmpList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-rowdatabound="onrowdatabound" e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                    <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                    <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="40" e-visible="false"></div>
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="40"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                    <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                    <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                    <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                    <div e-column e-field="EmployeeStatus" e-headertext="Employee Status" e-width="60"></div>
                    <div e-column e-headertext="Actions" e-width="50">
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.valuePassInRPModal(this);" style="margin: -6px;"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false" e-isprimarykey="true"></div>
            <div e-column e-field="GroupName" e-headertext="Group Name" e-width="3"></div>
            <div e-column e-field="GroupInchargeName" e-headertext="Group Incharge Name" e-width="5"></div>
            <div e-column e-field="DepartmentalHead" e-headertext="Departmental Head" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>


<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <disv class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="SystemId" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </disv>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closePopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>
<div class="modal fade site-modal in" id="plantpopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPlant" ej-grid e-datasource="plantList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-templaterefresh="refreshTemplatePlant" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplatePlant" e-template="#checkboxTemplatePlant" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="80"></div>
                            <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
                            <div e-column e-field="UserName" e-headertext="UserName" e-width="80"></div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxTemplatePlant">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" e-value="data.Flag" />
                    </script>

                    <script type="text/x-jsrender" id="headerTemplatePlant">
                        <input type="checkbox" id="headchk" />
                    </script>
                </div>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closePlantPopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="removePlantPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeletePlant();"></confirm-archive-generic>

<ej-dialog id="dialogCustomerSearch" title=" Search Customer" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target="#mainContainer" e-minwidth="1000" e-open="enableBtn">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchCustomer">
                                <option ng-repeat="option in searchByCustomer" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="searchCustomerValue" ng-enter="GetCustomerList()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="GetCustomerList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="GridCustomerList" ng-init="chkinit()" ej-grid e-actioncomplete="syncfusiongriddatabound" e-datasource="CustomerList" e-allowfiltering="true"
         e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-recorddoubleclick="SelectCustomer"
         e-allowselection="true" e-filtersettings-filterType="excel">
        <div e-columns>
            <div e-column e-type="string" e-field="Customer" e-headertext="Customer"></div>
            <div e-column e-type="number" e-field="NoOfMasterOrder" e-headertext="Master Orders" e-width="80"></div>
            <div e-column e-type="number" e-field="NoOfMasterOrderItem" e-headertext="Items" e-width="80"></div>
            <div e-column e-type="number" e-field="NoOfMasterSalesOrder" e-headertext="Sales Orders" e-width="80"></div>
            <div e-column e-type="number" e-field="MissingSKUBreakdown" e-headertext="Missing SKU Breakdown" e-width="80"></div>
            <div e-column e-type="number" e-field="MissingCostingAttachment" e-headertext="Missing Costing" e-width="80"></div>
            <div e-column e-type="number" e-field="CostItemNos" e-headertext="Cost Items" e-width="80"></div>
            <div e-column e-type="number" e-field="ItemWithoutBOQ" e-headertext="Items Wihout BOQ" e-width="80"></div>
            <div e-column e-type="number" e-field="OverdueSOList" e-headertext="SO Overdue" e-width="80"></div>
            <div e-column e-type="number" e-field="DueSOList" e-headertext="SO Due" e-width="80"></div>
        </div>
    </div>

</ej-dialog>
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")
<div class="modal fade site-modal in" id="EmppopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridEmpPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-templaterefresh="refreshTemplateemployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
