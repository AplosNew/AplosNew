                <script type="text/template" id="IsPending">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsPending" />
                </script>
                <script type="text/template" id="Applicable">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Applicable" />
                </script>
                <script type="text/template" id="PDValue">
                    @*<div class="select-style">
                            <select class="form-control" ng-model="data.Value" name="Pre defined Value"
                                    ng-options="item.Text as item.Text for item in $parent.ValueList">
                            </select>
                        </div>*@
                    <div class="col-sm-8" style="padding:0px;">
                        <input type="text" name="Value" ng-model="data.Value" ng-disabled="true" class="form-control" readonly>
                    </div>
                    <div class="col-sm-4 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="$parent.selectItemValue(this);" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </script>
                <script type="text/template" id="ActionToBeTaken">
                    <div class="col-sm-12" style="padding:0px;">
                        <input type="text" name="Action To Be Taken" ng-model="data.ActionToBeTaken" ng-click="" class="form-control">
                    </div>
                </script>
                <script type="text/template" id="AnalysisRemarks">
                    <div class="col-sm-12" style="padding:0px;">
                        <input type="text" name="Analysis Remarks" ng-model="data.AnalysisRemarks" ng-click="" class="form-control">
                    </div>
                </script>
                <script type="text/template" id="ResponsiblePerson">
                    <div class="col-sm-9" style="padding:0px;">
                        <input type="text" name="Responsible Person" ng-model="data.ResponsiblePerson" ng-disabled="true" class="form-control" readonly>
                    </div>
                    <div class="col-sm-3 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="$parent.selectResponsiblePerson(this);" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </script>
                <script type="text/template" id="Attachment">
                    <div class="col-md-12">
                        <div class="col-md-8 text-left" style="padding:0px;">
                            <label class="col-sm-12 control-label text-left" ng-click="$parent.FileDownload(data,data.test)"><a href="{{$parent.dwonloadUrl}}" style="text-decoration:underline" download="{{data.FileName}}" target="_self">{{data.FileName}}</a></label>
                        </div>
                        <div class="col-md-4 text-right">
                            <div id="UploadDefault" e-enabled="data.AttachmentApplicable" e-id="{{data.Id}}" e-data="data.Id" e-dialogPosition-x="0" e-multiplefilesselection="false" e-width="50" e-buttontext-browse="+File" e-success="$parent.getFileList" e-showroundedcorner="false" @*e-height="30"*@ e-autoupload="true" e-begin="$parent.onBeginUpload" e-filesize="2097152" ej-uploadbox e-saveurl="$parent.uploadUrl" e-extensionsallow=".jpg,.bmp,.png,.jpeg,.pdf,.xls,.xlsx,.doc,.docx,.ppt,.pptx,.txt" e-error="$parent.errorUpload"></div>
                        </div>
                    </div>
                </script>
                <div class="common-btn">
                    <ul class="list-inline text-center">
                        <li>
                            <button ng-click="SaveAnalysisItem();" class="btn"><i class=""></i> Save</button>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </div>
</div>
