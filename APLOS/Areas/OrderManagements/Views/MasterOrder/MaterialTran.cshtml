<div class="form-elements form-horizontal" ng-form name="TransferForm">

    <!-- ===================== HEADER ===================== -->
    <div class="row">
        <div class="col-xs-12"><h4>Material Transfer</h4></div>

        <div class="col-xs-12 col-sm-6 col-md-3">
            <div class="form-group">
                <label class="control-label col-sm-4">Purpose</label>
                <div class="col-sm-8 select-style">
                    <select class="form-control" ng-model="Header.Purpose"
                            ng-options="i.Value as i.Text for i in PurposeList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-3">
            <div class="form-group">
                <label class="control-label col-sm-4">From Location</label>
                <div class="col-sm-8 select-style">
                    <select class="form-control" ng-model="Header.FromLocationId"
                            ng-options="i.Value as i.Text for i in LocationList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-3">
            <div class="form-group">
                <label class="control-label col-sm-4">To Location</label>
                <div class="col-sm-8 select-style">
                    <select class="form-control" ng-model="Header.ToLocationId"
                            ng-options="i.Value as i.Text for i in LocationList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-3">
            <div class="form-group">
                <label class="control-label col-sm-4">By Whom</label>
                <div class="col-sm-8 select-style">
                    <select class="form-control" ng-model="Header.ByWhomId"
                            ng-options="i.Value as i.Text for i in EmployeeList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-3">
            <div class="form-group">
                <label class="control-label col-sm-4">To Whom</label>
                <div class="col-sm-8 select-style">
                    <select class="form-control" ng-model="Header.ToWhomId"
                            ng-options="i.Value as i.Text for i in EmployeeList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-3">
            <div class="form-group">
                <label class="control-label col-sm-4">Remark</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control" ng-model="Header.Remark" ng-maxlength="200" />
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-3">
            <div class="form-group">
                <label class="control-label col-sm-4">Grade</label>
                <div class="col-sm-8 select-style">
                    <select class="form-control" ng-model="Header.Grade"
                            ng-options="i.Value as i.Text for i in GradeList">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== FILTER ===================== -->
    <div class="panel panel-default">
        <div class="panel-heading">Filter</div>
        <div class="panel-body">
            <div class="row">
                <div class="col-xs-12 col-sm-6 col-md-2">
                    <label>SO Status</label>
                    <select class="form-control" ng-model="Filter.SOStatus"
                            ng-options="i.Value as i.Text for i in SOStatusList">
                        <option value="">--All--</option>
                    </select>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-2">
                    <label>Customer</label>
                    <select class="form-control" ng-model="Filter.Customer"
                            ng-options="i.Value as i.Text for i in CustomerList">
                        <option value="">--All--</option>
                    </select>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-2">
                    <label>Style</label>
                    <select class="form-control" ng-model="Filter.Style"
                            ng-options="i.Value as i.Text for i in StyleList">
                        <option value="">--All--</option>
                    </select>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-2">
                    <label>Description</label>
                    <input type="text" class="form-control" ng-model="Filter.Description" />
                </div>
                <div class="col-xs-12 col-sm-6 col-md-1">
                    <label>SO No</label>
                    <input type="text" class="form-control" ng-model="Filter.SONo" />
                </div>
                <div class="col-xs-12 col-sm-6 col-md-2">
                    <label>Line Item Ref</label>
                    <input type="text" class="form-control" ng-model="Filter.LineItemReference" />
                </div>
                <div class="col-xs-12 col-sm-6 col-md-1">
                    <label>&nbsp;</label><br />
                    <button ng-click="GetSalesOrderItems();" class="btn" tabindex="9">
                        <i class="glyphicon glyphicon-eye-open"></i> GO
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== SALES ORDER LINE ITEM GRID ===================== -->
    <div class="row">
        <div class="col-xs-12">
            <div style="color:black;" id="SOItemGrid" ej-grid e-datasource="SalesOrderItemList" e-gridlines="vertical"
                 e-allowscrolling="true" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-recorddoubleclick="LoadSKUMatrix">
                <div e-columns>
                    <div e-column e-type="string" e-template="#SelectItem" e-headertext="Actions" e-width="40"></div>
                    <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="100"></div>
                    <div e-column e-type="string" e-field="Style" e-headertext="Style" e-width="90"></div>
                    <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="130"></div>
                    <div e-column e-type="string" e-field="SONo" e-headertext="SO No" e-width="80"></div>
                    <div e-column e-type="string" e-field="LineItemReference" e-headertext="Line Item Ref" e-width="90"></div>
                    <div e-column e-type="string" e-field="SOStatus" e-headertext="SO Status" e-width="80"></div>
                    <div e-column e-type="number" e-format="{0:0.00}" e-field="PlannedQty" e-headertext="SO Qty" e-textalign="right" e-width="70"></div>
                </div>
            </div>
            <script type="text/template" id="SelectItem">
                <div class="text-left" style="padding: 0px 2px;">
                    <button ng-click="$parent.LoadSKUMatrix(this);" class="btn single-small-btn" tabindex="6">
                        <i class="cr-icon glyphicon glyphicon-th-list"></i>
                    </button>
                </div>
            </script>
        </div>
    </div>

    <!-- ===================== SKU MATRIX ===================== -->
    <div class="row" ng-show="SKUList.length > 0">
        <div class="col-xs-12">
            <div ng-repeat="sku in SKUList" style="margin-top:15px;">
                <strong>{{sku.SKUName}}</strong>
                <span class="pull-right">Total: {{skuTotal(sku)}}</span>
                <div class="table-responsive">
                    <table class="table table-bordered table-condensed">
                        <thead>
                            <tr>
                                <th style="width:150px;">Color</th>
                                <th ng-repeat="s in sku.Sizes" class="text-center">{{s.SizeName}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="c in sku.Colors">
                                <td>{{c.ColorName}}</td>
                                <td ng-repeat="s in sku.Sizes">
                                    <input type="number" min="0" class="form-control text-right"
                                           style="color:black;" placeholder="Qty"
                                           ng-model="c.Qty[s.SizeId]" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li>
                        <button ng-click="Save();" class="btn" tabindex="10">
                            <i class="cr-icon glyphicon glyphicon-floppy-disk"></i> Save
                        </button>
                    </li>
                    <li>
                        <button ng-click="Reset();" class="btn" tabindex="11">
                            <i class="glyphicon glyphicon-refresh"></i> Reset
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- ===================== CARTON / CHILD ===================== -->
    <div class="row" ng-show="SKUList.length > 0">
        <div class="col-xs-12">
            <hr />
            <div class="table-responsive">
                <table class="table table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th style="width:110px;">No Of Carton</th>
                            <th>Carton Ref No</th>
                            <th>Packed By</th>
                            <th>Remark</th>
                            <th style="width:90px;"></th>
                            <th style="width:200px;">Generate QR (Qty)</th>
                            <th style="width:40px;">
                                <button ng-click="AddCartonRow();" class="btn single-small-btn" title="Add row">
                                    <i class="glyphicon glyphicon-plus"></i>
                                </button>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="c in CartonList">
                            <td><input type="number" min="1" class="form-control text-right" style="color:black;" ng-model="c.NoOfCarton" /></td>
                            <td><input type="text" class="form-control" style="color:black;" ng-model="c.CartonRefNo" ng-maxlength="50" /></td>
                            <td>
                                <select class="form-control" ng-model="c.PackedById"
                                        ng-options="i.Value as i.Text for i in EmployeeList">
                                    <option value="">--Select--</option>
                                </select>
                            </td>
                            <td><input type="text" class="form-control" style="color:black;" ng-model="c.Remark" ng-maxlength="200" /></td>
                            <td class="text-center">
                                <button ng-click="SaveChild(c);" class="btn single-small-btn">
                                    <i class="cr-icon glyphicon glyphicon-floppy-disk"></i> Save Child
                                </button>
                            </td>
                            <td>
                                <div class="input-group">
                                    <input type="number" min="1" class="form-control text-right" style="color:black;" ng-model="c.QRQty" />
                                    <span class="input-group-btn">
                                        <button ng-click="GenerateQR(c);" class="btn single-small-btn">
                                            <i class="glyphicon glyphicon-qrcode"></i> Generate
                                        </button>
                                    </span>
                                </div>
                            </td>
                            <td class="text-center">
                                <button ng-click="RemoveCartonRow($index);" class="btn single-small-btn">
                                    <i class="cr-icon glyphicon glyphicon-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>


