<div class="form-elements form-horizontal" ng-form name="GeneralForm">
    <div class="row">
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Movement Purpose<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.PurposeId" name="Movement Purpose" ng-change="getLocation();"
                                ng-options="item.Value as item.Text for item in purposeList" required tabindex="6">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Grade<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Grade" ng-model="ModelNew.Grade" required class="form-control text-left" tabindex="13">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">To Whom<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="To Whom" ng-model="ModelNew.ToWhom" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="getEmpPopUpData('To');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Location" disabled ng-model="ModelNew.Location" class="form-control" maxlength="200" required tabindex="4">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">By Whom<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="By Whom" ng-model="ModelNew.ByWhom" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="getEmpPopUpData('By');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="8"></textarea>
                </div>
            </div>


        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>

