<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);" href="" data-toggle="tab">Order Monitors</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" data-toggle="tab">SKU</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <div class="form-elements form-horizontal" ng-form name="ModelNewForm">
            <input type="hidden" ng-model="ModelNew.Id">
            @*<div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Status<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Status" class="form-control" ng-model="ModelNew.Status" ng-options="item.Value as item.Text for item in StatusList" required>
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Target Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="TargetDate" ng-model="ModelNew.TargetDate" class="form-control" datepicker required tabindex="3">
                        </div>
                    </div>

                </div>*@
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button ng-click="getEmpPopUpData()" ng-disabled="disGo" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> Order Monitors</button></li>
                        </ul>
                    </div>
                </div>

            </div>
            <div class="col-xs-12">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridOM" ej-grid e-datasource="OrderMonitorsList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-type="string" e-template="#Remove" e-headertext="Actions" e-width="90"></div>
                            <div e-column e-field="EmpSystemId" e-headertext="EmpSystemId" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-template="#Process" e-headertext="Process" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#WorkGroupId" e-headertext="WorkGroup" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#RPLevel" e-headertext="RPLevel" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#UserCategory" e-headertext="UserCategory" e-width="80" style="height: 20px;"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>

                </div>
                <script type="text/template" id="Remove">
                    <div class="col-sm-2 text-left" style="padding: 0px; padding-left: 2px; width: 20px;">
                        <button ng-click="$parent.removeEmp(this);" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-trash"></i></button>
                        <button ng-click="$parent.SaveRow(this);" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-floppy-disk"></i></button>
                    </div>
                </script>
                <script type="text/template" id="Process">
                    <div class="select-style">
                        <select class="form-control" ng-model="data.ProcessId" name="Process">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in $parent.processCboList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </script>
                <script type="text/template" id="WorkGroupId">
                    <div class="select-style">
                        <select class="form-control" ng-model="data.WorkGroupId" name="WorkGroupId">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in $parent.WorkGroupList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </script>
                <script type="text/template" id="RPLevel">
                    <div class="select-style">
                        <select class="form-control" ng-model="data.RPLevel" name="RPLevel">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in $parent.LevelList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </script>
                <script type="text/template" id="UserCategory">
                    <div class="col-sm-10" style="padding:0px; width:70px;">
                        <input type="text" ng-model="data.UserCategory" ng-maxlength="100" style="color:black;" class="form-control" />
                    </div>
                </script>
            </div>
        </div>
          
        </div>
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">

    </div>
</div>

<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Employee Information<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-templaterefresh="refreshTemplateemployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="SystemId" e-headertext="EmpSystemId" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>
                    </div>
                    <div class="common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="closePopUp();" class="btn">Apply</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<confirm-archive-generic modalid="confirmRunDelPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteEmployee();"></confirm-archive-generic>
