                                                <li>
                                                    <button ng-click="AddDescription(x)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Description"><i class="glyphicon glyphicon-th-list"></i></button>
                                                </li>
                                                <li>
                                                    <button ng-click="getSalesOrder(x,x.Id, x.MaterialMasterId, x.MaterialMasterName, x.ArticleName,x.HSNCodeId,x.BuyerReferenceNo);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="SO" ng-disabled="x.Id==null">SO</button>
                                                </li>
                                                <li>
                                                    <button ng-click="AddQBOQ(x)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Quick BOQ">BOQ({{x.BOQNo}})</button>
