<togglable name="{{FormTitle}}"></togglable>
<style>
    .modellgModify {
        width: 1200px;
    }

    .modellgModifyNew {
        width: 1600px;
    }
</style>
<div class="row">
    <div ng-form="fileNewForm" id="ganttContainer">
        <div class="form-element-ctrl form-horizontal">
            <div class="col-xs-5 col-sm-5 col-md-5">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select name="Company" class="form-control" ng-model="fileNew.CompanyId" ng-change="getPlantCbo();getData();GetProcessByCompany();" ng-options="item.Value as item.Text for item in companyList" required>
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-5 col-sm-5 col-md-5">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Commitment</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input type="text" name="Commitment" ng-model="fileNew.CommitmentId" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="showCommitmentPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">

            </div>
        </div>
        <div class="clearfix"></div>
        <div class="form-horizontal form-elements">
            <div class="col-xs-5 col-sm-5 col-md-5">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select name="Plant" class="form-control" ng-model="fileNew.PlantId" ng-change="getSpecialTaxByPlantCbo();getEntityCbo();" ng-options="item.Value as item.Text for item in plantList" required>
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-5 col-sm-5 col-md-5" ng-show="specialTaxList.length>0">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Special Tax</label>
                    <div class="col-sm-6">
                        <div class="select-style">
                            <select name="Irregular Tax" class="form-control" ng-model="fileNew.SpecialTaxId" ng-options="item.Value as item.Text for item in specialTaxList" ng-disabled="SpecialTax">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                    <label class="col-sm-2 control-label">If applicable</label>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2"></div>
            <div class="clearfix"></div>
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }">
                        <a ng-click="setTab(1)" href="" data-toggle="tab">General</a>
                    </li>
                    @*
                        <li role="presentation" ng-class="{ active: isSet(2) }">
                        <a ng-click="setTab(2)" href="" data-toggle="tab">Responsible Person</a></li>*@
                    <li role="presentation" ng-class="{ active: isSet(3) }">
                        <a ng-click="setTab(3)" href="" data-toggle="tab">Item</a>
                    </li>
                    <li role="presentation" ng-class="{ active: isSet(4) }">
                        <a ng-click="setTab(4)" href="" data-toggle="tab">Packing Define</a>
                    </li>
                </ul>
            </div>
            <div class="tab-content" id="AplosCurrencyContainer">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form="tab1">
                        <div class="col-xs-6 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Master Order No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="File No" ng-model="fileNew.MasterOrderNo" class="form-control" disabled tabindex="3">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Type</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Type" class="form-control" ng-model="fileNew.Type" ng-options="item.Value as item.Text for item in typeList" ng-change="getLineItemType();" tabindex="1">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="input-group">
                                        <input type="text" name="Customer" ng-model="fileNew.CustomerName" class="form-control" readonly required>
                                        <span class="input-group-btn">
                                            <button ng-click="ShowCustomerPopUpNew();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                            @*<button ng-click="showPartyPopUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>*@
                                            <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Payment Due Date BaseOn<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="BaseOnDueDate" ng-disabled="IsBaseOnDueDateEnable==false" ng-model="fileNew.BaseOnDueDate" ng-change="getMatureDate(fileNew.BaseOnDueDate,fileNew.PaymentTermDays)" datepicker class="form-control datepicker" tabindex="11">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Buyer Ref No</label>
                                <div class="col-sm-2">
