                                </div>

                                <label class="col-sm-2 control-label">Own Ref No</label>
                                <div class="col-sm-4">
                                    <input type="text" name="Own Ref No" ng-model="fileNew.OwnReferenceNo" maxlength="50" class="form-control" tabindex="5">
                                </div>
                            </div>
                            <div class="form-group" ng-show="isBuyerApplicable">
                                <label class="col-sm-4 control-label">Buyer<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Buyer" class="form-control" ng-model="fileNew.BuyerId" ng-options="item.Value as item.Text for item in buyerList" tabindex="6" ng-change="buyerChange();">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" ng-show="isBuyerApplicable">
                                <label class="col-sm-4 control-label">Buyer Division<sup>*</sup></label>
                                <div class="col-sm-8">
                                    @*
                                        <div class="select-style">
                                                                                <select name="Buyer Division" class="form-control" ng-model="fileNew.BuyerDivisionId" ng-options="item.Value as item.Text for item in divisionList" tabindex="13">
                                                                                    <option value=""></option>
                                                                                </select>
                                                                            </div>*@
                                    <div class="select-style">
                                        <select class="form-control" name="Division" id="Division" ng-model="fileNew.BuyerDivisionId" tabindex="8">
                                            @*<option value="ALL">ALL</option>*@
                                            <option ng-repeat="option in divisionList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Order Status<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Order Status" class="form-control" ng-model="fileNew.OrderStatusId" ng-options="item.Value as item.Text for item in orderStatusList" tabindex="9" required>
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Season<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Season" class="form-control" ng-model="fileNew.SeasonId" ng-options="item.Value as item.Text for item in seasonList" tabindex="11">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Total Quantity<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <input type="text" n-decimals="2" name="Total Qty" ng-model="fileNew.TotalQty" class="form-control text-right" tabindex="13">
                                </div>
                                <div class="col-sm-2">
                                    <div class="select-style">
                                        <select name="Total Quantity UOM" class="form-control" ng-model="fileNew.TotalQtyUOMId" ng-options="item.Value as item.Text for item in uOMList" tabindex="13">
                                            @*<option value=""></option>*@
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="text" name="Responsible Person" ng-model="fileNew.ResponsiblePersonName" class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button ng-click="getEmpPopUpData('mo');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Extra Order Percentage</label>
                                <div class="col-sm-1">
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="fileNew.IsExtraOrderPercentage" ng-click="fileNew.IsExtraOrderPercentage != fileNew.IsExtraOrderPercentage; fileNew.ExtraOrderPercentage = 0" ng-checked="fileNew.ExtraOrderPercentage > 0">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-sm-7">
                                    <input type="text" n-decimals="2" name="Extra Order Percentage" ng-model="fileNew.ExtraOrderPercentage" tabindex="17" ng-disabled="fileNew.IsExtraOrderPercentage != true" class="form-control text-right" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Exceptional Process</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Exceptional Process" class="form-control" ng-model="fileNew.ExceptionalProcessId" ng-change="GetSubProcessByProcess();" ng-options="item.Value as item.Text for item in ProcessList">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-2 control-label">Replacement</label>
                                <div class="col-sm-3">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="fileNew.IsReplacement">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                                <label class="col-sm-3 control-label">Order Type<sup>*</sup></label>
                                <div class="col-sm-4  show-message">
                                    <div class="select-style">
                                        <select name="Order Type" class="form-control" ng-model="fileNew.OrderType" ng-options="item.Value as item.Text for item in OrderTypeList" required tabindex="1">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Entity" class="form-control" ng-change="" ng-model="fileNew.EntityId" ng-options="item.Id as item.UserName for item in entityList" required tabindex="3">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Payment Term<sup>*</sup></label>
                                <div class="col-sm-5 show-message">
                                    <div class="select-style">
                                        <select tabindex="10" id="paymentTermId" ng-disabled="fileNew.IsPaymentTermChangeable==false" class="form-control" name="Payment Term" ng-model="fileNew.PaymentTermId" ng-change="changePaymentTerm(fileNew.PaymentTermId);GetRemarksControlList();" required>
                                            <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-3 show-message">
                                    <input type="text" only-numbers name="Days" ng-model="fileNew.PaymentTermDays" disabled class="form-control" tabindex="5">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Payment Mature Date</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Mature Date" ng-model="fileNew.MatureDate" class="form-control" readonly>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Payment Term Remarks</label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="text" name="Responsible Person" ng-model="RemarksControlmodel.RemarksControl" class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button ng-click="GetRemarksControlList();" ng-disabled="fileNew.IsPaymentTermChangeable==false" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                    @*<div class="select-style">
                                            <select tabindex="10" id="RemarksControlId" ng-disabled="fileNew.IsPaymentTermChangeable==false" class="form-control" name="Remarks Control" ng-model="fileNew.RemarksControlId">
                                                <option ng-repeat="option in RemarksControlList" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>*@
                                </div>
                            </div>
                            <div class="form-group" ng-show="isBuyerApplicable">
                                <label class="col-sm-4 control-label">Buyer Brand</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Brand" class="form-control" ng-model="fileNew.BuyerBrandId" ng-options="item.Value as item.Text for item in brandList" tabindex="7">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" ng-show="isBuyerApplicable">
                                <label class="col-sm-4 control-label">Buyer Department<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select class="form-control" name="Department" id="Department" ng-model="fileNew.BuyerDepartmentId" tabindex="8">
                                            @*<option value="ALL">ALL</option>*@
                                            <option ng-repeat="option in departmentList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" ng-show="isBuyerApplicable">
                                <label class="col-sm-4 control-label">Testing Std</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Testing Std" class="form-control" ng-model="fileNew.TestingStandardId"
                                                ng-options="item.Value as item.Text for item in testingStandardList | filter:{ BuyerId: fileNew.BuyerId }:true" tabindex="10">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Order Category<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Order Category" class="form-control" ng-model="fileNew.OrderCategoryId" ng-options="item.Value as item.Text for item in orderCategoryList" tabindex="12" required>
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Year<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="fileNew.OrderYear" name="OrderYear" ng-options="item.Value as item.Text for item in yearList" required tabindex="14">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <div class="select-style">
                                        <select name="Currency" class="form-control" ng-model="fileNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList" tabindex="16">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-2">
                                    <span class="input-group-btn">
                                        <button ng-click="ExchangeShowExchangeRates(fileNew.CurrencyId);" class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-list"></i></button>
                                    </span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Order Wastage Percentage</label>
                                <div class="col-sm-8">
                                    <input type="text" n-decimals="2" name="Order Wastage Percentage" ng-model="fileNew.OrderWastagePercentage" class="form-control text-right" tabindex="18">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Exceptional SubProcess</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Exceptional SubProcess" class="form-control" ng-model="fileNew.ExceptionalSubProcessId" ng-options="item.Value as item.Text for item in SubProcessList">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">No. of Line Item<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" only-numbers name="No of Line Item" ng-model="fileNew.NoOfLineItem" class="form-control text-right" tabindex="20">
                                </div>
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li>
                                    <button ng-click="getTaskList();" class="btn single-small-btn"><i class="glyphicon glyphicon-list"></i> View Task List</button>
                                </li>
                                <li>
                                    <button ng-click="PrintTaskList();" class="btn single-small-btn"><i class="glyphicon glyphicon-list-alt"></i> Task List</button>
                                </li>
                                <li>
                                    <button ng-click="PrintMatrix();" class="btn single-small-btn"><i class="glyphicon glyphicon-list-alt"></i> Master Order (Matrix)</button>
                                </li>
                                <li>
                                    <button ng-click="PrintLinear();" class="btn single-small-btn"><i class="glyphicon glyphicon-list-alt"></i> Master Order (Linear)</button>
                                </li>

                            </ul>
                            <ul class="list-inline text-right">
                                @*<li><button ng-click="Save();" ng-disabled="btndisable"  class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>*@
                                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                <li><button ng-click="removeMaster();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                    <div class="row" ng-form="tab3">
                        <div class="col-md-12 table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Check Status</th>
                                        <th>Approve Status</th>
                                        <th class="col-sm-1">Action</th>

                                        <th>Total Quantity</th>
                                        <th>SO Total Quantity</th>
                                        <th>Total Amount</th>
                                        <th>UoM</th>
                                        <th>Article</th>
                                        <th>Customer Article</th>
                                        <th>C.SPT</th>
                                        <th>Item Costing</th>
                                        <th>Additional Info</th>
                                        <th>Buyer Ref.No</th>
                                        <th>Production/Own #</th>
                                        <th>Production Group</th>
                                        <th>Item Category</th>
                                        <th>Order Wastage Percentage</th>
                                        <th>Extra Order Percentage</th>
                                        <th>Inquiry</th>
                                        <th>Sample No</th>
                                        <th>Testing Std</th>
                                        <th>Repeat</th>
                                        <th>Product Library</th>
                                        <th>Order Costing</th>
                                        <th>Product</th>
                                        <th>Contract No</th>
                                        <th>MasterLC No</th>
                                        <th>Type</th>
                                        <th style="width: 170px;">JW/OS Type</th>
                                        <th>Entity/Vendor</th>
                                        <th>Consignment</th>
                                        <th>Remark</th>
                                        <th>Attachment</th>
                                        <th>Order Status</th>
                                        <th>Copy SO</th>
                                        <th>Additional Info</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in itemList">
                                        <td>{{x.Id}}</td>
                                        <td>{{x.CheckStatus}}</td>
                                        <td>{{x.ApproveStatus}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
