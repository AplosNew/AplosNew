<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);" href="" data-toggle="tab">SKU</a></li>
    </ul>
</div>
<div class="tab-content">

    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <togglable name="SKU"></togglable>
        <div class="form-elements form-horizontal row" ng-form name="ModelNew3Form">
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">MO Entity</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <input id="moentityDropdown" ej-dropdownlist e-multiselectmode="visualmode" e-watermarktext="All" e-datasource="moentityList" e-fields-value="Id" e-fields-text="UserName" e-width="100%" e-showcheckbox="true" />
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Sales Order<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <input type="text" name="SalesOrder" ng-model="SalesOrder" class="form-control" readonly required>
                            <span class="input-group-btn">
                                <button ng-click="recipeMaterialPopUp();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            @*<div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">ItemNo<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <input type="text" name="ItemNo" ng-model="fileNew.ItemNo" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="ShowMasterOrderItem();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>*@
            <div class="col-md-12">
                <div class="col-md-8">
                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-4 ">
                            <input id="uploadSOImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                        </label>
                        <input type="button" value="Import Data" class="btn btn-success" ng-click="ImportSOData()" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="GetSKUSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File Download</button></li>
                            <li ng-show="ShowSaveBtn"> <button ng-click="SaveSOData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div id="GridSO"
                     ng-init="chkinit()"
                     ej-grid e-datasource="soData"
                     e-allowfiltering="true"
                     e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowscrolling="true"
                     e-pagesettings-pagesize="25"
                     e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="OrderCategoryId" e-headertext="OrderCategoryId" e-width="60"></div>
                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="DeliveryDate" e-headertext="DeliveryDate" e-width="100"></div>
                        <div e-column e-field="ShipmentModeId" e-headertext="ShipmentModeId" e-width="100"></div>
                        <div e-column e-field="DestinationId" e-headertext="DestinationId" e-width="100"></div>
                        <div e-column e-field="Qty" e-headertext="Qty" e-width="100"></div>
                        <div e-column e-field="PackingTypeId" e-headertext="PackingTypeId" e-width="50"></div>
                        <div e-column e-field="ResponsiblePersonId" e-headertext="ResponsiblePersonId" e-width="60"></div>
                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="LSD" e-headertext="LSD" e-width="100"></div>
                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="MainRawMaterialInhouseDate" e-headertext="MainRawMaterialInhouseDate" e-width="100"></div>
                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="OtherRawMaterialInhouseDate" e-headertext="OtherRawMaterialInhouseDate" e-width="100"></div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12 ">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li ng-show="ShowSaveBtn"> <button ng-click="SaveSOData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- #region Recipe Material and SO -->

<div class="modal site-modal" id="recipeMaterialPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" id="ordermodal">
        <div class="modal-content">
            <div class="modal-header"> Sales Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select value="Material" ng-model="recipeMaterialParameters.searchBy">
                                            <option ng-repeat="option in recipeMaterialFilterList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="recipeMaterialParameters.search" ng-enter="serachSoMaterial()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="serachSoMaterial()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div id="GridSOItem" ng-init="chkinit()" ej-grid e-datasource="recipeMaterialList"
                         e-allowscrolling="true" @*e-minwidth="1000" e-minheight="400" e-scrollsettings-height="200"*@
                         e-rowdatabound="rowDataBound" e-actioncomplete="actionCompleteSearch" e-allowfiltering="true"
                         e-allowpaging="true" e-allowsorting="true"
                         e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>

                            <div e-column e-headertext="" e-template="#checkboxTemplateSOSearch" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="OrderType" e-headertext="Order Type" e-width="70"></div>
                            <div e-column e-field="ShipmentFromStock" e-headertext="ShipmentFromStock" e-width="50"></div>
                            <div e-column e-field="ProductName" e-headertext="Product" e-width="180" e></div>
                            <div e-column e-field="ArticleName" e-headertext="Article" e-width="120"></div>
                            <div e-column e-field="SalesOrderId" e-headertext="SO. ID" e-width="70"></div>
                            <div e-column e-field="OwnReferenceNo" e-headertext="Production Own #" e-width="100"></div>
                            <div e-column e-field="ProductionGrouping" e-headertext="Product Grouping" e-width="120" e></div>
                            <div e-column e-field="BuyerOrderNo" e-headertext="Customer Order#" e-width="70"></div>
                            <div e-column e-field="Description" e-headertext="Description" e-width="80"></div>
                            <div e-column e-field="Qty" e-headertext="Qty" e-width="80" e-textalign="right"></div>
                            <div e-column e-field="MasterOrderItemId" e-headertext="M. Order Item" e-width="70"></div>
                            <div e-column e-field="DeliveryDate" e-headertext="Del. Date" e-width="80"></div>
                            <div e-column e-field="CommitmentDate" e-headertext="Commi.Date" e-width="80"></div>
                            <div e-column e-field="BuyerReferenceNo" e-headertext="Customer Item#" e-width="100"></div>
                            <div e-column e-field="OwnOrderNo" e-headertext="Own Order#" e-width="100"></div>
                            <div e-column e-field="DestinationName" e-headertext="Dest." e-width="80"></div>
                            <div e-column e-field="DestinationDescription" e-headertext="Dest. Description" e-width="80"></div>
                            <div e-column e-field="DeliveryWeek" e-headertext="Del. Week" e-width="80"></div>
                            <div e-column e-field="MasterOrderNo" e-headertext="M. Order No" e-width="70"></div>

                            <div e-column e-field="Customer" e-headertext="Customer" e-width="180"></div>
                            <div e-column e-field="Buyer" e-headertext="Buyer" e-width="180"></div>
                            <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="180" e></div>
                            <div e-column e-field="ShipmentModeName" e-headertext="Ship.Mode" e-width="80"></div>
                            <div e-column e-field="ProductionType" e-headertext="ProductionType" e-width="50"></div>

                            <div e-column e-field="PONumber" e-headertext="Customer PO No" e-width="80"></div>
                            <div e-column e-field="MasterOrderEntity" e-headertext="M. Order Entity" e-width="70"></div>
                            <div e-column e-field="ProductionOrderId" e-headertext="PO No" e-width="80"></div>
                            <div e-column e-field="POStatus" e-headertext="POStatus" e-width="70"></div>
                            <div e-column e-field="OrderStatusName" e-headertext="SO Status" e-width="80"></div>
                            <div e-column e-field="MasterOrderType" e-headertext="M. Order Type" e-width="70"></div>
                            <div e-column e-field="POEntity" e-headertext="POEntity" e-width="70"></div>

                            <div e-column e-field="ProcessEntity" e-headertext="Process Entity" e-width="70"></div>
                            <div e-column e-field="OrderCategoryName" e-headertext="Ord. Cat." e-width="80"></div>

                            <div e-column e-type="boolean" e-field="Consignment" e-headertext="Consignment" e-width="60"></div>
                            <div e-column e-type="string" e-field="OrderOwner" e-headertext="Order Owner" e-width="180"></div>

                            @*<div e-column e-field="Rate" e-headertext="Rate" e-width="80" e-textalign="right"></div>*@

                        </div>

                    </div>

                    <script type="text/template" id="checkboxTemplateSOSearch">
                        @*<input type="checkbox" ng-model="{{:SalesOrderId}}" class="rowCheckbox" value="{{:SalesOrderId}}" />*@
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Checked" e-checked="data.Checked" />

                    </script>
                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headchk" />
                    </script>

                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="addRecipeMaterial();" class="btn">Done</button></li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>