<h3 class="site-heading"><span class="glyphicon glyphicon-th-list"></span> Order Control</h3>

<div class="form-horizontal form-elements" ng-form name="OrderControlForm" id="mainDiv">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Control Type<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select id="ControlTypeId" class="form-control" name="Control Type" ng-model="OrderControl.ControlTypeId" ng-change="GetDayAndLevel();" tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in controlTypeList" value="{{option.Id}}">{{option.ControlType}}</option>
                        </select>
                    </div>
                </div>
            </div>


        </div>

        <div class="col-xs-12">

            <div style="visibility:{{(Level=='ShipmentControl' && SOList.length>0)?'visible':'hidden'}};height:{{(Level=='ShipmentControl' && SOList.length>0)?'inherit':'0px'}};">
                <div id="GridSO" ej-grid e-datasource="SOList" e-rowdatabound="rowDataBoundOrder"
                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-minheight="400"
                     e-allowselection="false" e-filtersettings-filterType="excel" e-allowscrolling="true">
                    <div e-columns>
                        <div e-column e-type="string" e-template="#ShowActionButtonsassigned" e-headertext="Remarks" e-width="30px"></div>
                        <div e-column e-type="string" e-template="#crl" e-headertext="Criticality Level" e-width="100"></div>
                        <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="80" e-Visible="false"></div>
                        <div e-column e-type="string" e-field="SalesOrderId" e-headertext="SO No" e-width="80"></div>
                        <div e-column e-type="date" e-field="Date" e-format="{0:dd-MMM-yyyy}" e-headertext="Date" e-width="80"></div>
                        <div e-column e-type="string" e-field="LineItemReference" e-headertext="Line Item Reference" e-width="80"></div>
                        <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="80"></div>
                        <div e-column e-type="string" e-field="Qty" e-headertext="SO Qty" e-width="80" e-textalign="right"></div>
                        <div e-column e-type="string" e-field="BuyerOrder" e-headertext="Buyer Ord#" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnOrder" e-headertext="Own Ord#" e-width="80"></div>
                        <div e-column e-type="string" e-field="BuyerItem" e-headertext="Buyer Item#" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnItem" e-headertext="Own Item#" e-width="80"></div>
                        <div e-column e-type="string" e-field="PONumber" e-headertext="PO Number" e-width="80"></div>
                        <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                        <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                        <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material Master" e-width="80"></div>
                        <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductMasterName" e-headertext="Product" e-width="80"></div>
                    </div>
                </div>
            </div>

            <div style="visibility:{{(Level!='ShipmentControl' && PRList.length>0)?'visible':'hidden'}};height:{{(Level!='ShipmentControl' && PRList.length>0)?'inherit':'0px'}};">

                <div id="GridSOss" ej-grid e-datasource="PRList" e-rowdatabound="rowDataBoundOrder"
                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-minheight="400"
                     e-allowselection="false" e-filtersettings-filterType="excel" e-allowscrolling="true">
                    <div e-columns>

                        <div e-column e-template="#cl" e-headertext="Criticality Level" e-width="100"></div>
                        <div e-column e-template="#templatestatus" e-headertext="Status" e-width="100"></div>
                        <div e-column e-template="#ShowActionButtonsassigned" e-headertext="Remarks" e-width="30px"></div>

                        <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="80" e-Visible="false"></div>
                        <div e-column e-type="string" e-field="ProductionOrderId" e-headertext="PrO" e-width="80"></div>
                        <div e-column e-type="date" e-field="Date" e-format="{0:dd-MMM-yyyy}" e-headertext="Date" e-width="80"></div>
                        <div e-column e-type="string" e-field="LineItemReference" e-headertext="Line Item Reference" e-width="80"></div>
                        <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="80"></div>
                        <div e-column e-type="string" e-field="Qty" e-headertext="SO Qty" e-width="80" e-textalign="right"></div>
                        <div e-column e-type="string" e-field="BuyerOrder" e-headertext="Buyer Ord#" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnOrder" e-headertext="Own Ord#" e-width="80"></div>
                        <div e-column e-type="string" e-field="BuyerItem" e-headertext="Buyer Item#" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnItem" e-headertext="Own Item#" e-width="80"></div>
                        <div e-column e-type="string" e-field="PONumber" e-headertext="PO Number" e-width="80"></div>
                        <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                        <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                        <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material Master" e-width="80"></div>
                        <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductMasterName" e-headertext="Product" e-width="80"></div>
                    </div>
                </div>
            </div>

            <script type="text/template" id="cl">
                @*<input type="text" e-fields-text="Text" e-fields-value="Value" ej-combobox e-datasource="$parent.CriticalityLevelList" e-value="data.CriticalityLevel" e-width="100%" />*@
                @*<div class="select-style">
                <select name="CriticalLevel" class="form-control" ng-model="data.CriticalityLevel" ng-options="item.Value as item.Text for item in $parent.CriticalityLevelList" tabindex="4">
                    <option value=""></option>
                </select>
            </div>*@
                <div class="select-style">
                    <select name="CriticalLevel" class="form-control" ng-model="data.CriticalityLevel" tabindex="1">
                        <option value="">--Select--</option>
                        <option value="Critical">Critical</option>
                        <option value="Important">Important</option>
                        <option value="Normal">Normal</option>
                    </select>
                </div>
            </script>
            <script type="text/template" id="crl">
                <input type="text" e-fields-text="Text" e-fields-value="Value" ej-combobox e-datasource="$parent.SOCriticalityLevelList" e-value="data.CriticalityLevel" e-width="100%" />
            </script>
            <script type="text/template" id="templatestatus">
                <input type="text" e-fields-text="Text" e-fields-value="Value" ej-combobox e-datasource="$parent.StatusList" e-value="data.Status" e-width="100%" />

            </script>

            <script type="text/ng-template" id="ShowActionButtonsassigned">
                <div class="common-btn">
                    <ul class="list-inline text-right small">
                        <li>
                            <button ng-click="$parent.showRemarksPopUp(data);" title="Remarks" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                                <i class="glyphicon glyphicon-plus-sign"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </script>
        </div>
        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

    </div>
</div>

<div class="modal fade site-modal in" id="RemarksPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeRemarksPopUp()">&times;</button>
                <h4 class="modal-title">Remarks</h4>
            </div>
            <div class="modal-body">
                <div id="gridRemarks" ej-grid e-datasource="RemarkList" e-pagesettings-pagesize="4" e-minheight="300"
                     e-endadd="SaveRemarks" e-endedit="SaveRemarks" e-enddelete="DeleteRemarks" e-editsettings-allowediting="true" e-editsettings-allowadding="true" e-editsettings-allowdeleting="true"
                     e-toolbarsettings-showtoolbar="true" e-toolbarsettings-toolbaritems="[ej.Grid.ToolBarItems.Add, ej.Grid.ToolBarItems.Edit, ej.Grid.ToolBarItems.Delete, ej.Grid.ToolBarItems.Update, ej.Grid.ToolBarItems.Cancel]"
                     e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filtertype="excel">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-isprimarykey="true"></div>
                        <div e-column e-field="OrderControlId" e-headertext="OrderControlId" e-visible="false"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="5"></div>
                        <div e-column e-type="date" e-allowediting="false" e-format="{0:dd-MMM-yyyy}" e-field="AddedDate" e-headertext="Date" e-width="2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


