<togglable name="Customer Division"></togglable>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">General</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Responsible Person</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row" ng-form="tabFrom1">
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Account Group<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Account Group" class="form-control" ng-model="modelNew.PartyAccountGroupId" required
                                        ng-options="item.Value as item.Text for item in accountGroupList| filter:{ AccountType: 'Customer' }:true" ng-change="getPartyCbo();" tabindex="1"></select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Buyer<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="modelNew.BuyerId" name="Buyer" ng-change="getBuyerBrandDivision();"
                                        ng-options="item.Value as item.Text for item in buyerList" tabindex="3" required></select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Buyer Division</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="modelNew.BuyerDivisionId" ng-options="item.Value as item.Text for item in buyerDivisionList" tabindex="5"></select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" name="Customer" ng-model="modelNew.PartyId" ng-options="item.Value as item.Text for item in partyList" ng-change="getPartyContactPersonCbo();" tabindex="2" required></select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Buyer Brand</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="modelNew.BuyerBrandId" ng-options="item.Value as item.Text for item in buyerBrandList" tabindex="4"></select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row" ng-form="tabFrom2">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Department<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" id="departmentId" ng-model="detailModelNew.OrderResponsibleDepartmentId" ng-options="item.Value as item.Text for item in departmentList" tabindex="21">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">Respnsible Person (Our)<sup>*</sup></label>
                        <div class="col-sm-6 show-message">
                            <div class="input-group">
                                <span class="input-group-addon">{{detailModelNew.EmployeeCode}}</span>
                                <input type="text" name="@Library.Model.Parties.PartyType.Customer.ToString()" ng-model="detailModelNew.EmployeeName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="22"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">Respnsible Person (Party)</label>
                        <div class="col-sm-6 show-message">
                            <div class="select-style">
                                <select class="form-control" id="personId" ng-model="detailModelNew.PartyRespnsiblePersonId" ng-options="item.Value as item.Text for item in conactList" tabindex="23">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-1">
                    <button class="btn single-small-btn" ng-click="addRow();" tabindex="24"><i class="cr-icon glyphicon glyphicon-plus"></i></button>
                </div>
                <div class="col-md-12 table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Department</th>
                                <th>Respnsible Person (Our)</th>
                                <th>Respnsible Person (Party)</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in personList">
                                <td>{{x.Department}}</td>
                                <td>{{x.EmployeeCode}}-{{x.EmployeeName}}</td>
                                <td>{{x.PartyRespnsiblePerson}}</td>
                                <td class="text-right table-td">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="editRow($index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="edit"><i class="glyphicon glyphicon-edit"></i></button></li>
                                        <li><button ng-click="removeRowModal(x.Department, $index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Account Group</th>
                    <th>Customer</th>
                    <th>Buyer</th>
                    <th>Brand</th>
                    <th>Division</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in modelList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get($index);">
                    <td>{{x.AccountGroupName}}</td>
                    <td>{{x.Customer}}</td>
                    <td>{{x.BuyerName}}</td>
                    <td>{{x.BuyerBrandName}}</td>
                    <td>{{x.BuyerDivisionName}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUp.cshtml")
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow();"></confirm-archive-generic>
