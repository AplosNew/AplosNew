<div class="modal fade site-modal in" id="QBOQPoUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Quick BOQ<button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12 table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>

                                <th>Seq.</th>
                                <th>Item Name</th>
                                <th>Material</th>
                                <th>Article</th>
                                <th>Material Cost/Unit</th>
                                <th>Net Consumption/Unit</th>
                                <th>Value Loss(%)</th>
                                <th>Gross Consumption</th>
                                <th>UoM</th>
                                <th>Process</th>
                                <th>Work Type</th>
                                <th>Entity/Vendor</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in qboqList">
                                <td>{{x.Sequence}}</td>
                                <td>{{x.CostingItem}}</td>
                                <td>{{x.MaterialMaster}}</td>
                                <td>{{x.Article}}</td>
                                <td>{{x.MaterialCostPerUnit}}</td>
                                <td>{{x.NetConsumptionPerUnit}}</td>
                                <td>{{x.ValueLossPercentage}}</td>
                                <td>{{x.GrossConsumption}}</td>
                                <td>{{x.UoM}}</td>
                                <td>{{x.Process}}</td>
                                <td>{{x.JobWorkType}}</td>
                                <td>{{x.EntityOrVendorName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">

            </div>
        </div>
    </div>
</div>


@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterByTypePopUp.cshtml")
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
