<togglable name="Packing List"></togglable>
<div class="form-horizontal" ng-form="modelForm">
    <div class="clearfix form-element-ctrl">
        <div class="col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Entity" class="form-control" ng-change="getData();ClearFields();" ng-model="modelNew.EntityId"
                                ng-options="item.Value as item.Text for item in entityList" required tabindex="1">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="Customer" ng-model="modelNew.PartyName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="showPartyPopUp();" class="btn single-small-btn" required tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                            <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 col-md-4 control-label">Bill To</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select ng-model="modelNew.InvoicingPartyPlantId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }"
                                ng-change="billShippAddress(modelNew.InvoicingPartyPlantId,'billTo')" tabindex="3">
                            <option value=""></option>
                        </select>
                    </div>
                    <p ng-hide="modelNew.InvoicingState==null">State :{{modelNew.InvoicingState}}</p>
                    <p ng-hide="modelNew.InvoicingState==null">GSTIN :{{modelNew.InvoicingGSTIN}}</p>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Billing Address</label>
                <div class="col-sm-8">
                    <textarea type="text" rows="3" ng-model="modelNew.InvoicingByAddress" class="form-control"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" hidden>
                <label class="col-sm-4 control-label">Total Qty<sup>*</sup></label>
                <div class="col-sm-6">
                    <input type="text" n-decimals="2" name="Total Qty" ng-model="modelNew.TotalQty" class="form-control text-right" disabled>
                </div>
                <div class="col-sm-2">
                    <div class="select-style">
                        <select name="Total Qty UOM" id="totalQtyId" class="form-control" ng-model="modelNew.TotalQtyUOMId" ng-options="item.Value as item.Text for item in uOMList" disabled></select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Ship To</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="modelNew.DeliveryPartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }"
                                ng-change="billShippAddress(modelNew.DeliveryPartyPlantId,'shipTo')" tabindex="4">
                            <option value=""></option>
                        </select>
                    </div>
                    <p ng-hide="modelNew.DeliveryState==null">State :{{modelNew.DeliveryState}}</p>
                    <p ng-hide="modelNew.DeliveryState==null">GSTIN :{{modelNew.DeliveryGSTIN}}</p>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Shipping Address</label>
                <div class="col-sm-8">
                    <textarea type="text" rows="3" ng-model="modelNew.DeliveryByAddress" class="form-control"></textarea>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-md-6">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="dispatchPopUp();" class="btn"> Create Dispatch Unit</button></li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
                    <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
                </ul>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Sales Order</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Packet</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="formTab1">
                    <div class="col-md-12 table-responsive modal-table" ng-show="dispatchMasterArticleList.length>0">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>{{IsDispatchGrpApplicable ? DispatchUoM : PackingUoM}} Code</th>
                                    <th>Master Order No</th>
                                    <th>Sales Order No.</th>
                                    <th>Material</th>
                                    <th>Article</th>
                                    <th>Qty</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in dispatchMasterArticleList">
                                    <td>{{x.DispatchUnitCode}}</td>
                                    <td>{{x.MasterOrderNo}}</td>
                                    <td>{{x.SalesOrderNo}}</td>
                                    <td>{{x.MaterialMasterName}}</td>
                                    <td>{{x.ArticleName}}</td>
                                    <td>{{x.Qty}} {{qtyName}}</td>
                                    <td class="text-right">
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="GetDispatchAllData(x.DispatchUnitMasterId);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i></button></li>
                                            <li><button ng-click="genericDelete(x.Id, $index, 'article', null);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="formTab2">
                    <div class="col-md-12 table-responsive modal-table" ng-show="dispatchSKUList.length>0">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>{{DispatchUoM}} Code</th>
                                    <th>Master Order No</th>
                                    <th>Sales Order No.</th>
                                    <th>Material</th>
                                    <th>Article</th>
                                    <th>SKU 1</th>
                                    <th>SKU 2</th>
                                    <th>SKU 3</th>
                                    <th ng-show="IsDispatchGrpApplicable">NoOfPackingUnit({{PackingUoM}})</th>
                                    <th ng-show="IsDispatchGrpApplicable">QtyPerPackingUnit({{PackingUoM}})</th>
                                    <th>Qty</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in dispatchSKUList">
                                    <td>{{x.DispatchUnitCode}}</td>
                                    <td>{{x.MasterOrderNo}}</td>
                                    <td>{{x.SalesOrderNo}}</td>
                                    <td>{{x.MaterialMasterName}}</td>
                                    <td>{{x.ArticleName}}</td>
                                    <td>{{x.CH1Name}} - {{x.CH1Value}}</td>
                                    <td>{{x.CH2Name}} - {{x.CH2Value}}</td>
                                    <td>{{x.CH3Name}} - {{x.CH3Value}}</td>
                                    <td ng-show="IsDispatchGrpApplicable">{{x.NoOfPackingUnit}}</td>
                                    <td ng-show="IsDispatchGrpApplicable">{{x.QtyPerPackingUnit}}</td>
                                    <td>{{x.Qty}} {{qtyName}}</td>
                                    <td class="text-right">
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="GetDispatchAllData(x.DispatchUnitMasterId);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i></button></li>
                                            <li><button ng-click="genericDelete(x.Id, $index, 'details', null);" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchMasterFilterList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getModelList()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getModelList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Party</th>
                    <th>Bill TO</th>
                    <th>Ship To</th>
                    <th>TotalQty</th>
                    <th>TotalQtyUOM	</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in modelList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get($index);">
                    <td>{{x.PartyCode}} - {{x.PartyName}}</td>
                    <td>{{x.InvoicingPartyPlant}}</td>
                    <td>{{x.DeliveryPartyPlant}}</td>
                    <td>{{x.TotalQty}}</td>
                    <td>{{x.TotalQtyUOM}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="getModelList(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUp.cshtml")
<confirm-modal></confirm-modal>
<!-- #region Dispatch Master -->
<div class="modal fade site-modal in" id="dispatchMasterPoUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Dispatch<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-element-ctrl form-horizontal clearfix">
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div id="div_DispatchUnitCode" class="form-group">
                        <label class="col-sm-4 control-label">Dispatch Unit Code ({{IsDispatchGrpApplicable ? DispatchUoM : PackingUoM}})<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" ng-model="detailModel.DispatchUnitCode" class="form-control" ng-disabled="detailModel.Id!=null" maxlength="50" tabindex="21">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Gross Weight</label>
                        <div class="col-sm-8">
                            <input type="text" n-decimals="{{currencyPrecision}}" ng-model="detailModel.GrossWeight" class="form-control text-right" maxlength="18" tabindex="23">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="2" ng-model="detailModel.Remarks" class="form-control" maxlength="25" tabindex="25"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Qty<sup>*</sup></label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" n-decimals="{{currencyPrecision}}" ng-model="detailModel.Qty" class="form-control text-right" maxlength="18" tabindex="22" readonly>
                        </div>
                        <div class="col-sm-2 pdl3">
                            <div class="select-style">
                                <select class="form-control" ng-model="detailModel.QtyUOMId" ng-options="item.Value as item.Text for item in uOMList" disabled></select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">NetWeight</label>
                        <div class="col-sm-8">
                            <input type="text" n-decimals="{{currencyPrecision}}" ng-model="detailModel.NetWeight" class="form-control text-right" maxlength="18" tabindex="24">
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-6">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button ng-click="addDispatchArticle();" class="btn"><i class=""></i> Add Unit</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="saveDispatch();" class="btn"><i class=""></i> Save Changes</button></li>
                            <li><button ng-click="closeDispatchPopUp();" class="btn btn-default">Close</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-12 table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sales Order</th>
                                <th>Material</th>
                                <th>Article</th>
                                <th>Qty</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in dispatchArticleList">
                                <td>
                                    <div class="input-group">
                                        <input type="text" ng-model="x.SalesOrderId" class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button ng-click="salesOrderPopUp($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </td>
                                <td>{{x.MaterialMasterName}}</td>
                                <td>{{x.ArticleName}}</td>
                                <td>
                                    <div class="input-group">
                                        <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.Qty" class="form-control text-right" maxlength="18">
                                        <span class="input-group-addon">{{qtyName}}</span>
                                    </div>
                                </td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="skuPopUp(x.Id, x.SalesOrderId);" class="btn btn-action tooltip-here" ng-disabled="!HasAttribute && x.Id==null" tooltip data-placement="top" title="Details">Details</button></li>
                                        <li><button ng-click="genericDelete(x.Id, $index, 'article', 'popUp');" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion Dispatch Master-->
<!-- #region Sales Order -->
<div class="modal fade site-modal in" id="salesOrderPoUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Sales Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="salesOrderParameters.searchBy">
                                            <option ng-repeat="option in salesOrderFilterList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="salesOrderParameters.search" ng-enter="getSalesOrderList()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getSalesOrderList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <td>Sales Order No</td>
                                <td>Delivery Date</td>
                                <td>PO Number</td>
                                <td>Material</td>
                                <td>Article</td>
                                <td>Qty</td>
                                <td>Rate</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in salesOrderList |itemsPerPage:salesOrderParameters.pageSize" ng-dblclick="selectSalesOrder(x);"
                                pagination-id="metaData.name + 'salesOrderList'" total-items="salesOrderParameters.total_count">
                                <td>{{x.SalesOrderNo}}</td>
                                <td>{{x.DeliveryDate}}</td>
                                <td>{{x.PONumber}}</td>
                                <td>{{x.MaterialMasterName}}</td>
                                <td>{{x.ArticleName}}</td>
                                <td>{{x.Qty}}</td>
                                <td>{{x.Rate}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'salesOrderList'"
                                             direction-links="true" boundary-links="true"
                                             on-page-change="getSalesOrderList(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion Sales Order-->
<!-- #region Dispatch SKU -->
<div class="modal fade site-modal in" id="dispatchSKUPopUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Dispatch Details<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-element-ctrl form-horizontal clearfix">
                <div class="col-md-6">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button ng-click="salesOrderSkuPopUp();" class="btn"><i class="glyphicon glyphicon-plus"></i> Details</button></li>
                            <li><button ng-click="addSku();" class="btn"><i class="glyphicon glyphicon-plus"></i> Only Packet</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="saveDispatchSku();" class="btn"><i class=""></i> Save Changes</button></li>
                            <li><button ng-click="closeDispatchSkuPopUp();" class="btn btn-default">Close</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-12 table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>SKU 1</th>
                                <th>SKU 2</th>
                                <th>SKU 3</th>
                                <th ng-show="IsDispatchGrpApplicable">NoOfPackingUnit({{PackingUoM}})</th>
                                <th ng-show="IsDispatchGrpApplicable">QtyPerPackingUnit({{PackingUoM}})</th>
                                <th>Qty</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in dispatchSKUPopUpList">
                                <td>{{x.CH1Name}} - {{x.CH1Value}}</td>
                                <td>{{x.CH2Name}} - {{x.CH2Value}}</td>
                                <td>{{x.CH3Name}} - {{x.CH3Value}}</td>
                                <td ng-show="IsDispatchGrpApplicable">
                                    <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.NoOfPackingUnit" class="form-control text-right" maxlength="18">
                                </td>
                                <td ng-show="IsDispatchGrpApplicable">
                                    <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.QtyPerPackingUnit" class="form-control text-right" maxlength="18">
                                </td>
                                <td>
                                    <div class="input-group">
                                        <input type="text" n-decimals="{{currencyPrecision}}" ng-model="x.Qty" class="form-control text-right" maxlength="18" ng-disabled="x.disabledQty">
                                        <span class="input-group-addon">{{qtyName}}</span>
                                    </div>
                                </td>
                                <td class="text-right">
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="genericDelete(x.Id, $index, 'sku', 'popUp');" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion Dispatch SKU -->
<!-- #region SalesOrder SKU -->
<div class="modal fade site-modal in" id="salesOrderSkuPopUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">SalesOrder SKU<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>SKU 1</th>
                                <th>SKU 2</th>
                                <th>SKU 3</th>
                                <th>Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in salesOrderSkuList" ng-dblclick="selectSku(x);">
                                <td>{{x.CH1Name}} - {{x.CH1Value}}</td>
                                <td>{{x.CH2Name}} - {{x.CH2Value}}</td>
                                <td>{{x.CH3Name}} - {{x.CH3Value}}</td>
