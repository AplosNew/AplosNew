    @*PO Master Search Modal*@
    <div class="modal fade site-modal in" id="pomastersearchpopup" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    Production Reference Search <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">

                    <div class="row text-left">
                        <div class="col-xs-12 col-sm-12 col-sm-12">
                            <div class="search-form">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-3 col-md-3">
                                        <div class="select-style">
                                            <select ng-model="$root.parameters.searchBy">
                                                <option ng-repeat="option in sbproductionBatchMasterList" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-7 col-md-7">
                                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="loadBatchData()">
                                    </div>
                                    <div class="col-xs-12 col-sm-2 col-md-2">
                                        <button type="button" ng-click="loadBatchData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th ng-repeat="h in sbproductionBatchMasterList">{{h.Text}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="x in productionBatchMasterList | itemsPerPage:$root.pageSize" pagination-id="metaData.name + 'productionBatchMasterList'" total-items="$root.total_count" ng-dblclick="getBatchSingle(x);">
                                    <td ng-repeat="h in sbproductionBatchMasterList">{{x[h.Value]}}</td>
                                </tr>
                            </tbody>
                        </table>
                        <dir-pagination-controls pagination-id="metaData.name + 'productionBatchMasterList'"
                                                 max-size="2"
                                                 direction-links="true"
                                                 boundary-links="true"
                                                 on-page-change="loadBatchData(newPageNumber)">
                        </dir-pagination-controls>
                    </div>

                </div>
            </div>
        </div>
    </div>
    @*Batch Master Search Modal*@
    <div class="modal fade site-modal in" id="mastersearchpopup" role="dialog" data-backdrop="static">
