<style>
    div[class="form-group"] {
        height: 8px !important;
    }

    .control-label {
        text-align: right !important;
        line-height: 8px !important;
    }
</style>

<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Production Reference Subprocess
</h3>

<div class="row form-elements form-horizontal" ng-form id="ProductionReferenceSubprocess" name="MasterForm">

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="Plant" ng-model="master.EntityId" class="col-sm-3 form-control" ng-disabled="pref.BatchNo.length>0"
                            ng-options="item.Value as item.Text for item in entityList" tabindex="1"
                            ng-change="ClearBody();" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group">
            <label class="col-sm-4 control-label">Process<sup>*</sup></label>
            <div class="col-sm-8 ">
                <div class="select-style">
                    <select name="Process" id="Process" class="form-control" tabindex="2" ng-change="GetProcessName()" ng-disabled="pref.BatchNo.length>0" ng-model="master.ProcessId" ng-options="item.Value as item.Text for item in processList">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>


    <div class="clearfix"></div>
    <hr style="width:95%; text-align:center;margin-bottom:5px;margin-top:5px;" ng-show="pref.BatchNo.length>0" />
    <div class="col-xs-12 col-sm-12 col-md-12" ng-show="master.EntityId.length>0">
        <div class="form-group">
            <label class="col-sm-2" style="text-align:right;">
                <button ng-click="addProdRefPopup();" class="btn"><i class="glyphicon glyphicon-plus"></i> </button>
            </label>
            <div class="col-sm-4">
                <button ng-click="editProdRefPopup();" class="btn"><i class="glyphicon glyphicon-search"></i> </button>
                <button ng-click="ClearBody();" class="btn"><i class="glyphicon glyphicon-refresh"></i> </button>
            </div>
            @*<div class="col-sm-">
                    <button ng-click="ClearBody();" class="btn"><i class="glyphicon glyphicon-refresh"></i> </button>
                </div>*@
        </div>
    </div>
    <!--Master view Left -->
    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="pref.BatchNo.length>0">



        <div class="form-group">
            <label class="col-sm-4 control-label">File No</label>
            <div class="col-sm-8">
                <span> {{pref.FileNo}}</span>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Buyer</label>
            <div class="col-sm-8">
                <span> {{pref.Buyer}}</span>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Customer</label>
            <div class="col-sm-8">
                {{pref.Customer}}
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Batch No</label>
            <div class="col-sm-8">
                {{pref.BatchNo}}
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Process Type</label>
            <div class="col-sm-8">
                {{pref.ProcessType}}
            </div>
        </div>
    </div>

    <!--Master view Rigt-->
    <div class="col-xs-12 col-sm-6 col-md-6" ng-show="pref.BatchNo.length>0">

        <div class="form-group">
            <label class="col-sm-4 control-label">Production Order</label>
            <div class="col-sm-8">
                {{pref.ProductionOrder}}
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Material Master</label>
            <div class="col-sm-8">
                <input type="hidden" ng-model="pref.MaterialMasterId" />
                {{pref.MaterialMaster}}
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Qty</label>
            <div class="col-sm-8">
                {{pref.Qty}}
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Batch Date</label>
            <div class="col-sm-8">
                {{pref.BatchDate}}
            </div>
        </div>

    </div>
    <div class="clearfix"></div>
    <hr style="width:95%; text-align:center;margin-bottom:0px;margin-top:5px;" ng-show="pref.BatchNo.length>0" />

    @*<div class="clearfix"></div>*@

    <div class="common-btn" ng-show="pref.BatchNo.length>0">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <ul class="list-inline text-left">
                <li>
                    <button ng-click="detailEntryPopup('ADDNEW',null);" class="btn"><i class="glyphicon glyphicon-plus"></i>&nbsp;Add Line Item (Criteria)</button>
                </li>
            </ul>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <!--<ul class="list-inline text-right">
                <li>
                    <button ng-click="Save
                );" class="btn"><i class="glyphicon glyphicon-plus"></i>{{Action}}</button></li>
                <li>
                    <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-remove"></i>Delete</button></li>
                <li>
                    <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-trash"></i>Clear</button></li>
            </ul>-->
        </div>

    </div>

    <!--Detail Grid-->
    <div class="col-xs-12 col-sm-12 col-md-12 form-horizontal" ng-show="detailList.length>0">
        <div class="table-responsive modal-table">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th style="width:5px;">Edit</th>
                        <th style="width:5px;">Delete</th>
                        <th style="width:30px;" ng-show="detailmodal.Characteristics1Selected">{{detailmodal.Characteristics1}}</th>
                        <th style="width:30px;" ng-show="detailmodal.Characteristics2Selected">{{detailmodal.Characteristics2}}</th>
                        <th style="width:30px;" ng-show="detailmodal.Characteristics3Selected">{{detailmodal.Characteristics3}}</th>

                        <th style="width:30px;">Process Criteria</th>
                        <th style="width:20px;">Load Factor</th>
                        <th style="width:20px;">Cycle Time</th>
                        <th style="width:20px;">Avg Weight</th>
                        <th style="width:20px;">Uom</th>
                        <th style="width:20px;">Qty</th>
                        <th style="width:5px;">Detail</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in detailList" total-items="$root.total_count">
                        <td>
                            <ul class="list-inline action-list">
                                <li>
                                    <button ng-click="detailEntryPopup('EDIT', x)" class="btn btn-action tooltip-here" data-placement="top" title="Process Criteria" tooltip>
                                        <i class="glyphicon glyphicon-edit"></i>
                                    </button>
                                </li>
                            </ul>
                        </td>
                        <td>
                            <ul class="list-inline action-list">
                                <li>
                                    <button ng-click="deleteDetail(x)" class="btn btn-action tooltip-here" data-placement="top" title="Process Criteria" tooltip>
                                        <i class="glyphicon glyphicon-remove"></i>
                                    </button>
                                </li>
                            </ul>
                        </td>
                        <td ng-show="detailmodal.Characteristics1Selected">{{x.Characteristics1Value}}</td>
                        <td ng-show="detailmodal.Characteristics2Selected">{{x.Characteristics2Value}}</td>
                        <td ng-show="detailmodal.Characteristics3Selected">{{x.Characteristics3Value}}</td>
                        <td>{{x.ProcessCriteria}}</td>
                        <td>{{x.LoadFactor}}</td>
                        <td>{{x.CycleTime}}</td>
                        <td>{{x.AvgWeight}}</td>
                        <td>{{x.WeightUom}}</td>
                        <td>{{x.Qty}}</td>
                        <td>
                            <button ng-click="detailChildEntryPopups(x);" type="submit" title="Subprocess Set" tooltip class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-list-alt"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>


