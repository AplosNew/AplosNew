<h3 class="site-heading" id="mainContainer">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  BOM Report
</h3>
<div class="form-horizontal form-elements">
   
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-sm-6">
            <div class="input-group" ng-show="SelectionType=='MASTERORDER'">
                <input type="text" name="Customer" ng-model="MasterOrder.Id" class="form-control" readonly>
                <span class="input-group-btn">
                    <button ng-click="openPopupAngular('searchNewPopupMasterOrder');SearchMasterOrder();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
            <div class="input-group" ng-show="SelectionType=='PR'">
                <input type="text" name="Customer" ng-model="ProductionOrder.Id" class="form-control" readonly>
                <span class="input-group-btn">
                    <button ng-click="openPopupAngular('searchNewPopupProductionOrder');SearchProductionOrder();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>

        </div>

        <div class="col-xs-6 text-left">
            <input type="radio" ng-model="SelectionType" ng-change="ChangeSelectionType();" value="MASTERORDER">
            <span>Master Order</span>
            <input type="radio" ng-model="SelectionType" ng-change="ChangeSelectionType();" value="PR">
            <span>Production Order</span>
        </div>
    </div>
    <div class="row" style="display:{{SalesOrderList.length>0?'inherit':'none'}};">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            Sales Order List
        </div>
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div id="GridSOItemSelected" ng-init="chkinit()" ej-grid e-datasource="SalesOrderList" e-allowscrolling="true"
                 e-templaterefresh="refreshTemplateSO"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-headertext=""  e-headertemplateid="#headerTemplateSO" e-template="#checkboxTemplateSOSearch" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="SalesOrderId" e-headertext="SO. ID" e-width="120"></div>
                    <div e-column e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
                    <div e-column e-field="Customer" e-headertext="Customer" e-width="180"></div>
                    <div e-column e-field="BuyerOrderNo" e-headertext="Customer Order#" e-width="100"></div>
                    <div e-column e-field="OwnOrderNo" e-headertext="Own Order#" e-width="100"></div>
                    <div e-column e-field="LSD" e-headertext="LSD" e-width="80"></div>
                    <div e-column e-field="DeliveryDate" e-headertext="Del. Date" e-width="80"></div>
                    <div e-column e-field="CommitmentDate" e-headertext="Commi.Date" e-width="80"></div>
                    <div e-column e-field="DestinationName" e-headertext="Dest." e-width="80"></div>
                    <div e-column e-field="ShipmentModeName" e-headertext="Ship.Mode" e-width="80"></div>
                    <div e-column e-field="PONumber" e-headertext="PO No" e-width="80"></div>
                    <div e-column e-field="Buyer" e-headertext="Buyer" e-width="180"></div>
                    <div e-column e-field="Qty" e-headertext="Qty" e-width="80" e-textalign="right"></div>
                    <div e-column e-field="OrderStatusName" e-headertext="Ord. Status" e-width="80"></div>
                    <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="180" e></div>
                    <div e-column e-field="ArticleName" e-headertext="Article" e-width="180"></div>



                    <div e-column e-field="BuyerReferenceNo" e-headertext="Customer Item#" e-width="100"></div>
                    <div e-column e-field="OwnReferenceNo" e-headertext="Own Item#" e-width="100"></div>

                    <div e-column e-field="ProductName" e-headertext="Product" e-width="180" e></div>
                    <div e-column e-field="ProductionGrouping" e-headertext="Product Grouping" e-width="120" e></div>



                    <div e-column e-field="OrderCategoryName" e-headertext="Ord. Cat." e-width="80"></div>

                </div>
                <script type="text/template" id="checkboxTemplateSOSearch">
                    <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Checked" e-checked="data.Checked" />

                </script>
                <script type="text/x-jsrender" id="headerTemplateSO">
                    <input type="checkbox"  ej-checkbox class="nodetext" id="headchkSO"/>
                </script>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="ApplyForItem();" class="btn">Get Items</button></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row" style="display:{{SalesOrderList.length>0 && ItemList.length>0?'inherit':'none'}};">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            BOM Items for Selected Sales Orders
        </div>
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div id="BOQItems" ng-init="chkinit()" ej-grid e-datasource="ItemList" e-allowsorting="true"
                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-allowresizing="true"
                 e-allowscrolling="true" e-minwidth="450" e-minheight="400" e-templaterefresh="refreshTemplateItem"
                 e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-headertext=""  e-headertemplateid="#headerTemplateItem" e-template="#checkboxTemplateItemSearch" e-textalign="center" e-width="20"></div>
                    <div e-column e-type="string" e-field="MaterialGroup" e-headertext="Material Group" e-width="80"></div>
                    <div e-column e-type="string" e-field="Material" e-headertext="Material" e-width="150"></div>
                    <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="200"></div>
                    <div e-column e-type="string" e-field="Vendor" e-headertext="Vendor" e-width="100"></div>

                </div>
            </div>
            <script type="text/template" id="checkboxTemplateItemSearch">
                <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Checked" e-checked="data.Checked" />

            </script>
            <script type="text/x-jsrender" id="headerTemplateItem">
                <input type="checkbox" id="headchkItem" />
            </script>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="getBOMReport();" class="btn">Report</button></li>
                <li> <button ng-click="ChangeSelectionType();" class="btn">Cancel</button></li>
            </ul>
        </div>
    </div>
</div>


<div class="modal site-modal" id="searchNewPopupProductionOrder" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" id="ordermodal">
        <div class="modal-content">
            <div class="modal-header"> Production Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="ProductionOrderSearchValue">
                                            <option ng-repeat="option in modelFilterByProductionOrder" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="ProductionOrderSearchText" ng-enter="SearchProductionOrder()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="SearchProductionOrder()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <div id="GridSearch" ng-init="chkinit()" ej-grid e-datasource="ProductionOrderList" e-recorddoubleclick="SelectProductionOrder" e-allowscrolling="true"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>

                        <div e-column e-field="Id" e-headertext="ID" e-width="80"></div>
                        <div e-column e-field="BuyerRefNo" e-headertext="Customer Ord#" e-width="80"></div>
                        <div e-column e-field="OwnRefNo" e-headertext="Own Ord#" e-width="80"></div>
                        <div e-column e-field="SODesc" e-headertext="So.Description" e-width="150"></div>
                        <div e-column e-field="SOQuantity" e-headertext="Qty" e-width="60"></div>
                        <div e-column e-field="LSD" e-headertext="LSD" e-width="80"></div>
                        <div e-column e-field="PlanExFactoryDate" e-headertext="Ex. Fty Dt" e-width="80"></div>


                        <div e-column e-field="ProductionStatus" e-headertext="Production Status" e-width="90"></div>
                        <div e-column e-field="DeliveryDate" e-headertext="So.Delivery Date" e-width="80"></div>
                        <div e-column e-field="ProductCategory" e-headertext="Product Cat." e-width="130"></div>
                        <div e-column e-field="Product" e-headertext="Product" e-width="150"></div>
                        <div e-column e-field="buyer" e-headertext="Buyer" e-width="150"></div>
                        <div e-column e-field="Customer" e-headertext="Customer" e-width="150"></div>
                        <div e-column e-field="MasterOrderId" e-headertext="Order#" e-width="80"></div>
                        <div e-column e-field="StyleNo" e-headertext="Customer Item#" e-width="80"></div>
                        <div e-column e-field="OwnStyleNo" e-headertext="Own Item#" e-width="80"></div>

                        <div e-column e-field="EntityName" e-headertext="Entity" e-width="90"></div>
                        <div e-column e-field="ProductionRemarks" e-headertext="Remarks" e-width="150"></div>

                    </div>

                </div>

            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="closePopup('searchNewPopupProductionOrder');" class="btn">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal site-modal" id="searchNewPopupMasterOrder" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Master Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="MasterOrderSearchValue">
                                            <option ng-repeat="option in modelFilterByMasterOrder" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="MasterOrderSearchText" ng-enter="SearchMasterOrder()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="SearchMasterOrder()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="GridSearchMasterOrder" ng-init="chkinit()" ej-grid e-datasource="MasterOrderList" e-recorddoubleclick="SelectMasterOrder" 
                     e-allowscrolling="true"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>

                        <div e-column e-field="Id" e-headertext="Id" e-width="80"></div>
                        <div e-column e-field="CustomerName" e-headertext="Customer" e-width="80"></div>
                        <div e-column e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                        <div e-column e-field="OrderStatus" e-headertext="Order Status" e-width="150"></div>
                        <div e-column e-field="OrderCategory" e-headertext="Order Category" e-width="60"></div>
                        <div e-column e-field="OrderYear" e-headertext="Order Year" e-width="60"></div>
                        <div e-column e-field="ResponsiblePersonName" e-headertext="Resp Person" e-width="100"></div>
                        <div e-column e-field="OwnReferenceNo" e-headertext="Own Ord. No" e-width="60"></div>
                        <div e-column e-field="BuyerReferenceNo" e-headertext="Customer Ord. No" e-width="60"></div>
                        <div e-column e-field="OwnItem" e-headertext="Own Item" e-width="60"></div>
                        <div e-column e-field="BuyerItem" e-headertext="Cust. Item" e-width="60"></div>
                        <div e-column e-field="ContractNo" e-headertext="Contract No" e-width="60"></div>
                        <div e-column e-field="MasterLCNo" e-headertext="Master LC" e-width="60"></div>
                        <div e-column e-field="TotalQty" e-headertext="Total Qty" e-width="60"></div>
                        <div e-column e-field="NoOfLineItem" e-headertext="NoOfLineItem" e-width="60"></div>
                        

                    </div>

                </div>

            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="closePopup('searchNewPopupMasterOrder');" class="btn">Close</button></li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>
