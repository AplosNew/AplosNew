<div class="row">
    <div class="col-sm-12">
        <div id="GridEditBOQItemChild" ng-init="chkinit()" ej-grid e-datasource="AttachmentBOMItemDataChild"  e-allowsorting="true"
             e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" e-allowresizing="true"
             e-allowscrolling="true" e-minwidth="450" e-minheight="400" @*e-rowdatabound="rowDataBoundRequisition"*@
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                @*<div e-column e-template="#ShowActionButtonRequirementApprovalChild" e-isfrozen="true" e-headertext="" e-width="66"></div>*@

                <div e-column e-type="string" e-field="SalesOrderId" e-headertext="SO Id" e-width="70"></div>
                @*<div e-column e-field="isParent" e-headertext="isParent" e-width="70"></div>*@

                <div e-column e-type="string" e-field="Material" e-headertext="Material" e-width="120"></div>
                <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="120"></div>
                <div e-column e-type="string" e-field="RMDescription" e-headertext="RM Description" e-width="130"></div>

                <div e-column e-type="string" e-field="CharVal1" e-headertext="SKU-1" e-width="60"></div>
                <div e-column e-type="string" e-field="CharVal2" e-headertext="SKU-2" e-width="60"></div>
                <div e-column e-type="string" e-field="CharVal3" e-headertext="SKU-3" e-width="60"></div>
                <div e-column e-type="number" e-format="{0:N2}" e-field="BOMQty" e-headertext="BOM Qty" e-width="80"></div>
                <div e-column e-type="number" e-format="{0:N2}" e-field="RequiredQty" e-headertext="Required Qty" e-width="80"></div>
                @*<div e-column e-template="#ShowTextBoxRequiredQtyChild" e-headertext="Required Qty" e-width="160"></div>*@
                <div e-column e-type="string" e-field="UOM" e-headertext="UOM" e-width="60"></div>
                <div e-column e-type="string" e-field="SKUDesc" e-headertext="SKU Desc" e-width="80"></div>
                <div e-column e-type="string" e-field="RMCustomerSpec" e-headertext="RM Customer Spec" e-width="130"></div>
                <div e-column e-type="string" e-field="RMVendorSpec" e-headertext="RM Vendor Spec" e-width="130"></div>



                <div e-column e-type="number" e-format="{0:N2}" e-field="OrderQty" e-headertext="Order Qty" e-width="70"></div>
                <div e-column e-type="number" e-format="{0:N2}" e-field="PlanOrderQty" e-headertext="Plan Order Qty" e-width="70"></div>
                <div e-column e-type="string" e-field="ParentUOM" e-headertext="UOM" e-width="60"></div>

                <div e-column e-type="number" e-format="{0:###.00%}" e-field="WastagePer" e-headertext="Wastage Per" e-width="80"></div>
                <div e-column e-type="number" e-format="{0:###.0000}" e-field="Consumption" e-headertext="Consumption" e-width="80"></div>


                <div e-column e-type="string" e-field="Vendor" e-headertext="Vendor" e-width="150"></div>
                @*<div e-column e-template="#ShowActionButtonsVendorChild" e-headertext="" e-width="120"></div>*@

            </div>
        </div>
        <script type="text/template" id="ShowActionButtonRequirementApprovalChild">
            <div class="common-btn">
                <ul class="list-inline text-left small">
                    <li>
                        <button ng-click="$parent.AttachmentApprovalRequiredQty(data);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                            <i class="glyphicon glyphicon-ok-circle" style="color:{{data.RequiredQtyApproved?'#00ff00':'#999999'}}"></i>
                        </button>
                    
                    </li>

                </ul>
            </div>
        </script>
        <script type="text/template" id="ShowActionButtonsVendorChild">
            <div class="common-btn">
                <ul class="list-inline text-right small">
                    <li>

                        <span class="input-group-btn">
                            <button ng-click="$parent.showPartyPopUp();$parent.AttachmentOpenParty(data);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="$parent.AttachmentclearVendor(data)" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </li>
                </ul>
            </div>
        </script>
        <script type="text/template" id="ShowTextBoxRequiredQtyChild">
            <input e-enabled="{{data.isParent==true?'false':'true'}}" type="text" ej-numerictextbox e-minvalue="0" e-decimalplaces="2" e-enablertl="true" e-value="data.RequiredQty" e-width="150" />
        </script>
    </div>
    <div class="col-sm-12">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="AttachmentUpdateBomRequiredQtyChild();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
                <li> <button ng-click="AttachmentclosePopup('dialogBOMItemEditChild')" class="btn"><i class="glyphicon glyphicon-refresh"></i> Close</button></li>
            </ul>
        </div>
    </div>
</div>
