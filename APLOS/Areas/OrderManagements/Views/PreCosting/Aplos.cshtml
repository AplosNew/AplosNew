<togglable name="Pre Costing"></togglable>
<div class="form-horizontal" ng-form id="preCostingNew" name="preCostingNewForm">
    <div class="row">
        <div class="form-elements">
            <input type="hidden" ng-model="preCostingNew.Id">
            @*<div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">IsInquiryLinked</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="preCostingNew.IsInquiryLinked">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                    </div>
                </div>*@
            <div class="clearfix"></div>
            <div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Plant</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="preCostingNew.PlantId"
                                        ng-options="item.Value as item.Text for item in plantList"
                                        ng-change="GetPreCostingCalculation(preCostingNew.PlantId)">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Finished Goods<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" name="Finished Goods" ng-model="preCostingNew.FinishedGoods" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button tabindex="7" ng-click="getGenericPopUpForInquiyLinkedForm();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Buyer<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="preCostingNew.BuyerId"
                                        ng-options="item.Value as item.Text for item in buyerList" tabindex="10">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-sm-12" ng-show="articleList.length>0">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Article</legend>
                        <div class="col-xs-12 col-sm-8 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Article Code</label>
                                <div class="col-sm-7">
                                    <input type="text" name="Id" ng-model="preCostingNew.ArticleCode" class="form-control" readonly tabindex="3">
                                </div>
                                @*<div class="col-sm-1">
                                        <button class="btn single-small-btn" ng-click="loadMaterialMasterArticleModalList()"><i class="cr-icon glyphicon glyphicon-edit"></i></button>
                                    </div>*@
                            </div>
                            <div ng-repeat="x in articleHead">
                                <div class="form-group" ng-if="$index%2===0">
                                    <label class="col-sm-4 control-label">{{x.MaterialAttributeName}}</label>
                                    <div class="col-sm-8">
                                        <input type="text" name="Id" ng-model="preCostingNew[x.MaterialAttributeName]" class="form-control" readonly tabindex="3">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Article Name</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Id" ng-model="preCostingNew.ArticleStandardName" class="form-control" readonly tabindex="3">
                                </div>
                            </div>
                            <div ng-repeat="x in articleHead">
                                <div class="form-group" ng-if="$index%2 !=0">
                                    <label class="col-sm-4 control-label">{{x.MaterialAttributeName}}</label>
                                    <div class="col-sm-8">
                                        <input type="text" name="Id" ng-model="preCostingNew[x.MaterialAttributeName]" class="form-control" readonly tabindex="3">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
            <div class="clearfix"></div>
            <div>
                <div class="site-tab">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">General</a></li>
                        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Meterial Group</a></li>
                        <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Calculation</a></li>
                    </ul>
                </div>
                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                        <div class="row" ng-form="tabFrom1">
                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Style Category<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="preCostingNew.CriticalId"
                                                    ng-options="item.Value as item.Text for item in styleCategoryList" tabindex="10">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Selling Price<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="SellingPrice" n-decimals="4" ng-model="preCostingNew.SellingPrice" class="form-control" required tabindex="5">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Remarks</label>
                                    <div class="col-sm-8">
                                        <textarea class="form-control" name="Remarks" rows="3" ng-model="preCostingNew.Remarks" maxlength="250" tabindex="7" ng-trim="false"></textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">SPT<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="Code" only-numbers ng-model="preCostingNew.SPT" class="form-control" required tabindex="2">
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="preCostingNew.CurrencyId"
                                                    ng-options="item.Value as item.Text for item in currencyList" tabindex="10">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                        <div class="row" ng-form="tabFrom2" ng-show="preCostingNew.Id !=null">
                            <div class="col-xs-12">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="showMaterialGroupMasterPopUp();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> Add Line Item</button></li>
                                    </ul>
                                </div>
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Delete</th>
                                                <th>Code</th>
                                                <th>User Name</th>
                                                <th>Material Type</th>
                                                <th>Description</th>
                                                <th>Base UOM</th>
                                                <th>Consumption UOM</th>
                                                <th>Consumption</th>
                                                <th>Rate</th>
                                                <th>Detail</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in materialGroupMasterListForSave">
                                                <td class="text-right table-td">
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="valuePassInMaterialFormDelModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                                <i class="glyphicon glyphicon-remove"></i>
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </td>
                                                <td>{{x.Code}}</td>
                                                <td>{{x.MaterialGroupMasterName}}</td>
                                                <td>{{x.MaterialTypeName}}</td>
                                                <td>
                                                    <input type="text" name="Description" style="height:24px;margin-top: -3px;" ng-model="x.Description" class="form-control">
                                                </td>
                                                <td>{{x.BaseUOM}}</td>
                                                <td style="width:144px;">
                                                    <div class="select-style">
                                                        <select class="form-control" style="height:24px;" required ng-model="x.AlternativeUOMId"
                                                                ng-options="item.Value as item.Text for item in x.AlernativeUomLists" id="AlternativeUomId"
                                                                name="AlternativeUom" tabindex="1">
                                                            <option></option>
                                                        </select>
                                                    </div>
                                                </td>
                                                <td>
                                                    <input type="text" name="UomValue" style="height:24px;margin-top: -3px;" n-decimals="4" ng-model="x.UomValue" class="form-control">
                                                </td>
                                                <td>
                                                    <input type="text" name="Rate" style="height:24px;margin-top: -3px;" n-decimals="4" ng-model="x.Rate" class="form-control">
                                                </td>
                                                <td>
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="getMaterialGroupArticleProductionProcessPopUp($index, x)" class="btn-action tooltip-here" data-placement="top" title="Detail">
                                                                <i class="glyphicon glyphicon-list"></i>
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-xs-12">
                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li> <button ng-click="MaterialGroupMasterSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save Line Item</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                        <div class="row" ng-form="tabFrom3">
                            <div class="col-xs-12">
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Entity</th>
                                                <th>Work Station</th>
                                                <th>Hourly Fixed Cost</th>
                                                <th>Hourly Variable Cost</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in preCostingCalculationEntityList">
                                                <td>{{x.EntityName}}</td>
                                                <td>{{x.WorkStation}}</td>
                                                <td>{{x.HourlyFixedCost}}</td>
                                                <td>{{x.HourlyVariableCost}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="clearfix">
                            </div>
                            <div class="col-xs-12">
                                <br />
                                <div>
                                    <p>Total Work station Of Entity: {{totalWorkStationOfEntity}}</p>
                                    <p>Total Hourly Cost Of Entity: {{totalHourlyCostOfEntity}}</p>
                                    <p>Per hour work station cost :{{perHourWSCost}}           </p>
                                </div>
                            </div>
                            <div class="clearfix">
                            </div>
                            <div class="col-xs-12">
                                <br />
                                <div>
                                    <p>No of work station required for FG: {{noOfWorkStationRequiredForFg}}</p>
                                    <p>Hourly Cost for the FG: {{hourlyCostForFG}}</p>
                                    <p>Total minute of the work station :{{totalMinuteOfTheWorkStation}}           </p>
                                    <p>SPT:{{finishGoodSPT}}           </p>
                                    <p>Efficiency:{{finishGoodEfficiency}}           </p>
                                </div>
                            </div>
                            <div class="clearfix">
                            </div>
                            <div class="col-xs-12">
                                <br />
                                <div>
                                    <p>Time required at efficency: {{timeRequiredAtEfficiency}}</p>
                                    <p>Output per hour: {{outputPerHour}}</p>
                                    <p>Per Output cost :{{costOutputPerHour}}           </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
                        <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByPreCostingList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Buyer Name</th>
                <th>Finished Goods</th>
                <th>Criticality</th>
                <th>Selling Price</th>
                <th>SPT</th>
                @*<th>Material Group</th>*@
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in preCostings |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.BuyerName}}</td>
                <td>{{x.FinishedGoods}}</td>
                <td>{{x.CriticalName}}</td>
                <td>{{x.SellingPrice}}</td>
                <td>{{x.SPT}}</td>
                @*<td class="text-right table-td">
                        <ul class="list-inline action-list">
                            <li>
                                <button ng-click="materialGroupMasterFormSearchPopup(x)" class="btn-action" title="materialGroupMaster Assign">
                                    <i class="glyphicon glyphicon-list"></i>
                                </button>
                            </li>
                        </ul>
                    </td>*@
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<div class="modal fade site-modal in" id="inquiryPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Inquiry</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="inquiryListParameters.searchBy">
                                            <option ng-repeat="option in searchbyInquiryList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="inquiryListParameters.search" ng-enter="loadInquiryData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadInquiryData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Finished  Goods</th>
                                <th>Material Group </th>
                                <th>Product Master</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in inquiryDataList | itemsPerPage:inquiryListParameters.pageSize" pagination-id="metaData.name + 'inquiryDataList'" total-items="inquiryListParameters.total_count" ng-dblclick="selectInquiryInfo(x)">
                                <td>{{x.FinishedGoods}}</td>
                                <td>{{x.MaterialGroupName}}</td>
                                <td>{{x.ProductMasterName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'inquiryDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadInquiryData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="inquirySelectdCloseListPopUp();" class="btn">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="mgProductionProcessGroupArticleFormPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Material Group Aticle</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="form-element-ctrl col-xs-12 col-sm-12 col-md-12">
                        <div class="form-group">
                            <label class="col-sm-2 control-label">Article<sup>*</sup></label>
                            <div class="col-sm-4 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                                <input type="text" name="Material Group(Mst)" ng-model="preCostingNew.MaterialGroupArticleName" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="showMaterialGroupArticlePopUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Prod Process Group</th>
                                        <th>Input</th>
                                        <th class="col-md-2">Wastage</th>
                                        <th>Output</th>
                                        <th class="col-md-2">Rate</th>
                                        <th>Criteria</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in materialGroupArticleProductionProcessList">
                                        <td>{{x.ProductionProcessGroupName}}</td>
                                        <td>
                                            {{x.InputValue}}
                                        </td>
                                        <td>{{x.Wastage}}</td>
                                        <td>{{x.OutputValue}}</td>
                                        <td>{{x.Rate}}</td>
                                        <td>
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="showMaterialGroupProductionCriteriaPop(x)" class="btn-action tooltip-here" data-placement="top" title="Detail">
                                                        <i class="glyphicon glyphicon-list"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="materialGroupMasterFormPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Material Group Master</h4>
            </div>
            <div class="modal-body">
                <div class="row">

                    <div class="col-xs-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="showMaterialGroupMasterPopUp();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> Add Line Item</button></li>
                            </ul>
                        </div>
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Delete</th>
                                        <th>Code</th>
                                        <th>Material Group</th>
                                        <th>Material Type</th>
                                        <th>Base UOM</th>
                                        <th>Alternative UOM</th>
                                        <th>Consumption Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in materialGroupMasterListForSave">
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="valuePassInMaterialFormDelModal($index, x.Id)" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                        <td>{{x.Code}}</td>
                                        <td>{{x.MaterialGroupMasterName}}</td>
                                        <td>{{x.MaterialTypeName}}</td>
                                        <td>{{x.BaseUOM}}</td>
                                        <td style="width:144px;">
                                            <div class="select-style">
                                                <select class="form-control" style="height:24px;" required ng-model="x.AlternativeUOMId"
                                                        ng-options="item.Value as item.Text for item in x.AlernativeUomLists" id="AlternativeUomId"
                                                        name="AlternativeUom" tabindex="1">
                                                    <option></option>
                                                </select>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="text" name="UomValue" style="height:24px;margin-top: -3px;" n-decimals="4" ng-model="x.UomValue" class="form-control">
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
