<togglable name="Production Order Reports"></togglable>

<div id="maincontent">
    <div class="row">
        <div class="col-sm-12">
            <div id="gridSelectPlant" ng-init="chkinit()" ej-grid e-datasource="Plants" e-width="500"
                 e-responsive="true">
                <div e-columns>
                    <div e-column e-template="#plantselect" e-width="5"></div>
                    <div e-column e-field="PlantName" e-headertext="Plant Name" e-width="50"></div>
                    <div e-column e-field="SelectedEntities" e-headertext="Selected Entities" e-width="100"></div>
                    <div e-column e-template="#showEntityList" e-width="5"></div>
                </div>

            </div>
        </div>
        <script type="text/template" id="plantselect">
            <div class="checkbox-site">
                <label>
                    <input type="checkbox" ng-model="data.isChecked" ng-checked="data.isChecked" ng-change="$parent.SelectPlant(data.Id)">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </script>
        <script type="text/template" id="showEntityList">
            <div class="common-btn">
                <ul class="list-inline text-right small">
                    <li>
                        <button ng-click="$parent.showEntityPopUp(data.Id,data.PlantName);" class="btn small" style="height: 20px;width: 20px; padding: 0px; margin: 0px;">
                            <i class="glyphicon glyphicon-th-list"></i>
                        </button>
                    </li>

                </ul>
            </div>
        </script>

    </div>

    <div class="row">

        <div class="form-group">
            <label class="col-sm-2 control-label">From Date<sup class="redFont"> *</sup></label>
            <div class="col-sm-4 text-left">
                <input type="text" name="fromdate" ng-model="FromDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-2 control-label">To Date<sup class="redFont"> *</sup></label>
            <div class="col-sm-4 text-left">

                <input type="text" name="fromdate" ng-model="ToDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required>
            </div>
        </div>

    </div>
    <div class="row">

        <label class="col-sm-2 control-label">Production Status</label>
        <div class="col-sm-4">

            <span class="checkbox-site" ng-repeat="option in productionStatusList">

                <label>
                    <input type="checkbox" ng-model="option.Checked">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    {{option.Text}}
                </label>

            </span>

        </div>

    </div>
    <div class="row" style="padding-top:40px;">
        <div class="form-group">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <ul class="common-btn list-inline text-left">
                    <li>
                        <button id="spltbuttonMasterOrder" ej-splitbutton e-showroundedcorner="false" e-text="Master Order" e-targetid="UlMasterOrder"></button>
                        <ul id="UlMasterOrder" style="width:160px;background-color:transparent;border:none;">
                            <li style="height: 36px;background-color:transparent;">
                                <button class="btn" ng-click="getMasterOrder('nonclosed');" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> Non-Closed Orders</button>
                            </li>
                            <li style="height:36px;background-color:transparent;">
                                <button class="btn" ng-click="getMasterOrder('closed');" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> Closed Orders</button>
                            </li>
                        </ul>

                    </li>

                    <li>
                        <div ej-tooltip e-showshadow="true" e-content="All active orders with individual line items" ng-click="getos1();" e-width="width">
                            <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> OS-1</button>
                        </div>
                    </li>
                    <li>
                        <div ej-tooltip e-showshadow="true" e-content="All active orders with production plan data" ng-click="getos2();" e-width="width">
                            <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> OS-2</button>
                        </div>
                    </li>
                    <li>
                        <div ej-tooltip e-showshadow="true" e-content="Distribution of production and planning data into sales orders<br/><b>Note: Running planning simulation before taking this report will provide more accurate result<b/>" ng-click="getos3();" e-width="width">
                            <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> OS-3</button>
                        </div>
                    </li>
                    <li>
                        <div ej-tooltip e-showshadow="true" e-content="Plan Vs. Actual Production<br/>Note: Entity and date range is required to get the report" ng-click="getos4();" e-width="width">
                            <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> OS-4</button>
                        </div>
                    </li>
                    <li>
                        <div ej-tooltip e-showshadow="true" e-content="Process wise plan data" ng-click="getos5();" e-width="width">
                            <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> OS-5</button>
                        </div>
                    </li>
                    <li>
                        <div ej-tooltip e-showshadow="true" e-content="Production Data for <br/>1. For the day production,<br/>2. For the date range production,<br/>3. Upto date production" ng-click="getProductionInfoWithWIP();" e-width="width">
                            <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> Production Info</button>
                        </div>
                    </li>
                    <li>
                        <div ej-tooltip e-showshadow="true" e-content="Production plan data with line gap" ng-click="LineBookingStatus();" e-width="width">
                            <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> Workcenter Booking Status</button>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12">
                <ul class="common-btn list-inline text-left">
                    <li>
                        <div ej-tooltip e-showshadow="true" e-content="Production data" ng-click="ProductionData();" e-width="width">
                            <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> Production Data</button>
                        </div>
                    </li>
                    <li>
                        <div ej-tooltip e-showshadow="true" e-content="<b>Parameter: Entity</b><br/> Only non-closed production orders with bulletin shown in  the report." ng-click="Bulletin();" e-width="width">
                            <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> Bulletin </button>
                        </div>
                    </li>
                    <li>
                        <div ej-tooltip e-showshadow="true" e-content="Snapshot 2" ng-click="Snapshot2Data();" e-width="width">
                            <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> Snapshot 2</button>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<ej-dialog id="dialogSelectEntity" title="SinglePlantEntity" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target="#maincontent" e-minheight="200" e-width="290" e-open="enableBtn">

    <div class="row" style="width:290px!important;">
        <div id="gridSelectEntity" ng-init="chkinit()" ej-grid e-datasource="SinglePlantEntity"
             e-responsive="true">
            <div e-columns>
                <div e-column e-template="#entityselect" e-width="2"></div>
                <div e-column e-field="Entity" e-headertext="Entity" e-width="20"></div>
            </div>

        </div>
        <script type="text/template" id="entityselect">
            <div class="checkbox-site">
                <label>
                    <input type="checkbox" ng-model="data.isChecked" ng-checked="data.isChecked" ng-change="$parent.ConstructSelectedEntities(data.PlantId)">
                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                </label>
            </div>
        </script>


    </div>


</ej-dialog>