<togglable name="Line Day Criticality"></togglable>
<div class="form-elements form-horizontal" ng-form name="orderCategoryNewForm">
    <input type="hidden" ng-model="lineDayCriticalityNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Line Day</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="lineDayCriticalityNew.WorkDay"
                            ng-options="item.Value as item.Text for item in workingDayList" id="LineDay" tabindex="1"
                            name="LineDay"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div ng-repeat="x in criticalList">
            <div class="form-group" ng-if="$index%2===0">
                <label class="col-sm-4 control-label">{{x.UserName}} (%)</label>
                <div class="col-sm-8">
                    <input type="text" name="Id" only-numbers ng-model="lineDayCriticalityNew[x.UserName]" class="form-control" tabindex="{{$index+1}}">
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div ng-repeat="x in criticalList">
            <div class="form-group" ng-if="$index%2 !=0">
                <label class="col-sm-4 control-label">{{x.UserName}} (%)</label>
                <div class="col-sm-8">
                    <input type="text" name="Id"  only-numbers ng-model="lineDayCriticalityNew[x.UserName]" class="form-control" tabindex="{{$index+1}}">
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Line Day</th>
                <th ng-repeat="h in criticalList">{{h.UserName}}</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in lineDayCriticalitySelectedList" ng-dblclick="Get(x,$index);">
                <td>{{x.WorkDay}}</td>
                <td ng-repeat="h in criticalList">{{x[h.UserName]}} <span ng-if="x[h.UserName] !=null">%</span></td>

            </tr>
        </tbody>
    </table>
</div>

