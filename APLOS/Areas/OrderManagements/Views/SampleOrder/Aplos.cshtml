<togglable name="Sample Order"></togglable>
<div class="form-horizontal form-element-ctrl col-xs-12 col-sm-12 col-md-12" ng-form name="sampleOrderNewForm">
    <div class="form-group" show-errors>
        <label class="col-sm-2 control-label">Production Entity<sup>*</sup></label>
        <div class="col-sm-4 show-message">
            <div class="select-style">
                <select name="EntityId" ng-model="sampleOrderNew.EntityId" class="col-sm-3 form-control" ng-change="getDataList();"
                        ng-options="item.Value as item.Text for item in entityList" required tabindex="1">
                    <option value=""></option>
                </select>
            </div>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<div class="form-horizontal form-elements" ng-form name="sampleOrderNewForm">
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="partnerfunction" role="tab" data-toggle="tab">Material Group (Mst)</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="sampleOrderFormTab1">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sales Org.<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Sales Organisation" class="form-control" ng-change="LoadSalesGroup(false);clearChangeOnSalesOrg();" ng-disabled="sampleOrderNew.PlantId==null"
                                            ng-model="sampleOrderNew.SalesOrganisationId" ng-options="item.Value as item.Text for item in salesOrganizationList" required tabindex="2">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <span class="input-group-addon">{{sampleOrderNew.PartyCode}}</span>
                                    <input type="text" name="Vendor" ng-model="sampleOrderNew.PartyName" class="form-control" required readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="showPartyPopUp()" ng-disabled="subMaterialList.length>0" class="btn single-small-btn" tabindex="4"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                        <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Payment Term<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Payment Term" class="form-control" ng-model="sampleOrderNew.PaymentTermId" ng-disabled="!sampleOrderNew.IsChangeable"
                                            ng-options="item.Value as item.Text for item in paymentTermList" required tabindex="6">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" id="reqRefDateId">
                            <label class="col-sm-4 control-label">Request Ref. Date</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" ng-model="sampleOrderNew.RequestReferenceDate" ng-change="rangeDateValidation('reqRefDateId',false);" datepicker class="form-control" tabindex="8">
                            </div>
                        </div>
                        <div class="form-group" id="deliveryDateId">
                            <label class="col-sm-4 control-label">Delivery Date</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" ng-model="sampleOrderNew.DeliveryDate" ng-change="rangeDateValidation('deliveryDateId',true);" datepicker class="form-control" tabindex="10">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sales Group<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Sales Group" class="form-control" ng-model="sampleOrderNew.SalesGroupId" ng-disabled="sampleOrderNew.SalesOrganisationId==null"
                                            ng-options="item.Value as item.Text for item in salesgroupList" required tabindex="3">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Buyer<sup ng-show="buyerApplicable">*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Buyer" class="form-control" ng-model="sampleOrderNew.BuyerId" tabindex="5"
                                            ng-options="item.Value as item.Text for item in buyerList" ng-required="buyerApplicable">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Currency</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Currency" class="form-control" ng-model="sampleOrderNew.CurrencyId" required tabindex="7" ng-change="InsertCurrencyInTbl();" id="curId"
                                            ng-options="item.Value as item.Text for item in currencyList">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Ref. Doc No</label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="sampleOrderNew.ReferenceDocNo" class="form-control" tabindex="9">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form="sampleOrderFormTab2">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-disabled="sampleOrderNew.PartyName==null" ng-click="ShowSubMaterialFormPopUp();" class="btn"><i class="glyphicon glyphicon-plus"></i> Material Group (Mst)</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-12 col-md-12" ng-show="subMaterialList.length>0">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Material Group(Mst.)</th>
                                        <th>Name</th>
                                        <th>Qty</th>
                                        <th>UoM</th>
                                        <th>Rate</th>
                                        <th>Currency</th>
                                        <th>DeliveryDate</th>
                                        <th>Confirmed</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in subMaterialList">
                                        <td>{{x.MaterialGroupMasterName}}</td>
                                        <td>{{x.Name}}</td>
                                        <td>{{x.Qty}}</td>
                                        <td>{{x.UoMName}}</td>
                                        <td>{{x.Rate}}</td>
                                        <td>{{x.CurrencyName}}</td>
                                        <td>{{x.DeliveryDate}}</td>
                                        <td>{{x.IsConfirmed?'Yes':'No'}}</td>
                                        <td class="text-center">
                                            <ul class="list-inline action-list">
                                                @*<li>
                                                        <button ng-click="materialAttributeValueEdit(x)" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                            <i class="glyphicon glyphicon-pencil"></i>
                                                        </button>
                                                    </li>*@
                                                <li>
                                                    <button ng-click="MaterialAttributeValueDelete($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchsampleOrderList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Plant</th>
                    <th>Entity</th>
                    <th>Sales Org.</th>
                    <th>Sales Group</th>
                    <th>Buyer</th>
                    <th>Customer</th>
                    <th>Currency</th>
                    <th>Request Ref. Date</th>
                    <th>Ref. DocNo</th>
                    <th>Delivery Date</th>
                    <th>Id</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in soMasterList|itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get($index);" pagination-id="metaData.name + 'soMasterList'">
                    <td>{{x.Plant}}</td>
                    <td>{{x.Entity}}</td>
                    <td>{{x.SalesOrganisation}}</td>
                    <td>{{x.SalesGroup}}</td>
                    <td>{{x.Buyer}}</td>
                    <td>{{x.PartyName}}</td>
                    <td>{{x.Currency}}</td>
                    <td>{{x.RequestReferenceDate}}</td>
                    <td>{{x.ReferenceDocNo}}</td>
                    <td>{{x.DeliveryDate}}</td>
                    <td>{{x.Id}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10"
                                 pagination-id="metaData.name + 'soMasterList'"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="getData(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>
<confirm-modal></confirm-modal>
<!-- #region Customer -->
@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUp.cshtml")
<!-- #endregion -->
<!-- #region PartnerFunction -->
<div class="modal fade site-modal in" id="invoicingPartyPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Invoicing Party<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Ship To</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="sampleOrderNew.DeliveryPartyPlantId" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(sampleOrderNew.DeliveryPartyPlantId,'shipTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p>{{sampleOrderNew.DeliveryState}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Shipping by Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="sampleOrderNew.DeliveryByAddress" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 col-md-4 control-label">Bill To</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select ng-model="sampleOrderNew.InvoicingPartyPlantId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in partyPlantList| filter:{ PartyId: x.PartyId }" ng-change="billShippAddress(sampleOrderNew.InvoicingPartyPlantId,'billTo')">
                                    <option value=""></option>
                                </select>
                            </div>
                            <p>{{sampleOrderNew.InvoicingState}}</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Billing Address</label>
                        <div class="col-sm-8">
                            <textarea type="text" rows="3" ng-model="sampleOrderNew.InvoicingByAddress" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeInvoicingPartyPopUp();" class="btn"> Done</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
<!-- #region subMaterial -->
<div class="modal fade site-modal in" id="subMaterialPoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Material Group (Mst)<button type="button" class="close" ng-click="CloseSubMaterialPopUp();" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-element-ctrl form-horizontal">
                <input type="hidden" ng-model="subMaterialNew.Id" />
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Material Group (Mst)<sup>*</sup></label>
                        <div class="col-sm-6 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                            <input type="text" name="Material Group (Mst)" ng-model="subMaterialNew.MaterialGroupMasterName" class="form-control" required readonly>
                            <span class="input-group-btn">
                                <button class="btn single-small-btn" ng-click="materialGroupMstPopUp()"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                <button class="btn single-small-btn" ng-click="materialGroupClear()"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div ng-show="attributeList.length>0">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Attribute</th>
                                        <th>Attribute Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in attributeList">
                                        <td> {{x.MaterialAttributeName}}</td>
                                        @*<td>
                                                <div class="col-sm-8 input-group" style="margin-top:-2px;">
                                                    <input type="text" ng-model="x.MaterialAttributeValueFreeText" class="col-sm-2 form-control" ng-keyup="idNullByFreeText(x.MaterialAttributeId, $index)" ng-disabled="x.FlagDisable" name="Material attribute value">
                                                    <span class="input-group-btn">
                                                        <button ng-click="materialAttributeValuePoUp(x.MaterialAttributeId, $index)" ng-disabled="!x.IsPreDefinedField" class="btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                                        <button ng-click="materialAttributeValueClear($index)" class="btn"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                                    </span>
                                                </div>
                                                <p class="msg-error" ng-show="IsMandatoryButNull(x.IsMandatory, x.MaterialAttributeValueFreeText)">value is required.</p>
                                            </td>*@
                                        <td>
                                            <div class="col-sm-10">
                                                <div class="input-group">
                                                    <input type="text" ng-model="x.MaterialAttributeValueFreeText" class="form-control" ng-keyup="idNullByFreeText(x.MaterialAttributeId, $index)" ng-disabled="x.FlagDisable" ng-required="x.IsMandatory">
                                                    <span class="input-group-btn">
                                                        <button ng-click="valuePoUp(x, $index)" ng-disabled="!x.IsPreDefinedField" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                                                        <button ng-click="materialAttributeValueClear($index)" class="btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                                    </span>
                                                </div>
                                            </div>
                                            <p class="msg-error" ng-show="IsMandatoryButNull(x.IsMandatory, x.MaterialAttributeValueFreeText)">value is required.</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4" style="margin-top:10px;">
                        <div class="form-group">
                            <label class="col-sm-2 control-label">Qty<sup>*</sup></label>
                            <div class="col-sm-5" style="padding-right:0px;padding-left:24px;">
                                <input type="text" only-numbers ng-model="subMaterialNew.Qty" class="form-control text-right" tabindex="21">
                            </div>
                            <div class="col-sm-5" style="padding-left:0px">
                                <div class="select-style">
                                    <select ng-model="subMaterialNew.UoMId" class="form-control" name="BaseUOM" tabindex="22"
                                            id="uOMId" ng-disabled="materialMasterAlternativeUOMs.length>0" ng-options="item.Value as item.Text for item in subMaterialUOMList">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4" style="margin-top:10px;">
                        <div class="form-group">
                            <label class="col-sm-2 control-label">Rate<sup>*</sup></label>
                            <div class="col-sm-5" style="padding-right:0px;padding-left: 24px;">
                                <input type="text" n-decimals="4" ng-model="subMaterialNew.Rate" class="form-control text-right" tabindex="23">
                            </div>
                            <div class="col-sm-5" style="padding-left:0px;">
                                <div class="select-style">
                                    <select name="Currency" class="form-control" ng-model="subMaterialNew.CurrencyId" id="currencyId"
                                            ng-options="item.Value as item.Text for item in currencyList" disabled>
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4" style="margin-top:10px;">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Delivery Date</label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="subMaterialNew.DeliveryDate" datepicker class="form-control" tabindex="24">
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Test Std</label>
                            <div class="col-sm-9" style="padding-left:1px;">
                                <div class="select-style">
                                    <select class="form-control" ng-model="subMaterialNew.TestingStandardId"
                                            ng-options="item.Value as item.Text for item in testingStdList" tabindex="26">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-8 col-md-8">
                        <div class="form-group">
                            <label class="col-sm-2 control-label" style="margin-right: -36px;">Remarks</label>
                            <div class="col-sm-10">
                                <textarea ng-model="subMaterialNew.Remarks" class="form-control" rows="2" name="Remarks" maxlength="250" ng-trim="false" tabindex="26"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix common-btn" style="padding-right: 15px;">
                    <ul class="list-inline text-right">
                        <li><button tabindex="27" ng-click="AddSubMaterial();" class="btn" ng-disabled="attributeList.length==0">{{subMaterialCaption}}</button></li>
                        <li><button tabindex="28" type="button" class="btn btn-default" ng-click="CloseSubMaterialPopUp();">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="subMaterial" title="Confirmation" message={{subMaterialMessage}}
                         data-ng-click-right-button="removeSubMaterialRow()"></confirm-archive-generic>
<!-- #endregion -->
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialGroupMstPopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_AttributeValuePopUp.cshtml")
<confirm-archive-generic data-modalid="pfDelPopUp" title="Confirmation" message={{pf_message}} data-ng-click-right-button="removePf()"></confirm-archive-generic>