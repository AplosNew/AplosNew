<togglable name="Product Planning"></togglable>
<div class="form-horizontal form-elements" ng-form="modelNewForm">
    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Workstations<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <textarea class="form-control" name="Workstations" rows="2" ng-model="model.NoOfWorkStation" maxlength="250" tabindex="4"></textarea>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Efficiency</label>
            <div class="col-sm-8">
                <textarea class="form-control" name="Remarks" rows="2" ng-model="model.Efficiency" maxlength="250" tabindex="4"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">SPT<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <textarea class="form-control" name="Workstations" rows="2" ng-model="model.SPT" maxlength="250" tabindex="4"></textarea>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Efficiency</label>
            <div class="col-sm-8">
                <textarea class="form-control" name="Remarks" rows="2" ng-model="model.Efficiency" maxlength="250" tabindex="4"></textarea>
            </div>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in modelFilterByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="Gridunassigned" ng-init="chkinit()" ej-grid e-datasource="modelList" e-recorddoubleclick="Get" e-rowdatabound="rowDataBoundOrder"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Order ID" e-width="5"></div>
            <div e-column e-field="EntityName" e-headertext="Entity" e-width="5"></div>
            <div e-column e-field="ProductionStatus" e-headertext="Production Status" e-width="5"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="8"></div>
        </div>

    </div>
</div>