@*<h3 class="site-heading"><span class="glyphicon glyphicon-th-list"></span> Bill of Meterial</h3>*@
<togglable name="{{FormTitle}}"></togglable>
<div class="form-horizontal form-elements" ng-form name="bomNewForm" id="mainDiv">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Material">Finish Goods<sup>*</sup></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" ng-model="bomNew.FGMaterialMaster" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getMaterial()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="bomNew.Description" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Article">Finish Goods Article<sup>*</sup></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" ng-model="bomNew.FGArticle" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getArticle($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearArticle();" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Product</label>
                <label class="col-sm-8 control-label">{{bomNew.ProductMasterName}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Finish Goods UoM<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select name="UOM" class="form-control" ng-model="bomNew.UnitOfMeasurementId" ng-options="item.Value as item.Text for item in unitOfMeasurementList" tabindex="13"></select>
                    </div>
                </div>
            </div>
            <div class="form-group" ng-show="FGmsg!=null">
                <label class="col-sm-4 control-label"></label>
                <label class="col-sm-8 control-label" style="color:blue;font-size: 11px;margin-bottom: -12px;font-style: italic;"> This Finish Goods <span style="text-transform:lowercase">{{FGmsg}}</span> SKU.</label>
            </div>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="SaveMaster();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{bom.Id==null?'Save':'Update'}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                @*<li> <button ng-click="Copy();" class="btn" tabindex="9"><i class="glyphicon glyphicon-copy"></i> Copy</button></li>*@
            </ul>
        </div>
        <div class="clearfix"></div>

        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Details</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Attachments</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="col-xs-12">

                    <div class="common-btn" id="DetailAdd">
                        <ul class="list-inline text-left">
                            <li>
                                <btton ng-click="ShowDetailPopup();" tooltip data-placement="top" title="Add Detail" ng-disabled="bomNew.Id===null" class="btn single-small-btn"><i class="glyphicon glyphicon-plus"></i></btton>
                            </li>
                        </ul>
                    </div>
                    <div class="clearfix"></div>
                    <div class="content-container-fluid" style="color: black;" ng-show="detailDataList.length>0">
                        <div style="color:black;" id="Grid1" ej-grid e-datasource="detailDataList" e-allowsorting="true" e-allowscrolling="true"
                             e-allowfiltering="true" e-gridlines="vertical" e-allowResizing="true" e-allowrowdraganddrop="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionComplete" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-headertext="Actions" e-template="#ShowActionButtonsBOM" e-width="140"></div>

                                <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="60"></div>
                                <div e-column e-field="Seq" e-headertext="Seq" e-width="30" e-visible="false"></div>
                                <div e-column e-field="RMMaterialMaster" e-headertext="Raw Material" e-width="150"></div>
                                <div e-column e-field="RMArticle" e-headertext="Raw Article" e-width="150"></div>
                                <div e-column e-field="PartyName" e-headertext="Vendor" e-width="100"></div>
                                <div e-column e-field="Process" e-headertext="Process" e-width="80"></div>
                                <div e-column e-field="Consumption" e-headertext="Consumption" e-width="50"></div>
                                <div e-column e-field="UnitOfMeasurement" e-headertext="UnitOfMeasurement" e-width="50"></div>
                                <div e-column e-field="WastagePer" e-headertext="Wastage Percentage" e-width="50"></div>
                                <div e-column e-field="SKU1" e-headertext="SKU1" e-width="70"></div>
                                <div e-column e-field="SKU2" e-headertext="SKU2" e-width="70"></div>
                                <div e-column e-field="SKU3" e-headertext="SKU3" e-width="70"></div>
                                <div e-column e-field="SKUCommon" e-headertext="SKU Common" e-width="70"></div>
                                <div e-column e-field="Description" e-headertext="Description" e-width="150"></div>
                                <div e-column e-field="IsConsumptionDetail" e-headertext="IsConsumptionDetail" e-width="80"></div>
                                <div e-column e-field="CreatedBy" e-headertext="CreatedBy" e-width="80"></div>
                                <div e-column e-field="CreationDate" e-headertext="Creation Date" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            </div>
                        </div>
                    </div>
                    <script type="text/template" id="ShowActionButtonsBOM">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" ng-disabled="data.IsConsumptionDetail==false" title="Consumption" class="btn"><i class="glyphicon glyphicon-list" ng-click="$parent.GetConsumption(this);" style="margin: -6px;"></i></button>
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Edit" class="btn"><i class="glyphicon glyphicon-pencil" ng-click="$parent.GetRawMaterialDetail(this);" style="margin: -6px;"></i></button>
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Detail" class="btn"><i class="glyphicon glyphicon-eye-open" ng-click="$parent.GetMatrixDetail(this);" style="margin: -6px;"></i></button>
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeBoMDetail(this);" style="margin: -6px;"></i></button>
                    </script>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-elements">

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Upload</label>
                            <div class="col-sm-8">
                                <div id="UploadDefault" e-dialogtext-title="Document" e-autoupload="true" e-begin="onBeginUpload" e-filesize="10971520" ej-uploadbox e-saveurl="uploadUrl" e-multiplefilesselection=false e-extensionsallow=".jpg,.bmp,.png,.jpeg,.pdf" e-error="errorPicUpload" e-complete="LoadIssueDocumentsData"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 form-elements">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="bomDocuments.Description" maxlength="250" tabindex="10"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveDocuments();" ng-disabled="bomDocuments.Id===null" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>File Name</th>
                                        <th>Description</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in issueTransactionDocumentList ">
                                        <td ng-click="FileDownload(x)"><a href="{{dwonloadUrl}}" style="text-decoration:underline" download="{{x.FileName}}" target="_self">{{x.FileName}}</a></td>
                                        <td>{{x.Description}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="GetDocumentData(x, $index);" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                        <i class="glyphicon glyphicon-pencil"></i>
                                                    </button>
                                                    <button data-toggle="modal" data-target="#confirmQualificationDelete" ng-click="confirmQualificationDelete(x)" class="btn btn-action tooltip-here" data-placement="top" title="Document Delete" tooltip>
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>

                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
                
            </div>
        </div>
        
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row">
        <div class="col-md-12">
            <div class="content-container-fluid" style="color: black;">
                <div style="color:black;" id="Grid" ej-grid e-datasource="masterDataList" e-recorddoubleclick="Get"
                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                    <div e-columns>
                        <div e-column e-template="#ShowActionButtonsBOMGrid" e-allowfiltering="false" e-headertext="Copy" e-width="16px"></div>

                        <div e-column e-field="Id" e-headertext="Id" e-width="20"></div>
                        <div e-column e-field="MaterialGroup" e-headertext="Material Group" e-width="50"></div>
                        <div e-column e-field="FGMaterialMaster" e-headertext="FG Material" e-width="80"></div>
                        <div e-column e-field="FGArticle" e-headertext="FG Article" e-width="80"></div>
                        <div e-column e-field="ProductMasterName" e-headertext="Product Master" e-width="80"></div>
                        <div e-column e-field="Description" e-headertext="Description" e-width="100"></div>
                    </div>
                </div>
                <script type="text/ng-template" id="ShowActionButtonsBOMGrid">
                    <div class="common-btn">
                        <ul class="list-inline text-left small">
                            <li>
                                <button ng-click="$parent.openPopupAngular('confirmBOMCopy');$parent.SelectedBOMRowForCopy(data);" title="Copy" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                                    <i class="glyphicon glyphicon-copy" style="color:white;"></i>
                                </button>
                            </li>

                        </ul>
                    </div>
                </script>

            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
