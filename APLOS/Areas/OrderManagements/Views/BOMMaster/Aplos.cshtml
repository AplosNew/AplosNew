                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-sm-6" style=" padding-right: 5px;">
                                    @*<div class="select-style">
                                            <select name="Destination" id="DestinationId" ng-disabled="bomDetailNew.IsDestinationSpecific == false " class="form-control" ng-model="bomDetailNew.DestinationId" ng-options="item.Value as item.Text for item in destinationList" tabindex="15">
                                                <option value=""></option>
                                            </select>
                                        </div>*@
                                    <input id="destinationList" ej-dropdownlist e-enablefiltersearch="true" e-create="create" e-enabled="bomDetailNew.IsDestinationSpecific == true" e-multiselectmode="visualmode" e-datasource="destinationList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true" />
                                </div>
                            </div>


                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label" title="Article">Raw Article<sup>*</sup></label>
                                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                                    <input type="text" ng-model="bomDetailNew.RMArticle" class="form-control" readonly>
                                    <span class="input-group-btn">
