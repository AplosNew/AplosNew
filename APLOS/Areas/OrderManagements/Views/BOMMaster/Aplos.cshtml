                                            <input type="text" ng-model="rmchar1.FreeText" class="form-control"
                                                   ng-keyup="nullByFreeText('rmchar1')" disabled>
                                            <span class="input-group-btn">
                                                <button ng-click="findCharValueSearchData(rmchar1, 'rmchar1')" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                                <button ng-click="clearCharValueField('rmchar1');" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                                <button ng-click="AddSKU('1st',null);" class="btn single-small-btn"><i class="glyphicon glyphicon-plus"></i></button>
                                            </span>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6" ng-show="rmchar2.CharacteristicsId.length>0;">
