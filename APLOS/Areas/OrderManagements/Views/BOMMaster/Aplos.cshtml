                                </div>
                                <div class="col-sm-2" style="padding-left:0px">
                                    <div class="select-style">
                                        <select name="UOM" class="form-control" ng-model="bomDetailNew.UoMId" ng-options="item.Value as item.Text for item in uOMList" tabindex="13"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Customer Specification</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Customer Specification" ng-model="bomDetailNew.CustomerSpec" class="form-control" maxlength="100" tabindex="12">
                                </div>
                            </div>
                            <div class="form-group">
