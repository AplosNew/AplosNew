                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" n-decimals="2" name="Sequence" ng-model="characteristicsvalueNew.Sequence" class="form-control text-right" required tabindex="2">
                            </div>
