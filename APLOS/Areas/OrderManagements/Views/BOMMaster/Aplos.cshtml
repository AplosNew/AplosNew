                                </div>*@
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Is Consumption Detail</label>
                                <div class="col-sm-1">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="bomDetailNew.IsConsumptionDetail" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                                <label class="col-sm-7 control-label" ng-show="msg!=null" style="color:blue;font-size: 11px;margin-bottom: -12px;font-style: italic;"> This Raw Material <span style="text-transform:lowercase">{{msg}}</span> SKU.</label>
                            </div>
