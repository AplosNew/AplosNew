                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Vendor Specification</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Vendor  Specification" ng-model="bomDetailNew.VendorSpec" class="form-control" maxlength="100" tabindex="12">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Wastage(%)</label>
