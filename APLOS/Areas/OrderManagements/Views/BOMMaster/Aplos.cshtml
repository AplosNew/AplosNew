                                        <label>
                                            <input type="checkbox" name="SKUCommon" ng-show="showradiocommon" ng-model="bomDetailNew.Specific" ng-change="SpecificClick();">
                                            <span class="cr"><i class="cr-icon"></i></span><span ng-show="showradiocommon">Common</span>
