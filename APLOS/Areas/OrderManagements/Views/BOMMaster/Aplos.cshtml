                                <input type="text" name="Short Name" maxlength="15" ng-model="characteristicsvalueNew.ShortName" class="form-control" required tabindex="4">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" maxlength="50" ng-model="characteristicsvalueNew.UserName" class="form-control" required tabindex="6">
