                            <label class="col-sm-3 control-label" style="font-size: 11px;margin-top: -18px;font-style: italic;">FG Article: <span style="color:blue;font-size: 11px;font-style: italic;"> {{bomNew.FGArticle}}</span></label>
                        </div>

                        <div class="col-xs-12 col-sm-6 col-md-6">
