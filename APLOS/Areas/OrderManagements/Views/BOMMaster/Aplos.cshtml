                                <div class="col-sm-2">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="bomDetailNew.SalesOrderSpecificMaterial" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>

                                <label class="col-sm-4 control-label">PO Specific</label>
                                <div class="col-sm-2" style="padding-top: 7px;    margin-left: -70px;">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="bomDetailNew.IsPOSpecific" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" ng-show="showradiodiv">
