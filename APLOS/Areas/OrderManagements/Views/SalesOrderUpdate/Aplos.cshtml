<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{FormTitle}}</h3>
<div class="row">
    <div ng-form="fileNewForm" id="ganttContainer">
        <div class="form-element-ctrl form-horizontal">

            <div class="col-xs-5 col-sm-5 col-md-5">
                <div class="form-group">
                    @*MasterOrderNo*@
                    <label class="col-sm-4 control-label">Master Order</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input type="text" name="Commitment" ng-model="MasterOrderNo" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="MasterOrderPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-elements form-horizontal" ng-form id="formSOupdate" name="formSOupdate">

                <div class="tab-design" id="tab_show">
                    <div style="color:black;" id="GridSO" ej-grid e-datasource="SOList" e-rowdatabound="rowDataBoundOrder"
                         e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                         e-filtersettings-filterType="excel" e-enabletouch="false"
                         e-allowselection="false">
                        <div e-columns>
                            <div e-column e-headertext="Edit" e-textalign="center" e-template="#SOedit" e-width="70"></div>

                            <div e-column e-type="string" e-field="Id" e-headertext="Sales order No." e-width="80"></div>
                            <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="300"></div>
                            <div e-column e-type="string" e-field="BuyerReferenceNo" e-headertext="Buyer Ref No" e-width="100"></div>
                            <div e-column e-type="string" e-field="BuyerPo" e-headertext="Buyer PO" e-width="70"></div>
                            <div e-column e-type="string" e-field="CM" e-headertext="CM" e-width="65"></div>
                            <div e-column e-type="date" e-field="DeliveryDate" e-format="{0:dd-MMM-yyyy}" e-headertext="Delivery Date" e-width="80"></div>
                            <div e-column e-type="string" e-field="Destination" e-headertext="Destination" e-width="100"></div>
                            <div e-column e-type="date" e-field="CommitmentDate" e-format="{0:dd-MMM-yyyy}" e-headertext="Commitment Date" e-width="80"></div>
                            <div e-column e-type="date" e-field="PlanExFactoryDate" e-format="{0:dd-MMM-yyyy}" e-headertext="Plan ExFactory Date" e-width="80"></div>
                            <div e-column e-type="string" e-field="SOType" e-headertext="SO Type" e-width="50"></div>
                            <div e-column e-type="string" e-field="UpCharge" e-headertext="Up Charge" e-width="50"></div>
                            <div e-column e-type="number" e-field="Qty" e-textalign="right" e-format="{0:N2}" e-headertext="Quantity" e-width="100"></div>
                            <div e-column e-type="number" e-field="SKUQty" e-textalign="right" e-format="{0:N2}" e-headertext="SKU Quantity" e-width="100"></div>
                            <div e-column e-type="number" e-field="Rate" e-textalign="right" e-format="{0:N2}" e-headertext="Rate" e-width="100"></div>
                            <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="120"></div>
                            <div e-column e-type="number" e-field="Discount" e-textalign="right" e-format="{0:N2}" e-headertext="Discount" e-width="100"></div>
                            <div e-column e-type="date" e-field="LSD" e-format="{0:dd-MMM-yyyy}" e-headertext="LSD" e-width="80"></div>
                            <div e-column e-type="date" e-field="MainRawMaterialInhouseDate" e-format="{0:dd-MMM-yyyy}" e-headertext="MainRawMaterialInhouseDate" e-width="80"></div>
                            <div e-column e-type="date" e-field="OtherRawMaterialInhouseDate" e-format="{0:dd-MMM-yyyy}" e-headertext="OtherRawMaterialInhouseDate" e-width="80"></div>
                            <div e-column e-type="string" e-field="OrderStatusId" e-headertext="Order Status" e-width="80"></div>

                        </div>
                        <script id="SOedit" type="text/template">
                            <div class="common-btn">
                                <ul class="common-btn list-inline text-center">
                                    <li>
                                        <button ng-click="$parent.EditSOPopUp(this);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="">
                                            <i class="glyphicon glyphicon-edit" style="color:orangered;"></i>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </script>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<confirm-modal></confirm-modal>
<div class="row">
    <div class="modal fade site-modal in" id="masterOrderPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">
                        <i class="glyphicon glyphicon-info-sign"></i> Master Order
                    </h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div style="color:black;" id="Grid" ej-grid e-datasource="MasterOrderList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-recorddoubleclick="SelectMO" e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Master order Id" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                                <div e-column e-field="CreationDate" e-format="{0:dd-MMM-yyyy}" e-type="date" e-headertext="Date" e-width="80"></div>
                                <div e-column e-field="CustomerName" e-headertext="Customer" e-width="80"></div>
                                <div e-column e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                                <div e-column e-field="MasterOrderNo" e-headertext="Master Order No." e-width="80"></div>
                                <div e-column e-field="BuyerItem" e-headertext="Buyer Item" e-width="80"></div>
                                <div e-column e-field="OwnItem" e-headertext="Own Item" e-width="80"></div>
                                <div e-column e-field="TotalQty" e-headertext="Total Qty" e-width="80"></div>
                                <div e-column e-field="OrderCategory" e-headertext="Order Category" e-width="80"></div>
                                <div e-column e-field="OrderYear" e-headertext="Order Year" e-width="80"></div>
                                <div e-column e-field="NoOfLineItem" e-headertext="No Of Line Item" e-width="80"></div>
                                <div e-column e-field="ResponsiblePersonName" e-headertext="Responsible Person" e-width="80"></div>
                                <div e-column e-field="InvoicingByAddress" e-headertext="Invoicing By Address" e-width="80"></div>
                                <div e-column e-field="DeliveryByAddress" e-headertext="Delivery By Address" e-width="80"></div>
                                <div e-column e-field="OrderWastagePercentage" e-headertext="Order Wastage Percentage" e-width="80"></div>
                                <div e-column e-field="ExtraOrderPercentage" e-headertext="Extra Order Percentage" e-width="80"></div>
                                <div e-column e-field="UserName" e-headertext="Plant" e-width="80"></div>
                                <div e-column e-field="IsReplacement" e-headertext="Is Replacement" e-width="80"></div>
                                <div e-column e-field="Type" e-headertext="Type" e-width="80"></div>
                                <div e-column e-field="Currency" e-headertext="Currency" e-width="80"></div>
                                <div e-column e-field="IsExtraOrderPercentage" e-headertext="Is ExtraOrder Percentage" e-width="80"></div>
                                <div e-column e-field="ProductMaster" e-headertext="Product Master" e-width="80"></div>
                                <div e-column e-field="OrderStatus" e-headertext="Order Status" e-width="80"></div>
                                <div e-column e-field="AddedDate" e-headertext="Added Date" e-width="80"></div>
                                <div e-column e-field="AddedBy" e-headertext="Added By" e-width="80"></div>
                                <div e-column e-field="OwnReferenceNo" e-headertext="Own Reference No." e-width="80"></div>
                                <div e-column e-field="BuyerReferenceNo" e-headertext="Buyer Reference No." e-width="80"></div>
                                <div e-column e-field="PaymentTermDays" e-headertext="Payment Term Days" e-width="80"></div>
                                <div e-column e-field="ContractNo" e-headertext="Contract No." e-width="80"></div>
                                <div e-column e-field="MasterLCNo" e-headertext="Master LC No." e-width="80"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade site-modal in" id="salesOrderEditPopUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                {{mName}} Sales Order
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="tab-design" id="tab_show">
                <div class="site-tab">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="dateUpdate" role="tab" data-toggle="tab">Date</a></li>
                        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="rateUpdate" role="tab" data-toggle="tab">Rate</a></li>
                        <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="quantityUpdate" role="tab" data-toggle="tab">Quantity</a></li>
                        <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="statusUpdate" role="tab" data-toggle="tab">Status</a></li>
                    </ul>
                </div>
            </div>
            <div class="modal-body form-elements form-horizontal">
                <div ng-form="somainForm">
                    <div class="tab-content">
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                            <div ng-form="soDateForm">
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Commitment Date</label>
                                        <div class="col-sm-8">
                                            <input type="text" datepicker name="Commitment Date" ng-model="soModel.CommitmentDate" class="form-control" tabindex="107">
                                        </div>
                                    </div>
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Main RM Inhouse Date<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <input type="text" datepicker name="Main RM Inhouse Date" ng-model="soModel.MainRawMaterialInhouseDate" class="form-control" required tabindex="117">
                                        </div>
                                    </div>
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Other RM Inhouse Date<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <input type="text" datepicker name="Other RM Inhouse Date" ng-model="soModel.OtherRawMaterialInhouseDate" class="form-control" required tabindex="116">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Delivery Date<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <input type="text" datepicker name="Delivery Date" ng-model="soModel.DeliveryDate" class="form-control" required tabindex="106">
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Plan Ex-Factory Date</label>
                                        <div class="col-sm-8">
                                            <input type="text" datepicker name="Plan Ex-Factory Date" ng-model="soModel.PlanExFactoryDate" class="form-control" tabindex="106">
                                        </div>
                                    </div>
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">LSD<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <input type="text" datepicker name="LSD" ng-model="soModel.LSD" class="form-control" required tabindex="114">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="common-btn" style="padding-right: 15px;">
                                <ul class="list-inline text-right">
                                    <li>
                                        <button ng-click="saveSalesOrderDate();" class="btn">Update</button>
                                    </li>
                                    <li>
                                        <button ng-click="closeSOPopUp();" class="btn">Close</button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                            <div ng-form="soRateForm">
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Rate<sup>*</sup></label>
                                        <div class="col-sm-6 show-message">
                                            <input type="text" n-decimals="4" name="Rate" ng-model="soModel.Rate" class="form-control text-right" required tabindex="110">
                                        </div>
                                        <div class="col-sm-2" style="padding-left:0px;padding-right:0px;margin-left:-15px;">
                                            <input type="text" ng-model=soModel.Currency class="form-control" disabled />
                                           
                                           
                                        </div>
                                    </div>
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Sales Expense<sup>*</sup></label>
                                        <div class="col-sm-8  show-message">
                                            <input type="text" n-decimals="2" name="Sales Expense" ng-model="soModel.SalesExpense" ng-keyup="SetNetSalesRealization();" class="form-control text-right" tabindex="113" required>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Up Charge</label>
                                        <div class="col-sm-8">
                                            <input type="text" n-decimals="2" name="UpCharge" ng-model="soModel.UpCharge" class="form-control text-right" tabindex="113">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Discount</label>
                                        <div class="col-sm-8">
                                            <input type="text" n-decimals="2" name="Discount" ng-model="soModel.Discount" class="form-control text-right" tabindex="112">
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Net Sales Realization</label>
                                        <div class="col-sm-8">
                                            <input type="text" n-decimals="2" name="NetSalesRealization" disabled ng-model="soModel.NetSalesRealization" class="form-control text-right" tabindex="113">
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">CM</label>
                                        <div class="col-sm-8">
                                            <input type="text" n-decimals="4" name="CM" ng-model="soModel.CM" class="form-control text-right" tabindex="113">
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="common-btn" style="padding-right: 15px;">
                                <ul class="list-inline text-right">
                                    <li>
                                        <button ng-click="saveSalesOrderRate();" class="btn">Update</button>
                                    </li>
                                    <li>
                                        <button ng-click="closeSOPopUp();" class="btn">Close</button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                            <div ng-form="soQTYForm">
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Quantity<sup>*</sup></label>
                                        <div class="col-sm-8">
                                            <input type="text" n-decimals="2" name="Qty" ng-model="soModel.Qty" class="form-control text-right" tabindex="111">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-6">

                                </div>
                            </div>
                            <div class="common-btn" style="padding-right: 15px;">
                                <ul class="list-inline text-right">
                                    <li>
                                        <button ng-click="saveSalesOrderQTY();" class="btn">Update</button>
                                    </li>
                                    <li>
                                        <button ng-click="closeSOPopUp();" class="btn">Close</button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                            <div ng-form="soStatusForm">
                                <div class="form-group">
                                    <label class="control-label" style="color:blue;padding-left: 17px;font-size:12px;margin-top: -6px;">Booked <span style="text-transform: lowercase;">as Sales Order. </span>This <span style="text-transform: lowercase;">qty will reduce from Produce qty.</span></label>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Order Status<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <div class="select-style">
                                                <select name="Order Status" class="form-control" ng-model="soModel.OrderStatusId" ng-disabled="soModel.ApprovedStatus!=='Approved'" ng-options="item.Value as item.Text for item in orderStatusList" required tabindex="105" ng-change="GetSOBookedQtyAndLevel(soModel.Id);">
                                                    <option value="">--Select--</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">SO Production Allocation</label>

                                        <div class="col-sm-3">
                                            <input type="text" name="SO Production Allocation" hidden ng-model="soModel.ProductionBookingLevel" disabled class="form-control text-right" tabindex="101">
                                            <input type="text" only-numbers name="Booked Quantity" ng-model="soModel.ProductionBookedQty" ng-disabled="soModel.ProductionBookingLevel==='SalesOrder' || soModel.OrderStatusId==='Active'" class="form-control text-right" tabindex="101" ng-change="SetTotalProdQty();">
                                        </div>
                                        <label class="col-sm-3 control-label" style="padding-left: 5px;">Total Prd. Qty</label>
                                        <div class="col-sm-2">
                                            <input type="text" name="Total Produced Qty" ng-model="TotalProducedQty" disabled class="form-control text-right" tabindex="101">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Produced Qty<span ng-show="soModel.ProductionBookingLevel!=='SalesOrder'">(Without SO)</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" name="Booked Quantity" ng-model="ProdBookedQty" disabled class="form-control text-right" tabindex="101">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="common-btn" style="padding-right: 15px;">
                                <ul class="list-inline text-right">
                                    <li>
                                        <button ng-click="saveSalesOrderStatus();" class="btn">Update</button>
                                    </li>
                                    <li>
                                        <button ng-click="closeSOPopUp();" class="btn">Close</button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


