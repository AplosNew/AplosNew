<div class="row">
    <div ng-form="fileNewForm" id="ganttContainer">
        <div class="form-element-ctrl form-horizontal">

            <div class="col-xs-5 col-sm-5 col-md-5">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Master Order</label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input type="text" name="Commitment" ng-model="fileNew.CommitmentId" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="showCommitmentPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="form-horizontal form-elements">

            <div class="col-xs-5 col-sm-5 col-md-5" ng-show="specialTaxList.length>0">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Special Tax</label>
                    <div class="col-sm-6">
                        <div class="select-style">
                            <select name="Irregular Tax" class="form-control" ng-model="fileNew.SpecialTaxId" ng-options="item.Value as item.Text for item in specialTaxList" ng-disabled="SpecialTax">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                    <label class="col-sm-2 control-label">If applicable</label>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2"></div>
            <div class="clearfix"></div>
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }">
                        <a ng-click="setTab(1)" href="" data-toggle="tab">Date Update</a>
                    </li>
                    <li role="presentation" ng-class="{ active: isSet(2) }">
                        <a ng-click="setTab(2)" href="" data-toggle="tab">Rate Update</a>
                    </li>
                    <li role="presentation" ng-class="{ active: isSet(3) }">
                        <a ng-click="setTab(3)" href="" data-toggle="tab">Quantity Update</a>
                    </li>
                    <li role="presentation" ng-class="{ active: isSet(4) }">
                        <a ng-click="setTab(4);" href="" data-toggle="tab">Status Update</a>
                    </li>
                </ul>
            </div>

            <div class="tab-content" id="AplosCurrencyContainer">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row" ng-form="tab1">
                        <div class="col-xs-6 col-sm-6 col-md-6">

                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-6">

                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row" ng-form="tab2">

                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                    <div class="row" ng-form="tab3">
                        <div class="col-xs-6 col-sm-6 col-md-6">

                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-6">

                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                    <div class="row" ng-form="tab3">

                    </div>
                </div>

            </div>

            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li>
                        <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button>
                    </li>
                    <li>
                        <button ng-click="removeMaster();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button>
                    </li>
                    @*
                        <li>
                        <button data-toggle="modal" data-target="#confirmMasterPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                    <li>
                        <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmMasterPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow();"></confirm-archive-generic>

<div class="modal fade site-modal in" id="commitmentPop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">
                    <i class="glyphicon glyphicon-info-sign"></i> Commitment
                </h4>
            </div>
            <div class="modal-body">
                <div style="color:black;" id="Grid" ej-grid e-datasource="commitmentList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-recorddoubleclick="SetCommitment" e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Commitment Id" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                        <div e-column e-field="BuyerDefinition" e-headertext="Buyer" e-width="80"></div>
                        <div e-column e-field="DepartmentName" e-headertext="Department" e-width="80"></div>
                        <div e-column e-field="DivisionName" e-headertext="Division" e-width="80"></div>
                        <div e-column e-field="ProductMaster" e-headertext="Product Master" e-width="80"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
            </div>
        </div>
    </div>
</div>



<div class="modal site-modal" id="POItemPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Production Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div style="color:black;" id="Grid" ej-grid e-datasource="SOItemList" e-allowscrolling="true"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-recorddoubleclick="selectSOItem"
                     e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>


                        <div e-column e-type="string" e-field="Id" e-headertext="ID" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Cat." e-width="130"></div>
                        <div e-column e-type="string" e-field="buyer" e-headertext="Buyer" e-width="100"></div>
                        <div e-column e-type="string" e-field="MasterOrderId" e-headertext="Order#" e-width="80"></div>
                        <div e-column e-type="string" e-field="BuyerRefNo" e-headertext="Customer Ord#" e-width="80"></div>
                        <div e-column e-type="string" e-field="SODesc" e-headertext="So.Description" e-width="150"></div>
                        <div e-column e-type="number" e-field="Qty" e-headertext="Qty" e-width="60"></div>
                        <div e-column e-type="string" e-field="DeliveryDate" e-headertext="So.Delivery Date" e-width="80"></div>
                        <div e-column e-type="string" e-field="Product" e-headertext="Product" e-width="150"></div>
                        <div e-column e-type="string" e-field="ProductionStatus" e-headertext="Production Status" e-width="90"></div>
                        <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="150"></div>
                        <div e-column e-type="string" e-field="OwnRefNo" e-headertext="Own Ord#" e-width="80"></div>
                        <div e-column e-type="string" e-field="StyleNo" e-headertext="Customer Item#" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnStyleNo" e-headertext="Own Item#" e-width="80"></div>

                        <div e-column e-type="string" e-field="BuyerItemNo" e-headertext="Buyer Item No#" e-width="80"></div>
                        <div e-column e-type="string" e-field="CustomerPONo" e-headertext="PO No#" e-width="80"></div>

                        <div e-column e-type="string" e-field="EntityName" e-headertext="Entity" e-width="90"></div>
                        <div e-column e-type="string" e-field="ProductionRemarks" e-headertext="Remarks" e-width="150"></div>

                        <div e-column e-type="string" e-field="AddedBy" e-headertext="Created By" e-width="80"></div>
                        <div e-column e-field="CreationDate" e-headertext="Creation Date" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
