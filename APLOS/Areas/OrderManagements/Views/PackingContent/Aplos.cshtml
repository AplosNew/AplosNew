<togglable name="{{FormTitle}}"></togglable>
<div class="form-horizontal form-elements" ng-form name="PackingContentForm" id="mainDiv">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Order<sup>*</sup></label>
                <div class="col-sm-7 show-message">
                    <div class="input-group">
                        <input type="text" name="Production Order" ng-model="packingContenNew.ProductionOrderId" class="form-control" readonly required>
                        <span class="input-group-btn">
                            <button ng-click="getProductionOrderPopUp();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            <button ng-click="GetPackingContentDataByPRId();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-th-list"></i></button>
                        </span>
                    </div>
                </div>

            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Net Weight<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Net Weight" n-decimals="2" ng-model="packingContenNew.NetWeight" class="form-control" maxlength="100" tabindex="4" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Weight UoM<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    @*<div class="select-style">
                            <select name="Weight UoM" class="form-control" ng-model="packingContenNew.WeightUoMId" ng-options="item.Value as item.Text for item in uOMList" tabindex="6" required></select>
                        </div>*@
                    <div class="select-style">
                        <select class="form-control" ng-model="packingContenNew.WeightUoMId" name="Weight UoM" required>
                            <option value="">--Select--</option>
                            <option value="kg">kg</option>
                            <option value="gm">gm</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="packingContenNew.Description" maxlength="250" tabindex="8"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Qty/{{packingContenNew.PackingForm}}<sup>*</sup></label>
                <div class="col-sm-2 show-message">
                    <input type="text" name="Qty" n-decimals="2" disabled ng-model="packingContenNew.Qty" class="form-control" maxlength="100" tabindex="2" required>
                </div>
                <label class="col-sm-2 control-label">No.of {{packingContenNew.PackingForm}}</label>
                <div class="col-sm-1">
                    <input type="text" name="LineNo" n-decimals="2" disabled ng-model="LineNo" class="form-control" maxlength="100" tabindex="2">
                </div>
                <label class="col-sm-1 control-label">Total Qty</label>
                <div class="col-sm-2 show-message">
                    <input type="text" name="Total Qty" n-decimals="2" disabled ng-model="TQty" class="form-control" maxlength="100" tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Gross Weight<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Qty" n-decimals="2" ng-model="packingContenNew.GrossWeight" class="form-control" maxlength="100" tabindex="5" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Lot No<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Lot Number" ng-model="packingContenNew.LotNo" class="form-control" tabindex="7" maxlength="50" required>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="packingContenNew.Remarks" maxlength="250" tabindex="8"></textarea>
                </div>
            </div>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" ng-disabled="packingContenNew.IsPackingSKURequired!=true" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{packingContenNew.Id==null?'Save':'Update'}}</button></li>
                @*<li> <button data-toggle="modal" ng-disabled="packingContenNew.IsPackingSKURequired!=true" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
        <div class="clearfix"></div>
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Individual Packing Detail</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Individual Packing</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form="tabFrom1">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <ul class="common-btn list-inline text-left">
                            <li><button ng-click="recipeMaterialPopUp();" ng-disabled="packingContenNew.IsPackingSKURequired!=true" class="btn"><i class="glyphicon glyphicon-plus"></i> Add</button></li>
                        </ul>
                    </div>
                </div>
                <div id="GridSOItemSelected" ng-init="chkinit()" ej-grid e-datasource="recipeMaterialListSelected"
                     e-allowscrolling="true" e-actioncomplete="actionCompleteSelected" e-minwidth="450" e-minheight="400"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-showsummary="true" e-summaryrows="summaryRows" e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="180" e></div>
                        <div e-column e-field="ArticleName" e-headertext="Article" e-width="180"></div>
                        <div e-column e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="180"></div>
                        <div e-column e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="180"></div>
                        <div e-column e-field="ThirdCharacteristicsValue" e-headertext="SKU3" e-width="180"></div>
                        <div e-column e-field="TotalQty" e-headertext="TotalQty" e-width="80" e-textalign="right"></div>
                        <div e-column e-template="#CurrentAccept" e-headertext="Qty" e-width="80" style="height: 20px;"></div>

                    </div>
                </div>
                <script type="text/template" id="CurrentAccept">
                    <div class="col-sm-10" style="padding:0px; width:70px;">
                        <input type="text" class="input ejinputtext form-control" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.Qty" width="80" />
                    </div>
                </script>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Packing Content</th>
                                <th>Individual Pack</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in lineItemNo">
                                <td><input type="text" ng-model="x.PackingContentMasterId" ng-disabled="true" class="form-control text-left"></td>
                                <td><input type="text" n-decimals="2" ng-model="x.Sequence" ng-disabled="true" class="form-control text-left"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row">
        <div class="col-md-12">
            <div class="content-container-fluid" style="color: black;">
                <div style="color:black;" id="Grid" ej-grid e-datasource="masterDataList" e-recorddoubleclick="Get"
                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                    <div e-columns>

                        <div e-column e-field="Id" e-headertext="Id" e-width="20" e-visible="false"></div>
                        <div e-column e-field="ProductionOrderId" e-headertext="Production Order" e-width="80"></div>
                        <div e-column e-field="Qty" e-headertext="Qty" e-width="80"></div>
                        @*<div e-column e-field="UOM" e-headertext="UOM" e-width="80"></div>*@
                        <div e-column e-field="NetWeight" e-headertext="Net Weight" e-width="80"></div>
                        <div e-column e-field="GrossWeight" e-headertext="Gross Weight" e-width="80"></div>
                        <div e-column e-field="WeightUoMId" e-headertext="Weight UoM" e-width="100"></div>
                        <div e-column e-field="LotNo" e-headertext="Lot No" e-width="100"></div>
                        <div e-column e-field="Description" e-headertext="Description" e-width="80" e-textalign="right"></div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

