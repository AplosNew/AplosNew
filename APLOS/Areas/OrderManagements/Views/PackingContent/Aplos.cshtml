<!-- #region Material and SO -->
<ej-dialog id="MaterialPopUp" title=" Sales Order Detail" e-enablemodal="true" e-position-y="0" e-showoninit="false"
           e-target="#mainDiv" e-minheight="200" e-width="900" e-open="enableBtn">

    <div class="row" style="width:890px!important;">

        <div class="row text-right">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="search-form">
                    <div class="row">
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="select-style">
                                <select value="Material" ng-model="recipeMaterialParameters.searchBy">
                                    <option ng-repeat="option in recipeMaterialFilterList" value="{{option.value}}">{{option.name}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-7 col-md-7">
                            <input type="text" class="form-control" placeholder="Search" ng-model="recipeMaterialParameters.search" ng-enter="serachSoMaterial()">
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2">
                            <button type="button" ng-click="serachSoMaterial()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="GridSOItem" ng-init="chkinit()" ej-grid e-datasource="recipeMaterialList"
             e-allowscrolling="true" e-rowdatabound="rowDataBound" e-actioncomplete="actionCompleteSearch" e-allowfiltering="true"
             e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>

                <div e-column e-headertext="" e-template="#checkboxTemplateSOSearch" e-textalign="center" e-width="30"></div>
                <div e-column e-field="MaterialMasterName" e-headertext="Material" e-width="80" e></div>
                <div e-column e-field="ArticleName" e-headertext="Article" e-width="120"></div>
                <div e-column e-field="WithSKU" e-headertext="WithSKU" e-width="30"></div>
                <div e-column e-field="FirstCharacteristicsValue" e-headertext="SKU1" e-width="30"></div>
                <div e-column e-field="SecondCharacteristicsValue" e-headertext="SKU2" e-width="30"></div>
                <div e-column e-field="ThirdCharacteristicsValue" e-headertext="SKU3" e-width="30"></div>
                <div e-column e-field="TotalQty" e-headertext="TotalQty" e-width="20" e-textalign="right"></div>
                <div e-column e-template="#CurrentAcceptance" e-headertext="Qty" e-width="20" style="height: 20px;"></div>
            </div>
        </div>

        <script type="text/template" id="checkboxTemplateSOSearch">
            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Checked" e-checked="data.Checked" />

        </script>
        <script type="text/x-jsrender" id="headerTemplate">
            <input type="checkbox" id="headchk" />
        </script>
        <script type="text/template" id="CurrentAcceptance">
            <div class="col-sm-10" style="padding:0px; width:70px;">
                <input type="text" class="input ejinputtext form-control" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.Qty" width="80" />
            </div>
        </script>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="addRecipeMaterial();" class="btn">Done</button></li>
                <li><button ng-click="closePopup('MaterialPopUp')" class="btn"><i> Close</i></button></li>
            </ul>
        </div>

    </div>


</ej-dialog>

