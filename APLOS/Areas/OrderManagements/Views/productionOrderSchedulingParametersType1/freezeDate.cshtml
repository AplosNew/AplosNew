<div class="row">

    <div class="form-group">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <label class="col-sm-12 control-label">Existing Date</label>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <input e-dateformat="dd-MMM-yyyy" e-enabled="false" ej-datepicker e-value="FreezeConfig.FreezeDate" e-width="100%" />
        </div>
    </div>
</div>
<div class="row">
    <div class="form-group">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <label class="col-sm-12 control-label">New Date</label>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6">
            <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="NewFreezeDate" e-width="100%" />
        </div>
    </div>
</div>
<div class="row">
    <div class="form-group">
        <ul class="common-btn list-inline text-right">
            <li><button ng-click="SaveFreezeConfig();" class="btn"><i class="glyphicon glyphicon-save"></i> Save</button></li>
        </ul>
    </div>
</div>
