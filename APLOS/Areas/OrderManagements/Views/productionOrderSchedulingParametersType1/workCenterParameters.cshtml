<div class="form-element-ctrl form-horizontal">
    <div class="col-xs-12 col-sm-12 col-md-12">

        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">Code</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.Code}}</label>
                </div>

            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">Work-Center Name</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.WorkCenter}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">Capacity</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.Capacity}} {{WORKCENTERPARAMS.UOM}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">Plan Efficiency%</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.PlanEfficiency}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">Max Time/Day</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.MaxTimePerDay}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">Std. Time/Day</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.MaxTimePerDay}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">Plan Budget Capacity/Day</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.PlanBudgetCapacityPerDay}}</label>
                </div>
            </div>
        </div>

        <div class="col-xs-6 col-sm-6 col-md-6">
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">Daily Fixed Cost</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.DailyFixedCost}} {{WORKCENTERPARAMS.Currency}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">Variable Cost</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.VariableCost}} {{WORKCENTERPARAMS.Currency}}</label>
                </div>
            </div>

            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">SPT</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.SPT}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">CM</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.CM}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">No.Of.Days/Month</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.MonthlyNoOfDays}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-9 control-label">Work Stations</label>
                    <label class="col-sm-3 control-label">{{WORKCENTERPARAMS.NoOfWorkStation}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-4 control-label">Responsible Person</label>
                    <label class="col-sm-8 control-label">{{WORKCENTERPARAMS.ResponsiblePerson}}</label>
                </div>
            </div>
            <div class="form-group">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <label class="col-sm-4 control-label">Mentor</label>
                    <label class="col-sm-8 control-label">{{WORKCENTERPARAMS.Mentor}}</label>
                </div>
            </div>


        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-12 col-md-12">
            Recommended products for this work center
            <div id="gridWORKCENTERProductList" ng-init="chkinit()" ej-grid e-datasource="WORKCENTERProductList" e-rowdatabound="onworkcenterproductrow"
                 e-enabletouch="false" e-responsive="true">
                <div e-columns>
                    <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                    <div e-column e-field="ProductCategory" e-headertext="Category" e-width="120"></div>
                    <div e-column e-field="ProductSubCategory" e-headertext="Sub Category" e-width="120"></div>
                    <div e-column e-field="ProductName" e-headertext="Product Name" e-width="180"></div>
                </div>
            </div>
        </div>
    </div>
</div>
