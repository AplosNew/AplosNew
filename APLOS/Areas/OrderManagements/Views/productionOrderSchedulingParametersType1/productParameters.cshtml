<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="row">
            <div class="col-xs-6 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Workstations</label>
                    <label class="col-sm-8 control-label">{{PRODUCTPARAMS.NoOfWorkStation}}</label>

                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Efficiency</label>
                    <label class="col-sm-8 control-label">{{PRODUCTPARAMS.Efficiency}}</label>

                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">SPT</label>
                    <label class="col-sm-8 control-label">{{PRODUCTPARAMS.SPT}}</label>

                </div>

                <div class="form-group">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        Recommended work center for this product
                        <div id="GRIDPRODUCTPARAMS" ng-init="chkinit()" ej-grid e-datasource="PRODUCTPARAMSWorkCenterList"
                             e-enabletouch="false" e-responsive="true"   e-recordclick="workcenterclickbyid">
                            <div e-columns>

                                <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                                <div e-column e-field="UserName" e-headertext="Work Center" e-width="180"></div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-xs-6 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Std Work. Hr/Per Day</label>
                    <label class="col-sm-8 control-label">{{PRODUCTPARAMS.PlanWorkingHoursPerDay}}</label>

                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">First Day Output/Hr</label>
                    <label class="col-sm-8 control-label">{{PRODUCTPARAMS.FirstDayOutPut}}</label>

                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Increment Value</label>
                    <label class="col-sm-2 control-label">{{PRODUCTPARAMS.IncrementValue}}</label>
                    <div class="col-sm-6 text-left">
                        <input type="radio" name="baselinedate" ng-model="PRODUCTPARAMS.IncrementType" value="FIXED">
                        <span>FIXED</span>
                        <input type="radio" name="baselinedate" ng-model="PRODUCTPARAMS.IncrementType" value="PERCENTAGE">
                        <span>PERCENTAGE</span>

                    </div>
                </div>


                <div class="form-group">
                    <label class="col-sm-4 control-label">Day To Reach Target</label>
                    <label class="col-sm-8 control-label">{{PRODUCTPARAMS.DayToReachTheTarget}}</label>

                </div>
            </div>
        </div>
    </div>
</div>