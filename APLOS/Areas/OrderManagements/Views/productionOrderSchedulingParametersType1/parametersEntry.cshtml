
<div class="form-element-ctrl form-horizontal">
    <div class="row" style="margin-right:10px;margin-left:10px;">
        <div class="row">
            <div class="col-xs-4 col-sm-4 col-md-4">

                <div class="form-group">
                    <label class="col-sm-4 control-label">Prd.Order ID</label>
                    <div class="col-sm-8">
                        <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="productionOrderModel.Id" maxlength="250" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Ord. Qty(Saved)</label>
                    <div class="col-sm-8">
                        <input type="text" ng-disabled="true" style="color:{{productionOrderModel.SavedQuantity!=productionOrderModel.POQuantity?'red':'black'}}" class="form-control" rows="2" ng-model="productionOrderModel.SavedQuantity" maxlength="250" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Prod. Sub Cat.</label>
                    <div class="col-sm-8">
                        <span class="tooltipAplos">
                            <span class="tooltipAplostext">{{displayModel.ProductSubCategory}}</span>
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.ProductSubCategory" maxlength="250" />
                        </span>
                    </div>
                </div>


                <div class="form-group">
                    <label class="col-sm-4 control-label">Product Category</label>
                    <div class="col-sm-8">
                        <span class="tooltipAplos">
                            <span class="tooltipAplostext">{{displayModel.ProductCategory}}</span>
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.ProductCategory" maxlength="250" />
                        </span>

                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Pro. Ord. Qty</label>
                    <div class="col-sm-8">
                        <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="productionOrderModel.POQuantity" maxlength="250" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Customer</label>
                    <div class="col-sm-8">
                        <span class="tooltipAplos">
                            <span class="tooltipAplostext">{{productionOrderModel.Customer}}</span>
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="productionOrderModel.Customer" maxlength="250" />
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Entity</label>
                    <div class="col-sm-8">

                        <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="productionOrderModel.EntityName" maxlength="250" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Product</label>
                    <div class="col-sm-8">
                        <span class="tooltipAplos">
                            <span class="tooltipAplostext">{{displayModel.ProductName}}</span>
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.ProductName" maxlength="250" />
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">SO Desc</label>
                    <div class="col-sm-8">
                        <span class="tooltipAplos">
                            <span class="tooltipAplostext">{{displayModel.SODesc}}</span>
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.SODesc" maxlength="250" />
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Customer Ref</label>
                    <div class="col-sm-8">
                        <span class="tooltipAplos">
                            <span class="tooltipAplostext">{{displayModel.BuyerRefNo}}</span>
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.BuyerRefNo" maxlength="250" />
                        </span>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Plan. Ord. Qty</label>
                    <div class="col-sm-8">

                        <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="productionOrderModel.SOQuantity" maxlength="250" />

                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Produced Qty</label>
                    <div class="col-sm-8">
                        <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="productionOrderModel.ProductionQtyAtPR" maxlength="250" />
                    </div>
                </div>
            </div>


            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Master Order</label>
                    <div class="col-sm-8">
                        <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.MasterOrderId" maxlength="250" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Material</label>
                    <div class="col-sm-8">
                        <span class="tooltipAplos">
                            <span class="tooltipAplostext">{{displayModel.Material}}</span>
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.Material" maxlength="250" />
                        </span>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Article</label>
                    <div class="col-sm-8">
                        <span class="tooltipAplos">
                            <span class="tooltipAplostext">{{displayModel.Article}}</span>
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.Article" maxlength="250" />
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Actual Plan Qty</label>
                    <div class="col-sm-8">
                        <input type="text" ej-numerictextbox e-minvalue="0" e-decimalplaces="0" e-enablertl="false" e-value="model.Qty" e-width="100" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Production Status</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select name="Production Status" class="form-control" ng-model="model.ProductionStatusId"
                                    ng-options="item.Value as item.Text for item in productionStatusList" tabindex="2">
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remaining Qty</label>
                    <div class="col-sm-8">
                        <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="productionOrderModel.ToBePlanQty" maxlength="250" />
                    </div>
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-xs-4 col-sm-4 col-md-4">

                <div class="form-group">
                    <div class="col-sm-8 control-label"><a ej-tooltip e-content="Planning simulation will consider daily production hours from workcenter master instead of planning calendar" e-width="width">Consider Plan hour from WC</a></div>
                    <div class="col-sm-4">
                        <input type="checkbox" ej-checkbox e-value="model.ConsiderHourFromWorkCenter" e-checked="model.ConsiderHourFromWorkCenter" class="nodetext" />
                    </div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="form-group">
                    <div class="col-sm-8 control-label"><a ej-tooltip e-content="Planning simulation will consider no of workstations from workcenter to distribute quantity proportionately based on current production order workstations" e-width="width">Consider Actual WorkStations</a></div>
                    <div class="col-sm-4">
                        <input type="checkbox" ej-checkbox e-value="model.ConsiderWorkStationsFromWorkCenter" e-checked="model.ConsiderWorkStationsFromWorkCenter" class="nodetext" />
                    </div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
            </div>

        </div>
    </div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">General Parameters</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Work Center Preference</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Running Order Parameters</a></li>
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4);actionCompleteSelected()" href="" data-toggle="tab">Material</a></li>

        </ul>
    </div>
    <div class="tab-content" id="OuterContainer">

        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row">


                <div class="col-xs-5 col-sm-5 col-md-5">
                    <div class="form-group">
                        <a ej-tooltip e-content="this value is coming from  planning parameters-product master efficiency " e-width="width">
                            <label class="col-sm-5 control-label">Workstations</label>
                        </a>
                        <div class="col-sm-7">
                            <div class="select-style">
                                <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.NoOfWorkStation" maxlength="250" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <a ej-tooltip e-content="this value is coming from  planning parameters-product master efficiency " e-width="width">
                            <label class="col-sm-5 control-label">Efficiency</label>
                        </a>
                        <div class="col-sm-7">
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.Efficiency" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <a ej-tooltip e-content="this value is coming from  planning parameters-product master efficiency " e-width="width">
                            <label class="col-sm-5 control-label">SPT</label>
                        </a>
                        <div class="col-sm-7">
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.SPT" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <a ej-tooltip e-content=" value from planning parameters-product master efficiency " e-width="width">
                            <label class="col-sm-5 control-label">Pln. Work. Hours/Per Day</label>
                        </a>
                        <div class="col-sm-7">
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.PlanWorkingHoursPerDay" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <a ej-tooltip e-content=" value is coming from product master " e-width="width">
                            <label class="col-sm-5 control-label">First Day Output/Hour</label>
                        </a>
                        <div class="col-sm-7">
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.FirstDayOutPut" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <a ej-tooltip e-content=" value is coming from product master " e-width="width">
                            <label class="col-sm-5 control-label">Increment Value</label>
                        </a>
                        <div class="col-sm-2">
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.IncrementValue" maxlength="250" />
                        </div>
                        <div class="col-sm-5 text-left">
                            <input type="radio" ng-model="displayModel.IncrementType" value="FIXED">
                            <span>FIXED</span>
                            <input type="radio" ng-model="displayModel.IncrementType" value="PERCENTAGE">
                            <span>PERCENTAGE</span>

                        </div>
                    </div>


                    <div class="form-group">
                        <a ej-tooltip e-content=" value is coming from product master " e-width="width">
                            <label class="col-sm-5 control-label">Day To Reach The Target</label>
                        </a>
                        <div class="col-sm-7">
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.DayToReachTheTarget" maxlength="250" />
                        </div>
                    </div>

                    <div class="form-group">
                        <a ej-tooltip e-content="Minimum date among all sales orders in current production order " e-width="width">
                            <label class="col-sm-5 control-label">LSD</label>
                        </a>
                        <div class="col-sm-7">
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.LSD" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <a ej-tooltip e-content="Maximum date among all sales orders in current production order " e-width="width">
                            <label class="col-sm-5 control-label">Commitment Date</label>
                        </a>
                        <div class="col-sm-7">
                            <input type="text" ng-disabled="true" class="form-control" rows="2" ng-model="displayModel.CommitmentDate" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <a ej-tooltip e-content="minimum  Main RM In house Date among all sales orders in current production order " e-width="width">
                            <label class="col-sm-5 control-label">Main RM In house Date</label>
                        </a>
                        <div class="col-sm-7">
                            <input e-dateformat="dd-MMM-yyyy" e-enabled="false" ej-datepicker e-value="displayModel.MainRawMaterialInhouseDate" e-width="100%" />
                        </div>
                    </div>
                    <div class="form-group">
                        <a ej-tooltip e-content="Maximum Other RM In house Date among all sales orders in current production order " e-width="width">
                            <label class="col-sm-5 control-label">Other RM Inhouse Date</label>
                        </a>
                        <div class="col-sm-7">
                            <input e-dateformat="dd-MMM-yyyy" e-enabled="false" ej-datepicker e-value="displayModel.OtherRawMaterialInhouseDate" e-width="100%" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-12">
                            Recommended Work Center
                            <div id="GridWorkCenterProduct" ng-init="chkinit()" ej-grid e-datasource="productWorkCenterList"
                                 e-allowpaging="true" e-enabletouch="false" e-responsive="true">
                                <div e-columns>

                                    <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                                    <div e-column e-field="UserName" e-headertext="Work Center" e-width="180"></div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-1 col-sm-2 col-md-1">

                </div>
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Workstations<sup>*</sup></label>
                        <div class="col-sm-3">
                            <div class="select-style">
                                <input type="number" inputmode="numeric" ng-change="calculations()" class="form-control" rows="2" ng-model="model.NoOfWorkStation" maxlength="4" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Efficiency %<sup>*</sup></label>
                        <div class="col-sm-3">
                            <input type="number" ng-disabled="SPTEfficiencySlab.length>0" inputmode="numeric" ng-change="calculations()" class="form-control" rows="2" ng-model="model.Efficiency" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">SPT<sup>*</sup></label>
                        <div class="col-sm-3">
                            <input type="number" inputmode="numeric" ng-change="AutoEfficiencyPercentageOnSPT();" class="form-control" rows="2" ng-model="model.SPT" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Plan Working Hours/Per Day<sup>*</sup></label>
                        <div class="col-sm-3">
                            <input type="number" inputmode="numeric" ng-change="calculations()" class="form-control" rows="2" ng-model="model.PlanWorkingHoursPerDay" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">First Day Output/Hour<sup>*</sup></label>
                        <div class="col-sm-3">
                            <input type="number"  ng-disabled="SPTEfficiencySlab.length>0" ng-change="calculations()" inputmode="numeric" class="form-control" rows="2" ng-model="model.FirstDayOutPut" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Increment Value<sup>*</sup></label>
                        <div class="col-sm-3">
                            <input type="number"  ng-disabled="SPTEfficiencySlab.length>0" ng-change="calculations()" inputmode="numeric" class="form-control" rows="2" ng-model="model.IncrementValue" maxlength="250" />
                        </div>
                        <div class="col-sm-5 text-left">
                            <input type="radio" ng-change="calculations()" ng-disabled="SPTEfficiencySlab.length>0" ng-model="model.IncrementType" value="FIXED">
                            <span>FIXED</span>
                            <input type="radio" ng-change="calculations()" ng-disabled="SPTEfficiencySlab.length>0" ng-model="model.IncrementType" value="PERCENTAGE">
                            <span>PERCENTAGE</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Day To Reach The Target</label>
                        <div class="col-sm-8">
                            <input type="text" e-enabled="false" ej-numerictextbox e-decimalplaces="0" e-enablertl="false" e-value="model.DayToReachTheTarget" e-width="100" />

                            @*<input type="text" ng-disabled="true" class="form-control"  rows="2" ng-model="model.DayToReachTheTarget" maxlength="250" />*@
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">LSD<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input e-dateformat="dd-MMM-yyyy" e-change="selectSigleDate" ej-datepicker e-value="model.LSD" e-width="100%" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Commitment Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input e-dateformat="dd-MMM-yyyy" e-change="selectSigleDate" ej-datepicker e-value="model.CommitmentDate" e-width="100%" />

                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Main RM Inhouse Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input e-dateformat="dd-MMM-yyyy" e-change="selectSigleDate" ej-datepicker e-value="model.MainRawMaterialInhouseDate" e-width="100%" />

                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Other RM Inhouse Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input e-dateformat="dd-MMM-yyyy" e-change="selectSigleDate" ej-datepicker e-value="model.OtherRawMaterialInhouseDate" e-width="100%" />

                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Priority<sup>*</sup></label>
                        <div class="col-sm-3">
                            <input type="number" inputmode="numeric" class="form-control" rows="2" ng-model="model.ProductionPriority" maxlength="250" />
                        </div>
                        <div class="col-sm-5">

                        </div>
                    </div>
                    <div class="form-group">
                        @*<a id="test" ej-tooltip e-content="targetperhourtooltip" e-width="width">*@
                        <label class="col-sm-4 control-label">Target/Hour at {{model.Efficiency}}% eff.</label>
                        @*</a>*@
                        <div class="col-sm-8">
                            <input type="text" e-enabled="false" ej-numerictextbox e-decimalplaces="2" e-enablertl="false" e-value="model.TargetPerHour" e-width="100" />

                            @*<input type="text" ng-disabled="true" class="form-control"  rows="2" ng-model="model.TargetPerHour" maxlength="250" />*@
                        </div>
                    </div>
                    <div class="form-group">
                        @*<a id="test" ej-tooltip e-content="targetperdaytooltip" e-width="width">*@
                        <label class="col-sm-4 control-label">Target/Day at {{model.Efficiency}}% eff.</label>
                        @*</a>*@
                        <div class="col-sm-8">
                            <input type="text" e-enabled="false" ej-numerictextbox e-decimalplaces="2" e-enablertl="false" e-value="model.TargetPerDay" e-width="100" />

                            @*<input type="text" ng-disabled="true" class="form-control"  rows="2" ng-model="model.TargetPerDay" maxlength="250" />*@
                        </div>
                    </div>



                    <div class="form-group">
                        <label class="col-sm-4 control-label">100% Efficiency/Day</label>
                        <div class="col-sm-8">
                            <input type="text" e-enabled="false" ej-numerictextbox e-decimalplaces="2" e-enablertl="false" e-value="EfficiencyPercentage" e-width="100" />

                            @*<input type="text" ng-disabled="true" class="form-control"  rows="2" ng-model="EfficiencyPercentage" maxlength="250" />*@
                        </div>
                    </div>



                    <div class="form-group">
                        <a ej-tooltip e-content=" initially this value is coming from entity wise configuration " e-width="width">
                            <label class="col-sm-4 control-label">Min. Workcenter Days<sup>*</sup></label>
                        </a>
                        <div class="col-sm-3">
                            <input type="number" inputmode="numeric" ng-change="calculations()" class="form-control" rows="2" ng-model="model.MinimumLineDays" maxlength="250" placeholder="Hint: 10 Days" />
                        </div>
                    </div>
                    <div class="form-group">
                        <a ej-tooltip e-content="linedaystooltip" e-width="width">
                            <label class="col-sm-4 control-label">Required Workcenter Days</label>
                        </a>
                        <div class="col-sm-8">
                            <input type="text" e-enabled="false" ej-numerictextbox e-decimalplaces="2" e-enablertl="false" e-value="model.RequiredLineDays" e-width="100" />

                            @*<input type="text" ng-disabled="true" class="form-control"  rows="2" ng-model="model.RequiredLineDays" maxlength="250" />*@
                        </div>
                    </div>
                    <div class="form-group">
                        <a ej-tooltip e-content="requiredNoOfLines" e-width="width">
                            <label class="col-sm-4 control-label">Required No. Workcenter</label>
                        </a>
                        <div class="col-sm-8">
                            <input type="text" e-enabled="false" ej-numerictextbox e-decimalplaces="2" e-enablertl="false" e-value="model.RequiredNoOfLines" e-width="100" />

                            @*<input type="text" ng-disabled="true" class="form-control"  rows="2" ng-model="model.RequiredNoOfLines" maxlength="250" />*@
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Allocated Workcenter<sup>*</sup></label>
                        <div class="col-sm-3">
                            <input type="number" inputmode="numeric" class="form-control" rows="2" ng-model="model.AllocatedLines" maxlength="250" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Production Display Color<sup>*</sup></label>
                        <div class="col-sm-8 text-left">

                            <input ej-colorpicker e-value="model.Color" e-modeltype="palette" />

                        </div>
                    </div>

                </div>

            </div>


        </div>

        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row" ng-form="tabFrom4">
                <div class="col-xs-12 col-sm-6 col-md-6" style="height:48px;">
                    <ul class="common-btn list-inline text-left">
                        <li><button ng-click="workCenterPopUp('PREFERENCE');" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Work Center</button></li>
                    </ul>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <input type="radio" ng-model="model.WCPreferenceType" value="INCLUDE">
                    <span>INCLUDE</span>
                    <input type="radio" ng-model="model.WCPreferenceType" value="EXCLUDE">
                    <span>EXCLUDE</span>
                </div>
