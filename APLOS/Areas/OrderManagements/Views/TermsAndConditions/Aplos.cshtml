<togglable name="{{title}}"></togglable>
<div class="form-horizontal row" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <input type="hidden" ng-model="ModelNew.Id">
                <label class="col-sm-4 control-label" style="padding-right: 52px;">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message" style="padding-left: 20px;padding-right: 31px;">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.CompanyId" ng-change="getData();"
                                ng-options="item.Value as item.Text for item in companyList" id="CompanyId"
                                name="Company" required tabindex="1" @*ng-disabled="PlantWiseHRMSSetting.SystemID != null"*@>
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

        </div>
    </div>
</div>
<div class="form-horizontal form-elements" ng-form name="ModelNewForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence"  required tabindex="1" />
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-model="ModelNew.Type" id="TypeList" class="form-control" name="TypeList" ng-options="item.Value as item.Text for item in typesList" required tabindex="3">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="7" maxlength="50">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Description<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea name="Description" class="form-control" rows="3" ng-model="ModelNew.Description" required tabindex="8" maxlength="250"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Group Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="GroupName" class="form-control" ng-model="ModelNew.GroupId" ng-options="item.Value as item.Text for item in GroupNameList" required tabindex="12">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Mandatory</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.Mandatory" tabindex="10">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="12"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="13"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="col-md-12" ng-show="ModelNew.Id!=null">

        <div class="col-md-8">
            <label class="col-md-2 control-label">Title</label>
            <div class="col-sm-7 show-message">
                <input type="text" name="Title" ng-model="TitleModel.Title" class="form-control" tabindex="2" maxlength="150">

            </div>
            <div class="form-group col-md-3 text-right">
                <div class="common-btn text-right">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="GridTitle();SaveTitle();" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Show">
                                <i class="glyphicon glyphicon-plus" style="color: greenyellow;"></i>
                            </button>
                        </li>
                        <li>
                            <button ng-click="ClearTitle();" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Show">
                                <i class="glyphicon glyphicon-refresh"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-4"></div>
    </div>
    <div class="col-md-12" ng-show="TitleList.length>0">
        <div class="col-md-8">
            <div id="Grid2" ej-grid e-datasource="TitleList" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="false">
                <div e-columns>

                    <div e-column e-template="#templateTitle" e-headertext="Title" e-width="60"></div>
                    <div e-column e-template="#ShowAction" e-headertext="Action" e-width="20"></div>
                    @*<div e-column e-template="#templateDescription" e-headertext="Description" e-width="15"></div>*@
                    @*<div e-column e-headertext=" Action " e-template="#ActionBTN" e-width="6"></div>*@
                </div>

                <script type="text/ng-template" id="ShowAction">
                    <div class="common-btn">
                        <ul class="list-inline ">
                            <li>
                                <button ng-click="$parent.showRemarksPopUp(data);" title="Details" class="btn small" @*style="height: 28px; width: 28px; padding: 0px; margin: 0px;"*@>
                                    <i class="glyphicon glyphicon-list"></i>
                                </button>
                            </li>
                            <li>
                                <button ng-click="$parent.EditTitle(this);" title="Edit" class="btn small" @*style="height: 28px; width: 28px; padding: 0px; margin: 0px;"*@>
                                    <i class="glyphicon glyphicon-pencil" style="color:limegreen;"></i>
                                </button>
                            </li>
                            <li>
                                <button ng-click="$parent.removeBoMDetail(this);@*$parent.ClearTitle();*@" class="btn small tooltip-here" @*style="height: 28px; width: 28px; padding: 0px; margin: 0px;"*@ title="Delete">
                                    <i class="glyphicon glyphicon-trash" style="color: orangered;"></i>
                                </button>
                            </li>
                        </ul>
                    </div>
                </script>
            </div>

            <script type="text/template" id="templateTitle">
                <input type="text" ng-model="data.Title" ng-disabled="true" ng-maxlength="150" style="color:black;" class="form-control" />
            </script>
            <script type="text/template" id="templateDescription">
                <input type="text" ng-model="data.Description" ng-maxlength="150" style="color:black;" class="form-control" />
            </script>
        </div>
        <div class="col-md-4"></div>
    </div>
</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            @*<div e-column e-field="AddedDate" e-format="{0:dd-MMM-yyyy}"  e-type="date" e-headertext="Date Added" e-width="2"></div>*@
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="Type" e-headertext="Type" e-width="5"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="Description" e-headertext="Description" e-width="8"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
            <div e-column e-field="Mandatory" e-headertext="Mandatory" e-width="2"></div>
        </div>
    </div>
</div>
<div class="row">
    <div class="modal fade site-modal in" id="GridPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">Details<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body">
                    <div class="row">
                        <div style="color:black;" id="gridRemarks" ej-grid e-datasource="POPupList" e-allowsorting="true" e-allowscrolling="true"
                             e-allowfiltering="true" e-gridlines="vertical" e-allowResizing="true" e-allowrowdraganddrop="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionComplete" e-allowselection="true"
                             e-endadd="SaveGrid" e-endedit="SaveGrid" e-enddelete="DeleteRemarks" e-editsettings-allowediting="true" e-editsettings-allowadding="true" e-editsettings-allowdeleting="true"
                             e-toolbarsettings-showtoolbar="true" e-toolbarsettings-toolbaritems="[ej.Grid.ToolBarItems.Add, ej.Grid.ToolBarItems.Edit, ej.Grid.ToolBarItems.Delete, ej.Grid.ToolBarItems.Update, ej.Grid.ToolBarItems.Cancel]">

                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-isprimarykey="true"></div>
                                <div e-column e-field="Sequence" e-headertext="Sequence" e-visible="false"></div>
                                <div e-column e-field="TermsAndConditionsChildId" e-headertext="TermsAndConditionsChildId" e-visible="false"></div>
                                <div e-column e-field="HeaderCaption" e-headertext="Header" e-width="5"></div>
                                <div e-column e-field="Description" e-headertext="Description" e-width="5"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmBoMDetailPopUp" title="Confirmation" message={{message_detailconfirmation}} data-ng-click-right-button="DeleteBomDetail();"></confirm-archive-generic>
