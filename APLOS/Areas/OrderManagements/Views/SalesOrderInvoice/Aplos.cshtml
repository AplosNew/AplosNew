<togglable name="Sales Order Invoice"></togglable>
<div class="form-horizontal" ng-form name="SalesOrderInvoiceForm">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="EntityId" ng-model="fileNew.EntityId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in entityList" tabindex="2"
                            ng-change="getData();LoadSalesOrganization()" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Sales Organization<sup>*</sup></label>
                <div class="col-sm-8 ">
                    <div class="select-style">
                        <select name="Sales Organization" ng-model="fileNew.SalesOrganizationId" class="col-sm-3 form-control"
                                ng-options="item.Value as item.Text for item in salesOrganizationList" tabindex="2"
                                ng-change="LoadSalesGroup(fileNew.SalesOrganizationId)">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Invoice Date</label>
                <div class="col-sm-8">
                    <input type="text" ng-disabled="true" name="Invoice Date" ng-model="fileNew.InvoiceDate" datepicker class="form-control datepicker" tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="hidden" ng-model="fileNew.CustomerId">
                        <input type="text" name="Customer" ng-model="fileNew.CustomerName" class="form-control" readonly required>
                        <span class="input-group-btn">
                            <button ng-click="findCustomerSearchData('MATERIAL_MASTER');" class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearCustomerSearchData();" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Payment Term<sup>*</sup></label>
                <div class="col-sm-8 ">
                    <div class="select-style">
                        <select name="Payment Term" ng-model="fileNew.PaymentTermId" ng-disabled="!fileNew.IsChangeable" class="col-sm-3 form-control"
                                ng-options="item.Value as item.Text for item in paymentTermList" tabindex="2"
                                ng-change="GetBaseLineDateSetting(fileNew.PaymentTermId)">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Sales Group<sup>*</sup></label>
                <div class="col-sm-8 ">
                    <div class="select-style">
                        <select name="Sales Group" ng-model="fileNew.SalesGroupId" class="col-sm-3 form-control"
                                ng-options="item.Value as item.Text for item in salesgroupList" tabindex="2"
                                ng-change="">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Invoice No</label>
                <div class="col-sm-8">
                    <input type="text" ng-disabled="true" name="Invoice No" ng-model="fileNew.InvoiceNo" class="form-control" tabindex="0">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Sales Type<sup>*</sup></label>
                <div class="col-sm-8 ">
                    <div class="select-style">
                        <select name="Sales Type" ng-model="fileNew.SalesTypeId" class="col-sm-3 form-control"
                                ng-options="item.Value as item.Text for item in salestypeList" tabindex="2"
                                ng-change="">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Value</label>
                <div class="col-sm-4" style="margin-right:0px;padding-right:0px;">
                    <input type="number" readonly name="Value" tabindex="16" ng-model="fileNew.InvoiceValue" class="form-control">
                </div>
                <div class="col-sm-4 " style="margin-left:0px;padding-left:0px;">
                    <div class="select-style">
                        <select name="Currency" tabindex="17" class="form-control" submit-required="true" ng-model="fileNew.CurrencyId" ng-options="item.Value as item.Text for item in currencyList">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <!--Master Detail Buttons-->
        <div class="col-xs-12 col-sm-12 col-md-12" ng-show="fileNew.Id.length>0">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li>
                        <button ng-click="plEntryPopup();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Line Item (Packing List)</button>
                    </li>
                </ul>
            </div>
        </div>

        <!--Detail Grid-->
        <div class="col-xs-12 col-sm-12 col-md-12" ng-show="detailList.length>0">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Delete</th>
                            <th>Edit</th>
                            <th>PL Master</th>
                            <th>PackingDate</th>
                            <th>Customer</th>
                            <th>PackingListNo</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in detailList">

                            <td>
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="deleteDetailGrid(x)" class="btn-action tooltip-here" data-placement="top" title="Remove" tooltip>
                                            <i class="glyphicon glyphicon-remove"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                            <td>
                                <ul class="list-inline action-list">
                                    <li>
                                        <button ng-click="plEditPopup(x)" class="btn-action tooltip-here" data-placement="top" title="Edit" tooltip>
                                            <i class="glyphicon glyphicon-edit"></i>
                                        </button>
                                    </li>
                                </ul>
                            </td>
                            <td>{{x.SalesOrderPackingListMasterId}}</td>
                            <td>{{x.PackingDate}}</td>
                            <td>{{x.Customer}}</td>
                            <td>{{x.PackingListNo}}</td>
                            <td>{{x.Amount}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="SaveMaster();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{(fileNew.Id.length>0?'Update':'Save')}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in masterSearchByList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="loadMasterData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>SalesOrganization</th>
                    <th>SalesGroup</th>
                    <th>SalesType</th>
                    <th>PaymentTerm</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in salesOrderInvoiceList |itemsPerPage:$root.pageSize"  pagination-id="metaData.name + 'salesOrderInvoiceList'" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.CustomerName}}</td>
                    <td>{{x.SalesOrganization}}</td>
                    <td>{{x.SalesGroup}}</td>
                    <td>{{x.SalesType}}</td>
                    <td>{{x.PaymentTerm}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10"
                             pagination-id="metaData.name + 'salesOrderInvoiceList'"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="loadMasterData(newPageNumber)">
    </dir-pagination-controls>
</div>
