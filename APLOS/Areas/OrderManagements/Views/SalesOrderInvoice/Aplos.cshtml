@*Master Search Modal*@
<div class="modal fade site-modal in" id="mastersearchpopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Invoice Master <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body ">

                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="$root.parameters.searchBy">
                                            <option ng-repeat="option in sbmasterList" ng-show="option.IsVisible" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="loadMasterData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadMasterData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th ng-repeat="h in sbmasterList">{{h.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in masterList | itemsPerPage:$root.pageSize" pagination-id="metaData.name + 'masterList'" total-items="$root.total_count" ng-dblclick="getMasterSingle(x);">
                                <td>{{x.Id}}</td>
                                <td ng-repeat="h in sbmasterList">{{x[h.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls pagination-id="metaData.name + 'masterList'"
                                             max-size="5"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadMasterData(newPageNumber)">
                    </dir-pagination-controls>
                </div>

            </div>
        </div>
    </div>
</div>

@*File Search Modal*@
<div class="modal fade site-modal in" id="filesearchpopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                File <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body ">

                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="$root.parameters.searchBy">
                                            <option ng-repeat="option in sbfileList" ng-show="option.IsVisible" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="loadFileData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadFileData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th ng-repeat="h in sbfileList">{{h.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in fileList | itemsPerPage:$root.pageSize" pagination-id="metaData.name + 'fileList'" total-items="$root.total_count" ng-dblclick="getFileSingle(x);">
                                <td ng-repeat="h in sbfileList">{{x[h.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls pagination-id="metaData.name + 'fileList'"
                                             max-size="5"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadFileData(newPageNumber)">
                    </dir-pagination-controls>
                </div>

            </div>
        </div>
    </div>
</div>

