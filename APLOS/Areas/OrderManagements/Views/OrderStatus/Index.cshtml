@model IEnumerable< APLOS.VM.OrderManagements.OrderStatusViewModel>

@{
    ViewBag.Title = "Index";
}
<div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="/Setups/Currency">Home</a>
        </li>
        <li class="#">OrderManagements</li>
        <li class="active">OrderStatus</li>
    </ul>
</div>
@Html.Partial("_ThemeSettings")
<div class="main-content">
    <div id="page-content">
        <div class="page-header position-relative">
            <h1>OrderStatus</h1>
        </div>
        <div class="col-xs-12">
            <p>
                @Html.ActionLink("Create New", "Create")
            </p>
            <div class="row-fluid">
                <div class="span12">
                    <table id="table_bug_report" class="table table-striped table-bordered table-hover">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Sequence)</th>
                            <th>@Html.DisplayNameFor(model => model.Code)</th>
                            <th>@Html.DisplayNameFor(model => model.StandardName)</th>
                            <th>@Html.DisplayNameFor(model => model.ShortName)</th>
                            <th>@Html.DisplayNameFor(model => model.UserName)</th>
                            <th>@Html.DisplayNameFor(model => model.Description)</th>
                            <th>@Html.DisplayNameFor(model => model.Remarks)</th>
                            <th>@Html.DisplayNameFor(model => model.A7T36C11)</th>
                            <th>@Html.DisplayNameFor(model => model.A7T36C12)</th>
                            <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                            <th></th>
                        </tr>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Sequence) </td>
                                <td>@Html.DisplayFor(modelItem => item.Code) </td>
                                <td>@Html.DisplayFor(modelItem => item.StandardName) </td>
                                <td>@Html.DisplayFor(modelItem => item.ShortName) </td>
                                <td>@Html.DisplayFor(modelItem => item.UserName) </td>
                                <td>@Html.DisplayFor(modelItem => item.Description) </td>
                                <td>@Html.DisplayFor(modelItem => item.Remarks) </td>
                                <td>@Html.DisplayFor(modelItem => item.A7T36C11) </td>
                                <td>@Html.DisplayFor(modelItem => item.A7T36C12) </td>
                                <td>@Html.DisplayFor(modelItem => item.IsActive) </td>
                                <td class="hidden-480">
                                    @Html.ActionLink(" ", "Edit", new { id = item.Id }, new { @class = " btn btn-minier fa fa-pencil-square-o" })
                                </td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
