<div class="modal fade site-modal in" id="productInquiryDetailFormModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Production Process Group<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <ul class="common-btn list-inline text-left">
                    <li>
                        <button ng-click="ShowProductProcessGroupPopUp();" class="btn" tabindex="10">
                            <i class="glyphicon glyphicon-plus-sign"></i> Production Process Group
                        </button>
                    </li>
                </ul>
                <div class="table-responsive modal-table  modal-table form-element-ctrl">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>User Name</th>
                                <th>Standard Name</th>
                                <th style="width: 10px">Job Work Applicable</th>
                                <th style="width:170px;">Job Work Type</th>
                                <th>Internal/External</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in productInquiryDetailSelectedList">
                                <td>{{x.Code}}</td>
                                <td>{{x.IntermediateItemName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.JobWorkApplicable" ng-checked="x.JobWorkApplicable" ng-click="clearJobType(productInquiryDetailSelectedList,x.IntermediateItemEntityId);clearEntityOrVendor(productInquiryDetailSelectedList,x.IntermediateItemEntityId);" />
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.JobWorkType" ng-disabled="!x.JobWorkApplicable" ng-change="clearEntityOrVendor(productInquiryDetailSelectedList,x.Id);"
                                                ng-options="item.Value as item.Text for item in jobWorkTypeList">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </td>
                                <td>
                                    <input type="hidden" ng-model="x.InternalId">
                                    <input type="hidden" ng-model="x.VendorId">
                                    <div class="col-sm-8 pdl3 pdr3">
                                        <input type="text" ng-model="x.EntityOrVendorName" class="form-control" disabled>
                                    </div>
                                    <button style="height: 27px; margin-top: 2px; margin-left: 0px" class="btn" ng-click="popUp(x.ProductionProcessGroupId)" ng-disabled="!x.JobWorkApplicable"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    <button style="height: 27px; margin-top: 2px; margin-left: 0px" class="btn" ng-click="clearEntityOrVendor(processSetDetails,x.Id);" ng-disabled="!x.JobWorkApplicable"><i class="cr-icon glyphicon glyphicon-remove"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="ProductInquiryDetailSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        <li> <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
