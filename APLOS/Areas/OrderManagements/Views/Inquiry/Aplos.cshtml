<div class="modal fade site-modal in" id="productFormModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width: 80%;">
        <div class="modal-content">
            <div class="modal-header">Product Inquiry<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <ul class="common-btn list-inline text-left">
                    <li>
                        <button ng-click="ShowProductPopUp();" class="btn" tabindex="10">
                            <i class="glyphicon glyphicon-plus-sign"></i> Product
                        </button>
                    </li>
                </ul>
                <div class=" table-responsive modal-table form-element-ctrl">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>FG</th>
                                <th>Material Group </th>
                                <th>Product Master</th>
                                <th>Quantity</th>
                                <th>Target Price</th>
                                <th>LSD</th>
                                <th>Shipment Date</th>
                                <th>Brand</th>
                                <th>Development</th>
                                <th>PreCosting</th>
                                <th>Item Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in productInquirySelectedList">
                                <td style="vertical-align: middle">{{x.FinishedGoods}}</td>
                                <td style="vertical-align: middle">{{x.MaterialGroupName}}</td>
                                <td style="vertical-align: middle">{{x.ProductMasterName}}</td>
                                <td style="vertical-align: middle">
                                    <input type="text" ng-model="x.Quantity" only-numbers class="form-control">
                                </td>
                                <td>
                                    <input type="text" n-decimals="4" ng-model="x.TargetPrice" class="form-control">
                                </td>
                                <td>
                                    <input type="text" ng-model="x.LSD" datepicker class="form-control datepicker">
                                </td>
                                <td>
                                    <input type="text" ng-model="x.ShipmentDate" datepicker class="form-control datepicker">
                                </td>
                                <td style="vertical-align: middle">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="x.BrandId" name="Buyer"
                                                ng-options="item.Value as item.Text for item in brandList" required>
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </td>
                                <td style="vertical-align: middle">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="x.Id" ng-model="x.IsDevelopment">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td style="vertical-align: middle">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" id="x.Id+1" ng-model="x.IsPreCosting">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td style="vertical-align: middle">
                                    <ul class="list-inline action-list">
                                        <li>
                                            <button ng-click="productInquiryDetailPopUp($index, x.Id)" ng-hide="x.Id===null" class="btn-action tooltip-here" data-placement="top" title="Remove">
                                                <i class="glyphicon glyphicon-list"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="ProductSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        <li> <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
