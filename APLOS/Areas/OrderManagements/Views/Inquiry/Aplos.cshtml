<div class="modal fade site-modal in" id="commitmentFormModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" style="width:75%">
        <div class="modal-content" ng-form name="commitmentForm">
            <div class="modal-header">
                Commitment Inquiry
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <ul class="common-btn list-inline text-left">
                    <li>
                        <button ng-click="ShowCommitmentPopUp();" class="btn" tabindex="10">
                            <i class="glyphicon glyphicon-plus-sign"></i> Commitment
                        </button>
                    </li>
                </ul>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Finished  Goods</th>
                                <th>Process</th>
                                <th>SubProcess</th>
                                <th>Buyer</th>
                                <th>LSD</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in commitmentInquirySelectedList">
                                <td>{{x.FinishedGoods}}</td>
                                <td>{{x.ProcessName}}</td>
                                <td>{{x.SubProcessName}}</td>
                                <td>{{x.BuyerName}}</td>
                                <td>{{x.LSD | dateFiltering}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline">
                        <li> <button ng-click="CommitmentSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        <li> <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
