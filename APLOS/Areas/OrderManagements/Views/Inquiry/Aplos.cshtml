                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>System Id</th>
                    <th>Buyer</th>
                    <th>Commitment</th>
                    <th>Product</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in inquirys |itemsPerPage:$root.pageSize" total-items="$root.total_count"
                    pagination-id="metaData.name + 'inquirys'" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.Id}}</td>
                    <td>{{x.BuyerName}}</td>
                    <td class="text-right table-td">
                        <ul class="list-inline action-list">
                            <li>
                                <button ng-click="showCommitmentFormModal(x.Id)" class="btn-action" title="Commitment Assign">
                                    <i class="glyphicon glyphicon-list"></i>
                                </button>
                            </li>
                        </ul>
                    </td>
                    <td class="text-right table-td">
                        <ul class="list-inline action-list">
                            <li>
                                <button ng-click="showProductFormModal(x.Id)" class="btn-action" title="Product Assign">
                                    <i class="glyphicon glyphicon-list"></i>
                                </button>
                            </li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10"
                             pagination-id="metaData.name + 'inquirys'"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
