<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Report Currency Exchange Rate</h3>


<div class="row">
    <div class="col-xs-12">
        <div class="col-xs-12 col-sm-2 col-sm-2 small">
            Company
            <div class="select-style">
                <select ng-model="SelectedCompany" ng-change="ChangeCompany();" style="height:26px;">
                    <option ng-repeat="option in CompanyList" value="{{option.CompanyId}}">{{option.Company}}</option>
                </select>
            </div>

        </div>
        <div class="col-xs-12 col-sm-2 col-sm-2 small">
            Plant
            <div class="select-style">
                <select ng-model="SelectedPlant" ng-change="ChangePlant();" style="height:26px;">
                    <option ng-repeat="option in PlantList" value="{{option.PlantId}}">{{option.Plant}}</option>
                </select>
            </div>

        </div>
        <div class="col-xs-12 col-sm-2 col-sm-2 small">
            Report Currency
            <div class="select-style">
                <select ng-model="SelectedCurrency" ng-change="ChangeCurrency();" style="height:26px;">
                    <option ng-repeat="option in CurrencyList" value="{{option.Id}}">{{option.Code}}</option>
                </select>
            </div>

        </div>
    </div>
    <div class="col-xs-12">
        <table>


            <tr ng-repeat="cur in CurrencyMatrix">
                <td>
                    1
                </td>
                <td>
                    {{cur.FromCurrency}} is equivalent to
                </td>
                <td style="width:110px;">
                    <input type="text" ej-numerictextbox e-minvalue="0" e-decimalplaces="6" e-value="cur.ExchangeRate" e-width="100" />
                </td>
                <td>
                    {{cur.ToCurrency}}
                </td>
            </tr>
        </table>

    </div>


    <div class="col-xs-12 small">
        <i style="color:#0026ff;">**update/save your data after providing exchange rates</i>
    </div>
    <div class="col-xs-12 text-right" ng-show="SelectedCurrency!='' && SelectedCurrency!=null && SelectedCurrency!='undefined'">
        <span class="input-group-btn">
            <button ng-click="SaveReportCurrencyConversion();" class="btn single-small-btn"><i class="glyphicon glyphicon-ok-circle"></i> Update</button>
        </span>
    </div>
</div>

