<h3 class="site-heading" id="mainContainer">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  Order Control Types
</h3>
<div class="row">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div id="GridSettings" ng-init="chkinit()" ej-grid e-datasource="model"
             e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
             e-minheight="400"
             e-allowselection="false" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-type="string" e-field="ControlTypeDesc" e-headertext="ControlType" e-width="100"></div>
                <div e-column e-type="string" e-field="Form" e-headertext="Form" e-width="120"></div>
                <div e-column e-type="string" e-field="DependentDate" e-headertext="Dependent Date" e-width="100"></div>
                <div e-column e-type="string" e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="130"></div>
                <div e-column e-template="#eTemplatesearchEmployee" e-headertext="" e-width="28px"></div>
                <div e-column e-template="#eTemplatedays" e-headertext="Days" e-width="100"></div>
                <div e-column e-template="#eTemplatelagDays" e-headertext="Lag Days" e-width="100"></div>
            </div>
        </div>
        <script type="text/ng-template" id="eTemplatedays">
            <input type="text" ej-numerictextbox e-minvalue="0" e-decimalplaces="0" e-enablertl="false" e-value="data.Days" e-width="100" />
        </script>
        <script type="text/ng-template" id="eTemplatelagDays">
            <input type="text" ej-numerictextbox e-decimalplaces="0" e-enablertl="false" e-value="data.LagDays" e-width="100" />
        </script>
        <script type="text/ng-template" id="eTemplatesearchEmployee">
            <div class="common-btn">
                <ul class="list-inline text-right small">
                    <li>
                        <button ng-click="$parent.OpenEmployeeSearchBox(data);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                            <i class="glyphicon glyphicon-search"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>
    </div>
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="common-btn">
            <ul class="list-inline text-right small">
                <li>
                    <button ng-click="Save();" class="btn small">
                        <i class="glyphicon glyphicon-floppy-disk"> Update</i>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>


<ej-dialog id="dialogSearchEmployee" title="Employees" e-enablemodal="true" e-position-y="0" e-position-x="0" e-showoninit="false" e-target="#mainContainer" e-close="onDialogClose" e-width="900" e-open="enableBtn">
    <div class="col-xs-12" style="border:1px solid #dfdfdf">
        <div class="row text-right">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="search-form">
                    <div class="row">
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="select-style">
                                <select ng-model="EmployeeSearchCol">
                                    <option ng-repeat="option in EmployeemodelFilterByList" value="{{option.value}}">{{option.name}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-7 col-md-7">
                            <input type="text" class="form-control" placeholder="Search" ng-model="EmployeeSearchVal" ng-enter="getEmployeeData()">
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2">
                            <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="SearchEmployee" ng-init="chkinit()" ej-grid e-datasource="EmployeeList" e-gridlines="horizontal"
             e-allowtextwrap="true" e-textwrapsettings.wrapmode="content"
             e-recorddoubleclick="TagEmployee" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="30" e-primarykey="true" e-visible="false"></div>
                <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                <div e-column e-headertext="" e-template="#empdetail" e-textalign="left" e-width="400"></div>
                @*<div e-column e-field="EmployeeCode" e-headertext="Code" e-width="30"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>*@
            </div>
        </div>
        <script type="text/x-jsrender" id="empimage">
            <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')"
                 src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;border:2px solid #efefef; border-radius:50%;" />
        </script>
        <script type="text/template" id="empdetail">
            <div style="font-size:1.2em">
                <span style="color:blue;font-weight:bold;">{{data.EmployeeCode}}  </span><span style="color:black;font-weight:bold;">{{data.EmployeeName}}</span><br />
            </div>
            <div style="font-size:1em;font-style:italic">
                {{data.Designation}}, {{data.Department}}
            </div>
            <div style="font-size:1em;">
                Section: {{data.Section}}, Sub-section: {{data.SubSection}}
            </div>
        </script>
    </div>
</ej-dialog>


