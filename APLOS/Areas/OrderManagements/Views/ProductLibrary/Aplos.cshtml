<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Material Group (Mst)</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in popUpList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr><th ng-repeat="x in popUpList" ng-show="{{x.Value!='Archive'}}">{{x.Text}}</th></tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
                                pagination-id="metaData.name + 'popUpDataList'" ng-click="selectSingleClick(x)" ng-dblclick="selectDoubleClick(x)">
                                <td ng-repeat="hh in popUpList">{{x[hh.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'popUpDataList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getPopUpData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer  common-btn">
                <ul class="list-inline text-right">
                    <li><button data-ng-click="selectByButton()" class="btn"><i class=""></i> Select</button></li>
                    <li><button data-ng-click="closePopUp()" class="btn btn-default">Cancel</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
