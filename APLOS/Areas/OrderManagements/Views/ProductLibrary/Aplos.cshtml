<modal-table modalid="processSetPopUp"
             data-title="Process Set"
             data-search-parameters="processPetParameters"
             data-exclued-column-list=""
             data-field-list="popUpList"
             data-data-list="processSetList"
             data-search-function="getProcessSetList"
             data-single-click=""
             data-double-click="selectProcessSet(data)"
             data-left-button="false"
             data-right-button="true"
             data-ng-click-left-button=""
             data-ng-click-cancel="closePopUp()">
</modal-table>
