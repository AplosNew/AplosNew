                <div class="row">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridCostingMasterTemplate" ej-grid e-datasource="CostingMasterTemplateList" e-recorddoubleclick="SelectedCostingMasterTemplate"
