<style>
    .listClass {
        width: auto;
        text-align: right;
    }

    .listClassLbl {
        width: 170px;
        text-align: left;
        font-weight: normal;
    }

    .customLbl {
        padding-right: 0px;
    }

    .customControl {
        padding-left: 0px;
        padding-right: 20px;
    }

    .selected {
        background-color: rgba(234, 97, 83, 0.42) !important;
    }
</style>
<togglable name="Product Library"></togglable>
<div class="form-elements form-horizontal" ng-form="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 divborder mark">
        <div class="col-xs-12 col-sm-6 col-md-6 pdl3 pdr3">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Sequence" ng-model="ModelNew.Sequence" class="form-control" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="ShortName" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="4">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="UserName" ng-model="ModelNew.UserName" class="form-control" required tabindex="6" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Material Master<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" name="Material Master" ng-model="ModelNew.MaterialMaster" class="form-control" readonly required>
                        <span class="input-group-btn">
                            <button ng-click="getMaterial();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="MaterialClear()" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Costing Template</label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="Costing Template" ng-model="ModelNew.CostingMasterTemplate" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="GetCostingMasterTemplatePopUp();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="CostingMasterTemplateClear()" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="2" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 pdr3">
            <div class="form-group">
                <label class="col-sm-4 control-label">Code</label>
                <div class="col-sm-8">
                    <input type="text" name="Code" ng-model="ModelNew.Code" ng-disabled="ModelNew.Id!=null" class="form-control" tabindex="3" maxlength="10">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="StandardName" ng-model="ModelNew.StandardName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Product</label>
                <label class="col-sm-8 control-label">{{ModelNew.ProductMasterName}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label" title="Article">Article<sup>*</sup></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <input type="text" ng-model="ModelNew.Article" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getArticle($index);" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearArticle();" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="2" ng-model="ModelNew.Description" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>


        </div>


    </div>
    <div class="col-xs-2 site-tab">
        <ul class="nav nav-tabs tabs-left" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">General</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Attribute</a></li>
        </ul>
    </div>
    <div class="col-xs-10 tab-content">
        <!-- #region General -->
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row" ng-form name="materialMasterFormTab1">
                <div class="col-xs-12 col-sm-6 col-md-6 pdr3">

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Dispaly Name</label>
                        <div class="col-sm-8">
                            <div class="radio">
                                <label>
                                    <input type="radio" name="DispalyName" ng-model="ModelNew.RecipeOrProductionGroup" value="Recipe">
                                    <span class="cr"><i class="cr-icon"></i></span>Recipe
                                </label>&nbsp;&nbsp;
                                <label>
                                    <input type="radio" name="DispalyName" ng-model="ModelNew.RecipeOrProductionGroup" value="ProductionGroup">
                                    <span class="cr"><i class="cr-icon"></i></span>Production Group
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Recipe<sup ng-show="ModelNew.RecipeOrProductionGroup==='Recipe'">*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" name="Recipe" ng-model="ModelNew.Recipe" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="GetRecipepopUp();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="RecipeClear()" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-xs-12 col-sm-6 col-md-6 pdl3 pdr3">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ModelNew.Active">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Production Group<sup ng-show="ModelNew.RecipeOrProductionGroup==='ProductionGroup'">*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" name="ProductionGroup" ng-model="ModelNew.ProductionGroup" class="form-control" tabindex="5" maxlength="50">
                        </div>
                    </div>
                </div>


            </div>
        </div>
        <!-- #endregion -->
        <!-- #region Material Attribute -->
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row" ng-form name="materialMasterFormTab4">
                <div class="col-md-2">
                    <button ng-click="materialAttributeCreatePopUp();" class="btn single-small-btn" tabindex="41"><i class=""></i> Create Attribute</button>
                </div>

                <div class="clearfix"></div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                @*<th ng-show="materialAttributeMasters.length>1">Sort</th>*@
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                                <th>Scan Item</th>
                                <th>Value</th>
                                <th>UoM</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in materialAttributeMasters">
                                @*<td ng-show="materialAttributeMasters.length>1">
                                        <span ng-show="!$first&&materialAttributeMasterNew.Id==null" ng-click="moveUp($index, materialAttributeMasters, 'Sequence')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                        <div class="clearfix"></div>
                                        <span ng-show="!$last&&materialAttributeMasterNew.Id==null" ng-click="moveDown($index, materialAttributeMasters, 'Sequence')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                    </td>*@
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.ScanItem}}</td>
                                <td>{{x.AttributeValue}}</td>
                                <td>{{x.UoM}}</td>
                                <td>
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="editAttribute($index);" class="btn btn-action tooltip-here" data-placement="top" title="Edit" ng-disabled="x.ValueAssignmentLevel=='General'"><i class="glyphicon glyphicon-edit"></i></button></li>
                                        <li><button ng-click="removeAttr(x,$index);" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>

                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- #endregion -->


    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            @*<li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>*@
            <li> <button ng-click="confirmToCreateNewVersion();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select value="Material" ng-model="PRsearchBy">
                                <option ng-repeat="option in PRFilterList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="PRsearch" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <div class="content-container-fluid" style="color:black;overflow:scroll">
        <div style="color:black;" id="Grid" ej-grid e-datasource="masterDataList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="20" e-visible="false"></div>
                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="30"></div>
                <div e-column e-field="Code" e-headertext="Code" e-width="30"></div>
                <div e-column e-field="ShortName" e-headertext="Short Name" e-width="30"></div>
                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="30"></div>
                <div e-column e-field="UserName" e-headertext="User Name" e-width="30"></div>
                <div e-column e-field="MaterialMaster" e-headertext="Material Master" e-width="40"></div>
                <div e-column e-field="Article" e-headertext="Article" e-width="40"></div>
                <div e-column e-field="RecipeOrProductionGroup" e-headertext="Dispaly Name" e-width="40"></div>
                <div e-column e-field="Recipe" e-headertext="Recipe" e-width="20"></div>
                <div e-column e-field="ProductionGroup" e-headertext="Production Group" e-width="20"></div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <ul class="common-btn list-inline text-left">
            <li>
                <div ej-tooltip e-showshadow="true" e-content="Product Library Report" ng-click="getProductLibraryReport();" e-width="width">
                    <button class="btn" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i> Report </button>
                </div>
            </li>
        </ul>
    </div>
</div>




