<div class="modal fade site-modal in" id="fixedAssetMasterModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                FixedAsset Master
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">

                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="fixedAssetMasterListParameters.searchBy">
                                            <option ng-repeat="option in searchbyixedAssetMasterList|orderBy:'Text'" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="fixedAssetMasterListParameters.search" ng-enter="loadFixedAssetMasterData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="loadFixedAssetMasterData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th ng-repeat="h in searchbyixedAssetMasterList">{{h.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in fixedAssetMasterList  |itemsPerPage:fixedAssetMasterListParameters.pageSize" pagination-id="metaData.name + 'fixedAssetMasterList'" total-items="fixedAssetMasterListParameters.total_count" ng-dblclick="selectAssetMaster(x);">
                                <td ng-repeat="hh in searchbyixedAssetMasterList">{{x[hh.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'fixedAssetMasterList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="loadFixedAssetMasterData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
