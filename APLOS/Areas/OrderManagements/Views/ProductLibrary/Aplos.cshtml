                                <div e-column e-field="Description" e-headertext="Description" e-width="40"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="CloseRecipePopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Done</button></li>
                    </ul>
                </div>
            </div>
