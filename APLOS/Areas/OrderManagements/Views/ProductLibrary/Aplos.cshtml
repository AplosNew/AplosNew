<div class="modal fade site-modal in" id="revenueBudgetPopUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header"> Revenue Budget<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="assetBudgetPopUpParameters.searchBy">
                                            <option ng-repeat="option in budgetPopUpList|orderBy:'Text'" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="assetBudgetPopUpParameters.search" ng-enter="getAssetBudgetPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getAssetBudgetPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>GL Item</th>
                                <th>Account Code</th>
                                <th>Budget Group</th>
                                <th>Budget Category</th>
                                <th>BudgetSub Category</th>
                                <th>Budget Class</th>
                                <th>Budget Code</th>
                                <th>Budget</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in budgetList|itemsPerPage:assetBudgetPopUpParameters.pageSize" total-items="assetBudgetPopUpParameters.total_count"
                                pagination-id="metaData.name + 'budgetList'" ng-click="selectSingleClick(x)">
                                <td>
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="x.Flag" ng-click="pushTempList(x,$event)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.GLItem}}</td>
                                <td>{{x.GLGeneralInfoCode}}</td>
                                <td>{{x.BudgetGroup}}</td>
                                <td>{{x.BudgetCategory}}</td>
                                <td>{{x.BudgetSubCategory}}</td>
                                <td>{{x.BudgetClass}}</td>
                                <td>{{x.BudgetCode}}</td>
                                <td>{{x.BudgetName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'budgetList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getAssetBudgetPopUpData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer  common-btn">
                <ul class="list-inline text-right">
                    <li><button data-ng-click="selectRevenue();" class="btn"><i class=""></i> Select</button></li>
                    <li><button data-ng-click="closeRevenuePopUp();" class="btn btn-default">Cancel</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
