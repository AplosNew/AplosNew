<togglable name="Machine Master "></togglable>
<div class="aplos-grid-toggle">
    <div class="row text-right" hidden>
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <fieldset class="scheduler-border">
        <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
        <div class="content-container-fluid" style="color:black;">
            <div style="color:black;" id="Grid" ej-grid e-datasource="GriddataOperationMaster"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                 e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                <div e-columns>
                    <div e-column e-field="Sequence" e-headertext="Sequence" e-width="80"></div>
                    <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                    <div e-column e-field="UserName" e-headertext="Machine Name" e-width="80"></div>
                    <div e-column e-field="StandardName" e-headertext="Machine Name" e-width="80"></div>
                    <div e-column e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                    <div e-column e-field="MachineCategory" e-headertext="MachineCategory" e-width="50"></div>
                    <div e-column e-field="MachineSubCategory" e-headertext="MachineSubCategory" e-width="50"></div>
                    <div e-column e-field="MachineGroup" e-headertext="MachineGroup" e-width="80"></div>
                    <div e-column e-field="Description" e-headertext="Description" e-width="50"></div>
                    <div e-column e-field="ProductionMachineQty" e-headertext="ProductionMachineQty" e-width="50"></div>
                    <div e-column e-field="SampleMachineQty" e-headertext="SampleMachineQty" e-width="50"></div>
                    <div e-column e-field="TrainingMachineQty" e-headertext="TrainingMachineQty" e-width="50"></div>
                    <div e-column e-field="RentMachineQty" e-headertext="RentMachineQty" e-width="80"></div>
                </div>
            </div>
        </div>
    </fieldset>
</div>

