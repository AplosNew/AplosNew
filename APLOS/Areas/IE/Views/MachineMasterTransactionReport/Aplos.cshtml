<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        /*background-color: #1c1f32;*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>
@*<togglable name="{{title}}"></togglable>*@
<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>&nbsp;{{title}}</h3>

<div class="form-elements form-horizontal">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12 ">
            <div class="row">
                <div class="col-md-5">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" name="From Date" ng-model="FromDate" datepicker class="form-control datepicker" placeholder="dd-mmm-yyyy" tabindex="1">
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                   
                    <div class="form-group">
                        <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" name="To Date" ng-model="ToDate" datepicker class="form-control datepicker" placeholder="dd-mmm-yyyy" tabindex="1">
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <ul class="col-md-6 common-btn list-inline text-left">
                        <li><button ng-click="MachineMasterTransactionloadfilters();" class="btn"><i class="glyphicon glyphicon-send"></i> GO</button></li>
                    </ul>
                </div>
            </div>
            <div class="row">
                <div id="filters">
                </div>

                <div class="col-md-1 text-right" style="margin-top:20px;">
                    <button type="button" class="btn single-btn" ng-click="Report()" style="margin-top:10px;"><i class="glyphicon glyphicon-arrow-down"></i>Download</button>
                </div>



            </div>
        </div>
    </div>
</div>


<confirm-modal></confirm-modal>
