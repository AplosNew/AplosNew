<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Production System Allowance</h3>
<div class="form-elements form-horizontal" ng-form="productionSystemAllowanceForm">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12" style="padding-bottom: 10px;">
                <button type="button" class="btn single-small-btn" ng-click="AddNew();"><i class="glyphicon glyphicon-plus"></i> Add Production System Allowance</button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">
                <div id="GridPSA" ej-grid e-datasource="productionSystemAllowanceList" e-gridlines="vertical" e-templaterefresh="refreshGridPSA"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-allowsorting="true"
                     e-allowResizing="true"
                     e-filtersettings-filterType="excel"
                     e-enabletouch="true" e-responsive="true"
                     e-recorddoubleclick="recorddoubleclick">
                    <div e-columns>
                        <div e-column e-field="BundleHandleTimeId" e-headertext="BundleHandleTimeId" e-width="50" e-visible="false"></div>
                        <div e-column e-field="Factor" e-headertext="Factor" e-width="65"></div>
                        <div e-column e-field="FactorValue" e-headertext="Factor Value" e-width="100"></div>
                        <div e-column e-template="#GridActions" e-width="30" textAlign='center'></div>
                    </div>
                </div>
                <script type="text/template" id="GridActions">
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnApprove">
                        <i class="fa fa-pencil" title="Load Data" ng-click="$parent.LoadSelectedData('GridPSA');" style="margin: -6px;"></i>
                    </button>
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnDelete">
                        <i class="fa fa-trash" title="Delete Data" ng-click="$parent.DeleteSelectedData('GridPSA');" style="margin: -6px;"></i>
                    </button>
                </script>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
<div class="clearfix"></div>
<div class="common-btn">
    <ul class="list-inline text-right">
        <li> <button ng-click="Save();" ng-show="EntryModeSave" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
        <li> <button data-toggle="modal" ng-show="ViewMode" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
    </ul>
</div>

<div class="modal fade site-modal in" id="modalProductionSystemAllowanceList" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Production System Allowance<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row form-elements" ng-form name="productionSystemAllowanceForm">
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <div class="form-group" show-errors>
                            <label class="control-label" for="txtElementTypeName">
                                Factor Name<sup>*</sup>
                            </label>
                            <div class="show-message">
                                <input type="text" id="txtFactor" name="Factor Name" class="form-control" ng-model="VAS.Factor" required tabindex="1" />
                                <input type="hidden" id="txtBundleHandleTimeId" name="txtBundleHandleTimeId" ng-model="VAS.BundleHandleTimeId" />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <div class="form-group" show-errors>
                            <label class="control-label" for="txtDescription">
                                Factor Value<sup>*</sup>
                            </label>
                            <div class="show-message">
                                <input type="text" id="txtFactorValue" name="Factor Value" class="form-control" ng-model="VAS.FactorValue" required tabindex="2" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <button type="button" class="btn single-small-btn" ng-click="SaveData();"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
