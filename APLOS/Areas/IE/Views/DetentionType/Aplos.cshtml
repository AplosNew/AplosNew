<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet2(1) }"><a ng-click="setTab2(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Detention Type</a></li>
                <li role="presentation" ng-class="{ active: isSet2(2) }"><a ng-click="setTab2(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Budget Code</a></li>

            </ul>

        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(1), active: isSet2(1) }">
                <input type="hidden" ng-model="ModelNew.Id">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100" required />
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Description</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="ModelNew.Description" tabindex="7" maxlength="250"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveDT();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(2), active: isSet2(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="openBudgetCodePopUp();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Budget Code</button></li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="userBudgetCodeList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        
                                        <th>Id</th>
                                        <th>Code</th>
                                        <th>DetentionType</th>
                                        
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userBudgetCodeList" ng-class="{selected : x.Id==null}">
                                        
                                        <td>{{x.Id}}</td>
                                        <td>{{x.Code}}</td>
                                        <td>{{x.DetentionType}}</td>
                                        
                                        @*<td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeDeptRowModal(x.Department, $index, 'userDepartMentList', x.Id, 'DepartmentId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>*@
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        @*</div>
            </div>*@
                    </div>
                </div>
            </div>
            </div>
        </div>
 </div>
            <div class="row text-right aplos-grid-toggle">
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="searchBy">
                                        <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-responsive aplos-grid-toggle">
                <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                        @*<div e-column e-field="AddedDate" e-format="{0:dd-MMM-yyyy}"  e-type="date" e-headertext="Date Added" e-width="2"></div>*@
                        <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
                        <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
                        <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
                        <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
                        <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
                    </div>
                </div>
            </div>
            <confirm-modal></confirm-modal>


            <div class="modal fade site-modal in" id="BudgetCodePopUp" role="dialog" data-backdrop="static">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">Budget Code<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                        <div class="modal-body">
                            <div class="row">
                                <div style="color:black;" id="GridDetentionMasterBudgetCode" ej-grid e-datasource="BudgetCodeList"
                                     e-templaterefresh="BudgetCodeGridAllCheck"
                                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true" e-showsummary="true"
                                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                                    <div e-columns>
                                        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="7"></div>
                                        <div e-column e-type="Number" e-field="ManPowerBudgetId" e-headertext="Id" e-width="30"></div>
                                        <div e-column e-type="Number" e-field="Code" e-headertext="Code" e-width="30"></div>
                                        <div e-column e-type="String" e-field="Entity" e-headertext="Entity" e-width="30"></div>
                                        <div e-column e-type="String" e-field="Position" e-headertext="Position" e-width="100"></div>
                                       
                                    </div>
                                </div>
                                <script type="text/x-jsrender" id="headerTemplate">
                                    <input type="checkbox" id="headchk" />
                                </script>
                                <script type="text/template" id="checkboxTemplate">
                                    <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
                                </script>
                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li><button type="button" class="btn btn-default" ng-click="SaveBudgetCode();">Add</button></li>
                                        <li><button type="button" class="btn btn-default" ng-click="closeDeptPopUp();">Cancel</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
