<togglable name="Bulletin"></togglable>
<div class="form-elements form-horizontal" id="bulletin">
    <div ng-form name="BulletinForm">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Picture</label>
                <div class="col-sm-8">
                    <img id="uploadSigsrc" ng-src="{{PicFileName}}" style="border: 1px dashed; height: 150px; width: 140px;" />
                    <div id="UploadDefault" e-dialogtext-title="Product Picture" e-autoupload="true" e-begin="onBeginPBUpload" e-filesize="2097152" ej-uploadbox e-saveurl="uploadPBUrl" e-multiplefilesselection="false" e-success="getFileList" e-extensionsallow=".jpg,.bmp,.png,.jpeg" e-error="errorPBPicUpload"></div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Bulletin ID<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" name="Bulletin Id" disabled ng-model="bulletinTemplateNew.Id" class="form-control">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Bulletin Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Bulletin Name" ng-model="bulletinTemplateNew.BulletinName" class="form-control" required tabindex="1" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Size Group<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Size Group" class="form-control" ng-model="bulletinTemplateNew.SizeGroupId" ng-options="item.Value as item.Text for item in sizeGroupList" tabindex="5" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Tagged PrO</label>
                <div class="col-sm-8">
                    @*<a style="text-decoration:underline;color:blue; cursor:pointer;" ng-click="GetProdBulletinInfo();">{{bulletinTemplateNew.PBCount}}</a>*@
                    <ul class="list-inline action-list">
                        <li>
                            <button ng-click="GetProdBulletinInfo()" style="text-decoration:underline; cursor:pointer;" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Tagged PrO">
                                {{bulletinTemplateNew.PBCount}}
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">By Whom<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="By Whom" ng-model="bulletinTemplateNew.ByWhom" class="form-control" required tabindex="3" maxlength="50">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Alternative Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Alternative Name" ng-model="bulletinTemplateNew.AlternativeName" class="form-control" required tabindex="2" maxlength="50" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Product Master<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Product Master" class="form-control" ng-model="bulletinTemplateNew.ProductMasterId" ng-options="item.Value as item.Text for item in productMasterList" tabindex="4" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{bulletinTemplateNew.Id==null?'Save':'Update'}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            <li> <button ng-click="Copy();" class="btn" tabindex="9"><i class="glyphicon glyphicon-copy"></i> Copy</button></li>
        </ul>
    </div>
    <div class="col-xs-12" id="processbuyer">
        <div class="col-sm-12 col-sm-6 col-md-6">
            <fieldset class="scheduler-border" id="ProcessH">
                <legend class="scheduler-border">Process</legend>
                <div class="common-btn" style="margin-top: -20px;">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="AddNewProcess();" class="btn" tabindex="9" ng-disabled="bulletinTemplateNew.Id===null"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i> Add New Process</button></li>
                    </ul>
                </div>
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridProcess" ej-grid e-datasource="processList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="getProcess" e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true" e-actioncomplete="actionCompleteUnassign">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="Process" e-headertext="Process Name" e-width="80"></div>
                            <div e-column e-field="RequiredStdTarget" e-headertext="Required Std.Target" e-width="80"></div>
                            <div e-column e-field="MaxNoOfWS" e-headertext="Max No Of WS" e-width="80"></div>
                            <div e-column e-field="PlannedHoursPerDay" e-headertext="Planned Hours PerDay" e-width="60"></div>
                            <div e-column e-field="BottleNeckPercentage" e-headertext="Bottle Neck Percentage" e-width="80"></div>
                            <div e-column e-headertext="Actions" e-width="70">
                                <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;" class="btn"><i class="glyphicon glyphicon-pencil" ng-click="$parent.EditProcess($event);" style="margin: -6px;"></i></button>
                                <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeProcess($event);" style="margin: -6px;"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="col-sm-12 col-sm-6 col-md-6">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Buyer</legend>
                <div class="common-btn" style="margin-top: -20px;">
                    <ul class="list-inline text-left">
                        <li><button ng-click="AddNewBuyer();" class="btn" tabindex="9" ng-disabled="bulletinTemplateNew.Id===null"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i> Add New Buyer</button></li>
                    </ul>
                </div>
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridBuyer" ej-grid e-datasource="buyerList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="Buyer" e-headertext="BuyerName" e-width="80"></div>
                            <div e-column e-field="BuyerStyleRefNo" e-headertext="Buyer Style Ref No" e-width="80"></div>
                            <div e-column e-field="OwnStyleRefNo" e-headertext="Own Style Ref No" e-width="60"></div>
                            <div e-column e-headertext="Actions" e-width="50">
                                <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;" class="btn"><i class="glyphicon glyphicon-pencil" ng-click="$parent.EditBuyer($event);" style="margin: -6px;"></i></button>
                                <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeBuyer($event);" style="margin: -6px;"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
    <div class="col-xs-12" id="addoperation" style="font-size:12px">
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="form-group">
                <label class="col-sm-8 control-label" title="Sum of all Total SPT by process" style="color:blue"> Total SPT: {{TotalSPT}}</label>
                <label class="col-sm-8 control-label" title="Sum of all Total MP by process" style="color:blue"> Total MP: {{TotalManpower}}</label>
                <label class="col-sm-8 control-label" title="Sum of all Alloted Work station by process" style="color:blue"> Total Wk Station: {{TotalWorkStation}}</label>
            </div>

        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="form-group">
                <label class="col-sm-8 control-label" title="Sum of MC Total SPT by process" style="color:blue"> MC Total SPT: {{MCtotalspt}}</label>
                <label class="col-sm-8 control-label" title="Sum of MC Total MP by process" style="color:blue"> MC Total MP: {{MCtotalMP}}</label>
            </div>
        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="form-group">
                <label class="col-sm-8 control-label" title="Sum of Non MC Total SPT by process" style="color:blue"> Non MC Total SPT: {{NonMCtotalspt}}</label>
                <label class="col-sm-8 control-label" title="Sum of Non MC Total MP by process" style="color:blue"> Non MC Total MP: {{NonMCtotalMP}}</label>
