                            <li><button style="margin-left: 5px;" ng-click="AddOperation();" ng-disabled="bulletinTemplateNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus" style="top: 1px;"></i> Add {{Process}} Operation</button></li>
                            <li><button style="margin-left: 5px;" ng-click="AddMultiCode();" ng-disabled="bulletinTemplateNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus" style="top: 1px;"></i> Multi Code</button></li>
                        </ul>
                    </div>

