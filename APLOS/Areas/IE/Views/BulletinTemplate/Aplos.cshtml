        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="form-group">
                <label class="col-sm-8 control-label" title="Total SPT/Total Manpower" style="color:blue">Pitch Time: {{PitchTime}}</label>
                <label class="col-sm-8 control-label" title="(Total Manpower * 60)/Total SPT" style="color:blue">Pdn 100% Efficiency/Hr: {{ProductionEfficiencyPerHour}}</label>
            </div>
        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="form-group">
                <label class="col-sm-8 control-label" title="Max of Avg Allotted Time" style="color:blue">Max. Allotted Time: {{MaxAllottedTime}}</label>
                <label class="col-sm-12 control-label" title="Production at 100% Efficiency/Hour x Planned Hours/day" style="color:blue">Pdn 100% Efficiency/Day: {{ProductionEfficiencyPerDay}}</label>
            </div>
        </div>
