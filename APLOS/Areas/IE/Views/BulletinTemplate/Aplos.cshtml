                </div>
                <div class="clearfix"></div>
                <div class="col-xs-12">
                    <div style="color:black;" id="GridBulOperation" ej-grid e-datasource="operationList" e-recorddoubleclick="GetOperationVaiationCode" @*e-recorddoubleclick="GetOperationVaiationCode" e-allowpaging="true" *@
