                        </div>
                    </script>
                    <script type="text/template" id="TotalSPT">
                        <div class="col-sm-10" style="padding:0px; width:70px;">
                            @*<input type="text" ng-model="data.TotalSPT| number : 2" disabled style="color:black;" class="form-control" />*@
                            @*<input type="text" ng-model="data.TotalSPT" n-decimals="2" disabled style="color:black;" class="form-control" />*@
                            <span>{{data.TotalSPT| number:2}}</span>
                        </div>
                    </script>

