                <label class="col-sm-8 control-label" title="Production at 100% Efficiency/Hour x Organization Efficiency" style="color:blue">Line Target/Hour: {{LineTargetPerHour}}</label>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="site-tab">
