                            </div>
                            <div e-column e-field="MachineName" e-headertext="Machine Name" e-width="80" style="height: 20px;"></div>
                            <div e-column e-type="numeric" e-format="{0:0.00}" e-field="OperationSPT" e-headertext="Operation SPT" e-width="50" style="height: 20px;"></div>
                            <div e-column e-field="VASSAMSOURCE" e-headertext="SAM Source" e-width="50"></div>
                            <div e-column e-template="#AddSPT" e-headertext="Add.SPT" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#TotalSPT" e-headertext="Total Operation SPT" e-width="50" style="height: 20px;"></div>

                            <div e-column e-template="#RequiredManPower" e-headertext="Required ManPower" e-width="50" style="height: 20px;"></div>
                            <div e-column e-template="#AllotedManpower" e-headertext="Alloted Manpower" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#AllotedWorkstation" e-headertext="Alloted Work Station" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#OperationGroup" e-headertext="Operation Group" e-width="40" style="height: 20px;"></div>
                            <div e-column e-template="#AvgAllotedTime" e-headertext="Avg Alloted Time" e-width="50" style="height: 20px;"></div>
                            <div e-column e-template="#OperationTarget" e-headertext="OperationTarget/Hr" e-width="50" style="height: 20px;"></div>

                            <div e-column e-template="#OperationCategory" e-headertext="Operation Category" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#FZZone" e-headertext="FG Zone" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#FZComponent" e-headertext="FG Component" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#Attachment" e-headertext="Attachment" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#GaugeFolder" e-headertext="Gauge Folder" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#OperationConsumption" e-headertext="Operation Consumption" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#OperationType" e-headertext="Operation Type" e-width="80" style="height: 20px;"></div>
                            <div e-column e-template="#Quality" e-headertext="Quality Level" e-width="40" style="height: 20px;"></div>

                            @*<div e-column e-template="#SPI" e-headertext="SPI" e-width="50" style="height: 20px;"></div>
                                <div e-column e-template="#NoOfStitch" e-headertext="No Of Rows" e-width="50" style="height: 20px;"></div>
                                <div e-column e-template="#OperationLength" e-headertext="Operation Length-cm" e-width="50" style="height: 20px;"></div>
                                <div e-column e-template="#FabWdth" e-headertext="Fabric Width-inch" e-width="50" style="height: 20px;"></div>*@
                            @*<div e-column e-template="#StitchCode" e-headertext="Stitch Code" e-width="80" style="height: 20px;"></div>*@
                            <div e-column e-template="#Frequency" e-headertext="Frequency" e-width="40" style="height: 20px;"></div>



                            <div e-column e-template="#Remark" e-headertext="Remark" e-width="80" style="height: 20px;"></div>
                            <div e-column e-field="IsMaxAllottedTime" e-headertext="IsMaxAllottedTime" e-width="80" style="height: 20px;" e-visible="false"></div>
                            <div e-column e-field="MaterialMaster" e-headertext="Machine Master" e-width="80" style="height: 20px;"></div>
                            <div e-column e-headertext="Actions" e-width="50">
                                <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeProcessOperation($event);" style="margin: -6px;"></i></button>
                            </div>
                            <div e-column e-headertext="" @*e-headertemplateid="#headerDelTemplate"*@ e-template="#checkboxDelTemplate" e-textalign="center" e-width="30"></div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxDelTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.DelFlag" />
                    </script>

                    <script type="text/template" id="Sequence">
                        <div class="col-sm-10" style="padding:0px; width:70px;">
                            <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="data.Sequence" e-width="80" />
                        </div>
                    </script>
                    <script type="text/template" id="OperationGroup">
                        <div class="col-sm-10" style="padding:0px; width:70px;">
                            <input type="text" ng-model="data.OperationGroup" style="color:black;" class="form-control" />
                        </div>
                    </script>
                    <script type="text/template" id="OperationCategory">
                        @*<div class="col-sm-10" style="padding:0px; width:90px;margin:-12px;">
                                <input ej-dropdownlist e-datasource="$parent.OperationCategoryList" e-value="data.OperationCategoryId" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                            </div>*@
