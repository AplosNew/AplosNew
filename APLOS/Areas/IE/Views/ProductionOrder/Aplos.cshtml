<togglable name="Production Order"></togglable>

<div class="form-elements" ng-form id="ProductionOrder" name="productionOrderForm">
    <input type="hidden" ng-model="productionOrder.Id">
    <input type="hidden" ng-model="productionOrder.AddedBy">
    <input type="hidden" ng-model="productionOrder.AddedDate">
    <input type="hidden" ng-model="productionOrder.AddedFromIP">

    <!--Master Entry Left-->
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Material Master<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="MaterialMasterId"  ng-model="productionOrder.MaterialMasterId" class="form-control" required>
                <!--<div class="select-style">
                    <select name="Characteristics" submit-required="true" ng-model="productionOrder.CharacteristicsId" ng-options="item.Value as item.Text for item in characterList" tabindex="1" required>
                        <option></option>
                    </select>
                </div>-->
            </div>
        </div>
        

        <div class="form-group"  show-errors>
            <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="CustomerId"  ng-model="productionOrder.CustomerId" class="form-control">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">PO</label>
            <div class="col-sm-8">
                <input type="text" name="PoNumber" ng-model="productionOrder.PoNumber" class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="PlantId" submit-required="true" ng-model="productionOrder.PlantId" ng-options="item.Value as item.Text for item in plantList" required>
                        <option></option>
                    </select>
                </div>
                <!--<input type="number" name="PlantId" ng-model="productionOrder.PlantId" class="form-control" required tabindex="7">-->
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Unit<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="UnitId" submit-required="true" ng-model="productionOrder.UnitId" ng-options="item.Value as item.Text for item in unitList" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">UOM<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="UomId" submit-required="true" ng-model="productionOrder.UomId" ng-options="item.Value as item.Text for item in uomList" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox">
                    <input type="checkbox" class="css-checkbox" id="active" ng-model="characteristicsvalue.Active" tabindex="9">
                    <label class="css-label" for="active"></label>
                </div>
            </div>
        </div>
    </div>
    <!--Master Entry Rigt-->
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <!--<div class="form-group">
            <label class="col-sm-4 control-label">MaterialCodePrefix</label>
            <div class="col-sm-8">
                <input type="text" ng-model="characteristicsvalue.MaterialCodePrefix" class="form-control" tabindex="2">
            </div>
        </div>-->
        <!--<div class="form-group">
            <label class="col-sm-4 control-label">MaterialDescPrefix</label>
            <div class="col-sm-8">
                <input type="text" ng-model="characteristicsvalue.MaterialDescPrefix" class="form-control" tabindex="4" >
            </div>
        </div>-->
        <!--<div class="form-group">
            <label class="col-sm-4 control-label">Is Default</label>
            <div class="col-sm-8">
                <div class="checkbox">
                    <input type="checkbox" class="css-checkbox" id="IsDefault" ng-model="characteristicsvalue.IsDefault" tabindex="6">
                    <label class="css-label" for="IsDefault"></label>
                </div>
            </div>
        </div>-->
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-plus"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-remove"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-trash"></i> Clear</button></li>
        </ul>
    </div>

</div>

<!--Search Filter-->
<div class="row text-right">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchMasterByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Grid-->
<div class="table-responsive common-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Material Master</th>
                <th>Customer</th>
                <th>PO</th>
                <th>Plant</th>
                <th>Unit</th>
                <th>UOM</th>
                <th>Active</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in productionOrderList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-click="Get(x.Id, $index);">

                <td>{{x.Id}}</td>
                <td>{{x.MaterialMasterName}}</td>
                <td>{{x.CustomerName}}</td>
                <td>{{x.PoNumber}}</td>
                <td>{{x.PlantName}}</td>
                <td>{{x.UnitName}}</td>
                <td>{{x.UomName}}</td>
                <td>{{x.Active?'Yes':'False'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
