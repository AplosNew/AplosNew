<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="form-horizontal" ng-form name="ModelNewForm" id="MainDIV">
    <div class="form-elements" id="Marker">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="modelNew.ProductionEntityId" name="Entity" ng-options="item.Id as item.UserName for item in entityList" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Production Order<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="text" name="ProductionOrder" ng-model="modelNew.ProductionOrderId" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="getProductionOrderPopUp();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="col-md-12" ng-show="VWCDATA.length>0">
        <div id="gridprviews" n ej-grid e-datasource="VWCDATA" e-showsummary="true" e-summaryrows="summaryRowsForWorkCenter"
             e-responsive="true">
            @*e-recorddoubleclick="workcenterclick"*@
            <div e-columns>
                <div e-column e-field="Entity" e-headertext="Entity" e-width="4" e-isprimarykey="true"></div>
                <div e-column e-field="WorkCenter" e-headertext="Work Center" e-width="4" e-isprimarykey="true"></div>
                <div e-column e-field="FromDate" e-headertext="From Plan Date" e-width="3"></div>
                <div e-column e-field="ToDate" e-headertext="To Plan Date" e-width="3"></div>
                <div e-column e-field="LSD" e-headertext="LSD" e-width="3"></div>
                <div e-column e-field="CommitmentDate" e-headertext="Comm. Dt" e-width="3"></div>
                <div e-column e-type="number" e-field="DelayedProductionDaysOnCommitmentDate" e-headertext="Delay(On Comm. Dt)" e-width="2"></div>

                <div e-column e-field="PlannedQuantity" e-headertext="Plan Qty" e-width="2"></div>
                <div e-column e-template="#showGraph" e-headertext="" e-width="3"></div>
            </div>
        </div>
        <script type="text/template" id="showGraph">

            <div class="common-btn">
                <ul class="list-inline text-right small">

                    <li>
                        <button ng-click="$parent.showlinegraph(this);" class="btn small" style="height: 20px; width: 20px;padding: 0px;margin: 0px;">
                            <i class="glyphicon glyphicon-signal small"></i>
                        </button>
                    </li>
                    <li>
                        <button ng-click="$parent.workcenterclick(this);" class="btn small" style="height: 20px;width: 20px;padding: 0px;margin: 0px;">
                            <i class="glyphicon glyphicon-list small"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>
    </div>
    <br />
</div>

<div id="mainContent"></div>

<div id="ToolbarItem" ej-toolbar e-datasource="drawingToolsList" e-fields-tooltiptext="tooltiptext"
     e-width="100%" e-height="33px" e-fields-id="id" e-fields-spritecssclass="spriteCss" e-click="onItemclick"
     style="background-color: #ebeced; border-bottom-color: #bbbbbb; border-top-style: none; border-left-style: none; border-right-style: none">
</div>
<div>
    <ej-diagram id="diagram" e-contextmenu="contextMenu" e-contextmenuclick="onDiagramContextMenuClick" e-height="400px" e-itemclick="itemClick" e-nodecollectionchange="nodeCollectionChange" e-width="100%">
    </ej-diagram>
</div>

<div class="common-btn">
    <ul class="list-inline text-right">
        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
    </ul>
</div>

