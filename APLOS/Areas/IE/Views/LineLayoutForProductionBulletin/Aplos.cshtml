                            <button ng-click="$parent.ViewOperationVariationCard(this);" class="btn small" style="height: 20px; width: 20px; padding: 0px; margin: 0px;">
                                <i class="glyphicon glyphicon-th-list"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
            @*<div class="col-xs-12 col-sm-5 col-md-5">
                    <div class="common-btn">
                        <ul class="list-inline text-right small">
                            <li>
                                <button ng-click="$parent.operationButtonClick(this);" class="btn small" style="height: 20px; width: 20px; padding: 0px; margin: 0px;">
                                    <i class="glyphicon glyphicon-search"></i>
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>*@
        </div>
        <div class="row" style="padding-top:4px;">
            <div class="col-xs-12 col-sm-12 col-md-12" style="white-space: nowrap; overflow: hidden; font-size: 10px;color:{{this.items[0].fontColor}};">
                <span title=" {{this.items[0].addInfo.ArticleId?this.items[0].addInfo.ArticleDesc:'[select machine]'}}">
                    {{this.items[0].addInfo.ArticleId?this.items[0].addInfo.ArticleDesc:'[Missing Machine]'}}
                </span>
            </div>
            @*<div class="col-xs-12 col-sm-5 col-md-5">
                    <div class="common-btn">
                        <ul class="list-inline text-right small">
                            <li>
                                <button ng-click="$parent.machineButtonClick(this);" class="btn small" style="height: 20px; width: 20px; padding: 0px; margin: 0px;">
                                    <i class="glyphicon glyphicon-search"></i>
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>*@
        </div>
        <div class="col-xs-12" style="padding:0px;margin:0px;font-size:6pt; font-weight: bolder;  position: absolute; bottom: 0px; left: 0px; float: left;">
            <div class="col-xs-12  col-sm-2 col-md-2 center-block" style="padding-left:2px; border: 1px solid #ffffff; background-color: yellow; color: blue;">
                S{{this.items[0].addInfo.Sequence}}
            </div>
            <div class="col-xs-12  col-sm-2 col-md-2 center-block" style="padding-left: 2px; border: 1px solid #ffffff; background-color: blue; color: white; ">
                M{{this.items[0].addInfo.RequiredManPower}}
            </div>
            <div class="col-xs-12  col-sm-2 col-md-2 center-block" style="padding-left: 2px; border: 1px solid #ffffff; background-color: #015a20; color: white;">
                W{{this.items[0].addInfo.AllotedWorkstation}}
            </div>
            <div class="col-xs-12  col-sm-2 col-md-2 center-block" style="padding-left: 2px; border: 1px solid #ffffff; background-color: #e89800; color: white;">
                T{{this.items[0].addInfo.TotalSPT}}
            </div>
            <div class="col-xs-12  col-sm-1 col-md-1 center-block" style="padding-left: 2px; border: 1px solid #ffffff; background-color: #015a20; color: white;">
