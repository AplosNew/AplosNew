                <span title="{{this.items[0].addInfo.OperationDesc?this.items[0].addInfo.OperationDesc:'[select operation]'}}">
                    {{this.items[0].addInfo.OperationDesc?this.items[0].addInfo.OperationDesc:'[Missing Operation]'}}
