<ej-dialog id="dialogEditNode" title="Color" e-enablemodal="true" e-position-y="0" e-position-x="0" e-showoninit="false" e-target="#MainDIV" e-close="onDialogClose" e-width="500" e-open="enableBtn">
    <div class="row">
        <div class="col-sm-12 col-sm-2 col-sm-2" ng-show="selectednode.target.hasOwnProperty('fontColor')"> Font</div>
        <div class="col-sm-12 col-sm-2 col-sm-2" ng-show="selectednode.target.hasOwnProperty('fontColor')">
            <input ej-colorpicker e-field="fontColor" e-change="UpdateColor" e-value="selectednode.target.fontColor" e-modeltype="palette" />
        </div>
        <div class="col-sm-12 col-sm-2 col-sm-2"> Back</div>
        <div class="col-sm-12 col-sm-2 col-sm-2">
            <input ej-colorpicker e-field="fillColor" e-change="UpdateColor" e-value="selectednode.target.fillColor" e-modeltype="palette" />
        </div>
        <div class="col-sm-12 col-sm-2 col-sm-2"> Border</div>
        <div class="col-sm-12 col-sm-2 col-sm-2">
            <input ej-colorpicker e-field="borderColor" e-change="UpdateColor" e-value="selectednode.target.borderColor" e-modeltype="palette" />
        </div>


    </div>
</ej-dialog>
<ej-dialog id="dialogOperationVariationCard" title="Operation Info" e-enablemodal="true" e-position-y="0" e-position-x="0" e-showoninit="false" e-target="#MainDIV" e-close="onDialogClose" e-width="900" e-open="enableBtn">

    <div class="row">
        <div class="col-xs-12">
            <h6 class="site-heading">Operation Detail</h6>
        </div>
        <div class="col-xs-12">
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Operation </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].Operation}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Opn Var. </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].OperationVariation}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Code </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].Code}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Category </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].OperationCategory}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Material </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].Material}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Article </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].Article}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">RPM </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].RPM}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">StitchCode </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].StitchCode}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Machine Req. </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].IsMachineRequired}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Skill </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].Skill}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Sub Opn.SPT </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].SubOperationSAM}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Add. SPT </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].AdditionalSAM}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Freq </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].Frequency}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Mac.Alw </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].MachineAllowance}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">SPI </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].SPI}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Total SPT </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].TotalSAM}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">Add.Alw </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].AdditionalAllowance}} </div>
            <div class="col-xs-12 col-sm-2 col-sm-2 text-nowrap">VAS SPT </div><div class="col-xs-12 col-sm-4 col-sm-4 text-nowrap">: {{OperationVariationCard[0][0].VASFINALSAM}} </div>
        </div>
    </div>

</ej-dialog>
<ej-dialog id="dialogSearchEmployee" title="Employees" e-enablemodal="true" e-position-y="0" e-position-x="0" e-showoninit="false" e-target="#mainContent" e-close="onDialogClose" e-width="900" e-open="enableBtn">
    <div class="col-xs-12" style="border:1px solid #dfdfdf">
        <div class="row text-right">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="search-form">
                    <div class="row">
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="select-style">
                                <select ng-model="EmployeeSearchCol">
                                    <option ng-repeat="option in EmployeemodelFilterByList" value="{{option.value}}">{{option.name}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-7 col-md-7">
                            <input type="text" class="form-control" placeholder="Search" ng-model="EmployeeSearchVal" ng-enter="getEmployeeData()">
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2">
                            <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="SearchEmployee" ng-init="chkinit()" ej-grid e-datasource="EmployeeList" e-gridlines="horizontal"
             e-allowtextwrap="true" e-textwrapsettings.wrapmode="content"
             e-recorddoubleclick="ViewEmployeeStatus" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="30" e-primarykey="true" e-visible="false"></div>
                <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                <div e-column e-headertext="" e-template="#empdetail" e-textalign="left" e-width="400"></div>
                @*<div e-column e-field="EmployeeCode" e-headertext="Code" e-width="30"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>*@
            </div>
        </div>
        <script type="text/x-jsrender" id="empimage">
            <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')"
                 src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;border:2px solid #efefef; border-radius:50%;" />
        </script>
        <script type="text/template" id="empdetail">
            <div style="font-size:1.2em">
                <span style="color:blue;font-weight:bold;">{{data.EmployeeCode}}  </span><span style="color:black;font-weight:bold;">{{data.EmployeeName}}</span><br />
            </div>
            <div style="font-size:1em;font-style:italic">
                {{data.Designation}}, {{data.Department}}
            </div>
            <div style="font-size:1em;">
                Section: {{data.Section}}, Sub-section: {{data.SubSection}}
            </div>
        </script>
    </div>
</ej-dialog>

