<style>
    .e-filterset:before {
        color: white;
    }

    #processbuyer .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
        font-size: 10px;
    }

    #addoperation .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
        font-size: 10px;
    }

    #addoperation .e-grid .e-rowcell {
        line-height: 14px;
        font-size: 11px;
        padding: 1px 2px 0px 2px !important;
    }

    #processbuyer .e-grid .e-rowcell {
        line-height: 14px;
        font-size: 11px;
        padding: 1px 2px 0px 2px !important;
    }

    #addoperation .e-grid .e-headercelldiv {
        font-size: 9px;
        height: 20px;
        line-height: 10px;
    }

    #processbuyer .e-grid .e-headercelldiv {
        font-size: 9px;
        height: 20px;
        line-height: 10px;
    }

    #processbuyer .glyphicon {
        top: -6px;
    }

    #addoperation .glyphicon {
        top: -6px;
    }
</style>

<h3 class="site-heading"> VAS Approval</h3>
<div class="form-elements form-horizontal">
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <div class="form-group">
                <ej-dialog id="BullPoUp" title="Bulletin" e-enablemodal="true" e-position-y="0" e-showoninit="false"
                           e-close="onDialogClose" e-minwidth="1000" e-minheight="80" e-open="enableBtn" e-target="#ProdBulletin">
                </ej-dialog>
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <div class="site-tab">
                            <ul class="nav nav-tabs" role="tablist">
                                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Element10" role="tab" data-toggle="tab">New</a></li>
                                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Element20" role="tab" data-toggle="tab">Approved</a></li>
                            </ul>
                        </div>
                        <div class="tab-content">
                            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="col-xs-12 col-sm-3 col-md-3">
                                            <div class="form-group">
                                                <label class="control-label">From Date(Creation)<sup>*</sup></label>
                                                <div>
                                                    <input  type="text" name="Form Date" ng-model="report.FromDate" datepicker tabindex="1" class="form-control" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-xs-12 col-sm-3 col-md-3">
                                            <div class="form-group">
                                                <label class="control-label">To Date(Creation)<sup>*</sup></label>
                                                <div>
                                                    <input type="text" name="To Date" ng-model="report.ToDate" datepicker tabindex="2" class="form-control" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-xs-12 col-sm-6 col-md-6" style="padding-top: 25px;">
                                            <button type="button" class="btn single-small-btn" ng-click="getNewVASList();"><i class="glyphicon glyphicon-refresh"></i></button>
                                        </div>
                                    </div>
                                </div>

                                <div id="GridVASNew" ej-grid e-datasource="newVASList" e-gridlines="vertical" e-templaterefresh="refreshTemplateOperation"
                                     e-allowfiltering="true"
                                     e-allowpaging="true"
                                     e-allowsorting="true"
                                     e-allowResizing="true"
                                     e-allowscrolling="true"
                                     e-filtersettings-filterType="excel"
                                     e-enabletouch="true" e-responsive="true"
                                     e-allowTextWrap="true"
                                     e-rowdatabound="rowDataBoundOrder"
                                     e-recorddoubleclick="recorddoubleclick">
                                    <div e-columns>
                                        <div e-column e-type="string" e-field="Id" e-headertext="ID" e-width="50" e-visible="false"></div>
                                        <div e-column e-type="string" e-field="OperationCode" e-headertext="Opr. Var. Code" e-width="100"></div>
                                        <div e-column e-type="string" e-field="StandardName" e-headertext="Opr. Var. Name" e-width="200"></div>
                                        <div e-column e-type="string" e-field="Operation" e-headertext="Operation" e-width="100"></div>
                                        <div e-column e-type="string" e-field="Machine" e-headertext="Opt. Machine" e-width="100"></div>
                                        <div e-column e-type="string" e-field="MachineActual" e-headertext="Actual Machine" e-width="100"></div>
                                        @*<div e-column e-type="number" e-field="Version" e-headertext="Approved Version" textAlign='center' e-width="100"></div>*@
                                        <div e-column e-type="string" e-field="VasDescription" e-headertext="Description" textAlign='center' e-width="100"></div>
                                        <div e-column e-type="string" e-field="OriginalVideoName" e-headertext="File Name" textAlign='center' e-width="100"></div>
                                        <div e-column e-type="number" e-field="SPI" e-headertext="SPI" e-width="100" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="RPM" e-headertext="RPM" textAlign='center' e-width="80"></div>
                                        <div e-column e-type="number" e-field="PersonalAllowances" e-headertext="Personal Allowances %" e-width="120" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="MachineAllowances" e-headertext="Machine Allowances %" e-width="120" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="AdditionalAllowances" e-headertext="Additional Allowances %" e-width="120" textAlign='center'></div>
                                        <div e-column e-type="string" e-field="ProductionSystem" e-headertext="Prod. System" e-width="100"></div>
                                        <div e-column e-type="number" e-field="ProductionSystemAllowance" e-headertext="PS Allowance %" e-width="100"></div>
                                        <div e-column e-type="number" e-field="OperationSAM" e-headertext="Operation SPT" e-width="100" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="VASSAM" e-headertext="VAS SPT" e-width="100" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="StandardSAM" e-headertext="Standard SPT" e-width="100" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="VASQuantity" e-headertext="Qty" e-width="100" textAlign='center'></div>

                                        <div e-column e-type="number" e-field="TotalVersion" e-headertext="Total Version" e-width="100" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="ApprovedVersion" e-headertext="Approved Version" e-width="100" textAlign='center'></div>
                                        <div e-column e-field="AddedBy" e-headertext="Created By" textAlign='center' e-width="80"></div>
                                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy hh:mm:ss tt}" e-field="AddedDate" e-headertext="Creation Date" textAlign='center' e-width="90"></div>
                                        <div e-column e-type="string" e-field="ApprovedBy" e-headertext="Approved By" textAlign='center' e-width="80" e-allowfiltering="true"></div>
                                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy hh:mm:ss tt}" e-field="ApprovedDate" e-headertext="Approval Date" textAlign='center' e-width="90" e-allowfiltering="true"></div>
                                        @*<div e-column e-field="Version" e-headertext="Version" textAlign='center' e-width="100"></div>*@
                                        @*<div e-column e-template="#GridBullActions" e-width="50" textAlign='center'></div>*@
                                    </div>
                                </div>

                                <script type="text/template" id="GridBullActions">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnApprove">
                                        <i class="glyphicon glyphicon-list-alt" title="Approve" ng-click="$parent.onClickVASVersion('GridVASNew');" style="margin: -6px;"></i>
                                    </button>
                                </script>
                                <div class="row">
                                    <div class="col-sm-12">
                                        All parameters are based on last version
                                    </div>
                                </div>
                            </div>
                            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">

                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="col-xs-12 col-sm-3 col-md-3">
                                            <div class="form-group">
                                                <label class="control-label">From Date(Approval)<sup>*</sup></label>
                                                <div>
                                                    <input type="text" name="Form Date" ng-model="reportApproved.FromDate" datepicker class="form-control" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-xs-12 col-sm-3 col-md-3">
                                            <div class="form-group">
                                                <label class="control-label">To Date(Approval)<sup>*</sup></label>
                                                <div>
                                                    <input type="text" name="To Date" ng-model="reportApproved.ToDate" datepicker class="form-control" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-xs-12 col-sm-6 col-md-6" style="padding-top: 25px;">
                                            <button type="button" class="btn single-small-btn" ng-click="getApprovedVASList();"><i class="glyphicon glyphicon-refresh"></i></button>
                                        </div>
                                    </div>
                                </div>
                                <div id="GridVASApproved" ej-grid e-datasource="approvedVASList" e-gridlines="vertical" e-templaterefresh="refreshTemplateOperation"
                                     e-allowfiltering="true"
                                     e-allowpaging="true"
                                     e-allowsorting="true"
                                     e-allowResizing="true"
                                     e-allowscrolling="true"
                                     e-filtersettings-filterType="excel"
                                     e-enabletouch="true" e-responsive="true"
                                     e-allowTextWrap="true"
                                     e-rowdatabound="rowDataBoundOrder"
                                     e-recorddoubleclick="recorddoubleclick">
                                    <div e-columns>
                                        <div e-column e-type="string" e-field="Id" e-headertext="ID" e-width="50" e-visible="false"></div>
                                        <div e-column e-type="string" e-field="OperationCode" e-headertext="Opr. Var. Code" e-width="100"></div>
                                        <div e-column e-type="string" e-field="StandardName" e-headertext="Opr. Var. Name" e-width="200"></div>
                                        <div e-column e-type="string" e-field="Operation" e-headertext="Operation" e-width="100"></div>
                                        <div e-column e-type="string" e-field="Machine" e-headertext="Opt. Machine" e-width="100"></div>
                                        <div e-column e-type="string" e-field="MachineActual" e-headertext="Actual Machine" e-width="100"></div>
                                        <div e-column e-type="number" e-field="Version" e-headertext="Approved Version" textAlign='center' e-width="100"></div>
                                        <div e-column e-type="string" e-field="VasDescription" e-headertext="Description" textAlign='center' e-width="100"></div>
                                        <div e-column e-type="string" e-field="OriginalVideoName" e-headertext="File Name" textAlign='center' e-width="100"></div>
                                        <div e-column e-type="number" e-field="SPI" e-headertext="SPI" e-width="100" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="RPM" e-headertext="RPM" textAlign='center' e-width="80"></div>
                                        <div e-column e-type="number" e-field="PersonalAllowances" e-headertext="Personal Allowances %" e-width="120" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="MachineAllowances" e-headertext="Machine Allowances %" e-width="120" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="AdditionalAllowances" e-headertext="Additional Allowances %" e-width="120" textAlign='center'></div>
                                        <div e-column e-type="string" e-field="ProductionSystem" e-headertext="Prod. System" e-width="100"></div>
                                        <div e-column e-type="number" e-field="ProductionSystemAllowance" e-headertext="PS Allowance %" e-width="100"></div>
                                        <div e-column e-type="number" e-field="OperationSAM" e-headertext="Operation SPT" e-width="100" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="VASSAM" e-headertext="VAS SPT" e-width="100" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="StandardSAM" e-headertext="Standard SPT" e-width="100" textAlign='center'></div>
                                        <div e-column e-type="number" e-field="VASQuantity" e-headertext="Qty" e-width="100" textAlign='center'></div>
                                        <div e-column e-field="AddedBy" e-headertext="Created By" textAlign='center' e-width="80"></div>
                                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy hh:mm:ss tt}" e-field="AddedDate" e-headertext="Creation Date" textAlign='center' e-width="90"></div>
                                        <div e-column e-type="string" e-field="ApprovedBy" e-headertext="Approved By" textAlign='center' e-width="80" e-allowfiltering="true"></div>
                                        <div e-column e-type="date" e-format="{0:dd-MMM-yyyy hh:mm:ss tt}" e-field="ApprovedDate" e-headertext="Approval Date" textAlign='center' e-width="90" e-allowfiltering="true"></div>
                                        @*<div e-column e-field="VASSAM" e-headertext="VAS SAM" e-width="100" textAlign='center'></div>*@
                                        <div e-column e-type="number" e-field="TotalVersion" e-headertext="Total Version" e-width="100" textAlign='center'></div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12">
                                        All parameters are based on approved version
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal site-modal" id="modalVersionList" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Operation Version List - {{Operation_Version_Name}}<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        **All durations are expressed in seconds
                    </div>
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <div id="GridVASVersion" ej-grid e-datasource="newVASVersionList" e-gridlines="vertical" e-templaterefresh="refreshTemplateOperation"
                             e-allowpaging="true"
                             e-allowsorting="true"
                             e-allowscrolling="true"
                             e-allowResizing="true"
                             e-allowTextWrap="true"
                             e-allowfiltering="true"
                             e-filtersettings-filterType="excel"
                             e-enabletouch="true" e-responsive="true"
                             e-detailstemplate="detailTemp"
                             e-rowdatabound="rowDataBoundOrder"
                             e-detailsdatabound="detailgrid">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                                <div e-column e-headertext="Approve" e-template="#GridApproveActions" e-width="50" textAlign='center'></div>
                                <div e-column e-headertext="Video" e-template="#GridVideoActions" e-width="50" textAlign='center'></div>
                                <div e-column e-type="number" e-field="Version" e-headertext="Version" e-width="50" textAlign='center'></div>
                                <div e-column e-type="string" e-field="VASMasterID" e-headertext="VASMasterID" e-width="50" e-visible="false"></div>
                                <div e-column e-type="string" e-field="VasDescription" e-headertext="Desc" e-width="100"></div>
                                <div e-column e-type="string" e-field="OriginalVideoName" e-headertext="File Name" textAlign='center' e-width="100"></div>
                                <div e-column e-type="number" e-field="SPI" e-headertext="SPI" e-width="40" textAlign='center'></div>
                                <div e-column e-type="number" e-field="RPM" e-headertext="RPM" e-width="40" textAlign='center'></div>
                                <div e-column e-type="number" e-field="PersonalAllowances" e-headertext="Personal Allowances" e-width="60" textAlign='center'></div>
                                <div e-column e-type="number" e-field="MachineAllowances" e-headertext="Machine Allowances" e-width="60" textAlign='center'></div>
                                <div e-column e-type="number" e-field="AdditionalAllowances" e-headertext="Additional Allowances" e-width="60" textAlign='center'></div>
                                <div e-column e-type="number" e-field="ProductionSystemAllowance" e-headertext="PS Allowance %" e-width="60"></div>
                                <div e-column e-type="number" e-field="OperationSAM" e-headertext="Operation SPT" textAlign='center' e-width="60"></div>
                                <div e-column e-type="number" e-field="VASSAM" e-headertext="VAS SPT" e-width="40" textAlign='center'></div>
                                <div e-column e-type="number" e-field="StandardSAM" e-headertext="Standard SPT" textAlign='center' e-width="60"></div>
                                <div e-column e-type="number" e-field="VASQuantity" e-headertext="Qty" e-width="100" textAlign='center'></div>
                                @*<div e-colu e-type="number"mn e-field="ApprovedVersion" e-headertext="Approved Version" e-width="80" textAlign='center'></div>*@
                                <div e-column e-field="AddedBy" e-headertext="Created By" textAlign='center' e-width="80"></div>
                                <div e-column e-type="date" e-format="{0:dd-MMM-yyyy hh:mm:ss tt}" e-field="AddedDate" e-headertext="Creation Date" textAlign='center' e-width="90"></div>
                                <div e-column e-type="string" e-field="ApprovedBy" e-headertext="Approved By" textAlign='center' e-width="80" e-allowfiltering="true"></div>
                                <div e-column e-type="date" e-format="{0:dd-MMM-yyyy hh:mm:ss tt}" e-field="ApprovedDate" e-headertext="Approval Date" textAlign='center' e-width="90" e-allowfiltering="true"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/template" id="GridApproveActions">
    <button @*ng-hide="data.ApprovedVersion !=null"*@ style="color:{{data.ApprovedVersion !=null && data.Version==data.ApprovedVersion?'#00ff00':' #f3f3ec'}};background-color: #1c1f32;height: 30px;" class="btn btnApprove">
        <i class="fa fa-check" title="Approve" ng-click="$parent.approveOperationVersion('GridVASVersion');" style="margin: -6px;"></i>
    </button>
</script>
<script type="text/template" id="GridVideoActions">
    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnApprove">
        <i class="fa fa-file-video-o" title="Play Video" ng-click="$parent.loadOperationVideo('GridVASVersion');" style="margin: -6px;"></i>
    </button>
</script>
<div class="modal fade site-modal in" id="modalPlayVideo" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">{{Operation_Video_Version_Name}}<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <video id='vdid' controls volume='0' muted='muted' style="width:100%;height:400px; object-fit:scale-down;">
                        </video>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script id="tabGridContents" type="text/x-jsrender">
    <div id="detailGrid"></div>
</script>
<confirm-archive-generic modalid="modalConfirm" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="vasApprove();"></confirm-archive-generic>