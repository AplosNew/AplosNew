<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> VAS SPT Compare</h3>
<div class="form-elements form-horizontal"  ng-form name="frmVASReport">
    @*<div class="col-xs-12 col-sm-2 col-md-2" style="padding-top: 25px;">
        <button type="button" class="btn single-small-btn" ng-click="onClickVASReport();"><i class="glyphicon glyphicon-export"></i>Load Report</button>
    </div>*@

    <div class="row">
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="form-group" show-errors>
                <label class="control-label">From Date(Creation)<sup>*</sup></label>
                <div class="show-message">
                    <input id="txtFromDate" type="text" name="Form Date" ng-model="report.FromDate" datepicker required tabindex="1" class="form-control" />
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-3 col-md-3">
            <div class="form-group" show-errors>
                <label class="control-label">To Date(Creation)<sup>*</sup></label>
                <div class="show-message">
                    <input id="txtToDate" type="text" name="To Date" ng-model="report.ToDate" datepicker required tabindex="2" class="form-control" />
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6" style="padding-top: 25px;">
            <button type="button" class="btn single-small-btn" ng-click="LoadSearchdData();"><i class="glyphicon glyphicon-refresh"></i></button>
            <button type="button" ng-show="samCompareDataList.length>0" class="btn single-small-btn" ng-click="onClickVASReport();"><i class="glyphicon glyphicon-download"></i>Load Report</button>
        </div>
    </div>
    <div class="col-sm-12 col-md-12 col-lg-12">
        **All durations are expressed in seconds
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="row" style="margin-top: 20px;">
            <div id="GridVASReport" ej-grid e-datasource="samCompareDataList" e-gridlines="vertical" e-templaterefresh="refreshTemplateOperation"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowResizing="true"
                 e-allowscrolling="true"
                 e-allowfiltering="true"
                 e-filtersettings-filterType="excel"
                 e-enabletouch="true" e-responsive="true"
                 e-allowTextWrap="true"
                 e-recorddoubleclick="GetBulletin"
                 e-detailstemplate="detailTemp"
                 e-detailsdatabound="detailgrid">
                <div e-columns>
                    <div e-column e-headertemplateid="#headerTemplate" e-template="#checkboxToggle" e-headertext="" e-width="40" textAlign='center'></div>
                    <div e-column e-headertext="Video" e-template="#GridVideoActions" e-width="50" textAlign='center'></div>
                    <div e-column e-type="string" e-field="OperationCode" e-headertext="Opr. Var. Code" e-width="100"></div>
                    <div e-column e-type="string" e-field="StandardName" e-headertext="Opr. Var. Name" e-width="200"></div>
                    <div e-column e-type="string" e-field="Operation" e-headertext="Operation" e-width="100"></div>
                    <div e-column e-type="string" e-field="Machine" e-headertext="Opt. Machine" e-width="100"></div>
                    <div e-column e-type="string" e-field="MachineActual" e-headertext="Actual Machine" e-width="100"></div>
                    <div e-column e-type="number" e-field="Version" e-headertext="Version" textAlign='center' e-width="100"></div>
                    <div e-column e-type="string" e-field="VasDescription" e-headertext="Description" textAlign='center' e-width="100"></div>
                    <div e-column e-type="string" e-field="OriginalVideoName" e-headertext="File Name" textAlign='center' e-width="100"></div>
                    <div e-column e-type="number" e-field="SPI" e-headertext="SPI" e-width="100" textAlign='center'></div>
                    <div e-column e-type="number" e-field="RPM" e-headertext="RPM" textAlign='center' e-width="80"></div>
                    <div e-column e-type="number" e-field="PersonalAllowances" e-headertext="Personal Allowances %" e-width="120" textAlign='center'></div>
                    <div e-column e-type="number" e-field="MachineAllowances" e-headertext="Machine Allowances %" e-width="120" textAlign='center'></div>
                    <div e-column e-type="number" e-field="AdditionalAllowances" e-headertext="Additional Allowances %" e-width="120" textAlign='center'></div>
                    <div e-column e-type="string" e-field="ProductionSystem" e-headertext="Prod. System" e-width="100"></div>
                    <div e-column e-type="number" e-field="ProductionSystemAllowance" e-headertext="PS Allowance %" e-width="100"></div>
                    <div e-column e-type="number" e-field="OperationSAM" e-headertext="Operation SPT" e-width="100" textAlign='center'></div>
                    <div e-column e-type="number" e-field="VASSAM" e-headertext="VAS SPT" e-width="100" textAlign='center'></div>
                    <div e-column e-type="number" e-field="StandardSAM" e-headertext="Standard SPT" e-width="100" textAlign='center'></div>
                    <div e-column e-type="number" e-field="VASQuantity" e-headertext="Qty" e-width="100" textAlign='center'></div>

                    <div e-column e-field="AddedBy" e-headertext="Created By" textAlign='center' e-width="80"></div>
                    <div e-column e-type="date" e-format="{0:dd-MMM-yyyy hh:mm:ss tt}" e-field="AddedDate" e-headertext="Creation Date" textAlign='center' e-width="90"></div>
                    <div e-column e-type="string" e-field="ApprovedBy" e-headertext="Approved By" textAlign='center' e-width="50" e-allowfiltering="true"></div>
                    <div e-column e-type="date" e-format="{0:dd-MMM-yyyy hh:mm:ss tt}" e-field="ApprovedDate" e-headertext="Approval Date" textAlign='center' e-width="90" e-allowfiltering="true"></div>
                    <div e-column e-field="Status" e-headertext="Status" textAlign='center' e-width="50"></div>
                    @*<div e-column e-template="#GridBullActions" e-width="30" textAlign='center'></div>*@
                </div>
            </div>
            <script type="text/template" id="GridBullActions">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnApprove">
                    <i class="glyphicon glyphicon-export" title="Report" ng-click="$parent.onClickSingleVASReport('GridVASReport');" style="margin: -6px;"></i>
                </button>
            </script>
            <script type="text/template" id="checkboxToggle">
                <input type="checkbox" e-value="data.Checked" ej-checkbox class="rowCheckbox" e-checked="data.Checked" />
            </script>
            <script id="tabGridContents" type="text/x-jsrender">
                <div class="col-sm-12" style="width:1000px;overflow:scroll;">
                    <div id="detailGrid"></div>
                </div>
            </script>
            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
            </script>
            <script type="text/template" id="GridVideoActions">
                <div class="common-btn">
                    <ul class="list-inline text-right small">

                        <li>
                            <button ng-click="$parent.loadOperationVideo(data);" class="btn small" style="font-size:24px; height: 40px;width: 40px;padding: 0px;margin: 0px;">
                                <i class="glyphicon glyphicon-facetime-video"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </script>
        </div>
    </div>
    <div class="clearfix"></div>
</div>
<div class="clearfix"></div>
<div class="modal fade site-modal in" id="modalPlayVideo" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">{{Operation_Video_Version_Name}}<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <video id='vdid' controls volume='0' muted='muted' style="width:100%;height:400px; object-fit:scale-down;">
                        </video>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
