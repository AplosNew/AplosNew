<togglable name={{title}}></togglable>
<div class="row form-elements" ng-form name="ElementTypeForm">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtCode">
                        Code<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtCode" name="Element Code" class="form-control" ng-model="VAS.Code" required tabindex="1" />
                        <input type="hidden" id="txtId" name="txtId" ng-model="VAS.Id" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtShortName">
                        Short Name<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtShortName" name="Short Name" class="form-control" ng-model="VAS.ShortName" required tabindex="2" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtStandardName">
                        Standard Name<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtStandardName" name="Standard Name" class="form-control" ng-model="VAS.StandardName" required tabindex="3" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtUserName">
                        User Define Name<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtUserName" name="User Name" class="form-control" ng-model="VAS.UserName" required tabindex="4" />
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">
                <div class="form-group">
                    <label class="control-label" for="txtDescription">
                        Description
                    </label>
                    <div class="">
                        <input type="text" id="txtDescription" name="Description" class="form-control" ng-model="VAS.Description" tabindex="7" />
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="SaveElementType();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{VAS.Id==''?'Save':'Update'}}</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                <li> <button ng-click="Cancel();" class="btn"><i class="glyphicon glyphicon-remove-circle"></i> Cancel</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">
                <div id="GridElementType" ej-grid e-datasource="elementTypeList" e-gridlines="vertical" e-templaterefresh="refreshElementType"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-allowsorting="true"
                     e-allowResizing="true"
                     e-allowTextWrap="true"
                     e-filtersettings-filterType="excel"
                     e-enabletouch="true" e-responsive="true"
                     e-recorddoubleclick="recorddoubleclick">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="Code" e-headertext="Code" e-width="65"></div>
                        <div e-column e-field="ShortName" e-headertext="Short Name" e-width="65"></div>
                        <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="65"></div>
                        <div e-column e-field="UserName" e-headertext="User Define Name" e-width="65"></div>                       
                        <div e-column e-field="Description" e-headertext="Description" e-width="100"></div>
                        <div e-column e-template="#GridActions" e-width="45" textAlign='center'></div>
                    </div>
                </div>
                <script type="text/template" id="GridActions">
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnApprove">
                        <i class="fa fa-pencil" title="Load Data" ng-click="$parent.LoadSelectedData('GridElementType');" style="margin: -6px;"></i>
                    </button>
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnDelete">
                        <i class="fa fa-trash" title="Delete Data" ng-click="$parent.DeleteSelectedData('GridElementType');" style="margin: -6px;"></i>
                    </button>
                </script>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
</div>

<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
