<togglable name={{title}}></togglable>
<div class="row form-elements" ng-form name="ElementCodeForm">
    <div class="col-sm-12 col-md-12 col-lg-12">
        <div class="row">
            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtCode">
                        Element Code<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtCode" name="Element Code" class="form-control" ng-model="VAS.Code" readonly required />
                        <input type="hidden" id="txtId" name="txtId" ng-model="VAS.Id" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtShortName">
                        Short Name<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtShortName" name="Short Name" class="form-control" ng-change="MakeCode();" ng-model="VAS.ShortName" required />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtStandardName">
                        Standard Name<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtStandardName" name="Standard Name" class="form-control" ng-model="VAS.StandardName" required />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtUserName">
                        User Define Name<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtUserName" name="User Name" class="form-control" ng-model="VAS.UserName" required />
                    </div>
                </div>
            </div>
        </div>
        <div class="row">

            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtActivity">
                        Activity<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtActivity" name="Activity" class="form-control" ng-model="VAS.Activity" required />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtElement">
                        Element<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtElement" name="Element" class="form-control" ng-model="VAS.Element" required />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group">
                    <label class="control-label" for="txtDescription">
                        Description
                    </label>
                    <div class="">
                        <input type="text" id="txtDescription" name="Description" class="form-control" ng-model="VAS.Description" />
                    </div>
                </div>
            </div>


            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtRPM">
                        RPM<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtRPM" name="RPM" class="form-control" n-decimals="2" ng-model="VAS.RPM" required ng-change="getTMUValue()" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row">

            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtSPI">
                        SPI<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtSPI" name="SPI" class="form-control" n-decimals="2" ng-model="VAS.SPI" required ng-change="getTMUValue()" />
                    </div>
                </div>
            </div>


            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtLengthInCM">
                        Length In CM<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtLengthInCM" name="Length In CM" n-decimals="2" class="form-control" ng-model="VAS.LengthInCM" required ng-change="getTMUValue();MakeCode();" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="ddlStoppingAccuracy">
                        Stopping Accuracy<sup>*</sup>
                    </label>
                    <div class="select-style">
                        <select class="form-control" id="ddlStoppingAccuracy" ng-model="VAS.StopAccuracyId" required ng-change="getTMUValue();MakeCode();">
                            <option ng-repeat="option in stoppingAccuracyList" value="{{option.Id}}">{{option.Code}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="ddlMCHand">
                        Handling Factor<sup>*</sup>
                    </label>
                    <div class="select-style">
                        <select class="form-control" id="ddlMCHand" ng-model="VAS.HandlingFactorId" required ng-change="getTMUValue();MakeCode();">
                            <option ng-repeat="option in handlingFactorList" value="{{option.Id}}">{{option.Code}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">

            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtSPI">
                        No Of Start<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" name="NoOfStart" class="form-control" n-decimals="0" ng-model="VAS.NoOfStart" required ng-change="getTMUValue()" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtSPI">
                        No Of Stop<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" name="NoOfStop" class="form-control" n-decimals="0" ng-model="VAS.NoOfStop" required ng-change="getTMUValue()" />


                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="SaveData();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{VAS.Id==''?'Save':'Update'}}</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                <li> <button ng-click="Cancel();" class="btn"><i class="glyphicon glyphicon-remove-circle"></i> Cancel</button></li>
            </ul>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12">
                <div class="panel panel-success">
                    <div class="panel-heading">
                        Calculations
                    </div>
                    <div class="panel-body">
                        <div class="col-sm-12 col-md-12 col-lg-12">
                            <table class="table table-bordered table-condensed">
                                <thead>
                                    <tr>
                                        <th>
                                            <span class="tooltipAplos">
                                                <span class="tooltipAplostext">TMU for each start is coming from VAS core settings</span>

                                                {{VAS.NoOfStart}} Start ({{GeneralSetting.EachStartTMU}} x {{VAS.NoOfStart}})
                                            </span>
                                        </th>
                                        <th>
                                            <span class="tooltipAplos">
                                                <span class="tooltipAplostext">Straight Machine Time=(SPI/2.54)*Operation Length in CM/RPM/0.0006</span>
                                                Straight Machine Time
                                            </span>
                                        </th>
                                        <th>
                                            <span class="tooltipAplos">
                                                <span class="tooltipAplostext">This value is coming from VAS core settings</span>
                                                Stop Accuracy
                                            </span>
                                        </th>
                                        <th>
                                            <span class="tooltipAplos">
                                                <span class="tooltipAplostext">TMU for each stop is coming from VAS core settings</span>
                                                {{VAS.NoOfStop}} Stop ({{GeneralSetting.EachStopTMU}} x {{VAS.NoOfStop}})
                                            </span>
                                        </th>
                                        <th>
                                            <span class="tooltipAplos">
                                                <span class="tooltipAplostext">Total TMU=StraightMachineTime + StartTMU + StopTMU + StopAccuracy</span>
                                                Total
                                            </span>

                                        </th>
                                        <th>
                                            <span class="tooltipAplos">
                                                <span class="tooltipAplostext">Additional % on Straight Machine Time(Based on difficulty of handling components)</span>
                                                Handling Factor ({{Calculations.HandlingFactorInPercentage}}%)
                                            </span>

                                        </th>
                                        <th>
                                            <span class="tooltipAplos">
                                                <span class="tooltipAplostext">TMU = Total + HandlingFactor</span>
                                                TMU
                                            </span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            {{GeneralSetting.EachStartTMU*VAS.NoOfStart}}
                                        </td>
                                        <td>
                                            {{Calculations.StraightMachineTMUX}}
                                        </td>

                                        <td>
                                            {{Calculations.StopAccuracy}}
                                        </td>
                                        <td>
                                            {{GeneralSetting.EachStopTMU*VAS.NoOfStop}}
                                        </td>
                                        <td>
                                            <input type="text" name="txtTMU" class="form-control" ng-model="Calculations.StraightMachineTMU" readonly required />
                                        </td>
                                        <td>
                                            {{Calculations.GuideAndTense}}
                                        </td>

                                        <td>
                                            <input type="text" id="txtTMU" name="txtTMU" class="form-control" ng-model="VAS.TMU" readonly required />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <div id="GridElementCode" ej-grid e-datasource="sewingCodeList" e-gridlines="vertical" e-templaterefresh="refreshGridGridElementCode"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowResizing="true"
                 e-allowTextWrap="true"
                 e-filtersettings-filterType="excel"
                 e-enabletouch="true" e-responsive="true"
                 e-allowscrolling="true"
                 e-recorddoubleclick="recorddoubleclick">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                    <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
                    <div e-column e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
                    <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="100"></div>
                    <div e-column e-field="UserName" e-headertext="User Define Name" e-width="100"></div>
                    <div e-column e-field="Activity" e-headertext="Activity" e-width="150"></div>
                    <div e-column e-field="Element" e-headertext="Element" e-width="150"></div>
                    <div e-column e-field="TMU" e-headertext="TMU" e-width="150"></div>
                    <div e-column e-field="MCHand" e-headertext="Handling Factor" e-width="130"></div>
                    <div e-column e-field="SPI" e-headertext="SPI" e-width="100"></div>
                    <div e-column e-field="RPM" e-headertext="RPM" e-width="100"></div>
                    <div e-column e-field="LengthInCM" e-headertext="Length In CM" e-width="100"></div>
                    <div e-column e-field="StoppingAccuracy" e-headertext="Stopping Accuracy" e-width="100"></div>
                    <div e-column e-field="Description" e-headertext="Description" e-width="100"></div>
                    <div e-column e-template="#GridActions" e-width="100" textAlign='center'></div>
                </div>
            </div>
            <script type="text/template" id="GridActions">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnApprove">
                    <i class="fa fa-pencil" title="Load Data" ng-click="$parent.LoadSelectedData('GridElementCode');" style="margin: -6px;"></i>
                </button>
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnDelete">
                    <i class="fa fa-trash" title="Delete Data" ng-click="$parent.DeleteSelectedData('GridElementCode');" style="margin: -6px;"></i>
                </button>
            </script>
        </div>
    </div>
</div>
<div class="clearfix"></div>

<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
