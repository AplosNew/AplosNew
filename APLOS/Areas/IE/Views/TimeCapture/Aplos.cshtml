<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Time Capture</h3>
<div class="form-elements form-horizontal" ng-form="timeCaptureForm">
    <div class="row">
        <div class="col-sm-12 col-md-2 col-lg-2" style="padding-top: 25px;">
            <button type="button" class="btn single-small-btn btn-block" ng-click="getOperationList();"><i class="glyphicon glyphicon-list"></i> Operation Names</button>
        </div>
        <div class="col-sm-12 col-md-1 col-lg-1">
            <div class="form-group" show-errors>
                <label class="control-label" for="txtOperationCode">
                    Operation Code<sup>*</sup>
                </label>
                <div class="show-message">
                    <input type="text" id="txtOperationCode" name="Operation Code" class="form-control" required ng-model="VAS.OperationCode" readonly />
                    <input type="hidden" id="txtOperationId" name="txtOperationId" ng-model="VAS.OperationId" />
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-1 col-lg-1">
            <div class="form-group show-errors">
                <label class="col-sm-12 control-label">Version<sup>*</sup></label>
                <div class="col-sm-12 show-message">
                    <input type="text" id="txtVersion" style="background-color:{{isVersionApproved?'greenyellow':'gainsboro'}};font-size:10pt;font-weight:bolder;" name="Version Should Have a Value" class="form-control" required ng-model="VAS.Version" value="0" readonly />
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <div class="form-group tab-design">
                <label class="col-sm-12 control-label">Select Version</label>
                <div class="col-xs-12 col-md-12 col-lg-12 select-style" style="width: 90%;margin-left: 15px;">
                    <select class="form-control" id="ddlOperationVersion" ng-model="VAS.OperationVersion" ng-change="GetOperationVersionData()">
                        <option value="0">New Version</option>
                        <option ng-repeat="option in operationVersionList" value="{{option.Version}}">{{option.VersionText}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2" style="padding-top: 25px;">
            <button type="button" class="btn single-small-btn" ng-show="IsCreateNewVersion" ng-click="createNewVersion();"><i class="glyphicon glyphicon-plus"></i>Create New Version</button>
        </div>

        <div class="col-sm-12 col-md-4 col-lg-4">
            <div class="form-group tab-design">
                <label class="col-sm-12 control-label">Description</label>
                <div class="col-sm-12">
                    <input type="text" class="form-control" ng-model="VAS.VasDescription" />
                </div>
            </div>
        </div>


    </div>

    <div class="row" style="margin-bottom:10px;">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <div class="form-group">
                <label class="col-sm-12 control-label">Browse file</label>
                <div class="col-sm-12">
                    <div class="upload-btn-wrapper btn-block">
                        <button class="btnUpload btn-block"><i class="fa fa-upload fa-fw"></i> Browse a File(.mp4)</button>
                        <input type="file" accept=".mp4" id="filec" name="file" tabindex="13" />
                    </div>
                </div>
            </div>

        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <div class="form-group">
                <label class="col-sm-12 control-label">Operation Variation Name:</label>
                <div class="col-sm-12">
                    <span id="spOVName" style="font-size: 10pt;"></span>
                </div>
                <label class="col-sm-12 control-label">File Name:</label>
                <div class="col-sm-12">
                    <span id="spFileName" style="font-size: 10pt;"></span>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group">
                <label class="col-sm-12 control-label">Operation Name:</label>
                <div class="col-sm-12">
                    <span id="spOPName" style="font-size: 10pt;"></span>
                </div>
                <div class="row" ng-hide="VAS.Id=='' || VAS.Id==null">
                    <div class="col-sm-12">
                        <label class="col-sm-3 control-label">Crtd By:</label>
                        <label class="col-sm-9 control-label">{{VAS.AddedBy}}</label>
                    </div>
                    <div class="col-sm-12">
                        <label class="col-sm-3 control-label">Crt. Dt:</label>
                        <label class="col-sm-9 control-label">{{VAS.AddedDate}}</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group">
                <label class="col-sm-12 control-label">Machine Name:</label>
                <div class="col-sm-12">
                    <span id="spMCName" style="font-size: 10pt;"></span>
                </div>

                <div class="row" ng-hide="VAS.Id=='' || VAS.Id==null || isVersionApproved==false">
                    <div class="col-sm-12">
                        <label class="col-sm-3 control-label">Appr By:</label>
                        <label class="col-sm-9 control-label">{{VAS.ApprovedBy}}</label>
                    </div>
                    <div class="col-sm-12">
                        <label class="col-sm-3 control-label">Appr Dt:</label>
                        <label class="col-sm-9 control-label">{{VAS.ApprovedDate}}</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row" style="margin-bottom:10px;">
        <div class="col-sm-12 col-sm-6 col-lg-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Machine Master</label>
                <label class="col-sm-8 control-label">{{operationdata.MachineMaster}}</label>

            </div>
        </div>
        <div class="col-sm-12 col-sm-6 col-lg-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Machine</label>
                <div class="col-sm-8">
                    <div class="input-group">
                        @*{{VAS.ArticleId}}*@
                        <input type="text" name="Machine" ng-model="VAS.MachineName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-disabled="operationdata.IsMachineRequired!='M'" ng-click="getArticle();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <style type="text/css">
        #custom-seekbar {
            cursor: default;
            height: 5px;
            margin-bottom: 10px;
            outline: thin solid orange;
            overflow: hidden;
            position: relative;
            width: 100%;
            text-align: center;
        }

            #custom-seekbar span {
                background-color: orange;
                position: absolute;
                top: 0;
                left: 0;
                height: 5px;
                width: 0px;
            }

            #custom-seekbar div {
                position: absolute;
                top: 0;
                left: 0;
                height: 5px;
                width: 100%;
                color: black;
                text-align: center;
            }

        /* following rule is for hiding Stack Overflow's console  */
        .as-console-wrapper {
            display: none !important;
        }
    </style>
    <div class="col-xs-12 col-sm-4 col-md-4">

        <div id="divVideoArea" class="row">

            <figure id="customcontrols">

                <video id='vdid' controls volume='0' muted='muted' style="width:100%;object-fit:scale-down;"></video>

                <figcaption>
                    <div class="row">
                        <div class="col-sm-12 text-center">

                            <div id="custom-seekbar">
                                <span></span>
                            </div>

                            <div class="col-xs-12 col-sm-6 col-md-6 text-left" style="padding:0px;margin:0px;">
                                <input id="timepicker" e-enabled="VideoStartEnabled" type="text" e-value="VAS.videoStartTime" e-change="SetVideoStartPoint" e-timeformat="HH:mm:ss" style="padding:0px;margin:0px;" ej-timepicker e-width="130" />



                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6 text-right">
                                <a style="padding:0px;margin:0px; font-size:8pt;">{{SeekbarDuration}}</a>
                            </div>

                        </div>
                        <div class="col-sm-12 col-md-2 col-lg-2" style="padding-top: 10px;">
                            <a id="btnPlayPause" style="color: #000;font-size: 20pt;" href="javascript:void(0)" ng-click="setPlayPauseActivity()"><i id="playPauseIcon" class="fa fa-play-circle-o fa-fw"></i></a>
                        </div>
                        <div class="col-sm-12 col-md-2 col-lg-2" style="padding-top: 15px;">
                            <a id="btnFastForward" title="Reload Video" style="color: #000;font-size: 15pt;" href="javascript:void(0)" ng-click="reloadVideo()"><i class="fa fa-repeat fa-fw"></i></a>
                        </div>
                        <div class="col-sm-12 col-md-2 col-lg-2" style="padding-top: 15px;">
                            <a id="btnSlowForward" style="color: #000;font-size: 15pt;" href="javascript:void(0)" ng-click="playBackward()"><i class="fa fa-backward fa-fw"></i></a>
                        </div>
                        <div class="col-sm-12 col-md-2 col-lg-2" style="padding-top: 15px;">
                            <a id="btnCalculate" title="Calculate" style="color: #000;font-size: 15pt;" href="javascript:void(0)" ng-click="getCalculateSAM();"><i class="fa fa-calculator fa-fw"></i></a>
                        </div>
                        <div class="col-sm-12 col-md-2 col-lg-2">
                            <div class="btn-group dropup">
                                <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border-radius: 100%;height: 40px;width: 40px;background-color: #000;font-weight: 600;border: 1px solid #000;font-family: verdana;font-size: .6rem;">
                                    {{cycleName}}
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript::void(0)" ng-click="setCycle(1)">CT1</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setCycle(2)">CT2</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setCycle(3)">CT3</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setCycle(4)">CT4</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setCycle(5)">CT5</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-2 col-lg-2">
                            <div class="btn-group dropup">
                                <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border-radius: 100%;height: 40px;width: 40px;background-color: #000;font-weight: 600;border: 1px solid #000;font-family: verdana;font-size: .6rem;">
                                    {{speedName}}
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript::void(0)" ng-click="setRate(0.10)">x.1</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setRate(0.25)">x.25</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setRate(0.50)">x.50</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setRate(0.75)">x.75</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setRate(1)">x1</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setRate(2)">x2</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setRate(4)">x4</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setRate(6)">x6</a></li>
                                    <li><a href="javascript::void(0)" ng-click="setRate(8)">x8</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                </figcaption>
            </figure>
        </div>
    </div>
    <style type="text/css">
        .tarektext {
            display: inline-block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 6ch;
        }
    </style>
    <div class="col-xs-12 col-sm-8 col-md-8" id="divResultArea">
        **Double click on element header to delete that element (e.g. E1, E2...)
        <div class="site-tab">

            <ul class="nav nav-tabs" role="tablist">
                <li ng-repeat="TAB in TotalTabs" role="presentation" ng-class="{ active: isSet(TAB+1) }"><a ng-click="setTab(TAB+1)" href="" aria-controls="Element{{TAB+1}}0" role="tab" data-toggle="tab">E{{TAB+1}}0</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane" ng-repeat="TAB in TotalTabs" ng-class="{ 'in':isSet($index+1), active: isSet($index+1) }">
                <table id="tblE{{TAB+1}}0" style="text-align:left;" class="table table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>
                                Element &nbsp;<i class="fa fa-angle-right fa-lg"></i>
                            </th>
                            <th ng-repeat="ELE in TotalElements">
                                <a href="javascript::void(0)" ng-dblclick="clearSelectedField((TAB*10)+ELE)">E{{(TAB*10)+ELE}}</a>
                            </th>
                        </tr>
                    </thead>
                    <thead class="tblheadTitle">
                        <tr>
                            <th>
                                Element Code&nbsp;<i class="fa fa-angle-right fa-lg"></i>
                            </th>
                            <th ng-repeat="ELE in TotalElements">
                                <input type="button" id="GSD_{{(TAB*10)+ELE}}" value="" class="btn btn-default btnGSD tarektext" ng-click="SetGSDValue($event)" />
                                <input type="hidden" id="hdGSD_{{(TAB*10)+ELE}}" class="GSD_TMU" value="0">
                            </th>

                        </tr>
                        <tr>
                            <th>
                                Element TMU&nbsp;<i class="fa fa-angle-right fa-lg"></i>
                            </th>
                            <th ng-repeat="ELE in TotalElements">
                                <input type="button" id="GSDTMU_{{(TAB*10)+ELE}}" value="" class="btn btn-default btnGSDTMU" />
                            </th>
                        </tr>
                        <tr>
                            <th>
                                Element Type&nbsp;<i class="fa fa-angle-right fa-lg"></i>
                            </th>
                            <th ng-repeat="ELE in TotalElements">
                                <select class="ddlET" id="ddlET_{{(TAB*10)+ELE}}">
                                    <option value=""></option>
                                    <option ng-repeat="option in elementTypesList" value="{{option.Id}}">{{option.name}}</option>
                                </select>
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="CT in TotalCT">
                            <td class="tdTitle">CT{{CT}}</td>
                            <td ng-repeat="ELE in TotalElements">
                                <input type="text" id="CT_{{CT}}_{{(TAB*10)+ELE}}" class="form-control clsTime" n-decimals="3" ng-blur="changeTimes((TAB*10)+ELE);" />
                            </td>
                            <td class="tdTitle" style="background-color:#f6f6f6;border:1px solid #dddddd;padding-left:0px;margin-left:0px;text-align:left;">{{CTAverageModel[$index].Value}}</td>
                        </tr>

                        <tr class="tdAvg">
                            <td class="tdTitle">
                                Average
                            </td>
                            <td ng-repeat="ELE in TotalElements">
                                <input type="text" readonly id="CT_Avg_{{(TAB*10)+ELE}}" class="form-control" ng-blur="changeRatings((TAB*10)+ELE)" />
                            </td>
                            <td class="tdTitle" style="background-color:#f6f6f6;border:1px solid #dddddd;padding-left:0px;margin-left:0px;text-align:left;">{{TotalAverage}}</td>

                        </tr>
                        <tr class="tdRatings">
                            <td class="tdTitle">
                                Rating(%)
                            </td>
                            <td ng-repeat="ELE in TotalElements">
                                <input type="text" id="CT_Rat_{{(TAB*10)+ELE}}" class="form-control CTRating" ng-blur="changeRatings((TAB*10)+ELE)">
                            </td>
                        </tr>
                        <tr class="tdBtSec">
                            <td class="tdTitle">
                                BT(SEC)
                            </td>
                            <td ng-repeat="ELE in TotalElements">
                                <input type="text" readonly id="CT_BT_SEC_{{(TAB*10)+ELE}}" class="form-control BTSEC">
                            </td>
                            <td class="tdTitle" style="background-color:#f6f6f6;border:1px solid #dddddd;padding-left:0px;margin-left:0px;text-align:left;">{{TotalBTSec}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>




    <div class="row">
        <div class="col-sm-12 col-md-4 col-lg-4">
            <div style="margin-top: 20px;">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">SPT</legend>
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group" show-errors>
                            <label class="control-label">Operation<sup>*</sup></label>
                            <div class="show-message">
                                <input type="text" id="txtOperationSAM" name="Operation SPT" class="form-control" required ng-model="VAS.OperationSAM" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group" show-errors>
                            <label class="control-label">VAS<sup>*</sup></label>
                            <div class="show-message">
                                <input type="text" id="txtVASSAM" name="VAS SPT" class="form-control" required ng-model="VAS.VASSAM" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group" show-errors>
                            <label class="control-label">Standard<sup>*</sup></label>
                            <div class="show-message">
                                <input type="text" id="txtStandardSAM" name="Standard SPT" class="form-control" required ng-model="VAS.StandardSAM" readonly />
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
        <div class="col-sm-12 col-md-8 col-lg-8">
            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-12">
                    <div class="col-sm-12 col-md-6 col-lg-6">
                        <div class="form-group" style="padding-left: 15px;">
                            <div class="checkbox-site">
                                <label class=" control-label">
                                    <input type="checkbox" value="1" name="chkCycle" id="chkCycle1" ng-model="VAS.IsAvgCT1" ng-true-value=true ng-false-value=false ng-change="FindCycleAvgMaxMin()">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span> CT1
                                </label>
                                <label class=" control-label">
                                    <input type="checkbox" value="2" name="chkCycle" id="chkCycle2" ng-model="VAS.IsAvgCT2" ng-true-value=true ng-false-value=false ng-change="FindCycleAvgMaxMin()">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span> CT2
                                </label>
                                <label class=" control-label">
                                    <input type="checkbox" value="3" name="chkCycle" id="chkCycle3" ng-model="VAS.IsAvgCT3" ng-true-value=true ng-false-value=false ng-change="FindCycleAvgMaxMin()">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span> CT3
                                </label>
                                <label class=" control-label">
                                    <input type="checkbox" value="4" name="chkCycle" id="chkCycle4" ng-model="VAS.IsAvgCT4" ng-true-value=true ng-false-value=false ng-change="FindCycleAvgMaxMin()">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span> CT4
                                </label>
                                <label class=" control-label">
                                    <input type="checkbox" value="5" name="chkCycle" id="chkCycle5" ng-model="VAS.IsAvgCT5" ng-true-value=true ng-false-value=false ng-change="FindCycleAvgMaxMin()">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span> CT5
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-6 col-lg-6">
                        <div class="form-group" style="padding-left: 15px;">
                            <div class="radio">
                                <label>
                                    <input type="radio" ng-model="VAS.AvgMaxMin" ng-value="1" name="AvgMM" ng-click="setAvgMaxMin(1)">
                                    <span class="cr"><i class="cr-icon"></i></span>AVG
                                </label>
                                <label>
                                    <input type="radio" ng-model="VAS.AvgMaxMin" ng-value="2" name="AvgMM" ng-click="setAvgMaxMin(2)">
                                    <span class="cr"><i class="cr-icon"></i></span>MAX
                                </label>
                                <label>
                                    <input type="radio" ng-model="VAS.AvgMaxMin" ng-value="3" name="AvgMM" ng-click="setAvgMaxMin(3)">
                                    <span class="cr"><i class="cr-icon"></i></span>MIN
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-12">
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group show-errors" style="margin-right: 5px;margin-top: 2px;">
                            <label class="control-label">Production System Allowance</label>
                            <div class="select-style show-message">
                                <select class="form-control" id="ddlProductionSystemId" name="Production System Allowance" ng-model="VAS.ProductionSystemId" required ng-change="GetPSAValue()">
                                    <option value="">-- Select --</option>
                                    <option ng-repeat="option in bHTList" value="{{option.Id}}">{{option.Factor}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-group" show-errors>
                            <label class="control-label">PS Value(%)<sup>*</sup></label>
                            <div class="show-message">
                                <input type="text" id="txtBHTValue" name="Production System Value" class="form-control" required ng-model="VAS.BHTValue" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Other Information</legend>
                <div class="col-sm-12 col-md-12 col-lg-12">
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <div class="form-group">
                            <label class="control-label" for="txtId">
                                VAS ID
                            </label>
                            <input type="text" id="txtId" name="txtId" class="form-control" ng-model="VAS.Id" readonly />
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-1 col-lg-1">
                        <div class="form-group" show-errors>
                            <label class="control-label" for="txtFrequancy">
                                Frequency<sup>*</sup>
                            </label>
                            <div class="show-message">
                                <input type="text" id="txtFrequency" name="Frequency" class="form-control" n-decimals="2" required ng-model="VAS.Frequency" />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-1 col-lg-1">
                        <div class="form-group" show-errors>
                            <label class="control-label" for="Quantity">
                                Quantity<sup>*</sup>
                            </label>
                            <div class="show-message">
                                <input type="text" name="Quantity" class="form-control" n-decimals="0" required ng-model="VAS.VASQuantity" />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-1 col-lg-1">
                        <div class="form-group" show-errors>
                            <label class="control-label" for="txtSPI">
                                SPI (Inch)<sup>*</sup>
                            </label>
                            <div class="show-message">
