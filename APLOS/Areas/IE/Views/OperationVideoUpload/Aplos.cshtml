<togglable name="Operation Video Upload"></togglable>
<div class="form-elements" ng-form id="OperationVideoUpload" name="operationVideoUploadForm" method='POST' enctype="multipart/form-data">
    <input type="hidden" ng-model="OperationVideoUpload.Id">
    <input type="hidden" ng-model="OperationVideoUpload.AddedBy">
    <input type="hidden" ng-model="OperationVideoUpload.AddedDate">
    <input type="hidden" ng-model="OperationVideoUpload.AddedFromIP">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="ProcessList" ng-model="OperationVideoUpload.ProcessId" ng-change="getOperationList()" tabindex="1" required>
                        <option ng-repeat="option in processList" value="{{option.value}}">{{option.name}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Operation<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select name="OperationList" ng-model="OperationVideoUpload.OperationId" tabindex="1" required>
                        <option ng-repeat="option in operationList" value="{{option.value}}">{{option.name}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Browse file</label>
            <div class="col-sm-8">
                @*<input type="file" ng-model="OperationVideoUpload.FileName" accept="video/*" id="file" name="file" />*@
                @*<input type="file" id="filec" name="filec" ng-model="vFile" ng-click="add($event)" />*@
                <input type="file" id="filec" name="file" />
                @*<button ng-click="add()">Add</button>*@
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Sequence</label>
            <div class="col-sm-8 show-message">
                <div id="data-vid" class="large-8 columns">
                    <!--video will be inserted here.-->
                </div>
                @*<h2 id="name-vid"></h2>*@
                @*<p id="size-vid"></p>*@
                @*<p id="type-vid"></p>*@
                @*<video width="400" name="vdid" id="vdid" controls ng-click="" volume="0" muted="muted">
                        <source src="{{the_url}}" type="video/mp4">

                        Your browser does not support HTML5 video.
                    </video>*@
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Sequence</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="FileName" ng-model="OperationVideoUpload.Sequence" value="1" class="form-control" tabindex="3">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox">
                    <input type="checkbox" class="css-checkbox" id="active" ng-model="OperationVideoUpload.Active" tabindex="2">
                    <label class="css-label" for="active"></label>
                </div>
            </div>
        </div>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="uploadFile();" class="btn"><i class="glyphicon glyphicon-plus"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-remove"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-trash"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="row text-right">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>File Name</th>
                <th>Sequence</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in operationVideoUploadList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-click="Get(x.Id, $index);">

                <td>{{x.Id}}</td>
                <td>{{x.FileName}}</td>
                <td>{{x.Sequence}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>