<h3 class="site-heading" id="mainContainer">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>  Addtional Element Code Settings
</h3>
<div class="form-horizontal form-elements">
    <div class="form-horizontal" ng-form id="FrmGeneralSettings" name="FrmGeneralSettings">
        <div class="form-elements">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">For Each Start (TMU)<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ej-numerictextbox e-minvalue="1" e-decimalplaces="2" e-enablertl="false" e-value="GeneralSettings.EachStartTMU" e-width="150" />
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">For Each Stop (TMU)<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ej-numerictextbox e-minvalue="1" e-decimalplaces="2" e-enablertl="false" e-value="GeneralSettings.EachStopTMU" e-width="150" />
                    </div>
                </div>

            </div>

        </div>
    </div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: AttachmentisSet(1) }"><a ng-click="AttachmentsetTab(1)" href="" data-toggle="tab">Stopping Accuracy</a></li>
            <li role="presentation" ng-class="{ active: AttachmentisSet(2) }"><a ng-click="AttachmentsetTab(2)" href="" data-toggle="tab">Handling Factor</a></li>
        </ul>
    </div>
    <div class="tab-content" id="OuterContainer">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':AttachmentisSet(1), active: AttachmentisSet(1) }">
            <div class="row">
                <div class="form-horizontal" ng-form id="FrmStoppingAccuracyModel" name="FrmStoppingAccuracyModel">
                    <div class="form-elements">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input id="StoppingAccuracyCode" type="text" class="form-control" placeholder="Enter code here" ng-model="StoppingAccuracyModel.Code" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Value(TMU)<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" ej-numerictextbox e-minvalue="0" e-decimalplaces="2" e-enablertl="false" e-value="StoppingAccuracyModel.ValueInTMU" e-width="150" />
                                </div>
                            </div>

                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" class="form-control" placeholder="Enter Description Here" ng-model="StoppingAccuracyModel.Description" required>
                                </div>
                            </div>

                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="SaveGeneralSettings();SaveStoppingAccuracy();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Update</button></li>
                                <li><button ng-click="openPopupAngular('confirmDeleteStoppingAccuracy');" class="btn"><i class="glyphicon glyphicon-trash" tabindex="9"></i> Delete</button></li>
                                <li><button ng-click="ClearStoppingAccuracy();" class="btn"><i class="glyphicon glyphicon-remove-circle" tabindex="9"></i> Cancel</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div id="GridStoppingAccuracy" ng-init="chkinit()" ej-grid e-datasource="StoppingAccuracy" e-recorddoubleclick="SelectStoppingAccuracy"
                         e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" @*e-allowrowdraganddrop="true"*@
                         e-allowresizing="true" e-allowsorting="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="100"></div>
                            <div e-column e-type="string" e-field="Description" e-headertext="Description"></div>
                            <div e-column e-type="string" e-field="ValueInTMU" e-headertext="Value(TMU)" e-width="120"></div>
                        </div>
                    </div>

                    <script type="text/template" id="deleteStoppingAccuracy">
                        <div class="common-btn">
                            <ul class="list-inline text-right small">
                                <li>
                                    <button ng-click="$parent.DeleteStoppingAccuracy(data);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                                        <i class="glyphicon glyphicon-trash"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </script>

                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':AttachmentisSet(2), active: AttachmentisSet(2) }">
            <div class="row">

                <div class="form-horizontal" ng-form id="FrmHandlingFactorModel" name="FrmHandlingFactorModel">
                    <div class="form-elements">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input id="HandlingFactorCode" type="text" class="form-control" placeholder="Enter Code Here" ng-model="HandlingFactorModel.Code" required>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Degree Of Difficulty<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="HandlingFactorModel.DegreeOfDifficulty" name="Repeat">
                                            <option value="None">None</option>
                                            <option value="Low">Low</option>
                                            <option value="Middle">Middle</option>
                                            <option value="High">High</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Additional Rate(%)<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" ej-numerictextbox e-minvalue="0" e-decimalplaces="2" e-enablertl="false" e-value="HandlingFactorModel.AdditionRate" e-width="150" />
                                </div>
                            </div>

                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" class="form-control" placeholder="Enter Description Here" ng-model="HandlingFactorModel.Description" required>
                                </div>
                            </div>

                        </div>
                        
                    </div>
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="SaveGeneralSettings();SaveHandlingFactor();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Update</button></li>
                                <li><button ng-click="openPopupAngular('confirmDeleteHandlingFactor');" class="btn"><i class="glyphicon glyphicon-trash" tabindex="9"></i> Delete</button></li>
                                <li><button ng-click="ClearHandlingFactor();" class="btn"><i class="glyphicon glyphicon-remove-circle" tabindex="9"></i> Cancel</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div id="GridHandlingFactor" ng-init="chkinit()" ej-grid e-datasource="HandlingFactor" e-recorddoubleclick="SelectHandlingFactor"
                         e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true" @*e-allowrowdraganddrop="true"*@
                         e-allowresizing="true" e-allowsorting="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>

                            <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="100"></div>
                            <div e-column e-type="string" e-field="Description" e-headertext="Description"></div>
                            <div e-column e-type="number" e-field="DegreeOfDifficulty" e-headertext="Degree Of Difficulty" e-width="100"></div>
                            <div e-column e-type="number" e-field="AdditionRate" e-headertext="Addition Rate" e-width="100"></div>
                        </div>
                    </div>

                    <script type="text/template" id="deleteHandlingFactor">
                        <div class="common-btn">
                            <ul class="list-inline text-right small">
                                <li>
                                    <button ng-click="$parent.DeleteHandlingFactor(data);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                                        <i class="glyphicon glyphicon-trash"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </script>


                </div>
            </div>
        </div>

    </div>

</div>

<confirm-archive-generic modalid="confirmDeleteStoppingAccuracy" title="Confirmation" message="Are you sure to delete stopping accuracy?" data-ng-click-right-button="DeleteStoppingAccuracy();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeleteHandlingFactor" title="Confirmation" message="Are you sure to delete handling factor?" data-ng-click-right-button="DeleteHandlingFactor();"></confirm-archive-generic>

