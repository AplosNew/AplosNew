<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script>
<togglable name="{{FormTitle}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <div class="container-fluid">
        <div class="row">
            <input type="hidden" ng-model="ModelNew.Id">
            <div class="col-xs-12 col-sm-3 col-md-3 my-2">

                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Entity<sup>*</sup></label>
                    <div class="input-group">
                        <input type="text" name="Entity" ng-model="ModelNew.Entity" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                        <span class="input-group-btn">
                            <button ng-click="selectEntity()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>

                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Detention<sup>*</sup></label>

                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.DetentionId" name="Detention"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in DetentionList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>

                </div>
            </div>

            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Date<sup>*</sup></label>
                    <div class="show-message">
                        <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="ModelNew.Date" datepicker class="form-control" required>
                    </div>
                </div>

                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">From Time<sup>*</sup></label>
                    @*<div class="show-message">
                            <input id="timepicker1" e-value="ModelNew.FromTime" width="328" ej-timepicker e-change="getMinute()" name="Time" tabindex="4" required />
                        </div>*@
                    <div class="input-group bootstrap-timepicker timepicker" style="float:right">
                        <input id="FromTime" type="text" class="form-control" ng-model="ModelNew.FromTime" ng-change="getMinute();" style="margin-left:-10%; width:94%" tabindex="7">
                        <span class="input-group-addon" style="float:left; width:12%"><i class="glyphicon glyphicon-time"></i></span>
                    </div>
                </div>


            </div>

            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Shift<sup>*</sup></label>
                    <div class="show-message">
                        <div class="input-group">
                            <input type="text" name="Entity" ng-model="ModelNew.Shift" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                            <span class="input-group-btn">
                                <button ng-click="selectShift()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">To Time<sup>*</sup></label>
                    @*<div class="show-message">
                            <input id="timepicker2" e-value="ModelNew.ToTime" width="328" ej-timepicker name="Time" e-change="getMinute()" tabindex="4" required />
                        </div>*@
                    <div class="input-group bootstrap-timepicker timepicker" style="float:right">
                        <input id="ToTime" type="text" class="form-control" ng-model="ModelNew.ToTime" ng-change="getMinute();" style="margin-left:-10%; width:94%" tabindex="7">
                        <span class="input-group-addon" style="float:left; width:12%"><i class="glyphicon glyphicon-time"></i></span>
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label">Process<sup>*</sup></label>
                    <div class="show-message">
                        <div class="input-group">
                            <input type="text" name="Process" ng-model="ModelNew.Process" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                            <span class="input-group-btn">
                                <button ng-click="selectProcess()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="workcenterGrid" ej-grid e-datasource="WorkcenterList" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-headertext="Check / UnCheck" e-template="#checkboxUnallocationTemplate" e-textalign="center" e-width="60"></div>

            <div e-column e-field="StandardName" e-headertext="Workcenter" e-width="100"></div>
            <div e-column e-headertext="Calculated Time" e-template="#calculatedTime" e-textalign="center" e-width="100"></div>
        </div>
    </div>
    <script type="text/template" id="checkboxUnallocationTemplate">
        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" ng-model="data.Active" />
    </script>
    <script type="text/template" id="calculatedTime">
        <input type="text" class="form-control" name="CalculatedTime" e-width="100" />
    </script>


    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="CalculateDetention();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Entity" e-headertext="Entity" e-width="12"></div>
            <div e-column e-field="Department" e-headertext="Department" e-width="13"></div>
            <div e-column e-field="DetentionCode" e-headertext="Detention" e-width="13"></div>
            <div e-column e-field="Detention" e-headertext="Detention" e-width="13"></div>
            <div e-column e-field="DetentionType" e-headertext="Detention Type" e-width="13"></div>
            <div e-column e-field="Date" e-headertext="Date" e-width="13"></div>
            <div e-column e-field="MachineMaster" e-headertext="Machine" e-width="15"></div>
            <div e-column e-field="Process" e-headertext="Process" e-width="15"></div>
            <div e-column e-field="WorkCenter" e-headertext="Work Center" e-width="15"></div>
            <div e-column e-field="FromTime" e-headertext="From Time" e-width="15"></div>
            <div e-column e-field="ToTime" e-headertext="To Time" e-width="15"></div>
            <div e-column e-field="Minute" e-headertext="Minute" e-width="15"></div>
            <div e-column e-field="Shift" e-headertext="Shift" e-width="15"></div>
            <div e-column e-field="Asset" e-headertext="Asset" e-width="15"></div>
            <div e-column e-field="ResponsiblePerson" e-headertext="ResponsiblePerson" e-width="15"></div>
            <div e-column e-field="Remark" e-headertext="Remark" e-width="15"></div>
        </div>
    </div>
</div>

