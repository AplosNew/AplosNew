<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script>
<togglable name="{{FormTitle}}"></togglable>

<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <div class="container-fluid">
        <div class="row">
            <input type="hidden" ng-model="ModelNew.Id">
            <div class="col-xs-12 col-sm-3 col-md-3 my-2">

                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Entity<sup>*</sup></label>
                    <div class="input-group">
                        <input type="text" name="Entity" ng-model="ModelNew.Entity" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                        <span class="input-group-btn">
                            <button ng-click="selectEntity()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>

                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Detention<sup>*</sup></label>

                    <div class="select-style">
                        <select id="DetentionId" class="form-control" ng-model="ModelNew.DetentionId" name="Detention" ng-change="SelectedDetentionInGrid();"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in DetentionList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>

                </div>

                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Remarks</label>
                    <div class="show-message">
                        <textarea type="text" name="Remark" ng-model="ModelNew.Remark" row="2" class="form-control" autocomplete="off" tabindex="4" maxlength="250"></textarea>

                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Date<sup>*</sup></label>
                    <div class="show-message">
                        <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="ModelNew.Date" ng-change="DateValidation(ModelNew.Date)" datepicker class="form-control" required>
                    </div>
                </div>
                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Responsible Person<sup>*</sup></label>
                    <div class="show-message">
                        <div class="input-group">
                            <span class="input-group-addon">{{ModelNew.ResponsiblePersonCode}}</span>
                            <input type="text" name="Responsible Person" ng-model="ModelNew.ResponsiblePerson" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button name="submit" ng-click="showEmployeeListPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>



            </div>

            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group" show-errors>
                    <label class="control-label">Process<sup>*</sup></label>
                    <div class="show-message">
                        <div class="input-group">
                            <input type="text" name="Process" ng-model="ModelNew.Process" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                            <span class="input-group-btn">
                                <button ng-click="selectProcess()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">From Time<sup>*</sup></label>
                    @*<div class="show-message">
                            <input id="timepicker1" e-value="ModelNew.FromTime" width="328" ej-timepicker e-change="getMinute()" name="Time" tabindex="4" required />
                        </div>*@
                    <div class="input-group bootstrap-timepicker timepicker">
                        <input id="FromTime" type="text" class="form-control" ng-model="ModelNew.FromTime" ng-change="getMinute();" e-width="100" tabindex="7">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-time"></i></span>
                    </div>
                </div>

            </div>

            <div class="col-xs-12 col-sm-3 col-md-3">
                <div class="form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">Shift<sup>*</sup></label>
                    <div class="show-message">
                        <div class="input-group">
                            <input type="text" name="Entity" ng-model="ModelNew.Shift" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                            <span class="input-group-btn">
                                <button ng-click="selectShift()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="mb-3 form-group" style="margin-right:4px" show-errors>
                    <label class="control-label">To Time<sup>*</sup></label>
                    @*<div class="show-message">
                            <input id="timepicker2" e-value="ModelNew.ToTime" width="328" ej-timepicker name="Time" e-change="getMinute()" tabindex="4" required />
                        </div>*@

                    <div class="input-group bootstrap-timepicker timepicker">

                        <input id="ToTime" type="text" class="form-control" ng-model="ModelNew.ToTime" ng-change="getMinute();" e-width="100" tabindex="7">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-time"></i></span>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Add Multiple Workcenter</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Update Workcenter</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div id="workcenterGrid" ej-grid e-datasource="WorkcenterList" e-templaterefresh="refreshTemplateWorkcenter" e-load="loadGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                        <div e-column e-headertemplateid="#headerTemplateWorkcenter" e-template="#checkboxUnallocationTemplate" e-textalign="center" e-width="60"></div>
                        <div e-column e-field="StandardName" e-headertext="Workcenter" e-width="100"></div>
                        <div e-column e-headertext="Detention" e-template="#Detention" e-textalign="center" e-width="100"></div>
                        <div e-column e-headertext="Responsible Person" e-template="#Responsibleperson" e-textalign="center" e-width="100"></div>
                        <div e-column e-headertext="Calculated Minute" e-template="#calculatedTime" e-textalign="center" e-width="100"></div>
                    </div>
                </div>

                <script type="text/x-jsrender" id="headerTemplateWorkcenter">
                    <input type="checkbox" id="Workcenterheadchk" />
                </script>
                <script type="text/template" id="checkboxUnallocationTemplate">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" ng-model="data.Active" />
                </script>
                <script type="text/template" id="Detention">
                    <input type="text" class="form-control" name="Detention" ng-model="data.Detention" e-width="100" />
                </script>
                <script type="text/template" id="Responsibleperson">
                    <input type="text" class="form-control" name="Responsible Person" ng-model="data.ResponsiblePerson" e-width="100" />
                </script>
                <script type="text/template" id="calculatedTime">
                    <input type="text" class="form-control" name="Minute" ng-model="data.Minute" e-width="100" />
                </script>


                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                        <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div ej-grid e-datasource="MachineMasterDateForUpdate" e-load="loadGridEdit"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                            <div e-column e-headertext="Check / UnCheck" e-template="#checkboxUpdateTemplate" e-textalign="center" e-width="60"></div>

                            <div e-column e-field="StandardName" e-headertext="Workcenter" e-width="100"></div>
                            <div e-column e-headertext="DetentionUserName" e-field="DetentionUserName" e-width="100"></div>
                            <div e-column e-headertext="Responsible Person" e-field="EmployeeName" e-width="100"></div>
                            <div e-column e-headertext="Calculated Minute" e-template="#calculatedTime" e-textalign="center" e-width="100"></div>
                        </div>
                        @*<div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button data-toggle="modal" ng-click="Delete();" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                                </ul>
                            </div>*@

                    </div>
                    <script type="text/template" id="checkboxUpdateTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" ng-model="data.Active" />
                    </script>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="UpdateOrDelete();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-recorddoubleclick="Get" e-load="loadGridEdit" e-datasource="GriddataMachineMasterData"
