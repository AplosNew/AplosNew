<div class="modal fade site-modal in" id="EntityPop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Entity List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Entity</p>
                        <div style="color:black;" id="GridEntity" ej-grid e-datasource="EntityList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleEntity">
                            <div e-columns>
                                <div e-column e-field="UserName" e-headertext="Entity Name" e-width="50"></div>
                                <div e-column e-field="EntityType" e-headertext="Entity Type" e-width="50"></div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closePopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>

@*<!-- #endregion -->*@
