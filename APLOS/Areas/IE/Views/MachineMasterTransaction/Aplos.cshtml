<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script>

<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Entity" ng-model="ModelNew.Entity" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                    <span class="input-group-btn">
                        <button ng-click="selectEntity()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Date<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Date" e-dateformat="dd-MMM-yyyy" ng-model="ModelNew.Date" datepicker class="form-control" required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Machine<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Machine" ng-model="ModelNew.MachineMaster" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                    <span class="input-group-btn">
                        <button ng-click="selectMachine()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-addon">{{ModelNew.ResponsiblePersonCode}}</span>
                    <input type="text" name="Responsible Person" ng-model="ModelNew.ResponsiblePerson" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" ng-click="showEmployeeListPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Detention<sup>*</sup></label>
            <div class="col-sm-8 show-message ">
                <div class="select-style">
                    <select class="form-control" id="Detention" name="Detention" ng-model="ModelNew.DetentionId" ng-options="item.Value as item.Text for item in DetentionList" ng-change="getAssetWorkCenterApplicable();getDetentionParaPoPUp();GetDetentionTypeById(ModelNew.DetentionId);" tabindex="6">
                        <option value="">---Select---</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">From Time<sup>*</sup></label>
            <div class="col-sm-7 input-group bootstrap-timepicker timepicker" style="float:right">
                <input id="FromTime" type="text" class="form-control input-small" ng-model="ModelNew.FromTime" ng-change="getMinute();" style="margin-left:-10%; width:94%" tabindex="7">
                <span class="input-group-addon" style="float:left; width:12%"><i class="glyphicon glyphicon-time"></i></span>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Work Center</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" id="WorkCenter"  name="Work Center" ng-model="ModelNew.WorkCenterId" ng-options="item.Id as item.UserName for item in workcenterList" ng-change="GetEntityProcessByWorkCenter(ModelNew.WorkCenterId);"
                            tabindex="6">
                        <option value="">---Select---</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Minute<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Minute" ng-model="ModelNew.Minute" class="form-control" required disabled tabindex="4" maxlength="50">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Department<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Department" ng-model="ModelNew.Department" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                    <span class="input-group-btn">
                        <button ng-click="selectDepartment()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>

            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Entity" ng-model="ModelNew.Shift" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                    <span class="input-group-btn">
                        <button ng-click="selectShift()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Process" ng-model="ModelNew.Process" ng-disabled="true" class="form-control" maxlength="200" tabindex="5" required readonly>
                    <span class="input-group-btn">
                        <button ng-click="selectProcess()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label"><span style="font-size:14px">Asset</span></label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" name="Asset" ng-model="ModelNew.Asset" class="form-control" maxlength="200" tabindex="5" readonly>
                    <span class="input-group-btn">
                        <button ng-click="selectAsset()" ng-disabled="IsAssetApplicable == false" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>

        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Detention Type<sup>*</sup></label>
            <div class="col-sm-8 show-message ">
                <div class="select-style">
                    <select class="form-control" id="DetentionType" name="DetentionType" ng-model="ModelNew.DetentionTypeId" ng-options="item.Value as item.Text for item in DetentionTypeList"
                            tabindex="6">
                        <option value="">---Select---</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">To Time<sup>*</sup></label>
            <div class="col-sm-7 input-group bootstrap-timepicker timepicker" style="float:right">
                <input id="ToTime" type="text" class="form-control input-small" ng-model="ModelNew.ToTime" ng-change="getMinute();" style="margin-left:-10%; width:94%" tabindex="7">
                <span class="input-group-addon" style="float:left; width:12%"><i class="glyphicon glyphicon-time"></i></span>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Detention Code<sup>*</sup></label>
            <div class="col-sm-8 show-message ">
                <div class="select-style">
                    <select class="form-control" id="DetentionCode" name="Detention Code" ng-model="ModelNew.DetentionCode" ng-change="GetDetentionTypeAndDetentionByCode(ModelNew.DetentionCode);" ng-options="item.Value as item.Text for item in DetentionCodeList"
                            tabindex="6">
                        <option value="">---Select---</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Remark</label>
            <div class="col-sm-8 show-message">
                <textarea type="text" name="Remark" ng-model="ModelNew.Remark" row="2" class="form-control" required autocomplete="off" tabindex="4" maxlength="250"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12">
        @*<div id="DetentionBookingParameter" ej-grid style="z-index:3;"
             e-datasource="ParameterList"
