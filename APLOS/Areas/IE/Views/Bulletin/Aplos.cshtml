<div class="modal fade site-modal in" id="operationmodal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Operation<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="operationParameters.searchBy">
                                            <option ng-repeat="option in searchbyOperationDatalist" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="operationParameters.search" ng-enter="getOperationData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getOperationData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                                <th>Operation Type</th>
                                <th>Operation Category</th>
                                <th>Operation Action</th>
                                <th>Machine Required</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in operationData  |itemsPerPage:operationParameters.pageSize" total-items="operationParameters.total_count"
                                ng-dblclick="getOperationCode(x);" pagination-id="metaData.name + 'operationData'">
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.OperationTypeCode}}</td>
                                <td>{{x.OperationCategoryName}}</td>
                                <td>{{x.OperationActionName}}</td>
                                <td>{{x.IsMachineRequired?'Yes':'No'}}</td>
                                <td>{{x.Active?'Yes':'False'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="5"
                                             pagination-id="metaData.name + 'operationData'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getOperationData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>
