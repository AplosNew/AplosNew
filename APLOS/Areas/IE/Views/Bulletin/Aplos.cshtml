<div class="modal fade site-modal in" id="summarymodal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Summary
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <div class="modal-table">
                    <table class="table">
                        <tr>
                            <td style="font-weight:bold;text-align:right;">Total Manpower: </td>
                            <td style="font-weight:bold;text-align:left;">{{TotalManpower}}</td>
                            <td style="font-weight:bold;text-align:right;">Total SAM: </td>
                            <td style="font-weight:bold;text-align:left;">{{TotalSAM}}</td>

                        </tr>
                        <tr>
                            <td style="font-weight:bold;text-align:right;">Working Hour: </td>
                            <td style="font-weight:bold;text-align:left;">{{bulletinmaster.WorkingHour}}</td>
                            <td style="font-weight:bold;text-align:right;">Target at 100% Effeciency : </td>
                            <td style="font-weight:bold;text-align:left;">{{(bulletinmaster.WorkingHour*TotalManpower*60)/TotalSAM | number:2}}</td>

                        </tr>
                        <tr>
                            <td style="font-weight:bold;text-align:right;">Total Minutes : </td>
                            <td style="font-weight:bold;text-align:left;">{{bulletinmaster.WorkingHour*TotalManpower*60| number:2}}</td>
                            <td></td>
                            <td></td>
                        </tr>

                        @*<tr>
                                <td colspan="6">* Total Minutes=WorkingHour*TotalManpower*60</td>
                            </tr>
                            <tr>
                                <td colspan="6">**Effeciency=Total Minutes/Total SAM</td>
                            </tr>*@
                    </table>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>SR</th>
                                <th>Zone</th>
                                <th>Component</th>
                                <th>Operation</th>
                                <th>SAM ({{TotalSAM}})</th>
                                <th>Alloted Manpower ({{TotalManpower}})</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in summaryDataList  | orderBy :'Sequence'">
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Zone}}</td>
                                <td>{{x.Component}}</td>
                                <td>{{x.OperationDescription}}</td>
                                <td>{{x.UserDefinedSPT}}</td>
                                <td>{{x.AllotedManpower}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
