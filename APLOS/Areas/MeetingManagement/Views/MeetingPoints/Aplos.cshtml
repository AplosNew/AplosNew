<div class="modal site-modal" id="talkingPointPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Talking Points
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-elements form-horizontal" ng-form name="talkingPointForm">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Talking Point<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <textarea type="text" rows="3" name="Talking Point" ng-model="ModelTalkingPoint.TalkingPoint" class="form-control" required autocomplete="off" maxlength="300"></textarea>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Discussion Detail<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <textarea type="text" rows="3" name="Discussion Detail" ng-model="ModelTalkingPoint.DiscussionDetail" class="form-control" required autocomplete="off" maxlength="300"></textarea>
                        </div>
                    </div>


                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">By Whom<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <span class="input-group-addon">{{ModelTalkingPoint.ByWhomCode}}</span>
                                <input type="text" name="By Whom Name" ng-model="ModelTalkingPoint.ByWhomName" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp('Talking');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
            <div class="modal-footer common-btn">
                <button ng-click="SaveTalkingPoint();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{ActionTalkingPoint}}</button>
                <button data-toggle="modal" class="btn" ng-click="ConfirmTalkingPoint();" tabindex="10"><i class="glyphicon glyphicon-trash"></i>Delete</button>
                <button ng-click="TalkingPointClear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button>
            </div>
            <div class="table-responsive">
                <div id="TalkingPointGridEdit" ng-init="TalkingPointchkinit()" ej-grid e-datasource="ModelTalkingPointList" e-recorddoubleclick="GetTalkingPoint" e-load="loadTalkingPointGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="TalkingPoint" e-headertext="Talking Point" e-width="12" e-isprimarykey="true"></div>
                        <div e-column e-field="DiscussionDetail" e-headertext="Discussion Detail" e-width="12"></div>
                        <div e-column e-field="ByWhomName" e-headertext="By Whom" e-width="13"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


