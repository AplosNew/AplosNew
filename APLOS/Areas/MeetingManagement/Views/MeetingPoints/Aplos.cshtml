<div class="modal site-modal" id="actionablePointsPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Actionable Points
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body form-elements form-horizontal" ng-form name="actionablePointsForm">
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Action To Be Taken<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <textarea type="text" name="Action To Be Taken" rows="3" ng-model="ModelActionablePoints.ActionToBeTaken" class="form-control" required maxlength="300"></textarea>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Current Status<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <textarea type="text" name="Status" rows="3" ng-model="ModelActionablePoints.CurrentStatus" class="form-control" required maxlength="300"></textarea>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Target Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Target Date" ng-model="ModelActionablePoints.TargetDate" datepicker class="form-control" required tabindex="6">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">By Whom<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <span class="input-group-addon">{{ModelActionablePoints.ByWhomCode}}</span>
                                <input type="text" name="By Whom" ng-model="ModelActionablePoints.ByWhomName" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp('Action');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Final Status<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <textarea type="text" name="Final Status" rows="3" ng-model="ModelActionablePoints.FinalStatus" class="form-control" required maxlength="300"></textarea>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea type="text" name="Remarks" rows="3" ng-model="ModelActionablePoints.Remarks" class="form-control" maxlength="300"></textarea>
                        </div>
                    </div>
                </div>
