                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);showSuggestionsRecommendationListPopUp();" href="" aria-controls="doc" role="tab" data-toggle="tab">Suggestions & Recommendation</a></li>
