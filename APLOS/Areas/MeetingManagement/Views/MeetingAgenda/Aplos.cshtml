                        <label class="col-sm-6 control-label">By Whom<sup>*</sup></label>
                        <div class="col-sm-6 show-message">
                            <div class="input-group">
                                <span class="input-group-addon">{{ModelMeetingDecision.DecisionByWhomCode}}</span>
                                <input type="text" name="By Whom" ng-model="ModelMeetingDecision.DecisionByWhomName" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp('Decision');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    </div>
                </div>
            <div class="modal-footer common-btn">
                <button ng-click="SaveMeetingDecision();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button>
                <button ng-click="DeleteMeetingDecision();" class="btn"><i class="glyphicon glyphicon-trash"></i>Delete</button>
                @*<button ng-click="closeMeetingDecisionPopUp();" class="btn"><i class=""></i> Close</button>*@
                <button ng-click="MeetingDecisionClear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button>
            </div>
            <div class="table-responsive">
                <div id="MeetingDecisionGridEdit" ng-init="MeetingDecisionchkinit()" ej-grid e-datasource="ModelMeetingDecisionList" e-recorddoubleclick="GetMeetingDecision" e-load="loadMeetingDecisionGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Decision" e-headertext="Decision" e-width="12" e-isprimarykey="true"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="12"></div>
                        <div e-column e-field="DecisionByWhomName" e-headertext="By Whom" e-width="13"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="employeePopUps" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Designation</th>
                                <th>Entity</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-dblclick="selectEmployeePopUp($index, x)" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOB | dateFiltering}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.EmploymentType}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'employeeList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>


