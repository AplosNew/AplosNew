            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-addon">{{ModelNew.MeetingOrganizedByCode}}</span>
                    <input type="text" name="Meeting Organized By" ng-model="ModelNew.MeetingOrganizedBy" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" ng-click="showEmployeeListPopUp('Main')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

        
            <div class="form-group" show-errors>
