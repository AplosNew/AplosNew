            <div e-column e-field="IssueMeetingItemTitle" e-headertext="Issue / Meeting Item Title" e-width="15"></div>
            <div e-column e-field="BackgroundIssueDetail" e-headertext="Background / Issue Detail" e-width="15"></div>
            <div e-column e-field="IssueCritically" e-headertext="Issue Critically" e-width="15"></div>
            @*<div e-column e-field="Category" e-headertext="Action Applicable" e-width="15"></div>*@
            @*<div e-column e-field="SubCategory" e-headertext="Decision Applicable" e-width="15"></div>*@
            @*<div e-column e-field="" e-headertext="Cost Applicable" e-width="12"></div>*@
            <div e-column e-field="CostEstimation" e-headertext="Cost Estimation" e-width="12"></div>
            <div e-column e-field="MeetingLegDays" e-headertext="Meeting Leg Days" e-width="12"></div>
            <div e-column e-field="IssueStatus" e-headertext="Issue Status" e-width="12"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="12"></div>
            <div e-column e-field="Attachment" e-headertext="Attachment File Name" e-width="12"></div>
        </div>
    </div>
</div>



<div class="modal fade site-modal in" id="talkingPointPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Talking Points
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-elements form-horizontal" ng-form name="talkingPointForm">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Talking Point<sup>*</sup></label>
                        <div class="col-sm-8 show-message" >
                            <textarea type="text" rows="3" name="Talking Point" ng-model="ModelTalkingPoint.TalkingPoint" class="form-control" required autocomplete="off" maxlength="300"></textarea>
