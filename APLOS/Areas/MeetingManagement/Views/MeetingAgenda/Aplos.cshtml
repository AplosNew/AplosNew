            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-addon">{{ModelNew.ChairedByCode}}</span>
                    <input type="text" name="Chaired By" ng-model="ModelNew.ChairedBy" class="form-control" required readonly>
                    <span class="input-group-btn">
