            <label class="col-sm-4 control-label">Department<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="Department" class="form-control" ng-model="ModelNew.DepartmentId" name="Department" tabindex="6"--> @*ng-change="changeSectionByDept();"*@ <!--required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in departmentList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>-->

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Meeting Orginizes By<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="Department" class="form-control" ng-model="ModelNew.MeetingTypeId" name="MeetingType" tabindex="6" @*ng-change="changeSectionByDept();*@ required>
                        <option value="">--Select--</option>
                        <option ng-repeat="option in meetingTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item Detail<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Item Detail" ng-model="ModelNew.ItemDetail" class="form-control" required autocomplete="off" tabindex="5" maxlength="50">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Background / Issue Detail<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Background / Issue Detail" ng-model="ModelNew.BackgroundIssueDetail" class="form-control" required autocomplete="off" tabindex="5" maxlength="50">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Action Applicable</label>
            <div class="col-sm-2">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.ActionApplicable" tabindex="10">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-4 control-label">Decision Applicable</label>
            <div class="col-sm-2">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.DecisionApplicable" tabindex="10">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>

        
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue Status<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="Department" class="form-control" ng-model="ModelNew.IssueStatus" name="IssueStatus<" tabindex="6" required>
                        <option value="Active">Active</option>
                        <option value="InProgress">In-Progress </option>
                        <option value="Pending">Pending </option>
                        <option value="Closed">Closed</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Attachment File Name</label>
            <div class="col-sm-8">
                <div id="UploadDefault" class="col-sm-1"  e-dialogtext-title="Product Picture" e-autoupload="true" e-begin="onBeginPBUpload" e-filesize="2097152" ej-uploadbox e-saveurl="uploadPBUrl" e-multiplefilesselection="false" e-success="getFileList" e-extensionsallow=".jpg,.bmp,.png,.jpeg" e-error="errorPBPicUpload"></div>
                <label class="col-sm-7 control-label">{{ModelNew.Attachment}}</label>
            </div>
        </div>

        <div class="form-group" show-errors>
            <div class="col-sm-4 show-message">
                <div class="input-group">
                    <span class="input-group-btn">
                        <button ng-click="showTalkingPointListPopUp();" class="btn single-small-btn" tabindex="15"><i class="glyphicon">Talking Point</i></button>
                    </span>
                </div>
            </div>
            <div class="col-sm-6 show-message">
                <div class="input-group">
                    <span class="input-group-btn">
                        <button ng-click="showSuggestionsRecommendationListPopUp();" class="btn single-small-btn" tabindex="15"><i class="glyphicon">Suggestions & Recommendation</i></button>
                    </span>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <div class="col-sm-4 show-message">
                <div class="input-group">
                    <span class="input-group-btn">
                        <button ng-click="showActionablePointsPopUp();" class="btn single-small-btn" tabindex="15"><i class="glyphicon">Actionable Points</i></button>
                    </span>
                </div>
            </div>
            <div class="col-sm-6 show-message">
                <div class="input-group">
                    <span class="input-group-btn">
                        <button ng-click="showMeetingDecisionPopUp();" class="btn single-small-btn" tabindex="15"><i class="glyphicon">Meeting Decision</i></button>
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">

        
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">By Whom<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-addon">{{ModelNew.ByWhomCode}}</span>
                    <input type="text" name="ByWhomName" ng-model="ModelNew.ByWhomName" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" ng-click="showEmployeeListPopUp('Main')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Item Title<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Item Title" ng-model="ModelNew.ItemTitle" class="form-control" required autocomplete="off" tabindex="4" maxlength="50">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue / Meeting Item Title<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Issue / Meeting Item Title" ng-model="ModelNew.IssueMeetingItemTitle" class="form-control" required autocomplete="off" tabindex="4" maxlength="50">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Issue Critically<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="Department" class="form-control" ng-model="ModelNew.IssueCritically" name="IssueCritically" tabindex="6" required>
                        <option value="">--Select--</option>
                        <option value="Critical">Critical </option>
                        <option value="Important">Important </option>
                        <option value="Normal">Normal</option>
                    </select>
                </div>
            </div>
        </div>


        <div class="form-group" show-errors>


            <label class="col-sm-4 control-label">Cost Applicable</label>
            <div class="col-sm-2">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="ModelNew.CostApplicable" tabindex="10">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-2 control-label">Cost Estimation</label>
            <div class="col-sm-4 show-message">
                <input type="text" name="Cost Estimation" ng-disabled="ModelNew.CostApplicable == false" only-numbers ng-model="ModelNew.CostEstimation" class="form-control" autocomplete="off" tabindex="2" maxlength="10">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Meeting Leg Days<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Meeting Leg Days" ng-model="ModelNew.MeetingLegDays" class="form-control" required autocomplete="off" tabindex="7" only-numbers>
            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="10"></textarea>
            </div>
        </div>



    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
