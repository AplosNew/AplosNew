<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Special Issue Control</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Define Period</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <togglable name="Special Issue Control"></togglable>
        <div class="form-elements form-horizontal">
            <div class="row" ng-form="SpecialIssueControlForm">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="issueNew.Category" name="Category" required
                                        ng-options="item.Value as item.Text for item in CategoryList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Special Issue name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="issueNew.SpecialIssueName" class="form-control" required maxlength="100" autocomplete="off">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Special Issue Details<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="issueNew.SpecialIssueDetails" class="form-control" required maxlength="100" autocomplete="off">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Sub Category<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="issueNew.SubCategory" name="Sub Category" required
                                        ng-options="item.Value as item.Text for item in SubCategoryList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Target Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" ng-model="issueNew.TargetDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label"> Remarks<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="issueNew.Remarks" class="form-control" required maxlength="100" autocomplete="off">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="Responsible Person" ng-disabled="true" ng-model="issueNew.ResponsiblePerson" class="form-control" maxlength="100" required autocomplete="off">
                            </div>
                            <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                <button ng-click="selectEmployee();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Monitoring Period<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="issueNew.MonitoringPeriod" name="Monitoring Period" required
                                        ng-options="item.Value as item.Text for item in MonitoringPeriodList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Issue Status<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="issueNew.IssueStatus" name="Issue Status" required
                                        ng-options="item.Value as item.Text for item in IssueStatusList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                        <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-12 control-label"></label>
                <label class="col-sm-12 control-label"></label>
            </div>
            <div class="clearfix"></div>
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Item Details</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" ng-form="SpecialIssueItemForm" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <input type="hidden" ng-model="ItemNew.Id">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Special Issue Item<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Special Issue Item" ng-model="ItemNew.SpecialIssueItem" class="form-control" required maxlength="100" autocomplete="off">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Action to be taken<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Action taken" ng-model="ItemNew.Actiontaken" class="form-control" required maxlength="100" autocomplete="off">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Action to be taken By<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="col-sm-10" style="padding:0px;">
                                    <input type="text" name="Action taken By" ng-disabled="true" ng-model="ItemNew.ActiontakenBy" class="form-control" maxlength="100" required autocomplete="off">
                                </div>
                                <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                    <button ng-click="selectActionTakenBy();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sample Size<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Sample Size" ng-model="ItemNew.SampleSize" class="form-control" required maxlength="100" autocomplete="off">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Remarks<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Remarks" ng-model="ItemNew.Remarks" class="form-control" required maxlength="100" autocomplete="off">
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div id="GridItem" ej-grid e-datasource="IssueItemList" e-recorddoubleclick="GetItemDetails"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Item Id" e-visible="false" e-width="3"></div>
                                <div e-column e-field="SpecialIssueItem" e-headertext="Special Issue Item" e-width="3"></div>
                                <div e-column e-field="Actiontaken" e-headertext="Action taken" e-width="3"></div>
                                <div e-column e-field="ActiontakenBy" e-headertext="Action taken By" e-width="3"></div>
                                <div e-column e-field="SampleSize" e-headertext="Sample Size" e-width="3"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="ItemSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                            <li> <button ng-click="removeRowModal($index,ItemNew.Id);" ng-disabled="ItemNew.Id===null" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete </button></li>
                            <li> <button ng-click="ItemClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="table-responsive aplos-grid-toggle">
            <div id="GridSpecialIssueControlMaster" ej-grid e-datasource="IssueControlMasterList" e-recorddoubleclick="GetDetails"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-type="String" e-field="Id" e-headertext="Id" e-visible="false" e-width="3"></div>
                    <div e-column e-type="String" e-field="Category" e-headertext="Category" e-width="3"></div>
                    <div e-column e-type="String" e-field="SubCategory" e-headertext="Sub Category" e-width="3"></div>
                    <div e-column e-type="String" e-field="SpecialIssueName" e-headertext="Special Issue Name" e-width="3"></div>
                    <div e-column e-type="String" e-field="SpecialIssueDetails" e-headertext="Special Issue Details" e-width="3"></div>
                    <div e-column e-type="String" e-field="TDate" e-headertext="Target Date" e-width="3"></div>
                    <div e-column e-type="String" e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                    <div e-column e-type="String" e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="3"></div>
                    <div e-column e-type="String" e-field="MonitoringPeriod" e-headertext="Monitoring Period" e-width="3"></div>
                    <div e-column e-type="String" e-field="IssueStatus" e-headertext="Issue Status" e-width="3"></div>
                </div>
            </div>
        </div>
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div class="row">
            <div class="row" ng-form="SpecialDefinePeirodForm">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="number" name="Sequence" ng-model="PeriodNew.Sequence" class="form-control" required tabindex="1">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Period Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Period Name" ng-model="PeriodNew.PeriodName" class="form-control" required maxlength="100" autocomplete="off">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Time<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" ej-timepicker e-value="PeriodNew.Time" e-width="100%" />
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="PeriodNew.Shift" name="Shift" required
                                        ng-options="item.Value as item.Text for item in ShiftList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div id="GridPeriod" ej-grid e-datasource="PeriodList" e-recorddoubleclick="GetPeriodDetails"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Period Id" e-visible="false" e-width="3"></div>
                            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="3"></div>
                            <div e-column e-field="PeriodName" e-headertext="Period Name" e-width="3"></div>
                            <div e-column e-field="ShiftName" e-headertext="Shift" e-width="3"></div>
                            <div e-column e-field="Times" e-headertext="Time" e-width="3"></div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="PeriodSave();" class="btn"><i class=""></i> Save</button></li>
                        <li> <button ng-click="PeriodClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="ResponsiblePopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Employee List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Employee</p>
                        <div style="color:black;" id="GridResponsiblePopUp" ej-grid e-datasource="EmployeeList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleEmployee">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="Id" e-visible="false" e-width="120"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="120"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="120"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="120"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="120"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeResponsiblePopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="ActionTakenByPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Employee List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Employee</p>
                        <div style="color:black;" id="GridActionTakenByPopUp" ej-grid e-datasource="ActionTakenByList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleActionTakenBy">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="Id" e-visible="false" e-width="120"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="120"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="120"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="120"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="120"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeActionTakenByPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmRemoveItem" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeItemRow();"></confirm-archive-generic>




