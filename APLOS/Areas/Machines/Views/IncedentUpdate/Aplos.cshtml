                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="120"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="120"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="120"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
