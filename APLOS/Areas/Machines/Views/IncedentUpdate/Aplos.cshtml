<togglable name="Incedent Update"></togglable>
<div class="form-elements form-horizontal">
    <div class="row" ng-form="IncedentCategoryUpdateForm">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-disabled="true" ng-model="incedentupdate.Date" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label"> Budget Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Budget Code" ng-disabled="true" ng-model="incedentupdate.BudgetCode" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Incedent Item Title<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Incedent Iten Title" ng-disabled="true" ng-model="incedentupdate.IncedentItemTitle" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Criticality Level<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="true" ng-model="incedentupdate.CriticalityLevel" name="Criticality Level" required
                                ng-options="item.Value as item.Text for item in CriticalityLevelList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Follow-Up Applicable</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-disabled="true" ng-model="incedentupdate.FollowUpApplicable" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Issue Incharge</label>
                <div class="col-sm-8">
                    <input type="text" name="Issue Incharge" ng-disabled="true" ng-model="incedentupdate.IssueIncharge" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Time<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" e-enabled="false" ej-timepicker e-value="incedentupdate.Time" e-width="100%" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">ROName<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="ROName" ng-disabled="true" ng-model="incedentupdate.ROName" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectROEmployee();" ng-disabled="true" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Incedent Detail<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Incedent Detail" ng-disabled="true" ng-model="incedentupdate.IncedentDetail" class="form-control" required maxlength="200" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Action Taken<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Action Taken" ng-disabled="true" ng-model="incedentupdate.ActionTaken" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label" ng-disabled="true" ng-show="incedentupdate.FollowUpApplicable==true">Follow-Up Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Follow-Up Days" ng-show="incedentupdate.FollowUpApplicable==true" ng-model="incedentupdate.FollowUpDays" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Final Status<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="true" ng-model="incedentupdate.FinalStatus" name="Final Status" required
                                ng-options="item.Value as item.Text for item in FinalStatusList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Employee Name" ng-disabled="true" ng-model="incedentupdate.EmployeeName" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectEmployee();" ng-disabled="true" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Incedent Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="true" ng-model="incedentupdate.IncedentCategoryId" name="Incedent Category" ng-change="GetIssueInchargeById(incedentupdate.IncedentCategoryId);" required
                                ng-options="item.Value as item.Text for item in IncedentCategoryList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Incedent Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="true" ng-model="incedentupdate.IncedentType" name="Incedent Type" required
                                ng-options="item.Value as item.Text for item in IncedentTypeList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Story Points<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-disabled="true" ng-model="incedentupdate.StoryPoints" name="Incedent Type" required
                                ng-options="item.Value as item.Text for item in StoryPointsList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label" ng-show="incedentupdate.FollowUpApplicable==true">Follow-Up By</label>
                <div class="col-sm-8">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Follow-Up By" ng-show="incedentupdate.FollowUpApplicable==true" ng-disabled="true" ng-model="incedentupdate.FollowUpBy" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectFollowUpBy();" ng-show="incedentupdate.FollowUpApplicable==true" ng-disabled="true" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" ng-disabled="true" rows="3" ng-model="incedentupdate.Remarks" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>
        </div>
    </div>
    <div class="row" ng-form="IncedentUpdateForm">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="incedentupdateNew.Date" datepicker class="form-control" placeholder="dd-MM-yyyy" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Update<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <textarea class="form-control" name="Update" ng-model="incedentupdateNew.Update" required maxlength="250"></textarea>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Action to be taken<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Action to be taken" ng-model="incedentupdateNew.ActionToBeTaken" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Responsible Person" ng-disabled="true" ng-model="incedentupdateNew.ResponsiblePerson" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectResponsiblePerson();"  class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="incedentupdateNew.Remarks" maxlength="250"></textarea>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div style="color:black;" id="GridIncedentUpdate" ej-grid e-datasource="IncedentUpdateList"
                 e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                 e-recorddoubleclick="GetIUDetails">
                <div e-columns>
                    <div e-column e-type="string" e-field="Id" e-visible="false" e-headertext="Id" e-width="2"></div>
                    <div e-column e-type="string" e-field="IncedentDate" e-headertext="Date" e-width="2"></div>
                    <div e-column e-type="string" e-field="Update" e-headertext="Update" e-width="2"></div>
                    <div e-column e-type="string" e-field="ActionToBeTaken" e-headertext="Action To Be Taken" e-width="3"></div>
                    <div e-column e-type="string" e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="3"></div>
                    <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button data-toggle="modal" ng-click="IncedentReport();" class="btn" tabindex="10"><i class="glyphicon glyphicon-cloud-download"></i>Download</button></li>
        </ul>
    </div>
    <div style="color:black;" id="GridIncedentCategoryUpdate" ej-grid e-datasource="IncedentCategoryUpdateList"
         e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
         e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
         e-recorddoubleclick="GetICUDetails">
        <div e-columns>
            <div e-column e-type="string" e-field="Id" e-visible="false" e-headertext="Id" e-width="2"></div>
            <div e-column e-type="string" e-field="IncedentDate" e-headertext="Date" e-width="2"></div>
            <div e-column e-type="string" e-field="IncedentTime" e-headertext="Time" e-width="2"></div>
            <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="3"></div>
            <div e-column e-type="string" e-field="ROName" e-headertext="RO Name" e-width="3"></div>
            <div e-column e-type="string" e-field="IncedentCategory" e-headertext="Incedent Category" e-width="3"></div>
            <div e-column e-type="string" e-field="IncedentType" e-headertext="Incedent Type" e-width="3"></div>
            <div e-column e-type="string" e-field="CriticalityLevel" e-headertext="Criticality Level" e-width="3"></div>
            <div e-column e-type="string" e-field="ActionTaken" e-headertext="Action Taken" e-width="2"></div>
            <div e-column e-type="string" e-field="AddedBy" e-headertext="AddedBy" e-width="1"></div>
            @* <div e-column e-template="#Attachment" e-headertext="Attachment" e-width="4"></div>*@
        </div>
        <script type="text/template" id="Attachment">
            <div class="col-md-12">
                <div class="col-md-8 text-left" style="padding:0px;">
                    <label class="col-sm-12 control-label text-left" ng-click="$parent.FileDownload(data)"><a href="{{$parent.dwonloadUrl}}" style="text-decoration:underline" download="{{data.FileName}}" target="_self">{{data.FileName}}</a></label>
                </div>
                <div class="col-md-4 text-right">
                    <div id="UploadDefault" e-id="{{data.Id}}" e-data="data.Id" e-dialogPosition-x="0" e-multiplefilesselection="false" e-width="50" e-buttontext-browse="+File" e-success="$parent.getFileList" e-showroundedcorner="false" @*e-height="30"*@ e-autoupload="true" e-begin="$parent.onBeginUpload" e-filesize="2097152" ej-uploadbox e-saveurl="$parent.uploadUrl" e-extensionsallow=".jpg,.bmp,.png,.jpeg,.pdf,.xls,.xlsx,.doc,.docx,.ppt,.pptx,.txt" e-error="$parent.errorUpload"></div>
                </div>
            </div>
        </script>
    </div>
</div>
<confirm-modal></confirm-modal>
