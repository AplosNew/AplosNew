<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Pending Skill Management
</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .modellgModify {
        width: 1600px;
    }
</style>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="form-group">
                <label class="col-sm-4 control-label">From Date</label>
                <div class="col-sm-8">
                    <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.FromDate" datepicker class="form-control">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="form-group">
                <label class="col-sm-4 control-label">To Date</label>
                <div class="col-sm-8">
                    <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.ToDate" datepicker class="form-control" ng-change="">
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsProrataMonthlyColu" ng-model="statusNew.Status" value="Pending">
                        <span class="cr"><i class="cr-icon"></i></span>Pending Schedules
                    </label>

                </div>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsProrataMonthlyColu" ng-model="statusNew.Status" value="Completed">
                        <span class="cr"><i class="cr-icon"></i></span>Completed Schedules
                    </label>
                </div>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsProrataMonthlyColu" ng-model="statusNew.Status" value="All">
                        <span class="cr"><i class="cr-icon"></i></span>All Schedules
                    </label>
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <label class="col-sm-4 control-label">Action.Person</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="statusNew.ActResponsiblePerson" name="ActResponsiblePerson" required
                                ng-options="item.Value as item.Text for item in ActionablePersonList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            </div>
            
            <div class="col-xs-12">
                <div id="filters">
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="View();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>
                    </ul>
                </div>
            </div>
