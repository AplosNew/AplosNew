<togglable name="Third Party Operation"></togglable>
<div class="form-elements" ng-form id="thirdPartyNew" name="thirdPartyNewForm">
    <input type="hidden" ng-model="thirdPartyNew.Id">
    <input type="hidden" ng-model="thirdPartyNew.AddedBy">
    <input type="hidden" ng-model="thirdPartyNew.AddedDate">
    <input type="hidden" ng-model="thirdPartyNew.AddedFromIP">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="Code" ng-model="thirdPartyNew.Code" class="form-control" required maxlength="15" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Grouping</label>
            <div class="col-sm-8  show-message">
                <input type="text" name="Grouping" ng-model="thirdPartyNew.Grouping" class="form-control" required maxlength="20" tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Description<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <textarea class="form-control" name="Description" rows="2" ng-model="thirdPartyNew.Description" maxlength="250" tabindex="5" required></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Time Measurement Unit</label>
            <div class="col-sm-8  show-message">
                <input type="number" name="Time Measurement Unit" ng-model="thirdPartyNew.TMU" class="form-control" required placeholder="0" tabindex="2">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Is Machine</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="thirdPartyNew.IsMachine" tabindex="4">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="thirdPartyNew.Active" tabindex="6">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="7"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="8"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Description</th>
                <th>Time Measurement Unit</th>
                <th>Grouping</th>
                <th>Machine</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in thirdParties  |itemsPerPage:$root.pageSize| orderBy:'Code'" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Code}}</td>
                <td>{{x.Description}}</td>
                <td>{{x.TMU}}</td>
                <td>{{x.Grouping}}</td>
                <td>{{x.IsMachine?'Yes':'No'}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
