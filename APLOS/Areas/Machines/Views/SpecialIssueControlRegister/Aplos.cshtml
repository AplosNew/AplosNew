<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Special Issue Control Report</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="col-md-4">
                <label class="col-sm-4 control-label">Select Shift<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="SpecialIssueRegisters.Shift" name="Shift" required
                                ng-options="item.Value as item.Text for item in ShiftList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="LoadSpecialIssueMasterList();" class="btn"><i class="glyphicon glyphicon-search"></i> Load Issue Details </button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div id="GridSpecialIssueControlMaster" ej-grid e-datasource="IssueControlMasterList" e-recorddoubleclick="GetDetails"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-type="String" e-field="Id" e-headertext="Id" e-visible="false" e-width="3"></div>
                    <div e-column e-type="String" e-field="Category" e-headertext="Category" e-width="3"></div>
                    <div e-column e-type="String" e-field="SubCategory" e-headertext="Sub Category" e-width="3"></div>
                    <div e-column e-type="String" e-field="SpecialIssueName" e-headertext="Special Issue Name" e-width="3"></div>
                    <div e-column e-type="String" e-field="SpecialIssueDetails" e-headertext="Special Issue Details" e-width="3"></div>
                    <div e-column e-type="String" e-field="TDate" e-headertext="Target Date" e-width="3"></div>
                    <div e-column e-type="String" e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                    <div e-column e-type="String" e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="3"></div>
                    <div e-column e-type="String" e-field="MonitoringPeriods" e-headertext="Monitoring Period" e-width="3"></div>
                    <div e-column e-type="String" e-field="IssueStatus" e-headertext="Issue Status" e-width="3"></div>
                    <div e-column e-headertext="Print" e-width="2" e-template="#reportButton"></div>
                </div>
            </div>
            <script type="text/template" id="reportButton">
                <a class="btn" style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" href="Machines/SpecialIssueControlRegister/GetIssueControlJobCardReportView?Shift={{$parent.SpecialIssueRegisters.Shift}}&IssueId={{data.Id}}" target="_blank"><i class="glyphicon glyphicon-print" style="margin: -6px;"></i></a>
            </script>
        </div>
    </div>
</div>

