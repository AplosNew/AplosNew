<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);" href="" data-toggle="tab">Tool Master</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);GetToolMasterCbo();" href="" data-toggle="tab">Tool Item Master</a></li>
        @*<li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="OpenTIMTab();" href="" data-toggle="tab">Tool Item Master</a></li>*@
        <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);" href="" data-toggle="tab">Hand Tool Issue</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        @Html.Partial("~/Areas/Machines/Views/MachineandEquipmentHelpDesk/ToolMaster.cshtml")
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        @Html.Partial("~/Areas/Machines/Views/MachineandEquipmentHelpDesk/ToolItemMaster.cshtml")
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
        @Html.Partial("~/Areas/Machines/Views/MachineandEquipmentHelpDesk/HandToolIssue.cshtml")
    </div>
</div>



