<togglable name="Hand Tool Issue"></togglable>
<div class="form-elements" ng-form id="ToolMasterItemNew" name="HandToolIssueNewForm">
    <input type="hidden" ng-model="ToolMasterItemNew.Id">
    <input type="hidden" ng-model="ToolMasterItemNew.AddedBy">
    <input type="hidden" ng-model="ToolMasterItemNew.AddedDate">
    <input type="hidden" ng-model="ToolMasterItemNew.AddedFromIP">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Tool Item<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="HandToolIssueNew.ToolItemMasterId" name="Tool Item"
                            ng-options="item.Id as item.ToolMaster for item in TIMModelList" required tabindex="6">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">By Issue<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" name="To Whom" ng-model="HandToolIssueNew.ByIssue" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getEmpPopUpData('By');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Date Time<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" datepicker name="Date Time" ng-model="HandToolIssueNew.DateandTime" class="form-control" required tabindex="117">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">To Issue<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="input-group">
                    <input type="text" name="To Issue" ng-model="HandToolIssueNew.ToIssue" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getEmpPopUpData('To');" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="SaveHTI();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{HTIAction}}</button></li>
            <li> <button ng-click="removeHTI();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="ClearHTI();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="HTIModelList" e-recorddoubleclick="GetHTI" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="DateandTime" e-headertext="DateTime" e-width="5"></div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Employee Information<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="selectEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="EmpSystemId" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                    <div class="common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="closePopUp();" class="btn">Close</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<confirm-archive-generic modalid="confirmRunHTIDelPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteHTI();"></confirm-archive-generic>