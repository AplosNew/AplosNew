                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateMachineAsset" e-template="#checkboxTemplateMachineAsset" e-textalign="center" e-width="50"></div>
                                <div e-column e-type="string" e-field="Id" e-visible="false" e-headertext="Id" e-width="100"></div>
                                <div e-column e-type="string" e-field="AssetId" e-headertext="Asset Id" e-width="100"></div>
                                <div e-column e-type="string" e-field="MaintenanceSchedulingId" e-visible="false" e-headertext="Maintenance Scheduling Id" e-width="100"></div>
                                <div e-column e-type="string" e-field="AssetName" e-headertext="Asset Name" e-width="100"></div>
                                <div e-column e-type="string" e-field="AssetCode" e-headertext="Asset Code" e-width="100"></div>
                                <div e-column e-type="string" e-field="AssetReference" e-headertext="Asset Reference" e-width="100"></div>
                                <div e-column e-type="string" e-field="WorkCenter" e-headertext="Work Center" e-width="100"></div>
                                <div e-column e-type="string" e-field="ScheduleDays" e-headertext="Schedule Days" e-width="100"></div>
                                <div e-column e-type="string" e-field="LastMaintenanceDate" e-headertext="Last Maintenance Date" e-width="100"></div>
                                <div e-column e-type="string" e-field="CurrentMaintanceDate" e-headertext="Current Maintance Date" e-width="100"></div>
                                <div e-column e-type="string" e-field="DueDays" e-headertext="Due Days" e-width="100"></div>
                                <div e-column e-type="string" e-field="OverDue" e-headertext="Over Due" e-width="100"></div>
                                <div e-column e-type="string" e-field="DueToday" e-headertext="Due Today" e-width="100"></div>
                                <div e-column e-type="string" e-field="FutureDue" e-headertext="Future Due" e-width="100"></div>
                                <div e-column e-type="string" e-field="StandardScheduleMinutes" e-headertext="Standard Schedule Minutes" e-width="100"></div>
                                <div e-column e-template="#PlannedDate" e-headertext="Planned Date" e-width="150"></div>
                                <div e-column e-template="#Remark" e-headertext="Remarks" e-width="150"></div>
                                @*<div e-column e-type="string" e-field="Status" e-headertext="Status" e-width="100"></div>*@
                                <div e-column e-template="#ActualData" e-headertext="Actionable Person" e-width="100"></div>
                                <div e-column e-template="#JobCart" e-headertext="Print" e-width="100"></div>
                            </div>
                            <script type="text/template" id="checkboxTemplateMachineAsset">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                            </script>
                            <script type="text/x-jsrender" id="headerTemplateMachineAsset">
                                <input type="checkbox" id="headchk" />
                            </script>
                            <script type="text/template" id="PlannedDate">
                                <div class="col-sm-12" style="padding:0px;">
                                    <input type="text" id="PlannedDate" ng-disabled="data.Id!==''" ng-model="data.PlannedDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9">
                                </div>
                            </script>
                            <script type="text/template" id="Remark">
                                <div class="col-sm-12" style="padding:0px;">
                                    <input type="text" name="Remark" ng-model="data.Remarks" ng-click="" class="form-control">
                                </div>
                            </script>
                            <script type="text/template" id="ActualData">
                                <div class="form-group">
                                    <div class="col-sm-5 text-left" style="padding:0px;padding-left:2px">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li>
                                                    <button id="DetailsResponsible"  ng-click="$parent.SavePlannedDetails();$parent.GetReponsiblePersonPopUp(this);" class="btn"><i class="glyphicon glyphicon-list"></i></button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </script>
                            <script type="text/template" id="JobCart">
                                <div class="form-group">
                                    <div class="col-sm-5 text-left" style="padding:0px;padding-left:2px">
                                        <div class="common-btn">
                                            <a class="btn" ng-disabled="data.Id===''" style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" href="Machines/MaintenanceStatusDetails/GetMaintenanceJobCardPlanReportView?PlannedId={{data.Id}}" target="_blank"><i class="glyphicon glyphicon-print" style="margin: -6px;"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </script>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-center">
                        <li>
                            <button ng-click="closeMachinePopUp();" class="btn"><i class=""></i> Close</button>
                            @*<button ng-click="SavePlannedDetails();" class="btn"><i class=""></i> Save</button>*@
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
