<h3 class="site-heading">
        <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Maintenance Status
    </h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }
</style>
<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Maintenance Status (Summary)</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Maintenance Status (Details)</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" ng-form="MaintenanceStatusSummaryForm" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="statusNew.ToDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <button ng-click="ViewSummary();" class="btn"> View </button>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="maindiv" class="table-responsive modal-table">
                    <div id="GridMaintenanceStatusSummary" ej-grid e-datasource="MaintenanceStatusSummaryList" e-recorddoubleclick="GetDetails"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-type="string" e-field="Id" e-headertext="Id" e-visible="false" e-width="3"></div>
                            <div e-column e-type="string" e-field="Entity" e-headertext="Entity" e-width="3"></div>
                            <div e-column e-type="string" e-field="ScheduleName" e-headertext="Schedule Name" e-width="3"></div>
                            <div e-column e-type="string" e-field="MachineName" e-headertext="Machine Name" e-width="3"></div>
                            <div e-column e-type="string" e-field="Make" e-headertext="Make" e-width="3"></div>
                            <div e-column e-type="string" e-field="Model" e-headertext="Model" e-width="3"></div>
                            <div e-column e-type="string" e-field="ScheduleCode" e-headertext="Schedule Code" e-width="3"></div>
                            <div e-column e-type="string" e-field="ResponsiblePersonBudgetCode" e-headertext="Responsible Person Bgt Code" e-width="3"></div>
                            <div e-column e-type="string" e-field="NoOfAsset" e-headertext="No Of Asset" e-width="3"></div>
                            <div e-column e-type="string" e-field="OverDue" e-headertext="Over Due" e-width="3"></div>
                            <div e-column e-type="string" e-field="DueToday" e-headertext="Due Today" e-width="3"></div>
                            <div e-column e-type="string" e-field="FutureDue" e-headertext="Future Due" e-width="3"></div>
                            <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div role="tabpanel" ng-form="MaintenanceStatusDetailsForm" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="statusNew.ToDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <button ng-click="View();" class="btn"> View </button>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="maindiv" class="table-responsive modal-table">
                    <div id="GridMaintenanceStatusDetails" ej-grid e-datasource="MaintenanceStatusDetailsList" e-recorddoubleclick="GetDetails"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-type="string" e-field="Id" e-headertext="Id" e-visible="false" e-width="3"></div>
                            <div e-column e-type="string" e-field="Entity" e-headertext="Entity" e-width="3"></div>
                            <div e-column e-type="string" e-field="ScheduleName" e-headertext="Schedule Name" e-width="3"></div>
                            <div e-column e-type="string" e-field="MachineName" e-headertext="Machine Name" e-width="3"></div>
                            <div e-column e-type="string" e-field="Make" e-headertext="Make" e-width="3"></div>
                            <div e-column e-type="string" e-field="Model" e-headertext="Model" e-width="3"></div>
                            <div e-column e-type="string" e-field="ScheduleCode" e-headertext="Schedule Code" e-width="3"></div>
                            <div e-column e-type="string" e-field="ResponsiblePersonBudgetCode" e-headertext="Responsible Person Bgt Code" e-width="3"></div>
                            <div e-column e-type="string" e-field="AssetName" e-headertext="Asset Name" e-width="3"></div>
                            <div e-column e-type="string" e-field="AssetCode" e-headertext="Asset Code" e-width="3"></div>
                            <div e-column e-type="string" e-field="WorkCenter" e-headertext="Work Center" e-width="3"></div>
                            <div e-column e-type="string" e-field="ScheduleDays" e-headertext="Schedule Days" e-width="3"></div>
                            <div e-column e-type="string" e-field="LastMaintenanceDate" e-headertext="Last Maintenance Date" e-width="3"></div>
                            <div e-column e-type="string" e-field="CurrentMaintanceDate" e-headertext="Current Maintance Date" e-width="3"></div>
                            <div e-column e-type="string" e-field="DueDays" e-headertext="Due Days" e-width="3"></div>
                            <div e-column e-type="string" e-field="OverDue" e-headertext="Over Due" e-width="3"></div>
                            <div e-column e-type="string" e-field="DueToday" e-headertext="Due Today" e-width="3"></div>
                            <div e-column e-type="string" e-field="FutureDue" e-headertext="Future Due" e-width="3"></div>
                            <div e-column e-type="string" e-field="StandardScheduleMinutes" e-headertext="Standard Schedule Minutes" e-width="3"></div>
                            <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

