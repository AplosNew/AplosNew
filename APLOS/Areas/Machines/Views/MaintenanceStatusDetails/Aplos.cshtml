
<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Maintenance Status
</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .modellgModify {
        width: 2000px;
    }
</style>
<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }">
            <a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Maintenance Status (Summary)</a>
        </li>
        <li role="presentation" ng-class="{ active: isSet(2) }">
            <a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Maintenance Status (Details)</a>
        </li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" ng-form="MaintenanceStatusSummaryForm" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <div class="row">
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date</label>
                    <div class="col-sm-8">
                        <input type="text" name="Form Date" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.FromDate" datepicker class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date</label>
                    <div class="col-sm-8">
                        <input type="text" name="To Date" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.ToDate" datepicker class="form-control" ng-change="">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-2 col-md-2">
                <div class="common-btn">
                    <button ng-click="ViewSummary();" class="btn"> View </button>
                </div>
            </div>
            <div class="col-xs-12 col-sm-2 col-md-2">
                <div class="common-btn" ng-show="MaintenanceStatusSummaryList.length>0">
                    <ul class="list-inline text-left">
                        <li>
                            <button ng-click="MaintenanceStatusSummaryReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12">
                @*<div id="maindiv" class="table-responsive modal-table">*@
                <div id="GridMaintenanceStatusSummary" ej-grid e-datasource="MaintenanceStatusSummaryList" e-recorddoubleclick=""
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true" e-rowdatabound="rowDataBound"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Id" e-headertext="Id" e-visible="false" e-width="100"></div>
                        <div e-column e-type="string" e-field="Entity" e-headertext="Entity" e-width="100"></div>
                        <div e-column e-type="string" e-field="ScheduleName" e-headertext="Schedule Name" e-width="100"></div>
                        <div e-column e-type="string" e-field="MachineName" e-headertext="Machine Name" e-width="150"></div>
                        <div e-column e-type="string" e-field="Make" e-headertext="Make" e-width="100"></div>
                        <div e-column e-type="string" e-field="Model" e-headertext="Model" e-width="100"></div>
                        <div e-column e-type="string" e-field="ScheduleCode" e-headertext="Schedule Code" e-width="100"></div>
                        <div e-column e-type="string" e-field="ResponsiblePersonBudgetCode" e-headertext="Responsible Person Bgt Code" e-width="100"></div>
                        <div e-column e-type="Number" e-template="#NoOfAssetCounts" e-headertext="No Of Asset" e-width="100"></div>
                        <div e-column e-type="Number" e-template="#OverDueCounts" e-headertext="Over Due" e-width="100"></div>
                        <div e-column e-type="Number" e-template="#DueTodayCounts" e-headertext="Due Today" e-width="100"></div>
                        <div e-column e-type="Number" e-template="#FutureDueCounts" e-headertext="Future Due" e-width="100"></div>
                        <div e-column e-type="Number" e-field="PlanStatus" e-headertext="Plan Pending" e-visible="false" e-width="100"></div>
                        <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                        <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="100"></div>
                        <div e-column e-type="number" e-field="MaintenanceGroup" e-headertext="Maintenance Group" e-width="100"></div>
                    </div>
                    <script type="text/template" id="NoOfAssetCounts">
                        <div class="text-left" style="width:100%">
                            <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.GetAssetPopUp(this,data.NoOfAsset);">{{data.NoOfAsset}}</a>
                        </div>
                    </script>
                    <script type="text/template" id="OverDueCounts">
                        <div class="text-left" style="width:100%">
                            <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.GetAssetPopUp(this,data.OverDue);">{{data.OverDue}}</a>
                        </div>
                    </script>
                    <script type="text/template" id="DueTodayCounts">
                        <div class="text-left" style="width:100%">
                            <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.GetAssetPopUp(this,data.DueToday);">{{data.DueToday}}</a>
                        </div>
                    </script>
                    <script type="text/template" id="FutureDueCounts">
                        <div class="text-left" style="width:100%">
                            <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.GetAssetPopUp(this,data.FutureDue);">{{data.FutureDue}}</a>
                        </div>
                    </script>
                </div>
                @*</div>*@
            </div>
        </div>
    </div>

    <div role="tabpanel" ng-form="MaintenanceStatusDetailsForm" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div class="row">
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date</label>
                    <div class="col-sm-8">
                        <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.FromDateMD" datepicker class="form-control">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date</label>
                    <div class="col-sm-8">
                        <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.ToDateMD" datepicker class="form-control" ng-change="">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-2 col-md-2">
                <div class="common-btn">
                    <button ng-click="View();" class="btn"> View </button>
                </div>
            </div>
            <div class="col-xs-12 col-sm-2 col-md-2">
                <div class="common-btn" ng-show="MaintenanceStatusDetailsList.length>0">
                    <ul class="list-inline text-left">
                        <li>
                            <button ng-click="MaintenanceStatusDetailsReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12">
                @*<div id="maindiv" class="table-responsive modal-table">*@
                <div id="GridMaintenanceStatusDetails" ej-grid e-datasource="MaintenanceStatusDetailsList" e-recorddoubleclick="GetDetails"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true" e-rowdatabound="rowDataBoundDetails"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Id" e-headertext="Id" e-visible="false" e-width="100"></div>
                        <div e-column e-type="string" e-field="Entity" e-headertext="Entity" e-width="100"></div>
                        <div e-column e-type="string" e-field="ScheduleName" e-headertext="Schedule Name" e-width="100"></div>
                        <div e-column e-type="string" e-field="AdvancePlanningDays" e-headertext="Planning Days" e-width="100"></div>
                        <div e-column e-type="string" e-field="MachineName" e-headertext="Machine Name" e-width="150"></div>
                        <div e-column e-type="string" e-field="Make" e-headertext="Make" e-width="100"></div>
                        <div e-column e-type="string" e-field="Model" e-headertext="Model" e-width="100"></div>
                        <div e-column e-type="string" e-field="ScheduleCode" e-headertext="Schedule Code" e-width="100"></div>
                        <div e-column e-type="string" e-field="ResponsiblePersonBudgetCode" e-headertext="Responsible Person Bgt Code" e-width="100"></div>
                        <div e-column e-type="string" e-field="AssetName" e-headertext="Asset Name" e-width="100"></div>
                        <div e-column e-type="string" e-field="AssetCode" e-headertext="Asset Code" e-width="100"></div>
                        <div e-column e-type="string" e-field="AssetReference" e-headertext="Asset Reference" e-width="100"></div>
                        <div e-column e-type="string" e-field="WorkCenter" e-headertext="Work Center" e-width="100"></div>
                        <div e-column e-type="string" e-field="ScheduleDays" e-headertext="Schedule Days" e-width="100"></div>
                        <div e-column e-type="Date" e-field="PlannedDate" e-headertext="Planned Date" e-width="100"></div>
                        <div e-column e-type="Date" e-field="LastMaintenanceDate" e-headertext="Last Maintenance Date" e-width="100"></div>
                        <div e-column e-type="Date" e-field="CurrentMaintanceDate" e-headertext="Current Maintance Date" e-width="100"></div>
                        <div e-column e-type="string" e-field="DueDays" e-headertext="Due Days" e-width="100"></div>
                        <div e-column e-type="string" e-field="OverDue" e-headertext="Over Due" e-width="100"></div>
                        <div e-column e-type="string" e-field="DueToday" e-headertext="Due Today" e-width="100"></div>
                        <div e-column e-type="string" e-field="FutureDue" e-headertext="Future Due" e-width="100"></div>
                        <div e-column e-type="string" e-field="StandardScheduleMinutes" e-headertext="Standard Schedule Minutes" e-width="100"></div>
                        <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                        <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="100"></div>
                        <div e-column e-type="number" e-field="MaintenanceGroup" e-headertext="Maintenance Group" e-width="100"></div>
                    </div>
                </div>
                @*</div>*@
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="MachineAssetPop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">
                Machine Asset Details
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
