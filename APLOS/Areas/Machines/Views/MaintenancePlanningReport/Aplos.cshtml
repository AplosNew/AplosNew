<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Maintenance Planning Report
</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .modellgModify {
        width: 2000px;
    }
</style>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="form-group">
                <label class="col-sm-4 control-label">From Date</label>
                <div class="col-sm-8">
                    <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.FromDateMD" datepicker class="form-control">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="form-group">
                <label class="col-sm-4 control-label">To Date</label>
                <div class="col-sm-8">
                    <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.ToDateMD" datepicker class="form-control" ng-change="">
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsProrataMonthlyColu" ng-model="statusNew.Status" value="Pending">
                        <span class="cr"><i class="cr-icon"></i></span>Pending Schedules
                    </label>

                </div>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsProrataMonthlyColu" ng-model="statusNew.Status" value="Completed">
                        <span class="cr"><i class="cr-icon"></i></span>Completed Schedules
                    </label>
                </div>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsProrataMonthlyColu" ng-model="statusNew.Status" value="All">
                        <span class="cr"><i class="cr-icon"></i></span>All Schedules
                    </label>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="common-btn">
                <button ng-click="View();" class="btn"> View </button>
            </div> 
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="common-btn" ng-show="MaintenancePlanningReportList.length>0">
                <ul class="list-inline text-right">
                    <li><button ng-click="MaintenancePlanningReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                </ul>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div id="maindiv" class="table-responsive modal-table">
                <div id="GridMaintenancePlanningReport" ej-grid e-datasource="MaintenancePlanningReportList" e-recorddoubleclick="GetDetails"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true" e-rowdatabound="rowDataBoundDetails"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Entity" e-headertext="Entity" e-width="100"></div>
                        <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="100"></div>
                        <div e-column e-type="string" e-field="Process" e-headertext="Process" e-width="100"></div>
                        <div e-column e-type="string" e-field="WorkCenter" e-headertext="Work Center" e-width="100"></div>
                        <div e-column e-type="string" e-field="WCCode" e-headertext="Work Center Code" e-width="100"></div>
                        <div e-column e-type="string" e-field="AssetName" e-headertext="Asset Name" e-width="150"></div>
                        <div e-column e-type="string" e-field="AssetCode" e-headertext="Asset Code" e-width="100"></div>
                        <div e-column e-type="string" e-field="Make" e-headertext="Make" e-width="100"></div>
                        <div e-column e-type="string" e-field="Model" e-headertext="Model" e-width="100"></div>
                        <div e-column e-type="string" e-field="ScheduleName" e-headertext="Schedule Name" e-width="100"></div>
                        <div e-column e-type="string" e-field="ScheduleCode" e-headertext="Schedule Code" e-width="100"></div>
                        <div e-column e-type="string" e-field="ActualDate" e-headertext="Last Maintenance Date" e-width="100"></div>
                        <div e-column e-type="string" e-field="CMD" e-headertext="Current Maintenance Date" e-width="100"></div>
                        <div e-column e-type="string" e-field="PlannedDate" e-headertext="Planned Date" e-width="100"></div>
                        <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


