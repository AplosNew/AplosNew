<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> Entity Operation Settings</h3>
<div class="form-elements form-horizontal" ng-form="modelNewForm">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Entity<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select class="form-control" name="Entity" ng-model="modelNew.EntityId" ng-options="item.Value as item.Text for item in entityList" ng-change="getData();" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li> <button ng-click="popUp();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Operation</button></li>
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Remove</th>
                    <th>OperationName</th>
                    <th>Process</th>
                    <th>Operation Type</th>
                    <th>Operation Category</th>
                    <th>Operation Activity</th>
                    <th>Machine Or Not</th>
                    <th>Employee Number</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in modelList">
                    <td class="text-right table-td">
                        <ul class="list-inline action-list">
                            <li><button ng-click="removeRowModal(x, $index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                        </ul>
                    </td>
                    <td>{{x.OperationName}}</td>
                    <td>{{x.Process}}</td>
                    <td>{{x.OperationTypeCode}}</td>
                    <td>{{x.OperationCategoryName}}</td>
                    <td>{{x.OperationActivityName}}</td>
                    <td>{{x.IsMachineRequired?'Yes':'No'}}</td>
                    <td><input type="text" only-numbers ng-model="x.NoOfEmployee" class="form-control text-right"></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- #region Operation -->
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Operation<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Operation</th>
                                <th>Process</th>
                                <th>Operation Type</th>
                                <th>Operation Category</th>
                                <th>Operation Activity</th>
                                <th>Machine Or Not</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" pagination-id="metaData.name + 'popUpDataList'" total-items="popUpParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="pushInTempList(x, $event, modelList);">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.Process}}</td>
                                <td>{{x.OperationTypeCode}}</td>
                                <td>{{x.OperationCategoryName}}</td>
                                <td>{{x.OperationActivityName}}</td>
                                <td>{{x.IsMachineRequired?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'popUpDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getPopUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="selectByButton()" class="btn">Done</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>

