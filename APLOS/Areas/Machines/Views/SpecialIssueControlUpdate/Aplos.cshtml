                                <div e-column e-type="string" e-field="SICItemId" e-visible="false" e-headertext="Item Id" e-width="2"></div>
                                <div e-column e-type="string" e-field="ICUId" e-visible="false" e-headertext="Issue Update Id" e-width="2"></div>
                                <div e-column e-type="string" e-field="SpecialIssueItem" e-headertext="Item Name" e-width="3"></div>
                                <div e-column e-type="string" e-field="Actiontaken" e-headertext="Action taken" e-width="3"></div>
                                <div e-column e-type="string" e-field="ActiontakenBy" e-headertext="Action taken By" e-width="3"></div>
                                <div e-column e-type="string" e-field="SampleSize" e-headertext="Sample Size" e-width="2"></div>
                                <div e-column e-type="string" e-template="#Value" e-headertext="Value" e-width="2"></div>
                                <div e-column e-type="string" e-template="#Remark" e-headertext="Remarks" e-width="2"></div>
                            </div>
                            <script type="text/template" id="checkboxTemplateIssueItem">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                            </script>
                            <script type="text/x-jsrender" id="headerTemplateIssueItem">
                                <input type="checkbox" id="headchk" />
                            </script>
                            <script type="text/template" id="Value">
