                            <button ng-click="closeIssuePopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="IssueItemPopup" role="dialog" data-backdrop="static">
