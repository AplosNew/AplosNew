<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span>Special Issue Control Update</h3>
<div class="form-elements form-horizontal">
    <div class="row" ng-form="SpecialIssueControlUpdateForm">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ng-model="issueupdateNew.Date" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="9" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="issueupdateNew.Shift" name="Shift" required
                                ng-options="item.Value as item.Text for item in ShiftList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Shift Incharge<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="ShiftIncharge" ng-disabled="true" ng-model="issueupdateNew.ShiftInCharge" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectEmployee();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Time<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" ej-timepicker e-value="issueupdateNew.Time" e-width="100%" />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Issue<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Issue" ng-disabled="true" ng-model="issueupdateNew.Issue" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectIssue();" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Remarks<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Remarks" ng-model="issueupdateNew.Remarks" class="form-control" required maxlength="100" autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <div class="common-btn">
                            <button ng-click="GetIssueItemPopup();" class="btn"> View </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*<div class="col-xs-12 col-sm-12 col-md-12">
                <div id="GridIssueControlUpdate" ej-grid e-datasource="IssueControlUpdateList" e-recorddoubleclick="GetICUDetails"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="3"></div>
                        <div e-column e-field="IssueUpdateDate" e-headertext="Date" e-width="3"></div>
                        <div e-column e-field="ShiftName" e-headertext="Shift" e-width="3"></div>
                        <div e-column e-field="ShiftInCharge" e-headertext="Shift In Charge" e-width="3"></div>
                        <div e-column e-field="Issue" e-headertext="Issue" e-width="3"></div>
                        <div e-column e-field="IssueTime" e-headertext="Time" e-width="3"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                        <div e-column e-template="#ItemGrid" e-headertext="Item Grid" e-width="3"></div>
                    </div>
                </div>
                <script type="text/template" id="ItemGrid">
                    <div class="form-group">
                        <div class="col-sm-5 text-left" style="padding:0px;padding-left:2px">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="$parent.GetIssueItemPopup(this);" class="btn"><i class="glyphicon glyphicon-list"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </script>
            </div>*@
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div style="color:black;" id="GridUpdateIssueItem" ej-grid e-datasource="IssueItemDetailsList"
                 e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                 e-recorddoubleclick="" e-templaterefresh="refreshTemplateIssueItem">
                <div e-columns>
                    @* <div e-column e-headertext="All" e-headertemplateid="#headerTemplateIssueItem" e-template="#checkboxTemplateIssueItem" e-textalign="center" e-width="1"></div>*@
                    <div e-column e-type="string" e-field="Id" e-visible="false" e-headertext="Id" e-width="2"></div>
                    <div e-column e-type="string" e-field="SICItemId" e-visible="false" e-headertext="Item Id" e-width="2"></div>
                    <div e-column e-type="string" e-field="ICUId" e-visible="false" e-headertext="Issue Update Id" e-width="2"></div>
                    <div e-column e-type="string" e-field="SpecialIssueItem" e-headertext="Item Name" e-width="3"></div>
                    <div e-column e-type="string" e-field="Actiontaken" e-headertext="Action taken" e-width="3"></div>
                    <div e-column e-type="string" e-field="ActiontakenBy" e-headertext="Action taken By" e-width="3"></div>
                    <div e-column e-type="string" e-field="SampleSize" e-headertext="Sample Size" e-width="2"></div>
                    <div e-column e-type="string" e-template="#Value" e-headertext="Value" e-width="2"></div>
                    <div e-column e-type="string" e-template="#Remark" e-headertext="Remarks" e-width="2"></div>
                    <div e-column e-type="string" e-template="#ConfidenceLevel" e-headertext="Confidence Level" e-width="2"></div>
                </div>
                <script type="text/template" id="checkboxTemplateIssueItem">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplateIssueItem">
                    <input type="checkbox" id="headchk" />
                </script>
                <script type="text/template" id="Value">
                    <div class="col-sm-12" style="padding:0px;">
                        <input type="text" name="Value" ng-model="data.Value" ng-click="" class="form-control">
                    </div>
                </script>
                <script type="text/template" id="Remark">
                    <div class="col-sm-12" style="padding:0px;">
                        <input type="text" name="Remark" ng-model="data.Remarks" ng-click="" class="form-control">
                    </div>
                </script>
                <script type="text/template" id="ConfidenceLevel">
                    <div class="select-style">
                        <select class="form-control" ng-model="data.ConfidenceLevel" name="ConfidenceLevel" 
                                ng-options="item.Value as item.Text for item in $parent.ConfidenceLevelList">
                            @*<option value="">Select</option>*@
                        </select>
                    </div>
                </script>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                @*<li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Delete</button></li>*@
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="ShifInChargePopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Employee List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Employee</p>
                        <div style="color:black;" id="GridShifInChargePopUp" ej-grid e-datasource="EmployeeList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleEmployee">
                            <div e-columns>
                                <div e-column e-field="SystemId" e-headertext="Id" e-visible="false" e-width="120"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="120"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="120"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="120"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="120"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeShifInChargePopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="IssuePopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Issue List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Double click to Select an Issue</p>
                        <div style="color:black;" id="GridIssuePopUp" ej-grid e-datasource="IssueList"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                             e-recorddoubleclick="doubleIssue">
                            <div e-columns>
                                <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="120"></div>
                                <div e-column e-field="Category" e-headertext="Category" e-width="120"></div>
                                <div e-column e-field="SubCategory" e-headertext="Sub Category" e-width="120"></div>
                                <div e-column e-field="SpecialIssueName" e-headertext="Special Issue Name" e-width="120"></div>
                                <div e-column e-field="SpecialIssueDetails" e-headertext="Special Issue Details" e-width="120"></div>
                                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="120"></div>
                                <div e-column e-field="TDate" e-headertext="Target Date" e-width="120"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
