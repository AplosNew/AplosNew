                             e-recorddoubleclick="" e-templaterefresh="refreshTemplateIssueItem">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateIssueItem" e-template="#checkboxTemplateIssueItem" e-textalign="center" e-width="1"></div>
