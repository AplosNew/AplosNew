                                    <input type="text" name="Value" ng-model="data.Value" ng-click="" class="form-control">
                                </div>
                            </script>
                            <script type="text/template" id="Remark">
                                <div class="col-sm-12" style="padding:0px;">
                                    <input type="text" name="Remark" ng-model="data.Remarks" ng-click="" class="form-control">
                                </div>
                            </script>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeIssueItemPopUp();" class="btn"><i class=""></i> Close</button>
                            <button ng-click="SaveIssueUpdateItemDetails();" class="btn"><i class=""></i> Save</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmRemoveItem" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeItemRow();"></confirm-archive-generic>




