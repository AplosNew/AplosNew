<div class="modal fade site-modal in" id="operationAttributeValueEntryPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content row">
            <div class="modal-header">{{oprationValueNew.AttributeName}} Value <button type="button" ng-click="closeValue();" class="close">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" id="value_Sequence">
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" n-decimals="2" name="Sequence" ng-model="oprationValueNew.Sequence" ng-keyup="manualValidationAddRemove('value_Sequence', oprationValueNew, 'Sequence');" class="form-control text-right" tabindex="41">
                        </div>
                    </div>
                    <div class="form-group" id="value_ShortName">
                        <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="ShortName" ng-model="oprationValueNew.ShortName" ng-keyup="manualValidationAddRemove('value_ShortName', oprationValueNew, 'ShortName');" class="form-control" maxlength="15" tabindex="43">
                        </div>
                    </div>
                    <div class="form-group" id="value_UserName">
                        <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="UserName" ng-model="oprationValueNew.UserName" ng-keyup="manualValidationAddRemove('value_UserName', oprationValueNew, 'UserName');" class="form-control" tabindex="45" maxlength="50">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" id="value_Code">
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Code" ng-model="oprationValueNew.Code" ng-keyup="manualValidationAddRemove('value_Code', oprationValueNew, 'Code');" class="form-control" tabindex="42" maxlength="10">
                        </div>
                    </div>
                    <div class="form-group" id="value_StandardName">
                        <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="StandardName" ng-model="oprationValueNew.StandardName" ng-keyup="manualValidationAddRemove('value_StandardName', oprationValueNew, 'StandardName');" class="form-control" tabindex="44" maxlength="50">
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="addValue();" class="btn" tabindex="47"><i class="glyphicon glyphicon-plus"></i> {{valueAction}}</button></li>
                        <li><button ng-click="clearValue();" class="btn" tabindex="48"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        <li><button ng-click="closeValue();" class="btn" tabindex="49"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12" ng-show="valueList.length>0">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Sequence</th>
                                    <th>Code</th>
                                    <th>Short Name</th>
                                    <th>Standard Name</th>
                                    <th>User Name</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in valueList|filter:{'OperationAttributeId':oprationValueNew.OperationAttributeId}">
                                    <td>{{x.Sequence}}</td>
                                    <td>{{x.Code}}</td>
                                    <td>{{x.ShortName}}</td>
                                    <td>{{x.StandardName}}</td>
                                    <td>{{x.UserName}}</td>
                                    <td>
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="editvalue(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i> </button></li>
                                            <li><button ng-click="removeRowModal(x, $index, 'valueList')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i> </button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>