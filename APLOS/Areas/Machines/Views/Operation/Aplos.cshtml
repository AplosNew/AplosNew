<togglable name="Operation Master"></togglable>
<div class="form-elements form-horizontal" ng-form="operationNewForm">
    <input type="hidden" ng-model="operationNew.Id">
    <div class="col-xs-12 divborder mark">
        <div class="col-xs-12 col-sm-4 col-md-4 pdr3">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" n-decimals="2" name="Sequence" ng-model="operationNew.Sequence" class="form-control text-right" required tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="StandardName" ng-model="operationNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Operation Activity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="operationTypeId" class="form-control" name="Operation Activity" ng-model="operationNew.OperationActivityId"
                                ng-options="item.Value as item.Text for item in operationActionList" required tabindex="6">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="2" ng-model="operationNew.Remarks" maxlength="250" tabindex="185"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4 pdl3 pdr3">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="operationNew.Code" class="form-control" required maxlength="10" tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="UserName" ng-model="operationNew.UserName" class="form-control" required maxlength="50" tabindex="5">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Operation Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="operationTypeId" class="form-control" name="Operation Type" ng-model="operationNew.OperationTypeId" required tabindex="7">
                            <option value=""></option>
                            <option ng-repeat="option in operationTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label class="control-label">
                            <input type="checkbox" ng-model="operationNew.Active" tabindex="11">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4 pdl3">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="ShortName" ng-model="operationNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label"></label>
                <div class="col-sm-8">
                    <div class="radio" ng-disabled="machineAndSkillList.length>0">
                        <label>
                            <input type="radio" name="isMachine" ng-model="operationNew.IsMachineRequired" ng-click="changeMachineRequired();" value="M" ng-disabled="machineAndSkillList.length>0">
                            <span class="cr"><i class="cr-icon"></i></span>
                            Machine
                        </label>
                        <label>
                            <input type="radio" name="isMachine" ng-model="operationNew.IsMachineRequired" ng-click="changeMachineRequired();" value="H" ng-disabled="machineAndSkillList.length>0">
                            <span class="cr"><i class="cr-icon"></i></span>
                            Without Machine
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Operation Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="operationCategoryId" class="form-control" ng-model="operationNew.OperationCategoryId" name="Operation Category" required
                                ng-options="item.Value as item.Text for item in operationCategoryList" tabindex="8">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            @*<div class="form-group" >
                    <label class="col-sm-4 control-label">Cycle Time</label>
                    <div class="col-sm-8 ">
                        <input type="text" name="CycleTime" n-decimals="2" ng-model="operationNew.CycleTime" class="form-control" maxlength="50" tabindex="5">
                    </div>
                </div>*@
        </div>
    </div>
    <div class="col-xs-2 site-tab">
        <ul class="nav nav-tabs tabs-left" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Process</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Advanced</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">FG Components</a></li>
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Attribute</a></li>
        </ul>
    </div>
    <div class="col-xs-10 tab-content">
        <!-- #region Process -->
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li> <button ng-click="processPopUp();" class="btn"> Add Process</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12" ng-show="sprocessList.length>0">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Remove</th>
                                    <th>Sequence</th>
                                    <th>Code</th>
                                    <th>Short Name</th>
                                    <th>Standard Name</th>
                                    <th>User Name</th>
                                    <th class="col-md-1">SubProcess</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in sprocessList">
                                    <td class="text-left">
                                        <ul class="list-inline">
                                            <li><button ng-click="removeProcessRowModal(x, $index)" class="btn btn-action tooltip-here" tooltip data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                    <td>{{x.Sequence}}</td>
                                    <td>{{x.Code}}</td>
                                    <td>{{x.ShortName}}</td>
                                    <td>{{x.StandardName}}</td>
                                    <td>{{x.UserName}}</td>
                                    <td class="text-right">
                                        <ul class="list-inline">
                                            <li><button ng-click="subProcessPoUp(x.ProcessId,$index)" class="btn btn-action tooltip-here" tooltip data-placement="left" title="Add SubProsess"><i class="glyphicon glyphicon-list"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- #endregion -->
        <!-- #region Advanced -->
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row" ng-form="AdvancedForm">
                <div class="col-xs-12 col-sm-4 col-md-4 pdr3">
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Machine<sup ng-show="operationNew.IsMachineRequired=='M'">*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="input-group">
                                <input type="text" name="Machine" ng-model="operationNew.ArticleName" class="form-control" ng-required="operationNew.IsMachineRequired=='M'" disabled>
                                <span class="input-group-btn">
                                    <button ng-disabled="operationNew.IsMachineRequired=='H'" ng-click="materialPopUp();" class="btn single-small-btn" tabindex="21"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label tooltip-here" title="Associate Process Time" tooltip>APT<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="input-group">
                                <input type="text" n-decimals="4" name="Associate Process Time" ng-model="operationNew.AssociateProcessTime" class="form-control text-right" required tabindex="24">
                                <span class="input-group-addon">Minutes</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Personal Allowance<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="input-group">
                                <input type="text" n-decimals="4" name="Personal Allowance" ng-model="operationNew.PersonalAllowance" class="form-control text-right" required tabindex="25">
                                <span class="input-group-addon">%</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Production System<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="select-style">
                                <select class="form-control" name="Production System" ng-model="operationNew.ProductionSystemId"
                                        ng-options="item.Value as item.Text for item in productionSystemList" required tabindex="29">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4 pdl3 pdr3">
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Skill<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="input-group">
                                <input type="text" name="Skill" ng-model="operationNew.SkillName" class="form-control" required disabled>
                                <span class="input-group-btn">
                                    <button @*ng-disabled="operationNew.IsMachineRequired=='M'"*@ ng-click="skillPoUp();" class="btn single-small-btn" tabindex="22"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">SPI<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <input type="text" only-numbers name="SPI" ng-disabled="operationNew.IsMachineRequired=='H'" ng-model="operationNew.SPI" class="form-control text-right" tabindex="28">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Machine Allowance<sup ng-show="operationNew.IsMachineRequired=='M'">*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="input-group">
                                <input type="text" n-decimals="4" disabled name="Machine Allowance" ng-model="operationNew.MachineAllowance" class="form-control text-right" ng-required="operationNew.IsMachineRequired=='M'">
                                <span class="input-group-addon">%</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Frequency<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <input type="text" only-numbers name="Frequency" ng-model="operationNew.Frequency" class="form-control text-right" required tabindex="27">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4 pdl3">
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label tooltip-here" title="Basic Process Time" tooltip>BPT<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="input-group">
                                <input type="text" n-decimals="4" name="Basic Process Time" ng-model="operationNew.BasicProcessTime" class="form-control text-right" required tabindex="23">
                                <span class="input-group-addon">Minutes</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Operation Length<sup ng-show="operationNew.IsMachineRequired=='M'">*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="input-group">
                                <input type="text" only-numbers name="Operation Length" ng-disabled="operationNew.IsMachineRequired=='H'" ng-model="operationNew.OperationLength" class="form-control text-right" ng-required="operationNew.IsMachineRequired=='M'" tabindex="26">
                                <span class="input-group-addon">Inches</span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Additional Allowance<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="input-group">
                                <input type="text" n-decimals="4" name="Additional Allowance" ng-model="operationNew.AdditionalAllowance" class="form-control text-right" ng-required>
                                <span class="input-group-addon">%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- #endregion -->
        <!-- #region fgComponents -->
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li> <button ng-click="FgComponentPopUp();" class="btn">FG Component</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12" ng-show="operationFgComponents.length>0">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Sequence</th>
                                    <th>Code</th>
                                    <th>Short Name</th>
                                    <th>Standard Name</th>
                                    <th>User Name</th>
                                    <th>Active</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in operationFgComponents">
                                    <td>
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="removeRowModal(x,$index,'operationFgComponents')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i> </button></li>
                                        </ul>
                                    </td>
                                    <td>{{x.Sequence}}</td>
                                    <td>{{x.Code}}</td>
                                    <td>{{x.ShortName}}</td>
                                    <td>{{x.StandardName}}</td>
                                    <td>{{x.UserName}}</td>
                                    <td>{{x.Active?'Yes':'No'}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- #endregion -->
        <!-- #region Attribute -->
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li> <button ng-click="attributePopUp();" class="btn">Attribute</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12" ng-show="attributeList.length>0">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Sequence</th>
                                    <th>Code</th>
                                    <th>Short Name</th>
                                    <th>Standard Name</th>
                                    <th>User Name</th>
                                    <th>AttributeType</th>
                                    <th>Assignment Level</th>
                                    <th>Attribute Property</th>
                                    <th>Character Fixed</th>
                                    <th>No of Character</th>
                                    <th>FreeField</th>
                                    <th>PreDefinedField</th>
                                    <th>Mandatory</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in attributeList">
                                    <td>{{x.Sequence}}</td>
                                    <td>{{x.Code}}</td>
                                    <td>{{x.ShortName}}</td>
                                    <td>{{x.StandardName}}</td>
                                    <td>{{x.UserName}}</td>
                                    <td>{{x.AttributeType}}</td>
                                    <td>{{x.ValueAssignmentLevel}}</td>
                                    <td>{{x.AttributeProperty}}</td>
                                    <td>{{x.IsFixedNoOfCharacter?'Yes':'No'}}</td>
                                    <td>{{x.NoOfCharacter}}</td>
                                    <td>{{x.IsFreeField?'Yes':'No'}}</td>
                                    <td>{{x.IsPreDefinedField?'Yes':'No'}}</td>
                                    <td>{{x.IsMandatory?'Yes':'No'}}</td>
                                    <td>
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="editAttribute($index);" class="btn btn-action tooltip-here" data-placement="top" title="Edit" tooltip><i class="glyphicon glyphicon-edit"></i> </button></li>
                                            <li><button ng-click="valuePopUp(x.Id, x.UserName, $index);" class="btn btn-action tooltip-here" data-placement="top" title="Value" tooltip><i class="glyphicon glyphicon-list-alt"></i> </button></li>
                                            <li><button ng-click="removeAttributeModal($index, 'attributeList', 'valueList', x.UserName, x.Id);" class="btn btn-action tooltip-here" data-placement="top" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i> </button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- #endregion -->
    </div>
    <div class="clearfix common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>

        </ul>
    </div>

</div>
<div class="aplos-grid-toggle">
    <div class="clearfix common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="GetOperationReportExcel();" class="btn" title="Report"><i class="glyphicon glyphicon-cloud-download"></i>Operation</button></li>
        </ul>
    </div>
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchOerationByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sequence</th>
                    <th>Code</th>
                    <th>Short Name</th>
                    <th>Standard Name</th>
                    <th>User Name</th>
                    <th>Process</th>
                    <th>Operation Type</th>
                    <th>Operation Category</th>
                    <th>Operation Activity</th>
                    <th>Machine/Without Machine</th>
                    <th>No. of Operation Variation</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in operations |itemsPerPage:$root.pageSize| orderBy:'Sequence'" total-items="$root.total_count" ng-dblclick="Get($index);">
                    <td>{{x.Sequence}}</td>
                    <td>{{x.Code}}</td>
                    <td>{{x.ShortName}}</td>
                    <td>{{x.StandardName}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.Process}}</td>
                    <td>{{x.OperationTypeCode}}</td>
                    <td>{{x.OperationCategoryName}}</td>
                    <td>{{x.OperationActivityName}}</td>
                    <td>{{x.IsMachineRequired?'Yes':'No'}}</td>
                    <td style="text-align:center">
                        <b><a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="GetOperationVariationData(x.Id);">{{x.OVCount}}</a></b>
                    </td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<!-- #region Process -->
<div class="modal fade site-modal in" id="processPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeProcess();">&times;</button>
                <h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Process</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="processParameters.searchBy">
                                            <option ng-repeat="option in searchProcessByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="processParameters.search" ng-enter="getProcessData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getProcessData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in processList|itemsPerPage:processParameters.pageSize"
                                pagination-id="metaData.name + 'processList'" total-items="processParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
