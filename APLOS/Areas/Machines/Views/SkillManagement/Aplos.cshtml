                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                     e-recorddoubleclick="" e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-templaterefresh="refreshTemplatePositionCode">
                    <div e-columns>
                        <div e-column e-headertext="All" e-headertemplateid="#headerTemplatePositionCode" e-template="#checkboxTemplatePositionCode" e-textalign="center" e-width="30"></div>
