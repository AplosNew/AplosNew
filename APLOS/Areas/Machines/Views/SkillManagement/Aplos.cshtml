                    <div e-column e-field="SNO" e-headertext="SNO" e-width="50"></div>
                    <div e-column e-field="PerformanceGroup" e-headertext="Performance Group" e-width="100"></div>
                    <div e-column e-field="PerformanceDetails" e-headertext="Performance Details" e-width="100"></div>
                    <div e-column e-field="PerformancePoints" e-headertext="Performance Points" e-width="100"></div>
                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                </div>
            </div>
        </div>
        <div role="tabpanel" ng-form="SkillManagementItemForm" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
