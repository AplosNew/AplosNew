<togglable name="Skill Management"></togglable>
<div class="form-elements form-horizontal">
    <div class="row" ng-form="MaintenanceScheduleForm">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Schedule Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Schedule Code" ng-model="scheduleNew.ScheduleCode " class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standared Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standared Nam" ng-model="scheduleNew.StandaredName" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Schedule Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Schedule Days" ng-model="scheduleNew.ScheduleDays" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Min Schedule Minutes<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Min Schedule Minutes" ng-model="scheduleNew.MinScheduleMinutes" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsible Persone Bgt Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Responsible Persone Bgt Code" ng-disabled="true" ng-model="scheduleNew.ResponsiblePersoneBgtCode" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectBudgetCode();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Department<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Department" ng-disabled="true" ng-model="scheduleNew.Department" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectDepartment();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="scheduleNew.ProcessId" name="Process" ng-change="GetSubProcessList(scheduleNew.ProcessId)" required
                                ng-options="item.Value as item.Text for item in ProcessList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="scheduleNew.UserName" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Min Schedule Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Min Schedule Days" ng-model="scheduleNew.MinScheduleDays" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max Schedule Minutes<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Min Schedule Minutes" ng-model="scheduleNew.MaxScheduleMinutes" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <input type="text" name="Remarks" ng-model="scheduleNew.Remarks" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Training Group</label>
                <div class="col-sm-8">
                    <input type="text" name="Training Group" ng-model="scheduleNew.TrainingGroup" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sub Process</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="scheduleNew.SubProcessId" name="Sub Process"
                                ng-options="item.Value as item.Text for item in SubProcessList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max Schedule Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Max Schedule Days" ng-model="scheduleNew.MaxScheduleDays" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Schedule Minutes<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Schedule Minutes" ng-model="scheduleNew.StandardScheduleMinutes" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Advance Planning Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Advance Planning Days" ng-model="scheduleNew.AdvancePlanningDays" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">IsActive</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="scheduleNew.IsActive" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-12 control-label"></label>
        <label class="col-sm-12 control-label"></label>
    </div>
    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(0) }"><a ng-click="setTab(0)" href="" aria-controls="doc" role="tab" data-toggle="tab">Entity</a></li>
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Position Code</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Skill Level</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="doc" role="tab" data-toggle="tab">Item</a></li>
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="doc" role="tab" data-toggle="tab">Actionable Person BudgetCode</a></li>
            <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" aria-controls="doc" role="tab" data-toggle="tab">Team Definition</a></li>
            <li role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" aria-controls="doc" role="tab" data-toggle="tab">Grading</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(0), active: isSet(0) }">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="GridEntity" ej-grid e-datasource="SkillManagementEntityList" e-templaterefresh="refreshTemplateEntity" e-recorddoubleclick=""
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-headertext="All" e-headertemplateid="#headerTemplateEntity" e-template="#checkboxTemplateEntity" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="EntityType" e-headertext="Entity Type" e-width="100"></div>
                        <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>
                        <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
                    </div>
                </div>
                <script type="text/template" id="checkboxTemplateEntity">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplateEntity">
                    <input type="checkbox" id="Eheadchk" />
                </script>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-disabled="scheduleNew.Id===null" ng-click="EntitySave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                </ul>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
