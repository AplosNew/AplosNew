                <script type="text/x-jsrender" id="headerTemplatePositionCode">
                    <input type="checkbox" id="PCheadchk" />
                </script>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-disabled="scheduleNew.Id===null" ng-click="PositionCodeSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                </ul>
            </div>
        </div>
