<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Team Plan Report
</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .modellgModify {
        width: 1600px;
    }
</style>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">From Date</label>
                <div class="col-sm-8">
                    <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.FromDate" datepicker class="form-control">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Team Name</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="statusNew.TeamName" name="Team Name"
                                ng-options="item.Value as item.Text for item in TeamNameList" ng-change="GetEntityList(statusNew.TeamName);GetTeamCategoryList(statusNew.TeamName);GetBudgetCodeList(statusNew.TeamName);GetEmployeeList(statusNew.TeamName);">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Team Category</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="statusNew.TeamCategory" name="Team Category"
                                ng-options="item.Value as item.Text for item in TeamCategoryList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            @*<div class="form-group">
                    <label class="col-sm-4 control-label">Budget Code</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="statusNew.BudgetCode" name="Budget Code" ng-change=""
                                    ng-options="item.Value as item.Text for item in BudgetCodeList">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>*@
            <div class="form-group">
                <label class="col-sm-4 control-label">Employee Activity Category</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="statusNew.ActivityCategory" name="Employee Activity Category"
                                ng-options="item.Value as item.Text for item in ActivityCategoryList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">To Date</label>
                <div class="col-sm-8">
                    <input type="text" required e-dateformat="dd-MMM-yyyy" ng-model="statusNew.ToDate" datepicker class="form-control">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Entity</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="statusNew.Entity" name="Entity"
                                ng-options="item.Value as item.Text for item in EntityList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Employee</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="statusNew.Employee" name="Employee Name" ng-change="GetActivityCategoryList(statusNew.Employee);"
                                ng-options="item.Value as item.Text for item in EmployeeList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="TeamPlanReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>


