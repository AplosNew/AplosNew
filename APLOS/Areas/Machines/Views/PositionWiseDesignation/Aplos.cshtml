<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Position Wise Designation</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Position Wise Designation Report</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <togglable name="Position Wise Designation"></togglable>
        <div class="form-elements form-horizontal">
            <div class="row" ng-form="PositionWiseDesignationForm">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Employee Category<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="positionNew.EmployeeCategoryId" name="Employee Category" required
                                        ng-options="item.Value as item.Text for item in EmployeeCategoryList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="Responsible Person" ng-disabled="true" ng-model="positionNew.ResponsiblePerson" class="form-control" maxlength="100" required autocomplete="off">
                            </div>
                            <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                <button ng-click="selectResponsiblePerson();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <input type="text" name="Remarks" ng-model="positionNew.Remarks" class="form-control" maxlength="100" autocomplete="off">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">IsActive</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="positionNew.IsActive" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Position Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="Position Code" ng-disabled="true" ng-model="positionNew.PositionCode" class="form-control" maxlength="100" required autocomplete="off">
                            </div>
                            <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                                <button ng-click="selectPositionCode();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Position Category<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="positionNew.PositionCategory" name="Position Category" required
                                        ng-options="item.Value as item.Text for item in PositionCategoryList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Cost Review Category<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="positionNew.CostReviewCategory" name="Cost Review Category" required
                                        ng-options="item.Value as item.Text for item in CostReviewCategoryList">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                        <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-12 control-label"></label>
                <label class="col-sm-12 control-label"></label>
            </div>
            <div class="clearfix"></div>
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSetteam(1) }"><a ng-click="setTabTeam(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Designation Group</a></li>
                    <li role="presentation" ng-class="{ active: isSetteam(2) }"><a ng-click="setTabTeam(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Designation Given/Legal</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetteam(1), active: isSetteam(1) }">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div id="GridDesignationGroup" ej-grid e-datasource="PositionDesignationGroupList" e-templaterefresh="refreshTemplateDesignationGroup" e-recorddoubleclick=""
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateDesignationGroup" e-template="#checkboxTemplateDesignationGroup" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                                <div e-column e-field="DesignationGroup" e-headertext="Designation Group" e-width="100"></div>
                                <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
                                <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-width="100"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplateDesignationGroup">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplateDesignationGroup">
                            <input type="checkbox" id="DGheadchk" />
                        </script>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-disabled="positionNew.Id===null" ng-click="DesignationGroupSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                        </ul>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetteam(2), active: isSetteam(2) }">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div style="color:black;" id="GridDesignation" ej-grid e-datasource="PositionWiseDesignationList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                             e-recorddoubleclick="" e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-templaterefresh="refreshTemplateDesignation">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateDesignation" e-template="#checkboxTemplateDesignation" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Given/Legal Designation" e-width="100"></div>
                                <div e-column e-field="DesignationGroup" e-headertext="Designation Group" e-width="100"></div>
                                <div e-column e-template="#SkillCategory" e-headertext="Skill Category" e-width="100"></div>
                            </div>
                        </div>

                        <script type="text/template" id="checkboxTemplateDesignation">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplateDesignation">
                            <input type="checkbox" id="Dheadchk" />
                        </script>
                        <script type="text/template" id="SkillCategory">
                            <div class="select-style">
                                <select class="form-control" ng-model="data.SkillCategory"
                                        ng-options="item.Value as item.Text for item in $parent.SkillCategoryList">
                                </select>
                            </div>
                        </script>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-disabled="positionNew.Id===null" ng-click="DesignationSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="table-responsive aplos-grid-toggle">
            <div id="GridPositionWiseDesignationMaster" ej-grid e-datasource="PositionWiseDesignationMasterList" e-recorddoubleclick="GetDetails"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-allowscrolling="true">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-visible="false" e-width="50"></div>
                    <div e-column e-field="PositionCode" e-headertext="Position Code" e-width="100"></div>
                    <div e-column e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="100"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-width="100"></div>
                    <div e-column e-field="PositionCategory" e-headertext="Position Category" e-width="100"></div>
                    <div e-column e-field="CostReviewCategory" e-headertext="Cost Review Category" e-width="100"></div>
                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                    <div e-column e-field="IsActive" e-headertext="Is Active" e-width="100"></div>
                </div>
            </div>
        </div>
    </div>
    @*<confirm-modal></confirm-modal>*@
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div style="color:black;" id="GridPositionWiseDesignationReport" ej-grid e-datasource="PositionWiseDesignationReportList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                 e-recorddoubleclick="" e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-templaterefresh="">
                <div e-columns>
                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-width="100"></div>
                    <div e-column e-field="Division" e-headertext="Division" e-width="100"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>
                    <div e-column e-field="Activity" e-headertext="Activity" e-width="100"></div>
                    <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                    <div e-column e-field="PositionCode" e-headertext="Position Code" e-width="100"></div>
                    <div e-column e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="100"></div>
                    <div e-column e-field="PositionCategory" e-headertext="Position Category" e-width="100"></div>
                    <div e-column e-field="CostReviewCategory" e-headertext="Cost Review Catergory" e-width="100"></div>
                    <div e-column e-field="Remarks" e-headertext="Remark" e-width="100"></div>  
                    <div e-column e-field="DesignationGroup" e-headertext="Designation Group" e-width="100"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                    <div e-column e-field="LegalDesignation" e-headertext="GivenLegal Designation" e-width="100"></div>
                    <div e-column e-field="SkillCategory" e-headertext="Skill Category" e-width="100"></div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="PositionWiseDesignationReport();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Download </button></li>
            </ul>
        </div>
    </div>
</div>
    <div class="modal fade site-modal in" id="PositionCodePopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg modellgModify">
            <div class="modal-content">
                <div class="modal-header">Position Code <button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body form-elements form-horizontal">
                    <div class="col-md-12">
                        <div class="content-container-fluid" style="color:black;overflow:scroll">
                            <p>Double click to Select an Position Code</p>
                            <div style="color:black;" id="GridPositionCode" ej-grid e-datasource="PositionCodeList"
                                 e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                                 e-recorddoubleclick="doublePositionCode">
                                <div e-columns>
                                    <div e-column e-type="Number" e-field="Id" e-headertext="Id" e-visible="false" e-width="30"></div>
                                    <div e-column e-type="Number" e-field="Code" e-headertext="Code" e-width="30"></div>
                                    <div e-column e-type="String" e-field="Position" e-headertext="Position" e-width="30"></div>
                                    <div e-column e-type="String" e-field="Department" e-headertext="Department" e-width="30"></div>
                                    <div e-column e-type="String" e-field="Section" e-headertext="Section" e-width="30"></div>
                                    <div e-column e-type="String" e-field="SubSection" e-headertext="Sub Section" e-width="30"></div>
                                    <div e-column e-type="String" e-field="Activity" e-headertext="Activity" e-width="30"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li>
                                <button ng-click="closePositionCodePopUp();" class="btn"><i class=""></i> Close</button>
                            </li>
                        </ul>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade site-modal in" id="ResponsiblePersonPopup" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg modellgModify">
            <div class="modal-content">
                <div class="modal-header">Employee List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body form-elements form-horizontal">
                    <div class="col-md-12">
                        <div class="content-container-fluid" style="color:black;overflow:scroll">
                            <p>Double click to Select an Employee</p>
                            <div style="color:black;" id="GridResponsiblePersonPopUp" ej-grid e-datasource="EmployeeList"
                                 e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                                 e-recorddoubleclick="doubleEmployee">
                                <div e-columns>
                                    <div e-column e-field="SystemId" e-headertext="Id" e-visible="false" e-width="120"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="120"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="50"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-width="120"></div>
                                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="120"></div>
                                    <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="120"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li>
                                <button ng-click="closeResponsiblePersonPopUp();" class="btn"><i class=""></i> Close</button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
