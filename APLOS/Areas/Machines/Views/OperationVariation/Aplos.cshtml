<togglable name="Operation Variation Master"></togglable>

<div class="form-horizontal" ng-form="operationVariationNewForm">
    <div class="col-xs-12 col-sm-6 col-md-6 form-element-ctrl">
        @*<div class="form-group" show-errors>
                <label class="col-sm-2 control-label">Operation<sup>*</sup></label>
                <div class="col-sm-4 show-message">
                    <div class="select-style">
                        <select class="form-control" submit-required="true" ng-model="operationVariationNew.OperationId"
                                ng-change="getDataList();GetSequence();getAttributeList();" ng-options="item.Value as item.Text for item in operationList"
                                name="Operation Step" required tabindex="1">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
                <label class="col-sm-4 control-label" style="color:blue">{{msg}}</label>
            </div>*@
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Operation<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <span class="input-group-addon">{{operationVariationNew.OperationCode}}</span>
                    <input type="text" name="Operation" ng-model="operationVariationNew.OperationName" class="form-control" required readonly>
                    <span class="input-group-btn">
                        <button name="submit" ng-click="GetOperationData()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>

    </div>

    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Advanced</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Attribute Value</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Size Group</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" data-toggle="tab">Product Master</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <!-- #region General -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Sequence" ng-model="operationVariationNew.Sequence" class="form-control" required placeholder="0" tabindex="2">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Short Name" ng-model="operationVariationNew.ShortName" class="form-control" required maxlength="15" tabindex="4">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" ng-model="operationVariationNew.UserName" class="form-control" required maxlength="50" tabindex="6">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="operationVariationNew.Remarks" maxlength="250" tabindex="8"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Is Special Operation</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" ng-model="operationVariationNew.isSpecialOperation">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        

                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Code" ng-model="operationVariationNew.Code" class="form-control" required maxlength="10" tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Standard Name" ng-model="operationVariationNew.StandardName" class="form-control" required maxlength="50" tabindex="5">
                            </div>
                        </div>
                        @*<div class="form-group">
                            <label class="col-sm-4 control-label">Skill (Operation Master)</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" name="Operation Master" ng-model="operationVariationNew.OperationMasterCode" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="showOperationPopUp();" class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>*@
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="operationVariationNew.Description" maxlength="250" tabindex="7"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Display Color<sup>*</sup></label>
                            <div class="col-sm-8 text-left">

                                <input ej-colorpicker e-value="operationVariationNew.Color" e-modeltype="palette" />

                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" ng-model="operationVariationNew.Active">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Advanced -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-4 col-md-4 pdr3">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Machine Master<sup ng-show="operationVariationNew.IsMachineRequired=='M'">*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Machine" ng-model="operationVariationNew.MaterialName" class="form-control" ng-required="operationVariationNew.IsMachineRequired=='M'" disabled>
                                    <span class="input-group-btn">
                                        <button ng-click="materialPopUp();" ng-disabled="operationVariationNew.IsMachineRequired=='H'" class="btn single-small-btn" tabindex="21"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label tooltip-here" title="Basic Process Time" tooltip>BPT</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" n-decimals="4" ng-model="operationVariationNew.BasicProcessTime" class="form-control text-right" disabled>
                                    <span class="input-group-addon">Minutes</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Personal Allowance<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" n-decimals="4" ng-model="operationVariationNew.PersonalAllowance" class="form-control text-right" disabled>
                                    <span class="input-group-addon">%</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Operation SPT<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" n-decimals="2" ng-model="operationVariationNew.SAM" class="form-control text-right" disabled>
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Frequency<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" only-numbers name="Frequency" ng-model="operationVariationNew.Frequency" class="form-control text-right" required tabindex="24">
                            </div>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 pdl3 pdr3">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Machine<sup ng-show="operationVariationNew.IsMachineRequired=='M'">*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Machine" ng-model="operationVariationNew.ArticleName" class="form-control" ng-required="operationVariationNew.IsMachineRequired=='M'" disabled
                                           style="width: 224px;">
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label tooltip-here" title="Associate Process Time" tooltip>APT</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" n-decimals="4" ng-model="operationVariationNew.AssociateProcessTime" class="form-control text-right" disabled>
                                    <span class="input-group-addon">Minutes</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Machine Allowance<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" n-decimals="4" name="Machine Allowance" ng-disabled="operationVariationNew.IsMachineRequired=='H'" ng-model="operationVariationNew.MachineAllowance" class="form-control text-right" ng-change="CalculateChangeSAM();" ng-required="operationVariationNew.IsMachineRequired=='M'">
                                    <span class="input-group-addon">%</span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Operation Variance SPT<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" n-decimals="4" name="SubOperationSAM" ng-model="operationVariationNew.SubOperationSAM" class="form-control text-right" disabled required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Standard SPT<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" n-decimals="4" name="Standard SPT" ng-model="operationVariationNew.StandardSPT" class="form-control text-right" tabindex="25">
                            </div>
                        </div>
                       
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4 pdl3">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label" style="padding-left: 30px;">Skill Master<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Skill Master" ng-model="operationVariationNew.SkillName" class="form-control" required disabled>
                                    <span class="input-group-btn">
                                        @*<button ng-click="skillPoUp();" ng-disabled="operationVariationNew.IsMachineRequired=='M'" class="btn single-small-btn" tabindex="22"><i class="cr-icon glyphicon glyphicon-search"></i></button>*@
                                        <button ng-click="showOperationPopUp();" class="btn single-small-btn" tabindex="22"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">SPI<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" only-numbers name="SPI" ng-disabled="operationVariationNew.IsMachineRequired=='H'" ng-model="operationVariationNew.SPI" class="form-control text-right" tabindex="25">
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Additional Allowance<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" n-decimals="4" name="Additional Allowance" ng-model="operationVariationNew.AdditionalAllowance" ng-change="CalculateChangeSAM();" class="form-control text-right" ng-required>
                                    <span class="input-group-addon">%</span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Additional SPT<sup>*</sup></label>
                            <div class="col-sm-4">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="symbol" ng-model="operationVariationNew.AdditionalSAMSymbol" value="+" ng-change="getTotalSam();">
                                        <span class="cr"><i class="cr-icon"></i></span> +
                                    </label>
                                    <label>
                                        <input type="radio" name="symbol" ng-model="operationVariationNew.AdditionalSAMSymbol" value="-" ng-change="getTotalSam();">
                                        <span class="cr"><i class="cr-icon"></i></span> -
                                    </label>
                                </div>
                            </div>
                            <div class="col-sm-4 pdl3 show-message">
                                <input type="text" n-decimals="4" name="Additional SAM" ng-model="operationVariationNew.AdditionalSAM" class="form-control text-right" required tabindex="23" ng-change="getTotalSam();">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Final SPT</label>
                            <div class="col-sm-8">
                                <input type="text" n-decimals="4" name="Total SAM" ng-model="operationVariationNew.TotalSAM" class="form-control text-right" disabled>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Attribute -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12" ng-show="attributeList.length>0">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Attribute</th>
                                        <th>Attribute Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in attributeList">
                                        <td> {{x.OperationAttributeName}}</td>
                                        <td>
                                            <div class="col-sm-8">
                                                <div class="input-group">
                                                    <input type="text" ng-model="x.AttributeValueFreeText" class="col-sm-2 form-control" ng-keyup="idNullByFreeText(x.OperationAttributeId, $index)" ng-disabled="x.FlagDisable">
                                                    <span class="input-group-btn">
                                                        <button ng-click="valuePoUp(x, $index);" ng-disabled="!x.IsPreDefinedField" class="btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                                        <button ng-click="attributeValueClear($index)" class="btn"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                                    </span>
                                                </div>
                                            </div>
                                            <p class="msg-error" ng-show="IsMandatoryButNull(x.IsMandatory, x.AttributeValueFreeText)">value is required.</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Size Group -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="SizeGroupPopUpDataList();" ng-disabled="operationVariationNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add SizeGroup</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="operationVariationSizeGroupDataList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Sequence</th>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>
                                        <th>User Define Name</th>
                                        <th>Seam Length</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in operationVariationSizeGroupDataList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Sequence}}</td>
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td> <input type="text" n-decimals="2" class="form-control " ng-model="x.SeamLength"></td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeRowModal($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Product Master -->
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="getPMData();" ng-disabled="operationVariationNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Product Master</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="operationVariationPMDataList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Sequence</th>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>
                                        <th>User Define Name</th>
                                        <th>Product Category</th>
                                        <th>Product Subcategory</th>
                                        <th>Product</th>
                                        <th>Base Process</th>
                                        <th>Base UoM</th>
                                        <th>Active</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in operationVariationPMDataList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Sequence}}</td>
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td>{{x.ProductCategoryName}}</td>
                                        <td>{{x.ProductSubCategoryName}}</td>
                                        <td>{{x.ProductName}}</td>
                                        <td>{{x.BaseProcess}}</td>
                                        <td>{{x.BaseUom}}</td>
                                        <td>{{x.Active?'Yes':'No'}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removePMRowModal($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
        </div>
        <div class="clearfix common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">

        <div class="clearfix common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="GetOperationVariationReportExcel();" class="btn" title="Report"><i class="glyphicon glyphicon-cloud-download"></i>Operation Variation</button></li>
            </ul>
        </div>

        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByOpStepList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sequence</th>
                    <th>Code</th>
                    <th>Short Name</th>
                    <th>Standard Name</th>
                    <th>User Name</th>
                    <th>SubOperation SPT</th>
                    <th>Additional SPT</th>
                    <th>Final SPT</th>
                    <th>Frequency</th>
                    <th>Active</th>
                    <th>Special Operation</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in operationVariations |itemsPerPage:$root.pageSize| orderBy:'Sequence'" total-items="$root.total_count" ng-dblclick="Get($index);">
                    <td>{{x.Sequence}}</td>
                    <td>{{x.Code}}</td>
                    <td>{{x.ShortName}}</td>
                    <td>{{x.StandardName}}</td>
                    <td>{{x.UserName}}</td>
                    <td class="text-right">{{x.SubOperationSAM}}</td>
                    <td class="text-right">{{x.AdditionalSAM}}</td>
                    <td class="text-right">{{x.TotalSAM}}</td>
                    <td class="text-right">{{x.Frequency}}</td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                    <td>{{x.isSpecialOperation?'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber);">
    </dir-pagination-controls>
</div>
<!-- #region Material -->
<div class="modal fade site-modal in" id="materialId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closeMaterial()">&times;</button>
                <h4 class="modal-title">Machine Master</h4>
            </div>
