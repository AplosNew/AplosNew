                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Particulars</label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Model" ng-disabled="true" ng-model="scheduleNew.Particulars" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Model</label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Model" ng-disabled="true" ng-model="scheduleNew.Model" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max Schedule Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Max Schedule Days" ng-model="scheduleNew.MaxScheduleDays" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Schedule Minutes<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Schedule Minutes" ng-model="scheduleNew.StandardScheduleMinutes" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">IsActive</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="scheduleNew.IsActive" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
