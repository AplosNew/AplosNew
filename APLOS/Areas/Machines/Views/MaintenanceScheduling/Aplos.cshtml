<togglable name="Maintenance Scheduling"></togglable>
<div class="form-elements form-horizontal">
    <div class="row" ng-form="MaintenanceScheduleForm">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Schedule Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Schedule Code" ng-model="scheduleNew.ScheduleCode " class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standared Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standared Nam" ng-model="scheduleNew.StandaredName" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Machine Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Machine Name" ng-disabled="true" ng-model="scheduleNew.MachineName" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectMachine();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Schedule Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Schedule Days" ng-model="scheduleNew.ScheduleDays" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Min Schedule Minutes<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Min Schedule Minutes" ng-model="scheduleNew.MinScheduleMinutes" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsible Persone Bgt Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Responsible Persone Bgt Code" ng-disabled="true" ng-model="scheduleNew.ResponsiblePersoneBgtCode" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectBudgetCode();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Department<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Department" ng-disabled="true" ng-model="scheduleNew.Department" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectDepartment();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Attachment<sup>*</sup></label>
        </div>*@
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="scheduleNew.Category" name="Category" required
                                ng-options="item.Value as item.Text for item in CategoryList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="scheduleNew.UserName" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Make</label>
                <div class="col-sm-8">
                    <input type="text" name="Make" ng-disabled="true" ng-model="scheduleNew.Make" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Min Schedule Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Min Schedule Days" ng-model="scheduleNew.MinScheduleDays" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max Schedule Minutes<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Min Schedule Minutes" ng-model="scheduleNew.MaxScheduleMinutes" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <input type="text" name="Remarks" ng-model="scheduleNew.Remarks" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Maintenance Group</label>
                <div class="col-sm-8">
                    <input type="text" name="MaintenanceGroup" ng-model="scheduleNew.MaintenanceGroup" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sub Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="scheduleNew.SubCategory" name="Sub Category" required
                                ng-options="item.Value as item.Text for item in SubCategoryList">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Particulars</label>
                <div class="col-sm-8">
                    <input type="text" name="Model" ng-disabled="true" ng-model="scheduleNew.Particulars" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Model</label>
                <div class="col-sm-8">
                    <input type="text" name="Model" ng-disabled="true" ng-model="scheduleNew.Model" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Max Schedule Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Max Schedule Days" ng-model="scheduleNew.MaxScheduleDays" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Schedule Minutes<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Schedule Minutes" ng-model="scheduleNew.StandardScheduleMinutes" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">IsActive</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="scheduleNew.IsActive" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                @*<li> <button data-toggle="modal" data-target="#confirmPopUp" ng-disabled="scheduleNew.Id===null" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-12 control-label"></label>
        <label class="col-sm-12 control-label"></label>
    </div>
    <div class="clearfix"></div>
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Machine/Asset Name</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Item</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="doc" role="tab" data-toggle="tab">Stores & Consumable</a></li>
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="doc" role="tab" data-toggle="tab">Actionable Person BudgetCode</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" ng-form="MaintenanceScheduleMachineForm" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="GridMachine" ej-grid e-datasource="ScheduleMachineList" e-templaterefresh="refreshTemplateMachineAsset" e-recorddoubleclick=""
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-headertext="All" e-headertemplateid="#headerTemplateMachineAsset" e-template="#checkboxTemplateMachineAsset" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="AssetId" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="AssetName" e-headertext="Asset Name" e-width="100"></div>
                        <div e-column e-field="AssetCode" e-headertext="Asset Code" e-width="100"></div>
                        <div e-column e-field="EntityId" e-headertext="EntityId" e-visible="false" e-width="100"></div>
                        <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>
                        <div e-column e-field="WorkCenterMasterId" e-headertext="WCId" e-width="50" e-visible="false"></div>
                        <div e-column e-field="WorkCenter" e-headertext="Work Center" e-width="100"></div>
                        <div e-column e-field="MachineMasterId" e-headertext="WCId" e-width="50" e-visible="false"></div>
                        <div e-column e-field="MachineName" e-headertext="Machine Name" e-width="100"></div>
                        <div e-column e-template="#SNO" e-headertext="SNO" e-width="100"></div>
                        <div e-column e-template="#AssetGroup" e-headertext="Asset Group" e-width="100"></div>
                        <div e-column e-template="#Remarks" e-headertext="Remarks" e-width="200"></div>
                    </div>
                </div>
                <script type="text/template" id="checkboxTemplateMachineAsset">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplateMachineAsset">
                    <input type="checkbox" id="headchk" />
                </script>
                <script type="text/template" id="SNO">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="SNO" ng-model="data.SNO" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
                <script type="text/template" id="AssetGroup">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="AssetGroup" ng-model="data.AssetGroup" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
                <script type="text/template" id="Remarks">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Remarks" ng-model="data.Remarks" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="MachineSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                    @*<li> <button ng-click="MachineDelete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete </button></li>
                        <li> <button ng-click="MachineClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>*@
                </ul>
            </div>
        </div>

        <div role="tabpanel" ng-form="MaintenanceScheduleItemForm" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">SNO<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="SNO" ng-disabled="true" ng-model="ItemNew.SNO" class="form-control" required maxlength="100" autocomplete="off">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">IsAuditable</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="ItemNew.IsAuditable" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Critical Level<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ItemNew.CriticalLevel" name="Critical Level" required
                                    ng-options="item.Value as item.Text for item in CriticalLevelLists">
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Item Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Name" ng-model="ItemNew.ItemName" class="form-control" required maxlength="100" autocomplete="off">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label" ng-show="ItemNew.IsAuditable==true">By Whom</label>
                    <div class="col-sm-8">
                        <div class="col-sm-10" style="padding:0px;">
                            <input type="text" name="By Whome" ng-disabled="true" ng-show="ItemNew.IsAuditable==true" ng-model="ItemNew.ByWhom" class="form-control" maxlength="100"  autocomplete="off">
                        </div>
                        <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                            <button ng-click="selectEmployee();" ng-show="ItemNew.IsAuditable==true" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <input type="text" name="Remarks" ng-model="ItemNew.Remarks" class="form-control"  maxlength="100" autocomplete="off">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="GridItem" ej-grid e-datasource="ScheduleItemList" e-recorddoubleclick="GetItemDetails"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Item Id" e-visible="false" e-width="3"></div>
                        <div e-column e-field="SNO" e-headertext="SNO" e-width="3"></div>
                        <div e-column e-field="ItemName" e-headertext="Item Name" e-width="3"></div>
                        <div e-column e-field="CriticalLevel" e-headertext="Critical Level" e-width="3"></div>
                        <div e-column e-field="IsAuditable" e-headertext="Is Auditable" e-width="3"></div>
                        <div e-column e-field="ByWhom" e-headertext="By Whom" e-width="3"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                        <div e-column e-template="#Parameter" e-headertext="Child Parameter" e-width="2"></div>
                    </div>
                </div>
                <script type="text/template" id="Parameter">
                    <div class="form-group">
                        <div class="col-sm-5 text-left" style="padding:0px;padding-left:2px">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click=";$parent.GetItemDetails(this);$parent.getParameterPopup(this);" class="btn"><i class="glyphicon glyphicon-list"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </script>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="ItemSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                    <li> <button ng-click="removeRowModal($index,ItemNew.Id);" ng-disabled="ItemNew.Id===null" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete </button></li>
                    <li> <button ng-click="ItemClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

        <div role="tabpanel" ng-form="MaintenanceScheduleStoresForm" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">SNO</label>
                    <div class="col-sm-8">
                        <input type="text" name="SNO" ng-disabled="true" ng-model="StoresNew.SNO" class="form-control"  maxlength="100" autocomplete="off">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Item Name</label>
                    <div class="col-sm-8">
                        <input type="text" name="Item Name" ng-model="StoresNew.ItemName" class="form-control"  maxlength="100" autocomplete="off">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Estimated Qty</label>
                    <div class="col-sm-8">
                        <input type="text" name="Estimated Qty" ng-model="StoresNew.EstimatedQty" class="form-control"  maxlength="100" autocomplete="off">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Cost Type</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="StoresNew.CostType" name="Cost Type" 
                                    ng-options="item.Value as item.Text for item in CostTypeList">
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <input type="text" name="Remarks" ng-model="StoresNew.Remarks" class="form-control"  maxlength="100" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-4 col-md-4">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Item Category</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="StoresNew.Category" name="Item Category" 
                                    ng-options="item.Value as item.Text for item in ItemCategoryList">
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Article</label>
                    <div class="col-sm-8">
                        <div class="col-sm-10" style="padding:0px;">
                            <input type="text" name="Article" ng-disabled="true" ng-model="StoresNew.Article" class="form-control" maxlength="100"  autocomplete="off">
                        </div>
                        <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                            <button ng-click="selectArticle();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">UOM</label>
                    <div class="col-sm-8">
                        <div class="col-sm-10" style="padding:0px;">
                            <input type="text" name="UOM" ng-disabled="true" ng-model="StoresNew.UOM" class="form-control" maxlength="100" autocomplete="off">
                        </div>
                        <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                            <button ng-click="selectUOM();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Estimation Level</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="StoresNew.EstimationLevel" name="Estimation Level" 
                                    ng-options="item.Value as item.Text for item in EstimationLevelList">
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="GridStores" ej-grid e-datasource="ScheduleStoresList" e-recorddoubleclick="GetStoresDetails"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Stores Id" e-visible="false" e-width="3"></div>
                        <div e-column e-field="SNO" e-headertext="SNO" e-width="3"></div>
                        <div e-column e-field="ItemName" e-headertext="Item Name" e-width="3"></div>
                        <div e-column e-field="UOM" e-headertext="UOM" e-width="3"></div>
                        <div e-column e-field="EstimatedQty" e-headertext="Estimated Qty" e-width="3"></div>
                        <div e-column e-field="Category" e-headertext="Item Category" e-width="3"></div>
                        <div e-column e-field="Article" e-headertext="Article" e-width="3"></div>
                        <div e-column e-field="CostType" e-headertext="Cost Type" e-width="3"></div>
                        <div e-column e-field="EstimationLevel" e-headertext="Estimation Level" e-width="3"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="3"></div>
                    </div>
                </div>
            </div>
            <div class="common-btn">
