<togglable name="Maintenance Scheduling"></togglable>
<div class="form-elements form-horizontal">
    <div class="row" ng-form="MaintenanceScheduleForm">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Schedule Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Schedule Code" ng-model="scheduleNew.ScheduleCode " class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standared Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standared Nam" ng-model="scheduleNew.StandaredName" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Machine Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Machine Name" ng-model="scheduleNew.MachineName" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
                    <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                        <button ng-click="selectMachine();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Schedule Days<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Schedule Days" ng-model="scheduleNew.ScheduleDays" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Min Schedule Minutes<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Min Schedule Minutes" ng-model="scheduleNew.MinScheduleMinutes" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsible Persone Bgt Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Responsible Persone Bgt Code" ng-model="scheduleNew.ResponsiblePersoneBgtCode" class="form-control" maxlength="100" required autocomplete="off">
                    </div>
