            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="GridMachine" ej-grid e-datasource="ScheduleMachineList" e-templaterefresh="refreshTemplateMachineAsset" e-recorddoubleclick=""
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-headertext="All" e-headertemplateid="#headerTemplateMachineAsset" e-template="#checkboxTemplateMachineAsset" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="AssetId" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="AssetName" e-headertext="Asset Name" e-width="200"></div>
                        <div e-column e-field="WorkCenterMasterId" e-headertext="WCId" e-width="50" e-visible="false"></div>
                        <div e-column e-field="WorkCenter" e-headertext="Work Center" e-width="200"></div>
                        <div e-column e-field="MachineMasterId" e-headertext="WCId" e-width="50" e-visible="false"></div>
                        <div e-column e-field="MachineName" e-headertext="Machine Name" e-width="200"></div>
                        <div e-column e-template="#SNO" e-headertext="SNO" e-width="200"></div>
                        <div e-column e-template="#AssetGroup" e-headertext="Asset Group" e-width="200"></div>
                        <div e-column e-template="#Remarks" e-headertext="Remarks" e-width="200"></div>
                    </div>
                </div>
                <script type="text/template" id="checkboxTemplateMachineAsset">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplateMachineAsset">
                    <input type="checkbox" id="headchk" />
                </script>
                <script type="text/template" id="SNO">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="SNO" ng-model="data.SNO" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
                <script type="text/template" id="AssetGroup">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="AssetGroup" ng-model="data.AssetGroup" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
                <script type="text/template" id="Remarks">
                    <div class="col-sm-10" style="padding:0px;">
                        <input type="text" name="Remarks" ng-model="data.Remarks" ng-click="" class="form-control" maxlength="200">
                    </div>
                </script>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="MachineSave();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                    <li> <button ng-click="MachineDelete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete </button></li>
                    <li> <button ng-click="MachineClear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>

