
<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form="modelNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Infromation</legend>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-3 control-label">Doc Ref & Date<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{modelNew.DocRefNo}}</span>
                        <input type="text" ng-model="modelNew.DocDate" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="popUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-3 control-label">Posting Date<sup>*</sup></label>
                <div class="col-sm-9 show-message">
                    <input required datepicker="checkPostingDate();checkDocDate();" id="postingDate" type="text" name="PostingDate" ng-model="modelNew.PostingDate" class="form-control" tabindex="1">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Voucher Type<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" name="Voucher Type" ng-disabled="voucherTypeList.length==1" ng-model="modelNew.VoucherTypeId"
                                    ng-options="item.Value as item.Text for item in voucherTypeList" tabindex="2">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
    </fieldset>

    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Material Info</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Transaction" role="tab" data-toggle="tab">Journal</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form="tabForm1">
                <div class="clearfix"></div>

                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material Master</th>
                                <th>Article</th>
                                <th>Order Qty</th>
                                <th>Receive Qty</th>
                                <th>Other Billing Qty</th>
                                <th>BillingQty</th>
                                <th>Rate</th>
                                <th>Amount (BC)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in outSourceBillingDetailList">
                                <td>{{x.MaterialName}}</td>
                                <td>{{x.Article}}</td>
                                <td class="text-right">{{x.OrderQty | number| setDecimal:2}}</td>
                                <td class="text-right">{{x.ReceiveQty | number| setDecimal:2}}</td>
                                <td class="text-right">{{x.OtherBillingQty | number| setDecimal:2}}</td>
                                <td class="text-right">{{x.BillingQty | number| setDecimal:2}}</td>
                                <td class="text-right">{{x.MaterialTranRate | number| setDecimal:2}}</td>
                                <td class="text-right">{{x.Amount | number| setDecimal:2}}</td>

                            </tr>
                            <tr>
                                <td colspan="2" class="text-right"><strong>Total : </strong></td>
                                <td class="text-right"><strong>{{outSourceBillingDetailList | sumByKey : 'OrderQty'| number| setDecimal:2}}</strong></td>
                                <td class="text-right"><strong>{{outSourceBillingDetailList | sumByKey : 'ReceiveQty'| number| setDecimal:2 }}</strong></td>
                                <td class="text-right"><strong>{{outSourceBillingDetailList | sumByKey : 'OtherBillingQty'| number| setDecimal:2 }}</strong></td>
                                <td class="text-right"></td>
                                <td class="text-right"></td>
                                <td class="text-right"><strong>{{outSourceBillingDetailList | sumByKey : 'Amount'| number| setDecimal:2 }}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                @*<div class="clearfix"></div>*@


                <div class="clearfix"></div>

            </div>
            
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form="tabForm3" >
               
                <div class="clearfix"></div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>Dr</th>
                                <th>Cr</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in billingJV| orderBy:'Dr'">
                                <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td class="text-right">{{x.Dr | number| setDecimal:4}}</td>
                                <td class="text-right">{{x.Cr | number| setDecimal:4}}</td>
                            </tr>
                            <tr>
                                <td colspan="3"></td>
                                <td class="text-right"><strong>{{billingJV | sumByKey : 'Dr' | number| setDecimal:4}}</strong></td>
                                <td class="text-right"><strong>{{billingJV | sumByKey : 'Cr' | number| setDecimal:4}}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="clearfix"></div>

            </div>


        </div>
    </div>
    <div class="clearfix"></div>

    <div class="common-btn">
        <ul class="common-btn list-inline text-right">
            <li> <button ng-click="Post();" class="btn"> Post</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchByPostedGRN">
                                <option ng-repeat="option in searchByPostedGRNList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="searchGRN" ng-enter="getDataList();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content-container-fluid" style="color:black;">
        <div style="color:black;" id="GridPrint" ej-grid e-datasource="products" e-allowfiltering="true" e-allowpaging="true"
             e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
             e-actioncomplete="actionCompleteSelected" e-allowscrolling="true" e-showstackedheader="true">
            <div e-columns>
                <div e-column e-field="GRNType" e-headertext="Type" e-width="60" e-filter="false"></div>
                <div e-column e-field="Particular" e-headertext="Particular" e-width="180"></div>
                <div e-column e-field="Id" e-headertext="GRN No" e-width="80" textAlign='Center'></div>
                <div e-column e-field="GRNDate" e-headertext="GRN Date" e-width="80" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="GateEntryNo" e-headertext="Gate EntryNo" e-width="80"></div>
                <div e-column e-field="VoucherNo" e-headertext="VoucherNo" e-width="100"></div>
                <div e-column e-field="PostingDate" e-headertext="PostingDate" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="POId" e-headertext="PO Id" e-width="60"></div>
                <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                <div e-column e-field="DocDate" e-headertext="Doc Ref Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="MaterialStorageName" e-headertext="Storage Location" e-width="130"></div>
                <div e-column e-field="TransactionQty" e-headertext="Tran.Qty" e-width="100" textAlign='Right'></div>
                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="60" textAlign='Right'></div>
                <div e-column e-field="TransactionAmount" e-headertext="Tran Amount" e-width="100" textAlign='Right'></div>
                <div e-column e-field="TDSTax" e-headertext=" TDS " e-width="100" textAlign='Right'></div>
                <div e-column e-field="TDSVoucherNo" e-headertext="TDS VoucherNo" e-width="100" textAlign='Right'></div>
                <div e-column e-field="IsTDSTaxPost" e-headertext="Tax Status" e-width="100" textAlign='Right'></div>
                <div e-column e-headertext="Report" e-template="#ReportTemplate" e-width="100"></div>
                <div e-column e-headertext=" Action " e-template="#DeleteTemplate" e-width="120"></div>

            </div>


        </div>

        @*<script id="AdditionalTaxTemplate" type="text/template">
                <ul class="common-btn list-inline text-right">
                </ul>

            </script>*@
        <script id="ReportTemplate" type="text/template">
            <div class="common-btn">
                <ul class="common-btn list-inline text-center">
                    <li>
                        <button ng-click="$parent.onClickReportDownloadWord(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Pdf">
                            <i class="fa fa-file-pdf-o"></i>
                        </button>
                        <button ng-click="$parent.onClickReportDownloadExcel(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Excel">
                            <i class="fa fa-file-excel-o"></i>
                        </button>
                        <button ng-click="$parent.onClickGRNID(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="GRN">
                            <i class="glyphicon glyphicon-file" style="color:orangered;"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>

        <script id="DeleteTemplate" type="text/template">
            <div class="common-btn">
                <ul class="common-btn list-inline text-center">
                    <li>
                        <button ng-disabled="data.AdditionalTaxId==null" ng-click="$parent.onClickadditionalTaxPop(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="TDS">
                            TDS
                        </button>
                        <button ng-disabled="data.IsPark==false" ng-click="$parent.onClickDeletePopUp(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Delete">
                            <i class="glyphicon glyphicon-trash" style="color:orangered;"></i>
                        </button>
                        <button ng-show="data.WrittenOffAmount" ng-click="$parent.getInvoiceSetOffDetailByInvoice(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="SetOff">
                            <i class="glyphicon glyphicon-eye-open" style="color:orangered;"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>
    </div>
    <i>**Showing top 100 Posted GRN  order by PostingDate</i>
</div>
@Html.Partial("~/Areas/Outsourcing/Views/OutsourceBillingPost/_OutsourceBillingPopUp.cshtml")