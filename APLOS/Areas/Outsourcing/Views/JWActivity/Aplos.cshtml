<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="JobWorkActivity.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="JobWorkActivity.Sequence" e-width="100" required tabindex="1" />
            </div>
        </div>


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" ng-model="JobWorkActivity.ShortName" class="form-control" maxlength="15" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User  Name<sup>*</sup></label>

            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="JobWorkActivity.UserName" class="form-control" required maxlength="50" tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Job Work Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="JobWorkActivity.Type" name="Job Work Type" required tabindex="5">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in jobWorkTypeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Service<sup></sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="JobWorkActivity.ServiceId" name="Service" tabindex="7">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in serviceCboList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Production Process<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="JobWorkActivity.ProcessId" name="Production Process" tabindex="8">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in productionPrcoessList" value="{{option.Id}}">{{option.UserName}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="JobWorkActivity.Code" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="JobWorkActivity.StandardName" class="form-control" required maxlength="50" tabindex="3">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Responsible Person<sup></sup></label>
            <div class="col-sm-8 ">
                <div class="input-group">
                    <input type="text" name="Responsible Person" ng-model="JobWorkActivity.ResponsiblePersonName" class="form-control" readonly tabindex="8">
                    <input type="hidden" name="EmployeeId" ng-model="JobWorkActivity.ResponsiblePersonId" />
                    <span class="input-group-btn">
                        <button ng-click="showAllEmployeeListPopUp()" tabindex="8" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearResponsiblePerson()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="JobWorkActivity.Remarks" maxlength="250" tabindex="9"></textarea>
            </div>
        </div>




    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            @*<div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>*@
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            @*<div e-column e-field="AddedDate" e-format="{0:dd-MMM-yyyy}"  e-type="date" e-headertext="Date Added" e-width="2"></div>*@
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="Type" e-headertext="Type" e-width="5"></div>
            <div e-column e-field="ResponsiblePersonName" e-headertext="Resp. Person" e-width="5"></div>
            <div e-column e-field="ServiceName" e-headertext="Service" e-width="5"></div>ProcessName
            <div e-column e-field="ProcessName" e-headertext="Process" e-width="5"></div>

        </div>
    </div>
</div>



<div class="modal fade site-modal in" id="responsiblePersonPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <div id="Gridemployees" ng-init="chkinit()" ej-grid e-datasource="employeeList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowscrolling="true" e-recorddoubleclick="getEmp">
                        <div e-columns>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="DOB" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-allowediting="false" e-width="80"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer common-btn">
                    <button ng-click="closeResponsiblePersonPopUp();" class="btn"><i class=""></i> Close</button>
                </div>
            </div>
        </div>
    </div>
</div>



@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterByTypePopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterArticleSearchPopUp.cshtml")
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
