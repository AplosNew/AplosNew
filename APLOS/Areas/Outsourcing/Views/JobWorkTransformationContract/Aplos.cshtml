<togglable name={{title}}></togglable>
<div class="form-elements form-horizontal" ng-form name="frmValueAddedContract" style="padding:0px;">
    <div class="row">
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlProcessTypeId">
                    Process Type<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <select name="Process Type Id" id="ddlProcessTypeId" class="form-control" submit-required="true" tabindex="1" ng-model="ValueAddedContract.ProcessTypeId" ng-options="item.Id as item.StandardName for item in processTypeList" required></select>
                        <input type="hidden" id="txtId" name="txtId" ng-model="ValueAddedContract.Id" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="txtContractDate">
                    Contract Date<sup>*</sup>
                </label>
                <div class="show-message">
                    <input id="txtContractDate" name="Contract Date" e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="data.InDate" e-width="100%" ng-model="ValueAddedContract.ContractDate" required tabindex="2" />
                    @*<input type="text" id="txtContractDate" name="Contract Date" datepicker="" class="form-control" ng-model="ValueAddedContract.ContractDate" required tabindex="2" />*@
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="txtContractTime">
                    Contract Time<sup>*</sup>
                </label>
                <div class="show-message">
                    @*<input type="text" id="txtContractTime" name="Contract Time" class="form-control" ng-model="ValueAddedContract.ContractTime" required tabindex="3" />*@
                    <input type="text" id="txtContractTime" name="Contract Time" ng-model="ValueAddedContract.ContractTime" required tabindex="3" ej-timepicker e-value="data.InTime" e-width="100%" />
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlPlantId">
                    Plant<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <select name="Plant" id="ddlPlantId" class="form-control" submit-required="true" tabindex="4" ng-model="ValueAddedContract.PlantId" ng-options="item.Id as item.StandardName for item in plantList" required ng-change="LoadPlantWiseEntity()"></select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlEntityId">
                    Entity<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <select name="EntityId" id="ddlEntityId" class="form-control" submit-required="true" tabindex="5" ng-model="ValueAddedContract.EntityId" ng-options="item.Id as item.UserName for item in entityList" required ng-change="LoadMaterialLocation()"></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlJobWorkLocationId">
                    Material Location<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <select name="Material Location" id="ddlJobWorkLocationId" class="form-control" submit-required="true" tabindex="6" ng-model="ValueAddedContract.JobWorkLocationId" ng-options="item.Id as item.LocationName for item in materialLocationList" required></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="ddlMaterialType">
                    Material Type<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <select name="Material Type" id="ddlMaterialType" class="form-control" submit-required="true" tabindex="7" ng-model="ValueAddedContract.MaterialType" ng-options="item.name as item.name for item in materialTypeList" required></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="txtLocationCode">
                    Final Output Category<sup>*</sup>
                </label>
                <div class="show-message">
                    <div class="select-style">
                        <select name="Final Output Category" id="ddlFinalOutputCategory" class="form-control" submit-required="true" tabindex="8" ng-model="ValueAddedContract.FinalOutputCategory" ng-options="item.name as item.name for item in finalOutputCategory" required></select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label">Vendor<sup>*</sup></label>
                <div class="show-message">
                    <div class="input-group">
                        <input type="text" hidden id="masterId" ng-model="ValueAddedContract.PartyId" />
                        <span class="input-group-addon"> {{ValueAddedContract.PartyCode}}</span>
                        <input type="text" name="Vendor" id="Vendor" ng-model="ValueAddedContract.PartyName" tabindex="9" class="form-control" readonly required>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="showPartyPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="txtProcessStartDate">
                    Process Start Date<sup>*</sup>
                </label>
                <div class="show-message">
                    <input id="txtProcessStartDate" name="Process Start Date" e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="data.InDate" e-width="100%" ng-model="ValueAddedContract.ProcessStartDate" required tabindex="10" />
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="txtProcessEndDate">
                    Process End Date<sup>*</sup>
                </label>
                <div class="show-message">
                    <input id="txtProcessEndDate" name="Process End Date" e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="data.InDate" e-width="100%" ng-model="ValueAddedContract.ProcessEndDate" required tabindex="11" />
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3">
            <div class="form-group" show-errors>
                <label class="control-label" for="txtContractClosingDate">
                    Contract Closing Date<sup>*</sup>
                </label>
                <div class="show-message">
                    <input id="txtContractClosingDate" name="Contract Closing Date" e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="data.InDate" e-width="100%" ng-model="ValueAddedContract.ContractClosingDate" required tabindex="12" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <div class="form-group">
                <label class="control-label" for="txtRemarks">Remarks</label>
                <input type="text" id="txtRemarks" name="Contract Closing Date" class="form-control" ng-model="ValueAddedContract.Remarks" required tabindex="13" />
            </div>
        </div>
    </div>
    <div class="row" style="margin-top: 15px;">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="MaterialPlanning" role="tab" data-toggle="tab">Material Planning</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="MaterialInput" role="tab" data-toggle="tab">Material Input</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div id="MaterialPlanning">
                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top: 0px;">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li><button ng-click="AddNewMaterialPlanning();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Material Planning</button></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-12 col-lg-12">
                                <div class="table-responsive modal-table table-wrapper-scroll-y my-custom-scrollbar">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th ng-hide="true">Id</th>
                                                <th ng-hide="true">JobWorkMaterialMasterId</th>
                                                <th>Job Work Material</th>
                                                <th>Specification</th>
                                                <th>Material Ref</th>
                                                <th>UOM</th>
                                                <th>Quantity</th>
                                                <th ng-hide="true">MaterialMasterId</th>
                                                <th>Material Code</th>
                                                <th>Order Specific</th>
                                                <th>Required Capacity/Day</th>
                                                <th>By Product Applicable</th>
                                                <th>Rate Apply</th>
                                                <th ng-hide="true">CurrencyId</th>
                                                <th>Currency</th>
                                                <th>Rate/Unit</th>
                                                <th>Rejection</th>
                                                <th>Value Loss</th>
                                                <th ng-hide="true">ResponsiblePersonId</th>
                                                <th>Responsible Person</th>
                                                <th>Remarks</th>
                                                <th>By Product List</th>
                                                <th>Requirements</th>
                                                <th>Attachment</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in materialPlanningList">
                                                <td ng-hide="true">{{x.Id}}</td>
                                                <td ng-hide="true">{{x.JobWorkMaterialMasterId}}</td>
                                                <td>{{x.JobWorkMaterialName}}</td>
                                                <td><input type="text" class="form-control" ng-model="x.MaterialSpecification" style="width: 100px;" /></td>
                                                <td><input type="text" class="form-control" ng-model="x.MaterialRef" style="width: 100px;" /></td>
                                                <td>{{x.UOM}}</td>
                                                <td><input type="text" class="form-control" ng-model="x.Quantity" style="width: 100px;" /></td>
                                                <td ng-hide="true">{{x.MaterialMasterId}}</td>
                                                <td>{{x.MaterialMasterName}}</td>
                                                <td>{{x.OrderSpecific}}</td>
                                                <td><input type="text" class="form-control" ng-model="x.RequiredCapacityPerDay" style="width: 100px;" /></td>
                                                <td>{{x.ByProductApplicable}}</td>
                                                <td>{{x.RateApply}}</td>
                                                <td ng-hide="true">{{x.CurrencyId}}</td>
                                                <td>{{x.Currency}}</td>
                                                <td><input type="text" class="form-control" ng-model="x.RatePerUnit" style="width: 100px;" /></td>
                                                <td><input type="text" class="form-control" ng-model="x.Rejection" style="width: 100px;" /></td>
                                                <td><input type="text" class="form-control" ng-model="x.ValueLoss" style="width: 100px;" /></td>
                                                <td ng-hide="true">{{x.ResponsiblePersonId}}</td>
                                                <td>{{x.ResponsiblePerson}}</td>
                                                <td><input type="text" class="form-control" ng-model="x.Remarks" style="width: 200px;" /></td>
                                                <td>
                                                    <ul class="list-inline action-list">
                                                        <li style="width: 100%;"><center><button ng-show="{{x.Id !='' && x.ByProductApplicable=='Yes'}}" ng-click="SetByProductApplicable($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="By Product List"><i class="glyphicon glyphicon-list"></i></button></center></li>
                                                    </ul>
                                                </td>
                                                <td>
                                                    <ul class="list-inline action-list">
                                                        <li style="width: 100%;"><center><button ng-show="{{x.Id !='' && x.OrderSpecific=='Yes'}}" ng-click="SetRequirements($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Order Wise Requirement"><i class="glyphicon glyphicon-list"></i></button></center></li>
                                                    </ul>
                                                </td>
                                                <td>
                                                    <ul class="list-inline action-list">
                                                        <li style="width: 100%;"><center><button ng-show="{{x.Id !=''}}" ng-click="SetAttachment($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Attachment"><i class="glyphicon glyphicon-upload"></i></button></center></li>
                                                    </ul>
                                                </td>
                                                <td class="text-right table-td" style="vertical-align: middle;">
                                                    <ul class="list-inline action-list">
                                                        <li><center><button ng-click="removeMaterialPlanning($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></center></li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div id="MaterialInput">
                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top: 0px;">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li><button ng-click="AddNewMaterialInput();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Material Input</button></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-12 col-lg-12">
                                <div class="table-responsive modal-table table-wrapper-scroll-y my-custom-scrollbar">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th ng-hide="true">Id</th>
                                                <th ng-hide="true">JobWorkTransformationContractId</th>
                                                <th ng-hide="true">JobWorkMaterialId</th>
                                                <th>Job Work Material</th>
                                                <th>Specification</th>
                                                <th>UOM</th>
                                                <th>Net Consumption</th>
                                                <th>Rejection</th>
                                                <th>Value Loss</th>
                                                <th>Gross Consumption</th>
                                                <th ng-hide="true">ResponsiblePersonId</th>
                                                <th>Responsible Person</th>
                                                <th>Remarks</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in materialInputList">
                                                <td ng-hide="true">{{x.Id}}</td>
                                                <td ng-hide="true">{{x.JobWorkTransformationContractId}}</td>
                                                <td ng-hide="true">{{x.JobWorkMaterialId}}</td>
                                                <td>{{x.JobWorkMaterialName}}</td>
                                                <td>{{x.MaterialSpecification}}</td>
                                                <td>{{x.UOM}}</td>
                                                <td>{{x.NetConsumption}}</td>
                                                <td>{{x.Rejection}}</td>
                                                <td>{{x.ValueLoss}}</td>
                                                <td>{{x.GrossConsumption}}</td>
                                                <td ng-hide="true">{{x.ResponsiblePersonId}}</td>
                                                <td>{{x.ResponsiblePerson}}</td>
                                                <td>{{x.Remarks}}</td>
                                                <td class="text-right table-td" style="vertical-align: middle;">
                                                    <ul class="list-inline action-list">
                                                        <li><center><button ng-disabled="{{x.Id==''}}" ng-click="EditMaterialInput($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></button></center></li>
                                                        <li><center><button ng-click="removeMaterialInput($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></center></li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-12 col-lg-12" style="padding-top: 20px;">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ValueAddedContract.Id==''?'Save':'Update'}}</button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    <li> <button ng-click="Cancel();" class="btn"><i class="glyphicon glyphicon-remove-circle"></i> Cancel</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12" style="padding-top: 0px;">
            <div id="GridData" ej-grid e-datasource="gridDataList" e-gridlines="vertical" e-templaterefresh="refreshGridGridElementCode"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowResizing="true"
                 e-allowTextWrap="true"
                 e-allowscrolling="true"
                 e-minheight="400px"
                 e-height="400px"
                 e-filtersettings-filterType="excel"
                 e-enabletouch="true"
                 e-responsive="true"
                 e-recorddoubleclick="recorddoubleclick">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                    <div e-column e-field="ProcessTypeId" e-headertext="Process Type" e-width="100"></div>
                    <div e-column e-field="ContractDate" e-headertext="Contract Date" e-width="100"></div>
                    <div e-column e-field="ContractTime" e-headertext="Contract Time" e-width="100"></div>
                    <div e-column e-field="PlantId" e-headertext="Plant" e-width="100"></div>
                    <div e-column e-field="EntityId" e-headertext="Entity" e-width="100"></div>
                    <div e-column e-field="JobWorkLocationId" e-headertext="Material Location" e-width="100"></div>
                    <div e-column e-field="MaterialType" e-headertext="Material Type" e-width="100"></div>
                    <div e-column e-field="PartyId" e-headertext="Vender / Party" e-width="100"></div>
                    <div e-column e-field="ProcessStartDate" e-headertext="Process Start Date" e-width="100"></div>
                    <div e-column e-field="ProcessEndDate" e-headertext="Process End Date" e-width="100"></div>
                    <div e-column e-field="ContractClosingDate" e-headertext="Contract Closing Date" e-width="100"></div>
                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                    <div e-column e-template="#GridActions" e-width="75" textAlign='center'></div>
                </div>
            </div>
            <script type="text/template" id="GridActions">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnDelete">
                    <i class="fa fa-trash" title="Delete Data" ng-click="$parent.DeleteSelectedData('GridData');" style="margin: -6px;"></i>
                </button>
            </script>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="modalMaterialPlanning" role="dialog" data-backdrop="static">
    <div class="modal-dialog" style="width:75%">
        <div class="modal-content modal-lg" style="width:100%">
            <div class="modal-header">Material Planning<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="form-elements form-horizontal" ng-form name="frmMaterialPlanning">
                    <div class="row">
                        <div class="col-sm-12 col-md-3 col-lg-3">
                            <div class="form-group show-errors">
                                <label class="control-label">Material Planning<sup>*</sup></label>
                                <div class="show-message">
                                    <div class="select-style">
                                        <select id="ddlJobWorkMaterialMasterId" name="JobWorkMaterialMasterId" tabindex="3" class="form-control" submit-required="true" ng-model="MaterialPlanning.JobWorkMaterialMasterId" ng-options="item.Id as item.ItemName for item in valueAddedMasterItemList" required ng-change="LoadItemDetails()"></select>
                                    </div>
                                    <input type="hidden" name="Id" ng-model="MaterialPlanning.Id" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-3 col-lg-3">
                            <div class="form-group show-errors">
                                <label class="control-label">Material Specification<sup>*</sup></label>
                                <div class="show-message">
                                    <input type="text" id="txtMaterialSpecification" name="Material Specification" tabindex="4" class="form-control" required ng-model="MaterialPlanning.MaterialSpecification" value="" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-3 col-lg-3">
                            <div class="form-group show-errors">
                                <label class="control-label">Material Ref<sup>*</sup></label>
                                <div class="show-message">
                                    <input type="text" id="txtMaterialRef" name="Material Ref" tabindex="5" class="form-control" required ng-model="MaterialPlanning.MaterialRef" value="" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-3 col-lg-3">
                            <div class="form-group show-errors">
                                <label class="control-label">UOM<sup>*</sup></label>
                                <div class="show-message">
                                    <input type="text" id="txtUOM" name="UOM" tabindex="6" class="form-control" required ng-model="MaterialPlanning.UOM" value="" readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12 col-md-3 col-lg-3">
                            <div class="form-group show-errors">
                                <label class="control-label">Quantity<sup>*</sup></label>
                                <div class="show-message">
                                    <input type="text" id="txtQuantity" name="Quantity" tabindex="7" n-decimals="2" class="form-control" required ng-model="MaterialPlanning.Quantity" value="" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-3 col-lg-3">
                            <div class="form-group show-errors">
                                <label class="control-label">Article Code<sup>*</sup></label>
                                <div class="show-message">
                                    <div class="show-message">
                                        <div class="input-group">
                                            <input type="text" ng-model="MaterialPlanning.MaterialMasterName" class="form-control" readonly required />
                                            <input type="hidden" id="txtMaterialMasterId" name="txtMaterialMasterId" ng-model="MaterialPlanning.MaterialMasterId" />
                                            <span class="input-group-btn">
                                                <button tabindex="5" ng-click="getMaterialMasterbyTypePopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-3 col-lg-3">
                            <div class="form-group" show-errors>
                                <label class="control-label" for="ddlType">Order Specific<sup>*</sup></label>
                                <div class="show-message">
                                    <div class="select-style">
                                        <div class="select-style">
                                            <select id="ddlOrderSpecific" name="OrderSpecific" tabindex="9" class="form-control" submit-required="true" ng-model="MaterialPlanning.OrderSpecific" ng-options="item.name as item.name for item in orderSpecificList" required></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-3 col-lg-3">
                            <div class="form-group show-errors">
                                <label class="control-label">Required Capacity/Day<sup>*</sup></label>
