
<togglable name={{title}}></togglable>
<div class="form-elements" ng-form name="jobWorkActivity" id="jobWorkActivity">
    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Sequence" ng-model="JobWorkActivity.Sequence" class="form-control" required placeholder="0.00" tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="StandardName" maxlength="50" ng-model="JobWorkActivity.StandardName" class="form-control" required tabindex="4" autocomplete="off">
                <input type="hidden" name="txtId" ng-model="JobWorkActivity.Id" />
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="JobWorkActivity.Remarks" name="Description" maxlength="250" tabindex="9" ng-trim="false"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sequence" ng-model="JobWorkActivity.Code" class="form-control" required tabindex="2" autocomplete="off">
            </div>
        </div>


        <div class="form-group">
            <label class="col-sm-4 control-label">UserName</label>
            <div class="col-sm-8">
                <input type="text" name="UserName" maxlength="50" ng-model="JobWorkActivity.UserName" class="form-control" required tabindex="5" autocomplete="off">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">JobWork</label>
            <div class="col-sm-2">
                <div class="checkbox-site">
                    <label>
                        <input tabindex="8" type="checkbox" ng-model="JobWorkActivity.IsJobWork">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-4 control-label">Outsource</label>
            <div class="col-sm-2">
                <div class="checkbox-site">
                    <label>
                        <input tabindex="8" type="checkbox" ng-model="JobWorkActivity.IsOutsource">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="form-group">
                <label class="col-sm-4 control-label">Active/In-Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input tabindex="8" type="checkbox" ng-model="JobWorkActivity.IsActive">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">ShortName<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="ShortName" maxlength="50" ng-model="JobWorkActivity.ShortName" class="form-control" required tabindex="3" autocomplete="off">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <div class="select-style">
                        <select name="Type" tabindex="6" class="form-control" submit-required="true" ng-disabled="DisableType" ng-model="JobWorkActivity.Type" ng-options="item.name as item.name for item in jobWorkActivityTypeList" required></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="input-group">
                    <input type="text" name="Responsible Person" ng-model="JobWorkActivity.ResponsiblePersonName" class="form-control" readonly />
                    <span class="input-group-btn">
                        <button ng-click="showResponsiblePersonListPopUp()" tabindex="7" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        <button ng-click="clearResponsiblePerson()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </span>
                </div>
            </div>
        </div>
        
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{JobWorkActivity.Id==null?'Save':'Update'}}</button></li>
            <li> <button ng-click="DeleteSelectedData();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    @*<div class="row">*@
    <div class="col-xs-12 col-sm-12 col-md-12" style="padding-top: 20px;">
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li><button ng-click="AddNewItem();" ng-disabled="JobWorkActivity.Id==null" class="btn"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i>Add JW Items</button></li>
            </ul>
        </div>
    </div>

    <div class="col-xs-12">
        <div style="color:black;" id="GridSelectedEmpCategoryTab" ej-grid e-datasource="SelectedEmpCategoryTabList"
             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
             e-allowselection="false" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-type="string" e-field="JobActivity" e-headertext="Job Activity Master" e-width="40"></div>
                <div e-column e-type="string" e-field="JobWorkItem" e-headertext="Job Work Item" e-width="40"></div>
                <div e-column e-type="string" e-field="UOM" e-headertext="UOM" e-width="40"></div>
                <div e-column e-type="string" e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="40"></div>
                <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material Master" e-width="40"></div>


                <div e-column e-template="#DeleteEmpCategoryTab" e-width="40"></div>
            </div>
        </div>

        <script type="text/template" id="DeleteEmpCategoryTab">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="$parent.ConfirmDeleteEmpCategoryTab(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                </ul>
            </div>
        </script>

    </div>

    @*</div>*@
</div>

<div class="aplos-grid-toggle">
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12" style="padding-top: 0px;">
            <div id="GridData" ej-grid e-datasource="gridDataList" e-gridlines="vertical" e-templaterefresh="refreshGridGridElementCode"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowResizing="true"
                 e-allowTextWrap="true"
                 e-allowscrolling="true"
                 e-filtersettings-filterType="excel"
                 e-enabletouch="true" e-responsive="true"
                 e-recorddoubleclick="recorddoubleclick">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                    <div e-column e-field="Sequence" e-headertext="Sequence" e-width="100" e-format="{0:n2}"></div>
                    <div e-column e-field="Code" e-headertext="Code" e-width="150"></div>
                    <div e-column e-field="ShortName" e-headertext="Short Name" e-width="150"></div>
                    <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="150"></div>
                    <div e-column e-field="UserName" e-headertext="User Define Name" e-width="150"></div>
                    <div e-column e-field="Type" e-headertext="Type" e-width="100"></div>
                    <div e-column e-field="ResponsiblePersonName" e-headertext="Responsible Person" e-width="150"></div>
                    <div e-column e-field="IsActive" e-headertext="Is Active" e-width="100"></div>
                    <div e-column e-field="IsOutsource" e-headertext="Is Outsource" e-width="100"></div>
                    <div e-column e-field="IsJobWork" e-headertext="Is JobWork" e-width="100"></div>
                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="200"></div>
                    <div e-column e-template="#GridActions" e-width="75" textAlign='center'></div>
                </div>
            </div>
            <script type="text/template" id="GridActions">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn btnDelete">
                    <i class="fa fa-trash" title="Delete Data" ng-click="$parent.DeleteSelectedData('GridData');" style="margin: -6px;"></i>
                </button>
            </script>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="EmpCatTabPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Job Work Items List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridEmpCatTab" ej-grid e-datasource="EmpCatList"
                             e-allowfiltering="true" e-allowpaging="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-template="#checkedEmpCatTabItem" e-width="20"></div>

                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="140"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="Job Work Item Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="40"></div>
                                <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material Master" e-width="80"></div>
                                <div e-column e-type="string" e-field="UOM" e-headertext="UOM" e-width="80"></div>

                            </div>

                        </div>
                        <script type="text/template" id="checkedEmpCatTabItem">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.isSelected" e-checked="data.isSelected" />
                        </script>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="SaveEmpCatTab();closeEmpCatTabPopUp('EmpCatTabPopUp');" class="btn"><i class=""></i> Save</button>
                            <button ng-click="closeEmpCatTabPopUp('EmpCatTabPopUp');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Employees/Views/Shared/_ResponsiblePersonPopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterByTypePopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterArticleSearchPopUp.cshtml")
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="removerPopUp" title="Confirmation" message={{message}} data-ng-click-right-button="removeChildRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDelEmpCatPopUp" title="Confirmation" message="Are you sure want to Delete?" data-ng-click-right-button="DelActivityChild();"></confirm-archive-generic>


