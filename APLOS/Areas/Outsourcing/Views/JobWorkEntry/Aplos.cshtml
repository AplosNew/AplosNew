<togglable name={{title}}></togglable>
<div style="padding:0px;">
    <div class="form-elements form-horizontal" ng-form name="jobWorkItem">
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtCode">
                        Sequence<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtSequence" name="Sequence" class="form-control" ng-model="JobWorkItem.Sequence" required tabindex="1" />
                        <input type="hidden" id="txtId" name="txtId" ng-model="JobWorkItem.Id" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtCode">
                        CustomerInvNo<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtCode" name="CustomerInvoiceNo" class="form-control" ng-model="JobWorkItem.CustomerInvoiceNo" required tabindex="2" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtShortName">
                        CustomerInvDate<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtShortName" name="CustomerInvoiceDate" datepicker class="form-control" ng-model="JobWorkItem.CustomerInvoiceDate" required tabindex="3" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtStandardName">
                        Customer Name<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtStandardName" name="Customer Name" class="form-control" ng-model="JobWorkItem.CustomerName" required tabindex="4" />
                    </div>
                </div>
            </div>            
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtUserName">
                        Article<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtUserName" name="Article" class="form-control" ng-model="JobWorkItem.Article" required tabindex="5" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtUserName">
                        Lot<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtUserName" name="Lot" class="form-control" ng-model="JobWorkItem.Lot" required tabindex="5" />
                    </div>
                </div>
            </div>

            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtUserName">
                        Shade<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="text" id="txtUserName" name="Shade" class="form-control" ng-model="JobWorkItem.Shade" required tabindex="5" />
                    </div>
                </div>
            </div>

            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtUserName">
                        Quantity<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="number" id="txtUserName" name="Quantity" class="form-control" ng-model="JobWorkItem.Quantity" required tabindex="5" />
                    </div>
                </div>
            </div>



        </div>
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtUserName">
                        Material Value<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="number" id="txtUserName" name="Material Value" class="form-control" ng-model="JobWorkItem.MaterialValue" required tabindex="5" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtUserName">
                        Tax Value<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="number" id="txtUserName" name="Tax Value" class="form-control" ng-model="JobWorkItem.TaxValue" required tabindex="5" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group" show-errors>
                    <label class="control-label" for="txtUserName">
                        Total Value<sup>*</sup>
                    </label>
                    <div class="show-message">
                        <input type="number" id="txtUserName" name="Total Value" class="form-control" ng-model="JobWorkItem.TotalValue" required tabindex="5" />
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <div class="row">
                        <label class="col-sm-12 control-label">Gate Entry No<sup>*</sup></label>
                        <div class="col-sm-12">
                            <div class="input-group">
                                <span class="input-group-addon">{{JobWorkItem.GateEntryNo}}</span>
                                <input type="text" ng-model="JobWorkItem.Party" class="form-control" readonly>
                                <input type="hidden" ng-model="JobWorkItem.GateEntryNo" />
                                <span class="input-group-btn">
                                    <button ng-click="MaterialMstPopUp()" tabindex="8" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                    <button ng-click="MaterialMstClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <label class="control-label">HSN</label>
                    <input type="text" name="Remarks" tabindex="5" class="form-control" ng-model="JobWorkItem.Remarks" />
                </div>
            </div>

            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="form-group">
                    <label class="control-label">Begs</label>
                    <input type="number" name="Begs" tabindex="5" class="form-control" ng-model="JobWorkItem.Begs" />
                </div>
            </div>
        </div>
        <div class="common-btn" style="padding-top: 20px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{JobWorkItem.Id==null?'Save':'Update'}}</button></li>
                <li> <button ng-click="Delete();" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>                
            </ul>
        </div>
    </div>
    <div class="aplos-grid-toggle">
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12" style="padding-top: 0px;">
                <div id="GridData" ej-grid e-datasource="gridDataList" e-gridlines="vertical" e-templaterefresh="refreshGridGridElementCode"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-allowsorting="true"
                     e-allowResizing="true"
                     e-allowTextWrap="true"
                     e-allowscrolling="true"
                     e-filtersettings-filterType="excel"
                     e-enabletouch="true" e-responsive="true"
                     e-recorddoubleclick="recorddoubleclick">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-width="100" e-format="{0:n2}"></div>
                        <div e-column e-field="GateEntryNo" e-headertext="GateEntryNo" e-width="100"></div>
                        <div e-column e-field="CustomerInvoiceNo" e-headertext="CustomerInvNo" e-width="150"></div>
                        <div e-column e-field="CustomerInvoiceDate" e-headertext="CustomerInvDate" e-width="150"></div>
                        <div e-column e-field="CustomerName" e-headertext="Customer Name" e-width="150"></div>
                        <div e-column e-field="Article" e-headertext="Article" e-width="150"></div>
                        <div e-column e-field="Lot" e-headertext="Lot" e-width="150"></div>
                        <div e-column e-field="Shade" e-headertext="Shade" e-width="120"></div>
                        <div e-column e-field="Quantity" e-headertext="Quantity" e-width="150"></div>
                        <div e-column e-field="MaterialValue" e-headertext="MaterialValue" e-width="150"></div>
                        <div e-column e-field="TaxValue" e-headertext="TaxValue" e-width="150"></div>
                        <div e-column e-field="TotalValue" e-headertext="TotalValue" e-width="150"></div>
                        <div e-column e-field="Remarks" e-headertext="Remarks" e-width="200"></div>
                        <div e-column e-field="Begs" e-headertext="Begs" e-width="200"></div>
                        <div e-column e-template="#GridActions" e-width="75" textAlign='center'></div>
                    </div>
                </div>
                 <script type="text/template" id="GridActions">
        
     </script>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Employees/Views/Shared/_ResponsiblePersonPopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterByTypePopUp.cshtml")
@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterArticleSearchPopUp.cshtml")
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message="Are you sure want to Delete?" data-ng-click-right-button="removeRow()"></confirm-archive-generic>

<div class="modal fade site-modal in" id="EmployeePopUpResPerson" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Gate Entry List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridEmployeeResPerson" ej-grid e-datasource="EmpResPersonList"
                             e-allowfiltering="true" e-recorddoubleclick="setEmpData" e-allowpaging="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-type="string" e-field="GateEntryNo" e-headertext="GateEntryNo" e-width="60"></div>
                                <div e-column e-type="string" e-field="GateEntryDate" e-headertext="GateEntryDate" e-width="40"></div>
                                <div e-column e-type="string" e-field="Quantity" e-headertext="Quantity" e-width="40"></div>
                                <div e-column e-type="string" e-field="Party" e-headertext="Party" e-width="100"></div>
                                <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                                @*<div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>*@
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeEmpResPersonPopUp('EmployeePopUpResPerson');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="ApprovedPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> Responsible Person List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <div style="color:black;" id="GridApprovedBy" ej-grid e-datasource="ApprovedByList"
                             e-allowfiltering="true" e-recorddoubleclick="setApprovedByData" e-allowpaging="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="40"></div>
                                <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="PositionName" e-headertext="Position" e-width="140"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-type="string" e-field="DepartmentName" e-headertext="Department Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeapprovedbyPopUp('ApprovedPopUp');" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

