<style>
	.modellgModify {
		width: 1000px;
	}
</style>
<div class="modal fade site-modal in" id="PSProcessPopUp" role="dialog" data-backdrop="static">
	<div class="modal-dialog modal-lg modellgModify">
		<div class="modal-content" style="overflow:scroll">
			<div class="modal-header" style="width:1960px;"> Material Stock<button type="button" class="close" data-dismiss="modal">&times;</button></div>

            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">OSTCMasterId<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modalSpecificOSTCMasterId" class="form-control" readonly tabindex="2">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Material<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modalSpecificMaterialName" class="form-control" readonly tabindex="2">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">OSOutputItem<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modalSpecificOSOutputItem" class="form-control" readonly tabindex="2">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Article<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modalSpecificArticleName" class="form-control" readonly tabindex="2">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">OSInputItem<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modalSpecificOSInputItem" class="form-control" readonly tabindex="2">
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-md-12">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped" style="font-size: 12px;white-space: nowrap; ">
                            <thead>
                                <tr>
                                    <th ng-hide="productNew.Id!=null">Select</th>
                                    <th>Material Type</th>
                                    <th>Material</th>
                                    <th>Article</th>
                                    <th>LotNumber</th>
                                    <th>Process</th>
                                    <th>ProductionSummaryId</th>
                                    <th>Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in materialStockList">
                                   
                                    <td ng-hide="productNew.Id!=null">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>{{x.MaterialType}}</td>
                                    <td>{{x.MaterialMaster}}</td>
                                    <td>{{x.Article}}</td>
                                    <td>{{x.LotNumber}}</td>
                                    <td>{{x.Process}}</td>
                                    <td>{{x.ProductionSummaryId}}</td>
                                    <td>{{x.RequisitionQty}}</td>
                                </tr>
                                <tr>
                                    <td colspan="7" class="text-right"><strong>Total : </strong></td>
                                    <td class="text-left"><strong>{{materialStockList | sumByKey : 'RequisitionQty' }}</strong></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                    <div class="common-btn">
                        <ul class="list-inline text-left" @*style="width:1960px;"*@>
                            <li><button ng-hide="productNew.Id!=null" ng-click="addProductionSummaryItem();" class="btn"><i class="glyphicon glyphicon-plus"></i> Submit</button></li>
                            <li><button @*ng-hide="productNew.Id==null"*@ ng-click="closePSProcessPopUp();" class="btn">Close</button></li>
                        </ul>
                    </div>
                </div>
            </div>
	</div>
</div>