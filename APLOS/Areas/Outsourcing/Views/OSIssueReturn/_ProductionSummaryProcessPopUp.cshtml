<style>
	.modellgModify {
		width: 1000px;
	}
</style>
<div class="modal fade site-modal in" id="PSProcessPopUp" role="dialog" data-backdrop="static">
	<div class="modal-dialog modal-lg modellgModify">
		<div class="modal-content" style="overflow:scroll">
			<div class="modal-header"> Material Stock<button type="button" class="close" data-dismiss="modal">&times;</button></div>

            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">OSTCMasterId<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modalSpecificOSTCMasterId" class="form-control" readonly tabindex="2">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Material<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modalSpecificMaterialName" class="form-control" readonly tabindex="2">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">OSOutputItem<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modalSpecificOSOutputItem" class="form-control" readonly tabindex="2">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Article<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modalSpecificArticleName" class="form-control" readonly tabindex="2">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">OSInputItem<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="modalSpecificOSInputItem" class="form-control" readonly tabindex="2">
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
              
                <div class="modal-body form-elements form-horizontal">
                    <div class="col-md-12">
                        <div class="content-container-fluid">
                            <div style="color:black;overflow:scroll" id="GRNGrid" ej-grid e-datasource="materialStockList" e-templaterefresh="refreshTemplate"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true" e-allowscrolling="true">
                                <div e-columns>
                                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                                    <div e-column e-field="MaterialType" e-headertext="Type" e-width="70" e-filter="false"></div>
                                    <div e-column e-field="MaterialMaster" e-headertext="MaterialMaster" e-width="180"></div>
                                    <div e-column e-field="Article" e-headertext="Article" e-width="80"></div>
                                    <div e-column e-field="SKU1" e-headertext="SKU1" e-width="70" e-format="{0:dd-MMM-yyyy}" type="date"></div>
                                    <div e-column e-field="SKU2" e-headertext="SKU2" e-width="80"></div>
                                    <div e-column e-field="LotNumber" e-headertext="LotNumber" e-width="50"></div>
                                    <div e-column e-field="Process" e-headertext="Process" e-width="80" textAlign='Right'></div>
                                    <div e-column e-field="Source" e-headertext="Source" e-width="80" textAlign='Right'></div>
                                    <div e-column e-field="ProductionSummaryId" e-headertext="ProductionSummary" e-width="80" textAlign='Right'></div>
                                    <div e-column e-field="RequisitionQty" e-headertext="RequisitionQty" e-width="100" e-type='string'></div>
                                </div>
                            </div>
                            <script type="text/template" id="checkboxTemplate">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                            </script>
                            <script type="text/x-jsrender" id="headerTemplate">
                                <input type="checkbox" id="headchk" />
                            </script>
                        </div>
                    </div>
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-hide="productNew.Id!=null" ng-click="addProductionSummaryItem();" class="btn"><i class="glyphicon glyphicon-plus"></i> Submit</button></li>
                        <li><button ng-click="closePSProcessPopUp();" class="btn">Close</button></li>
                    </ul>
                </div>
              
            </div>
            </div>
	</div>
</div>