<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal">
    <div ng-form name="ModelNewForm">
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100%" required />
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Description" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="row">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Detail</a></li>
            </ul>
        </div>

        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="ModelNewChildForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Task Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Task Name" ng-model="ModelChildNew.Task" class="form-control" required tabindex="4" maxlength="100">
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Leg Days<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="LegDays" ng-model="ModelChildNew.LegDays" only-numbers class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Responsible Person</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <span class="input-group-addon">{{ModelChildNew.ResponsiblePersonCode}}</span>
                                    <input type="text" name="ResponsiblePersonName" ng-model="ModelChildNew.ResponsiblePerson" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="GetByWhomPopupData()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="ModelChildNew.Remarks" maxlength="250" tabindex="6"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Dependant Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Dependant Date" ng-model="ModelChildNew.DependantDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Task Dependant Leg Days<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Task Dependant Leg Days" ng-model="ModelChildNew.TaskDependantLegDays" only-numbers class="form-control" required tabindex="5" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Dependant Task</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <span class="input-group-addon">{{ModelChildNew.DependantTaskDetailId}}</span>
                                    <input type="text" name="By Whom" ng-model="ModelChildNew.TaskName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button name="submit" ng-click="getDependantTaskData()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>


                        

                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveChild();" ng-disabled="ModelNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                            <li> <button ng-click="ClearChild();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>

                    <div id="GridChildEdit" ej-grid e-datasource="ChildModelList" e-recorddoubleclick="GetChild"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                            <div e-column e-field="Task" e-headertext="Task" e-width="2"></div>
                            <div e-column e-field="DependantDate" e-headertext="Dependant Date"  e-format="{0:dd-MMM-yyyy}" e-type="string" e-width="2"></div>
                            <div e-column e-field="LegDays" e-headertext="LegDays" e-width="3"></div>
                            <div e-column e-field="TaskDependantLegDays" e-headertext="TaskDependantLegDays" e-width="5"></div>
                            <div e-column e-field="ResponsiblePerson" e-headertext="ResponsiblePerson" e-width="5"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="DependantPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Dependant Task List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridDPopUp" ej-grid e-datasource="DependantTaskList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="selectdblClickDependant" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                            <div e-column e-field="Task" e-headertext="Task" e-width="2"></div>
                            <div e-column e-field="DependantDate" e-headertext="Dependant Date" e-width="2"></div>
                            <div e-column e-field="LegDays" e-headertext="LegDays" e-width="3"></div>
                            <div e-column e-field="TaskDependantLegDays" e-headertext="TaskDependantLegDays" e-width="5"></div>
                            <div e-column e-field="ResponsiblePerson" e-headertext="ResponsiblePerson" e-width="5"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="EmpPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee Information
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridEmpPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="selectdblClick" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="Pic" e-template="#empimage" e-textalign="center" e-width="40"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>