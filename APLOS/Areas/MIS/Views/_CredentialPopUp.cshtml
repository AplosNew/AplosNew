
<style>
    .modellgModify {
        width: 400px;
    }
</style>
<div class="modal fade site-modal in" id="biCredentialPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> BI Credentials <button type="button" class="close" ng-click="closeViewCredential();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-6 control-label">UserId</label>
                        <div class="col-sm-6 show-message">
                            <div class="input-group">
                                <span class="input-group-btn">
                                    <button ng-click="copyUserId()" class="btn single-small-btn">Copy</button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-6 control-label">Password</label>
                        <div class="col-sm-6 show-message">
                            <div class="input-group">
                                <span class="input-group-btn">
                                    <button ng-click="copyPassword()" class="btn single-small-btn">Copy</button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button type="button" class="btn btn-default" data-dismiss="modal">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>