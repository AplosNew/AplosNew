@*<togglable name="Payment Mode Change"></togglable>*@
<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Payment Mode Change
</h3>



<div class="form-elements" ng-form >
    <div class="row"></div>
    <div class="row">
        <div class="col-xs-12 col-sm-9 col-md-9 form-horizontal">
            <div class="row">
                <label class="col-md-1 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-3 show-message">
                    <input type="text" min="1" name="Sequence" ng-model="FromDate" class="form-control" datepicker placeholder="dd-MMM-yyyy" required tabindex="1">

                </div>

                <label class="col-md-1 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-3 show-message">
                    <input type="text" min="1" name="Sequence" ng-model="ToDate" class="form-control" datepicker placeholder="dd-MMM-yyyy" required tabindex="1">

                </div>


                <label class="col-md-2 control-label">Select Employee<sup>*</sup></label>
                <div class="col-md-2 show-message" style="margin-left:0px;padding-left:0px">
                    <button style="color: #f3f3ec;background-color: #1c1f32; " class="btn"><i class="glyphicon glyphicon-search" ng-click="getEmploymeeList()" style="margin: -4px;"></i></button>
                </div>

            </div>




        </div>
        <div class="col-xs-12 col-sm-3 col-md-3 form-horizontal">


            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Payment Mode<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="SalaryHeadFormula" class="form-control" ng-model="EmployeePaymentMode" name="EmployeePaymentMode" tabindex="1">
                            <option value="">--Select--</option>
                            <option value="Bank">Bank</option>
                            <option value="Check">Check</option>
                            <option value="Cash">Cash</option>
                            <option value="Transfer">Transfer</option>
                            @*<option ng-repeat="option in PaymentMode" value="{{option.UserName}}">{{option.UserName}}</option>*@
                        </select>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>
<div class="row">
    <div class="col-xs-12 col-sm-12 col-sm-12">

        <div style="color:black;"
             id="GridSelectedEmployeeInfoList"
             e-recorddoubleclick="SelectEmployee"
             ej-grid e-datasource="SelectedEmployeeList"
             e-gridlines="vertical"
             e-allowfiltering="true"
             e-allowpaging="true"
             e-allowsorting="true"
             e-allowselection="true"
             e-pagesettings-pagesize="25"
             e-filtersettings-filterType="excel" e-allowtouch="true">
            <div e-columns>

                <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>

                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="70"></div>
                <div e-column e-field="DOS" e-headertext="DOS" e-width="70"></div>

                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>



                <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-width="80"></div>
                <div e-column e-field="PaymentMode" e-headertext="PaymentMode" e-width="80"></div>
                <div e-column e-headertext="Actions" e-width="40">

                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.RemoveSelectedEmployeeList($event);" style="margin: -6px;"></i></button>

                </div>


            </div>
        </div>

    </div>


</div>





<div class="common-btn">
    <ul class="list-inline text-right">
        <li><button ng-click="SaveChangeData();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
        <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
    </ul>
</div>






<ej-dialog id="dialogEmployeeInfo"
           title=" Employee Information"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target=".site-heading"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="500" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">

            <div style="color:black;"
                 id="GridEmployeeInfoList"
                 e-recorddoubleclick="SelectEmployee"
                 ej-grid e-datasource="EmployeeList"
                 e-templaterefresh="refreshTemplateemployee4"
                 e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowselection="true"
                 e-pagesettings-pagesize="25"
                 e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>
                    <div e-column e-headertext="All" e-headertemplateid="#headerTemplate4" e-template="#checkboxTemplate4" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>

                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="70"></div>
                    <div e-column e-field="DOS" e-headertext="DOS" e-width="70"></div>
                    @*<div e-column e-field="DOBs" e-headertext="DOB" e-width="70"></div>*@
                    <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    @*<div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>*@


                    <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-width="80"></div>
                    <div e-column e-field="PaymentMode" e-headertext="PaymentMode" e-width="80"></div>

                    @*<div e-column e-field="DesignationGroupName" e-headertext="Designation Group" e-width="80"></div>*@
                    @*<div e-column e-field="CellPhnNo" e-headertext="Cell No" e-width="80"></div>*@
                    @*<div e-column e-field="PayRollGroupName" e-headertext="Payroll Group" e-width="80"></div>
                        <div e-column e-field="ApprovedStatus" e-headertext="Status" e-width="60"></div>*@
                </div>
            </div>
            <script type="text/template" id="checkboxTemplate4">
                @*<input type="checkbox" ng-model="data.WorkDate" class="rowCheckbox" enabled="data.IsLock" value="WorkDate" />*@
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>
            <script type="text/x-jsrender" id="headerTemplate4">
                <input type="checkbox" id="headchk4" />
                @*<input type="checkbox" ej-checkbox class="rowCheckbox" e-change="$parent.headCheckChangeemployee4" />*@
            </script>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="GetSelectedEmployeeList();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Select</button></li>

            </ul>
        </div>

    </div>

</ej-dialog>