<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Employee SalaryRule Editable</h3>

<div id="employeeSalaryRuleEditable" class="form-horizontal" ng-form name="employeeSalaryRuleEditableNewForm">
    <input type="hidden" ng-model="employeeSalaryRuleEditableOb.Id">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee Select</label>
            <div class="col-sm-8">
                <button name="Add" class="single-btn" ng-click="popUp();"><i class="glyphicon glyphicon-search"></i></button>
            </div>
        </div>
    </div>

    <div class="clearfix"></div>
    <div class="row form-elements">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>EmployeeId</th>
                            <th>EmployeeName</th>
                            <th>BudgetCode</th>
                            <th>Remove</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in employeeSalaryRuleEditableSelectedList">
                            <td>{{x.EmployeeId}}</td>
                            <td>{{x.EmployeeName}}</td>
                            <td>{{x.BudgetCode}}</td>
                            <td class="text-right">
                                <button ng-click="valuePassInDelModal($index,x)" class="btn-action tooltip-here"
                                        data-placement="top" title="Delete">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic data-modalid="confirmDocumentdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Budget Code</th>
                                <th>Given Designation</th>
                                <th>Department</th>
                                <th>Section</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-dblclick="selectdblClick(x);" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.BudgetCode}}</td>
                                <td>{{x.GivenDesignation}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'employeeList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEmployeeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button data-dismiss="modal" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>
