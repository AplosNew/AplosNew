<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Document Assignment
</h3>
<div ng-form name="preRecruitmentEmployeeForm" class="form-horizontal form-element-ctrl">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Date" ng-model="modalNew.FromDate" datepicker class="form-control" disabled required tabindex="4">

                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Employee Category<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <input id="EmpCategoryDropdown" ej-dropdownlist e-multiselectmode="visualmode"
                               e-datasource="EmpCatList" e-fields-value="Value"
                               e-fields-text="Text" e-width="100%" e-showcheckbox="true" />
                    </div>
                </div>
            </div>


        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Date" ng-model="modalNew.ToDate" datepicker class="form-control" disabled required tabindex="4">

                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                    <span class="input-group-addon">{{modalNew.EmployeeCode}}</span>
                    <input type="text" ng-model="modalNew.EmployeeName" class="form-control" readonly>
                    <span class="input-group-btn">
                        <button ng-click="getEmpPopUpData()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                        @*<button ng-click="clearEmployeeInfo()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>*@
                    </span>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div style="color:black;" id="GridDoc" ej-grid e-datasource="documentdataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="DocumentName" e-headertext="Document Name" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                    <div e-column e-field="OptionalOrMandatory" e-headertext="Optional Or Mandatory" e-width="80"></div>
                    <div e-column e-headertext="DueDate" e-template="#DueDate" e-textalign="center" e-width="30"></div>
                    <div e-column e-headertext="Applicable" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                </div>
            </div>
            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Applicable" />
            </script>
            <script type="text/template" id="DueDate">
                <input type="text" name="Due Date" ng-model="data.DueDate" datepicker class="form-control" tabindex="4">
            </script>
        </div>
        <div class="common-btn" style="margin-top:10px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="11"><i class="glyphicon glyphicon-save"></i> Save </button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-repeat"></i> Clear </button></li>

            </ul>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Employee Information<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                       e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="EmpSystemId" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                    <div class="common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="closePopUp();" class="btn">Close</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

