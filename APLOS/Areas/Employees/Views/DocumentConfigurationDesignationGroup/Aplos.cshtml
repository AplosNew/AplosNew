<togglable name="Document Set Assignment"></togglable>
<div class=" form-horizontal" ng-form id="documentConfigurationDesignationGroupNew" name="documentConfigurationDesignationGroupForm">
    <input type="hidden" ng-model="documentConfigurationDesignationGroupNew.Id">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="documentConfigurationDesignationGroupNew.CompanyId" id="plant" ng-options="item.Value as item.Text for item in companyList"
                            name="Company" required tabindex="4" ng-change="getPlantList()">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="documentConfigurationDesignationGroupNew.PlantId" id="plant" ng-options="item.Value as item.Text for item in plantList"
                            name="Plant" required tabindex="4" ng-change="getData()">
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" id="employeeTypeId" ng-model="documentConfigurationDesignationGroupNew.EmployeeCategoryId" ng-options="item.Value as item.Text for item in employeeTypeList"
                                name="Employee Type" tabindex="4" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Document Set<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="hidden" ng-model="documentConfigurationDesignationGroupNew.ComplianceDocumentSetId" class="form-control" disabled>
                        <input type="text" name="ComplianceDocumentSetName" ng-model="documentConfigurationDesignationGroupNew.ComplianceDocumentSetName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="complianceDocumentPopUp();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearComplianceDocument()" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Responsible Person By<sup>*</sup></label>
                <div class="col-sm-8">
                    Document Set <input type="radio" ng-model="documentConfigurationDesignationGroupNew.ResponsiblePersonBy" ng-change="clearDocument();" value="DocumentSet">
                    Document <input type="radio" ng-model="documentConfigurationDesignationGroupNew.ResponsiblePersonBy" ng-change="clearDocumentSet();" value="Document">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employment Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" id="EmploymentType" ng-model="documentConfigurationDesignationGroupNew.EmploymentType" ng-options="item.Value as item.Text for item in EmploymentTypeList"
                                name="Employee Type" tabindex="4" required>
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" ng-hide="documentConfigurationDesignationGroupNew.ResponsiblePersonBy==='Document'">
                <label class="col-sm-4 control-label">Responsible Person</label>
                <div class="col-sm-8">
                    <div class="input-group">
                        <input type="hidden" ng-model="documentConfigurationDesignationGroupNew.ResponsiblePersonId" class="form-control" disabled>
                        <input type="text" name="ResponsiblePersonName" ng-model="documentConfigurationDesignationGroupNew.ResponsiblePersonName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="ShowEmployeeListPopUp(null);" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearResponsiblePerson(null)" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix" style="padding-top:38px;"></div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="table-responsive modal-table" ng-show="complianceDocumentConfigurationList.length>0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Document Name</th>
                            <th>Document Type</th>
                            <th>Responsible Person</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in complianceDocumentConfigurationList">
                            <td>{{x.ComplianceDocumentName}}</td>
                            <td>{{x.DocumentType}}</td>
                            <td>
                                <div class="col-sm-8 input-group">
                                    <input type="hidden" ng-model="x.ResponsiblePersonId" class="form-control" disabled>
                                    <input type="text" ng-model="x.ResponsiblePersonName" class="col-sm-2 form-control" disabled>
                                    <span class="input-group-btn">
                                        <button class="btn single-small-btn" style="margin-top:-5px;margin-bottom:-5px;" ng-click="ShowEmployeeListPopUp($index)">
                                            <i class="cr-icon glyphicon glyphicon-search"></i>
                                        </button>
                                        <button class="btn single-small-btn" ng-click="clearResponsiblePerson($index)" style="margin-top:-5px;margin-bottom:-5px;"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Compliance DocumentSet</th>
                        <th>Employee Category</th>
                        <th>Employment Type</th>
                    </tr>
                </thead>
                <tbody>
                    <tr dir-paginate="x in documentConfigurationDesignationGroups |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                        <td>{{x.ComplianceDocumentSet}}</td>
                        <td>{{x.EmployeeCategory}}</td>
                        <td>{{x.EmploymentType}}</td>
                    </tr>
                </tbody>
            </table>
            <dir-pagination-controls max-size="10"
                                     direction-links="true"
                                     boundary-links="true"
                                     on-page-change="getData(newPageNumber)">
            </dir-pagination-controls>
        </div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="complianceDocumentPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">ComplianceDocument Informations</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="complianceDocumentParameters.searchBy">
                                            <option ng-repeat="option in complianceDocumentSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="complianceDocumentParameters.search" ng-enter="getComplianceDocumentData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getComplianceDocumentData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" ng-show="complianceDocumentDataList.length">
                        <thead>
                            <tr>
                                <th>User Name</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in complianceDocumentDataList|itemsPerPage:complianceDocumentParameters.pageSize" total-items="complianceDocumentParameters.total_count" pagination-id="metaData.name + 'complianceDocumentDataList'" ng-dblclick="selectComplianceDocumentPopUp(x);">
                                <td>{{x.UserName}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'complianceDocumentDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getComplianceDocumentData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <ul class="list-inline text-right">
                    <li> <button type="button" class="btn btn-default" ng-click="closeComplianceDocumentPopUp();">Close</button></li>
                    <li> <button ng-click="selectComplianceDocumentPopUp();" class="btn">Select</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search"  ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-click="selectEmployeePopUp($index, x.SystemId)" ng-class="{unsaveRow : x.SystemId == selectedEmployee}" ng-dblclick="selectEmployeedblClick(x);" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DateOfBirth}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'employeeList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEmployeeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmgenericPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="deleteDocumentRow()"></confirm-archive-generic>