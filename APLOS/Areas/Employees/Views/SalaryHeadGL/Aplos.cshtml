                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="salaryHeadGL.DrInDirectBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in InDirectBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getInDirectActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="salaryHeadGL.DrInDirectActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in InDirectActivityList" id="ActivityId"
                                        name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>


                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">Other GL Code<sup></sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="salaryHeadGL.DrInDirectOtherGLCode" class="form-control" @* required tabindex="5"*@ maxlength="20">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">Other GL<sup></sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="salaryHeadGL.DrInDirectOtherGL" class="form-control" @* required tabindex="5"*@ maxlength="50">
                        </div>
                    </div>
                </fieldset>


            </div>
            <div class="clearfix"></div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Cr Direct</legend>

                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL</label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control col-sm-6" ng-model="CrDirectGLInfo" readonly>
                        </div>
                        <button name="submit" class="single-btn" ng-click="GetCrDirectGLList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshCrDirectGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="salaryHeadGL.CrDirectBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in CrDirectBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getCrDirectActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="salaryHeadGL.CrDirectActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in CrDirectActivityList" id="ActivityId"
                                        name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>


                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">Other GL Code<sup></sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="salaryHeadGL.CrDirectOtherGLCode" class="form-control" @* required tabindex="5"*@ maxlength="20">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">Other GL<sup></sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="salaryHeadGL.CrDirectOtherGL" class="form-control" @* required tabindex="5"*@ maxlength="50">
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Cr In Direct </legend>


                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL</label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control col-sm-6" ng-model="CrInDirectGLInfo" readonly>
