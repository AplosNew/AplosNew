                                    </li>
                                    <li>
                                        <button ng-disabled="DrDisable"  ng-click="refreshInDirectGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
