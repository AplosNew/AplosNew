                        <button ng-click="refreshCrInDirectGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="salaryHeadGL.CrInDirectBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in CrInDirectBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getCrInDirectActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="salaryHeadGL.CrInDirectActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in CrInDirectActivityList" id="ActivityId"
                                        name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>


                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">Other GL Code<sup></sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="salaryHeadGL.CrInDirectOtherGLCode" class="form-control" @* required tabindex="5"*@ maxlength="20">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">Other GL<sup></sup></label>
                        <div class="col-sm-8 show-message">
