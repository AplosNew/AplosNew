                </fieldset>


            </div>
        </div>
        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>
    </div>

</div>

<!-- #region ****************DirectGL**************** -->

<div class="modal fade site-modal in" id="DirectGLListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="DirectGLTypeListForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Direct Expenses GL</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="DirectListParameters.searchBy">
                                            <option ng-repeat="option in searchDirectGLByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="DirectListParameters.search" ng-enter="GetDirectGLListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetDirectGLListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive  modal-table ">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Account Group </th>
                                <th>GL </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in DirectGLList |itemsPerPage:DirectListParameters.pageSize" pagination-id="metaData.name + 'DirectGLList'"
                                total-items="DirectListParameters.total_count"
                                ng-click="setDirectGLSelected(x)" ng-dblclick="closeDirectGLListPopUpSelected()" ng-class="{selected : x.GLGeneralInfoCode === rowSelected}">
                                <td>{{x.AccountGroupName}}</td>
                                <td>{{x.GLGeneralInfoName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'DirectGLList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="GetDirectGLListData(newPageNumber)">
                </dir-pagination-controls>

                <div class="common-btn">
                </div>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closeDirectGLTypeListPopUpSelected()">Select</button>
            </div>
        </div>
    </div>
</div>

<!-- #endregion -->
