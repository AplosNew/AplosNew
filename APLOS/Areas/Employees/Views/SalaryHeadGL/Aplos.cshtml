<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Salary Head GL
</h3>
<div class="form-elements form-horizontal" ng-form name="salaryHeadGLNewForm">
    <input type="hidden" ng-model="salaryHeadGL.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Company Name" class="col-sm-3 form-control" ng-model="salaryHeadGL.CompanyId" ng-options="item.Value as item.Text for item in companyList" required tabindex="2" ng-change="getPlantList();getCoa()">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="salaryHeadGL.PlantId" ng-change="getPlantSalaryHeadSequence()"
                                ng-options="item.Value as item.Text for item in plantList" id="plantId"
                                name="Plant" required tabindex="2">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group">
                <label class="col-sm-4  control-label">COA</label>
                <div class="col-sm-8 ">
                    <input type="text" name="coa" id="coa" ng-model="salaryHeadGL.CoaName" class="form-control " readonly required>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li><button ng-click="getsalaryHeadGLWithCoa('assing');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> All Assign</button></li>
                    <li>
                        <button ng-click="getsalaryHeadGLWithCoa('notassing');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> Not Assign</button>
                    </li>
                    <li>
                        <button ng-click="getsalaryHeadGLWithCoa('all');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> All</button>
                    </li>

                    <li>
                        <button ng-click="getSalaryHeadGlReport();" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-download"></i> Download</button>
                    </li>

                </ul>
            </div>
        </div>



        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li>
                        <button ng-click="clearSearchDropDown();" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-refresh"></i></button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div class="table-responsive modal-table" ng-show="selectsalaryHeadGLWithCombineList.length">
                <br />

                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th rowspan="2">Apply</th>
                            <th style="vertical-align: middle; text-align:center" rowspan="2">Salary Head</th>
                            <th style="vertical-align: middle; text-align:center" rowspan="2">HeadCategory</th>
                            <th style="vertical-align: middle; text-align:center" rowspan="2">HeadType</th>
                            <th style="vertical-align: middle; text-align:center" rowspan="2">Payable Group</th>
                            <th style="text-align:center" colspan="3">Dr Direct GL</th>
                            <th style="text-align:center" colspan="3">Cr Direct GL</th>
                            <th style="text-align:center" colspan="3">Dr InDirect GL</th>
                            <th style="text-align:center" colspan="3">Cr InDirect GL</th>
                            <th style="vertical-align: middle; text-align:center" rowspan="2"> Untag</th>
                        </tr>
                        <tr>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                            <th>GL</th>
                            <th>Budget</th>
                            <th>Activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="x in selectsalaryHeadGLWithCombineList|itemsPerPage:$root.pageSize" pagination-id="metaData.name + 'selectsalaryHeadGLWithCombineList'" total-items="$root.total_count">

                            <td>
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" id="{{x.SalaryHeadID}}" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectChValueId($event,x.SalaryHeadID,x)">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>{{x.SalaryHead}}</td>
                            <td>{{x.HeadCategory}}</td>
                            <td>{{x.HeadType}}</td>
                            <td>{{x.SalaryPayableGroup}}</td>
                            <td>{{x.DirectGLName}}</td>
                            <td>{{x.DirectBudgetName}}</td>
                            <td>{{x.DirectActivityName}}</td>
                            <td>{{x.CrDirectGLName}}</td>
                            <td>{{x.CrDirectBudgetName}}</td>
                            <td>{{x.CrDirectActivityName}}</td>
                            <td>{{x.InDirectGLName}}</td>
                            <td>{{x.InDirectBudgetName}}</td>
                            <td>{{x.InDirectActivityName}}</td>
                            <td>{{x.CrInDirectGLName}}</td>
                            <td>{{x.CrInDirectBudgetName}}</td>
                            <td>{{x.CrInDirectActivityName}}</td>
                            <td class="text-center">
                                <ul class="list-inline action-list">
                                    <li><button ng-disabled="x.Id ===null" ng-click="editSalaryGL(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i></button></li>
                                    <li><button ng-disabled="x.Id ===null" ng-click="valuePassInDelModal(x,$index,$event)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'selectsalaryHeadGLWithCombineList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getData(newPageNumber)">
                </dir-pagination-controls>
            </div>
        </div>
        <div class="col-xs-12">
            <br /><br />
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Dr Direct</legend>

                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL</label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control col-sm-6" ng-model="DirectGLInfo" readonly>
                        </div>
                        <button name="submit" class="single-btn" ng-click="GetDirectGLList();"><i class="fa fa-search"></i></button>
                        <button ng-click="refreshDirectGL();" class="single-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Budget</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="salaryHeadGL.DrDirectBudgetMasterId"
                                        ng-options="item.BudgetMasterId as item.BudgetName for item in DirectBudgetList" id="BudgetId"
                                        name="Budget" tabindex="1" ng-change="getDirectActivity()">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Activity</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="salaryHeadGL.DrDirectActivityId"
                                        ng-options="item.ActivityId as item.ActivityName for item in DirectActivityList" id="ActivityId"
                                        name="Activity" tabindex="1">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">Other GL Code<sup></sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="salaryHeadGL.DrDirectOtherGLCode" class="form-control" @*required tabindex="5"*@ maxlength="20">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-3 control-label">Other GL<sup></sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="salaryHeadGL.DrDirectOtherGL" class="form-control" @* required tabindex="5"*@ maxlength="50">
                        </div>
                    </div>

                </fieldset>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Dr In Direct </legend>


                    <div class="form-group">
                        <label class="col-sm-3 control-label">GL</label>
                        <div class="col-sm-6 pdr3">
                            <input type="text" class="form-control col-sm-6" ng-model="InDirectGLInfo" readonly>
