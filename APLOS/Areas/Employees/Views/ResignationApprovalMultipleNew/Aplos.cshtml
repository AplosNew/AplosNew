        </div>
    </ej-dialog>
    <script id="sample" type="text/template">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-12">

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li style="float:right; padding-right:11px"> <div id="buttonName" class="btn">OK</div></li>
                    </ul>
                </div>
            </div>
        </div>
    </script>

