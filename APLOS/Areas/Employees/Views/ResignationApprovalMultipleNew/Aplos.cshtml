<div class="modal fade site-modal in" id="remarksPopUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-m">
        <div class="modal-content">
            <div class="modal-header"> Remarks  </div>
            <div class="modal-body">
                <div class="col-xs-12 col-sm-12 col-sm-12 form-elements form-horizontal">
                    <textarea ng-model="tempRowData.Remarks" rows="3" class="form-control" placeholder="Please enter remarks here" maxlength="250" style="width:480px;border:1px solid black" />
                </div>
                <div class="common-btn modal-footer">
                    <ul class="list-inline text-right">
                        <li><button ng-click="closeRemarkPopUp()" class="btn">Done</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>



         
          
          
    <ej-dialog id="dialogRemarks"
               title="Remarks"
               e-enablemodal="true"
               e-position-y="0"
