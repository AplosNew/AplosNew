<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Plant Transfer
</h3>
<div class="row"></div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee Code<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" min="1" name="Sequence" ng-model="EmployeeModel.EmployeeCode" class="form-control" ng-disabled="true" required tabindex="1">

            </div>
            <div class="col-sm-2 show-message" style="margin-left:0px;padding-left:0px">

                <button style="color: #f3f3ec;background-color: #1c1f32; " class="btn"><i class="glyphicon glyphicon-search" ng-click="LoadEmployeeList()" style="margin: -4px;"></i></button>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee Name </label>
            <label class="col-sm-8 control-label">: {{EmployeeModel.EmployeeName}}</label>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">DOJ </label>
            <label class="col-sm-8 control-label">: {{EmployeeModel.DOJs}}</label>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Budget Code </label>
            <label class="col-sm-8 control-label">: {{EmployeeModel.Code}}</label>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Legal Designation </label>
            <label class="col-sm-8 control-label">: {{EmployeeModel.LegalDesignation}}</label>
        </div>
        @*<div class="form-group">
                <label class="col-sm-4 control-label">Department </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.Department}}</label>
            </div>*@
        @*<div class="form-group">
                <label class="col-sm-4 control-label">Position </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.PositionName}}</label>
            </div>*@
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant </label>
            <label class="col-sm-8 control-label">: {{EmployeeModel.PlantName}}</label>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Salary Rule </label>
            <label class="col-sm-8 control-label">: {{EmployeeModel.SalaryRuleName}}</label>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Leave Policy </label>
            <label class="col-sm-8 control-label">: {{EmployeeModel.LeavePolicyName}}</label>
        </div>



    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label" style="padding-right: 107px;">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="CustomPara.PlantId"
                            ng-options="item.Value as item.Text for item in plantList" id="plantId" ng-change="PlantChange()"
                            name="Plant" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>








        <br /><br />


        <div class="form-group">
            <label class="col-sm-4 control-label">Budget Code<sup>*</sup></label>
            <div class="col-sm-8 input-group show-message" style="padding-left: 15px; padding-right: 14px;">
                <input type="text" name="Code" ng-model="CustomPara.BudgetCode" class="form-control" readonly>
                <span class="input-group-btn">
                    <button ng-click="LoadBCList();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
        @*<div class="form-group">
                <label class="col-sm-4 control-label">Budget Code </label>
                <label class="col-sm-8 control-label">: {{NewEmployeeModel.Code}}</label>
            </div>*@
        <div class="form-group">
            <label class="col-sm-4 control-label">Legal Designation </label>
            <label class="col-sm-8 control-label">: {{NewEmployeeModel.LegalDesignation}}</label>
        </div>
        @*<div class="form-group">
                <label class="col-sm-4 control-label">Department </label>
                <label class="col-sm-8 control-label">: {{NewEmployeeModel.Department}}</label>
            </div>*@
        @*<div class="form-group">
                <label class="col-sm-4 control-label">Position </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.PositionName}}</label>
            </div>*@
        @*<div class="form-group">
                <label class="col-sm-4 control-label">Plant </label>
                <label class="col-sm-8 control-label">: {{NewEmployeeModel.PlantName}}</label>
            </div>*@
        <div class="form-group">
            <label class="col-sm-4 control-label">Salary Rule </label>
            <label class="col-sm-8 control-label">: {{NewEmployeeModel.SalaryRuleName}}</label>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Leave Policy </label>
            <label class="col-sm-8 control-label">: {{NewEmployeeModel.LeavePolicyName}}</label>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Job Location<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="CustomPara.JobLocationId"
                            ng-options="item.SystemID as item.JobLocation for item in JobLocationList" id="JobLocationId"
                            name="JobLocationId" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Effective Date</label>
            <div class="col-sm-8">
                <input type="text" ej-datepicker e-width="100%" e-dateformat="dd-MMM-yyyy" e-value="CustomPara.EffectiveDate" />
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label" style="padding-right: 107px;">Shift<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="CustomPara.ShiftId"
                            ng-options="item.SystemID as item.UserName for item in ShiftList" id="ShiftId"
                            name="ShiftId" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>

    </div>
</div>
<hr />
<div class="row">
    <div class="col-sm-12">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="SaveData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            </ul>
        </div>
    </div>
</div>


<ej-dialog id="dialogEmployeeInfo"
           title=" Employee Information"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target=".site-heading"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="500" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">

            <div style="color:black;"
                 id="GridEmployeeInfoList"
                 e-recorddoubleclick="SelectEmployee"
                 ej-grid e-datasource="EmployeeInformationList"
                 e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowselection="true"
                 e-pagesettings-pagesize="25"
                 e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>

                    <div e-column e-field="DOJs" e-headertext="DOJ" e-width="70"></div>
                    <div e-column e-field="DOS" e-headertext="DOS" e-width="70"></div>
                    @*<div e-column e-field="DOBs" e-headertext="DOB" e-width="70"></div>*@
                    <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    @*<div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>*@

                    <div e-column e-field="EntityName" e-headertext="Entity" e-width="80"></div>
                    <div e-column e-field="PlantName" e-headertext="PlantName" e-width="60"></div>
                    @*<div e-column e-field="DesignationGroupName" e-headertext="Designation Group" e-width="80"></div>*@
                    @*<div e-column e-field="CellPhnNo" e-headertext="Cell No" e-width="80"></div>*@
                    @*<div e-column e-field="PayRollGroupName" e-headertext="Payroll Group" e-width="80"></div>
                        <div e-column e-field="PlantName" e-headertext="PlantName" e-width="60"></div>*@
                </div>
            </div>
        </div>
    </div>

</ej-dialog>





<ej-dialog id="dialogBC"
           title=" Employee Information"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target=".site-heading"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="500" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">

            <div style="color:black;"
                 id="GridBC"
                 e-recorddoubleclick="SelectBC"
                 ej-grid e-datasource="BCList"
                 e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowselection="true"
                 e-pagesettings-pagesize="25"
                 e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>
                    <div e-column e-field="Code" e-headertext="Code" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmploymentType" e-headertext="EmploymentType" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EntityName" e-headertext="EntityName" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Plant" e-headertext="Plant" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="PositionName" e-headertext="PositionName" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SubDivision" e-headertext="SubDivision" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Unit" e-headertext="Unit" e-allowediting="false" e-width="80"></div>
                </div>
            </div>
        </div>
    </div>

</ej-dialog>





























