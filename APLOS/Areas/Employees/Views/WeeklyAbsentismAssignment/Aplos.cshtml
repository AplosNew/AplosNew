<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Weekly Absenteeism Assignment</h3>
<style>
    .filled {
        background-color: #f3f587e6 !important;
    }
</style>
<div class="form-elements form-horizontal" ng-form name="modelForm">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="assign" role="tab" data-toggle="tab">Absenteeism Assignment</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="assigned" role="tab" data-toggle="tab">Assigned Absenteeism</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Year<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <div class="select-style">
                                        <select id="Year" class="form-control" ng-model="absentisim.YearId" name="Year" required tabindex="1" ng-change="getData();GetAssignEmpList()">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in yearList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Month<sup>*</sup></label>
                                <div class="col-sm-6">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="absentisim.Month" name="Month" ng-change="getData();GetAssignEmpList();">
                                            <option value="">--Select--</option>
                                            <option value="Jan">Jan</option>
                                            <option value="Feb">Feb</option>
                                            <option value="Mar">Mar</option>
                                            <option value="Apr">Apr</option>
                                            <option value="May">May</option>
                                            <option value="Jun">Jun</option>
                                            <option value="Jul">Jul</option>
                                            <option value="Aug">Aug</option>
                                            <option value="Sep">Sep</option>
                                            <option value="Oct">Oct</option>
                                            <option value="Nov">Nov</option>
                                            <option value="Dec">Dec</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">More than<sup>*</sup></label>
                                <div class="col-sm-4">
                                    <input type="text" name="day" ng-model="absentisim.Day" class="form-control" tabindex="1">
                                </div>
                                <label class="col-sm-2 control-label" style="margin-left: -27px;">days absent or LWP</label>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-group">
                                <div class="col-sm-6">
                                    <button ng-click="RefreshBody();" ng-disabled="absentisim.YearId==null || absentisim.Month==null || absentisim.Day==null" class="btn single-small-btn" style="margin-left: 90px;">Go</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="row form-elements">
                    <label class="form-control">Total Employee : {{totalemployee}}</label>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>

                                            <div class="checkbox-site text-center">
                                                <label>
                                                    <input type="checkbox" ng-click="CheckAll($event);">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </th>
                                        <th>Employee Code</th>
                                        <th>Employee Name</th>
                                        @*<th ng-repeat="h in offdayList">{{h.OffDayDate|dateFiltering}}</th>*@
                                        <th>{{day1}}</th>
                                        <th>{{day2}}</th>
                                        <th>{{day3}}</th>
                                        <th>{{day4}}</th>
                                        <th ng-show="day5.length>0">{{day5}}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in dayList">
                                        <td>
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" ng-model="x.Selected" ng-checked="x.Selected" ng-click="pushTempList(x,$event,dayList);">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </td>
                                        <td>{{x.EmployeeCode}}</td>
                                        <td>{{x.EmployeeName}}</td>
                                        <td>
                                            <div ng-class="getColor(x.WeekNo1)">
                                                <input type="checkbox" ng-model="x.W0Status" ng-checked="x.W0Status" ng-disabled="!x.WeekNo1">
                                                <button ng-click="loadDetails(x,'W0',$index)" class="btn-action tooltip-here" data-placement="top" title="Detail" tooltip>
                                                    <i class="glyphicon glyphicon-list"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <div ng-class="getColor1(x.WeekNo2)">
                                                <input type="checkbox" ng-model="x.W1Status" ng-checked="x.W1Status" ng-disabled="!x.WeekNo2">
                                                <button ng-click="loadDetails(x,'W1',$index)" class="btn-action tooltip-here" data-placement="top" title="Detail" tooltip>
                                                    <i class="glyphicon glyphicon-list"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <div ng-class="getColor2(x.WeekNo3)">
                                                <input type="checkbox" ng-model="x.W2Status" ng-checked="x.W2Status" ng-disabled="!x.WeekNo3">
                                                <button ng-click="loadDetails(x,'W2',$index)" class="btn-action tooltip-here" data-placement="top" title="Detail" tooltip>
                                                    <i class="glyphicon glyphicon-list"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <div ng-class="getColor3(x.WeekNo4)">
                                                <input type="checkbox" ng-model="x.W3Status" ng-checked="x.W3Status" ng-disabled="!x.WeekNo4">
                                                <button ng-click="loadDetails(x,'W3',$index)" class="btn-action tooltip-here" data-placement="top" title="Detail" tooltip>
                                                    <i class="glyphicon glyphicon-list"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td ng-class="getColor4(x.WeekNo5)" ng-show="day5.length>0">
                                            <input type="checkbox" ng-model="x.W4Status" ng-checked="x.W4Status" ng-disabled="!x.WeekNo5">
                                            <button ng-click="loadDetails(x,'W4',$index)" class="btn-action tooltip-here" data-placement="top" title="Detail" tooltip>
                                                <i class="glyphicon glyphicon-list"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-md-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="$root.parameters.searchBy">
                                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-12 col-sm-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Employee Code</th>
                                        <th>Employee Name</th>
                                        <th>Work Date</th>
                                        <th>Delete</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="x in assignedList |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                                        <td>{{x.EmployeeCode}}</td>
                                        <td>{{x.EmployeeName}}</td>
                                        <td>{{x.WorkingDate | dateFiltering}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button data-toggle="modal" data-target="#confirmDelete" ng-click="confirmDelete(x.Id,x.EmployeeCode,$index)"
                                                            class="btn btn-action tooltip-here" data-placement="top" title="Delete" tooltip>
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <dir-pagination-controls max-size="10"
                                                     direction-links="true"
                                                     boundary-links="true"
                                                     on-page-change="getData(newPageNumber)">
                            </dir-pagination-controls>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="DetailPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Detail Information<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Work Date</th>
                                <th>Day Status</th>
                                <th>InTime</th>
                                <th>OutTime</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in detailList">
                                <td>{{x.WorkDate}}</td>
                                <td>{{x.DayStatus}}</td>
                                <td>{{x.InTime}}</td>
                                <td>{{x.OutTime}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="close();" class="btn">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic data-modalid="confirmDelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteDetail()"></confirm-archive-generic>
<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>