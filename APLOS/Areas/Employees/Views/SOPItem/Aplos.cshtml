                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Average Time (Min)<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="number" name="AverageTime" ng-model="activityNew.AverageTime" class="form-control" tabindex="37">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="activityNew.Remarks" name="Remarks" maxlength="200" tabindex="39"></textarea>
                            </div>
                        </div>
                        <div class="form-group" ng-show="hidediv">
                            <label class="col-sm-4 control-label">KPI</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="activityNew.KPI">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="hidediv">
                            <label class="col-sm-4 control-label">Documents</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="activityNew.Documents">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Detail<sup>*</sup></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="activityNew.ActivityDetail" name="Activity Detail" maxlength="1000" tabindex="32"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Importance<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="ActivityImportanceId" class="form-control" name="Activity Importance" ng-model="activityNew.ActivityImportanceId" tabindex="34">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in activityImportanceList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Frequency<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="number" name="Frequency" ng-model="activityNew.Frequency" class="form-control" tabindex="36">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" title="Do You Find Value In This Activity">Find Value in this Activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Value In Activity" ng-model="activityNew.ValueInActivity" class="form-control" tabindex="38">
                                        <option value="">--Select--</option>
                                        <option value="Yes">Yes</option>
                                        <option value="No">No</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Purpose of the activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="2" ng-model="activityNew.PurposeOfTheActivity" name="PurposeOfTheActivity" maxlength="200" tabindex="40"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Has Financial Impact</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="activityNew.FinancialImpact" tabindex="10">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveActivity();" ng-disabled="disableBtn();savebtndisable;sopItemNew.Id===null" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ActivityAction}}</button></li>
                            <li> <button ng-click="clearactivity();" ng-disabled="disableBtn()" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Activity</th>
                                        <th>Position Name</th>
                                        <th>Activity Category</th>
                                        <th>Activity Importance</th>
                                        <th>Period</th>
                                        <th class="col-md-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in activityDataList">
                                        <td>{{x.Name}}</td>
                                        <td>{{x.PositionName}}</td>
                                        <td>{{x.ActivityCategoryId}}</td>
                                        <td>{{x.ActivityImportanceId}}</td>
                                        <td>{{x.PeriodId}}</td>
                                        <td class="text-center table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="activityEdit(x, $index)" ng-disabled="disableBtn()" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                        <i class="glyphicon glyphicon-edit"></i>
                                                    </button>
                                                </li>
                                                <li>
                                                    <button ng-click="activityDelete(x, $index)" ng-disabled="disableBtn()" class="btn btn-action tooltip-here" data-placement="top" title="Delete">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row" ng-form name="documentForm">
                    <input type="hidden" ng-model="documentActivityNew.Id" />
                    <div class="col-xs-6 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="ActivityId" class="form-control" name="Activity" ng-model="documentActivityNew.SOPActivityId" tabindex="41">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in activitydocumentList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button ng-click="documentPopUp();" class="btn single-small-btn"><i class="glyphicon glyphicon-plus" tabindex="5"></i> Add Document</button>
                    </div>
                    <div class="col-sm-12" ng-show="documentSetDetailList.length>0">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Document Name</th>
                                        <th>Data Source Category</th>
                                        <th>FileName</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in documentSetDetailList">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td>{{x.DataSourceCategory}}</td>
                                        <td>{{x.FileName}}</td>
                                        <td>
                                            <ul class="list-inline action-list">
                                                <li><button ng-click="valuePassInDelModal(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="common-btn" style="padding-right:18px">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveDocument();" class="btn" ng-disabled="disableBtn();savebtndisable;documentActivityNew.SOPActivityId===null"><i class="glyphicon glyphicon-floppy-disk"></i>{{DocumentAction}}</button></li>
                                <li> <button ng-click="clearDocument();" class="btn" ng-disabled="disableBtn()" tabindex="9"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Activity</th>
                                        <th>Document Name</th>
                                        <th>Data Source Category</th>
                                        <th>File Name</th>
                                        <th class="col-md-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in documentsDataList">
                                        <td>{{x.Activity}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td>{{x.DataSourceCategory}}</td>
                                        <td ng-click="SOPActivityDocFileDownload(x)"><a href="{{dwonloadUrl}}" style="text-decoration:underline" download="{{x.FileName}}" target="_self">{{x.FileName}}</a></td>
                                        <td class="text-center table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="documentDelete(x, $index)" ng-disabled="disableBtn()" class="btn btn-action tooltip-here" data-placement="top" title="Delete">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="row">
                    <div class="form-elements form-horizontal">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Activity<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select id="ActivityId" class="form-control" name="Activity" ng-model="kpiNew.SOPActivityId" tabindex="61" @*ng-change="kpiData();"*@>
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in activitykpiList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">KPI Detail<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="kpiNew.KPIDetail" name="Name" maxlength="200" tabindex="63"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Name of KPI<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="kpiNew.Name" name="Name" maxlength="200" tabindex="62"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="kpiNew.Remarks" name="Remarks" maxlength="200" tabindex="64"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right" style="padding-right:18px">
                                <li> <button ng-click="UpdateKPI();" ng-disabled="disableBtn();savebtndisable;kpiNew.SOPActivityId===null" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{KPIAction}}</button></li>
                                <li> <button ng-click="clearkpibody();" ng-disabled="disableBtn()" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear </button></li>
                            </ul>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Activity</th>
                                            <th>Name of KPI</th>
                                            <th>KPI Detail</th>
                                            <th class="col-md-2">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in kpiList">
                                            <td>{{x.Activity}}</td>
                                            <td>{{x.Name}}</td>
                                            <td>{{x.KPIDetail}}</td>
                                            <td class="text-center table-td">
                                                <ul class="list-inline action-list">
                                                    <li>
                                                        <button ng-click="kpiEdit(x, $index)" ng-disabled="disableBtn()" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                            <i class="glyphicon glyphicon-edit"></i>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button ng-click="kpiDelete(x, $index)" ng-disabled="disableBtn()" class="btn btn-action tooltip-here" data-placement="top" title="Delete">
                                                            <i class="glyphicon glyphicon-remove"></i>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>SOP Category</th>
                <th>SOP SubCategory</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in sopItems|itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.SOPCategory}}</td>
                <td>{{x.SOPSubCategory}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="documentPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                SOP Document
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="documentListParameters.searchBy">
                                            <option ng-repeat="option in searchByDocumentList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="documentListParameters.search" ng-enter="getDocumentData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getDocumentData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Code</th>
                                <th>Document Name</th>
                                <th>Data Source Category</th>
                                <th>File Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in documents |itemsPerPage:documentListParameters.pageSize" pagination-id="metaData.name + 'documents'" total-items="documentListParameters.total_count" ng-dblclick="selectDocument(x);">
                                <td>
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="x.Flag" checked="{{x.Flag}}" ng-click="selectFirstChValue($event,x)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.DataSourceCategory}}</td>
                                <td>{{x.FileName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'documents'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getDocumentData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button type="button" class="btn btn-default" data-dismiss="modal">Close</button></li>
                        <li> <button type="submit" class="btn btn-default" ng-click="selectDocument();">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="positionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Position Informations
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="positionParameters.searchBy">
                                            <option ng-repeat="option in positionSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="positionParameters.search" ng-enter="getPositionData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPositionData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped" ng-show="positionDataList.length">
                        <thead>
                            <tr>
                                <th ng-repeat="x in positionSearchList">{{x.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in positionDataList|itemsPerPage:positionParameters.pageSize" total-items="positionParameters.total_count" pagination-id="metaData.name + 'positionDataList'" ng-dblclick="selectPositionPopUp(x)">
                                <td ng-repeat="y in positionSearchList">{{x[y.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'positionDataList'"
                                             direction-links="true" boundary-links="true"
                                             on-page-change="getPositionData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button type="button" class="btn btn-default" ng-click="closePositionPopUp();">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
