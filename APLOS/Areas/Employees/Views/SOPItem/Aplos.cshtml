                                <input type="text" name="Name" ng-model="activityNew.Name" class="form-control" maxlength="50" tabindex="31">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Position<sup>*</sup></label>
                            <div class="col-sm-5 pdr3" style="Width:295px;">
                                <input type="hidden" ng-model="activityNew.PositionId" class="form-control" disabled>
                                <input type="text" name="Position" ng-model="activityNew.PositionName" class="form-control" disabled>
                            </div>
                            <div class="pdl3">
                                <button name="submit" class="btn single-small-btn" ng-click="positionPopUp()" tabindex="3">
                                    <i class="cr-icon glyphicon glyphicon-search"></i>
                                </button>
                                <button class="btn single-small-btn" ng-click="clearPosition()">
                                    <i class="cr-icon glyphicon glyphicon-refresh"></i>
                                </button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Activity Category<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="ActivityCategoryId" ng-change="checkActivityCategory()" class="form-control" name="Activity Category" ng-model="activityNew.ActivityCategoryId" tabindex="33">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in activityCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="otherActivityCategory">
