<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">To Assign</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);UnallocationView()" href="" aria-controls="doc" role="tab" data-toggle="tab">Unassign</a></li>
            </ul>
        </div>

        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

                <div class="row">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            @*<li> <button ng-click="view();" class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-down "></i>View</button></li>*@
                            <li> <button data-toggle="modal" ng-click="AssignReport();" class="btn" tabindex="10"><i class="glyphicon glyphicon-cloud-download"></i> Get Report</button></li>
                        </ul>
                    </div>
                </div>
                <div class="table-responsive" id="REGrid">
                    <div id="GridRouteEmp" ej-grid style="z-index:3;"
                         e-datasource="ModelList"
                         e-allowfiltering="true"
                         e-allowpaging="true"
                         e-allowsorting="true"
                         e-enabletouch="false"
                         e-responsive="true"
                         e-allowselection="true"
                         e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Route" e-headertext="Route" e-width="100"></div>
                            <div e-column e-field="Transport" e-headertext="Transport" e-width="100"></div>
                             <div e-column e-field="TripId" e-headertext="Trip Id" e-width="100"></div>
                            <div e-column e-field="TripNo" e-headertext="Trip No" e-width="100"></div>
                            <div e-column e-field="UpDown" e-headertext="Up/Down" e-width="100"></div>
                            <div e-column e-field="From" e-headertext="From" e-width="100"></div>
                            <div e-column e-field="To" e-headertext="To" e-width="100"></div>
                            <div e-column e-field="Shift" e-headertext="Shift" e-width="100"></div>
                            <div e-column e-field="Vacancy" e-headertext="Vacancy" e-width="100"></div>
                            <div e-column e-field="PlanCapacity" e-headertext="Plan" e-width="80"></div>
                            <div e-column e-field="Alloted" e-headertext="Alloted" e-width="100"></div>
                            <div e-column e-template="#templateBalance" e-type="string" e-field="Balance" e-headertext="Balance" e-width="70"></div>
                            @*<div e-column e-headertext="Allocation" ng-click="openChildGrid()" e-headertemplateid="#headerTemplate" e-template="#AllocationTemplate" e-textalign="center" e-width="100"></div>*@
                            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                        </div>
                    </div>
                    @*<script type="text/template" id="AllocationTemplate">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-down "></i>View</button></li>
                            </ul>
                        </div>
                    </script>*@
                    <script type="text/template" id="templateBalance">
                        <div class="text-left" style="width:100%">
                            <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.AvailablePopUpData(this);">{{data.Balance}}</a>
                        </div>
                    </script>
                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        @* <li> <button ng-click="ResidenceStatusSave();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>*@
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>

                </div>
                <div class="modal fade site-modal in" id="EmpPop" role="dialog" data-backdrop="static">
                    <div class="modal-dialog modal-lg modellgModify ">
                        <div class="modal-content">
                            <div class="modal-header">Employee join after date.<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                            <div class="modal-body form-elements form-horizontal">
                                <div class="col-md-12">
                                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                                        <p style="margin-bottom:10px">Please allot / unallot the Employees.</p>
                                        @* Add To and From Date column start *@
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group" show-errors>
                                                    <label class="col-sm-4 control-label">From Date</label>
                                                    <div class="col-sm-8 show-message">
                                                        <input type="text" ng-model="selectedData.fromDate" name="Current Date" datepicker class="form-control" maxlength="50" tabindex="3" required>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group" show-errors>
                                                    <label class="col-sm-4 control-label">To Date</label>
                                                    <div class="col-sm-8 show-message">
                                                        <input type="text" ng-model="selectedData.toDate" name="After Date" datepicker class="form-control" maxlength="50" tabindex="3" required>
                                                    </div>
                                                </div>
                                                <div class="common-btn">
                                                    <ul class="list-inline text-right">
                                                        <li>

                                                            <button ng-click="PopupEmployeeView();" class="btn"><i class=""></i> View</button>
                                                        </li>
                                                    </ul>

                                                </div>
                                            </div>
                                        </div>
                                        @* Add To and From Date column end *@
                                        <div class="table-responsive" id="EmpGrid" style="margin-top:20px; display:none">
                                            <div id="GridEdit" ej-grid e-datasource="popupEmployeeList" e-load="loadGridEdit"
                                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" style="width:100vw !important">
                                                <div e-columns>
                                                    <div e-column e-headertext="Allot / Unallot" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="100"></div>
                                                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="120"></div>
                                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                                    <div e-column e-field="SystemId" e-headertext="System Id" e-width="50"></div>
                                                    <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                                                    @*<div e-column e-field="Activity" e-headertext="Activity" e-width="50"></div>*@

                                                    <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                                                    <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                                                    <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>

                                                </div>
                                            </div>
                                            <script type="text/template" id="checkboxTemplate">

                                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" e-value="data.isSelected" />
                                            </script>

                                        </div>
                                    </div>
                                </div>
                                @*<p>Please Unallot the selected employees.</p>*@
                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li>
                                            @*<button ng-click="selectEmpDetail();" class="btn"><i class=""></i> Select</button>*@
                                            <button class="btn"><i class=""></i>Unallot</button>
                                            <button ng-click="closeChildGrid();" class="btn"><i class=""></i> Close</button>
                                        </li>
                                    </ul>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <style>
                    button.btn-primary {
                        position: fixed;
                        top: 50%;
                        left: 50%;
                        margin-top: -50px;
                        margin-left: -100px;
                    }

                    .hide {
                        display: none;
                    }

                    .show {
                        display: block;
                    }
                </style>

                <div class="container">
                    <!-- Button to Open the Modal -->
                    <!-- The Modal -->
                    <div class="modal" id="myModal">
                        <div class="modal-dialog">

                            <div class="modal-content">
                                <!-- Modal Header -->
                                <div class="modal-header">
                                    @*<h4 class="modal-title">Modal Heading</h4>
                                        <button type="button" class="close" data-dismiss="modal">&times;</button>*@
                                </div>

                                <!-- Modal body -->
                                <div class="modal-body">
                                    Are You Sure You want to delete?
                                </div>
                                <!-- Modal footer -->
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                    <button class="btn btn-danger" ng-click="Deletet()">Delete</button>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>


            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button data-toggle="modal" ng-click="UnassignReport();" class="btn" tabindex="10"><i class="glyphicon glyphicon-cloud-download"></i> Get Report</button></li>
                        </ul>
                    </div>
                </div>
                <div class="table-responsive" id="EGSGrid" style="margin-top:20px;">
                    <div id="GridEUnallocation" ej-grid e-datasource="ModelUnassignList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" style="width:100vw !important">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerUnassignTemplate" e-template="#checkboxUnassignTemplate" e-textalign="center" e-width="30"></div>

                            <div e-column e-field="EmployeeId" e-headertext="Employee Id" e-width="100"></div>
                            <div e-column e-field="EmployeeStatus" e-headertext="Employee Status" e-width="100"></div>
                            <div e-column e-field="EmployeeCurrentStatus" e-headertext="Employee Current Status" e-width="100"></div>
                            <div e-column e-field="Stoppage" e-headertext="Stoppage" e-width="100"></div>
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-width="100"></div>
                            <div e-column e-field="DOS" e-headertext="DOS" e-width="100"></div>
                            <div e-column e-field="Route" e-headertext="Route" e-width="100"></div>
                            <div e-column e-field="Transport" e-headertext="Transport" e-width="100"></div>
                            <div e-column e-field="Shift" e-headertext="Shift" e-width="100"></div>
                            <div e-column e-field="From" e-headertext="From" e-width="100"></div>
                            <div e-column e-field="To" e-headertext="To" e-width="100"></div>
                            <div e-column e-field="TripId" e-headertext="Trip Id" e-width="100"></div>
                            <div e-column e-field="TripNo" e-headertext="TripNo" e-width="100"></div>
                            <div e-column e-field="Skill" e-headertext="Skill" e-width="100"></div>
                            <div e-column e-field="GivenDesignation" e-headertext="Given Designation" e-width="100"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="100"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                            <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>

                        </div>
                        <script type="text/template" id="checkboxUnassignTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
                        </script>
                        <script type="text/x-jsrender" id="headerUnassignTemplate">
                            <input type="checkbox" id="headcheck" />
                        </script>

                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveUnassignData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    </ul>

                </div>

                <!--   FOR EMPLOYEE CATEGORY pop up screen    -->
                <div class="modal fade site-modal in" id="EmpCategoryPop" role="dialog" data-backdrop="static">
                    <div class="modal-dialog modal-lg modellgModify ">
                        <div class="modal-content">
                            <div class="modal-header">Employee category Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
                            <div class="modal-body form-elements form-horizontal">
                                <div class="col-md-12">
                                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                                        @*<p>Please Select Employee Goal .</p>*@
                                        <div style="color:black;" id="GridEmployeeGoal" ej-grid e-datasource="EmployeeCategoryList" e-recorddoubleclick="selEmployeeCategory"
                                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                                            <div e-columns>
                                                <div e-column e-field="Id" e-headertext="Id" e-width="50"></div>

                                                <div e-column e-field="UserName" e-headertext="User Name" e-width="120"></div>
                                                <div e-column e-field="WorkingDaysInAMonth" e-headertext="Working Days In A Month" e-width="50"></div>
                                            </div>

                                        </div>


                                    </div>
                                </div>
                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li>

                                            <button ng-click="EmployeeGoalPop();" class="btn"><i class=""></i> Close</button>
                                        </li>
                                    </ul>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @*<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                    @{ Html.RenderPartial("_ResidenceMasterReport");}
                </div>*@
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>

<!--POP UP SCREEN  FOR EMPLOYEE DETAIL  (EmployeeInformation) TAB 2  -->
<div class="modal fade site-modal in" id="EmployeePop" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify ">
        <div class="modal-content">
            <div class="modal-header">Employee Detail <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="content-container-fluid" style="color:black;overflow:scroll">
                        <p>Please Select Employee Detail .</p>
                        <div style="color:black;" id="GridEmployee" ej-grid e-datasource="EmployeeList" e-recorddoubleclick="selEmp"
                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-templaterefresh="refreshTemplatebudget" e-responsive="true">
                            <div e-columns>

                                <div e-column e-field="SystemId" e-headertext="System Id" e-width="50"></div>
                                @*<div e-column e-field="EmployeeId" e-headertext="EmployeeCode" e-width="50"></div>*@
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="120"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="120"></div>
                                <div e-column e-field="DOB" e-headertext="DOB" e-width="100"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li>
                            <button ng-click="closeEmpPopUp();" class="btn"><i class=""></i> Close</button>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeEmployeePopUps();">&times;</button>
            </div>
            <div class="modal-body">

                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridEmp" ej-grid e-datasource="dataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplateemployee">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-template="#stoppageTemplate" e-type="string" e-field="Stoppage" e-headertext="Stoppage" e-width="90"></div>
                            <div e-column e-field="SystemID" e-headertext="Employee Id" e-width="100"></div>
                            <div e-column e-field="EmployeeStatus" e-headertext="Employee Status" e-width="100"></div>
                            <div e-column e-field="EmployeeCurrentStatus" e-headertext="Employee Current Status" e-width="100"></div>
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-width="100"></div>
                            <div e-column e-field="Skill" e-headertext="Skill" e-width="100"></div>
                            <div e-column e-field="GivenDesignation" e-headertext="Given Designation" e-width="100"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="100"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                            <div e-column e-field="EntityName" e-headertext="Entity" e-width="100"></div>
                        </div>
                    </div>
                </div>
                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
                </script>
                <script type="text/x-jsrender" id="headerTemplate">
                    <input type="checkbox" id="headchk" />
                </script>

                <script type="text/template" id="templateBalance">
                    <div class="text-left" style="width:100%">
                        <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.AvailablePopUpData(this);">{{data.Balance}}</a>
                    </div>
                </script>

                <script type="text/template" id="stoppageTemplate">
                    <div class="text-left" style="width:100%">
                        <div class="select-style">
                                <input ej-dropdownlist e-datasource="$parent.StopageDataList" e-value="data.StoppageId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                            @*<input ej-dropdownlist e-datasource="StopageDataList" e-value="Stoppage" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />*@
                        </div>
                    </div>
                </script>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Save</button>
            </div>
        </div>
    </div>
</div>
