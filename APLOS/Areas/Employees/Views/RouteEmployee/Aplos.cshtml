<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Route Assignment
</h3>


<div class="tab-design" id="tab_show">

    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">Unassigned</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Assigned</a></li>
        </ul>
    </div>

    <div class="tab-content" id="tabpaneldiv">

        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet11(11), active: isSet11(11) }">
            <div class="row">
                <div class="form-elements">
                    <div class="col-xs-12 ">

                        <div class="col-xs-12 col-sm-3 col-md-3 col-md-3 col-md-3">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Up Route</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <input ej-dropdownlist e-datasource="UARouteUpList" e-change="getUAstopageUpDropDownList" e-value="UArouteEmployee.UARouteUpId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                                       
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-3 col-md-3 col-md-3 col-md-3">
                            <div class="form-group">
                                <label class="col-sm-6 control-label">Up Stoppage</label>
                                <div class="col-sm-6 show-message">
                                    <div class="select-style">
                                        <input ej-dropdownlist e-datasource="UAStopageUpList"e-value="UArouteEmployee.UAStopageUpId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-3 col-md-3 col-md-3 col-md-3">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Down Route</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <input ej-dropdownlist e-datasource="UARouteDownList"  e-change="getUAstopageDownUpDropDownList" e-value="UArouteEmployee.UARouteDownId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-3 col-md-3 col-md-3 col-md-3">
                            <div class="form-group">
                                <label class="col-sm-6 control-label">Down Stoppage</label>
                                <div class="col-sm-6 show-message">
                                    <div class="select-style">
                                        <input ej-dropdownlist e-datasource="UAStopageDownList" e-value="UArouteEmployee.UAStopageDownId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-xs-12 col-sm-6 col-md-6">

                </div>

                <div class="col-xs-12 col-sm-6 col-md-6 ">

                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li style="float:right"> <button ng-click="UnAssignApplyForAll();" class="btn"><i class="glyphicon glyphicon-ok-circle"></i> Apply For All</button></li>
                        </ul>
                    </div>

                </div>

                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div class="content-container-fluid" style="color:black;">
                        <div ng-init="chkinit()"
                             id="UnassignGrid"
                             ej-grid e-datasource="UnassignEmpList"
                             e-gridlines="vertical"
                             e-templaterefresh="refreshTemplateemployee"
                             e-allowfiltering="true"
                             e-allowpaging="true"
                             e-allowsorting="true"
                             e-enabletouch="false"
                             e-rowdatabound="onrowdatabound1"
                             e-responsive="true"
                             e-pagesettings-pagesize="15"
                             e-allowselection="true"
                             e-filtersettings-filterType="excel">

                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="30"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="50"></div>
                                <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="50"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="50"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="50"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="50"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="50"></div>
                                <div e-column e-template="#UAUpRoute" e-headertext="Up Route" e-width="70"></div>
                                <div e-column e-template="#UAUpStopage" e-headertext="Up Stopage" e-width="70"></div>
                                <div e-column e-template="#UADownRoute" e-headertext="Down Route" e-width="70"></div>
                                <div e-column e-template="#UADownStopage" e-headertext="Down Stopage" e-width="70"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>

                        <script type="text/template" id="UAUpRoute">
                            <input ej-dropdownlist e-datasource="data.UARouteUpList" e-change="$parent.getUAstopageUpList" e-value="data.UARouteUpGridId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                        </script>
                        <script type="text/template" id="UAUpStopage">
                            <input ej-dropdownlist e-datasource="data.UAStopageUpList" e-value="data.UAStopageUpGridId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                        </script>
                        <script type="text/template" id="UADownRoute">
                            <input ej-dropdownlist e-datasource="data.UARouteDownList" e-change="$parent.getUAstopageDownList" e-value="data.UARouteDownGridId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                        </script>
                        <script type="text/template" id="UADownStopage">
                            <input ej-dropdownlist e-datasource="data.UAStopageDownList" e-value="data.UAStopageDownGridId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                        </script>
                    </div>
                </div>


                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveUnAssign();" class="btn" tabindex="4"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    </ul>
                </div>
            </div>

        </div>


        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet22(22), active: isSet22(22) }">
            <div class="row">
                <div class="form-horizontal" ng-form="routeEmployeeForm">
                    <input type="hidden" ng-model="routeEmployee.Id">
                    <div class="form-elements">

                        <div class="col-xs-12 ">

                            <div class="col-xs-12 col-sm-3 col-md-3 col-md-3 col-md-3">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Up Route<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <input ej-dropdownlist e-datasource="RouteUpList" e-change="getstopageUpDropDownList" e-value="routeEmployee.RouteUpId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12 col-sm-3 col-md-3 col-md-3 col-md-3">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Up Stoppage<sup>*</sup></label>
                                    <div class="col-sm-6 show-message">
                                        <div class="select-style">
                                            <input ej-dropdownlist e-datasource="StopageUpList"  e-value="routeEmployee.StopageUpId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12 col-sm-3 col-md-3 col-md-3 col-md-3">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Down Route<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            
                                            <input ej-dropdownlist e-datasource="RouteDownList" e-change="getstopageDownUpDropDownList" e-value="routeEmployee.RouteDownId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12 col-sm-3 col-md-3 col-md-3 col-md-3">
                                <div class="form-group">
                                    <label class="col-sm-6 control-label">Down Stoppage<sup>*</sup></label>
                                    <div class="col-sm-6 show-message">
                                        <div class="select-style">
                                            
                                            <input ej-dropdownlist e-datasource="StopageDownList" e-value="routeEmployee.StopageDownId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="col-xs-12 col-sm-6 col-md-6">

                        </div>

                    </div>

                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li style="float:right"> <button ng-click="ApplyForAll();" class="btn"><i class="glyphicon glyphicon-ok-circle"></i> Apply For All</button></li>
                            </ul>
                        </div>

                    </div>

                    <div class="col-xs-12 col-sm-6 col-md-12">
                        <div class="content-container-fluid" style="color:black;">
                            <div id="EmpGrid"
                                 ng-init="chkinit()"
                                 ej-grid e-datasource="dataList"
                                 e-gridlines="vertical"
                                 e-templaterefresh="refreshTemplateemployeeTWO"
                                 e-allowfiltering="true"
                                 e-allowpaging="true"
                                 e-allowsorting="true"
                                 e-enabletouch="false"
                                 e-responsive="true"
                                 e-allowselection="true"
                                 e-filtersettings-filterType="excel"
                                 e-pagesettings-pagesize="15">
                                <div e-columns>
                                    <div e-column e-headertext="" e-headertemplateid="#headerTemplateTwo" e-template="#checkboxTemplateTWO" e-textalign="center" e-width="30"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="30"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="50"></div>
                                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="50"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="50"></div>
                                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="50"></div>
                                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="50"></div>
                                    <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="50"></div>
                                    <div e-column e-template="#UpRoute" e-headertext="UpRoute" e-width="70"></div>
                                    <div e-column e-template="#UpStopage" e-headertext="UpStopage" e-width="70"></div>
                                    <div e-column e-template="#DownRoute" e-headertext="DownRoute" e-width="70"></div>
                                    <div e-column e-template="#DownStopage" e-headertext="DownStopage" e-width="70"></div>
                                </div>
                            </div>
                            <script type="text/template" id="checkboxTemplateTWO">
                                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelectTwo" />
                            </script>
                            <script type="text/x-jsrender" id="headerTemplateTwo">
                                <input type="checkbox" id="headchkTWO" />
                            </script>
                            <script type="text/template" id="UpRoute">
                                <input ej-dropdownlist e-datasource="data.RouteUpList" e-change="$parent.getstopageUpList" e-value="data.RouteUpGridId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                               
                            </script>
                            <script type="text/template" id="UpStopage">
                                <input ej-dropdownlist e-datasource="data.StopageUpList" e-value="data.StopageUpGridId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                            </script>
                            <script type="text/template" id="DownRoute">
                                <input ej-dropdownlist e-datasource="data.RouteDownList" e-change="$parent.getstopageDownList" e-value="data.RouteDownGridId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                            </script>
                            <script type="text/template" id="DownStopage">
                                <input ej-dropdownlist e-datasource="data.StopageDownList" e-value="data.StopageDownGridId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />

                            </script>
                        </div>

                    </div>

                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Save();" class="btn" tabindex="4"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                            <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        </ul>
                    </div>

                </div>

                <confirm-modal></confirm-modal>
                <confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
            </div>
        </div>

    </div>
</div>
