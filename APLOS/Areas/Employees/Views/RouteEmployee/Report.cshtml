<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);" href="" aria-controls="doc" role="tab" data-toggle="tab">To Assign List</a></li>
                @*<li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);" href="" aria-controls="doc" role="tab" data-toggle="tab">To Unassign List</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4);" href="" aria-controls="doc" role="tab" data-toggle="tab">Pending For UnAllocation</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5);" href="" aria-controls="doc" role="tab" data-toggle="tab">Residence Summary Report</a></li>*@
            </ul>
        </div>

        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button data-toggle="modal" ng-click="AssignReport();" class="btn" tabindex="10"><i class="glyphicon glyphicon-cloud-download"></i> Get Report</button></li>
                        </ul>
                    </div>
                </div>
                <div class="table-responsive" id="REGrid">
                    <div id="GridRouteEmp" ej-grid style="z-index:3;"
                         e-datasource="ModelList"
                         e-allowfiltering="true"
                         e-allowpaging="true"
                         e-allowsorting="true"
                         e-enabletouch="false"
                         e-responsive="true"
                         e-allowselection="true"
                         e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Route" e-headertext="Route" e-width="100"></div>
                            <div e-column e-field="Transport" e-headertext="Transport" e-width="100"></div>
                            <div e-column e-field="TripId" e-headertext="Trip Id" e-width="100"></div>
                            <div e-column e-field="TripNo" e-headertext="Trip No" e-width="100"></div>
                            <div e-column e-field="UpDown" e-headertext="Up/Down" e-width="100"></div>
                            <div e-column e-field="From" e-headertext="From" e-width="100"></div>
                            <div e-column e-field="To" e-headertext="To" e-width="100"></div>
                            <div e-column e-field="Shift" e-headertext="Shift" e-width="100"></div>
                            <div e-column e-field="Vacancy" e-headertext="Vacancy" e-width="100"></div>
                            <div e-column e-field="PlanCapacity" e-headertext="Plan" e-width="80"></div>
                            <div e-column e-field="Alloted" e-headertext="Alloted" e-width="100"></div>
                            <div e-column e-template="#templateBalance" e-type="string" e-field="Balance" e-headertext="Balance" e-width="70"></div>
                            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
                        </div>
                    </div>

                    <script type="text/template" id="templateBalance">
                        <div class="text-left" style="width:100%">
                            <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.AvailablePopUpData(this);">{{data.Balance}}</a>
                        </div>
                    </script>
                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>

                </div>

            </div>

          
        </div>
    </div>
</div>


    <confirm-modal></confirm-modal>

    <div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    Employee List
                    <button type="button" class="close" ng-click="closeEmployeePopUps();">&times;</button>
                </div>
                <div class="modal-body">

                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="GridEmp" ej-grid e-datasource="dataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplateemployee">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                                <div e-column e-template="#stoppageTemplate" e-type="string" e-field="Stoppage" e-headertext="Stoppage" e-width="90"></div>
                                <div e-column e-field="SystemID" e-headertext="Employee Id" e-width="100"></div>
                                <div e-column e-field="EmployeeStatus" e-headertext="Employee Status" e-width="100"></div>
                                <div e-column e-field="EmployeeCurrentStatus" e-headertext="Employee Current Status" e-width="100"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="100"></div>
                                <div e-column e-field="Skill" e-headertext="Skill" e-width="100"></div>
                                <div e-column e-field="GivenDesignation" e-headertext="Given Designation" e-width="100"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-width="100"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                                <div e-column e-field="EntityName" e-headertext="Entity" e-width="100"></div>
                            </div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.isSelected" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headchk" />
                    </script>

                    <script type="text/template" id="templateBalance">
                        <div class="text-left" style="width:100%">
                            <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.AvailablePopUpData(this);">{{data.Balance}}</a>
                        </div>
                    </script>

                    <script type="text/template" id="stoppageTemplate">
                        <div class="text-left" style="width:100%">
                            <div class="select-style">
                                <input ej-dropdownlist e-datasource="$parent.StopageDataList" e-value="data.StoppageId" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />
                                @*<input ej-dropdownlist e-datasource="StopageDataList" e-value="Stoppage" e-fields-value="Id" e-fields-text="UserName" e-width="100%" />*@
                            </div>
                        </div>
                    </script>
                </div>
                <div class="modal-footer common-btn">
                    <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Save</button>
                </div>
            </div>
        </div>
    </div>
