<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{title}}</h3>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee Code Level</label>
            <div class="col-sm-8" style=" padding-left: 95px; padding-right: 17px;">
                <div class="select-style">
                    <select id="EmployeeCodeStart" class="form-control" ng-model="ModelNew.EmployeeCodeLevel" name="Level" ng-change="LoadData();" tabindex="1">
                        <option value=""></option>
                        <option Value="CompanyGroup">CompanyGroup</option>
                        <option Value="Company">Company</option>
                        <option Value="Plant">Plant</option>
                    </select>
                </div>
            </div>
        </div>
       
    </div>
    <div class="col-xs-12">
        <div id="Grid" ej-grid e-datasource="dataList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" ng-show="ModelNew.EmployeeCodeLevel=='CompanyGroup'">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                <div e-column e-field="CompanyGroupId" e-headertext="CompanyGroupId" e-width="2"  e-visible="false"></div>
                <div e-column e-field="CompanyGroup" e-headertext="Company Group" e-width="2"></div>
                <div e-column e-template="#StartValue" e-headertext="Start Value" e-width="2" style="height: 20px;"></div>
            </div>
        </div>
        <div id="Grid" ej-grid e-datasource="dataList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" ng-show="ModelNew.EmployeeCodeLevel=='Company'">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                <div e-column e-field="CompanyGroupId" e-headertext="CompanyGroupId" e-width="2"  e-visible="false"></div>
                <div e-column e-field="CompanyGroup" e-headertext="Company Group" e-width="2"></div>
                <div e-column e-field="CompanyId" e-headertext="CompanyId" e-width="2"  e-visible="false"></div>
                <div e-column e-field="Company" e-headertext="Company" e-width="2"></div>
                <div e-column e-template="#StartValue" e-headertext="Start Value" e-width="2" style="height: 20px;"></div>

            </div>
        </div>
        <div id="Grid" ej-grid e-datasource="dataList" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" ng-show="ModelNew.EmployeeCodeLevel=='Plant'">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                <div e-column e-field="CompanyGroupId" e-headertext="CompanyGroupId" e-width="2"  e-visible="false"></div>
                <div e-column e-field="CompanyGroup" e-headertext="Company Group" e-width="2"></div>
                <div e-column e-field="CompanyId" e-headertext="CompanyId" e-width="2"  e-visible="false"></div>
                <div e-column e-field="Company" e-headertext="Company" e-width="2"></div>
                <div e-column e-field="PlantId" e-headertext="PlantId" e-width="2"  e-visible="false"></div>
                <div e-column e-field="Plant" e-headertext="Plant" e-width="2"></div>
                <div e-column e-template="#StartValue" e-headertext="Start Value" e-width="2" style="height: 20px;"></div>

            </div>
        </div>
        <script type="text/template" id="StartValue">
            <div class="col-sm-10" style="padding:0px; width:100px;">
                <input type="text" style="text-align:right" class="form-control" ng-model="data.StartValue" />

            </div>
        </script>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>*@
        </ul>
    </div>
</div>

<confirm-modal></confirm-modal>