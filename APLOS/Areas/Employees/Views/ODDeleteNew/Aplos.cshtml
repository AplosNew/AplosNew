<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    .e-grid .e-rowcell {
        line-height: 22px;
        /*font-size: 14px;*/
        padding: 0px 2px 0px 2px;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>
<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> OD Delete
</h3>
<div class="form-elements form-horizontal" ng-form name="ODDeleteForm">
    <div class="clearfix"></div>
    <input type="hidden" ng-model="ODDelete.Id">
    <input type="text" ng-model="ODDelete.Id" hidden />
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <div class="form-group" show-errors id="div_Employee">
                    <label class="col-sm-3 control-label">Employee<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" class="form-control" ng-model="employeeInformation.EmployeeName" readonly>
                    </div>
                    <button class="single-btn tooltip-here" data-placement="top" title="Employee Change" ng-click="popUp(EmployeeInformation);"><i class="fa fa-search"></i></button>
                </div>
            </div>
        </div>       
        <div class="clearfix"></div>
        <div class="col-xs-12">
            <div class="content-container-fluid" style="color:black;">
                <div style="color:black;" id="Grid" ej-grid e-datasource="OdList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="70"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                        <div e-column e-field="FromDate" e-headertext="From Date" e-width="60"></div>
                        <div e-column e-field="ToDate" e-headertext="To Date" e-width="60"></div>
                        <div e-column e-field="IsApproved" e-headertext="Approved" e-width="60"></div>
                        <div e-column e-headertext="Actions" e-width="50">
                            <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.remove($event);" style="margin: -4px;"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
       
    </div>
</div>
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                {{popUpTitle}}
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in popUpList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="popUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="popUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Division</th>
                                <th>Section</th>
                                <th>Department</th>
                                <th>Given Designation</th>
                                <th>Employee Category</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
                                ng-click="selectSingleClick(x)" ng-dblclick="selectdblClick(x);">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.Division}}</td>
                                <td>{{x.Section}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.GivenDesignation}}</td>
                                <td>{{x.EmployeeCategory}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="popUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
