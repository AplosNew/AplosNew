<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Resignation Approval Information
</h3>
<style>
    * {
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
    }

    .inputBtnSection {
        /*display: inline-block;*/
        vertical-align: top;
        font-size: 0;
        font-family: verdana;
    }

    .disableInputField {
        /*display: inline-block;*/
        vertical-align: top;
        height: 27px;
        margin: 0;
        font-size: 14px;
        padding: 0 3px;
    }

    .fileUpload {
        position: relative;
        overflow: hidden;
        /*border: solid 1px gray;*/
        display: inline-block;
        vertical-align: top;
    }

    .uploadBtn {
        display: inline-block;
        vertical-align: top;
        background: #242841;
        font-size: 14px;
        padding: 0 10px;
        height: 25px;
        line-height: 22px;
        color: #fff;
    }

    .fileUpload input.upload {
        position: absolute;
        top: 0;
        right: 0;
        margin: 0;
        padding: 0;
        font-size: 20px;
        cursor: pointer;
        opacity: 0;
        filter: alpha(opacity=0);
    }
</style>
<div class="form-elements form-horizontal" ng-form name="ResignationForm">
    <input type="hidden" ng-model="Resignation.Id">
    <div class="col-xs-12 col-sm-7 col-md-7">
        @*<div class="common-btn">
                <ul class="list-inline text-left">
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-plus"></i> Add</button></li>
                    <li> <button ng-click="showSearch('REG')" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> Search</button></li>
                </ul>
            </div>*@
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style show-message">
                    <select class="form-control" ng-disabled="Resignation.Id.length>0" ng-model="Resignation.PlantId" ng-change="getEntityWithChange();"
                            ng-options="item.Value as item.Text for item in PlantList" id="plantId" name="Plant" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employee ID</label>
            <label class="col-sm-4 control-label">{{Resignation.EmpSystemId}}</label>
            @*<div class="col-sm-7 show-message">
                    <input type="text" name="EmpSystemId" ng-show="false" ng-model="Resignation.EmpSystemId" class="form-control" readonly required>
                    <input type="text" name="EmployeeName" ng-model="Resignation.EmpSystemId" class="form-control" readonly>
                </div>*@

        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Designation</label>
            <label class="col-sm-4 control-label">{{Resignation.Designation}}</label>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Date Of Join</label>
            <label class="col-sm-4 control-label">{{Resignation.DOJ}}</label>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Resignation Submission Date</label>
            <label class="col-sm-4 control-label">{{Resignation.ResignationDate}}</label>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Reason</label>
            <label class="col-sm-4 control-label">{{Resignation.Reason}}</label>
        </div>

        @*<div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Approval Status<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="Resignation.IsApproved" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>*@

        <div class="form-group">
            <label class="col-sm-4 control-label">Approval Status</label>
            <div class="col-sm-8">
                <div class="select-style show-message">
                    <select class="form-control"ng-model="Resignation.ApprovalStatus"
                            ng-options="item.Value as item.Text for item in ApprovalList" id="plantId" name="Plant" required tabindex="1">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Approved Effective Date<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="text" ng-disabled="!Resignation.IsApproved" ng-model="Resignation.ApprovedEffectiveDate" datepicker class="form-control datepicker" placeholder="dd-MM-yyyy" tabindex="7">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employee Name</label>
            <div class="col-sm-7 show-message">
                <input type="text" name="EmpSystemId" ng-show="false" ng-model="Resignation.EmpSystemId" class="form-control" readonly required>
                <input type="text" name="EmployeeName" ng-model="Resignation.EmployeeName" class="form-control" readonly>
            </div>
            <div class="col-sm-1">
                <button ng-click="showSearch('EMP');" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employee Code</label>
            <label class="col-sm-4 control-label">{{Resignation.EmployeeCode}}</label>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employee Category</label>
            <label class="col-sm-4 control-label">{{Resignation.EmployeeCategory}}</label>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Date Of Confirmation</label>
            <label class="col-sm-4 control-label">{{Resignation.DOC}}</label>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Applied Effective Date</label>
            <label class="col-sm-4 control-label">{{Resignation.EffectiveDate}}</label>
        </div>    
        <div class="form-group">
            <label class="col-sm-4 control-label">Updated Resignation Letter</label>
            <label class="col-sm-4 control-label"><a href="{{dwonloadUrl}}" ng-click="FileDownload(Resignation)" style="text-decoration:underline" download="{{Resignation.AttachLetter}}" target="_self">{{Resignation.AttachLetter}}</a></label>

        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Remarks<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" ng-model="Resignation.Remarks" class="form-control" maxlength="15" required tabindex="3">
            </div>
        </div>

    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Resignation.Id.length>0?'Update':'Save'}}</button></li>
            @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<confirm-modal></confirm-modal>
<modal-table modalid="resignationpopUpId"
             data-title={{popUpTitle}}
             data-search-parameters="resignationpopUpParameters"
             data-exclued-column-list="Code"
             data-field-list="popUpList"
             data-data-list="resignationpopUpDataList"
             data-search-function="getPopUpData"
             data-single-click="selectSingleClick(data)"
             data-double-click="resignationDoubleClick(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectByButton()"
             data-ng-click-cancel="resignationclosePopUp()">
</modal-table>
<modal-table modalid="popUpId"
             data-title={{popUpTitle}}
             data-search-parameters="popUpParameters"
             data-exclued-column-list="Code"
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click="selectSingleClick(data)"
             data-double-click="selectDoubleClick(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectByButton()"
             data-ng-click-cancel="closePopUp()">
</modal-table>
<modal-table modalid="search_popup"
             data-title="Search (Finished Goods) Data"
             data-search-parameters="popUpParameters"
             data-exclued-column-list="excluedColumnList"
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click=""
             data-double-click="getSearchObject(data)"
             data-right-button="false"
             data-left-button="false"
             data-ng-click-left-button=""
             data-ng-click-cancel="">
</modal-table>
<confirm-archive-generic modalid="confirmDelete" title="Confirmation" data-ng-click-left-button="confirmCloseExperienceDelete()" message={{message_confirmation}} data-ng-click-right-button="removeResignation()"></confirm-archive-generic>