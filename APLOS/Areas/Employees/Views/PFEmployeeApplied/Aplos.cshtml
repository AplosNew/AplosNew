<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>PF Entitlement</h3>
<div class="form-elements row">
    <div class="col-xs-12">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Mandatory PF Entitle</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">PF Entitlement</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row">
                        <div class="row text-right">
                            <div class="col-xs-12 col-sm-12 col-sm-12">
                                <div class="search-form">
                                    <div class="row">
                                        <div class="col-xs-12 col-sm-3 col-md-3">
                                            <div class="select-style">
                                                <select ng-model="popUpPFMandatoryEmployeeParameters.searchBy">
                                                    <option ng-repeat="option in searchByPFMandatoryEmployeeList" value="{{option.value}}">{{option.name}}</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-xs-12 col-sm-7 col-md-7">
                                            <input type="text" class="form-control" placeholder="Search" ng-model="popUpPFMandatoryEmployeeParameters.search" ng-enter="getPFMandatoryEmployeeData()">
                                        </div>
                                        <div class="col-xs-12 col-sm-2 col-md-2">
                                            <button type="button" ng-click="getPFMandatoryEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Employee Code</th>
                                        <th>Employee Name</th>
                                        <th>Designation</th>
                                        <th>Department</th>
                                        <th>Section</th>
                                        <th>Sub Section</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="x in PFMandatoryEmployeeList |itemsPerPage:popUpPFMandatoryEmployeeParameters.pageSize" total-items="popUpPFMandatoryEmployeeParameters.total_count" pagination-id="metaData.name + 'PFMandatoryEmployeeList'">
                                        <td>{{x.EmployeeCode}}</td>
                                        <td>{{x.EmployeeName}}</td>
                                        <td>{{x.EmpDesignation}}</td>
                                        <td>{{x.EMPDepartment}}</td>
                                        <td>{{x.EMPSection}}</td>
                                        <td>{{x.EMPSubSection}}</td>
                                    </tr>
                                </tbody>
                            </table>
                            <dir-pagination-controls max-size="10"
                                                     pagination-id="metaData.name + 'PFMandatoryEmployeeList'"
                                                     direction-links="true"
                                                     boundary-links="true"
                                                     on-page-change="getPFMandatoryEmployeeData(newPageNumber)">
                            </dir-pagination-controls>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row">
                        <div class="row text-right">
                            <div class="col-xs-12 col-sm-12 col-sm-12">
                                <div class="search-form">
                                    <div class="row">
                                        <div class="col-xs-12 col-sm-3 col-md-3">
                                            <div class="select-style">
                                                <select ng-model="popUpPFOptionalEmployeeParameters.searchBy">
                                                    <option ng-repeat="option in searchByPFOptionalEmployeeList" value="{{option.value}}">{{option.name}}</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-xs-12 col-sm-7 col-md-7">
                                            <input type="text" class="form-control" placeholder="Search" ng-model="popUpPFOptionalEmployeeParameters.search" ng-enter="getPFOptionalEmployeeData()">
                                        </div>
                                        <div class="col-xs-12 col-sm-2 col-md-2">
                                            <button type="button" ng-click="getPFOptionalEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Select</th>
                                        <th>Employee Code</th>
                                        <th>Employee Name</th>
                                        <th>Designation</th>
                                        <th>Department</th>
                                        <th>Section</th>
                                        <th>Sub Section</th>
                                        <th>Not entitle get allownce</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="x in PFOptionalEmployeeList |itemsPerPage:popUpPFOptionalEmployeeParameters.pageSize" total-items="popUpPFOptionalEmployeeParameters.total_count" pagination-id="metaData.name + 'PFOptionalEmployeeList'">
                                        <td>
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" ng-model="x.Checked" ng-change="getNotEntitleGetAllownceChecked($index,x)">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </td>
                                        <td>{{x.EmployeeCode}}</td>
                                        <td>{{x.EmployeeName}}</td>
                                        <td>{{x.EmpDesignation}}</td>
                                        <td>{{x.EMPDepartment}}</td>
                                        <td>{{x.EMPSection}}</td>
                                        <td>{{x.EMPSubSection}}</td>
                                        <td>
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" ng-model="x.IsPFNotEntitleGetAllownceKeepChecked" ng-disabled="x.PFNotEntitleGetAllownceCheckDisabled">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <dir-pagination-controls max-size="10"
                                                     pagination-id="metaData.name + 'PFOptionalEmployeeList'"
                                                     direction-links="true"
                                                     boundary-links="true"
                                                     on-page-change="getPFOptionalEmployeeData(newPageNumber)">
                            </dir-pagination-controls>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeletePFEmployeeAppliedList()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>