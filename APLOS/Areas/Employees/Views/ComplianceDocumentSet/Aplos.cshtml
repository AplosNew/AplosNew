<togglable name="Compliance Document Set"></togglable>
<div class="form-elements form-horizontal" ng-form name="complianceDocumentSetNewForm">
    <input type="hidden" ng-model="complianceDocumentSetNew.Id">
    <div class="row">

        <div class="modal-body">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Compliance Document</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Document Proof</a></li>
                </ul>
            </div>


            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Compliance Document</legend>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" name="Sequence" ng-model="complianceDocumentSetNew.Sequence" class="form-control" required tabindex="1">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Short Name" ng-model="complianceDocumentSetNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="User Name" ng-model="complianceDocumentSetNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="complianceDocumentSetNew.Description" tabindex="7" maxlength="250"></textarea>
                                </div>
                            </div>

                            @*<fieldset class="scheduler-border">
                                <legend class="scheduler-border">Document Proof</legend>
                                    <div class="form-group">
                                        <table style="border: 1px solid #d8d7d7;">
                                            <tbody>
                                                <tr ng-repeat="x in documentProofList" style="border: 1px solid #d8d7d7;">
                                                    <td style="padding-left: 6px;">{{x.UserName}}</td>
                                                    <td>
                                                        <div class="checkbox-site" style="margin-top: -4px;margin-bottom: -2px;float:right">
                                                            <label class="control-label">
                                                                <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag">
                                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                            </fieldset>*@

                            
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="complianceDocumentPopUp();" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus"></i> Add Document</button></li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Code" ng-model="complianceDocumentSetNew.Code" class="form-control" required tabindex="2" maxlength="10">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Standard Name" ng-model="complianceDocumentSetNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="complianceDocumentSetNew.Remarks" maxlength="250" tabindex="6"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Active</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="complianceDocumentSetNew.Active">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                </div>

                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">

                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Document Proof</legend>
                        <div class="col-sm-12 form-group">
                            <div class="table-responsive modal-table">
                                <table class="table table-striped" style="border: 1px solid #d8d7d7;">
                                    <tbody>
                                        <tr dir-paginate="x in documentProofList|itemsPerPage:paginationParameters.pageSize" pagination-id="metaData.name + 'documentProofList'" total-items="paginationParameters.total_count">
                                            <td style="padding-left: 6px;">{{x.UserName}}</td>
                                            <td>
                                                <div class="checkbox-site" style="margin-top: -4px;margin-bottom: -2px;float:right">
                                                    <label class="control-label">
                                                        <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectChValueId($event,x)">


                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <dir-pagination-controls max-size="10"
                                                     pagination-id="metaData.name + 'documentProofList'"
                                                     direction-links="true"
                                                     boundary-links="true"
                                                     on-page-change="getTypeData(newPageNumber)">
                            </dir-pagination-controls>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>

        <div class="col-sm-12" ng-show="complianceDocumentSetDetailList.length>0">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Document Name</th>
                            <th>Document Category</th>
                            <th>Document Subcategory</th>
                            <th>Document Type</th>
                            <th>Importance</th>
                            <th>Employment Stage</th>
                            <th>Optional or Mandatory</th>
                            <th>Remove</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in complianceDocumentSetDetailList">
                            <td>{{x.UserName}}</td>
                            <td>{{x.ComplianceDocumentCategoryName}}</td>
                            <td>{{x.ComplianceDocumentSubCategoryName}}</td>
                            <td>{{x.DocumentType}}</td>
                            <td>{{x.Importance}}</td>
                            <td>{{x.EmploymentStage}}</td>
                            <td>
                                <div class="select-style">
                                    <select name="OptionalOrMandatory" class="form-control" ng-model="x.OptionalOrMandatory">
                                        <option value="Optional">Optional</option>
                                        <option value="Mandatory">Mandatory</option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <ul class="list-inline action-list">
                                    <li><button ng-click="valuePassInDelModal(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
        <div class="col-xs-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in complianceDocumentSets |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<div class="modal fade site-modal in" id="complianceDocumentPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Compliance Document Set
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="complianceDocumentListParameters.searchBy">
                                            <option ng-repeat="option in searchByComplianceDocumentList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="complianceDocumentListParameters.search"  ng-enter="getComplianceDocumentData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getComplianceDocumentData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Document Name</th>
                                <th>Document Category</th>
                                <th>Document Subcategory</th>
                                <th>Document Type</th>
                                <th>Importance</th>
                                <th>Employment Stage</th>
                                <th>Optional or Mandatory</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in complianceDocuments |itemsPerPage:complianceDocumentListParameters.pageSize"  pagination-id="metaData.name + 'complianceDocuments'"  total-items="complianceDocumentListParameters.total_count" ng-dblclick="selectComplianceDocument(x);">
                                <td>
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="x.Flag" checked="{{x.Flag}}" ng-click="selectFirstChValue($event,x)">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.ComplianceDocumentCategoryName}}</td>
                                <td>{{x.ComplianceDocumentSubCategoryName}}</td>
                                <td>{{x.DocumentType}}</td>
                                <td>{{x.Importance}}</td>
                                <td>{{x.EmploymentStage}}</td>
                                <td>{{x.OptionalOrMandatory}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'complianceDocuments'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getComplianceDocumentData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button type="button" class="btn btn-default" data-dismiss="modal">Close</button></li>
                        <li> <button type="submit" class="btn btn-default" ng-click="selectComplianceDocument();">Select</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="deleteRow" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
