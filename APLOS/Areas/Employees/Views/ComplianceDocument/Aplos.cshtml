<togglable name="Compliance Document"></togglable>
<div class="form-horizontal" ng-form name="complianceDocumentNewForm">
    <input type="hidden" ng-model="complianceDocumentNew.Id">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Type<sup>*</sup> </label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select id="Type" class="form-control" ng-model="complianceDocumentNew.Type" name="Type" required tabindex="1" ng-change="GetDocData()">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in typeList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="modal-body">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Compliance Document</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Document Proof</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Compliance Document</legend>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" name="Sequence" ng-model="complianceDocumentNew.Sequence" class="form-control" required tabindex="1">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Short Name" ng-model="complianceDocumentNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Document Name" ng-model="complianceDocumentNew.UserName" class="form-control" maxlength="100" required tabindex="5">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Document Category <sup>*</sup></label>
                                <div class="col-sm-8  show-message">
                                    <div class="select-style">
                                        <select name="Document Category" class="form-control" ng-model="complianceDocumentNew.ComplianceDocumentCategoryId" ng-options="item.Value as item.Text for item in complianceDocumentCategoryList" required tabindex="7">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Document Type<sup>*</sup></label>
                                <div class="col-sm-8  show-message">
                                    <div class="select-style">
                                        <select name="Document Type" class="form-control" ng-model="complianceDocumentNew.DocumentType" ng-options="item.Value as item.Text for item in documentTypeList" required tabindex="9">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label" title="Responsible Person"><span>Responsible Person</span></label>
                                <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                                    <span class="input-group-addon">{{complianceDocumentNew.ResponsiblePersonCode}}</span>
                                    <input type="text" ng-model="complianceDocumentNew.PositionName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="employeeProfilePopUp()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="employeeProfileClear()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                    </span>
                                </div>
                            </div>
                            <fieldset class="scheduler-border" ng-show="complianceDocumentNew.Type==='EmployeeRelated'">
                                <legend class="scheduler-border">Employee Related</legend>
                                <div class="form-group" ng-show="complianceDocumentNew.Type==='EmployeeRelated'">
                                    <label class="col-sm-4 control-label">Dependent Date<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <div class="select-style">
                                            <select name="Dependate Date" class="form-control" ng-model="complianceDocumentNew.DependateDate" ng-options="item.Value as item.Text for item in dependateDateList" tabindex="16">
                                                <option></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" ng-show="complianceDocumentNew.Type==='EmployeeRelated'">
                                    <label class="col-sm-4 control-label">Documentation By<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        Self <input type="radio" ng-model="complianceDocumentNew.DocumentationBy" value="Self">
                                        Department <input type="radio" ng-model="complianceDocumentNew.DocumentationBy" value="Department">
                                    </div>
                                </div>
                                <div class="form-group" ng-show="complianceDocumentNew.Type==='EmployeeRelated'">
                                    <label class="col-sm-4 control-label">Profile Type</label>
                                    <div class="col-sm-8">
                                        <div class="select-style">
                                            <select name="Profile Type" class="form-control" ng-model="complianceDocumentNew.ProfileType" ng-options="item.Value as item.Text for item in getProfileTypeList" tabindex="17">
                                                <option></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" ng-show="complianceDocumentNew.ProfileType==='Qualification'">
                                    <label class="col-sm-4 control-label">Qualification Level</label>
                                    <div class="col-sm-8">
                                        <div class="select-style">
                                            <select name="Qualification label" class="form-control" ng-model="complianceDocumentNew.QualificationLevelId" ng-options="item.Value as item.Text for item in qualificationLabelList" tabindex="18">
                                                <option></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" ng-show="complianceDocumentNew.Type==='EmployeeRelated'">
                                    <label class="col-sm-4 control-label">Emp Type<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <div class="select-style">
                                            <select name="EmpType" class="form-control" ng-model="complianceDocumentNew.EmpType" tabindex="19">
                                                <option value="Expatriate">Expatriate</option>
                                                <option value="Local">Local</option>
                                                <option value="Both">Both</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group" ng-show="complianceDocumentNew.Type==='EmployeeRelated'">
                                    <label class="col-sm-4 control-label">Lead or Lag Days<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <input type="text" name="Lead or Lag Days" ng-model="complianceDocumentNew.LeadOrLagDays" class="form-control" maxlength="50" only-Numbers tabindex="20">
                                    </div>
                                </div>
                                <div class="form-group" ng-show="complianceDocumentNew.Type==='EmployeeRelated'">
                                    <label class="col-sm-4 control-label">Employment Stage<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <div class="select-style">
                                            <select name="Employment Stage" class="form-control" ng-model="complianceDocumentNew.EmploymentStage" ng-options="item.Value as item.Text for item in employmentStageList" ng-change="resetPostRecritment()" tabindex="21">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" ng-show="complianceDocumentNew.EmploymentStage==='PostRecruitment'">
                                    <label class="col-sm-4 control-label">Post Recruitment</label>
                                    <div class="col-sm-8">
                                        <div ng-dropdown-multiselect="" options="postRecruitmentList" selected-model="postRecruitmentSelectedList"
                                             extra-settings="multiSelectSettings" events="multi1events" tabindex="22"></div>
                                    </div>
                                </div>
                            </fieldset>
                            <div class="form-group" ng-show="complianceDocumentNew.Type==='EmployeeRelated'">
                                <label class="col-sm-4 control-label">Skill Based</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="complianceDocumentNew.IsSkillBased">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="common-btn" ng-show="complianceDocumentNew.Type==='EmployeeRelated'">
                                <ul class="list-inline text-left">
                                    <li> <button ng-disabled="!complianceDocumentNew.IsSkillBased" ng-click="positionPopUp();" class="btn" tabindex="15"><i class="glyphicon glyphicon-plus"></i> Add Position</button></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Code" ng-model="complianceDocumentNew.Code" class="form-control" maxlength="10" required tabindex="2">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Standard Name" ng-model="complianceDocumentNew.StandardName" class="form-control" required tabindex="4" maxlength="100">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Importance<sup>*</sup></label>
                                <div class="col-sm-8  show-message">
                                    <div class="select-style">
                                        <select name="Importance" class="form-control" ng-model="complianceDocumentNew.Importance" ng-options="item.Value as item.Text for item in importanceList" required tabindex="6">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Document Subcategory<sup>*</sup></label>
                                <div class="col-sm-8  show-message">
                                    <div class="select-style">
                                        <select name="Document Subcategory" class="form-control" ng-model="complianceDocumentNew.ComplianceDocumentSubCategoryId" ng-options="item.Value as item.Text for item in complianceDocumentSubCategoryList" required tabindex="8">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Optional or Mandatory</label>
                                <div class="col-sm-8  show-message">
                                    <div class="select-style">
                                        <select name="OptionalOrMandatory" class="form-control" ng-model="complianceDocumentNew.OptionalOrMandatory" tabindex="10">
                                            <option value="Optional">Optional</option>
                                            <option value="Mandatory">Mandatory</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Document No. Required</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="complianceDocumentNew.DocNumberRequired" tabindex="12">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Document Date Required</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="complianceDocumentNew.DocDateRequired" tabindex="14">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">Document Expirable</legend>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Document Expirable<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        Non Expirable <input type="radio" ng-model="complianceDocumentNew.DocumentExpirable" value="NonExpirable">
                                        Expirable <input type="radio" ng-model="complianceDocumentNew.DocumentExpirable" value="Expirable">
                                    </div>
                                </div>
                                <div class="form-group" ng-show="complianceDocumentNew.DocumentExpirable=='Expirable'">
                                    <label class="col-sm-4 control-label">Renewable</label>
                                    <div class="col-sm-1">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="complianceDocumentNew.ReNewAble" tabindex="24">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-sm-7" style="padding-left:0px;" ng-show="complianceDocumentNew.ReNewAble==true">
                                        <label class="col-sm-6 control-label">Renew <span style="text-transform: lowercase;">after every</span></label>
                                        <div class="col-sm-2">
                                            <input type="text" name="ReNewAfterEvery" ng-model="complianceDocumentNew.ReNewAfterEvery" class="form-control" tabindex="4" style="width: 52px;" n-decimals="2">
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="select-style">
                                                <select name="ReNewUOM" class="form-control" ng-model="complianceDocumentNew.ReNewUOM" ng-options="item.Value as item.Text for item in durationUOMList" tabindex="15">
                                                    <option></option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" ng-show="complianceDocumentNew.DocumentExpirable=='Expirable'">
                                    <label class="col-sm-4 control-label">Mail Alert</label>
                                    <div class="col-sm-1">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="complianceDocumentNew.MailAlert" tabindex="24">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-sm-7" style="padding-left:0px;" ng-show="complianceDocumentNew.MailAlert==true">
                                        <label class="col-sm-6 control-label">Days <span>before expiry</span></label>
                                        <div class="col-sm-6">
                                            <input type="text" name="DaysBeforeExpiry" ng-model="complianceDocumentNew.DaysBeforeExpiry" class="form-control" tabindex="4" style="width: 138px;" only-numbers>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="complianceDocumentNew.Description" tabindex="22" maxlength="250"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="3" ng-model="complianceDocumentNew.Remarks" maxlength="250" tabindex="23"></textarea>
                                </div>

                            </div>
                        </div>
                        <div class="col-sm-12" ng-show="positionList.length>0">
                            <div class="table-responsive modal-table">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>User Name</th>
                                            <th>Division</th>
                                            <th>Department</th>
                                            <th>Section</th>
                                            <th>Designation</th>
                                            <th>Remove</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in positionList">
                                            <td>{{x.PositionCode}}</td>
                                            <td>{{x.UserName}}</td>
                                            <td>{{x.Division}}</td>
                                            <td>{{x.Department}}</td>
                                            <td>{{x.Section}}</td>
                                            <td>{{x.Designation}}</td>
                                            <td>
                                                <ul class="list-inline action-list">
                                                    <li><button ng-click="valuePassInDelModal(x,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                                </ul>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Document Proof</legend>
                        <div class="col-sm-12 form-group">
                            <div class="table-responsive modal-table">
                                <table class="table table-striped" style="border: 1px solid #d8d7d7;">
                                    <tbody>
                                        <tr dir-paginate="x in documentProofList|itemsPerPage:paginationParameters.pageSize" pagination-id="metaData.name + 'documentProofList'" total-items="paginationParameters.total_count">
                                            <td style="padding-left: 6px;">{{x.UserName}}</td>
                                            <td>
                                                <div class="checkbox-site" style="margin-top: -4px;margin-bottom: -2px;float:right">
                                                    <label class="control-label">
                                                        <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectChValueId($event,x)">


                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <dir-pagination-controls max-size="10"
                                                     pagination-id="metaData.name + 'documentProofList'"
                                                     direction-links="true"
                                                     boundary-links="true"
                                                     on-page-change="getTypeData(newPageNumber)">
                            </dir-pagination-controls>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>

