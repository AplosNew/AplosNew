<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Compliance Document Report
</h3>
<div class="form-elements form-horizontal" ng-form id="form" name="form">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Document List</label>
            <div class="col-sm-8">
                <div class="radio">
                    <label>
                        <input type="radio" name="DocumentLevel" ng-model="complianceDocumentReport.DocumentLevel" ng-click="DocumentHideShowFn();" value="Document">
                        <span class="cr"><i class="cr-icon"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Document Set</label>
            <div class="col-sm-8">
                <div class="radio">
                    <label>
                        <input type="radio" name="DocumentLevel" ng-model="complianceDocumentReport.DocumentLevel" ng-click="DocumentHideShowFn();" value="DocumentSet">
                        <span class="cr"><i class="cr-icon"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant Wise Document Set</label>
            <div class="col-sm-8">
                <div class="radio">
                    <label>
                        <input type="radio" name="DocumentLevel" ng-model="complianceDocumentReport.DocumentLevel" ng-click="DocumentHideShowFn();" value="PlantWiseDocumentSet">
                        <span class="cr"><i class="cr-icon"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" ng-show="CompanyHideShow">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="complianceDocumentReport.CompanyId" ng-change="companyOnChange()"
                            ng-options="item.Value as item.Text for item in companyList" name="Company" tabindex="1">
                        <option></option>
                    </select>
                </div>
                <p ng-show="selectMessageCompany" style="color:red" class="show-message">{{selectMessageCompany}}</p>
            </div>
        </div>
        <div class="form-group" ng-show="CompanyHideShow">
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="complianceDocumentReport.PlantId"
                            ng-options="item.Value as item.Text for item in plantList" name="Plant" tabindex="2">
                        <option></option>
                    </select>
                </div>
                <p ng-show="selectMessagePlant" style="color:red" class="show-message">{{selectMessagePlant}}</p>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="complianceDocumentReport();" class="btn"><i class="glyphicon glyphicon-print"></i> Print</button></li>
        </ul>
    </div>
</div>

<confirm-modal></confirm-modal>
