<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Candidate Document Assignment
</h3>
<div ng-form name="preRecruitmentEmployeeForm" class="form-horizontal form-element-ctrl">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant</label>
            <div class="col-sm-6 pdr3" style="padding-left: 5px;">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="candidateInfo.PlantId" name="Plant" ng-change="LoadData(candidateInfo.PlantId)">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in plantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
            <div class="col-sm-2"><button ng-click="RefreshBody();" ng-disabled="candidateInfo.PlantId==null" class="btn"><i class="glyphicon glyphicon-refresh"></i></button></div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="col-sm-6">
            <div class="radio">
                <label>
                    <input type="radio" name="Assign" ng-model="candidateInfo.Assign" value="Assign" ng-change="LoadData(candidateInfo.PlantId)">
                    <span class="cr"><i class="cr-icon"></i></span>Assign
                </label>
                <label>
                    <input type="radio" name="Assign" ng-model="candidateInfo.Assign" value="" ng-change="LoadData(candidateInfo.PlantId)">
                    <span class="cr"><i class="cr-icon"></i></span>Non Assign
                </label>
            </div>
        </div>
    </div>
</div>
<div class="clearfix"></div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="SelectionParameters.searchBy">
                            <option ng-repeat="option in searchDataByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="SelectionParameters.search" ng-enter="LoadDataList()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="LoadDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="form-elements form-horizontal" ng-show="recruitmentSelections.length>0">
    <label>Total :{{SelectionParameters.total_count}}</label>
    <input type="hidden" ng-model="candidateInfo.Id">
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        <div class="checkbox-site text-center">
                            <input type="checkbox" ng-click="CheckAll($event);">
                        </div>
                    </th>
                    <th>Candidate ID</th>
                    <th>Candidate Name</th>
                    <th>EmailId</th>
                    <th>Date of Birth</th>
                    <th>Budget Code</th>
                    <th>Entity</th>
                    <th>Position</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Given Designation</th>
                    <th>No. Of Document</th>
                    <th>Documents</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="e in recruitmentSelections |itemsPerPage:SelectionParameters.pageSize" total-items="SelectionParameters.total_count">
                    <td class="text-right table-td">
                        <div class="checkbox-site">
                            <input type="checkbox" ng-model="e.Active" ng-click="selectChValueId($event,e)">
                        </div>
                    </td>
                    <td>{{e.Id}}</td>
                    <td>{{e.FullName | uppercase}}</td>
                    <td>{{e.EmailId}}</td>
                    <td>{{e.DOB | dateFiltering}}</td>
                    <td>{{e.Code}}</td>
                    <td>{{e.EntityName}}</td>
                    <td>{{e.PositionName}}</td>
                    <td>{{e.Department}}</td>
                    <td>{{e.Designation}}</td>
                    <td>{{e.GivenDesignations}}</td>
                    <td>{{e.TotalDoc}}</td>
                    <td>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="showDocumentPopUp(e,$index);" class="btn">Documents</button></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="500"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="LoadDataList(newPageNumber)">
        </dir-pagination-controls>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" ng-disabled="tempIdList.length==0" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
        </ul>
    </div>
</div>
<div class="modal fade site-modal in" id="DocumentPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" style="width: 75%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closepopUp()">&times;</button>
                <h4 class="modal-title"> Assign Documents</h4>
            </div>
            <div class="modal-body" style="width: 99%;padding-left: 3%;">
                <div class="row">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Document Stage</th>
                                    <th>Document Name</th>
                                    <th>File Name</th>
                                    <th>Optional Or Mandatory</th>
                                    <th>Due Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="d in documentdataList">
                                    <td>{{d.EmploymentStage}}</td>
                                    <td>{{d.DocumentName}}</td>
                                    <td ng-click="DocDownload(d)"><a href="{{dwonloadUrl}}" style="text-decoration:underline" download="{{d.FileName}}" target="_self">{{d.FileName}}</a></td>
                                    <td>{{d.OptionalOrMandatory}}</td>
                                    <td>{{d.DueDate | dateFiltering}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button type="submit" class="btn btn-default" ng-click="closepopUp();">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>