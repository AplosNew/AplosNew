<togglable name="Separation Type"></togglable>
<div class="form-elements" ng-form id="SeparationType" name="SeparationTypeForm">
    @*<input type="hidden" ng-model="SeparationType.Id">*@
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" min="1" name="Sequence" ng-model="SeparationType.Sequence" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="15" name="ShortName" ng-model="SeparationType.ShortName" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" ng-model="SeparationType.UserName" name="UserName" class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea maxlength="250" name="Description" class="form-control" rows="3" ng-model="SeparationType.Description" tabindex="7"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="10" name="Code" ng-model="SeparationType.Code" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input maxlength="50" type="text" name="StandardName" ng-model="SeparationType.StandardName" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea maxlength="250" name="Remarks" class="form-control" rows="3" ng-model="SeparationType.Remarks" tabindex="6"></textarea>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input tabindex="8" type="checkbox" ng-model="SeparationType.IsActive">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="row col-md-12" style="margin-left:-10px">
        <fieldset class="scheduler-border" style="width:1076px ;padding:15px !important">
            <div class="col-xs-12 col-sm-6 col-md-6">




                <div class="form-group">
                    <label class="col-sm-4 control-label">Salary Head</label>
                    <div class="col-sm-6">
                        <div class="select-style">

                            <select id="SalaryHeadFormula" class="form-control" ng-model="salaryRuleGeneral.SalaryHeadIdFormula" name="DailyAllowanceType" tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in salaryHeadList" value="{{option.SalaryHeadID}}">{{option.SalaryHead}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('SHead');" style="margin: -4px;"></i></button>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Operator</label>
                    <div class="col-sm-6">
                        <div class="select-style">
                            <select ng-model="salaryRuleGeneral.Operator" class="form-control" name="Operator" tabindex="5">
                                <option value=""></option>
                                <option value="*">*</option>
                                <option value="/">/</option>
                                <option value="+">+</option>
                                <option value="-">-</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('Operator');" style="margin: -4px;"></i></button>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Precedence</label>
                    <div class="col-sm-6">
                        <div class="select-style">
                            <select ng-model="salaryRuleGeneral.Precedence" class="form-control" name="Precedence" tabindex="5">
                                <option value=""></option>
                                <option value="(">(</option>
                                <option value=")">)</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('Precedence');" style="margin: -4px;"></i></button>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Value</label>
                    <div class="col-sm-6">
                        <input type="text" name="Value" ng-model="salaryRuleGeneral.Value" class="form-control" required tabindex="2" maxlength="50">
                    </div>
                    <div class="col-sm-2">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('Value');" style="margin: -4px;"></i></button>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" style="margin-top: -8px;">
                    <button style="color: #f3f3ec;background-color: #1c1f32;margin-top: 8px;" class="btn"><i class="glyphicon glyphicon-backward" ng-click="RemoveFormula();" style="margin: -4px;"></i></button>
                </div>
                <div class="form-group">
                    {{salaryRuleGeneral.FormulaDescription}}
                </div>
            </div>
        </fieldset>
    </div>
    <div class="row form-horizontal form-elements">
        <div class="col-xs-12 col-sm-12 col-md-8 ">
            <div class="common-btn">
                <ul class="list-inline text-right">

                    <li><button ng-click="AddNewRoweparationTypeDetails();" class="btn"><i class="glyphicon glyphicon-plus-sign" tabindex="11"></i> Add Row</button></li>
                </ul>
            </div>

            <div id="GridShiftInfo" ej-grid
                 e-datasource="SeparationTypeDetails"
                 @*e-recorddoubleclick="Get"*@
                 @*e-endedit="updatedata"*@
                 e-templaterefresh="refreshTemplateemployee4"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-enabletouch="true"
                 e-responsive="true"
                 e-allowselection="true"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    @*<div e-column e-headertext="All" e-headertemplateid="#headerTemplate4" e-template="#checkboxTemplate4" e-textalign="center" e-width="30"></div>*@
                    @*<div e-column e-field="Id" e-headertext="Id" e-width="100" e-primarykey="true"></div>*@
                    @*<div e-column e-field="YearNo" e-headertext="Year" e-width="100"></div>*@


                    <div e-column e-template="#YearNo" e-headertext="Year No." e-width="100"></div>
                    <div e-column e-template="#DayNo" e-headertext="Days No." e-width="100"></div>
                    <div e-column e-template="#RoundUp" e-headertext="Round Up" e-width="30"></div>
                    @*<div e-column e-template="#EmploymentType" e-headertext="Type" e-width="150"></div>*@
                </div>
            </div>
            <script type="text/template" id="checkboxTemplate4">

                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>
            <script type="text/x-jsrender" id="headerTemplate4">
                <input type="checkbox" id="headchk4" />
            </script>
            <script type="text/template" id="YearNo">
                <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                    <input type="text" ng-model="data.YearNo" style="color:black;" class="form-control" />

                </div>
            </script>
            <script type="text/template" id="DayNo">
                <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                    <input type="text" ng-model="data.DayNo" style="color:black;" class="form-control" />

                </div>
            </script>
            <script type="text/template" id="RoundUp">
                <div class="col-sm-10" style="padding:0px; width:100%;height:20px; text-align:center">
                    <input type="checkbox" id="headchk4" ng-model="data.RoundUp" />

                </div>
            </script>
            <script type="text/template" id="EmploymentType">
                <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                    <div class="select-style">
                        <input ej-dropdownlist e-datasource="$parent.EmploymentTypeList" e-value="data.EmploymentType" e-fields-value="UserName" e-fields-text="UserName" e-width="100%" />
                        @*<select id="SalaryHeadFormula" class="form-control" ng-model="salaryRuleGeneral.SalaryHeadIdFormula" name="DailyAllowanceType" tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in $parent.EmploymentTypeList" value="{{option.UserName}}">{{option.UserName}}</option>
                            </select>*@
                    </div>

                </div>
            </script>

        </div>
        <div class="col-xs-12 col-sm-12 col-md-4 ">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border"> Gratuity</legend>
                <div class="form-group">
                    <label class="col-sm-8 control-label"> Applicable</label>
                    <div class="col-sm-4">
                        <div class="checkbox-site">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="SeparationType.IsGratuityApplicable">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-8 control-label">Net Pay with Final settlement</label>
                    <div class="col-sm-4">
                        <div class="checkbox-site">
                            <label>
                                <input tabindex="8" type="checkbox" ng-model="SeparationType.IsNetPayWithFinalSattlement">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </fieldset>
            <div class="form-group">
                <label class="col-sm-8 control-label">Fixed Days Amount Applicable</label>
                <div class="col-sm-4">
                    <div class="checkbox-site">
                        <label>
                            <input tabindex="8" type="checkbox" ng-model="SeparationType.IsFixedDayAmountApplicable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

            <div id="GridEmploymentTypelistForFiexdDays" ej-grid
                 e-datasource="EmploymentTypelistForFiexdDays"
                 @*e-recorddoubleclick="Get"*@
                 @*e-endedit="updatedata"*@
                 @*e-templaterefresh="refreshTemplateemployee4"*@
                 @*e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"*@
                 e-enabletouch="true"
                 e-responsive="true"
                 e-allowselection="true"
                 @*e-filtersettings-filterType="excel"*@>
                <div e-columns>

                    <div e-column e-field="EmploymentType" e-headertext="Employment Type" e-width="100"></div>
                    <div e-column e-template="#DayNoFixed" e-headertext="Days No." e-width="100"></div>


                </div>
            </div>

            <script type="text/template" id="DayNoFixed">
                <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                    <input type="text" ng-model="data.DayNo" style="color:black;" class="form-control" />

                </div>
            </script>


        </div>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
            @*<li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" ng-disabled="checkIdUsedValue" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">

        <div style="color:black;"
             id="GridSeparationTypesList"
             ej-grid e-datasource="SeparationTypesList"
             e-gridlines="vertical"
             e-allowfiltering="true"
             e-allowpaging="true"
             e-allowsorting="true"
             e-allowselection="true"
             e-filtersettings-filterType="excel" e-allowtouch="true">
            <div e-columns>
                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="100" @*e-visible="false" e-primarykey="true"*@></div>
                <div e-column e-field="Code" e-headertext="Code" e-width="100"></div>
                <div e-column e-field="UserName" e-headertext="UserName" e-width="100"></div>
                <div e-column e-field="FormulaDes" e-headertext="FormulaDes" e-width="55"></div>
                <div e-column e-field="IsGratuityApplicable" e-headertext="IsGratuityApplicable Date" e-width="50"></div>

                <div e-column e-headertext="Actions" e-width="70">
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-edit" ng-click="$parent.EditSeparationType($event);" style="margin: -6px;"></i></button>
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.remove($event);" style="margin: -6px;"></i></button>

                </div>
            </div>
        </div>
    </div>

</div>

<confirm-modal></confirm-modal>