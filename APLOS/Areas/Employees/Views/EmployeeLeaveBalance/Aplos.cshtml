<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Leave Balance Information
</h3>
<style>
    * {
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
    }

    .inputBtnSection {
        /*display: inline-block;*/
        vertical-align: top;
        font-size: 0;
        font-family: verdana;
    }

    .disableInputField {
        /*display: inline-block;*/
        vertical-align: top;
        height: 27px;
        margin: 0;
        font-size: 14px;
        padding: 0 3px;
    }

    .fileUpload {
        position: relative;
        overflow: hidden;
        /*border: solid 1px gray;*/
        display: inline-block;
        vertical-align: top;
    }

    .uploadBtn {
        display: inline-block;
        vertical-align: top;
        background: #242841;
        font-size: 14px;
        padding: 0 10px;
        height: 25px;
        line-height: 22px;
        color: #fff;
    }

    .fileUpload input.upload {
        position: absolute;
        top: 0;
        right: 0;
        margin: 0;
        padding: 0;
        font-size: 20px;
        cursor: pointer;
        opacity: 0;
        filter: alpha(opacity=0);
    }
</style>

<p style="text-decoration:underline;cursor:pointer;" ng-show="message==null || message == ''" ng-click="showEntity();">My Entity List</p>
<p class="msg-success" ng-show="message!=null || message == ''">{{message}}</p>

<div class="form-elements form-horizontal" ng-form="EmployeeLeaveBalanceForm">
    <div class="">
        <input type="hidden" ng-model="EmployeeLeaveBalance.Id">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <div class="select-style show-message">
                            <select class="form-control" ng-disabled="EmployeeLeaveBalance.Id.length>0" ng-model="EmployeeLeaveBalance.PlantId" ng-change=""
                                    ng-options="item.Value as item.Text for item in PlantList" id="plantId" name="Plant" required tabindex="1">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-sm-1">
                        <button ng-click="showSearch('NewEMP');" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Employee Name</label>
                    <div class="col-sm-8">
                        <div class="select-style show-message">
                            <input type="text" name="Entity" ng-model="EmployeeLeaveBalance.EmployeeName" class="form-control" readonly>
                        </div>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Date Of Join</label>
                    <div class="col-sm-8">
                        <div class="select-style show-message">
                            <input type="text" name="Entity" ng-model="EmployeeLeaveBalance.DOJ" class="form-control" readonly>
                        </div>
                    </div>
                </div>
                @*<div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Current Year Allocation</label>
                    <div class="col-sm-8">
                        <div class="select-style show-message">
                            <input type="text" name="Entity" ng-model="EmployeeLeaveBalance.CurrentYearAllocation" class="form-control" readonly>
                        </div>
                    </div>
                </div>*@
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Availed Opening Balance<sup>*</sup></label>
                    <div class="col-sm-8">
                        <div class="select-style show-message">
                            <input type="text" name="Entity" ng-model="EmployeeLeaveBalance.AvailedOpeningBalance" class="form-control">
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Given Designation</label>
                    <div class="col-sm-8">
                        <div class="select-style show-message">
                            <input type="text" name="Entity" ng-model="EmployeeLeaveBalance.GivenDesignation" class="form-control" readonly>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Date Of Confirmation</label>
                    <div class="col-sm-8">
                        <div class="select-style show-message">
                            <input type="text" name="Entity" ng-model="EmployeeLeaveBalance.DOC" class="form-control" readonly>
                        </div>
                    </div>
                </div>

                @*<div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Can Avail At Present</label>
                    <div class="col-sm-8">
                        <div class="select-style show-message">
                            <input type="text" name="Entity" ng-model="EmployeeLeaveBalance.DaysCanBeSanctioned" class="form-control" readonly>
                        </div>
                    </div>
                </div>*@

                
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right" style="margin-left:10px;margin-right:15px">
                <li> <button ng-click="Update();" class="btn" ng-disabled="EmployeeLeaveBalance.EmployeeName==null" tabindex="7"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="8"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>

            </ul>
        </div>

        <div class="modal fade site-modal in" id="ResignationHistoryPopUp" role="dialog" data-backdrop="static">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header"> Resignation History<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                    <div class="modal-body">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Resignation Date</th>
                                        <th>Applied Effective Date</th>
                                        <th>Approved Effective Date</th>
                                        <th>Approval Starus</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in entityList">
                                        <td align="center">{{x.ResignationDate}}</td>
                                        <td align="center">{{x.EffectiveDate}}</td>
                                        <td align="center">{{x.ApprovedEffectiveDate}}</td>
                                        <td align="center">{{x.ApprovalStatus}}</td>
                                        <td>{{x.Remarks}}</td>
                                    </tr>
                                </tbody>

                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
            <div class="modal-dialog modal-sm">
                <div class="modal-content">
                    <div class="modal-header"> My Entity List<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                    <div class="modal-body">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Entity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in entityList">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.EntityName}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>




<confirm-modal></confirm-modal>
<modal-table modalid="popUpId1"
             data-title="Active Employee Information"
             data-search-parameters="popUpParameters"
             data-exclued-column-list="excluedEmpColumn"
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click="selectSingleClick(data)"
             data-double-click="getSearchObject(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectByButton()"
             data-ng-click-cancel="closePopUp()">
</modal-table>

<modal-table modalid="popUpId2"
             data-title="Pending Employee Information"
             data-search-parameters="popUpParameters"
             data-exclued-column-list="excluedEmpColumn"
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click="selectSingleClick(data)"
             data-double-click="getSearchObject(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectByButton()"
             data-ng-click-cancel="closePopUp2()">
</modal-table>


