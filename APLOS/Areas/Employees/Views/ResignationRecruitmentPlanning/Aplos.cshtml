<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Resignation Recruitment Planning
</h3>
<style>
    * {
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
    }

    .inputBtnSection {
        /*display: inline-block;*/
        vertical-align: top;
        font-size: 0;
        font-family: verdana;
    }

    .disableInputField {
        /*display: inline-block;*/
        vertical-align: top;
        height: 27px;
        margin: 0;
        font-size: 14px;
        padding: 0 3px;
    }

    .fileUpload {
        position: relative;
        overflow: hidden;
        /*border: solid 1px gray;*/
        display: inline-block;
        vertical-align: top;
    }

    .uploadBtn {
        display: inline-block;
        vertical-align: top;
        background: #242841;
        font-size: 14px;
        padding: 0 10px;
        height: 25px;
        line-height: 22px;
        color: #fff;
    }

    .fileUpload input.upload {
        position: absolute;
        top: 0;
        right: 0;
        margin: 0;
        padding: 0;
        font-size: 20px;
        cursor: pointer;
        opacity: 0;
        filter: alpha(opacity=0);
    }

    .old {
        background-color: #e08283;
    }

    .current {
        background-color: #52b3d9;
    }

    .pending {
        background-color: #c8f7c5;
    }
</style>
<p style="text-decoration:underline;cursor:pointer;" ng-show="message==null || message == ''" ng-click="showEntity();">My Entity List</p>
<p class="msg-success" ng-show="message!=null || message == ''">{{message}}</p>
<div class="form-horizontal" ng-form id="recruitmentGroup" name="recruitmentGroupForm">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="resignationRecruitmentPlanning.CompanyId" name="Company"
                            ng-options="item.Value as item.Text for item in companyList"
                            ng-change="getCboPlantByCompany(resignationRecruitmentPlanning.CompanyId)" required>
                        <option value="">--Select--</option>
                    </select>

                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="resignationRecruitmentPlanning.PlantId" name="Plant"
                            ng-options="item.Value as item.Text for item in plantList"
                            ng-change="getSequence()"
                            required>
                        <option value="">--Select--</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="">

        <div class="row text-right">
            <div class="col-xs-12 col-sm-12 col-sm-12">
                <div class="search-form">
                    <div class="row">
                        <div class="col-xs-12 col-sm-3 col-md-3">
                            <div class="select-style">
                                <select tabindex="18" ng-model="$root.parameters.searchBy">
                                    <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-7 col-md-7">
                            <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="LoadDataList()">

                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2">
                            <button type="button" ng-click="LoadDataList();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-elements form-horizontal" ng-show="resignationRecruitmentPlannings.length>0">
            <input type="hidden" ng-model="resignationRecruitmentPlanning.Id">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Select</th>
                            <th>Employee Name</th>
                            <th>Employee Code</th>
                            <th>Entity</th>
                            <th>Position</th>
                            <th>Budget Code</th>
                            <th>Resignation Date</th>
                            <th>Hand Over Days</th>
                            <th>OnBoard Date</th>
                            <th>Recruitment Process Set</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="e in resignationRecruitmentPlannings |itemsPerPage:SelectionParameters.pageSize" total-items="SelectionParameters.total_count">
                            <td class="text-right table-td">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="e.Active" checked="{{e.Active}}" ng-click="selectChValueId($event,e)">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>{{e.EmployeeName}}</td>
                            <td>{{e.EmployeeCode}}</td>
                            <td>{{e.EntityName}}</td>
                            <td>{{e.PositionName}}</td>
                            <td>{{e.BudgetCode}}</td>
                            <td>{{e.ResignationDate}}</td>
                            <td>{{e.HandoverDays}}</td>
                            <td>{{e.OnBoardDate1}}</td>
                            <td>
                                <button ng-click="loadRecruitmentPopUp(e,$index)" ng-disabled="e.ProcessName===null" style="width:120px;"class="btn">{{e.ProcessName !=null ? e.ProcessName : 'No Process Set'}}</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <dir-pagination-controls max-size="10"
                                     direction-links="true"
                                     boundary-links="true"
                                     on-page-change="LoadDataList(newPageNumber)">
            </dir-pagination-controls>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" ng-disabled="tempIdList.length==0" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            </ul>
        </div>
    </div>

</div>

<div class="modal fade site-modal in" id="recruitmentPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-m">
        <div class="modal-content">
            <div class="modal-header"> Process Set Information<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Process Name</th>
                                <th>Days Required</th>
                                <th>Process Finished Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in resignationRecruitmentPlannings1">
                                <td>{{x.ProcessName}}</td>
                                <td>{{x.RequiredDays}}</td>
                                <td ng-class="getDateColor(x)" style="width:100px">{{x.finisedDate1}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header"> My Entity List<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Entity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in entityList">
                                <td>{{x.Code}}</td>
                                <td>{{x.EntityName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>