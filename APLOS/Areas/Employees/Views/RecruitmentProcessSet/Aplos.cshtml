<togglable name="Recruitment Process Set"></togglable>
<div class="form-elements form-horizontal" ng-form name="recruitmentProcessSetForm">
    <input type="hidden" ng-model="recruitmentProcessSetNew.Id">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="address" role="tab" data-toggle="tab">Process Set</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" min="1" name="Sequence" ng-model="recruitmentProcessSetNew.Sequence" class="form-control" required placeholder="0" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="ShortName" maxlength="15" ng-model="recruitmentProcessSetNew.ShortName" class="form-control" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" ng-model="recruitmentProcessSetNew.UserName" name="UserName" maxlength="50" class="form-control" required tabindex="5">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" name="Remarks" maxlength="250" rows="3" ng-model="recruitmentProcessSetNew.Remarks" tabindex="7"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Code" maxlength="10" ng-model="recruitmentProcessSetNew.Code" class="form-control" required tabindex="2">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="StandardName" maxlength="50" ng-model="recruitmentProcessSetNew.StandardName" class="form-control" required tabindex="4">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" name="Description" maxlength="250" ng-model="recruitmentProcessSetNew.Description" tabindex="6"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" class="css-checkbox" ng-model="recruitmentProcessSetNew.Active" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-5 col-md-5">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="recruitmentProcessSetDetailNew.Sequence" ng-disabled="recruitmentProcessSetDetailCaption == 'Update Row'" name="Sequence" maxlength="50" class="form-control" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Required Days<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="recruitmentProcessSetDetailNew.RequiredDays" name="RequiredDays" maxlength="50" class="form-control" tabindex="3">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-5 col-md-5">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Recruitment Process<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select id="recruitmentProcessId" class="form-control" name="RecruitmentProcess" ng-model="recruitmentProcessSetDetailNew.RecruitmentProcessId" tabindex="2">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in recruitmentProcessList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" class="css-checkbox" ng-model="recruitmentProcessSetDetailNew.Active" tabindex="4">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button ng-click="AddMultiplerecruitmentProcessSetDetail();" class="btn single-small-btn"><i class="glyphicon glyphicon-plus" tabindex="5"></i> {{recruitmentProcessSetDetailCaption}}</button>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="recruitmentProcessSetDetailTbl">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Sequence</th>
                                        <th>Recruitment Process</th>
                                        <th>Required Days</th>
                                        <th>Active</th>
                                        <th class="col-md-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="x in recruitmentProcessSetDetailDataList |itemsPerPage:recruitmentProcessSetDetailParameters.pageSize" total-items="recruitmentProcessSetDetailDataParameters.total_count"
                                        pagination-id="metaData.name + 'recruitmentProcessSetDetailDataList'">
                                        <td>{{x.Sequence}}</td>
                                        <td>{{x.RecruitmentProcessName}}</td>
                                        <td>{{x.RequiredDays}}</td>
                                        <td>{{x.Active?'Yes':'No'}}</td>
                                        <td class="text-right">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="recruitmentProcessSetDetailEdit(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                                        <i class="glyphicon glyphicon-edit"></i>
                                                    </button>
                                                </li>
                                                <li>
                                                    <button ng-click="recruitmentProcessSetDetailDelete(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <dir-pagination-controls max-size="10"
                                                     pagination-id="metaData.name + 'recruitmentProcessSetDetailDataList'"
                                                     direction-links="true" boundary-links="true"
                                                     on-page-change="getRecruitmentProcessSetDetailData(newPageNumber)">
                            </dir-pagination-controls>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="12"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right  aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search"  ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in recruitmentProcessSets |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.RecruitmentProcessSetId, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmlngPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()">
</confirm-archive-generic>

