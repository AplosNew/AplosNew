<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Recruitment Approval
</h3>
<p style="text-decoration:underline;cursor:pointer;" ng-show="message==null" ng-click="showEntityPopUp();">My Entity List</p>
<p class="msg-success" ng-show="message!=null">*{{message}}</p>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchDataByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="LoadData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="LoadData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="form-elements form-horizontal" ng-form name="preRecruitmentEmployeeForm" ng-show="preRecruitmentEmployees.length>0">
    <input type="hidden" ng-model="preRecruitmentEmployee.Id">
    <label class="text-right">Total :{{confirmParameters.total_count}}</label>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        <div class="checkbox-site text-center">
                            <input type="checkbox" ng-click="CheckAll($event);">
                        </div>
                    </th>
                    <th>Candidate Id</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Date of Birth</th>
                    <th>Budget Id</th>
                    <th>Entity</th>
                    <th>Position</th>
                    <th>Department</th>
                    <th>Employee Type</th>
                    <th>Designation</th>
                    <th>Given Designation</th>
                    <th>Legal Designation</th>
                    <th>Salary</th>
                    <th>App Added Date</th>
                    <th>Candidate Submitted Date</th>
                    <th>Document Approval Date</th>
                    <th>Agreed DOJ</th>
                    <th>Date of Join</th>
                    <th>Confirm after(Days)</th>
                    <th>Employee Code</th>
                    @*<th>Joining Letter</th>*@
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="e in preRecruitmentEmployees |itemsPerPage:confirmParameters.pageSize" total-items="confirmParameters.total_count">
                    @*<tr dir-paginate="e in preRecruitmentEmployees |itemsPerPage:$root.pageSize" total-items="$root.total_count">*@
                    <td class="text-right table-td">
                        @*<div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="e.Active" checked="{{e.Active}}" ng-click="selectChValueId($event,e)">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>*@
                        <div class="checkbox-site">
                            <input type="checkbox" ng-model="e.Active" ng-click="selectChValueId($event,e)">
                        </div>
                    </td>
                    <td>{{e.Id}}</td>
                    <td>{{e.FullName | uppercase}}</td>
                    <td>{{e.Email}}</td>
                    <td>{{e.DOB| dateFiltering}}</td>
                    <td>{{e.BudgetId}}</td>
                    <td>{{e.EntityName}}</td>
                    <td>{{e.Position}}</td>
                    <td>{{e.Department}}</td>
                    <td>{{e.EmployeeCategory}}</td>
                    <td>{{e.Designation}}</td>
                    <td>{{e.GivenDesignation}}</td>
                    <td>
                        <div class="select-style">
                            <select id="LegalDesignationId" class="form-control" name="LegalDesignation" ng-model="e.LegalDesignationId" style="height: 28px;">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in e.legalDesignationList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </td>
                    <td>{{e.TotalSalary}}</td>
                    <td>{{e.AppAddedDateTime| dateFiltering}}</td>
                    <td>{{e.SubmitDateTime| dateFiltering}}</td>
                    <td>{{e.ApprovedDateTime | dateFiltering}}</td>
                    <td>{{e.AgreedDOJ| dateFiltering}}</td>
                    <td><input type="text" ng-model="e.DOJ" datepicker class="form-control datepicker" placeholder="dd-MM-yyyy" style="height:30px;width:110px"></td>
                    <td><input type="text" style="width:50px" name="ConfirmAfterDays" ng-model="e.ConfirmAfterDays" class="form-control"></td>
                    <td><input type="text" style="width:80px" name="EmployeeCode" maxlength="50" ng-model="e.EmployeeCode" ng-disabled="e.IsEmployeeCodeOpenField===false" class="form-control"></td>

                    @*<td style="width:41%">
                            <div class="inputBtnSection common-btn">
                                <label class="fileUpload col-sm-3">
                                    <input id="uploadBtn4" type="file" name="file[]" ng-click="getInd($index,e)" class="upload" onchange="angular.element(this).scope().fileNameChanged(this)" />
                                    <span class="uploadBtn"><i class="fa fa-paperclip" aria-hidden="true"> Attach</i></span>
                                </label>
                                <div class="col-sm-6" style="width: 198px;">
                                    <input type="text" id="{{$index}}" ng-model="e.FileName" name="uploadFile4" class="disableInputField form-control"
                                           disabled="disabled" style="width: 183px;" />
                                </div>
                                <div class="col-sm-2" style="padding-left:0px;">
                                    <button ng-click="DocumentRemove(d.Id);" class="btn" ng-disabled="disableBtn();savedisable" style="height: 29px;width: 88px;padding-left: 8px;background: #242841;margin-top:1px">
                                        <i class="fa fa-chain-broken" aria-hidden="true"></i> Detach
                                    </button>
                                </div>
                            </div>
                        </td>*@


                    <td>
                        <div class="select-style">
                            <select name="Confirmation Status" style="width:80px;height: 28px;" ng-model="e.ConfirmationStatus" ng-change="pushValue(e)" class="form-control">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in confirmationStatusList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="50"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="LoadData(newPageNumber)">
        </dir-pagination-controls>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" ng-disabled="tempList.length==0" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
        </ul>
    </div>
</div>
<div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header"> My Entity List<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Entity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in entityList">
                                <td>{{x.Code}}</td>
                                <td>{{x.EntityName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
