<style>
    #docFilterGrid {
    }

    #accordion section, #accordion .pointer, #accordion h1, #accordion p {
        -webkit-transition: all 0.20s ease-in-out;
        -moz-transition: all 0.5s ease-in-out;
        transition: all 0.5s ease-in-out;
    }

    #accordion {
        margin-bottom: 30px;
    }

        #accordion h1 {
            line-height: 1.2;
            font-size: 15px;
            background-color: #3e445a;
            margin: 0;
            padding: 10px 10px 10px 30px;
        }

            #accordion h1 a {
                color: #fff;
            }

        #accordion section {
            overflow: hidden;
        }

        #accordion p {
            padding: 0 10px;
            color: #fff;
        }

        #accordion section.ac_hidden p:not(.pointer) {
            color: #fff;
        }

        #accordion section.ac_hidden {
            height: 44px;
        }

        #accordion .pointer {
            padding: 0;
            margin: 10px 0 0 6px;
            line-height: 20px;
            width: 13px;
            position: absolute;
        }

        #accordion section:not(.ac_hidden) h1 {
            background-color: #204d74;
        }

        #accordion section:not(.ac_hidden) .pointer {
            display: block;
            -webkit-transform: rotate(90deg);
            -moz-transform: rotate(90deg);
            -o-transform: rotate(90deg);
            transform: rotate(90deg);
            padding: 0;
        }

    #drpdwnfont {
        color: #95a5a6;
    }

    html {
        overflow: scroll;
    }

    .filled {
        background-color: #0dbe67 !important;
    }

    #myDIV {
        width: 100%;
        text-align: center;
    }

    #inDiv {
        width: 100%;
        text-align: center;
    }

    .options {
        height: 150px;
        overflow-y: scroll;
    }

    .changeType {
        background: #eee;
        border-radius: 2px;
        border: 1px solid #bbb;
        color: #bbb;
        font-size: 10px;
        padding: 4px;
        float: right;
    }

        .changeType:before {
            content: "\25BC ";
        }

    .options {
        height: 150px;
        overflow-y: scroll;
        color: black;
        font-weight: 100;
    }

    a.filterlink {
        font-size: 12px;
    }

    .e-grid .e-headercelldiv {
        font-weight: bold;
        font-size: 13px;
        display: block;
        border: 0 none;
        height: 29px;
        line-height: 29px;
        margin: -7px;
        padding: 0 .7em;
        text-align: left;
        white-space: nowrap;
        text-overflow: ellipsis;
        font-family: "Arial Narrow";
    }
</style>

<div id="MainDiv">
    <div class="col-md-4">
        <h4><span class="glyphicon glyphicon-stats"></span>Document Dashboard</h4>
    </div>
    <div class="col-md-4 text-center">
        <button disabled class="btn" style="border-radius: 50%;cursor:pointer;color:white;" id="forward1">1</button>
        <button class="btn" style="border-radius: 50%;cursor:pointer;background-color:#242841;color:white;" id="forward1" ng-click="clickdde();">2</button>
        <button class="btn" style="border-radius: 50%;cursor:pointer;background-color:#242841;color:white;" id="forward1" ng-click="clickdde3();">3</button>

    </div>
    <div class="col-md-4 text-right">
        <h4><i class="glyphicon glyphicon-repeat" style="cursor:pointer;" ng-click="getDocDashboardSync();"></i></h4>
    </div>

    <div class="row">
        <div class="col-xs-12" style="margin-left:-12px">
            <div id="docFilterGrid" ej-grid e-datasource="filterDataList"
                 e-allowfiltering="true"
                 e-filtersettings-filterType="excel" e-actioncomplete="actionCompleteSelected">
                <div e-columns>
                    <div e-column e-field="EmpCategory" e-headertext="Emp Category" e-tooltip="Employee Category" e-width="80"></div>
                    <div e-column e-field="DocumentCategoryName" e-headertext="Doc Category" e-tooltip="Document Category" e-width="80"></div>
                    <div e-column e-field="DocumentSubCategoryName" e-headertext="Doc Subcategory" e-tooltip="Document Subcategory" e-width="80"></div>
                    <div e-column e-field="DocumentUserName" e-headertext="Doc Name" e-tooltip="Document Name" e-width="80"></div>
                    <div e-column e-field="DocumentType" e-headertext="Doc Type" e-tooltip="Document Type" e-width="80"></div>
                    <div e-column e-field="DocumentationBy" e-headertext="Doc By" e-tooltip="Documentation by" e-width="80"></div>
                    <div e-column e-field="Importance" e-headertext="Importance" e-width="80"></div>
                    <div e-column e-field="OptionalOrMandatory" e-headertext="Opt. or Mandt." e-tooltip="Optional or Mandatory" e-width="80"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12  modal-body table-responsive modal-table" style="padding-top:1.5px;">
            <table class="table table-hover" style="margin-left: -1%;border:1px solid black; padding:1px !important;box-shadow:1px 1px 1px 1px grey;">
                <thead class="doc_dashboardOAthead">
                    <tr>
                        <th rowspan="3"></th>
                        <th rowspan="1" colspan="3" style="padding:1px !important; text-align:center"><span>Completion status</span></th>
                        <th rowspan="3" style="padding:1px !important; text-align:center"><span>Due</span></th>
                        <th colspan="8" style="text-align:center; padding:1px !important;">Over Due</th>
                    </tr>
                    <tr>
                        <th rowspan="2" style="padding:1px !important;text-align:center">Total</th>
                        <th colspan="2" style="padding:1px !important; text-align:center">On Time</th>
                        <th colspan="2" style="padding:1px !important;text-align:center">OverAll</th>
                        <th colspan="2" style="padding:1px !important; text-align:center">&lt;10 Days</th>
                        <th colspan="2" style=" padding:1px !important;text-align:center"><span>10 to 30 Days</span></th>
                        <th colspan="2" style=" padding:1px !important;text-align:center"><span>30+ Days</span></th>
                    </tr>
                    <tr>
                        <th style="padding:1px !important; text-align:center">Total Count</th>
                        <th style="padding:1px !important; text-align:center">On Time(%) </th>
                        <th style="text-align:right;"><div data-placement="bottom" title="Number of Employees" tooltip>No. of Emp.</div></th>
                        <th style="text-align:right;"><div data-placement="bottom" title="Number of Documents" tooltip>No. of Doc.</div></th>
                        <th style="text-align:right;border-left:1px solid #C0C0C0;"><div data-placement="bottom" title="Number of Employees" tooltip>No. of Emp.</div></th>
                        <th style="text-align:right;"><div data-placement="bottom" title="Number of Documents" tooltip>No.of Doc.</div></th>
                        <th style="text-align:right;border-left:1px solid #C0C0C0;"><div data-placement="bottom" title="Number of Employees" tooltip>No. of Emp.</div></th>
                        <th style="text-align:right;"><div data-placement="bottom" title="Number of Documents" tooltip>No.of Doc.</div></th>
                        <th style="text-align:right;border-left:1px solid #C0C0C0;"><div data-placement="bottom" title="Number of Documents" tooltip>No. of Emp.</div></th>
                        <th style="text-align:right;"><div data-placement="bottom" title="Number of Documents" tooltip>No.of Doc.</div></th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in overDueDataListNew">
                        <td style="padding:1px !important; border-right:1px solid #C0C0C0;">{{x.DocumentType}}</td>
                        <td class="text-right" style="padding:3px !important; border-right:1px solid grey;">{{x.TotalCompleted==0?'':x.TotalCompleted}}</td>
                        <td class="text-right" style="padding:3px !important; border-right:1px solid grey;">{{x.TotalOntimeCompleted==0?'':x.TotalOntimeCompleted}}</td>
                        <td class="text-right" style="padding:3px !important; border-right:1px solid grey;">{{x.TotalOntimeCompletionPercentage==0?'':x.TotalOntimeCompletionPercentage+'%'}}</td>
                        <td class="text-right" style="padding:3px !important; border-right:1px solid grey;">{{x.TotalDue==0?'':x.TotalDue}}</td>
                        <td class="text-right hoverItem" style="padding:3px !important; cursor:pointer" ng-click="GetModalOverAllOverDueDocEmp(x,'OVERALL');">{{x.OverAllDueEmp==0?'':x.OverAllDueEmp}}</td><!--OverAllemp-->
                        <td class="text-right hoverItem" style="padding:3px !important; cursor:pointer" ng-click="GetSegmentedModalOverDueDoc(x,'OVERALL');">{{x.OverAllDueDoc==0?'':x.OverAllDueDoc}}</td><!--OverAlldoc-->
                        <td class="text-right hoverItem" style="padding:3px !important; border-left:1px solid #C0C0C0;cursor:pointer" ng-click="GetModalOverAllOverDueDocEmp(x,'SEGMENT1');">{{x.Seg1Emp==0?'':x.Seg1Emp}}</td><!--emp1-->
                        <td class="text-right hoverItem" style="padding:3px !important; cursor:pointer" ng-click="GetSegmentedModalOverDueDoc(x,'SEGMENT1');">{{x.Seg1Doc==0?'':x.Seg1Doc}}</td><!--doc1-->
                        <td class="text-right hoverItem" style="padding:3px !important; border-left:1px solid #C0C0C0;cursor:pointer" ng-click="GetModalOverAllOverDueDocEmp(x,'SEGMENT2');">{{x.Seg2Emp==0?'':x.Seg2Emp}}</td><!--emp2-->
                        <td class="text-right hoverItem" style="padding:3px !important; cursor:pointer" ng-click="GetSegmentedModalOverDueDoc(x,'SEGMENT2');;">{{x.Seg2Doc==0?'':x.Seg2Doc}}</td><!--doc2-->
                        <td class="text-right hoverItem" style="padding:3px !important; border-left:1px solid #C0C0C0;cursor:pointer" ng-click="GetModalOverAllOverDueDocEmp(x,'SEGMENT3');">{{x.Seg3Emp==0?'':x.Seg3Emp}}</td><!--emp3-->
                        <td class="text-right hoverItem" style="padding:3px !important; cursor:pointer" ng-click="GetSegmentedModalOverDueDoc(x,'SEGMENT3');;">{{x.Seg3Doc==0?'':x.Seg3Doc}}</td><!--doc3-->
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-6" style="margin-left:.4%; width:54.4%;">
            <div class="row" style=" box-shadow:1px 1px 1px 1px grey;">
                <canvas id="overDueChart" width="400" height="160"></canvas>
            </div>
        </div>
        <div class="col-lg-1" style="width:5.333333%;"></div>
        <div class="col-lg-5" style="border:1px solid black;box-shadow:1px 1px 1px 1px grey; margin-left:1.4%;">
            <div class="row">
                <div class="col-lg-7">
                    <label class="chart-title">Total Documents <br><span>{{pieOverDue+pieDue+pieCompleted}}</span></label>
                    <canvas id="submittedChart" width="400" height="400"></canvas>
                </div>
                <div class="col-lg-5 doc_dashboardpieTableDiv" style="margin-left: -6.5%;width: 45.666667%;">
                    <table class="table  table-hover doc_dashboardpieTable">
                        <tbody>
                            <tr ng-click="GetModalOverDueDoc('')" style="cursor:pointer;">
                                <td class="doc_dashboardpieTableTD">Over Due</td>
                                <td><span style="background-color:rgba(240, 52, 52, .6); border:.5px solid rgba(240, 52, 52, .8)"> &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;&nbsp;</span></td>
                                <td class="doc_dashboardpieTableTDR hoverItem">{{pieOverDue}}</td>
                            </tr>
                            <tr ng-click="GetModalDueDoc();" style="cursor:pointer;">
                                <td class="doc_dashboardpieTableTD">Due</td>
                                <td><span style="background-color:rgba(241, 196, 15, 1); border:.5px solid rgba(241, 196, 15, .8)"> &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;&nbsp;</span></td>
                                <td class="doc_dashboardpieTableTDR hoverItem">{{pieDue}}</td>
                            </tr>
                            <tr ng-click="GetModalCompletedDoc();" style="cursor:pointer;">
                                <td class="doc_dashboardpieTableTD">Completed</td>
                                <td><span style="background-color:rgba(46, 204, 113,.6); border:.5px solid rgba(46, 204, 113,.6)"> &nbsp;&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;&nbsp;</span></td>
                                <td class="doc_dashboardpieTableTDR hoverItem">{{pieCompleted}}</td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="row"><br /></div>
    <div class="row">
        <div class="col-lg-1" style="margin-left: -6.1%;"></div>
        <div class="col-lg-12" style="border:1px solid black;margin-left:-1.8%;width: 98%;  box-shadow:1px 1px 1px 1px grey;">
            <canvas id="docbarChart" width="400" height="125"></canvas>
        </div>
    </div>
</div>

