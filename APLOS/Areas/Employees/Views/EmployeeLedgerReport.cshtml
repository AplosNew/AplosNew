<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Ledger</h3>
<div class="form-elements form-horizontal" ng-form="form0">
    <div class="col-xs-12 col-sm-5 col-md-5">
        <div class="form-group" show-errors id="div_Employee">
            <label class="col-sm-3 control-label">Employee<sup>*</sup></label>
            <div class="col-sm-7 show-message">
                <input type="text" class="form-control" ng-model="ledgerReport.EmployeeName" readonly>
            </div>
            <button class="single-btn tooltip-here" data-placement="top" title="Employee Change" ng-click="showEmployeeListPopUp();"><i class="fa fa-search"></i></button>
        </div>
        <div class="form-group" show-errors id="div_FromDate">
            <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-7 show-message">
                <input type="text" name="Form Date" ng-model="ledgerReport.FromDate" datepicker class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors id="div_ToDate">
            <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-7 show-message">
                <input type="text" name="To Date" ng-model="ledgerReport.ToDate" datepicker class="form-control">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Format<sup>*</sup></label>
            <div class="col-sm-9 radio">
                <label>
                    <input type="radio" name="source" ng-model="ledgerReport.ReportFormat" value="@Library.Model.Enums.ReportFormat.Pdf.ToString()">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Pdf.ToString()
                </label>
                <label>
                    <input type="radio" name="source" ng-model="ledgerReport.ReportFormat" value="@Library.Model.Enums.ReportFormat.Excel.ToString()">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>@Library.Model.Enums.ReportFormat.Excel.ToString()
                </label>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li><button ng-click="report();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
        </ul>
    </div>
</div>
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Employee List<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Designation</th>
                                <th>Department</th>
                                <th>Section</th>
                                <th>Sub Section</th>
                                <th>Line</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-click="selectEmployeePopUp($index, x.SystemId)" ng-class="{selected : x.SystemId == selectedEmployee}" ng-dblclick="closeEmployeePopUp();" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOB}}</td>
                                <td>{{x.LegalDesignation}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                                <td>{{x.SubSection}}</td>
                                <td>{{x.Line}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'employeeList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>