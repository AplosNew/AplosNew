<div class="aplos-grid-toggle">
    <div class="table-responsive aplos-grid-toggle">
        <div style="color:black;" ej-grid e-datasource="LeaveTransactionList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-field="ID" e-headertext="ID" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="5"></div>
                <div e-column e-field="EmployeeName" e-headertext="Emp Name" e-width="5"></div>
                <div e-column e-field="Depertment" e-headertext="Department" e-width="5"></div>
                <div e-column e-field="Designation" e-headertext="Designation" e-width="5"></div>
                <div e-column e-field="leaveTypeName" e-headertext="Leave Name" e-width="5"></div>
                <div e-column e-field="LeaveDayType" e-headertext="Leave Day" e-width="5"></div>
                <div e-column e-field="Fdate" e-headertext="From Date" e-width="5" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                <div e-column e-field="Tdate" e-headertext="To Date" e-width="5" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
            </div>
        </div>
    </div>
    <p style="color:blue;font-size:11px">Leave duration more than 1 day</p>
</div>

<ej-dialog id="rebate" title="Confirm Delete?" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target="#MainDivId" e-close="onDialogClose" e-minwidth="240" e-minheight="165" e-open="enableBtn">
    <p>
        Are you sure to delete ?
    </p>
    <p class="text-right">
        <ul class="list-inline text-right">
            <li><button ng-click="DeleteLeave();ConfirmrebateClose()" class="btn">Yes</button></li>
            <li><button ng-click="ConfirmrebateClose();" class="btn"> No</button></li>
        </ul>
    </p>
</ej-dialog>

<confirm-modal></confirm-modal>
