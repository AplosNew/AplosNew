<togglable name="{{title}}"></togglable>
<div class="form-horizontal" ng-form name="leaveApplicationNewForm" id="MainDivId">
    <div class="row aplos-grid-toggle">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Calender Year</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select id="ID" class="form-control" ng-model="YearNo" name="YearNo" ng-change="getData();">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in leaveYearlist" value="{{option.Id}}">{{option.YearNo}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-elements ">
        <input type="hidden" ng-model="leaveApplicationNew.Id">
        <input type="text" ng-model="leaveApplicationNew.Id" hidden />
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <div class="col-sm-8">
                        <div>
                            <img id="uploadImageSrc" ng-src="{{imageSrc}}" style=" border: 1px solid; height: 150px; width: 150px;" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Code</label>
                    <label class="col-sm-8 control-label">{{leaveApplicationNew.EmployeeCode}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Name</label>
                    <label class="col-sm-8 control-label">{{leaveApplicationNew.EmployeeName}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Department</label>
                    <label class="col-sm-8 control-label">{{leaveApplicationNew.Depertment}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Designation</label>
                    <label class="col-sm-8 control-label">{{leaveApplicationNew.Designation}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Leave From</label>
                    <label class="col-sm-8 control-label">{{FromDate}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Leave To</label>
                    <label class="col-sm-8 control-label">{{ToDate}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Leave Duration</label>
                    <label class="col-sm-8 control-label">{{LeaveDays}}</label>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="from-group">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Leave Name</th>
                                    <th>Current Year Allocation</th>
                                    <th>Carry Forward</th>
                                    <th>Leave Days Allowed</th>
                                    <th>Applied</th>
                                    <th>Availed</th>
                                    <th>Encashed</th>
                                    <th>Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in LeaveBalanceList">
                                    <td>{{x.LeaveName}}</td>
                                    <td>{{x.CurrentAllocation}}</td>
                                    <td>{{x.BroughtForward}}</td>
                                    <td>{{x.LeaveDays}}</td>
                                    <td>{{x.Applied}}</td>
                                    <td>{{x.Availed}}</td>
                                    <td>{{x.EncashedInbetween}}</td>
                                    <td>{{x.Balance}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Delete Leave Single Day</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="aria2" role="tab" data-toggle="tab">All Leave Details</a></li>
                </ul>
            </div>
            <div class="tab-content" id="tabpaneldiv">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="form-elements form-horizontal" ng-form id="OTSlapFormId" name="OTSlapForm">
