                <input type="text" name="Standard Name" maxlength="50" ng-model="sopDocumentNew.DocumentTypeId" class="form-control" required tabindex="4">
            </div>
        </div>*@
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Prep. Freq. PerMonth<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Prep. Freq. PerMonth" only-numbers ng-model="sopDocumentNew.PreparationFrequencyPerMonth" class="form-control" required tabindex="12">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Prep. Time In Minutes<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Prep. Time In Minutes" n-decimals="2" ng-model="sopDocumentNew.PreparationTimeInMinutes" class="form-control" required tabindex="14">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Review Required</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="sopDocumentNew.ReviewRequired">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Is System Generated</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input id="Check_IsSystemGenerated" type="checkbox" class="css-checkbox" ng-change="Enabledisablemodule()" ng-model="sopDocumentNew.IsSystemGenerated" tabindex="11">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Module</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="sopDocumentNew.ModuleId" ng-disabled="enable" 
                            ng-options="item.Value as item.Text for item in ModuleList">
                        <option></option>
                    </select>
                </div>
            </div>
