<togglable name="SOP Document"></togglable>
<div class="form-elements form-horizontal" ng-form id="sopDocument" name="sopDocumentNewForm">
    <input type="hidden" ng-model="sopDocumentNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Sequence" n-decimals="2" ng-model="sopDocumentNew.Sequence" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" ng-model="sopDocumentNew.ShortName" name="Short Name" maxlength="15" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" maxlength="50" ng-model="sopDocumentNew.UserName" class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Document Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="DocumentCategoryId" class="form-control" name="Document Category" ng-model="sopDocumentNew.SOPDocumentCategoryId" required tabindex="7">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in documentCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>


        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Document Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Document Type" ng-model="sopDocumentNew.DocumentTypeId" required tabindex="9">
                        <option value="">--Select--</option>
                        <option ng-repeat="row in DocumentTypeData" value="{{row.Id}}">{{row.UserName}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Data Source Category<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Data Source Category" mexlength="50" ng-model="sopDocumentNew.DataSourceCategory" ng-options="item.Value as item.Text for item in DataSourceCategoryList" required tabindex="11">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Purpose<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Purpose" maxlength="200" ng-model="sopDocumentNew.Purpose" class="form-control" required tabindex="13">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="2" ng-model="sopDocumentNew.Description" name="Description" maxlength="250" tabindex="15" ng-trim="false"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Printable</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="sopDocumentNew.Printable">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="2" ng-model="sopDocumentNew.Remarks" name="Remarks" maxlength="250" tabindex="17" ng-trim="false"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" maxlength="10" ng-model="sopDocumentNew.Code" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" maxlength="50" ng-model="sopDocumentNew.StandardName" class="form-control" required tabindex="4">
            </div>
        </div>

        @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company GroupId<sup>*</sup></label>
            <div class="col-sm-8 show-message">
