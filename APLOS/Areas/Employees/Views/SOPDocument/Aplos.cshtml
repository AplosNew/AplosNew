        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Document Format<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Document Formate" ng-model="sopDocumentNew.DocumentFormate" ng-options="item.Value as item.Text for item in DocumentFormateList" required tabindex="16">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="inputBtnSection common-btn">
                <label class="fileUpload col-sm-4 ">
                    <input id="uploadBtn" type="file" name="file[]" class="upload" />
                    <span class="uploadBtn"><i class="fa fa-paperclip" aria-hidden="true"> Attach<sup>*</sup></i></span>
                </label>
                <div class="col-sm-6" style="width: 250px;">
                    <input type="text" id="uploadFile" name="uploadFile" class="disableInputField form-control" disabled="disabled" style="width: 250px;" />
                </div>
                <div class="col-sm-2" style="padding-left:0px;">
                    <button ng-click="DocumentRemove();" class="btn" style="height: 31px;width: 88px;padding-left: 8px;background: #242841;"><i class="fa fa-chain-broken" aria-hidden="true"></i> Detach</button>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="sopDocumentNew.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>


    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    @*Multiple Value Sellection*@
    @*tabs*@
    <div class="row">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Process</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Department</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Document Source</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Prepared By</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" data-toggle="tab">Document Location</a></li>
            </ul>
        </div>

        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    @*process body*@
                    <div class="col-sm-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="showProcessPopUp();" ng-disabled="sopDocumentNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridSelectedProcess" ej-grid e-datasource="SelectedProcessList"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="80"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="80"></div>
                                <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="140"></div>
                                @*delete*@
                                <div e-column e-template="#DeleteDocumentProcess" e-width="40"></div>
                            </div>
                        </div>

                        <script type="text/template" id="DeleteDocumentProcess">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="$parent.ConfirmDeleteProcess(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                </ul>
                            </div>
                        </script>

                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    @*Department body*@

                    <div class="col-sm-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="showDepartmentPopUp();" ng-disabled="sopDocumentNew.Id==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus-sign" style="top: 1px;"></i></button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div style="color:black;" id="GridSelectedDepartment" ej-grid e-datasource="SelectedDepartmentList"
                             e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="80"></div>
                                <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="80"></div>
                                <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="User Name" e-width="140"></div>
                                <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="140"></div>
                                @*delete*@
                                <div e-column e-template="#DeleteDocumentDepartment" e-width="40"></div>
                            </div>
                        </div>

                        <script type="text/template" id="DeleteDocumentDepartment">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button ng-click="$parent.ConfirmDeleteDepartment(data.Id);" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                </ul>
                            </div>
                        </script>

                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    @*DocumentSource body*@
                    <div class="col-sm-12 col-sm-12 col-md-12">
