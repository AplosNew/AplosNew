        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Critical Level<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Critical Level" ng-model="sopDocumentNew.CriticalId" required tabindex="10">
                        <option value="">--Select--</option>
                        <option ng-repeat="row in CriticalLevelData" value="{{row.Id}}">{{row.UserName}}</option>
                    </select>
                </div>
            </div>
        </div>

        @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Document Type<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" name="Document Type" ng-model="sopDocumentNew.DocumentTypeId" required tabindex="6">
