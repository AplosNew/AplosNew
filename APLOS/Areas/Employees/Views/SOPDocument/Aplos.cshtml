        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Document SubCategory<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="DocumentSubCategoryId" class="form-control" name="Document SubCategory" ng-model="sopDocumentNew.SOPDocumentSubCategoryId" required tabindex="8">
