<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee DOJ Change.
</h3>
<div class="form-elements" ng-form id="FinalSettlement" name="FinalSettlementForm">
    <div class="row"></div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Code<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <input type="text" min="1" name="Sequence" ng-model="EmployeeModel.EmployeeCode" class="form-control" ng-disabled="true" required tabindex="1">

                </div>
                <div class="col-sm-2 show-message" style="margin-left:0px;padding-left:0px">

                    <button style="color: #f3f3ec;background-color: #1c1f32; " class="btn"><i class="glyphicon glyphicon-search" ng-click="LoadEmployeeList()" style="margin: -4px;"></i></button>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Name </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.EmployeeName}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">DOJ </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.DOJ}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">DOC </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.DOC}}</label>
            </div>




        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">


            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">New DOJ <sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" maxlength="15" name="ShortName" ng-model="NewDOJ" ng-change="SetDoc();" datepicker placeholder="dd-MMM-yyyy" class="form-control" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Legal Designation </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.LegalDesignation}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Department </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.Department}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Position </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.PositionName}}</label>
            </div>


        </div>
    </div>
    <hr />
   
    <hr />
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-saved" tabindex="9"></i> Change</button></li>

        </ul>
    </div>
</div>





<confirm-modal></confirm-modal>



<ej-dialog id="dialogEmployeeInfo"
           title=" Employee Information"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target=".site-heading"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="500" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">

            <div style="color:black;"
                 id="GridEmployeeInfoList"
                 e-recorddoubleclick="SelectEmployee"
                 ej-grid e-datasource="EmployeeInformationList"
                 e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowselection="true"
                 e-pagesettings-pagesize="25"
                 e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>

                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="70"></div>
                    <div e-column e-field="DOC" e-headertext="DOC" e-width="70"></div>
                    <div e-column e-field="DOS" e-headertext="DOS" e-width="70"></div>
                    @*<div e-column e-field="DOBs" e-headertext="DOB" e-width="70"></div>*@
                    <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    @*<div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>*@

                    <div e-column e-field="EntityName" e-headertext="Entity" e-width="80"></div>

                    @*<div e-column e-field="DesignationGroupName" e-headertext="Designation Group" e-width="80"></div>*@
                    @*<div e-column e-field="CellPhnNo" e-headertext="Cell No" e-width="80"></div>*@
                    @*<div e-column e-field="PayRollGroupName" e-headertext="Payroll Group" e-width="80"></div>
        <div e-column e-field="ApprovedStatus" e-headertext="Status" e-width="60"></div>*@
                </div>
            </div>
        </div>
    </div>

</ej-dialog>