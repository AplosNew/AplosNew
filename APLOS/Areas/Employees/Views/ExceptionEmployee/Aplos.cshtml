<togglable name="Exception Employee For Salary Process"></togglable>
<div class="form-elements form-horizontal" ng-form name="restNewForm">
    <div class="clearfix"> </div>
    <input type="hidden" ng-model="restNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group">
            <label class="col-sm-4 control-label"></label>
            <div class="col-sm-8">
                <button class="btn" ng-click="popUp('EmployeeInfo');"><i class="glyphicon glyphicon-search"></i> Search Employee</button>
            </div>
        </div>

    </div>


    <div class="clearfix"></div>

</div>
<div class="row text-right aplos-grid-toggle" id="ejGrid">
    <div class="col-xs-12">
        <div style="color:black;" id="GridEmpWise" ej-grid e-datasource="GetExceptionEmployeeList" e-allowscrolling="true"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true" e-pagesettings-pagesize="25"
             e-allowselection="false" e-filtersettings-filterType="excel" e-recorddoubleclick="Get">
            <div e-columns>
                <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="30" e-primarykey="true"></div>
                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>
                <div e-column e-field="EffectiveDate" e-headertext="EffectiveDate" e-width="80"></div>

                <div e-column e-headertext="Actions" e-width="70">
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 30px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.commandExceptionEmployeeDelete(this);" style="margin: -6px;"></i></button>

                </div>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                {{popUpTitle}}
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in popUpList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="popUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="popUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    <div class="checkbox-site text-center">
                                        <input type="checkbox" ng-click="CheckAll($event);">
                                    </div>
                                </th>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Plant</th>
                                <th>Department</th>
                                <th>Section</th>
                                <th>SubSection</th>
                                <th>Designation</th>
                                <th>Given Designation</th>
                                <th>Effective Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count" pagination-id="metaData.name + 'popUpDataList'">
                                <td>
                                    <div class="checkbox-site">
                                        <input type="checkbox" ng-model="x.Active" ng-click="selectChValueId($event,x)">
                                    </div>
                                </td>
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.Plant}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                                <td>{{x.SubSection}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.GivenDesignation}}</td>
                                <td> <input type="text" name="EffectiveDate" placeholder="dd-MMM-yyyy" datepicker ng-model="x.EffectiveDate" class="form-control" style="width: 100Px;"></td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'popUpDataList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="popUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">

                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic data-modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete()"></confirm-archive-generic>

<ej-dialog id="dialogMessage" title="{{messageTitle}}" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target=".site-heading" e-close="onDialogClose" e-minwidth="50%" e-minheight="50" e-open="enableBtn">

    <div>
        {{messageText}}
    </div>
</ej-dialog>