
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>User Define Report</h3>
<div class="form-horizontal form-elements" ng-form="modelForm">
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Daily Report</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Daily Attdn Report</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="general" role="tab" data-toggle="tab">Daily Attdn Graph</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Work Date<sup>*</sup></label>
                                <div class="col-sm-7">
                                    <input type="text" name="Form Date" ng-model="WorkDate" datepicker class="form-control">
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="getFiltersData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-ok-circle"></i> Go </button></li>
                                    @*<li> <button ng-click="getClearFiltersData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-ok-circle"></i> Clear Filter</button></li>*@
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div id="filters">
                        </div>
                        <div class="common-btn" ng-show="filters.length>0">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="GetDailyReportData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>
                                @*<li> <button ng-click="SaveFavourite();" class="btn" tabindex="9"><i class="glyphicon glyphicon-bookmark"></i> Favourite Filter</button></li>*@
                                <li> <button ng-click="GetDailyReport();" class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-down"></i> Export to Excel</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12" ng-show="DailyHRReportList.length>0">
                        <div id="GridEmp" ng-init="chkinit()" ej-grid e-datasource="DailyHRReportList"
                             e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="EmpCategory" e-headertext="Category" e-width="80"></div>
                                <div e-column e-field="Division" e-headertext="Division" e-width="100"></div>
                                <div e-column e-textalign="center" e-field="Deployment" e-headertext="Deployment" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="Sanction" e-headertext="Sanction" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="ActiveEmployee" e-headertext="Active Emp" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="NetOnroll" e-headertext="Net Onroll" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="OnrollShortSurplus" e-headertext="Onroll Short Surplus" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="LeaveYesterday" e-headertext="Leave" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="LeavePer" e-headertext="Leave %" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="LongAbsenteeism" e-headertext="LongAbsenteeism" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="TBS" e-headertext="TBS" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="WeekOffYesterday" e-headertext="Weekoff" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="AbsentYesterday" e-headertext="Absent" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="AbsentPerYesterday" e-headertext="Absent %" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="NetDeployedYesterday" e-headertext="Net Deployed" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="ScanApplicable" e-headertext="Scan Applicable" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="ScanComplete" e-headertext="Scan Complete" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="ScanPending" e-headertext="Scan Pending" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="TotalInTime" e-headertext="Yesterday's In" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="VarificationMissingYesterday" e-headertext="Varification Missing" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="ProductionEmp" e-headertext="Production Data" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="ZeroProductionEmp" e-headertext="Prod Data Missing" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="NoInTimeYesterday" e-headertext="In Punch Missing" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="TraineePresentValue" e-headertext="Trainee" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="JoinedLast30Days" e-headertext="Last 30 Days Joining" e-width="50"></div>
                                <div e-column e-textalign="center" e-field="LeftLast30Days" e-headertext="Last 30 Days Left" e-width="50"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Work Date<sup>*</sup></label>
                                <div class="col-sm-7">
                                    <input type="text" name="Form Date" ng-model="WrkDate" datepicker class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label"> Employee Category<sup>*</sup></label>
                                <div class="col-sm-8  show-message">
                                    <div class="select-style">
                                        <select ng-model="EmpCat">
                                            <option value="">Select All</option>
                                            <option ng-repeat="option in docEmployeeCategoryList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--<div class="col-md-3">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="getFiltersData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-ok-circle"></i> Go </button></li>-->
                        @*<li> <button ng-click="getClearFiltersData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-ok-circle"></i> Clear Filter</button></li>*@
                        <!--</ul>
                    </div>
                </div>-->
                    </div>
                    <div class="col-xs-12">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="GetDailyAttdnReportData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>
                                <li> <button ng-click="GetDailyAttdnReport();" class="btn" tabindex="9"><i class="glyphicon glyphicon-arrow-down"></i> Export to Excel</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div id="GridAttdnEmp" ng-if="gridColumns.length > 0" ng-init="chkinit()" ej-grid
                             e-datasource="DailyHRAttdnReportList"
                             e-columns="gridColumns"
                             e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row" style="box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                                <div class="col-sm-7">
                                    <input type="text" name="Form Date" ng-model="FromDate" datepicker class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                                <div class="col-sm-7">
                                    <input type="text" name="Form Date" ng-model="ToDate" datepicker class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="getGraphFiltersData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-ok-circle"></i> Go </button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div id="filtersdata">
                        </div>
                        <div class="common-btn" ng-show="filtersdata.length>0">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="GetDailyGraphData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div style="height:400px"><canvas id="countChart"></canvas></div>
                        <div style="height:400px"><canvas id="pctChart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>








