<togglable name="User Favourite Filter Setting"></togglable>
<div class="form-horizontal form-elements" ng-form="modelForm">
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="process" role="tab" data-toggle="tab">Filter Setting</a></li>
            </ul>
        </div>
        <div class="tab-content">

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form="filterNewForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">User<sup>*</sup></label>
                            <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 15px;">
                                <span class="input-group-addon">{{ModelNew.User}}</span>
                                <input type="text" name="User" ng-model="ModelNew.FullName" class="form-control" required readonly>
                                <span class="input-group-btn">
                                    <button name="submit" class="btn single-small-btn" ng-click="popUp()" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="4" maxlength="50" ng-keyup="CheckSpecialCharecter();">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Favourite Master</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelNew.FavouriteMasterId" ng-change="GetChildData();"
                                            ng-options="item.Id as item.UIName for item in modelList" id="Favourite Master"
                                            name="FavouriteMaster" tabindex="1">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                            <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 15px;">
                                <span class="input-group-addon">{{ModelNew.EmployeeId}}</span>
                                <input type="text" name="User" ng-model="ModelNew.FullName" class="form-control" required readonly>
                                
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Remarks</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                            </div>
                        </div>

                    </div>

                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveFavouriteFilter();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                </div>
                <div class="tab-design">
                    <div class="site-tab">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" ng-class="{ active: isSet2(1) }"><a ng-click="setTab2(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Child</a></li>
                        </ul>
                    </div>
                    <div class="tab-content">
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(1), active: isSet2(1) }">
                            <div class="row" ng-form="modelChildForm">
                                <div style="color:black;" id="GridC" ej-grid e-datasource="modelChildList" e-templaterefresh="refreshTemplate"
                                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-gridlines="vertical"
                                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                                    <div e-columns>
                                        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                                        <div e-column e-type="string" e-field="Id" e-headertext="Id" e-visible="false" e-width="50"></div>
                                        <div e-column e-type="string" e-field="ColumnName" e-headertext="ColumnName" e-width="80"></div>
                                        <div e-column e-headertext="FilterApply" e-template="#checkboxFilterApply" e-textalign="center" e-width="30"></div>
                                        <div e-column e-headertext="MandatoryDisplay" e-template="#checkboxMandatoryDisplay" e-textalign="center" e-width="30"></div>
                                    </div>
                                    <script type="text/template" id="checkboxTemplate">
                                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                                    </script>
                                    <script type="text/x-jsrender" id="headerTemplate">
                                        <input type="checkbox" id="headchk" />
                                    </script>
                                    <script type="text/template" id="checkboxFilterApply">
                                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.FilterApply" />
                                    </script>
                                    <script type="text/template" id="checkboxMandatoryDisplay">
                                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.MandatoryDisplay" />
                                    </script>
                                </div>
                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li> <button ng-click="SaveChild();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="table-responsive aplos-grid-toggle">
        <div style="color:black;" id="Grid" ej-grid e-datasource="modelList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-type="string" e-field="Id" e-headertext="Id" e-visible="false" e-width="50"></div>
                <div e-column e-type="string" e-field="Href" e-headertext="Href" e-width="80"></div>
                <div e-column e-type="string" e-field="UIName" e-headertext="UIName" e-width="100"></div>
                <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="100"></div>
                <div e-column e-type="string" e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
            </div>

        </div>

    </div>
</div>
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                User <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in searchByUserList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Employee Id</th>
                                <th>Full Name</th>
                                <th>Auth Token</th>
                                <th>User Type</th>
                                <th>Auth Token Locked</th>
                                <th>User Locked</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
                                ng-click="selectSingleClick(x)" ng-class="{selected : x.UserId === rowSelected}" ng-dblclick="selectDoubleClick(x);" pagination-id="metaData.name + 'popUpList'">
                                <td>{{x.UserId}}</td>
                                <td>{{x.EmployeeId}}</td>
                                <td>{{x.FullName}}</td>
                                <td>{{x.AuthToken}}</td>
                                <td>{{x.UserType}}</td>
                                <td>{{x.AuthTokenLocked?'Locked':'UnLocked'}}</td>
                                <td>{{x.UserLocked?'Locked':'UnLocked'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'popUpList'" direction-links="true" boundary-links="true" on-page-change="getPopUpData(newPageNumber)"></dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="selectByButton();" class="btn"><i class=""></i> Select</button></li>
                        <li><button type="button" class="btn btn-default" ng-click="closePopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>