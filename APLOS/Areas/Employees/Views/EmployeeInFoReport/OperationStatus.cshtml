                <div class="form-elements" ng-form="modelForm">
                    <div class="row">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Data Name</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="operationStatusSetting.DataName" ng-change="getMasterCbo(operationStatusSetting.DataName)" name="Include Exclude" tabindex="4">
                                            <option value="">-- Select --</option>
                                            <option value="Master">Master</option>
                                            <option value="OS2.1">OS2.1</option>
                                            <option value="OS2.2">OS2.2</option>
                                            <option value="Production">Production</option>
                                            <option value="WorkCenter">WorkCenter</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Column Name</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select ng-model="operationStatusSetting.ColumnName"
                                                ng-options="c for c in columnList">
                                            <option value="">-- Select Column --</option>
                                        </select>
                                        @*<input type="text" name="ColumnName" maxlength="50" ng-model="operationStatusSetting.ColumnName" class="form-control" tabindex="2">*@
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Operator</label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select class="form-control"
                                                ng-model="operationStatusSetting.Operator"
                                                name="Operator"
                                                tabindex="4">

                                            <option value="">-- Select Operator --</option>

                                            <optgroup label="Comparison Operators">
                                                <option value="=">= (Equal To)</option>
                                                <option value="!=">!= (Not Equal To)</option>
                                                <option value="<>"><> (Not Equal To)</option>
                                                <option value=">">&gt; (Greater Than)</option>
                                                <option value="<">&lt; (Less Than)</option>
                                                <option value=">=">&gt;= (Greater Than or Equal To)</option>
                                                <option value="<=">&lt;= (Less Than or Equal To)</option>
                                            </optgroup>

                                            <optgroup label="Text Operators">
                                                <option value="LIKE">LIKE (Contains / Pattern Match)</option>
                                                <option value="NOT LIKE">NOT LIKE (Does Not Match)</option>
                                                <option value="IN">IN (Multiple Values)</option>
                                                <option value="NOT IN">NOT IN (Exclude Multiple Values)</option>
                                                <option value="BETWEEN">BETWEEN (Range)</option>
                                                <option value="NOT BETWEEN">NOT BETWEEN (Outside Range)</option>
                                                <option value="IS NULL">IS NULL</option>
                                                <option value="IS NOT NULL">IS NOT NULL</option>
                                            </optgroup>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Operator Value</label>
                                <div class="col-sm-8">
                                    <input type="text" name="OperatorValue" maxlength="50" ng-model="operationStatusSetting.OperatorValue" class="form-control" tabindex="6">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Filter</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input tabindex="3" type="checkbox" ng-model="operationStatusSetting.Filter">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Start Date</label>
                                <div class="col-sm-8">
                                    <input type="text" name="StartDate" ng-model="operationStatusSetting.StartDate" datepicker class="form-control" tabindex="7">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-4 control-label">Start Time</label>
                                <div class="col-sm-8">
                                    <div class="row">
                                        <div class="col-xs-6">
                                            <div class="select-style">
                                                <select class="form-control" name="StartHour" ng-model="startTimePart.Hour"
                                                        ng-options="h for h in hourList" ng-change="setStartTime()" tabindex="8">
                                                    <option value="">HH</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-xs-6">
                                            <div class="select-style">
                                                <select class="form-control" name="StartMinute" ng-model="startTimePart.Minute"
                                                        ng-options="m for m in minuteList" ng-change="setStartTime()"
                                                        ng-disabled="!startTimePart.Hour" tabindex="9">
                                                    <option value="">MM</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Include / Exclude</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="operationStatusSetting.Type" name="Include Exclude" tabindex="4">
                                            <option value="">-- Select --</option>
                                            <option value="Included">Included</option>
                                            <option value="Excluded">Excluded</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Repeat Value</label>
                                <div class="col-sm-8">
                                    <input type="number" name="RepeatValue" step="any" ng-model="operationStatusSetting.RepeatValue" class="form-control" tabindex="9">
                                </div>
                            </div>

                        </div>

                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
