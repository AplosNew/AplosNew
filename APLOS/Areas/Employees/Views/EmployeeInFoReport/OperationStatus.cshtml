                                <td>{{x.ColumnName}}</td>
                                <td>{{x.Filter?'Yes':'No'}}</td>
                                <td>{{x.Type}}</td>
                                <td>{{x.Operator}}</td>
                                <td>{{x.OperatorValue}}</td>
                                <td>{{x.StartDate | dateFilter}}</td>
                                <td>{{x.StartTime}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
