<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
    .fchips {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 8px;
        padding: 4px 0;
    }

    .fchips-label {
        font-size: 12px;
        color: #6b7280;
        margin-right: 2px;
        white-space: nowrap;
    }

    .fchip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 10px;
        border: 1px solid #c7d2fe;
        background: #eef2ff;
        color: #1e1b4b;
        border-radius: 14px;
        font-size: 12px;
        line-height: 18px;
    }

    .fchip-col {
        color: #4b5563;
    }

    .fchip-op {
        font-style: normal;
        color: #6366f1;
        font-weight: 600;
    }

    .fchip-val {
        font-weight: 600;
    }

    .fchip.is-excl {
        background: #fef2f2;
        border-color: #fecaca;
        color: #7f1d1d;
    }

        .fchip.is-excl .fchip-op {
            color: #dc2626;
        }

    .fchip-not {
        font-size: 10px;
        background: #dc2626;
        color: #fff;
        border-radius: 3px;
        padding: 0 4px;
    }

    .fchips-none {
        font-size: 12px;
        color: #6b7280;
    }
</style>
