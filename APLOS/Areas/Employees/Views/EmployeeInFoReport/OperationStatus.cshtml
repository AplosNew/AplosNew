<script>
    // Syncfusion grid যখন hidden tab-এ render হয় তখন layout ভেঙে যায়।
    // ট্যাব দৃশ্যমান হওয়ার পর grid refresh করে layout ঠিক করা হয়।
    (function () {
        var gridIds = ["#masterGrid", "#oS2OneGrid", "#oS2SecondGrid", "#productionGrid", "#workCenterGrid"];

        function doRefresh() {
            for (var i = 0; i < gridIds.length; i++) {
                var el = $(gridIds[i]);
                if (el.length && el.is(":visible") && el.data("ejGrid")) {
                    try { el.ejGrid("refreshContent"); } catch (e) { }
                }
            }
            $(window).trigger("resize");
        }

        window.refreshGrids = function () {
            setTimeout(doRefresh, 50);
            setTimeout(doRefresh, 400); // fade transition শেষ হওয়ার পর
        };

        // পেজ লোডের পর Master ট্যাবের grid একবার refresh
        $(function () {
            setTimeout(doRefresh, 300);
            setTimeout(doRefresh, 800);
        });
    })();
</script>
