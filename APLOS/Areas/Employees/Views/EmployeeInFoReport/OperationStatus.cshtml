                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input tabindex="3" type="checkbox" ng-model="operationStatusSetting.Filter">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Include / Exclude</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="operationStatusSetting.Type" name="Include Exclude" tabindex="4">
                                            <option value="">-- Select --</option>
                                            <option value="Included">Included</option>
                                            <option value="Excluded">Excluded</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Operator</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Operator" maxlength="50" ng-model="operationStatusSetting.Operator" class="form-control" tabindex="5">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Operator Value</label>
                                <div class="col-sm-8">
                                    <input type="text" name="OperatorValue" maxlength="50" ng-model="operationStatusSetting.OperatorValue" class="form-control" tabindex="6">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Start Date</label>
                                <div class="col-sm-8">
                                    <input type="text" name="StartDate" ng-model="operationStatusSetting.StartDate" datepicker class="form-control" tabindex="7">
                                </div>
                            </div>
                            @*<div class="form-group">
                                    <label class="col-sm-4 control-label">Start Time</label>
                                    <div class="col-sm-8">
                                        <input type="text" name="StartTime" maxlength="5" placeholder="HH:mm" ng-model="operationStatusSetting.StartTime" ng-pattern="/^([01][0-9]|2[0-3]):[0-5][0-9]$/" class="form-control" tabindex="8">
                                    </div>
                                </div>*@
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Start Time</label>
                                <div class="col-sm-8">
                                    <div class="row">
                                        <div class="col-xs-6">
                                            <div class="select-style">
                                                <select class="form-control" name="StartHour" ng-model="startTimePart.Hour"
                                                        ng-options="h for h in hourList" ng-change="setStartTime()" tabindex="8">
                                                    <option value="">HH</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-xs-6">
                                            <div class="select-style">
                                                <select class="form-control" name="StartMinute" ng-model="startTimePart.Minute"
                                                        ng-options="m for m in minuteList" ng-change="setStartTime()"
                                                        ng-disabled="!startTimePart.Hour" tabindex="9">
                                                    <option value="">MM</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Repeat Value</label>
                                <div class="col-sm-8">
                                    <input type="number" name="RepeatValue" step="any" ng-model="operationStatusSetting.RepeatValue" class="form-control" tabindex="9">
                                </div>
                            </div>
                        </div>

                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                @*<li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                                <li><button ng-click="Delete();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Delete</button></li>
                                <li><button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="row text-right aplos-grid-toggle">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="$root.parameters.searchBy">
                                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table aplos-grid-toggle">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Data Name</th>
                                <th>Column Name</th>
                                <th>Filter</th>
                                <th>Type Text</th>
                                <th>Operator</th>
                                <th>Operator Value</th>
                                <th>Start Date</th>
                                <th>Start Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in operationStatusSettings" ng-dblclick="Get(x.Id, $index);">
                                <td>{{x.DataName}}</td>
                                <td>{{x.ColumnName}}</td>
                                <td>{{x.Filter?'Yes':'No'}}</td>
                                <td>{{x.Type}}</td>
                                <td>{{x.Operator}}</td>
                                <td>{{x.OperatorValue}}</td>
                                <td>{{x.StartDate | dateFilter}}</td>
                                <td>{{x.StartTime}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Syncfusion grid যখন hidden tab-এ render হয় তখন layout ভেঙে যায়।
    // ট্যাব দৃশ্যমান হওয়ার পর grid refresh করে layout ঠিক করা হয়।
    (function () {
        var gridIds = ["#masterGrid", "#oS2OneGrid", "#OS2SecondGrid", "#productionGrid", "#workCenterGrid"];

        function doRefresh() {
            for (var i = 0; i < gridIds.length; i++) {
                var el = $(gridIds[i]);
                if (el.length && el.is(":visible") && el.data("ejGrid")) {
                    try { el.ejGrid("refreshContent"); } catch (e) { }
                }
            }
            $(window).trigger("resize");
        }

        window.refreshGrids = function () {
            setTimeout(doRefresh, 50);
            setTimeout(doRefresh, 400); // fade transition শেষ হওয়ার পর
        };

        // পেজ লোডের পর Master ট্যাবের grid একবার refresh
        $(function () {
            setTimeout(doRefresh, 300);
            setTimeout(doRefresh, 800);
        });
    })();
</script>
