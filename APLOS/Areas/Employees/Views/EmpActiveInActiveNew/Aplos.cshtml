@*<togglable name="Employee Re-activate"></togglable>*@
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>   Employee Separated Within 4 month can be Re-Actived. </h3>

<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSetFirst(1) }"><a ng-click="setTabFirst(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Separeted List</a></li>
           </ul>


    </div>


    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetFirst(1), active: isSetFirst(1) }">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
                <div>


                    @*<div id='Grid'>e-allowselection="true"</div>*@
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="GridInActive" ej-grid e-datasource="GriddataInactive"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true">
                            <div e-columns>
                                <div e-column e-field="BudgetCode" e-headertext="BudgetCode" e-width="80"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="EmployeeCode" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="80"></div>
                                <div e-column e-field="DOB" e-headertext="DOB" e-width="80"></div>
                                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>
                                <div e-column e-field="DOS" e-headertext="DOS" e-width="80"></div>
                                <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-width="60"></div>
                                <div e-column e-field="DesignationName" e-headertext="DesignationName" e-width="60"></div>
                                <div e-column e-field="EntityId" e-headertext="EntityId" e-width="60"></div>
                                <div e-column e-field="GivenDesignation" e-headertext="GivenDesignation" e-width="60"></div>
                                <div e-column e-template="#employeeimg" e-headertext="EmpPic" e-width="60"></div>

                                <div e-column e-headertext="" e-commands="commandInActive" e-isunbound=true e-textalign="center" e-width="100"></div>

                            </div>
                            
                        </div>
                        <script type="text/x-jsrender" id="employeeimg">
                            <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" height="48" width="48">
                        </script>
                    </div>
                </div>
            </fieldset>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetSecond(2), active: isSetSecond(2) }">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Search Data</span></legend>
                <div>
                    @*<div id='Grid'>e-allowselection="true"</div>*@
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="GridActive" ej-grid e-datasource="GriddataActive"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true">
                            <div e-columns>

                                <div e-column e-field="SystemId" e-headertext="SystemId" e-width="80"></div>
                                <div e-column e-field="PositionCode" e-headertext="PositionCode" e-width="80"></div>
                                <div e-column e-field="BudgetCode" e-headertext="BudgetCode" e-width="80"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="EmployeeCode" e-width="80"></div>
                                <div e-column e-field="FirstName" e-headertext="FirstName" e-width="80"></div>
                                <div e-column e-field="MiddleName" e-headertext="MiddleName" e-width="50"></div>
                                <div e-column e-field="LastName" e-headertext="LastName" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="80"></div>
                                <div e-column e-field="DOB" e-headertext="DOB" e-width="80"></div>
                                <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-width="60"></div>
                                <div e-column e-field="DesignationName" e-headertext="DesignationName" e-width="60"></div>
                                <div e-column e-field="PositionName" e-headertext="PositionName" e-width="60"></div>
                                <div e-column e-field="GivenDesignation" e-headertext="GivenDesignation" e-width="60"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="60"></div>


                                @*<div e-column e-headertext="" e-commands="commandpo" e-isunbound=true e-textalign="center" e-width="50"></div>*@
                                <div e-column e-headertext="" e-commands="commandActive" e-isunbound=true e-textalign="center" e-width="90"></div>


                            </div>

                        </div>

                    </div>
                </div>
            </fieldset>
        </div>

    </div>



</div>
<div class="modal fade site-modal in" id="ActionPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Re-Activate Reason</div>  @*<button type="button" class="close" ng-click="closeInvoicingPartyPopUp();">&times;</button>*@
            <div class="modal-body">
                <div class="col-xs-12 col-sm-12col-md-12">

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Reason</label>
                        <label class="col-sm-4 control-label" ng-model="SystemId" ng-hide="true">{{SystemId}}</label>
                        <div class="col-sm-12">
                            <textarea type="text" rows="3" ng-model="reason" class="form-control" style="border:double"></textarea>
                        </div>



                    </div>

                </div>
                <div class="clearfix"></div>
                <div class="form-group">
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-click="UpdateInActiveToActive();" class="btn"> Save</button></li>
                        <li><button ng-click="ClosedPOPUp();" class="btn"> Close</button></li>
                    </ul>
                </div>


                @*  *@
            </div>


       
        </div>
    </div>

    
</div>


<confirm-archive-generic modalid="InactiveAlert" title="Confirmation" message={{Inactivemessage}} data-ng-click-right-button="UpdateInActiveToActive();"></confirm-archive-generic>
<confirm-archive-generic modalid="ActiveAlert" title="Confirmation" message={{Activemessage}} data-ng-click-right-button="UpdateActiveToInActive();"></confirm-archive-generic>