<table id="screenMain">
    <tr>
        <td>
            <h3 class="site-heading form-horizontal form-elements">
                <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employees QR Code
            </h3>
        </td>
        @*<td class="text-right" style="width:70px;">
                <span style="font-size:3em; color:green;" ng-hide="ShowFilterScreen==false" ng-click="filterComplete();" class="glyphicon glyphicon-circle-arrow-right"></span>
                <span style="font-size:3em; color:blueviolet;" ng-hide="ShowFilterScreen==true" ng-click="ShowFilterScreen=true; HideGrid=true;" class="glyphicon glyphicon-circle-arrow-left"></span>

            </td>*@

    </tr>
</table>
<div class="row">
    <div class="form-group">
        <div class="col-xs-12 col-sm-12 col-md-12">

            <ul class="common-btn list-inline text-left">


                <li>
                    <div ej-tooltip e-showshadow="true" e-content="QR Code for all active employees" ng-click="EmployeeQRCode();" e-width="width">
                        <button class="btn"><i class="glyphicon glyphicon-file"></i> Download QR Code</button>
                    </div>
                </li>
            </ul>
        </div>
    </div>

</div>
<div id="gridEmployee" ng-init="chkinit()" ej-grid e-datasource="EmployeeList" e-gridlines="horizontal"
     e-allowtextwrap="true" e-textwrapsettings.wrapmode="content"
     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
     e-allowselection="true" e-filtersettings-filterType="excel">
    <div e-columns>
        <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
        <div e-column e-type="string" e-field="Id" e-headertext="Id" e-width="30"></div>
        <div e-column e-type="string" e-field="EmployeeCode" e-headertext="Code" e-width="30"></div>
        <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
        <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="80"></div>
        <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="80"></div>
        <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
        <div e-column e-type="string" e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
    </div>
</div>
<script type="text/x-jsrender" id="empimage">
    <img onerror="$(arguments[0].currentTarget).attr('src','images/blankuser.png')" src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
</script>



