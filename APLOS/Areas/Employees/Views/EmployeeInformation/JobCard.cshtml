<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Job Card Information
</h3>
<div class="form-elements form-horizontal" ng-form id="from" name="from">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="Form Date" ng-model="jobCardReport.FromDate" datepicker class="form-control">
                <p ng-show="dateMessageFrom" style="color:red" class="show-message">{{dateMessageFrom}}</p>
                <p ng-show="dateMessageFrom2" style="color:red" class="show-message">{{dateMessageFrom2}}</p>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <input type="text" name="To Date" ng-model="jobCardReport.ToDate" datepicker class="form-control">
                <p ng-show="dateMessageTo" style="color:red" class="show-message">{{dateMessageTo}}</p>
            </div>
        </div>

    </div>
    <div class="form-group">
            <div class="common-btn col-xs-12 col-sm-6 col-md-6">
                <ul class="list-inline text-right">
                    <li><button ng-click="jobCardReport();" class="btn"><i class="glyphicon glyphicon-print"></i> Print</button></li>
                </ul>

            </div>
    </div>
</div>

