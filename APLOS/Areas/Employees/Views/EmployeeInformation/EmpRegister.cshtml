
<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Register Information
</h3>


<div class="form-elements form-horizontal" ng-form id="leavefrom" name="leavefrom">
    <div class="col-sm-2">
        <div class="form-group">
            <div class="radio">
                <label>
                    <input type="radio" name="IsProrataMonthlyColu" ng-model="EmployeeInFoReport.EmployeeCatagory" value="Active">
                    <span class="cr"><i class="cr-icon"></i></span>Active Employee
                </label>

            </div>
        </div>
    </div>

    <div class="col-sm-2">
        <div class="form-group">
            <div class="radio">
                <label>
                    <input type="radio" name="IsProrataMonthlyColu" ng-model="EmployeeInFoReport.EmployeeCatagory" value="Separated">
                    <span class="cr"><i class="cr-icon"></i></span>InActive Employee
                </label>
            </div>
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-6">
            <button ng-click="EmpRegisterPrint();" id="download" class="btn single-btn" tabindex="2"><i class="glyphicon glyphicon-download"></i> Download</button>
        </div>
    </div>
</div>
