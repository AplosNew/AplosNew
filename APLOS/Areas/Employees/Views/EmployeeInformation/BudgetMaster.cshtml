<h3 class="site-heading" style="cursor:default"><span class="glyphicon glyphicon-info-sign"></span> Budget Master Employee Tagging</h3>
<div class="form-horizontal form-elements row" ng-form name="form">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="positionAllowance.PlantId" name="Entity" ng-options="item.Value as item.Text for item in plantList" required>
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <label class="col-sm-3 control-label">Employee<sup>*</sup></label>
        <div class="col-sm-9 input-group">
            <input type="hidden" ng-model="positionAllowance.EmployeeId" class="form-control" disabled required>
            <input type="text" name="Position" ng-model="positionAllowance.EmployeeName" class="form-control" disabled required>
            <span class="input-group-btn">
                <button name="submit" class="btn single-small-btn" ng-click="showEmployeeListPopUp()" tabindex="3">
                    <i class="cr-icon glyphicon glyphicon-search"></i>
                </button>
                <button class="btn single-small-btn" ng-click="clearEmployee()">
                    <i class="cr-icon glyphicon glyphicon-refresh"></i>
                </button>
            </span>
        </div>
        <ul class="common-btn list-inline text-right">
            <li>
                <button ng-click="showBudgetMasterPopUpList();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add Budget Master</button>
                <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk" tabindex="29"></i> Save</button>
            </li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="budgetParameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="budgetParameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="positionAllowanceList.length>0">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>GL</th>
                <th>Budget Group</th>
                <th>Budget Category</th>
                <th>Budget Subcategory</th>
                <th>Budget</th>
                <th>Level</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in positionAllowanceList|itemsPerPage:budgetParameters.pageSize" total-items="budgetParameters.total_count">
                <td>{{x.GLGeneralInfoCode}} - {{x.GLGeneralInfoName}}</td>
                <td>{{x.BudgetGroup}}</td>
                <td>{{x.BudgetCategory}}</td>
                <td>{{x.BudgetSubCategory}}</td>
                <td>{{x.BudgetItem}}</td>
                <td>
                    <div class="col-md-12 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="x.MappingLevel">
                                <option ng-repeat="option in mappingLevelList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </td>
                <td class="text-right">
                    <div class="col-sm-12 input-group" style="margin-top:-7px;">
                        <span class="input-group-btn">
                            <button ng-disabled="x.MappingLevel=='Budget'" ng-click="activityPopUpShow(x, $index)" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                        <button ng-click="removeRow($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                            <i class="glyphicon glyphicon-remove"></i>
                        </button>
                    </div>
                    @*<div class="dropdown">
                            <a class="dropdown-toggle" data-toggle="dropdown" href=""><i class="glyphicon glyphicon-menu-down"></i></a>
                            <ul ng-hide="!x.Active" class="dropdown-menu dropdown-menu-right" role="menu" aria-labelledby="dLabel">
                                <li><a href="{{bootPoint}}employee-budget-master-activity/{{positionAllowance.EmployeeId}}/{{positionAllowance.EmployeeName}}/{{x.BudgetMasterId}}/{{x.BudgetItem}}">Budget Master Activity</a></li>
                            </ul>
                        </div>*@
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)"></dir-pagination-controls>
</div>
@Html.Partial("~/Areas/Accounts/Views/BudgetMaster/_BudgetMasterPopUp.cshtml")
@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
@Html.Partial("~/Areas/Employees/Views/EmployeeInformation/_BudgetMasterActivityPopUp.cshtml")
@Html.Partial("~/Areas/Employees/Views/EmployeeInformation/_BudgetMasterActivityAddPopUp.cshtml")
<confirm-archive-generic modalid="activityDeletePopUp" title="Confirmation" message={{activityConfirmMessage}} data-ng-click-right-button="confirmActivityRemoveRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="activityDeleteAddPopUp" title="Confirmation" message={{activityConfirmMessage}} data-ng-click-right-button="confirmActivityAddRemoveRow()"></confirm-archive-generic>
