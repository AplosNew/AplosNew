
<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Information
</h3>

<div class="form-elements form-horizontal" ng-form id="leavefrom" name="leavefrom">
    <div class="form-group">
        <label class="col-sm-1 col-md-1 control-label">Employee Select</label>
        <div class="col-sm-3 pdr3">
            <div class="input-group">
                <span class="input-group-addon">{{emp.EmployeeId}}</span>
                <input type="text" ng-model="emp.EmployeeName" class="form-control" required readonly>
                <span class="input-group-btn">
                    <button ng-click="popUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                </span>
            </div>
        </div>
        <div class="col-sm-4 pdl3">
            <button ng-click="EmpReportPrint();" id="download" class="btn single-btn" tabindex="2"><i class="glyphicon glyphicon-download"></i> Download</button>
            <button ng-click="Clear();" class="btn single-btn" tabindex="3"><i class="glyphicon glyphicon-refresh"></i> Clear</button>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row form-element-ctrl form-horizontal">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div ng-dropdown-multiselect="" options="divisionNewList" selected-model="divisionIds"
                                     extra-settings="multiSelectSettings" translation-texts="example4customTexts" events="multi4events"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div ng-dropdown-multiselect="" options="departmentNewList" selected-model="departmentIds"
                                     extra-settings="multiSelectSettings" translation-texts="example3customTexts" events="multi3events"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div ng-dropdown-multiselect="" options="sectionNewList" selected-model="sectionIds"
                                     extra-settings="multiSelectSettings" translation-texts="example5customTexts" events="multi5events"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div ng-dropdown-multiselect="" options="employeeCategoryNewList" selected-model="employeeCategoryIds"
                                     extra-settings="multiSelectSettings" translation-texts="example6customTexts" events="multi6events"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div ng-dropdown-multiselect="" options="givenDesignationNewList" selected-model="givenDesignationIds"
                                     extra-settings="multiSelectSettings" translation-texts="example7customTexts" events="multi7events"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row form-element-ctrl form-horizontal">
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Employee Code</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="ShortName" ng-model="paidHoursEmployeeAssignNew.EmployeeCode" class="form-control" maxlength="15" tabindex="3">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Employee Name</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="ShortName" ng-model="paidHoursEmployeeAssignNew.EmployeeName" class="form-control" maxlength="15" tabindex="3">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="common-btn">
                            <button type="button" ng-click="getSearchData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                        </div>
                    </div>
                </div>
                <p>Employee Count:{{employeeParameters.total_count}}</p>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>Employee Name</th>
                                <th>Employee Category</th>
                                <th>Given Designation</th>
                                <th>Division</th>
                                <th>Department</th>
                                <th>Section</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
        pagination-id="metaData.name + 'employeeList'" ng-dblclick="setData(x)">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.EmployeeCategory}}</td>
                                <td>{{x.GivenDesignation}}</td>
                                <td>{{x.Division}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.Section}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'employeeList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getEmployeeData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>

