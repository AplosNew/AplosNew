
<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Entries" role="tab" data-toggle="tab">Target Upload</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Reporting" role="tab" data-toggle="tab">Employee</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <togglable></togglable>
            <div class="form-elements form-horizontal row" ng-form name="ModelNewForm">
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Entity</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="EntityId" name="Entity" ng-change="getProcess();getPo();getWkC();"
                                        ng-options="item.Value as item.Text for item in EntityList">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>



                    <div id="div_Date" class="form-group">
                        <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="From Date" ng-model="TargetDate" datepicker class="form-control" tabindex="4">

                        </div>
                    </div>


                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Process</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="ProcessId" name="Process" ng-change="getWkC();GetShiftList();"
                                        ng-options="item.Value as item.Text for item in ProcessList">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Shift</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="shiftId" name="WorkCenter"
                                        ng-options="item.Value as item.Text for item in ShiftList">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div id="div_Date" class="form-group">
                        <label class="col-sm-4 control-label">Working Hour<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Working Hour" ng-model="WorkingHour" class="form-control" tabindex="6">
                        </div>
                    </div>



                </div>

                <div class="col-md-9">
                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-4 ">
                            <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                        </label>
                        <input type="button" value="Import Data" class="btn btn-success"
                               ng-click="ImportData()" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="GetSampleFile();" ng-disabled="shiftId==null" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File Download</button></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div id="GridWorkCenterProduct"
                         ng-init="chkinit()"
                         ej-grid e-datasource="UploadedData"
                         e-allowfiltering="true"
                         e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowscrolling="true"
                         e-pagesettings-pagesize="25"
                         e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="WorkCenter" e-headertext="WorkCenter" e-width="100"></div>
                            <div e-column e-headertext="PO" e-template="#po" e-textalign="center" e-width="100"></div>
                            <div e-column e-headertext="TargetQty" e-template="#tQty" e-textalign="center" e-width="100"></div>
                            <div e-column e-field="SPT" e-headertext="SPT" e-width="100"></div>
                            <div e-column e-field="Operator" e-headertext="Operator" e-width="80"></div>
                            <div e-column e-field="Helper" e-headertext="Helper" e-width="80"></div>
                        </div>
                    </div>
                    <script type="text/template" id="po">
                        <input type="text" class="form-control" ng-model="data.ProductionOrderId" style="color:black; text-align:center" />
                    </script>
                    <script type="text/template" id="so">
                        <input type="text" class="form-control" ng-model="data.SalesOrderId" style="color:black; text-align:center" />
                    </script>
                    <script type="text/template" id="tQty">
                        <input type="text" class="form-control" ng-model="data.TargetQty" style="color:black; text-align:center" />
                    </script>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12 ">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li ng-show="ShowSaveBtn"> <button ng-click="SaveUploadedData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <togglable></togglable>
            <div class="form-elements form-horizontal row" ng-form name="ModelNewForm1">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Entity</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="EntityId" name="Entity" ng-change="getProcess();getPo();getWkC();"
                                        ng-options="item.Value as item.Text for item in EntityList">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>


                    <div id="div_Date" class="form-group">
                        <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Category" ng-model="DailyTargetEmployeeData.Category" class="form-control" tabindex="6">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Employee<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <input type="text" name="Employee" ng-model="EmployeeName" required @*style="width:200px;"*@ class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button name="submit" ng-click="openPopupAngular('employeeNewPopUp')" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input tabindex="8" type="checkbox" ng-model="DailyTargetEmployeeData.Active">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Process</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="DailyTargetEmployeeData.ProcessId" name="Process" ng-change="getWkC();GetShiftList();"
                                        ng-options="item.Value as item.Text for item in ProcessList">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Work Group</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="DailyTargetEmployeeData.WorkGroupId" name="WorkGroup" ng-change="getWkC();GetShiftList();"
                                        ng-options="item.Value as item.Text for item in WorkGroupList">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Reporting Officer<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <input type="text" name="Employee" ng-model="ReportingOfficerName" required @*style="width:200px;"*@ class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button name="submit" ng-click="openPopupAngular('ReportingOfficerPopUp')" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Remark<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <textarea rows="1" type="text" name="Remark" tabindex="8" class="form-control" ng-model="DailyTargetEmployeeData.Remark" maxlength="500" required capitalize></textarea>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="SaveDailyTargetEmployee();" class="btn" tabindex="9"><i class="glyphicon glyphicon-download"></i> Save </button></li>
                    </ul>
                </div>

            </div>
            <div class="aplos-grid-toggle">
                @*<div class="row text-right">
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="searchByPostedGRN">
                                        <option ng-repeat="option in searchByPostedGRNList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="searchGRN" ng-enter="getDataList();">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="getDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>*@
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPrint" ej-grid e-datasource="DailyTargetEmployeeList" e-allowfiltering="true" e-allowpaging="true"
                         e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true"
                         e-allowscrolling="true" e-showstackedheader="true">
                        <div e-columns>
                            <div e-column e-field="ProcessName" e-headertext="Process" e-width="60" e-filter="false"></div>
                            <div e-column e-field="Category" e-headertext="Category" e-width="80"></div>
                            <div e-column e-field="WorkGroupName" e-headertext="WorkGroup" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="100"></div>
                            <div e-column e-field="ReportingOfficerName" e-headertext="ReportingOfficerName" e-width="100"></div>
                            @*<div e-column e-headertext=" Action " e-template="#DeleteTemplate" e-width="180"></div>*@
                        </div>
                    </div>
                    @*<script id="ReportTemplate" type="text/template">
                    <div class="common-btn">
                        <ul class="common-btn list-inline text-center">
                            <li>
