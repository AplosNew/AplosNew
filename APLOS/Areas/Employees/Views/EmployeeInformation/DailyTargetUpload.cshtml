
<togglable name=" To be Uploaded & Downloaded"></togglable>
<div class="form-elements form-horizontal row" ng-form name="ModelNewForm">
    
    <div class="col-md-9">
        <div class="inputBtnSection common-btn">
            <label class="fileUpload col-sm-4 ">
                <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
            </label>
            <input type="button" value="Import Data" class="btn btn-success"
                   ng-click="ImportData()" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="GetSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File Download</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div id="GridWorkCenterProduct"
             ng-init="chkinit()"
             ej-grid e-datasource="UploadedData"
             e-allowfiltering="true"
             e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowscrolling="true"
             e-pagesettings-pagesize="25"
             e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="EmployeeCode" e-headertext="EmployeeCode" e-width="100"></div>
                <div e-column e-field="SystemId" e-headertext="SystemId" e-width="100"></div>
                <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-width="100"></div>
                <div e-column e-field="DOJ" e-headertext="DOJ" e-width="100"></div>
                <div e-column e-field="DOS" e-headertext="DOS" e-width="100"></div>
                <div e-column e-field="Entity" e-headertext="Entity" e-width="100"></div>
                <div e-column e-field="Company" e-headertext="Company" e-width="100"></div>
                <div e-column e-field="Plant" e-headertext="Plant" e-width="100"></div>
                <div e-column e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-width="80"></div>
                <div e-column e-field="EmployeeCurrentStatus" e-headertext="EmployeeCurrentStatus" e-width="80"></div>
                <div e-column e-field="EmployeeUserStatus" e-headertext="EmployeeUserStatus" e-width="80"></div>
                <div e-column e-field="UserDefineCategory" e-headertext="UserDefineCategory" e-width="80"></div>
                <div e-column e-field="Remark" e-headertext="Remark" e-width="80"></div>
                <div e-column e-field="ToUpdate" e-headertext="ToUpdate" e-width="80"></div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 ">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li ng-show="ShowSaveBtn"> <button ng-click="SaveUploadedData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
            </ul>
        </div>
    </div>
</div>