<togglable name="Training Type"></togglable>
<div class="form-elements form-horizontal" ng-form name="TrainingTypeNewForm">
    <input type="hidden" ng-model="TrainingTypeNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sequence" n-decimals="2" ng-model="TrainingTypeNew.Sequence" class="form-control" maxlength="15" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Name Of Training<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" ng-model="TrainingTypeNew.NameOfTraining" class="form-control" maxlength="15" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Minimum Days<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="MinDays" ng-model="TrainingTypeNew.MinimumDays" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="TrainingTypeNew.Code" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Maximum Days<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="MinDays" ng-model="TrainingTypeNew.MaximumDays" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="TrainingTypeNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>
    </div>
    @*<div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="SaveGroup();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button ng-click="removeGroup();" title="Remove" class="btn"><i class="glyphicon glyphicon-trash"></i>Delete</button></li>
            <li> <button ng-click="ClearGroup();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>*@
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="CategorysearchBy">
                            <option ng-repeat="option in CategorysearchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="searchCategory" ng-enter="getTrainingTypeData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getTrainingTypeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="TrainingTypes" e-recorddoubleclick="GetCategory" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false" e-isprimarykey="true"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmCatDataPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteCategory();"></confirm-archive-generic>