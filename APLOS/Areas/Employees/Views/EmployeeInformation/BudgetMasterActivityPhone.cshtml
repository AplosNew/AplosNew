<h3 class="site-heading" style="cursor:default"><span class="glyphicon glyphicon-info-sign"></span> Budget Master Activity Phone Responsible Person</h3>
<div class="form-horizontal form-elements row" ng-form name="form">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <label class="col-sm-3 control-label">Employee<sup>*</sup></label>
        <div class="col-sm-9 pdr3">
            <input type="hidden" ng-model="positionAllowance.EmployeeId" class="form-control" disabled required>
            <input type="text" name="Position" ng-model="positionAllowance.EmployeeName" class="form-control" disabled required>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <label class="col-sm-3 control-label">Budget<sup>*</sup></label>
        <div class="col-sm-9 pdr3">
            <input type="hidden" ng-model="positionAllowance.BudgetMasterId" class="form-control" disabled required>
            <input type="text" name="Position" ng-model="positionAllowance.BudgetMasterName" class="form-control" disabled required>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <label class="col-sm-3 control-label">Activity<sup>*</sup></label>
        <div class="col-sm-9 pdr3">
            <input type="hidden" ng-model="positionAllowance.ActivityId" class="form-control" disabled required>
            <input type="text" name="Position" ng-model="positionAllowance.ActivityName" class="form-control" disabled required>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12 ">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table" ng-show="positionAllowanceList.length>0">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Apply</th>
                <th>GL</th>
                <th>Budget</th>
                <th>Activity</th>
                <th>Activity Type</th>
                <th>Cell Number</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in positionAllowanceList|itemsPerPage:$root.pageSize" total-items="$root.total_count">
                <td>
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="x.Active" ng-click="Save($event, x)">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </td>
                <td>{{x.GLGeneralInfoName}}</td>
                <td>{{x.BudgetCodeName}}</td>
                <td>{{x.ActivityCodeName}}</td>
                <td>{{x.ActivityType}}</td>
                <td>{{x.ActivityType}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>