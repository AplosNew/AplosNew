<togglable name="Employee Information"></togglable>
<style>

    #accordion section, #accordion .pointer, #accordion h1, #accordion p {
        -webkit-transition: all 0.20s ease-in-out;
        -moz-transition: all 0.5s ease-in-out;
        transition: all 0.5s ease-in-out;
    }

    #accordion {
        margin-bottom: 30px;
    }

        #accordion h1 {
            line-height: 1.2;
            font-size: 15px;
            background-color: #3e445a;
            margin: 0;
            padding: 10px 10px 10px 30px;
        }

            #accordion h1 a {
                color: #fff;
            }

        #accordion section {
            overflow: hidden;
        }

        #accordion p {
            padding: 0 10px;
            color: #fff;
        }

        #accordion section.ac_hidden p:not(.pointer) {
            color: #fff;
        }

        #accordion section.ac_hidden {
            height: 44px;
        }

        #accordion .pointer {
            padding: 0;
            margin: 10px 0 0 6px;
            line-height: 20px;
            width: 13px;
            position: absolute;
        }

        #accordion section:not(.ac_hidden) h1 {
            background-color: #204d74;
        }

        #accordion section:not(.ac_hidden) .pointer {
            display: block;
            -webkit-transform: rotate(90deg);
            -moz-transform: rotate(90deg);
            -o-transform: rotate(90deg);
            transform: rotate(90deg);
            padding: 0;
        }

    #drpdwnfont {
        color: #95a5a6;
    }

    html {
        overflow: scroll;
    }

    .filled {
        background-color: #0dbe67 !important;
    }
</style>
<label style="color:{{Color}};float:right">{{approved}}</label>
<div class="form-elements form-horizontal" ng-form name="employeeInformationForm" id="addEmployee">
    @*<div class="form-horizontal form-elements" ng-form name="employeeInformationForm" ng-scroll="auto" id="addEmployee">*@
    <input type="hidden" ng-model="employeeInformation.SystemId">
    <div class="row" ng-form name="employeeInformationForm1">
        <div ng-form name="employeeInformationForm2">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">SystemId</label>
                    <label class="col-sm-2 control-label">{{employeeInformation.SystemId}}</label>
                    <label class="col-sm-3 control-label">EmployeeCode Type</label>
                    <label class="col-sm-3 control-label">{{employeeInformation.EmpCodeType}}</label>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Employee Code<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Employee Code" ng-model="employeeInformation.EmployeeCode" disabled class="form-control" maxlength="30" required tabindex="1">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Salutation<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select id="Salutation" class="form-control" name="Salutation" ng-model="employeeInformation.Salutation" tabindex="1" required>
                                <option value="">--Select--</option>
                                <option ng-repeat="option in salutaionList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">First Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="First Name" ng-model="employeeInformation.FirstName" ng-disabled="employeeInformation.IsApproved" class="form-control" maxlength="100" tabindex="2" required>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Middle Name</label>
                    <div class="col-sm-8">
                        <input type="text" name="Middle Name" ng-model="employeeInformation.MiddleName" ng-disabled="employeeInformation.IsApproved" class="form-control" maxlength="100" tabindex="3">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Last Name</label>
                    <div class="col-sm-8">
                        <input type="text" name="Last Name" ng-model="employeeInformation.LastName" ng-disabled="employeeInformation.IsApproved" class="form-control" maxlength="100" tabindex="4">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Employee Name</label>
                    <div class="col-sm-8">
                        <label class="control-label">{{employeeInformation.EmployeeName=(employeeInformation.FirstName?employeeInformation.FirstName:'')+' '+(employeeInformation.MiddleName?employeeInformation.MiddleName:'')+' '+(employeeInformation.LastName?employeeInformation.LastName:'')}}</label>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label" style="color: blue;">{{NameLabel}}</label>
                    <div class="col-sm-7">
                        <input type="text" name="EmployeeNameLocal" ng-model="employeeInformation.EmployeeNameLocal" class="form-control" maxlength="100" tabindex="2">
                    </div>
                    <label class="col-sm-1 control-label" style="color: blue;font-size: 11px;padding-left: 0px;">[Local]</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Nick Name</label>
                    <div class="col-sm-8">
                        <input type="text" name="Nick Name" ng-model="employeeInformation.NickName" class="form-control" maxlength="100" tabindex="5">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Punch Card No.</label>
                    <div class="col-sm-8">
                        <input type="text" name="Punch Card No." ng-model="employeeInformation.CardNumber" class="form-control" maxlength="50" tabindex="5">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Emp Type (Is Expatriate)</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="employeeInformation.EmpType" name="Emp Type" required>
                                <option value="">--Select--</option>
                                <option value="Local">Local</option>
                                <option value="Expatriate">Expatriate</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Applying <span style="text-transform: lowercase;">as fresher</span></label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="employeeInformation.ApplyingAsFresher">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Entry Level<sup>*</sup></label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="employeeInformation.EntryLevel" name="EntryLevel" ng-disabled="employeeInformation.IsApproved">
                                <option value="">--Select--</option>
                                <option value="Trainee">Trainee</option>
                                <option value="NonTrainee">Non-Trainee</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Budget Code<sup>*</sup></label>
                    <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                        <input type="hidden" name="Budget Code" ng-model="employeeInformation.BudgetCode" class="form-control" required>
                        <input type="text" name="Code" ng-model="employeeInformation.Code" class="form-control" readonly required>
                        @*<span class="input-group-btn">
                                <button ng-click="popUp();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                                <button ng-click="clearCode()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                            </span>*@
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-sm-8">
                        <div>
                            <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="margin-left: 180px; border: 1px solid; height: 150px; width: 150px;" />
                        </div>
                    </div>
                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-6" style="margin-left: 180px;">
                            <input id="uploadImage" ng-file-select="onFileSelect($files)" type="file" name="uploadFile" class="upload" />
                            <span class="uploadBtn"><i class="fa fa-paperclip" aria-hidden="true"> Upload</i></span>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Upload Signature</label>
                    <div class="col-sm-8">
                        <img id="uploadSigsrc" ng-src="{{EmpSignature}}" style="border: 1px solid; height: 50px; width: 135px;" />
                    </div>
                </div>
                <div class="form-group" style="margin-top: -10px;">
                    <label class="col-sm-4 control-label"></label>
                    <div class="col-sm-8">
                        <div id="UploadDefault" e-dialogtext-title="Signature" e-autoupload="true" e-begin="onBeginUpload" e-filesize="2097152" ej-uploadbox e-saveurl="uploadUrl" e-multiplefilesselection=false e-success="getFileList" e-extensionsallow=".jpg,.bmp,.png,.jpeg" e-error="errorPicUpload"></div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Job Location<sup>*</sup> </label>
                    <div class="col-sm-8 input-group show-message">
                        <div class="select-style">
                            <select id="JobLocation" class="form-control" name="Job Location" ng-model="employeeInformation.JobLocationID" ng-disabled="employeeInformation.IsApproved" tabindex="14" required>
                                <option value="">--Select--</option>
                                <option ng-repeat="option in JobLocationList" value="{{option.SystemID}}">{{option.JobLocation}}</option>
                            </select>
                        </div>
                        <span class="input-group-btn">
                            <button ng-show="Flag=='Load All'" ng-click="LoadAllJobLocation();" ng-disabled="employeeInformation.IsApproved" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i>Load All</button>
                            <button ng-show="Flag=='Load Less'" ng-click="LoadPlantJobLocation();" ng-disabled="employeeInformation.IsApproved" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i>Load Less</button>
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Do<span style="text-transform: lowercase;"> you know anyone in<br /></span> <span style="text-transform: lowercase;">this company?</span></label>
                    <div class="col-sm-2">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="employeeInformation.IsKnownPerson" ng-change="getNum();">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                    <label ng-show="employeeInformation.IsKnownPerson===true" class="col-sm-3 control-label" title="No. of Known Person">No.<span style="text-transform: lowercase;">of Known Person</span></label>
                    <div class="col-sm-3" ng-show="employeeInformation.IsKnownPerson===true">
                        <input type="number" name="Number of Known Person" ng-model="employeeInformation.NumberOfKnownPerson" class="form-control">
                    </div>

                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label"></label>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Training Type</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="employeeInformation.TrainingTypeId" name="TrainingType" ng-disabled="employeeInformation.IsApproved||employeeInformation.EntryLevel=='NonTrainee'">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in TrainingTypesCbo" value="{{option.Id}}">{{option.NameOfTraining}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="common-btn" style="padding-right:18px">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" ng-disabled="employeeInformation.SystemId===null" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{employeeInformation.SystemId==null?'Save':'Update'}}</button></li>
                </ul>
            </div>
        </div><br />
