<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Issue" role="tab" data-toggle="tab">Issue</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" aria-controls="GLpload" role="tab" data-toggle="tab">Responsible Person</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <togglable name="Daily Issue"></togglable>
            <div class="form-elements form-horizontal" ng-form name="ModelNewForm">
                <input type="hidden" ng-model="DailyIssueNew.Id">
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Category<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Category" ng-model="DailyIssueNew.Category" class="form-control" required tabindex="1" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Resolve Time<sup>*</sup></label>
                        <div class="col-sm-6 show-message">
                            <input type="text" name="ResolveTime" ng-model="DailyIssueNew.ResolveTime" only-numbers class="form-control" required tabindex="5" maxlength="50">
                        </div>
                        <label class="col-sm-2 control-label">(Min)</label>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Criticality Level<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="DailyIssueNew.CriticalityLevel" name="Item"
                                        ng-options="item.Value as item.Text for item in CriticalityLevelList" required tabindex="10">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <input type="text" name="Responsible Person" ng-model="DailyIssueNew.ResponsiblePerson" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="getPopUpData();" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Issue<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Issue" ng-model="DailyIssueNew.IssueType" class="form-control" maxlength="50" required tabindex="2">
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Handle Time<sup>*</sup></label>
                        <div class="col-sm-6 show-message">
                            <input type="text" name="HandleTime" ng-model="DailyIssueNew.HandleTime" only-numbers class="form-control" required tabindex="5" maxlength="50">
                        </div>
                        <label class="col-sm-2 control-label">(Min)</label>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select id="Shit " class="form-control" ng-model="DailyIssueNew.ShiftId" name="Shift" tabindex="16" required>
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in fixedShitList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="DailyIssueNew.Remarks" maxlength="250" tabindex="6"></textarea>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            <div class="row text-right aplos-grid-toggle">
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="searchDIBy">
                                        <option ng-repeat="option in searchByDIList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="searchDI" ng-enter="getData()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-responsive aplos-grid-toggle">
                <div id="GridEdit" ej-grid e-datasource="DailyIssues" e-recorddoubleclick="Get" e-load="loadGridEdit"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false" e-isprimarykey="true"></div>
                        <div e-column e-field="ShiftName" e-headertext="Shift" e-width="2"></div>
                        <div e-column e-field="Category" e-headertext="Category" e-width="2"></div>
                        <div e-column e-field="IssueType" e-headertext="Issue" e-width="5"></div>
                        <div e-column e-field="CriticalityLevel" e-headertext="CriticalityLevel" e-width="5"></div>
                        <div e-column e-field="ResolveTime" e-headertext="ResolveTime" e-width="3"></div>
                        <div e-column e-field="HandleTime" e-headertext="HandleTime" e-width="3"></div>
                        <div e-column e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="5"></div>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="getEmpPopUpData()" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> Responsible Person</button></li>
                            </ul>
                        </div>
                    </div>

                </div>
                <div class="col-xs-12">
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="GridRP" ej-grid e-datasource="ResponsiblePersonList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-template="#Remove" e-headertext="Actions" e-width="90"></div>
                                <div e-column e-field="EmpSystemId" e-headertext="EmpSystemId" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                            </div>
                        </div>

                    </div>
                    <script type="text/template" id="Remove">
                        <div class="col-sm-2 text-left" style="padding: 0px; padding-left: 2px; width: 20px;">
                            <button ng-click="$parent.removeEmp(this);" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-trash"></i></button>
                        </div>
                    </script>
                  
                </div>
            </div>
        </div>
    </div>
</div>


<confirm-archive-generic modalid="confirmRunDelPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteEmployee();"></confirm-archive-generic>

<div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
            </div>
            <div class="modal-body">
                @*<div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchBy">
                                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getEmpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>

                    </div>*@
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div class="content-container-fluid" style="color:black;">
                        <div style="color:black;" id="Grid" ej-grid e-datasource="ResponsiblePersonList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-field="EmpSystemId" e-headertext="EmpSystemId" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                                <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                                <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Employee Information<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-templaterefresh="refreshTemplateemployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="SystemId" e-headertext="EmpSystemId" e-headertext-color="black" e-textalign="left" e-width="75"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplate">
                            <input type="checkbox" id="headchk" />
                        </script>
                    </div>
                    <div class="common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="closePopUp();" class="btn">Apply</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>