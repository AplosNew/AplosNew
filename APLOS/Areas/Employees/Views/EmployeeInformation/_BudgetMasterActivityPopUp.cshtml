<div class="modal fade site-modal in" id="budgetActivityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Activity Responsible Person</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <ul class="common-btn list-inline text-left">
                            <li>
                                <button ng-click="showActivityPopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add Activity</button>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>FA Linked</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in budgetActivityList">
                                <td>{{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetItem}}</td>
                                <td>{{x.ActivityCodeName}}</td>
                                <td>{{x.FALinked}}</td>
                                <td class="text-right">
                                    <button ng-click="removeAtivityAddRow($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                        <i class="glyphicon glyphicon-remove"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="activityPopUpClose();">OK</button>
            </div>
        </div>
    </div>
</div>