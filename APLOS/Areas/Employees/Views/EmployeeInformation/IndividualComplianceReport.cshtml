<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Individual Compliance
</h3>

<div class="form-horizontal" ng-form name="employeeInformationForm" ng-scroll="auto">
    <div class="col-xs-12">
        <div class="row">

            <div class="col-sm-4 radio">
                <input type="radio" name="baselinedate" ng-model="EmployeeStatus" value="Active">
                <span></span><span>Active Employee</span><br />

            </div>
            <div class="col-sm-4 radio">
                <input type="radio" name="baselinedate" ng-model="EmployeeStatus" value="Separated" ng-checked="Separated">
                <span></span><span>InActive Employee</span><br />

            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button ng-click="getData();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Go</button></li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Employee Code</th>
                <th>Employee Name</th>
                <th>DOJ</th>
                <th>DOB</th>
                <th>Department</th>
                <th>Section</th>
                <th>Designation</th>
                <th>Report Type</th>
                <th>Language</th>
                <th>Print</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in employees |itemsPerPage:$root.pageSize" total-items="$root.total_count" pagination-id="metaData.name + 'employees'">
                <td>{{x.EmployeeCode}}</td>
                <td>{{x.EmployeeName}}</td>
                <td>{{x.DOJ | dateFiltering}}</td>
                <td>{{x.DOB | dateFiltering}}</td>
                <td>{{x.Department}}</td>
                <td>{{x.Section}}</td>
                <td>{{x.LegalDesignation}}</td>
                <td>
                    <div class="select-style">
                        <select id="CompliedShiftGroupId" class="form-control" name="Complied Shift Group" ng-model="x.SelectedItem" ng-change="loadTemplateCbo(x.SelectedItem,$index)" tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in ReportTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </td>
                <td>
                    <div class="select-style">
                        <select class="" ng-model="x.Id" name="Complied Shift Group" tabindex="1" ng-disabled="x.SelectedItem===''">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in templateList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>

                </td>


                <td>
                    <div class="common-btn">
                        <ul class="common-btn list-inline text-left">
                            <li> <button class="btn" ng-click="PrintLocal(x.SystemId,x.Id,x.SelectedItem,$index);">DownLoad</button></li>
                        </ul>

                    </div>
                </td>

            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             pagination-id="metaData.name + 'employees'"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
</div>


<div class="modal fade site-modal in" id="parametersPopUpModel" role="dialog" data-backdrop="static" style='overflow:auto;'>
    <div class="modal-dialog modal-sm">
        <div class="modal-content" name="budgetCodeChangeForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-elements form-horizontal">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Select Year<sup>*</sup></label>
                    <div class="col-sm-8  show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="Id" ng-change="getFromAndToDate()" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in ClanderYear" value="{{option.Id}}">{{option.YearNo}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-8  show-message">
                        <input type="text" name="Form Date" value="{{ClanderYearModel.FromDate}}" datepicker class="form-control" readonly>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-8  show-message">
                        <input type="text" name="To Date" value="{{ClanderYearModel.ToDate}}" datepicker class="form-control" readonly>
                    </div>
                </div>


                <div class="form-group">
                    <div class="common-btn col-xs-12 col-sm-8 col-md-6">
                        <ul class="list-inline text-right">
                            <li><button ng-click="LeaveRegisterReportPrint();" class="btn"> <i class="glyphicon glyphicon-download"></i> Download</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade site-modal in" id="IdCardPopUpModel" role="dialog" data-backdrop="static" style='overflow:auto;'>
    <div class="modal-dialog modal-md">
        <div class="modal-content" name="IdCardForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="number" maxlength="18" disabled name="Sequence" ng-model="model.Sequence" class="form-control" tabindex="1">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Issue Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="model.IssueDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label" title="Work Type">Work Type@*<sup>*</sup>*@</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="model.EmployeeWorkTypeId" id="Work Type" name="Work Type" tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in workTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Expiry Date</label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="model.ExpiryDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8">
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="SaveIdIssue();" class="btn"> <i class="glyphicon glyphicon-floppy-save"></i> Save</button></li> @*<i class="glyphicon glyphicon-download"></i>*@
                    </ul>
                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table" style="margin: 10px;">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sequence</th>
                                <th>Issue Date</th>
                                <th>Expiry Date</th>
                                <th>Work Type</th>
                                <th>Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in issueIdCardList">
                                <td>{{x.Sequence}}</td>
                                <td>{{x.IssueDate | dateFiltering}}</td>
                                <td>{{x.ExpiryDate | dateFiltering}}</td>
                                <td>{{x.UserName}}</td>
                                <td>
                                    <button ng-click="IdCardPrint($index,x);" class="btn"><i class="fa fa-cloud-download"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="WarningLetterPopUpModel" role="dialog" data-backdrop="static" style='overflow:auto;'>
    <div class="modal-dialog modal-md">
        <div class="modal-content" name="WarningLetterForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-elements form-horizontal">

                <div class="col-xs-12 col-sm-6">
                    <div class="form-group">
                        <div class="radio">
                            <label>
                                <input type="radio" name="IsProrataMonthlyColu" ng-model="WarningLettermodel.WarningConumn" value="firstwarning">
                                <span class="cr"><i class="cr-icon"></i></span>1st Warning
                            </label>
                            <label>
                                <input type="radio" name="IsProrataMonthlyColu" ng-model="WarningLettermodel.WarningConumn" value="secondwarning">
                                <span class="cr"><i class="cr-icon"></i></span>2st Warning
                            </label>
                            <label>
                                false
                                <input type="radio" name="IsProrataMonthlyColu" ng-model="WarningLettermodel.WarningConumn" value="thirdwarning">
                                <span class="cr"><i class="cr-icon"></i></span>3rd Warning
                            </label>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


<ej-dialog id="WarningLetterPopUpModel"
           title="Warning Letter"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target=".site-heading"
           e-close="onDialogClose"
           e-minwidth="70%"
           e-minheight="500" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">

            <div class="col-xs-12 form-element-ctrl form-horizontal">
                <div class="col-xs-12 col-sm-6">
                    <div class="form-group">
                        <div class="radio">
                            <label>
                                <input type="radio" name="IsProrataMonthlyColu" ng-model="WarningLettermodel.WarningColumn" value="firstwarning">
                                <span class="cr"><i class="cr-icon"></i></span>1st Warning
                            </label>
                            <label>
                                <input type="radio" name="IsProrataMonthlyColu" ng-model="WarningLettermodel.WarningColumn" value="secondwarning">
                                <span class="cr"><i class="cr-icon"></i></span>2st Warning
                            </label>
                            <label>
                                false
                                <input type="radio" name="IsProrataMonthlyColu" ng-model="WarningLettermodel.WarningColumn" value="thirdwarning">
                                <span class="cr"><i class="cr-icon"></i></span>3rd Warning
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-4">
                <div class="form-group">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button ng-click="GetWarningLetterReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                        </ul>
                    </div>
                </div>
            </div>

            <confirm-archive-generic modalid="confirmPopUpDetails" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteDetails();"></confirm-archive-generic>
        </div>
    </div>
</ej-dialog>

