<togglable name="Separation Application"></togglable>
<style>
    * {
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
    }

    .inputBtnSection {
        /*display: inline-block;*/
        vertical-align: top;
        font-size: 0;
        font-family: verdana;
    }

    .disableInputField {
        /*display: inline-block;*/
        vertical-align: top;
        height: 27px;
        margin: 0;
        font-size: 14px;
        padding: 0 3px;
    }

    .fileUpload {
        position: relative;
        overflow: hidden;
        /*border: solid 1px gray;*/
        display: inline-block;
        vertical-align: top;
    }

    .uploadBtn {
        display: inline-block;
        vertical-align: top;
        background: #242841;
        font-size: 14px;
        padding: 0 10px;
        height: 25px;
        line-height: 22px;
        color: #fff;
    }

    .fileUpload input.upload {
        position: absolute;
        top: 0;
        right: 0;
        margin: 0;
        padding: 0;
        font-size: 20px;
        cursor: pointer;
        opacity: 0;
        filter: alpha(opacity=0);
    }
</style>
<div class="form-elements form-horizontal" ng-form="ResignationForm">
    <div class="">
        <input type="hidden" ng-model="Resignation.Id">

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style show-message">
                        <select class="form-control" ng-disabled="Resignation.Id.length>0" ng-model="Resignation.PlantId" ng-change=""
                                ng-options="item.Value as item.Text for item in PlantList" id="plantId" name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label"></label>
                <div class="col-sm-8 show-message">
                    <div class="common-btn">
                        <ul class="list-inline text-left" style="margin-left:0px">
                            <li> <button ng-click="showSearch('NewEMP');" class="btn"><i class="glyphicon glyphicon-plus"></i></button></li>
                            <li> <button ng-click="showSearch('PendingEMP');" class="btn"><i class="glyphicon glyphicon-edit"></i></button></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="EmployeeId" ng-show="false" ng-model="Resignation.EmployeeId" class="form-control" readonly required>
                    <input type="text" name="EmployeeName" ng-model="Resignation.EmployeeName" class="form-control" readonly tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Code</label>
                <div class="col-sm-8">
                    <div class="select-style show-message">
                        <input type="text" name="Entity" ng-model="Resignation.EmployeeCode" class="form-control" readonly>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entity</label>
                <div class="col-sm-8">
                    <div class="select-style show-message">
                        <input type="text" name="Entity" ng-model="Resignation.Entity" class="form-control" readonly>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Given Designation</label>
                <div class="col-sm-8">
                    <div class="select-style show-message">
                        <input type="text" name="Entity" ng-model="Resignation.GivenDesignation" class="form-control" readonly>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Designation</label>
                <div class="col-sm-8">
                    <div class="select-style show-message">
                        <input type="text" name="Entity" ng-model="Resignation.Designation" class="form-control" readonly>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Date Of Join</label>
                <div class="col-sm-8">
                    <div class="select-style show-message">
                        <input type="text" name="Entity" ng-model="Resignation.DOJ" class="form-control" readonly>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Date Of Confirmation</label>
                <div class="col-sm-8">
                    <div class="select-style show-message">
                        <input type="text" name="Entity" ng-model="Resignation.DOC" class="form-control" readonly>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-1 control-label">Employee Picture</label>
                <div class="col-sm-4">
                    <div>
                        <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="margin-left: 155px;margin-bottom:35px; height: 150px; width: 150px;" />
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Separation Type<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style show-message">
                        <select class="form-control" ng-disabled="SeparationTypeList.Id.length>0" ng-model="Resignation.SeparationTypeId" ng-change=""
                                ng-options="item.Id as item.UserName for item in SeparationTypeList" id="SeparationTypeId" name="SeparationTypeId" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
                @*<div class="col-sm-8">
                <input ej-dropdownlist e-datasource="SeparationTypeList" e-fields-text="UserName" e-fields-value="Id" e-value="data.SeparationType" e-width="100%" />
            </div>*@
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Separation Submission Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ng-model="Resignation.ResignationDate" datepicker class="form-control datepicker" placeholder="dd-MM-yyyy" tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Applied Effective Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input type="text" ng-model="Resignation.EffectiveDate" datepicker class="form-control datepicker" placeholder="dd-MM-yyyy" tabindex="4">
                </div>
            </div>
            @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Reason<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <textarea ng-model="Resignation.Reason" rows="2" class="form-control" placeholder="Please enter reasons here" maxlength="250" tabindex="5" />
            </div>
        </div>*@

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Reason<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="Resignation.Reason" required name="Reason"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in ResignationTypeList" value="{{option.Text}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>

            @*<div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Reason<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="Resignation.ResignationTypeId" required name="Reason"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in ResignationTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>*@

            <div class="form-group">
                <div class="inputBtnSection common-btn">
                    <label class="fileUpload col-sm-4 ">
                        <input id="uploadBtn" type="file" name="file" class="upload" />
                        <span class="uploadBtn"><i class="fa fa-upload" aria-hidden="true"> Separation Letter</i><sup>*</sup></span>
                    </label>
                    <div class="col-sm-6" style="width: 198px;">
                        <input type="text" class="form-control" style="width: 292px;" value="" id="abc" tabindex="6" readonly />
                    </div>
                    <div class="col-sm-2" style="padding-left:60px;">
                        <button ng-click="AttachRemove();" class="btn" style="height: 31px;width: 88px;padding-left: 8px;background: #242841;"><i class="fa fa-chain-broken" aria-hidden="true"></i> Detach</button>
                    </div>
                </div>

            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right" style="margin-left:10px;margin-right:15px">
                <li> <button ng-click="Save();" class="btn" ng-disabled="Resignation.EmployeeName==null"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button ng-click="loadResignationHistory(Resignation.EmployeeId);" ng-disabled="Resignation.Id==null" class="btn"><i class="glyphicon glyphicon-list"></i> Detail</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>

            </ul>
        </div>
        <div class="modal fade site-modal in" id="ResignationHistoryPopUp" role="dialog" data-backdrop="static">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header"> Separation History<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                    <div class="modal-body">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Separation Date</th>
                                        <th>Applied Effective Date</th>
                                        <th>Approved Effective Date</th>
                                        <th>Approval Starus</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in entityList">
                                        <td align="center">{{x.ResignationDate}}</td>
                                        <td align="center">{{x.EffectiveDate}}</td>
                                        <td align="center">{{x.ApprovedEffectiveDate}}</td>
                                        <td align="center">{{x.ApprovalStatus}}</td>
                                        <td>{{x.Remarks}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
            <div class="modal-dialog modal-sm">
                <div class="modal-content">
                    <div class="modal-header"> My Entity List<button type="button" class="close" data-dismiss="modal">&times;</button></div>
                    <div class="modal-body">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Entity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in entityList">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.EntityName}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div class="GridResignationAppliedEmployee" id="GridResignationAppliedEmployeeList" ej-grid e-datasource="appliedList"
         e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"  e-recorddoubleclick="Get"
         e-allowscrolling="true" e-minheight="400" e-gridlines="none"
         e-actioncomplete="actionCompleteSingleEmployee" e-height="400px"
         e-filtersettings-filterType="excel">
        <div e-columns>
            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
            <div e-column e-field="Entity" e-headertext="Entity" e-width="80"></div>
            <div e-column e-field="ResignationDate" e-headertext="Separation Date" e-width="100"></div>
            <div e-column e-field="EffectiveDate" e-headertext="Effective Date" e-width="100"></div>
            <div e-column e-template="#actiondwonloadUrl" e- e-headertext="Separation Letter" e-width="80"></div>

            <div e-column e-field="DisciplinaryAction" e-headertext="Disciplinary Action" e-width="80"></div>
            <div e-column e-field="CaseNo" e-headertext="Case No" e-width="80"></div>
            <div e-column e-field="Letter" e-headertext="Letter" e-width="80"></div>
        </div>
        <script type="text/template" id="actiondwonloadUrl">
            <a href="{{filePath+data.AttachLetter}}" style="text-decoration:underline" download="{{data.AttachLetter}}" target="_self">{{data.AttachLetter}}</a>
        </script>
    </div>
</div>
<confirm-modal></confirm-modal>
<modal-table modalid="popUpId1"
             data-title="Active Employee Information"
             data-search-parameters="popUpParameters"
             data-exclued-column-list="excluedEmpColumn"
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click="selectSingleClick(data)"
             data-double-click="getSearchObject(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectByButton()"
             data-ng-click-cancel="closePopUp()">
</modal-table>
<modal-table modalid="popUpId2"
             data-title="Pending Employee Information"
             data-search-parameters="popUpParameters"
             data-exclued-column-list="excluedEmpColumn"
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click="selectSingleClick(data)"
             data-double-click="getSearchObject(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectByButton()"
             data-ng-click-cancel="closePopUp2()">
</modal-table>