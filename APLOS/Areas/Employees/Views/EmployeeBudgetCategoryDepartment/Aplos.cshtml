<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Employee Budget Category Department</h3>
<div class="form-elements row">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <div class="col-sm-8">
                <ul class="common-btn list-inline text-left">
                    <li>
                        <button ng-click="getDepartment();" class="btn" tabindex="10"><i class="glyphicon glyphicon-eye-open"></i> Show Department</button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

    </div>
        <div class="col-xs-12">
            <div class="clearfix"><br /></div>
            <div class="table-responsive modal-table" ng-show="departmentList.length>0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Select</th>
                            <th>Code</th>
                            <th>User Name</th>
                            <th>Budget Category</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in departmentList">
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" id="{{x.Id}}" ng-model="x.Flag" ng-checked="x.Flag">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>{{x.Code}}</td>
                            <td>{{x.UserName}}</td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.EmployeeBudgetCategoryId"
                                            ng-options="item.Value as item.Text for item in employeeBudgetCategoryCboList">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="col-xs-12">
                <ul class="common-btn list-inline text-right">
                    <li>
                        <button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button>
                    </li>
                </ul>
            </div>
        </div>


    </div>


<confirm-archive-generic data-modalid="confirmgenericPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="DeleteCostCenterList()">
</confirm-archive-generic>
<confirm-modal></confirm-modal>
