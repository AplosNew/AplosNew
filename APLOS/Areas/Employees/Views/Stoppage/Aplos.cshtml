<togglable name="Stoppage"></togglable>
<div class="form-elements form-horizontal" ng-form name="stoppageNewForm">
    <input type="hidden" ng-model="stoppageNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group">
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="LeaveTypeID" class="form-control" ng-change="getCityList()" ng-model="stoppageNew.CompanyId" name="Company" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in companyList" value="{{option.Id}}">{{option.UserName}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="stoppageNew.Sequence" e-width="100" required />
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" ng-model="stoppageNew.ShortName" class="form-control" maxlength="15" required tabindex="5">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="stoppageNew.UserName" class="form-control" required tabindex="7" maxlength="50">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="stoppageNew.Description" tabindex="9" maxlength="250"></textarea>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">

        <div class="form-group">
            <label class="col-sm-4 control-label">City<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="LeaveTypeID" class="form-control" ng-model="stoppageNew.CityId" name="City" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in cityList" value="{{option.Id}}">{{option.UserName}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="stoppageNew.Code" class="form-control" required tabindex="4" maxlength="10">
            </div>
        </div>

        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="stoppageNew.StandardName" class="form-control" required tabindex="6" maxlength="50">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="stoppageNew.Remarks" maxlength="250" tabindex="8"></textarea>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="stoppageNew.Active">
                        <span class="cr" tabindex="10"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>

    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i></button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="12"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="13"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>

</div>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="recorddoubleclick" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="4"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="4"></div>
            <div e-column e-field="AC" e-headertext="Active" e-width="2"></div>
            <div e-column e-field="City" e-headertext="City" e-width="3"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>