<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Pre Recruitment Department Document Upload
</h3>
<style>
    .filled {
        background-color: #0dbe67 !important;
    }
</style>
<div class="form-elements form-horizontal" ng-form name="preRecruitmentEmployeeForm">
    <input type="hidden" ng-model="preRecruitmentEmployee.Id">
    <p style="text-decoration:underline;cursor:pointer;" ng-show="message==null" ng-click="showEntityPopUp();">My Entity List</p>
    <p class="msg-success" ng-show="message!=null">*{{message}}</p>
</div>
<div class="row text-right">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchDataByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="LoadData()" >
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="LoadData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Candidate Id</th>
                <th>Employee Code</th>
                <th>Name</th>
                <th>Email</th>
                <th>Date of Birth</th>
                <th>Budget Id</th>
                <th>Entity</th>
                <th>Position</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Given Designation</th>
                <th>App Added Date</th>
                <th>Add Document</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="e in preRecruitmentEmployees |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                <td>{{e.Id}}</td>
                <td>{{e.EmployeeCode}}</td>
                <td>{{e.FullName | uppercase}}</td>
                <td>{{e.Email}}</td>
                <td>{{e.DOB | dateFiltering}}</td>
                <td>{{e.BudgetId}}</td>
                <td>{{e.EntityName}}</td>
                <td>{{e.PositionName}}</td>
                <td>{{e.Department}}</td>
                <td>{{e.Designation}}</td>
                <td>{{e.GivenDesignation}}</td>
                <td>{{e.AppAddedDateTime | dateFiltering}}</td>
                <td>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="showDocumentPopUp(e,$index);" class="btn"> Add Document</button></li>
                        </ul>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="LoadData(newPageNumber)"></dir-pagination-controls>
</div>
<div class="modal fade site-modal in" id="DocumentPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" style="width: 75%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" ng-click="closepopUp()">&times;</button>
                <h4 class="modal-title"> Add Document</h4>
            </div>
            <div class="modal-body" style="width: 99%;padding-left: 3%;">
                <div class="row">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Document Name</th>
                                    <th>Emp Type</th>
                                    <th>Employee Category</th>
                                    <th>Optional Or Mandatory</th>
                                    <th>Skill Based</th>
                                    <th>Due Date</th>
                                    <th>File Name</th>
                                    <th>File</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="d in documentdataList">
                                    <td>{{d.DocumentName}}</td>
                                    <td>{{d.EmpType}}</td>
                                    <td>{{d.EmployeeCategory}}</td>
                                    <td>{{d.OptionalOrMandatory}}</td>
                                    <td>{{d.IsSkillBased?'Yes':'No'}}</td>
                                    <td>{{d.DueDate | dateFiltering}}</td>
                                    <td ng-click="DocDownload(d)"><a href="{{dwonloadUrl}}" style="text-decoration:underline" download="{{d.FileName}}" target="_self">{{d.FileName}}</a></td>
                                    <td>
                                        <button ng-click="DocShow(d);" ng-class="getColor(d)" class="btn" ng-disabled="savedisable"><i class="fa fa-paperclip"></i> Document</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header"> My Entity List<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Entity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in entityList">
                                <td>{{x.Code}}</td>
                                <td>{{x.EntityName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="DocPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Add Document</h4>
            </div>
            <div class="modal-body">
                <div class="row form-elements form-horizontal">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Document Name</label>
                            <div class="col-sm-8">
                                <input type="text" name="Document Name" ng-model="documentdata.DocumentName" readonly class="form-control" tabindex="72">
                            </div>
                        </div>
                        <div class="form-group" ng-show="documentdata.DocNumberRequired===true">
                            <label class="col-sm-4 control-label">Document Number</label>
                            <div class="col-sm-8">
                                <input type="text" name="Document Number" ng-model="documentdata.DocNumber" class="form-control" tabindex="72" ng-disabled="documentdata.ProfileType==='NID' || documentdata.ProfileType==='TIN'">
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="inputBtnSection common-btn">
                                <label class="fileUpload col-sm-4 ">
                                    <input id="uploadBtn4" type="file" name="file[]" class="upload" />
                                    <span class="uploadBtn"><i class="fa fa-paperclip" aria-hidden="true"> Attach</i></span>
                                </label>
                                <div class="col-sm-6" style="width: 198px;">
                                    <input type="text" id="uploadFile4" ng-model="documentdata.FileName" name="uploadFile4" class="disableInputField form-control" disabled="disabled" style="width: 183px;" />
                                </div>
                                <div class="col-sm-2" style="padding-left:0px;">
                                    <button ng-click="DocumentRemove(documentdata.Id);" class="btn" ng-disabled="disableBtn();savedisable" style="height: 31px;width: 88px;padding-left: 8px;background: #242841;"><i class="fa fa-chain-broken" aria-hidden="true"></i> Detach</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Emp Type</label>
                            <div class="col-sm-8">
                                <input type="text" name="Emp Type" ng-model="documentdata.EmpType" readonly class="form-control" tabindex="74">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Employee Category</label>
                            <div class="col-sm-8">
                                <input type="text" name="Employee Category" ng-model="documentdata.EmployeeCategory" readonly class="form-control" tabindex="74">
                            </div>
                        </div>
                        <div class="form-group" ng-show="documentdata.DocDateRequired===true">
                            <label class="col-sm-4 control-label">Document Date</label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="documentdata.DocDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="10">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveDocument();" class="btn" ng-disabled="savedisable"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic data-modalid="confirmSubmit" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="SaveDocument()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDocDelete" title="Confirmation" data-ng-click-left-button="confirmCloseDocDelete()" message={{message_confirmation}} data-ng-click-right-button="removeDoc()"></confirm-archive-generic>