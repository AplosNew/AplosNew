<togglable name="Route"></togglable>
<link href="~/Scripts/BootstrapTimePicker/css/bootstrap-timepicker.css" rel="stylesheet" />
<script src="~/Scripts/BootstrapTimePicker/Scripts/bootstrap.js"></script>
<script src="~/Scripts/BootstrapTimePicker/js/bootstrap-timepicker.js"></script>
<div class="form-elements form-horizontal" ng-form="routeNewForm">
    <input type="hidden" ng-model="routeNew.Id">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="general" role="tab" data-toggle="tab">Transport Detail</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="general" role="tab" data-toggle="tab">Route Schedule</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Code" ng-model="routeNew.Code" class="form-control" required tabindex="1001" maxlength="10">
                        </div>
                    </div>

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="routeNew.StandardName" class="form-control" required tabindex="1003" maxlength="50">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Description</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="routeNew.Description" tabindex="1005" maxlength="250"></textarea>
                        </div>
                    </div>
                    
                    <div class="col-sm-12" id="stopageId">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="GetStopageInformation();" class="btn"><i class="glyphicon glyphicon-plus" tabindex="1008"></i>Add Stoppage</button></li>
                            </ul>
                        </div>
                    </div>

                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short Name" ng-model="routeNew.ShortName" class="form-control" required tabindex="1002" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="routeNew.UserName" class="form-control" required tabindex="1004" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="routeNew.Remarks" maxlength="250" tabindex="1006"></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="routeNew.Active">
                                    <span class="cr" tabindex="1007"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row ">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">

                                <thead>
                                    <tr>
                                        @*<th ng-show="StopageListNew.length>1"></th>*@
                                        <th>Sequence</th>
                                        <th>Code</th>
                                        <th>ShortName</th>
                                        <th>StandardName</th>
                                        <th>UserName</th>
                                        <th>Up Distance From(km)</th>
                                        <th>Down Distance From(km)</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <tr ng-repeat="x in StopageListNew">
                                        @*<td ng-show="StopageListNew.length>1">
                                            <span ng-show="!$first" ng-click="moveUp($index,'StopageListNew')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                            <br />
                                            <span ng-show="!$last" ng-click="moveDown($index,'StopageListNew')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                        </td>*@
                                        <td>{{x.Sequence}}</td>
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td>
                                            <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                                                <input n-decimals="2" ng-model="x.UpDistanceFrom" style="color:black;" class="form-control" tabindex="1009"/>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                                                <input n-decimals="2" ng-model="x.DownDistanceFrom" style="color:black;" class="form-control" tabindex="1010"/>
                                            </div>
                                        </td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="DeleteStopage(x)" class="btn-action tooltip-here" data-placement="top" title="Remove" tabindex="1011">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" ng-disabled="selectedStoppageList.length===0"><i class="glyphicon glyphicon-floppy-disk" tabindex="1012"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash" tabindex="1013"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="1014"></i> Clear</button></li>
                    </ul>
                </div>
            </div>

            @*<div class="row">*@
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="form-horizontal form-elements" ng-form="routeNewForm">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border"></legend>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            @*<div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Transport Id<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="Transport Id" ej-numerictextbox e-decimalplaces="0" e-minvalue="1" e-enablertl="false" e-value="ModelChildNew.Id" class="form-control text-right" required tabindex="110">
                                    </div>
                                </div>*@

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Transport User Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="TransportUserName" ng-model="ModelChildNew.TransportUserName" class="form-control text-right" required tabindex="110">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Transport No<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="TransportNo" ng-model="ModelChildNew.TransportNo" class="form-control text-right" required tabindex="112">
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Driver Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                        <input type="text" name="DriverName" ng-model="ModelChildNew.DriverName" class="form-control text-right" required tabindex="114">
                                </div>
                            </div>

                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Transport Category<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="TransportCategory" ng-model="ModelChildNew.TransportCategory" class="form-control text-right" required tabindex="111">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Transport Port<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="TransportPort" ng-model="ModelChildNew.TransportPort" class="form-control text-right" required tabindex="113">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Capacity<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="number" name="Capacity" ng-model="ModelChildNew.Capacity" class="form-control" required tabindex="115">
                                    @*<input type="text" n-decimals="4" name="Capacity" ng-model="ModelChildNew.Capacity" class="form-control text-right" required tabindex="110">*@
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Remarks</label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Remark" ng-model="ModelChildNew.Remarks" class="form-control text-right" required tabindex="116">
                                </div>
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SaveChild();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="117"></i> {{Action}}</button></li>
                                <li> <button ng-click="ClearTransDetails();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="118"></i> Clear</button></li>
                            </ul>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <div class="table-responsive modal-table" ng-show="transportDetailsList.length>0">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Transport Id</th>
                                            <th>Transport User Name</th>
                                            <th>Transport No</th>
                                            <th>Driver Name</th>
                                            <th>Transport Category</th>

                                            <th>Transport Port</th>
                                            <th>Capacity</th>
                                            <th>Remarks</th>
                                            <th>Remove</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in transportDetailsList" ng-click="TransportDetailsdoubleclick(x);" ng-class="{selected : x.Id==null}">
                                            <td>{{x.Id}}</td>
                                            <td>{{x.TransportUserName}}</td>
                                            <td>{{x.TransportNo}}</td>
                                            <td>{{x.DriverName}}</td>
                                            <td>{{x.TransportCategory}}</td>
                                            <td>{{x.TransportPort}}</td>
                                            <td>{{x.Capacity}}</td>
                                            <td>{{x.Remarks}}</td>
                                            <td class="text-right table-td">
                                                <ul class="list-inline action-list">
                                                    <li>
                                                        <button ng-click="removeTransportDetailsRowModal(x.Id)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"  tabindex="119"></i></button>
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </fieldset>

                </div>
            </div>


            <div class="row">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                    <div class="form-horizontal form-elements" ng-form="routeNewForm">
                        <fieldset class="scheduler-border">
                            <legend class="scheduler-border"></legend>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Trip No<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="Trip No" ej-numerictextbox e-decimalplaces="0" e-minvalue="1" e-enablertl="false" e-value="ModelRouteSchedule.TripNo" class="form-control text-right" required tabindex="201">
                                    </div>
                                </div>


                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Start Time<sup>*</sup></label>
                                    <div class="col-sm-7 input-group bootstrap-timepicker timepicker" style="float:right"  tabindex="203">
                                        <input id="StartTime" type="text" class="form-control input-small" ng-change="getDistance();" ng-model="ModelRouteSchedule.StartTime" style="margin-left:-10%; width:94%">
                                        <span class="input-group-addon" style="float:left; width:12%"><i class="glyphicon glyphicon-time"></i></span>
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">From<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="From" ng-model="ModelRouteSchedule.From" class="form-control" required tabindex="205">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Up/Down</label>
                                    <div class="col-sm-8 show-message ">
                                        <div class="select-style">
                                            <select id="UpDown" class="form-control" ng-model="ModelRouteSchedule.UpDown" name="UpDown<" tabindex="207" required>
                                                <option value="Up">Up</option>
                                                <option value="Down">Down</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Distance(km)<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" n-decimals="4" name="Distance" ng-change="getDistance();" ng-model="ModelRouteSchedule.Distance" class="form-control text-right" required tabindex="209">
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Distance Per Unit(km)<sup>*</sup></label>
                                    <div class="col-sm-8 show-message"  tabindex="211">
                                        <input type="text" n-decimals="4" ng-disabled="true" name="Distance Per Unit" ng-model="ModelRouteSchedule.DistancePerUnit" class="form-control text-right" required>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Transport<sup>*</sup></label>
                                    <div class="col-sm-8 show-message"  tabindex="202">
                                        <input id="transportList" ej-dropdownlist e-enablefiltersearch="true" e-create="create" e-multiselectmode="visualmode" e-datasource="transportList" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-showcheckbox="true"/>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">End Time<sup>*</sup></label>
                                    <div class="col-sm-7 input-group bootstrap-timepicker timepicker" style="float:right"  tabindex="204">
                                        <input id="EndTime" type="text" class="form-control input-small" ng-change="getDistance();" ng-model="ModelRouteSchedule.EndTime" style="margin-left:-10%; width:94%">
                                        <span class="input-group-addon" style="float:left; width:12%"><i class="glyphicon glyphicon-time"></i></span>
                                    </div>
                                </div>

                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">To<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="To" ng-model="ModelRouteSchedule.To" class="form-control" required tabindex="206">
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Shift<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="input-group"  tabindex="208">
                                            <input type="text" name="Entity" ng-model="ModelRouteSchedule.Shift" ng-disabled="true" class="form-control" maxlength="200" required readonly>
                                            <span class="input-group-btn">
                                                <button ng-click="selectShift()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Remarks</label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="Remark" ng-model="ModelRouteSchedule.Remarks" class="form-control" required tabindex="210">
                                    </div>
                                </div>
                            </div>
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="SaveRouteSchedule();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="212"></i> {{Action}}</button></li>
                                    <li> <button ng-click="ClearRouteSchedule();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="213"></i> Clear</button></li>
                                </ul>
                            </div>
                            <div class="col-xs-12 col-sm-12 col-md-12">
                                <div class="table-responsive modal-table" ng-show="routeScheduleList.length>0">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Trip No</th>
                                                <th>Transport</th>
                                                <th>Start Time</th>
                                                <th>EndTime</th>
                                                <th>From</th>
                                                <th>To</th>
                                                <th>Up/Down</th>
                                                <th>Distance(km)</th>
                                                <th>Shift</th>
                                                <th>Remarks</th>
                                                <th>Remove</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in routeScheduleList" ng-dblclick="routeScheduledoubleclick(x);" ng-class="{selected : x.Id==null}">
                                                <td>{{x.TripNo}}</td>
                                                <td>{{x.RouteScheduleTransport}}</td>
                                                <td>{{x.StartTime}}</td>
                                                <td>{{x.EndTime}}</td>
                                                <td>{{x.From}}</td>
                                                <td>{{x.To}}</td>
                                                <td>{{x.UpDown}}</td>
                                                <td>{{x.Distance}}</td>
                                                <td>{{x.Shift}}</td>
                                                <td>{{x.Remarks}}</td>
                                                <td class="text-right table-td">
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="removeRouteScheduleRowModal(x.Id)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove" tabindex="214"></i></button>
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </fieldset>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
