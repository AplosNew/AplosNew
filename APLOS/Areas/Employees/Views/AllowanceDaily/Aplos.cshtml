<togglable name="Allowance Daily"></togglable>
<div class="form-elements form-horizontal" ng-form name="bloodGroupNewForm">
    <input type="hidden" ng-model="bloodGroupNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Sequence" ng-model="bloodGroupNew.Sequence" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" ng-model="bloodGroupNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="bloodGroupNew.UserName" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Salary Head<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="SH" ng-model="bloodGroupNew.SalaryHeadId" class="form-control" name="Salary Rule" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="bloodGroupNew.Description" tabindex="7" maxlength="250"></textarea>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="bloodGroupNew.Code" class="form-control" required tabindex="10" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="bloodGroupNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="bloodGroupNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>
        <div class="form-group">

            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="bloodGroupNew.Active" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>



        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Calculation on <sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="bloodGroupNew.CalculationBasics" ng-change="ChangeCalculation()" tabindex="1">
                        <option value="Rate" >Rate</option>
                        <option value="Formula">Formula</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <br />
    <br />
    <div class="col-sx-12">
        <div ng-show="ShowFormulaDiv===true">
            <div class="col-sm-6" ng-show="true">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Catagory <sup>*</sup></label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="bloodGroupNew.Catagory" name="Given Designation" tabindex="1">
                                <option value="HourlyOffDuty">Hourly OffDuty</option>
                                @*<option value="Formula">Formula</option>*@
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6" ng-show="true"></div>
            <div class="col-sm-12" ng-show="true" style="margin-left:-20px;padding-top:20px">


                <fieldset class="scheduler-border" style="width:1076px">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Salary Head</label>
                            <div class="col-sm-6">
                                <div class="select-style">
                                    <select ng-model="salaryRuleGeneral.SalaryHeadIdFormula" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('SHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Operator</label>
                            <div class="col-sm-6">

                                <div class="select-style">
                                    <select ng-model="salaryRuleGeneral.Operator" class="form-control" name="Operator" tabindex="5">
                                        <option value=""></option>
                                        <option value="*">*</option>
                                        <option value="/">/</option>
                                        <option value="+">+</option>
                                        <option value="-">-</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('Operator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Precedence</label>
                            <div class="col-sm-6">
                                <div class="select-style">
                                    <select ng-model="salaryRuleGeneral.Precedence" class="form-control" name="Precedence" tabindex="5">
                                        <option value=""></option>
                                        <option value="(">(</option>
                                        <option value=")">)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('Precedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Value</label>
                            <div class="col-sm-6">
                                <input type="text" name="Value" ng-model="salaryRuleGeneral.Value" class="form-control" required tabindex="2" maxlength="50">
                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('Value');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">

                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="RemoveFormula();" class="btn" tabindex="9"><i class="glyphicon glyphicon-backward"></i></button></li>
                            </ul>
                        </div>
                        <div class="form-group">
                            {{salaryRuleGeneral.FormulaDescription}}
                        </div>
                    </div>
                </fieldset>
            </div>

        </div>
    </div>  
       
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
</div>



    <div class="row text-right aplos-grid-toggle">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table aplos-grid-toggle">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sequence</th>
                    <th>Code</th>
                    <th>Short Name</th>
                    <th>Standard Name</th>
                    <th>User Name</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in bloodGroups |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.Sequence}}</td>
                    <td>{{x.Code}}</td>
                    <td>{{x.ShortName}}</td>
                    <td>{{x.StandardName}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="getData(newPageNumber)">
        </dir-pagination-controls>
    </div>
    <confirm-modal></confirm-modal>
