@*<togglable name="My Job Description" ng-show="isExist"></togglable>*@
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> My Job Description</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>
<div class="form-element form-horizontal">
    <div class="row">
        <div class="col-lg-12">
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Budget Code: {{Code}}</label>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Position: {{Position}}</label>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label">Entity: {{Entity}}</label>
                </div>
            </div>
        </div>
        <div class="col-lg-12">
            <div class="table-responsive modal-table aplos-grid-toggle" ng-show="isExist">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="Grid" ej-grid e-datasource="employeeJobDescriptions" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="SOPCategory" e-headertext="SOP Category" e-width="60"></div>
                            <div e-column e-field="ActivityName" e-headertext="ActivityName" e-width="80"></div>
                            <div e-column e-field="ActivityImportanceId" e-headertext="Activity Importance" e-width="40"></div>
                            <div e-column e-field="AverageTime" e-headertext="Average Time-min" e-width="60"></div>
                            <div e-column e-templateid="#SOPDocument" e-headertext="No. of Activity Document" e-width="20"></div>
                            <div e-column e-templateid="#SOPItemDocument" e-headertext="No. of SOP Document" e-width="40"></div>
                            <div e-column e-field="SOPItem" e-headertext="SOPItem" e-width="80"></div>
                        </div>
                    </div>
                </div>
                <script type="text/template" id="SOPDocument">
                    <a href="" ng-click="$parent.showStat(this,'SOPDocument')"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{data.SOPDocument}}</span></a>
                </script>
                <script type="text/template" id="SOPItemDocument">
                    <a href="" ng-click="$parent.showStat(this,'SOPItemDocument')"><span style="font-weight:bold;text-decoration:underline;color:blue;">{{data.SOPItemDocument}}</span></a>
                </script>
            </div>
        </div>
    </div>
   
</div>
<div class="modal fade site-modal in" id="ACTDOCPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Select File</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Name</th>
                                <th>Data Source Category</th>
                                <th>Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="fl in ActivityDocumentList">
                                <td>{{fl.Code}}</td>
                                <td>{{fl.ShortName}}</td>
                                <td>{{fl.StandardName}}</td>
                                <td>{{fl.UserName}}</td>
                                <td>{{fl.DataSourceCategory}}</td>
                                <td ng-click="FileDownload(fl)"><a href="{{downloadUrl}}" class="btn btn-action tooltip-here" style="text-decoration:underline" download="{{fl.FileName}}" target="_self">{{fl.FileName}}</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="SOPDOCPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Select File</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>File Name</th>
                                <th>File Id</th>
                                <th>Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="s in SOPDocumentList">
                                <td>{{s.Id}}</td>
                                <td>{{s.FileName}}</td>
                                <td>{{s.FileId}}</td>
                                <td ng-click="SOPActivityDocFileDownload(s)"><a href="{{downloadUrl}}" class="btn btn-action tooltip-here" style="text-decoration:underline" download="{{s.FileName}}" target="_self">{{s.FileName}}</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade site-modal in" id="filePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Select File</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>File Name</th>
                                <th>File Id</th>
                                <th>Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="fl in fileList">
                                <td>{{fl.Id}}</td>
                                <td>{{fl.FileName}}</td>
                                <td>{{fl.FileId}}</td>
                                <td ng-click="FileDownload(fl)"><a href="{{downloadUrl}}" class="btn btn-action tooltip-here" style="text-decoration:underline" download="{{fl.FileName}}" target="_self">{{fl.FileName}}</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<toaster-container toaster-options="{ 'position-class': 'toast-center', 'close-button':true, 'animation-class': 'toast-center'}"></toaster-container>

<div class="modal fade site-modal in" id="JDPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header"> Job Description<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="control-label">{{message_confirmation}}</label>
                </div>
            </div>
        </div>
    </div>
</div>