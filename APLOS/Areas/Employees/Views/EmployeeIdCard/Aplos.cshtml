<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> ID Card</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">

    <div class="row">
        <div class="col-xs-12">
            <div class="col-xs-4">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="GetEmployeeInformation();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Load Employee </button></li>
                        <li><button ng-click="showEmployeeFilterScreen()" class="btn" tabindex="10"><i class="glyphicon glyphicon-filter"></i></button></li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-8">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Is Current Issue Date</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label class="control-label">
                                <input type="checkbox" ng-model="IsCurrentIssueDate" ng-checked="IsCurrentIssueDate">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12">
            <div id="Grid" ej-grid
                 e-datasource="EmployeeList"
                 e-recorddoubleclick="Get"
                 e-allowscrolling="true"
                 e-pageSettings-pageSize="8"
                 e-actioncomplete="actionCompleteSelected"
                 e-templaterefresh="refreshTemplateemployee"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-enabletouch="false"
                 e-responsive="true"
                 e-allowselection="true"
                 e-rowdatabound="rowcolor"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="40"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="30"></div>
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Line" e-headertext="Line" e-type="string" e-allowediting="false" e-width="80"></div>
                    <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="50"></div>
                    <div e-column e-field="Sequence" e-headertext="Sequence" e-allowediting="false" e-width="20"></div>
                    <div e-column e-field="EmployeeWorkType" e-headertext="Employee WorkType" e-allowediting="false" e-width="40"></div>
                    <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="IssueDate" e-headertext="Issue Date" e-allowediting="false" e-width="50"></div>
                    <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="ExpiryDate" e-headertext="Expiry Date" e-allowediting="false" e-width="50"></div>
                    <div e-column e-headertext="Actions" e-width="30">
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;" class="btn"><i class="glyphicon glyphicon-list" ng-click="$parent.GetIDCard(this);" style="margin: -8px;"></i></button>
                    </div>
                </div>
            </div>

        </div>
        <div class="clearfix"></div>
        <div class="col-xs-12">
            <div class="col-xs-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Format</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="paraModel.tempId" name="Language" tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in templateList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-6">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="DownLoadIdCard();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="EmpPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> Select Employees<button type="button" class="close" data-dismiss="modal">&times;</button></div>

            <div class="col-xs-12 col-sm-6 col-md-12">
                <div id="GridPopUp" ej-grid
                     ng-init="chkinit()"
                     e-datasource="EmployeePopUpList"
                     e-recorddoubleclick="Get"
                     e-allowscrolling="true"
                     e-pageSettings-pageSize="15"
                     e-actioncomplete="actionCompleteSelected"
                     e-templaterefresh="refreshTemplateemployee"
                     e-allowfiltering="true"
                     e-allowpaging="true"
                     e-enabletouch="false"
                     e-responsive="true"
                     e-allowselection="true"
                     e-rowdatabound="rowcolor"
                     e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="40"></div>
                        <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                        <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="50"></div>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-allowediting="false" e-width="20"></div>
                        <div e-column e-field="EmployeeWorkType" e-headertext="Employee WorkType" e-allowediting="false" e-width="40"></div>
                        <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="IssueDate" e-headertext="Issue Date" e-allowediting="false" e-width="50"></div>
                        <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="ExpiryDate" e-headertext="Expiry Date" e-allowediting="false" e-width="50"></div>
                    </div>

                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" e-value="data.CheckBoxSelect" />
                    </script>

                    <script type="text/x-jsrender" id="headerTemplate">

                        <input type="checkbox" id="headchk" />
                    </script>

                </div>
            </div>

            <ul class="common-btn list-inline text-right" style="padding: 20px;">
                <li><button ng-click="saveemployeedata();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button></li>
                <li><button ng-click="Back();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Back</button></li>
            </ul>

        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="IdCardPopUpModel" role="dialog" data-backdrop="static" style='overflow:auto;'>
    <div class="modal-dialog modal-md">
        <div class="modal-content" name="IdCardForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="number" maxlength="18" disabled name="Sequence" ng-model="model.Sequence" class="form-control" tabindex="1">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Issue Date<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="model.IssueDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label" title="Work Type">Work Type<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="model.EmployeeWorkTypeId" id="Work Type" name="Work Type" tabindex="1">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in workTypeList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Expiry Date</label>
                        <div class="col-sm-8">
                            <input type="text" ng-model="model.ExpiryDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8">
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="SaveIdIssue();" class="btn"> <i class="glyphicon glyphicon-floppy-save"></i> Save</button></li>
                    </ul>
                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table" style="margin: 10px;">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sequence</th>
                                <th>Issue Date</th>
                                <th>Expiry Date</th>
                                <th>Work Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in issueIdCardList" ng-dblclick="GetIssue(x);">
                                <td>{{x.Sequence}}</td>
                                <td>{{x.IssueDate}}</td>
                                <td>{{x.ExpiryDate}}</td>
                                <td>{{x.UserName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
    <div class="bounce3"></div>
</div>

