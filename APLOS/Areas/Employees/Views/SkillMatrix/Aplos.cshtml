		color: #fff;
		padding: 100px;
		font-size: 25px;
	}

	.e-grid .e-headercelldiv {
		font-weight: bold;
		font-size: 10px;
		display: block;
		border: 0 none;
		height: 29px;
		line-height: 29px;
		margin: -7px;
		padding: 0 .7em;
		text-align: left;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-family: "Arial Narrow";
	}

