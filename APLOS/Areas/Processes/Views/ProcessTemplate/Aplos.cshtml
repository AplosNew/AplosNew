<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal">
    <div class="row" ng-form="ProcessManagementForm">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standared Nam" ng-model="ProcessManagementNew.StandardName" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{ProcessManagementNew.ResponsiblePersonId}}</span>
                        <input type="text" name="Responsible Person" ng-model="ProcessManagementNew.ResponsiblePerson" class="form-control" readonly required>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="LoadResponsiblePopupData()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standared Nam" ng-model="ProcessManagementNew.UserName" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <input type="text" name="Remarks" ng-model="ProcessManagementNew.Remarks" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>

            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="22"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="23"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="24"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>
    </div>

    @*---------------------------------------------------------------------------------------------------------------------------------------*@
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Process</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Saved Process</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="doc" role="tab" data-toggle="tab">Process Utility</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row">
                <div id="GridPM" ej-grid e-datasource="ProcessManagementList" e-templaterefresh="refreshTemplateWorkCenter"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-headertext="" e-headertemplateid="#headerTemplatePM" e-template="#checkboxTemplatePM" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="ProcessCode" e-headertext="Process Code" e-width="100"></div>
                        <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                        <div e-column e-field="SubProcess" e-headertext="Sub Process" e-width="100"></div>
                        <div e-column e-field="ProcessGroupCode" e-headertext="Process Group Code" e-width="100"></div>
                        <div e-column e-field="ProcessGroup" e-headertext="Process Group" e-width="100"></div>
                    </div>
                </div>
                <script type="text/template" id="checkboxTemplatePM">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplatePM">
                    <input type="checkbox" id="Wheadchk" />
                </script>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveProcess()" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="row">
                <div id="GridMaterial" ej-grid e-datasource="PMMaterialList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-headertext="All" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>
                        <div e-column e-field="SubProcess" e-headertext="Sub Process" e-width="100"></div>
                        <div e-column e-headertext="Process Parameter" e-template="#headerTemplateParameter" e-width="100"></div>
                        <div e-column e-headertext="Process Material" e-template="#TemplateMaterial" e-width="100"></div>
                        <div e-column e-headertext="Process Utility" e-template="#headerTemplateUtility" e-width="100"></div>

                    </div>
                </div>
                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplate">
                    <input type="checkbox" id="Materialheadchk" />
                </script>

                <script type="text/template" id="headerTemplateParameter">
                    <button ng-click="$parent.OpenProcessParamPopUp()" class="btn"><i class="glyphicon glyphicon-search" ng-click="$parent.OpenProcessParamPopUp()"></i></button>
                </script>

                <script type="text/template" id="TemplateMaterial">
                    <button ng-click="$parent.OpenProcessMaterialPopUp()" class="btn"><i class="glyphicon glyphicon-search" ng-click="$parent.OpenProcessMaterialPopUp()"></i></button>
                </script>

                <script type="text/template" id="headerTemplateUtility">
                    <button ng-click="$parent.OpenProcessUtilityPopUp()" class="btn"><i class="glyphicon glyphicon-search" ng-click="$parent.OpenProcessUtilityPopUp()"></i></button>
                </script>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                </ul>
            </div>
        </div>

        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
            <div class="row">
                <div id="GridUtility" ej-grid e-datasource="PMUtilityList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        @*<div e-column e-headertext="All" e-headertemplateid="#headerTemplateUtility" e-template="#checkboxTemplateUtility" e-textalign="center" e-width="30"></div>*@
                        <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                        <div e-column e-field="UtilityName" e-headertext="Utility User Name" e-width="100"></div>
                        <div e-column e-field="UtilityStdName" e-headertext="Utility Standard Name" e-width="100"></div>
                        <div e-column e-field="UtilityCategory" e-headertext="Utility Category" e-width="100"></div>
                        <div e-column e-field="UtilitySubCategory" e-headertext="Utility Sub Category" e-width="100"></div>
                        <div e-column e-field="Min" e-headertext="Min" e-width="100"></div>
                        <div e-column e-field="Max" e-headertext="Max" e-width="100"></div>
                        <div e-column e-field="UOM" e-headertext="UOM" e-width="100"></div>
                        
                    </div>
                </div>
                @*<script type="text/template" id="checkboxTemplateUtility">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplateUtility">
                    <input type="checkbox" id="Materialheadchk" />
                </script>*@
               
               
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                </ul>
            </div>
        </div>

    </div>
    @*---------------------------------------------------------------------------------------------------------------------------------------*@

</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit1" ej-grid e-datasource="ModelData" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false" e-isprimarykey="true"></div>
            <div e-column e-field="UserName" e-headertext="UserName" e-width="2"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="ResponsiblePerson" e-headertext="Responsible Person" e-width="5"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="5"></div>
            
        </div>
    </div>
</div>


@*Employee Popup*@
<div class="modal fade site-modal in" id="employeePopUps" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div id="GridRespPerson" ej-grid e-datasource="ResponsiblePersonList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true" e-recorddoubleclick="EmployeedblClick"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="Id" e-width="50" e-visible="false"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Emp Code" e-width="100"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Name" e-width="100"></div>

                            <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                            <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="100"></div>
                        </div>
                    </div>

                </div>
            </div>
            @*<div class="modal-footer common-btn">
                    <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
                </div>*@
        </div>
    </div>
</div>

