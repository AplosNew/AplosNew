<confirm-archive-generic modalid="confirmDeleteQualityPopUp" title="Confirmation" message={{message_Qualityconfirmation}} data-ng-click-right-button="DeleteQuality();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeleteQualityParaPopUp" title="Confirmation" message={{message_QualityParaconfirmation}} data-ng-click-right-button="DeleteQualityPara();"></confirm-archive-generic>