<togglable name="Production Booking Process Parameter"></togglable>
<div class="form-elements form-horizontal" ng-form="mainForm">
    <div class="row">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">Production Booking Process Parameter</legend>
            <div class="form-horizontal form-elements" ng-form="modelNewForm">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Process" ng-model="ModelNew.ProcessId" class="col-sm-3 form-control"
                                        id="processId" ng-options="item.Value as item.Text for item in processList" required tabindex="1">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Input Item Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Input Item Name" ng-model="ModelNew.InputItemName" class="form-control" required tabindex="3" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Output Item Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Output Item Name" ng-model="ModelNew.OutputItemName" class="form-control" required tabindex="5" maxlength="50">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors id="div_Ratio">
                        <label class="col-sm-4 control-label">Input/OutPut Ratio<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Input/OutPut Ratio" ng-model="ModelNew.InPutOutPutRatio" class="form-control" required tabindex="3" n-decimals="2">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Input Item UOM<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Input Item UOM" class="form-control" ng-model="ModelNew.InputItemUoMId" ng-options="item.Value as item.Text for item in uOMinList" required tabindex="4">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Output Item UOM<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="Output Item UOM" class="form-control" ng-model="ModelNew.OutputItemUoMId" ng-options="item.Value as item.Text for item in uOMoutList" required tabindex="6">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li><button ng-click="MainClear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </fieldset>
        <div class="tab-design">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Production Parameter</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Service" role="tab" data-toggle="tab">Quality Parameter</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form="tabForm1" id="Production">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Production Booking Parameter</legend>
                        <div class="form-horizontal form-elements">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="number" name="Sequence" ng-model="ModelProcessPara.Sequence" class="form-control" required tabindex="1">
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Sandard Name<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="Sandard Name" ng-model="ModelProcessPara.SandardName" class="form-control" required tabindex="3" maxlength="50">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label"></label>
                                    <div class="col-sm-8">
                                        <div class="radio">
                                            <label>
                                                <input type="radio" name="Assign" ng-model="ModelProcessPara.EntryState" value="Entry" ng-change="setCheckedEntry('Entry')">
                                                <span class="cr"><i class="cr-icon"></i></span>Entry
                                            </label>
                                            <label>
                                                <input type="radio" name="Assign" ng-model="ModelProcessPara.EntryState" value="Calculate">
                                                <span class="cr"><i class="cr-icon"></i></span>Calculate
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" ng-show="ModelProcessPara.EntryState=='Entry'">
                                    <label class="col-sm-4 control-label"></label>
                                    <div class="col-sm-4">
                                        <div class="checkbox-site radio">
                                            <label>
                                                <input type="checkbox" ng-model="ModelProcessPara.ValueinPercentage" ng-change="setCheckedValue('ValueinPercentage')">
                                                <span class="cr"><i class="cr-icon"></i></span>
                                            </label>
                                            <label class="control-label">Percentage</label>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="checkbox-site radio">
                                            <label>
                                                <input type="checkbox" ng-model="ModelProcessPara.ValueinDecimal" ng-change="setCheckedValue('ValueinDecimal')">
                                                <span class="cr"><i class="cr-icon"></i></span>
                                            </label>
                                            <label class="control-label">Decimal</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" ng-show="ModelProcessPara.EntryState=='Entry'">
                                    <label class="col-sm-4 control-label">Default Value</label>
                                    <div class="col-sm-8">
                                        <input type="text" name="Fixed Value" n-decimals="2" ng-model="ModelProcessPara.DefaultValue" class="form-control">
                                    </div>
                                </div>

                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="User Name" ng-model="ModelProcessPara.UserName" class="form-control" required tabindex="2" maxlength="50">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Active</label>
                                    <div class="col-sm-2">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="ModelProcessPara.Active" tabindex="8">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                    <label class="col-sm-4 control-label">IsProduction</label>
                                    <div class="col-sm-2">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="ModelProcessPara.IsProduction" tabindex="8">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">IsVisible</label>
                                    <div class="col-sm-2">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="ModelProcessPara.IsVisible" tabindex="8">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                    <label class="col-sm-4 control-label">IsPreviousValueApplicable</label>
                                    <div class="col-sm-2">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="ModelProcessPara.IsPreviousValueApplicable" tabindex="8">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="col-sm-12" ng-show="ModelProcessPara.EntryState=='Calculate'">
                                <fieldset class="scheduler-border" style="width:1076px">
                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Head</label>
                                            <div class="col-sm-6">
                                                <div class="select-style">
                                                    <select ng-model="ModelProcessPara.HeadIdFormula" id="HeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in OrderLineCostingItemList">
                                                        <option value=""></option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="common-btn">
                                                    <ul class="list-inline text-left">
                                                        <li>
                                                            <button ng-click="SetFormula('SHead');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Value</label>
                                            <div class="col-sm-6">
                                                <input type="text" name="Value" ng-model="ModelProcessPara.Value" class="form-control" maxlength="50">
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="common-btn">
                                                    <ul class="list-inline text-left">
                                                        <li>
                                                            <button ng-click="SetFormula('Value');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Operator</label>
                                            <div class="col-sm-6">
                                                <div class="select-style">
                                                    <select ng-model="ModelProcessPara.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList">
                                                        <option value=""></option>
                                                    </select>
                                                </div>

                                            </div>
                                            <div class="col-sm-2">
                                                <div class="common-btn">
                                                    <ul class="list-inline text-left">
                                                        <li>
                                                            <button ng-click="SetFormula('Operator');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Precedence</label>
                                            <div class="col-sm-6">
                                                <div class="select-style">
                                                    <select ng-model="ModelProcessPara.Precedence" class="form-control" name="Precedence">
                                                        <option value=""></option>
                                                        <option value="(">(</option>
                                                        <option value=")">)</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="common-btn">
                                                    <ul class="list-inline text-left">
                                                        <li>
                                                            <button ng-click="SetFormula('Precedence');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="col-xs-12 col-sm-6 col-md-6">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li>
                                                    <button ng-click="RemoveFormula();" class="btn"><i class="glyphicon glyphicon-backward"></i></button>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="form-group">
                                            {{ModelProcessPara.FormulaDescription}}
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                            <div class="clearfix"></div>
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li><button ng-click="SaveProcessParameter();" ng-disabled="masterId==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{ProductionAction}}</button></li>
                                    <li><button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                </ul>
                            </div>
                            <div id="GridChild" ej-grid e-datasource="ProcessParameterList" e-recorddoubleclick="GetProcessPara"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                                <div e-columns>
                                    <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                                    <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                                    <div e-column e-field="SandardName" e-headertext="Standard Name" e-width="5"></div>
                                    <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
                                    <div e-column e-field="Formula" e-headertext="Formula" e-width="5"></div>
                                    <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
                                    <div e-column e-headertext="Actions" e-template="#ProParaAction" e-width="3"></div>
                                </div>
                            </div>
                            <script type="text/template" id="ProParaAction">
                                <button style="color: #f3f3ec;background-color: #1c1f32;" title="Process Parameter" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removePrductionPara(this);" style="margin: -6px;"></i></button>
                            </script>
                        </div>
                    </fieldset>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form="tabForm2" id="Quality">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Quality Parameter</legend>
                        <div class="form-horizontal form-elements">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select name="Process" ng-model="ModelQualityNew.ProcessId" class="col-sm-3 form-control"
                                                    id="processId" ng-options="item.Value as item.Text for item in qprocessList" required tabindex="1">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Item Name<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" name="Item Name" ng-model="ModelQualityNew.ItemName" class="form-control" required tabindex="5" maxlength="100">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Active</label>
                                    <div class="col-sm-8">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="ModelQualityNew.Active" tabindex="8">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li><button ng-click="SaveQuality();" ng-disabled="masterId==null" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{QualityAction}}</button></li>
                                    <li><button ng-click="ClearQuality();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                </ul>
                            </div>
                            <div id="GridQuality" ej-grid e-datasource="QualityProcessList" e-recorddoubleclick="GetQualityPro"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                                <div e-columns>
                                    <div e-column e-field="Process" e-headertext="Process" e-width="5"></div>
                                    <div e-column e-field="ItemName" e-headertext="Item Name" e-width="2"></div>
                                    <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
                                    <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="3"></div>
                                </div>
                            </div>
                            <script type="text/template" id="ShowActionButtons">
                                <button style="color: #f3f3ec;background-color: #1c1f32;" title="Quality Process Parameter" class="btn"><i class="glyphicon glyphicon-list" ng-click="$parent.GetQualityProcessParameterPopUp(this);" style="margin: -6px;"></i></button>
                                <button style="color: #f3f3ec;background-color: #1c1f32;" title="Quality Parameter Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeQuality(this);" style="margin: -6px;"></i></button>
                            </script>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div id="GridMain" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Process" e-headertext="Process" e-width="5"></div>
            <div e-column e-field="InputItemName" e-headertext="InputItemName" e-width="5"></div>
            <div e-column e-field="InputItemUoM" e-headertext="InputItemUoM" e-width="5"></div>
            <div e-column e-field="OutputItemName" e-headertext="OutputItemName" e-width="5"></div>
            <div e-column e-field="OutputItemUoM" e-headertext="OutputItemUoM" e-width="5"></div>
            <div e-column e-field="InPutOutPutRatio" e-headertext="InPutOutPutRatio" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>

<!-- #region QualityProcesspopup -->
<div class="modal fade site-modal in" id="QualityProcesspopup" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Quality Process Parameter
                <button type="button" class="close" data-dismiss="modal">&times;</button><br />
                {{JobWorkType}}
            </div>
            <div class="modal-body form-elements form-horizontal">
                <div ng-form="soForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="number" name="Sequence" ng-model="ModelQualityParaNew.Sequence" class="form-control" required tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Sandard Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Sandard Name" ng-model="ModelQualityParaNew.SandardName" class="form-control" required tabindex="3" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Grade<sup>*</sup></label>
                            <div class="col-sm-8 show-message" style="padding-right:-1px;">
                                <div class="select-style">
                                    <select class="form-control" ng-model="ModelQualityParaNew.ParameterGrade" placeholder="Grade" name="ProductionGrade" ng-options="item.Value as item.Text for item in gradeList" required>
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"></label>
                            <div class="col-sm-8">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="Assign" ng-model="ModelQualityParaNew.EntryState" value="Entry">
                                        <span class="cr"><i class="cr-icon"></i></span>Entry
                                    </label>
                                    <label>
                                        <input type="radio" name="Assign" ng-model="ModelQualityParaNew.EntryState" value="Calculate">
                                        <span class="cr"><i class="cr-icon"></i></span>Calculate
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="ModelQualityParaNew.EntryState=='Entry'">
                            <label class="col-sm-4 control-label"></label>
                            <div class="col-sm-4">
                                <div class="checkbox-site radio">
                                    <label>
                                        <input type="checkbox" ng-model="ModelQualityParaNew.ValueinPercentage" ng-change="setCheckedValue('ValueinPercentage')">
                                        <span class="cr"><i class="cr-icon"></i></span>
                                    </label>
                                    <label class="control-label">Percentage</label>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="checkbox-site radio">
                                    <label>
                                        <input type="checkbox" ng-model="ModelQualityParaNew.ValueinDecimal" ng-change="setCheckedValue('ValueinDecimal')">
                                        <span class="cr"><i class="cr-icon"></i></span>
                                    </label>
                                    <label class="control-label">Decimal</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" ng-show="ModelQualityParaNew.EntryState=='Entry'">
                            <label class="col-sm-4 control-label">Default Value</label>
                            <div class="col-sm-8">
                                <input type="text" name="Fixed Value" n-decimals="2" ng-model="ModelQualityParaNew.DefaultValue" class="form-control">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="User Name" ng-model="ModelQualityParaNew.UserName" class="form-control" required tabindex="2" maxlength="50">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="ModelQualityParaNew.Active" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Grade Lot No<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Grade Lot No" ng-model="ModelQualityParaNew.GradeLot" class="form-control" tabindex="5" maxlength="20">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Is Critical</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="ModelQualityParaNew.IsCritical" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">IsVisible</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="ModelQualityParaNew.IsVisible" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12" ng-show="ModelQualityParaNew.EntryState=='Calculate'">
                        <fieldset class="scheduler-border" style="width:1076px">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Head</label>
                                    <div class="col-sm-6">
                                        <div class="select-style">
                                            <select ng-model="ModelQualityParaNew.HeadIdFormula" id="QHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in QualityProcessParameterHeaderList">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li>
                                                    <button ng-click="SetQualityParaFormula('SHead');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Value</label>
                                    <div class="col-sm-6">
                                        <input type="text" name="Value" ng-model="ModelQualityParaNew.Value" class="form-control" maxlength="50">
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li>
                                                    <button ng-click="SetQualityParaFormula('Value');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Operator</label>
                                    <div class="col-sm-6">
                                        <div class="select-style">
                                            <select ng-model="ModelQualityParaNew.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList">
                                                <option value=""></option>
                                            </select>
                                        </div>

                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li>
                                                    <button ng-click="SetQualityParaFormula('Operator');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Precedence</label>
                                    <div class="col-sm-6">
                                        <div class="select-style">
                                            <select ng-model="ModelQualityParaNew.Precedence" class="form-control" name="Precedence">
                                                <option value=""></option>
                                                <option value="(">(</option>
                                                <option value=")">)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-2">
                                        <div class="common-btn">
                                            <ul class="list-inline text-left">
                                                <li>
                                                    <button ng-click="SetQualityParaFormula('Precedence');" class="btn"><i class="glyphicon glyphicon-forward"></i></button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li>
                                            <button ng-click="RemoveQualityParaFormula();" class="btn"><i class="glyphicon glyphicon-backward"></i></button>
                                        </li>
                                    </ul>
                                </div>
                                <div class="form-group">
                                    {{ModelQualityParaNew.FormulaDescription}}
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="clearfix"></div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="SaveQualityProcess();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{QualityParameterAction}}</button></li>
                            <li><button ng-click="ClearQualityProcessPara();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div id="GridQualityPara" ej-grid e-datasource="QualityParameterList" e-recorddoubleclick="GetQualityPara"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                            <div e-column e-field="SandardName" e-headertext="Standard Name" e-width="5"></div>
                            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
                            <div e-column e-field="GradeLot" e-headertext="Grade Lot No" e-width="5"></div>
                            <div e-column e-field="ParameterGrade" e-headertext="Grade" e-width="5"></div>
                            <div e-column e-field="Formula" e-headertext="Formula" e-width="5"></div>
                            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
                            <div e-column e-headertext="Actions" e-template="#ShowQPActionButtons" e-width="3"></div>
                        </div>
                    </div>
                    <script type="text/template" id="ShowQPActionButtons">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Quality Parameter Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.removeQualityPara(this);" style="margin: -6px;"></i></button>
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion SO-->

