<togglable name="Process"></togglable>
<div class="form-elements form-horizontal" ng-form="processNewForm">
	<input type="hidden" ng-model="processNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" n-decimals="2" name="Sequence" ng-model="processNew.Sequence" class="form-control text-right" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" ng-model="processNew.ShortName" name="Short Name" maxlength="15" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" maxlength="50" ng-model="processNew.UserName" class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Process Group<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" id="ProcessGroupId" name="Process Group" ng-model="processNew.ProcessGroupId" ng-options="item.Value as item.Text for item in processGroupList" required tabindex="7">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Production Process</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="processNew.IsProductionProcess">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Checked</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="processNew.IsChecked">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Is First</label>
            <div class="col-sm-1">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="processNew.IsFirst" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-2 control-label">Is Last</label>
            <div class="col-sm-5">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="processNew.IsLast" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="processNew.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" maxlength="10" ng-model="processNew.Code" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" maxlength="50" ng-model="processNew.StandardName" class="form-control" required tabindex="4">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Material Type(SFG)</label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="processNew.MaterialTypeId" ng-options="item.Value as item.Text for item in materialTypeList" tabindex="6">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">PO Control Milestone Sequence</label>
            <div class="col-sm-8">
                <input type="number" name="POControlMilestoneSequence" maxlength="10" ng-model="processNew.POControlMilestoneSequence" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="1" ng-model="processNew.Remarks" name="Remarks" maxlength="250" tabindex="8" ng-trim="false"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Process Routing</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="processNew.IsProcessRouting">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Locked</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-click="checkProcessRouting($event);" ng-model="processNew.IsLocked">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Value Added</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="processNew.IsValueAdded">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Is Cross Allowed</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="processNew.IsCrossAllowed" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>

        </div>
    </div>
	<div class="common-btn">
		<ul class="list-inline text-right">
			<li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
			<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
			<li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
		</ul>
	</div>
</div>
<div class="row text-right aplos-grid-toggle">
	<div class="col-xs-12 col-sm-12 col-sm-12">
		<div class="search-form">
			<div class="row">
				<div class="col-xs-12 col-sm-3 col-md-3">
					<div class="select-style">
						<select ng-model="$root.parameters.searchBy">
							<option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
						</select>
					</div>
				</div>
				<div class="col-xs-12 col-sm-7 col-md-7">
					<input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
				</div>
				<div class="col-xs-12 col-sm-2 col-md-2">
					<button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
	<table class="table table-striped">
		<thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Process Group</th>
                <th>Production Process</th>
                <th>Process Routing</th>
                <th>Locked</th>
                <th>Checked</th>
                <th>IsFirst</th>
                <th>IsLast</th>
                <th>Is Cross Allowed</th>
                <th>Active</th>
            </tr>
		</thead>
		<tbody>
            <tr dir-paginate="x in processes|itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get($index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.ProcessGroupName}}</td>
                <td>{{x.IsProductionProcess?'Yes':'No'}}</td>
                <td>{{x.IsProcessRouting?'Yes':'No'}}</td>
                <td>{{x.IsLocked?'Yes':'No'}}</td>
                <td>{{x.IsChecked?'Yes':'No'}}</td>
                <td>{{x.IsFirst?'Yes':'No'}}</td>
                <td>{{x.IsLast?'Yes':'No'}}</td>
                <td>{{x.IsCrossAllowed?'Yes':'No'}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
		</tbody>
	</table>
	<dir-pagination-controls max-size="10"
							 direction-links="true"
							 boundary-links="true"
							 on-page-change="getData(newPageNumber)">
	</dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>