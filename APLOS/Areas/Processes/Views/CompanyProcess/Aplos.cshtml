<style>
	.selected {
		background-color: rgba(234, 97, 83, 0.42) !important;
	}
</style>
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Company Process</h3>
<div class="row form-elements form-horizontal">
	<input type="hidden" ng-model="companyProcess.Id">
	<div class="col-xs-12 col-sm-12 col-md-12">
		<div class="form-group">
			<label class="col-sm-2 control-label">Company<sup>*</sup></label>
			<div class="col-sm-4">
				<div class="select-style">
					<select class="form-control" ng-model="companyProcess.CompanyId" id="companyId"
							ng-change="getData();" ng-options="item.Value as item.Text for item in companyList">
						<option value=""></option>
					</select>
				</div>
			</div>
		</div>
	</div>
	<div class="clearfix"></div>
	<div class="col-xs-12 col-sm-6 col-md-6">
		<ul class="common-btn list-inline text-left">
			<li><button ng-click="processPopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Add Process</button></li>
		</ul>
	</div>
	<div class="col-xs-12 col-sm-6 col-md-6">
		<ul class="common-btn list-inline text-right">
			<li><button ng-click="Save();" class="btn" tabindex="10"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
		</ul>
	</div>
</div>
<div class="table-responsive modal-table" ng-show="companyProcessList.length>0">
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Code</th>
				<th>Process Name</th>
				<th>Short Name</th>
				<th>Standard Name</th>
                <th>Is Production Process</th>
				<th>Remove</th>
			</tr>
		</thead>
		<tbody>
			<tr ng-repeat="x in companyProcessList" ng-class="{selected : x.class=='new'}">
				<td>{{x.Code}}</td>
				<td>{{x.ProcessName}}</td>
				<td>{{x.ShortName}}</td>
				<td>{{x.StandardName}}</td>
                <td>{{x.IsProductionProcess?'Yes':'No'}}</td>
				<td class="text-right table-td">
					<ul class="list-inline action-list">
						<li>
							<button ng-click="removeRowModal(x.ProcessName, $index,'companyProcessList', 'Id', 'ProcessId');" class="btn-action tooltip-here" data-placement="top" title="Remove">
								<i class="glyphicon glyphicon-remove"></i>
							</button>
						</li>
					</ul>
				</td>
			</tr>
		</tbody>
	</table>
</div>
<div class="modal fade site-modal in" id="processPopUp" role="dialog" data-backdrop="static">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" ng-click="CloseProcessPopUp()">&times;</button>
				<h4 class="modal-title"><i class="glyphicon glyphicon-info-sign"></i> Process</h4>
			</div>
			<div class="modal-body">
				<div class="row text-right">
					<div class="col-xs-12 col-sm-12 col-sm-12">
						<div class="search-form">
							<div class="row">
								<div class="col-xs-12 col-sm-3 col-md-3">
									<div class="select-style">
										<select ng-model="popUpParameters.searchBy">
											<option ng-repeat="option in searchProcessByList" value="{{option.value}}">{{option.name}}</option>
										</select>
									</div>
								</div>
								<div class="col-xs-12 col-sm-7 col-md-7">
									<input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getCompanyProcessData()">
								</div>
								<div class="col-xs-12 col-sm-2 col-md-2">
									<button type="button" ng-click="getCompanyProcessData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="table-responsive modal-table">
					<table class="table table-striped">
						<thead>
							<tr>
								<th>Select</th>
								<th>Code</th>
								<th>Short Name</th>
								<th>Standard Name</th>
								<th>User Name</th>
								<th>Active</th>
							</tr>
						</thead>
						<tbody>
							<tr dir-paginate="x in processes|itemsPerPage:popUpParameters.pageSize"
								total-items="popUpParameters.total_count" pagination-id="metaData.name + 'processes'">
								<td>
									<div class="checkbox-site">
										<label>
											<input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="genericPushInTempList(x,$event,companyProcessList, 'Id', 'ProcessId');">
											<span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
										</label>
									</div>
								</td>
								<td>{{x.Code}}</td>
								<td>{{x.ShortName}}</td>
								<td>{{x.StandardName}}</td>
								<td>{{x.UserName}}</td>
								<td>{{x.Active?'Yes':'No'}}</td>
							</tr>
						</tbody>
					</table>
					<dir-pagination-controls max-size="10"
											 pagination-id="metaData.name + 'processes'"
											 direction-links="true"
											 boundary-links="true"
											 on-page-change="getCompanyProcessData(newPageNumber)">
					</dir-pagination-controls>
				</div>
				<div class="common-btn">
					<ul class="list-inline text-right">
						<li> <button ng-click="addProcess()" class="btn">Select</button></li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-modal></confirm-modal>