<togglable name="Process Set"></togglable>
<div class="form-horizontal" ng-form name="processSetNewForm">
    <input type="hidden" ng-model="processSetNew.Id">
    <div class="col-xs-12">
        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Company" ng-model="processSetNew.CompanyId" class="col-sm-3 form-control" ng-change="getPlant();"
                                ng-options="item.Value as item.Text for item in companyList" required tabindex="1">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="PlantId" class="form-control" ng-model="processSetNew.PlantId" name="Plant" ng-change="getEntity();" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Entity" ng-model="processSetNew.EntityId" class="col-sm-3 form-control" ng-change="getEntityMapData();getData();"
                                ng-options="item.Id as item.UserName for item in entityList" required tabindex="2">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="row" style="border:1px solid">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" ng-repeat="x in entities" ng-if="$index % 2 == 0">
                    <label class="col-sm-4 control-label">{{x.Text}}</label>
                    <div class="col-sm-8" ng-repeat="y in entityValue">
                        <label class="col-sm-8 control-label"><b>{{y[x.Value]}}</b></label>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" ng-repeat="x in entities" ng-if="$index % 2 != 0">
                    <label class="col-sm-4 control-label">{{x.Text}}</label>
                    <div class="col-sm-8" ng-repeat="y in entityValue">
                        <label class="col-sm-8 control-label"><b>{{y[x.Value]}}</b></label>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="addprocess" role="tab" data-toggle="tab">Add Process</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row">
                        <div class="col-xs-6 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Process Category<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Process category" ng-model="processSetNew.ProcessCategoryId" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in processCategoryList" required tabindex="3">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Code" maxlength="10" ng-model="processSetNew.Code" class="form-control" required tabindex="5">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Required Time Unit<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Required time unit" ng-model="processSetNew.RequiredTimeUnit" class="col-sm-3 form-control" ng-disabled="processSetDetails.length>0"
                                                ng-options="item.Value as item.Text for item in requiredTimeUnitList" required tabindex="7">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Process Criteria<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Process criteria" ng-model="processSetNew.ProcessCriteriaId" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in processCriteriaList" required tabindex="4">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="processSetNew.Description" name="Remarks" maxlength="250" tabindex="6"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <ul class="common-btn list-inline text-left">
                            <li><button ng-click="processSetDetailPopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Production Process</button></li>
                        </ul>
                    </div>
                    <div class="clearfix"></div>
                    <div class="table-responsive modal-table" ng-show="processSetDetails.length>0">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th ng-show="processSetDetails.length>1">Sort</th>
                                    <th>Process</th>
                                    <th style="width: 74px;">Base Process</th>
                                    <th>+/-</th>
                                    <th style="width: 130px;">Lead/Lag {{processSetNew.RequiredTimeUnit}}</th>
                                    <th style="width: 130px;">Production Cycle Time({{processSetNew.RequiredTimeUnit}})</th>
                                    <th style="width: 10px">Job Work Applicable</th>
                                    <th style="width:170px;">Job Work Type</th>
                                    <th>Entity/Vendor</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in processSetDetails" ng-class="{selected : x.class=='new'}">
                                    <td ng-show="processSetDetails.length>1">
                                        <span ng-show="!$first" ng-click="moveUp($index)"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                        <br />
                                        <span ng-show="!$last" ng-click="moveDown($index)"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                    </td>
                                    <td>{{x.ProcessName}}</td>
                                    <td class="text-center">
                                        <div class="radio">
                                            <label>
                                                <input type="radio" name="optradio" ng-checked="x.IsBaseProcess" ng-click="setPlusOrMinus($event,$index)" value="" />
                                                <span class="cr"><i class="cr-icon"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>{{x.Symbol}}</td>
                                    <td><input type="text" ng-model="x.Days" class="form-control" only-numbers ng-disabled="x.IsBaseProcess"></td>
                                    <td><input type="text" ng-model="x.ProductionCycleTime" class="form-control" only-numbers></td>
                                    <td class="text-center">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="x.JobWorkApplicable" ng-checked="x.JobWorkApplicable" ng-click="clearJobType(processSetDetails,x.Id);clearEntityOrVendor(processSetDetails,x.Id);" />
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="select-style">
                                            <select class="form-control" ng-model="x.JobWorkType" ng-disabled="!x.JobWorkApplicable" ng-change="clearEntityOrVendor(processSetDetails,x.Id);"
                                                    ng-options="item.Value as item.Text for item in jobWorkTypeList">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="hidden" ng-model="x.EntityIdWithinCompany">
                                        <input type="hidden" ng-model="x.EntityIdWithinGroup">
                                        <input type="hidden" ng-model="x.VendorId">
                                        <div class="col-sm-8 pdl3 pdr3">
                                            <input type="text" ng-model="x.EntityOrVendorName" class="form-control" disabled>
                                        </div>
                                        <button style="height: 27px; margin-top: 2px; margin-left: 0px" class="btn" ng-click="popUp(x.Id)" ng-disabled="!x.JobWorkApplicable"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                        <button style="height: 27px; margin-top: 2px; margin-left: 0px" class="btn" ng-click="clearEntityOrVendor(processSetDetails,x.Id);" ng-disabled="!x.JobWorkApplicable"><i class="cr-icon glyphicon glyphicon-remove"></i></button>
                                    </td>

                                    <td class="text-right table-td">
                                        <ul class="list-inline action-list">
                                            <li>
                                                <button ng-click="valuePassInDelModal(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                    <i class="glyphicon glyphicon-remove"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
	<div class="col-xs-12 col-sm-12 col-sm-12">
		<div class="search-form">
			<div class="row">
				<div class="col-xs-12 col-sm-3 col-md-3">
					<div class="select-style">
						<select ng-model="$root.parameters.searchBy">
							<option ng-repeat="option in searchFromProcessSetList" value="{{option.value}}">{{option.name}}</option>
						</select>
					</div>
				</div>
				<div class="col-xs-12 col-sm-7 col-md-7">
					<input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
				</div>
				<div class="col-xs-12 col-sm-2 col-md-2">
					<button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Process Category</th>
				<th>Process Criteria</th>
				<th>Code</th>
				<th>Description</th>
			</tr>
		</thead>
		<tbody>
			<tr dir-paginate="x in processSets |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
				<td>{{x.ProcessCategory}}</td>
				<td>{{x.ProcessCriteria}}</td>
				<td>{{x.Code}}</td>
				<td>{{x.Description}}</td>
			</tr>
		</tbody>
	</table>
	<dir-pagination-controls max-size="10"
							 direction-links="true"
							 boundary-links="true"
							 on-page-change="getData(newPageNumber)">
	</dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<!-- #region Process PopUp -->
<modal-table modalid="processSetDetailPopUp"
			 data-title="Process"
			 data-search-parameters="processSetDetailParameters"
			 data-exclued-column-list=""
			 data-field-list="processSetDetailList"
			 data-data-list="processSetDetailDataList"
			 data-search-function="getProcessPopUpData"
			 data-single-click="selectPSDSingleClick(data)"
			 data-double-click="selectPSDDoubleClick(data)"
			 data-right-button="true"
			 data-left-button="true"
			 data-ng-click-left-button="selectPSDByButton()"
			 data-ng-click-cancel="closePSDPopUp()">
</modal-table>
<confirm-archive-generic modalid="confirmDelPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<!-- #endregion -->
<!-- #region modal tbl -->
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
	<div class="modal-dialog modal-lg">
		<div class="modal-content" ng-form name="materialgridCharacteristicsForm">
			<div class="modal-header"> {{popUpTitle}} <button type="button" class="close" data-dismiss="modal">&times;</button> </div>
			<div class="modal-body">
				<div class="row text-right">
					<div class="col-xs-12 col-sm-12 col-sm-12">
						<div class="search-form">
							<div class="row">
								<div class="col-xs-12 col-sm-3 col-md-3">
									<div class="select-style">
										<select ng-model="popUpParameters.searchBy">
											<option ng-repeat="option in popUpList|orderBy:'Text'" value="{{option.Value}}">{{option.Text}}</option>
										</select>
									</div>
								</div>
								<div class="col-xs-12 col-sm-7 col-md-7">
									<input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
								</div>
								<div class="col-xs-12 col-sm-2 col-md-2">
									<button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="table-responsive modal-table">
					<table class="table table-striped">
						<thead>
							<tr><th ng-repeat="x in popUpList" ng-show="{{x.Value!='Archive'}}">{{x.Text}}</th></tr>
						</thead>
						<tbody>
							<tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
								pagination-id="metaData.name + 'popUpDataList'" ng-click="selectSingleClick(x)" ng-dblclick="selectDoubleClick(x)">
								<td ng-repeat="hh in popUpList">{{x[hh.Value]}}</td>
							</tr>
						</tbody>
					</table>
					<dir-pagination-controls max-size="10"
											 pagination-id="metaData.name + 'popUpDataList'"
											 direction-links="true"
											 boundary-links="true"
											 on-page-change="getPopUpData(newPageNumber)">
					</dir-pagination-controls>
				</div>
				<div class="common-btn">
					<ul class="list-inline text-right">
						<li> <button ng-click="selectByButton()" class="btn">Select</button></li>
						<li> <button ng-click="closePopUp()" class="btn">Cancel</button></li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- #endregion -->
