<togglable name="Subprocess Set"></togglable>
<div class="form-horizontal" ng-form name="subProcessSetNewForm">
    <input type="hidden" ng-model="subProcessSetNew.Id">
    @*<div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Company" ng-model="subProcessSetNew.CompanyId" class="col-sm-3 form-control" ng-change="GetEntityList();"
                                ng-options="item.Value as item.Text for item in companyList" required tabindex="1">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Entity" ng-model="subProcessSetNew.EntityId" class="col-sm-3 form-control" ng-change="getEntityMapData(); getData();"
                                ng-options="item.Value as item.Text for item in entityList" required tabindex="2">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>*@
    <div class="col-xs-12">
        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Company" ng-model="subProcessSetNew.CompanyId" class="col-sm-3 form-control" ng-change="getPlant();"
                                ng-options="item.Value as item.Text for item in companyList" required tabindex="1">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup> </label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="PlantId" class="form-control" ng-model="subProcessSetNew.PlantId" name="Plant" ng-change="getEntity();" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-4 col-sm-4 col-md-4 form-element-ctrl">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Production Entity<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select name="Entity" ng-model="subProcessSetNew.EntityId" class="col-sm-3 form-control" ng-change="getEntityMapData(); getData();"
                                ng-options="item.Id as item.UserName for item in entityList" required tabindex="2">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" ng-repeat="x in entities" ng-if="$index % 2 == 0">
                <label class="col-sm-4 control-label">{{x.Text}}</label>
                <div class="col-sm-8" ng-repeat="y in entityValue">
                    <label class="col-sm-8 control-label"><b>{{y[x.Value]}}</b></label>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" ng-repeat="x in entities" ng-if="$index % 2 != 0">
                <label class="col-sm-4 control-label">{{x.Text}}</label>
                <div class="col-sm-8" ng-repeat="y in entityValue">
                    <label class="col-sm-8 control-label"><b>{{y[x.Value]}}</b></label>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="addprocess" role="tab" data-toggle="tab">Add Sub Process</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row">
                        <div class="col-xs-6 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Production Process<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Process" ng-model="subProcessSetNew.ProcessId" class="col-sm-3 form-control" ng-change="getProcessTypeList();"
                                                ng-options="item.Value as item.Text for item in processList|orderBy:'Text'" required tabindex="3">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Code" maxlength="10" ng-model="subProcessSetNew.Code" class="form-control" required tabindex="5">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Required Time Unit<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Required time unit" ng-model="subProcessSetNew.RequiredTimeUnit" class="col-sm-3 form-control" ng-disabled="subProcessSetDetails.length>0"
                                                ng-options="item.Value as item.Text for item in requiredTimeUnitList" required tabindex="7">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Process Type<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="Process Type" ng-model="subProcessSetNew.ProcessTypeId" class="col-sm-3 form-control"
                                                ng-options="item.Value as item.Text for item in processTypeList" required tabindex="4">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Description</label>
                                <div class="col-sm-8">
                                    <textarea class="form-control" rows="2" ng-model="subProcessSetNew.Description" name="Remarks" maxlength="250" tabindex="6"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <ul class="common-btn list-inline text-left">
                            <li><button ng-click="subprocessSetDetailPopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus"></i> Add Sub Process</button></li>
                        </ul>
                    </div>
                    <div class="clearfix"></div>
                    <div class="table-responsive modal-table" ng-show="processSetDetailTblShow">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th ng-show="subProcessSetDetails.length>1">Sort</th>
                                    <th>Sub Process</th>
                                    <th style="width: 101px;">Base Process</th>
                                    <th>+/-</th>
                                    <th style="width: 130px;">Lead/Lag {{subProcessSetNew.RequiredTimeUnit}}</th>
                                    <th style="width: 130px;">Production Cycle Time({{subProcessSetNew.RequiredTimeUnit}})</th>
                                    <th style="width: 10px">Job Work Applicable</th>
                                    <th style="width: 170px;">Job Work Type</th>
                                    <th style="width: 22%;">Entity/Vendor</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in subProcessSetDetails" ng-class="{selected : x.Class=='new'}">
                                    <td ng-show="subProcessSetDetails.length>1">
                                        <span ng-show="!$first" ng-click="moveUp($index)"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                        <br />
                                        <span ng-show="!$last" ng-click="moveDown($index)"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                    </td>
                                    <td>{{x.SubProcessName}}</td>
                                    <td class="text-center">
                                        <input type="radio" name="optradio" ng-checked="x.IsBaseProcess"
                                               ng-click="setPlusOrMinus($event,$index)" />
                                    </td>
                                    <td>{{x.Symbol}}</td>
                                    <td><input type="text" ng-model="x.Days" class="form-control" only-numbers ng-disabled="x.IsBaseProcess"></td>
                                    <td><input type="text" ng-model="x.ProductionCycleTime" class="form-control" only-numbers></td>
                                    <td>
                                        <input type="checkbox" ng-model="x.JobWorkApplicable" ng-checked="x.JobWorkApplicable" ng-click="clearJobType(subProcessSetDetails,x.Id);clearEntityOrVendor(subProcessSetDetails,x.Id);" />
                                    </td>
                                    <td>
                                        <div class="select-style">
                                            <select class="form-control" ng-model="x.JobWorkType" style="height: 28px"
                                                    ng-options="item.Value as item.Text for item in jobWorkTypeList" ng-disabled="!x.JobWorkApplicable">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="hidden" ng-model="x.EntityIdWithinCompany">
                                        <input type="hidden" ng-model="x.EntityIdWithinGroup">
                                        <input type="hidden" ng-model="x.VendorId">
                                        @*<div class="col-sm-8 pdl3 pdr3">
                                                <input type="text" ng-model="x.EntityOrVendorName" class="form-control" disabled>
                                            </div>
                                            <button style="height: 27px; margin-top: 2px; margin-left: 0px" class="btn" ng-click="popUp(x.Id)" ng-disabled="!x.JobWorkApplicable"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                            <button style="height: 27px; margin-top: 2px; margin-left: 0px" class="btn" ng-click="" ng-disabled="!x.JobWorkApplicable"><i class="cr-icon glyphicon glyphicon-remove"></i></button>*@
                                        <div class="input-group">
                                            <input type="text" name="CustomerName" ng-model="x.EntityOrVendorName" class="form-control" readonly>
                                            <span class="input-group-btn">
                                                <button ng-click="popUp(x.Id);" ng-disabled="!x.JobWorkApplicable" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                                                <button ng-click="clearCustomer()" ng-disabled="!x.JobWorkApplicable" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-right table-td">
                                        <ul class="list-inline action-list">
                                            <li>
                                                <button ng-click="valuePassInDelModal(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                                    <i class="glyphicon glyphicon-remove"></i>
                                                </button>
                                            </li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchFromProcessSetList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Entity</th>
                <th>Process</th>
                <th>Process Type</th>
                <th>Code</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in subProcessSets |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                <td>{{x.Entity}}</td>
                <td>{{x.Process}}</td>
                <td>{{x.ProcessType}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.Description}}</td>
            </tr>
        </tbody>
    </table>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>

<!-- #region Sub Process PopUp -->
<modal-table modalid="subprocessSetDetailPopUp"
             data-title={{subprocessTitle}}
             data-search-parameters="subprocessSetDetailParameters"
             data-exclued-column-list=""
             data-field-list="subprocessSetDetailList"
             data-data-list="subprocessSetDetailDataList"
             data-search-function="getProcessPopUpData"
             data-select-function="selectPSDSingleClick(data)"
             data-double-click="selectPSDDoubleClick(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectPSDByButton()"
             data-ng-click-cancel="closePSDPopUp()">
</modal-table>

<confirm-archive-generic modalid="confirmDelPopUp" title="Confirmation"
                         message={{message_confirmation}} data-ng-click-right-button="removeRow()">
</confirm-archive-generic>
<!-- #endregion -->
<!-- #region modal tbl -->
<modal-table modalid="popUpId"
             data-title=""
             data-search-parameters="popUpParameters"
             data-exclued-column-list=""
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click="selectSingleClick(data)"
             data-double-click="selectDoubleClick(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectByButton()"
             data-ng-click-cancel="closePopUp()">
</modal-table>
<!-- #endregion -->
