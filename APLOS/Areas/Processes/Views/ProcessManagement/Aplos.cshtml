<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal">
    <div class="row" ng-form="ProcessManagementForm">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standared Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standared Nam" ng-model="ProcessManagementNew.StandaredName" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProcessManagementNew.Process" name="Process"
                                tabindex="2" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in ProcessList" value="{{option.value}}">{{option.name}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{ProcessManagementNew.ResponsiblePersonCode}}</span>
                        <input type="text" name="Responsible Person" ng-model="ProcessManagementNew.EmployeeName" class="form-control" readonly required>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="showEmployeeListPopUp()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standared Nam" ng-model="ProcessManagementNew.UserName" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sub Process<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProcessManagementNew.SubProcess" name="SubProcess"
                                tabindex="2" required>
                            <option value="">--Select--</option>
                            <option ng-repeat="option in SubProcessList" value="{{option.value}}">{{option.name}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <input type="text" name="Remarks" ng-model="ProcessManagementNew.Remarks" class="form-control" maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>

        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSetPRM(1) }"><a ng-click="setTabPRM(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Quality Management Master</a></li>
                <li role="presentation" ng-class="{ active: isSetPRM(2) }"><a ng-click="setTabPRM(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Parameter Master</a></li>
                <li role="presentation" ng-class="{ active: isSetPRM(2) }"><a ng-click="setTabPRM(3)" href="" aria-controls="doc" role="tab" data-toggle="tab">Frequency</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetPRM(1), active: isSetPRM(1) }">
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetPRM(2), active: isSetPRM(2) }">
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetPRM(3), active: isSetPRM(3) }">
            </div>
        </div>
    </div>
</div>


@*Employee Popup*@
<div class="modal fade site-modal in" id="employeePopUps" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>
