<style>
    .modellgModify {
        width: 1500px;
    }
</style>
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{FormTitle}}</h3>
<div class="form-elements form-horizontal" ng-form name="buyerNewForm">
    <div class="row">
        <div class="form-elements form-horizontal" id="Main">
            <div class="col-xs-12" ng-show="showfromto">
                <div class="col-xs-5">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label" id="fDate">From Date<sup>*</sup></label>
                        <div class="col-sm-8  show-message">
                            <input type="text" name="From Date" ng-model="FromDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required tabindex="2">
                        </div>
                    </div>
                </div>
                <div class="col-xs-5">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label" id="tDate">To Date<sup>*</sup></label>
                        <div class="col-sm-8  show-message">
                            <input type="text" name="To Date" ng-model="ToDate" datepicker class="form-control" placeholder="dd-MM-yyyy" required tabindex="3">
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="clickGo();" class="btn"><i class="glyphicon glyphicon-send"></i> Go</button></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-xs-12" ng-show="showgrndiv">
                <div class="col-xs-12">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="clickBack();" class="btn"><i class="glyphicon glyphicon-backward"></i> Back</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">GRN No :</span></label>
                        <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                            <input type="text" ng-model="fabricRollMaster.GRNNo" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="LoadGRNSearchList()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PO No  :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.POId}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">LC No  :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.PurchaseLCNo}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Vendor :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.PartyName}}</label>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Prepared by<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <span class="input-group-addon">{{fabricRollMaster.PreparedByCode}}</span>
                                <input type="text" name="Vendor" ng-model="fabricRollMaster.PreparedByName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button name="submit" ng-click="getPopUpData('Preparedby')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    <button name="submit" ng-click="ClearEmpdata('Preparedby')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">

                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">GRN Date :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.GRNDate}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PO Date  :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.PODate}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">LC Date  :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.LCDate}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Opening Bank :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.OpeningBank}}</label>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Checked by<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="input-group">
                                <span class="input-group-addon">{{fabricRollMaster.CheckedByCode}}</span>
                                <input type="text" name="Vendor" ng-model="fabricRollMaster.CheckedByName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button name="submit" ng-click="getPopUpData('Checkedby')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                    <button name="submit" ng-click="ClearEmpdata('Checkedby')" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">

                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Amount :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.TransactionAmount}}&nbsp;{{fabricRollMaster.CurrencyCode}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Vendor Ref No :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.VendorRefNo}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Invoice No :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.InvoiceNo}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI No :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.PINo}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Attachment :</span></label>
                        <div class="col-sm-8">
                            <div id="UploadDefault" e-dialogtext-title="Product Picture" e-autoupload="true" e-begin="onBeginPBUpload" e-filesize="2097152" ej-uploadbox e-saveurl="uploadPBUrl" e-multiplefilesselection="false" e-success="getFileList" e-extensionsallow=".xls,.xlsx"></div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12">
                    <div class="col-xs-6">
                        <div class="form-group">
                            <label class="col-sm-2 control-label"><span style="font-weight:bold">Buyer PO No :</span></label>
                            <label class="col-sm-10 control-label">{{fabricRollMaster.BuyerPONumber}}</label>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">Remarks</label>
                            <div class="col-sm-10">
                                <textarea class="form-control" rows="1" ng-model="fabricRollMaster.Remarks" tabindex="7" maxlength="250"></textarea>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-2 control-label">User Reference<sup>*</sup></label>
                            <div class="col-sm-6 show-message">
                                <input type="text" name="User" ng-model="fabricRollMaster.UserName" ng-keyup="CheckSpecialCharecter();" required class="form-control" maxlength="100" autocomplete="off">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-6">
                        <div class="form-group">
                            <label class="col-sm-2 control-label"><span style="font-weight:bold">Style :</span></label>
                            <label class="col-sm-10 control-label">{{fabricRollMaster.BuyerReferenceNo}}</label>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">Comment</label>
                            <div class="col-sm-10">
                                <textarea class="form-control" rows="1" ng-model="fabricRollMaster.Comment" tabindex="7" maxlength="250"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12" ng-show="MaterialGridList.length>0">
                    <div style="color:black;" id="MaterialGrid" ej-grid e-datasource="MaterialGridList"
                         e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                         e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
                         e-allowselection="false" e-templaterefresh="refreshTemplateemployee">
                        <div e-columns>
                            <div e-column e-headertext="" @*e-headertemplateid="#headerTemplate"*@ e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-type="string" e-field="Id" e-headertext="RowDetailNo" e-width="50"></div>
                            <div e-column e-type="string" e-field="MaterialMasterName" e-headertext="Material Master" e-width="120"></div>
                            <div e-column e-type="string" e-field="ArticleName" e-headertext="Article" e-width="150"></div>
                            <div e-column e-type="string" e-field="SKUInfo" e-headertext="SKU Info." e-width="100"></div>
                            <div e-column e-type="number" e-field="TransactionQty" e-textalign="right" e-format="{0:N2}" e-headertext="Transaction Qty" e-width="100"></div>

                            <div e-column e-type="string" e-field="UOM" e-headertext="UoM" e-width="50"></div>
                            <div e-column e-type="number" e-field="SplitCount" e-textalign="right" e-format="{0:N2}" e-headertext="Split Count" e-width="80"></div>
                            <div e-column e-type="number" e-field="TotalDistributeQty" e-textalign="right" e-format="{0:N2}" e-headertext="Total Distribute Qty" e-width="100"></div>
                            <div e-column e-headertext="RollNo" e-template="#rollsNo" e-width="80"></div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                    </script>

                    <script type="text/template" id="rollsNo">
                        <input type="text" only-numbers ng-model="data.RollNo" style="color:black;" class="form-control" />
                    </script>

                    <div class="col-md-6">
                        <div class="inputBtnSection common-btn">
                            <label class="fileUpload col-sm-4 ">
                                <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                            </label>
                            <input type="button" value="Import Data" class="btn btn-success" ng-click="ImportData()" />
                            @*<input type="button" class="btn btn-success" ng-click="ClearImportData()" />*@
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="SummaryData();" ng-show="grnDetailList.length>0" class="btn"><i class="glyphicon glyphicon-file"></i> Define Group</button></li>
                                <li> <button ng-click="getCustomerData();" ng-show="grnDetailList.length>0" class="btn"><i class="glyphicon glyphicon-file"></i> Customer Data</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="GetSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File</button></li>
                            </ul>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-12" ng-show="grnDetailList.length>0">
                            <div id="GridWorkCenterProduct"
                                 ng-init="chkinit()"
                                 ej-grid e-datasource="grnDetailList"
                                 e-allowfiltering="true"
                                 e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                                 e-pagesettings-pagesize="25"
                                 e-filtersettings-filterType="excel">
                                <div e-columns>
                                    <div e-column e-field="Sequence" e-headertext="Sequence" e-width="30" e-primarykey="true"></div>
                                    <div e-column e-field="GRNRowId" e-headertext="GRNRowId" e-width="80"></div>
                                    <div e-column e-field="Color" e-headertext="Color" e-width="80"></div>
                                    <div e-column e-field="LotNo" e-headertext="LotNo" e-width="80"></div>
                                    @*<div e-column e-field="ShadeGroup" e-headertext="ShadeGroup" e-width="80"></div>*@
                                    <div e-column e-field="FabricType" e-headertext="FabricType" e-width="80"></div>
                                    <div e-column e-field="FabricQuality" e-headertext="FabricQuality" e-width="80"></div>
                                    <div e-column e-field="SupplierRollNo" e-headertext="SupplierRollNo" e-width="80"></div>
                                    <div e-column e-field="OwnRollNo" e-headertext="OwnRollNo" e-width="80"></div>
                                    <div e-column e-field="QtyUoM" e-headertext="Qty UoM" e-width="80"></div>
                                    <div e-column e-field="SupplierQty" e-headertext="SupplierQty" e-width="80"></div>
                                    <div e-column e-field="ActualQty" e-headertext="Actual Qty" e-width="80"></div>
                                    <div e-column e-field="CutableWidth" e-headertext="CutableWidth" e-width="80"></div>
                                    <div e-column e-field="OwnGSM" e-headertext="OwnGSM" e-width="80"></div>
                                    <div e-column e-field="StdGSM" e-headertext="StdGSM" e-width="80"></div>
                                    <div e-column e-field="GSMVariation" e-headertext="GSMVariation" e-width="80"></div>
                                    <div e-column e-field="GSMVariationPer" e-headertext="GSMVariationPer" e-width="80"></div>
                                    <div e-column e-field="Shade" e-headertext="Shade" e-width="80"></div>
                                    <div e-column e-field="ShrinkageLengthWise" e-headertext="ShrinkageLengthWise" e-width="80"></div>
                                    <div e-column e-field="ShrinkageWidthWise" e-headertext="ShrinkageWidthWise" e-width="80"></div>
                                    @*<div e-column e-field="ShrinkageGroup" e-headertext="ShrinkageGroup" e-width="80"></div>*@
                                    <div e-column e-field="Dia" e-headertext="Dia" e-width="80"></div>
                                    <div e-column e-field="SupplierQualityGrade" e-headertext="SupplierQualityGrade" e-width="80"></div>
                                    <div e-column e-field="QualityStatus" e-headertext="QualityStatus" e-width="80"></div>
                                    <div e-column e-field="FTPReportNo" e-headertext="FTPReportNo" e-width="80"></div>
                                    <div e-column e-field="FTPReceiveDate" e-headertext="FTPReceiveDate" e-width="80"></div>
                                    <div e-column e-field="FTPStatus" e-headertext="FTPStatus" e-width="80"></div>
                                    @*<div e-column e-field="DimensionalChange3rdWash" e-headertext="DimensionalChange3rdWash" e-width="80"></div>
                                    <div e-column e-field="Spirality3rdWash" e-headertext="Spirality3rdWash" e-width="80"></div>
                                    <div e-column e-field="PillingResistance" e-headertext="PillingResistance" e-width="80"></div>
                                    <div e-column e-field="BurstingStrength" e-headertext="BurstingStrength" e-width="80"></div>
                                    <div e-column e-field="Absorbency" e-headertext="Absorbency" e-width="80"></div>
                                    <div e-column e-field="pHValue" e-headertext="pHValue" e-width="80"></div>
                                    <div e-column e-field="Sewablity" e-headertext="Sewablity" e-width="80"></div>
                                    <div e-column e-field="Handfeel" e-headertext="Handfeel" e-width="80"></div>*@
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 ">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-show="grnDetailList.length>0" ng-click="SaveRollData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                </ul>
                                <ul class="list-inline text-left bold" style="color:green;font-size:larger;font-weight:bolder;">
                                    <li>    <i>{{msg}}</i> </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="grnSummaryListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">
                Summary List <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body ">
                <div class="col-xs-12">
                    <div id="filters">
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="GetSummaryList();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> View</button></li>
                        </ul>
                    </div>
                </div>
                <div class="col-xs-12">
                    <div class="row">
                        <div style="color:black;" id="GridFabricSummary" ej-grid e-datasource="grnSummaryList" e-recorddoubleclick=""
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-type="string" e-field="FabricType" e-headertext="Fabric Type" e-width="100"></div>
                                <div e-column e-type="string" e-field="CutableWidth" e-headertext="Cutable Width" e-width="100"></div>
                                <div e-column e-type="string" e-field="ShrinkageWidthWise" e-headertext="Shrinkage-Width" e-width="100"></div>
                                <div e-column e-type="string" e-field="ShrinkageLengthWise" e-headertext="Shrinkage-Length" e-width="100"></div>
                                <div e-column e-type="string" e-field="Shade" e-headertext="Shade" e-width="100"></div>
                                <div e-column e-type="string" e-field="NoOfRoll" e-headertext="No Of Roll" e-width="100"></div>
                                <div e-column e-type="string" e-field="Qty" e-headertext="Qty" e-width="100"></div>
                                <div e-column e-type="string" e-template="#CutableWidthGroup" e-headertext="C.WidthGrp" e-width="100"></div>
                                <div e-column e-type="string" e-template="#ShrinkageGrp" e-headertext="ShrinkageGrp" e-width="100"></div>
                                <div e-column e-type="string" e-template="#MarkerGroup" e-headertext="MarkerGrp" e-width="100"></div>
                                <div e-column e-type="string" e-template="#ShadeGroup" e-headertext="ShadeGrp" e-width="100"></div>
                                <div e-column e-type="string" e-template="#FabricGroup" e-headertext="FabicGrp" e-width="100"></div>
                                <div e-column e-type="string" e-template="#Remarks" e-headertext="Remarks" e-width="100"></div>
                            </div>
                        </div>
                        <script type="text/template" id="MarkerGroup">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="MarkerGroup" ng-model="data.MarkerGroup" ng-change="$parent.FabricGroupChange(this);" ng-click="" class="form-control" maxlength="200">
                            </div>
                        </script>
                        <script type="text/template" id="FabricGroup">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="FabricGroup" ng-model="data.FabricGroup" ng-click="" class="form-control" maxlength="200">
                            </div>
                        </script>
                        <script type="text/template" id="CutableWidthGroup">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" n-decimals="2" name="CutableWidthGroup" ng-model="data.CutableWidthGroup" ng-click="" class="form-control" maxlength="200">
                            </div>
                        </script>
                        <script type="text/template" id="ShadeGroup">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="ShadeGroup" ng-model="data.ShadeGroup" ng-change="$parent.FabricGroupChange(this);" ng-click="" class="form-control" maxlength="200">
                            </div>
                        </script>
                        <script type="text/template" id="ShrinkageGrp">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="ShrinkageGroup" ng-model="data.ShrinkageGroup" ng-click="" class="form-control" maxlength="200">
                            </div>
                        </script>
                        <script type="text/template" id="Remarks">
                            <div class="col-sm-10" style="padding:0px;">
                                <input type="text" name="Remarks" ng-model="data.Remarks" ng-click="" class="form-control" maxlength="200">
                            </div>
                        </script>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="UpdateFabricDetails();" class="btn"><i class=""></i> Update </button>
                <button ng-click="closeGRNSummaryPopUp();" class="btn"><i class=""></i> Close </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="grnCustomerDataListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">
                Customer Data List <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body ">
                <div class="col-xs-12">
                    <div class="row">
                        <div style="color:black;" id="GridCustomerData" ej-grid e-datasource="grnCustomerDataList" e-recorddoubleclick=""
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true" e-templaterefresh="refreshTemplateCustomerData"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-headertext="All" e-headertemplateid="#headerTemplateCustomerData" e-template="#checkboxTemplateCustomerData" e-textalign="center" e-width="30"></div>
                                <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="100"></div>
                                <div e-column e-type="string" e-field="MasterOrderNo" e-headertext="MasterOrder No" e-width="100"></div>
                                <div e-column e-type="string" e-field="MasterOrderItemId" e-headertext="LineItem No" e-width="100"></div>
                                <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="100"></div>
                                <div e-column e-type="string" e-field="CustomerReferenceNo" e-headertext="Cust.Ref.No" e-width="100"></div>
                                <div e-column e-type="string" e-field="OwnReferenceNo" e-headertext="OwnRef.No" e-width="100"></div>
                                <div e-column e-type="string" e-field="SONo" e-headertext="SO No" e-width="100"></div>
