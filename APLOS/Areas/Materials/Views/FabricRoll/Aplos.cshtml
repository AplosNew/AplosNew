<togglable name="Fabric Roll"></togglable>
<div class="form-elements form-horizontal" ng-form name="buyerNewForm">
    @*<div class="modal-header">
            Material
            <button type="button" class="close" data-dismiss="modal">&times;</button>
        </div>*@
    <div class="modal-body">
        <div class="row">
            <div class="form-elements form-horizontal">

                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">GRN No :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.GRNNo}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PO No  :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.POId}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">LC No  :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.PurchaseLCNo}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label"><span style="font-weight:bold">Party :</span></label>
                        <label class="col-sm-10 control-label">{{fabricRollMaster.PartyName}}</label>

                        @*<label class="col-sm-2 control-label">&nbsp;</label>*@
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">GRN Date :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.GRNDate}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PO Date  :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.PODate}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">LC Date  :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.LCDate}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Opening Bank :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.OpeningBank}}</label>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">

                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Amount :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.TransactionAmount}}&nbsp;{{fabricRollMaster.CurrencyCode}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">Vendor Ref No :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.VendorRefNo}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label"><span style="font-weight:bold">PI No :</span></label>
                        <label class="col-sm-8 control-label">{{fabricRollMaster.PINo}}</label>
                    </div>
                </div>
            </div>
            <div class="col-xs-12">
                <div style="color:black;" id="drgtg" ej-grid e-datasource="MaterialGridList"
                     e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
                     e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
                     e-allowselection="false">
                    <div e-columns>
                        <div e-column e-type="string" e-field="MaterialMasterName" e-headertext="Material Master" e-width="100"></div>
                        <div e-column e-type="string" e-field="ArticleName" e-headertext="Article" e-width="100"></div>
                        <div e-column e-type="string" e-field="SKUInfo" e-headertext="SKU Info." e-width="100"></div>
                        <div e-column e-type="number" e-field="TransactionQty" e-textalign="right" e-format="{0:N2}" e-headertext="Transaction Qty" e-width="100"></div>

                        <div e-column e-type="string" e-field="UoM" e-headertext="UOM" e-width="120"></div>
                        <div e-column e-type="number" e-field="SplitCount" e-textalign="right" e-format="{0:N2}" e-headertext="Split Count" e-width="80"></div>
                        <div e-column e-type="number" e-field="TotalDistributeQty" e-textalign="right" e-format="{0:N2}" e-headertext="TotalDistribute Qty" e-width="100"></div>
                        <div e-column e-headertext=" Distribute " e-template="#distributeBTN" e-width="120"></div>

                    </div>
                    <script id="distributeBTN" type="text/template">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-center">

                                <li><button ng-click="$parent.showFabricPop(data)" class="btn btn-action tooltip-here" ng-disabled="data.SplitCount>0" data-placement="top" title="Add New"><i class="glyphicon glyphicon-list"></i></button></li>
                                <li><button ng-click="$parent.showFabricPop(data)" class="btn btn-action tooltip-here" ng-disabled="data.SplitCount<1" data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i></button></li>

                                <li>
                                    <button ng-click="$parent.getpdff(data);" class="btn small tooltip-here" style="height: 28px; width: 28px; padding: 0px; margin: 0px;" title="Edit">
                                        <i class="glyphicon glyphicon-eye-open" style="color:orangered;"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="row text-right">
                <div class="col-xs-12 col-sm-12 col-sm-12 ">
                    <div class="search-form">
                        <div class="row">
                            <div class="col-xs-12 col-sm-3 col-md-3">
                                <div class="select-style">
                                    <select ng-model="GRNsearchBy">
                                        <option ng-repeat="option in searchGRNByList" value="{{option.value}}">{{option.name}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-7 col-md-7">
                                <input type="text" class="form-control" placeholder="Search" ng-model="GRNsearch" ng-enter="LoadGRNSearchList()">
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2">
                                <button type="button" ng-click="LoadGRNSearchList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <label class="control-label" style="color:blue;padding-left: 17px;font-size:12px;margin-top: -6px;">Fabric <span style="text-transform: lowercase;">roll management should be activated. </span></label>
    <div class="table-responsive aplos-grid-toggle">
        <div style="color:black;" id="GridfabricRoll" ej-grid e-datasource="GRNGridList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowTextWrap="true"
             e-allowselection="false">
            <div e-columns>
                <div e-column e-type="string" e-field="GRNNo" e-headertext="GRN No." e-width="100"></div>
                <div e-column e-type="date"   e-field="GRNDate" e-format="{0:dd-MMM-yyyy}" e-headertext="GRN Date" e-width="120"></div>
                <div e-column e-type="string" e-field="GRNType" e-headertext="GRN Type" e-width="100"></div>
                <div e-column e-type="string" e-field="GRNStatus" e-headertext="GRN Status" e-width="100"></div>

                <div e-column e-type="string" e-field="PartyName" e-headertext="Vendor" e-width="120"></div>
                <div e-column e-type="number" e-field="TransactionQty" e-textalign="right" e-format="{0:N2}" e-headertext="Qty" e-width="80"></div>
                <div e-column e-type="number" e-field="TransactionAmount" e-textalign="right" e-format="{0:N2}" e-headertext="Amount" e-width="100"></div>
                <div e-column e-type="string" e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                <div e-column e-type="string" e-field="POId" e-headertext="PO No." e-width="100"></div>
                <div e-column e-type="date"   e-field="PODate" e-format="{0:dd-MMM-yyyy}" e-headertext="PO Date" e-width="120"></div>
                <div e-column e-type="string" e-field="VendorRefNo" e-headertext="PO Vendor Ref No." e-width="100"></div>
                <div e-column e-type="string" e-field="PurchaseLCNo" e-headertext="Purchase LC No." e-width="100"></div>
                <div e-column e-type="string" e-field="LCANo" e-headertext="LC Ref No." e-width="100"></div>
                <div e-column e-type="date"   e-field="LCDate" e-format="{0:dd-MMM-yyyy}" e-headertext="LC Date" e-width="120"></div>
                <div e-column e-type="string" e-field="PINo" e-headertext="PI No." e-width="100"></div>
                <div e-column e-type="string" e-field="OpeningBank" e-headertext="OpeningBank" e-width="100"></div>
                <div e-column e-type="string" e-field="ContractNo" e-headertext="Contract No." e-width="100"></div>
                <div e-column e-type="string" e-field="CustomerName" e-headertext="Customer" e-width="120"></div>
                <div e-column e-type="string" e-field="UDNo" e-headertext="UD" e-width="80"></div>
                <div e-column e-type="string" e-field="GateEntryNo" e-headertext="Gate Entry No" e-width="150"></div>
                <div e-column e-type="string" e-field="GateName" e-headertext="Gate Name" e-width="150"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="grnPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Material
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body ">
                <div class="form-elements form-horizontal">
                    @*col-xs-12 divborder*@
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><span style="font-weight:bold">GRNNo</span></label>
                            <label class="col-sm-8 control-label">{{fabricRollMaster.GRNNo}}</label>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><span style="font-weight:bold">PO Date:</span></label>
                            <label class="col-sm-8 control-label">{{fabricRollMaster.PODate}}</label>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><span style="font-weight:bold">GRN Date :</span></label>
                            <label class="col-sm-8 control-label">{{fabricRollMaster.GRNDate}}</label>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><span style="font-weight:bold">Qty :</span></label>
                            <label class="col-sm-8 control-label">{{fabricRollMaster.TotalDetailQty}}</label>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><span style="font-weight:bold">PONo:</span></label>
                            <label class="col-sm-8 control-label">{{fabricRollMaster.POID}}</label>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><span style="font-weight:bold">Amount :</span></label>
                            <label class="col-sm-8 control-label">{{fabricRollMaster.TotalDetailAmount}}&nbsp;{{fabricRollMaster.Code}}</label>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">

                        <div class="form-group">
                            <label class="col-sm-10 control-label"><span style="font-weight:bold">Party :</span>{{fabricRollMaster.PartyName}}</label>
                            <label class="col-sm-2 control-label">&nbsp;</label>
                        </div>


                    </div>
                </div>
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="grnDetailParameters.searchBy">
                                            <option ng-repeat="option in searchGRNDetailByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="grnDetailParameters.search" ng-enter="getGRNDetailData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getGRNDetailData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material Master</th>
                                <th>Article</th>
                                <th>SKU</th>
                                <th>PL Qty</th>
                                <th>UOM</th>
                                <th>No of Rolls</th>
                                <th>Distributed Qty</th>
                                <td>
                                    Distribute
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in grnDetailList|itemsPerPage:grnDetailParameters.pageSize" total-items="grnDetailParameters.total_count" pagination-id="metaData.name + 'grnDetailList'">
                                <td>{{x.MaterialMasterName}}</td>
                                <td>{{x.ArticleName}}</td>
                                <td>{{x.SKUInfo}}</td>
                                <td>{{x.TransactionQty}}</td>
                                <td>{{x.UOM}}</td>
                                <td>{{x.SplitCount}}</td>
                                <td>{{x.TotalDistributeQty}}</td>
                                <td>
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="showFabricPop($index,x,false)" class="btn btn-action tooltip-here" ng-disabled="x.SplitCount>0" data-placement="top" title="Add New"><i class="glyphicon glyphicon-list"></i></button></li>
                                        <li><button ng-click="showFabricPop($index,x,true)" class="btn btn-action tooltip-here" ng-disabled="x.SplitCount<1" data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i></button></li>
                                        <li><button ng-click="getpdff(x.Id)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-eye-open"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'grnDetailList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getGRNDetailData(newPageNumber)">
                    </dir-pagination-controls>
                </div>

            </div>
            <div class="modal-footer common-btn">
                @*<button ng-click="closeGRNPopUp();" class="btn"><i class=""></i> Select</button>*@
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="fabricRollPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Fabric Roll
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row" @*style="background-color:lightgray;"*@>
                    <div class="form-element-ctrl form-horizontal">
                        <div class="col-xs-12">
                            <div class="col-xs-12 col-sm-4 col-md-4">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label"><span style="font-weight:bold;">Material Group :</span></label>
                                    <label class="col-sm-8 control-label">{{selectedGRNRow.MaterialGroup}}</label>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label"><span style="font-weight:bold">SKU1 :</span></label>
                                    <label class="col-sm-8 control-label">{{selectedGRNRow.SKU1}}</label>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label"><span style="font-weight:bold">PL Qty :</span></label>
                                    <label class="col-sm-8 control-label">{{selectedGRNRow.TransactionQty}}&nbsp;{{selectedGRNRow.UOM}}</label>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-4 col-md-4">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><span style="font-weight:bold;">Material :</span></label>
                                    <label class="col-sm-9 control-label">{{selectedGRNRow.MaterialMasterName}}</label>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label"><span style="font-weight:bold">SKU2 :</span></label>
                                    <label class="col-sm-8 control-label">{{selectedGRNRow.SKU2}}</label>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label"><span style="font-weight:bold">Base UoM :</span></label>
                                    <label class="col-sm-8 control-label">{{selectedGRNRow.BaseUoM}}</label>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-4 col-md-4">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><span style="font-weight:bold;">Article :</span></label>
                                    <label class="col-sm-9 control-label">{{selectedGRNRow.ArticleName}}</label>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label"><span style="font-weight:bold">SKU3 :</span></label>
                                    <label class="col-sm-8 control-label">{{selectedGRNRow.SKU3}}</label>
                                </div>

                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label"><span style="font-weight:bold;">Vendor Width</span></label>
                                    <div class="col-sm-8">
                                        <input type="text" n-decimals="4" name="ShortName" ng-model="fabricRollSplitOb.VendorWidth" class="form-control" tabindex="6">
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">No Of Rolls<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <div class="input-group">
                                            <input type="text" only-numbers ng-model="fabricRollMasterNew.GRNSplitQty" class="form-control">
                                            <span class="input-group-btn">
                                                <button name="submit" ng-click="splitGrnRow()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-plus"></i></button>
                                                <button name="submit" ng-click="clearSplitRow()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row form-element-ctrl form-horizontal">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>SR#</th>
                                        <th>RollNo</th>
                                        <th>Vendor Roll No</th>
                                        <th>Vendor Lot No</th>
                                        <th>Vendor Width</th>
                                        <th>Vendor Qty</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in fabricRollMasterList track by $index">
                                        <td>{{$index+1}}</td>
                                        <td>{{x.RollNo}}</td>
                                        <td>
                                            <input type="text" name="User Name" ng-model="x.VendorRollNo" class="form-control" n-numbers>
                                        </td>
                                        <td>
                                            <input type="text" name="User Name" ng-model="x.VendorLotNo" class="form-control" n-numbers>
                                        </td>
                                        <td>
                                            <input type="text" name="User Name" ng-model="x.VendorWidth" class="form-control" n-numbers>
                                        </td>
                                        <td class="text-right">
                                            <input type="text" name="User Name" n-decimals="2" ng-model="x.VendorQty" class="form-control text-right" n-numbers>
                                        </td>
                                        <td>
                                            <ul class="list-inline action-list">
                                                <li><button ng-click="valuePassInDelModal($index,x)" class="btn btn-action tooltip-here" data-placement="top" title="Add New"><i class="glyphicon glyphicon-trash"></i></button></li>
                                            </ul>
                                        </td>
                                    </tr>
                                    <tr>

                                        <td colspan="6" class="text-right"><span style="font-weight:bold;">Total:</span><strong>{{fabricRollMasterList | sumByKey : 'VendorQty' }}</strong></td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer common-btn">
                    <button ng-click="Save();" class="btn"><i class=""></i> Save</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="fabricRollPDFPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Fabric Roll PDF
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div id="demo" style="height:1000px">

                </div>
            </div>
            <div class="modal-footer common-btn">
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirm_PopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
