<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Pending</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Confirm</a></li>
        <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="doc" role="tab" data-toggle="tab">Grouping</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <div class="form-elements form-horizontal" id="bulletin">
            <togglable name="Pending"></togglable>
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li> <button ng-show="fabricPendingDetailList.length>0" ng-click="ShowModal();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                </ul>
                
            </div>
            <div class="col-sm-12" ng-show="fabricPendingChildListList.length>0">
                <div id="GridPF" ej-grid e-datasource="fabricPendingChildListList" e-allowfiltering="true"
                     e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-pagesettings-pagesize="25"
                     e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-headertext="" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                        <div e-column e-field="Sequence" e-headertext="Sequence" e-width="30" e-primarykey="true"></div>
                        <div e-column e-field="GRNRowId" e-headertext="GRNRowId" e-width="80"></div>
                        <div e-column e-field="Color" e-headertext="Color" e-width="80"></div>
                        <div e-column e-field="LotNo" e-headertext="LotNo" e-width="80" style="height: 20px;"></div>
                        <div e-column e-field="FabricType" e-headertext="FabricType" e-width="80"></div>
                        <div e-column e-field="FabricQuality" e-headertext="FabricQuality" e-width="80"></div>
                        <div e-column e-field="SupplierRollNo" e-headertext="SupplierRollNo" e-width="80"></div>
                        <div e-column e-field="OwnRollNo" e-headertext="OwnRollNo" e-width="80"></div>
                        <div e-column e-field="QtyUoM" e-headertext="Qty UoM" e-width="80"></div>
                        <div e-column e-field="SupplierQty" e-headertext="SupplierQty" e-width="80"></div>
                        <div e-column e-field="ActualQty" e-headertext="Actual Qty" e-width="80"></div>
                        <div e-column e-field="CutableWidth" e-headertext="CutableWidth" e-width="80"></div>
                        <div e-column e-field="OwnGSM" e-headertext="OwnGSM" e-width="80"></div>
                        <div e-column e-field="StdGSM" e-headertext="StdGSM" e-width="80"></div>
                        <div e-column e-field="GSMVariation" e-headertext="GSMVariation" e-width="80"></div>
                        <div e-column e-field="GSMVariationPer" e-headertext="GSMVariationPer" e-width="80"></div>
                        <div e-column e-field="Shade" e-headertext="Shade" e-width="80"></div>
                        <div e-column e-field="ShrinkageLengthWise" e-headertext="ShrinkageLengthWise" e-width="80"></div>
                        <div e-column e-field="ShrinkageWidthWise" e-headertext="ShrinkageWidthWise" e-width="80"></div>
                        <div e-column e-field="Dia" e-headertext="Dia" e-width="80"></div>
                        <div e-column e-field="SupplierQualityGrade" e-headertext="SupplierQualityGrade" e-width="80"></div>
                        <div e-column e-field="QualityStatus" e-headertext="QualityStatus" e-width="80"></div>
                        <div e-column e-field="FTPReportNo" e-headertext="FTPReportNo" e-width="80"></div>
                        <div e-column e-field="FTPReceiveDate" e-headertext="FTPReceiveDate" e-width="80"></div>
                        <div e-column e-field="FTPStatus" e-headertext="FTPStatus" e-width="80"></div>
                    </div>
                </div>
                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplate">
                    <input type="checkbox" id="headchk" />
                </script>
                <script type="text/template" id="Color">
                    <div class="col-sm-10" style="padding:0px; width:70px;">
                        <input type="text" e-value="data.Color" e-width="80" />
                    </div>
                </script>
                <script type="text/template" id="AllotedManpower">
                    <div class="col-sm-10" style="padding:0px; width:70px;">
                        <input type="text" ej-numerictextbox e-decimalplaces="2" e-value="data.AllotedManpower" e-width="80" />
                    </div>
                </script>
                <script type="text/template" id="LotNo">
                    <div class="col-sm-10" style="padding:0px; width:70px;">
                        <input type="text" e-value="data.LotNo" e-width="80" />
                    </div>
                </script>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12 ">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-show="fabricPendingDetailList.length>0" ng-click="SaveRollData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                        <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                    <ul class="list-inline text-left bold" style="color:green;font-size:larger;font-weight:bolder;">
                        <li>    <i>{{msg}}</i> </li>
                    </ul>
                </div>
            </div>


        </div>
        <div class="row">
            <div class="aplos-grid-toggle">

                <div style="color:black;" id="GridPF" ej-grid e-datasource="fabricPendingDetailList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowResizing="true" e-recorddoubleclick="Get" e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Id" e-headertext-color="black" e-textalign="left" e-width="40"></div>
                        <div e-column e-field="GRNId" e-headertext="GRNId" e-width="80"></div>
                        <div e-column e-field="UserName" e-type="string" e-headertext="User Reference" e-width="80"></div>
                        <div e-column e-field="PreparedBy" e-headertext="PreparedBy" e-width="80"></div>
                        <div e-column e-field="CheckedBy" e-headertext="CheckedBy" e-width="80"></div>
                    </div>

                </div>

            </div>
        </div>

    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <div id="GridPC" ej-grid e-datasource="PCList"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-headertext="Article" e-template="#ShowArticleAction" e-width="2"></div>
                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
                <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
                <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
                <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
            </div>
        </div>
        <script type="text/template" id="ShowArticleAction">
            <button style="color: #f3f3ec;background-color: #1c1f32;" title="Article" class="btn"><i class="glyphicon glyphicon-th-list" ng-click="$parent.getSelectedArticle(this);" style="margin: -6px;"></i></button>
        </script>
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
    </div>
</div>

<div class="modal fade site-modal in" id="entryPopUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header">Entry 
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body form-elements form-horizontal">
                <div ng-form="soSplitForm">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Sales Order No</label>
                            <div class="col-sm-8">
                                <input type="text" name="Sales Order No" style="text-align:left" ng-model="soSplitModel.ParentId" disabled class="form-control text-right" tabindex="101">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">PO Number</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" ng-model="soSplitModel.PONumber" name="PO Number" class="form-control" readonly tabindex="103">
                                    <span class="input-group-btn">
                                        <button ng-click="" type="submit" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        <button ng-click="" class="btn single-small-btn"><i class="glyphicon glyphicon-plus"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Order Status<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Order Status" class="form-control" ng-model="soSplitModel.OrderStatusId" ng-options="item.Value as item.Text for item in orderStatusList" required tabindex="105">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Commitment Date</label>
                            <div class="col-sm-8">
                                <input type="text" datepicker name="Commitment Date" ng-model="soSplitModel.CommitmentDate" class="form-control" tabindex="107">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Revise Date</label>
                            <div class="col-sm-8">
                                <input type="text" datepicker name="Revise Date" ng-model="soSplitModel.ReviseDate" class="form-control" tabindex="106">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Bill Discounting Days</label>
                            <div class="col-sm-8">
                                <input type="text" only-numbers name="BillDiscountingDays" ng-disabled="IsBillDiscountingDays==false" ng-model="soSplitModel.BillDiscountingDays" class="form-control" tabindex="106">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Destination<sup>*</sup></label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Destination" class="form-control" ng-model="soSplitModel.DestinationId" ng-options="item.Value as item.Text for item in destinationList" tabindex="109">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Quantity<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" n-decimals="2" name="Qty" ng-model="soSplitModel.Qty" class="form-control text-right" tabindex="111">
                            </div>
                        </div>


                        <div class="form-group">
                            <label class="col-sm-4 control-label">Up Charge</label>
                            <div class="col-sm-8">
                                <input type="text" n-decimals="2" name="UpCharge" ng-model="soSplitModel.UpCharge" class="form-control text-right" tabindex="113">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Responsible Person</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input type="text" name="Responsible Person" ng-model="soSplitModel.ResponsiblePersonName" class="form-control" readonly tabindex="115">
                                    <span class="input-group-btn">
                                        <button ng-click="showEmployeeListPopUp('Splitso');" class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Main RM Inhouse Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" datepicker name="Main RM Inhouse Date" ng-model="soSplitModel.MainRawMaterialInhouseDate" class="form-control" required tabindex="117">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Production Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Production Type" class="form-control" ng-model="soSplitModel.ProductionType" tabindex="102">
                                        <option value="">--Select--</option>
                                        <option value="Order">Order</option>
                                        <option value="Stock">Stock</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" name="Description" ng-model="soSplitModel.Description" rows="2" maxlength="250" tabindex="119"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">

                        <div class="form-group">
                            <label class="col-sm-4 control-label">SO Type</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="SO Type" class="form-control" ng-model="soSplitModel.SOType" tabindex="102">
                                        <option value="">--Select--</option>
                                        <option value="Critical">Critical</option>
                                        <option value="Important">Important</option>
                                        <option value="Normal">Normal</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Order Category<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Order Category" class="form-control" ng-model="soSplitModel.OrderCategoryId" ng-options="item.Value as item.Text for item in orderCategoryList" required tabindex="104">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Delivery Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" datepicker name="Delivery Date" ng-model="soSplitModel.DeliveryDate" class="form-control" required tabindex="106">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Delivery Group</label>
                            <div class="col-sm-8">
                                <input type="text" name="DeliveryGroup" style="text-align:left" ng-model="soSplitModel.DeliveryGroup" class="form-control text-right" tabindex="107">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Plan Ex-Factory Date</label>
                            <div class="col-sm-8">
                                <input type="text" datepicker name="Plan Ex-Factory Date" ng-model="soSplitModel.PlanExFactoryDate" class="form-control" tabindex="108">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Shipment Mode<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Shipment Mode" class="form-control" ng-model="soSplitModel.ShipmentModeId" ng-options="item.Value as item.Text for item in shipmentModeList" required tabindex="110">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Packing Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="PackingType" class="form-control" ng-model="soSplitModel.PackingTypeId" ng-options="item.Value as item.Text for item in packingTypeList" required tabindex="105" ng-change="GetSOBookedQtyAndLevel(soModel.Id);">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" title="Destination Description">Destination Description</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" name="DestinationDescription" ng-model="soSplitModel.DestinationDescription" rows="1" maxlength="250" tabindex="119"></textarea>
                            </div>
                        </div>

                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">LSD<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" datepicker name="LSD" ng-model="soSplitModel.LSD" class="form-control" required tabindex="114">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Other RM Inhouse Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" datepicker name="Other RM Inhouse Date" ng-model="soSplitModel.OtherRawMaterialInhouseDate" class="form-control" required tabindex="116">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Shipment From Stock<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="Shipment From Stock" class="form-control" ng-model="soSplitModel.ShipmentFromStock" tabindex="102">
                                        <option value="">--Select--</option>
                                        <option value="1">Yes</option>
                                        <option value="0">No</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Reason</label>
                            <div class="col-sm-8">
                                <textarea class="form-control" ng-model="soSplitModel.Reason" rows="2" maxlength="250" tabindex="118"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li>
                                <button ng-click="saveSplitSalesOrder();" class="btn"><i class=""></i> {{soSplitModel.Id==null?'Save':'Update'}}</button>
                            </li>
                            <li>
                                <button ng-click="closeSplitSOPopUp();" class="btn">Close</button>
                            </li>
                            <li>
                                <button ng-click="genericDelete(null, 'so');" class="btn hide"><i class="glyphicon glyphicon-trash"></i> Delete</button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>