                                                <option ng-repeat="option in PackingformList" value="{{option.value}}">{{option.name}}</option>
                                            </select>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>

                        <div class="col-xs-12" ng-hide="GetFabricRollList.length>0">
