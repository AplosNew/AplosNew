                                </script>
                                <script type="text/template" id="VendorLotNo">
                                    <input type="text" class="form-control" e-enablertl="false" ng-model="data.VendorLotNo" e-width="100%" />
                                </script>
                                <script type="text/template" id="VendorWidth">
                                    <input type="text" class="form-control" ej-numerictextbox e-decimalplaces="2" e-minValue="0" e-enablertl="false" ng-model="data.VendorWidth" e-width="100%" />
                                </script>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer common-btn">
                    <button ng-click="Update();" class="btn"><i class=""></i> Update</button>
                    <button ng-click="POPupReport();" class="btn"><i class=""></i> Download</button>
                </div>
            </div>
        </div>
    </div>
</div>
