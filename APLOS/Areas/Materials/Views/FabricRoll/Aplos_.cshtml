                                    <label class="col-sm-8 control-label">{{selectedGRNRow.BaseUoM}}</label>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-4 col-md-4">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><span style="font-weight:bold;">Article :</span></label>
                                    <label class="col-sm-9 control-label">{{selectedGRNRow.ArticleName}}</label>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label"><span style="font-weight:bold">SKU3 :</span></label>
