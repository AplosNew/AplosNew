                                </div>
                                <script type="text/template" id="DeleteRollBTN">
                                    <div class="common-btn">
                                        <ul class="list-inline text-right small">
                                            <li>
                                                <button ng-click="$parent.removeRoll(this);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                                                    <i class="glyphicon glyphicon-trash" style="color: red;"></i>
                                                </button>
                                            </li>
                                            @*<li>
                                        <button ng-click="" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                                            <i class="glyphicon glyphicon-edit" style="color:olive"></i>
                                        </button>
                                    </li>*@
                                        </ul>

                                    </div>
