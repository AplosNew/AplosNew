<togglable name="Material Storage"></togglable>
<div class="form-horizontal" ng-form="buyerStyleForm">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select name="Company" ng-model="buyerStyleNew.CompanyId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in companyList" ng-change="getPlantList();" tabindex="1" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 col-md-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select name="Plant" ng-model="buyerStyleNew.PlantId" class="col-sm-3 form-control"
                            ng-options="item.Value as item.Text for item in plantList" ng-change="getDataList();" tabindex="2" required>
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements form-horizontal">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8  show-message">
                    <input type="number" name="Sequence" ng-model="buyerStyleNew.Sequence" class="form-control" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input maxlength="15" type="text" name="Short Name" ng-model="buyerStyleNew.ShortName" class="form-control" required tabindex="5">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input maxlength="50" type="text" name="User Name" ng-model="buyerStyleNew.UserName" class="form-control" required tabindex="7">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea maxlength="250" class="form-control" rows="3" ng-model="buyerStyleNew.Description" tabindex="9"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="buyerStyleNew.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input maxlength="10" type="text" ng-maxlength="15" name="Code" ng-model="buyerStyleNew.Code" class="form-control" required tabindex="4">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input maxlength="50" type="text" name="Standard Name" ng-model="buyerStyleNew.StandardName" class="form-control" required tabindex="6">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea maxlength="250" class="form-control" rows="3" ng-model="buyerStyleNew.Remarks" tabindex="8"></textarea>
                </div>
            </div>
            <div class="form-group">
                @*<label class="col-sm-4 control-label">Responsible ManPower</label>
                    <div class="col-sm-6">
                        <input type="text" name="Responsible ManPower" ng-model="buyerStyleNew.ResponsibleManPower" class="form-control" maxlength="150" tabindex="10" ng-disabled="true" />
                    </div>
                    <div class="col-sm-2">
                        <button ng-click="ResponsibleManPowerPopUp()" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                    </div>*@

                <div class="form-group">
                    <label class="col-sm-4 control-label">Responsible Person Budget Code<sup>*</sup></label>
                    <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                        <input type="hidden" name="Budget Code" ng-model="buyerStyleNew.BudgetId" class="form-control">
                        <input type="text" name="Code" ng-model="buyerStyleNew.BudgetCode" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="popUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearCode()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i>Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="12"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sequence</th>
                    <th>Code</th>
                    <th>Short Name</th>
                    <th>Standard Name</th>
                    <th>User Name</th>
                    <th>BudgetCode</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in buyerStyles |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.Sequence}}</td>
                    <td>{{x.Code}}</td>
                    <td>{{x.ShortName}}</td>
                    <td>{{x.StandardName}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.BudgetCode}}</td>
                    <td>{{x.Active? 'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10"
                                 direction-links="true"
                                 boundary-links="true"
                                 on-page-change="getData(newPageNumber)">
        </dir-pagination-controls>
    </div>
</div>


<div class="modal site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Budget Code Info<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body text-center">
                <div style="color:black;" id="POItemGrid" ej-grid e-datasource="popUpDataList" e-allowscrolling="true" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                   e-recorddoubleclick="selectDoubleClick"  e-allowResizing="true" e-allowselection="true" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="80"></div>
                        <div e-column e-type="string" e-field="EntityName" e-headertext="Entity Name" e-width="80"></div>
                        <div e-column e-type="string" e-field="PositionName" e-headertext="Position Name" e-width="150"></div>
                        <div e-column e-type="string" e-field="PositionCode" e-headertext="Position Code" e-width="80"></div>
                        <div e-column e-type="string" e-field="EntityCode" e-headertext="Entity Code" e-width="80"></div>
                        <div e-column e-type="string" e-field="EmploymentType" e-headertext="Employment Type" e-width="80"></div>
                        <div e-column e-type="string" e-field="IsOTEntitled" e-headertext="Is O T Entitled" e-width="100"></div>
                        <div e-column e-type="string" e-field="Deployment" e-headertext="Deployment" e-width="80"></div>
                        <div e-column e-type="string" e-field="IsDirect" e-headertext="Is Direct" e-width="80"></div>
                        <div e-column e-type="string" e-field="Plant" e-headertext="Plant" e-width="80"></div>
                        <div e-column e-type="string" e-field="Division" e-headertext="Division" e-width="80"></div>
                        <div e-column e-type="string" e-field="SubDivision" e-headertext="Sub Division" e-width="80"></div>
                        <div e-column e-type="string" e-field="Unit" e-headertext="Unit" e-width="80"></div>
                        <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="100"></div>
                        <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                        <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                        <div e-column e-type="string" e-field="Line" e-headertext="Line" e-width="80"></div>
                        <div e-column e-type="string" e-field="ShiftDefination" e-headertext="Shift Defination" e-width="150"></div>
                        <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-width="100"></div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>