<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> {{title}}</h3>


<div class="clearfix"></div>
<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Entries" role="tab" data-toggle="tab">General</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Reporting" role="tab" data-toggle="tab">Report</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="Processing" role="tab" data-toggle="tab">Processing</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row">
                <div class="form-elements form-horizontal" ng-form name="ModelNewForm" id="ShowForm">
                    
                        <div class="col-xs-12 col-sm-6 col-md-6">

                            <div class="form-group">
                                <label class="col-sm-4 control-label">From Entity</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="FromEntityId" name="Entity"
                                                ng-options="item.Value as item.Text for item in EntityList">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Transfer Type</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select name="voucherType" ng-model="TransferType" class="col-sm-3 form-control">
                                            <option value="Permanent"> Permanent</option>
                                            <option value="Temporary">Temporary</option>

                                        </select>
                                    </div>
                                </div>
                            </div>





                            <div class="form-group">
                                <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="input-group">
                                        <input type="text" name="ResponsiblePerson" ng-model="responsiblePerson" @*style="width:200px;"*@ class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button name="submit" ng-click="openPopupAngular('employeeNewPopUp')" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Approved By</label>
                                <div class="col-sm-8 ">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="periodId" name="PeriodList"
                                                ng-options="item.Value as item.Text for item in PeriodList">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">

                            <div class="form-group">
                                <label class="col-sm-4 control-label">To Entity</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="ToEntityId" name="Entity"
                                                ng-options="item.Value as item.Text for item in EntityList">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Days<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Days" ng-model="Days" class="form-control" tabindex="4">

                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Remarks<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <textarea name="Remarks" class="form-control" rows="2" maxlength="500" ng-model="Remarks" tabindex="7"></textarea>
                                </div>
                            </div>

                        </div>

                    
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="getAllData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-search"></i> View </button></li>
                        <li> <button ng-click="saveData();" class="btn" ng-disabled="isSaveBtnDisable" tabindex="9"><i class="glyphicon glyphicon-download"></i> Save </button></li>
                    </ul>
                </div>
                <div class="table-responsive ">
                    <div id="EmpEditsGrid" ej-grid e-datasource="ModelList" e-queryCellInfo="PeriodValidation" e-actionComplete="refreshPage"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                        <div e-columns>
                            <div e-column e-field="Material" e-headertext="Material" e-width="100"  ></div>
                            <div e-column e-field="Article" e-headertext="Article" e-width="100" ></div>
                            <div e-column e-field="ProductionMachineQty" e-headertext="ProductionMachineQty" e-width="80"></div>
                            <div e-column e-field="SampleMachineQty" e-headertext="SampleMachineQty" e-width="30"></div>

                            <div e-column e-headertext="TransferQty" e-template="#qty" e-textalign="center" e-width="80"></div>

                            @*<div e-column e-template="#btnAction" e-headertext="Actions" e-width="40"></div>*@

                        </div>
                    </div>
                </div>

                <script type="text/template" id="qty">
                    <input type="number" onkeypress="return isNumber(event)" id="pp1" ng-model="data.Qty" ng-keydown="$event.keyCode === 13 && $parent.changeInData(data,'qty')" style="color:black; text-align:center" />
                </script>

                <script type="text/template" id="btnAction">
                    <div class="common-btn">
                        <ul class="list-inline text-center">
                            <li><button ng-click="$parent.saveRowItemData(data);" class="btn"><i class="glyphicon glyphicon-floppy-save"></i></button></li>
                            <li><button ng-click="$parent.AddTile(data);" class="btn" tabindex="9"><i class="glyphicon glyphicon-plus" style="top: 1px;"></i></button></li>

                        </ul>
                    </div>
                </script>

            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">

            
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">

        </div>
    </div>
</div>

<confirm-modal></confirm-modal>

<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
@*<confirm-archive-generic modalid="confirmPopUpChild" title="Confirmation" message="Are you sure to save without any shifts ?" data-ng-click-left-button="restoreChildShifts();" data-ng-click-right-button="SaveShifts();"></confirm-archive-generic>*@

<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 46) {
            return false;
        }
        return true;
    }

                //onkeypress = "return isNumber(event)"
</script>
<div class="modal fade site-modal in" id="employeesModal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <button class="close" data-dismiss="modal">&times;</button>
                <h1 class="modal-title" style="font-size:20px; text-align:center; margin:-10px;">Responsible Person</h1>
            </div>
            <div class="modal-body" style="min-height:300px; min-width:100%;">
                <div class="row" style="margin: 20px; font-style:italic"> </div>
                <p style="margin:10px;">
                    Select The Responsible Person by Double Clicking the Choice.
                <p>

                    <div id="getCustomers" ej-grid e-datasource="EmployeeList" e-templaterefresh="refreshTemplate"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true"
                          e-allowtextwrap="true" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true"
                         e-recorddoubleclick="doubleResp">
                        <div e-columns>
                            <div e-column e-field="EmployeeCode" e-headertext="Id" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Customer" e-width="120"></div>

                        </div>
                    </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>

<div class="modal site-modal" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closePopup('employeeNewPopUp');">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color: black;" id="Grid" ej-grid e-actioncomplete="syncfusiongriddatabound" e-datasource="employee" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-type="string" e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-type="string" e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-type="string" e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-type="string" e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-type="string" e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-type="string" e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>