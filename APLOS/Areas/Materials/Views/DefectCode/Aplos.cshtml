<togglable name="Defect Code Master"></togglable>
<div ng-form id="defectCode" name="defectCodeForm">
    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Process<sup>*</sup></label>
            <div class="col-sm-4 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="defectCodeNew.ProcessId" ng-change="getData()"
                            ng-options="item.Value as item.Text for item in processIdList" id="processId"
                            name="Process" required tabindex="1">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements form-horizontal">
        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href aria-controls="defectValue" role="tab" data-toggle="tab">Defect Value</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row">
                        <input type="hidden" ng-model="defectCodeNew.Id">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Code" ng-model="defectCodeNew.Code" class="form-control" required tabindex="2" maxlength="10">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Active</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="defectCodeNew.Active" tabindex="4">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <textarea class="form-control" name="Description" required ng-model="defectCodeNew.Description" tabindex="3" maxlength="250"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row">
                        <input type="hidden" ng-model="defectCodeDetailNew.Id">
                        <input type="hidden" ng-model="defectCodeDetailNew.DefectCodeId">
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <div class="col-xs-5 col-sm-5 col-md-5">
                                @*<div class="form-group">
                                        <label class="col-sm-4 control-label">Zone<sup>*</sup></label>
                                        <div class="col-sm-8">
                                            <input type="text" name="Zone" ng-model="defectCodeDetailNew.Zone" class="form-control" required tabindex="1" maxlength="20">
                                        </div>
                                    </div>*@
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Zone<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="defectCodeDetailNew.Zone" name="Zone" id="zoneId"
                                                    ng-options="item.Value as item.Text for item in zoneList" tabindex="1"></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-5 col-sm-5 col-md-5">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Point(Minor)<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <input type="text" n-decimals="3" name="Point" ng-model="defectCodeDetailNew.Point" class="form-control" tabindex="2" value="0">
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-2 col-sm-2 col-md-2">
                                <div class="form-group">
                                    <button class="col-sm-8 btn single-small-btn" ng-click="addRow()" tabindex="10"><i class=""></i> {{CAction}}</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-12 table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Edit</th>
                                        <th>Remove</th>
                                        <th>Zone</th>
                                        <th>Point</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in defectCodeDetails">
                                        <td class="text-center table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="GetDefectCodeDetail(x.Id, $index)" class="btn-action tooltip-here" data-placement="top" title="Edit">
                                                        <i class="glyphicon glyphicon-edit"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                        <td class="text-center table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="passValue(x.Id, $index)" data-toggle="modal" data-target="#archivePopUp" class="btn-action tooltip-here"
                                                            data-placement="top" title="Remove">
                                                        <i class="glyphicon glyphicon-remove"></i>
                                                    </button>
                                                </li>
                                            </ul>
                                        </td>
                                        <td>{{x.ZoneName}}</td>
                                        <td>{{x.Point}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="5"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="6"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="7"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByDefectCodeList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in defectCodes |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-click="Get(x.Id, $index);">
                    <td>{{x.Code}}</td>
                    <td>{{x.Description}}</td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>
<confirm-archive message="Are you sure want to delete this" data-ng-click-right-button="removeRow()"></confirm-archive>
