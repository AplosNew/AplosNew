<div class="modal fade site-modal in" id="materialAttributeMasterPoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Material Attribute Master <button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="form-elements form-horizontal" ng-form="materialAttributeMasterForm">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="form-group">
                            <input type="hidden" ng-model="materialAttributeMasterNew.MaterialGroupMasterId">
                            <label class="col-sm-8 control-label">Material Group (Mst) : {{materialAttributeMasterNew.MaterialGroupMaster}}</label>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Material Attribute</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="materialAttributeMasterNew.MaterialAttributeId"
                                            ng-options="item.Value as item.Text for item in materialAttributeList" id="materialAttributeId" name="Material Attribute" tabindex="1">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <div class="form-group">
                            <label class="col-sm-5 control-label">Active</label>
                            <div class="col-sm-2">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" value="" ng-model="materialAttributeMasterNew.Active">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button ng-click="addMatarialAttributeRow('materialAttributeMasterPoUp');" class="btn single-small-btn" tabindex="2"><i class=""></i> {{ChAction}}</button>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="MatarialAttributeMasterSave();"ng-disabled="materialAttributeMasters.length==0" class="btn" tabindex="3"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        </ul>
                    </div>
                </div>
                <div class="table-responsive modal-table form-element-ctrl form-horizontal">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th ng-show="materialAttributeMasters.length>1">Sort</th>
                                <th>Sequence</th>
                                <th>Material Attribute</th>
                                <th>Free Field</th>
                                <th>Pre-Defined Field</th>
                                <th>Mandatory</th>
                                <th>Active</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in materialAttributeMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-click="">
                                <td ng-show="materialAttributeMasters.length>1">
                                    <span ng-show="!$first&&materialAttributeMasterNew.Id==null" ng-click="moveUp($index,materialAttributeMasters,'Sequence')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                    <br />
                                    <span ng-show="!$last&&materialAttributeMasterNew.Id==null" ng-click="moveDown($index,materialAttributeMasters,'Sequence')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                </td>
                                <td>{{x.Sequence}}</td>
                                <td>{{x.MaterialAttributeName}}</td>
                                <td class="text-center">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.IsFreeField">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.IsPreDefinedField">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.IsMandatory">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                                <td>
                                    <ul class="list-inline action-list">
                                        <li><button ng-disabled="materialAttributeMasterNew.Id!=null" ng-click="Select(x.Id, $index);" class="btn btn-action tooltip-here" data-toggle="tooltip" data-placement="top" title="Edit" tooltip><i class="glyphicon glyphicon-edit"></i></button></li>
                                        <li><button ng-disabled="materialAttributeMasterNew.Id!=null" ng-click="DeleteModal($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
