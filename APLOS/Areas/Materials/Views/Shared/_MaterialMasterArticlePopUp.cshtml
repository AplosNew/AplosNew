<div class="modal fade site-modal in" id="articlePoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Article<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-element-ctrl form-horizontal">
                <div></div>
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <input type="hidden" ng-model="articleNew.Id" />
                    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal" style="padding-left:0px;">
                        <div class="form-group" style="margin-bottom: 0px;">
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal" style="padding-left:0px;">
                        <div class="form-group">
                            <div class="col-sm-4">
                                <input type="text" ng-model="articleNew.Code" class="form-control" maxlength="200">
                            </div>
                            <div class="col-sm-4">
                                <input type="text" ng-model="articleNew.ShortName" class="form-control" maxlength="200">
                            </div>
                            <div class="col-sm-4">
                                <input type="text" ng-model="articleNew.StandardName" class="form-control" maxlength="200">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12" ng-show="attributeList.length>0">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Material Attribute</th>
                                    <th>Material Attribute Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in attributeList">
                                    <td> {{x.MaterialAttributeName}}</td>
                                    <td>
                                        <div class="col-sm-10">
                                            <div class="input-group" style="margin-top:-7px;">
                                                <input type="text" ng-model="x.MaterialAttributeValueFreeText" class="form-control" ng-keyup="idNullByFreeText(x.MaterialAttributeId, $index)" ng-disabled="x.FlagDisable" ng-required="x.IsMandatory">
                                                <span class="input-group-btn">
                                                    <button ng-click="valuePoUp(x, $index)" ng-disabled="!x.IsPreDefinedField" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                                                    <button ng-click="materialAttributeValueClear($index)" class="btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                                </span>
                                            </div>
                                        </div>
                                        <p class="msg-error" ng-show="IsMandatoryButNull(x.IsMandatory, x.MaterialAttributeValueFreeText)">
                                            value is required.
                                        </p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="clearfix common-btn" style="padding-right: 15px;">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="ArticleSave();" class="btn"><i class=""></i> Save</button></li>
                        <li> <button type="button" class="btn btn-default" ng-click="CloseArticlePopUp();">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>