<div class="modal fade site-modal in" id="materialAttributeValuePoUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content row">
            <div class="modal-header">{{attributeName}} Value <button type="button" class="close" ng-click="CloseMaterialMasterAttributeValue();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div id="div_1" class="form-group">
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" n-decimals="2" name="Sequence" ng-model="materialValueNew.Sequence" class="form-control text-right" tabindex="41" ng-keyup="manualValidationAddRemove('div_1','Sequence',materialValueNew);">
                        </div>
                    </div>
                    <div id="div_3" class="form-group">
                        <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short Name" maxlength="15" ng-model="materialValueNew.ShortName" class="form-control" tabindex="43" ng-keyup="manualValidationAddRemove('div_3','ShortName',materialValueNew);">
                        </div>
                    </div>
                    <div id="div_5" class="form-group">
                        <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" maxlength="50" ng-model="materialValueNew.UserName" class="form-control" tabindex="45" ng-keyup="manualValidationAddRemove('div_5','UserName',materialValueNew);">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="2" ng-model="materialValueNew.Remarks" name="Remarks" maxlength="250" tabindex="47"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div id="div_2" class="form-group">
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Code" maxlength="10" ng-model="materialValueNew.Code" class="form-control" tabindex="42" ng-keyup="manualValidationAddRemove('div_2','Code',materialValueNew);">
                        </div>
                    </div>
                    <div id="div_4" class="form-group">
                        <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" maxlength="50" ng-model="materialValueNew.StandardName" class="form-control" tabindex="44" ng-keyup="manualValidationAddRemove('div_4','StandardName',materialValueNew);">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Description</label>
                        <div class="col-sm-8">
                            <textarea type="text" maxlength="250" rows="2" ng-model="materialValueNew.Description" class="form-control" tabindex="46"></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Is Default</label>
                        <div class="col-sm-2">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialValueNew.IsDefault">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                        <label class="col-sm-3 control-label">Active</label>
                        <div class="col-sm-2">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialValueNew.Active">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="addMasterAttributeValue();" class="btn" tabindex="48"><i class="glyphicon glyphicon-plus"></i> {{materialValueAction}}</button></li>
                        <li><button ng-click="clearMasterAttributeValue();" class="btn" tabindex="49"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        <li><button ng-click="CloseMaterialMasterAttributeValue();" class="btn" tabindex="50"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Sequence</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>User Define Name</th>
                                <th>Default</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in materialValues|filter:{'MaterialAttributeId':charId}">
                                <td>
                                    <ul class="list-inline action-list">
                                        <li><button ng-click="GetMaterialMasterAttributeValue(x.Id, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i></button></li>
                                        <li><button ng-disabled="mvindex!=-1" ng-click="removeAttrValueRow(x.Id, x.UserName, 'materialValues');" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                    </ul>
                                </td>
                                <td>{{x.Sequence}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.IsDefault?'Yes':'No'}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
