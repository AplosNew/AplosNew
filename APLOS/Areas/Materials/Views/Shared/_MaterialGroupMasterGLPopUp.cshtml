<div class="modal fade site-modal in" id="MaterialMasterGroupGLModal" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="glPopUpForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Material Master Group GL</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="mMGLListParameters.searchBy">
                                            <option ng-repeat="option in searchmMGLByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="mMGLListParameters.search" ng-enter="GetMMGLData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetMMGLData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material Group </th>
                                <th>Material Master </th>
                                <th>Article </th>
                                <th>GL</th>
                                <th>Budget</th>
                                <th>Activity</th>
                                <th>RefNo</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in mMGLList |itemsPerPage:mMGLListParameters.pageSize" pagination-id="metaData.name + 'mMGLList'" total-items="mMGLListParameters.total_count"
                                ng-dblclick="setMMGLListSelected(x, $index)" ng-class="{selected : x.MaterialMasterId === rowSelected}">
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.MaterialMasterName}}</td>
                                <td>{{x.ArticleName}}</td>
                                <td>{{x.GLGeneralInfoCode}}-{{x.GLGeneralInfoName}}</td>
                                <td>{{x.BudgetName}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td>{{x.RefNo}}</td>
                                <td>{{x.CompanyCurrencyAmountDr}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10" pagination-id="metaData.name + 'mMGLList'" direction-links="true" boundary-links="true" on-page-change="GetMMGLData(newPageNumber)"></dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" ng-click="closeMMGLListPopUp()">OK</button>
            </div>
        </div>
    </div>
</div>