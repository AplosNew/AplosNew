<div class="col-xs-12 col-sm-6 col-md-6" ng-show="char1.CharacteristicsId.length>0;">
    <div class="form-group" ng-show="char1.show">
        <label class="col-sm-4 control-label">{{char1.Name}}<sup>*</sup></label>
        <div class="col-sm-8">
            <div class="input-group">
                <input type="text" ng-model="char1.FreeText" class="form-control"
                       ng-keyup="nullByFreeText('char1')" ng-disabled="char1.FlagDisable" ng-required="char1.IsMandatory">
                <span class="input-group-btn">
                    <button ng-click="findCharValueSearchData(char1, 'char1')" ng-disabled="enableControll()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="clearCharValueField('char1');" ng-disabled="enableControll()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                </span>
            </div>
            <p class="msg-error" ng-show="IsMandatoryButNull(char1.IsMandatory, char1.FreeText)">value is required.</p>
        </div>
    </div>
</div>
