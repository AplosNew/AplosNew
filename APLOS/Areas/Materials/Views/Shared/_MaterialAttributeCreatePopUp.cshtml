@using Library.Service.Enums
<div class="modal fade site-modal in" id="materialAttributeCreatePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content row">
            <div class="modal-header"> Create Attribute <button type="button" class="close" ng-click="CloseMaterialMasterAttribute();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div id="div_attr_1" class="form-group">
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="number" name="Sequence" ng-model="materialAttributeMasterNew.Sequence" class="form-control" ng-keyup="manualValidationAddRemove('div_attr_1','Sequence', materialAttributeMasterNew);" tabindex="51">
                        </div>
                    </div>
                    <div id="div_attrjs_1" class="form-group">
                        <label class="col-sm-4 control-label">Joining Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="number" name="Joining Sequence" ng-model="materialAttributeMasterNew.JoiningSequence" class="form-control" ng-keyup="manualValidationAddRemove('div_attrjs_1','Joining Sequence', materialAttributeMasterNew);" tabindex="51">
                        </div>
                    </div>
                    <div id="div_attr_3" class="form-group">
                        <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short Name" maxlength="15" ng-model="materialAttributeMasterNew.ShortName" class="form-control" ng-keyup="manualValidationAddRemove('div_attr_3','Short Name', materialAttributeMasterNew);" tabindex="53">
                        </div>
                    </div>
                    <div id="div_attr_5" class="form-group">
                        <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" maxlength="50" ng-model="materialAttributeMasterNew.UserName" class="form-control" ng-keyup="manualValidationAddRemove('div_attr_5','User Name', materialAttributeMasterNew);" tabindex="55">
                        </div>
                    </div>
                    
                    @*<div id="div_attr_7" class="form-group">
            <label class="col-sm-4 control-label">Value Assignment Level<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-model="materialAttributeMasterNew.ValueAssignmentLevel" class="form-control" name="Value Assignment" ng-change="manualValidationAddRemove('div_attr_7','ValueAssignmentLevel', materialAttributeMasterNew);"
                            ng-options="item.Value as item.Text for item in valueAssignmentList| filter:{ Value: '!FreeText'}" tabindex="57"></select>
                </div>
            </div>
        </div>*@
                    <div class="form-group" style="border: 1px solid #d8d7d7;margin-right: 0px;">
                        <label class="col-sm-2 control-label">Free Field</label>
                        <div class="col-sm-1">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialAttributeMasterNew.IsFreeField">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                        <label class="col-sm-3 control-label">Pre-Defined Field</label>
                        <div class="col-sm-1">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialAttributeMasterNew.IsPreDefinedField">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                        <label class="col-sm-2 control-label">Mandatory</label>
                        <div class="col-sm-1">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialAttributeMasterNew.IsMandatory">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" style="border: 1px solid #d8d7d7;margin-right: 0px;" ng-show="materialAttributeMasterNew.AttributeProperty=='@Html.Raw(AttributePropertiesEnum.Alphanumeric.ToString())'">
                        <label class="col-sm-4 control-label">Fixed (No Of Character)</label>
                        <div class="col-sm-1">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialAttributeMasterNew.IsFixedNoOfCharacter">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                        <label class="col-sm-3 control-label">No. of Character<sup>*</sup></label>
                        <div class="col-sm-3 show-message">
                            <input type="text" name="NoOfCharacter" only-numbers ng-model="materialAttributeMasterNew.NoOfCharacter" class="form-control text-right" ng-required="materialAttributeMasterNew.AttributeProperty=='@Html.Raw(AttributePropertiesEnum.Alphanumeric.ToString())'" tabindex="58">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Description</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="2" ng-model="materialAttributeMasterNew.Description" name="Description" maxlength="250" tabindex="59" ng-trim="false"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div id="div_attr_2" class="form-group">
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Code" maxlength="10" ng-model="materialAttributeMasterNew.Code" class="form-control" ng-keyup="manualValidationAddRemove('div_attr_2','Code', materialAttributeMasterNew);" tabindex="52">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Joining Parameter</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select name="Type" class="form-control" ng-model="materialAttributeMasterNew.JoiningParameter"
                                        ng-options="item.Value as item.Text for item in joiningParameterList">
                                    <option value="">--Select--</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div id="div_attr_4" class="form-group">
                        <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" maxlength="50" ng-model="materialAttributeMasterNew.StandardName" class="form-control" ng-keyup="manualValidationAddRemove('div_attr_4','Standard Name', materialAttributeMasterNew);" tabindex="54">
                        </div>
                    </div>

                    <div id="div_attr_6" class="form-group">
                        <label class="col-sm-4 control-label">Property<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select ng-model="materialAttributeMasterNew.AttributeProperty" class="form-control" name="Property" ng-keyup="manualValidationAddRemove('div_attr_6','Attribute Property', materialAttributeMasterNew, 'Property is required.');"
                                        ng-options="item.Value as item.Text for item in attributePropertyList" tabindex="56"></select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="2" ng-model="materialAttributeMasterNew.Remarks" name="Remarks" maxlength="250" tabindex="58" ng-trim="false"></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="materialAttributeMasterNew.Active">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="createMatarialAttribute();" class="btn" tabindex="60"><i class="glyphicon glyphicon-Crt"></i> {{attrAction}}</button></li>
                        <li> <button ng-click="ClearMaterialMasterAttribute();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        <li> <button ng-click="CloseMaterialMasterAttribute();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
