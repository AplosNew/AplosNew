<div class="modal fade site-modal in" id="searchcharactervaluepopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"> {{charValueCharName}} Data<button type="button" class="close" data-dismiss="modal">&times;</button></div>
			<div class="modal-body text-center">
				<!--Search Filter-->
				<div class="row text-right">
					<div class="col-xs-12 col-sm-12 col-sm-12 ">
						<div class="search-form">
							<div class="row">
								<div class="col-xs-12 col-sm-3 col-md-3">
									<div class="select-style">
										<select ng-model="charValueParameters.searchBy">
											<option ng-repeat="option in searchCharFilterList" value="{{option.value}}">{{option.name}}</option>
										</select>
									</div>
								</div>
								<div class="col-xs-12 col-sm-7 col-md-7">
									<input type="text" class="form-control" placeholder="Search" ng-model="charValueParameters.search" ng-enter="getSearchCharData()">
								</div>
								<div class="col-xs-12 col-sm-2 col-md-2">
									<button type="button" ng-click="getSearchCharData()" class="btn"><i class="glyphicon glyphicon-search"></i>Search</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!--Search Grid-->

				<div class="table-responsive modal-table" ng-hide="false">
					<table class="table table-striped">
						<thead>
							<tr>
								<th>Code</th>
								<th>ShortName</th>
								<th>StandardName</th>
								<th>UserName</th>
							</tr>
						</thead>
						<tbody>
							<tr dir-paginate="x in charDataList |itemsPerPage:charValueParameters.pageSize" total-items="charValueParameters.total_count"
								pagination-id="metaData.name + 'charDataList'" ng-dblclick="setCharData(x);">
								<td>{{x.Code}}</td>
								<td>{{x.ShortName}}</td>
								<td>{{x.StandardName}}</td>
								<td>{{x.UserName}}</td>
							</tr>
						</tbody>
					</table>
					<dir-pagination-controls pagination-id="metaData.name + 'charDataList'"
											 max-size="2"
											 direction-links="true"
											 boundary-links="true"
											 on-page-change="getSearchCharData(newPageNumber)">

					</dir-pagination-controls>
				</div>

				@*<div class="content-container-fluid" style="color:black;">
				
					<div style="color:black;" id="GridApproved" ej-grid e-datasource="charDataList"
						 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
						 e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
						<div e-columns>
							<div e-column e-field="Code" e-headertext="Code" e-width="30" e-filter="false"></div>
							<div e-column e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
							<div e-column e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
							<div e-column e-field="UserName" e-headertext="User Name" e-width="80"></div>
						</div>

					</div>

				</div>*@

			</div>
        </div>
    </div>
</div>