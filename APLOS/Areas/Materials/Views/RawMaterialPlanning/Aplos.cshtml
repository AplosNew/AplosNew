<div id="tarekcontainer">

</div>
<togglable name="Material Planning"></togglable>

<div class="form-horizontal form-elements" id="entrycontainer">
    <div class="row">
        <div ng-form name="RMPlanningNewForm">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Plan By<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="col-sm-10" style="padding:0px;">
                            <input type="text" name="Plan By" ng-disabled="true" ng-model="RMPlanningNew.PlanBy" class="form-control" maxlength="100" required autocomplete="off">
                        </div>
                        <div class="col-sm-2 text-left" style="padding:0px;padding-left:2px">
                            <button ng-click="selectRMPPlanBy();" class="btn single-small-btn" tabindex="6"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Plan Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Plan Name" ng-model="RMPlanningNew.UserPlanName" class="form-control" maxlength="15" required tabindex="1">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remark</label>
                    <div class="col-sm-8">
                        <input type="text" name="Remark" ng-model="RMPlanningNew.Remarks" class="form-control" maxlength="15" required tabindex="1">
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Plan Date<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control datepicker" datepicker ng-model="RMPlanningNew.PlanDate" name="Plan Date" tabindex="1">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Plan Status<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="RMPlanningNew.PlanStatus" name="PlanStatus" required
                                    ng-options="item.Value as item.Text for item in PlanStatusList">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Material Plan Type<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="RMPlanningNew.MaterialPlanType" name="MaterialPlanType" required ng-change="GetQBOQCostingData();"
                                    ng-options="item.Value as item.Text for item in MaterialPlanTypeList">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">IsActive</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="RMPlanningNew.IsActive" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-12">
                <div id="GridPlan" ej-grid e-datasource="PlanList" e-recorddoubleclick="GetPlanDetails"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                     e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                    <div e-columns>
                        <div e-column e-field="Id" e-headertext="Plan Id" e-width="3"></div>
                        <div e-column e-field="PlanBy" e-headertext="Plan By" e-width="3"></div>
                        <div e-column e-field="FormatPlanDate" e-headertext="Plan Date" e-width="3"></div>
                        <div e-column e-field="UserPlanName" e-headertext="User Plan Name" e-width="3"></div>
                        <div e-column e-field="Remarks" e-headertext="Remark" e-width="3"></div>
                        <div e-column e-field="IsActive" e-headertext="Active" e-width="3"></div>
                        <div e-column e-field="PlanStatus" e-headertext="Plan Staus " e-width="3"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet2(1) }"><a ng-click="setTab2(1)" href="" data-toggle="tab">SODetail</a></li>
                <li role="presentation" ng-class="{ active: isSet2(2) }"><a ng-click="setTab2(2);GetQBOQCostingData();" href="" data-toggle="tab">{{RMPlanningNew.MaterialPlanType}}</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(1), active: isSet2(1) }">
                <div style="color:black;" id="SOGrid" ej-grid e-datasource="SOItemList" e-allowscrolling="true"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                     e-allowselection="false" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplateSO">
                    <div e-columns>
                        <div e-column e-headertext="All" e-headertemplateid="#headerTemplateSO" e-template="#checkboxTemplateSO" e-textalign="center" e-width="50"></div>
                        <div e-column e-type="string" e-field="PlanId" e-headertext="Plan Id" e-width="80"></div>
                        <div e-column e-type="string" e-field="PlanDate" e-headertext="Plan Date" e-width="80"></div>
                        <div e-column e-type="string" e-field="SOId" e-headertext="SO No" e-width="80"></div>
                        <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                        <div e-column e-type="string" e-field="BuyerItem" e-visible="false" e-headertext="Customer Ref#" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnOrder" e-headertext="Own Ref#" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductMasterName" e-headertext="Product" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Category" e-width="80"></div>
                        <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material" e-width="100"></div>
                        <div e-column e-type="string" e-field="SOArticle" e-headertext="Article" e-width="160px"></div>
                        <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="80"></div>
                        <div e-column e-type="string" e-field="DeliveryDate" e-headertext="Delivery Date" e-width="80"></div>
                        <div e-column e-type="string" e-field="LineItemId" e-visible="false" e-headertext="LineItemId" e-width="75"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="PlannedQty" e-headertext="SO Qty" e-textalign="right" e-width="80"></div>
                        <div e-column e-template="#Remark" e-headertext="Remarks" e-width="150"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-visible="false" e-field="ItemMaterialCost" e-headertext="ItemMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-visible="false" e-field="SOMaterialCost" e-headertext="SOMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-visible="false" e-field="CostingMaterialCost" e-headertext="CostingMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-visible="false" e-field="BOQMaterialCost" e-headertext="BOQMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-visible="false" e-field="SOTotalMaterailCost" e-headertext="SOTotalMaterailCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-visible="false" e-field="CostingTotalMaterialCost" e-headertext="CostingTotalMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-visible="false" e-field="BOQTotalCost" e-headertext="BOQTotalCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-template="#TotalVarianceCostingVsSOTemplate" e-visible="false" e-field="TotalVarianceCostingVsSO" e-headertext="TotalVarianceCostingVsSO" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-template="#TotalVarianceCostingVsBOQTemplate" e-visible="false" e-field="TotalVarianceCostingVsBOQ" e-headertext="TotalVarianceCostingVsBOQ" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="PlanRate" e-visible="false" e-headertext="PlanRate" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="PlantCost" e-visible="false" e-headertext="PlantCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-template="#TotalSOCostVsTotalPlanCostTemplate" e-visible="false" e-field="TotalSOCostVsTotalPlanCost" e-headertext="TotalSOCostVsTotalPlanCost" e-textalign="right" e-width="80"></div>
                    </div>
                </div>
                <script type="text/template" id="checkboxTemplateSO">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                </script>
                <script type="text/x-jsrender" id="headerTemplateSO">
                    <input type="checkbox" id="headchk" />
                </script>
                <script type="text/template" id="Remark">
                    <div class="col-sm-12" style="padding:0px;">
                        <input type="text" name="Remark" ng-model="data.Remarks" ng-click="" class="form-control">
                    </div>
                </script>
                <script type="text/template" id="TotalVarianceCostingVsSOTemplate">
                    <div class="col-sm-10" style="padding:0px; width:70px;height:20px;">
                        <input type="text" ng-model="data.TotalVarianceCostingVsSO" disabled style="color:black; background-color:{{data.TotalVarianceCostingVsSO<0?'Red':'#d8d7d7'}}" class="form-control" />
                    </div>
                </script>
                <script type="text/template" id="TotalSOCostVsTotalPlanCostTemplate">
                    <div class="col-sm-10" style="padding:0px; width:70px;height:20px;">
                        <input type="text" ng-model="data.TotalSOCostVsTotalPlanCost" disabled style="color:black; background-color:{{data.TotalSOCostVsTotalPlanCost<0?'Red':'#d8d7d7'}}" class="form-control" />
                    </div>
                </script>
                <script type="text/template" id="TotalVarianceCostingVsBOQTemplate">
                    <div class="col-sm-10" style="padding:0px; width:70px;height:20px;">
                        <input type="text" ng-model="data.TotalVarianceCostingVsBOQ" disabled style="color:black; background-color:{{data.TotalVarianceCostingVsBOQ<0?'Red':'#d8d7d7'}}" class="form-control" />
                    </div>
                </script>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(2), active: isSet2(2) }">
                <div ng-show="RMPlanningNew.MaterialPlanType == 'QBOQ'">
                    <div style="color:black;" id="BGrid" ej-grid e-datasource="QBOQCostingList" e-allowscrolling="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                         e-allowselection="false" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplateQBOQ">
                        <div e-columns>
                            <div e-column e-headertext="All" e-headertemplateid="#headerTemplateQBOQ" e-template="#checkboxTemplateQBOQ" e-textalign="center" e-width="50"></div>
                            <div e-column e-type="string" e-field="PlanId" e-headertext="Plan Id" e-width="80"></div>
                            <div e-column e-type="string" e-field="SrNo" e-headertext="SrNo" e-width="80"></div>
                            <div e-column e-type="string" e-field="Item" e-headertext="Item" e-width="80"></div>
                            <div e-column e-type="string" e-field="UoM" e-headertext="UoM" e-width="80"></div>
                            <div e-column e-type="string" e-field="NetConsumptionPerUnit" e-headertext="Consumption" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="ValueLoss" e-headertext="ValueLoss" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="GrossConsumption" e-headertext="GrossConsumption" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="TotalConsumption" e-visible="false" e-headertext="TotalConsumption" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-template="#QAdditionReductionTemplate" e-visible="false" e-field="AdditionReduction" e-headertext="AdditionReduction" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="PlanConsumption" e-visible="false" e-headertext="PlanConsumption" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="Rate" e-headertext="Rate" e-visible="false" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="TotaPlanlAmount" e-visible="false" e-headertext="TotaPlanlAmount" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material" e-width="180"></div>
                            <div e-column e-type="string" e-field="QBOQArticle" e-headertext="Article" e-width="200px"></div>
                            <div e-column e-template="#SearchArticleTemplate" e-headertext="Article" e-visible="false" e-width="32px"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="StockRate" e-visible="false" e-headertext="StockRate" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="ActualIssueAmount" e-visible="false" e-headertext="ActualIssueAmount" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="string" e-field="ConsumptionLevel" e-template="#ConsumptionLevel" e-headertext="Consumption Level" e-width="200"></div>
                            <div e-column e-type="string" e-field="Remarks" e-template="#Remarks" e-headertext="Remarks" e-width="200"></div>
                        </div>
                    </div>
                </div>
                <div ng-show="RMPlanningNew.MaterialPlanType == 'Costing'">
                    <div style="color:black;" id="CGrid" ej-grid e-datasource="QBOQCostingList" e-allowscrolling="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                         e-allowselection="false" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplateCosting">
                        <div e-columns>
                            <div e-column e-headertext="All" e-headertemplateid="#headerTemplateCosting" e-template="#checkboxTemplateCosting" e-textalign="center" e-width="50"></div>
                            <div e-column e-type="string" e-field="PlanId" e-headertext="Plan Id" e-width="80"></div>
                            <div e-column e-type="string" e-field="SrNo" e-headertext="SrNo" e-width="80"></div>
                            <div e-column e-type="string" e-field="Item" e-headertext="Item" e-width="80"></div>
                            <div e-column e-type="string" e-field="UoM" e-headertext="UoM" e-width="80"></div>
                            <div e-column e-type="string" e-field="Consumption" e-headertext="NetConsumption" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="ValueLoss" e-headertext="ValueLoss" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="GrossConsumption" e-headertext="GrossConsumption" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="TotalConsumption" e-visible="false" e-headertext="TotalConsumption" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-template="#CAdditionReductionTemplate" e-visible="false" e-field="AdditionReduction" e-headertext="AdditionReduction" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="PlanConsumption" e-visible="false" e-headertext="PlanConsumption" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="Rate" e-visible="false" e-headertext="Rate" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="TotaPlanlAmount" e-visible="false" e-headertext="TotaPlanlAmount" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material" e-width="180"></div>
                            <div e-column e-type="string" e-field="QBOQArticle" e-headertext="Article" e-width="200px"></div>
                            <div e-column e-template="#SearchArticleTemplate" e-headertext="Article" e-visible="false" e-width="32px"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="StockRate" e-visible="false" e-headertext="StockRate" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="ActualIssueAmount" e-visible="false" e-headertext="ActualIssueAmount" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="string" e-field="ConsumptionLevel" e-template="#ConsumptionLevel" e-headertext="Consumption Level" e-width="200"></div>
                            <div e-column e-type="string" e-field="Remarks" e-template="#Remarks" e-headertext="Remarks" e-width="200"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script type="text/template" id="checkboxTemplateQBOQ">
            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
        </script>
        <script type="text/x-jsrender" id="headerTemplateQBOQ">
            <input type="checkbox" id="Qheadchk" />
        </script>
        <script type="text/template" id="checkboxTemplateCosting">
            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
        </script>
        <script type="text/x-jsrender" id="headerTemplateCosting">
            <input type="checkbox" id="Cheadchk" />
        </script>
        <script type="text/template" id="ConsumptionLevel">
            <div class="select-style">
                <select class="form-control" ng-model="data.ConsumptionLevel" name="ConsumptionLevel" required 
                        ng-options="item.Value as item.Text for item in $parent.ConsumptionLevelList">
                    <option value=""></option>
                </select>
            </div>
        </script>
        <script type="text/template" id="Remarks">
            <div class="text-left" style="width:100%">
                <input type="text" name="Remarks" ng-model="data.Remarks" class="form-control" maxlength="250" tabindex="3">
            </div>
        </script>
        <script type="text/template" id="SearchArticleTemplate">
            <div class="common-btn">
                <ul class="list-inline small">
                    <li>
                        <button ng-click="$parent.getArticle(data);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                            <i class="glyphicon glyphicon-search"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>
        <script type="text/template" id="QAdditionReductionTemplate">
            <div class="col-sm-10" style="padding:0px; width:80px;text-align:right;">
                <input type="text" class="form-control" n-decimals="4" ng-model="data.AdditionReduction" ng-blur="$parent.BoqCalculation(this)" e-width="80" style="text-align: right;" />
                @*<input type="text" ej-numerictextbox e-decimalplaces="4" e-value="data.AdditionReduction" ng-blur="$parent.BoqCalculation(this)" e-width="80" />*@
            </div>
        </script>
        <script type="text/template" id="CAdditionReductionTemplate">
            <div class="col-sm-10" style="padding:0px; width:80px;text-align:right;">
                <input type="text" class="form-control" n-decimals="4" ng-model="data.AdditionReduction" ng-blur="$parent.CostCalculation(this)" e-width="80" style="text-align: right;" />
                @*<input type="text" ej-numerictextbox e-decimalplaces="4" e-value="data.AdditionReduction" ng-blur="$parent.CostCalculation(this)" e-width="80" />*@
            </div>
        </script>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>

