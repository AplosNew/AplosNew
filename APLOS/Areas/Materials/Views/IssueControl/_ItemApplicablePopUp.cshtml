<div class="modal fade site-modal in" id="itemApplicablePopUpid" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> Item Applicable <button type="button" class="close" ng-click="closeSicknessPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Machine</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="MAObject.MachineApplicable" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Order Level<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" ng-model="MAObject.OrderLevel" required name="Order Level"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option value="LineItem">Line Item</option>
                                        <option value="ProductionOrder">Production Order</option>
                                        <option value="SalesOrder">Sales Order</option>

                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Work Center<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="MAObject.WorkCenterApplicable" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
               
                <ul class="common-btn list-inline text-right">
                   
                    <li><button ng-click="closeItemApplicablePopUp()"  class="btn"> Close</button></li>
                </ul>

            </div>
        </div>
    </div>
</div>

