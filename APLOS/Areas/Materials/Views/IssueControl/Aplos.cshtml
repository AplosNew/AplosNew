<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">User Name </label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="30">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Material Type</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-change="getMaterialGroup()" ng-model="ModelNew.MaterialTypeId" required name="Material Type"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in MaterialTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Material</label>
                <div class="col-sm-8 show-message">

                    <input e-change="getMaterialArticle" ej-dropdownlist e-enablefiltersearch="true" e-datasource="MaterialList" ng-model="ModelNew.MaterialMasterId" e-fields-value="Value" e-fields-text="Text" e-width="100%" />

                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Material Level<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.MaterialLevel" ng-change="ViewMaterialAndArticle()" required name="Storage Location"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="Material">Material</option>
                            <option value="Article">Article</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Material Group</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <input e-change="getMaterial" ej-dropdownlist e-enablefiltersearch="true" e-datasource="MaterialGroupList" ng-model="ModelNew.MaterialGroupMasterId" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>
        </div>
        <div class="common-btn">

            <div class="col-xs-12 col-lg-3 col-md-3"></div>
            <ul class="list-inline text-right">


                <li> <button ng-click="ViewMaterialAndArticle();" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> View</button></li>
                <li> <button ng-click="Save();" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>

            </ul>

        </div>
    </div>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                @*<li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Service" role="tab" data-toggle="tab">Item Applicable</a></li>*@
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Material Allocation</a></li>


            </ul>
        </div>
        <div class="tab-content">
            <!--<div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">-->
            @*#region*@


            <!--</div>-->

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Work Center</label>
                            <div class="col-sm-8 show-message">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="ModelNew.IsWorkCenterApplicable" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Machine</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="ModelNew.IsMachineApplicable" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Order Level</label>
                            <div class="col-sm-6 show-message">
                                <div class="select-style">
                                    <select id="OrderLevelId" class="form-control" ng-model="ModelNew.OrderLevel" required name="Order Level"
                                            tabindex="2">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in EnumList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="Apply();" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> Apply</button></li>
                                <li> <button ng-click="SaveIssueControlChild();" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
                            </ul>
                        </div>
                    </div>

                </div>
                <div class="clearfix"></div>
                <div class="table-responsive modal-table" id="MaterialId">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material </th>
                                <th ng-show="ModelNew.MaterialLevel=='Article'">Article </th>
                                <th>WorkCener Applicable</th>
                                <th>Machine Applicable</th>
                                <th>Order Level</th>
                                @*<th>Action</th>*@
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in MaterialArticleList">
                                <td>{{x.MaterialName}}</td>
                                <td ng-show="ModelNew.MaterialLevel=='Article'">{{x.ArticleName}}</td>
                                <td>
                                    <input type="checkbox" ej-checkbox class="rowCheckbox" ng-model="x.IsWorkCenterApplicable" e-checked="x.IsWorkCenterApplicable" e-value="x.IsWorkCenterApplicable" />
                                </td>
                                <td>
                                    <input type="checkbox" ej-checkbox class="rowCheckbox" ng-model="x.IsMachineApplicable" e-checked="x.IsMachineApplicable" e-value="x.IsMachineApplicable" />
                                </td>
                                <td>
                                    {{x.OrderLevelTex}}
                                </td>
                                @*<td>
                                        <div class="common-btn">

                                            <ul class="list-inline text-right">
                                                <li> <button ng-click="$parent.openItemApplicablePopUp(this);" class="btn" tabindex="11"><i class="glyphicon glyphicon-floppy-disk"></i> Update</button></li>
                                            </ul>

                                        </div>
                                    </td>*@
                            </tr>
                        </tbody>
                    </table>
                </div>

                @*<div class="common-btn" style="margin-top:20px">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="SaveIssueControlChild();" ng-disabled="tempIdList.length===0" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        </ul>
                    </div>*@
            </div>


        </div>

    </div>
</div>
@*----------------------------------HEAD CLOSED------------------------------------------------------*@

<div class="table-responsive aplos-grid-toggle">
    <div ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="UserName" e-headertext="UserName" e-width="2"></div>
            <div e-column e-field="MaterialLevel" e-headertext="MaterialLevel" e-width="3"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="5"></div>
        </div>
    </div>
</div>


<!--*************************************************************************************-->
<style>
    #ArticleId {
        display: none;
    }

    .modellgModify1 {
        width: 1300px;
    }

    .cmn-btn {
        background: #3e445a none repeat scroll 0 0;
        border: 1px solid #3e445a;
        border-radius: unset;
        color: #fff;
        font-size: 15px;
        /* font-weight: 600; */
        letter-spacing: 0.65px;
        line-height: normal;
        padding: 6px 15px;
        text-transform: none;
        transition: all 0.3s linear 0s;
    }

        .cmn-btn:hover {
            background: #EA6153 none repeat scroll 0 0;
            border: 1px solid #EA6153;
            color: #fff !important;
            outline: none;
        }
</style>

@Html.Partial("~/Areas/Materials/Views/IssueControl/_ItemApplicablePopUp.cshtml")





