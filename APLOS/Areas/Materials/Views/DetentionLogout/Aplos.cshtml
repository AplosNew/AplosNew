                                    <td class="text-right table-td">
                                        <ul class="list-inline action-list">
                                            <li>
                                                <button ng-click="removeDetentionLResPerson(x.EmployeeName, $index, 'DetLogResPersonList', x.Id, 'ResponsiblePersonid')" class="btn btn-action tooltip-here" data-placement="top" title="Update"><i class="glyphicon glyphicon-remove"></i></button>
