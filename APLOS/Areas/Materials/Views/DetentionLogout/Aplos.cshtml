            </div>*@
                <div class="modal fade site-modal in" id="ResponiblePersonPop" role="dialog" data-backdrop="static">
                    <div class="modal-dialog modal-lg modellgModify">
                        <div class="modal-content">
                            <div class="modal-header">Responible Person List <button type="button" class="close" data-dismiss="modal">&times;</button></div>
                            <div class="modal-body form-elements form-horizontal">
                                <div class="col-md-12">
                                    <div class="content-container-fluid" style="color:black;overflow:scroll">

                                        <div style="color:black;" id="GridResponsible" ej-grid e-datasource="ResponsibleList"
                                             e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowfiltering="true"
                                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false" e-responsive="true"
                                             e-templaterefresh="ResponsiblePersonGridAllCheck">
                                            <div e-columns>
                                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                                                <div e-column e-field="ResponsiblePerson" e-headertext="Employee Name" e-width="100"></div>
                                                <div e-column e-field="Department" e-headertext="Department" e-width="120"></div>
                                                <div e-column e-field="Section" e-headertext="Section" e-width="120"></div>
                                                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="120"></div>
                                                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="120"></div>

                                            </div>
                                        </div>
                                        <script type="text/x-jsrender" id="headerTemplate">
                                            <input type="checkbox" id="headchk" />
                                        </script>
                                        <script type="text/template" id="checkboxTemplate">
                                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-value="data.isActive" e-checked="data.isActive" />
                                        </script>

                                    </div>
                                </div>
                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li><button type="button" ng-click="SaveResponsiblePerson();" class="btn btn-default">Add</button></li>
                                        <li><button ng-click="closeResponsiblePopUp();" class="btn"><i class=""></i> Close</button></li>
                                    </ul>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                @{
                    Html.RenderPartial("_DetentionLogout");
                }
            </div>

           
        </div>
    </div>
</div>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="DetentionLogGridList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="40" e-isprimarykey="true"></div>
            <div e-column e-field="WorkCenter" e-headertext="WorkCenter" e-width="100"></div>
            <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
            <div e-column e-field="DetentionType" e-headertext="Detention Type" e-width="100"></div>
            <div e-column e-field="Process" e-headertext="Process" e-width="100"></div>

            <div e-column e-field="IssueByNo" e-headertext="Issue By No." e-width="100"></div>
            <div e-column e-field="LoginTime" e-headertext="Log Time" e-width="100"></div>
           
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>
            <div e-column e-field="isClose" e-headertext="is Close" e-width="100"></div>
        </div>
    </div>

</div>



<confirm-archive-generic modalid="confirmRemoveDetentionLRPersonPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeDetentiontRow();"></confirm-archive-generic>







