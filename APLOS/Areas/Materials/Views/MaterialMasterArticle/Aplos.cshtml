<h3 class="site-heading" style="cursor:unset;"><span class="glyphicon glyphicon-info-sign"></span> Material Master Article</h3>
<div class="site-tab">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="doc" role="tab" data-toggle="tab">Article</a></li>
        <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Production Grouping</a></li>
    </ul>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
        <togglable name="{{title}}"></togglable>
        <div class="form-elements form-horizontal row" ng-form="form">
            <div class="col-md-12 divborder">
                <div class="col-xs-12 col-sm-12 col-md-12">
                    <div class="form-group">
                        <label class="col-sm-2 control-label">Material (Mst)<sup>*</sup></label>
                        <div class="col-sm-4 show-message">
                            <div class="input-group">
                                <input type="text" name="Mterial (Mst)" ng-model="model.UserName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="popUp();" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Code :</label>
                        <label class="col-sm-8 control-label">{{model.Code}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Standard Name :</label>
                        <label class="col-sm-8 control-label">{{model.StandardName}}</label>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">ShortName :</label>
                        <label class="col-sm-8 control-label">{{model.ShortName}}</label>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">BaseUoM :</label>
                        <label class="col-sm-8 control-label">{{model.BaseUom}}</label>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">HSN Code :</label>
                        <label class="col-sm-8 control-label">{{model.HSNCode}}</label>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <ul class="list-inline">
                        <li><button ng-click="articleFormPopUp();" ng-disabled="model.UserName==null" class="btn"> Add Article</button></li>
                    </ul>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> {{Action}}</button></li>
                        @*<li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i>Delete</button></li>*@
                        <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="12"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            <div class="col-md-12 table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Actions</th>
                            <th>Code</th>
                            <th>Short Name</th>
                            <th>Standard Name</th>
                            <th>User Name</th>
                            <th>HSN Code</th>
                            <th>Machine</th>
                            <th>Work Center</th>
                            <th>Order Level</th>
                            <th>Active</th>
                            <th ng-repeat="x in articleHead">{{x.MaterialAttributeName}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in articleList">
                            <td class="text-right table-td">
                                <ul class="list-inline action-list">
                                    <li><button ng-click="edit(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-edit"></i></button></li>
                                    <li><button ng-click="ArticleAliasData(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="ArticleAlias"><i class="glyphicon glyphicon-th-list"></i></button></li>
                                    <li><button ng-click="deleteModal(x, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                </ul>
                            </td>
                            <td>{{x.Code}}</td>
                            <td>{{x.ShortName}}</td>
                            <td>{{x.StandardName}}</td>
                            <td>{{x.UserName}}</td>
                            <td>{{x.HSNCode}}</td>
                            <td>{{x.IsMachineApplicable?'Yes':'No'}}</td>
                            <td>{{x.IsWorkCenterApplicable?'Yes':'No'}}</td>
                            <td>{{x.OrderLevel}}</td>
                            <td>{{x.Active?'Yes':'No'}}</td>
                            <td ng-repeat="y in x.MaterialMasterArticleValues">{{y.MaterialAttributeValueFreeText}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
        <togglable name="Production Grouping"></togglable>
        <div class="form-elements form-horizontal" ng-form name="ModelNewForm">
            <input type="hidden" ng-model="ModelNew.Id">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100%" required />
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Name" ng-model="ModelNew.UserName"  ng-keyup="CheckSpecialCharecter();" class="form-control" required tabindex="5" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Description</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" rows="3" ng-model="ModelNew.Description" tabindex="7" maxlength="250"></textarea>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required tabindex="2" maxlength="10">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Active</label>
                    <div class="col-sm-3">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="ModelNew.Active" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                    
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="SaveProductionGrouping();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button ng-click="ClearPG();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>
        
        <div class="table-responsive aplos-grid-toggle">
            <div id="GridPG" ej-grid e-datasource="PGModelList" e-recorddoubleclick="GetProductionGrouping" e-load="loadGridEdit"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
                    <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
                    <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
                    <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
                    <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
                    <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
                    <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>
<!-- #region Material Master -->
<div class="modal fade site-modal in" id="popUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="materialgridCharacteristicsForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Material</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in searchbyMaterialMasterDatalist" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="getPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Material Type</th>
                                <th>Material Group</th>
                                <th>Product</th>
                                <th>Code</th>
                                <th>User Name</th>
                                <th>UOM</th>
                                <th>Standard Name</th>
                                <th>Short Name</th>
                                <th>IsAsset</th>
                                <th>Asset Master</th>
                                <th>Budget Code</th>
                                <th>Activity</th>
                                <th>Id</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count" ng-dblclick="selectDoubleClick(x);" ng-click="selectSingleClick(x);">
                                <td>{{x.MaterialTypeName}}</td>
                                <td>{{x.MaterialGroupMasterName}}</td>
                                <td>{{x.ProductMasterName}}</td>
                                <td>{{x.Code}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.BaseUom}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.IsAsset}}</td>
                                <td>{{x.AssetMasterName}}</td>
                                <td>{{x.AssetBudgetCode}}</td>
                                <td>{{x.ActivityName}}</td>
                                <td>{{x.Id}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getPopUpData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer  common-btn">
                <ul class="list-inline text-right">
                    <li><button data-ng-click="selectByButton()" class="btn"><i class=""></i> Select</button></li>
                    <li><button data-ng-click="closePopUp()" class="btn btn-default">Cancel</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
<!-- #region Article -->
<div class="modal fade site-modal in" id="articlePoUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Article<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-element-ctrl form-horizontal">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <input type="hidden" ng-model="articleNew.Id" />
                    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal" style="padding-left:0px;">
                        <div class="form-group" style="margin-bottom: 0px;">
                            <label class="col-sm-2 control-label">Code<sup>*</sup></label>
                            <label class="col-sm-3 control-label">Short Name<sup>*</sup></label>
                            <label class="col-sm-3 control-label">Standard Name<sup>*</sup></label>
                            <label class="col-sm-2 control-label">User Name</label>
                            <label class="col-sm-2 control-label"></label>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 form-element-ctrl form-horizontal" style="padding-left:0px;">
                        <div class="form-group">
                            <div class="col-sm-2">
                                <input type="text" ng-model="articleNew.Code" class="form-control" maxlength="200" disabled>
                            </div>
                            <div class="col-sm-3">
                                <input type="text" ng-model="articleNew.ShortName" class="form-control" maxlength="200">
                            </div>
                            <div class="col-sm-3">
                                <input type="text" ng-model="articleNew.StandardName" class="form-control" maxlength="200">
                            </div>
                            <div class="col-sm-2">
                                <input type="text" ng-model="articleNew.UserName" disabled class="form-control" maxlength="200" style="width: 180px;">
                            </div>
                            <div class="form-group">
                                <div class="col-sm-2">
                                    <ul class="list-inline text-right">
                                        <li><button ng-click="Generate();" class="btn" style="margin-top: -23px; background: #3e445a; color:#fff !important"><i class=""></i> Generate</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 form-element-ctrl form-horizontal" style="padding-left:0px;">
                        <div class="col-md-2 form-element-ctrl form-horizontal" style="padding-left:0px;">
                            <div class="form-group">
                                <label class="col-sm-8 control-label">Work Center</label>
                                <div class="col-sm-4">
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="articleNew.IsWorkCenterApplicable" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-8 control-label">Active</label>
                                <div class="col-sm-4">
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="articleNew.Active" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 form-element-ctrl form-horizontal" style="padding-left:0px;">
                            <div class="form-group">
                                <label class="col-sm-8 control-label">Machine</label>
                                <div class="col-sm-4">
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="articleNew.IsMachineApplicable" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-5 control-label" title="Production Grouping">PrO Grouping<sup>*</sup></label>
                                <div class="col-sm-7">
                                    <div class="select-style">
                                        <select name="Production Grouping" class="form-control" ng-model="articleNew.ProductionGroupingId" ng-options="item.Value as item.Text for item in ProductionGroupingCboList" tabindex="6">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-5 control-label" title="Process Constraint">Process Constraint<sup>*</sup></label>
                                <div class="col-sm-7">
                                    <div class="select-style">
                                        <select name="Production Grouping" class="form-control" ng-model="articleNew.ProcessConstraint" ng-options="item.Value as item.Text for item in ProductionGroupingCboList" tabindex="6">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 form-element-ctrl form-horizontal" style="padding-left:0px;">
                            <div class="form-group">
                                <label class="col-sm-5 control-label">Order Level</label>
                                <div class="col-sm-7">
                                    <div class="select-style">
                                        <select id="OrderLevelId" class="form-control" ng-model="articleNew.OrderLevel" name="Order Level" tabindex="2">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in EnumList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Process Set<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <input type="text" name="Process Set" ng-model="articleNew.ProcessSet" class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button ng-click="processSetPopUp();" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 form-element-ctrl form-horizontal" style="padding-left:0px;">
                            <div class="form-group">
                                <label class="col-sm-5 control-label">HSN Code</label>
                                <div class="col-sm-7">
                                    <input ej-dropdownlist e-enablefiltersearch="true" e-name="$index" e-datasource="hsnCodeList" e-value="articleNew.HSNCodeId" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 form-element-ctrl form-horizontal" style="padding-left:0px;">
                            <div class="form-group">
                                <label class="col-sm-8 control-label">Is Default Production Grouping</label>
                                <div class="col-sm-4">
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="articleNew.IsDefaultProductionGrouping" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 form-element-ctrl form-horizontal" style="padding-left:0px;">
                            <div class="form-group">
                                <label class="col-sm-8 control-label">Is Default ProcessSet</label>
                                <div class="col-sm-4">
                                    <div class="checkbox-site">
                                        <label class="control-label">
                                            <input type="checkbox" ng-model="articleNew.IsDefaultProcessSet" tabindex="8">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                    <div class="col-xs-12 col-sm-12 col-md-12" ng-show="attributeList.length>0">
                        <div class="table-responsive modal-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Material Attribute</th>
                                        <th>Material Attribute Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in attributeList">
                                        <td> {{x.MaterialAttributeName}}</td>
                                        <td>
                                            <div class="col-sm-10">
                                                <div class="input-group" style="margin-top:-2px;">
                                                    <input type="text" ng-model="x.MaterialAttributeValueFreeText" class="form-control" ng-keyup="idNullByFreeText(x.MaterialAttributeId, $index)" ng-disabled="x.FlagDisable" ng-required="x.IsMandatory" maxlength="50">
                                                    <span class="input-group-btn">
                                                        <button ng-click="valuePoUp(x, $index)" ng-disabled="!x.IsPreDefinedField" class="btn"><i class="glyphicon glyphicon-search"></i></button>
                                                        <button ng-click="materialAttributeValueClear($index)" class="btn"><i class="glyphicon glyphicon-refresh"></i></button>
                                                    </span>
                                                </div>
                                            </div>
                                            <p class="msg-error" ng-show="IsMandatoryButNull(x.IsMandatory, x.MaterialAttributeValueFreeText)">
                                                value is required.
                                            </p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="clearfix common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-show="index==-1" ng-click="AddArticle();" class="btn"><i class=""></i> Add</button></li>
                            <li> <button ng-hide="index==-1" ng-click="updateArticle();" class="btn"><i class=""></i> Update</button></li>
                            <li> <button type="button" class="btn btn-default" ng-click="CloseArticlePopUp();">Close</button></li>
                        </ul>
                    </div>
                </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="ArticleAliasPoUp" role="dialog" data-backdrop="static" style="overflow-y: auto !important;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Article Alias<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div ng-form="articleAliasForm">
                <div class="modal-body form-element-ctrl form-horizontal">
                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">Party Code<sup>*</sup></label>
                                    <div class="col-sm-10"><input type="text" ng-model="articleAlias.Code" disabled class="form-control" maxlength="50"></div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label" title="Article Party Name">Article Party Name<sup>*</sup></label>
                                    <div class="col-sm-10"><input type="text" placeholder="Article Party Name" ng-model="articleAlias.ArticlePartyName" class="form-control" maxlength="100"></div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">Remark</label>
                                    <div class="col-sm-10"><input type="text" ng-model="articleAlias.Remark" class="form-control" maxlength="100"></div>
                                </div>
                            </div>
                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">Party<sup>*</sup></label>
                                    <div class="input-group">
                                        <input type="text" name="Party" ng-model="articleAlias.PartyName" class="form-control" readonly>
                                        <span class="input-group-btn">
                                            <button ng-click="showPartyPopUpNew();" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">User Group<sup>*</sup></label>
                                    <div class="col-sm-10"><input type="text" ng-model="articleAlias.UserGroup" class="form-control" maxlength="50"></div>
                                </div>
                                <div class="clearfix common-btn" style="padding-right: 15px;">
                                    <div class="common-btn">
                                        <ul class="list-inline text-right">
                                            <li><button ng-click="SaveArticleAlias();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="10"></i> {{Action}}</button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                </div>
               
            </div>

        </div>
    </div>
</div>

