<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Material Master GL
</h3>
<div class="form-elements form-horizontal" ng-form name="fixedAssetGLNewForm">
    <input type="hidden" ng-model="fixedAssetGL.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Fixed Asset Master</label>
                <div class="col-sm-8 show-message">
                    <div ng-dropdown-multiselect="" options="fixedAssetMasterNewList" selected-model="fixedAssetMasterIds"
                         extra-settings="multiSelectSettings" events="multi4events"></div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4  control-label">COA<sup>*</sup></label>
                <div class="col-sm-8 ">
                    <div class="select-style">
                        <select class="form-control" ng-model="fixedAssetGL.COAId"
                                ng-options="item.Value as item.Text for item in COAList" ng-change="clearGlField();getAllWithCoa();">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Material Master</label>
                <div class="col-sm-8">
                    <div ng-dropdown-multiselect="" options="assetItemNewList" selected-model="materialMasterIds"
                         extra-settings="multiSelectSettings" events="multi3events"></div>
                </div>
            </div>
        </div>

        <div class="col-xs-12">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button ng-click="getFixedAssetMasterWithCoa('assing');setActiveBtn('assing');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> All Assign</button></li>
                        @*<li>
                            <button ng-click="getFixedAssetMasterWithCoa('notassing');setActiveBtn('notassing');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> Not Assign</button>
                        </li>*@
                        <li>
                            <button ng-click="getFixedAssetMasterWithCoa('all');setGlLebelHide();setActiveBtn('all');" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-search"></i> All</button>
                        </li>
                    </ul>
                </div>

            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li>
                            <button ng-click="clearSearchDropDown();" class="btn ng-binding" tabindex="9"><i class="glyphicon glyphicon-refresh"></i></button>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
