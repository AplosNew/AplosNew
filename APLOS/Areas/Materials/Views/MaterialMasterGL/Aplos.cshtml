                        <th colspan="3">Less Value Asset</th>
                        <th style=" text-align:center" colspan="3" ng-repeat=" y in accountGroupList">
                            {{y.UserName}}
                        </th>
                        <th style="vertical-align: middle; text-align:center" rowspan="2"> Untag</th>
                    </tr>
                    <tr>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th>GL</th>
                        <th>Budget</th>
                        <th>Activity</th>
                        <th ng-repeat=" y in childHeaderAcG track by $index">
                            {{y}}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr dir-paginate="x in selectFixedAssetMasterWithCombineList|itemsPerPage:$root.pageSize" pagination-id="metaData.name + 'selectFixedAssetMasterWithCombineList'" total-items="$root.total_count">
                        <td>
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" id="{{x.MaterialMasterId}}" ng-model="x.Flag" ng-checked="x.Flag" ng-click="selectChValueId($event,x.MaterialMasterId,x)">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </td>
                        <td>{{x.MaterialMasterName}}</td>
                        <td>
                            <span ng-show="btnActionAll">{{x.AssetGLInfo}}</span>
                        </td>
                        <td>{{x.AssetBudgetName}}</td>
                        <td>{{x.AssetActivityName}}</td>
                        <td>
                            <span ng-show="btnActionAll">{{x.AccDepreciationGLInfo}}</span>
                        </td>
                        <td>{{x.AccumulatedDepreciationBudgetName}}</td>
                        <td>{{x.AccumulatedDepreciationActivityName}}</td>
                        <td>
                            <span ng-show="btnActionAll">{{x.DepreciationGLInfo}}</span>
                        </td>
                        <td>{{x.DepreciationBudgetName}}</td>
                        <td>{{x.DepreciationActivityName}}</td>
                        <td>
                            <span ng-show="btnActionAll">{{x.AUCGLInfo}}</span>
                        </td>
                        <td>{{x.AssetUnderConstructionBudgetName}}</td>
                        <td>{{x.AssetUnderConstructionActivityName}}</td>
                        <td>
                            <span ng-show="btnActionAll">{{x.DownPaymentGLInfo}}</span>
                        </td>
                        <td>{{x.DownPaymentBudgetName}}</td>
                        <td>{{x.DownPaymentActivityName}}</td>
