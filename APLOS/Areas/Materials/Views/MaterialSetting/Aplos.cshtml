<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Material Setting
</h3>
<div class="form-elements form-horizontal" ng-form name="materialSettingForm">
    <div class="row">
        <input type="hidden" ng-model="materialSettingNew.Id">
        <div class="col-xs-12 col-sm-5 col-md-5">
            <div class="form-group">
                <label class="col-sm-4 control-label">Type</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="materialSettingNew.MaterialMasterTypeId" name="MaterialMasterType" ng-options="item.Value as item.Text for item in materialMasterTypeList" tabindex="6">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-5 col-md-5">
            <div class="form-group">
                <label class="col-sm-4 control-label">Type Value</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="materialSettingNew.TypeValue" name="Order Status" ng-options="item.Value as item.Text for item in materialTypeEnumList" tabindex="6">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-plus-sign" tabindex="10"></i></button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="10"></i></button></li>
                </ul>
            </div>
        </div>
    </div>
<div class="table-responsive modal-table">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Type</th>
                <th>Type Value</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in materialSettings">
                <td>{{x.Type}}</td>
                <td>{{x.TypeValue}}</td>
                <td class="text-right table-td">
                    <ul class="list-inline action-list">
                        <li>
                            <button ng-click="Get(x, $index);" class="btn btn-action tooltip-here" data-placement="top" title="Edit">
                                <i class="glyphicon glyphicon-pencil"></i>
                            </button>
                            <button ng-click="removeRowModal(x, $index);" class="btn btn-action tooltip-here" data-placement="top" title="Remove">
                                <i class="glyphicon glyphicon-remove"></i>
                            </button>
                        </li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
</div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete()"></confirm-archive-generic>
