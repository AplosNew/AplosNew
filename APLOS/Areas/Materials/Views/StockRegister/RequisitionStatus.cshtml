<div id="Test">
    <h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Requisition Status</h3>
    <div class="form-elements form-horizontal">
        <div class="col-xs-12 col-sm-12 col-md-12" ng-form="from0">
            <div class="col-xs-12 col-sm-12 col-md-12">
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">Requisition Status</legend>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <div class="col-sm-6 radio">
                                <label>
                                    <input ng-click="clearAllEmployee()" type="radio" name="source" ng-model="Employee" value="AllEmployee">
                                    <span class="cr" tabindex="17"><i class="cr-icon"></i></span>All
                                </label>
                                <label>
                                    <input ng-click="clearSingleEmployee()" type="radio" name="source" ng-model="Employee" value="@Library.Model.Parties.PartyType.Employee.ToString()">
                                    <span class="cr" tabindex="18"><i class="cr-icon"></i></span>@Library.Model.Parties.PartyType.Employee.ToString()
                                </label>

                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Form Date" ng-model="RequisitionFromDate" datepicker tabindex="3" class="form-control">
                            </div>
                        </div>

                        
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Status<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select class="form-control" id="Type" ng-model="RequisitionStatus" required name="Type" tabindex="2">
                                        <option value="All">All</option>
                                        <option value="Regular">Regular</option>
                                        <option value="Irregular">Irregular</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Form Date" ng-model="RequisitionToDate" datepicker tabindex="3" class="form-control">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-4">
                        <div class="form-group">
                            <div ng-hide="Employee=='AllEmployee'">
                                <label class="col-sm-4 control-label">@Library.Model.Parties.PartyType.Employee.ToString()<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <div class="input-group">
                                        <input tabindex="1" type="text" name="@Library.Model.Parties.PartyType.Employee.ToString()" ng-model="EmployeeName" class="form-control" readonly required>
                                        <span class="input-group-btn">
                                            <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="2"><i class="glyphicon glyphicon-search"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        

                        

                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li><button ng-click="GetRequisitionStatus();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> View</button></li>
                            </ul>
                        </div>
                    </div>
                </fieldset>

            </div>
        </div>

        <div class="clearfix"></div>
        <fieldset class="scheduler-border">
            <legend class="scheduler-border"><span style="color:maroon;font-weight:bold;">Requisition Status</span></legend>
            <div id="PR">
                <div class="content-container-fluid" style="color:black;">

                    <div style="color:black;" id="GridRequisitionStatus" ej-grid e-datasource="RequisitionStatusList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                         e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionCompleteSelected"
                         e-allowscrolling="true" e-showstackedheader="true" e-allowExcelExport='true' e-enableGroupingBar="true">

                        <div e-columns>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="100"></div>
                            <div e-column e-field="EN" e-headertext="Employee Name" e-width="120"></div>
                            <div e-column e-field="EntityName" e-headertext="Entity" e-width="150"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="150"></div>
                            <div e-column e-field="Division" e-headertext="Division" e-width="150"></div>
                            <div e-column e-field="Id" e-headertext="Id" e-width="80" textAlign='Left'></div>
                            <div e-column e-field="RequisitionDate" e-headertext="Requisition Date" e-width="90" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="ROWId" e-headertext="Row Id" e-width="90"></div>
                            <div e-column e-field="Material" e-headertext="Material" e-width="150"></div>
                            <div e-column e-field="Article" e-headertext="Article" e-width="150"></div>
                            <div e-column e-field="UOM" e-headertext="UOM" e-width="80"></div>
                            <div e-column e-field="ReqQty" e-headertext="Req Qty" e-width="90" textAlign='Right'></div>
                            <div e-column e-field="POQty" e-headertext="PO Qty" e-width="90" textAlign='Right'></div>
                            <div e-column e-field="POAmount" e-headertext="PO Amount" e-width="90" textAlign='Right'></div>
                            <div e-column e-field="BalancePOQty" e-headertext="Balance POQty" e-width="90" textAlign='Right'></div>
                            <div e-column e-field="GRNQty" e-headertext="GRN Qty" e-width="90" textAlign='Right'></div>
                            <div e-column e-field="GRNAmount" e-headertext="GRN Amount" e-width="90" textAlign='Right'></div>
                            <div e-column e-field="IssueQty" e-headertext="Issue Qty" e-width="90" textAlign='Right'></div>
                            <div e-column e-field="SalesQty" e-headertext="Sales Qty" e-width="90" textAlign='Right'></div>
                            <div e-column e-field="BalanceToReceive" e-headertext="Balance To Receive" e-width="90" textAlign='Right'></div>
                            <div e-column e-field="ReqStatus" e-headertext="Requisition Status" e-width="120" textAlign='Right'></div>
                            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="110" textAlign='Right'></div>
                        </div>

                    </div>

                </div>
            </div>
        </fieldset>

        <div class="common-btn">
            <ul class="list-inline text-left">
                <li>
                    <div ej-tooltip e-showshadow="true" e-content="Export To Excel" ng-click="RequisitionStatusReportExcel();" e-width="width">
                        <button class="btn"><i class="glyphicon glyphicon-cloud-download"></i>Download</button>
                    </div>
                </li>
            </ul>
        </div>
        <div class="clearfix"></div>


    </div>
</div>

@Html.Partial("~/Areas/Employees/Views/Shared/_EmployeePopUp.cshtml")
<confirm-archive-generic modalid="confirmSavePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="clearDataOnEmployeeChange()"></confirm-archive-generic>

