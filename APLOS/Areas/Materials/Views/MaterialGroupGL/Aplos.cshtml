<div class="modal fade site-modal in" id="VendorReconListPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" ng-form name="DownPaymentListForm">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Vendor Recon GL</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="vendorReconListParameters.searchBy">
                                            <option ng-repeat="option in searchVendorReconByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="vendorReconListParameters.search" ng-enter="GetVendorReconListData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="GetVendorReconListData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>COA</th>
                                <th>Account Group     </th>
                                <th>GL Code</th>
                                <th>GL </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in VendorReconGlList |itemsPerPage:vendorReconListParameters.pageSize" pagination-id="metaData.name + 'VendorReconGlList'" total-items="vendorReconListParameters.total_count"
                                ng-click="setVendorReconGLSelected(x)" ng-dblclick="closeVendorReconListPopUpSelected();" ng-class="{selected : x.GLGeneralInfoCode === rowSelected}">
                                <td>{{x.COAName}}</td>
                                <td>{{x.AccountGroupName}}</td>
                                <td>{{x.GLGeneralInfoCode}}</td>
                                <td>{{x.GLGeneralInfoName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'VendorReconGlList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="GetVendorReconListData(newPageNumber)">
                </dir-pagination-controls>

                <div class="common-btn">
                </div>
            </div>
            <div class="modal-footer  common-btn">
                <button type="button" class="btn btn-default" ng-click="closeVendorReconListPopUpSelected()">Select</button>
            </div>
        </div>
    </div>
</div>
