<style>
    .listClass {
        width: auto;
        text-align: right;
    }

    .listClassLbl {
        width: 170px;
        text-align: left;
        font-weight: normal;
    }

    .customLbl {
        padding-right: 0px;
    }

    .customControl {
        padding-left: 0px;
        padding-right: 20px;
    }

    .selected {
        background-color: rgba(234, 97, 83, 0.42) !important;
