                                <select ng-model="materialMasterNew.SalesOrderUOMId" class="form-control" name="Sales Ord UOM" required
                                        @*ng-disabled="UsedInPO==true || UsedInBOM==true"*@ ng-options="item.Value as item.Text for item in oirUoMList|orderBy:'Text'" tabindex="14">
