        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
            <div class="row" ng-form name="materialMasterFormTab4">
                <div class="col-md-2">
                    <button ng-click="materialAttributeCreatePopUp();" class="btn single-small-btn" tabindex="41"><i class=""></i> Create Attribute</button>
                </div>
                <div class="col-md-4">
                    <div class="form-group" id="div_Attr" show-errors>
                        <label class="col-sm-4 control-label">Material Attribute</label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select class="form-control" ng-model="materialAttributeMasterNew.MaterialAttributeId" name="Material Attribute" ng-change="change();"
                                        ng-options="item.Value as item.Text for item in materialAttributeList" tabindex="40">
