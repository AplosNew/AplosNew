<togglable name="Material Master"></togglable>
<div class="form-elements form-horizontal" ng-form="materialMasterNewForm">
    <input type="hidden" ng-model="materialMasterNew.Id">
    <div class="col-xs-12 divborder mark">
        <div class="col-xs-12 col-sm-4 col-md-4 pdr3">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Material Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select ng-model="materialMasterNew.MaterialTypeId" class="form-control" name="Material type" ng-change="ChangeMaterialType();"
                                ng-options="item.Value as item.Text for item in materialTypeList" required tabindex="1">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Code</label>
                <div class="col-sm-8">
                    <input type="text" name="Code" ng-model="materialMasterNew.Code" class="form-control" tabindex="3" disabled maxlength="100">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Std Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="StandardName" ng-model="materialMasterNew.StandardName" class="form-control" required tabindex="5" maxlength="100">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4 pdl3 pdr3">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Sequence" ng-model="materialMasterNew.Sequence" class="form-control" required tabindex="2">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="ShortName" ng-model="materialMasterNew.ShortName" class="form-control" maxlength="100" required tabindex="4">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="UserName" ng-model="materialMasterNew.UserName" class="form-control" required tabindex="6" maxlength="100">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4 pdr3 tab-design">
            <div class="form-group">
                <label class="col-sm-6 control-label">Material Picture</label>
                <div class="col-sm-6">
                    <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="border: 1px dashed; height: 86px; width: 100px;" />
                </div>
                <div class="col-sm-6">
                    <input ng-file-select type="file" accept=".png,.jpg" id="uploadImage" name="file" />
                </div>
                <div class="col-sm-4">
                    <button ng-click="DocumentRemove(materialMasterNew.Id);" class="btn single-small-btn"><i class="glyphicon glyphicon-remove"></i></button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-2 site-tab">
        <ul class="nav nav-tabs tabs-left" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">General</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Alternative UOM</a></li>
            <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" data-toggle="tab">Advance</a></li>
            <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" data-toggle="tab">Material Attribute</a></li>
            <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5)" href="" data-toggle="tab">SKU</a></li>
            @*<li role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" data-toggle="tab" ng-show="processRoutingTabe">Process Routing</a></li>*@
            <li role="presentation" ng-class="{ active: isSet(6) }"><a ng-click="setTab(6)" href="" data-toggle="tab" ng-show="productMst">Product Master</a></li>
            <li role="presentation" ng-class="{ active: isSet(7) }"><a ng-click="setTab(7)" href="" data-toggle="tab">Process Set</a></li>

        </ul>
    </div>
    <div class="col-xs-10 tab-content">
        <!-- #region General -->
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row" ng-form name="materialMasterFormTab1">
                <div class="col-xs-12 col-sm-4 col-md-4 pdr3">
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Material Category</label>
                        <div class="col-sm-7">
                            <div class="select-style">
                                <select ng-model="materialMasterNew.MaterialCategoryId" class="form-control"
                                        ng-options="item.Value as item.Text for item in materialCategoryList" tabindex="6">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">HSN Code</label>
                        <div class="col-sm-7">
                            @*<div class="select-style">
                                <select class="form-control" ng-model="materialMasterNew.HSNCodeId" ng-options="item.Value as item.Text for item in hsnCodeList">
                                    <option value=""></option>
                                </select>
                            </div>*@
                            <input ej-dropdownlist e-enablefiltersearch="true" e-name="$index" e-datasource="hsnCodeList" e-value="materialMasterNew.HSNCodeId" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Origin Applicable</label>
                        <div class="col-sm-7">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialMasterNew.IsOriginApplicable">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Material Master Type</label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select class="form-control" ng-model="materialMasterNew.MaterialMasterTypeId" name="MaterialMasterType" ng-options="item.Value as item.Text for item in materialMasterTypeList" tabindex="6">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Work Center</label>
                        <div class="col-sm-7">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialMasterNew.IsWorkCenterApplicable" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4 pdl3 pdr3">
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Material SubCategory</label>
                        <div class="col-sm-7">
                            <div class="select-style">
                                <select ng-model="materialMasterNew.MaterialSubCategoryId" class="form-control"
                                        ng-options="item.Value as item.Text for item in materialSubCategoryList" tabindex="7">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Test Std</label>
                        <div class="col-sm-7">
                            <div class="select-style">
                                <select class="form-control" ng-model="materialMasterNew.TestingStandardId"
                                        ng-options="item.Value as item.Text for item in testingStdList" tabindex="10">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Is Regular</label>
                        <div class="col-sm-7">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialMasterNew.IsRegular">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Issue By UoM</label>
                        <div class="col-sm-7">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialMasterNew.IssueByUoM">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Machine</label>
                        <div class="col-sm-7">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialMasterNew.IsMachineApplicable" tabindex="8">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4 pdl3">
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Material Group<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="input-group">
                                <input type="text" name="Mterial Group (Mst)" ng-model="materialMasterNew.MaterialGroupMasterName" class="form-control" readonly required>
                                <span class="input-group-btn">
                                    <button ng-click="popUp();" ng-disabled="subMaterialList.length>0" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-5 control-label">Base UOM<sup>*</sup></label>
                        <div class="col-sm-7 show-message">
                            <div class="select-style">
                                <select submit-="true" ng-model="materialMasterNew.BaseUOMId" class="form-control" name="BaseUOM" required
                                        id="baseUOMId" ng-disabled="materialMasterAlternativeUOMs.length>0" ng-options="item.Value as item.Text for item in uOMList" ng-change="putValueInAltUom();createUomList();" tabindex="8">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Active</label>
                        <div class="col-sm-7">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialMasterNew.Active">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Is Replacement</label>
                        <div class="col-sm-7">
                            <div class="checkbox-site">
                                <label class="control-label">
                                    <input type="checkbox" ng-model="materialMasterNew.IsReplacement">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    
                   
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Order Level</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select id="OrderLevelId" class="form-control" ng-model="materialMasterNew.OrderLevel" name="Order Level"
                                        tabindex="2">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in EnumList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Asset/Capital</legend>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Asset/Capital</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" ng-model="materialMasterNew.IsAsset" ng-click="isAsset($event);">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors ng-show="materialMasterNew.IsAsset">
                            <label class="col-sm-4 control-label">Asset Master<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Asset master" ng-model="materialMasterNew.AssetMasterName" class="form-control" ng-required="materialMasterNew.IsAsset" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="getFixedAssetMasterData();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors ng-show="materialMasterNew.IsAsset">
                            <label class="col-sm-4 control-label">Budget Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Budget Code" ng-model="materialMasterNew.AssetBudgetCode" class="form-control" ng-required="materialMasterNew.IsAsset" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="assetBudgetPopUp();" type="submit" class="btn single-small-btn pull-right"><i class="glyphicon glyphicon-search"></i></button>
                                    </span>
