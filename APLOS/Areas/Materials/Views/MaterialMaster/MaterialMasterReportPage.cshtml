<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Material Master Report
</h3>
<div class="form-elements form-horizontal" ng-form id="materialMasterReportNew" name="materialMasterNewReportForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-3 control-label">Material Type</label>
            <div class="col-sm-7 show-message">
                <div class="select-style">
                    <select submit-="true" ng-model="materialMasterReportNew.MaterialTypeId" class="form-control" name="MaterialType"
                            ng-options="item.Value as item.Text for item in materialTypeList" required tabindex="1">
                        <option value=""></option>
                    </select>
                </div>
                <p ng-show="selectMessage" style="color:red" class="show-message">{{selectMessage}}</p>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-3 control-label">With Article</label>
            <div class="col-sm-7">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="materialMasterReportNew.WithArticle" tabindex="2">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="getMasterReport2();" class="btn"><i class="glyphicon glyphicon-print"></i> Print</button></li>
        </ul>
    </div>
</div>

<confirm-modal></confirm-modal>
