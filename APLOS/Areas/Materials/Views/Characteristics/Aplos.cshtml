@using Library.Service.Enums
<togglable name="Characteristics"></togglable>
<div class="form-elements form-horizontal" ng-form="characteristicsNewForm">
    <input type="hidden" ng-model="characteristicsNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" n-decimals="2" name="Sequence" ng-model="characteristicsNew.Sequence" class="form-control text-right" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" maxlength="15" ng-model="characteristicsNew.ShortName" class="form-control" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Define Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" maxlength="50" ng-model="characteristicsNew.UserName" class="form-control" required tabindex="5">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Value Assignment Level<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-model="characteristicsNew.ValueAssignmentLevel" class="form-control" name="Value Assignment" required
                            ng-options="item.Value as item.Text for item in valueAssignmentList| filter:{ Value: '!FreeText'}" tabindex="7"></select>
                </div>
            </div>
        </div>
        <div class="form-group" style="border: 1px solid #d8d7d7;margin-right: 0px;">
            <label class="col-sm-2 control-label">Free Field</label>
            <div class="col-sm-1">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="characteristicsNew.IsFreeField">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-3 control-label">Pre-Defined Field</label>
            <div class="col-sm-1">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="characteristicsNew.IsPreDefinedField">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label class="col-sm-2 control-label">Mandatory</label>
            <div class="col-sm-1">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="characteristicsNew.IsMandatory">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group" style="border: 1px solid #d8d7d7;margin-right: 0px;" ng-show="characteristicsNew.AttributeProperty=='@Html.Raw(AttributePropertiesEnum.Alphanumeric.ToString())'">
            <label class="col-sm-4 control-label">Is Fixed (No Of Character)</label>
            <div class="col-sm-1">
                <div class="checkbox-site">
                    <label class="control-label">
                        <input type="checkbox" ng-model="characteristicsNew.IsFixedNoOfCharacter">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <div show-errors>
                <label class="col-sm-4 control-label">No. of Character<sup>*</sup></label>
                <div class="col-sm-3 show-message">
                    <input type="text" name="NoOfCharacter" only-numbers ng-model="characteristicsNew.NoOfCharacter" class="form-control text-right" ng-required="characteristicsNew.AttributeProperty=='@Html.Raw(AttributePropertiesEnum.Alphanumeric.ToString())'" tabindex="8">
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="characteristicsNew.Active">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" maxlength="10" ng-model="characteristicsNew.Code" class="form-control" required tabindex="2">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" maxlength="50" ng-model="characteristicsNew.StandardName" class="form-control" tabindex="4" required>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Property<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select ng-model="characteristicsNew.AttributeProperty" class="form-control" name="Property" required
                            ng-options="item.Value as item.Text for item in attributePropertyList" tabindex="6"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="2" ng-model="characteristicsNew.Remarks" name="Remarks" maxlength="250" tabindex="8" ng-trim="false"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="2" ng-model="characteristicsNew.Description" name="Description" maxlength="250" tabindex="9" ng-trim="false"></textarea>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12 ">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchCharacteristicsByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Sequence</th>
                    <th>Code</th>
                    <th>Short Name</th>
                    <th>Standard Name</th>
                    <th>User Define Name</th>
                    <th tootipe title="Value Assignment Level">Value Assig.Lvl</th>
                    <th>Attribute Property</th>
                    <th>Fixed(Character)</th>
                    <th>NoOfCharacter</th>
                    <th>Free Field</th>
                    <th>PreDefinedField</th>
                    <th>Mandatory</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in characterlist |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.Sequence}}</td>
                    <td>{{x.Code}}</td>
                    <td>{{x.ShortName}}</td>
                    <td>{{x.StandardName}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.ValueAssignmentLevel}}</td>
                    <td>{{x.AttributeProperty}}</td>
                    <td>{{x.IsFixedNoOfCharacter?'Yes':'No'}}</td>
                    <td>{{x.NoOfCharacter}}</td>
                    <td>{{x.IsFreeField?'Yes':'No'}}</td>
                    <td>{{x.IsPreDefinedField?'Yes':'No'}}</td>
                    <td>{{x.IsMandatory?'Yes':'No'}}</td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<confirm-modal></confirm-modal>