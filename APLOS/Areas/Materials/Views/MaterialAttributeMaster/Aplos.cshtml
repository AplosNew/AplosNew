<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-info-sign"></span> Material Attribute Master</h3>
<div class="form-elements form-horizontal" ng-form="materialAttributeMasterForm">
    <input type="hidden" ng-model="materialAttributeMasterNew.Id">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="form-group" show-errors>
            <label class="col-sm-2 control-label">Material Group (Mst)<sup>*</sup></label>
            <div class="col-sm-4 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                <input type="text" name="Material Group(Mst)" ng-model="materialAttributeMasterNew.MaterialGroupMaster" class="form-control" readonly>
                <span class="input-group-btn">
                    <button ng-click="matarialGroupPopUp();" ng-disabled="materialAttributeMasters.length>0" class="btn single-small-btn" tabindex="5"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="materialGroupClear()" ng-disabled="materialAttributeMasters.length>0" class="btn single-small-btn" tabindex="6"><i class="glyphicon glyphicon-refresh"></i></button>
                </span>
            </div>
        </div>
        <div class="form-group" style="font-size:11px;margin-top: -10px;padding-left: 194px;">{{gethierarchyList}}</div>
    </div>
    <div class="col-md-12" style="border: 1px solid #d8d7d7;margin-right: 0px;padding-top: 10px;margin-bottom: 10px;">
        <div class="col-xs-12 col-sm-6 col-md-6" style="margin-left: -12px;">
            <div class="form-group">
                <label class="col-sm-4 control-label">Material Attribute</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="materialAttributeMasterNew.MaterialAttributeId" id="materialAttributeId"
                                ng-options="item.Value as item.Text for item in materialAttributeList" ng-change="change();"
                                name="Material Attribute" tabindex="3">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label class="control-label">
                            <input type="checkbox" value="" ng-model="materialAttributeMasterNew.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-1 col-md-1">
            <button ng-click="addMatarialAttributeRow()" class="btn single-small-btn" tabindex="3"><i class=""></i> {{ChAction}}</button>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="MatarialAttributeSave();" class="btn" tabindex="6"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="7"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn" tabindex="8"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table form-element-ctrl form-horizontal" ng-show="materialAttributeMasters.length>0">
    <table class="table table-striped">
        <thead>
            <tr>
                <th ng-show="materialAttributeMasters.length>1">Sort</th>
                <th>Sequence</th>
                <th>Material Attribute</th>
                <th>Free Field</th>
                <th>Pre-Defined Field</th>
                <th>Mandatory</th>
                <th>Active</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="x in materialAttributeMasters">
                <td ng-show="materialAttributeMasters.length>1">
                    <span ng-show="!$first&&materialAttributeMasterNew.Id==null" ng-click="moveUp($index, materialAttributeMasters,'Sequence')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                    <br />
                    <span ng-show="!$last&&materialAttributeMasterNew.Id==null" ng-click="moveDown($index, materialAttributeMasters,'Sequence')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                </td>
                <td>{{x.Sequence}}</td>
                <td>{{x.MaterialAttributeName}}</td>
                <td>{{x.IsFreeField?'Yes':'No'}}</td>
                <td>{{x.IsPreDefinedField?'Yes':'No'}}</td>
                <td>{{x.IsMandatory?'Yes':'No'}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
                <td>
                    <ul class="list-inline action-list">
                        @*<li><button ng-disabled="materialAttributeMasterNew.Id!=null" ng-click="Select(x.Id, $index);" class="btn btn-action tooltip-here" data-toggle="tooltip" data-placement="top" title="Edit" tooltip><i class="glyphicon glyphicon-edit"></i></button></li>*@
                        <li><button ng-disabled="materialAttributeMasterNew.Id!=null" ng-click="DeleteModal($index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<!-- #region MaterialGroupMaster -->
<modal-table modalid="popUpId"
             title={{popUpTitle}}
             data-search-parameters="popUpParameters"
             data-exclued-column-list="Code"
             data-field-list="popUpList"
             data-data-list="popUpDataList"
             data-search-function="getPopUpData"
             data-single-click="selectSingleClick(data)"
             data-double-click="selectDoubleClick(data)"
             data-right-button="true"
             data-left-button="true"
             data-ng-click-left-button="selectByButton()"
             data-ng-click-cancel="closePopUp()">
</modal-table>
<!-- #endregion -->
<confirm-archive-generic modalid="materialMaster" title="Confirmation" message={{subMaterialMessage}} data-ng-click-right-button="removeMaterialAttributeRow()"></confirm-archive-generic>