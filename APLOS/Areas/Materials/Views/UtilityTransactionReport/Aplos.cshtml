<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>&nbsp;{{title}}</h3>

<div class="row">
    <div class="form-elements form-horizontal" ng-form="modelForm">
        <div class="col-xs-12 col-sm-12 col-sm-12 ">
            <div class="col-md-4">
                <div class="form-group" show-errors id="div_FromDate">
                    <label class="col-sm-3 control-label">Utility Group<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <select name="Category" class="form-control" ng-model="UtilityGroupId" ng-options="item.Value as item.Text for item in UserGroupList" tabindex="13" required>
                            <option value="">--Select--</option>
                        </select>
                        @*<input id="datepicker" e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="FromDate" e-width="100%" />*@
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" show-errors id="div_FromDate">
                    <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="Form Date" ng-model="FromDate" datepicker class="form-control">
                        @*<input id="datepicker" e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="FromDate" e-width="100%" />*@
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group" show-errors id="div_ToDate">
                    <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-7 show-message">
                        <input type="text" name="To Date" ng-model="ToDate" datepicker class="form-control">
                        @*<input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="ToDate" e-width="100%" />*@
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="getUtilityTransactionData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-ok-circle"></i> View </button></li>
                    </ul>
                </div>
            </div>
            @*<div id="filters">
        </div>*@


        </div>
    </div>
</div>
<div class="row" style="margin:10px; margin-left:15px;">
    <div class="row">
        <div class="table-responsive">
            <div id="GridEdit" ej-grid e-datasource="UtilityTransactionList" @*e-recorddoubleclick="GetDet"*@
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    @*<div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>*@
                    <div e-column e-field="TransactionDate" e-headertext="TransactionDate" e-width="2"></div>
                    <div e-column e-field="UtilityMasterName" e-headertext="UtilityMasterName" e-width="2"></div>
                    <div e-column e-field="InputSouceName" e-headertext="InputSouceName" e-width="3"></div>
                    <div e-column e-field="TransactionQuantity" e-headertext="TransactionQuantity" e-width="3"></div>
                    <div e-column e-field="SumOfChild" e-headertext="SumOfChild" e-width="3"></div>
                    <div e-column e-field="NetQty" e-headertext="NetQty" @*e-type="number"*@ e-width="3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 text-left" style="margin-top:20px;">
    <button type="button" class="btn single-btn" ng-click="UtilityTransactionReport()" style="margin-top:10px;"><i class="glyphicon glyphicon-arrow-down"></i>Download</button>
</div>

<confirm-modal></confirm-modal>
