<div id="Test">

    <h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Material Issue Report</h3>
    <div class="form-elements form-horizontal" ng-form="from0">
        <div class="col-xs-12 col-sm-6 col-md-6">

            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Select Options</legend>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 col-xs-4 control-label" title="Select Option" tooltip>Select Option<sup>*</sup></label>
                        <div class="radio col-sm-8 col-xs-8">
                            <label>
                                <input type="radio" name="As On Date" ng-click="change('AsOnDate')" ng-model="productNew.AsOnDate" value="AsOnDate">
                                <span class="cr" tabindex="14"><i class="cr-icon"></i></span>As On Date
                            </label>
                            <label>
                                <input type="radio" name="As On Date" ng-click="change('ForThePeriod')" ng-model="productNew.AsOnDate" value="ForThePeriod">
                                <span class="cr" tabindex="15"><i class="cr-icon"></i></span>For The Period
                            </label>
                        </div>
                    </div>


                </div>


                <div class="clearfix"></div>
                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-1">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="productNew.Qty" value="Qty">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                    <label class="col-sm-4 control-label"> Qty</label>
                </div>
                <div class="clearfix"></div>
                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-1">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="productNew.Amount" value="Amount">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                    <label class="col-sm-4 control-label">Amount</label>
                </div>


                <div class="clearfix"></div>
                <div class="form-group" show-errors id="div_FromDate">
                    <label class="col-sm-3 control-label" ng-hide="productNew.AsOnDate==='AsOnDate'">From Date<sup>*</sup></label>
                    <div class="col-sm-9 show-message">
                        <input type="text" name="Form Date" ng-model="report.FromDate" datepicker tabindex="2" class="form-control" ng-hide="productNew.AsOnDate==='AsOnDate'">  @*ng-disabled="productNew.AsOnDate==='AsOnDate'"*@
                    </div>
                </div>
                <div class="form-group" show-errors id="div_ToDate">
                    <label class="col-sm-3 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-9  show-message">
                        <input type="text" name="To Date" ng-model="report.ToDate" datepicker tabindex="3" class="form-control">
                    </div>
                </div>
                <div class="clearfix"></div>
                @*<div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-1">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="productNew.RcptIssue" ng-disabled="productNew.AsOnDate==='AsOnDate'">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                    <label class="col-sm-4 control-label"> With Receipts & Issue</label>*
                </div>*@

            </fieldset>
        </div>
        @*<div class="common-btn">
            <ul class="list-inline text-left">

                <li> <button id="" class="btn" ng-click="MaterialIssueReportPdf();"><i class="glyphicon glyphicon-download"></i> Export To Pdf</button></li>
                <li> <button id="" class="btn" ng-click="MaterialIssueReportExcel();"><i class="glyphicon glyphicon-download"></i> Export To Excel</button></li>
            </ul>
        </div>*@

        <div class="common-btn">
            <ul class="list-inline text-left">

                <li>
                    <div ej-tooltip e-showshadow="true" e-content="All active orders with individual line items" ng-click="MaterialIssueReportPdf('Pdf');" e-width="width">
                        <button class="btn"><i class="glyphicon glyphicon-download"></i>Export To Pdf</button>
                    </div>
                </li>

                <li>
                    <div ej-tooltip e-showshadow="true" e-content="All active orders with individual line items" ng-click="MaterialIssueReportExcel('Excel');" e-width="width">
                        <button class="btn"><i class="glyphicon glyphicon-download"></i>Export To Excel</button>
                    </div>
                </li>
            </ul>
        </div>
        <div class="clearfix"></div>

    </div>
</div>
