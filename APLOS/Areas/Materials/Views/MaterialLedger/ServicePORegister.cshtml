<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="form-elements form-horizontal">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="col-xs-6 col-sm-6 col-md-6">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Filter By PO Date</legend>
                <div class="clearfix"></div>
                <div class="form-group" id="div_FromDate">
                    <label class="col-sm-3 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-9 show-message">
                        <input type="text" name="Form Date" ng-model="report.FromDate" datepicker tabindex="2" class="form-control">
                    </div>
                </div>

                <div class="form-group" id="div_ToDate">
                    <label class="col-sm-3 control-label">TO Date<sup>*</sup></label>
                    <div class="col-sm-9  show-message">
                        <input type="text" name="To Date" ng-model="report.ToDate" datepicker tabindex="3" class="form-control">
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="getPurchaseRegisterReport();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> View</button></li>
                    </ul>
                </div>
            </fieldset>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-left">
            <li>
                <div ej-tooltip e-showshadow="true" e-content="Export To Pdf" ng-click="PurchaseOrderReportPdf('Pdf');" e-width="width">
                    <button class="btn"><i class="glyphicon glyphicon-file"></i>Export To Pdf</button>
                </div>
            </li>
            <li>
                <div ej-tooltip e-showshadow="true" e-content="Export To Excel" ng-click="PurchaseOrderReportExcel('Excel');" e-width="width">
                    <button class="btn"><i class="glyphicon glyphicon-file"></i>Export To Excel</button>
                </div>
            </li>
        </ul>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div style="color:black;" id="GridPrint" ej-grid e-datasource="PurchaseRegisterLst"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                 e-filtersettings-filterType="excel" e-enabletouch="true" e-actioncomplete="actionCompleteSelected"
                 e-allowscrolling="true" e-showstackedheader="true" e-allowExcelExport='true' e-enableGroupingBar="true">
                <div e-columns>
                    <div e-column e-field="POId" e-headertext="PO No" e-width="100" textAlign='Left'></div>
                    <div e-column e-field="PODate" e-headertext="PO Date" e-width="100" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                    <div e-column e-field="POType" e-headertext="PO Type" e-width="130" textAlign='Center'></div>
                    <div e-column e-field="PartyName" e-headertext="Party" e-width="180" textAlign='Left'></div>
                    <div e-column e-field="DocRefNo" e-headertext="Doc Ref No" e-width="100"></div>
                    <div e-column e-field="DocDate" e-headertext="Doc Ref Date" e-width="100"></div>
                    <div e-column e-field="ServiceGroup" e-headertext="Service Group" e-width="180"></div>
                    <div e-column e-field="ServiceName" e-headertext="Service Name" e-width="250"></div>
                    <div e-column e-field="InvoicingPartyPlant" e-headertext="Invoicing Party Plant" e-width="200"></div>
                    <div e-column e-field="DeliveryPartyPlant" e-headertext="Delivery Party Plant" e-width="180"></div>                    
                    <div e-column e-field="HSNCode" e-headertext="HSNCode" e-width="80"></div>
                    <div e-column e-field="TransactionQty" e-headertext="Transaction Qty" e-format="{0:N2}" e-width="130" textAlign='Right'></div>
                    <div e-column e-field="TransactionRate" e-headertext="Transaction Rate" e-format="{0:N4}" e-width="130" textAlign='Right'></div>
                    <div e-column e-field="TransactionAmount" e-headertext="Transaction Amount" e-format="{0:N2}" e-width="130"></div>
                    <div e-column e-field="TotalTaxAmount" e-headertext="Total Tax Amount" e-format="{0:N2}" e-width="180" textAlign='Right'></div>
                    <div e-column e-field="ServiceCharge" e-headertext="Service Charge" e-format="{0:N2}" e-width="130" textAlign='Right'></div>
                    <div e-column e-field="ServiceChargeTax" e-headertext="Service Charge Tax" e-format="{0:N2}" e-width="130" textAlign='Right'></div>
                    <div e-column e-field="BaseAmount" e-headertext="Base Amount" e-format="{0:N2}" e-width="130" textAlign='Right'></div>
                    <div e-column e-field="CGST" e-headertext="CGST" e-width="130" e-format="{0:N2}" textAlign='Right'></div>
                    <div e-column e-field="CGSTTaxPercentage" e-headertext="CGST Tax Percentage" e-format="{0:N2}" e-width="130" textAlign='Right'></div>
                    <div e-column e-field="SGST" e-headertext="SGST" e-width="130" e-format="{0:N2}" textAlign='Right'></div>
                    <div e-column e-field="SGSTTaxPercentage" e-headertext="SGST Tax Percentage" e-format="{0:N2}" e-width="130" textAlign='Right'></div>
                    <div e-column e-field="IGST" e-headertext="IGST" e-width="130" e-format="{0:N2}" textAlign='Right'></div>
                    <div e-column e-field="IGSTTaxPercentage" e-headertext="IGST Tax Percentage" e-format="{0:N2}" e-width="130" textAlign='Right'></div>
                    <div e-column e-field="TDS" e-headertext="TDS" e-width="130" e-format="{0:N2}" textAlign='Right'></div>
                    <div e-column e-field="TDSTaxPercentage" e-headertext="TDS Tax Percentage" e-width="130" textAlign='Right'></div>
                    <div e-column e-field="TCS" e-headertext="TCS" e-width="130" e-format="{0:N2}" textAlign='Right'></div>
                    <div e-column e-field="TCSTaxPercentage" e-headertext="TCS Tax Percentage" e-format="{0:N2}" e-width="130" textAlign='Right'></div>
                    <div e-column e-field="AddedBy" e-headertext="Prepared By" e-width="130"></div>
                    <div e-column e-field="CheckedBY" e-headertext="Checking Name" e-width="130"></div>
                    <div e-column e-field="AuthorizedBy" e-headertext="Approving Name" e-width="130"></div>
                    <div e-column e-field="LCANo" e-headertext="LCANo" e-width="130"></div>
                    <div e-column e-field="LCRef" e-headertext="LCRef" e-width="130"></div>
                    <div e-column e-field="ContractId" e-headertext="ContractId" e-width="130"></div>
                    <div e-column e-field="RefferenceNo" e-headertext="RefferenceNo" e-width="130"></div>
                </div>
            </div>
        </div>
    </div>
</div>
