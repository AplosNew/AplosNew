                <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select name="EntityId" ng-model="EntityId" ng-change="getData();" class="form-control"
                                ng-options="item.Id as item.UserName for item in entityList" tabindex="1" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
