                </div>
            </div>*@
        <div class="clearfix"></div>
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Production Orders</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);GetSavedData();" href="" data-toggle="tab">Pending Data</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);GetSavedData();" href="" data-toggle="tab">Issue Data</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select name="entityId" ng-model="ModelNew.EntityId" ng-change="getData();GetEntityName();" class="form-control"
                                        ng-options="item.Value as item.Text for item in entityList" tabindex="1" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="PRSearchColumn">
                                            <option ng-repeat="option in modelFilterByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="PRSearchValue" ng-enter="getData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-12" style="color:black;">
                        <div id="GridSaved" e-load="actionCompleteSearch" ej-grid e-datasource="modelList" e-recorddoubleclick="Get" e-rowdatabound="rowDataBoundOrder"
                             e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                             e-cellselected="cellSelected" e-selectiontype="single" e-actioncomplete="syncfusiongriddatabound"
                             e-allowscrolling="true" e-minwidth="450" e-minheight="400" e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="Prd.Order ID" e-width="50"></div>
                                <div e-column e-type="string" e-field="ProductionStatus" e-headertext="Production Status" e-width="80"></div>
                                <div e-column e-type="string" e-field="SONo" e-headertext="SO Nos" e-width="100"></div>
                                <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="180"></div>
                                <div e-column e-type="string" e-field="BuyerRefNo" e-headertext="Cust. Order#" e-width="100"></div>
                                <div e-column e-type="string" e-field="SODesc" e-headertext="SO Desc" e-width="100"></div>
                                <div e-column e-type="string" e-field="SOQty" e-headertext="SO Qty" e-width="80"></div>
                                <div e-column e-type="string" e-field="POQuantity" e-headertext="PO Qty" e-width="80"></div>

