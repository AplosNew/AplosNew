<div id="tarekcontainer">

</div>
<togglable name="Material Issue Control Approval"></togglable>

<div class="form-horizontal form-elements" id="entrycontainer">
    <div class="row">
        <div ng-form name="ModelNewForm">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Code<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Code" disabled ng-model="ModelNew.UserCode" class="form-control" maxlength="15" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Ref#<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Ref" disabled ng-model="ModelNew.UserRef" class="form-control" maxlength="15" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Plan(%)<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Plan Percentage" disabled ng-model="ModelNew.PlanPercentage" only-numbers class="form-control" required tabindex="3">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">By Whom<sup>*</sup></label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input type="text" name="ByWhom" ng-model="ModelNew.ByWhom" class="form-control" readonly tabindex="115">
                            <span class="input-group-btn">
                                <button ng-click="showEmployeeListPopUp();" disabled class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Name"disabled ng-model="ModelNew.UserName" class="form-control" maxlength="50" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Lot No<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="LotNo"disabled ng-model="ModelNew.LotNo" class="form-control" maxlength="50" required tabindex="3">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Level</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" disabled ng-model="ModelNew.Level" name="Level">
                                <option value="">--Select--</option>
                                <option value="Costing">Costing</option>
                                <option value="QBOQ">QBOQ</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" disabled rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="6"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">SODetail</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" data-toggle="tab">{{ModelNew.Level}}</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div style="color:black;" id="SOGrid" ej-grid e-datasource="SOItemList" e-allowscrolling="true"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="false" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                        <div e-column e-type="string" e-field="BuyerItem" e-headertext="Customer Ref#" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnItem" e-headertext="Own Ref#" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductMasterName" e-headertext="Product" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Category" e-width="80"></div>
                        <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material Master" e-width="80"></div>
                        <div e-column e-type="string" e-field="SOArticle" e-headertext="Article" e-width="160px"></div>
                        <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="80"></div>
                        <div e-column e-type="string" e-field="LineItemId" e-headertext="LineItemId" e-width="75"></div>
                        <div e-column e-type="string" e-field="SOId" e-headertext="SOId" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.00}" e-field="PlannedQty" e-headertext="SO Qty" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.00}" e-field="ItemMaterialCost" e-headertext="ItemMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.00}" e-field="SOMaterialCost" e-headertext="SOMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.00}" e-field="CostingMaterialCost" e-headertext="CostingMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.00}" e-field="BOQMaterialCost" e-headertext="BOQMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.00}" e-field="SOTotalMaterailCost" e-headertext="SOTotalMaterailCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.00}" e-field="CostingTotalMaterialCost" e-headertext="CostingTotalMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.00}" e-field="BOQTotalCost" e-headertext="BOQTotalCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.00}" e-field="TotalVarianceCostingVsSO" e-headertext="TotalVarianceCostingVsSO" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.00}" e-field="TotalVarianceCostingVsBOQ" e-headertext="TotalVarianceCostingVsBOQ" e-textalign="right" e-width="80"></div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div style="color:black;" id="BGrid" ej-grid e-datasource="QBOQCostingList" e-allowscrolling="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="false" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-type="string" e-field="SrNo" e-headertext="SrNo" e-width="80"></div>
                            <div e-column e-type="string" e-field="Item" e-headertext="Item" e-width="80"></div>
                            <div e-column e-type="string" e-field="UoM" e-headertext="UoM" e-width="80"></div>
                            <div e-column e-type="string" e-field="NetConsumptionPerUnit" e-headertext="Consumption" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.00}" e-field="ValueLossPercentage" e-headertext="ValueLoss" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.00}" e-field="GrossConsumption" e-headertext="GrossConsumption" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.00}" e-field="TotalConsumption" e-headertext="TotalConsumption" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.00}" e-template="#AdditionReductionTemplate" e-field="AdditionReduction" e-headertext="AdditionReduction" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.00}" e-field="PlanConsumption" e-headertext="PlanConsumption" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.00}" e-field="Rate" e-headertext="Rate" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.00}" e-field="TotaPlanlAmount" e-headertext="TotaPlanlAmount" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="200px"></div>
                            <div e-column e-template="#SearchArticleTemplate" e-headertext="Article" e-width="32px"></div>
                            <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material" e-width="180"></div>
                            <div e-column e-type="number" e-format="{0:0.00}" e-field="StockRate" e-headertext="StockRate" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.00}" e-field="ActualIssueAmount" e-headertext="ActualIssueAmount" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="string" e-field="Remarks" e-template="#Remarks" e-headertext="Remarks" e-width="200"></div>
                        </div>
                    </div>
            </div>
        </div>

        <script type="text/template" id="Remarks">
            <div class="text-left" style="width:100%">
                <input type="text" name="Remarks" disabled ng-model="data.Remarks" class="form-control" maxlength="250" tabindex="3">
            </div>
        </script>
        <script type="text/template" id="SearchArticleTemplate">
            <div class="common-btn">
                <ul class="list-inline small">
                    <li>
                        <button ng-click="$parent.getArticle(data);" disabled class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                            <i class="glyphicon glyphicon-search"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>
        <script type="text/template" id="AdditionReductionTemplate">
            <div class="col-sm-10" style="padding:0px; width:70px;">
                <input type="text" ej-numerictextbox e-decimalplaces="4" disabled e-value="data.AdditionReduction" ng-blur="$parent.Calculation(this)" e-width="80" />
            </div>
        </script>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>

    </div>



</div>

<div class="aplos-grid-toggle" id="maincontainer">
    <div class="row">
        <div id="Tab" ej-tab e-itemactive="onactivetab" e-create="oncreatetab">
            <ul><li><a href="#TabEdit">Production Orders</a></li> </ul>
            <div id="TabEdit">
                
                <div class="row">

                    <div class="col-xs-12" style="color:black;">
                        <div id="Gridunassigned" e-load="actionCompleteSearch" ej-grid e-datasource="modelList" e-recorddoubleclick="Get" 
                             e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                             e-cellselected="cellSelected" e-selectiontype="single" e-actioncomplete="syncfusiongriddatabound"
                             e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                @*<div e-column e-template="#showPRPlanList" e-headertext="" e-width="28"></div>*@
                                <div e-column e-type="string" e-field="Id" e-headertext="ID" e-visible="false" e-width="50"></div>
                                <div e-column e-type="string" e-field="POId" e-headertext="POId" e-width="100"></div>
                                <div e-column e-type="string" e-field="UserCode" e-headertext="UserCode" e-width="50"></div>
                                <div e-column e-type="string" e-field="UserRef" e-headertext="UserRef" e-width="80"></div>
                                <div e-column e-type="string" e-field="UserName" e-headertext="UserName" e-width="100"></div>
                                <div e-column e-type="text" e-field="PlanPercentage" e-headertext="PlanPercentage" e-width="80" style="height: 20px;"></div>
                                <div e-column e-type="text" e-field="ByWhom" e-headertext="ByWhom" e-width="80" style="height: 20px;"></div>
                                <div e-column e-type="string" e-field="Level" e-headertext="Level" e-width="80"></div>
                                <div e-column e-type="string" e-field="LotNo" e-headertext="LotNo" e-width="80"></div>

                             


                            </div>

                        </div>
                        @*<script type="text/template" id="SOCount">
                                <div class="text-left" style="width:100%">
                                    <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.GetSOItemList(data);">{{data.SOCount}}</a>
                                </div>
                            </script>
                            <script type="text/template" id="ItemCount">
                                <div class="text-left" style="width:100%">
                                    <a style="text-decoration: underline; color: blue; cursor: pointer;" ng-click="$parent.GetMOIItemList(data);">{{data.ItemCount}}</a>
                                </div>
                            </script>*@
                    </div>
                </div>
            </div>





        </div>
    </div>

</div>

@Html.Partial("~/Areas/Materials/Views/Shared/_MaterialMasterArticleSearchPopUp.cshtml")
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <disv class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="SystemId" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </disv>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closePopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>
