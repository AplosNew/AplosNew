<div id="tarekcontainer">

</div>
<togglable name="Material Issue"></togglable>

<div class="form-horizontal form-elements" id="entrycontainer">
    <div class="row">
        <div ng-form name="ModelNewForm">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">PO Id<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="PO Id" disabled ng-model="ModelNew.POId" class="form-control" maxlength="15" required tabindex="1">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Code<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Code" disabled ng-model="ModelNew.UserCode" class="form-control" maxlength="15" required tabindex="1">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Ref#<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Ref" disabled ng-model="ModelNew.UserRef" class="form-control" maxlength="15" required tabindex="3">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Plan(%)<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Plan Percentage" disabled ng-model="ModelNew.PlanPercentage" only-numbers class="form-control" ng-change="CalculationByPlan();" required tabindex="5">
                    </div>
                </div>
                @*<div class="form-group" show-errors>
                    <label class="col-sm-4 col-md-4 control-label">Storage Location<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select name="Storage" ng-model="ModelNew.MaterialStorageId" disabled class="form-control" ng-options="item.Value as item.Text for item in storageList" tabindex="7" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>*@
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Issue Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Issue Date" ng-model="ModelNew.IssueDate" disabled datepicker class="form-control" placeholder="dd-mmm-yyyy" required tabindex="9">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">By Whom<sup>*</sup></label>
                    <div class="col-sm-8">
                        <div class="input-group">
                            <input type="text" name="ByWhom" ng-model="ModelNew.ByWhom" disabled class="form-control" readonly tabindex="11">
                            <span class="input-group-btn">
                                <button ng-click="showEmployeeListPopUp();" class="btn single-small-btn" tabindex="11"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Entity" disabled ng-model="ModelNew.Entity" class="form-control" maxlength="15" required tabindex="1">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="User Name" ng-model="ModelNew.UserName" disabled class="form-control" maxlength="50" required tabindex="2">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Lot No<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="LotNo" ng-model="ModelNew.LotNo" disabled class="form-control" maxlength="50" required tabindex="4">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Level</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="ModelNew.Level" disabled name="Level" tabindex="6" ng-change="GetQBOQCostingData();">
                                <option value="">--Select--</option>
                                <option value="Costing">Costing</option>
                                <option value="QBOQ">QBOQ</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label" ng-show="checkedByList.length">{{labelCheckAndApproved}}</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style" ng-show="checkedByList.length">
                            <select id="CheckedBy" class="form-control" name="Checked By" ng-model="ModelNew.CheckedBy" tabindex="8">
                                <option ng-repeat="option in checkedByList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Cost Center</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select id="CheckedBy" class="form-control" name="Cost Center" ng-model="ModelNew.CostCenterId" tabindex="10">
                                <option ng-repeat="option in costCenterList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" disabled maxlength="250" tabindex="12"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">SODetail</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);" href="" data-toggle="tab">{{ModelNew.Level}}</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3);" href="" data-toggle="tab">Inventory Issue</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div style="color:black;" id="SOGrid" ej-grid e-datasource="SOItemList" e-allowscrolling="true"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                     e-allowselection="false" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                        <div e-column e-type="string" e-field="BuyerItem" e-headertext="Customer Ref#" e-width="80"></div>
                        <div e-column e-type="string" e-field="OwnItem" e-headertext="Own Ref#" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductMasterName" e-headertext="Product" e-width="80"></div>
                        <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Category" e-width="80"></div>
                        <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material" e-width="100"></div>
                        <div e-column e-type="string" e-field="SOArticle" e-headertext="Article" e-width="160px"></div>
                        <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="80"></div>
                        <div e-column e-type="string" e-field="LineItemId" e-headertext="LineItemId" e-width="75"></div>
                        <div e-column e-type="string" e-field="SOId" e-headertext="SOId" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="PlannedQty" e-headertext="SO Qty" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="ItemMaterialCost" e-headertext="ItemMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="SOMaterialCost" e-headertext="SOMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="CostingMaterialCost" e-headertext="CostingMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="BOQMaterialCost" e-headertext="BOQMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="SOTotalMaterailCost" e-headertext="SOTotalMaterailCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="CostingTotalMaterialCost" e-headertext="CostingTotalMaterialCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="BOQTotalCost" e-headertext="BOQTotalCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-template="#TotalVarianceCostingVsSOTemplate" e-field="TotalVarianceCostingVsSO" e-headertext="TotalVarianceCostingVsSO" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-template="#TotalVarianceCostingVsBOQTemplate" e-field="TotalVarianceCostingVsBOQ" e-headertext="TotalVarianceCostingVsBOQ" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="PlanRate" e-headertext="PlanRate" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="PlantCost" e-headertext="PlantCost" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-template="#TotalSOCostVsTotalPlanCostTemplate" e-field="TotalSOCostVsTotalPlanCost" e-headertext="TotalSOCostVsTotalPlanCost" e-textalign="right" e-width="80"></div>
                    </div>
                </div>
                <script type="text/template" id="TotalVarianceCostingVsSOTemplate">
                    <div class="col-sm-10" style="padding:0px; width:70px;height:20px;">
                        <input type="text" ng-model="data.TotalVarianceCostingVsSO" disabled style="color:black; background-color:{{data.TotalVarianceCostingVsSO<0?'Red':'#d8d7d7'}}" class="form-control" />
                    </div>
                </script>
                <script type="text/template" id="TotalSOCostVsTotalPlanCostTemplate">
                    <div class="col-sm-10" style="padding:0px; width:70px;height:20px;">
                        <input type="text" ng-model="data.TotalSOCostVsTotalPlanCost" disabled style="color:black; background-color:{{data.TotalSOCostVsTotalPlanCost<0?'Red':'#d8d7d7'}}" class="form-control" />
                    </div>
                </script>
                <script type="text/template" id="TotalVarianceCostingVsBOQTemplate">
                    <div class="col-sm-10" style="padding:0px; width:70px;height:20px;">
                        <input type="text" ng-model="data.TotalVarianceCostingVsBOQ" disabled style="color:black; background-color:{{data.TotalVarianceCostingVsBOQ<0?'Red':'#d8d7d7'}}" class="form-control" />
                    </div>
                </script>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div style="color:black;" id="BGrid" ej-grid e-datasource="QBOQCostingList" e-allowscrolling="true"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                     e-allowselection="false" e-filtersettings-filterType="excel">
                    <div e-columns>
                        <div e-column e-type="string" e-field="SrNo" e-headertext="SrNo" e-width="80"></div>
                        <div e-column e-type="string" e-field="Item" e-headertext="Item" e-width="80"></div>
                        <div e-column e-type="string" e-field="UoM" e-headertext="UoM" e-width="80"></div>
                        <div e-column e-type="string" e-field="NetConsumptionPerUnit" e-headertext="Consumption" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="ValueLoss" e-headertext="ValueLoss" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="GrossConsumption" e-headertext="GrossConsumption" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="TotalConsumption" e-headertext="TotalConsumption" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="PlanConsumption" e-headertext="PlanConsumption" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}"  e-field="IssueQty" e-headertext="Issued Qty" e-textalign="right" e-width="140"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-template="#IssueTemplate" e-field="RequestedQty" e-headertext="RequestedQty" e-textalign="right" e-width="140"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="Rate" e-headertext="Rate" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="number" e-format="{0:0.0000}" e-field="StockRate" e-headertext="StockRate" e-textalign="right" e-width="80"></div>
                        @*<div e-column e-type="number" e-format="{0:0.00}" e-field="TotaPlanlAmount" e-headertext="TotaPlanlAmount" e-textalign="right" e-width="80"></div>*@
                        <div e-column e-type="string" e-field="MaterialMaster" e-headertext="Material" e-width="180"></div>
                        <div e-column e-type="string" e-field="QBOQArticle" e-headertext="Article" e-width="200px"></div>
                        <div e-column e-type="string" e-field="BudgetName" e-headertext="Budget" e-width="200px"></div>
                        <div e-column e-type="string" e-field="ActivityName" e-headertext="Activity" e-width="200px"></div>
                        <div e-column e-template="#SearchArticleTemplate" e-headertext="Article" e-width="32px"></div>
                        @*<div e-column e-type="number" e-format="{0:0.00}" e-field="ActualIssueAmount" e-headertext="ActualIssueAmount" e-textalign="right" e-width="80"></div>*@
                        <div e-column e-type="string" e-field="Remarks" e-template="#Remarks" e-headertext="Remarks" e-width="200"></div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div ng-show="ModelNew.Level == 'QBOQ'">
                    <div style="color:black;" id="GridIssueSlip" ej-grid e-datasource="IssueSlipList"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowResizing="true"
                         e-recorddoubleclick="recorddoubleclickIssueSlip" e-filtersettings-filterType="excel" e-enabletouch="true"
                         e-allowselection="true"
                         e-detailstemplate="detailTemp"
                         e-detailsdatabound="detailgrid">
                        <div e-columns>
                            <div e-column e-headertext="Actions" e-width="20">
                                <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;padding-top:1px;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.AllTabPrint('GridIssueSlip');" style="margin: -6px;"></i></button>
                            </div>
                            <div e-column e-field="Id" e-headertext="Id" e-width="40"></div>
                            <div e-column e-field="RequestedQty" e-headertext="ValidQty" e-width="50"></div>
                            <div e-column e-field="AddedDate" e-headertext="Entry Date" e-width="80"></div>
                            <div e-column e-field="PreparedBy" e-headertext="Prepared By" e-width="80"></div>
                            <div e-column e-field="CheckedBy" e-headertext="Checked By" e-width="80"></div>
                            <div e-column e-field="CheckedByStatus" e-headertext="CheckedByStatus" e-width="80"></div>
                            <div e-column e-field="AuthorizedBy" e-headertext="Approved By" e-width="80"></div>
                            <div e-column e-field="AuthorizedByStatus" e-headertext="Approved Status" e-width="80"></div>
                            <div e-column e-field="SalesOrderId" e-headertext="SalesOrderId" e-width="80"></div>
                        </div>

                    </div>

                    <script id="tabGridContents" type="text/x-jsrender">
                        <div class="tabcontrol" id="Test">
                            <ul>
                                <li><a href="#gridTab{{:Id}}">Material Issue Details</a></li>
                            </ul>
                            <div id="gridTab{{:Id}}">
                                <div id="detailGrid"></div>
                            </div>
                        </div>
                    </script>
                </div>
            </div>
        </div>

        <script type="text/template" id="Remarks">
            <div class="text-left" style="width:100%">
                <input type="text" name="Remarks" disabled ng-model="data.Remarks" class="form-control" maxlength="250" tabindex="3">
            </div>
        </script>
        <script type="text/template" id="SearchArticleTemplate">
            <div class="common-btn">
                <ul class="list-inline small">
                    <li>
                        <button ng-click="$parent.GLPopUp(data,$index);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                            <i class="glyphicon glyphicon-search"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </script>
        <script type="text/template" id="IssueTemplate">
            <div class="col-sm-12">
                <div class="form-group">
                    <div class="col-sm-4">
                        <input type="text" ng-model="data.RequestedQty" disabled style="color:black;width: 75px;text-align:right" class="form-control" />
                    </div>
                    <div class="col-sm-8">
                        <div class="common-btn">
                            <ul class="list-inline small">
                                <li>
                                    <button ng-click="$parent.getSpecificMaterialStock(this);" class="btn small" style="height: 28px; width: 28px; padding: 0px; margin: 0px;">
                                        <i class="glyphicon glyphicon-th-list"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </script>

        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>

    </div>
</div>

