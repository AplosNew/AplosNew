<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <disv class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="GridPopUp" ej-grid e-datasource="popUpDataList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="SelectEmployee" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="SystemId" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-headertext="" e-template="#empimage" e-textalign="center" e-width="40"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Company" e-headertext="Company" e-width="80"></div>
                            <div e-column e-field="Plant" e-headertext="Plant" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </disv>
            </div>
            <div class="modal-footer">
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="closePopUp();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
    <script type="text/x-jsrender" id="empimage">
        <img src="POPResources/EmployeeProfiles/EmpPic/{{:EmpPicPath}}" style="height:48px;width:48px;" />
    </script>
</div>
<div class="modal fade site-modal in" id="stockPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content" style="overflow:scroll">
            <div class="modal-header"> Material Stock<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div class="table-responsive modal-table">
                        <table class="table table-striped" style="font-size: 12px;white-space: nowrap; ">
                            <thead>
                                <tr>
                                    <th ng-hide="productNew.Id!=null">Select</th>
                                    <th>Material Group</th>
                                    <th>Material Type</th>
                                    <th>Material</th>
                                    <th>Article</th>
                                    <th>SKU1</th>
                                    <th>SKU2</th>
                                    <th>Balance Qty</th>
                                    <th style="width:300px;">Requisition Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in materialStockList">
                                    <td ng-hide="productNew.Id!=null">
                                        <div class="checkbox-site">
                                            <label>
                                                <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td>{{x.MaterialMasterGroupName}}</td>
                                    <td>{{x.MaterialType}}</td>
                                    <td>{{x.MaterialMasterName}}</td>
                                    <td>{{x.StandardName}}</td>
                                    <td>{{x.FirstCharacteristics}}</td>
                                    <td>{{x.SecondCharacteristics}}</td>
                                    <td>{{x.TotalQty}} {{x.UOM}}</td>
                                    <td class="text-right">
                                        <div class="input-group">
                                            <input type="text" n-decimals="20" ng-model="x.RequestedQty" class="form-control text-right" ng-keyup="CalTotalQty()" width="200" />
                                            <span class="input-group-addon">{{x.TrasactopmUomQty}}</span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="7" class="text-right"><strong>Total : </strong></td>
                                    <td class="text-right"><strong>{{materialStockList | sumByKey : 'BalanceStock' }}</strong></td>
                                    <td class="text-right"><strong>{{materialStockList | sumByKey : 'RequisitionQty'}}</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button @*ng-hide="productNew.Id==null"*@ ng-click="closeStockPopUp();" class="btn">Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

