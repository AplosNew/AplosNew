<togglable name="Rack"></togglable>

<div class="form-elements form-horizontal" ng-form="rackNewForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Storage Location<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="rackNew.StorageLocationId" name="Storage Location"
                                ng-options="item.Id as item.Storage for item in StorageList" id="StorageId"
                                required tabindex="1">                            
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" n-decimals="2" name="Sequence" ng-model="rackNew.Sequence" class="form-control text-right" required>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="rackNew.ShortName" class="form-control" maxlength="15" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="rackNew.UserName" class="form-control" required maxlength="50"  autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="rackNew.Description" maxlength="250"></textarea>
                </div>
            </div>


        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="rackNew.Code" class="form-control" required maxlength="10" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="rackNew.StandardName" class="form-control" required maxlength="50" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="rackNew.Remarks" maxlength="250"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" class="css-checkbox" ng-model="rackNew.Active">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" >
                <label class="col-sm-4 control-label">Row<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input ng-disabled="binList.length>0" type="text" n-decimals="2" ng-model="rackNew.Rows" name="row" class="form-control text-right" >
                </div>
            </div>
            <div class="common-btn" ng-show="!binList.length>0">
                <ul class="list-inline text-left">
                    <li> <button ng-click="GenerateBIN();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Submit </button></li>
                </ul>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group"  >
                <label class="col-sm-4 control-label">Column<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input ng-disabled="binList.length>0" type="text" n-decimals="2" ng-model="rackNew.Columns" name="col" class="form-control text-right" >
                </div>
            </div>
        </div>
    </div>

    <div class="row" ng-show="binList.length>0"> 
            <div id="GridBin" ej-grid e-datasource="binList" e-load="loadGridBin"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-field="Code" e-headertext="Bin" e-width="3"></div>
                    <div e-column e-field="Row" e-headertext="Row" e-width="3"></div>
                    <div e-column e-field="Column" e-headertext="Column" e-width="3"></div>
                    <div e-column e-field="UserName" e-headertext="UserName" e-width="3">
                        <input type="text" ng-model="data.UserName" name="col" class="form-control text-left" required>
                    </div>
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
       
    </div>
</div>

    <div class="table-responsive aplos-grid-toggle">
        <div id="GridRackList" ej-grid e-datasource="RackList" e-recorddoubleclick="GetDetails" e-load="loadRackList"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Rack Id" e-width="3"></div>
                <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>             
                <div e-column e-field="UserName" e-headertext="User Name" e-width="3"></div>
                <div e-column e-field="Description" e-headertext="Description" e-width="3"></div>
                <div e-column e-field="Rows" e-headertext="No. of Row's" e-width="3"></div>
                <div e-column e-field="Columns" e-headertext="No. of Column's" e-width="3"></div>
                <div e-column e-field="TotalBin" e-headertext="Total Bin" e-width="3"></div>
                <div e-column e-field="StorageLocation" e-headertext="Storage Location" e-width="3"></div>             
            </div>
        </div>
    </div>


    <confirm-modal></confirm-modal>
