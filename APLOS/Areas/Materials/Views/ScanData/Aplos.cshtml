<div>
    <h4><span class="glyphicon glyphicon"></span> {{title}}</h4>
    <hr />
</div>
<div class="table-responsive">
    <div id="GridEdit" ej-grid e-datasource="ItemScanChildList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            @*<div e-column e-headertext="Select" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="10"></div>*@
            <div e-column e-field="Id" e-headertext="Id" e-width="60" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="LotNo" e-headertext="LotNo" e-width="20"></div>
            <div e-column e-field="RefNo" e-headertext="Ref No" e-width="20"></div>
            <div e-column e-field="Cones" e-headertext="Cones" e-width="10"></div>
            <div e-column e-field="NetWeight" e-headertext="Net Weight" e-width="20"></div>
            <div e-column e-field="GWeight" e-headertext="Gross Weight" e-width="20"></div>
        </div>
    </div>
    @*<script type="text/x-jsrender" id="headerTemplate">
        <input type="checkbox" id="headchk" />
    </script>
    <script type="text/template" id="checkboxTemplate">
        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.chk" e-value="data.chk" />
    </script>*@
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>

        </ul>
    </div>
</div>