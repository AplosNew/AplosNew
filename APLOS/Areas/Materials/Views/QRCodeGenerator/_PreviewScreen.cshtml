            </div>
            <div class="modal-footer">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        @*<li> <button ng-click="SendDataToGenerateQR();" class="btn" tabindex="9"><i class="glyphicon glyphicon-print"></i> Generate QR</button></li>*@
                        <li> <button ng-click="getPrint()"  class="btn" tabindex="9"><i class="glyphicon glyphicon-print"></i> PRINT</button></li>


                    </ul>
