@*PO, Article, LOT, Product Code, No Of Cones, net weight*@
<div>
    <h4><span></span>QR Code Generator</h4>
    <hr />
</div>
<div class="form-elements form-horizontal" ng-form name="QRCodeGenerateForm">
    <input type="hidden" ng-model="QRCodeGenerateModel.Id">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Guest Name</label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="VehicleRequisitionModel.Name" class="form-control" tabindex="5" maxlength="50">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
        </div>
    </div>
</div>
