<div>
    <h4><span></span>QR Code Generator</h4>
    <hr />
</div>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    @*<input type="hidden" ng-model="QRCodeGenerateModel.Id">*@
    <div class="row">
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Port No.</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
            <select class="form-control" ng-model="ModelNew.Portno" name="PO"
                    tabindex="2">
                <option value="">--Select--</option>
                <option ng-repeat="option in PortNoList" value="{{option.Value}}">{{option.Text}}</option>
            </select>
        </div>
                   @*<input type="text" name="Short Name" ng-model="ModelNew.Portno" class="form-control" maxlength="15" required tabindex="3">*@

                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Customer</label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <span class="input-group-addon">{{ModelNew.PartyCode}}</span>
                        <input type="text" name="Vendor" ng-model="ModelNew.PartyName" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="showPartyPopUpNew()" ng-disabled="inventoryMaterialList.length>0" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                            <button name="submit" ng-click="ClearPO()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-refresh"></i></button>

                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">PO</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.PO" name="PO" ng-change="LoadGrid();"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in POList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">G.Weight</label>
                <div class="col-sm-8 show-message">
                   
                    <input type="text" name="Short Name" ng-model="ModelNew.GrossWeight" class="form-control" maxlength="15" required tabindex="3">

                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="LoadGrid();" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> Load Grid</button></li>
                    <li> <button ng-click="ConnectPortConnection();" class="btn" tabindex="9"><i class="glyphicon"></i> Make Connection</button></li>

                </ul>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="tab-design">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Budget Code</a></li>

                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="table-responsive">
                        <div id="bgtCodeGridId" ej-grid e-datasource="DataList" e-load="loadGridEdit" e-recorddoubleclick="Get"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-field="PO" e-headertext="PO" e-width="70"></div>
                                <div e-column e-field="Article" e-headertext="Article" e-width="150"></div>
                                <div e-column e-field="ProductCode" e-headertext="Product Code" e-width="70"></div>
                                <div e-column e-field="Shade" e-headertext="Shade" e-width="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal site-modal in" id="POItemPopup" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Production Order<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body text-center">
                <div class="row">
                    <div style="color:black;" id="GridPO" ej-grid e-datasource="ProductionOrderList" e-allowscrolling="true"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-recorddoubleclick="SetPrOData"
                         e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-template="#showSOList" e-headertext="" e-width="30"></div>
                            <div e-column e-type="string" e-field="POId" e-headertext="PrO" e-width="80"></div>
                            <div e-column e-type="string" e-field="BuyerOrder" e-headertext="Buyer Ord#" e-width="80"></div>
                            <div e-column e-type="string" e-field="OwnOrder" e-headertext="Own Ord#" e-width="80"></div>
                            <div e-column e-type="string" e-field="Description" e-headertext="Description" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.00}" e-field="Qty" e-headertext="Qty" e-width="80" e-textalign="right"></div>
                            <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="LSD" e-headertext="LSD" e-width="80"></div>
                            <div e-column e-format="{0:dd-MMM-yyyy}" e-type="date" e-field="CommitmentDate" e-headertext="Commitment Date" e-width="80"></div>
                            <div e-column e-type="string" e-field="ProductionStatus" e-headertext="Production Status" e-width="80"></div>
                            <div e-column e-type="string" e-field="BuyerItem" e-headertext="Buyer Item#" e-width="80"></div>
                            <div e-column e-type="string" e-field="OwnItem" e-headertext="Own Item#" e-width="80"></div>
                            <div e-column e-type="string" e-field="ProductCategory" e-headertext="Product Category" e-width="80"></div>
                            <div e-column e-type="string" e-field="Product" e-headertext="Product" e-width="80"></div>
                            <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                            <div e-column e-type="string" e-field="Buyer" e-headertext="Buyer" e-width="80"></div>
                            <div e-column e-type="string" e-field="PONumber" e-headertext="PO Number" e-width="80"></div>
                            <div e-column e-type="string" e-field="RequiredTimeUnit" e-headertext="Required Time Unit" e-width="80"></div>

                        </div>
                    </div>
                    <script type="text/template" id="showSOList">
                        <div class="common-btn">
                            <ul class="list-inline text-right small">

                                <li>
                                    <button ng-click="$parent.getSalesOrderOfProdOrderList(this);" class="btn small" style="height: 20px;width: 20px;padding: 0px;margin: 0px;">
                                        <i class="glyphicon glyphicon-th-list"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Parties/Views/Party/_VendorPopUpNew.cshtml")
@Html.Partial("~/Areas/Materials/Views/QRCodeGenerator/_WeighingScaleMachinePopUp.cshtml")
