            <label class="col-sm-4 control-label">Weighing Scale No.</label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select class="form-control" ng-model="QRCodeGenerateModel.WeighingScaleNo" name="WeighingScaleNo" ng-change="GetGrossWeight(QRCodeGenerateModel.WeighingScaleNo)"
                            tabindex="2">
                       <option ng-repeat="option in WeighingScaleList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>*@
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Port No.</label>
                                <div class="col-sm-8 show-message">
                                    <div class="select-style">
                                        <select class="form-control" ng-model="QRCodeGenerateModel.Portno" name="PO" ng-change="ConnectPortConnection()"
                                                tabindex="2">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="option in PortNoList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2"></div>
                    </div>
                    <input type="hidden" ng-model="QRCodeGenerateModel.Id">
                    <div class="row">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">PO</label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="PO" ng-model="QRCodeGenerateModel.PO" class="form-control" tabindex="5" maxlength="50" ng-disabled="true">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Product Code</label>
                                <div class="col-sm-8 show-message">

                                    <input type="text" name="PO" ng-model="QRCodeGenerateModel.ProductCode" class="form-control" tabindex="5" maxlength="50" ng-disabled="true">
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Min. Weight</label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="MinWeight" ng-model="QRCodeGenerateModel.MinWeight"  class="form-control" tabindex="5" maxlength="50">
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">G Wt.</label>
                                <div class="col-sm-8 show-message">

                                    <input type="text" name="MinWeight" ng-model="QRCodeGenerateModel.GrossWeight" class="form-control" tabindex="5" maxlength="50" ng-disabled="true">

                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Tier Wt.</label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="TierWeiht" ng-model="QRCodeGenerateModel.TierWeight" ng-change="CalcNetWeight();" class="form-control" tabindex="5" maxlength="50">
                                </div>
                            </div>

                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">No. of Cones</label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="NumberOfCones" ng-model="QRCodeGenerateModel.NumberOfCones" class="form-control" tabindex="5" maxlength="50">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Article</label>
                                <div class="col-sm-8 show-message">
                                    
                                    <input type="text" name="NumberOfCones" ng-model="QRCodeGenerateModel.Article" class="form-control" tabindex="5" maxlength="50"  readonly>

                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Shade</label>
                                <div class="col-sm-8 show-message">
                                    
                                    <input type="text" name="NumberOfCones" ng-model="QRCodeGenerateModel.Shade" class="form-control" tabindex="5" maxlength="50"  readonly>

                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Max. Weight</label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="MaxWeight" ng-model="QRCodeGenerateModel.MaxWeight" ng-change="validateMaxWeight();" class="form-control" tabindex="5" maxlength="50">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Net Wt.</label>
                                <div class="col-sm-8 show-message">
                                    
                                    <input type="text" name="NumberOfCones" ng-model="QRCodeGenerateModel.NetWeight" class="form-control" tabindex="5" maxlength="50"  readonly>

                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">LOT</label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="LOT" ng-model="QRCodeGenerateModel.LOT" class="form-control" tabindex="5" maxlength="50">
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SendDataToGenerateQR();" class="btn" tabindex="9"><i class="glyphicon glyphicon-print"></i> Generate QR</button></li>


                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
