                <center>
                    <embed src="{{FN}}"
                           width="800"
                           height="500">
                </center>
            </div>
            <div class="modal-footer common-btn">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        @*<li> <button ng-click="SendDataToGenerateQR();" class="btn" tabindex="9"><i class="glyphicon glyphicon-print"></i> Generate QR</button></li>*@
                        <li> <button ng-click="generateQRCode()" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> PREVIEW</button></li>


                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Materials/Views/QRCodeGenerator/_PreviewScreen.cshtml")
