                                            </div>
                                        </th>
                                        <th ng-repeat="h in searchbyMMUOMlist">{{h.Text}}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr dir-paginate="x in mmUOMData  |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                                        <td>
                                            <div class="checkbox-site">
                                                <input type="checkbox" ng-model="x.IsSelectedID">
                                            </div>
                                        </td>
                                        <td ng-repeat="hh in searchbyMMUOMlist">{{x[hh.Value]}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="common-btn">
                    </div>
                    <div class="common-btn">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <ul class="list-inline text-left"></ul>
                        </div>
                        <ul class="list-inline text-right">
                            <li>
                                <button ng-click="getUOMCode();" class="btn"><i class="glyphicon glyphicon-plus"></i> Select</button>
                            </li>

                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!--Characteristics Value Popup-->
    <div class="modal fade site-modal in" id="characteristicsValuepopup" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    {{CharacteristicsSearchTitle}} Value
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body text-center">

                    <div class="row text-right">
                        <div class="col-xs-12 col-sm-12 col-sm-12">
                            <div class="search-form">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-3 col-lg-3">
                                        <div class="select-style">
                                            <select ng-model="$root.parameters.searchBy">
                                                <option ng-repeat="option in searchbyCharacteristicsValuelist" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-7 col-md-7">
                                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="loadCharacteristicsValueData()">
                                    </div>
                                    <div class="col-xs-12 col-sm-2 col-md-2">
                                        <button type="button" ng-click="loadCharacteristicsValueData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th ng-repeat="h in searchbyCharacteristicsValuelist">{{h.Text}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr dir-paginate="x in characteristicsValueData  |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getCharacteristicsValueCode(x.Id, x.Description);">
                                    <td ng-repeat="hh in searchbyCharacteristicsValuelist">{{x[hh.Value]}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>
<confirm-archive title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRowYes()"></confirm-archive>
<confirm-archive-generic data-modalid="confirchilddelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeChildYes()"></confirm-archive-generic>
<confirm-archive-generic data-modalid="confirmasterdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeMasterYes()"></confirm-archive-generic>
<confirm-archive-generic data-modalid="confirdetaildelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeDetailYes()"></confirm-archive-generic>
<confirm-archive-generic data-modalid="confiruomdelete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeUOMYes()"></confirm-archive-generic>
