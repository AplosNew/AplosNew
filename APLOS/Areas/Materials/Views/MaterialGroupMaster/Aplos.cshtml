<togglable name="Material Group Master"></togglable>
<div class="form-elements form-horizontal" ng-form="materialGroupMasterNewForm">
    <input type="hidden" ng-model="materialGroupMasterNew.Id">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="alternativeUoM" role="tab" data-toggle="tab">Alternative UoM</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="packingForm" role="tab" data-toggle="tab">Packing</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="productionProcess" role="tab" data-toggle="tab">Production Process Group</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row" ng-form name="materialGroupMasterNewFormTab1">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Material Group1<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="MaterialGroup1" id="materialGroup1" ng-model="materialGroupMasterNew.MaterialGroup1Id" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in materialGroup1List" tabindex="1" required>
                                        <option value=''></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Material Group3</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="MaterialGroup3" id="materialGroup3" ng-model="materialGroupMasterNew.MaterialGroup3Id" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in materialGroup3List" tabindex="3">
                                        <option value=''></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="10" ng-model="materialGroupMasterNew.Code" name="Code" class="form-control" required tabindex="5">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Material Type<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="MaterialType" id="materialTypeId" ng-model="materialGroupMasterNew.MaterialTypeId" required class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in materialTypeList" tabindex="7">
                                        <option value=''></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">HSN Code</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select class="form-control" ng-model="materialGroupMasterNew.HSNCodeId"
                                            ng-options="item.Value as item.Text for item in hsnCodeList" tabindex="9">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Active</label>
                            <div class="col-sm-8">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="materialGroupMasterNew.Active">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Material Group2</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="MaterialGroup2" id="materialGroup2" ng-model="materialGroupMasterNew.MaterialGroup2Id" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in materialGroup2List" tabindex="2">
                                        <option value=''></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Material Group4</label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select name="MaterialGroup4" id="materialGroup4" ng-model="materialGroupMasterNew.MaterialGroup4Id" class="col-sm-3 form-control"
                                            ng-options="item.Value as item.Text for item in materialGroup4List" tabindex="4">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="50" ng-model="materialGroupMasterNew.UserName" name="User Defined Name" class="form-control" required tabindex="6">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Base UoM</label>
                            <div class="col-sm-8">
                                <div class="select-style">
                                    <select name="Unit of measurement" class="form-control" ng-model="materialGroupMasterNew.BaseUoMId" id="baseUOMId"
                                            ng-options="item.Value as item.Text for item in uOMList" ng-change="valueSetInAltUoM();" ng-disabled="mgmAlternativeUoMList.length>0" tabindex="8">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Inventory Issue Policy</label>
                            <div class="col-sm-8">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="CompanyGroupLevel" ng-model="materialGroupMasterNew.InventoryIssuePolicy" value="FIFO">
                                        <span class="cr"><i class="cr-icon"></i></span>
                                        FIFO
                                    </label>
                                    <label>
                                        <input type="radio" name="CompanyGroupLevel" ng-model="materialGroupMasterNew.InventoryIssuePolicy" value="LIFO">
                                        <span class="cr"><i class="cr-icon"></i></span>
                                        LIFO
                                    </label>
                                    <label>
                                        <input type="radio" name="CompanyGroupLevel" ng-model="materialGroupMasterNew.InventoryIssuePolicy" value="WeightedAverage">
                                        <span class="cr"><i class="cr-icon"></i></span>
                                        Weighted Avg
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row" ng-form name="materialGroupMasterNewFormTab2">
                    <input type="hidden" ng-model="alternativeUoMNew.Id">
                    <div class="col-xs-12 col-sm-10 col-md-10" style="padding-right: 0px;">
                        <div class="form-group">
                            <div class="col-sm-1">
                                <input type="number" class="form-control text-center" value="1" readonly>
                            </div>
                            <label class="col-sm-2 control-label" style="margin-left:-20px;margin-right:-44px;">Alternative UoM</label>
                            <div class="col-sm-3">
                                <div class="select-style">
                                    <select ng-model="alternativeUoMNew.AlternativeUoMId" class="form-control" name="Unit of masurement"
                                            id="altUOMId" ng-options="item.Value as item.Text for item in uOMList" tabindex="1">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                            <label class="col-sm-1 control-label" style="margin-left:-20px;margin-right:-58px;">Is</label>
                            <div class="col-sm-2">
                                <input type="number" name="Base uom factor" string-to-number ng-model="alternativeUoMNew.BaseUoMFactor" class="form-control" tabindex="2" maxlength="50">
                            </div>
                            <div class="col-sm-2" style="margin-left:-30px;">
                                <input type="text" name="Base uom" ng-model="alternativeUoMNew.BaseUoMName" class="form-control" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2" style="padding-left: 0px;margin-left:-248px;">
                        <button ng-click="addAlternativeUoM();" class="btn single-small-btn" tabindex="3"><i class=""></i> {{AltUomAction}}</button>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="mgmAlternativeUoMList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Action</th>
                                        <th>Alternative UoM Factor</th>
                                        <th>Alternative UoM</th>
                                        <th>Base UoM Factor</th>
                                        <th>Base UoM</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in mgmAlternativeUoMList">
                                        <td class="text-center">
                                            <ul class="list-inline action-list">
                                                <li><button ng-click="GetMGMAlternativeUoM(x.Id, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></button></li>
                                                <li><button ng-click="removeRowModal(x.AlternativeUoMName, $index, 'mgmAlternativeUoMList' ,null,'AlternativeUoMId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                            </ul>
                                        </td>
                                        <td>{{x.AlternativeUoMFactor}}</td>
                                        <td>{{x.AlternativeUoMName}}</td>
                                        <td>{{x.BaseUoMFactor}}</td>
                                        <td>{{x.BaseUoMName}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row" ng-form name="materialGroupMasterNewFormTab3">
                    <input type="hidden" ng-model="packingFormNew.Id">
                    <div class="col-xs-12 col-sm-10 col-md-10" style="padding-right: 0px;">
                        <div class="form-group">
                            <label class="col-sm-1 control-label">Sequence</label>
                            <div class="col-sm-1">
                                <input type="text" only-numbers class="form-control text-center" ng-disabled="packBtn" ng-model="packingFormNew.Sequence" tabindex="31">
                            </div>
                            <label class="col-sm-1 control-label" style="margin-left:-20px;margin-right:20px;">Packing Form</label>
                            <div class="col-sm-3">
                                <div class="select-style">
                                    <select ng-model="packingFormNew.PackingFormId" class="form-control" id="packingFormId"
                                            ng-options="item.Value as item.Text for item in pFormList" tabindex="32">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                            <label class="col-sm-2 control-label" style="margin-left:-20px;margin-right:-40px;">Unique Container</label>
                            <div class="col-sm-2">
                                <div class="checkbox-site">
                                    <label class="control-label">
                                        <input type="checkbox" ng-model="packingFormNew.IsSingleEntry">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                            <div class="col-sm-2 col-md-2" style="margin-left:-123px;">
                                <button ng-click="addPackingForm();" class="btn single-small-btn" tabindex="34">{{PackingAction}}</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="packingFormList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th class="col-sm-1">Action</th>
                                        <th>Sequence</th>
                                        <th>Packing Form</th>
                                        <th>Unique Container</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in packingFormList">
                                        <td class="text-center">
                                            <ul class="list-inline action-list">
                                                <li><button ng-click="GetPackingForm(x.Id, $index)" class="btn btn-action tooltip-here" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></button></li>
                                                <li><button ng-click="packingFormDelModal(x.AlternativeUoMId, $index, x.Sequence)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                            </ul>
                                        </td>
                                        <td>{{x.Sequence}}</td>
                                        <td>{{x.PackingFormName}}</td>
                                        <td>{{x.IsSingleEntry?'Yes':'No'}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div ng-form="materialGroupMasterNewFormTab4">
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li><button ng-click="prdProcessPopUp();" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Production Process Group</button></li>
                        </ul>
                    </div>
                    <div class="table-responsive modal-table" ng-show="processGroupList.length>0">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th ng-show="processGroupList.length>1">Sort</th>
                                    @*<th>Sequence</th>*@
                                    <th>Code</th>
                                    <th>Short Name</th>
                                    <th>Prod Process Group</th>
                                    <th>Input</th>
                                    <th class="col-md-1">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in processGroupList">
                                    <td ng-show="processGroupList.length>1">
                                        <span ng-show="!$first" ng-click="moveUp($index, processGroupList,'Sequence')"><i class="glyphicon glyphicon-triangle-top"></i></span>
                                        <br />
                                        <span ng-show="!$last" ng-click="moveDown($index, processGroupList,'Sequence')"><i class="glyphicon glyphicon-triangle-bottom"></i></span>
                                    </td>
                                    @*<td>{{x.Sequence}}</td>*@
                                    <td>{{x.Code}}</td>
                                    <td>{{x.ShortName}}</td>
                                    <td>{{x.ProdProcessGroupName}}</td>
                                    <td>
                                        <div class="select-style">
                                            <select class="form-control" ng-model="x.InputId" ng-options="item.Value as item.Text for item in inputList">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </td>
                                    <td>
                                        <ul class="list-inline">
                                            <li><button ng-click="removeRowModal(x.ProdProcessGroupName, $index, 'processGroupList' , 'ProductionProcessGroupId', 'ProductionProcessGroupId')" class="btn btn-action single-small-btn tooltip-here" data-placement="top" title="Remove" tooltip><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="7"></i> {{Action}}</button></li>
            <li><button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="8"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="9"></i> Clear</button></li>
            <li><button ng-click="materialGroupMasterReport();" class="btn"><i class="glyphicon glyphicon-print"></i> Print</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Material Type</th>
                    <th>Material Group1</th>
                    <th>Material Group2</th>
                    <th>Material Group3</th>
                    <th>Material Group4</th>
                    <th>User Defined Name</th>
                    <th>Inventory Issue Policy</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in materialGroupMasters |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="Get(x.Id, $index);">
                    <td>{{x.Code}}</td>
                    <td>{{x.MaterialTypeName}}</td>
                    <td>{{x.MaterialGroup1Name}}</td>
                    <td>{{x.MaterialGroup2Name}}</td>
                    <td>{{x.MaterialGroup3Name}}</td>
                    <td>{{x.MaterialGroup4Name}}</td>
                    <td>{{x.UserName}}</td>
                    <td>{{x.InventoryIssuePolicy}}</td>
                    <td>{{x.Active?'Yes':'No'}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <dir-pagination-controls max-size="10"
                             direction-links="true"
                             boundary-links="true"
                             on-page-change="getData(newPageNumber)">
    </dir-pagination-controls>
</div>
<!-- #region Production Process PopUp -->
<div class="modal fade site-modal in" id="prdProcessPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Production Process Group<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="processParameters.searchBy">
                                            <option ng-repeat="option in prdProcessPopUpList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="processParameters.search" ng-enter="getProcessGroupData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getProcessGroupData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Prod Process Group</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in prdProcessList|itemsPerPage:processParameters.pageSize"
                                pagination-id="metaData.name + 'prdProcessList'" total-items="processParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag"
                                                   ng-click="genericPushInTempList(x,$event,processGroupList,'ProductionProcessGroupId', 'ProductionProcessGroupId');">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.ProdProcessGroupName}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'prdProcessList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getProcessGroupData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="addPrdProcess()" class="btn">Done</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- #endregion -->
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirmProcessPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="delPackingFormPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removePackingFormRow()"></confirm-archive-generic>