                    </script>
                    <script type="text/template" id="TranQty">
                        <div class="col-sm-10" style="text-align: right;">
                            <input type="text" n-decimals="4" ng-model="data.TranQty" style="color: black; width: 78px; text-align: right;" class="form-control" />
                        </div>
                    </script>
                </div>
                <div class="modal-footer">
                    <div class="common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="closeSOPopUp();" class="btn">Apply</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
