                            <div e-column e-type="string" e-field="MaterialType" e-headertext="Material Type" e-width="100"></div>
                            <div e-column e-type="string" e-field="Material" e-headertext="Material" e-width="100"></div>
                            <div e-column e-type="string" e-field="Article" e-headertext="Article" e-width="160px"></div>
                            <div e-column e-type="string" e-field="PartyName" e-headertext="Vendor" e-width="180"></div>
                            <div e-column e-type="string" e-field="InventoryReceiveId" e-headertext="GRNNo" e-width="80"></div>
                            <div e-column e-type="string" e-field="InventoryReceiveDetailId" e-headertext="GRNRowNo" e-width="80"></div>
                            <div e-column e-type="string" e-field="GRNDate" e-headertext="GRN Date" e-width="80"></div>
                            <div e-column e-type="string" e-field="MaterialStorage" e-headertext="Storage Location" e-width="80"></div>
                            <div e-column e-type="string" e-field="LotNumber" e-headertext="Lot No" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="TransactionQty" e-headertext="Receive Qty" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="IssueQty" e-headertext="Issue Qty" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="BalanceStock" e-headertext="BalanceStock" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-template="#TranQty" e-field="TranQty" e-headertext="TranQty" e-textalign="right" e-width="100"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="MaterialTranRate" e-headertext="Rate" e-textalign="right" e-width="80"></div>
                            <div e-column e-type="number" e-format="{0:0.0000}" e-field="BaseRate" e-headertext="Rate" e-textalign="BaseRate" e-width="80"></div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxTemplate">
