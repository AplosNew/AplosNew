                        <div e-column e-type="number" e-template="#WasteQty" e-field="WasteQty" e-headertext="WasteQty" e-textalign="right" e-width="60"></div>
                        <div e-column e-type="number" e-field="UptodateOtherQty" e-headertext="UptodateOtherQty" e-textalign="right" e-width="50"></div>
                        <div e-column e-type="number" e-field="UptodateWasteQty" e-headertext="UptodateWasteQty" e-textalign="right" e-width="50"></div>
                        <div e-column e-type="number" e-field="TotalQty" e-headertext="TotalQty" e-textalign="right" e-width="50"></div>
                    </div>
                </div>
                <script type="text/template" id="OtherQty">
                    <div class="col-sm-10" style="text-align:right;">
                        <input type="text" n-decimals="4" ng-model="data.OtherQty" ng-blur="$parent.GetTotalQty(this)" style="color: black; width: 78px; text-align: right;" class="form-control" />
                    </div>
                </script>
                <script type="text/template" id="WasteQty">
                    <div class="col-sm-10" style="text-align: right;">
                        <input type="text" n-decimals="4" ng-model="data.WasteQty" ng-blur="$parent.GetTotalQty(this)" style="color: black; width: 78px; text-align: right;" class="form-control" />
                    </div>
                </script>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(3), active: isSet2(3) }">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li><button style="margin-left: 5px;" ng-click="AddOtherMaterial();" ng-disabled="ModelNew.POId===null" class="btn"><i class="glyphicon glyphicon-plus" style="top: 1px;"></i> Add Material</button></li>
                    </ul>
                </div>
                <div class="row">
                    <div class="col-sm-12">
                        <div id="GridAddM" ej-grid e-datasource="AddOtherMaterialList"
                             e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                             e-cellselected="cellSelected" e-selectiontype="single" e-actioncomplete="syncfusiongriddatabound"
                             e-allowscrolling="true" e-minwidth="450" e-minheight="400"
                             e-allowselection="false" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-type="string" e-field="Id" e-headertext="ID" e-visible="false" e-width="50"></div>
                                <div e-column e-type="string" e-field="ArticleId" e-headertext="ArticleId" e-width="100"></div>
                                <div e-column e-type="string" e-field="ArticleCode" e-headertext="ArticleCode" e-width="100"></div>
                                <div e-column e-type="string" e-field="ArticleName" e-headertext="Article" e-width="100"></div>
                                <div e-column e-type="string" e-field="Material" e-headertext="Material" e-width="50"></div>
                                <div e-column e-type="string" e-field="MaterialMasterId" e-headertext="MaterialMasterId" e-width="80"></div>
                                <div e-column e-type="number" e-template="#Qty" e-field="Qty" e-headertext="Qty" e-textalign="right" e-width="60"></div>
                            </div>
                            <script type="text/template" id="Qty">
                                <div class="col-sm-10" style="text-align:right;">
                                    <input type="text" n-decimals="4" ng-model="data.Qty" style="color: black; width: 78px; text-align: right;" class="form-control" />
                                </div>
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" ng-disabled="disbtn" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
</div>

