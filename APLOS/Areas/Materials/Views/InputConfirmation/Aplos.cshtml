<togglable name="Input Confirmation"></togglable>

<div class="form-horizontal form-elements" id="entrycontainer">
    <div class="row">
        <div ng-form name="ModelNewForm">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">PO Id<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="PO Id" disabled ng-model="ModelNew.POId" class="form-control" required tabindex="1">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Process<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ModelNew.ProcessId" disabled name="ProcessId" ng-options="item.Value as item.Text for item in processList" ng-change="loadWC(ModelNew.ProcessId, ModelNew.EntityId);" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Confirmation Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Confirmation Date" ng-model="ModelNew.ConfirmationDate" datepicker class="form-control" placeholder="dd-mmm-yyyy" required tabindex="9">
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" rows="1" ng-model="ModelNew.Remarks" maxlength="250" tabindex="13"></textarea>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Entity<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Entity" disabled ng-model="ModelNew.Entity" class="form-control" required tabindex="1">
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Work Center<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ModelNew.WorkCenterMasterId" name="Work Center" ng-options="item.Value as item.Text for item in wcList" required>
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                    <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                        <input type="hidden" name="CheckedBy" ng-model="ModelNew.ResponsiblePersonId" class="form-control">
                        <span class="input-group-addon">{{ModelNew.ResponsiblePersonEmployeeCode}}</span>
                        <input type="text" name="CheckedBy" ng-model="ModelNew.ResponsiblePerson" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="showEmployeeListPopUp('RP');" class="btn single-small-btn" tabindex="13"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearEmp('RP')" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Checked By<sup>*</sup></label>
                    <div class="col-sm-8 input-group show-message" style="padding-left: 15px;padding-right: 14px;">
                        <input type="hidden" name="CheckedBy" ng-model="ModelNew.CheckedById" class="form-control">
                        <span class="input-group-addon">{{ModelNew.CheckedByEmployeeCode}}</span>
                        <input type="text" name="CheckedBy" ng-model="ModelNew.CheckedBy" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="showEmployeeListPopUp('CB');" class="btn single-small-btn" tabindex="13"><i class="glyphicon glyphicon-search"></i></button>
                            <button ng-click="clearEmp('CB')" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
        <div class="site-tab">
