                                <option ng-repeat="option in userDefinedNameList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="ModelNew.Date" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8" required>
                    </div>
                </div>


