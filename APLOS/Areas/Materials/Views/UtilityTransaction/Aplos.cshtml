<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="tab-design" id="tab_show">
        @*<div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
            </ul>
        </div>*@
        <div class="tab-content">

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Utility Master<sup>*</sup> </label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select id="CategoryId" class="form-control" ng-model="ModelNew.UtilityMasterId" ng-change="GetEditReadingList();" name="Category" tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in utilityMasterList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Last Reading</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="LastReading" ng-disabled="true" n-decimals="3" class="form-control" maxlength="250" tabindex="8">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Last Reading Date</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="LastReadingDate" ng-disabled="true" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Last Reading Time</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="LastReadingTime" ng-disabled="true" class="form-control" maxlength="250" tabindex="8">
                    </div>
                </div>

            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="ModelNew.Date" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8" required>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Reading<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="ModelNew.Reading" ng-change="GetQuantity();"  n-decimals="3" class="form-control" maxlength="250" tabindex="8" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Quantity<sup>*</sup></label>
                    <div class="col-sm-2 show-message">
                        <input type="text" name="Quantity" ng-model="ModelNew.Quantity" ng-disabled="true"  n-decimals="3" class="form-control" only-numbers required autocomplete="off" tabindex="4" maxlength="50">
                    </div>
                    <label class="col-sm-4 control-label">{{UoMName}}</label>

                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="8"></textarea>
                    </div>
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>

        </div>
     </div>

    </div>

<confirm-archive-generic modalid="confirmUtilityDetailsRemovePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeUtilityDetailsRow();"></confirm-archive-generic>

<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true"></div>
            <div e-column e-field="Date" e-headertext="Date" e-width="2"></div>
            <div e-column e-field="UtilityMaster" e-headertext="Utility Master" e-width="3"></div>
            <div e-column e-field="UoM" e-headertext="UoM" e-width="5"></div>
            <div e-column e-field="Quantity" e-headertext="Quantity" e-width="5"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="5"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
