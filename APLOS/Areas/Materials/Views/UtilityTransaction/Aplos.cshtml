                        <div class="col-sm-2 show-message">
                            <input type="text" name="Quantity" ng-model="ModelNew.Quantity" class="form-control" required autocomplete="off" tabindex="4" maxlength="50">
                        </div>
                    <label class="col-sm-2 control-label">UoM<sup>*</sup> </label>
                    <div class="col-sm-4">
                        <div class="select-style">
                            <select id="UoMId" class="form-control" ng-disabled="ModelNew.Quantity == false" ng-model="ModelNew.UoMId" name="UoM" tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in uOMList" value="{{option.Value}}">{{option.Text}}</option>
