<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="tab-design" id="tab_show">

        <div class="tab-content">

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Utility Master<sup>*</sup> </label>
                    <div class="col-sm-8 show-message">
                        <div class="input-group">
                            <input type="text" name="UtilityMaster" ng-model="ModelNew.UtilityMaster" class="form-control" readonly>
                            <span class="input-group-btn">
                                <button ng-click="getUtilityTransactionPopUpData();" class="btn single-small-btn" @*ng-change="GetEditReadingList();GetUoMAndReadingApplicable();"*@ tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                            </span>
                        </div>
                    </div>

                    @*<div class="col-sm-8">
                <div class="select-style">
                    <select id="CategoryId" class="form-control" ng-model="ModelNew.UtilityMasterId" ng-change="GetEditReadingList();GetUoMAndReadingApplicable();" name="Category" tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in utilityMasterList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>*@
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">InputSourceId</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="ModelNew.InputSourceId" ng-disabled="true" n-decimals="3" class="form-control" maxlength="250" tabindex="8">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Last Reading</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="ModelNew.LastReading" ng-disabled="true" n-decimals="3" class="form-control" maxlength="250" tabindex="8">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Last Reading Date</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="ModelNew.LastReadingDate" ng-disabled="true" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Last Reading Time</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="ModelNew.LastReadingTime" ng-disabled="true" class="form-control" maxlength="250" tabindex="8">
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Multiplying Factor<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="Multiplying Factor" ng-model="ModelNew.MultiplyingFactor" class="form-control" n-decimals="3" required autocomplete="off" tabindex="11" maxlength="50" ng-disabled="true">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Date<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="ModelNew.Date" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="8" required>
                    </div>
                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Reading<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="ModelNew.Reading" ng-change="GetQuantity();GetCalculatedValue();" n-decimals="3" class="form-control" maxlength="250" tabindex="8" required>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Quantity<sup>*</sup></label>
                    <div class="col-sm-2 show-message">
                        <input type="text" name="Quantity" ng-model="ModelNew.Quantity" ng-disabled="true" n-decimals="4" class="form-control"  required autocomplete="off" tabindex="4" maxlength="50">
                    </div>
                    <label class="col-sm-4 control-label">{{ModelNew.UoM}}</label>

                </div>
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Calculated Value<sup>*</sup></label>
                    <div class="col-sm-8">
                        <input type="text" name="CalculatedValue" ng-model="CalculatedValue" ng-disabled="true" n-decimals="4" class="form-control"   required autocomplete="off" tabindex="4" maxlength="50">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="8"></textarea>
                    </div>
                </div>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="11"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>

        </div>
    </div>

</div>

<confirm-archive-generic modalid="confirmUtilityDetailsRemovePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeUtilityDetailsRow();"></confirm-archive-generic>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            @*<div e-column e-field="Id" e-headertext="Id" e-width="3" e-isprimarykey="true"></div>*@
            <div e-column e-field="ReadingDate" e-headertext="Date" e-width="3"></div>
            <div e-column e-field="UtilityMaster" e-headertext="Utility Master" e-width="5"></div>
            <div e-column e-field="UoM" e-headertext="UoM" e-width="5"></div>
            <div e-column e-field="Quantity" e-headertext="Quantity" e-width="4"></div>
            <div e-column e-field="Reading" e-headertext="Reading" e-width="4"></div>
            <div e-column e-field="LastReading" e-headertext="Last Reading" e-width="4"></div>
            <div e-column e-field="LastReadingDate" e-headertext="Last Reading Date" e-width="4"></div>
            <div e-column e-field="LastReadingTime" e-headertext="Last Reading Time" e-width="4"></div>
            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="2"></div>
        </div>
    </div>
</div>
 
<div class="modal fade site-modal in" id="UtilityMasterpopUpId" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header">Utility Master<button type="button" class="close" ng-click="closePopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByUtility">
                                            <option ng-repeat="option in searchbyUtilityTransactionlist" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchUtility" ng-enter="getUtilityTransactionPopUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getUtilityTransactionPopUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="content-container-fluid">

                        <div style="color:black;" id="utilityPopUpGrid" ej-grid e-datasource="utilityMasterList" e-recorddoubleclick="selectDoubleClick"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="UtilityMaster" e-headertext="Utility Master" e-width="80" e-filter="false"></div>
                                <div e-column e-field="UtilityGroup" e-headertext="Utility Group" e-width="80"></div>
                                <div e-column e-field="UtilitySubGroup" e-headertext="Utility SubGroup" e-width="100"></div>
                                <div e-column e-field="UtilityCategory" e-headertext="Utility Category" e-width="50"></div>
                                <div e-column e-field="UtilitySubCategory" e-headertext="Utility SubCategory" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="MultiplyingFactor" e-headertext="Multiplying Factor" e-width="80" textAlign='Right'></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closePopUp();" class="btn"> Close</button></li>
                </ul>
               
            </div>
        </div>
    </div>
</div>

<confirm-modal></confirm-modal>
