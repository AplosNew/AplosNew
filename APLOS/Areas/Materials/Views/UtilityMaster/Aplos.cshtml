<togglable name="{{title}}"></togglable>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <input type="hidden" ng-model="ModelNew.Id">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">General</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Details</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="asset" role="tab" data-toggle="tab">Asset</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Sequence" tabindex="1" ej-numerictextbox e-decimalplaces="0" e-minvalue="1" e-enablertl="false" e-value="ModelNew.Sequence" e-width="100%" required />
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Short Name" ng-model="ModelNew.ShortName" class="form-control" maxlength="15" autocomplete="off" required tabindex="3">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">User Defined Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required autocomplete="off" tabindex="5" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Utility Group<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <div class="select-style">
                                <select name="UtilityGroup" ng-model="ModelNew.UtilityGroupId" class="col-sm-3 form-control" ng-options="item.Value as item.Text for item in UtilityGroupList" tabindex="7"></select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Utility Category<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.UtilityCategory" class="form-control" required autocomplete="off" tabindex="9" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Item<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.Item" class="form-control" required autocomplete="off" tabindex="11" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Is Party Applicable</label>
                        <div class="col-sm-2">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ModelNew.IsPartyApplicable" ng-change="ChangeCustomer();" tabindex="13">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                        <label class="col-sm-2 control-label">Party<sup>*</sup></label>
                        <div class="col-sm-4" @*ng-show="ModelNew.IfPartyApplicable==true"*@>
                            <div class="input-group">
                                <input type="text" name="Party" ng-model="ModelNew.PartyName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="ShowCustomerPopUpNew(partyType);" ng-disabled="ModelNew.IsPartyApplicable == false" class="btn single-small-btn" tabindex="15"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Is Reading Applicable</label>
                        <div class="col-sm-2">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ModelNew.IsReadingApplicable" @*ng-change="ChangeReading();"*@ tabindex="17">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Entry Leg Days<sup>*</sup></label>
                        <div class="col-sm-8">
                            <input class="form-control" rows="3" ng-model="ModelNew.EntryLegDays" only-numbers tabindex="19" maxlength="250"></input>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Description</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="ModelNew.Description" tabindex="21" maxlength="250"></textarea>
                        </div>
                    </div>

                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Code" ng-model="ModelNew.Code" class="form-control" required autocomplete="off" tabindex="2" maxlength="10">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.StandardName" class="form-control" required autocomplete="off" tabindex="4" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Active</label>
                        <div class="col-sm-8">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="ModelNew.Active" tabindex="6">
                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Utility SubGroup<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.UtilitySubGroup" class="form-control" required autocomplete="off" tabindex="8" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Utility SubCategory<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="Standard Name" ng-model="ModelNew.UtilitySubCategory" class="form-control" required autocomplete="off" tabindex="10" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">InPut Source<sup>*</sup></label>
                        <div class="col-sm-8 show-message">
                            <input type="text" name="InPutSource" ng-model="ModelNew.InPutSource" class="form-control" required autocomplete="off" tabindex="10" maxlength="50">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">UoM<sup>*</sup> </label>
                        <div class="col-sm-8">
                            <div class="select-style">
                                <select id="UoMId" class="form-control" ng-model="ModelNew.UoMId" name="UoM" tabindex="12">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="option in uOMList" value="{{option.Value}}">{{option.Text}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Responsible Person<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" name="Responsible Person" ng-model="ModelNew.ResponsiblePersonName" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp('mo');" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Admin<sup>*</sup></label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                <input type="text" name="Admin" ng-model="ModelNew.Admin" class="form-control" readonly>
                                <span class="input-group-btn">
                                    <button ng-click="showEmployeeListPopUp('ad');" class="btn single-small-btn" tabindex="16"><i class="glyphicon glyphicon-search"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" maxlength="250" tabindex="18"></textarea>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="22"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="23"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="24"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="form-horizontal form-elements" ng-form="modelNewForm">
                        <fieldset class="scheduler-border">
                            <legend class="scheduler-border"></legend>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="ModelChildNew.EffectiveDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="1">
                                    </div>
                                </div>
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Rate<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" n-decimals="4" name="Rate" ng-model="ModelChildNew.Rate" class="form-control text-right" required tabindex="2">
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-6 col-md-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Remarks</label>
                                    <div class="col-sm-8">
                                        <textarea class="form-control" rows="3" ng-model="ModelChildNew.Remark" maxlength="250" tabindex="3"></textarea>
                                    </div>
                                </div>

                            </div>
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="SaveChild();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                                    <li> <button ng-click="ClearUtilityDetail();" class="btn" tabindex="12"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                </ul>
                            </div>
                        </fieldset>
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <div class="table-responsive modal-table" ng-show="utilityDetails.length>0">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Effective Date</th>
                                            <th>Rate</th>
                                            <th>Remarks</th>
                                            <th>Remove</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in utilityDetails" ng-dblclick="UtilityDetaildoubleclick(x);" ng-class="{selected : x.Id==null}">
                                            <td>{{x.EffectiveDates}}</td>
                                            <td>{{x.Rate}}</td>
                                            <td>{{x.Remark}}</td>
                                            <td class="text-right table-td">
                                                <ul class="list-inline action-list">
                                                    <li>
                                                        <button ng-click="removeUtilityDetailsRowModal(x.Id)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="GetAssetpDataList();" ng-disabled="ModelNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Asset</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <div class="table-responsive modal-table" ng-show="userReportGroupList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Report Group</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userReportGroupList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.UserName}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeRowModal(x.ProcessName, $index, 'userReportGroupList', 'Id', 'ReportingGroupId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
<confirm-archive-generic modalid="confirmUtilityDetailsRemovePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeUtilityDetailsRow();"></confirm-archive-generic>

<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ng-init="chkinit()" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-visible="false" e-isprimarykey="true"></div>
            <div e-column e-field="Sequence" e-headertext="Sequence" e-width="2"></div>
            <div e-column e-field="Code" e-headertext="Code" e-width="3"></div>
            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="5"></div>
            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="5"></div>
            <div e-column e-field="UserName" e-headertext="User Name" e-width="5"></div>
            <div e-column e-field="Active" e-headertext="Active" e-width="2"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="CustomerPopUpNew" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg ">
        <div class="modal-content">
            <div class="modal-header"> {{partyType}} List <button type="button" class="close" ng-click="closeCustomerPopUpNew();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="row text-right">
                    <div class="col-md-12">
                        <div class="col-sm-2">
                            <div class="form-group">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="IsProrataMonthlyColu" ng-model="partyType" value="Vendor" ng-change="ShowCustomerPopUpNew(partyType);">
                                        <span class="cr"><i class="cr-icon"></i></span>Vendor
                                    </label>

                                </div>
                            </div>
                        </div>

                        <div class="col-sm-2">
                            <div class="form-group">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="IsProrataMonthlyColu" ng-model="partyType" value="Customer" ng-change="ShowCustomerPopUpNew(partyType);">
                                        <span class="cr"><i class="cr-icon"></i></span>Customer
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-2">
                            <div class="form-group">
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="IsProrataMonthlyColu" ng-model="partyType" value="All" ng-change="ShowCustomerPopUpNew(partyType);">
                                        <span class="cr"><i class="cr-icon"></i></span>All
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="searchByParty">
                                            <option ng-repeat="option in searchByPartyList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="searchParty" ng-enter="ShowCustomerPopUpNew(partyType)">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="ShowCustomerPopUpNew(partyType)" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        <div style="color:black;" id="customerPopUpGrid" ej-grid e-datasource="partyList" e-recorddoubleclick="SetCustomerData"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="Code" e-headertext="Code" e-width="50" e-filter="false"></div>
                                <div e-column e-field="UserName" e-headertext="Party" e-width="130"></div>
                                <div e-column e-field="PartyAccountGroupName" e-headertext="Account Group" e-width="130"></div>
                                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                <div e-column e-field="CountryName" e-headertext="Country" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="StateName" e-headertext="State" e-width="80" textAlign='Right'></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeCustomerPopUpNew();" class="btn"> Close</button></li>
                </ul>
                <i>**Showing top 100 {{partyType}} order by Code</i>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="employeePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="employeeParameters.searchBy">
                                            <option ng-repeat="option in searchEmployeeByList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="employeeParameters.search" ng-enter="getEmployeeData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeeData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee Code</th>
                                <th>First Name</th>
                                <th>Middle Name</th>
                                <th>Last Name</th>
                                <th>Employee Name</th>
                                <th>Date Of Birth</th>
                                <th>Designation</th>
                                <th>Entity</th>
                                <th>Department</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in employeeList|itemsPerPage:employeeParameters.pageSize" total-items="employeeParameters.total_count"
                                ng-click="selectEmployeePopUp($index, x.SystemId)" ng-class="{selected : x.SystemId == selectedEmployee}" ng-dblclick="closeEmployeePopUp();" pagination-id="metaData.name + 'employeeList'">
                                <td>{{x.EmployeeCode}}</td>
                                <td>{{x.FirstName}}</td>
                                <td>{{x.MiddleName}}</td>
                                <td>{{x.LastName}}</td>
                                <td>{{x.EmployeeName}}</td>
                                <td>{{x.DOB | dateFiltering}}</td>
                                <td>{{x.Designation}}</td>
                                <td>{{x.EntityName}}</td>
                                <td>{{x.Department}}</td>
                                <td>{{x.EmploymentType}}</td>
                                <td>{{x.EmployeeStatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'employeeList'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeeData(newPageNumber)">
                </dir-pagination-controls>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Select</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="AssetPopUp" role="dialog" data-backdrop="static">
