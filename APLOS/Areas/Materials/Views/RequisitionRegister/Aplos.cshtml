<div id="Test">
    <h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Requisition Register</h3>
    <div class="form-elements form-horizontal" ng-form="from0">
        <div class="col-xs-12 col-sm-6 col-md-6">
			<fieldset class="scheduler-border">
				<legend class="scheduler-border">Select Options</legend>
				<div class="col-xs-12 col-sm-12 col-md-12">
					<div class="form-group">
						<label class="col-sm-3 control-label" title="Select Option" tooltip>Select Option<sup>*</sup></label>
						<div class="col-sm-9 show-message">
							<div class="radio">
								<label>
									<input ng-click="changeSourceFrom('AllData')" type="radio" name="As On Date" ng-model="productNew.AsOnDate" value="AllData" ng-checked="true">
									<span class="cr" tabindex="21"><i class="cr-icon"></i></span>All Data
								</label>
								<label>
									<input ng-click="changeSourceFrom('EmployeeWise')" type="radio" name="For The Period" ng-model="productNew.AsOnDate" value="EmployeeWise">
									<span class="cr" tabindex="22"><i class="cr-icon"></i></span>Employee Wise
								</label>

							</div>
						</div>
					</div>
				</div>

				<div class="clearfix"></div>
				<div class="clearfix"></div>
				<div class="col-xs-12 col-sm-6 col-md-6">
					<fieldset class="scheduler-border" ng-hide="true">
						<legend class="scheduler-border">Select Asset / Inventory</legend>
						<div class="form-group">
							<label class="col-sm-3 control-label"></label>
							<div class="col-sm-1">
								<div class="checkbox-site">
									<label>
										<input type="checkbox" ng-model="productNew.Asset " value="Asset">
										<span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
									</label>
								</div>
							</div>
							<label class="col-sm-4 control-label"> Asset</label>
						</div>

						<div class="clearfix"></div>
						<div class="form-group">
							<label class="col-sm-3 control-label"></label>
							<div class="col-sm-1">
								<div class="checkbox-site">
									<label>
										<input type="checkbox" ng-model="productNew.Inventory" value="Inventory">
										<span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
									</label>
								</div>
							</div>
							<label class="col-sm-4 control-label">Inventory</label>
						</div>
					</fieldset>
				</div>
				<fieldset class="scheduler-border" ng-hide="true">
					<legend class="scheduler-border">Select Qty / Amount</legend>
					<div class="form-group">
						<label class="col-sm-3 control-label"></label>
						<div class="col-sm-1">
							<div class="checkbox-site">
								<label>
									<input type="checkbox" ng-model="productNew.Qty" value="Qty" ng-disabled="false">
									<span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
								</label>
							</div>
						</div>
						<label class="col-sm-4 control-label"> Qty</label>
					</div>
					<div class="clearfix"></div>
					<div class="form-group">
						<label class="col-sm-3 control-label"></label>
						<div class="col-sm-1">
							<div class="checkbox-site">
								<label>
									<input type="checkbox" ng-model="productNew.Amount" value="Amount">
									<span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
								</label>
							</div>
						</div>
						<label class="col-sm-4 control-label">Amount</label>
					</div>
				</fieldset>
				<div class="clearfix"></div>
				<div class="form-group" show-errors id="div_FromDate">
					<label class="col-sm-3 control-label">From Date<sup>*</sup></label>
					<div class="col-sm-9 show-message">
						<input type="text" name="Form Date" ng-model="report.FromDate" datepicker tabindex="2" class="form-control">  @*ng-disabled="productNew.AsOnDate==='AsOnDate'"*@
					</div>
				</div>
				<div class="form-group" show-errors id="div_ToDate">
					<label class="col-sm-3 control-label">To Date<sup>*</sup></label>
					<div class="col-sm-9  show-message">
						<input type="text" name="To Date" ng-model="report.ToDate" datepicker tabindex="3" class="form-control" ng-change="EmpList();">
					</div>
				</div>
				<div class="form-group" ng-hide="productNew.Type==='AllData'">
					<label class="col-sm-3 control-label">Employee</label>
					<div class="col-sm-9 show-message">
						<div class="select-style">
							<select id="paymentTermId" class="form-control" name="Entity" ng-model="productNew.EmployeeId" tabindex="1">
								<option ng-repeat="option in EmployeeList" value="{{option.Value}}">{{option.Text}}</option>

							</select>
						</div>
					</div>
				</div>
				<div class="clearfix"></div>
				<div class="clearfix"></div>
				<div class="form-group" ng-hide="true">
					<label class="col-sm-3 control-label"></label>
					<div class="col-sm-1">
						<div class="checkbox-site">
							<label>
								<input type="checkbox" ng-model="productNew.RcptIssue" ng-hide="productNew.AsOnDate==='AsOnDate'">
								<span class="cr" ng-hide="productNew.AsOnDate==='AsOnDate'"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
							</label>
						</div>
					</div>
					<label class="col-sm-4 control-label" ng-hide="productNew.AsOnDate==='AsOnDate'"> With Receipts & Issue</label>
				</div>

			</fieldset>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-left">

                <li>
                    <div ej-tooltip e-showshadow="true" e-content="All active orders with individual line items" ng-click="getRequisitionRegisterReport('Pdf');" e-width="width">
                        <button class="btn"><i class="glyphicon glyphicon-file"></i>Export To Pdf</button>
                    </div>
                </li>

                <li>
                    <div ej-tooltip e-showshadow="true" e-content="All active orders with individual line items" ng-click="getRequisitionRegisterReport('Excel');" e-width="width">
                        <button class="btn"><i class="glyphicon glyphicon-file"></i>Export To Excel</button>
                    </div>
                </li>

            </ul>
        </div>

