                                    <div class="select-style">
                                        <select ng-model="grnDetailParameters.searchBy">
                                            <option ng-repeat="option in searchGRNDetailByList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
