                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             pagination-id="metaData.name + 'grnDetailList'"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="getGRNDetailData(newPageNumber)">
                    </dir-pagination-controls>
                </div>

            </div>
            <div class="modal-footer common-btn">
                @*<button ng-click="closeGRNPopUp();" class="btn"><i class=""></i> Select</button>*@
            </div>
