<togglable name="Detention Master"></togglable>

<div class="form-elements">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Detention</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="doc" role="tab" data-toggle="tab">Department</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="doc" role="tab" data-toggle="tab">Process</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="doc" role="tab" data-toggle="tab">Machine</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">

                <div class="form-elements form-horizontal" ng-form="DetentionMasterForm">
                    <div class="row">
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Detention Category<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Detention Category" ng-model="detentionNew.DetentionCategory " class="form-control" maxlength="100" required autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Detention Sub Category<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Detention Sub Category" ng-model="detentionNew.DetentionSubCategory" class="form-control" maxlength="100" required autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Detention Standared Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Detention Standared Name" ng-model="detentionNew.DetentionStandaredName" class="form-control" maxlength="100" required autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Detention User Name<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Detention User Name" ng-model="detentionNew.DetentionUserName" class="form-control" required maxlength="100" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Detention Type<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Detention Type" ng-model="detentionNew.DetentionType" class="form-control" required maxlength="100" autocomplete="off">
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-6 col-md-6">
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Detention Criticality<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Detention Criticality" ng-model="detentionNew.DetentionCriticality" class="form-control" required maxlength="100" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Responsible Persion (Employee)<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Responsible Persion" ng-model="detentionNew.ResponsiblePersion" class="form-control" required maxlength="100" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Detention Target(%)<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Detention Target" ng-model="detentionNew.DetentionTarget" class="form-control" required maxlength="100" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group" show-errors>
                                <label class="col-sm-4 control-label">Detention Plan(%)<sup>*</sup></label>
                                <div class="col-sm-8 show-message">
                                    <input type="text" name="Detention Plan" ng-model="detentionNew.DetentionPlan" class="form-control" required maxlength="100" autocomplete="off">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Is Avoidable</label>
                                <div class="col-sm-8">
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" class="css-checkbox" ng-model="detentionNew.IsAvoidable">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-right">
                                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                                <li> <button data-toggle="modal" data-target="#confirmPopUp" ng-disabled="detentionNew.Id===null" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                            </ul>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="DepartmentPopUpList();" ng-disabled="detentionNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Department</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="userDepartMentList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Sequence</th>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>
                                        <th>Department</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userDepartMentList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Sequence}}</td>
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.Department}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeDeptRowModal(x.Department, $index, 'userDepartMentList', x.Id, 'DepartmentId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        @*</div>
                            </div>*@
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="processPopUpDataList();" ng-disabled="detentionNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Process</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="userProcessList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Sequence</th>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>

                                        <th>Process</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userProcessList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Sequence}}</td>
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>

                                        <td>{{x.Process}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeRowModal(x.Process, $index, 'userProcessList', x.Id, 'ProcessId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        @*</div>
                            </div>*@
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="MachinePopUpList();" ng-disabled="detentionNew.Id===null" class="btn"><i class="glyphicon glyphicon-plus"></i> Add Machine</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <div class="table-responsive modal-table" ng-show="userMachineList.length>0">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Sequence</th>
                                        <th>Code</th>
                                        <th>Short Name</th>
                                        <th>Standard Name</th>
                                        <th>Machine</th>
                                        <th>Remove</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in userMachineList" ng-class="{selected : x.Id==null}">
                                        <td>{{x.Sequence}}</td>
                                        <td>{{x.Code}}</td>
                                        <td>{{x.ShortName}}</td>
                                        <td>{{x.StandardName}}</td>
                                        <td>{{x.Machine}}</td>
                                        <td class="text-right table-td">
                                            <ul class="list-inline action-list">
                                                <li>
                                                    <button ng-click="removeMachineRowModal(x.Machine, $index, 'userMachineList', x.Id, 'MachineMasterId')" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        @*</div>
                            </div>*@
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="table-responsive aplos-grid-toggle">
    <div id="GridDetentionMaster" ej-grid e-datasource="DetentionList" e-recorddoubleclick="GetDetails" e-load="loadRackList"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Detention Id" e-width="3"></div>
            <div e-column e-field="DetentionCategory" e-headertext="Detention Category " e-width="3"></div>
            <div e-column e-field="DetentionSubCategory" e-headertext="Detention Sub Category " e-width="3"></div>
            <div e-column e-field="DetentionStandaredName" e-headertext="Detention Standared Name" e-width="3"></div>
            <div e-column e-field="DetentionUserName" e-headertext="Detention User Name" e-width="3"></div>
            <div e-column e-field="DetentionType" e-headertext="Detention Type" e-width="3"></div>
            <div e-column e-field="DetentionCriticality" e-headertext="Detention Criticality" e-width="3"></div>
            <div e-column e-field="ResponsiblePersion" e-headertext="Responsible Persion" e-width="3"></div>
            <div e-column e-field="DetentionTarget" e-headertext="Detention Target" e-width="3"></div>
            <div e-column e-field="DetentionPlan" e-headertext="Detention Plan" e-width="3"></div>
            <div e-column e-field="Avoidable" e-headertext="Is Avoidable" e-width="3"></div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="processPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Process<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="processPopUpParameters.searchBy">
                                            <option ng-repeat="option in processSearchList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="processPopUpParameters.search" ng-enter="getProcessDataList();">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getProcessDataList();" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Select</th>
                                <th>Code</th>
                                <th>Short Name</th>
                                <th>Standard Name</th>
                                <th>Process Name</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in processDataList|itemsPerPage:processPopUpParameters.pageSize" pagination-id="metaData.name + 'processDataList'" total-items="processPopUpParameters.total_count">
                                <td>
                                    <div class="checkbox-site">
                                        <label>
                                            <input type="checkbox" ng-model="x.Flag" ng-checked="x.Flag" ng-click="genericPushInTempList(x, $event, userProcessList, 'Id', 'ProcessId' );">
                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                        </label>
                                    </div>
                                </td>
                                <td>{{x.Code}}</td>
                                <td>{{x.ShortName}}</td>
                                <td>{{x.StandardName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.Active?'Yes':'No'}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls pagination-id="metaData.name + 'processDataList'"
                                             max-size="10" direction-links="true" boundary-links="true"
                                             on-page-change="getProcessDataList(newPageNumber)">
                    </dir-pagination-controls>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button type="button" class="btn btn-default" ng-click="SaveProcess();">Add</button></li>
                        <li><button type="button" class="btn btn-default" ng-click="closeProcessPopUp();">Cancel</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="departmentPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Department<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row">
                    <div style="color:black;" id="GridDetentionMasterDepartment" ej-grid e-datasource="DepartmentDataList"
                         e-templaterefresh="DepartmentGridAllCheck"
                         e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true" e-showsummary="true"
                         e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="7"></div>
                            <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="50"></div>
                            <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
                            <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="50"></div>
                            <div e-column e-type="string" e-field="UserName" e-headertext="Department Name" e-width="50"></div>
                            <div e-column e-type="string" e-field="Active" e-headertext="Active" e-width="50"></div>
                        </div>
                    </div>
                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headchk" />
                    </script>
                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
                    </script>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button type="button" class="btn btn-default" ng-click="SaveDepartment();">Add</button></li>
                            <li><button type="button" class="btn btn-default" ng-click="closeDeptPopUp();">Cancel</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="MachinePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Machine<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row">
                    <div style="color:black;" id="GridDetentionMasterMachine" ej-grid e-datasource="MachineDataList"
                         e-templaterefresh="DepartmentGridAllCheck"
                         e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowscrolling="true" e-showsummary="true"
                         e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplateMachine" e-template="#checkboxTemplateMachine" e-textalign="center" e-width="7"></div>
                            <div e-column e-type="string" e-field="Code" e-headertext="Code" e-width="50"></div>
                            <div e-column e-type="string" e-field="ShortName" e-headertext="Short Name" e-width="100"></div>
                            <div e-column e-type="string" e-field="StandardName" e-headertext="Standard Name" e-width="50"></div>
                            <div e-column e-type="string" e-field="UserName" e-headertext="Machine Name" e-width="50"></div>
                            <div e-column e-type="string" e-field="Active" e-headertext="Active" e-width="50"></div>
                        </div>
                    </div>
                    <script type="text/x-jsrender" id="headerTemplateMachine">
                        <input type="checkbox" id="headchk" />
                    </script>
                    <script type="text/template" id="checkboxTemplateMachine">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="data.chk" e-checked="data.chk" />
                    </script>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button type="button" class="btn btn-default" ng-click="SaveMachine();">Add</button></li>
                            <li><button type="button" class="btn btn-default" ng-click="closeMachinePopUp();">Cancel</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmRemovePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmRemoveDeptPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeDeptRow();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmRemoveMachinePopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeMachineRow();"></confirm-archive-generic>



