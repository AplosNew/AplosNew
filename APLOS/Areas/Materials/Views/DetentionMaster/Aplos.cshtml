<togglable name="Detention Master"></togglable>
<div class="form-elements form-horizontal" ng-form="DetentionMasterForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Detention Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="detentionNew.DetentionCategory " class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Detention Sub Category<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Detention Sub Category " ng-model="detentionNew.DetentionSubCategory" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Detention Standared Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="detentionNew.DetentionStandaredName" class="form-control" maxlength="100" required autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Detention User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="detentionNew.DetentionUserName" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Detention Type<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="detentionNew.DetentionType" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Detention Criticality<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="detentionNew.DetentionCriticality" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Responsible Persion (Employee)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="detentionNew.ResponsiblePersion" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Detention Target(%)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="detentionNew.DetentionTarget" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Detention Plan(%)<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="detentionNew.DetentionPlan" class="form-control" required maxlength="100" autocomplete="off">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Is Avoidable</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" class="css-checkbox" ng-model="detentionNew.IsAvoidable">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
        <div class="clearfix"></div>
    </div>
</div>
    <div class="table-responsive aplos-grid-toggle">
        <div id="GridRackList" ej-grid e-datasource="DetentionList" e-recorddoubleclick="GetDetails" e-load="loadRackList"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Detention Id" e-width="3"></div>
                <div e-column e-field="DetentionCategory" e-headertext="Detention Category " e-width="3"></div>             
                <div e-column e-field="DetentionSubCategory" e-headertext="Detention Sub Category " e-width="3"></div>
                <div e-column e-field="DetentionStandaredName" e-headertext="Detention Standared Name" e-width="3"></div>
                <div e-column e-field="DetentionUserName" e-headertext="Detention User Name" e-width="3"></div>
                <div e-column e-field="DetentionType" e-headertext="Detention Type" e-width="3"></div>
                <div e-column e-field="DetentionCriticality" e-headertext="Detention Criticality" e-width="3"></div>
                <div e-column e-field="ResponsiblePersion" e-headertext="Responsible Persion" e-width="3"></div>             
                <div e-column e-field="DetentionTarget" e-headertext="Detention Target" e-width="3"></div>             
                <div e-column e-field="DetentionPlan" e-headertext="Detention Plan" e-width="3"></div>             
                <div e-column e-field="IsAvoidable" e-headertext="Is Avoidable" e-width="3"></div>             
            </div>
        </div>
    </div>
<confirm-modal></confirm-modal>
