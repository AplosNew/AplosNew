    .cmn-btn {
        background: #3e445a none repeat scroll 0 0;
        border: 1px solid #3e445a;
        border-radius: unset;
        color: #fff;
        font-size: 15px;
        /* font-weight: 600; */
        letter-spacing: 0.65px;
        line-height: normal;
        padding: 6px 15px;
        text-transform: none;
        transition: all 0.3s linear 0s;
    }

        .cmn-btn:hover {
            background: #EA6153 none repeat scroll 0 0;
            border: 1px solid #EA6153;
            color: #fff !important;
            outline: none;
        }
</style>






