<style>
    .modellgModify1 {
        width: 1300px;
    }

    .cmn-btn {
        background: #3e445a none repeat scroll 0 0;
        border: 1px solid #3e445a;
        border-radius: unset;
        color: #fff;
        font-size: 15px;
        /* font-weight: 600; */
        letter-spacing: 0.65px;
        line-height: normal;
        padding: 6px 15px;
        text-transform: none;
        transition: all 0.3s linear 0s;
    }

        .cmn-btn:hover {
            background: #EA6153 none repeat scroll 0 0;
            border: 1px solid #EA6153;
            color: #fff !important;
            outline: none;
        }
</style>
<togglable name="Storage Bin Allocation"></togglable>

<div class="form-elements form-horizontal" ng-form="ModelNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">Bin Allocation Header</legend>
        <input type="hidden" ng-model="ModelNew.Id">
        @*<div class="row">*@
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">User Name </label>
                <div class="col-sm-6 show-message">
                    <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" tabindex="5" maxlength="30" autocomplete="off">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Storage Sub Location<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-change="getAccessType();" ng-model="ModelNew.StorageSubLocation" required name="Storage Location"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in StorageSubLocationList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Storage Level<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.StorageLevel" required name="Storage Location Level"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option value="Material">Material</option>
                            <option value="Article">Article</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Material Group<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-change="getMaterial();" ng-model="ModelNew.MaterialGroupMasterId" required name="Material Group"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in MaterialGroupList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>



            <div class="form-group">
                <label class="col-sm-4 control-label">No. Of Bin</label>
                <div class="col-sm-6 show-message">
                    <input type="number" name="No Of Bin" ng-model="ModelNew.NoOfBin" class="form-control" tabindex="5" maxlength="30">
                </div>
            </div>


        </div>

        <!--
     //** ----------------------------------------------------  **//
    -->

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Storage Location<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-change="getStorageSubLocation()" ng-model="ModelNew.StorageLocationId" required name="Storage Location"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in StorageLocationList" value="{{option.Value}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Access Type<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.AccessType" required name="Access Type"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in AccessTypeList" value="{{option.Text}}">{{option.Text}}</option>

                        </select>
                    </div>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Material Type<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-change="getMaterialGroup()" ng-model="ModelNew.MaterialTypeId" required name="Material Type"
                                tabindex="2">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in MaterialTypeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>


            <div class="form-group">
                <label class="col-sm-4 control-label">Material</label>
                <div class="col-sm-6 show-message">

                    <input e-change="getMaterialArticle" ej-dropdownlist e-enablefiltersearch="true" e-datasource="MaterialList" ng-model="ModelNew.MaterialMasterId" e-fields-value="Value" e-fields-text="Text" e-width="100%" />

                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-6">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.Remarks" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>

        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="selectIDs();" class="btn"><i class="glyphicon glyphicon-chevron-down"></i> View</button></li>
            </ul>
        </div>
    </fieldset>
    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="general" role="tab" data-toggle="tab">Material Allocation</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Service" role="tab" data-toggle="tab">Bin Allocation</a></li>

            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="table-responsive">
                    <div id="GridEdit"
                         ej-grid e-datasource="BinHeadList"
                         e-load="loadGridEdit"
                         e-allowfiltering="true"
                         e-allowpaging="true"
                         e-allowsorting="true"
                         e-enabletouch="false"
                         e-responsive="true"
                         e-allowselection="true"
                         e-filtersettings-filterType="excel"
                         e-templaterefresh="MaterialAllocationGridAllCheck"
                         e-allowtextwrap="true">

                        <div e-columns>
                            <div e-column e-headertext="Select" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="10"></div>


                            <div e-column e-field="ArticleName" e-headertext="Material Article" e-width="80"></div>

                            <div e-column e-headertext="Estimated Capacity" e-template="#EstimatedCapacity" e-textalign="center" e-width="50"></div>
                        </div>
                    </div>
                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headchk" />
                    </script>
                    <script type="text/template" id="checkboxTemplate">

                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.chk" e-value="data.chk" />
                    </script>

                    <script type="text/template" id="EstimatedCapacity">
                        <input type="text" name="User Name" ng-model="data.EstimatedCapacity" class="form-control" required tabindex="5" maxlength="30">
                    </script>
                </div>
                <div class="common-btn" style="margin-top:10px">

                    <ul class="list-inline text-right">

                        @* <li> <button class="btn" ng-click="selheaderBin()" tabindex="11"><i class="glyphicon"></i> Select</button></li>*@
                        @*<li> <button ng-click="SaveMaterialAllocation();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>*@

                    </ul>

                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                <div class="table-responsive">
                    <div id="GridEditB" ej-grid e-datasource="BinAllocationChildList" e-load="loadGridEdit"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true" e-templaterefresh="BinAllocationGridAllCheck">
                        <div e-columns>
                            <div e-column e-headertext="Select" e-headertemplateid="#headerTemplateB" e-template="#checkboxTemplateB" e-textalign="center" e-width="20"></div>
                            <div e-column e-field="AreaRackCode" e-headertext="Area Rack Code" e-width="70"></div>
                            <div e-column e-field="ColumnNo" e-headertext="Column No" e-width="80"></div>
                            <div e-column e-field="RowNo" e-headertext="RowNo" e-width="80"></div>
                            <div e-column e-field="BinReference" e-headertext="Bin Reference" e-width="100"></div>
                            <div e-column e-field="BinCode" e-headertext="Bin Code" e-width="80"></div>
                            <div e-column e-field="CapacityValue" e-headertext="Capacity Value " e-width="80"></div>
                            <div e-column e-field="UserLocationType" e-headertext="User Location Type" e-width="100"></div>

                        </div>
                    </div>
                    <script type="text/x-jsrender" id="headerTemplateB">
                        <input type="checkbox" id="headchkB" />
                    </script>

                    <script type="text/template" id="checkboxTemplateB">

                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.chk" e-value="data.chk" />
                    </script>
                </div>
                <div class="common-btn" style="margin-top:10px">

                    <ul class="list-inline text-right">

                        @*<li> <button class="btn" ng-click="selBinAllocation()" tabindex="11"><i class="glyphicon"></i> Select</button></li>*@
                        @*<li> <button ng-click="SaveBinAllocation();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>*@

                    </ul>

                </div>
            </div>


            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn cmn-btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                @*<li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>*@
                @*<li> <button ng-click="Clear();" class="btn cmn-btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>*@
            </ul>
        </div>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="searchByBinAllocation">
                                <option ng-repeat="option in searchByBinAllocationList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="searchBinAllocation" ng-enter="getbinAllocationHeadDataList();">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getbinAllocationHeadDataList()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content-container-fluid" style="color:black;">
        <div style="color:black;" id="GridPrint" ej-grid e-datasource="binAllocationHeads" e-allowfiltering="true" e-allowpaging="true"
             e-allowsorting="true" e-allowResizing="true" e-filtersettings-filterType="excel" e-enabletouch="true" e-recorddoubleclick="Get"
             e-actioncomplete="actionCompleteSelected" e-allowscrolling="true" e-showstackedheader="true">
            <div e-columns>
                <div e-column e-field="UserName" e-headertext="UserName" e-width="60" e-filter="false"></div>
                <div e-column e-field="MaterialStorage" e-headertext="Material Storage" e-width="180"></div>
                <div e-column e-field="MaterialType" e-headertext="Material Type" e-width="80" textAlign='Left'></div>
                <div e-column e-field="MaterialGroup" e-headertext="Material Group" e-width="80" textAlign='Left'></div>
                <div e-column e-field="MaterialName" e-headertext="Material " e-width="80" textAlign='Left'></div>
                <div e-column e-field="AccessType" e-headertext="AccessType " e-width="80" textAlign='Left'></div>
                <div e-column e-headertext="Actions" e-width="30">
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 20px;padding-top:1px;" class="btn"><i class="glyphicon glyphicon-print" title="Print Report" ng-click="$parent.GetStorageBinAllocation(data);" style="margin: -6px;"></i></button>
                </div>
                @*<div e-column e-headertext="Report" e-template="#ReportTemplate" e-width="100"></div>
                <div e-column e-headertext=" Action " e-template="#DeleteTemplate" e-width="120"></div>*@
            </div>
        </div>
  
        <div class="col-md-12 text-right" style="padding-top: 17px;">
            <ul class="common-btn list-inline text-right">
                <li> <button ng-click="GetStorageBinAllocationAllReport();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Download</button></li>
            </ul>
        </div>
    </div>
</div>

