<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="ModelNewForm">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">Bin Allocation Header</legend>
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">User Name </label>
                    <div class="col-sm-6 show-message">
                        <input type="text" name="User Name" ng-model="ModelNew.UserName" class="form-control" required tabindex="5" maxlength="30" autocomplete="off">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Storage Sub Location</label>
                    <div class="col-sm-6 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-change="getAccessType();" ng-model="ModelNew.StorageSubLocation" required name="Storage Location"
                                    tabindex="2">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in StorageSubLocationList" value="{{option.Text}}">{{option.Text}}</option>

                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Storage Level<sup>*</sup></label>
                    <div class="col-sm-6 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ModelNew.StorageLevel" required name="Storage Location"
                                    tabindex="2">
                                <option value="">--Select--</option>
                                <option value="Material">Material</option>
                                <option value="Article">Article</option>

                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-4 control-label">Material Group</label>
                    <div class="col-sm-6 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-change="getMaterial();" ng-model="ModelNew.MaterialGroupMasterId" required name="Material Group"
                                    tabindex="2">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in MaterialGroupList" value="{{option.Value}}">{{option.Text}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                


                <div class="form-group">
                    <label class="col-sm-4 control-label">No. Of Bin</label>
                    <div class="col-sm-6 show-message">
                        <input type="number" name="No Of Bin" ng-model="ModelNew.NoOfBin" class="form-control" required tabindex="5" maxlength="30">
                    </div>
                </div>


            </div>

            <!--
             //** ----------------------------------------------------  **//
            -->

            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Storage Location</label>
                    <div class="col-sm-6 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-change="getStorageSubLocation()" ng-model="ModelNew.StorageBinmasterId" required name="Storage Location"
                                    tabindex="2">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in StorageLocationList" value="{{option.Value}}">{{option.Text}}</option>

                            </select>
                        </div>
                    </div>
                </div>
