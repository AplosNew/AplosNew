<togglable name="Material Master AlternativeUOM Informations"></togglable>
<div class="form-elements" ng-form id="materialMasterAlternativeUOM" name="materialMasterAlternativeUOMForm">
    <input type="hidden" ng-model="materialMasterAlternativeUOM.Id">
    <input type="hidden" ng-model="materialMasterAlternativeUOM.AddedBy">
    <input type="hidden" ng-model="materialMasterAlternativeUOM.AddedDate">
    <input type="hidden" ng-model="materialMasterAlternativeUOM.AddedFromIP">
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Material Master<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select submit-="true" ng-model="materialMasterAlternativeUOM.MaterialMasterId" class="form-control" name="Material Master"
                            ng-options="item.Value as item.Text for item in materialMasterList" required tabindex="1"></select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Alternative UOM<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select submit-="true" ng-model="materialMasterAlternativeUOM.AlternativeUOMId" class="form-control" name="Alternative UOM"
                            ng-options="item.Value as item.Text for item in uOMList" required tabindex="3"></select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Base UOM<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select submit-="true" ng-model="materialMasterAlternativeUOM.BaseUOMId" class="form-control" name="Alternative UOM"
                            ng-options="item.Value as item.Text for item in uOMList" required tabindex="5"></select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox">
                    <input type="checkbox" class="css-checkbox" id="active" ng-model="materialMasterAlternativeUOM.Active"  tabindex="2">
                    <label class="css-label" for="active"></label>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">AlternativeUOM Factor<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="AlternativeUOMFactor" ng-model="materialMasterAlternativeUOM.AlternativeUOMFactor" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">BaseUOM Factor<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="BaseUOMFactor" ng-model="materialMasterAlternativeUOM.BaseUOMFactor" class="form-control" required tabindex="6" maxlength="50">
            </div>
        </div>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div class="search-form">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-3">
                    <div class="select-style">
                        <select ng-model="$root.parameters.searchBy">
                            <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-7 col-md-7">
                    <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getData()">
                </div>
                <div class="col-xs-12 col-sm-2 col-md-2">
                    <button type="button" ng-click="getData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sequence</th>
                <th>Code</th>
                <th>Short Name</th>
                <th>Standard Name</th>
                <th>User Name</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="x in materialMasterAlternativeUOMs |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-click="Get(x.Id, $index);">
                <td>{{x.Sequence}}</td>
                <td>{{x.Code}}</td>
                <td>{{x.ShortName}}</td>
                <td>{{x.StandardName}}</td>
                <td>{{x.UserName}}</td>
                <td>{{x.Active?'Yes':'No'}}</td>
            </tr>
        </tbody>
    </table>
</div>
<dir-pagination-controls max-size="10"
                         direction-links="true"
                         boundary-links="true"
                         on-page-change="getData(newPageNumber)">
</dir-pagination-controls>
<confirm-modal></confirm-modal>
