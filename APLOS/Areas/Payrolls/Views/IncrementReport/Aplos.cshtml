<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>{{FormTitle}}</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">

        <div class="col-sm-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="Date.FromDate" />
                </div>
            </div>


        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <input e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="Date.ToDate" />
                </div>
            </div>


        </div>
        <div class="col-sm-12 text-left">
            <ul>
                <li>
                    <button class="btn" ng-click="getIncrementReport();" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i>Download</button>

                </li>

            </ul>
        </div>
    </div>
    </div>
<confirm-modal></confirm-modal>
