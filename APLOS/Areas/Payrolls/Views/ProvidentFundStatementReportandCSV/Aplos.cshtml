<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Provident Fund Statements</h3>
<div class="row">
    <div class="col-xs-12">
        <div class="col-md-12">
           <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="col-md-12">
                        <input id="ddlYearList"  e-watermarktext="Year" ej-dropdownlist e-datasource="yearList"  e-enablefiltersearch="true" e-value="year" e-databound="SelectDefaultValue" e-fields-value="Text" e-fields-text="Text" e-width="100%" />
                    </div>
                </div>
           <div class="col-xs-3 col-sm-3 col-md-3">
               <div class="col-md-12">
                   <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-enablefiltersearch="true" e-value="month" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
               </div>
           </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                @*<div class="form-group">
                    <label class="col-sm-4 ">Active<sup></sup></label>
                    <div class="col-sm-8">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="isActive" e-checked="isActive" />

                    </div>
                </div>*@

            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                @*<div class="form-group">
                    <label class="col-sm-4">Seperated<sup></sup></label>
                    <div class="col-sm-8">

                        <input type="checkbox" ej-checkbox class="nodetext" e-value="isSeperated" e-checked="isSeperated" />


                    </div>

                </div>*@

            </div>
        </div>
        <hr />
        <div class="form-horizontal form-elements">
            <div id="Tab" ej-tab e-itemactive="onactivetab" e-create="oncreatetab">

                <ul>
                    <li><a href="#TabPFEligible">Provident Fund Statement</a></li>
                    <li><a href="#TabPFCSV">Provident Fund CSV</a></li>
                    <li><a href="#TabNOTPFEligible">PF Not Deducted</a></li>
                </ul>

                <div id="TabPFEligible">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-4">
                            </div>             
                            <div class="col-md-4">
                                <div class="form-group">
                                    <button ng-click="GetProvidentFundStatement(true);"  class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button>
                                </div>
                            </div>             
                            <div class="col-md-4">                                
                            </div>                         
                        </div>
                    </div>
                </div>
                <div id="TabPFCSV">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">

                                    <button ng-click="GetPFcsv();" class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button>
                                </div>
                            </div>
                            <div class="col-md-4">

                            </div>

                        </div>
                    </div>
                </div>
                <div id="TabNOTPFEligible">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <button ng-click="GetProvidentFundStatement(false);" class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button>
                                </div>
                            </div>
                            <div class="col-md-4">
                            </div>

                        </div>
                    </div>
                </div>               
            </div>
        </div>

        @*<div class="row">
