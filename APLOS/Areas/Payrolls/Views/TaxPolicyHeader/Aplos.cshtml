<togglable name="Tax Policy Master"></togglable>
<div class="form-elements form-horizontal" ng-form id="TaxId" name="TaxPolicyHeaderForm">
    <div class="row">

        <div ng-form name="HeaderForm">
            <div class="col-xs-12 col-sm-6 col-md-6">


                <div class="form-group">
                    <label class="col-sm-4 control-label">Sequence</label>
                    <div class="col-sm-8">
                        <input type="text" onkeypress="return isNumber(event)" ng-model="Header.Sequence" class="form-control" maxlength="100" tabindex="2" readonly>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Standard Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="Header.StandardName" name="Standard Name" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="Header.Remarks" class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">

