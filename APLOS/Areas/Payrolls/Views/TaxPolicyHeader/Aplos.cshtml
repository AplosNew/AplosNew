<togglable name="Tax Policy Master"></togglable>
<div class="form-elements form-horizontal" ng-form id="TaxId" name="TaxPolicyHeaderForm">
    <div class="row">

        <div ng-form name="HeaderForm">
            <div class="col-xs-12 col-sm-6 col-md-6">


                <div class="form-group">
                    <label class="col-sm-4 control-label">Sequence</label>
                    <div class="col-sm-8">
                        <input type="text" onkeypress="return isNumber(event)" ng-model="Header.Sequence" class="form-control" maxlength="100" readonly>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Standard Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="Header.StandardName" name="Standard Name" class="form-control" maxlength="50" required>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Age Limit</label>
                    <label class="col-sm-2 control-label">From</label>
                    <div class="col-sm-2 show-message">
                        <input type="number" ng-model="Header.AgeFrom" class="form-control" required>
                    </div>
                    <label class="col-sm-2 control-label">To</label>
                    <div class="col-sm-2 show-message">
                        <input type="number" ng-model="Header.AgeTo" class="form-control" required>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">City Of Residence</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="Header.CityOfResidence" required>
                                <option value=""></option>
                                <option value="Metro">Metro</option>
                                <option value="Non-Metro">Non-Metro</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="Header.UserName" name="User Name" class="form-control" maxlength="50" required>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Short Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="Header.ShortName" class="form-control" name="Short Name" maxlength="15" required>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Gender</label>
                    <div class="col-sm-4">
                        <div class="checkbox-site" style="padding-top: 7px;">
                            <label>
                                <input type="checkbox" name="Gender" ng-model="Header.Male" ng-disabled="Header.Female==true">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Male
                            </label>
                        </div>
                    </div>
                    <div class="col-sm-4" style="padding-top: 7px;">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" name="Gender" ng-model="Header.Female" ng-disabled="Header.Male==true">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>Female
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Active</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site" style="margin-top:7px;">
                            <label>
                                <input type="checkbox" ng-model="Header.Active">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="saveHeader();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button ng-click="clearHeader();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="EarningMasterChild" role="tab" data-toggle="tab">Earning Master</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="InvestmentDeductionMaster" role="tab" data-toggle="tab">Investment <strong>/</strong> Deduction Master</a></li>
                    <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" href="" aria-controls="TaxYearTagging" role="tab" data-toggle="tab">Tax Year Tagging</a></li>
                    <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" href="" aria-controls="PlantChild" role="tab" data-toggle="tab">Plant Tagging</a></li>
                 </ul>
            </div>
            <div class="tab-content">

                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row">
                        <div ng-form name="EarningMasterForm">

                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Header Id</label>
                                    <div class="col-sm-8">
                                        <input type="text" onkeypress="return isNumber(event)" ng-model="EarningMasterModel.TaxPolicyHeaderId" class="form-control" maxlength="100" readonly>
                                    </div>
                                </div>

                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" ng-model="EarningMasterModel.StandardName" name="Standard Name" class="form-control" maxlength="30" required>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Remarks</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="EarningMasterModel.Remarks" class="form-control" maxlength="200">
                                    </div>
                                </div>

                            </div>

                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" ng-model="EarningMasterModel.UserName" class="form-control" maxlength="100" required>
                                    </div>
                                </div>

                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" ng-model="EarningMasterModel.ShortName" class="form-control" maxlength="100" required>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Active</label>
                                    <div class="col-sm-8">
                                        <div class="checkbox-site" style="margin-top:7px;">
                                            <label>
                                                <input type="checkbox" ng-model="EarningMasterModel.Active">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="col-xs-12">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Configuration Values</legend>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">SalaryHead<sup>*</sup></label>
                                            <div class="col-sm-8 show-message">
                                                <div class="select-style">
                                                    <select class="form-control" ng-model="EarningMasterModel.SalaryHeadId" name="SalaryHead"
                                                            ng-options="item.Value as item.Text for item in SalaryHeadList" required>
                                                        <option value="">--Select--</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group" show-errors>
                                            <label class="col-sm-4 control-label">Taxable Amount %</label>
                                            <div class="col-sm-8 show-message">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="EarningMasterModel.TaxableAmountPer" class="form-control" maxlength="100">
                                            </div>
                                        </div>

                                        <div class="form-group" show-errors>
                                            <label class="col-sm-4 control-label">Exemption On</label>
                                            <div class="col-sm-4">
                                                <div class="checkbox-site radio">
                                                    <label>
                                                        <input ng-disabled="EarningMasterModel.ExemptionApplicable == false" type="radio"
                                                               ng-model="EarningMasterModel.IsLessOrMore" name="Less" value="Which Ever Is Less">
                                                        <span class="cr"><i class="cr-icon"></i></span>Which Ever Is Less
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-sm-4">
                                                <div class="checkbox-site radio">
                                                    <label>
                                                        <input ng-disabled="EarningMasterModel.ExemptionApplicable == false" type="radio" ng-model="EarningMasterModel.IsLessOrMore"
                                                               name="More" value="Which Ever Is More">
                                                        <span class="cr"><i class="cr-icon"></i></span>Which Ever Is More
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Exemption Applicable</label>
                                            <div class="col-sm-8">
                                                <div class="checkbox-site" style="margin-top:7px;">
                                                    <label>
                                                        <input type="checkbox" ng-model="EarningMasterModel.ExemptionApplicable">
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group" show-errors>
                                            <label class="col-sm-4 control-label">Taxable Amount Fix</label>
                                            <div class="col-sm-8 show-message">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="EarningMasterModel.TaxableAmountFix" class="form-control" maxlength="100">
                                            </div>
                                        </div>
                                    </div>

                                </fieldset>
                            </div>

                            <div class="col-xs-12">
                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li> <button ng-click="SaveEarningMaster();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                        <li> <button ng-click="ClearEarningMaster();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                    </ul>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-12 col-sm-12 col-sm-12">
                                    <div style="color:black;" id="EarningMasterChildGrid" ej-grid e-datasource="EarningList"
                                         e-allowfiltering="true" e-allowpaging="true" e-pagesettings-pagesize="20"
                                         e-allowselection="true" e-recorddoubleclick="getEarnMasterChildDetails" e-filtersettings-filterType="excel"
                                         e-templaterefresh="refreshTemplate" e-enabletouch="true" e-responsive="true" e-allowtextwrap="true" e-allowscrolling="true">
                                        <div e-columns>
                                            <div e-column e-field="Id" e-headertext="Id" e-width="50"></div>
                                            <div e-column e-field="TaxPolicyHeaderId" e-headertext="TaxPolicyHeaderId" e-width="80"></div>
                                            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="120"></div>
                                            <div e-column e-field="UserName" e-headertext="User Name" e-width="120"></div>
                                            <div e-column e-field="SalaryHead" e-headertext="SalaryHead" e-width="120"></div>
                                            <div e-column e-field="ExemptionApplicable" e-headertext="Exemption Applicable" e-width="80"></div>
                                            <div e-column e-headertext="Actions" e-template="#ShowButtons" e-width="50"></div>
                                        </div>
                                    </div>
                                    <script type="text/ng-template" id="ShowButtons">
                                        <div class="common-btn">
                                            <button style="color: #f3f3ec;background-color: #1c1f32;" title="Actions" class="btn">
                                                <i class="glyphicon glyphicon-list" ng-click="$parent.AddEntry(this);"></i>
                                            </button>
                                        </div>
                                    </script>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row">
                        <div ng-form name="InvestmentDeductionForm">

                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Header Id</label>
                                    <div class="col-sm-8">
                                        <input type="text" onkeypress="return isNumber(event)" ng-model="InvestDeductModel.TaxPolicyHeaderId" class="form-control" maxlength="100" readonly>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Tax Type</label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select class="form-control" name="TaxType" id="TaxType" ng-model="InvestDeductModel.TaxTypeId">
                                                <option value=""></option>
                                                <option ng-repeat="option in TaxTypeList" value="{{option.Id}}">{{option.Username}}</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Tax Saving Group</label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select ng-model="InvestDeductModel.TaxSavingGroupId"
                                                    class="form-control" ng-change="fillMaxLimit();"
                                                    ng-options="item.Id as item.Username for item in TaxSavingGroupList">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">UserCode<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" ng-model="InvestDeductModel.UserCode" class="form-control" maxlength="50" required>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Item Applicable</label>
                                    <div class="col-sm-8">
                                        <div class="checkbox-site" style="margin-top:7px;">
                                            <label>
                                                <input type="checkbox" ng-model="InvestDeductModel.ItemApplicable">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label"> <b>Max Limit : {{maxLimit}}</b></label>
                                </div>

                            </div>

                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="SaveDeductionMaster();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                    <li> <button ng-click="ClearMasterFields();" class="btn" style="margin-right:15px"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                </ul>
                            </div>

                            <div class="row" style="margin:10px;">
                                <div class="col-xs-12 col-sm-12 col-sm-12">
                                    <div style="color:black;" ej-grid e-datasource="ModelMasterList"
                                         e-allowfiltering="true" e-allowpaging="true" e-pagesettings-pagesize="20"
                                         e-allowselection="true" e-recorddoubleclick="getDeductionMasterDoubleClick" e-filtersettings-filterType="excel"
                                         e-templaterefresh="refreshTemplate" e-enabletouch="true" e-responsive="true" e-allowtextwrap="true" e-allowscrolling="true">
                                        <div e-columns>
                                            <div e-column e-field="SystemId" e-headertext="Id" e-width="50" e-visible="false"></div>
                                            <div e-column e-field="UserCode" e-headertext="UserCode" e-width="80"></div>
                                            <div e-column e-field="TaxType" e-headertext="TaxType" e-width="80"></div>
                                            <div e-column e-field="TaxSavingGroup" e-headertext="Tax Saving Group" e-width="100"></div>
                                            <div e-column e-field="ItemApplicable" e-headertext="Item Applicable" e-width="50"></div>
                                            <div e-column e-field="MaxLimit" e-headertext="MaxLimit" e-visible="false"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div><br /></div>
                            <div class="col-xs-12">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border"><b> Item Level Configuration </b> </legend>

                                    <div class="col-xs-12">
                                        <div class="common-btn" style="margin-right:10px;">
                                            <ul class="list-inline text-right">
                                                <li> <button ng-disabled="InvestDeductModel.SystemId==null || InvestDeductModel.ItemApplicable==false" ng-click="OpenSavingItemPopup();" class="btn"><i class="glyphicon glyphicon-plus-sign"></i> Add Item</button></li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="row" style="margin:10px;">
                                        <div class="col-xs-12 col-sm-12 col-sm-12">
                                            <div style="color:black;" ej-grid e-datasource="IncomechildData" e-recorddoubleclick="getDeductionChildDoubleClick"
                                                 e-allowfiltering="true" e-allowpaging="true" e-pagesettings-pagesize="20"
                                                 e-allowselection="true" e-filtersettings-filterType="excel"
                                                 e-templaterefresh="refreshTemplate" e-enabletouch="true" e-responsive="true" e-allowtextwrap="true" e-allowscrolling="true">
                                                <div e-columns>
                                                    <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false"></div>
                                                    <div e-column e-field="TaxSavingItem" e-headertext="TaxSavingItem" e-width="80"></div>
                                                    <div e-column e-field="Limit" e-headertext="Limit" e-width="50"></div>
                                                    <div e-column e-field="IsEarning" e-headertext="Is Earning" e-width="50"></div>
                                                    <div e-column e-field="IsInvestment" e-headertext="Is Investment" e-width="50"></div>
                                                    <div e-column e-field="IsDeduction" e-headertext="Is Deduction" e-width="50"></div>
                                                    <div e-column e-field="Remarks" e-headertext="Remarks" e-width="80"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>

                        </div>
                    </div>
                </div>

                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                    <div class="row" ng-form name="TaxYearForm" id="Allowed">
                        <div class="row" style="padding:10px;">
                            <div class="col-xs-6 col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Header Id</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="TaxYearModel.HeaderId" class="form-control" maxlength="100" readonly>
                                    </div>
                                </div>                             

                            </div>

                            <div class="col-lg-6 col-xs-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Tax Year<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="TaxYearModel.TaxYearId" name="TaxYear"
                                                    ng-options="item.Value as item.Text for item in TaxYearList" required>
                                                <option value="">--Select--</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li> <button ng-click="SaveTaxYearTagging();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save </button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-sm-12">
                                <div style="color:black;" id="TaxYearGrid" ej-grid e-datasource="childDataList"
                                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                                     e-allowselection="true" e-filtersettings-filterType="excel"
                                     e-templaterefresh="refreshTemplate" e-enabletouch="true" e-responsive="true" e-allowtextwrap="true" e-allowscrolling="true">
                                    <div e-columns>
                                        <div e-column e-field="HeaderId" e-headertext="Header Id" e-width="70"></div>
                                        <div e-column e-field="PlantId" e-headertext="Plant Id" e-width="120"></div>
                                    </div>
                                </div>                                
                            </div>
                        </div>

                    </div>
                </div>

                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                    <div class="row" ng-form name="ChildForm" id="Allowed">
                        <div class="row" style="padding:10px;">
                            <div class="col-xs-6 col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Header Id</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="Child.HeaderId" class="form-control" maxlength="100" readonly>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="Company" ng-change="getPlants()" name="Entity"
                                                    ng-options="item.Value as item.Text for item in CompanyList" required>
                                                <option value="">--Select--</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="col-lg-6 col-xs-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="Child.PlantId" name="Plant"
                                                    ng-options="item.Value as item.Text for item in PlantList" required>
                                                <option value="">--Select--</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li> <button ng-click="saveChild();" class="btn"><i class="glyphicon glyphicon-plus-sign"></i> Add </button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-sm-12">
                                <div style="color:black;" id="ChildGrid" ej-grid e-datasource="childDataList"
                                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                                     e-allowselection="true" e-filtersettings-filterType="excel"
                                     e-templaterefresh="refreshTemplate" e-enabletouch="true" e-responsive="true" e-allowtextwrap="true" e-allowscrolling="true">
                                    <div e-columns>

                                        <div e-column e-field="HeaderId" e-headertext="Header Id" e-width="70"></div>
                                        <div e-column e-field="PlantId" e-headertext="Plant Id" e-width="120"></div>
                                        <div e-column e-template="#DeleteFile" e-headertext="" e-width="30"></div>

                                    </div>
                                </div>
                                <script type="text/template" id="DeleteFile">
                                    <div class="common-btn">
