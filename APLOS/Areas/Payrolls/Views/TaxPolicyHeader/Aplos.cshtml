<togglable name="Tax Policy Master"></togglable>
<div class="form-elements form-horizontal" ng-form id="TaxId" name="TaxPolicyHeaderForm">
    <div class="row">
      
        <div ng-form name="HeaderForm">
            <div class="col-xs-12 col-sm-6 col-md-6">


                <div class="form-group">
                    <label class="col-sm-4 control-label">Sequence</label>
                    <div class="col-sm-8">
                        <input type="text" onkeypress="return isNumber(event)" ng-model="Header.Sequence" class="form-control" maxlength="100" tabindex="2" readonly>
                    </div>
                </div>

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Standard Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="Header.StandardName" name="Standard Name" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Remarks</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="Header.Remarks" class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">User Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="Header.UserName" name="User Name" class="form-control" maxlength="50" tabindex="2" required>
                    </div>
                </div>

                <div class="form-group"  show-errors>
                    <label class="col-sm-4 control-label">Short Name</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" ng-model="Header.ShortName" class="form-control" name="Short Name" maxlength="15" tabindex="2" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Active</label>
                    <div class="col-sm-8">
                        <div class="checkbox-site" style="margin-top:7px;">
                            <label>
                                <input type="checkbox" ng-model="Header.Active" tabindex="8">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-xs-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="saveHeader();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button ng-click="clearHeader();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div>
       
        <div class="clearfix"></div>

        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="DayTypeWithValues" role="tab" data-toggle="tab">Rule Master</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="PlantChild" role="tab" data-toggle="tab">Plant Tagging</a></li>
                </ul>
            </div>
            <div class="tab-content">
              
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div class="row">
                        <div ng-form name="RuleMasterForm">
                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Header Id</label>
                                    <div class="col-sm-8">
                                        <input type="text" onkeypress="return isNumber(event)" ng-model="RuleMaster.HeaderId" class="form-control" maxlength="100" tabindex="2" readonly>
                                    </div>
                                </div>

                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Standard Name</label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" ng-model="RuleMaster.StandardName" name="Standard Name" class="form-control" maxlength="30" required>
                                    </div>
                                </div>                                                                           

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Remarks</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="RuleMaster.Remarks" class="form-control" maxlength="200">
                                    </div>
                                </div>

                            </div>

                            <div class="col-xs-12 col-sm-6 col-md-6">

                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">User Name</label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" ng-model="RuleMaster.UserName" class="form-control" maxlength="100" required>
                                    </div>
                                </div>

                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Short Name</label>
                                    <div class="col-sm-8 show-message">
                                        <input type="text" ng-model="RuleMaster.ShortName" class="form-control" maxlength="100" required>
                                    </div>
                                </div>                              
                              
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Active</label>
                                    <div class="col-sm-8">
                                        <div class="checkbox-site" style="margin-top:7px;">
                                            <label>
                                                <input type="checkbox" ng-model="RuleMaster.Active">
                                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            
                            </div>

                            <div class="col-xs-12">
                                <fieldset class="scheduler-border">
                                    <legend class="scheduler-border">Configuration Values</legend>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                                   
                                        <div class="form-group" show-errors>
                                            <label class="col-sm-4 control-label">Leave Value </label>
                                            <div class="col-sm-8 show-message">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="RuleMaster.LeaveValue" class="form-control" maxlength="100" required>
                                            </div>
                                        </div>

                                        <div class="form-group" show-errors>
                                            <label class="col-sm-4 control-label">Late Value </label>
                                            <div class="col-sm-8 show-message">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="RuleMaster.LateValue" class="form-control" maxlength="100" required>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="col-xs-12 col-sm-6 col-md-6 ">

                                        <div class="form-group" show-errors>
                                            <label class="col-sm-4 control-label">Absent value </label>
                                            <div class="col-sm-8 show-message">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="RuleMaster.AbsentValue" class="form-control" maxlength="100" required>
                                            </div>
                                        </div>
                                       
                                        <div class="form-group" show-errors>
                                            <label class="col-sm-4 control-label">Amount</label>
                                            <div class="col-sm-8 show-message">
                                                <input type="text" onkeypress="return isNumber(event)" ng-model="RuleMaster.Amount" class="form-control" maxlength="100" required>
                                            </div>
                                        </div>
                                    </div>

                                </fieldset>
                            </div>
                      
                            <div class="col-xs-12">
                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li> <button ng-click="SaveRuleMaster();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                                        <li> <button ng-click="ClearRuleMaster();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                    </ul>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-12 col-sm-12 col-sm-12">
                                    <div style="color:black;" id="RulesMasterChildGrid" ej-grid e-datasource="RulesList"
                                         e-allowfiltering="true" e-allowpaging="true" e-pagesettings-pagesize="20"
                                         e-allowselection="true" e-recorddoubleclick="getRuleChildDetails" e-filtersettings-filterType="excel"
                                         e-templaterefresh="refreshTemplate" e-enabletouch="true" e-responsive="true" e-allowtextwrap="true" e-allowscrolling="true">
                                        <div e-columns>

                                            <div e-column e-field="Id" e-headertext="Id" e-width="50"></div>
                                            <div e-column e-field="HeaderId" e-headertext="header Id" e-width="50"></div>
                                            <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="120"></div>
                                            <div e-column e-field="UserName" e-headertext="User Name" e-width="120"></div>
                                            <div e-column e-field="ShortName" e-headertext="Short Name" e-width="120"></div>
                                            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                                            <div e-column e-field="Active" e-headertext="Active" e-width="50"></div>
                                          
                                        </div>
                                    </div>
                                  
                                </div>
                            </div>
                       
                        </div>
                    </div>
                </div>               
                
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row" ng-form name="ChildForm" id="Allowed">
                        <div class="row" style="padding:10px;">
                            <div class="col-xs-6 col-lg-6">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Header Id</label>
                                    <div class="col-sm-8">
                                        <input type="text" ng-model="Child.HeaderId" class="form-control" maxlength="100" tabindex="2" readonly>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="Company" ng-change="getPlants()" name="Entity"
                                                    ng-options="item.Value as item.Text for item in CompanyList" required>
                                                <option value="">--Select--</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                            
                            <div class="col-lg-6 col-xs-6">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                                    <div class="col-sm-8 show-message">
                                        <div class="select-style">
                                            <select class="form-control" ng-model="Child.PlantId" name="Plant"
                                                    ng-options="item.Value as item.Text for item in PlantList" required >
                                                <option value="">--Select--</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="common-btn">
                                    <ul class="list-inline text-right">
                                        <li> <button ng-click="saveChild();" class="btn" tabindex="10"><i class="glyphicon glyphicon-plus-sign"></i> Add </button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-sm-12">
                                <div style="color:black;" id="ChildGrid" ej-grid e-datasource="childDataList"
                                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-pagesettings-pagesize="20"
                                     e-allowselection="true" e-filtersettings-filterType="excel"
                                     e-templaterefresh="refreshTemplate" e-enabletouch="true" e-responsive="true" e-allowtextwrap="true" e-allowscrolling="true">
                                    <div e-columns>

                                        <div e-column e-field="HeaderId" e-headertext="Header Id" e-width="70"></div>
                                        <div e-column e-field="PlantId" e-headertext="Plant Id" e-width="120"></div>
                                        <div e-column e-template="#DeleteFile" e-headertext="" e-width="30"></div>

                                    </div>
                                </div>
                                <script type="text/template" id="DeleteFile">
                                    <div class="common-btn">
                                        <ul class="list-inline text-left">
                                            <li><button ng-click="$parent.confirmModal(data)" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                        </ul>
                                    </div>
                                </script>
                            </div>
                        </div>
                    </div>
                </div>               
            </div>
        </div>
    </div>
</div>

<div class="row text-right aplos-grid-toggle">

    <div class="col-xs-12 col-sm-12 col-sm-12">
        <div style="color:black;" id="HeaderGrid" ej-grid e-datasource="HeaderList"
             e-allowfiltering="true" e-allowpaging="true" e-pagesettings-pagesize="20"
             e-allowselection="true" e-recorddoubleclick="getHeaderDetails" e-filtersettings-filterType="excel"
             e-templaterefresh="refreshTemplate" e-enabletouch="true" e-responsive="true" e-allowtextwrap="true" e-allowscrolling="true">
            <div e-columns>

                <div e-column e-field="Id" e-headertext="Id" e-width="50"></div>
                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="50"></div>
                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="120"></div>
                <div e-column e-field="UserName" e-headertext="User Name" e-width="120"></div>
                <div e-column e-field="ShortName" e-headertext="Short Name" e-width="120"></div>
                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="150"></div>
                <div e-column e-field="Active" e-headertext="Active" e-width="50"></div>
                

            </div>
        </div>
    </div>

</div>

<confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpDT" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteDT();"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmPopUpDS" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="DeleteDS();"></confirm-archive-generic>

<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
</div>

<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 46) {
            return false;
        }
        return true;
    }

</script>

<div class="modal fade site-modal in" id="confirmPOPUPD" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">x</button>
                <h4 class="modal-title">
                    <i class="glyphicon glyphicon-warning-sign"></i> "Delete"
                </h4>
            </div>
            <div class="modal-body">
                <p class="text-warning">Are you sure to delete ?</p>
            </div>
            <div class="modal-footer common-btn">
                <button type="button" class="btn btn-default" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-default" data-dismiss="modal" id="btnConfirmed" ng-click="DeleteChild();">Yes</button>

            </div>
        </div>
    </div>
</div>
