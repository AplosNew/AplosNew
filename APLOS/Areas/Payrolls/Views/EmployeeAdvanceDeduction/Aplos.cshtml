<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>

<div class="form-elements form-horizontal">
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Year</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-value="year" @*e-databound="SelectDefaultValue"*@ e-fields-value="Text" e-fields-text="Text" e-width="100%" e-change="getSalaryAdvance" />
                    </div>
                </div>
            </div>

        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Month</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <input id="ddlMonthListEmployeeAdvanceDeductionReportExcel" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-value="month" e-fields-value="Value" e-fields-text="Text" e-width="100%" e-change="getSalaryAdvance" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Salary Advance</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="aria2" role="tab" data-toggle="tab">General Advance</a></li>
            </ul>
        </div>

        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Advance GL<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    @*<input id="SalaryHeadId" e-watermarktext="Salary Head" ej-dropdownlist e-datasource="SalaryHeadList" e-value="SalaryHeadId" e-fields-value="Id" e-fields-text="UserName" e-width="100%"  />*@
                                    <select id="SalaryHeadId" class="form-control" ng-model="SalaryHeadId" name="SalaryHead" required tabindex="1">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in SalaryHeadList" value="{{option.Id}}">{{option.UserName}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Interest GL<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    @*<input id="SalaryHeadId" e-watermarktext="Salary Head" ej-dropdownlist e-datasource="SalaryHeadList" e-value="SalaryHeadId" e-fields-value="Id" e-fields-text="UserName" e-width="100%"  />*@
                                    <select id="SalaryHeadInterest" class="form-control" ng-model="SalaryHeadInterest" name="SalaryHeadInterest" required tabindex="1">
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in SalaryInterestList" value="{{option.Id}}">{{option.UserName}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-sm-12">
                        <div style="color:black;" id="SalaryAdvance" ej-grid e-datasource="SalaryAdvanceList"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-rowdatabound="rowDataBound"
                             e-allowselection="true" e-recorddoubleclick="" e-filtersettings-filterType="excel" e-actioncomplete="actionCompleteSelected">
                            <div e-columns>
                                <div e-column e-headertext="" e-template="#checkboxTemplate" e-textalign="center" e-width="1"></div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="3"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="5"></div>
                                <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="5"></div>
                                <div e-column e-field="SanctionedAmount" e-headertext="Sanctioned" e-width="3"></div>
                                <div e-column e-field="RecoveredAmount" e-headertext="Recovered" e-width="3"></div>
                                <div e-column e-field="CurrentInstallment" e-headertext="Current Installment" e-width="3"></div>
                                <div e-column e-field="PrincipalAmount" e-headertext="Principal " e-width="3"></div>
                                <div e-column e-field="InterestAmount" e-headertext="Interest" e-width="3"></div>
                                <div e-column e-field="Balance" e-headertext="Balance" e-width="3"></div>
                            </div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="data.IsSelected" e-checked="data.IsSelected" />
                    </script>
                </div>

                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="EmployeeAdvanceDeductionReportExcel();" class="btn"><i class="glyphicon glyphicon-cloud-download"></i> Download</button></li>

                            <li><button ng-click="SaveSalaryAdvance();" class="btn"> <i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        </ul>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-sm-12">
                            <div style="color:black;" id="SalaryAdvance" ej-grid e-datasource="SalaryGeneralList"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-rowdatabound="rowDataBound"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-actioncomplete="actionCompleteSelected">
                                <div e-columns>
                                    <div e-column e-headertext="" e-template="#checkboxTemplate" e-textalign="center" e-width="1"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="3"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="5"></div>
                                    <div e-column e-field="SanctionedAmount" e-headertext="Sanctioned Amount" e-width="3"></div>
                                    <div e-column e-field="RecoveredAmount" e-headertext="Recovered Amount" e-width="3"></div>
                                    <div e-column e-field="CurrentInstallment" e-headertext="Current Installment" e-width="3"></div>
                                    <div e-column e-field="Balance" e-headertext="Balance" e-width="3"></div>
                                </div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplate">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.IsSelected" e-checked="data.IsSelected" />
                        </script>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li><button ng-click="SaveSalaryAdvance();" class="btn"> <i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                        </ul>
                    </div>
                </div>
            </div>
    </div>
</div>
<confirm-archive-generic modalid="confirmMasterPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteMaster();"></confirm-archive-generic>
