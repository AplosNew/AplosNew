<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Service (Variable)
</h3>

<div class="form-elements form-horizontal" ng-form="FixedServiceReport" id="MainDivId">
    <div class="row">
        <div class="col-md-12">
            <div class="col-md-3">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="From Date" ng-model="FromDate" datepicker class="form-control" required tabindex="6">
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group" show-errors>
                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="To Date" ng-model="ToDate" datepicker class="form-control" required tabindex="6">
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Service Name</label>
                    <div class="col-sm-8">
                        <div class="select-style">
                            <select class="form-control" ng-model="ServiceName" ng-options="item.Value as item.Text for item in EmpServiceTypeList">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-right">
                    <div class="form-group">
                        <div class="col-xs-12" style="margin:1px;">
                            <div class="common-btn">
                                <button ng-click="GetReport();" class="btn"> <i class="glyphicon glyphicon-download"></i> Download</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



