<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Day Status Report
</h3>

<div class="form-elements form-horizontal" ng-form="DiscreteAllowanceReport" id="MainDivId">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Date" ng-model="FromDate" datepicker class="form-control" required tabindex="6">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Shift</label>
                <div class="col-sm-8">
                    <input id="shiftList" ej-dropdownlist e-create="create"  e-multiselectmode="visualmode" e-datasource="ShiftList" e-fields-value="SystemID" e-fields-text="ShiftType" e-width="100%" e-showcheckbox="true" />
                </div>
                @*<div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="shift">
                            <option value=""></option>
                            <option ng-repeat="option in ShiftList" value="{{option.SystemID}}">{{option.ShiftType}}</option>
                        </select>
                    </div>
                </div>*@
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Date" ng-model="ToDate" datepicker class="form-control" required tabindex="6">
                </div>
            </div>            
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <div class="col-sm-4">No Late</div>
                <div class="col-sm-2" style="padding-top: 7px;">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="Late" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-4">No Absent</div>
                <div class="col-sm-2" style="padding-top: 7px;">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="Absent" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <div class="col-sm-4">No Leave With Pay</div>
                <div class="col-sm-2" style="padding-top: 7px;">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="LvWP" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-4">No Leave Without Pay</div>
                <div class="col-sm-2" style="padding-top: 7px;">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="LvWOP" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        
            <div class="col-md-12">
                <div class="text-right">
                    <div class="form-group">
                        <div class="col-xs-12" style="margin:1px;">
                            <div class="common-btn">
                                <button ng-click="GetReport();" class="btn"> <i class="glyphicon glyphicon-download"></i> Download</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        
    </div>
</div>




