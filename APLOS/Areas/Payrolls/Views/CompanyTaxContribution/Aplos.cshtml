<togglable name="Company Tax Contribution"></togglable>
<div class="form-elements form-horizontal" ng-form name="companyTaxContributionNewForm">
    <input type="hidden" ng-model="companyTaxContributionNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Plant <sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="companyTaxContributionNew.PlantId" name="Plant">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in plantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-4 control-label">Tax Year <sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="TaxYearId" class="form-control" ng-model="companyTaxContributionNew.TaxYearId" name="Tax Year">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in taxYearList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Tax Amount <sup>*</sup></label>
            <div class="col-sm-4">
                Fixed <input type="radio" name="IsFixed" ng-model="companyTaxContributionNew.IsFixed" value="Fixed">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                Percentage <input type="radio" name="Percentage" ng-model="companyTaxContributionNew.IsFixed" value="Percentage">
            </div>
            <div class="col-sm-4">
                <input type="number" class="form-control" ng-model="companyTaxContributionNew.Amount" />
            </div>

        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Employee <sup>*</sup></label>
            <div class="col-sm-8 input-group  show-message">
                <span class="input-group-addon">{{companyTaxContributionNew.EmpSystemId}}</span>
                <input type="text" name="User" ng-model="companyTaxContributionNew.EmployeeName" class="form-control" required readonly>
                <span class="input-group-btn">
                    <button name="submit" class="btn single-small-btn" ng-click="getEmployeesInPopup()"><i class="cr-icon glyphicon glyphicon-search" tabindex="9"></i></button>
                </span>
            </div>
        </div>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            @*<li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>*@
        </ul>
    </div>
</div>

<div class="modal fade site-modal in" id="PopUpEmployee" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Select Employee</h4>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="EmployeePopUpParameters.searchBy">
                                            <option ng-repeat="option in searchInEmployeesList" value="{{option.value}}">{{option.name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="EmployeePopUpParameters.search" ng-enter="getEmployeesInPopup()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="getEmployeesInPopup()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee ID</th>
                                <th>Employee Name</th>
                                <th>Email</th>
                                <th>Department</th>
                                <th>Given Designation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="dr in dataListEmployee |itemsPerPage:EmployeePopUpParameters.pageSize" pagination-id="metaData.name + 'dataListEmployee'"
                                total-items="EmployeePopUpParameters.total_count" ng-dblclick="selectedEmployee(dr)">
                                <td>{{dr.SystemId}}</td>
                                <td>{{dr.EmployeeName}}</td>
                                <td>{{dr.EmailId}}</td>
                                <td>{{dr.Department}}</td>
                                <td>{{dr.GivenDesignation}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <dir-pagination-controls max-size="10"
                                         pagination-id="metaData.name + 'dataListEmployee'"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getEmployeesInPopup(newPageNumber)">
                </dir-pagination-controls>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
