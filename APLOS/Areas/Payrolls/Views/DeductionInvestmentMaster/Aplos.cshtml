<togglable name="{{title}}"></togglable>
<div class="form-horizontal" ng-form name="ModelNewForm">
    @*<input type="hidden" ng-model="ModelNew.Id">*@
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="margin-left: -93px;">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message" style="margin-left: 93px;">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.CompanyId"
                                ng-options="item.Value as item.Text for item in companyList" id="CompanyId" ng-change="getMasterData();"
                                name="Company" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

        </div>
    </div>
    <div class="form-elements ">
        <!--The Next Row (TaxType and TaxYear)-->
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Tax Type</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" name="TaxType" id="TaxType" ng-model="ModelNew.TaxTypeId">
                                <option value=""></option>
                                <option ng-repeat="option in TaxTypeList" value="{{option.Id}}">{{option.Username}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Tax Year</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select class="form-control" ng-model="ModelNew.TaxYearId">
                                <option value=""></option>
                                <option ng-repeat="option in YearList" value="{{option.TaxYearID}}">{{option.TaxYearName}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--The Next Row (System Id and User Code)-->
        <div class="row">
            <div class="col-xs-6 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Tax Saving Group</label>
                    <div class="col-sm-4 show-message">
                        <div class="select-style">
                            <select ng-model="ModelNew.TaxSavingGroupId" id="SalaryHeadFormula" class="form-control" name="SalaryHead" ng-change="fillMaxLimit();" ng-options="item.Id as item.Username for item in TaxSavingGroupList" tabindex="5">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                    <div id="taxGroupLimit" style="display:none; margin-top:10px;" class="col-sm-4 show-message">
                        <b>Max Limit : {{maxLimit}}</b>
                    </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">User Code</label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <input type="text" class="form-control" placeholder="UserCode" maxlength="50" ng-model="ModelNew.UserCode">
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>


        <div class="tab-design" id="tab_show">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Add Item</a></li>
                </ul>
            </div>

            <br />
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="form-elements form-horizontal">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 col-md-12">
                            <div class="form-elements " ng-form name="ModelNewForm">
                                <div class=" col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">Investment</label>
                                        <div class="col-sm-2 show-message" style=" margin-top: 7px;">
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" name="isApplicable" ng-model="ModelChild.IsInvestment" tabindex="8">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </div>
                                        <label class="col-sm-2 control-label">Deduction</label>
                                        <div class="col-sm-2 show-message" style=" margin-top: 7px;">
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" name="isApplicable" ng-model="ModelChild.IsDeduction" tabindex="8" ng-change="Deduction();">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </div>
                                        <label class="col-sm-2 control-label">Earning</label>
                                        <div class="col-sm-2 show-message" style=" margin-top: 7px;">
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" name="isApplicable" ng-model="ModelChild.IsEarning" tabindex="8" ng-change="Earning();">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Nature</label>
                                        <div class="col-sm-8 show-message">
                                            <div class="col-sm-8 show-message">
                                                <div class="select-style">
                                                    <input type="text" class="form-control" maxlength="10" placeholder="Nature" ng-model="ModelChild.Nature">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="margin-top:20px;">
                                        <div class="col-sm-6 " style="margin-left: 190px;">
                                            <input type="radio" id="fix" name="isfill" value="No" ng-model="ModelChild.isPercentage">
                                            <label for="fix">Fixed</label><br>
                                        </div>
                                        <div class="col-sm-6 " style="margin-left: -190px;">
                                            <input type="radio" id="percentage" name="isfill" value="Yes" ng-model="ModelChild.isPercentage">
                                            <label for="Percentage">Percentage</label><br>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Salary Head</label>
                                        <div class="col-sm-8 show-message">
                                            <div class="col-sm-8 show-message">
                                                <div class="select-style">
                                                    <select ng-model="ModelChild.SalaryHeadId" id="SalaryHeadFormula" class="form-control" name="SalaryHead" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5">
                                                        <option value=""></option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <input type="text" name="Sequence" ej-numerictextbox e-decimalplaces="2" e-minvalue="1" e-enablertl="false" e-value="ModelChild.Sequence"  required />
                                        </div>
                                    </div>
                                </div>
                                <!-- The 2nd Column Fields-->
                                <div class=" col-sm-6 col-md-6">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Tax Saving Item</label>
                                        <div class="col-sm-8 show-message">
                                            <div class="col-sm-8 show-message">
                                                <div class="select-style">
                                                    <select ng-model="ModelChild.TaxSavingItemId"  class="form-control"  ng-options="item.Id as item.Username for item in TaxSavingItemList" tabindex="5">
                                                        <option value=""></option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-2 control-label">Taxable Income</label>
                                        <div class="col-sm-4 show-message" style=" margin-top: 7px;">
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" name="TaxableIncome" ng-model="ModelChild.isTaxableIncome" tabindex="8">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </div>
                                        <label class="col-sm-2 control-label">Tax</label>
                                        <div class="col-sm-4 show-message" style=" margin-top: 7px;">
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" name="Tax" ng-model="ModelChild.isTax" tabindex="8">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" show-errors>
                                        <label class="col-sm-4 control-label">Limit<sup>*</sup></label>
                                        <div class="col-sm-8 show-message">
                                            <div class="col-sm-8 ">
                                                <div class="select-style">
                                                    <input type="text" class="form-control" onkeypress="return isNumber(event)" ng-model="ModelChild.Limit" name="Limit" required>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Remarks</label>
                                        <div class="col-sm-8 show-message">
                                            <div class="col-sm-8 show-message">
                                                <div class="select-style">
                                                    <input type="text" class="form-control" placeholder="" ng-model="ModelChild.Remarks">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="common-btn" style="margin-bottom:20px;">
                                    <ul class="list-inline text-right">
                                        <li> <button ng-click="SaveChild();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action1}}</button></li>

                                        <li> <button ng-click="ClearChildFields();" class="btn" tabindex="13"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-12 col-sm-12">
                            @*<div id="childData"></div>*@
                            <div style="color:black;" id="childGrid" ej-grid e-datasource="childData"
                                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowscrolling="true" e-allowtextwrap="true"
                                 e-allowselection="true" e-recorddoubleclick="getChildDetail" e-filtersettings-filterType="excel" e-actioncomplete="actionCompleteSelected">
                                <div e-columns>
                                    @*<div e-column e-field="Id" e-headertext="Id" e-width="40"></div>*@
                                    <div e-column e-field="Sequence" e-headertext="Sequence" e-width="40"></div>
                                    @*<div e-column e-field="IncomeTaxItemMasterId" e-headertext="Master Id" e-width="60"></div>*@
                                    <div e-column e-field="TaxSavingItem" e-headertext="Tax Saving Item" e-width="110"></div>
                                    <div e-column e-field="Nature" e-headertext="Nature" e-width="60"></div>
                                    <div e-column e-field="Limit" e-headertext="Limit" e-width="60"></div>
                                    <div e-column e-field="SalaryHead" e-headertext="Salary Head" e-width="100"></div>
                                    <div e-column e-field="isTaxableIncome" e-headertext="Taxable Income" e-width="60"></div>
                                    <div e-column e-field="isTax" e-headertext="Tax" e-width="60"></div>
                                    <div e-column e-field="isFix" e-headertext="Fix" e-width="60"></div>
                                    <div e-column e-field="isPercentage" e-headertext="Percentage" e-width="60"></div>
                                    <div e-column e-field="isApplicable" e-headertext="Applicable" e-width="60"></div>
                                    <div e-column e-template="#PrintFileTab" e-headertext="" e-width="60"></div>
                                </div>


                            </div>
                            <script type="text/template" id="PrintFileTab">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li><button ng-click="$parent.confirmModal(data)" class="btn" tabindex="9"><i class="glyphicon glyphicon-trash" style="top: 1px;"></i></button></li>
                                    </ul>
                                </div>
                            </script>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div class="col-xs-12 col-sm-12 col-sm-12" style="padding-left: 0px; padding-right: 0px;">
            <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="getDetail" e-load="loadGridEdit"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                <div e-columns>
                    <div e-column e-field="SystemId" e-headertext="Master Id" e-width="40"></div>
                    <div e-column e-field="Company" e-headertext="Comapny" e-width="40"></div>
                    <div e-column e-field="TaxType" e-headertext="Tax Type" e-width="40"></div>
                    <div e-column e-field="TaxYearName" e-headertext="Tax Year" e-width="40"></div>
                    <div e-column e-field="TaxSavingGroup" e-headertext="Tax Saving Group" e-width="40"></div>
                    <div e-column e-field="UserCode" e-headertext="User Code" e-width="40"></div>
                </div>
            </div>
        </div>

    </div>
    <script>
        function isNumber(evt) {
            evt = (evt) ? evt : window.event;
            var charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 46) {
                return false;
            }
            return true;
        }
    </script>

    <confirm-modal></confirm-modal>
    <div class="modal fade site-modal in" id="confirmPOPUPD" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">x</button>
                    <h4 class="modal-title">
                        <i class="glyphicon glyphicon-warning-sign"></i> "Delete"
                    </h4>
                </div>
                <div class="modal-body">
                    <p class="text-warning">Are you sure to delete ?</p>
                </div>
                <div class="modal-footer common-btn">
                    <button type="button" class="btn btn-default" data-dismiss="modal">No</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal" id="btnConfirmed" ng-click="DeleteChild();">Yes</button>

                </div>
            </div>
        </div>
    </div>
