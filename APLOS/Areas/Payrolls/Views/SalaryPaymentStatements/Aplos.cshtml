<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Payment Statements [Bank,Cash,Check,Transfer]</h3>
<div class="row">
    <div class="col-xs-12">
        <div class="row">
            <div class="col-md-12">
                <div class="col-xs-2 col-sm-2 col-md-2">
                    <div class="col-md-12">
                        @*<input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-model="year" e-enablefiltersearch="true" e-fields-value="Text" e-fields-text="Text" e-width="100%" />*@
                        <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-databound="SelectDefaultValue" e-value="year" e-enablefiltersearch="true" e-fields-value="Text" e-fields-text="Text" e-width="100%" />

                    </div>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="col-md-12">
                        <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-enablefiltersearch="true" e-value="month" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                        @*<input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-enablefiltersearch="true" e-model="month" e-fields-value="Value" e-fields-text="Text" e-change="getSalaryProcessIdList" e-width="100%" />*@
                    </div>
                </div>
                <div class="col-xs-2 col-sm-2 col-md-2">
                    <div class="form-group">
                        <label class="col-sm-6 " style="font-weight:normal;">Regular<sup></sup></label>
                        <div class="col-sm-6">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="isActive" e-checked="isActive" e-model="isActive" />
                        </div>
                    </div>
                </div>
                <div class="col-xs-2 col-sm-2 col-md-2">
                    <div class="form-group">
                        <label class="col-sm-8" style="font-weight:normal;">Seperated<sup></sup></label>
                        <div class="col-sm-4">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="isSeperated" e-checked="isSeperated" e-model="isSeperated" />
                        </div>
                    </div>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="form-group">
                        <label class="col-sm-8" style="font-weight:normal;">Going Maternity<sup></sup></label>
                        <div class="col-sm-2">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="isMaternity" e-checked="isMaternity" e-model="isMaternity" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3" style="margin-left:25px;margin-top:10px;">
                <input id="ddlEmpTypeList" e-watermarktext="Emp Type" ej-dropdownlist e-datasource="empTypeList" e-enablefiltersearch="true" e-model="empTypeId" e-fields-value="Value" e-fields-text="Text" e-width="80%" />
            </div>
        </div>
        <br />
        <br />

        <div class="form-horizontal form-elements">
            <div id="Tab" ej-tab e-itemactive="onactivetab" e-create="oncreatetab">

                <ul>
                    <li><a href="#TabBank">Bank Statement</a></li>
                    <li><a href="#TabCash">Cash Statement</a></li>
                    <li><a href="#TabCheque">Check Statement</a></li>
                    <li><a href="#TabTrnfar">Transfer Statement</a></li>
                </ul>

                <div id="TabBank">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-3">
                                <input id="ddlBankList" e-watermarktext="Bank" ej-dropdownlist e-datasource="empBankList" e-enablefiltersearch="true" e-model="empBankId" e-fields-value="Value" e-fields-text="Text" e-width="100%" />
                            </div>
                            <div class="col-md-3">
                                <input e-watermarktext="Letter Date" e-dateformat="dd-MMM-yyyy" ej-datepicker e-value="letterDate" e-width="100%" />
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <div class="form-elements">
                                        <input class="e-input" name='input' style="border: 1px solid lightgray;height: initial;" type="text" placeholder="Check No." ng-model="chequeNo" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <button ng-click="GetSalaryPaymentStatement('BANK');" class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="TabCash">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">

                                    <button ng-click="GetSalaryPaymentStatement('CASH');" class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button>
                                </div>
                            </div>
                            <div class="col-md-4">

                            </div>

                        </div>
                    </div>
                </div>
                <div id="TabCheque">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <button ng-click="GetSalaryPaymentStatement('CHECK');" class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button>
                                </div>
                            </div>
                            <div class="col-md-4">
                            </div>

                        </div>
                    </div>
                </div>
                <div id="TabTrnfar">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <button ng-click="GetSalaryPaymentStatement('TRANSFER');" class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button>
                                </div>
                            </div>
                            <div class="col-md-4">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
