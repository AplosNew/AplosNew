<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Salary Head Wise Payment Mode Policy
</h3>

<div class="form-horizontal" ng-form id="ShiftAssignment" name="ShiftAssignment">
    <div class="row form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6 ">
            <div class="form-group">
                <label class="col-sm-4 control-label">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="SalaryHeadWisePaymentModePolicyModel.CompanyId" ng-change="companyOnChange();"
                                ng-options="item.Value as item.Text for item in companyList" id="CompanyId"
                                name="Company" required tabindex="1" ng-disabled="SalaryHeadWisePaymentModePolicyModel.Id != null">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 ">
            <div class="form-group">
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="SalaryHeadWisePaymentModePolicyModel.PlantId"
                                ng-options="item.Value as item.Text for item in plantList" id="plantId" ng-disabled="SalaryHeadWisePaymentModePolicyModel.Id != null" ng-change="GetSalaryHeadPaymentPolicy()"
                                name="Plant" required tabindex="1">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
        <div class="row form-elements">
            <div class="col-xs-12 col-sm-6 col-md-6">

                <div class="form-group">
                    <label class="col-sm-4 control-label">Salary Head<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select id="SalaryHeadID" class="form-control" ng-model="SalaryHeadWisePaymentModePolicyModel.SalaryHeadId" name="Leave Type" required tabindex="1">
                                <option value="">--Select--</option>
                                <option ng-repeat="option in SalaryHeadlist" value="{{option.SalaryHeadID}}">{{option.SalaryHead}}</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-4 control-label">Amount</label>
                    <div class="col-sm-8">
                        <input type="text" ng-model="SalaryHeadWisePaymentModePolicyModel.Amount" only-numbers class="form-control" maxlength="100" tabindex="2">
                    </div>
                </div>


            </div>


            <div class="col-xs-12 col-sm-6 col-md-6">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Payment Mode<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <div class="select-style">
                            <select id="LeaveTypeID" class="form-control" ng-model="SalaryHeadWisePaymentModePolicyModel.PaymentMode" name="Leave Type" required tabindex="1">
                                <option ng-repeat="option in PaymentModelist" value="{{option.PaymentMode}}">{{option.PaymentMode}}</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>


            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    <li> <button data-toggle="modal" data-target="#confirmPopUpMaster" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                    <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                </ul>
            </div>
        </div>
    </div>
    <hr />
    <confirm-archive-generic modalid="confirmPopUpMaster" title="Confirmation" message="Are you sure to delete ?" data-ng-click-right-button="Delete();"></confirm-archive-generic>

    <div class="row text-right aplos-grid-toggle">

        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;" id="GridDesignation" ej-grid e-datasource="getSalaryHeatList"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                 e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                <div e-columns>

                    <div e-column e-field="Id" e-headertext="Id" e-width="70" e-visible="false"></div>
                    <div e-column e-field="SalaryHead" e-headertext="SalaryHead " e-width="60"></div>
                    <div e-column e-field="PaymentMode" e-headertext="Payment Mode" e-width="70"></div>
                    <div e-column e-field="Amount" e-headertext="Amount" e-width="80"></div>


                </div>
            </div>
        </div>

    </div>







