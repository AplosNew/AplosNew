@*<togglable name="Multiple Leave Encashment"></togglable>*@
<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Multiple Leave Encashment (Specific Date wise)
</h3>

<div class="row form-horizontal">
    <div class="col-xs-12 col-sm-5 col-md-8 " style="text-align:center">
        {{SpecificDateLeaveEncashmentDate}}
    </div>

    <div class="col-xs-12 col-sm-12 col-md-4">
        <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="GetSpecificDateLeaveEncashmentData(); LoadLeaveEncashmentList();" style="margin-right: 3px;" class="btn"><i class="glyphicon glyphicon-circle-arrow-right"></i> Go</button></li>
                </ul>
            </div>
    </div>

</div>
<br />
<br />









<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab">New (Encashment)</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab">Already Encashmented</a></li>


        </ul>
    </div>

    <div class="tab-content" id="tabpaneldiv">

        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet11(11), active: isSet11(11) }">

            <div class="row">
                <div class="col-xs-12 col-sm-12 col-sm-12">

                    <div style="color:black;"
                         id="GridLeaveEncashmentList"
                         ej-grid e-datasource="LeaveEncashmentList"
                         e-templaterefresh="refreshTemplateemployee"
                         e-actioncomplete="actionCompleteSelected"
                         e-pagesettings-pagesize="17"
                         e-gridlines="vertical"
                         e-allowfiltering="true"
                         e-allowpaging="true"
                         e-allowsorting="true"
                         e-allowselection="true"
                         e-filtersettings-filterType="excel" e-allowtouch="true">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Name" e-width="100"></div>
                            <div e-column e-field="Rate" e-headertext="Rate/Day" e-width="90" e-textalign="right"></div>
                            <div e-column e-field="BroughtForward" e-headertext="BF" e-width="90" e-textalign="right"></div>
                            <div e-column e-field="DaysCanBeSanctioned" e-headertext="Earned" e-width="90" e-textalign="right"></div>
                            @*<div e-column e-field="CurrentYearAllocation" e-headertext="CurrentYearAllocation" e-width="80"></div>
        <div e-column e-field="LeaveDaysAllowed" e-headertext="LeaveDaysAllowed" e-width="80"></div*@>
                            <div e-column e-field="AvailedLeave" e-headertext="Availed" e-width="90" e-textalign="right"></div>
                            <div e-column e-field="EncashedInbetween" e-headertext="Encashed" e-width="90" e-textalign="right"></div>
                            <div e-column e-field="Balance" e-headertext="Balance" e-width="90" e-textalign="right"></div>
                            @*<div e-column e-field="AvailedEncashment" e-headertext="AvailedEncashment" e-width="80"></div>*@
                            @*<div e-column e-template="#Rate" e-headertext="Encashment No" e-width="80"></div>*@

                            <div e-column e-field="CarryForward" e-headertext="CF" e-width="90" e-textalign="right"></div>
                            <div e-column e-field="YearEndLapse" e-headertext="Lapse" e-width="90" e-textalign="right"></div>
                            <div e-column e-field="Days" e-headertext="Encashment No" e-width="80" e-textalign="right"></div>
                            @*<div e-column e-field="EmpCategoryName" e-headertext="Category" e-width="90"></div>*@
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-width="90" e-format="{0:dd-MMM-yyyy}" e-type="date"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                            <div e-column e-field="Unit" e-headertext="Unit" e-width="100"></div>
                            <div e-column e-field="Division" e-headertext="Division" e-width="100"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="100"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="100"></div>
                            <div e-column e-field="EncashmentSpecificDate" e-headertext="Encashment Date" e-width="100"></div>
                            <div e-column e-field="PolicyName" e-headertext="Policy" e-width="100"></div>
                        </div>

                    </div>

                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headchk" />
                    </script>
                    <script type="text/template" id="Rate">
                        <div class="col-sm-12" style="padding:0px; width:100%;height:23px;">
                            <input type="text" ng-model="data.Days" style="color:black; height:22px;" class="form-control" />

                        </div>
                    </script>
                </div>

            </div>
            <hr />
            <div class="row form-horizontal">

                <div class="col-xs-12 col-sm-12 col-md-12 text-right">

                    <div class="form-group">

                        <div class="col-sm-12" style="margin-left:0px;padding-left:0px">

                            <button style="color: #f3f3ec;background-color: #1c1f32; " ng-click="Save()" class="btn">Save</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>


        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet22(22), active: isSet22(22) }">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-sm-12">

                    <div style="color:black;"
                         id="GridSavedLeaveEncashmentList"
                         ej-grid e-datasource="SeavedLeaveEncashmentList"
                         @*e-templaterefresh="refreshTemplateemployeeSeved"*@
                         e-actioncomplete="actionCompleteSelectedSeved"
                         e-pagesettings-pagesize="17"
                         e-gridlines="vertical"
                         e-allowfiltering="true"
                         e-allowpaging="true"
                         e-allowsorting="true"
                         e-allowselection="true"
                         e-filtersettings-filterType="excel" e-allowtouch="true">
                        <div e-columns>

                            <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Name" e-width="100"></div>
                            @*<div e-column e-field="Rate" e-headertext="Rate/Day" e-width="80"></div>*@
                            <div e-column e-field="BroughtForward" e-headertext="BF" e-width="80"></div>
                            <div e-column e-field="DaysCanBeSanctioned" e-headertext="Earned" e-width="80"></div>
                            <div e-column e-field="AvailedLeave" e-headertext="Availed" e-width="80"></div>
                            <div e-column e-field="Balance" e-headertext="Balance" e-width="80"></div>
                            <div e-column e-field="Days" e-headertext="Encashment" e-width="80"></div>
                            @*<div e-column e-field="EmpCategoryName" e-headertext="Category" e-width="90"></div>*@
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-width="90"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-width="100"></div>
                            <div e-column e-field="Unit" e-headertext="Unit" e-width="100"></div>
                            <div e-column e-field="Division" e-headertext="Division" e-width="100"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="100"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="100"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="100"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="100"></div>
                            <div e-column e-field="EncashmentSpecificDate" e-headertext="Encashment Date" e-width="100"></div>
                            <div e-column e-field="PolicyName" e-headertext="Policy" e-width="100"></div>
                        </div>

                    </div>


                </div>
            </div>

        </div>
    </div>





</div>

