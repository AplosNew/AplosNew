<togglable name="Leave Encashment"></togglable>
<div class="form-elements" ng-form id="LeaveEncashment" name="LeaveEncashment">
    <div class="row"></div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">


            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Year <sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <select id="SalaryHeadFormula" class="form-control" ng-model="CustomPara.YearlyCalendarId" name="DailyAllowanceType" tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in YearlyCalendar" value="{{option.Id}}">{{option.YearNo}}</option>
                    </select>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Code<sup>*</sup></label>
                <div class="col-sm-6 show-message">
                    <input type="text" min="1" name="Sequence" ng-model="EmployeeModel.EmployeeCode" class="form-control" ng-disabled="true" required tabindex="1">

                </div>
                <div class="col-sm-2 show-message" style="margin-left:0px;padding-left:0px">

                    <button style="color: #f3f3ec;background-color: #1c1f32; " class="btn"><i class="glyphicon glyphicon-search" ng-click="LoadEmployeeList()" style="margin: -4px;"></i></button>
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Employee Name </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.EmployeeName}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">DOJ </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.DOJ}}</label>
            </div>
            @*<div class="form-group" show-errors>
            <label class="col-sm-4 control-label">DOS </label>
            <label class="col-sm-8 control-label">: {{EmployeeModel.DOS}}</label>
        </div>*@

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Designation </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.LegalDesignation}}</label>
            </div>


        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">


            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Leave Encashment Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" maxlength="15" name="ShortName" ng-model="CustomPara.EncashmentDate" datepicker placeholder="dd-MMM-yyyy" class="form-control" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Leave Encashment Type</label>
                <div class="col-sm-8 show-message">
                    <select id="SalaryHeadFormula" class="form-control" ng-model="CustomPara.LeaveEncashmentType" name="DailyAllowanceType" tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in LeaveEncashmentTypeList" value="{{option.UserName}}">{{option.UserName}}</option>
                    </select>
                </div>
            </div>

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Department </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.Department}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Position </label>
                <label class="col-sm-8 control-label">: {{EmployeeModel.PositionName}}</label>
            </div>
           

        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">




            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">LeaveType </label>
                <label class="col-sm-8 control-label">: {{LeaveEncashmentModel.LeaveType}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">BroughtForward </label>
                <label class="col-sm-8 control-label">: {{LeaveEncashmentModel.BroughtForward}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">DaysCanBeSanctioned </label>
                <label class="col-sm-8 control-label">: {{LeaveEncashmentModel.DaysCanBeSanctioned}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">CurrentYearAllocation </label>
                <label class="col-sm-8 control-label">: {{LeaveEncashmentModel.CurrentYearAllocation}}</label>
            </div>


        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">

            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">LeaveDaysAllowed </label>
                <label class="col-sm-8 control-label">: {{LeaveEncashmentModel.LeaveDaysAllowed}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">AvailedLeave </label>
                <label class="col-sm-8 control-label">: {{LeaveEncashmentModel.AvailedLeave}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Balance </label>
                <label class="col-sm-8 control-label">: {{LeaveEncashmentModel.Balance}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Encashed </label>
                <label class="col-sm-8 control-label">: {{LeaveEncashmentModel.AvailedEncashment}}</label>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Rate </label>
                <label class="col-sm-8 control-label">: {{LeaveEncashmentModel.Rate}}</label>
            </div>

        </div>
    </div>
    <hr />

    <div class="row">

        
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">

        
            <div class="form-group">
                <label class="col-sm-3 control-label">Encashed(EL) :</label>
                <label class="col-sm-1 control-label">Days </label>
                <div class="col-sm-2 show-message">
                    <input type="number" placeholder="Day No" ng-model="LeaveEncashmentModel.Days" class="form-control" required tabindex="1">
                </div>
                <label class="col-sm-2 control-label"> Amount</label>
                <div class="col-sm-4 show-message">
                    <input type="text" ng-model="LeaveEncashmentModel.Days*LeaveEncashmentModel.Rate" class="form-control" required tabindex="1">
                </div>
            </div>

           
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
           

            <div class="form-group">
                <label class="col-sm-4 control-label">Disburse</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input tabindex="8" type="checkbox" ng-model="LeaveEncashmentModel.Isdisburse">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>

        </div>
    </div>
  
    <hr />
    <div class="common-btn">
        <ul class="list-inline text-right" ng-show="btnSave">
            <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
           
            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Clear</button></li>
        </ul>
    </div>
</div>



<div class="row text-right aplos-grid-toggle">
    <div class="col-xs-12 col-sm-12 col-sm-12">

        <div style="color:black;"
             id="GridLeaveEncashmentList"
             ej-grid e-datasource="LeaveEncashmentList"
             e-gridlines="vertical"
             e-allowfiltering="true"
             e-allowpaging="true"
             e-allowsorting="true"
             e-allowselection="true"
             e-filtersettings-filterType="excel" e-allowtouch="true">
            <div e-columns>
                <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="80"></div>
                <div e-column e-field="EmployeeName" e-headertext="Name" e-width="100"></div>
                <div e-column e-field="EncashmentDate" e-headertext="Encashment Date" e-width="80"></div>
                <div e-column e-field="LeaveEncashmentType" e-headertext="LeaveEncashmentType" e-width="50"></div>
                <div e-column e-field="YearlyCalendarId" e-headertext="TenureMonth" e-width="50"></div>
                <div e-column e-field="Days" e-headertext="Days" e-width="50"></div>
                <div e-column e-field="Rate" e-headertext="Rate" e-width="80"></div>
                <div e-column e-field="Isdisburse" e-headertext="Isdisburse" e-width="80"></div>
                <div e-column e-headertext="Actions" e-width="70">
                    @*<button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-edit" ng-click="$parent.EditFinalSettlement($event);" style="margin: -6px;"></i></button>*@
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.remove($event);" style="margin: -6px;"></i></button>

                </div>
            </div>
        </div>
    </div>

</div>

@*<confirm-modal></confirm-modal>*@



<ej-dialog id="dialogEmployeeInfo"
           title=" Employee Information"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target=".site-heading"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="500" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div style="color:black;"
                 id="GridEmployeeInfoList"                 
                 ej-grid e-datasource="EmployeeInformationList"
                 e-recorddoubleclick="SelectEmployee"
                 e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowselection="true"
                 e-pagesettings-pagesize="25"
                 e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="70"></div>
                    <div e-column e-field="DOS" e-headertext="DOS" e-width="70"></div>
                    <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>                    
                </div>
            </div>
        </div>
    </div>

</ej-dialog>


<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>