<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{title}}
</h3>
<div class="form-elements form-horizontal" ng-form name="leaveApplicationNewForm">
    <div class="clearfix"></div>
    <input type="hidden" ng-model="leaveApplicationNew.Id">
    <input type="text" ng-model="leaveApplicationNew.Id" hidden />
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee Select<sup>*</sup></label>
            <div class="input-group">
                <div class="col-sm-2">
                    <span class="input-group-btn">
                        <button name="submit" ng-click="getPopUpData();" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-8 col-md-8">
        <div class="col-md-5">
            <label>
                {{GPDetails.IsRound}}
            </label>
        </div>
        <div class="col-md-4">
            <label>
                Maturity year From: {{GPDetails.MaturityFromYear}}
            </label>
        </div>
        <div class="col-md-3">
            <label>
                Maturity year To: {{GPDetails.MaturityToYear}}
            </label>
        </div>
    </div>


    <div class="col-md-12 table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Employee Code</th>
                    <th>Employee Name</th>
                    <th>Father Name</th>
                    <th>DOB</th>
                    <th>DOJ</th>
                    <th>Designation</th>
                    <th>Tenure (Year)</th>
                    <th>Tenure (Month)</th>
                    <th>Agreement</th>
                    <th>PolicyNo</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="x in EmployeeListTemp">
                    <td>{{x.EmployeeCode}}</td>
                    <td>{{x.EmployeeName}}</td>
                    <td>{{x.FatherName}}</td>
                    <td>{{x.DOB}}</td>
                    <td>{{x.DOJ}}</td>
                    <td>{{x.Designation}}</td>
                    <td>{{x.TYear}}</td>
                    <td>{{x.TMonth}}</td>
                    <td>
                        <div class="select-style">
                            <select class="form-control" ng-model="x.AgreementId">
                                <option value=""></option>
                                <option ng-repeat="option in GratuityInsList" value="{{option.Id}}">{{option.AgreementNo}}</option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <input type="text" ng-model=" x.PolicyNo" class="form-control">
                    </td>
                    <td class="text-center">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="RemoveMaster(x);" style="margin: -6px;"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
        </ul>
    </div>
</div>

<div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="Grid" ej-grid e-datasource="employee" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplateemployee">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>
                            <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="TYear" e-headertext="Tenure Year" e-width="80"></div>
                            <div e-column e-field="TMonth" e-headertext="Tenure Month" e-width="80"></div>
                        </div>
                    </div>
                </div>

            </div>
            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" ej-checkbox class="nodetext" e-value="data.CheckBoxSelect" e-checked="data.CheckBoxSelect" />
            </script>
            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
            </script>
            <div class="modal-footer common-btn">
                <button ng-click="saveemployeedata();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button>
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmMasterPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteMaster();"></confirm-archive-generic>
