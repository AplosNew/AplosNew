<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Salary Process Delete</h3>
<div id="salaryProcessNew" class="form-horizontal" ng-form name="salaryProcessNewForm">
    <input type="hidden" ng-model="salaryProcessNew.Id">
    <div class="col-sm-3">
        <div class="form-group">
            <label class="col-sm-4 control-label">Month<sup>*</sup></label>
            <div class="col-sm-6">
                <div class="select-style">
                    <select class="form-control" ng-model="salaryProcessModel.MonthId" name="Month" ng-change="getData();">
                        <option value="">--Select--</option>
                        <option value="01">Jan</option>
                        <option value="02">Feb</option>
                        <option value="03">Mar</option>
                        <option value="04">Apr</option>
                        <option value="05">May</option>
                        <option value="06">Jun</option>
                        <option value="07">Jul</option>
                        <option value="08">Aug</option>
                        <option value="09">Sep</option>
                        <option value="10">Oct</option>
                        <option value="11">Nov</option>
                        <option value="12">Dec</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="form-group">
            <label class="col-sm-4 control-label">Year<sup>*</sup></label>
            <div class="col-sm-6">
                <div class="select-style">
                    <select id="Year" class="form-control" ng-model="salaryProcessModel.YearId" name="Year" required tabindex="1" ng-change="getData();">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in yearList" value="{{option.Text}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <label class="col-sm-4 control-label">Employee Select</label>
        <div class="col-sm-8  show-message">
            <div class="col-sm-8">
                <button name="Add" class="single-btn" ng-click="popUp();"><i class="glyphicon glyphicon-search"></i></button>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="row form-elements">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Employee Code</th>
                            <th>Employee Name</th>
                            <th>Employee Category</th>
                            <th>Given Designation</th>
                            <th>Division</th>
                            <th>Department</th>
                            <th>Section</th>
                            <th>Remove</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in salaryProcesss">
                            <td>{{x.EmployeeCode}}</td>
                            <td>{{x.EmployeeName}}</td>
                            <td>{{x.EmployeeCategory}}</td>
                            <td>{{x.GivenDesignation}}</td>
                            <td>{{x.Division}}</td>
                            <td>{{x.Department}}</td>
                            <td>{{x.Section}}</td>
                            <td class="text-right">
                                <button ng-click="valuePassInDelModal($index,x)" class="btn-action tooltip-here"
                                        data-placement="top" title="Delete">
                                    <i class="glyphicon glyphicon-remove"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="SalaryProcessDeleteMessage();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>{{Action}}</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
<confirm-archive-generic modalid="confirm_PopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
<confirm-archive-generic modalid="confirm_PopUp-Delete" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="SalaryProcessDelete()"></confirm-archive-generic>
