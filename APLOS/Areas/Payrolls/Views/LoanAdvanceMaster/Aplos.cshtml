<togglable name="Salary Advance"></togglable>
<div class="form-elements form-horizontal" ng-form name="loanAdvanceNewForm">
    <input type="hidden" ng-model="loanAdvanceNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="PlantId" class="form-control" ng-model="loanAdvanceNew.PlantId" name="Plant" required tabindex="1" ng-change="SetYearOfPassing(loanAdvanceNew.PlantId)">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee Name :</label>
            <div class="col-sm-8">
                <label>{{loanAdvance.EmployeeName}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee Code :</label>
            <div class="col-sm-8">
                <label>{{loanAdvance.EmployeeCode}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Budget Code :</label>
            <div class="col-sm-8">
                <label>{{loanAdvance.BudgetCode}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Email :</label>
            <div class="col-sm-8">
                <label>{{loanAdvance.EmailId}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Given Designation :</label>
            <div class="col-sm-8">
                <label>{{loanAdvance.Designation}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Department :</label>
            <div class="col-sm-8">
                <label>{{loanAdvance.Department}}</label>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Salary Rule Name:</label>
            <div class="col-sm-8">
                <label>{{loanAdvance.SalaryRuleName}}</label>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-left">
                <li> <button ng-click="AddSalaryAdvance()" ng-show="loanAdvance.SalaryRuleName.length>0" class="btn"><i class="glyphicon glyphicon-plus"></i>Add Salary Advance</button></li>
            </ul>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label"></label>
            <div class="col-sm-8" style="margin-top:-14px;">
                <ul class="common-btn list-inline text-left">
                    <li><button class="btn" ng-click="popUp('EmployeeInformation');"><i class="glyphicon glyphicon-search"></i> Search Employee</button></li>
                </ul>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-8">
                <div>
                    <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="margin-left: 180px; border: 1px solid; height: 200px; width: 200px;" />
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn">
    </div>
    <div class="table-responsive modal-table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Edit</th>
                    <th>Starting Year No</th>
                    <th>Starting Month</th>
                    @*<th>Advance Currency</th>*@
                    <th>Advance Amount</th>
                    @*<th>Defination Currency</th>*@
                    @*<th>Defination Amount</th>*@
                    @*<th>Paid Currency</th>*@
                    @*<th>Paid Amount</th>*@
                    <th>IsFixed Amount</th>
                    <th>IsMonthly Equal Amount</th>
                    <th>Installment Amount</th>
                    <th>Installment Month</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="q in masterDataList">
                    <td><span class="glyphicon glyphicon-edit" ng-click="EditSalaryAdvance(q.SystemID,$index)"></span></td>
                    <td>{{q.FromYearNo}}</td>
                    <td>{{q.StartingMonthName}}</td>
                    @*<td>{{q.AdvanceCurrency}}</td>*@
                    <td>{{q.AdvanceAmount}}</td>
                    @*<td>{{q.EntryCurrencyID}}</td>*@
                    @*<td>{{q.EntryCurrency}}</td>*@
                    @*<td>{{q.PaidAmount}}</td>*@
                    <td>{{q.IsFixedAmount?'Yes':'No'}}</td>
                    <td>{{q.IsEqualMonthAmount?'Yes':'No'}}</td>
                    <td>{{q.InstallmentAmount}}</td>
                    <td>{{q.InstallmentMonth}}</td>
                    <td><span class="glyphicon glyphicon-list" ng-click="GetLoanChildByMaster(q.SystemID)"></span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<confirm-modal></confirm-modal>
<div class="modal fade site-modal in" id="popUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                {{popUpTitle}}
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row text-right">
                    <div class="col-xs-12 col-sm-12 col-sm-12 ">
                        <div class="search-form">
                            <div class="row">
                                <div class="col-xs-12 col-sm-3 col-md-3">
                                    <div class="select-style">
                                        <select ng-model="popUpParameters.searchBy">
                                            <option ng-repeat="option in popUpList" value="{{option.Value}}">{{option.Text}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-7 col-md-7">
                                    <input type="text" class="form-control" placeholder="Search" ng-model="popUpParameters.search" ng-enter="popUpData()">
                                </div>
                                <div class="col-xs-12 col-sm-2 col-md-2">
                                    <button type="button" ng-click="popUpData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th ng-repeat="x in popUpList">{{x.Text}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in popUpDataList|itemsPerPage:popUpParameters.pageSize" total-items="popUpParameters.total_count"
                                ng-click="selectSingleClick(x)" ng-dblclick="selectdblClick(x);">
                                <td ng-repeat="hh in popUpList">{{x[hh.Value]}}</td>
                            </tr>
                        </tbody>
                    </table>
                    <dir-pagination-controls max-size="10"
                                             direction-links="true"
                                             boundary-links="true"
                                             on-page-change="popUpData(newPageNumber)">
                    </dir-pagination-controls>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="SalaryAdvancePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Add Salary Advance</h4>
            </div>
            <div class="modal-body">
                <div class="form-elements form-horizontal" ng-form="loanAdvanceNewForm2">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Start Date<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" ng-model="loanAdvanceNew.StartDate" datepicker class="form-control" placeholder="dd-MM-yyyy" tabindex="1">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Advance Amount<sup>*</sup></label>
                            <div class="col-sm-4 show-message">
                                <input type="text" style="width:145px;" ng-change="showBalanceAmt()" placeholder="Advance Amount" name="Advance Amount" ng-model="loanAdvanceNew.AdvanceAmount" only-numbers class="form-control" required tabindex="2">

                            </div>
                            <div class="col-sm-4 show-message">
                                <input type="text" style="width:115px;" ng-change="showBalanceAmt()" name="Paid Amount" placeholder="Paid Amount" ng-model="loanAdvanceNew.PaidAmount" only-numbers class="form-control" required tabindex="3">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label">Installment Amount<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Installment Amount" ng-change="getInstallMonth();" ng-model="loanAdvanceNew.InstallmentAmount" only-numbers class="form-control" tabindex="5">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"></label>
                            <div class="col-sm-8 show-message">
                            </div>
                        </div>

                        <div class="form-group" style="margin-top:33px;">
                            <label class="col-sm-4 control-label">Balance Amount</label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Balance Amount" ng-model="loanAdvanceNew.BalanceAmount" readonly class="form-control" required tabindex="4">
                            </div>
                        </div>


                        <div class="form-group">
                            <label class="col-sm-4 control-label">Installment Months<sup>*</sup></label>
                            <div class="col-sm-8">
                                <input type="text" name="Installment Month" ng-change="getInstallAmount();" ng-model="loanAdvanceNew.InstallmentMonth" only-numbers class="form-control" tabindex="6">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="7"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="SalaryAdvanceDetailsPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Add Salary Advance Details</h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Start Date</th>
                                <th>Month</th>
                                <th>Monthly Payment Amount</th>
                                <th>Paid Amount</th>
                                <th>Balance Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="t in childDataList">
                                <td>{{t.StartDate|dateFiltering}}</td>
                                <td>{{t.MonthName}}</td>
                                <td>{{t.MonthlyAdjAmount}}</td>
                                <td>{{t.PaidAmount}}</td>
                                <td>{{t.BalanceAmount}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>