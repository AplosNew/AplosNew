<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Salary Structure Approval
</h3>
<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell {
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }
</style>



<div class="row">
    <div id="maindiv" class="table-responsive modal-table">
        <div id="Grid" ej-grid e-datasource="employees" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="true" e-responsive="true" e-templaterefresh="refreshTemplateemployee4"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                <div e-column e-field="Code" e-headertext="Budget Code" e-width="50"></div>
                <div e-column e-field="BudgetedManPower" e-type="number" e-textalign="right" e-format="{0:N0}" e-headertext="Budgeted ManPower" e-width="100"></div>
                <div e-column e-field="OnRollManPwr" e-type="number" e-textalign="right" e-format="{0:N0}" e-headertext="OnRoll ManPower" e-width="100"></div>
                <div e-column e-field="CurrentApprovalRequired" e-type="number" e-textalign="right" e-format="{0:N}" e-headertext="Current Approval Required" e-width="100"></div>
                <div e-column e-field="BalanceRequired" e-type="number" e-textalign="right" e-format="{0:N0}" e-headertext="Balance Required" e-width="100"></div>
                <div e-column e-field="LA" e-type="number" e-textalign="right" e-format="{0:N0}" e-headertext="Long Abesenteeism" e-width="100"></div>
                <div e-column e-field="TBS" e-type="number" e-textalign="right" e-format="{0:N0}" e-headertext="Tobe Seperated" e-width="100"></div>
                <div e-column e-field="NetShortage" e-type="number" e-textalign="right" e-format="{0:N0}" e-headertext="Net Shortage" e-width="100"></div>

                <div e-column e-field="DOJs" e-headertext="DOJ" e-width="70"></div>
                <div e-column e-field="DOBs" e-headertext="DOB" e-width="70"></div>

                @*<div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>*@
                <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                <div e-column e-field="DesignationGroupName" e-headertext="Designation Group" e-width="80"></div>
                <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                <div e-column e-field="SubSection" e-headertext="Sub Section" e-width="80"></div>
                <div e-column e-field="DOSs" e-headertext="DOS" e-width="100"></div>
                <div e-column e-field="EmployeeStatus" e-headertext="Employee Status" e-width="80"></div>
                <div e-column e-field="PayRollGroupName" e-headertext="Payroll Group" e-width="80"></div>
                @*<div e-column e-field="ApprovedStatus" e-headertext="Status" e-width="60"></div>*@
                <div e-column e-field="IncrementType" e-headertext="Status" e-width="60"></div>
                <div e-column e-headertext="Action" e-commands="commandApproval" e-isunbound=true e-textalign="center" e-width="100"></div>
            </div>
        </div>
    </div>
</div>
<script type="text/x-jsrender" id="colTemplate">
    {{:IsPending===1 ? '<i class="glyphicon glyphicon-star-empty" ></i>' : FALSE }}
</script>

<script type="text/template" id="checkboxTemplate">
    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
</script>
<script type="text/x-jsrender" id="headerTemplate">
    <input type="checkbox" id="headchk" />
</script>
<div class="row form-horizontal form-elements" id="EntryDiv">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <div class="common-btn">
            <ul class="list-inline text-right">

                <li> <button ng-click="saveData();" style="margin-right: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Approved</button></li>

            </ul>
        </div>
    </div>

</div>
<!-- #endregion -->









<ej-dialog id="dialogApproval" title="Salary Structure Details" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target=".site-heading" e-close="onDialogClose" e-minwidth="70%" e-minheight="50" e-open="enableBtn">


    <div class="row form-horizontal form-elements">

        <div class="col-xs-12 col-md-5 ">
            <div class="form-group">
                <label class="col-sm-4 control-label">Name</label>
                <div class="col-sm-8">
                    <label class="control-label" style="font-size: 8pt"><b>:</b> {{budgetCodeChangeOld.EmployeeName }}</label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Employee Code</label>
                <div class="col-sm-8">
                    <label class="control-label" style="font-size: 8pt"><b>:</b> {{budgetCodeChangeOld.EmployeeCode}}</label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">DOJ</label>
                <div class="col-sm-8">
                    <label class="control-label" style="font-size: 8pt"><b>:</b> {{budgetCodeChangeOld.DOJ | dateFiltering}}</label>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-md-5 ">

            <div class="form-group">
                <label class="col-sm-4 control-label">Designation Group</label>
                <div class="col-sm-8">
                    <label class="control-label" style="font-size: 8pt"><b>:</b> {{budgetCodeChangeOld.DesignationGroupName}}</label>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Given Designation</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="budgetCodeChangeOld.GivenDesignationId" name="Given Designation" tabindex="1" ng-disabled="true">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in givenDesignationList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Legal Designation</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="budgetCodeChangeOld.LegalDesignationId" name="Legal Designation" ng-disabled="true" tabindex="1">
                            <option value=""> </option>
                            <option ng-repeat="option in LegalDesignationList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>

                    </div>

                </div>
            </div>
        </div>
        <div class="col-xs-12 col-md-2">
            <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="margin-left: 0px;margin-top: 10px; border: 1px solid; height: 100px; width: 100%;" />
        </div>





    </div>



    <div class="row form-horizontal form-elements">
        <div class="col-xs-12 col-sm-12 col-md-5">
            <div class="form-group">
                <label class="col-sm-4 control-label">Effective Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <input class="form-control" type="text" style="visibility:hidden;height:0px;width:0px; border:0px;padding:0px;" autofocus="" />
                        <input class="form-control" ng-model="EmpSalaryInfo.EffectiveDate" datepicker placeholder="dd-MM-yyyy" />
                    </div>
                </div>
            </div>
            <div class="form-group">

                <label class="col-sm-4 control-label">Salary Rule</label>
                <div class="col-sm-8 text-right">
                    <label class="control-label"> {{SelectedSalaryRole}}</label>
                </div>




            </div>

        </div>
        <div class="col-xs-12 col-sm-12 col-md-7">

            <div class="form-group">
                <label class="col-sm-4 control-label">Next Due Date<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <input class="form-control" ng-model="EmpSalaryInfo.NextDueDate" value="EmpSalaryInfo.NextDueDate" datepicker placeholder="dd-MM-yyyy" />
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-2 control-label">Total Gross </label>
                <div class="col-sm-2 text-right">
                    <label class="control-label"> {{ResultTatalGross | number :0}}</label>
                </div>

                <label class="col-sm-1 control-label">CTC </label>
                <div class="col-sm-3 text-right">
                    <label class="control-label"> {{ResultCTC | number :0}}</label>
                </div>
                <label class="col-sm-1 control-label">Net Pay </label>
                <div class="col-sm-3 text-right">
                    <label class="control-label"> {{ResultNetpay | number :0}}</label>
                </div>
            </div>
        </div>

    </div>
    <div>
        <div id="GridSalaryDetails" ej-grid e-datasource="EmpSalaryInfoDefine"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel">
            <div e-columns>
                <div e-column e-field="SalaryHead" e-headertext="SalaryHead" e-width="50"></div>
                <div e-column e-field="HeadType" e-headertext="HeadType" e-width="80"></div>
                <div e-column e-field="EntryCurrency" e-headertext="EntryCurrency" e-width="70"></div>
                <div e-column e-field="EntryAmount" e-headertext="EntryAmount" e-width="70"></div>
            </div>
        </div>
    </div>
    <div class="row form-horizontal form-elements" id="EntryDiv">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="common-btn">
                <ul class="list-inline text-right">

                    @*<li> <button ng-click="saveData();" style="margin-right: 30px;" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Approved</button></li>*@

                </ul>
            </div>
        </div>

    </div>


</ej-dialog>
<ej-dialog id="dialogMessage" title="{{messageTitle}}" e-enablemodal="true" e-position-y="0" e-showoninit="false" e-target=".site-heading" e-close="onDialogClose" e-minwidth="50%" e-minheight="50" e-open="enableBtn">

    <div>
        {{messageText}}
    </div>
</ej-dialog>

<script>
    $(document).ready(function () {
        $("#accordion section h1").click(function (e) {
            if (!$(this).closest('section').hasClass('ac_hidden')) {
                $(this).closest("section").addClass("ac_hidden");
            } else {
                $(this).closest("section").siblings().addClass("ac_hidden");
                $(this).closest("section").removeClass("ac_hidden");
            }
            e.preventDefault();
        });
    });
</script>
