<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Tax Opening Balance
</h3>

<div class="form-elements form-horizontal" ng-form name="leaveApplicationNewForm">
    <div class="row">
        <div class="clearfix"></div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Tax Type</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProfessionalTaxOB.TaxTypeId" ng-change="GetDedInvest();GetDedInvestDed();GetTaxableIncomePara();GetIncomeTabValue();">
                            <option value=""></option>
                            <option ng-repeat="option in TaxTypeList" value="{{option.Id}}">{{option.Username}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Employee Select<sup>*</sup></label>
                <div class="input-group">
                    <div class="col-sm-2">
                        <span class="input-group-btn">
                            <button name="submit" ng-click="getPopUpData();" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div class=" col-md-6">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Emp. Code</label>
                    <label class="col-sm-6 control-label">{{leaveApplicationNew.EmployeeCode}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">Emp. Name</label>
                    <label class="col-sm-6 control-label">{{leaveApplicationNew.EmployeeName}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">Gender</label>
                    <label class="col-sm-6 control-label">{{leaveApplicationNew.GenderID}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">DOJ</label>
                    <label class="col-sm-6 control-label">{{leaveApplicationNew.DOJ}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">DOB</label>
                    <label class="col-sm-6 control-label">{{leaveApplicationNew.DOB}}</label>
                </div>

            </div>
            <div class=" col-md-6">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Department</label>
                    <label class="col-sm-6 control-label">{{leaveApplicationNew.Department}}</label>
                </div>
                <div class="form-group">
                    <br />
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">Tax Policy:</label>
                    <label class="col-sm-6 control-label">{{TaxPolicyName}}</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">Age:</label>
                    <label class="col-sm-6 control-label">{{DurationYear}} Year, {{DurationMonth}}  Month</label>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label">Designation</label>
                    <label class="col-sm-6 control-label">{{leaveApplicationNew.LegalDesignation}}</label>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Tax Year</label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select class="form-control" ng-model="ProfessionalTaxOB.TaxYearId" ng-change="TabShow();GetDedInvest();GetDedInvestDed();GetTaxableIncomePara();GetIncomeTabValue();">
                            <option value=""></option>
                            <option ng-repeat="option in YearList" value="{{option.TaxYearID}}">{{option.TaxYearName}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-8">
                    <div>
                        <img id="uploadImageSrc" ng-src="{{imageSrc}}" style="margin-left: 263px; border: 1px solid; height: 200px; width: 200px;" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" aria-controls="OB" role="tab" data-toggle="tab" ng-show="taxb == 0">Opening Balance</a></li>
                <li role="presentation" ng-class="{ active: isSet(3) }"><a ng-click="setTab(3)" aria-controls="DED" role="tab" data-toggle="tab">Deduction</a></li>
                <li role="presentation" ng-class="{ active: isSet(4) }"><a ng-click="setTab(4)" aria-controls="Inc" role="tab" data-toggle="tab">Income</a></li>
                <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" aria-controls="INV" role="tab" data-toggle="tab">Investment</a></li>
                <li role="presentation" ng-class="{ active: isSet(5) }"><a ng-click="setTab(5);" aria-controls="Tax" role="tab" data-toggle="tab">Taxable Income Para.</a></li>
            </ul>
        </div>

        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-show="taxb == 0">
                @*OB*@

                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Taxable Income</label>
                        <div class="col-sm-8 show-message">
                            <input type="text" onkeypress="return (event.charCode == 8 || event.charCode == 0) ? null : event.charCode >= 48 && event.charCode <= 57" ng-model="leaveApplicationNew.OpeningTaxableIncomeEarned" class="form-control" required tabindex="5" maxlength="50">
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="form-group" show-errors>
                        <label class="col-sm-4 control-label">Paid Tax</label>
                        <div class="col-sm-8 show-message">
                            <input type="text" onkeypress="return (event.charCode == 8 || event.charCode == 0) ? null : event.charCode >= 48 && event.charCode <= 57" ng-model="leaveApplicationNew.OpeningTaxPaid" class="form-control" required tabindex="5" maxlength="50">
                        </div>
                    </div>
                </div>

                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                    </ul>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                @*INV*@
                <div class="row">
                    <div class="table-responsive aplos-grid">
                        <div style="color:black;" id="Grid1" ej-grid e-datasource="InvestMentTax"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowSorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-headertext="Select" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="1"></div>
                                <div e-column e-field="TaxGroup" e-headertext="Tax Saving Group" e-width="8"></div>
                                <div e-column e-field="MaxLimit" e-headertext="TaxGroup MaxLimit" e-width="3"></div>
                                <div e-column e-field="TaxSavingItem" e-headertext="Tax Saving Item" e-width="5"></div>
                                <div e-column e-field="TaxSavingItemLimit" e-headertext="Tax Saving Item Limit" e-width="3"></div>
                                <div e-column e-field="Tax" e-headertext="Tax" e-width="2"></div>
                                <div e-column e-field="Taxable" e-headertext="Taxable" e-width="2"></div>
                                <div e-column e-template="#ValueT" e-headertext="Value" e-width="5"></div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveInvestment();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    </ul>
                </div>
                <script type="text/template" id="ValueT">
                    <input type="text" name="Value" ng-model="data.Value" class="form-control" required tabindex="5" maxlength="50">
                </script>

                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelect" />
                </script>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(3), active: isSet(3) }">
                @*DED*@
                <div class="row">
                    <div class="table-responsive aplos-grid">
                        @*IncTaxItmChildId*@
                        <div style="color:black;" id="Grid2" ej-grid e-datasource="DeductionTax"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowSorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-headertext="Select" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplatee" e-textalign="center" e-width="1"></div>
                                <div e-column e-field="TaxGroup" e-headertext="Tax Saving Group" e-width="6"></div>
                                <div e-column e-field="MaxLimit" e-headertext="TaxGroup MaxLimit" e-width="3"></div>
                                <div e-column e-field="TaxSavingItem" e-headertext="Tax Saving Item" e-width="5"></div>
                                <div e-column e-field="TaxSavingItemLimit" e-headertext="Tax Saving Item Limit" e-width="3"></div>
                                <div e-column e-field="Tax" e-headertext="Tax" e-width="2"></div>
                                <div e-column e-field="Taxable" e-headertext="Taxable" e-width="2"></div>
                                <div e-column e-field="Type" e-headertext="Type" e-width="2"></div>
                                <div e-column e-template="#Valuee" e-headertext="Value" e-width="3"></div>
                                <div e-column e-template="#Files" e-headertext="Attachment" e-width="5"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <script type="text/template" id="Valuee">
                    <input type="text" name="Value" ng-model="data.Value" class="form-control" required tabindex="5" maxlength="50">
                </script>
                <script type="text/template" id="checkboxTemplatee">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelect" />
                </script>
                <script type="text/template" id="Files">
                    @*<div class="form-group">
                            <div class="col-sm-8">
                                <div>
                                    <img id="uploadImageSrc" ng-src="{{data.imageSrc}}" />
                                </div>
                            </div>
                            <div class="inputBtnSection common-btn">
                                <label class="fileUpload col-sm-6">
                                    <input id="uploadImage" ng-file-select="onFileSelect($files)" type="file" name="uploadFile" class="upload" />
                                    <span class="uploadBtn"><i class="fa fa-paperclip" aria-hidden="true"> Upload</i></span>
                                </label>
                            </div>
                        </div>*@
                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-12 " >
                            <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" />
                        </label>
                        @*<input type="button" value="Import Data" class="btn btn-success" ng-click="ImportData()" />*@
                    </div>
                </script>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveDeduction();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    </ul>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(4), active: isSet(4) }">
                <div class="row">
                    <div class="table-responsive aplos-grid">
                        <div style="color:black;" id="Grid3" ej-grid e-datasource="IncomeTax"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowSorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-headertext="Select" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplateee" e-textalign="center" e-width="1"></div>
                                <div e-column e-field="TaxGroup" e-headertext="Tax Saving Group" e-width="8"></div>
                                <div e-column e-field="MaxLimit" e-headertext="TaxGroup MaxLimit" e-width="3"></div>
                                <div e-column e-field="TaxSavingItem" e-headertext="Tax Saving Item" e-width="5"></div>
                                <div e-column e-field="TaxSavingItemLimit" e-headertext="Tax Saving Item Limit" e-width="3"></div>
                                <div e-column e-field="Tax" e-headertext="Tax" e-width="2"></div>
                                <div e-column e-field="Taxable" e-headertext="Taxable" e-width="2"></div>
                                <div e-column e-field="Type" e-headertext="Type" e-width="5"></div>
                                <div e-column e-template="#ValueeT" e-headertext="Value" e-width="5"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveIncome();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    </ul>
                </div>
                <script type="text/template" id="ValueeT">
                    <input type="text" name="Value" ng-model="data.Value" class="form-control" required tabindex="5" maxlength="50">
                </script>
                <script type="text/template" id="checkboxTemplateee">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsSelect" />
                </script>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(5), active: isSet(5) }">
                <div class="row">
                    <div class="table-responsive aplos-grid">
                        <div style="color:black;" id="Grid3" ej-grid e-datasource="TaxableIncomePara"
                             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical" e-allowSorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
                            <div e-columns>
                                <div e-column e-headertext="Select" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplateTaxableIncomePara" e-textalign="center" e-width="1"></div>
                                <div e-column e-field="Descriptions" e-headertext="Descriptions" e-width="6"></div>
                                <div e-column e-field="Description" e-headertext="Description" e-width="3"></div>
                                <div e-column e-field="OptionBase" e-headertext="Option Base" e-width="3"></div>
                                <div e-column e-template="#templateValue" e-headertext="Value" e-width="5"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="SaveTaxableIncomeEx();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                    </ul>
                </div>
                <script type="text/template" id="templateValue">
                    <input type="text" name="Value" ng-model="data.Value" ng-disabled="data.IsEnable" class="form-control" required tabindex="5" maxlength="50">
                </script>
                <script type="text/template" id="checkboxTemplateTaxableIncomePara">
                    <input type="checkbox" e-id="{{data.TaxFormulaId}}" ej-checkbox class="rowCheckbox" e-checked="data.IsSelect" e-change="$parent.CheckValidation" />
                </script>
            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="Grid" ej-grid e-datasource="employee" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel" e-templaterefresh="refreshTemplateemployee">
                        <div e-columns>
                            <div e-column e-field="SystemID" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="DOJ" e-headertext="DOJ" e-width="80"></div>
                            <div e-column e-field="CutOffDate" e-headertext="CutOff Date" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmMasterPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteMaster();"></confirm-archive-generic>
