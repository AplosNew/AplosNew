<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Salary Advance Approval
</h3>
<div class="form-elements form-horizontal" ng-form name="salaryAdvanceApprovalNewForm">
    <input type="hidden" ng-model="salaryAdvanceApprovalNew.Id">
    <p style="text-decoration:underline;cursor:pointer;" ng-show="message==null" ng-click="showEntityPopUp();">My Entity List</p>
    <p class="msg-success" ng-show="message!=null">*{{message}}</p>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Plant<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="select-style">
                        <select id="PlantId" class="form-control" ng-model="salaryAdvanceApprovalNew.PlantId" name="Plant" required tabindex="1" ng-change="LoadData(salaryAdvanceApprovalNew.PlantId)">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in PlantList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-md-12">
            <div class="table-responsive modal-table aplos-grid-toggle">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th style="text-align:center">--Select--</th>
                            <th>Employee ID</th>
                            <th>Employee Name</th>
                            <th>Advance Amount</th>
                            <th>Paid Amount</th>
                            <th>Installment Amount</th>
                            <th>Installment Month</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr dir-paginate="x in salaryAdvanceApprovals |itemsPerPage:$root.pageSize" total-items="$root.total_count">
                            <td style="text-align:center">
                                <div class="checkbox-site">
                                    <input type="checkbox" ng-model="x.Active" ng-click="selectChValueId($event,x)">
                                </div>
                            </td>
                            <td>{{x.EmpInfoSystemID}}</td>
                            <td>{{x.EmployeeName}}</td>
                            <td>{{x.AdvanceAmount}}</td>
                            <td>{{x.PaidAmount}}</td>
                            <td>{{x.InstallmentAmount}}</td>
                            <td>{{x.InstallmentMonth}}</td>
                            <td>
                                <div class="select-style">
                                    <select class="form-control" ng-model="x.ApprovalStatus"
                                            ng-options="item.Value as item.Text for item in ApprovalList">
                                        <option></option>
                                    </select>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <dir-pagination-controls max-size="10"
                                         direction-links="true"
                                         boundary-links="true"
                                         on-page-change="getData(newPageNumber)">
                </dir-pagination-controls>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="common-btn" style="padding-right:17px;">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" ng-disabled="tempList.length===0" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            </ul>
        </div>
</div>
<div class="modal fade site-modal in" id="entityPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header"> My Entity List<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="table-responsive modal-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Entity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="x in entityList">
                                <td>{{x.Code}}</td>
                                <td>{{x.EntityName}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
