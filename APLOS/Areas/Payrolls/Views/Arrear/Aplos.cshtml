<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Arrear </h3>
<style>
    .glyphicon.fast-right-spinner {
        -webkit-animation: glyphicon-spin-r 1s infinite linear;
        animation: glyphicon-spin-r 1s infinite linear;
    }
</style>
<div class="form-elements form-horizontal">
   

    <div class="row">
        <div class="col-md-12" style="color:blue;font-weight:bold;">
            {{NotificationMessage}}
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-3 control-label">Description<sup>*</sup></label>
                <div class="col-sm-8" style="left:-15px;">
                    <input class="form-control" id="txtDescription" ng-model="Description" placeholder="Description" type="text" tabindex="2" maxlength="200" />
                </div>
            </div>
        </div>
        <div class="col-xs-12">
            <div class="col-sm-4" style="left:-10px;">
                <div class="form-group">
                    <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-change="CreateToDate()" ng-model="FromDate" datepicker class="form-control datepicker" tabindex="1">
                    </div>
                </div>
            </div>
            <div class="col-sm-4" style="left:-10px;">
                <div class="form-group">
                    <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input type="text" name="To Date" placeholder="dd-MM-yyyy" ng-model="ToDate" datepicker class="form-control datepicker" tabindex="1">
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2" style="text-align:left;padding-right:0px">
                <div class="common-btn">
                    <button ng-click="GetEmployeeInformation();" class="btn"> <i class="glyphicon glyphicon-refresh"></i> Load</button>
                </div>
            </div>
        </div>
        <hr />
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12 col-sm-12">
            <div class="col-md-4 col-sm-4">
            </div>
            <div class="col-md-4 col-sm-4">
            </div>
            <div class="col-md-4 col-sm-4">
                <div class="common-btn">
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-click="showEmployeeFilterScreen()" class="btn" tabindex="10"><i class="glyphicon glyphicon-filter"></i></button></li>
                        <li><button ng-click="clearManualFilter()" class="btn" tabindex="10"><i class="glyphicon glyphicon-refresh"></i></button></li>

                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-12">

            <div id="empInfoGrid" ng-init="chkinit()" ej-grid e-datasource="EmployeeListTemp" e-gridlines="vertical" e-templaterefresh="dataBoundemployee"
                 e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-pagesettings-pagesize="15">
                <div e-columns>

                    <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                    <div e-column e-type="string" e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="string" e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="string" e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="string" e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="string" e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="string" e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="string" e-field="SalaryRuleName" e-headertext="Salary Rule" e-allowediting="false" e-width="80"></div>
                    <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}"  e-field="LastSalaryEffectiveDate" e-headertext="Approved Effective Date" e-allowediting="false" e-width="100"></div>
                    <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}"  e-field="LatestSalaryEffectiveDate" e-headertext="Last Effective Date" e-allowediting="false" e-width="100"></div>
                    <div e-column e-type="string" e-field="LastLocked" e-headertext="Last Locked" e-allowediting="false" e-width="100"></div>
                    
                </div>
            </div>

            <script type="text/template" id="checkboxTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>

            <script type="text/x-jsrender" id="headerTemplate">
                <input type="checkbox" id="headchk" />
                @*<input type="checkbox" id="headchk" />*@
            </script>
            <div class="col-md-12 col-sm-12">
                <div class="common-btn">
                    <ul class="common-btn list-inline text-right">
                        <li><button ng-click="ProcessAll()" class="btn" tabindex="10"><i class="glyphicon glyphicon-ok"></i></button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <h4>Notes</h4>
            <p>* All salary structures should be approved before [To Date]</p>
            <p>* Salary structure must be assigned to selected employees</p>
            <p>* Salary must be processed</p>
            <p>* Salary must be approved and locked</p>
        </div>
    </div>
    <div class="modal fade site-modal in" id="empfilterPopUp" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header"> Select Employees<button type="button" class="close" data-dismiss="modal">&times;</button></div>

                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div class="content-container-fluid">

                        <div id="Gridemployee" ng-init="chkinit()" ej-grid e-datasource="EmployeeList" e-gridlines="vertical"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-pagesettings-pagesize="15" e-templaterefresh="dataBoundemployeed">
                            <div e-columns>

                                <div e-column e-headertext="" e-headertemplateid="#headerTemplatePOPUp" e-template="#checkboxTemplatePopUp" e-textalign="center" e-width="30"></div>
                                <div e-column e-type="string" e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="string" e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="string" e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="string" e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="string" e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="string" e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                                <div e-column e-type="string" e-field="SalaryRuleName" e-headertext="Salary Rule" e-allowediting="false" e-width="80"></div>

                            </div>
                        </div>


                    </div>

                    <script type="text/template" id="checkboxTemplatePopUp">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="data.isToBeSelect" e-checked="data.isToBeSelect" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplatePOPUp">
                        <input type="checkbox" id="headchkd" />
                    </script>
                </div>
                <ul class="common-btn list-inline text-right" style="padding: 20px;">
                    <li><button ng-click="saveemployeedata();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Submit</button></li>
                    <li><button ng-click="Back();" class="btn" tabindex="10"><i class="glyphicon glyphicon-info-sign right"></i> Back</button></li>
                </ul>

            </div>
        </div>
    </div>
</div>










