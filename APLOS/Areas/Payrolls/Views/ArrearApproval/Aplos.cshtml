<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> {{FormTitle}} </h3>
<style>
    .glyphicon.fast-right-spinner {
        -webkit-animation: glyphicon-spin-r 1s infinite linear;
        animation: glyphicon-spin-r 1s infinite linear;
    }
</style>
<div class="form-elements form-horizontal">
    <div class="row">
        <div class="col-xs-12">
            <div class="col-xs-4"><h3 class="site-heading"><span class="glyphicon glyphicon-file"></span>Salary Sheet vs Arrear</h3></div>
            <div class="col-md-8">
                <div class="col-md-12">
                    <div class="col-xs-6 col-sm-6 col-md-6">
                        <div class="col-md-12">
                            <input id="ddlYearList" e-watermarktext="Arrear Detail" ej-dropdownlist e-datasource="ArrearProcessInfo" e-enablefiltersearch="true" e-value="SelectedArrearProcessBatchId" e-fields-value="ArrearProcessBatchId" e-fields-text="ArrearDesc" e-width="100%" />
                        </div>
                    </div>

                    <div class="col-xs- col-sm-1 col-md-1">
                        <div class="form-group">
                            <div class="common-btn">
                                <button ng-click="GetEmployeeInformation();" class="btn"> <i class="glyphicon glyphicon-download"></i>Go</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-12 col-md-12 col-lg-12">
            <div class="site-tab">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="Element10" role="tab" data-toggle="tab">To Be Approved</a></li>
                    <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="Element20" role="tab" data-toggle="tab">Approved</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                    <div id="empInfoGridUnApproved" ng-init="chkinit()" ej-grid e-datasource="EmployeeListUnApproved" e-gridlines="vertical" e-templaterefresh="dataBoundemployee"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-pagesettings-pagesize="15">
                        <div e-columns>

                            <div e-column e-headertext="" e-headertemplateid="#headerTemplateUnApproved" e-template="#checkboxTemplateUnApproved" e-textalign="center" e-width="30"></div>
                            <div e-column e-type="string" e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                        </div>
                    </div>

                    <script type="text/template" id="checkboxTemplateUnApproved">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                    </script>

                    <script type="text/x-jsrender" id="headerTemplateUnApproved">
                        <input type="checkbox" id="headchk" />
                    </script>
                    <div class="col-md-12 col-sm-12">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-right">
                                <li><button ng-click="ProcessAll(true)" class="btn" tabindex="10"><i class="glyphicon glyphicon-ok"> Approve</i></button></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                    <div id="empInfoGridApproved" ng-init="chkinit()" ej-grid e-datasource="EmployeeListApproved" e-gridlines="vertical" e-templaterefresh="dataBoundemployee"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-pagesettings-pagesize="15">
                        <div e-columns>

                            <div e-column e-headertext="" e-headertemplateid="#headerTemplateApproved" e-template="#checkboxTemplateApproved" e-textalign="center" e-width="30"></div>
                            <div e-column e-type="string" e-field="EmployeeCode" e-headertext="Employee Code" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="EmployeeName" e-headertext="Employee Name" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="Division" e-headertext="Division" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="date" e-format="{0:dd-MMM-yyyy}" e-field="DOS" e-headertext="DOS" e-allowediting="false" e-width="80"></div>
                            <div e-column e-type="string" e-field="EmployeeStatus" e-headertext="EmployeeStatus" e-allowediting="false" e-width="80"></div>
                        </div>
                    </div>

                    <script type="text/template" id="checkboxTemplateApproved">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                    </script>

                    <script type="text/x-jsrender" id="headerTemplateApproved">
                        <input type="checkbox" id="headchk" />
                    </script>
                    <div class="col-md-12 col-sm-12">
                        <div class="common-btn">
                            <ul class="common-btn list-inline text-right">
                                <li><button ng-click="ProcessAll(false)" class="btn" tabindex="10"><i class="glyphicon glyphicon-ok"> Un Approve</i></button></li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>










