<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> {{FormTitle}}</h3>
<div class="form-horizontal form-elements">
    <div class="row">
        <div class="col-md-10">
            <div class="col-xs-2 col-sm-2 col-md-2">
                <div class="col-md-12">
                    <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-databound="SelectDefaultValue" e-value="year" e-enablefiltersearch="true" e-fields-value="Text" e-fields-text="Text" e-width="100%" e-change="CheckTable"/>

                </div>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <div class="col-md-12">
                    <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-enablefiltersearch="true" e-value="month" e-fields-value="Value" e-fields-text="Text" e-width="100%"  e-change="CheckTable"/>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">
                <div class="form-group">
                    <label class="col-sm-6 " style="font-weight:normal;">Regular<sup></sup></label>
                    <div class="col-sm-6">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="isActive" e-checked="isActive" e-model="isActive" e-change="CheckTable" />
                    </div>
                </div>
            </div>
            <div class="col-xs-2 col-sm-2 col-md-2">
                <div class="form-group">
                    <label class="col-sm-8" style="font-weight:normal;">Seperated<sup></sup></label>
                    <div class="col-sm-4">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="isSeperated" e-checked="isSeperated" e-model="isSeperated" e-change="CheckTable" />
                    </div>
                </div>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <div class="form-group">
                    <label class="col-sm-8" style="font-weight:normal;">Going Maternity<sup></sup></label>
                    <div class="col-sm-2">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="isMaternity" e-checked="isMaternity" e-model="isMaternity" e-change="CheckTable" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <div class="common-btn">
                    <button ng-click="getData();" class="btn"> <i class="glyphicon glyphicon-download"></i>Go</button>
                </div>
            </div>
        </div>
        <div class="col-lg-12" ng-show="Show">
            <div id="empInfoGrid" ej-grid e-datasource="GetList" e-allowscrolling="true" e-pageSettings-pageSize="10"
                 e-actioncomplete="actionCompleteSelected" e-templaterefresh="refreshTemplateemployee"
                 e-allowfiltering="true" e-allowpaging="true" e-enabletouch="false" e-responsive="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" style="margin-left:1%">
                <div e-columns>
                    <div e-column e-field="PaymentMode" e-headertext="Payment Mode" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="BankName" e-headertext="Bank Name" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="PlantName" e-headertext="Plant" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="Entity" e-headertext="Entity" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DepartmentName" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="DesignationName" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SectionName" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SubSectionName" e-headertext="Sub Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-allowediting="false" e-width="80"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="common-btn" ng-show="Show">
        <ul class="list-inline text-right">
            <li><button ng-click="GetReport();" class="btn"> <i class="glyphicon glyphicon-download"></i>Download Report</button></li>
        </ul>
    </div>
</div>
