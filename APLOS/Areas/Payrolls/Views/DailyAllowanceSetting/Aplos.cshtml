<ej-dialog id="dialogDesignation"
           title="{{messageTitle}}"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#siteheaders"
           e-minwidth="900" e-open="enableBtn">

    <div class="row" id="dvpopup">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="row">
                <div class="col-md-4 ">
                    <div class="radio option-input radio">
                        <label>
                            <input type="radio" name="EmployeeLoadType" ng-model="DesignationModel.DesignationType" value="all" ng-change="DesignationTypeChange()">
                            <span class="cr"><i class="cr-icon"></i></span>All
                        </label>
                        <label>
                            <input type="radio" name="EmployeeLoadType" ng-model="DesignationModel.DesignationType" value="Selected" ng-change="DesignationTypeChange()">
                            <span class="cr"><i class="cr-icon"></i></span>Selected Designation
                        </label>
                    </div>
                </div>

                <div class="col-md-4 ">
                    <div class="radio option-input radio">
                        <label>
                            <input type="radio" name="EmployeeLoadCType" ng-model="DesignationModel.DesignationCatagory" value="Fixed" ng-change="DesignationCatagoryChange()">
                            <span class="cr"><i class="cr-icon"></i></span>Fixed
                        </label>
                        <label>
                            <input type="radio" name="EmployeeLoadCType" ng-model="DesignationModel.DesignationCatagory" value="Formula" ng-change="DesignationCatagoryChange()">
                            <span class="cr"><i class="cr-icon"></i></span>Formula
                        </label>
                    </div>
                </div>


                @*<div class="col-md-2 ">
                        <div class="form-group text-right">
                            <label class="col-sm-4 control-label text-right">Fixed </label>
                            <div class="col-sm-8 show-message">
                                <input type="checkbox" ng-model="DesignationModel.IsFixed" ej-checkbox class="rowCheckbox" e-checked="DesignationModel.IsFixed" e-change="DesignationIsFixedChange" />
                            </div>
                        </div>

                    </div>*@
                <div class="col-md-4">
                    <div ng-show="DesignationModel.IsFixed">
                        <div class=" col-sm-8">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Rate </label>
                                <div class="col-sm-8">
                                    <input class="form-control" ng-model="DesignationModel.Rate" maxlength="250" tabindex="6" />
                                </div>
                            </div>
                        </div>
                        <div class=" col-sm-4">
                            <div class="common-btn">
                                <ul class="list-inline text-right">
                                    <li> <button ng-click="DesignationRateSet();" ng-show="SelectedDesignationShow" style="margin-right: 3px;" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Set</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div ng-show="!DesignationModel.IsFixed">
                        <div class=" col-sm-8">
                            <label class="control-label">{{AllDesignationFormulaShow}}</label>
                        </div>
                        <div class=" col-sm-3">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="OpendialogFormula();" style="margin-right: 3px;" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Formula</button></li>
                                </ul>
                            </div>
                        </div>
                        <div class=" col-sm-1">

                        </div>
                    </div>

                </div>


            </div>



        </div>
        <div class="col-xs-12 col-sm-12 col-sm-12" ng-show="SelectedDesignationShow">

            <div style="color:black;"
                 id="GridDesignation"
                 ej-grid e-datasource="DailyAllowanceRateList"
                 e-templaterefresh="refreshTemplateemployee5"
                 e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>
                    <div e-column e-field="Id" e-headertext="Id" e-width="100" e-visible="false" e-primarykey="true"></div>
                    <div e-column e-headertext="All" e-headertemplateid="#headerTemplate5" e-template="#checkboxTemplate5" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="DesignationGroup" e-headertext="Designation Group" e-width="100"></div>
                    <div e-column e-field="DesignationName" e-headertext="Designation" e-width="100"></div>
                    <div e-column e-field="Category" e-headertext="Category" e-width="80"></div>
                    @*<div e-column e-headertext="Fixed" e-template="#IsRateTemplate" e-textalign="center" e-width="30"></div>*@
                    <div e-column e-headertext="Rate" e-template="#RateTemplate" e-textalign="center" e-width="80"></div>
                    @*<div e-column e-headertemplateid="#headerTemplateFormula" e-template="#checkboxTemplateFormula" e-textalign="center" e-width="80"></div>*@
                    <div e-column e-field="FormulaDescription" e-headertext="Formula" e-width="100"></div>
                    <div e-column e-field="Status" e-headertext="Status" e-width="80"></div>
                    <div e-column e-field="LegalDesignation" e-headertext="LegalDesignation" e-width="100"></div>
                    <div e-column e-width="50">
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon  glyphicon-th-list" ng-click="$parent.OpendialogLegalDesignationDetails($event);" style="margin: -6px;"></i></button>
                    </div>
                    <div e-column e-headertext="Actions" e-width="70">
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-refresh" ng-click="$parent.removeRate($event);" style="margin: -6px;"></i></button>
                    </div>
                </div>
            </div>
            <script type="text/template" id="checkboxTemplate5">

                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" e-change="$parent.DesignationIsFixedChange($event);" />
            </script>
            <script type="text/x-jsrender" id="headerTemplate5">
                <input type="checkbox" id="headchk5" />

            </script>

            <script type="text/template" id="IsRateTemplate">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.IsFixed" />
            </script>

            <script type="text/template" id="RateTemplate">
                <div class="col-sm-12" style="padding:0px; height:23px;">
                    <input type="text" ng-model="data.Rate" style="color:black;" ng-disabled="DesignationModel.IsFixed" class="form-control" />

                </div>

            </script>

            <script type="text/template" id="checkboxTemplateFormula">
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>
            <script type="text/x-jsrender" id="headerTemplateFormula">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-plus" ng-click="$parent.remove($event);" style="margin: -6px;"> Formula</i></button>

            </script>

        </div>
        <div class="col-xs-12 col-sm-12 col-md-12 ">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="SaveDailyAllowanceRateData();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                </ul>
            </div>
        </div>
    </div>

</ej-dialog>

