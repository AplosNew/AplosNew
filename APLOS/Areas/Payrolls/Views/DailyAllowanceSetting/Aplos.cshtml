<togglable name="Allowance Daily Setting"></togglable>
<div class="form-elements form-horizontal" ng-form name="bloodGroupNewForm">
    <input type="hidden" ng-model="bloodGroupNew.Id">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="number" name="Sequence" ng-model="bloodGroupNew.Sequence" class="form-control" required tabindex="1">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Short Name" ng-model="bloodGroupNew.ShortName" class="form-control" maxlength="3" required tabindex="3">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="User Name" ng-model="bloodGroupNew.UserName" class="form-control" required tabindex="5" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Salary Head<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="SH" ng-model="bloodGroupNew.SalaryHeadId" class="form-control" name="Salary Rule" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="7"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="bloodGroupNew.Description" tabindex="9" maxlength="250"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Voucher Payment</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="bloodGroupNew.IsVoucherPayment" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">From Effective Date</label>
            <div class="col-sm-8">
                <input type="text" maxlength="15" name="ShortName" ng-model="bloodGroupNew.FromEffectiveDate" datepicker placeholder="dd-MMM-yyyy" class="form-control" required tabindex="11">

            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Code<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Code" ng-model="bloodGroupNew.Code" class="form-control" required tabindex="2" maxlength="10">
            </div>
        </div>
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Standard Name" ng-model="bloodGroupNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="3" ng-model="bloodGroupNew.Remarks" maxlength="250" tabindex="6"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="bloodGroupNew.Active" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">

            <label class="col-sm-4 control-label">Rate Based On Salary Range</label>
            <div class="col-sm-1">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="bloodGroupNew.IsRateBasedOnSalaryRange" tabindex="8" ng-change="RateBasedOnSalaryRangeChange()">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
            <label ng-show="ShowSalaryRangeBasedOnSalaryHeadId" class="col-sm-2 control-label">Salary Head</label>
            <div class="col-sm-5" ng-show="ShowSalaryRangeBasedOnSalaryHeadId">
                <div class="select-style">
                    <select id="SH" ng-model="bloodGroupNew.SalaryRangeBasedOnSalaryHeadId" class="form-control" name="Salary Rule" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="7"></select>
                </div>
            </div>


        </div>
        <div class="form-group">
            <label class="col-sm-8 control-label" style="font-size:smaller; color:blue; text-align:right">{{CatagoryChangeMesssage}}</label>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Catagory <sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="bloodGroupNew.Catagory" name="Catagory" tabindex="10" ng-change="CatagoryChange()">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in DailyAllowanceCatagoryList" value="{{option.Value}}">{{option.Text}}</option>
                        @*<option value="HourlyOffDuty">Hourly OffDuty</option>
                            <option value="DailyAllowanceTimeBased">Daily Allowance Time Based</option>
                            <option value="WeekOffAllowance">Week Off Allowance</option>
                            <option value="HolidayAllowance">Holiday Allowance</option>
                            <option value="HourlyOffDutyDeduction">Hourly Off Duty Deduction</option>*@
                        @*<option value="Formula">Formula</option>*@
                    </select>
                </div>
            </div>
        </div>




        <div class="form-group">
            <label class="col-sm-4 control-label">To Effective Date</label>
            <div class="col-sm-8">
                <input type="text" maxlength="15" name="ShortName" ng-model="bloodGroupNew.ToEffectiveDate" datepicker placeholder="dd-MMM-yyyy" class="form-control" required tabindex="12">

            </div>
        </div>
    </div>

    <br />
    <br />
    <div class="col-sx-12">
        <div ng-show="ShowFormulaDiv===true">
            <div class="col-sm-6" ng-show="true">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Catagory <sup>*</sup></label>
                    <div class="col-sm-8">

                    </div>
                </div>

            </div>
            <div class="col-sm-6" ng-show="true"></div>
            <div class="col-sm-12" ng-show="true" style="margin-left:-20px;padding-top:20px">


                <fieldset class="scheduler-border" style="width:1076px">
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Salary Head</label>
                            <div class="col-sm-6">
                                <div class="select-style">
                                    <select ng-model="salaryRuleGeneral.SalaryHeadIdFormula" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in salaryHeadList">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('SHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Operator</label>
                            <div class="col-sm-6">

                                <div class="select-style">
                                    <select ng-model="salaryRuleGeneral.Operator" class="form-control" name="Operator">
                                        <option value=""></option>
                                        <option value="*">*</option>
                                        <option value="/">/</option>
                                        <option value="+">+</option>
                                        <option value="-">-</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('Operator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Precedence</label>
                            <div class="col-sm-6">
                                <div class="select-style">
                                    <select ng-model="salaryRuleGeneral.Precedence" class="form-control" name="Precedence" tabindex="5">
                                        <option value=""></option>
                                        <option value="(">(</option>
                                        <option value=")">)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('Precedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Value</label>
                            <div class="col-sm-6">
                                <input type="text" name="Value" ng-model="salaryRuleGeneral.Value" class="form-control" required tabindex="2" maxlength="50">
                            </div>
                            <div class="col-sm-2">
                                <div class="common-btn">
                                    <ul class="list-inline text-left">
                                        <li> <button ng-click="SetFormula('Value');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">

                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li> <button ng-click="RemoveFormula();" class="btn" tabindex="9"><i class="glyphicon glyphicon-backward"></i></button></li>
                            </ul>
                        </div>
                        <div class="form-group">
                            {{salaryRuleGeneral.FormulaDescription}}
                        </div>
                    </div>
                </fieldset>
            </div>

        </div>
    </div>

    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="table-responsive modal-table aplos-grid-toggle" id="siteheaders">
    <div style="color:black;"
         id="GridDailyAllowanceList"
         ej-grid e-datasource="DailyAllowanceList"
         e-recorddoubleclick="Get"
         e-gridlines="vertical"
         e-allowfiltering="true"
         e-allowpaging="true"
         e-allowsorting="true"
         e-allowselection="true"
         e-filtersettings-filterType="excel"
         e-allowtouch="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="50" e-visible="false" e-primarykey="true"></div>
            @*<div e-column e-field="Sequence" e-headertext="Sequence" e-width="100"></div>*@
            <div e-column e-field="Code" e-headertext="Code" e-width="50"></div>
            @*<div e-column e-field="ShortName" e-headertext="Short Name" e-width="55"></div>
                <div e-column e-field="StandardName" e-headertext="StandardName" e-width="50"></div>*@
            <div e-column e-field="UserName" e-headertext="Name" e-width="50"></div>
            <div e-column e-field="Catagory" e-headertext="Catagory" e-width="100"></div>
            <div e-column e-field="FromEffectiveDate" e-headertext="From Date" e-width="50"></div>
            <div e-column e-field="ToEffectiveDate" e-headertext="To Date" e-width="50"></div>

            <div e-column e-template="#checkboxTemplateIsActive" e-headertext="Active" e-width="100"></div>
            <div e-column e-headertext="Designation" e-width="70">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px; display:{{data.IsRateBasedOnSalaryRange==true ? 'none' : 'inherit'}}" class="btn"><i class="glyphicon glyphicon-plus" ng-click="$parent.OpendialogDesignation($event);" style="margin: -6px;"></i></button>
            </div>
            <div e-column e-headertext="Shift" e-width="70">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px; display:{{data.Catagory=='HourlyOffDuty'|| data.Catagory=='HourlyOffDutyDeduction'? 'none' : 'inherit'}}" class="btn">
                    <i class="glyphicon glyphicon-plus" ng-click="$parent.OpendialogShift($event);" style="margin: -6px;"></i>
                </button>
            </div>
            <div e-column e-headertext="Salary" e-width="70">
                <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px; display:{{data.IsRateBasedOnSalaryRange==false ? 'none' : 'inherit'}}" class="btn"><i class="glyphicon glyphicon-plus" ng-click="$parent.OpendialogSalaryRange($event);" style="margin: -6px;"></i></button>
            </div>
            <div e-column e-headertext="Additional Policy" e-width="70">
                <button class="btn"><i class="glyphicon glyphicon-plus" ng-click="$parent.OpendialogAdditionalPolicy($event);" style="margin: -6px;"></i></button>
            </div>
        </div>
    </div>
    <script type="text/template" id="checkboxTemplateIsActive">

        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Active" />
    </script>


</div>
