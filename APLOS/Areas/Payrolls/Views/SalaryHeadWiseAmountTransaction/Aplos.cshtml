
<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Salary Head Wise Amount Transaction
</h3>

<div class="row form-elements">


    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee Code<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" min="1" name="Sequence" ng-model="EmployeeModel.EmployeeCode" class="form-control" ng-disabled="true" required tabindex="1">

            </div>
            <div class="col-sm-2 show-message" style="margin-left:0px;padding-left:0px">

                <button style="color: #f3f3ec;background-color: #1c1f32; " class="btn"><i class="glyphicon glyphicon-search" ng-click="LoadEmployeeList()" style="margin: -4px;"></i></button>
            </div>
        </div>





    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">


        <div class="form-group">
            <label class="col-sm-4 control-label">Allowance Component<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="CustomModel.SalaryHeadWiseAmountSettingId" name="Legal Designation" tabindex="1" ng-change="GetSalaryHeadWiseAmountSettingDetails()">
                        <option value=""> </option>
                        <option ng-repeat="option in SalaryHeadWiseAmountSettinglist" value="{{option.Id}}">{{option.AllowanceComponent}}</option>
                    </select>

                </div>

            </div>
        </div>


    </div>
</div>

