<togglable name="Daily Allowance Rate Setting"></togglable>
<div class="form-elements form-horizontal" ng-form name="restNewForm">
    <div class="clearfix"> </div>

    <div class="row form-horizontal form-elements">


        <div class="col-xs-12 col-sm-5 col-md-5 ">



            <div class="form-group">
                <label class="col-sm-4 control-label">Allowance<sup>*</sup></label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select class="form-control" ng-model="DailyAllowanceType" name="DailyAllowanceType" tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in AllowanceList" value="{{option.id}}">{{option.UserName}}</option>
                        </select>
                    </div>
                </div>
            </div>

        </div>
        <div class="col-xs-12 col-sm-5 col-md-5 ">



        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">

        </div>


    </div>
    <div class="row form-horizontal form-elements">
        <div class="col-xs-12 col-sm-12 col-md-12 ">


            <div id="GridShiftInfo" ej-grid
                 e-datasource="ShiftInfoList"
                 
                 e-templaterefresh="refreshTemplateemployee4"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-enabletouch="true"
                 e-responsive="true"
                 e-allowselection="true"
                 e-filtersettings-filterType="excel">
                <div e-columns>
                    <div e-column @*e-headertext="All" e-headertemplateid="#headerTemplate4"*@ e-template="#checkboxTemplate4" e-textalign="center" e-width="30"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-width="100" e-primarykey="true"></div>               


                    <div e-column e-template="#Rate" e-headertext="Rate" e-width="55"></div>
                  
                </div>
            </div>
            <script type="text/template" id="checkboxTemplate4">
                @*<input type="checkbox" ng-model="data.WorkDate" class="rowCheckbox" enabled="data.IsLock" value="WorkDate" />*@
                <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
            </script>
            <script type="text/x-jsrender" id="headerTemplate4">
                <input type="checkbox" id="headchk4" />
            </script>
            <script type="text/template" id="Rate">
                <div class="col-sm-10" style="padding:0px; width:100%;height:20px;">
                    <input type="text" ng-model="data.Rate" style="color:black;" class="form-control"  />
                    @*<input type="text" ej-timepicker e-value="data.InTime" e-width="100%" />*@
                </div>
            </script>
            

        </div>
    </div>
    <br />
    <div class="row form-horizontal form-elements">


        <div class="col-xs-12 col-sm-5 col-md-5 ">
        </div>
        <div class="col-xs-12 col-sm-5 col-md-5 ">



        </div>
        <div class="col-xs-12 col-sm-2 col-md-2">
            <div class="common-btn">
                <ul class="list-inline text-left">
                    <li> <button ng-click="SaveDailyAllowanceData();" style="margin-right: 3px;" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
                </ul>
            </div>
        </div>


    </div>


    <div class="clearfix"></div>

</div>
<div class="row text-right aplos-grid-toggle" id="dvpopup">
    <div class="col-xs-12 col-sm-12 col-sm-12">
       
        <div style="color:black;" id="GridShiftInfoShow" ej-grid e-datasource="DailyAllowanceRateList" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
              e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="100" e-visible="false" e-primarykey="true"></div>

                <div e-column e-field="AllowanceType" e-headertext="AllowanceType" e-width="100"></div>
                <div e-column e-field="EmployeeCategory" e-headertext="EmployeeCategory" e-width="100"></div>
                <div e-column e-field="Rate" e-headertext="Rate" e-width="50"></div>
               
                <div e-column e-headertext="Actions" e-width="70">
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.remove($event);" style="margin: -6px;"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>




<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>
