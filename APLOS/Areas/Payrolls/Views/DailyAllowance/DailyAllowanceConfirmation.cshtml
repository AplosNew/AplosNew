            <label class="col-sm-4 control-label">Allowance<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="CustomPara.salaryHeadId" name="DailyAllowanceType" tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in AllowanceList" value="{{option.SalaryHeadId}}">{{option.UserName}}</option>
                    </select>
                </div>
            </div>
        </div>

    </div>
    <div class="col-xs-12 col-sm-5 col-md-5 ">



    </div>
