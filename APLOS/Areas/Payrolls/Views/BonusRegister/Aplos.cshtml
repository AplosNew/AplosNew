<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Bonus Register</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="assign" role="tab" data-toggle="tab">Salary Top Sheet</a></li>
            </ul>
        </div>
        <div class="tab-content">

            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                <div class="row">
                    <div class="form-elements form-horizontal" ng-form="modelForm">
                        <div class="col-md-12">
                            <div class="col-xs-4 col-sm-3 col-md-3">
                                <div class="form-group">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label">Year<sup>*</sup></label>
                                        <div class="col-sm-7">
                                            <div class="select-style">
                                                <select id="YearId" class="form-control" ng-model="year" name="YearId" required tabindex="1">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="option in yearList" value="{{option.Text}}">{{option.Text}}</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-4 col-sm-3 col-md-3">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Month<sup>*</sup></label>
                                    <div class="col-sm-8">
                                        <select name="selectIndex" ej-dropdownlist class="e-ddl" id="optIndexChange" e-change="getSalaryProcessIdList" e-width="107px" e-watermarktext="..select..">
                                            <option value="">--Select--</option>
                                            <option Value="01">Jan</option>
                                            <option Value="02">Feb</option>
                                            <option Value="03">Mar</option>
                                            <option Value="04">Apr</option>
                                            <option Value="05">May</option>
                                            <option Value="06">Jun</option>
                                            <option Value="07">Jul</option>
                                            <option Value="08">Aug</option>
                                            <option Value="09">Sep</option>
                                            <option Value="10">Oct</option>
                                            <option Value="11">Nov</option>
                                            <option Value="12">Dec</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-4 col-sm-3 col-md-3">
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Payment Mode</label>
                                    <div class="col-sm-8">
                                        <select name="selectIndex" ej-dropdownlist class="e-ddl" id="optIndexChange" e-change="onActiveIndexChange" e-width="107px" e-watermarktext="..select..">
                                            <option value="Bank">Bank</option>
                                            <option value="Check">Check</option>
                                            <option value="Cash">Cash</option>
                                            <option value="Transfer">Transfer</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li><button style="margin-left: 5px;" ng-click="GetSalaryTopRegistrar();" class="btn"><i class="glyphicon glyphicon-download"></i> Download</button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="loader" data-loader>
        Please wait
        <div class="bounce1"></div>
        <div class="bounce2"></div>
        <div class="bounce3"></div>
    </div>

</div>
