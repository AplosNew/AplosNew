<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Provident Fund Statements</h3>
<div class="row">
    <div class="col-xs-12">
        <div class="col-md-12">
            <div class="col-xs-3 col-sm-3 col-md-3">
                <div class="col-md-12">
                    <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-model="year" e-enablefiltersearch="true" e-fields-value="Text" e-fields-text="Text" e-width="100%" />
                </div>
            </div>
            <div class="col-xs-3 col-sm-2 col-md-3">
                <div class="col-md-12">

                    <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-enablefiltersearch="true" e-model="month" e-fields-value="Value" e-fields-text="Text" e-change="getSalaryProcessIdList" e-width="100%" />
                </div>
            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <div class="form-group">
                    <label class="col-sm-4 ">Active<sup></sup></label>
                    <div class="col-sm-8">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="isActive" e-checked="isActive" />

                    </div>
                </div>

            </div>
            <div class="col-xs-3 col-sm-3 col-md-3">
                <div class="form-group">
                    <label class="col-sm-4">Seperated<sup></sup></label>
                    <div class="col-sm-8">
                        <input type="checkbox" ej-checkbox class="nodetext" e-value="isSeperated" e-checked="isSeperated" />
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="col-md-12">
            <div class="col-md-5">
                <div class="form-group ">
                    <button ng-click="GetSalaryPaymentStatement('BANK');" class="btn"> <i class="glyphicon glyphicon-download"></i>Download</button>
                </div>

            </div>
            <div class="col-md-2"></div>
            <div class="col-md-5"></div>

        </div>
        
    </div>
</div>
