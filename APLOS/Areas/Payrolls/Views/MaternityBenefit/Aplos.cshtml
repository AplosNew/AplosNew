                                </div>
                            </script>

                            <script type="text/template" id="totalearnedamount">
                                <div class="col-sm-10" style="padding:0px; width:100px;height:20px;">
                                    <input type="text" ng-model="data.TotalEarnedAmount" disabled style="color:black;" class="form-control" />
