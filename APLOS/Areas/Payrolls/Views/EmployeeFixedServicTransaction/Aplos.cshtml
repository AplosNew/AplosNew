
<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Employee Fixed Service Transaction
</h3>

<div class="row form-elements">


    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Employee Code<sup>*</sup></label>
            <div class="col-sm-6 show-message">
                <input type="text" min="1" name="Sequence" ng-model="EmployeeModel.EmployeeCode" class="form-control" ng-disabled="true" required tabindex="1">

            </div>
            <div class="col-sm-2 show-message" style="margin-left:0px;padding-left:0px">

                <button style="color: #f3f3ec;background-color: #1c1f32; " class="btn"><i class="glyphicon glyphicon-search" ng-click="LoadEmployeeList()" style="margin: -4px;"></i></button>
            </div>
        </div>





    </div>
    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">


        <div class="form-group">
            <label class="col-sm-4 control-label">Servic Component<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select class="form-control" ng-model="SalaryHeadWiseAmountTransactionModel.EmployeeFixedServicId" name="Legal Designation" tabindex="1">
                        <option value=""> </option>
                        <option ng-repeat="option in SalaryHeadWiseAmountSettinglist" value="{{option.Id}}">{{option.ServicComponent+' ('+option.DurationType+')'}}</option>
                    </select>

                </div>

            </div>
        </div>


    </div>
</div>

<div class="row form-elements">




    <div class="col-md-3 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Effective Date</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="15" name="ShortName" ng-model="SalaryHeadWiseAmountTransactionModel.EffectiveDate" datepicker placeholder="dd-MMM-yyyy" class="form-control" required tabindex="3">
            </div>
        </div>
    </div>

    <div class="col-md-2 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Amount<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="15" name="ShortName" ng-model="SalaryHeadWiseAmountTransactionModel.Amount" class="form-control" required tabindex="3">
            </div>
        </div>
    </div>


    <div class="col-md-2 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Particulars</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="15" name="ShortName" ng-model="SalaryHeadWiseAmountTransactionModel.Particulars" class="form-control" required tabindex="3">
            </div>
        </div>
    </div>
    <div class="col-md-3 form-horizontal">
        <div class="form-group">
            <label class="col-sm-4 control-label">Remarks</label>
            <div class="col-sm-8 show-message">
                <input type="text" maxlength="15" name="ShortName" ng-model="SalaryHeadWiseAmountTransactionModel.Remarks" class="form-control" required tabindex="3">
            </div>
        </div>
    </div>
    <div class="col-md-2 form-horizontal">
        
        <div class="form-group">
            <label class="col-sm-4 control-label">Active</label>
            <div class="col-sm-8">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="SalaryHeadWiseAmountTransactionModel.Active" tabindex="8">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12 form-horizontal">
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li><button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> {{Action}}</button></li>
                <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="9"></i>  Clear</button></li>
            </ul>
           
        </div>
    </div>

</div>




























<div class="row">
    <div class="col-xs-12 col-sm-12 col-sm-12">

        <div style="color:black;"
             id="GridSalaryHeadWiseAmountTransactionList"
             e-recorddoubleclick="Edit"
             ej-grid e-datasource="SalaryHeadWiseAmountTransactionList"
             e-gridlines="vertical"
             e-allowfiltering="true"
             e-allowpaging="true"
             e-allowsorting="true"
             e-allowselection="true"
             e-pagesettings-pagesize="25"
             e-filtersettings-filterType="excel" e-allowtouch="true">
            <div e-columns>
                <div e-column e-field="EffectiveDate" e-headertext="Effective Date" e-width="50"></div>
                <div e-column e-field="ServicComponent" e-headertext="Servic Component" e-width="50"></div>
                <div e-column e-field="Amount" e-headertext="Amount" e-width="80"></div>
                <div e-column e-field="Particulars" e-headertext="Particulars" e-width="80"></div>
                <div e-column e-field="Remarks" e-headertext="Remarks" e-width="80"></div>
                @*<div e-column e-field="Active" e-headertext="Active" e-width="80"></div>*@
                @*<div e-column e-headertext="Actions" e-width="15">
                    <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn" ng-click="$parent.remove($event);"><i class="glyphicon glyphicon-trash" tabindex="9"></i></button>
                </div>*@
            </div>
        </div>
    </div>
</div>


<ej-dialog id="dialogEmployeeInfo"
           title=" Employee Information"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target=".site-heading"
           e-close="onDialogClose"
           e-minwidth="95%"
           e-minheight="500" e-open="enableBtn">
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">

            <div style="color:black;"
                 id="GridEmployeeInfoList"
                 e-recorddoubleclick="SelectEmployee"
                 ej-grid e-datasource="EmployeeInformationList"
                 e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowselection="true"
                 e-pagesettings-pagesize="25"
                 e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>
                    <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>

                    <div e-column e-field="DOJ" e-headertext="DOJ" e-width="70"></div>
                    @*<div e-column e-field="DOS" e-headertext="DOS" e-width="70"></div>*@
                    @*<div e-column e-field="DOBs" e-headertext="DOB" e-width="70"></div>*@
                    <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                    @*<div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>*@

                    <div e-column e-field="EntityName" e-headertext="Entity" e-width="80"></div>

                    @*<div e-column e-field="DesignationGroupName" e-headertext="Designation Group" e-width="80"></div>*@
                    @*<div e-column e-field="CellPhnNo" e-headertext="Cell No" e-width="80"></div>*@
                    @*<div e-column e-field="PayRollGroupName" e-headertext="Payroll Group" e-width="80"></div>
                        <div e-column e-field="ApprovedStatus" e-headertext="Status" e-width="60"></div>*@
                </div>
            </div>
        </div>
    </div>

</ej-dialog>



<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="Delete();"></confirm-archive-generic>