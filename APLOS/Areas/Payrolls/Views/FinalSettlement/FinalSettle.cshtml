<h3 class="site-heading"><span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Final Settlement</h3>
<div class="tab-design">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1);LoadAllFinalSettlementList();" href="" aria-controls="FNF" role="tab" data-toggle="tab">Final Settlement</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2);getApprovedData();" href="" aria-controls="Purchase" role="tab" data-toggle="tab">Approved</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }" ng-form="tabForm1" id="Sales">
            <togglable name="Final Settlement"></togglable>
            <div class="form-elements" ng-form id="FinalSettlement" name="FinalSettlementForm">
                <div class="row"></div>
                <div class="row">
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Final Settlement Name<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="100" name="Final Settlement Name" ng-model="FinalSettlementModel.FinalSettlementName" class="form-control" required tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Approved By<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="select-style">
                                    <select id="ApprovedBy" class="form-control" name="ApprovedBy" ng-model="FinalSettlementModel.ApproveById" tabindex="8" required>
                                        <option ng-repeat="option in approvedByList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="common-btn">
                            <ul class="list-inline text-left">
                                <li><button ng-click="LoadEmployeeList();" ng-disabled="FinalSettlementModel.IsApproved==true" class="btn"><i class="glyphicon glyphicon-search" tabindex="9"></i> Add Employee</button></li>
                            </ul>
                        </div>

                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6 form-horizontal">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Final Settlement Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" maxlength="15" name="Final Settlement Date" ng-model="FinalSettlementModel.FinalSettlementDate" datepicker placeholder="dd-MMM-yyyy" class="form-control" required tabindex="3">
                            </div>
                        </div>

                    </div>
                </div>
                <hr />
                <div clas="row">
                    <div id="GridSelectedEmp" ej-grid e-datasource="SelectedEmployeeList" e-templaterefresh="refreshTemplateEmp"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplateEmp" e-template="#checkboxTemplateEmp" e-textalign="center" e-width="30"></div>
                            <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="50"></div>
                            <div e-column e-field="EmpSystemId" e-headertext="EmpSystemId" e-width="50"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="DOJ" e-type="date" e-format="{0:dd-MMM-yyyy}" e-headertext="DOJ" e-width="70"></div>
                            <div e-column e-field="DOS" e-type="date" e-format="{0:dd-MMM-yyyy}" e-headertext="DOS" e-width="70"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                            <div e-column e-field="DesignationGroup" e-headertext="Designation Group" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                        </div>
                        <script type="text/template" id="ShowActionButtons">
                            <button style="color: #f3f3ec;background-color: #1c1f32;" ng-hide="data.Id==null" title="Items" class="btn"><i class="glyphicon glyphicon-list" ng-click="$parent.GetEmployeeItems(this);" style="margin: -6px;"></i></button>
                            <button style="color: #f3f3ec;background-color: #1c1f32;" ng-disabled="FinalSettlementModel.IsApproved==true" title="Remove" class="btn"><i class="glyphicon glyphicon-trash" ng-click="$parent.RemoveEmployee(this);" style="margin: -6px;"></i></button>
                            <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.PrintData(this);" style="margin: -6px;"></i></button>
                        </script>
                        <script type="text/template" id="checkboxTemplateEmp">
                            <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.State" />
                        </script>
                        <script type="text/x-jsrender" id="headerTemplateEmp">
                            <input type="checkbox" id="headchkEmp" />
                        </script>
                    </div>
                    <div class="common-btn" ng-show="SelectedEmployeeList.length>0">
                        <ul class="list-inline text-right">
                            <li><button ng-click="Process();" ng-disabled="FinalSettlementModel.IsApproved==true" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Process</button></li>
                            <li><button ng-click="Clear();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="9"></i> Clear</button></li>
                        </ul>
                    </div>

                </div>

            </div>

            <div class="row aplos-grid-toggle">
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div style="color:black;" id="GridFinalSettlementList" ej-grid e-datasource="FinalSettlementList" e-recorddoubleclick="SelectEmpDetail"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="80"></div>
                            <div e-column e-field="FinalSettlementName" e-headertext="Name" e-width="100"></div>
                            <div e-column e-field="FinalSettlementDate" e-type="date" e-format="{0:dd-MMM-yyyy}" e-headertext="Final Settlement Date" e-width="80"></div>
                            <div e-column e-field="ApproveBy" e-headertext="ApproveBy" e-width="80"></div>
                            <div e-column e-field="ApproveStatus" e-headertext="Approve Status" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }" ng-form="tabForm2" id="Approved">

            <div class="row">
                <div class="col-xs-12 col-sm-12 col-sm-12">
                    <div style="color:black;" id="GridFFS" ej-grid e-datasource="ApprovedFinalSettlementList"  e-recorddoubleclick="SelectEmpDetail"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="80"></div>
                            <div e-column e-field="FinalSettlementName" e-headertext="Name" e-width="100"></div>
                            <div e-column e-field="FinalSettlementDate" e-type="date" e-format="{0:dd-MMM-yyyy}" e-headertext="Final Settlement Date" e-width="80"></div>
                            <div e-column e-field="ApproveBy" e-headertext="ApproveBy" e-width="80"></div>
                            <div e-column e-field="ApproveStatus" e-headertext="Approve Status" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


<confirm-archive-generic modalid="confirmPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="DeleteEmp();"></confirm-archive-generic>

<div class="modal fade site-modal in" id="dialogEmployeeInfo" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">Employee Information<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div class="row">
                    <div id="GridEmp" ej-grid e-datasource="EmployeeInformationList" e-templaterefresh="refreshTemplateOperation"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                        <div e-columns>
                            <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>
                            <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="DOJ" e-type="date" e-format="{0:dd-MMM-yyyy}" e-headertext="DOJ" e-width="70"></div>
                            <div e-column e-field="DOS" e-type="date" e-format="{0:dd-MMM-yyyy}" e-headertext="DOS" e-width="70"></div>
                            <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                            <div e-column e-field="DesignationGroup" e-headertext="Designation Group" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="EntityName" e-headertext="Entity" e-width="80"></div>
                            <div e-column e-field="SepType" e-headertext="Separation Type" e-width="80"></div>
                        </div>
                    </div>
                    <script type="text/template" id="checkboxTemplate">
                        <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.Flag" />
                    </script>
                    <script type="text/x-jsrender" id="headerTemplate">
                        <input type="checkbox" id="headchk" />
                    </script>
                    <div class="common-btn" style="padding-right: 15px;">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Close();" class="btn">Apply</button></li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="FormulaInfo" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">Seperation Items<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div clas="row">

                    <div class="modal-body form-elements form-horizontal">
                        <div ng-form name="CostingSOform">
                            <div class="col-xs-12">
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Head</th>
                                                <th>State</th>
                                                <th>Value</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in FormulaList">
                                                <td>{{x.SandardName}}</td>
                                                <td>{{x.EntryState}}</td>
                                                @*<td><input class="form-control text-right" ng-disabled="x.FieldDisable==true" type="text" n-decimals="2" ng-model="x.Value" /></td>*@
                                            <td><input class="form-control text-right" ng-disabled="{{(x.EntryState=='Auto' && x.UserName=='EarnLeave')?'false':x.EntryState=='Entry'?'false' :(x.EntryState=='Auto'||x.EntryState=='Calculate')?'true':'true'}}" type="text" n-decimals="6" ng-model="x.Value" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <label style="color: red;">{{bonusMessage}}</label>

                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">Undisbursed Salary Info</legend>
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>YearNo</th>
                                                <th>Month Name</th>
                                                <th>Amount</th>
                                            </tr>

                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in FinalSettlementUndisbursedEarningList">
                                                <td>{{x.YearNo}}</td>
                                                <td>{{x.MonthName}}</td>
                                                <td class="text-right">{{x.DisbusmentAmount}}</td>
                                            </tr>
                                            <tr>
                                                <td colspan="2">Total</td>
                                                <td class="text-right">
                                                    {{FinalSettlementUndisbursedEarningList | sumByKey : 'DisbusmentAmount'|number:0}}
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>
                        </div>
                        <div class="common-btn" style="padding-right: 15px;">
                            <ul class="list-inline text-right">
                                <li><button ng-click="UpdateItemData();"ng-disabled="FinalSettlementModel.IsApproved==true" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Save</button></li>
                                <li><button ng-click="CloseFormulaPopUp();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Close</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
