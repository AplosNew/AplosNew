<togglable name="Final Settlement Payments"></togglable>
<div class="form-elements form-horizontal" ng-form="form0">
    <fieldset class="scheduler-border">
        <legend class="scheduler-border">General Info</legend>
        <div class="col-xs-12 col-sm-4 col-md-4">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Master Id<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <div class="input-group">
                        <input type="text" ng-model="voucher.DisbursementAdviceId" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="getMasterData();" class="btn single-small-btn" tabindex="1"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
            <div id="div_PostingDate" class="form-group" show-errors>
                <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input required datepicker="getFiscalYearPeriod(voucher.PostingDate);getTaxCodeByTaxYear(voucher.PostingDate);" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-8 col-md-8">
            <div class="form-group">

                <label class="col-sm-2 control-label">Payment Mode</label>
                <div class="col-sm-4">
                    <div class="select-style">
                        <select id="PaymentModeId" class="form-control" name="Payment Mode" ng-change="changePaymentMode()" ng-model="voucher.PaymentMode" tabindex="5">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in paymentModeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <label class="col-sm-2 control-label" ng-show="voucher.PaymentMode=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">Payment Bank<sup>*</sup></label>
                <div class="col-sm-4 show-message" ng-show="voucher.PaymentMode=='@Library.Model.Payments.PaymentSource.Bank.ToString()'">
                    <div class="input-group">
                        <input type="text" name="BankName" ng-model="voucher.BankName" class="form-control" readonly data-toggle="tooltip" data-placement="top" title="{{voucher.BankName}}" tooltip>
                        <span class="input-group-btn">
                            <button ng-click="showBankPopUp();" class="btn single-small-btn" tabindex="23"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
                <label class="col-sm-2 control-label" ng-show="voucher.PaymentMode=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">Payment Cash<sup>*</sup></label>
                <div class="col-sm-4 show-message" ng-show="voucher.PaymentMode=='@Library.Model.Payments.PaymentSource.Cash.ToString()'">
                    <div class="input-group">
                        <input type="text" name="CashName" ng-model="voucher.CashName" class="form-control" readonly>
                        <span class="input-group-btn">
                            <button ng-click="showCashPopUp(null, voucher.EntityId);" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        @*<div class="col-xs-12 col-sm-4 col-md-4">
                <div id="div_PostingDate" class="form-group" show-errors>
                    <label class="col-sm-4 control-label">Posting Date<sup>*</sup></label>
                    <div class="col-sm-8 show-message">
                        <input required datepicker="getFiscalYearPeriod(voucher.PostingDate);getTaxCodeByTaxYear(voucher.PostingDate);" id="postingDate" type="text" name="PostingDate" ng-model="voucher.PostingDate" class="form-control" tabindex="1">
                    </div>
                </div>
            </div>*@
    </fieldset>

    <div class="clearfix"></div>



    <div class="tab-design">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSetVoucher(1) }"><a ng-click="setTabVoucher(1)" href="" aria-controls="Service" role="tab" data-toggle="tab">Employee Info</a></li>
                <li role="presentation" ng-class="{ active: isSetVoucher(2) }"><a ng-click="setTabVoucher(2)" href="" aria-controls="general" role="tab" data-toggle="tab">JV Info</a></li>

            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetVoucher(1), active: isSetVoucher(1) }">
                <div ng-form="tabForm1">

                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">Disbursement</legend>
                        <div class="col-xs-10  col-sm-6 col-md-12">
                            <div id="GridSelectedEmp" ej-grid e-datasource="SelectedEmployeeList"
                                 e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                                 e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                                <div e-columns>
                                    <div e-column e-headertext="Actions" e-template="#ShowActionButtons" e-width="20"></div>
                                    <div e-column e-field="EmployeeCode" e-headertext="Code" e-width="50"></div>
                                    <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                    <div e-column e-field="DOJ" e-type="date" e-format="{0:dd-MMM-yyyy}" e-headertext="DOJ" e-width="70"></div>
                                    <div e-column e-field="DOS" e-type="date" e-format="{0:dd-MMM-yyyy}" e-headertext="DOS" e-width="70"></div>
                                    <div e-column e-field="LegalDesignation" e-headertext="Legal Designation" e-width="80"></div>
                                    <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                                    <div e-column e-field="PaymentMode" e-headertext="Payment Mode" e-width="80"></div>
                                </div>
                                <script type="text/template" id="ShowActionButtons">
                                    <button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-print" title="Print" ng-click="$parent.PrintData(this);" style="margin: -6px;"></i></button>
                                </script>
                            </div>
                        </div>

                    </fieldset>
                </div>

            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSetVoucher(2), active: isSetVoucher(2) }" ng-form="tabForm2">
                <div class="clearfix"></div>
                <fieldset class="scheduler-border">
                    <legend class="scheduler-border">JV</legend>
                    <div class="table-responsive modal-table">
                        <table class="table table-responsive table-striped">
                            <thead>
                                <tr>
                                    <th>GL</th>
                                    <th>Budget</th>
                                    <th>Activity</th>
                                    <th class="text-right">Dr</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in salaryLockPayableGLData">
                                    <td>{{x.GLName}}</td>
                                    <td>{{x.BudgetName}}</td>
                                    <td>{{x.ActivityName}}</td>
                                    <td class="text-right">{{x.DrAmount}}</td>
                                </tr>
                            </tbody>
                            <tfoot ng-show="salaryLockPayableGLData.length">
                                <tr>
                                    <td colspan="3" class="text-right"><b> Total</b></td>
                                    <td class="text-right"><b>{{ salaryLockPayableGLData | sumByKey : 'DrAmount' }}</b></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </fieldset>
            </div>

        </div>
    </div>


    <div class="common-btn">
        <ul class="list-inline text-right">
            <li><button ng-click="SaveGoodWorkPaymentAdviseDisbursement();" class="btn" ng-disabled="saveBtnDisable==true"><i class="glyphicon glyphicon-floppy-disk"></i> Park</button></li>
            <li><button ng-click="ClearGoodWorkPaymentAdviseDisbursement();" class="btn"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>
<div class="aplos-grid-toggle">
    <div class="row text-right">
        <div class="col-xs-12 col-sm-12 col-sm-12">
            <div class="search-form">
                <div class="row">
                    <div class="col-xs-12 col-sm-3 col-md-3">
                        <div class="select-style">
                            <select ng-model="$root.parameters.searchBy">
                                <option ng-repeat="option in searchByList" value="{{option.value}}">{{option.name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-7 col-md-7">
                        <input type="text" class="form-control" placeholder="Search" ng-model="$root.parameters.search" ng-enter="getVoucherData()">
                    </div>
                    <div class="col-xs-12 col-sm-2 col-md-2">
                        <button type="button" ng-click="getVoucherData()" class="btn"><i class="glyphicon glyphicon-search"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive modal-table ">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>VoucherNo</th>
                    <th>Doc Ref</th>
                    <th>Doc Date</th>
                    <th>Posting Date</th>
                    <th>Payment Bank/Cash</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr dir-paginate="x in goodWorkAdviseDisbursementVoucherList |itemsPerPage:$root.pageSize" total-items="$root.total_count" ng-dblclick="getById(x.Id);">
                    <td>{{x.VoucherNo}}</td>
                    <td>{{x.DocRefNo}}</td>
                    <td>{{x.DocDate | dateFiltering}}</td>
                    <td>{{x.PostingDate | dateFiltering}}</td>
                    <td>{{x.PaymentBank}}</td>
                    <td class="text-right">{{x.DrAmount | number:2}}</td>
                    <td>{{x.IsPark?'Parked':'Posted'}}</td>
                    <td class="text-right">
                        <ul class="list-inline action-list">
                            @*<li><a ng-click="XlsSalaryDisbursementVoucherWiseReport(x.PayableVoucherId);" class="btn btn-action" title="Salary Disbursement Report"><i class="fa fa-file-excel-o"></i></a></li>*@
                            <li ng-show="x.IsPark"><a ng-click="confirmPost(x.PayableVoucherId);" href="" class="btn btn-action tooltip-here">Post</a></li>
                            <li ng-show="x.IsPark"><a ng-click="confirmDelete(x);" href="" class="btn btn-action tooltip-here">Delete</a></li>
                            <li><a class="btn btn-action" href="Accounts/SalaryDisbursement/GetSalaryDisbursementVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Pdf.ToString()&voucherId={{x.PayableVoucherId}}" target="_blank"><i class="fa fa-file-pdf-o"></i></a></li>
                            <li><a class="btn btn-action" href="Accounts/SalaryDisbursement/GetSalaryDisbursementVoucherReport?reportFormat=@Library.Model.Enums.ReportFormat.Excel.ToString()&voucherId={{x.PayableVoucherId}}" target="_blank"><i class="fa fa-file-excel-o"></i></a></li>
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        <dir-pagination-controls max-size="10" direction-links="true" boundary-links="true" on-page-change="getVoucherData(newPageNumber)"></dir-pagination-controls>
    </div>
</div>

<div class="modal fade site-modal in" id="DisbursementAdvicepopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify1">
        <div class="modal-content">
            <div class="modal-header"> Disbursement Advice <button type="button" class="close" ng-click="closePopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                    <div style="color:black;" id="GridFinalSettlementList" ej-grid e-datasource="FinalSettlementList" e-recorddoubleclick="SelectMaster"
                         e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-allowselection="true" e-filtersettings-filterType="excel" e-allowtouch="true">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="Id" e-width="80"></div>
                            <div e-column e-field="FinalSettlementName" e-headertext="Name" e-width="100"></div>
                            <div e-column e-field="FinalSettlementDate" e-type="date" e-format="{0:dd-MMM-yyyy}" e-headertext="Final Settlement Date" e-width="80"></div>
                            <div e-column e-field="ApproveBy" e-headertext="ApproveBy" e-width="80"></div>
                            <div e-column e-field="ApproveStatus" e-headertext="Approve Status" e-width="80"></div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closePopUp();" class="btn"> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="modal fade site-modal in" id="FormulaInfo" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">Seperation Items<button type="button" class="close" data-dismiss="modal">&times;</button></div>
            <div class="modal-body">
                <div clas="row">
                    <div class="modal-body form-elements form-horizontal">
                        <div ng-form name="CostingSOform">
                            <div class="col-xs-12">
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Head</th>
                                                <th>State</th>
                                                <th>Value</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in FormulaList">
                                                <td>{{x.SandardName}}</td>
                                                <td>{{x.EntryState}}</td>
                                                <td><input class="form-control text-right" ng-disabled="true" type="text" n-decimals="6" ng-model="x.Value" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>


                            <fieldset class="scheduler-border">
                                <legend class="scheduler-border">Undisbursed Salary Info</legend>
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>YearNo</th>
                                                <th>Month Name</th>
                                                <th>Amount</th>
                                            </tr>

                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in FinalSettlementUndisbursedEarningList">
                                                <td>{{x.YearNo}}</td>
                                                <td>{{x.MonthName}}</td>
                                                <td class="text-right">{{x.DisbusmentAmount}}</td>
                                            </tr>
                                            <tr>
                                                <td colspan="2">Total</td>
                                                <td class="text-right">
                                                    {{FinalSettlementUndisbursedEarningList | sumByKey : 'DisbusmentAmount'|number:0}}
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>
                        </div>
                        <div class="common-btn" style="padding-right: 15px;">
                            <ul class="list-inline text-right">
                                @*<li><button ng-click="UpdateItemData();" class="btn"><i class="glyphicon glyphicon-floppy-disk" tabindex="9"></i> Save</button></li>*@
                                <li><button ng-click="CloseFormulaPopUp();" class="btn"><i class="glyphicon glyphicon-refresh" tabindex="11"></i> Close</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<confirm-archive-generic modalid="confirmPostPopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="post(voucherId)"></confirm-archive-generic>
<confirm-archive-generic modalid="confirmDeletePopUp" title="Confirmation" message={{message_delete_confirmation}} data-ng-click-right-button="deleteSalaryDisbursement(voucherId)"></confirm-archive-generic>

