<togglable name="OT Formula"></togglable>
<div class="form-horizontal form-element-ctrl" ng-form name="OTFormulaForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Company<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <div class="select-style">
                    <select id="CompanyId" class="form-control" ng-model="OTFormulaNew.CompanyId" name="Company" ng-change="GetData();GetSequence();" required tabindex="1">
                        <option value="">--Select--</option>
                        <option ng-repeat="option in companyList" value="{{option.Value}}">{{option.Text}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <div class="form-elements">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="number" name="Sequence" ng-model="OTFormulaNew.Sequence" class="form-control" required tabindex="1">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Short Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="OTFormulaNew.ShortName" class="form-control" maxlength="15" required tabindex="3">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">User Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="User Name" ng-model="OTFormulaNew.UserName" class="form-control" required tabindex="5" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="OTFormulaNew.Description" tabindex="7" maxlength="250"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Code<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="OTFormulaNew.Code" class="form-control" required tabindex="2" maxlength="10">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Standard Name<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Standard Name" ng-model="OTFormulaNew.StandardName" class="form-control" required tabindex="4" maxlength="50">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Remarks</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="OTFormulaNew.Remarks" maxlength="250" tabindex="6"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Active</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="OTFormulaNew.Active" tabindex="8">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-sm-12" style="margin-left:-29px">
            <fieldset class="scheduler-border" style="width:1076px">
                <legend class="scheduler-border">Formula</legend>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Salary Head</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="OTFormulaNew.SalaryHeadIdFormula" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="10">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('SHead');" class="btn" tabindex="11"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                            @*<button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('SHead');" style="margin: -4px;"></i></button>*@
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Operator</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="OTFormulaNew.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="12">
                                    <option value=""></option>
                                </select>
                            </div>

                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('Operator');" class="btn" tabindex="13"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Precedence</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="OTFormulaNew.Precedence" class="form-control" name="Precedence" tabindex="14">
                                    <option value=""></option>
                                    <option value="(">(</option>
                                    <option value=")">)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('Precedence');" class="btn"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Value</label>
                        <div class="col-sm-6">
                            <input type="text" name="Value" ng-model="OTFormulaNew.Value" class="form-control" tabindex="16" maxlength="50">
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('Value');" class="btn"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">

                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li> <button ng-click="RemoveFormula();" class="btn"><i class="glyphicon glyphicon-backward"></i></button></li>
                        </ul>
                    </div>
                    <div class="form-group">
                        {{OTFormulaNew.FormulaDescription}}
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="clearfix"></div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>

</div>
<div class="aplos-grid-toggle">
    <div class="content-container-fluid" style="color:black;overflow:scroll">
        <div style="color:black;" id="Grid" ej-grid e-datasource="OTFormulaList" e-recorddoubleclick="Get"
             e-allowfiltering="true" e-allowpaging="true" e-gridlines="vertical"
             e-filtersettings-filterType="excel" e-enabletouch="false" e-allowselection="false">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="20" e-visible="false"></div>
                <div e-column e-field="Sequence" e-headertext="Sequence" e-width="80"></div>
                <div e-column e-field="Code" e-headertext="Code" e-width="80"></div>
                <div e-column e-field="ShortName" e-headertext="Short Name" e-width="80"></div>
                <div e-column e-field="StandardName" e-headertext="Standard Name" e-width="80"></div>
                <div e-column e-field="UserName" e-headertext="User Name" e-width="80"></div>
                <div e-column e-field="FormulaDes" e-headertext="Formula Des." e-width="80"></div>
                <div e-column e-field="FormulaDesID" e-headertext="Formula Des.ID" e-width="80"></div>
                <div e-column e-field="Active" e-headertext="Active" e-width="80"></div>
            </div>
        </div>
    </div>

</div>
<confirm-modal></confirm-modal>
