<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span>Increment Summary Report</h3>
<div class="form-elements form-horizontal" ng-form="modelForm">
    <div class="row">

        <div class="col-xs-12">
            <div class="form-group">
                <label class="col-sm-3 control-label">Employee Select<sup>*</sup></label>
                <div class="col-sm-1">
                    <input type="text" style="width:100px;" ng-change="SearchEmployee()" ng-model="EmployeeCodee" placeholder="Employee Code" class="form-control" maxlength="100">
                </div>
                <div class="col-sm-3 text-left">
                    <div class="input-group">


                        <input type="text" name="EmployeeName" ng-model="EmployeeNamee" class="form-control" required readonly>
                        <span class="input-group-btn">
                            <button name="submit" ng-click="getPopUpData()" class="btn single-small-btn" tabindex="1"><i class="cr-icon glyphicon glyphicon-search"></i></button>
                        </span>

                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label" style="font-weight: normal;">Language<sup>*</sup></label>
                <div class="col-sm-3">
                    <div class="select-style" style="height: 26px;">
                        <select id="languageId" class="form-control" ng-model="languageId" name="languageId" required tabindex="3">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in localLanguageList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-3">
                </div>
            </div>
        </div>




        <div class="col-sm-12 text-left">
            <ul>
                <li>
                    <button class="btn" ng-click="getIncrementSummaryReport();" style="background-color:cornflowerblue;"><i class="glyphicon glyphicon-file"></i>Download</button>

                </li>

            </ul>
        </div>
    </div>
</div>

<div class="modal fade site-modal in" id="employeeNewPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                Employee List
                <button type="button" class="close" ng-click="closeEmployeePopUp();">&times;</button>
            </div>
            <div class="modal-body">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="Grid" ej-grid e-datasource="employee" e-gridlines="vertical" e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-recorddoubleclick="setEmpData" e-allowselection="true" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="SystemId" e-headertext="SystemID" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-type="string" e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-type="string" e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Designation" e-headertext="Designation" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Department" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="SubSection" e-headertext="SubSection" e-width="80"></div>
                            <div e-column e-field="Line" e-headertext="Line" e-width="80"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer common-btn">
                <button ng-click="closeEmployeePopUp();" class="btn"><i class=""></i> Close</button>
            </div>
        </div>
    </div>
</div>
<confirm-modal></confirm-modal>
