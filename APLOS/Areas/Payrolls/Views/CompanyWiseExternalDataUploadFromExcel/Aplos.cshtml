<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span>Company Wise External Data Upload From Excel<label style="float:right"></label>
</h3>
<style>
    /****************File Upload*/
    * {
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
    }

    .inputBtnSection {
        /*display: inline-block;*/
        vertical-align: top;
        font-size: 0;
        font-family: verdana;
    }

    .disableInputField {
        /*display: inline-block;*/
        vertical-align: top;
        height: 27px;
        margin: 0;
        font-size: 14px;
        padding: 0 3px;
    }

    .fileUpload {
        position: relative;
        overflow: hidden;
        /*border: solid 1px gray;*/
        display: inline-block;
        vertical-align: top;
    }

    .uploadBtn {
        display: inline-block;
        vertical-align: top;
        background: #242841;
        font-size: 14px;
        padding: 0 10px;
        height: 25px;
        line-height: 22px;
        color: #fff;
    }

    .fileUpload input.upload {
        position: absolute;
        top: 0;
        right: 0;
        margin: 0;
        padding: 0;
        font-size: 20px;
        cursor: pointer;
        opacity: 0;
        filter: alpha(opacity=0);
    }
</style>
<div class="form-elements form-horizontal" ng-form id="JobLocationFormId" name="JobLocationForm">

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label class="col-sm-5 control-label">Salary Head<sup>*</sup></label>
                <div class="col-sm-7 show-message">
                    <div class="select-style">
                        <select id="SalaryHeadId" class="form-control" ng-model="ModelNew.SalaryHeadId" name="SalaryHead" required tabindex="1">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in SalaryHeadList" value="{{option.Id}}">{{option.UserName}}</option>
                        </select>
                    </div>
                </div>
            </div>


        </div>

        <div class="col-md-4">

            <div class="form-group">
                <label class="col-sm-4 control-label">Year No<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    @*<input type="text" maxlength="15" name="ShortName" ng-model="SalaryHeadWiseAmountTransactionModel.YearNo" class="form-control" required tabindex="3">*@
                    <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="yearList" e-databound="SelectDefaultValue" e-value="ModelNew.YearNo" e-enablefiltersearch="true" e-fields-value="Text" e-fields-text="Text" e-width="100%" />
                </div>
            </div>



        </div>

        <div class="col-md-4">

            <div class="form-group">
                <label class="col-sm-4 control-label">Month No<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    @*<input type="text" maxlength="15" name="ShortName" ng-model="SalaryHeadWiseAmountTransactionModel.MonthNo" class="form-control" required tabindex="3">*@
                    <input id="ddlMonthList" e-watermarktext="Month" ej-dropdownlist e-datasource="monthList" e-value="ModelNew.MonthNo" e-fields-value="Value" e-fields-text="Text" e-width="100%" @*e-change="empGridShow"*@ />

                </div>
            </div>


        </div>
    </div>
</div>
<br />






<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet11(11) }"><a ng-click="setTab11(11)" href="" aria-controls="aria1" role="tab" data-toggle="tab"> To be Uploaded</a></li>
            <li role="presentation" ng-class="{ active: isSet22(22) }"><a ng-click="setTab22(22)" href="" aria-controls="aria2" role="tab" data-toggle="tab"> Uploaded</a></li>


        </ul>
    </div>

    <div class="tab-content" id="tabpaneldiv">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet11(11), active: isSet11(11) }">

            <div class="form-elements form-horizontal row" ng-form name="ModelNewForm">






                <div class="col-md-10">
                    <input type="hidden" ng-model="EmployeeProfileFromExcel.EmployeeCode">
                    <div class="inputBtnSection common-btn">
                        <label class="fileUpload col-sm-4 ">
                            @*<input type="file" name="file" class="form-control"
                                onchange="angular.element(this).scope().loadFile(this.files)" />*@

                            <input id="uploadImage" ng-file-select="onFileSelect($files)" class="form-control" type="file" name="uploadFile" accept=".xls,.xlsx" />
                        </label>
                        <input type="button" value="Import Data" class="btn btn-success"
                               ng-click="ImportData()" />
                    </div>
                </div>
                @*<div class="col-md-4">
                    <label class="control-label " style="color:red">If Employee Code Is Duplicate, It will uploaded for both employee</label>
                </div>*@
                <div class="col-md-2">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="GetSampleFile();" class="btn"><i class="glyphicon glyphicon-file"></i> Sample File</button></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-12">
                    <div id="GridWorkCenterProduct"
                         ng-init="chkinit()"
                         ej-grid e-datasource="AttdnRawData"
                         e-recorddoubleclick="selectSignleEmployee"
                         e-rowdatabound="onrowdatabound"
                         e-allowfiltering="true"
                         e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         e-allowscrolling="true" @* e-minwidth="1100" e-minheight="500"*@
                         e-pagesettings-pagesize="25"
                         @*e-allowselection="true"*@
                         e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="SalaryHead" e-headertext="Salary Head" e-width="80"></div>
                            <div e-column e-field="HeadType" e-headertext="Head Type" e-width="80"></div>
                            @*<div e-column e-field="ExistCurrency" e-headertext="Exist Currency" e-width="80"></div>
                                <div e-column e-field="ExistAmount" e-headertext="Exist Amount" e-width="80"></div>*@
                            <div e-column e-field="EntryCurrency" e-headertext="Entry Currency" e-width="100"></div>
                            <div e-column e-field="EntryAmount" e-headertext="Entry Amount" e-width="100"></div>
                            @*<div e-column e-field="DefinitionCurrency" e-headertext="Definition Currency" e-width="100"></div>
                                <div e-column e-field="DefineAmount" e-headertext="Define Amount" e-width="100"></div>*@
                            <div e-column e-field="Remarks" e-headertext="Remarks" e-width="100"></div>

                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12 ">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li ng-show="ShowSaveBtn"> <button ng-click="save();" class="btn"><i class="glyphicon glyphicon-check"></i> Save</button></li>
                        </ul>
                    </div>
                </div>
            </div>






        </div>


        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet22(22), active: isSet22(22) }">

            <div class="form-elements form-horizontal row" id="MainDivId">






                <div class="col-md-10">

                </div>
                <div class="col-md-2">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="LoadData();" class="btn"><i class="glyphicon glyphicon-download"></i> Load</button></li>

                        </ul>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div id="GridUploadedData"
                         ng-init="chkinit()"
                         ej-grid e-datasource="SaveDataList"
                         @*e-recorddoubleclick="selectSignleEmployee"
                         e-rowdatabound="onrowdatabound"*@
                         e-allowfiltering="true"
                         e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                         @*e-allowscrolling="true" e-minwidth="1100" e-minheight="500"*@
                         e-pagesettings-pagesize="25"
                         @*e-allowselection="true"*@
                         e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="50"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="SalaryHead" e-headertext="Salary Head" e-width="80"></div>
                            <div e-column e-field="HeadType" e-headertext="Head Type" e-width="80"></div>
                            <div e-column e-field="Currency" e-headertext="Currency" e-width="100"></div>
                            <div e-column e-field="EntryAmount" e-headertext="Entry Amount" e-width="100"></div>
                            <div e-column e-headertext="Details" e-template="#DetailsButtons" e-width="40"></div>

                        </div>
                    </div>
                </div>
                <script type="text/ng-template" id="DetailsButtons">
                    <div class="common-btn">
                        <button style="color: #f3f3ec;background-color: #1c1f32;" title="Actions" class="btn">
                            <i class="glyphicon glyphicon-th-list" ng-click="$parent.Edit(this);"></i>
                        </button>
                    </div>
                </script>
                <div class="col-xs-12 col-sm-12 col-md-12 ">
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="DownloadReport();" class="btn"><i class="glyphicon glyphicon-download-alt"></i> Report</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>





</div>
<ej-dialog id="Edit"
           title="Examption"
           e-enablemodal="true"
           e-position-y="0"
           e-showoninit="false"
           e-target="#MainDivId"
           e-close="onDialogClose"
           e-width="1080"
           e-minheight="470"
           e-open="enableBtn">

    <fieldset class="scheduler-border form-group form-elements" style="width:990px;">


        <div class="col-xs-6 col-sm-6 col-md-6 " style="margin-top: 6px;">
            <div class="form-group">
                <label class="col-sm-6 control-label">Employee Code</label>
                <label class="col-sm-6 control-label">{{edit.EmpCode}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Salary Head</label>
                <label class="col-sm-6 control-label">{{edit.SalaryHead}}</label>
            </div>
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6 " style="margin-top: 6px;">
            <div class="form-group">
                <label class="col-sm-6 control-label">Employee Name</label>
                <label class="col-sm-6 control-label">{{edit.EmpName}}</label>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Amount</label>
                <div class="col-sm-8">
                    <input type="number" ng-model="edit.Amount" class="form-control" maxlength="100" tabindex="2">
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="UpdateUpload();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
                @*<li> <button ng-click="ConfirmDeleteTaxRebateDetails();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-trash"></i>Delete</button></li>*@
            </ul>
        </div>
    </fieldset>


</ej-dialog>