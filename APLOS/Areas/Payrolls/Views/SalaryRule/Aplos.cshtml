@*<togglable name="Salary Rule"></togglable>*@
<togglable name="{{FormTitle}}"></togglable>
<div id="salaryRule" class="form-elements form-horizontal" ng-form name="salaryRuleForm">
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Salary Rule Name<sup>*</sup></label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Salary Rule" ng-model="salaryRuleNew.SalaryRuleName" class="form-control" required tabindex="2" maxlength="50">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label" title="Income Tax Group">Income Tax Group</label>
            <div class="col-sm-8 input-group" style="padding-left: 15px;padding-right: 14px;">
                <input type="text" ng-model="salaryRuleNew.IncomeTaxGroup" class="form-control" readonly>
                <span class="input-group-btn">
                    <button ng-click="getTaxGroup()" class="btn single-small-btn"><i class="glyphicon glyphicon-search"></i></button>
                    <button ng-click="ClearTaxGroup()" class="btn single-small-btn"><i class="glyphicon glyphicon-refresh"></i></button>
                </span>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-5 control-label">Active</label>
            <div class="col-sm-7">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="salaryRuleNew.IsActive">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-12">
                <div class="common-btn">
                    <ul class="list-inline text-left">
                        <li> <button ng-click="SalaryHeadPop();" ng-disabled="salaryRuleNew.SystemID===null" class="btn" tabindex="9"><i class="glyphicon glyphicon-eye-open"></i> Salary Head Setting</button></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Salary Head<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select id="SH" ng-model="salaryRuleGeneral.SalaryHeadID" class="form-control" name="Salary Rule" ng-options="item.Value as item.Text for item in salaryHeadCboList" tabindex="5"></select>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-5 control-label">Based Minimum Wages</label>
            <div class="col-sm-7">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="salaryRuleGeneral.IsMinWages">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="col-xs-12">
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="col-sm-6 control-label" style="margin-left: -28px;">Has Max Limit</label>
                    <div class="col-sm-6">
                        <div class="checkbox-site">
                            <label style="margin: 12px;">
                                <input type="checkbox" ng-model="salaryRuleGeneral.HasMaxLimit" ng-change="checkMax();">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4" ng-show="visiblecheckMax===true">
                <div class="form-group">
                    <div class="radio">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="salaryRuleGeneral.FixedMaxLimit" ng-change="checkMaxLimit('FixedMaxLimit');">
                                <span class="cr"><i class="cr-icon"></i></span>
                            </label>
                            <label class="control-label">Fixed</label>
                        </div>
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="salaryRuleGeneral.PercentageMaxLimit" ng-change="checkMaxLimit('PercentageMaxLimit');">
                                <span class="cr"><i class="cr-icon"></i></span>
                            </label>
                            <label class="control-label">Percentage</label>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-sm-4" ng-show="visiblecheckMax===true">
                <div class="form-group">
                    <input type="text" n-decimals="2" ng-model="salaryRuleGeneral.MaxLimitValue" ng-disabled="disblecheckFixMax" class="form-control">
                </div>
                <div class="col-sm-12">
                    <table>
                        <tr>
                            <td>
                                <div class="select-style">
                                    <select id="SH" ng-model="salaryRuleGeneral.PercentageMaxLimitSalaryHeadId" ng-disabled="disblecheckParMax" class="form-control" name="Salary Rule" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5"></select>
                                </div>
                            </td>
                            <td>
                                <input type="text" n-decimals="2" ng-model="salaryRuleGeneral.MaxLimitValue" ng-disabled="disblecheckParMax" class="form-control">
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

        </div>
        <div class="form-group">
            <fieldset class="scheduler-border" style="width: 530px;">
                <legend class="scheduler-border">General Salary Calculation</legend>
                <div class="col-sm-12" style="margin-top: -8px;">
                    <div class="radio">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="salaryRuleGeneral.IsNA" ng-change="showFormulaDiv('IsNA')">
                                <span class="cr"><i class="cr-icon"></i></span>
                            </label>
                            <label class="control-label">Derived from manpower Budgetcode</label>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12" style="margin-left: -15px;margin-bottom: -14px;">
                    <div class="col-sm-4">
                        <div class="radio">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="salaryRuleGeneral.IsFixed" ng-change="showFormulaDiv('IsFixed')">
                                    <span class="cr"><i class="cr-icon"></i></span>
                                </label>
                                <label class="control-label">Fixed Value</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group">
                            <div class="col-sm-8">
                                <input type="text" n-decimals="2" ng-disabled="disabled" ng-model="salaryRuleGeneral.FixedValue" class="form-control">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group">
                            <div class="col-sm-5">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="salaryRuleGeneral.IsOpen">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                            <label class="col-sm-7 control-label" style="margin-left: -7px;">Editable</label>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12" style="margin-left: -15px;">
                    <div class="col-sm-6">
                        <div class="radio">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="salaryRuleGeneral.IsFormula" ng-change="showFormulaDiv('IsFormulaDefine')">
                                    <span class="cr"><i class="cr-icon"></i></span>
                                </label>
                                <label class="control-label">Formula</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <div class="col-sm-7" style="margin-left: 80px;">
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="salaryRuleGeneral.BaseOnNetPay" ng-disabled="BaseOnNetPayDisabled">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </div>
                            <label class="col-sm-5 control-label" style="margin-left:-80px">Based On Netpay</label>
                        </div>
                    </div>
                    <div class="col-sm-6" style="margin-top:-8px;">
                        <div class="radio">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="salaryRuleGeneral.IsPolicyDerived" ng-change="showFormulaDiv('IsPolicyDerived')">
                                    <span class="cr"><i class="cr-icon"></i></span>
                                </label>
                                <label class="control-label">Policy Derived</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12" style="margin-top:-8px;">
                        <div class="radio">
                            <div class="checkbox-site">
                                <label>
                                    <input type="checkbox" ng-model="salaryRuleGeneral.IsSlabBased" ng-change="showFormulaDiv('IsSlabBased')">
                                    <span class="cr"><i class="cr-icon"></i></span>
                                </label>
                                <label class="control-label">Slab Based</label>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="col-sm-12" ng-show="showFormula===true" style="margin-left:-29px">
            <fieldset class="scheduler-border" style="width:1076px">
                <div class="col-xs-12 col-sm-6 col-md-6">
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Salary Head</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="salaryRuleGeneral.SalaryHeadIdFormula" id="SalaryHeadFormula" class="form-control" name="Salary Head" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5">
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('SHead');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                            @*<button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('SHead');" style="margin: -4px;"></i></button>*@
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Operator</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="salaryRuleGeneral.Operator" id="Operator" class="form-control" name="Operator" ng-options="item.Value as item.Text for item in OperatorList" tabindex="5">
                                    <option value=""></option>
                                </select>
                            </div>

                            @*<div class="select-style">
                                    <select ng-model="salaryRuleGeneral.Operator" class="form-control" name="Operator" tabindex="5">
                                        <option value=""></option>
                                        <option value="*">*</option>
                                        <option value="/">/</option>
                                        <option value="+">+</option>
                                        <option value="-">-</option>
                                    </select>
                                </div>*@
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('Operator');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                            @*<button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('Operator');" style="margin: -4px;"></i></button>*@
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Precedence</label>
                        <div class="col-sm-6">
                            <div class="select-style">
                                <select ng-model="salaryRuleGeneral.Precedence" class="form-control" name="Precedence" tabindex="5">
                                    <option value=""></option>
                                    <option value="(">(</option>
                                    <option value=")">)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('Precedence');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                            @*<button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('Precedence');" style="margin: -4px;"></i></button>*@
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Value</label>
                        <div class="col-sm-6">
                            <input type="text" name="Value" ng-model="salaryRuleGeneral.Value" class="form-control" required tabindex="2" maxlength="50">
                        </div>
                        <div class="col-sm-2">
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li> <button ng-click="SetFormula('Value');" class="btn" tabindex="9"><i class="glyphicon glyphicon-forward"></i></button></li>
                                </ul>
                            </div>
                            @*<button style="color: #f3f3ec;background-color: #1c1f32;" class="btn"><i class="glyphicon glyphicon-forward" ng-click="SetFormula('Value');" style="margin: -4px;"></i></button>*@
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-md-6">
                    @*<div class="form-group" style="margin-top: -8px;">
                            <button style="color: #f3f3ec;background-color: #1c1f32;margin-top: 8px;" class="btn"><i class="glyphicon glyphicon-backward" ng-click="RemoveFormula();" style="margin: -4px;"></i></button>
                        </div>*@
                    <div class="common-btn">
                        <ul class="list-inline text-left">
                            <li> <button ng-click="RemoveFormula();" class="btn" tabindex="9"><i class="glyphicon glyphicon-backward"></i></button></li>
                        </ul>
                    </div>
                    <div class="form-group">
                        {{salaryRuleGeneral.FormulaDescription}}
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
    <div class="col-xs-12 col-sm-6 col-md-6">
        <div class="form-group">
            <label class="col-sm-4 control-label">Description</label>
            <div class="col-sm-8">
                <textarea class="form-control" rows="1" ng-model="salaryRuleNew.SalaryRuleDescription" tabindex="4" maxlength="150"></textarea>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Currency Rule<sup>*</sup></label>
            <div class="col-sm-8">
                <div class="select-style">
                    <select ng-model="salaryRuleNew.CurrencyRuleSystemID" class="form-control" name="Currency Rule" ng-options="item.Value as item.Text for item in currencyRuleList" ng-change="getSH();" tabindex="5"></select>
                </div>
            </div>
        </div>
        @*<div class="form-group">
                <label class="col-sm-4 control-label">Is Validate with Gov't. Grade</label>
                <div class="col-sm-8">
                    <div class="checkbox-site">
                        <label>
                            <input type="checkbox" ng-model="salaryRuleNew.IsValidGovGrd">
                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Tax Group Description</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="1" ng-model="salaryRuleNew.Description" tabindex="4" maxlength="150"></textarea>
                </div>
            </div>*@
        <div class="form-group">
            <div class="col-sm-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                        <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                        <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                    </ul>
                </div>
            </div>
        </div><br /><br />
        <div class="form-group">
            <label class="col-sm-4 control-label">Sequence<sup>*</sup></label>
            <div class="col-sm-8">
                <input type="number" name="Sequence" ng-model="salaryRuleGeneral.SequenceNo" class="form-control" tabindex="1">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-5 control-label">Is this head reflected by Absentism</label>
            <div class="col-sm-7">
                <div class="checkbox-site">
                    <label>
                        <input type="checkbox" ng-model="salaryRuleGeneral.RefAbsentism" ng-disabled="RefAbsentismDisabled">
                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="col-xs-12">
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="col-sm-6 control-label" style="margin-left: -28px;">Has Min Limit</label>
                    <div class="col-sm-6">
                        <div class="checkbox-site">
                            <label style="margin: 12px;">
                                <input type="checkbox" ng-model="salaryRuleGeneral.HasMinLimit" ng-change="checkMin();">
                                <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4" ng-show="visiblecheckMin===true">
                <div class="form-group">
                    <div class="radio">
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="salaryRuleGeneral.FixedMinLimit" ng-change="checkMinLimit('FixedMinLimit');">
                                <span class="cr"><i class="cr-icon"></i></span>
                            </label>
                            <label class="control-label">Fixed</label>
                        </div>
                        <div class="checkbox-site">
                            <label>
                                <input type="checkbox" ng-model="salaryRuleGeneral.PercentageMinLimit" ng-change="checkMinLimit('PercentageMinLimit');">
                                <span class="cr"><i class="cr-icon"></i></span>
                            </label>
                            <label class="control-label">Percentage</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4" ng-show="visiblecheckMin===true">
                <div class="form-group">
                    <input type="text" n-decimals="2" ng-model="salaryRuleGeneral.MinLimitValue" ng-disabled="disblecheckFixMin" class="form-control">
                </div>
                <div class="col-sm-12">
                    <table>
                        <tr>
                            <td>
                                <div class="select-style">
                                    <select id="SH" ng-model="salaryRuleGeneral.PercentageMinLimitSalaryHeadId" ng-disabled="disblecheckParMin" class="form-control" name="Salary Rule" ng-options="item.Value as item.Text for item in salaryHeadList" tabindex="5"></select>
                                </div>
                            </td>
                            <td>
                                <input type="text" n-decimals="2" ng-model="salaryRuleGeneral.MinLimitValue" ng-disabled="disblecheckParMin" class="form-control">
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="clearfix"></div><br />
        <div class="form-group" style="margin-top:-14px;">
            <fieldset class="scheduler-border">
                <legend class="scheduler-border">Salary Head Disbursement Base On (Fixed / Proportionate)</legend>
                <div @*class="radio"*@ style="margin-top: -20px;">
                    <div class="checkbox-site radio">
                        <label>
                            <input type="checkbox" ng-model="salaryRuleGeneral.IsMonthDay" ng-change="setCheckedValue('IsMonthDay')">
                            <span class="cr"><i class="cr-icon"></i></span>
                        </label>
                        <label class="control-label">Days in a month (Proportionate)</label>
                    </div>
                    <div class="checkbox-site radio">
                        <label>
                            <input type="checkbox" ng-model="salaryRuleGeneral.IsMonthWorkDay" ng-change="setCheckedValue('IsMonthWorkDay')">
                            <span class="cr"><i class="cr-icon"></i></span>
                        </label>
                        <label class="control-label">Working days in a month (excluding week off and holiday)</label>
                    </div>
                    <div class="checkbox-site radio">
                        <label>
                            <input type="checkbox" ng-model="salaryRuleGeneral.IsWorkDaysInAMonthIncHold" ng-change="setCheckedValue('IsWorkDaysInAMonthIncHold')">
                            <span class="cr"><i class="cr-icon"></i></span>
                        </label>
                        <label class="control-label">Working days in a month (excluding week off )</label>
                    </div>
                    <div class="checkbox-site radio">
                        <label>
                            <input type="checkbox" ng-model="salaryRuleGeneral.IsFixedDisbus" ng-change="setCheckedValue('IsFixedDisbus')">
                            <span class="cr"><i class="cr-icon"></i></span>
                        </label>
                        <label class="control-label">Fixed value of the respective head</label>
                    </div>
                    <div class="checkbox-site">
                        <table  style="margin:0;padding:0">
                            <tr>
                                <td class="radio"  style="width:100px">
                                    <label>
                                        <input type="checkbox" ng-model="salaryRuleGeneral.IsFixedMonthDay" ng-change="setCheckedValue('IsFixedMonthDay')">
                                        <span class="cr"><i class="cr-icon"></i></span>
                                    </label>
                                    <label class="control-label">Fixed Day</label>
                                </td>
                                <td>
                                    <input type="text" n-decimals="2" ng-disabled="FixedMonthDaydisabled" ng-model="salaryRuleGeneral.FixedMonthDayValue" class="form-control" style="width:80px ;margin:0;padding:0">
                                </td>
                                
                                <td style="width:500px;">
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">(pay days excluding</label>
                                        <div class="col-sm-2" style="margin-top: 6px;">
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" ng-model="salaryRuleGeneral.IsPayOnWeekoffForFixedMonthDay" ng-disabled="FixedMonthDaydisabled">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </div>
                                        <label class="col-sm-2 control-label" style="margin-left: -35px;padding-top: 0px;margin-top: 6px;">Holiday</label>
                                        <div class="col-sm-2" style="margin-top: 6px;">
                                            <div class="checkbox-site">
                                                <label>
                                                    <input type="checkbox" ng-model="salaryRuleGeneral.IsPayOnHolidayForFixedMonthDay" ng-disabled="FixedMonthDaydisabled">
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </div>
                                        <label class="col-sm-2 control-label" style="margin-left: -35px;padding-top: 0px;margin-top: 6px;">Weekoff )</label>
                                    </div>
                                </td>
                               
                            </tr>
                        </table>
                    </div>

                </div>
            </fieldset>
        </div>
    </div>
    <div class="col-sm-12">
        <div class="common-btn">
