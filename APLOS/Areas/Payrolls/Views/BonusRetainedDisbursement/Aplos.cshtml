<togglable name=" Retained Bonus Disbursement"></togglable>
<div class="form-elements form-horizontal" ng-form name="bloodGroupNewForm" id="headingDiv1">

    <div class="row form-elements">

        <div class="col-md-6 form-horizontal">
            <div class="form-group">
                <label class="col-sm-4 control-label">Disbursement Date</label>
                <div class="col-sm-8 show-message">
                    <input type="text" maxlength="15" name="ShortName" ng-model="CustomPara.DisbursementDate" datepicker placeholder="dd-MMM-yyyy" class="form-control" required tabindex="3" ng-disabled="IsEdit">
                </div>
            </div>
        </div>

        <div class="col-md-6 form-horizontal">
            <div class="form-group">
                <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" maxlength="15" name="ShortName" ng-model="CustomPara.Description" class="form-control" required tabindex="3">
                </div>
            </div>
        </div>


        @*<div class="col-md-4 form-horizontal">
                <div class="form-group">
                    <label class="col-sm-4 control-label">Payment Date</label>
                    <div class="col-sm-8 show-message">
                        <input type="text" maxlength="15" name="ShortName" ng-model="CustomPara.PaymentDate" datepicker placeholder="dd-MMM-yyyy" class="form-control" required tabindex="3">
                    </div>
                </div>
            </div>*@

        <div class="col-md-12 form-horizontal">
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li><button ng-click="AddEmployee();" class="btn"><i class="glyphicon glyphicon-plus-sign" tabindex="9"></i> Add Employee</button></li>

                </ul>

            </div>
        </div>

    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-sm-12">

            <div style="color:black;"
                 id="GridBonusRetainedListForSaved"
                 e-recorddoubleclick="details"
                 ej-grid e-datasource="BonusRetainedListForSaved" e-templaterefresh="refreshTemplateemployee4"
                 e-gridlines="vertical"
                 e-allowfiltering="true"
                 e-allowpaging="true"
                 e-allowsorting="true"
                 e-allowselection="true"
                 e-pagesettings-pagesize="25"
                 e-filtersettings-filterType="excel" e-allowtouch="true">
                <div e-columns>
                    @*<div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="30"></div>*@
                    <div e-column e-field="EmployeeCode" e-headertext="Code" e-allowediting="false" e-width="50"></div>
                    <div e-column e-field="EmployeeName" e-headertext="EmployeeName" e-allowediting="false" e-width="80"></div>
                    @*<div e-column e-field="EmpInfoSystemID" e-headertext="EmpInfoSystemID" e-allowediting="false" e-width="80"></div>*@
                    <div e-column e-field="DisbusmentAmount" e-headertext="Amount" e-allowediting="false" e-width="50"></div>

                    <div e-column e-field="DOJ" e-headertext="DOJ" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="LegalDesignation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="EmployeeCategory" e-headertext="Category" e-allowediting="false" e-width="80"></div>
                    @*<div e-column e-field="GivenDesignation" e-headertext="GivenDesignation" e-allowediting="false" e-width="80"></div>*@
                    <div e-column e-field="Department" e-headertext="Department" e-allowediting="false" e-width="80"></div>
                    @*<div e-column e-field="Code" e-headertext="Code" e-allowediting="false" e-width="80"></div>*@
                    <div e-column e-field="Section" e-headertext="Section" e-allowediting="false" e-width="80"></div>
                    <div e-column e-field="SubSection" e-headertext="SubSection" e-allowediting="false" e-width="80"></div>


                    @*<div e-column e-field="PositionName" e-headertext="PositionName" e-allowediting="false" e-width="80"></div>
                        <div e-column e-field="EntityName" e-headertext="EntityName" e-allowediting="false" e-width="80"></div>*@
                    @*<div e-column e-field="Designation" e-headertext="Designation" e-allowediting="false" e-width="80"></div>*@

                    @*<div e-column e-field="PayRollGroupName" e-headertext="PayRollGroupName" e-allowediting="false" e-width="80"></div>*@


                    @*<div e-column e-field="SalaryGrade" e-headertext="SalaryGrade" e-allowediting="false" e-width="80"></div>*@

                    @*<div e-column e-field="Active" e-headertext="Active" e-width="80"></div>*@
                    <div e-column e-headertext="Actions" e-width="60">
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn" ng-click="$parent.details($event);"><i class="glyphicon glyphicon glyphicon-th-list" tabindex="9"></i></button>
                        <button style="color: #f3f3ec;background-color: #1c1f32;height: 28px;" class="btn" ng-click="$parent.remove($event);"><i class="glyphicon glyphicon glyphicon-trash" tabindex="9"></i></button>
                    </div>
                </div>


                <script type="text/template" id="checkboxTemplate">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-checked="data.CheckBoxSelect" />
                </script>
                <script type="text/x-jsrender" id="headerTemplate">
                    <input type="checkbox" id="headchk" />
                </script>


            </div>
        </div>
    </div>





  








    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="SaveBonusRetainedData();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> Save</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
</div>

