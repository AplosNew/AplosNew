<togglable name="{{title}}"></togglable>
<div class="form-horizontal" ng-form name="ModelNewForm">
    <div class="row">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label" style="padding-right: 52px;">Company<sup>*</sup></label>
                <div class="col-sm-8 show-message" style="padding-left: 20px;padding-right: 31px;">
                    <div class="select-style">
                        <select class="form-control" ng-model="ModelNew.CompanyId" ng-change="getData();"
                                ng-options="item.Value as item.Text for item in companyList" id="CompanyId"
                                name="Company" required tabindex="1" ng-disabled="ModelNew.Id != null">
                            <option></option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

        </div>
    </div>
    <div class="form-elements ">
        <input type="hidden" ng-model="ModelNew.Id">
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Agreement No<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Short Name" ng-model="ModelNew.AgreementNo" class="form-control" maxlength="50" required tabindex="3">
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-4 control-label">InsuranceCompanyName</label>
                <div class="col-sm-8">
                    <textarea class="form-control" rows="3" ng-model="ModelNew.InsuranceCompanyName" tabindex="7" maxlength="100"></textarea>
                </div>
            </div>
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Agreement Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Date" ng-model="ModelNew.AgreementDate" datepicker class="form-control">
                </div>
            </div>
            <div class="form-group" show-errors>
                <label class="col-sm-4 control-label">Branch<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="Code" ng-model="ModelNew.Branch" class="form-control" required tabindex="2" maxlength="100">
                </div>
            </div>
        </div>
        <div class="common-btn">
            <ul class="list-inline text-right">
                <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
            </ul>
        </div>
    </div>
    </div>

    <div class="table-responsive aplos-grid-toggle">
        <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get" e-load="loadGridEdit"
             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
            <div e-columns>
                <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
                <div e-column e-field="AgreementNo" e-headertext="Agreement No" e-width="3"></div>
                <div e-column e-field="AgreementDate" e-headertext="Agreement Date" e-width="5"></div>
                <div e-column e-field="InsuranceCompanyName" e-headertext="Insurance Company Name" e-width="5"></div>
                <div e-column e-field="Branch" e-headertext="Branch" e-width="5"></div>
            </div>

        </div>
    </div>
    <confirm-modal></confirm-modal>
