<style>
    .e-filterset:before {
        color: white;
    }

    .e-gridheader .e-headercell { /* grid header color and grid row select color*/
        background-color: #1c1f32;
        color: White;
        min-height: 100%;
        border-bottom-color: #8B4513;
    }

    element.style {
        height: 20px;
        width: 50px;
    }
</style>
<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> Payroll group employee assign</h3>
<div id="payrollGroupMasterNew" class="form-horizontal" ng-form name="payrollGroupMasterNewForm">
    <input type="hidden" ng-model="payrollGroupMasterNew.Id">
    <div class="col-xs-6 col-sm-6 col-md-6 form-element-ctrl">
        <div class="form-group" show-errors>
            <label class="col-sm-4 control-label">Payroll Group <sup>*</sup></label>
            <div class="col-sm-8  show-message">
                <div class="select-style">
                    <select name="PayrollGroupId" ng-model="payrollGroupMasterNew.PayrollGroupId" class="col-sm-3 form-control" id="PayrollGroupId"
                            ng-options="item.Value as item.Text for item in payrollGroupList" required ng-change="getSavedPayRollGroupData()">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="clearfix"></div>

<div class="tab-design" id="tab_show">
    <div class="site-tab">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" aria-controls="assign" role="tab" data-toggle="tab">Assign List</a></li>
            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" aria-controls="assigned" role="tab" data-toggle="tab">Unassign List</a></li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
            <div class="row">
                <div class="content-container-fluid" style="color:black;">
                    <div style="color:black;" id="Grid" ej-grid e-datasource="payrollGroupMasters"
                         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                         e-allowselection="true" e-recorddoubleclick="recorddoubleclick" e-filtersettings-filterType="excel">
                        <div e-columns>
                            <div e-column e-field="Id" e-headertext="id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                            <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                            <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                            <div e-column e-field="Department" e-headertext="Deparment" e-width="80"></div>
                            <div e-column e-field="GivenDesignation" e-headertext="GivenDesignation" e-width="80"></div>
                            <div e-column e-field="Division" e-headertext="Division" e-width="80"></div>
                            <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                            <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-width="80"></div>
                            <div e-column e-headertext="Delete" e-commands="command" e-isunbound=true e-textalign="center" e-width="75"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
            <div class="col-sm-12">
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li style="float:left"> <button ng-click="LoadUnsavedData();" class="btn"><i class="glyphicon glyphicon-search"></i>Load Employee</button></li>
                        <li style="float:right"> <button ng-click="Save();" class="btn"><i class="glyphicon glyphicon-floppy-disk"></i>Save</button></li>
                    </ul>
                </div>

            </div>
            <div class="clearfix"></div>
            <div class="col-sx-12">
                <div class="row">
                    <div class="clearfix"></div>
                    <div class="content-container-fluid" style="color:black;">
                       
                        <div id="Gridemployee" ng-init="chkinit()" ej-grid e-datasource="searchdata" e-templaterefresh="refreshTemplateemployee"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel">
                            <div e-columns>
                                <div e-column e-headertext="" e-headertemplateid="#headerTemplate" e-template="#checkboxTemplate" e-textalign="center" e-width="20"></div>
                                <div e-column e-field="EmployeeId" e-headertext="id" e-headertext-color="black" e-textalign="left" e-width="75" e-visible="false">  </div>
                                <div e-column e-field="EmployeeCode" e-headertext="Employee Code" e-width="80"></div>
                                <div e-column e-field="EmployeeName" e-headertext="Employee Name" e-width="80"></div>
                                <div e-column e-field="Department" e-headertext="Deparment" e-width="80"></div>
                                <div e-column e-field="GivenDesignation" e-headertext="Given Designation" e-width="80"></div>
                                <div e-column e-field="Division" e-headertext="Division" e-width="80"></div>
                                <div e-column e-field="Section" e-headertext="Section" e-width="80"></div>
                                <div e-column e-field="EmployeeCategory" e-headertext="Employee Category" e-width="80"></div>
                            </div>
                        </div>

                    </div>
                </div>
                <script type="text/x-jsrender" id="checkboxTemplate">
                    <input type="checkbox" ng-model="{{:EmployeeId}}" class="rowCheckbox" value="{{:EmployeeId}}" />
                </script>
                <script type="text/x-jsrender" id="headerTemplate">
                    <input type="checkbox" id="headchk" />
                </script>
            </div>
        </div>
    </div>
</div>
<confirm-archive-generic modalid="confirm_PopUp" title="Confirmation" message={{message_confirmation}} data-ng-click-right-button="removeRow()"></confirm-archive-generic>
