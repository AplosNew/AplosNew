<h3 class="site-heading"><span class="glyphicon glyphicon-file"></span>{{FormTitle}}</h3>
<div class="row">
    <div class="col-xs-12">
        <div class="col-sm-2">
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsProrataMonthlyColu" ng-model="ReportType" value="Salary">
                        <span class="cr"><i class="cr-icon"></i></span>Salary
                    </label>

                </div>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsProrataMonthlyColu" ng-model="ReportType" value="Bonus">
                        <span class="cr"><i class="cr-icon"></i></span>Bonus
                    </label>
                </div>
            </div>
        </div>

        <div class="col-sm-2">
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsProrataMonthlyColu" ng-model="ReportType" value="GoodWork">
                        <span class="cr"><i class="cr-icon"></i></span>Good Work
                    </label>
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="form-group">
                <div class="radio">
                    <label>
                        <input type="radio" name="IsProrataMonthlyColu" ng-model="ReportType" value="ExtraOT">
                        <span class="cr"><i class="cr-icon"></i></span>Extra OT
                    </label>
                </div>
            </div>
        </div>
        
    </div>
    <div class="col-xs-12">
        <div class="col-xs-4">
            <div class="form-group" ng-show="ReportType=='Salary'||ReportType=='Bonus'">
                <label class="col-sm-4 control-label">Year</label>
                <div class="col-sm-8">
                    <input id="ddlYearList" e-watermarktext="Year" ej-dropdownlist e-datasource="YearNoList" e-enablefiltersearch="true" e-value="year" e-databound="SelectDefaultValue" e-fields-value="Text" e-fields-text="Text" e-width="100%" />
                </div>
            </div>
            <div class="form-group" ng-show="ReportType=='GoodWork'||ReportType=='ExtraOT'">
                <label class="col-sm-4 control-label">From Date</label>
                <div class="col-sm-8">
                    <input type="text" name="FromDate" ng-model="FromDate" datepicker class="form-control datepicker" placeholder="dd-Mmm-yyyy" tabindex="3">
                </div>
            </div>
        </div>
        <div class="col-xs-4">
            <div class="form-group" ng-show="ReportType=='Salary'||ReportType=='Bonus'">
                <label class="col-sm-4 control-label">Month</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select id="Month" class="form-control" name="Month" ng-model="month" tabindex="5">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in monthList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group" ng-show="ReportType=='GoodWork'||ReportType=='ExtraOT'">
                <label class="col-sm-4 control-label">To Date</label>
                <div class="col-sm-8">
                    <input type="text" name="ToDate" ng-model="ToDate" datepicker class="form-control datepicker" placeholder="dd-Mmm-yyyy" tabindex="3">
                </div>
            </div>
        </div>
        <div class="col-xs-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Disbursment Type</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select id="PaymentModeId" class="form-control" name="Payment Mode" ng-model="PaymentMode" tabindex="5" ng-change="GetDisbursementAdviceCbo();">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in paymentModeList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12">
        <div class="col-xs-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Status</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select id="EmployeeCategory" class="form-control" name="Employee Category" ng-model="EmpCat" tabindex="5" ng-change="GetDisbursementAdviceCbo();">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in EmpCatList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-4">
            <div class="form-group">
                <label class="col-sm-4 control-label">Disbursment Id</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select id="DisbursmentId" class="form-control" name="DisbursmentId" ng-model="DisbursmentId" tabindex="5">
                            <option value="">--Select--</option>
                            <option ng-repeat="option in disbursementAdviceList" value="{{option.Value}}">{{option.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xs-2">
            <div class="common-btn" style="padding-right: 15px; margin-top: 10px;">
                <ul class="list-inline text-right">
                    <li><button ng-click="PrintData();" class="btn"><i class="glyphicon glyphicon-download" tabindex="9"></i> Download</button></li>
                </ul>
            </div>
        </div>
    </div>

</div>



<div class="loader" data-loader>
    Please wait
    <div class="bounce1"></div>
    <div class="bounce2"></div>
    <div class="bounce3"></div>
    <div class="bounce3"></div>
</div>

