<h3 class="site-heading"><span class="glyphicon glyphicon-info-sign"></span> {{FormTitle}}</h3>
<style>
    .glyphicon.fast-right-spinner {
        -webkit-animation: glyphicon-spin-r 1s infinite linear;
        animation: glyphicon-spin-r 1s infinite linear;
    }
</style>
<div class="form-elements form-horizontal">
    <div class="row">
        <div class="col-md-12" style="color:blue;font-weight:bold;">
            {{NotificationMessage}}
        </div>

        <div class="col-xs-12 col-sm-6 col-md-6">
            <div class="form-group">
                <label class="col-sm-4 control-label">Company</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select name="Company" class="form-control" ng-model="CompanyId" ng-change="getPlantCbo();" ng-options="item.Value as item.Text for item in companyList">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">From Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="From Date" placeholder="dd-MM-yyyy" ng-change="CreateToDate()" ng-model="FromDate_sep" id="txtFromDate_sep" datepicker class="form-control datepicker" tabindex="1">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">Description<sup>*</sup></label>
                <div class="col-sm-8">
                    <input class="form-control" id="txtDescription" ng-model="Description" placeholder="Description" type="text" tabindex="2" maxlength="200" />
                </div>
            </div>
          
        </div>
        <div class="col-xs-12 col-sm-6 col-md-6">

            <div class="form-group">
                <label class="col-sm-4 control-label">Plant</label>
                <div class="col-sm-8">
                    <div class="select-style">
                        <select name="Plant" class="form-control" ng-model="PlantId" ng-options="item.Value as item.Text for item in plantList">
                            <option value="">--Select--</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-4 control-label">To Date<sup>*</sup></label>
                <div class="col-sm-8 show-message">
                    <input type="text" name="To Date" placeholder="dd-MM-yyyy" ng-model="ToDate_sep" id="txtToDate_sep" datepicker class="form-control datepicker" tabindex="1">
                </div>
            </div>

            
            <div class="col-xs-2 col-sm-2 col-md-2" style="text-align:left;padding-right:0px">
                <div class="common-btn">
                    <button ng-click="GetEmployee_list();" class="btn"> <i class="glyphicon glyphicon-refresh"></i> Load</button>
                </div>
            </div>
        </div>
    </div>

</div>

<hr />
