<h3 class="site-heading">
    <span aria-hidden="true" class="glyphicon glyphicon-th-list"></span> Contract Fund Utilization
</h3>
<div ng-form name="ModelNewForm" class="form-elements form-horizontal">
    <div class="row" ng-form name="ModelNewForm1">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <div class="table-responsive modal-table">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Utilization</th>
                            <th>Sequence</th>
                            <th>Standard Name</th>
                            <th>User Name</th>
                            <th>Commisssion</th>
                            <th>Commisssion Value</th>
                            <th>Allowed Excess Variation</th>
                            <th>Allowed Less Variation</th>
                            <th>Remarks</th>
                            <th>Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in fundUtilizationList">
                            <td>{{x.Id}}</td>
                            <td><input type="text" n-Decimals="2" class="form-control" ng-model="x.Sequence"></td>
                            <td><input type="text" class="form-control" ng-model="x.StandardName" maxlength="50"></td>
                            <td><input type="text" class="form-control" ng-model="x.UserName" maxlength="50"></td>
                            <td>
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="{{x.Id+x.CommisssionCharge}}" ng-model="x.CommisssionCharge" value="Percentage">
                                        <span class="cr"><i class="cr-icon"></i></span>Percentage
                                    </label>
                                    <label>
                                        <input type="radio" name="{{x.Id+x.CommisssionCharge}}" ng-model="x.CommisssionCharge" value="Fixed">
                                        <span class="cr"><i class="cr-icon"></i></span>Fixed
                                    </label>
                                </div>
                                @*<input type="radio" name="{{x.Id+x.CommisssionCharge}}" ng-model="x.CommisssionCharge" value="Percentage"> Percentage
                                    <input type="radio" name="{{x.Id+x.CommisssionCharge}}" ng-model="x.CommisssionCharge" value="Fixed"> Fixed*@
                            </td>
                            <td><input type="text" class="form-control" ng-model="x.CommisssionChargeValue" n-Decimals="2"></td>
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="x.AllowedExcessVariation" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="x.AllowedLessVariation" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                            <td><input type="text" class="form-control" ng-model="x.Remarks" maxlength="250"></td>
                            <td>
                                <div class="checkbox-site">
                                    <label>
                                        <input type="checkbox" ng-model="x.Active" tabindex="8">
                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                    </label>
                                </div>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
            <div class="common-btn">
                <ul class="list-inline text-right">
                    <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                </ul>
            </div>
        </div>
    </div>
