<togglable name="Auto Loan"></togglable>
<div class="form-elements form-horizontal" ng-form name="AutoLoanForm">
    <input type="hidden" ng-model="AutoLoanNew.Id">
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group">
            <div class="col-sm-12 radio">
                <label>
                    <input type="radio" name="source2" ng-model="AutoLoanNew.DateRange" value=false ng-change="viewChange()">
                    <span class="cr" tabindex="1"><i class="cr-icon"></i></span>As On Date
                </label>
                <label>
                    <input type="radio" name="source2" ng-model="AutoLoanNew.DateRange" value=true ng-change="viewChange()">
                    <span class="cr" tabindex="2"><i class="cr-icon"></i></span>For the Period
                </label>
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-3 col-md-3">
        <div class="form-group" show-errors id="div_FromDate">
            <label class="col-sm-4 control-label">{{fromDateTitle}}</label>
            <div class="col-sm-8 show-message">
                <input type="text" name="Date" ng-model="AutoLoanNew.FromDate" datepicker class="form-control"  tabindex="3">
            </div>
        </div>
    </div>
    <div class="col-xs-12 col-sm-4 col-md-4">
        <div class="form-group" show-errors id="div_WDToDate">
            <div ng-show="toDateShow">
                <label class="col-sm-4 control-label">To Date</label>
                <div class="col-sm-6 show-message">
                    <input type="text" name="Date" ng-model="AutoLoanNew.ToDate" datepicker class="form-control"  tabindex="4">
                </div>
            </div>


            <div class="col-sm-2 show-message" style="padding-left:0px;">
                <div class="common-btn">
                    <button ng-click="getAutoLoanAvailableList();" class="btn"><i class="glyphicon glyphicon-circle-arrow-down"></i>Go</button>
                </div>
            </div>
        </div>

    </div>


    <div class="common-btn">
        <ul class="list-inline text-right">
            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
        </ul>
    </div>
    <div class="clearfix"></div>
    <div class="row">
        <div>
            <div class="content-container-fluid" style="color:black;">
                <div style="color:black;" id="GridAcceptanceList" ej-grid e-datasource="AutoLoanAvailableDataList"
                     e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                     e-allowselection="true"
                     e-gridlines="vertical" e-allowresizing="true"
                     @*e-recorddoubleclick="nonPostedAcceptance"*@
                     e-filtersettings-filterType="excel"
                     e-enabletouch="true"
                     e-templaterefresh="refreshTemplate"
                     e-detailsdatabound="detailgrid">
                    <div e-columns>
                        <div e-column e-headertext="Select" @*e-headertemplateid="#headerTemplate"*@ e-template="#checkMasterLC" e-textalign="center" e-width="30"></div>

                        <div e-column e-type="string" e-field="PurchaseDocAcceptanceId" e-headertext="Id" e-width="80"></div>
                        <div e-column e-type="string" e-field="AcceptanceNo" e-headertext="AccNo" e-width="80"></div>
                        <div e-column e-type="date" e-field="AcceptanceDate" e-headertext="Date" e-format="{0:dd-MMM-yyyy}" e-width="50"></div>
                        <div e-column e-type="string" e-field="VoucherNo" e-headertext="Voucher No" e-width="80"></div>
                        <div e-column e-type="date" e-field="PostingDate" e-headertext="Posting Date" e-format="{0:dd-MMM-yyyy}" e-width="70"></div>
                        <div e-column e-type="string" e-field="PartyName" e-headertext="Vendor" e-width="120"></div>
                        <div e-column e-type="string" e-field="Tenure" e-headertext="Tenure" e-width="50"></div>
                        <div e-column e-type="string" e-field="PaymentType" e-headertext="PaymentType" e-width="90"></div>
                        <div e-column e-type="string" e-field="DueDateBaseON" e-headertext="DueDate BaseOn" e-format="{0:dd-MMM-yyyy}" e-width="100"></div>
                        <div e-column e-type="date" e-field="DueDate" e-headertext="DueDate" e-format="{0:dd-MMM-yyyy}" e-width="100"></div>
                        <div e-column e-type="string" e-field="NoOfDays" e-headertext="NoOfDays" e-width="80"></div>
                        <div e-column e-type="string" e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="AcceptanceAmount" e-headertext="Amount" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="SetOff" e-headertext="SetOff" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="Balance" e-headertext="Balance" e-textalign="right" e-width="80"></div>
                        <div e-column e-template="#LoanAmountTemp" e-field="Amount" textAlign='right' e-headertext="LoanAmount" e-width="100"></div>
                        <div e-column e-template="#LoanNoTemp" e-field="LoanNo" textAlign='right' e-headertext="LoanNo" e-width="100"></div>
                        <div e-column e-template="#LoanDateTemp" e-field="LoanDate" textAlign='right' e-headertext="LoanDate" e-width="100"></div>

                        <div e-column e-type="string" e-field="PurchaseLCNo" e-headertext="LC No" e-width="50"></div>
                        <div e-column e-type="date" e-field="LCOpeningDate" e-headertext="LCOpeningDate" e-format="{0:dd-MMM-yyyy}" e-width="60"></div>
                        <div e-column e-type="string" e-field="PINo" e-headertext="PINo" e-width="50"></div>
                        <div e-column e-type="numeric" e-format="{0:0.00}" e-field="LCAmount" e-headertext="LCAmount" e-textalign="right" e-width="80"></div>
                        <div e-column e-type="string" e-field="OpeningBank" e-headertext="OpeningBank" e-width="100"></div>
                        <div e-column e-type="string" e-field="BenificiaryBank" e-headertext="BenificiaryBank" e-width="90"></div>


                        <div e-column e-type="string" e-field="PoNo" e-headertext="PoNo" e-width="50"></div>
                        <div e-column e-type="string" e-field="GRNNo" e-headertext="GRNNo" e-width="50"></div>
                        <div e-column e-type="string" e-field="ContractNo" e-headertext="Contract No" e-width="50"></div>
                        <div e-column e-type="string" e-field="Customer" e-headertext="Customer" e-width="80"></div>
                        <div e-column e-type="string" e-field="MasterLCNo" e-headertext="MasterLCNo" e-width="80"></div>
                        <div e-column e-type="string" e-field="UDNo" e-headertext="UDNo" e-width="80"></div>
                    </div>
                </div>
                <script type="text/template" id="checkMasterLC">
                    <input type="checkbox" ej-checkbox class="rowCheckbox" e-change="$parent.rowChecked" e-checked="data.isSelected" />
                </script>
                <script type="text/template" id="LoanAmountTemp">
                    <input type="text" class="input ejinputtext form-control" ng-disabled="isSelected" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.Amount" width="80" @*ng-change="$parent.calculateRequisitionData(this)"*@ />

                </script>
                <script type="text/template" id="LoanNoTemp">
                    <input type="text" class="input ejinputtext form-control" ng-disabled="isSelected" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.LoanNo" width="80" @*ng-change="$parent.calculateRequisitionData(this)"*@ />

                </script>
                <script type="text/template" id="LoanDateTemp">
                    <input type="text" class="datepicker form-control" datepicker ng-disabled="isSelected" style="background-color:antiquewhite;font-weight:bold;color:black;text-align:right;" ng-model="data.LoanDate" width="80" />

                </script>
            </div>


        </div>
       
    </div>
    
</div>
