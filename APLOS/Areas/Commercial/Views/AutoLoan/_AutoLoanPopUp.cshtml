<style>
    .modellgModify {
        width: 1400px;
    }
</style>
<div class="modal fade site-modal in" id="autoLoanPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg modellgModify">
        <div class="modal-content">
            <div class="modal-header"> AutoLoan  List <button type="button" class="close" ng-click="closeAutoLoanPopUp();">&times;</button></div>
            <div class="modal-body form-elements form-horizontal">
                
                <div class="col-md-12">
                    <div class="content-container-fluid">
                        <div style="color:black;" id="partyPopUpGrid" ej-grid e-datasource="AutoLoanPostableDataList" e-recorddoubleclick="selectAutoLoan"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true"
                             e-filtersettings-filterType="excel" e-enabletouch="true" e-allowselection="true">
                            <div e-columns>
                                <div e-column e-field="LoanNo" e-headertext="LoanNo" e-width="50" e-filter="false"></div>
                                <div e-column e-type="date" e-field="NewLoanDate" e-headertext="Loan Date" e-format="{0:dd-MMM-yyyy}" e-width="50"></div>
                                <div e-column e-field="AcceptanceNo" e-headertext="AccepNo" e-width="50" e-filter="false"></div>
                                <div e-column e-field="PaymentType" e-headertext="Type" e-width="50" e-filter="false"></div>
                                <div e-column e-field="PurchaseLCNo" e-headertext="LCNo" e-width="50" e-filter="false"></div>
                                <div e-column e-field="PINo" e-headertext="PINo" e-width="50" e-filter="false"></div>
                                <div e-column e-field="PartyName" e-headertext="Party" e-width="130"></div>
                                <div e-column e-field="AccountTitle" e-headertext="Bank Master" e-width="130"></div>
                                <div e-column e-field="CurrencyCode" e-headertext="Currency" e-width="50"></div>
                                <div e-column e-field="Amount" e-headertext="Amount" e-width="80" textAlign='Right'></div>
                                <div e-column e-field="UserName" e-headertext="Added By" e-width="50"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <ul class="common-btn list-inline text-right">
                    <li><button ng-click="closeAutoLoanPopUp();" class="btn"> Close</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
