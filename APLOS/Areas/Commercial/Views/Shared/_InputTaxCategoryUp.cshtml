<div class="modal fade site-modal in" id="receiveTaxPopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header"> Tax Information</div>
            <div class="modal-body form-elements form-horizontal">
                <div class="col-md-12">
                   
                    <div>
                        <p class="col-md-11"></p>
                        <button type="button" class="btn btn-action" ng-click="addTax();">Add Tax</button>
                    </div>
                    <div class="table-responsive modal-table">
                        <table class="table table-striped" border="1" id="AddTax">
                            <thead>
                                <tr>
                                    <th>Charges</th>
                                    <th>Tax Category</th>
                                    <th>Percentage</th>
                                    <th>Tax Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in receiveTaxList| filter:{PurchaseLCId:purchaseLCId}">
                                    <td>
                                        <div class="select-style">
                                            <select class="form-control" ng-model="x.PurchaseLCChargesId" ng-options="item.Id as item.LCChargesType for item in lcChargesList"></select>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="select-style">
                                            <select class="form-control" ng-model="x.TaxCategoryId" ng-options="item.Value as item.Text for item in taxCategoryList"></select>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="show-message">
                                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Percentage" ng-keyup="calculateTaxAmount(x);">
                                        </div>
                                    </td>
                                    <td class="text-right">
                                        <div class="show-message">
                                            <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.TaxAmount">
                                        </div>
                                    </td>
                                    <td class="text-right">
                                        <ul class="list-inline action-list">
                                            <li><button ng-click="taxDel(x.Id,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button></li>
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-right"><strong>Total : </strong></td>
                                    <td class="text-right"><strong>{{receiveTaxList | sumByKey : 'TotalAmount'| setDecimal:2| number:2 }}</strong></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li><button ng-click="closeReceiveTaxPopUp();" class="btn"><i class="glyphicon glyphicon-folder-close"></i> Done</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>