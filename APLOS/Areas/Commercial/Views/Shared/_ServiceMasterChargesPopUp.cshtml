                                <div e-column e-field="Id" e-headertext="Id" e-width="3"></div>
                                <div e-column e-field="UserName" e-headertext="Chages" e-width="3"></div>
                                <div e-column e-field="ServiceMaster" e-headertext="ServiceMaster" e-width="2"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="hideServiceMasterChargesPopUp();" class="btn"><i class="glyphicon glyphicon-remove"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>