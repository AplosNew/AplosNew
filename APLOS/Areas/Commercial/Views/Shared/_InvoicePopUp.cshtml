
<div class="modal fade site-modal in" id="InvoicePopUp" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Select Invoice</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="table-responsive aplos-grid-toggle">
                        <div id="InvoiceGridPopUp" ng-init="chkinit()" ej-grid e-datasource="VendorAvailableInvoiceList" @*e-recorddoubleclick="selectInvoice"*@ e-load="loadGridEdit"
                             e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
                             e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
                            <div e-columns>
                                <div e-column e-template="#checkboxTemplateMaster" e-textalign="center" e-width="1"></div>
                                <div e-column e-field="InvoiceId" e-headertext="InvoiceId" e-width="3"></div>
                                <div e-column e-field="VoucherNo" e-headertext="Voucher No" e-width="3"></div>
                                <div e-column e-field="Receivable" e-headertext="Amount" e-width="2"></div>
                                <div e-column e-field="DocDate" e-headertext="Invoice Date" e-width="2"></div>
                            </div>
                        </div>
                        <script type="text/template" id="checkboxTemplateMaster">
                            <input type="checkbox" ej-checkbox class="nodetext" e-value="data.Active" e-checked="data.Active" />
                        </script>
                    </div>
                </div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
                        <li> <button ng-click="selectInvoice();" class="btn"><i ></i> Apply</button></li>
                        <li> <button ng-click="hideInvoicePopUp();" class="btn"><i class="glyphicon glyphicon-remove"></i> Close</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>