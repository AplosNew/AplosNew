                                            <span class="cr"><i class="cr-icon"></i></span>Yes
                                        </label>
                                        <label>
                                            <input type="radio" name="TaxOptionService" ng-model="salesVM.TaxOptionService" value="No" ng-click="TaxOptionService('No');">@*ng-hide="HSNCode !=null"*@
                                            <span class="cr"><i class="cr-icon"></i></span>No
                                        </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                    </div>
                                </div>
                            </div>
                        </div>

                        <table class="table table-striped" ng-show="serviceModel.ServiceMasterId">
