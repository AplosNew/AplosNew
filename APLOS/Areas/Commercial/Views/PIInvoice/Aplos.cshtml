<togglable name="{{FormTitle}}"></togglable>
<div class="form-horizontal form-elements">
    <label class="control-label text-right">Invoice No: {{salesVM.Id}}</label>
    <div class="tab-design" id="tab_show">
        <div class="site-tab">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" ng-class="{ active: isSet2(1) }"><a ng-click="setTab2(1)" href="" aria-controls="general" role="tab" data-toggle="tab2">Invoice</a></li>
                <li role="presentation" ng-class="{ active: isSet2(2) }"><a ng-click="setTab2(2)" href="" aria-controls="address" role="tab" data-toggle="tab2">Post Sales</a></li>
            </ul>
        </div>
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(1), active: isSet2(1) }">
                <div class="form-horizontal form-elements" ng-form="form0">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <fieldset class="scheduler-border">
                            <legend class="scheduler-border">Packing list</legend>
                            <div class="common-btn">
                                <ul class="list-inline text-left">
                                    <li>
                                        <button ng-click="GetPackingListPopUp();" class="btn"><i class="glyphicon glyphicon-search" tabindex="3"></i> Packing list</button>
                                    </li>
                                </ul>
                            </div>
                            <div class="clearfix"></div>
                            <div class="table-responsive modal-table" ng-show="selectedPackingList.length">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>PI No</th>
                                            <th>Ref No</th>
                                            <th>Entity</th>
                                            <th>Customer</th>
                                            <th>Description</th>
                                            <th>Remarks</th>
                                            <th>PI Date</th>
                                            <th>Buyer</th>
                                            <th>ShippingMark</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in selectedPackingList ">
                                            <td>{{x.PINo}}</td>
                                            <td>{{x.RefNo}}</td>
                                            <td>{{x.Entity}}</td>
                                            <td>{{x.Customer}}</td>
                                            <td>{{x.Description}}</td>
                                            <td>{{x.Remarks}}</td>
                                            <td>{{x.PIDate}}</td>
                                            <td>{{x.Buyer}}</td>
                                            <td>{{x.ShippingMark}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </fieldset>

                    </div>
                    <div class="clearfix"></div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-4 control-label">Customer<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <div class="input-group">
                                    <input type="text" name="Customer" ng-model="salesVM.PartyName" class="form-control" readonly>
                                    <span class="input-group-btn">
                                        <button ng-click="showPartyPopUpNew();" class="btn single-small-btn" tabindex="14"><i class="glyphicon glyphicon-search"></i></button>
                                        <button name="submit" ng-click="invoicingPartyPopUp()" class="btn single-small-btn"><i class="cr-icon glyphicon glyphicon-list-alt"></i></button>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div id="div_DocDate" class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Invoice Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Invoice Date" ng-model="salesVM.InvoiceDate" datepicker="checkInvoiceDate();changePaymentTerm();" required class="form-control" tabindex="3">
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Comercial Invoice No<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" ng-maxlength="25" name="Comercial Invoice No" ng-model="salesVM.ComercialInvoiceNo" class="form-control" tabindex="4" required capitalize autocomplete="off">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" tilte="EXP Form No">EXP Form No</label>
                            <div class="col-sm-2" style="width: 30%;">
                                <input type="text" ng-maxlength="25" name="EXP Form No" ng-model="salesVM.EXPFromNo" class="form-control" tabindex="4" capitalize autocomplete="off">
                            </div>
                            <label class="col-sm-3 control-label" style="margin-left: -30px;" title="EXP Date">EXP Dt</label>
                            <div class="col-sm-3" style="margin-left: -15%;width: 30%;">
                                <input type="text" name="EXP Date" ng-model="salesVM.EXPDate" datepicker class="form-control">
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-md-6">
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Entry Date<sup>*</sup></label>
                            <div class="col-sm-8 show-message">
                                <input type="text" name="Entry Date" ng-model="salesVM.EntryDate" datepicker class="form-control" disabled required>
                            </div>
                        </div>
                        <div class="form-group" show-errors>
                            <label class="col-sm-4 control-label">Currency<sup>*</sup></label>
                            <div class="col-sm-5 show-message" style="padding-right:0px;">
                                <div class="select-style">
                                    <select id="currency" ng-disabled="true" class="form-control" tabindex="5" name="Currency" ng-model="salesVM.CurrencyId" ng-change="GetCurrencyExchangeRateList();" required>
                                        <option value="">--Select--</option>
                                        <option ng-repeat="option in tranCurrencyList" value="{{option.Value}}">{{option.Text}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-3 show-message" style="padding-left:0px;">
                                <input type="text" maxlength="50" id="Rate" name="Company Currency Rate" ng-model="salesVM.CompanyCurrencyRate" ng-disabled="salesVM.CurrencyId==salesVM.BaseCurrencyId" class="form-control text-right" tabindex="5" required autocomplete="off">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" title="BL Number">BL No.</label>
                            <div class="col-sm-3" style="width: 115px;margin-left: -33px;">
                                <input type="text" ng-maxlength="50" name="BL Number" ng-model="salesVM.BLNumber" class="form-control" tabindex="4" capitalize autocomplete="off">
                            </div>
                            <label class="col-sm-2 control-label" style="margin-left: -30px;" title="BL Date">BL Dt</label>
                            <div class="col-sm-4" style="margin-left: -12px;width: 42%;">
                                <input type="text" name="BL Date" ng-model="salesVM.BLDate" datepicker class="form-control">
                                @*<input type="text" class="form-control" ej-numerictextbox e-decimalplaces="0" ej-disabled="true" e-enablertl="false" e-value="model.Amount" e-width="100%" />*@
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12">
                        <fieldset class="scheduler-border">
                            <legend class="scheduler-border">Payment Term</legend>
                            <div class="col-xs-12 col-sm-12 col-md-12">
                                <div class="form-group" show-errors>
                                    <label class="col-sm-2 control-label">Payment Term<sup>*</sup></label>
                                    <div class="col-sm-2 show-message">
                                        <div class="select-style">
                                            <select tabindex="10" id="paymentTermId" ng-disabled="salesVM.IsPaymentTermChangeable==false" class="form-control" name="Payment Term" ng-model="salesVM.PaymentTermId" ng-change="changePaymentTerm(salesVM.PaymentTermId);">
                                                <option ng-repeat="option in paymentTermList" value="{{option.Value}}">{{option.Text}}</option>
                                            </select>
                                        </div>
                                    </div>

                                    <label class="col-sm-2 control-label">Due Date BaseOn<sup>*</sup></label>
                                    <div class="col-sm-2">
                                        <input type="text" name="BaseOnDueDate" ng-disabled="IsBaseOnDueDateEnable==false" ng-model="salesVM.BaseOnDueDate" ng-change="getMatureDate(salesVM.BaseOnDueDate,salesVM.BaseNoOfDays)" datepicker class="form-control datepicker" tabindex="11">
                                    </div>
                                    <label class="col-sm-1 control-label">No Of Days</label>
                                    <div class="col-sm-1 show-message">
                                        <input id="baseNoOfday" type="number" name="No Of Days" ng-disabled="IsBaseOnDueDateEnable==false" ng-model="salesVM.BaseNoOfDays" ng-change="getMatureDate(salesVM.BaseOnDueDate, salesVM.BaseNoOfDays)" class="form-control" tabindex="12">
                                    </div>
                                    <label class="col-sm-1 control-label">Mature Date</label>
                                    <div class="col-sm-1 show-message">
                                        <input type="text" style="width: 83px;" name="Mature Date" ng-model="salesVM.MatureDate" class="form-control" readonly>
                                    </div>

                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="clearfix"></div>
                    <div class="site-tab">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" ng-class="{ active: isSet(1) }"><a ng-click="setTab(1)" href="" data-toggle="tab">Material</a></li>
                            <li role="presentation" ng-class="{ active: isSet(2) }"><a ng-click="setTab(2)" href="" data-toggle="tab">Charges</a></li>
                        </ul>
                    </div>
                    <div class="tab-content">
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(1), active: isSet(1) }">
                            <div ng-form="tabForm1">
                                @*<div class="clearfix"></div>*@
                                <div class="table-responsive modal-table" ng-show="salesOrderList.length>0">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>PI Material Id</th>
                                                <th>DeliveryDate</th>
                                                <th>MaterialMasterName</th>
                                                <th class="text-right">Rate</th>
                                                <th class="text-right">Qty</th>
                                                <th class="text-right">UOM</th>
                                                <th class="text-right">Amount</th>
                                                <th class="text-right">Tax</th>
                                                <th class="text-right">Service Charge</th>
                                                <th class="text-right">Service Tax</th>
                                                <th class="text-right">Total Amount  </th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in salesOrderList">
                                                <td>{{x.PIMaterialId}}</td>
                                                <td>{{x.DeliveryDate}}</td>
                                                <td>{{x.MaterialGroup}}</td>
                                                <td class="text-right">{{x.Rate}}</td>
                                                <td class="text-right">{{x.Quantity | number:2}}</td>
                                                <td class="text-right">{{x.UOM}}</td>
                                                <td class="text-right">{{x.Amount | number:2}}</td>
                                                <td class="text-right">{{x.TaxAmount | number:2}}</td>
                                                <td class="text-right">{{x.ServiceCharge | number:2}}</td>
                                                <td class="text-right">{{x.ServiceTax | number:2}}</td>                                                
                                                <td class="text-right">{{x.NetAmount | number:2}}</td>
                                                <td class="text-right">
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="getMaterialTaxList(x, false,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button>
                                                        </li>
                                                        <li>
                                                            <button ng-click="removeMaterialRow(x.Id,$index)"  class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="3" class="text-right">
                                                    <strong>Total : </strong>
                                                </td>
                                                <td></td>
                                                <td class="text-right"><strong>{{salesOrderList | sumByKey : 'Quantity'| setDecimal:2 | number:2}}</strong></td>
                                                <td></td>
                                                <td class="text-right"><strong>{{salesOrderList | sumByKey : 'Amount'| setDecimal:2 | number:2}}</strong></td>
                                                <td class="text-right"><strong>{{salesOrderList | sumByKey : 'TaxAmount'| setDecimal:2 | number:2}}</strong></td>
                                                <td class="text-right"><strong>{{salesOrderList | sumByKey : 'ServiceCharge'| setDecimal:currencyPrecision | number}}</strong></td>
                                                <td class="text-right"><strong>{{salesOrderList | sumByKey : 'ServiceTax'| setDecimal:currencyPrecision | number}}</strong></td>
                                                <td class="text-right">
                                                    <strong>{{salesOrderList | sumByKey : 'NetAmount'| setDecimal:2 | number:2}}</strong>
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div class="clearfix"></div>

                                </div>
                            </div>
                        </div>
                        <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet(2), active: isSet(2) }">
                            <div ng-form="tabForm2">
                                <ul class="common-btn list-inline text-left">
                                    <li>
                                        <button ng-click="serviceChargePopUp();"  class="btn"><i class="glyphicon glyphicon-plus"></i> Add Charges</button>
                                    </li>
                                </ul>
                                <div class="table-responsive modal-table">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Service</th>
                                                <th>Amount</th>
                                                <th>Tax Amount</th>
                                                <th>Total Amount</th>
                                                <th class="col-sm-1"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="x in chargesList">
                                                <td>
                                                    {{x.ChargeName}}
                                                </td>
                                                <td class="text-right">
                                                    <div class="show-message">
                                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="x.Amount" ng-keyup="calculateServiceAmount(x);">
                                                    </div>
                                                </td>
                                                <td class="text-right">{{x.TaxAmount| number:2}}</td>
                                                <td class="text-right">{{x.TaxAndTotal | number:2}}</td>
                                                <td class="text-right">
                                                    <ul class="list-inline action-list">
                                                        <li>
                                                            <button ng-click="getServiceTaxList(x, false,x.ServiceMasterId,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Tax Info"><i class="glyphicon glyphicon-info-sign"></i></button>
                                                        </li>
                                                        <li>
                                                            <button ng-click="removeServiceRow(x.Id,$index)" class="btn btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                        </li>
                                                    </ul>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="1" class="text-right">
                                                    <strong>Total : </strong>
                                                </td>
                                                <td class="text-right">
                                                    <strong>{{chargesList | sumByKey : 'Amount'| setDecimal:2| number:2 }}</strong>
                                                </td>
                                                <td class="text-right">
                                                    <strong>{{chargesList | sumByKey : 'TaxAmount'| setDecimal:2| number:2 }}</strong>
                                                </td>
                                                <td class="text-right">
                                                    <strong>{{chargesList | sumByKey : 'TaxAndTotal'| setDecimal:2| number:2 }}</strong>
                                                </td>
                                                <td class="text-right"></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="common-btn">
                        <ul class="list-inline text-right">
                            <li> <button ng-click="Save();" class="btn" tabindex="9"><i class="glyphicon glyphicon-floppy-disk"></i> {{Action}}</button></li>
                            <li> <button data-toggle="modal" data-target="#confirmPopUp" class="btn" tabindex="10"><i class="glyphicon glyphicon-trash"></i> Delete</button></li>
                            <li> <button ng-click="Clear();" class="btn" tabindex="11"><i class="glyphicon glyphicon-refresh"></i> Clear</button></li>
                        </ul>
                    </div>
                    <div class="row">
                        <div class="col-xs-12">
                            <fieldset class="scheduler-border" ng-show="salesOrderList.length>0">
                                <legend class="scheduler-border">Additional Tax</legend>
                                <div class="col-xs-12 col-sm-4 col-md-4">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label">If Percentage Applicable</label>
                                        <div class="col-sm-6">
                                            <div class="radio">
                                                <label>
                                                    <input type="radio" name="TaxOptionAddiTax" ng-model="salesVM.TaxOptionAddiTax" value="Yes" ng-click="TaxOptionAdditax('Yes');">
                                                    <span class="cr"><i class="cr-icon"></i></span>Yes
                                                </label>
                                                <label>
                                                    <input type="radio" name="TaxOptionAddiTax" ng-model="salesVM.TaxOptionAddiTax" value="No" ng-click="TaxOptionAdditax('No');">
                                                    <span class="cr"><i class="cr-icon"></i></span>No
                                                </label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="clearfix"></div>
                                <div class="table-responsive modal-table">
                                    <table class="table table-responsive table-striped">
                                        <thead>
                                            <tr>
                                                <th>Input Tax</th>
                                                <th>Percentage</th>
                                                <th>Amount</th>
                                                <th class="text-right">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td id="td_TaxCode">
                                                    <div class="select-style show-message">
                                                        <select name="TaxCodeId" ng-model="advanceTax.TaxCodeId" ng-change="selectadditionalTax(advanceTax.TaxCodeId)" class="col-sm-3 form-control"
                                                                ng-options="item.Id as item.UserName for item in taxCodCboListWithhold">
                                                            <option></option>
                                                        </select>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div>
                                                        <input type="text" n-decimals="4" class="form-control text-right" ng-disabled="salesVM.TaxOptionAddiTax==='No'" ng-model="advanceTax.ValueOfFixed" ng-keyup="calculateTaxAmountForAdditionalTax(advanceTax.ValueOfFixed);">
                                                    </div>
                                                </td>
                                                <td id="td_TaxCodeAmount">
                                                    <div class="show-message">
                                                        <input type="text" n-decimals="2" class="form-control text-right" ng-model="advanceTax.TaxAmount" ng-keyup="copyTaxesAmount();checkRowValidationSdditionalTax(advanceTax.TaxAmount);" ng-disabled="salesVM.TaxOptionAddiTax==='Yes'">
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    <a ng-click="additionalTax();" ng-disabled="salesVM.Id==null" class="btn" tabindex="5"><i class="glyphicon glyphicon-plus-sign"></i></a>
                                                </td>
                                            </tr>
                                            <tr ng-repeat="x in advanceTaxesList">
                                                <td>{{x.TaxName}}</td>
                                                <td>{{x.ValueOfFixed}}</td>
                                                <td class="text-right">{{x.TaxAmount | number:2 }}</td>
                                                <td class="text-right">
                                                    <button ng-click="removeTaxesRow(x.Id,$index)" data-toggle="modal" ng-disabled="x.AdvanceId || salesVM.RowState==='Posted'" class="btn-action tooltip-here" data-placement="top" title="Remove"><i class="glyphicon glyphicon-remove"></i></button>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot ng-show="advanceTaxesList.length">
                                            <tr>
                                                <td colspan="2"><b>Sub Total</b></td>
                                                <td class="text-right"><b>{{ advanceTaxesList | sumByKey : 'TaxAmount'| setDecimal:2| number:2  }}</b></td>
                                                <td></td>
                                            </tr>

                                        </tfoot>
                                    </table>
                                </div>
                                <div class="common-btn">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label">Total Amount (Total Amount+Service Amount+Additional Tax)</label>
                                        <div class="col-sm-2 show-message">
                                            <input type="text" n-decimals="2" name="Total Amount" ng-model="advanceTax.TotalSumAfterTCSVal" class="form-control" tabindex="4" readonly>
                                        </div>
                                    </div>
                                    <ul class="list-inline text-right">
                                        <li><button ng-click="SaveAdditinalTax();" ng-disabled="salesVM.Id==null || salesVM.RowState==='Posted'" class="btn"><i class="glyphicon glyphicon-folder-close"></i>&nbsp;Save</button></li>

                                    </ul>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane fade" ng-class="{ 'in':isSet2(2), active: isSet2(2) }">
                <div class="form-elements form-horizontal" ng-form name="ModelNewForm">
                    <input type="hidden" ng-model="ModelNew.Id">
                    <fieldset class="scheduler-border">
                        <legend class="scheduler-border">General</legend>
                        <div class="col-xs-12 col-sm-4 col-md-4">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Invoice No<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <input type="text" name="Purchase LCNo" ng-model="ModelNew.InvoiceNo" class="form-control" readonly tabindex="1">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Contract No</label>
                                <div class="col-sm-8">
                                    <input type="text" name="ContractNo" disabled ng-model="salesVM.ContractNo" class="form-control" tabindex="5">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Bank<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Bank" id="OB" class="form-control" ng-model="ModelNew.BankMasterId" ng-options="item.Id as item.AccountTitle for item in bankMasterList" tabindex="3">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label" tilte="EXP Form No">EXP Form No</label>
                                <div class="col-sm-8">
                                    <input type="text" ng-maxlength="25" name="EXP Form No" ng-model="ModelNew.ExpFormNo" class="form-control" tabindex="7">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Cargo Net Wt</label>
                                <div class="col-sm-8">
                                    <input type="text" name="Cargo Net Wt" ng-model="ModelNew.CargoNetWt" n-decimals="2" class="form-control" autocomplete="off" tabindex="10" maxlength="50">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Shipment Mode<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Shipment Mode" class="form-control" ng-model="ModelNew.ShipmentModeId" ng-options="item.Value as item.Text for item in shipmentModeList" tabindex="13">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Final Destination<sup>*</sup></label>
                                <div class="col-sm-8">
                                    <div class="select-style">
                                        <select name="Destination" class="form-control" ng-model="ModelNew.FinalDestinationId" ng-options="item.Value as item.Text for item in destinationList" ng-change="GetPortOfDischargeByDstination()" tabindex="15">
                                            <option value=""></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label" title="Expected time of arrival">ETA</label>
                                <div class="col-sm-8">
                                    <input type="text" name="ETA" ng-model="ModelNew.ETA" datepicker class="form-control" tabindex="18">
                                </div>
                            </div>
                        </div>
