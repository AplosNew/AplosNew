                                </tr>
                                <tr>
                                    <td colspan="3" class="text-right">Total Tax (BC)</td>
                                    <td class="text-right">{{serviceModel.Amount| setDecimal:currencyPrecision}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </fieldset>

                <div class="clearfix"></div>
                <div class="common-btn">
                    <ul class="list-inline text-right">
