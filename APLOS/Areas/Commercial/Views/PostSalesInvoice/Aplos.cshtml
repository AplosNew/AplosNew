<div class="table-responsive aplos-grid-toggle">
    <div id="GridEdit" ej-grid e-datasource="ModelList" e-recorddoubleclick="Get"
         e-allowfiltering="true" e-allowpaging="true" e-allowsorting="true" e-enabletouch="false" e-responsive="true"
         e-allowselection="true" e-filtersettings-filterType="excel" e-allowtextwrap="true">
        <div e-columns>
            <div e-column e-field="Id" e-headertext="Id" e-width="2" e-isprimarykey="true" e-visible="false"></div>
            <div e-column e-field="InvoiceNo" e-headertext="InvoiceNo" e-width="2"></div>
            <div e-column e-field="InvoiceDate" e-headertext="InvoiceDate" e-width="2"></div>
            <div e-column e-field="CNFBLAWB" e-headertext="BLAWBNo" e-width="2"></div>
            <div e-column e-field="CNFBLAWBDate" e-headertext="BLAWBDate" e-width="2"></div>
